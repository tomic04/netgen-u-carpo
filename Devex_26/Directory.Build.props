<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    SharedAssembliesDir: mapa Jupiterovih DLL-ova (Spin\ i Microsoft\).
    Datoteka je u Devex_26 da je stari netgen/NetGenDLL.vbproj ne povuce.
    Lokalni dev na uobicajenoj instalaciji ne mora nista proslijediti.
    CI na runneru sql-ai prepisuje put naredbom
    /p:SharedAssembliesDir=...
    DevExpress i Jupiter DLL-ovi se ne committaju.
  -->
  <PropertyGroup>
    <SharedAssembliesDir Condition="'$(SharedAssembliesDir)' == ''">C:\Program Files (x86)\Jupiter Software\Jupiter Client\Programs\SharedAssemblies</SharedAssembliesDir>
    <DevExpressBinDir Condition="'$(DevExpressBinDir)' == ''">C:\Program Files\DevExpress 26.1\Components\Bin\Framework</DevExpressBinDir>
  </PropertyGroup>
</Project>
