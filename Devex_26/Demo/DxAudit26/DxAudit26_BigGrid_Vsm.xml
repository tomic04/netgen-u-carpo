<?xml version="1.0" encoding="utf-8"?>
<!--
  B6 VirtualServerMode — posebna manager granula (50k redova, paging SP).
  Preduvjet: Demo\DxAudit26\Sql\B6_VirtualServerMode_Test.sql na bazi.

  TestShell:
    XML  = ovaj file
    Form = DxAudit26_BigGrid_Vsm
-->
<root version="1.2" loglevel="3">

	<form name="DxAudit26_BigGrid_Vsm" type="master" caption="B6 VirtualServerMode — BigGrid 50k">
		<event type="shown">
			<action type="control populate" value="#grdBigVsm"/>
		</event>

		<managerlayout>
			<grid name="grdBigVsm"
				type="master"
				key="Id"
				dataname="~dtBigGridVsm"
				virtualservermode="true"
				findpanel="true"
				showautofilterrow="true"
				columnchooser="true"
				bestfitonrefresh="false"
				savelayout="false">
				<fields>
					<field name="Id" caption="ID" minwidth="60"/>
					<field name="Naziv" caption="Naziv" minwidth="180"/>
					<field name="Status" caption="Status" minwidth="60"/>
					<field name="Kategorija" caption="Kategorija" minwidth="90"/>
					<field name="Iznos" caption="Iznos" minwidth="90"/>
					<field name="Datum" caption="Datum" minwidth="90"/>
					<field name="PartnerId" caption="Partner" minwidth="70"/>
					<field name="Opis" caption="Opis" minwidth="160"/>
				</fields>
				<styles>
					<style name="backcolor" value="#e8f4e8" if="#grdBigVsm.@Status==1"/>
					<style name="backcolor" value="#fce8e8" if="#grdBigVsm.@Status==0"/>
				</styles>
			</grid>
		</managerlayout>

		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<!-- Ponovo veže VirtualServerModeSource i učitava prvu stranicu iz SP-a -->
				<button name="btnRefresh" caption="1) Refresh — ponovo učitaj stranice">
					<event type="click">
						<action type="control populate" value="#grdBigVsm"/>
					</event>
				</button>
				<!-- Samo objašnjenje (nema SQL) -->
				<button name="btnHint" caption="2) Što je VSM? (info)" begingroup="true">
					<event type="click">
						<action type="message" value="VSM (VirtualServerMode): grid ne ucitava svih 50000 redova odjednom. Vuce stranice (~50) preko sp_DxAudit26_BigGrid_Page (Skip/Take/Sort/Filter). Radi: scroll, sort, Find. Ne radi: foreachrow na cijeli set, full export 50k."/>
					</event>
				</button>
				<!-- Namjerno unsupported — treba Info da foreachrow nije dozvoljen -->
				<button name="btnForeachWarn" caption="3) Test foreachrow (očekuj upozorenje)">
					<event type="click">
						<action type="control foreachrow" value="#grdBigVsm">
							<action type="message" value="ne bi smjelo doći ovdje"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data name="dtBigGridVsm" command="sp_DxAudit26_BigGrid_Page"/>
		</datalist>
	</form>
</root>
