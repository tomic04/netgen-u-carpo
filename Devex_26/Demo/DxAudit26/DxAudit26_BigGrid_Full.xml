<?xml version="1.0" encoding="utf-8"?>
<!--
  B6 usporedba — stari način: cijeli DataTable (50k redova odjednom).
  Ista tablica / kolone kao DxAudit26_BigGrid_Vsm, bez virtualservermode.

  Preduvjet: Sql\B6_VirtualServerMode_Test.sql (tablica DxAudit26_BigGrid).

  TestShell:
    XML  = ovaj file
    Form = DxAudit26_BigGrid_Full

  Usporedi vrijeme otvaranja / Refresh s DxAudit26_BigGrid_Vsm.
-->
<root version="1.2" loglevel="3">

	<form name="DxAudit26_BigGrid_Full" type="master" caption="B6 FULL DataTable — BigGrid 50k (stari nacin)">
		<event type="shown">
			<action type="control populate" value="#grdBigFull"/>
		</event>

		<managerlayout>
			<!-- Klasični path: GetDataSet → DataSource = cijeli DataTable (nema virtualservermode) -->
			<grid name="grdBigFull"
				type="master"
				key="Id"
				dataname="~dtBigGridFull"
				findpanel="true"
				showautofilterrow="true"
				columnchooser="true"
				bestfitonrefresh="false"
				savelayout="false">
				<fields>
					<field name="Id" caption="ID" minwidth="60"/>
					<field name="Naziv" caption="Naziv" minwidth="180"/>
					<field name="Status" caption="Status" minwidth="60"/>
					<field name="Kategorija" caption="Kategorija" minwidth="90"/>
					<field name="Iznos" caption="Iznos" minwidth="90"/>
					<field name="Datum" caption="Datum" minwidth="90"/>
					<field name="PartnerId" caption="Partner" minwidth="70"/>
					<field name="Opis" caption="Opis" minwidth="160"/>
				</fields>
				<styles>
					<style name="backcolor" value="#e8f4e8" if="#grdBigFull.@Status==1"/>
					<style name="backcolor" value="#fce8e8" if="#grdBigFull.@Status==0"/>
				</styles>
			</grid>
		</managerlayout>

		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<button name="btnRefresh" caption="1) Refresh — ucitaj svih 50k (sync)">
					<event type="click">
						<action type="control populate" value="#grdBigFull"/>
					</event>
				</button>
				<button name="btnRefreshAsync" caption="1b) Refresh 50k async" begingroup="true">
					<event type="click">
						<action type="control populateasync" value="#grdBigFull"/>
					</event>
				</button>
				<button name="btnHint" caption="2) Sto je FULL? (info)">
					<event type="click">
						<action type="message" value="Stari nacin: SELECT cijele tablice DxAudit26_BigGrid u DataTable (svih ~50000 redova u memoriji). Usporedi vrijeme otvaranja / Refresh s granulom DxAudit26_BigGrid_Vsm (paging)."/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data name="dtBigGridFull" type="text" command="SELECT Id, Naziv, Status, Kategorija, Iznos, Datum, PartnerId, Opis FROM dbo.DxAudit26_BigGrid ORDER BY Id"/>
		</datalist>
	</form>
</root>
