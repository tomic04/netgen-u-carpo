<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Reference na DevExpress 26.1 nemaju HintPath (GAC / installer).
    Ako je Bin\Framework na disku, dodaj ga u potragu. Ako mape nema, ne diraj
    putanju (developer s GAC-om i dalje radi).
  -->
  <PropertyGroup Condition="'$(DevExpressBinDir)' != '' and Exists('$(DevExpressBinDir)')">
    <AssemblySearchPaths>$(DevExpressBinDir);$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>
</Project>
