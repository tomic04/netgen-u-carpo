<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spMPBrojIskazniceZastita @action = 1 " 
   CMD2CAPTION=""    
   CMD4CAPTION="Izmjeni:UPDATEFORM" 
   CMD3CAPTION=""
   CMD1CAPTION="Obnovi:OBNOVI"
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   FILTERMODE="TRUE" 
   MASTERDBLCLICK="">

	
  <NAME>Ažuriranje broja iskaznice-Zaštita po operaterima</NAME>
  <CAPTION>Ažuriranje broja iskaznice-Zaštita po operaterima</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>





	<OBNOVI
		WIDTH="5500" 
		ONSUBMIT="spMPBrojIskazniceZastita @action = 1" 
		ONLOAD="" 
		HEIGHT="2500" 
		FILLEXPLORER="TRUE" 
		CAPTION="Obnova podataka"  
		FOCUS="ok"
		 >

		<INPUT TYPE="label" CAPTION="Želite li obnoviti broj iskaznice-Zaštita po operaterima ? " NAME="varime" TOP="500" LEFT="400" SQL="" TABINDEX="1" STYLE="BOLD" SIZE="9" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="false" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Obnovi" TOP="1500" LEFT="196" TABINDEX ="2" WIDTH="1106" HEIGHT="322" ONCLICK="spMPBrojIskazniceZastita @action = 1#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1500" TABINDEX="3" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</OBNOVI>




	<UPDATEFORM 
                WIDTH="8000" 
                ONSUBMIT="" 
                ONLOAD="select * from ssoperateri where OperateriID = @@Operateriid " 
                HEIGHT="3500" 
                CAPTION="Izmjena podatka"  
		FOCUS="Naziv"
		 >

	  	<INPUT TYPE="text" CAPTION="Naziv operatera" NAME="naziv" SQL="" TABINDEX="1" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="false" />
		<INPUT TYPE="text" CAPTION="Broj iskaznice-Zaštita" NAME="BrojIskazniceZastita" SQL="" TABINDEX="2" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
		<INPUT TYPE="text" CAPTION="OIB" NAME="oib" SQL="" TABINDEX="2" WIDTH="2000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spMPBrojIskazniceZastita @action = 3, @Operateriid= @@Operateriid, @BrojIskazniceZastita = '@@BrojIskazniceZastita', @oib = '@@oib'#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

        </UPDATEFORM>




</PROJECT>
 
