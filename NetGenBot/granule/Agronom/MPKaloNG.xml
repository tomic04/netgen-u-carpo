<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
	BUTTONS="Filter:FILTERFORM" 
	MASTERDBLCLICK="" 
	TREE="spTreeKlMasterRoba:KLASIFIKACIJA"
	GROUPBYBOXVISIBLE="TRUE" 
	ONLOAD="" 
	EDITCOLUMNS="[Kalo %1200]"
	ONCELLEDITED="spMPKaloNG @action=1, @kalo=@@kalo, @id=@@robaid"
  SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
      PAGEHEADERRIGHT="@@tkosmomi">
	
	
<NAME>Projekt</NAME>
<CAPTION>Unos postotaka za kalo</CAPTION>
<KOMENTAR>Callisto 1.7.16</KOMENTAR>


<KLASIFIKACIJA  FILLEXPLORER="TRUE" ONSUBMIT="spMPKaloNG @action=0, @klmasterrobaid=@@node" />	
	

<FILTERFORM 
	NAME="FILTERFORM" HEIGHT="3500" WIDTH="7000" 
	REFRESHAFTERCHILD="TRUE" 
	CAPTION="Uvjeti za prikaz" 
	ONSUBMIT="spMPKaloNG @action = 0, "
	ONLOAD="" 
	FILLEXPLORER="TRUE" 
	CMD1CAPTION="Prihvati" 
	CMD2CAPTION="Odustani">
	
	<INPUT TYPE="combo" NAME="klmasterrobaid" TOP="600" LEFT="1200" HEIGHT="302" WIDTH="5000" CAPTION="Klasa robe*" VISIBLE="TRUE" 
		   SQL="select KlMasterRobaId, oznaka+' '+naziv as naziv from KlMasterRoba order by sortkey" ALLOWEMPTY="TRUE" ENABLED="TRUE"/>

	<INPUT TYPE="search" NAME="robaid" TOP="1000" LEFT="1200" HEIGHT="302" WIDTH="5000" CAPTION="Roba*" VISIBLE="TRUE"
		 SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid, @trazi = '@@searchboxrobaid'" ALLOWEMPTY="TRUE" ENABLED="TRUE"/>

</FILTERFORM>
</PROJECT>