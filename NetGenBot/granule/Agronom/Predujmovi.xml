<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM"  
      CMD1CAPTION=""  
      MASTERDBLCLICK=""
      CHECKBOXVISIBLE="TRUE"  
      PAGEHEADERCENTER=""
	  PAGEHEADERRIGHT=""
	  PAGEHEADERLEFT="##Predujmovi u periodu od: @@datumod do: @@datumdo"
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@datdanas"
	  PAGEFOOTERRIGHT="@@tkosmomi"
	  PAGEORIENTATION="LANDSCAPE"
	  COMMANDTIMEOUT="300"
      BUTTONS="Pregled:FILTERFORM#Proknjiži:MULTISELECTPROKNJIZI#Filter:SAMOPREDFORM#Ispiši:PRINTMASTER"	  
      >
 
  <NAME>Predujmovi</NAME>
  <CAPTION>Predujmovi</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
  
   <FILTERFORM 
		FILLEXPLORER="TRUE" 
		REPORT=""  
		WIDTH="6000" 
		ONSUBMIT="spPredujmoviQueryNG @action=1,@operateriid=@@Operateriid," 
		ONLOAD="select @@datumod as datumod , @@datumdo as datumdo ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas " 
		ONLOAD2="select (dateadd(month,datediff(month,0,getdate())-1,0))as datumod,(dateadd(d,-1,left(convert(varchar,getdate(),112),6)+'01')) AS datumdo"
		HEIGHT="1900" 
		CAPTION="Izaberite uvjete traženja"  
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		CMD3CAPTION=""  
		NEXTFORM=""  >
					  
		<INPUT TYPE="label" NAME="lblprijemod" TOP="280" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Razdoblje:"/>
		<INPUT TYPE="date" NAME="datumod" TOP="250" LEFT="1200" CAPTION="prijem od" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="0" DEFAULT="firstdayoflastmonth" CHECKBOX="FALSE"/>
							
		<INPUT TYPE="label" NAME="lblprijemdo" TOP="250" LEFT="3000" WIDTH="1500" HEIGHT="320" CAPTION="-"/>
		<INPUT TYPE="date" NAME="datumdo" TOP="250" LEFT="3500" CAPTION="prijemdo" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="1" CHECKBOX="FALSE"/>		  
				  
		<INPUT TYPE="button" NAME="ok1" HOTKEY="F4" TOP="1000" LEFT="200" WIDTH="1100" CAPTION="Izvrši (F4)" ONCLICK="OK" TABINDEX="2" />							  
		<INPUT TYPE="button" NAME="cancel" TOP="1000" LEFT="1450" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" TABINDEX="3" />
				
  </FILTERFORM>

  <MULTISELECTPROKNJIZI FILLEXPLORER="" ONLOAD="" ONSUBMIT="spPredujmoviQueryNG @action=2,@operateriid=@@Operateriid,@datumod=@@datumod ,@datumdo=@@datumdo" />

  <SAMOPREDFORM FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spPredujmoviQueryNG @action=3,@operateriid=@@Operateriid,@datumod=@@datumod ,@datumdo=@@datumdo,@filterid=@@filterid" />
  
</PROJECT>
 
