<PARAMETRI NAME="PARAMETRI" HEIGHT="4061" WIDTH="7142" CAPTION="Parametri" ONSUBMIT="spRealizacijaPonudaAnalitika @action = 0,
@DatumOd =&apos;@@fDatumOd&apos;,
@DatumDo = &apos;@@fDatumDo&apos;,
@PartneriId = @@fPartneriId,
@ParStruId = @@fParStruId,
@RobaID = @@fRobaId,
@SkladisteId = @@fSkladisteId,
@OrgShemaId=@@fOrgShemaId,
@KlMasterRobaId=@@fKlMasterRobaId,
@PodKlase=@@PodKlase--" ONLOAD="select @@fDatumOd as fDatumOd,

@@fDatumDo as fDatumDo,

(select partneriid as fpartneriid from partneri where partneriid=@@fpartneriid) as fpartneriid,

(select parstruid as fparstruid from parstru where parstruid=@@fparstruid) as fparstruid,

(select naziv from partneri where partneriid=@@fpartneriid) as partner,

(select naziv from parstru where parstruid=@@fparstruid) as lokacija,

(select robaid as frobaid from roba where robaid=@@frobaid) as frobaid,

(select cast(userid as varchar) + &apos; &apos; + naziv from roba where robaid=@@frobaid) as uvjet,

@@fSkladisteId as fSkladisteId,

@@fOrgShemaId as fOrgShemaId,

@@fKlMasterRobaId as fKlMasterRobaId,

@@PodKlase as PodKlase" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="date" NAME="fDatumDo" TOP="216" LEFT="4954" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="date" NAME="fDatumOd" TOP="216" LEFT="1642" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="label" NAME="Label15" TOP="216" LEFT="3586" HEIGHT="288" WIDTH="1296" CAPTION="Datum do:" TEXT="Label15"/>
	<INPUT TYPE="label" NAME="Label14" TOP="216" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Datum od:" TEXT="Label14"/>
	<INPUT TYPE="search" NAME="fPartneriId" TOP="619" LEFT="1699" HEIGHT="302" WIDTH="4968" SQL="spTraziPartneri @action=&apos;Partneri&apos;, @uvjet=&apos;@@searchboxfpartneriid&apos;" CAPTION="Partner"/>
	<INPUT TYPE="label" NAME="Label16" TOP="619" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Partner:" TEXT="Label16"/>
	<INPUT TYPE="search" NAME="fParStruId" TOP="1008" LEFT="1699" HEIGHT="302" WIDTH="4982" SQL="spTraziParstru @action=&apos;Parstru&apos;, @Uvjet=&apos;@@searchboxfparstruid&apos;, @partneriid=@@fpartneriid" CAPTION="Lokacija" ONLOSTFOCUS="select ps.partneriid as fpartneriid, p.naziv as partner 
from parstru ps inner join partneri p on ps.partneriid=p.partneriid 
where parstruid=@@fparstruid"/>
	<INPUT TYPE="label" NAME="Label17" TOP="1008" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Lokacija:" TEXT="Label17"/>
	<INPUT TYPE="search" NAME="fRobaId" TOP="1411" LEFT="1699" HEIGHT="302" WIDTH="4954" SQL="spTraziRoba @action=&apos;Roba&apos;, @Uvjet=&apos;@@searchboxfrobaid&apos;" CAPTION="Uvjet"/>
	<INPUT TYPE="label" NAME="Label18" TOP="1411" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Roba:" TEXT="Label18"/>
	<INPUT TYPE="combo" NAME="fKlMasterRobaId" TOP="1742" LEFT="1699" HEIGHT="302" WIDTH="3442" SQL="select KlMasterRobaId, rtrim(Naziv)+&apos; - &apos;+sortkey as naziv,SortKey from KlMasterRoba order by SortKey" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="check" NAME="PodKlase" TOP="1742" LEFT="5198" HEIGHT="288" WIDTH="1440" CAPTION="i ispod nje"/>
	<INPUT TYPE="label" NAME="Label21" TOP="1742" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Klasa:" TEXT="Label21"/>
	<INPUT TYPE="combo" NAME="fSkladisteId" TOP="2088" LEFT="1699" HEIGHT="302" WIDTH="4954" SQL="select SkladisteId, Opis from Skladiste" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label19" TOP="2088" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Skladište:" TEXT="Label19"/>
	<INPUT TYPE="combo" NAME="fOrgShemaId" TOP="2448" LEFT="1699" HEIGHT="302" WIDTH="4954" SQL="select orgshemaid, space(len(rtrim(coalesce(sortkey, &apos; &apos;))))+ Naziv as naziv from orgshema order by sortkey" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label20" TOP="2448" LEFT="346" HEIGHT="288" WIDTH="1296" CAPTION="Org. shema:" TEXT="Label20"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2880" LEFT="1498" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="2880" LEFT="346" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" ENABLED="TRUE" ONCLICK="OK"/>

</PARAMETRI>
