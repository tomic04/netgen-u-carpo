<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Parametri:MAINFORM" 
          ONLOAD=":MAINFORM" 
          GROUPBYBOXVISIBLE="FALSE" 
          CHECKBOXVISIBLE="FALSE">

  <NAME>Klase tečajeva</NAME>
  <CAPTION>Klase tečajeva</CAPTION>


<MAINFORM NAME="MAINFORM" HEIGHT="3498" WIDTH="5600"
         CAPTION="Fakture-min i max datum" 
         ONLOAD="spFaktureMinMaxDatum @action='popuni_datume'"
         MAXIMIZEBOX="FALSE" WINDOWSTATE="" >

    <INPUT TYPE="group"  NAME="topgroupbox"    DOCK="2" CAPTION="" HEIGHT="700"   />
	
    <INPUT TYPE="label" NAME="lblPitanje"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Unesite datum s kojim se može knjižiti faktura:"/>
   
    <INPUT TYPE="label" NAME="lbldatumod" TOP="1030" LEFT="200" WIDTH="800" CAPTION="Najraniji:"/>
    <INPUT TYPE="date" NAME="datod" TOP="1000" LEFT="1200" WIDTH="1400" CAPTION="Najraniji" CUSTOMFORMAT=""  />
	
	<INPUT TYPE="label" NAME="lbldatumdo" TOP="1530" LEFT="200" WIDTH="800" CAPTION="Najkasniji:"/>
    <INPUT TYPE="date" NAME="datdo" TOP="1500" LEFT="1200" WIDTH="1400" CAPTION="Najkasniji" CUSTOMFORMAT=""  />
	
	
	<INPUT TYPE="button" NAME="cmdDodaj" TOP="2550" LEFT="100" HEIGHT="331" WIDTH="1200" TEXT="ButtonNG44" CAPTION="U redu" ANCHOR="6"
			ONCLICK="spFaktureMinMaxDatum @action='promijeni_datume',@DatOd=@@datod,@DatDo=@@datdo
			         #OK"/>
	<INPUT TYPE="button" NAME="cmdCancel" TOP="2550" LEFT="1400" HEIGHT="331" WIDTH="1200" TEXT="ButtonNG45" CAPTION="Odustani" ANCHOR="6"
			ONCLICK="close"/>
 
</MAINFORM>

</PROJECT>