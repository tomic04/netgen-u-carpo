	<KARTICAPROMETA
	FILLEXPLORER=""
	WIDTH="15800"
		ONSUBMIT=""
	ONLOAD=""
	VERSION="1.3"
	HEIGHT="6000"
	CAPTION="Kartica prometa grla"
	BORDERSTYLE="3"
		>
		
		
		<INPUT TYPE="grid"
				NAME="kprometa"
				TOP="700"
				LEFT="200"
				WIDTH="12000"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="4000"
				CAPTION="Krtica prometa grla "
		REFRESHAFTERCHILD="TRUE"
		SQL="spstKarticaGrla @action = 1, @stgrloid = @@id" 
			   DOCK="5"/>

		<INPUT TYPE="group" NAME="bottomgroupbox" DOCK="2" HEIGHT="1000"  />
		
		<INPUT TYPE="button" NAME="ponisiti"  CAPTION="Poništi promet" TOP="250" LEFT="500" WIDTH="1506" HEIGHT="322" ONCLICK=":PONISTIPROMET" PARENT="bottomgroupbox" />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="250" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close" PARENT="bottomgroupbox" />


	</KARTICAPROMETA>


	<PONISTIPROMET
	FILLEXPLORER=""
	WIDTH="9600"
		ONSUBMIT=""
	ONLOAD="if (select dbo.fnSTZadnjiPrometID(@@id)) &lt;&gt; @@kprometa 
			begin exec spRaiserror 69001,  'Niste odabrali zadnji slog prometa. Ne možete poništiti !' 
			end 
			else begin 
				select stprometglaid from stprometdet where stprometdetid = (select dbo.fnSTZadnjiPrometID(@@id)) 
			end "
	ONLOADED="select * from stprometgla where stprometglaid = @@stprometglaid"
	HEIGHT="6000"
	CAPTION="Poništavanje prometa grla @@gridponistipŽivotni_broj"
		>
		<INPUT TYPE="text" NAME="stprometglaid " TOP="-1300" VIZIBLE="FALSE" />
		<INPUT TYPE="text" NAME="kprometa" TOP="-1300" VIZIBLE="FALSE" />
		<INPUT TYPE="text" NAME="broj" TOP="300" LEFT="2200" CAPTION="Broj dokumenta*" TEXT="" WIDTH="1500" HEIGHT="2300" ENABLED="TRUE" />
		<INPUT TYPE="date" NAME="datumdok" TOP="600" LEFT="2200" CAPTION="Datum*" TEXT="" WIDTH="1500" HEIGHT="1500" ENABLED="TRUE" />
	
		<INPUT TYPE="grid"
				NAME="ponistip"
				TOP="1100"
				LEFT="200"
				WIDTH="9500"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="3800"
				CAPTION="Poništavanje "
		REFRESHAFTERCHILD="TRUE"
		SQL="spstPrometQueryGlaiDet @action = 2, @id= @@stprometglaid, @stgrloid = @@id" />

		<INPUT TYPE="button" NAME="ponisiti"  CAPTION="Poništi promet" TOP="5100" LEFT="500" WIDTH="1506" HEIGHT="322" 
			   ONCLICK="exec spSTZakljucidok @action = 99 , @stprometdetid = @@gridkprometaSTPrometDetId, @operateriid  =@@operateriid #OK"  />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="5100" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</PONISTIPROMET>



