<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT="" 	
		BUTTONS="Parametri:FILTER_FORM" 
		DBLCLICKFORM=":FILTER_FORM"
	  CHECKBOXVISIBLE="FALSE"
    PAGEHEADERCENTER="Pregled povratne naknade Od @@datumod do @@datumdo"
		PAGEHEADERRIGHT="@@tkosmomi"
    PAGEORIENTATION="LANDSCAPE"
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Pregled povratne naknade</NAME>
  <CAPTION>Pregled povratne naknade</CAPTION>


<FILTER_FORM
      NAME="FILTER_FORM"
    CAPTION="Parametri" 
    FILLEXPLORER="TRUE" 
		WIDTH="9000" 
    HEIGHT="3500" 
		ONSUBMIT="spMPPregPovNaknadeNG @action=1, @operateriid = @@operateriid," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstadokid as vrstadokid" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" > 
		
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="true" 
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" DEFAULT="firstdayofmonth"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" DEFAULT="today"/>
    <INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta dokumenta" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
                 SQL="spMPDajVrstadok null"/>
										
</FILTER_FORM>


</PROJECT> 