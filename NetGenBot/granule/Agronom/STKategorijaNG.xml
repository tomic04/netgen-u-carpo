<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTKategorija @action = 1, @operateriid= @@operateriid, @vrsta='G' " 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Pokaži:POKAZI_FORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Kategorije grla"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Kategorije grla</NAME>
	<CAPTION>Kategorije grla</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTKategorija @action = 1, @operateriid= @@operateriid, @vrsta='G' " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Unos kategorije grla"
		 ONSUBMIT="spSTKategorija @action = 3, @operateriid= @@operateriid, @vrsta='G', "
		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"   CAPTION="Naziv kategorije:"  TABINDEX="0"  ENABLED="TRUE"  />
		 <INPUT TYPE="number"  NAME="StarostOd"		   CAPTION="Starost od:"        TABINDEX="1"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
		 <INPUT TYPE="number"  NAME="StarostDo"		   CAPTION="Starost do:"        TABINDEX="2"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="number"  NAME="Mlijeko"		   CAPTION="Mlijeko:"           TABINDEX="3"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Izmjena kategorije grla"
		 ONSUBMIT="spSTKategorija @action = 4, @operateriid= @@operateriid, @ID=@@ID, @vrsta='G', "
		 ONLOAD="select * from stkategorija where stkategorijaId=@@id" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"   CAPTION="Naziv kategorije:"   TABINDEX="0"  ENABLED="TRUE"  />
		 <INPUT TYPE="number"  NAME="StarostOd"		   CAPTION="Starost od:"         TABINDEX="1"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
		 <INPUT TYPE="number"  NAME="StarostDo"		   CAPTION="Starost do:"         TABINDEX="2"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="number"  NAME="Mlijeko"		   CAPTION="Mlijeko:"            TABINDEX="3"  ENABLED="TRUE"  DECIMALS="0"  SQL=""  />
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Brisanje kategorije grla ? Jeste li sigurni ?!"
		 ONSUBMIT="spSTKategorija @action = 5, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from stkategorija where stkategorijaId=@@id" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"             CAPTION="Naziv kategorije:"   ENABLED="FALSE"/>
		 <INPUT TYPE="number"  NAME="StarostOd"		   CAPTION="Starost od:"         ENABLED="FALSE"  DECIMALS="0"  SQL=""  />
		 <INPUT TYPE="number"  NAME="StarostDo"		   CAPTION="Starost do:"         ENABLED="FALSE"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="number"  NAME="Mlijeko"		   CAPTION="Mlijeko:"            ENABLED="FALSE"  DECIMALS="0"  SQL=""  />
</DELETE_FORM>

</PROJECT>