<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
	BUTTONS=""
	POPUPMASTER="" 
	MASTERDBLCLICK="MPKARTICA"
	GROUPBYBOXVISIBLE="TRUE" 
	ONLOAD="select 1"
	COMMANDTIMEOUT="600"
	FROZENCOLUMNS="0" 
	CHECKBOXVISIBLE="FALSE">
	
<NAME>Slanje podataka na kase</NAME>
<CAPTION>Slanje podataka na kase</CAPTION>
	

<MAINFORM 
		NAME=" MAINFORM " 
		HEIGHT="3000" 
		WIDTH="6000"
		COMMANDTIMEOUT="600"
		ONESCKEY="select 1"
		INCLUDEE=""
		CAPTION="Priprema podataka za blagajne "
		ONLOAD="SELECT @@trgpvinaid as trgovinaid"
		MAXIMIZEBOX="TRUE" 
		FOCUS="trgovinaid" 
		WINDOWSTATE="0">



	<INPUT TYPE="group" NAME="topgroupbox" DOCK="1" CAPTION="Uvjeti:" TOP="200" LEFT="100" HEIGHT="2200"  WIDTH="5500"   />

	<INPUT TYPE="combo" NAME="Trgovinaid" TOP="250" LEFT="1200" WIDTH="4500" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid" ALLOWEMPTY="TRUE" CAPTION="Trgovina:*"/>


	<INPUT TYPE="button" NAME="b1" CAPTION="Odustani" PARENT="topgroupbox" TOP="1250" LEFT="500" WIDTH="1500" HEIGHT="322" ONCLICK="close" HOTKEY="" />
	<INPUT TYPE="button" NAME="b2" CAPTION="Pripremi" PARENT="topgroupbox" TOP="1250" LEFT="2500" WIDTH="1500" HEIGHT="322" ONCLICK="exec spMPPripremiStanjeZaKasuNEW @trgovinaid = @@trgovinaid#OK" HOTKEY="" />
</MAINFORM>

	


	
</PROJECT>