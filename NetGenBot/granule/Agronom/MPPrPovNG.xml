<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="" 
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="" 
      MASTERDBLCLICK=""
      POPUPMASTER=""
   PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">
 
  <NAME>Isporuke i povrata robe u maloprodaji </NAME>
  <CAPTION>Isporuke i povrata robe u maloprodaji </CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>

  <MASTERCOLUMNS>
    <COLUMN INDEX="14" NAME="Efikasnost %1000" WIDTH="1200" CAPTION="" FORMAT="#,##0.###" VISIBLE="" AGREGATEFUNCTION="3" />
    <COLUMN INDEX="15" NAME="Efikasnost %1000" WIDTH="1200" CAPTION="" FORMAT="#,##0.###" VISIBLE="" AGREGATEFUNCTION="3" />
  </MASTERCOLUMNS>


  <FILTERFORM 
      FILLEXPLORER="TRUE" 
      REPORT=""  
      WIDTH="9000" 
      ONSUBMIT="spMPPregledPovrataIzTrg @action = 1, @operateriid = @@operateriid, " 
      ONLOAD="" 
      HEIGHT="3800" 
      CAPTION="Upišite uvjete "  
      BORDERSTYLE="3" 
      CMD1CAPTION="Pokaži ->>" 
      CMD2CAPTION="Odustani" 
      CMD3CAPTION=""  
      NEXTFORM=""  >

	  <INPUT TYPE="combo" NAME="Trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="TRUE" 
				  SQL="spMPDajTrgovina @@operateriid"  />

	  <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="today" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today" HEIGHT="320" WIDTH="1500" TABINDEX="3" CHECKBOX="FALSE"/>
	  <INPUT TYPE="combo" NAME="skladisteid" CAPTION="Skladište" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="TRUE" 
				  SQL="spMPDajSkladiste @@operateriid"  />

    <INPUT TYPE="search"  CAPTION="Klasa" NAME="klasaid"  WIDTH="5500" HEIGHT="320" TABINDEX="3"
          SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
    
	  <!--<INPUT TYPE="TRAZILICA"  CAPTION="Klasa" NAME="klasaid"  TABINDEX="3"  WIDTH="5500" HEIGHT="320"
		  SQL="ViKlaseRobe#klmasterrobaid#%Naziv%" />-->

	  <INPUT TYPE="check" NAME="podklase" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase"/>

</FILTERFORM>

<FILTERFORM1 
      FILLEXPLORER="TRUE" 
      REPORT=""  
      WIDTH="8000" 
      ONSUBMIT="spObilazakRoba " 
      ONLOAD="select partneriid from partneri where partneriid = @@partneriid" 
      HEIGHT="4800" 
      CAPTION="Upišite uvjete "  
      BORDERSTYLE="3" 
      CMD1CAPTION="Pokaži" 
      CMD2CAPTION="Odustani" 
      CMD3CAPTION=""  
      NEXTFORM=""  >

      <INPUT TYPE="label" NAME="lbl1" TOP="1100" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Razdoblje"/>
      <INPUT TYPE="date" NAME="datumod" TOP="1000" LEFT="2200" CAPTION="Datum od" DEFAULT="today" HEIGHT="320" WIDTH="1500" TABINDEX="1" CHECKBOX="FALSE"/>
      <INPUT TYPE="date" NAME="datumdo" TOP="1000" LEFT="4200" CAPTION="Datum do" DEFAULT="today" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE"/>

      <INPUT TYPE="combo" NAME="Partneriid" CAPTION="Partner" TOP="1500" LEFT="2200"  WIDTH="5500" HEIGHT="320" TABINDEX="3" ALLOWEMPTY="FALSE" ENABLED="FALSE"
              SQL="select partneriid, naziv from partneri order by naziv"  /> 

      <INPUT TYPE="combo" NAME="parstruid" CAPTION="Lokacija" TOP="2000" LEFT="2200"  WIDTH="5500" HEIGHT="320" TABINDEX="4" ALLOWEMPTY="FALSE" 
              SQL="select ps.parstruid, rtrim(ps.naziv)+', '+rtrim(m.hptbroj)+' '+rtrim(m.naziv)+', '+ rtrim(ps.adresa) as naziv 
                    from parstru ps left outer join mjesta m on ps.mjestaid = m.mjestaid where ps.partneriid = @@partneriid order by 2"  /> 


  </FILTERFORM1>

  


</PROJECT>
 
