<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>

<PROJECT 
DETAILGRID = ""
MASTERDBLCLICK=""
MULTIGRIDLAYOUT="TRUE" 
CMD1CAPTION="Parametri:FILTERFORM" 
CMD2CAPTION=""
CMD3CAPTION="" 
CMD4CAPTION="" 
CMD5CAPTION="" 		
CMD6CAPTION=""
CMD7CAPTION="Lista" 
CMD8CAPTION="" 
POPUPMASTER="Filter:FILTERFORM" 
TREE=""
GROUPBYBOXVISIBLE="TRUE" 
ONLOAD=":FILTERFORM"   
CHECKBOXVISIBLE="FALSE"
DETCHECKBOXVISIBLE="FALSE"
TOTALROWVISIBLE="FALSE"
DETTOTALROWVISIBLE="FALSE"
SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi" 
REPORT=""
PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid od @@datumod do @@datumdo"
PAGEHEADERCENTER="Najprodavaniji artikli, top @@top, sortirano po: @@comboboxorderBy"
PAGEHEADERRIGHT="@@tkosmomi"
COMMANDTIMEOUT="600">

 


<NAME>Najprodavaniji artikli</NAME>
<CAPTION>Najprodavaniji artikli</CAPTION>


<FILTERFORM 
	NAME="FILTERFORM" 
	HEIGHT="4000" WIDTH="6910" 
	CAPTION="Parametri" 
	ONSUBMIT="spMPNajArtikliAgronom @datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@trgovinaid, @top = @@top, @bojaid = @@bojaid, @orderBy = '@@orderBy'!!"
	ONLOAD="select '@@baza' as baza, '@@baza2' as baza2, '@@tablica' as tablica, '@@tablica2' as tablica2, @@mpskriptaid as mpskriptaid, '@@string' as string, '@@string2' as string2" 
	ONLOADED="select 'Količina' as orderby"
	FILLEXPLORER="TRUE">

  <INPUT TYPE="frame" NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6500" HEIGHT="2400" />
  <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od:*" TOP="400" LEFT="1300" WIDTH="1200" HEIGHT="320"/>
  <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do:*" TOP="400" LEFT="3700" WIDTH="1200" HEIGHT="320"/>
  <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" ALLOWEMPTY="TRUE" TOP="800" LEFT="1300" WIDTH="4000" ONLOSTFOCUS="" 
         SQL="spmpdajtrgovinang @operateriid = @@operateriid " />
  <INPUT TYPE="number" NAME="top"   CAPTION="Top:*" TOP="1200" LEFT="1300" WIDTH="1000" HEIGHT="320" DECIMALS="0" />
  <INPUT TYPE="combo" NAME="bojaid" CAPTION="Boja*" TOP="1600" LEFT="1300"  WIDTH="4000" HEIGHT="320" ALLOWEMPTY="TRUE"
	     SQL="select id, boja from ManRobaBoja order by boja"/>
  <INPUT TYPE="combo" NAME="orderBy" ALLOWEMPTY="FALSE" CAPTION="Sortiraj po:*" TOP="2000" LEFT="1300" WIDTH="4000" HEIGHT="320" 
         SQL="select 'Količina' as naziv union all 
              select 'MP Vrijednost' as naziv" />
  
  <INPUT TYPE="button" NAME="ok" CAPTION="Prikaži" TOP="2800" LEFT="300" WIDTH="1700" HEIGHT="520" ONCLICK="OK"  />
  <INPUT TYPE="button" NAME="odustani" CAPTION="Zatvori (ESC)" TOP="2800" LEFT="2300" WIDTH="1700" HEIGHT="520" ONCLICK="close"  />
</FILTERFORM>

  
</PROJECT>