<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object = '@@xmlname' "
ONLOAD=":FORM1"
PERMISSIO="TRUE"
REPORT=""
CMD1CAPTION="Parametri:FORM1"
DETAILGRID="spMPPonudaFiskalizacija @action = 2, @iD = @@id"
CMD2CAPTION=""
CMD3CAPTION="FISKALIZACIJA : FISKALIZACIJAPD(@@id)#:VRIJEMEJIR#REFRESHMASTER"
CMD4CAPTION=""
CMD5CAPTION=""
CMD6CAPTION=""
ONLOAD2="select 'FISKALIZACIJA' = case when @@FSKALIZACIJA=1 then 'enable' else 'disable' end"
MASTERDBLCLICK="">


	<NAME>Pregled nefiskaliziranih MP pratećih dokumenata</NAME>
	<CAPTION>Pregled nefiskaliziranih MP pratećih dokumenata</CAPTION>


<FORM1 	
	FILLEXPLORER="TRUE"
	WIDTH="9000"
	ONSUBMIT="spMPPonudaFiskalizacija @action = 1, @operateriid = @@operateriid,"
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid"
	HEIGHT="4000"
	CAPTION="Parametri"
	BORDERSTYLE="3"
	CMD1CAPTION="Pokaži"
	CMD2CAPTION="Odustani"
	CMD3CAPTION=""
	CHILDFORM="">

	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid"/>
</FORM1>

	
<VRIJEMEJIR 	
	FILLEXPLORER=""
	WIDTH="9000"
	ONSUBMIT="spMPPonudaFiskalizacija @action = 3, @id = @@id"
	ONLOAD=""
	HEIGHT="4000"
	CAPTION="Parametri"
	BORDERSTYLE="3"
	CMD1CAPTION="Pokaži"
	CMD2CAPTION="Odustani"
	CMD3CAPTION=""
	CHILDFORM="">
</VRIJEMEJIR>

</PROJECT>


