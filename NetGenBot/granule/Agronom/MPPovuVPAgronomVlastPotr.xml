<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT

		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @sifradok = '119',  @trazi ='%vl%potr%' "
		ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end , 
			'Zakljuci' = case when @@Zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 
			'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end "
		DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 1"
		BUTTONS="Dodaj:INSERTFORM#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Pronađi:FILTERFORM#Print dok.:MULTISELECTISPIS_FORM"
		MASTERDBLCLICK="UPDATE_FORM"
		POPUPMASTER="Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ#Storniraj#STORNO" 
		TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		GROUPBYBOXVISIBLE="TRUE" 
		CHECKBOXVISIBLE="TRUE"
		TOTALROWVISIBLE="TRUE"
		COMMANDTIMEOUT="300"
		DETTOTALROWVISIBLE="FALSE"
		DETCHECKBOXVISIBLE="FALSE"
		PAGEORIENTATION="LANDSCAPE"
		REPORT="">



	<NAME>Povrat iz MP u VP-vlast.potrošnja</NAME>
	<CAPTION>Povrat iz MP u VP-vlast.potrošnja</CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas', @sifradok = '119', @vrstadokid=@@vrstadokid, @nenc = 1" />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @sifradok = '119', @vrstadokid=@@vrstadokid, @nenc = 1" />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @sifradok = '119', @vrstadokid=@@vrstadokid, @nenc = 1" />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = '119', @vrstadokid=@@vrstadokid, @nenc = 1" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '119', @vrstadokid=@@vrstadokid, @nenc = 1" />



<INSERTFORM
	NAME="INSERTFORM" HEIGHT="3500" WIDTH="12000"
	CAPTION="Unos povratnice iz MP u VP"
	ONSUBMIT=""
	ONLOAD="select convert(varchar,getdate(),112) as datumdok"
	NEXTFORM="UPDATE_FORM"
	FOCUS="trgovinaid">

	<INPUT TYPE="frame"  NAME="fr1"  CAPTION="Zaglavlje:" TOP="28" LEFT="56" WIDTH="11500" HEIGHT="2200" STYLE="1" DOCK="1" />
	<INPUT TYPE="frame"  NAME="fr3"  CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />

	<INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*"     TOP="400" LEFT="1500" WIDTH="1500"  />
	<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="400"  LEFT="8200" WIDTH="3500" ALLOWEMPTY="FALSE" ENABLED="TRUE" 
		   SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" ONLOSTFOCUS="select 'refresh' as osobeid, 'refresh' as skladisteid"/>
	<INPUT TYPE="combo"  NAME="vrstadokid"  CAPTION="Vrsta povratnice*" TOP="750" LEFT="1500" WIDTH="3500" ENABLED="FALSE" 
		   SQL="select vrstadokid, opis as naziv from vrstadok where vrstadokid = @@vrstadokid" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="combo"  NAME="osobeid"		CAPTION="Odgovorna osoba*"  TOP="750"  LEFT="8200" SQL="spMPDajosobe @trgovinaid = @@trgovinaid"  WIDTH="3500" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="combo" NAME="skladisteid"  CAPTION="Skladište*"   TOP="1100"  LEFT="1500" WIDTH="3500" 
		   SQL="spMPDajSkladisteNG @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" ONCLICK="" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="text"   NAME="napomena"    CAPTION="Napomena*"       TOP="1450" LEFT="1500" WIDTH="10200"  />

	<INPUT TYPE="button" NAME="ok"          CAPTION="Stavke >>"  TOP="2500" LEFT="1000" ONCLICK="spMPInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = '119', ++#Ok"  />
	<INPUT TYPE="button" NAME="cancel"      CAPTION="Odustani"  TOP="2500" LEFT="8000" ONCLICK="close"  />
</INSERTFORM>

	
	
<UPDATE_FORM 
	CAPTION="Izmjena dokumenta : @@broj [ @@id ]" 
	HEIGHT="9000" 
	WIDTH= "12000" 
	FILLEXPLORER="" 
	FOCUS="robaid" 
	ONLOAD="if (select status from maloprodajagla  where maloprodajaglaid = @@ID ) = 2 begin 
			exec spRaiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
			end else begin
			if @@id = 0  begin 
			exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos;
			end else begin 
			exec spMPQueryGlaIDetNG @action=3 ,@ID=@@ID, @operateriid = @@operateriid end end "
  ONLOADED="spmpOperaterlock @action = 1, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#select 0 as indpak "
  ONESCKEY="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
  ONCLOSED="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
  >


	<INPUT TYPE="frame"  NAME="fr4"           CAPTION=""  WIDTH="1800" STYLE="1" DOCK="4" />
	<INPUT TYPE="frame"  NAME="fr2"           CAPTION="Nova stavka dokumenta :" TOP="2650" LEFT="50" WIDTH="11500" HEIGHT="2000"   STYLE="1" DOCK="1"  />
	<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Zaglavlje:" TOP="28" LEFT="50" WIDTH="11500" HEIGHT="2200"  STYLE="1" DOCK="1" />
	<INPUT TYPE="frame"  NAME="fr3"           CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />


	<INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*"     TOP="400"  LEFT="1500"   />
	<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="400"  LEFT="8200" ENABLED="FALSE" WIDTH="3500" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"/>
	<INPUT TYPE="text"   NAME="broj"        CAPTION="_Broj*"     TOP="750"  LEFT="1500" ENABLED="FALSE" WIDTH="3500" SQL=""  />
	<INPUT TYPE="combo"  NAME="vrstadokid"  CAPTION="Vrsta dokumenta*" TOP="1100" LEFT="1500" WIDTH="3500" ENABLED="FALSE" SQL="spMPDajVrstadok @sifra = '119', @aktivni=1" />
	<INPUT TYPE="combo"  NAME="osobeid"		CAPTION="Odgovorna osoba*"  TOP="1100"  LEFT="8200" SQL="spMPDajosobe @trgovinaid = @@trgovinaid"  WIDTH="3500"/>
	<INPUT TYPE="combo" NAME="skladisteid"  CAPTION="Skladište*"   TOP="1450"  LEFT="1500" WIDTH="3500" 
		   SQL="spMPDajSkladisteNG @trgovinaid = @@trgovinaid ,@operateriid=@@operateriid" ONCLICK="" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="text"   NAME="napomena"    CAPTION="Napomena*"       TOP="1800" LEFT="1500" WIDTH="10200"  />

	<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="2650" LEFT="1500" WIDTH="8000" ALLOWEMPTY="FALSE" HEIGHT="280"
		   SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid', @skladisteid = @@skladisteid"
		   ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid, @trgovinaid = @@trgovinaid
						#if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @Skladisteid = @@skladisteid, @datum = @@datumdok,@partneriid = null, @vrstadokid = @@vrstadokid, @sifradok = '119' end
						#:KOLPAK@@indpak#select @@pakovanje as kolicina#select 'kolicina' as focus#if coalesce(@@indpak,0)=0 begin select 0 as kolicina end" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
	<INPUT TYPE="text"   NAME="indpak"    CAPTION=""       TOP="-1610" LEFT="8000" WIDTH="1500"  />
	<INPUT TYPE="number"   NAME="kolpakovanje"    CAPTION=""       TOP="-1610" LEFT="8000" WIDTH="1500"  />
	<INPUT TYPE="text"   NAME="jmnaziv"	  CAPTION="JM*" TOP="2650" LEFT="10200" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
	<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina*" TOP="3000" LEFT="1500" WIDTH="1500" HEIGHT="280" DECIMALS="4" SQL=""  />
	<INPUT TYPE="number" NAME="mpcijena"	  CAPTION="MP Cijena*" TOP="3350" LEFT="1500" WIDTH="1500" HEIGHT="280" ENABLED="FALSE" SQL="select dbo.fnMPdajMPC(@@robaid, @@trgovinaid, @@datumdok )"  />
	<INPUT TYPE="number" NAME="nabcijena"	  CAPTION="Nabavna cijena*" TOP="3350" LEFT="4500" WIDTH="1500" HEIGHT="280" ENABLED="FALSE" SQL=""  />
	<INPUT TYPE="number" NAME="sktstanje"	  CAPTION="Kol.na skladištu*" TOP="3350" LEFT="7500" WIDTH="1500" HEIGHT="280" ENABLED="FALSE" SQL=""  />
	<INPUT TYPE="text"   NAME="opisdet"      CAPTION="Napomena*"  TOP="3700" LEFT="1500" WIDTH="8000" HEIGHT="280" ALLOWEMPTY="TRUE" SQL=""  />

	<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dodaj (F8)" TOP="3700" LEFT="10200" WIDTH="1428"
	   ONCLICK="if @@kolicina > 99 begin
                      declare @message varchar(1500)
                      set @message = 'UPOZORENJE:' + CHAR(13) + CHAR(10)
                      set @message += 'Količina povrata je troznamenkasta. +OK'
                      exec spRaiserror 69001, @message
                    end
          #spMPInsertGlaIdetNG @action=3,@robaid=@@robaid,@id=@@id,@NabCijena=@@nabcijena,@kolicinaulaz=@@kolicina, @mpcijena=@@mpcijena, @opisdet='@@opisdet', @porukagreska = 1
					#select cmpiznos , nabiznos from maloprodajagla where maloprodajaglaid = @@id
					#select '' as roba , 'robaid' as focus, robaid = null, kolicina = 0, nabcijena = 0, mpcijena = 0, sktstanje = 0, indpak=0, kolpakovanje=0, opisdet = null, 'refreshmovelast' as stavke " HOTKEY="F8" />


	<INPUT TYPE="grid" DOCK="5"
	   NAME="stavke"
	   REFRESHAFTERCHILD=""
	   CAPTION="Stavke"
	   TOP="5000" LEFT="100" WIDTH="10000" HEIGHT="2500"
	   TABINDEX="-1"
	   AFTERREFRESH="select cmpiznos,nabiznos from maloprodajagla where maloprodajaglaid = @@id"
	   POPUP="Obriši:BRISISTAVKU"
	   ONDBLCLICK=":IZMJENISTAVKU"
	   EDITCOLUMNS="kol.ulaz0800"
	   ONCELLEDITED="spMPInsertGlaIdetng @action=4, @maloprodajadetid = @@stavke, @id = @@id, @kolicinaulaz = @(stavke..kol.ulaz0800)#select 'stavke' as focus
                    #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id
                    #if @(stavke..kol.ulaz0800) > 99 begin
                      declare @message varchar(1500)
                      set @message = 'UPOZORENJE:' + CHAR(13) + CHAR(10)
                      set @message += 'Količina povrata je troznamenkasta. +OK'
                      exec spRaiserror 69001, @message
                    end"
	   CHECKBOXVISIBLE="FALSE"
	   PAGEHEADERCENTER="Povratnica iz MP u VP br.@@broj"
	   PAGEHEADERRIGHT=""
	   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
	   PAGEFOOTERCENTER=""
	   PAGEFOOTERLEFT=""
	   PAGEFOOTERRIGHT="@@tkosmomi"
	   PAGEORIENTATION="LANDSCAPE"
	   GROUPBYBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"
	   SQL="spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 1" />

	<INPUT TYPE="number" NAME="nabiznos" ANCHOR="6" CAPTION="Ukupna Nab.Vrijed.*" TOP="8000" LEFT="5000" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
	<INPUT TYPE="number" NAME="cmpiznos" ANCHOR="6" CAPTION="Ukupna MP Vrijed.*" TOP="8000" LEFT="9000" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>

	<INPUT TYPE="button" NAME="ok" ANCHOR="6" CAPTION="Spremi (F2)" TOP="8000" LEFT="196" WIDTH="1106" HEIGHT="322" HOTKEY="F2"
		   ONCLICK="#exec spmpDonesiAmbalazu @action = 1, @maloprodajaglaid = @@id
					#spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = '119',@status = 1, @datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @skladisteid = @@skladisteid#Ok"  />
	<INPUT TYPE="button" NAME="cancel" ANCHOR="6" CAPTION="Odustani" TOP="8000" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	<INPUT TYPE="button" NAME="ispravi" ANCHOR="9" CAPTION="Ispravi" TOP="4600" LEFT="10200" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
	<INPUT TYPE="button" NAME="obrisi" ANCHOR="9" CAPTION="Obriši" TOP="5200" LEFT="10200" WIDTH="1400" HEIGHT="322" ONCLICK="FOREACHBLUEROW(stavke)#:BRISISTAVKU#select 'refresh' as stavke"  />
	<INPUT TYPE="button" NAME="donesi" ANCHOR="9" CAPTION="Donesi" TOP="5800" LEFT="10200" WIDTH="1400" HEIGHT="322" ONCLICK=":DONESI#select 'refresh' as stavke"  />
	<INPUT TYPE="button" NAME="povdnev" ANCHOR="9" CAPTION="Donos dnevnih proizvodi" TOP="6400" LEFT="10200" WIDTH="1400" HEIGHT="622" 
		   ONCLICK="spmpPovDnevnih @action = 0 , @trgovinaid=@@trgovinaid,@datumdok = @@datumdok , @id = @@id , @rok = 1
					#select 'refresh' as stavke"  />

</UPDATE_FORM>



