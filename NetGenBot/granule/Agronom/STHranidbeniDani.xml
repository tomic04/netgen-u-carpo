<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Uvjeti:FILTERFORM" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 MULTIGRIDLAYOUT="TRUE" 
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT="">



	<NAME>Pregled hranidbenih dana </NAME>
	<CAPTION>Pregled hranidbenih dana </CAPTION>



	<MASTERCOLUMNS>
		<COLUMN INDEX="7" NAME="" WIDTH="1500" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="9" NAME="" WIDTH="1500" CAPTION="" FORMAT="#,##0.00" VISIBLE="" AGREGATEFUNCTION="3" STYLE="1"/>
	</MASTERCOLUMNS>



	<FILTERFORM NAME="FILTERFORM" HEIGHT="4000" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spstStanjeNaDanNew @action = 3, @granula = '@@xmlname',  @operateriid= @@operateriid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Od datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Do datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""/>
		<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 111, @trazi = '@@searchboxprnradninalogid'"/>
		<INPUT TYPE="check" NAME="analitikadan" CAPTION="Analitika po datumima" WIDTH="3000"/>
		<INPUT TYPE="check" NAME="analitikamjesec" CAPTION="Analitika po mjesecima" WIDTH="3000"/>
	</FILTERFORM>




</PROJECT>