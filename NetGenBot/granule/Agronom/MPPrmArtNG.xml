<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
ONLOAD=":FILTERFORM" 
DETAILGRID = ""
MASTERDBLCLICK=""
CMD1CAPTION="Parametri:FILTERFORM" 
CMD2CAPTION=""
CMD3CAPTION="" 
CMD4CAPTION="" 
CMD5CAPTION="Ispis liste:PRINTMASTER" 		
POPUPMASTER="Filter:FILTERFORM" 
POPUPDETAIL=""
TREE=""
GROUPBYBOXVISIBLE="TRUE"
MULTIGRIDLAYOUT="TRUE"
CHECKBOXVISIBLE="FALSE"
DETCHECKBOXVISIBLE="FALSE"
TOTALROWVISIBLE="FALSE"
DETTOTALROWVISIBLE="FALSE"
SETDEFAULTS="" 
ONLOAD2="" 
REPORT=""
COMMANDTIMEOUT="600"
PAGEHEADERCENTER="Pregled prometa artikala MP @@NoviRed Od @@datumod do @@datumdo"
PAGEHEADERRIGHT="@@tkosmomi"
PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid @@NoviRed @@comboboxvrstadokid "
PAGEFOOTERCENTER=""
PAGEFOOTERLEFT=""
PAGEFOOTERRIGHT=""
PAGEORIENTATION="LANDSCAPE">


	<NAME>Pregled prometa artikala MP</NAME>
	<CAPTION>Pregled prometa artikala MP</CAPTION>
	<AUTOR>4.6.2009. im </AUTOR>



<FILTERFORM 
	NAME="FILTERFORM" 
	HEIGHT="5254" WIDTH="7710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPPrmArtNG @action = 1, @operateriid= @@operateriid, "
	ONLOAD="select char(13)+char(10) as NoviRed, dbo.fnTkoSmoMi() as tkosmomi, @@trgovinaid as trgovinaid, @@vrstadokid as vrstadokid, @@vrstapromid as vrstapromid, @@datumod as datumod, @@datumdo as datumdo " 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >
		 
	<INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:" DEFAULT="firstdayofmonth"/>
	<INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:" />
	<INPUT TYPE="combo"  NAME="vrstapromid"     CAPTION="Vrsta prometa:" ALLOWEMPTY="TRUE"  ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm" />
	<INPUT TYPE="combo"  NAME="vrstadokid"      CAPTION="Vrsta dokumenta:" ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="spMPDajVrstaDok @vrstapromid = @@vrstapromid" />
	<INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:" ALLOWEMPTY="TRUE"  ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid" />
	<INPUT TYPE="search" NAME="partneriid"      CAPTION="Partner:" SQL="viPartneri#partneriid#naziv%#sifra#poreznibroj#!matbroj#!adresa#!mjestanaziv" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />  
	<INPUT TYPE="combo"  NAME="skladisteid"     CAPTION="Skladište:" ALLOWEMPTY="TRUE"  SQL="spMPDajSkladisteNG @trgovinaid = @@trgovinaid, @operateriid = @@operateriid" />
	<INPUT TYPE="search" NAME="klmasterrobaid"  CAPTION="Klasa:" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'"/>
	<INPUT TYPE="check" NAME="podklase"			CAPTION="pokaži i sve podklase" />
	<INPUT TYPE="search" NAME="robaid"			CAPTION="Roba:" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
	<INPUT TYPE="combo" NAME="combo1"			CAPTION="Vrsta robe " ALLOWEMPTY="TRUE" SQL="select 1 as id, ' Vlastita roba' as naziv union all select 0, 'Trgovačka roba'"/>


</FILTERFORM>



</PROJECT>