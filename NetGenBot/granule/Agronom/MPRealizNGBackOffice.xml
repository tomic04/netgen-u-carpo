<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
	ONLOAD=":FORM1"  		
	REPORT="" 	
	CMD1CAPTION="Parametri:FORM1" 
	CMD2CAPTION="" 
	CMD3CAPTION="" 
	CMD4CAPTION="Kartica:KARTICA"
	CMD5CAPTION="" 
	CMD6CAPTION=""
	PAGEHEADERRIGHT="@@TkoSmoMi"  
	PAGEHEADERCENTER="Realizacija robe u MP @@NoviRed Od @@datumod do @@datumdo"                                                             
	PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid @@NoviRed Vrsta dokumenta: @@comboboxvrstadokid"
	PAGEORIENTATION="LANDSCAPE" 
	SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname'" 
	MASTERDBLCLICK="KARTICA"
	POPUPMASTER=""> 
 

  <NAME>Realizacija robe u MP </NAME>
  <CAPTION>Realizacija robe u MP </CAPTION>
  

<FORM1 	
	FILLEXPLORER="TRUE" 
	WIDTH="9000" 
	ONSUBMIT="spMPRealizacijaRobeNG @action=1, @operateriid = @@operateriid,  " 
	ONLOAD="select @@datumod as datumod , @@datumdo as datumdo , @@trgovinaid as trgovinaid, char(13)+char(10) as NoviRed, dbo.fnTkoSmoMi() as tkosmomi" 
	HEIGHT="5500" 
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION="" 
	CHILDFORM=""> 


	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="FALSE" 
		   SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>
	<INPUT TYPE="search" NAME="robaid" CAPTION="Roba" WIDTH="5500" HEIGHT="320" SQL="roba#robaid#%Naziv%#robakod%#userid%#barcode%" TABINDEX="2"/> 
	<INPUT TYPE="text" NAME="search" CAPTION="Traženje pojma" WIDTH="5500" HEIGHT="320" TABINDEX="3"/>

  <INPUT TYPE="search"  CAPTION="Klasa" NAME="klasaid"  WIDTH="5500" HEIGHT="320" TABINDEX="3"
      SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
  
  <!--<INPUT TYPE="search" NAME="klasaid" CAPTION="Klasa" WIDTH="5500" HEIGHT="320" SQL="ViKlaseRobe#klmasterrobaid#Naziv%" TABINDEX="3"/>--> 
	
  <INPUT TYPE="checkbox" NAME="podklase" CAPTION="pokaži i sve podklase" WIDTH="3500" HEIGHT="320"/>
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" VALUE="DATE2" WIDTH="1500" HEIGHT="320" TABINDEX="4" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" VALUE="DATE" WIDTH="1500" HEIGHT="320" TABINDEX="5" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta dokumenta" WIDTH="5500" HEIGHT="320" TABINDEX="6" ALLOWEMPTY="true" SQL="spmpdajvrstadokmoze 2,null"/>
	<INPUT TYPE="combo" NAME="partneriid" CAPTION="Dobavljač" WIDTH="5500" HEIGHT="320" TABINDEX="7" ALLOWEMPTY="true" SQL="select PartneriId, naziv from partneri where exists (select dobavljacid from roba where dobavljacid is not null and dobavljacid=partneri.partneriid)"/>

</FORM1>

	
<KARTICA 	
	FILLEXPLORER="TRUE" 
	WIDTH="16000" 
	ONSUBMIT="" 
	ONLOAD="" 
	HEIGHT="9500" 
	CAPTION="Kartica robe" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Kraj" 
	CHILDFORM="">

	
	<INPUT TYPE="grid" NAME="gridkartica" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="15500" HEIGHT="8000" TABINDEX="2" TOTALROW="FALSE"
		   SQL="spMaloprodajaStanjeKartica @action = 1, @robaid = @@id, @prikaz= 0, @trgovinaid = @@trgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @totalgen= 1,@operateriid = @@operateriid " />

</KARTICA>


</PROJECT> 