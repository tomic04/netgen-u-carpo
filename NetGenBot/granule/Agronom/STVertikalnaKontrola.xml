<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD="spSTVertikalnaKontrola @action = 1 "  		
		 DETAILGRID = "spSTVertikalnaKontrola @action = 2 , @stfarmeid = @@id"
		CMD1CAPTION="Izmjeni:IZMJENI" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE" 
	        POPUPMASTER=""> 
 

  <NAME>Vertikalna kontrola pristupa</NAME>
  <CAPTION>Vertikalna kontrola pristupa</CAPTION>


	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="5254"
		WIDTH="7710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregArtng @operateriid= @@operateriid, "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid"
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstapromid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
		<INPUT TYPE="combo" NAME="klmasterrobaid" WIDTH="5500" SQL="select KlMasterRobaid, oznaka+&apos;&apos;+naziv as naziv from KlMasterRoba order by SortKey" ALLOWEMPTY="TRUE" CAPTION="Klasa robe:"/>
		<INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" />
		<INPUT TYPE="combo" NAME="dodatnaklasaid"  WIDTH="5500" SQL="select klrobaid, oznaka+&apos;&apos;+naziv as naziv from KlRoba order by SortKey" ALLOWEMPTY="TRUE" CAPTION="Dodatna Klasa robe:"/>

	</FILTERFORM>


	<IZMJENI FILLEXPLORER=""
		   WIDTH="6000"
		   ONSUBMIT=""
		   ONLOAD="select null as operater"
		   HEIGHT="7000"
		   CAPTION="Ažuriranje vertikalne kontrole pristupa"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION=""
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="combo" NAME="operater"
			ALLOWEMPTY="TRUE" TOP="500" LEFT="1000" CAPTION="Operater:*" ONLOSTFOCUS="select 'refresh' as grid1" SQL="select operateriid, naziv from ssoperateri order by naziv" />

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="1000" LEFT = "1000" WIDTH="3500" HEIGHT="4500" TABINDEX="2"
					 SQL="spSTDajFarme @action = 2" ONLOSTFOCUS=""/>
		
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Spremi" TABINDEX="2" TOP="5800" LEFT="1280" WIDTH="1428" HEIGHT="322"
			   ONCLICK="delete from stfarmePrava where operateriid = @@operater
				   #FOREACHSELECTED(grid1)#spSTVertikalnaKontrola @action = 3 , @operateriid = @@operater, @stfarmeid = @@grid1#OK" HOTKEY="F8" />
		<INPUT TYPE="button" NAME="cancel" 		CAPTION="Odustani" TABINDEX="3" TOP="5800" LEFT="3280" WIDTH="1428" HEIGHT="322" ONCLICK="close" HOTKEY="F8" />

	</IZMJENI>

</PROJECT>
