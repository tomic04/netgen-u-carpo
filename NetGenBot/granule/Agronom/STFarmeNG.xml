	<SKLADISTA NAME="SKLADISTA"
		 HEIGHT="6400"
		 WIDTH="7700"
		 CAPTION="Ažuriranje skladišta uz farmu"
		 ONSUBMIT=""
		 ONLOAD=""
		 NEXTFORM=""
		 FOCUS=""
		 CMD1CAPTION=""
		 CMD2CAPTION="" >


		<INPUT TYPE="combo"  NAME="SkladisteId"	    CAPTION="Skladište*"  TOP="1050" LEFT="1100" WIDTH="5500" SQL="select skladisteid, ltrim(rtrim(oznaka)) + ' - ' +ltrim(rtrim(opis)) as naziv from skladiste order by naziv"/>
	<INPUT TYPE="button" NAME="Dodaj"	          CAPTION="Dodaj &gt;" TABINDEX="16" TOP="1450" LEFT="1000" WIDTH="800"
           ONCLICK="spSTFarme @action=7, @id=@@id, @skladisteid=@@skladisteid#select 'refresh' as SkladistaGrid#select 'refresh' as SkladistaGrid#OKSTAY"/>
	<INPUT TYPE="grid"   NAME="SkladistaGrid" TABINDEX="-1" TOP="2000" LEFT="1100" WIDTH="5500" HEIGHT="2600" GROUPBYBOXVISIBLE="FALSE" CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE"
           SQL="select l.lnfarmaskladisteid, l.skladisteid, ltrim(rtrim(s.oznaka)) + ' - ' +ltrim(rtrim(s.opis)) as [Skladište4700] from lnfarmaskladiste l inner join skladiste s on l.skladisteid=s.skladisteid where l.stfarmeid=@@id"
           ONDBLCLICK="spSTFarme @action=8, @id=@@GRIDSkladistaGridlnfarmaskladisteid#select 'refresh' as SkladistaGrid#OKSTAY" />
