	<INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*" TABINDEX="2" TOP="700" LEFT="1400" WIDTH="1500" SQL=""  />
	<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*" TABINDEX="3" TOP="700" LEFT="5300" WIDTH="3500"  ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="spMPDajTrgovina @operateriid=@@operateriid"  ONCLICK="select 'refresh' as skladisteid, 'refresh' as osobeid"/>
