			ONCLICK="spMPInventuraNG @action = 18, @trgovinaid = @@trgovinaid , @datumdok = @@datumdok #spMPInventuraNG @action=10,@operateriid=@@operateriid,@status = 1, @vrstadokid = @@vrstadokid , @datumdok = @@datumdok, @trgovinaid = @@trgovinaid,  @osobeid = @@osobeid , @sort = @@sortpoid, @sifradok = '105', @mpsirovina= 0 , @samokomisija = @@samokomisija , @partneriid = @@partneriid, @knjustv = @@knjustv #close#:UPDATE_FORM"  />
