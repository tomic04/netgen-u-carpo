<INSERTFORM 
	NAME="INSERTFORM" 
	HEIGHT="4500" WIDTH="10000" 
	CAPTION="Unos MP Inventure"
	ONSUBMIT="spmpInventura @action=3,@operateriid=@@operateriid,@sifradok = '105', @status = 0,"
	ONLOAD="select convert(varchar,getdate(),112) as datumdok" 
	FOCUS="datumdok">
		
