<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTER_FORM"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="Račun:STAVKE_MASTER" 
		CMD4CAPTION=""
 		CMD5CAPTION="Print mp račun:vrstadokid-MPBlagajnagla"
		CMD6CAPTION=""  
		MASTERDBLCLICK="PROMET"
	  POPUPMASTER=""
     PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Pregled stornirane robe na MP računima</NAME>
  <CAPTION>Pregled stornirane robe na MP računima</CAPTION>
  

<FILTER_FORM 	
    NAME="FILTER_FORM"
    FILLEXPLORER="TRUE" 
		WIDTH="6700" 
		ONSUBMIT="spMPPregRobe0NG @action=11, " 
		ONLOAD="select @@trgovinaid as trgovinaid, @@datumod as datumod, @@datumdo as datumdo" 
		HEIGHT="2600" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani"> 
		
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="true" 
            SQL="spMPDajTrgovina @operateriid=@@operateriid"/>
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" />
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" />
																				
</FILTER_FORM>
  
<PROMET 	
    FILLEXPLORER="" 
		WIDTH="12200" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="7700" 
		CAPTION="Računi" 
		BORDERSTYLE="3" 
		
		NEXTFORM="">
    <INPUT TYPE="frame"  NAME="fr1"           CAPTION="" TOP="6250" LEFT="50" WIDTH="11800" HEIGHT="700"   />
    <INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="50"  
					WIDTH="11800" 
					HEIGHT="6000" 
					TABINDEX="5" 
          SQL="spMPPregRobe0NG @action=1,@id = @@robaid,@datumod = @@datumod, @datumdo = @@datumdo , @trgovinaid = @@trgovinaid" />

    <INPUT TYPE="button" NAME="ok"  CAPTION="Ispis" TOP="6500" LEFT="500" WIDTH="1106" HEIGHT="322" ONCLICK=":vrstadokid-MPBlagajnagla"  />
    <INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="6500" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
    <INPUT TYPE="button" NAME="Stavke"  CAPTION="Stavke" TOP="6500" LEFT="3500" WIDTH="1106" HEIGHT="322" ONCLICK=":STAVKE_CHILD"  />
  
</PROMET>		

<STAVKE_CHILD 
    FILLEXPLORER="" 
    REPORT=""  
    WIDTH="12000" 
    ONSUBMIT="" 
    ONLOAD="" 
    HEIGHT="8800" 
    CAPTION="Stavke računa"  
		MASTERDBLCLICK=""
    BORDERSTYLE="3" 
    CMD2CAPTION="KRAJ"
    NEXTFORM=""  >

    <INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					WIDTH="11500" 
					HEIGHT="7000" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					TABINDEX="5" 
          SQL="spMPBlagajnaQueryGlaIdetNG @action=2,@id = @@gridstavkempblagajnaglaid" /> 

</STAVKE_CHILD>

  <STAVKE_MASTER
    FILLEXPLORER=""
    REPORT=""
    WIDTH="12000"
    ONSUBMIT=""
    ONLOAD=""
    HEIGHT="8800"
    CAPTION="Stavke računa"
		MASTERDBLCLICK=""
    BORDERSTYLE="3"
    CMD2CAPTION="KRAJ"
    NEXTFORM=""  >

    <INPUT TYPE="grid"
					NAME="stavke"
					REFRESHAFTERCHILD="TRUE"
					WIDTH="11500"
					HEIGHT="7000"
					CAPTION="_ay"
					TOP="200"
					LEFT="200"
					TABINDEX="5"
          SQL="spMPBlagajnaQueryGlaIdetNG @action=2,@id = @@mpblagajnaglaid" />

  </STAVKE_MASTER>
  
</PROJECT> 