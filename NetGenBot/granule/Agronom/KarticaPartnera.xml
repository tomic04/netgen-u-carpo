<PROJECT  CMD1CAPTION="Prikaz:FILTERFORM" CMD3CAPTION="Ispis:PRINTMASTER" CMD4CAPTION="Ispis Hrv::repx/rptKarticaKontaSKTele2(@DatumDo=@@DatDo, @DatumOd=@@DatOd, @nizkonto=&apos;@@KntPlanAId&apos;, @PartneriId=@@PartneriId,@DevValuteId=@@DevValuteId, @AnalitikaPS=@@AnalitikaPS) #CLOSE" CMD5CAPTION="Ispis Eng::repx/rptKarticaKontaEngSKTele2(@DatumDo=@@DatDo, @DatumOd=@@DatOd, @nizkonto=&apos;@@KntPlanAId&apos;, @PartneriId=@@PartneriId,@DevValuteId=@@DevValuteId, @AnalitikaPS=@@AnalitikaPS) #CLOSE" ONLOAD=":FILTERFORM" PAGEHEADERRIGHT="u periodu: @@datod do @@datdo" PAGEHEADERLEFT="@@searchboxpartneriid" PAGEFOOTERRIGHT="@@datdanas##Jupiter Software by SPIN" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE" PAGEFOOTERLEFT="@@tkosmomi##@@mjesto" PAGEORIENTATION="LANDSCAPE" VERSION="1.1">
<NAME>Kartica Partnera</NAME>
<CAPTION>Kartica Partnera</CAPTION>
<KOMENTAR>CallistoII 2.22.0</KOMENTAR>
<HISTORY>
02.05.2016. SPIN\pjaman - PEROPC7
</HISTORY>

<FILTERFORM NAME="FILTERFORM" HEIGHT="3931" WIDTH="5501" CAPTION="Parametri" ONSUBMIT="spKarticaPartnera @DatOd=@@datod,@Datdo=@@datdo,@nizkonto=&apos;@@kntplanaid&apos;,@Partneriid=@@partneriid,@DevValuteId=@@DevValuteId,@AnalitikaPS=@@AnalitikaPS!!" ONLOAD="select @@datod as datod , @@datdo as datdo ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = &apos;NasId&apos;))) as tkosmomi,getdate() as datdanas,
                         (select m.naziv  from partneri p
			 inner join parstru ps on ps.partneriid=p.partneriid
			 inner join mjesta m on m.mjestaid=ps.mjestaid
			 where p.partneriid = convert(integer,(select VarSet from PubVars where VarIme = &apos;NasId&apos;))
			 and ps.hqind=&apos;*&apos;) AS mjesto,
                         &apos;@@searchboxpartneriid&apos; as ParNaziv" FILLEXPLORER="TRUE" ONLOAD2="select ka.KntPlanAId as kntplanaid 
						from KntPlanA ka inner join KntVrsta kv on ka.KntVrstaId = kv.KntVrstaId 
						order by ka.konto">
	<INPUT TYPE="date" NAME="datdo" TOP="245" LEFT="3197" HEIGHT="302" WIDTH="1498" CAPTION="do:*"/>
	<INPUT TYPE="date" NAME="datod" TOP="245" LEFT="1296" HEIGHT="302" WIDTH="1498" CAPTION="Razdoblje:*" DEFAULT="firstdayofyear"/>
	<INPUT TYPE="multidrop" NAME="kntplanaid" TOP="850" LEFT="1296" HEIGHT="302" WIDTH="3398" VISIBLE="TRUE" TABINDEX="1" ENABLED="TRUE" SQL="spKntPlanAQuery @Action = 4,@id=null,@Konto=&apos;&apos;"/>
	<INPUT TYPE="label" NAME="lblTablica" TOP="893" LEFT="706" HEIGHT="288" WIDTH="605" CAPTION="Konto:"/>
	<INPUT TYPE="search" NAME="partneriid" TOP="1397" LEFT="1296" HEIGHT="302" WIDTH="3398" SQL="spTraziPartneri @action=&apos;Partneri&apos;, @uvjet=&apos;@@SearchBoxPartneriId&apos;" ALLOWEMPTY="FALSE" CAPTION="Partner:*" ONLOSTFOCUS="select naziv as nazivpartner,telefon1 as telefon,fax from vipartneri where partneriid=@@partneriid"/>
	<INPUT TYPE="combo" NAME="DevValuteId" TOP="1901" LEFT="1296" HEIGHT="302" WIDTH="3398" SQL="spValuteQuery @action=2" ALLOWEMPTY="true"/>
	<INPUT TYPE="label" NAME="Label15" TOP="1901" LEFT="706" HEIGHT="288" WIDTH="749" CAPTION="Valuta:" TEXT="Label15"/>
	<INPUT TYPE="check" NAME="AnalitikaPS" TOP="2261" LEFT="1296" HEIGHT="605" WIDTH="6005" CAPTION="Analitika PS"/>
	<INPUT TYPE="button" NAME="ok" TOP="2909" LEFT="101" HEIGHT="331" WIDTH="1195" TEXT="ButtonNG0" CAPTION="Prikaži" ONCLICK="If @@partneriid is null begin  exec spRaiserror 66001, &apos;Obavezan unos partnera! +focus(partneriid)&apos;end##OK"/>
	<INPUT TYPE="button" NAME="close" TOP="2909" LEFT="1498" HEIGHT="331" WIDTH="1195" TEXT="ButtonNG1" CAPTION="Izlaz" ONCLICK="CLOSE"/>

</FILTERFORM>
</PROJECT>