<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="select vp.kupvrstaposteid,vp.oznaka as Oznaka,vp.Naziv,(case vp.indf when 1 then 'Ulazni račun' else 'Ostalo'end) as Indikator,
                 ks.opis as [Status2000] 
                 from kupvrstaposte vp left outer join kupstatus ks on vp.kupstatusid=ks.kupstatusid"  
      CMD1CAPTION="Unesi:INSERTFORM" 
      CMD2CAPTION="Izmjeni:UPDATEFORM" 
      CMD3CAPTION="Obriši:DELETEFORM" 
      MASTERDBLCLICK="UPDATEFORM"
	  CHECKBOXVISIBLE="FALSE"
      >
 
  <NAME>Vrsta pošte</NAME>
  <CAPTION>Vrsta pošte</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>

 <INSERTFORM
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7000" 
                         ONSUBMIT="spKUPVrstaPosteAzur @Action=0," 
                         ONLOAD="select 1" 
                         HEIGHT="3500" 
			             TOP="300" 
                         CAPTION="Unos vrste pošte"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  
                                  CHILDFORM="">

                     
                      	<INPUT TYPE="label" 
                                   	NAME="lbloznaka" 
                                      	TOP="250" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Oznaka"/>
						<INPUT TYPE="text" 
								NAME="Oznaka" 
								TOP="250" 
								LEFT="1700" 
								CAPTION="Oznaka" 
								TEXT="" 
								WIDTH="1000" 
								HEIGHT="320" 
								TABINDEX="0" 
								ENABLED="TRUE" />

                        <INPUT TYPE="label" 
                                   	NAME="lblNaziv" 
                                      	TOP="750" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Naziv"/>
						<INPUT TYPE="text" 
								NAME="Naziv" 
								TOP="750" 
								LEFT="1700" 
								CAPTION="Naziv" 
								TEXT="" 
								WIDTH="4000" 
								HEIGHT="320" 
								TABINDEX="1" 
								ENABLED="TRUE" />
								
						<INPUT TYPE="label" NAME="lblsvi" TOP="1250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Indikator:"/>
						<INPUT TYPE="combo" 
                                    NAME="IndF" 
                                	CAPTION="IndF" 
                               		TOP="1250" 
                            		LEFT="1700"  
                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="2" 
                              		ALLOWEMPTY="false" 
                            		SQL="select 1 as IndF,'Ulazni račun - 1 ' as Naziv
       									union all 
										select 0 as IndF ,'Ostalo - 0' as Naziv" /> 
										
						<INPUT TYPE="label" NAME="lblsvi5" TOP="1750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Status:"/>
						<INPUT TYPE="combo" 
                                    NAME="KUPStatusId" 
                                	CAPTION="status" 
                               		TOP="1750" 
                            		LEFT="1700"  
                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="3" 
                              		ALLOWEMPTY="true" 
                            		SQL="select KUPStatusid,Opis as Naziv from KUPStatus" /> 			

                     	
 
   </INSERTFORM>


<UPDATEFORM 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7000" 
                         ONSUBMIT="spKUPVrstaPosteAzur @action=1,@ID=@@ID," 
                         ONLOAD="select vp.*,ks.opis as [Status2000] 
						               from kupvrstaposte vp left outer join kupstatus ks on vp.kupstatusid=ks.kupstatusid 
									   where vp.KUPVrstaPosteId=@@ID" 
                         HEIGHT="3500" 
                         TOP="300" 
                         CAPTION="Izmjena vrste pošte"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani"				  
					
                                  NEXTFORM=""  >


                          		<INPUT TYPE="label" 
                                   	NAME="lbloznaka" 
                                      	TOP="250" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Oznaka"/>
						<INPUT TYPE="text" 
								NAME="Oznaka" 
								TOP="250" 
								LEFT="1700" 
								CAPTION="Oznaka" 
								TEXT="" 
								WIDTH="1000" 
								HEIGHT="320" 
								TABINDEX="0" 
								ENABLED="TRUE" />

                        <INPUT TYPE="label" 
                                   	NAME="lblNaziv" 
                                      	TOP="750" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Naziv"/>
						<INPUT TYPE="text" 
								NAME="Naziv" 
								TOP="750" 
								LEFT="1700" 
								CAPTION="Naziv" 
								TEXT="" 
								WIDTH="4000" 
								HEIGHT="320" 
								TABINDEX="1" 
								ENABLED="TRUE" />
								
						<INPUT TYPE="label" NAME="lblsvi" TOP="1250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Indikator:"/>
						<INPUT TYPE="combo" 
                                    NAME="IndF" 
                                	CAPTION="IndF" 
                               		TOP="1250" 
                            		LEFT="1700"  
                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="2" 
                              		ALLOWEMPTY="false" 
                            		SQL="select 1 as IndF,'Ulazni račun - 1 ' as Naziv
       									union all 
										select 0 as IndF ,'Ostalo - 0' as Naziv" /> 
										
						<INPUT TYPE="label" NAME="lblsvi5" TOP="1750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Status:"/>
						<INPUT TYPE="combo" 
                                    NAME="KUPStatusId" 
                                	CAPTION="status" 
                               		TOP="1750" 
                            		LEFT="1700"  
                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="3" 
                              		ALLOWEMPTY="true" 
                            		SQL="select KUPStatusid,Opis as Naziv from KUPStatus" />  


			
                                         


  </UPDATEFORM>


<DELETEFORM
		WIDTH="5500" 
		ONSUBMIT="spKUPVrstaPosteAzur @action=2,@ID=@@ID" 
		ONLOAD=""		
		HEIGHT="1900" 
		CAPTION="Obrisati ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Obriši"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
                <INPUT TYPE="label" NAME="stat" TOP="400" LEFT="100" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati stavku? "/>
   		
  </DELETEFORM> 
  
  


</PROJECT>
 
