<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<PROJECT
	BUTTONS=""
	POPUPMASTER=""
	MASTERDBLCLICK=""
	GROUPBYBOXVISIBLE="TRUE"
	DETAILGRID=""
	ONLOAD="select 'refresh' as gridRobaMaster"
	COMMANDTIMEOUT="600"
	CHECKBOXVISIBLE="FALSE">

	<NAME>Stanje robe po trgovinama i skladištima</NAME>
	<CAPTION>Stanje robe po trgovinama i skladištima</CAPTION>


	<MAINFORM
	NAME="MAINFORM"
	HEIGHT="9000"
	WIDTH="15500"
	CAPTION="Stanje robe po trgovinama i skladištima"
	COMMANDTIMEOUT="600"
	ONLOAD="select year(getdate()) as godina, convert(char(4),year(getdate()))+'0101' as datumod, convert(char(4),year(getdate()))+'1231' as datumdo"
	MAXIMIZEBOX="TRUE"
	WINDOWSTATE="2"
	FILLEXPLORER=""
	REFRESHAFTERCHILD="TRUE"
	VERSION="2">

		<INPUT TYPE="group" NAME="topgroupbox" DOCK="1" CAPTION="" HEIGHT="800"   />
		<INPUT TYPE="date" NAME="datumod" TOP="300" LEFT="1300" CAPTION="Datum od" DEFAULT="" VISIBLE="FALSE" />
		<INPUT TYPE="date" NAME="datumdo" TOP="300" LEFT="3700" CAPTION="Datum do" DEFAULT="" VISIBLE="FALSE"/>
		<INPUT TYPE="text" NAME="godina"  TOP="300" LEFT="2000"  CAPTION="Godina*" VISIBLE="TRUE" WIDTH="1000"
			   ONLOSTFOCUS="select 'refresh' as gridStanjeRoba, 'refresh' as gridStanjeRobaVP,  'refresh' as gridRobaMaster
			   #select convert(char(4),@@godina )+'0101' as datumod, convert(char(4),@@godina )+'1231' as datumdo"/>

		<INPUT TYPE="grid"
  NAME="gridStanjeRoba"
  CAPTION="Stanje robe"
  SKIPDEFAULTLOAD2="TRUE"
  REFRESHAFTERCHILD="TRUE"
  TOP="100" LEFT="100"
  WIDTH="8800" HEIGHT="4500"
  POPUP=""
  ONDBLCLICK="if year(@@datumod)&lt;&gt;year(@@datumdo) begin 
						exec spRaiserror 69001, &apos;Stanje maloprodaje može se pregledavati samo u istoj godini ! Molim ponovite upit !&apos;
					end 
												exec spMPStanjeQueryNG @action=500,@RobaId=@@gridRobaMaster, @SkladisteId=@@gridStanjeRoba, @DatumOd=@@datumod, @DatumDo=@@datumdo, 
						@KlMasterRobaId=@@gridgridRobaMasterKlMasterRobaId, @status=null, @kolicinaod=null, @kolicinado=null, @kartica=0, @neispravno=0, 
						@komisija=0, @podklase = 1, @dakolicina = null, @mpsirovina = 0, @robastr = '' 

					#:MPKARTICA"
  EDITCOLUMNS=""
  ONCELLEDITED=""
  CHECKBOXVISIBLE="FALSE"
  PAGEHEADERCENTER=""
  PAGEHEADERRIGHT=""
  PAGEHEADERLEFT=""
  PAGEFOOTERCENTER=""
  PAGEFOOTERLEFT=""
  ONCLICK=""
  VISIBLE="TRUE"
  PAGEFOOTERRIGHT="@@tkosmomi"
  PAGEORIENTATION="LANDSCAPE"
  GROUPBYBOXVISIBLE="TRUE"
  FILTERMODE="FALSE"
  TOTALROW="TRUE"
  SQL="spMPStanjeRobeTrg @action = 2, @robaid = @@gridRobaMaster, @godina = @@godina"
  DOCK="1">

			<COLUMN INDEX="" NAME="MPC1100" WIDTH="1200" CAPTION="" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR=""  AGREGATEFUNCTION="0"/>
			<COLUMN INDEX="" NAME="Nab.cijena1100" WIDTH="1200" CAPTION="" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR=""  AGREGATEFUNCTION="0"/>
			<COLUMN INDEX="" NAME="Marža %1100" WIDTH="1200" CAPTION="" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR=""  AGREGATEFUNCTION="0"/>
			<COLUMN INDEX="" NAME="Tarifa1000" WIDTH="1200" CAPTION="" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR=""  AGREGATEFUNCTION="0"/>

		</INPUT>


		<INPUT TYPE="grid"
		  NAME="gridStanjeRobaVP"
		  CAPTION="Stanje robe"
		  SKIPDEFAULTLOAD2="TRUE"
		  TOP="100" LEFT="100"
		  WIDTH="8800" HEIGHT="3500"
		  POPUP=""
		  ONDBLCLICK="if year(@@datumod)&lt;&gt;year(@@datumdo) begin 
						exec spRaiserror 69001, &apos;Stanje skladišta može se pregledavati samo u istoj godini ! Molim ponovite upit !&apos;
					end 
					#:VPKARTICA"
		  EDITCOLUMNS=""
		  ONCELLEDITED=""
		  CHECKBOXVISIBLE="FALSE"
		  PAGEHEADERCENTER=""
		  PAGEHEADERRIGHT=""
		  PAGEHEADERLEFT=""
		  PAGEFOOTERCENTER=""
		  PAGEFOOTERLEFT=""
		  ONCLICK=""
		  VISIBLE="TRUE"
		  PAGEFOOTERRIGHT="@@tkosmomi"
		  PAGEORIENTATION="LANDSCAPE"
		  GROUPBYBOXVISIBLE="TRUE"
		  FILTERMODE="FALSE"
		  TOTALROW="TRUE"
		  SQL="spMPStanjeRobeTrg @action = 3, @robaid = @@gridRobaMaster, @godina = @@godina"
		  DOCK="2">

			<COLUMN INDEX="" NAME="Nab.cijena1100" WIDTH="1200" CAPTION="" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR=""  AGREGATEFUNCTION="0"/>

		</INPUT>


		<INPUT TYPE="grid"
		  NAME="gridRobaMaster"
		  CAPTION="Roba"
		  TOP="100" LEFT="100"
		  HEIGHT="4400" WIDTH="10000"
		  AFTERREFRESH=""
		  POPUP="Godina:FILTERFORM"
		  FILTERMODE="TRUE"
		  ONDBLCLICK=""
		  ONCLICK="select 'refresh' as gridStanjeRoba, 'refresh' as gridStanjeRobaVP"
		  EDITCOLUMNS=""
		  ONCELLEDITED=""
		  DETCHECKBOXVISIBLE="FALSE"
		  PAGEHEADERCENTER=""
		  PAGEHEADERRIGHT=""
		  PAGEHEADERLEFT=""
		  PAGEFOOTERCENTER=""
		  PAGEFOOTERLEFT=""
		  PAGEFOOTERRIGHT="@@tkosmomi"
		  PAGEORIENTATION="LANDSCAPE"
		  GROUPBYBOXVISIBLE="TRUE"
		  CHECKBOXVISIBLE="FALSE"
		  TOTALROW="FALSE"
		  SQL="spMPStanjeRobeTrg @action = 1, @godina=@@godina"
		  DOCK="3" />

	</MAINFORM >

	<MPKARTICA
	  HEIGHT="7500"
	  WIDTH="16000"
	  CAPTION="Kartica: '@@gridgridRobaMasterRoba_naziv' "
	  ONSUBMIT=""
	  SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
	  PAGEHEADERRIGHT="@@tkosmomi"
	  PAGEHEADERLEFT="Od @@datod do @@datdo"
	  CHECKBOXVISIBLE="TRUE"
	  ONLOAD="select sifra+'  '+[naziv robe] as opis, convert(char(4),@@godina)+'0101' as datod, convert(char(4),@@godina)+'1231' as datdo, coalesce(@@nenc,0) as nenc, coalesce(@@totalgen,2) as totalgen from ##temp50 where robaid=@@gridRobaMaster and trgovinaid=@@gridStanjeRoba"
	  ONLOADED="select 1 as rbtnKumulativ">


		<INPUT TYPE="date" NAME="datod" TOP="300" LEFT="1300" CAPTION="Datum od*" DEFAULT="" />
		<INPUT TYPE="date" NAME="datdo" TOP="300" LEFT="3700" CAPTION="Datum do*" DEFAULT=""/>

		<INPUT TYPE="frame" NAME="frm" TOP="50" LEFT="200" CAPTION="" WIDTH="10500" HEIGHT="680"/>

		<INPUT TYPE="radio" NAME="rbtnKumulativ" CAPTION="Kumulativ" TOP="250" LEFT="5600" WIDTH="1300" HEIGHT="420"
				ONCLICK="select 'refresh' as karticagrid# select 'visible' as karticagrid, 'invisible' as karticagrid2"/>

		<INPUT TYPE="radio" NAME="rbtnAnalitika" CAPTION="Analitika" TOP="250" LEFT="7000" WIDTH="1500" HEIGHT="420"
			ONCLICK="select 'refresh' as karticagrid2# select 'visible' as karticagrid2, 'invisible' as karticagrid"/>

		<INPUT TYPE="button" NAME="" CAPTION="Pokaži" TOP="300" LEFT="9000" WIDTH="1500" HEIGHT="322"
			 ONCLICK=" if @@rbtnKumulativ = 1 begin
                      select 'refresh' as karticagrid
                      select 'visible' as karticagrid
                      select 'invisible' as karticagrid2
                    end
                    else begin
                       select 'refresh' as karticagrid2
                       select 'visible' as karticagrid2
                       select 'invisible' as karticagrid
                    end
         select 'refresh' as grid"/>

		<INPUT TYPE="grid"
			NAME="karticagrid"
			TOP="800" LEFT="200"
			WIDTH="15500" HIGHT="6000"
				  CAPTION="Kartica robe"
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
				  PAGEHEADERCENTER=""
					PAGEHEADERRIGHT="Kartica MP stanja za robu '@@gridgridRobaMasterRoba_naziv'"
					PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Trgovina: @@gridgridStanjeRobaTrgovina"
					PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
					PAGEORIENTATION="LANDSCAPE"
					SQL="exec spMPStanjeKarticaNG @action=0, @robaid=@@gridRobaMaster, @DatumOd=@@datod, @DatumDo=@@datdo, @trgovinaid=@@gridStanjeRoba, @totalgen = @@totalgen , @datod = @@datod, @datdo = @@datdo, @nenc = @@nenc" >

			<COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
			<COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
			<COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>

		<INPUT TYPE="grid"
			NAME="karticagrid2"
			TOP="800" LEFT="200"
			WIDTH="15500" HIGHT="6000"
				  CAPTION="Kartica robe"
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
				  PAGEHEADERCENTER=""
					PAGEHEADERRIGHT="Analitika kartice MP stanja za robu '@@gridgridRobaMasterRoba_naziv'"
					PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Trgovina: @@gridgridStanjeRobaTrgovina"
					PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
			VISIBLE="FALSE"
					PAGEORIENTATION="LANDSCAPE"
					SQL="exec spMPStanjeKarticaAnalitika @action=0, @robaid=@@gridRobaMaster, @DatumOd=@@DatumOd, @DatumDo=@@DatumDo, @trgovinaid=@@gridStanjeRoba, @totalgen = @@totalgen , @datod = @@datod, @datdo = @@datdo, @nenc = @@nenc" >

			<COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
			<COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
			<COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>

		<INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="6500" LEFT="200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>
		<INPUT TYPE="button" NAME="" CAPTION="Računi" TOP="6500" LEFT="2200" WIDTH="1500" HEIGHT="322" ONCLICK=":RACUNI"/>

		<INPUT TYPE="button" NAME="" CAPTION="Ispis kartice kumulativ" TOP="6500" LEFT="4200" WIDTH="2200" HEIGHT="322" ONCLICK="printgrid(karticagrid)"/>
		<INPUT TYPE="button" NAME="" CAPTION="Ispis kartice analitika" TOP="6500" LEFT="6500" WIDTH="2200" HEIGHT="322" ONCLICK="printgrid(karticagrid2)"/>
	</MPKARTICA>

	<RACUNI
		  FILLEXPLORER="TRUE"
		  WIDTH="7000"
		  ONSUBMIT=""
		  ONLOAD="if ( select vrstadokid from maloprodajagla where maloprodajaglaid = 
               (select maloprodajaglaid from maloprodajadet where maloprodajadetid = @@karticagrid )) not in  
		              ( select vrstadokid from vrstadok v inner join vrstaprom vp on v.vrstapromid = vp.vrstapromid where vp.sifra in ( '97' ,'98')) begin 
			              exec spRaiserror 69001, ' Niste odabrali dokument utrška.'
			          	end"
		  HEIGHT="7500"
		  CAPTION="Računi  "
		  BORDERSTYLE="3"
		  CMD1CAPTION=""
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  NEXTFORM="">

		<INPUT TYPE="grid"
					NAME="stavke"
					REFRESHAFTERCHILD="TRUE"
					CAPTION="_ay"
					TOP="200"
					LEFT="200"
					WIDTH="12000"
					HEIGHT="6000"
					TABINDEX="5"
					SQL="spMPStanjeKarticaNG @action=2,@id = @@karticagrid, @robaid =  @@gridRobaMaster"/>
	</RACUNI>


	<VPKARTICA
		HEIGHT="7500"
		WIDTH="16000"
		CAPTION="Kartica skladišta: '@@gridgridRobaMasterRoba_naziv' "
		ONSUBMIT=""
		SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
		PAGEHEADERRIGHT="@@tkosmomi"
		PAGEHEADERLEFT="Od @@datod do @@datdo"
		CHECKBOXVISIBLE="TRUE"
		ONLOAD="select cast(userid as varchar)+'  '+naziv as opis, convert(char(4),@@godina)+'0101' as datod, convert(char(4),@@godina)+'1231' as datdo from roba where robaid=@@gridRobaMaster"
		ONLOADED="">


		<INPUT TYPE="date" NAME="datod" TOP="300" LEFT="1300" CAPTION="Datum od*" DEFAULT="firstdayofyear" />
		<INPUT TYPE="date" NAME="datdo" TOP="300" LEFT="3700" CAPTION="Datum do*" DEFAULT="today"/>

		<INPUT TYPE="frame" NAME="frm" TOP="50" LEFT="200" CAPTION="" WIDTH="10500" HEIGHT="680"/>


		<INPUT TYPE="grid"
			NAME="karticagrid"
			TOP="800" LEFT="200"
			WIDTH="15500" HIGHT="6000"
					CAPTION="Kartica robe na skladištu"
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
					PAGEHEADERCENTER=""
					PAGEHEADERRIGHT="Kartica VP stanja za robu '@@gridgridRobaMasterRoba_naziv'"
					PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Skladište: @@gridgridStanjeRobaVPSkladiste"
					PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
					PAGEORIENTATION="LANDSCAPE"
					SQL="exec spSktKomercKarticaQueryNG @action=0, @robaid=@@gridRobaMaster, @DatumOd=@@datod, @DatumDo=@@datdo, @SkladisteId=@@gridStanjeRobaVP, @Faktor  = 1 , @kkvalglaid = null, @kontigent = 0, @order = 1 " >

			<COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
			<COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
			<COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>


		<INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="6500" LEFT="200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>

	</VPKARTICA>

</PROJECT>
