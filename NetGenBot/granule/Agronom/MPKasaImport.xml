<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
	   MULTIGRIDLAYOUT="TRUE" 
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="Status kasa:STATUS_FORM" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
     PAGEHEADERLEFT="Od @@datumod do @@datumdo"
    PAGEHEADERRIGHT="@@tkosmomi"
     COMMANDTIMEOUT="600">

	<NAME>Kasa - Import</NAME>
	<CAPTION>Kasa - Import</CAPTION>

<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="3800" 
	WIDTH="6910" 
	CAPTION="Parametri za import" 
	ONSUBMIT="spMPKasaCopy @action = 1, @datumod = @@datumod, @datumdo = @@datumdo, @mpkaseid = @@mpkaseid, @tablica = '@@tablica'!!"
	ONLOAD="select '@@baza' as baza, '@@baza2' as baza2, '@@tablica' as tablica, '@@tablica2' as tablica2, @@mpskriptaid as mpskriptaid, '@@string' as string, '@@string2' as string2" 
            
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="" 
	CMD2CAPTION="" 
	>

  <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6500" HEIGHT="2200" />

  <INPUT TYPE="combo" NAME="mpkaseid" ALLOWEMPTY="FALSE" CAPTION="Kasa:*" TOP="400" LEFT="1300" WIDTH="5000" HEIGHT="320"
         SQL="SELECT mpkaseid, (ltrim(rtrim(kasa)) + ' - ' + ltrim(rtrim(t.opis))) as naziv from mpkase k inner join trgovina t on k.trgovinaid = t.trgovinaid" ONLOSTFOCUS="" />

  <INPUT TYPE="combo" NAME="tablica" ALLOWEMPTY="FALSE" CAPTION="Tablica:*" TOP="800" LEFT="1300" WIDTH="5000" HEIGHT="320"
         SQL="select 'MPKase' as naziv union all 
              select 'MPNaplata' as naziv union all 
              select 'Install' as naziv union all 
              select 'KupciR1' as naziv union all 
              select 'Promet' as naziv union all 
              select 'Roba' as naziv union all
              select 'MPPolog' as naziv union all
              select 'ZakBlag' as naziv" />
  
  <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od:*" TOP="1200" LEFT="1300" WIDTH="1200" HEIGHT="320"/>
  <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do:*" TOP="1600" LEFT="1300" WIDTH="1200" HEIGHT="320"/>
  


  <INPUT TYPE="button"    NAME="ok"   CAPTION="Pokreni import" TOP="2600" LEFT="300" WIDTH="1700" HEIGHT="520"
         ONCLICK="BLAGAJNAENABLE(@@mpkaseid)#OK"  />
  <INPUT TYPE="button"    NAME="odustani"   CAPTION="Zatvori (ESC)" TOP="2600" LEFT="2300" WIDTH="1700" HEIGHT="520" ONCLICK="close"  />
</FILTERFORM>



  <STATUS_FORM NAME="STATUS_FORM"
    HEIGHT="9900"
    WIDTH="5000"
    CAPTION="Status kasa"
    ONSUBMIT=""
    ONLOADED=""
    ONLOAD=""
    FILLEXPLORER=""
    FOCUS=""
    CMD1CAPTION=""
    CMD2CAPTION="" >

    <INPUT TYPE="grid"
        NAME="kase"
        REFRESHAFTERCHILD="TRUE"
        CAPTION="Stavke"
        TOP="50" LEFT="56" WIDTH="4500" HEIGHT="8500"
        TABINDEX="-1"
        AFTERREFRESH=""
        POPUP=""
        ONDBLCLICK=""
        EDITCOLUMNS=""
        SKIPDEFAULTLOAD="FALSE"
        ONCELLEDITED=""
        CHECKBOXVISIBLE="TRUE"
        PAGEHEADERCENTER=""
        PAGEHEADERRIGHT=""
        PAGEHEADERLEFT=""
        PAGEFOOTERCENTER=""
        PAGEFOOTERLEFT=""
        PAGEFOOTERRIGHT=""
        PAGEORIENTATION="LANDSCAPE"
        GROUPBYBOXVISIBLE="FALSE"
        TOTALROW="FALSE"
        SQL="exec [dbo].[spMPKasaCopy] @action = 2" />
    
    <INPUT TYPE="button"    NAME="odustani"   CAPTION="Zatvori (ESC)" TOP="8700" LEFT="300" WIDTH="1700" HEIGHT="520" ONCLICK="close" HOTKEY="ESC" />

    <INPUT TYPE="button"    NAME="refresh"   CAPTION="Osvježi" TOP="8700" LEFT="2300" WIDTH="1700" HEIGHT="520"
         ONCLICK="FOREACHSELECTED(kase)#BLAGAJNAENABLE(@@gridkasempkaseid)#select 'refresh' as kase"  />
    
  </STATUS_FORM>

  <MULTIBLUEREFRESH_FORM
	  NAME="MULTIBLUEREFRESH_FORM"
	  FILLEXPLORER=""
	  CAPTION="Osvježavanje statusa"
	  WIDTH="8000"
	  HEIGHT="2600"
	  ONSUBMIT="BLAGAJNAENABLE(@@gridkasempkaseid)"
	  CMD1CAPTION="Poništi"
	  CMD2CAPTION="Odustani" >

  </MULTIBLUEREFRESH_FORM>
  
</PROJECT>