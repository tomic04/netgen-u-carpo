<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>

<PROJECT
	BUTTONS="Parametri:FILTERFORM#Zaključi:ZAKLJUCI#Print dok.:MULTISELECTISPIS_FORM#Datum:DATUM_FORM"
	PERMISIO="TRUE"
	TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#Sutra:SUTRA_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
	DETAILGRID = "spMPQueryGlaIDetNG @action=2, @operateriid=@@operateriid, @id=@@id, @nenc = 1"
	MASTERDBLCLICK="ZAKLJUCI"
	GROUPBYBOXVISIBLE="TRUE"
	CHECKBOXVISIBLE="TRUE"
	DETCHECKBOXVISIBLE="FALSE"
	DETTOTALROWVISIBLE="FALSE"
	SETDEFAULTS="spMPPermissionNG @action = 0, @operateriid = @@operateriid, @object = '@@xmlname', @sifradok = '104'#select dbo.fnTkoSmoMi() as tkosmomi" 
	ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end, 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end,
			'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end, 
			'Storno' = case when @@storno=1 then 'enable' else 'disable' end, 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
	POPUPMASTER="Parametri:FILTERFORM#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ" 
	PAGEHEADERRIGHT="@@tkosmomi"
	PAGEHEADERLEFT="Od @@datumod do @@datumdo">


<NAME>Zaprimanje robe u MP sa skladišta </NAME>
<CAPTION>Zaprimanje robe u MP sa skladišta </CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas', @sifradok = '104', @nenc = 1 , @veceodstatusa = 0" />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @sifradok = '104', @nenc = 1, @veceodstatusa = 0" />
<SUTRA_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='sutra', @sifradok = '104', @nenc = 1, @veceodstatusa = 0 " />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @sifradok = '104', @nenc = 1, @veceodstatusa = 0" />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = '104', @nenc = 1, @veceodstatusa = 0" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '104', @nenc = 1,  @veceodstatusa = 0" />



<FILTERFORM 
	NAME="FILTERFORM" 
	HEIGHT="3254" WIDTH="6710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPQueryGlaIDetNG @action = 1, @sifradok = '104', @operateriid= @@operateriid, "
	ONLOAD="" 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani">

	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @vrstatrg='M' " />
	<INPUT TYPE="combo" NAME="skladisteid" ALLOWEMPTY="TRUE" CAPTION="Skladište" SQL="spmpDajSkladisteNG @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />
	<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="true" CAPTION="Status" SQL="select 0 as status,&apos;Otvoren&apos; as naziv  union all select 1 as status,&apos;Naloženo &apos; as naziv union all select 2 as status,&apos;Zaprimljeno &apos; as naziv" />
	<INPUT TYPE="text" NAME="trazibroj"  WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta" ONLOSTFOCUS=""/>

</FILTERFORM>



<ZAKLJUCI 
	NAME="ZAKLJUCI" 
	HEIGHT="3197" WIDTH="5501" 
	CAPTION="Zaključiti dokument ?" 
	ONSUBMIT="spmpzakljucidokNG @id=@@id, @admin=1, @operateriid = @@operateriid"
	ONLOAD="if @@id = 0  begin
			exec spRaiserror 69001, 'Niste odabrali dokument !' end
			else begin
			if (select status from maloprodajagla where maloprodajaglaid=@@ID ) =  1 and (select dbo.fnMPDajSktId(1,@@id)) is not null  begin 
			exec spMPQueryGlaIDetNG @action=3,@ID=@@ID end 
			else begin 
			if (select status from maloprodajagla where maloprodajaglaid=@@ID ) = 1 begin 
			exec spRaiserror 69001, 'Dokument nije u statusu isporučen da bi se mogao zaključivati !' end
			else begin 
			if (select status from maloprodajagla where maloprodajaglaid=@@ID ) = 2 begin
			exec spRaiserror 69001, 'Dokument je zaključen i roba je već zaprimljena !' end end end end" 
	FILLEXPLORER="" 	
	CMD1CAPTION="Zaključi" 
	CMD2CAPTION="Odustani">

	<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" ENABLED="FALSE"/>
	<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Broj isporuke:" />
	<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? " />
</ZAKLJUCI>



<OTKLJUCAJ 
	NAME="OTKLJUCAJ" 
	HEIGHT="3197" WIDTH="5501" 
	CAPTION="Otključavanje dokumenta  ?" 
	ONSUBMIT="spMPOdkljucajDokNG @id=@@id, @operateriid = @@operateriid,"
	ONLOAD="if @@id = 0  begin
			exec spRaiserror 69001, 'Niste odabrali dokument !' end
			else begin
			if (select status from maloprodajagla where maloprodajaglaid= @@ID ) &lt;&gt; 2 begin 
			exec spRaiserror 69001, 'Dokument nije zaključen. Ne može se otključavati!' end
			else begin
			exec spMPQueryGlaIDetNG @action=3,@ID=@@ID end end"
	FILLEXPLORER="" 
	CMD1CAPTION="Otključaj" 
	CMD2CAPTION="Odustani">

	<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2779"  ENABLED="FALSE"/>
	<INPUT TYPE="label" NAME="Label57" TOP="360" LEFT="288" HEIGHT="288" WIDTH="1728" BOLD="FALSE" CAPTION="Broj narudžbe:" />
	<INPUT TYPE="label" NAME="stat" TOP="1267" LEFT="374" HEIGHT="418" WIDTH="4003"  BOLD="TRUE" CAPTION="Jeste li sigurni da želite otključati dokument  ? " />
</OTKLJUCAJ>

	
	
<DATUM_FORM
    NAME="DATUM_FORM"
    HEIGHT="3000" WIDTH="4500"
    CAPTION="Izmjena datuma dokumenta "
    ONSUBMIT="spMPInsertGlaIdetNG @action = 155, @id=@@id, @operateriid= @@operateriid, "
    ONLOAD="spMPQueryGlaIDetNG @action=3, @ID = @@ID, @operateriid = @@operateriid"
    FILLEXPLORER=""
    NEXTFORM=""
    FOCUS="datumdok"
    PERMISIO="TRUE"
    CMD1CAPTION=""
    CMD2CAPTION="">

   
    <INPUT TYPE="text" NAME="broj" CAPTION="Broj dokumenta*" TOP="600" LEFT="1500" HEIGHT="317" WIDTH="2500" ENABLED="FALSE"/>
    <INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="FALSE" CAPTION="Trgovina*" TOP="1000" LEFT="1500" HEIGHT="317" WIDTH="2500" 
           SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @vrstatrg='M'" ENABLED="FALSE"/>
    <INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta*" TOP="1400" LEFT="1500" HEIGHT="317" WIDTH="1200" DEFAULT="firstdayofyear" CHECKBOX="FALSE"/>

    <INPUT TYPE="button" NAME="izmjeni" CAPTION="Izmjeni" TOP="1900" LEFT="300" HEIGHT="317" WIDTH="1200" 
           ONCLICK="spMPInsertGlaIdetNG @action = 155, @id=@@id, @operateriid= @@operateriid, @vrstadokid = @@vrstadokid, @trgovinaid = @@trgovinaid, @datumdok = @@datumdok#select 'refresh' as master#OK"/>
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1900" LEFT="1700" HEIGHT="317" WIDTH="1200" ONCLICK="close"/>
</DATUM_FORM>

	
	
<MULTISELECTISPIS_FORM
    NAME="MULTISELECTISPIS_FORM"
    FILLEXPLORER=""
    CAPTION="Ispis dokumenata"
    WIDTH="8000"
    HEIGHT="2600"
    ONLOADED=":vrstadokid-Maloprodajagla"
    ONSUBMIT=""
    CMD1CAPTION="Poništi"
    CMD2CAPTION="Odustani" >
</MULTISELECTISPIS_FORM>

</PROJECT>