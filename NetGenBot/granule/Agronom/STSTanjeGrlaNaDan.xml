<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spstStanjeNaDanNew @action = 2, @stfarmeid = @@stfarmeid , @datumpreg = @@datumpreg, @operateriid = @@operateriid , @id = @@id, @vrstadokid = @@vrstadokid"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Uvjeti:FILTERFORM#Kartice:KARTICE" 
		 POPUPMASTER="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT="">



	<NAME>Stanje grla na dan</NAME>
	<CAPTION>Stanje grla na dan</CAPTION>



	<MASTERCOLUMNS>
		<COLUMN INDEX="7" NAME="" WIDTH="1500" CAPTION="Komada" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2"/>
		<COLUMN INDEX="4" NAME="" WIDTH="1500" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2"/>
	</MASTERCOLUMNS>



	<FILTERFORM NAME="FILTERFORM" HEIGHT="2500" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spstStanjeNaDanNew @action = 1,  @operateriid= @@operateriid, @granula = '@@xmlname',"
		 ONLOAD="select @@datumpreg as datumpreg, @@stfarmeid as stfarmeid" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
			<INPUT TYPE="date" NAME="datumpreg" CAPTION="Na Datum " DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="FALSE" CAPTION="Farma" ONLOSTFOCUS=""/>
			<INPUT TYPE="combo" NAME="vrstadokid" ONCLICK="" ENABLED="TREE" ALLOWEMPTY="FALSE" CAPTION="Vrsta RN" ONLOSTFOCUS=""
				   SQL="select vrstadokid, opis from vrstadok where opis like '%radni%nalog%tov%' and opis not like '%prasad%' union all select null as vrstadokid,  'Bez obzira na radni nalog' as opis" />
	</FILTERFORM>


	<KARTICE NAME="DONESI"
			HEIGHT="3902" WIDTH="7502"
			ONLOAD="select maticnibroj from stgrlo where stgrloid = @@stgrloid"
			CAPTION="Kartice grla: @@maticnibroj"
		  >
		<INPUT TYPE="text" NAME="stgrloid"     CAPTION=""  TOP="-5000"  />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica prometa"  TOP="500" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAPROMETA"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica mlijeka"      TOP="1000" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAMLIJEKA"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica reprodukcije"      TOP="1500" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAREPRODUKCIJE"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Zdravstvena kartica"      TOP="2000" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":ZDRAVSTVENAKARTICA"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani"            TOP="2500" LEFT="3756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</KARTICE >


	<KARTICAPROMETA
	FILLEXPLORER=""
	WIDTH="13000"
		ONSUBMIT=""
	ONLOAD="select stgrloid from stgrlo where maticnibroj= '@@maticnibroj'"
	HEIGHT="6000"
	CAPTION="Kartica prometa grla @@maticnibroj"
		>
		<INPUT TYPE="grid"
				NAME="kprometa"
				TOP="700"
				LEFT="200"
				WIDTH="12000"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="4000"
				CAPTION="Krtica prometa grla "
		REFRESHAFTERCHILD="TRUE"
		SQL="spstKarticaGrla @action = 1, @stgrloid = @@stgrloid" />

		<INPUT TYPE="button" NAME="ponisiti"  CAPTION="Poništi promet" TOP="5100" LEFT="500" WIDTH="1506" HEIGHT="322" ONCLICK=":PONISTIPROMET"  />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="5100" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</KARTICAPROMETA>



</PROJECT>