<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="Etikete.clsEtikete" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica:KARTICA" 
		CMD4CAPTION="Dodaj na više trgovina:DODAJVISE"
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		MASTERDBLCLICK=""
	        POPUPMASTER=""> 
 

  <NAME>Pregled robe po trgovinama</NAME>
  <CAPTION>Pregled robe po trgovinama</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		ONSUBMIT="spMPPregRobeTrgovinaNG @action=1, @operateriid = @@operateriid," 
		ONLOAD="select @@trgovinaid as trgovinaid" 
		HEIGHT="5300" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		

    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="200" LEFT="1800"  WIDTH="5500" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="true" 
            SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  
                from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

    <INPUT TYPE="search" CAPTION="Roba*" NAME="robaid" TOP="550" LEFT="1800" WIDTH="5500" HEIGHT="320"
					SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid, @trazi = '@@searchboxrobaid'" /> 
					
      <INPUT TYPE="text" CAPTION="Traženje pojma*" NAME="search" TOP="900" LEFT="1800" TEXT="" WIDTH="5500" HEIGHT="320"/>

			<INPUT TYPE="search"  CAPTION="Klasa*" NAME="klasaid" TOP="1250" LEFT="1800" WIDTH="5500" HEIGHT="320"
					SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/> 

      <INPUT TYPE="combo" NAME="jmid" CAPTION="Dodatna jedinica mjere*" TOP="1600"  LEFT="1800" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"
					SQL="select distinct j.jmid, naziv from jm j inner join jmroba jm on j.jmid = jm.jmid order by naziv"/>

			<INPUT TYPE="check" NAME="podklase" CAPTION="pokaži i sve podklase" TOP="1950" LEFT="1800" WIDTH="3500" HEIGHT="320" />
      <INPUT TYPE="check" NAME="stanje" TOP="2300" LEFT="1800" WIDTH="4000" HEIGHT="320" CAPTION="pokaži samo robe kojima je stanje različito od 0"/>
	   
      <INPUT TYPE="search" NAME="partneriid" TOP="2650" LEFT="1800" WIDTH="5500" CAPTION="Proizvođač*" ALLOWEMPTY="TRUE" 
             SQL="vipartneri#partneriid#naziv%#%mjestanaziv%#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />

    <INPUT TYPE="text" CAPTION="Godina*" NAME="godina" TOP="3000" LEFT="1800" TEXT="" WIDTH="1200" HEIGHT="320"/>

  </FORM1>

 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Krtica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
                         SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid , @totalgen=1" /> 
</KARTICA>

	<DODAJVISE 	FILLEXPLORER=""
	   WIDTH="7000"
	   ONSUBMIT=""
	   ONLOAD="select convert(varchar(20), userid ) + ' ' + naziv as roba , @@trgovinaid as trgovinaid from roba where robaid = @@ROBAID"
	   HEIGHT="8500"
	   CAPTION="Dodavanje robe na više trgovina "
	   BORDERSTYLE="3"
	   CMD1CAPTION=""
	   CMD2CAPTION=""
	   CMD3CAPTION=""
		FOCUS="trg"
	   CHILDFORM="">

		<INPUT TYPE="text" CAPTION="Roba*" NAME="roba" TOP="500" LEFT="500" TEXT="" STYLE="1" SIZE="10" WIDTH="5500" HEIGHT="320"/>
		<INPUT TYPE="text" CAPTION="" NAME="trgovinaid" VISIBLE="FALSE" TOP="500" LEFT="500" TEXT="" STYLE="1" SIZE="10" WIDTH="5500" HEIGHT="320"/>

		<INPUT TYPE="grid" NAME="trg" REFRESHAFTERCHILD="TRUE" TOP="1000" LEFT = "500" WIDTH="5800" HEIGHT="6000" TABINDEX=""
					 SQL="spMPPregRobeTrgovinaNG @action = 3, @robaid = @@robaid"
					 ONCLICK="" />

		<INPUT TYPE="button" NAME="ok"      CAPTION="Ažuriraj"  TOP="7500" LEFT="1000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="FOREACHSELECTED(trg)#spMPPregRobeTrgovinaNG @action = 4, @robaid = @@robaid, @trgovinaid = @@trgovinaid,@trgovina2id = @(trg..trgovinaid)#OK"   />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="7500" LEFT="2500" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</DODAJVISE>



</PROJECT> 