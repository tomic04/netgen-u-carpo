                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select stgrloskupinaid, opisg as naziv  from vistkategorije where stkategorijaid = @@stkategorijaid"  />

						  <INPUT TYPE="check"
