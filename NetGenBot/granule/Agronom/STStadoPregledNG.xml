		<INPUT TYPE="button" NAME="ok"     CAPTION="Zdravstvena kartica"      TOP="2000" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":ZDRAVSTVENAKARTICA"  HOTKEY="" />
