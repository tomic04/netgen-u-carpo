	<INPUT TYPE="frame" NAME="fr1" TOP="202" LEFT="274" HEIGHT="2088" WIDTH="8366" TEXT="FrameNG0" CAPTION="Zaglavlje:"/>
	<INPUT TYPE="date" NAME="datum" TOP="605" LEFT="1800" HEIGHT="346" WIDTH="1598" TABINDEX="0" CAPTION="Datum" ONLOSTFOCUS="declare @Broj varchar(6),@Godina integer
                     set @Godina=(select datepart(year,@@datum))
                     set @Broj = (select coalesce(max(CONVERT(Integer,substring(Broj,4,20))),0) + 1 
                                  from kntkompveriznegla 
								  where  datepart(year,Datum) = @Godina
								  and not (left(broj+&apos;      &apos;,6) like &apos;%[/]%&apos;
								  OR  left(broj+&apos;      &apos;,6) like &apos;%[A-Z]%&apos;)
								  and left(broj+&apos;      &apos;,6) like &apos;%[0-9]&apos; )
                     select coalesce(substring(CONVERT(varchar(20),@Godina),3,2)+&apos;-&apos;+replicate(&apos;0&apos;,6-len(@Broj)) + @Broj,@Broj)  as broj"/>
