			       d.Partneri,d.Telefon,d.Fax,d.OdgovornaOsoba as [Odgovorna Osoba1500],
			      (case when d.kntkompveriznedetid=(select max(kntkompveriznedetid)from kntkompveriznedet where kntkompverizneglaid=@@id) 
			       then &apos;boldbrown&apos; 
			            when d.kntkompveriznedetid=(select min(kntkompveriznedetid)from kntkompveriznedet where kntkompverizneglaid=@@id)
			       then&apos;boldorange&apos; end) as formatid
,g.Iznos-(select coalesce(sum(iznos),0) from KntKompVerizneKup where KntKompVerizneGlaId=d.KntKompVerizneGlaId  ) as [RazlikaKup1500]
		,g.Iznos-(select coalesce(sum(iznos),0) from KntKompVerizneDob where KntKompVerizneGlaId=d.KntKompVerizneGlaId  ) as [RazlikaDob1500]
,cast(d.Pokretac as bit) as [Pokretač1200]			       
					from kntkompveriznedet d
left outer join KntKompVerizneGla g on d.KntKompVerizneGlaId=g.KntKompVerizneGlaId 
					where d.kntkompverizneglaid=@@id" ANCHOR="15"/>
