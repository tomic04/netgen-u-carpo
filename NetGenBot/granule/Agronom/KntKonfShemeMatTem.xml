   <INSERTFORM 
					
                 WIDTH="6000" 
                 ONSUBMIT="spKntKonfShemeMatTem @action=2," 
                 ONLOAD=""                                                    
                 HEIGHT="7800" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="" 
                 CMD2CAPTION="" 
		 FILLEXPLORER=""
  		 >
  	       
                	
			   
		<INPUT TYPE="label" NAME="lblvrstaprom"  TOP="250" LEFT="220" WIDTH="1000" CAPTION="Vrsta prometa:"/>	   
		<INPUT TYPE="combo"  NAME="vrstapromid"    TOP="200" LEFT="1800" WIDTH="2000" ALLOWEMPTY="TRUE"
			   SQL="select vrstapromid,opis from vrstaprom where robnoind is not null order by opis" 
			   ONLOSTFOCUS="select 'refresh' as vrstadokid"/>
                 
  
		<INPUT TYPE="label" NAME="lblvrstadok"  TOP="750" LEFT="220" WIDTH="1000" CAPTION="Vrsta dok.:"/>	   
		<INPUT TYPE="combo"  NAME="vrstadokid"    TOP="750" LEFT="1800" WIDTH="2000" ALLOWEMPTY="TRUE"
			   SQL="if @@vrstapromid is null begin
					   select vd.VrstaDokId,vd.Opis
					   from VrstaDok vd
					   inner join VrstaProm vp on vd.VrstaPromId = vp.VrstaPromId
					   where vp.VrstaPromId in (select VrstaPromId from VrstaProm where  robnoind is not null)
					   order by vd.Opis 
					end   
					else begin  
					select vd.VrstaDokId,vd.Opis--,vd.VrstaPromId,vd.Prefix,vd.Sufix,vp.Opis as OpisVp,  coalesce(vd.Template,'') as Template
					from VrstaDok vd
					inner join VrstaProm vp on vd.VrstaPromId = vp.VrstaPromId
					where vp.VrstaPromId =@@vrstapromid
					order by vd.Opis
					end"/>	
		



		<INPUT TYPE="label" CAPTION="SkladisteOznakaUvjet:" NAME="lbl3"   TOP="1200" LEFT="200" WIDTH="1800" HEIGHT="300" 
                                     /> 				
		<INPUT TYPE="text" CAPTION="in('01')" NAME="SkladisteOznakaUvjet"   TOP="1200" LEFT="1800" WIDTH="3800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 




		<INPUT TYPE="label" CAPTION="KontoIzSheme:" NAME="lbl4"   TOP="1700" LEFT="200" WIDTH="1800" HEIGHT="300" 
                                     /> 
		<INPUT TYPE="text" CAPTION="ZKonto" NAME="KontoIzSheme"   TOP="1700" LEFT="1800" WIDTH="1800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 



		<INPUT TYPE="label" CAPTION="Konto:" NAME="lbl15"  TOP="2200" LEFT="200" WIDTH="1800"  HEIGHT="300"/>
		
		<INPUT TYPE="search" CAPTION="KTO" NAME="kntplanaid"   TOP="2200" LEFT="1800" WIDTH="1800" HEIGHT="300"
		  ALLOWEMPTY="FALSE" SQL="kntplana#kntplanaid#konto%"
				 ONLOSTFOCUS="select konto as konto,naziv as nazivkonta from kntplana where kntplanaid=@@kntplanaid" />



		
		<INPUT TYPE="label" CAPTION="Dug:" NAME="lbl6"   TOP="2700" LEFT="200" WIDTH="1800" HEIGHT="300" 
                   		     /> 
		<INPUT TYPE="text" CAPTION="Izlaz*-1" NAME="Dug"   TOP="2700" LEFT="1800" WIDTH="3800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 
		


		
		<INPUT TYPE="label" CAPTION="Pot:" NAME="lbl7"   TOP="3200" LEFT="200" WIDTH="1800" HEIGHT="300" 
                   		     /> 
		<INPUT TYPE="text" CAPTION="Izlaz*-1" NAME="Pot"   TOP="3200" LEFT="1800" WIDTH="3800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 



		
		<INPUT TYPE="label" CAPTION="Opis:" NAME="lbl8"   TOP="3700" LEFT="200" WIDTH="1800" HEIGHT="300" 
                  		     /> 
		<INPUT TYPE="text" CAPTION="Opis" NAME="Opis"   TOP="3700" LEFT="1800" WIDTH="1800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 




		<INPUT TYPE="label" CAPTION="OrgShemaGroupBy:" NAME="lbl9"   TOP="4200" LEFT="200" WIDTH="1800" HEIGHT="300"
                    		     /> 
		<INPUT TYPE="text" CAPTION="1" NAME="OrgShemaGroupBy"   TOP="4200" LEFT="1800" WIDTH="500" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 
		




		<INPUT TYPE="label" CAPTION="PartneriGroupBy:" NAME="lbl10"   TOP="4700" LEFT="200" WIDTH="1800" HEIGHT="300"
                    		     /> 
		<INPUT TYPE="text" CAPTION="1" NAME="PartneriGroupBy"   TOP="4700" LEFT="1800" WIDTH="500" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 

		
		<INPUT TYPE="label" CAPTION="DimenzijeGroupBy:" NAME="lbl13"   TOP="5200" LEFT="200" WIDTH="1800" HEIGHT="300"
                    		     /> 
		<INPUT TYPE="text" CAPTION="1" NAME="DimenzijeGroupBy"   TOP="5200" LEFT="1800" WIDTH="500" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 




		<INPUT TYPE="label" CAPTION="Uvjet1:" NAME="lbl11"   TOP="5700" LEFT="200" WIDTH="1800" HEIGHT="300"
                   		     /> 
		<INPUT TYPE="text" CAPTION="Uvjet1" NAME="Uvjet1"   TOP="5700" LEFT="1800" WIDTH="3800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 




		<INPUT TYPE="label" CAPTION="Uvjet2:" NAME="lbl12"   TOP="6200" LEFT="200" WIDTH="1800" HEIGHT="300"
                   		     /> 
		<INPUT TYPE="text" CAPTION="Uvjet2" NAME="Uvjet2"   TOP="6200" LEFT="1800" WIDTH="3800" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 
                           
		
		
		<INPUT TYPE="button" NAME="ok" TOP="6700" LEFT="100" WIDTH="1200" CAPTION="Spremi" 
		ONCLICK="Ok"/>

		<INPUT TYPE="button" NAME="cancle" TOP="6700" LEFT="1500" WIDTH="1200" CAPTION="Izlaz" 
		ONCLICK="close"  />



  </INSERTFORM>





<UPDATEFORM 
					
