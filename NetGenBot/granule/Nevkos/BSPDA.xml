<IZMJENA NAME="IZMJENA" HEIGHT="6941" WIDTH="6552" CAPTION="Izmjena PDA liste" ONLOAD="select 
	g.bspdaglaid as bspdaglaid, 
	g.Naziv as naziv, 
	g.DatumIzrade  as datumIzrade, 
	t.bspdaterminalid as bspdaterminalid,
     capBSTerminalId=t.naziv + &apos; (&apos;+t.Oznaka+&apos;)&apos;,
	g.datumOd as datumOd, 
