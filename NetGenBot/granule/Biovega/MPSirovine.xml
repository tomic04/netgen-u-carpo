<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="" 
   TREE="Granula >>> Sirovine u MP:#sPTreeKlmasterroba:FILTERKLASAFORM" 
   DETAILGRID=""
   FILLEXPLORER="TRUE" 
	BUTTONS="Uvjeti:FILTERFORM#Aktiviraj:MULTISELECTAKTIVIRAJ#Deaktiviraj:MULTISELECTDEAKTIVIRAJ"
   CMD1CAPTION=""    
   CMD2CAPTION="" 
   CMD6CAPTION=""
   CMD4CAPTION=""
   CMD3CAPTION=""
   CMD5CAPTION=""
   CHECKBOXVISIBLE="TRUE"
   TOTALROWVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK=""
   PAGEHEADERLEFT=""
      PAGEHEADERRIGHT="@@tkosmomi"
      SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">

	<NAME>Ažuriranje sirovina u MP  </NAME>
  <CAPTION>Ažuriranje sirovina u MP  </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MT 23.04.2009.  </AUTOR>

	<FILTERKLASAFORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPSirovine @action=1,@klmasterrobaid='@@node'" />

	<FILTERFORM
				   WIDTH="8000" 
				   ONSUBMIT="spMPSirovine @action = 1, " 
				   FILLEXPLORER="TRUE" 
				   ONLOAD="" 
				   FOCUS="search" 
				   HEIGHT="3000" 
				   CAPTION="Odaberite robu"  
				   CMD1CAPTION="Pokaži" 
				   CMD2CAPTION="Izlaz" 
		 >
    <INPUT TYPE="search" NAME="robaid" CAPTION="Roba:" WIDTH="4000" 
           SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid' " ALLOWEMPTY="TRUE" />

    <INPUT TYPE="text" CAPTION="Pojam" NAME="search" TABINDEX="1" TOP="" LEFT="" TEXT="" WIDTH="5500" HEIGHT="320"/>

    <INPUT TYPE="search"  CAPTION="Klasa" NAME="klmasterrobaid" TABINDEX="2" TOP="" LEFT="" TEXT="" WIDTH="5500" HEIGHT="320"
            SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'"/>
    
		<!--<INPUT TYPE="TRAZILICA" CAPTION="Klasa" NAME="klmasterrobaid" TABINDEX="2" TOP="" LEFT="" TEXT="" WIDTH="5500" HEIGHT="320"
				SQL="ViKlaseRobe#klmasterrobaid#%Naziv%"/>-->

		<INPUT TYPE="check" NAME="podklase" TOP="" LEFT="" TABINDEX="3" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase"/>

</FILTERFORM>



	<MULTISELECTAKTIVIRAJ NAME="MULTISELECTAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
		CAPTION="Aktivirati sirovine ?"
		ONSUBMIT=""
		ONLOAD=""
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		>
		<INPUT TYPE="grid"
		NAME="akt"
		TOP="500"
		LEFT="200"
		WIDTH="7000"
		HEIGHT="5000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION="Aktiviranje sirovina"
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="exec spMPSirovine @action = 2 , @operateriid = @@operateriid " />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Aktiviraj"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spMPSirovine @action=3, @operateriid = @@operateriid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTAKTIVIRAJ>

	<MULTISELECTDEAKTIVIRAJ NAME="MULTISELECTDEAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
		CAPTION="Deaktivirati sirovine ?"
		ONSUBMIT=""
		ONLOAD=""
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		>
		<INPUT TYPE="grid"
		NAME="akt"
		TOP="500"
		LEFT="200"
		WIDTH="7000"
		HEIGHT="5000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION="Deaktiviranje sirovina"
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="exec spMPSirovine @action = 2 , @operateriid = @@operateriid " />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Deaktiviraj"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spMPSirovine @action=4, @operateriid = @@operateriid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTDEAKTIVIRAJ>




	<DEAKTIVIRAJ NAME="AKTIVIRAJ" HEIGHT="3197" WIDTH="5501" 
		CAPTION="Deaktivirati asortiman ?" 
		ONSUBMIT="spMPParAsortimanPregledNG @action=8, @partneriid = @@node, "
		ONLOAD="if (select count(*) from parasortiman where partneriid = @@node) = 0 begin 
					exec spRaiserror 69001, 'Nema stavaka asortimana! Ne možete aktivirati' end 
					else begin 
						select naziv as asort from partneri where partneriid = @@node
					end" 
		 FILLEXPLORER="" 	
		 CMD1CAPTION="Dektiviraj" 
		 CMD2CAPTION="Odustani" 
		>
		<INPUT TYPE="text"  NAME="asort" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" TABINDEX="1" ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Asortiman dobavljača :" />
		<INPUT TYPE="checkbox" NAME="doduMP"  CAPTION="Deaktiviraj u asortimanu MP" TOP="900" LEFT="2300"    />
		<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite deaktivirati asortiman? " />
	</DEAKTIVIRAJ>

</PROJECT>
 
