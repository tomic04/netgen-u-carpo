<?xml version="1.0" encoding="windows-1250" ?>


<PROJECT
    ONLOAD=":FILTERFORM"
    CHECKBOXVISIBLE="TRUE"
	  DETCHECKBOXVISIBLE="FALSE"
	  DETTOTALROWVISIBLE="FALSE"
	  TOTALROWVISIBLE="FALSE"
	  DETAILGRID = "spMPProizvodiNG @action=10, @operateriid= @@operateriid, @maloprodajaglaid=@@id"
    MASTERDBLCLICK=""
    COMMANDTIMEOUT="600"
    BUTTONS="Uvjeti:FILTERFORM#Sirovine:SIROVINE#Ažuriraj:AZURIRAJ#Ažuriraj dan:AZURIRAJDAN#Dokumenti:DOKUMENTI"
    POPUPMASTER=""
    PAGEHEADERLEFT="Od @@datumod do @@datumdo"
    PAGEHEADERRIGHT="@@tkosmomi"
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">

	<NAME>Obračun proizvodnje u MP </NAME>
	<CAPTION>Obračun proizvodnje u MP </CAPTION>

	<KOMENTAR> </KOMENTAR>


<FILTERFORM TEXT="Izaberi dokumente"
					TOP="4392"
					LEFT="3200"
					HEIGHT="3500"
					WIDTH="8006"
					CAPTION="Izaberi dokumente"
					NAME="FILTERFORM"
					BORDERSTYLE="3"
					ONSUBMIT="spMPProizvodiNG @action=9, @operateriid= @@operateriid, "
					ONLOAD="select getdate() as datumod, getdate() as datumdo"
					FOCUS="trgovinaid"
					FILLEXPLORER="True"
					CMD1CAPTION="Pokaži"
					CMD2CAPTION="Odustani">
    
		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" HEIGHT="302" WIDTH="4501" ALLOWEMPTY="TRue" TOP="500" LEFT="1500"
				    SQL="spMPDajTrgovinaNG @operateriid = @@operateriid "/>
		
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" HEIGHT="288" WIDTH="1498" DEFAULT="today" TOP="900" LEFT="1500"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" HEIGHT="288" WIDTH="1498" DEFAULT="today" TOP="1300" LEFT="1500"/>
		<INPUT TYPE="combo"  NAME="statusid" CAPTION="Status*" HEIGHT="302" WIDTH="4501" ALLOWEMPTY="TRUE" TOP="1700" LEFT="1500" 
				    SQL="select 0 as ststusid, 'Neobrađeno' as naziv union all select 1,'Obrađeno'"/>

</FILTERFORM>

<PROIZVODI
					FILLEXPLORER=""
					WIDTH="11200"
					ONSUBMIT=""
					ONLOAD=""
					HEIGHT="7000"
					CAPTION="Prodani proizvodi po dokumentu"
					BORDERSTYLE="3"
					CMD1CAPTION=""
					CMD2CAPTION="Odustani"
					CMD3CAPTION=""
					CMD4CAPTION="SIROVINE:SIRART" >

    <INPUT TYPE="grid"
				NAME="Proizvodi"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=10, @operateriid= @@operateriid, @maloprodajaglaid=@@id"/>
  
</PROIZVODI>
  
<SIROVINE
				FILLEXPLORER=""
				WIDTH="11200"
				ONSUBMIT=""
				ONLOAD=""
				HEIGHT="7000"
				CAPTION="Utrošene sirovine po dokumentu "
				BORDERSTYLE="3"
				CMD1CAPTION=""
				CMD2CAPTION="Odustani" >

    <INPUT TYPE="grid"
				NAME="Sirovine"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				CHECKBOXVISIBLE="FALSE"
		    TOTALROWVISIBLE="FALSE"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=11, @operateriid= @@operateriid, @maloprodajaglaid=@@id" >
			<COLUMN INDEX="" NAME="Količina1300" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>
		

</SIROVINE>

<SIRART
				FILLEXPLORER=""
				WIDTH="11200"
				ONSUBMIT=""
				ONLOAD=""
				HEIGHT="7000"
				CAPTION="Utrošene sirovine po proizvodu"
				BORDERSTYLE="3"
				CMD1CAPTION=""
				CMD2CAPTION="Odustani" >

    <INPUT TYPE="grid"
				NAME="SirovineArt"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=12, @operateriid= @@operateriid, @maloprodajadetid=@@Proizvodi"/>

</SIRART>

<DOKUMENTI
				FILLEXPLORER=""
				REPORT=""
				WIDTH="11200"
				ONSUBMIT=""
				ONLOAD=""
				HEIGHT="7000"
				CAPTION="Pregled dokumenta obrade proizvoda i sirovina"
				BORDERSTYLE="3"
				CMD1CAPTION=""
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""
				CMD4CAPTION="Stavke:STAVKEDOK">

    <INPUT TYPE="grid"
				NAME="Dokumenti"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
			  CHECKBOXVISIBLE="FALSE"
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=13, @operateriid= @@operateriid, @maloprodajaglaid=@@id"/>

</DOKUMENTI>

<STAVKEDOK
				FILLEXPLORER=""
				WIDTH="11200"
				ONSUBMIT=""
				ONLOAD=""
				HEIGHT="7000"
				CAPTION="Pregled stavaka dokumenta"
				BORDERSTYLE="3"
				CMD1CAPTION=""
				CMD2CAPTION="Odustani" >

    <INPUT TYPE="grid"
				NAME="ştavkedok"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="11000"
			  CHECKBOXVISIBLE="FALSE"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=14, @operateriid= @@operateriid, @maloprodajaglaid=@@dokumenti"/>

</STAVKEDOK>

<AZURIRAJ
		WIDTH="8700"
		ONSUBMIT=""
		ONLOAD="select @@trgovinaid as trgovinaid,@@datum as datum, poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = getdate() 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end "
		HEIGHT="4200"
		CAPTION="Obračun proizvodnje ?"
		BORDERSTYLE="3">
  
		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" HEIGHT="302" WIDTH="4501" ALLOWEMPTY="TRue"
				    SQL="spMPDajTrgovinaNG @operateriid = @@operateriid "
			      ONLOSTFOCUS="select poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = @@datum 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end #select 'refresh' as poruke"/>

		<INPUT TYPE="date" NAME="datum" CAPTION="Datum " HEIGHT="288" WIDTH="1498"
            ONLOSTFOCUS="select poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = @@datum 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end #select 'refresh' as poruke"/>
		
    <INPUT TYPE="text" NAME="poruka" CAPTION="Status obračuna" ENABLED="FALSE" HEIGHT="288" WIDTH="5000"/>
		<INPUT TYPE="checkbox" NAME="ponovi" CAPTION="Ponovi obračun" />

		<INPUT TYPE="button" NAME="OK" CAPTION="Obračunaj" TOP="2100" LEFT="800" WIDTH="1400" HEIGHT="322" 
			   ONCLICK="if (select coalesce(indproi,0) from trgovina where trgovinaid = @@trgovinaid) = 0 begin 
									exec spRaiserror 69001, &apos;Trgovina nema proizvodnju. Nije potreban obračun !!&apos;
								end 
								else begin 
									exec spMPProizvodiNG  @action = 8, @trgovinaid = @@trgovinaid, @datum = @@datum , @operateriid = @@operateriid, @ponovi = @@ponovi, @obrproiz = 1, @indminuskolicina = 1
								end #OK"  />
		<INPUT TYPE="button" NAME="Odustani" CAPTION="Odustani" TOP="2100" LEFT="2300" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

	</AZURIRAJ>

  <AZURIRAJDAN
      WIDTH="4200"
      ONSUBMIT=""
      ONLOAD="select @@datum as datum"
      HEIGHT="2500"
      CAPTION="Obračun proizvodnje za dan @@datum ?"
      BORDERSTYLE="3">


    <INPUT TYPE="date" NAME="datum" CAPTION="Datum *" HEIGHT="288" WIDTH="1498" TOP="500" LEFT ="1000"
            ONLOSTFOCUS=""/>

    <INPUT TYPE="button" NAME="OK" CAPTION="Obračunaj" TOP="1300" LEFT="500" WIDTH="1400" HEIGHT="322"
			   ONCLICK="exec spmpobracunProizvodnjeJob @action = 0 , @datumod = @@datum , @datumdo = @@datum#OK"  />
    <INPUT TYPE="button" NAME="Odustani" CAPTION="Odustani" TOP="1300" LEFT="2300" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

  </AZURIRAJDAN>


</PROJECT>
