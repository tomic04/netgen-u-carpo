<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
		DETAILGRID="spMPAutomatskeNarudzbeNEW @action = 2 , @robaid = @@id, @trgovinaid = @@trgovinaid, @danaprometa = @@danaprometa , @datumdo = @@Datum_zadnjeg_prometa" 
      CMD1CAPTION="Parametri:FILTERFORM" 
      CMD2CAPTION="" 
      CMD3CAPTION="" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Print dok."   
      REPORT="" 
      MASTERDBLCLICK=""
      POPUPMASTER="">
 
	
	
  <NAME>Pregled robe za automatsku narudžbu od dobavljača</NAME>
  <CAPTION>Pregled robe za automatsku narudžbu od dobavljača</CAPTION>
 
  <KOMENTAR> </KOMENTAR>



	<MASTERCOLUMNS CLEARCOLUMS="FALSE" HEADERALIGNMENT="2">
		<COLUMN INDEX="" NAME="datumzadnjegprometa" WIDTH="1000" CAPTION="Datum zadnjeg prometa " FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	</MASTERCOLUMNS>




	<FILTERFORM
						   FILLEXPLORER="TRUE"
						   REPORT=""
						   WIDTH="8000"
						  ONSUBMIT="spMPAutomatskeNarudzbe @action = 11, "
						  ONLOAD="select @@trgovinaid as trgovinaid, @@partneriid as partneriid, @@danaisporuke as danaisporuke, @@danaprometa as danaprometa, 1 as podklase"
						   HEIGHT="4000"
						   CAPTION="Upis parametara pregleda "
						   BORDERSTYLE="3"
									CMD1CAPTION="Pokaži"
									CMD2CAPTION="Odustani"
									CMD3CAPTION=""
									NEXTFORM=""  >
		<INPUT TYPE="combo"
						NAME="Trgovinaid"
						CAPTION="Trgovina"
						WIDTH="5500"
					HEIGHT="320"
						TABINDEX="1"
					ALLOWEMPTY="FALSE"
					ONCLICK="select 'refresh' as skladisteid" 
					SQL="spMPDajTrgovinaNG @operateriid=@@operateriid"  />

		<INPUT TYPE="search" NAME="partneriid" CAPTION="Partner"  SQL="vipartneri#partneriid#naziv%#%mjestanaziv%#!adresa" ALLOWEMPTY="TRUE" />


		<INPUT TYPE="combo"
						NAME="klmasterrobaid"
						CAPTION="Klasa robe"
						WIDTH="5500"
					HEIGHT="320"
						TABINDEX="1"
					ALLOWEMPTY="FALSE"
					SQL="select klmasterrobaid , naziv from klmasterroba order by 1 "  />
		<INPUT TYPE="check"
				CAPTION="Uzmi i sve podklase"
				NAME="podklase"
				SQL=""
				TEXT=""
				TABINDEX="4"
				WIDTH="5000"
				HEIGHT="320"/>

		<INPUT TYPE="number"
									  NAME="danaisporuke"
										  CAPTION="Dana isporuke"
									  VALUE=""
									  DECIMALS="0"
									  HEIGHT="320"
									  WIDTH="1500"
									  TABINDEX="2"
										  CHECKBOX="FALSE"/>

		<INPUT TYPE="number"
					NAME="danaprometa"
					CAPTION="Dana prometa"
					VALUE=""
					DECIMALS="0"
					HEIGHT="320"
					WIDTH="1500"
					TABINDEX="3"
						CHECKBOX="FALSE"/>

		<INPUT TYPE="check"
				CAPTION="Zaokruži na pakovanje"
				NAME="pakovanje"
				SQL=""
				TEXT=""
				TABINDEX="4"
				WIDTH="5000"
				HEIGHT="320"/>


	</FILTERFORM>










</PROJECT>
 
