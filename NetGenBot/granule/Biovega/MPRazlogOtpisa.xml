<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpRazlogOtpisa @action = 0" 
   CMD1CAPTION=""
   CMD2CAPTION="Dodaj:INSERTFORM" 
   CMD3CAPTION="Izmjeni:UPDATEFORM"
   CMD4CAPTION="" 
   CMD5CAPTION=""
   CMD6CAPTION=""
   DETAILGRID = "" 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK=""
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Ažuriranje razloga otpisa robe u MP</NAME>
  <CAPTION>Ažuriranje razloga otpisa robe u MP </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MH 29.01.2018.  </AUTOR>




  <INSERTFORM
		WIDTH="7000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="2800"
		VERSION="1.13"
    CAPTION="Unos podatka"
		FOCUS="Opis"
		>

    <INPUT TYPE="text" CAPTION="Razlog otpisa *" NAME="opis" SQL="" TABINDEX="1" LEFT="1500" TOP="500" WIDTH="4300" HEIGHT="700" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2" MULTILINE="TRUE"/>
	<INPUT TYPE="text" NAME="sort"  CAPTION="Sortkey*"  TOP="1300" LEFT="1500" SQL="" ONLOSTFOCUS="" ALLOWEMPTY="TRUE" WIDTH="600" BACKCOLOR="LIGHTYELLOW"  />
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="1900" LEFT="196" WIDTH="1106" HEIGHT="322" 
           ONCLICK="spmpRazlogOtpisa @action=1, @opis = '@@opis', @sort='@@sort' #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1900" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </INSERTFORM>
	

  <UPDATEFORM 
        WIDTH="7000" 
        ONSUBMIT="" 
        ONLOAD="select * from MPRazlogOtpisa where MPRazlogOtpisaId = @@id" 
        FOCUS="OPis"
        HEIGHT="3400" 
		VERSION="1.14"
        CAPTION="Izmjena podatka"  
		
		>

    <INPUT TYPE="text" CAPTION="Razlog otpisa*" NAME="opis" SQL="" TABINDEX="1" LEFT="1500" TOP="500" WIDTH="4300" HEIGHT="700" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2" MULTILINE="TRUE"/>
	<INPUT TYPE="text" NAME="sort"  CAPTION="Sortkey*"  TOP="1300" LEFT="1500" SQL="" ONLOSTFOCUS="" ALLOWEMPTY="TRUE" WIDTH="600" BACKCOLOR="LIGHTYELLOW" />
    <INPUT TYPE="check" CAPTION="Aktivno" NAME="status" SQL="" TABINDEX="1" LEFT="1500" TOP="1800" WIDTH="3300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2500" LEFT="500" WIDTH="1106" HEIGHT="322"
           ONCLICK="spmpRazlogOtpisa @action=2, @Id =  @@id,  @opis = '@@opis' , @status = @@status, @sort='@@sort' #Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2500" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </UPDATEFORM>



