           NAME="stavke" 
           CAPTION="Štampanje iz Jupitera" 
           TOP="200" LEFT="1400" 
           WIDTH="8500" HEIGHT="3000" 
           CHECKBOXVISIBLE="FALSE"
           TOTALROW="FALSE"
           GROUPBYBOXVISIBLE="FALSE"
           SQL="select u.mpUvjetiKaseid,[Aktivno0800] = case when u.status = 1 then 'NE' else 'DA' end,r.naziv as [Roba2000],kl.naziv as [Klasa2000],
                u.popust as [% popusta0800],u.mpcijena as [MP cijena1000],
                u.datumod as [Datum početka1000],u.datumdo as [Datum kraja1000],u.satod as [Početni sat1000],u.satdo as [Završni sat1000]
                from totalgenmultiselecttemp t 
                inner join mpUvjetiKase u on t.id=u.mpUvjetiKaseid 
                left outer join roba r on u.robaid = r.robaid 
                left outer join klmasterroba kl on u.klmasterrobaid = kl.klmasterrobaid 
                where t.operateriid=@@operateriid"/>

