<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
ONLOAD=":FILTERFORM"  
BUTTONS="Parametri:FILTERFORM#Promet OTP:PROMETOTP#Popravi:POPRAVI"
PAGEHEADERRIGHT="@@tkosmomi"
GROUPBYBOXVISIBLE="TRUE" 
CHECKBOXVISIBLE="FALSE"
TOTALROWVISIBLE="FALSE"
DETAILGRID="spMPKontrolaIzdatnica @action=5, @id = @@id"
POPUPMASTER=""> 
 

<NAME>Analiza izdatnica iz VP u MP</NAME>
<CAPTION>Analiza izdatnica iz VP u MP</CAPTION>


<FILTERFORM
	FILLEXPLORER="TRUE"
	WIDTH="9000" HEIGHT="3000"
	ONSUBMIT="spMPKontrolaIzdatnica @action=1, @operateriid = @@operateriid,"
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo"
	CAPTION="Upišite uvjete pregleda "
	BORDERSTYLE="3"
	CMD1CAPTION="Pokaži"
	CMD2CAPTION="Odustani">


	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="250" LEFT="1200" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="250" LEFT="4200" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="650" LEFT="1200" HEIGHT="320" WIDTH="3000" ALLOWEMPTY="TRUE" 
		   SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as naziv from trgovina t 
				inner join trgovineprava tp on t.trgovinaid = tp.trgovinaid
				where tp.operaterid = @@operateriid
				and t.vrstatrg in ('M','F') 
				order by 2"/>
	<INPUT TYPE="combo" NAME="sifra" CAPTION="Vrsta prometa*" TOP="1050" LEFT="1200" HEIGHT="320" WIDTH="3000" ALLOWEMPTY="FALSE"
		   SQL="select '104' as sifra, 'Izdatnica iz VP u MP' as naziv union all select '119', 'Povratnica iz MP u VP' "/>
	<INPUT TYPE="check" NAME="razlike" CAPTION="Samo razlike*" TOP="1450" LEFT="1200" WIDTH="2000"/>

</FILTERFORM>


<PROMETMP
	FILLEXPLORER="TRUE" 
	WIDTH="14000" HEIGHT="7500"
	CAPTION="Stavke prometa" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani">


	<INPUT TYPE="grid"
	    NAME="stavke"
	    TOP="200"
	    LEFT="200"
	    WIDTH="12000"
		HEIGHT="6000"
	    CHECKBOXVISIBLE="FALSE"
	    TOTALROWVISIBLE="FALSE"
	    GROUPBYBOXVISIBLE="TRUE"
        CAPTION="_Stavke mp prometa"
	    REFRESHAFTERCHILD="TRUE"
        SQL="spMPKontrolaIzdatnica @action=2, @id = @@id" />
</PROMETMP>



<PROMETSKL
	FILLEXPLORER="TRUE"
	WIDTH="14000" HEIGHT="7500"
	CAPTION="Stavke prometa"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION="Odustani">


	<INPUT TYPE="grid"
		NAME="stavke"
		TOP="200"
		LEFT="200"
		WIDTH="12000"
		HEIGHT="6000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
		GROUPBYBOXVISIBLE="TRUE"
		CAPTION="_Stavke skl prometa"
		REFRESHAFTERCHILD="TRUE"
		SQL="spMPKontrolaIzdatnica @action=3, @id = @@id" />
</PROMETSKL>



<PROMETOTP
	FILLEXPLORER="TRUE"
	WIDTH="14000" HEIGHT="7500"
	CAPTION="Stavke prometa"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION="Odustani">


	<INPUT TYPE="grid"
		NAME="stavke"
		TOP="200"
		LEFT="200"
		WIDTH="12000"
		HEIGHT="6000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
		GROUPBYBOXVISIBLE="TRUE"
		CAPTION="_Stavke prometa"
		REFRESHAFTERCHILD="TRUE"
		SQL="spMPKontrolaIzdatnica @action=4, @id = @@id" />
</PROMETOTP>

	<POPRAVI
  NAME="UPDATE_NC"
  HEIGHT="2200" WIDTH="8000"
  CAPTION="Korekcija razlike "
  ONLOAD="select broj, maloprodajaglaid from maloprodajagla where maloprodajaglaid = @@id  "
  ONSUBMIT="spMPKontrolaIzdatnica @action=6, @id = @@id!!  "
  ONLOADED =""
  FILLEXPLORER=""
  CMD1CAPTION="Popravi"
  CMD2CAPTION="Odustani">

		<INPUT TYPE="text" NAME="maloprodajaglaid" TOP="500" LEFT="2800" HEIGHT="490" WIDTH="2000" CAPTION="" ENABLED="FALSE"  VISIBLE="FALSE"/>
		<INPUT TYPE="text" NAME="Broj" TOP="500" LEFT="2800" HEIGHT="490" WIDTH="2000" CAPTION="Broj dokumenta*" ENABLED="FALSE" />

	</POPRAVI>


</PROJECT> 