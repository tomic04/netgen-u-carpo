<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Pregled prometa artikala MP"
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT=""
		 PAGEORIENTATION="LANDSCAPE"
     PAGEHEADERLEFT="Od @@datumod do @@datumdo"
     PAGEHEADERRIGHT="@@tkosmomi"
     SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">


	<NAME>Pregled prometa sirovina u MP </NAME>
	<CAPTION>Pregled prometa sirovina u MP </CAPTION>
	<AUTOR>4.6.2009. im </AUTOR>



<FILTERFORM NAME="FILTERFORM" 
		 HEIGHT="5254" 
		 WIDTH="7710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPPregPromSirovina @action = 1,  @operateriid= @@operateriid, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" >
		 
		 <INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:" DEFAULT="firstdayofmonth"/>
		 <INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:" />
	     <INPUT TYPE="combo"  NAME="vrstapromid"     CAPTION="Vrsta prometa:"    ALLOWEMPTY="TRUE"  ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
	     <INPUT TYPE="combo"  NAME="vrstadokid"      CAPTION="Vrsta dokumenta:"  ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
	     <INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:"   ALLOWEMPTY="TRUE"  ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	     <INPUT TYPE="search" NAME="partneriid"      CAPTION="Partner:"    SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />  
		 <INPUT TYPE="combo"  NAME="skladisteid"     CAPTION="Skladište:"  ALLOWEMPTY="TRUE"  SQL="spmpDajSkladiste @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />

    <INPUT TYPE="search"  CAPTION="Klasa" NAME="klasaid" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW"
      SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
  
    <!--<INPUT TYPE="search" NAME="klasaid"  CAPTION="Klasa:"    SQL="viklaserobe#klmasterrobaid#%naziv%" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />-->  
	
    <INPUT TYPE="search" NAME="robaid"          CAPTION="Roba:"    SQL="viroba#robaid#%naziv%#%jmnaziv%#%robakod%#!barcode" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />  
				 
</FILTERFORM>



</PROJECT>