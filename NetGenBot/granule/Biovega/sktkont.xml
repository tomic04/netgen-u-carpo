<FRMKARTICA NAME="FRMKARTICA" HEIGHT="8251" WIDTH="17798" CAPTION="Ažuriranje" ONLOAD="select @@robaid as robaid, @@skladisteid as skladisteid" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="grid" NAME="grid2" TOP="72" LEFT="11290" HEIGHT="6797" WIDTH="5616" TOTALROW="TRUE" CHECKBOXVISIBLE="FALSE" SQL="spSktKontingenti_Query @action=3, @robaid=@@robaid, @skladisteid=@@skladisteid">
		<COLUMN INDEX="" NAME="broj" WIDTH="1800" CAPTION="Broj" FORMAT="#,##0.#" VISIBLE="" />
<COLUMN INDEX="" NAME="Ulaz" WIDTH="1100" CAPTION="Ulaz" FORMAT="#,##0.#" VISIBLE="" />
<COLUMN INDEX="" NAME="Izlaz" WIDTH="1100" CAPTION="Izlaz" FORMAT="#,##0.#" VISIBLE="" />
<COLUMN INDEX="" NAME="Razlika" WIDTH="1100" CAPTION="Razlika" FORMAT="#,##0.#" VISIBLE="" />
	</INPUT>
	<INPUT TYPE="grid" NAME="grid1" TOP="72" LEFT="72" HEIGHT="6811" WIDTH="11074" TOTALROW="TRUE" ONDBLCLICK="spSktKontingenti_Azur @@grid1, @@kkvalglaid#select &apos;refresh&apos; as grid1, &apos;refresh&apos; as grid2" CHECKBOXVISIBLE="FALSE" SQL="spSktKontingenti_Query @action=1, @robaid=@@robaid, @skladisteid=@@skladisteid"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="7114" LEFT="72" HEIGHT="331" WIDTH="2117" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Zatvori" ENABLED="TRUE" ONCLICK="OK"/>
	<INPUT TYPE="button" NAME="ButtonNG6" TOP="7142" LEFT="9475" HEIGHT="331" WIDTH="1699" TEXT="ButtonNG1" CAPTION="Dodijeli označenima" ONCLICK="FOREACHBLUEROW(grid1)#spSktKontingenti_Azur @@grid1, @@grid2
#select &apos;refresh&apos; as grid1, &apos;refresh&apos; as grid2"/>
	<INPUT TYPE="combo" NAME="kkvalglaid" TOP="7142" LEFT="5616" HEIGHT="302" WIDTH="3715" VISIBLE="FALSE" SQL="spSktKontingenti_Query @action=2, @robaid=@@robaid, @skladisteid=@@skladisteid"/>
	<INPUT TYPE="label" NAME="Label14" TOP="7142" LEFT="4622" HEIGHT="288" WIDTH="965" VISIBLE="FALSE" CAPTION="Kontingent" TEXT="Label14"/>
	<INPUT TYPE="text" NAME="robaid" TOP="7142" LEFT="2938" HEIGHT="288" WIDTH="706" VISIBLE="FALSE"/>
	<INPUT TYPE="text" NAME="skladisteid" TOP="7142" LEFT="4075" HEIGHT="288" WIDTH="547" VISIBLE="FALSE"/>

</FRMKARTICA>

<FRMAZUR NAME="FRMAZUR" HEIGHT="3802" WIDTH="7085" CAPTION="Form" ONSUBMIT="spSktKontingenti_Azur @@grid1, @@kkvalglaid" ONLOAD="select @@grid1 as sktprometdetid, @@kkvalglaid as kkvalglaid" FILLEXPLORER="FALSE">
	<INPUT TYPE="text" NAME="sktprometdetid" TOP="1080" LEFT="2362" HEIGHT="288" WIDTH="1440"/>
	<INPUT TYPE="text" NAME="kkvalglaid" TOP="1541" LEFT="2362" HEIGHT="288" WIDTH="1440"/>
	<INPUT TYPE="button" NAME="ButtonNG5" TOP="2520" LEFT="720" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG5" ONCLICK="OK"/>

</FRMAZUR>

<FILTER NAME="FILTER" HEIGHT="2808" WIDTH="7200" CAPTION="Filter" ONSUBMIT="select distinct v.skladisteid, v.robaid, r.userid, r.naziv as Roba3500, s.opis as Skladiste3500
from visktpromet v (nolock)
inner join skladiste s on s.skladisteid=v.skladisteid and s.kkvalobavezan=1
inner join roba r on r.robaid=v.robaid and r.kkvalobavezan=1
where year(datumdok)=2012
and (v.robaid=@@robaid or @@robaid is null)
and (v.skladisteid=@@skladisteid or @@skladisteid is null)" FILLEXPLORER="TRUE">
	<INPUT TYPE="search" NAME="robaid" TOP="274" LEFT="1411" HEIGHT="302" WIDTH="4075" VISIBLE="TRUE" SQL="roba#robaid#userid%#robakod%#%naziv%" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" CAPTION="robaid" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="lblRobaid" TOP="274" LEFT="216" HEIGHT="288" WIDTH="1728" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Roba" ENABLED="TRUE" TEXT="Label28"/>
	<INPUT TYPE="search" NAME="skladisteid" TOP="806" LEFT="1411" HEIGHT="302" WIDTH="4090" SQL="skladiste#skladisteid#oznaka%#%opis%"/>
	<INPUT TYPE="label" NAME="lblSkladiste" TOP="806" LEFT="216" HEIGHT="288" WIDTH="1728" VISIBLE="TRUE" CAPTION="Skladište" ENABLED="TRUE"/>
	<INPUT TYPE="button" NAME="button1" TOP="1541" LEFT="317" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG3" CAPTION="Prihvati" ONCLICK="OK"/>
	<INPUT TYPE="button" NAME="button2" TOP="1541" LEFT="1469" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG4" CAPTION="Odustani" ONCLICK="CLOSE"/>

</FILTER>
</PROJECT>