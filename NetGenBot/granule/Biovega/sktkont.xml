<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Kartica:FRMKARTICA" CMD3CAPTION="Filter:FILTER" ONLOAD="select vi.*, r.userid as sifra, r.naziv from vikkvalkatalog vi
		  inner join roba r on r.robaid = vi.robaid
where skladisteid =2
and raspolozivo&lt;0" GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" MASTERDBLCLICK=":FRMKARTICA" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE" ONLOADQ="select distinct v.skladisteid, v.robaid, r.userid  as RobaKod, r.naziv as Roba3500, s.opis as Skladiste3500
from visktpromet v
inner join skladiste s on s.skladisteid=v.skladisteid and s.kkvalobavezan=1
inner join roba r on r.robaid=v.robaid and r.kkvalobavezan=1
where year(datumdok) =2014 /*and vrstadokid=62 and kkvalglaid is null*/
and v.kolicinaulaz-v.kolicinaizlaz != 0
">
<NAME>SKT-KONT-AZUR</NAME>
<CAPTION>Ažuriranje Kontingenata</CAPTION>
<KOMENTAR>CallistoII 2.21.0</KOMENTAR>
<HISTORY>
