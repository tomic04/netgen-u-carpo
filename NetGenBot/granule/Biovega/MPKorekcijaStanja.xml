<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpKorekcijaStanja @action=1,@Operateriid=@@Operateriid" 
   TREE="" 
   VERSION="1.2"
   DETAILGRID=""
   FILLEXPLORER="TRUE" 
	BUTTONS=""
   CMD1CAPTION=""    
   CMD2CAPTION="Deaktiviraj:DEAKT" 
    CMD3CAPTION=""   
   CMD4CAPTION=""
   CMD5CAPTION="Povijest korekcije artikla na trgovini:HISTFORM"
   CMD6CAPTION=""
   CMD7CAPTION=""
    CMD8CAPTION=""
   
	FILTERMODE="TRUE"
	EDITCOLUMNSDET=""
	COMMANDTIMEOUT="300"
	ONCELLEDITEDDET=""
   CHECKBOXVISIBLE="FALSE"
   TOTALROWVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK="">

	<NAME>Pregled korekcija stanja</NAME>
  <CAPTION>Pregled korekcija stanja</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> </AUTOR>


	<DEAKT
	  NAME="DEAKT" HEIGHT="3197" WIDTH="5501"
	  CAPTION="Deaktiviraj odabrani slog  ?"
	  ONSUBMIT="spmpKorekcijaStanja @action=3,@Operateriid=@@Operateriid, @id=@@id, @Razloziid=@@Razloziid--"
	  ONLOAD="if (select coalesce(IndStatus,0) from MPKorekcijaStanja where MPKorekcijaStanjaid= @@ID ) = 0 begin 
			exec spRaiserror 69001, 'Zapis je neaktivan, nemože se deaktivirati!' 
			end else begin
			exec spmpKorekcijaStanja @action=4, @id=@@id
			end"
	  FILLEXPLORER=""
	  CMD1CAPTION="Deaktiviraj"
	  CMD2CAPTION="Odustani" >

		<INPUT TYPE="text" NAME="roba" TOP="325" LEFT="931" HEIGHT="490" WIDTH="4234" CAPTION="Roba: *" ENABLED="FALSE"/>
		<INPUT TYPE="text" NAME="trgovina" TOP="825" LEFT="931" HEIGHT="490" WIDTH="4234" CAPTION="Trgovina: *" ENABLED="FALSE" />
		<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="931" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite deaktivirati zapis  ? " />
		<INPUT TYPE="combo"  NAME="Razloziid"		CAPTION="Razlog deaktivacije:* "  TOP="1825" LEFT="1531" HEIGHT="490" WIDTH="3634" 
			   SQL="select MPKorekcijaStanjaRazloziid, opis from MPKorekcijaStanjaRazlozi " ALLOWEMPTY="FALSE"/>
		
	</DEAKT>

	<HISTFORM
			 WIDTH="10500"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="8000"
			 CAPTION="Povijest artikla na trgovini"
			 CMD1CAPTION=""
			 CMD2CAPTION=""
			 FILLEXPLORER=""
			 VERSION="1.1"

		 >
		<INPUT TYPE="grid"
			   NAME="korkcija"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION=" "
			   TOP="500" LEFT="300" WIDTH="8400" HEIGHT="5000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT=""
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpKorekcijaStanja @action=2, @id = @@id" />

	
		<INPUT TYPE="button" NAME="cancel" CAPTION="Zatvori" TABINDEX="1" TOP="6000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</HISTFORM>



</PROJECT>
 
