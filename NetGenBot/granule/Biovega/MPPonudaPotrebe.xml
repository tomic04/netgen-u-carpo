<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 ONLOAD=":FILTERFORM" 
		 MASTERDBLCLICK=""
		 MULTIGRIDLAYOUT="TRUE" 
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="Ispiši:repx/rptBiovegaWebIsporuka(@datumod=@@datumod, @datumdo=@@datumdo)" 
		 CMD4CAPTION="Pošalji mail:ASSEMBLYLOAD(PdfCreateSend.CreateSend)" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION="Dodaj artikl:DODAJART"
		  CMD7CAPTION="Obriši artikl:OBRISIART"
		 CMD8CAPTION="Izmjeni količinu:IZMJENIART"
		 CMD9CAPTION=""
		 CMD10CAPTION="Donesi sa narudžbe:DONOSNAR"
		 POPUPMASTER="Parametri:FILTERFORM" 
	     TREE=""
		 GROUPBYBOXVISIBLE="TRUE"
		 CHECKBOXVISIBLE="TRUE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE" >

	<NAME>Webshop - Potrebe za isporuku</NAME>
	<CAPTION>Webshop - Potrebe za isporuku</CAPTION>






		
<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="4500" 
	WIDTH="7000" 
	CAPTION="Upišite uvjete prikaza" 
	ONSUBMIT="spmpPonudaPotrebe @action = 1,  @operateriid= @@operateriid, "
	ONLOAD="select 1 as status" 
	VERSION="1.1"
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani">
	
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od:*" LEFT="2500" TOP="500"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do:*" LEFT="2500" TOP="1000" />
	<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="TRUE" CAPTION="Status:*" 
		   SQL="select 1 as status , 'Nezaključeno' as Naziv union all select 2 , 'Zaključeno' "  LEFT="2500" TOP="1500"/>
	<INPUT TYPE="multidrop"    NAME="dodklasa"   ALLOWEMPTY="FALSE" CAPTION="Dodatna klasa:*" WIDTH="4200"
			SQL="spmpDajDodKlasa @duzina = 4" LEFT="2500" TOP="2000" />
	<INPUT TYPE="text" NAME="dokument1" CAPTION="Od broja webshop narudžbe:*" LEFT="2500" TOP="2500" />
	<INPUT TYPE="text" NAME="dokument2" CAPTION="Od broja dokumenta 0800 ponude:*" LEFT="2500" TOP="3000"/>
	<INPUT TYPE="combo" NAME="Neispisano" ALLOWEMPTY="TRUE" CAPTION="Ispis:*"
		   SQL="select 0 as Neispisano , 'Neispisano' as Naziv union all select 1 , 'Ispisano' "  LEFT="2500" TOP="3500"/>
</FILTERFORM>

	<DODAJART
	 NAME="DODAJART" HEIGHT="4000" WIDTH="6000"
	 CAPTION="Dodavanje artikla"
	 ONLOAD=""
	 ONSUBMIT="spmpPonudaPotrebe @action = 11,  @operateriid= @@operateriid--,"
	 FILLEXPLORER="TRUE" 
	 >

		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba" WIDTH="4000" ALLOWEMPTY="FALSE" HEIGHT="317"
				   SQL="spMPRobaZaMPNG @trgovinaid = 18 , @trazi = '@@searchboxrobaid', @operateriid = @@operateriid"  BACKCOLOR="LIGHTYELLOW" HOTKEY=""/>
		<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina"   WIDTH="1500" HEIGHT="302" DECIMALS="4" VALUE="1"
		   ONLOSTFOCUS="" SQL=""  />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Dodaj"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaPotrebe @action = 4, @robaid=@@robaid, @kolicina=@@kolicina#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
			   
	</DODAJART>

	<OBRISIART
	NAME="OBRISIART"
	HEIGHT="3000" WIDTH="7000"
	CAPTION="Brisanje stavke"
	ONLOAD="exec spmpPonudaPotrebe @action = 6, @robaid=@@id" 
	 ONSUBMIT="spmpPonudaPotrebe @action = 11,  @operateriid= @@operateriid--,"
	FILLEXPLORER="TRUE"  >

		<INPUT TYPE="text"   NAME="userid"       CAPTION="Šifra"      HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="FALSE" />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaPotrebe @action = 5, @robaid=@@robaid#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</OBRISIART>

	<IZMJENIART
NAME="IZMJENIART"
HEIGHT="3000" WIDTH="7000"
CAPTION="Izmjena stavke"
ONLOAD="exec spmpPonudaPotrebe @action = 6, @robaid=@@id"
 ONSUBMIT="spmpPonudaPotrebe @action = 11,  @operateriid= @@operateriid--,"
FILLEXPLORER="TRUE"  >

		<INPUT TYPE="text"   NAME="userid"       CAPTION="Šifra"      HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="" />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Izmjeni"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaPotrebe @action = 10, @robaid=@@robaid, @kolicina=@@kolicina#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</IZMJENIART>

	<DONOSNAR
		 
		FILLEXPLORER="TRUE"
		WIDTH="8800"
		ONSUBMIT="spmpPonudaPotrebe @action = 11,  @operateriid= @@operateriid--,"
		ONLOAD=""
		HEIGHT="10000"
		FOCUS="povezinar"
		CAPTION="Izbor narudžbenica ">
		<INPUT TYPE="frame"  NAME="fr1"  CAPTION="Narudžbenice za preuzimanje" TOP="400" LEFT="56" WIDTH="6800" HEIGHT="4000" STYLE="1"  />
		<INPUT TYPE="frame"  NAME="fr2"  CAPTION="Stavke narudžbenice" TOP="4400" LEFT="56" WIDTH="8500" HEIGHT="5000" STYLE="1" />


		<INPUT TYPE="grid"
			NAME="povezinar"
			TOP="700"
			LEFT="200"
			WIDTH="6500"
			HEIGHT="3500"
			CHECKBOXVISIBLE="FALSE"
			TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
			GROUPBYBOXVISIBLE="FALSE"
			CAPTION="_Zadnje narudžbenice skladištu"
			REFRESHAFTERCHILD=""
			VISIBLE="TRUE"
			ONCLICK="select 'refresh' as povezinar1"
			SQL="spmpPonudaPotrebe @action = 7 " />

		<INPUT TYPE="grid"
			NAME="povezinar1"
			TOP="4700"
			LEFT="200"
			WIDTH="8200"
			HEIGHT="4500"
			CHECKBOXVISIBLE="FALSE"
			TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
			GROUPBYBOXVISIBLE="FALSE"
			CAPTION=""
			REFRESHAFTERCHILD=""
			VISIBLE="TRUE"
			SQL="spmpPonudaPotrebe @action = 8, @id = @@povezinar" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Preuzmi"  TOP="1500" LEFT="7000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpPonudaPotrebe @action = 9, @id = @@povezinar#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2500" LEFT="7000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DONOSNAR>


	

</PROJECT>