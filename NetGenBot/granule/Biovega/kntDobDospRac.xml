<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Prikaz:FILTERFORM" 
      CMD2CAPTION="Virman:VIRMANFORM" 
      CMD3CAPTION="Ispis:PRINTMASTER"
      CMD4CAPTION="Označi:MULTIBLUEEDIT"
      MASTERDBLCLICK=":UPDATEFORM"
      POPUPMASTER="Označi:MULTIBLUEEDIT"		
      CHECKBOXVISIBLE="FALSE" 
      PAGEHEADERCENTER=""
      PAGEHEADERRIGHT="u periodu: @@datod do @@datdo"
	  PAGEHEADERLEFT="@@searchboxpartneriid"
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@tkosmomi##@@mjesto"
	  PAGEFOOTERRIGHT="@@datdanas##Jupiter Software by SPIN"
	  PAGEORIENTATION=""	  
	  TOTALROWVISIBLE="TRUE"
          SETDEFAULTS=""
	  COMMANDTIMEOUT="120"
      >

 
  <NAME>Dobavljači - prijedlog za plaćanje</NAME>
  <CAPTION>Dobavljači - prijedlog za plaćanje</CAPTION>




	<MASTERCOLUMNS>
		<COLUMN INDEX="" NAME="Partnernaziv" WIDTH="2000" CAPTION="Partner" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="Broj" WIDTH="2000" CAPTION="Broj" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="Datumdok" WIDTH="1000" CAPTION="Datum dokumenta" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="IznosRacuna" WIDTH="1200" CAPTION="Iznos računa" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="lightyellow" />
		<COLUMN INDEX="" NAME="IznosRacunaBezPDV" WIDTH="1200" CAPTION="Iznos bez PDV-a" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="IznosPdv" WIDTH="1200" CAPTION="Iznos poreza" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="CassaScontoIznos" WIDTH="1200" CAPTION="Cassa Sconto Iznos" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="CassaScontoPosto" WIDTH="0800" CAPTION="Cassa Sconto Posto" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="CassaScontoDana" WIDTH="0800" CAPTION="Cassa Sconto Dana" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="IznosZaPlatiti" WIDTH="1200" CAPTION="Iznos za platiti" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="NacinObracuna" WIDTH="1000" CAPTION="Nacin obračuna" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		
	</MASTERCOLUMNS>

	<FILTERFORM
					
                 WIDTH="5500"
                 ONLOAD="select @@datod as datod , @@datdo as datdo ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas,
                         (select m.naziv  from partneri p
			 inner join parstru ps on ps.partneriid=p.partneriid
			 inner join mjesta m on m.mjestaid=ps.mjestaid
			 where p.partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))
			 and ps.hqind='*') AS mjesto,
                         '@@searchboxpartneriid' as ParNaziv"
                
		 ONSUBMIT="spkntDobDospRacNG @Action=1,"
                 HEIGHT="2700"
                 CAPTION="Parametri"
                 CMD1CAPTION="Ok"
                 CMD2CAPTION="Izlaz"
		 FILLEXPLORER="TRUE"
  		 >

		<INPUT TYPE="date"	NAME="datod"	TOP="250"	LEFT="1300"	CAPTION="Razdoblje:*"	HEIGHT="320"	WIDTH="1500"	DEFAULT="firstdayofyear"/>
		<INPUT TYPE="date"	NAME="datdo"	TOP="250"	LEFT="3200"	CAPTION=" do:*"			HEIGHT="320"	WIDTH="1500" />


		<INPUT TYPE="search"	NAME="partneriid" TOP="850"	LEFT="1300" CAPTION="Partner:*"	  	HEIGHT="300"	 WIDTH="3400"  ALLOWEMPTY="TRUE"
                 SQL="partneri#partneriid#naziv%"
                 ONLOSTFOCUS="select naziv as nazivpartner,telefon1 as telefon,fax from vipartneri where partneriid=@@partneriid" />



	</FILTERFORM>


	<VIRMANFORM   CAPTION="Proknjiži " HEIGHT="1700" WIDTH= "4200"
									  FILLEXPLORER="TRUE"
					   ONLOAD=""
					   ONSUBMIT="spkntDobDospRacNG @action=4"
					   CMD1CAPTION="OK"
					   CMD2CAPTION="Odustani"
					   NEXTFORM="" >

		<INPUT TYPE="label" NAME="lblpitanje" TOP="300" LEFT="250" WIDTH="400" CAPTION="Želite napraviti virmane?"/>

	</VIRMANFORM>





	<UPDATEFORM
		   
				FILLEXPLORER="TRUE"	ONSUBMIT="spkntDobDospRacNG @action=2, @tmpKntDobDospRacNGId=@@tmpKntDobDospRacNGId,@datod=@@datod,@datdo=@@datdo">


	</UPDATEFORM>


	<MULTIBLUEEDIT 
					
               FILLEXPLORER="TRUE"	ONSUBMIT="spkntDobDospRacNG @action=6, @tmpKntDobDospRacNGId=@@tmpKntDobDospRacNGId,@datod=@@datod,@datdo=@@datdo"> 

  	</MULTIBLUEEDIT>





</PROJECT>
 


