<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
		DETAILGRID="spmpAnalizeLoy @action = 2 , @datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@trgovinaid, @mpclanoviid = @@mpclanoviid, @robaid = @@id, @roba2id = @@roba2id" 
      CMD1CAPTION="Parametri:FILTERFORM" 
      CMD2CAPTION="" 
      CMD3CAPTION="" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Print dok."   
      REPORT="" 
		COMMANDTIMEOUT="300"
      MASTERDBLCLICK=""
		 GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
      POPUPMASTER="">
 
	
	
  <NAME>Analiza vezane prodaje </NAME>
  <CAPTION>Analiza vezane prodaje </CAPTION>
 
  <KOMENTAR> </KOMENTAR>



	<MASTERCOLUMNS CLEARCOLUMS="FALSE" HEADERALIGNMENT="2">
		<COLUMN INDEX="" NAME="datumzadnjegprometa" WIDTH="1000" CAPTION="Datum zadnjeg prometa " FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	</MASTERCOLUMNS>




	<FILTERFORM
						   FILLEXPLORER="TRUE"
						   REPORT=""
						   WIDTH="8000"
						  ONSUBMIT="spmpAnalizeLoy @action = 1, "
						  ONLOAD="select @@trgovinaid as trgovinaid, @@datumod as datumod, @@datumdo as datumdo "
						   HEIGHT="4000"
						   CAPTION="Upis parametara pregleda "
						   BORDERSTYLE="3"
									CMD1CAPTION="Pokaži"
									CMD2CAPTION="Odustani"
									CMD3CAPTION=""
									NEXTFORM=""  >
		<INPUT TYPE="combo"
						NAME="Trgovinaid"
						CAPTION="Trgovina"
						WIDTH="5500"
					HEIGHT="320"
						TABINDEX="1"
					ALLOWEMPTY="FALSE"
					ONCLICK="select 'refresh' as skladisteid" 
					SQL="spMPDajTrgovinaNG @operateriid=@@operateriid"  />
		<INPUT TYPE="date"
									  NAME="datumod"
										  CAPTION="Datum od "
									  VALUE=""
									  DECIMALS="0"
									  HEIGHT="320"
									  WIDTH="1500"
									  TABINDEX="2"
										  CHECKBOX="FALSE"/>
		<INPUT TYPE="date"
									  NAME="datumdo"
										  CAPTION="Datum do"
									  VALUE=""
									  DECIMALS="0"
									  HEIGHT="320"
									  WIDTH="1500"
									  TABINDEX="3"
										  CHECKBOX="FALSE"/>

		<INPUT TYPE="number"
					NAME="broj"
					CAPTION="Komada računa"
					VALUE=""
					DECIMALS="0"
					HEIGHT="320"
					WIDTH="1500"
					TABINDEX="4"
						CHECKBOX="FALSE"/>

		<INPUT TYPE="search"
			CAPTION="Član "
			NAME="mpclanoviid"
			SQL="spmpdajclana @trazi = @@searchboxmpclanoviid"
			TABINDEX="5"
			TEXT=""
			DECIMALS="0"
			WIDTH="4000"
			HEIGHT="320"/>


	</FILTERFORM>










</PROJECT>
 
