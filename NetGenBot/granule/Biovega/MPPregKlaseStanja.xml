<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  
		 DETAILGRID = "spmpStanjePoKlasama @action=2, @robaid=@@robaid"
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"
		MASTERDBLCLICK=""
	    POPUPMASTER=""
		COMMANDTIMEOUT="600"
		 GROUPBYBOXVISIBLE="TRUE" 
		 MULTIGRIDLAYOUT="TRUE" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		ONCLOSED=""
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @trazi ='' "> 

 
  <NAME>Pregled robe po SVIM trgovinama</NAME>
  <CAPTION>Pregled robe po SVIM trgovinama</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="6000" 
		ONSUBMIT="spmpStanjePoKlasama @action=1, @klasaid=@@klasaid, @podklase=@@podklase,
					@status=@@status--" 
		ONLOAD="" 
		HEIGHT="4000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">


	  <INPUT TYPE="TRAZILICA" CAPTION="Klasa*" NAME="klasaid" TOP="1000" LEFT="700" WIDTH="4000" HEIGHT="320"
			  SQL="klMasterRoba#klmasterrobaid#Naziv%" />


	  <INPUT TYPE="VB.checkbox" NAME="podklase" TOP="1500" LEFT="700" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase"/>


	  <INPUT TYPE="combo" NAME="status" CAPTION="Status*" TOP="2000" LEFT="700" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="true"
			 SQL="select 0 as id, 'Aktivna' as naziv union select 1 as id, 'Umirovljena' as naziv"/>



  </FORM1>

	
	

</PROJECT> 