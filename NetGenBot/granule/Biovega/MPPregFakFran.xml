<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FORM1" 
   DETAILGRID = "spMPPregFakFransize @action=2,@id=@@faktureid"
   CMD1CAPTION="Filter:FORM1"    
   CMD2CAPTION=""    
   CMD3CAPTION="" 
   CMD4CAPTION=""
   CMD5CAPTION="Print dok.:repx/rptBiovegaFaktura(@id = @@id)"
   CMD6CAPTION=""
   POPUPMASTER=""
   TOTALROWVISIBLE="TRUE"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK="FORM1"
   COMMANDTIMEOUT="300">
 
  <NAME>Pregled faktura Biovege </NAME>
  <CAPTION>Pregled faktura Biovege</CAPTION>
 
 

  <FORM1 
        FILLEXPLORER="TRUE"
		WIDTH="7500" 
        ONSUBMIT="spMPPregFakFransize @action=1, @operateriid = @@operateriid, " 
        ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
        HEIGHT="2500" 
        CAPTION="Popunte uvjete"
		BORDERSTYLE="3"   
        CMD1CAPTION="Pokaži" 
        CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo" CAPTION="Trgovina" NAME="TrgovinaId"  WIDTH="4500" HEIGHT="320" ENABLED="TRUE" ALLOWEMPTY="TRUE"
					SQL="spmpDajTrgovina @operateriid=@@operateriid" />

		<INPUT TYPE="date" NAME="datumod" CAPTION="Od " HEIGHT="320" WIDTH="1500"  />

		<INPUT TYPE="date" NAME="datumdo" CAPTION="Do " HEIGHT="320" WIDTH="1500" />


	  

  </FORM1>
  

 

</PROJECT>
 
