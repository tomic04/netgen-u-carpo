	<INPUT TYPE="search" NAME="robaid" TOP="806" LEFT="2016" HEIGHT="302" WIDTH="4090" VISIBLE="TRUE" SQL="viRoba#robaid#!userid+&apos;&apos;#userid%#%naziv%#!jmnaziv" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" CAPTION="robaid" ENABLED="TRUE" COLUMNCAPTION="Šifra, Jedinicamjere, Naziv, Jedinica mjere"/>
	<INPUT TYPE="label" NAME="lblRobaid" TOP="806" LEFT="346" HEIGHT="288" WIDTH="1728" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Roba" ENABLED="TRUE" TEXT="Label28"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="1426" LEFT="230" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Spremi" ENABLED="TRUE" ONCLICK="IF &apos;@@KlMasterRobaId&apos; &lt;&gt; &apos;null&apos; AND &apos;@@RobaId&apos; &lt;&gt; &apos;null&apos;
		BEGIN
			exec spRaiserror 69001, &apos;Smije biti zadana samo klasa ili roba.  +focus(buttonCLOSE)&apos;
		END

ELSE
BEGIN
	IF &apos;@@KlMasterRobaId&apos;=&apos;null&apos; BEGIN
		IF &apos;@@RobaId&apos;=&apos;null&apos; BEGIN 
				IF EXISTS(SELECT * FROM PrnTroskoviGla WHERE KlMasterRobaId Is Null And RobaId Is Null)
				BEGIN exec spRaiserror 69001, &apos;Ne može se dodati. Postoji već takva klasifikacija i roba. +focus(buttonCLOSE)&apos; END
		END
		ELSE BEGIN
				IF EXISTS(SELECT * FROM PrnTroskoviGla WHERE KlMasterRobaId Is Null And RobaId=@@RobaId)
				BEGIN exec spRaiserror 69001, &apos;Ne može se dodati. Postoji već takva klasifikacija i roba. +focus(buttonCLOSE)&apos; END
		END
	END
	ELSE BEGIN
		IF &apos;@@RobaId&apos;=&apos;null&apos; BEGIN 
				IF EXISTS(SELECT * FROM PrnTroskoviGla WHERE KlMasterRobaId=@@KlMasterRobaId And RobaId Is Null)
				BEGIN exec spRaiserror 69001, &apos;Ne može se dodati. Postoji već takva klasifikacija i roba. +focus(buttonCLOSE)&apos; END
		END
		ELSE BEGIN
					IF EXISTS(SELECT * FROM PrnTroskoviGla WHERE KlMasterRobaId=@@KlMasterRobaId And RobaId=@@RobaId)
			BEGIN exec spRaiserror 69001, &apos;Ne može se dodati. Postoji već takva klasifikacija i roba. +focus(buttonCLOSE)&apos; END
		END
	END
END
#OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="1426" LEFT="1382" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

</INSERTFORM>

