	<INPUT TYPE="frame" NAME="FrameNG6" TOP="144" LEFT="144" HEIGHT="1195" WIDTH="6235" TEXT="Unos"/>
	<INPUT TYPE="search" NAME="klmasterrobaid" TOP="346" LEFT="2016" HEIGHT="302" WIDTH="4090" SQL="klmasterroba#klmasterrobaid#!space(len(usluga))#!sortkey#!space(len(sortkey))+naziv%#%naziv%" CAPTION="klmasterrobaid" COLUMNCAPTION="LenSpaceUsluga,SortKey,Klasa, Naziv" COLUMNWIDTH="0,0,500,0"/>
