<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD1CAPTION="Parametri:FILTERFORM"    
   CMD2CAPTION="" 
   CMD3CAPTION="2"   
   POPUPMASTER=""
   CHECKBOXVISIBLE="false">
   
  <NAME>Inventurne razlike po klasama robe</NAME>
  <CAPTION>Inventurne razlike po klasama robe</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>

   <FILTERFORM 
					FILLEXPLORER="TRUE" 
					REPORT=""  
					WIDTH="4500" 
					ONSUBMIT="spSktInvRazlikeIZV @skladisteid = @@skladisteid,@sktinventuraglaid=@@sktinventuraglaid" 
					ONLOAD="SELECT null" 
					HEIGHT="2200" 
					CAPTION="Izaberi uvjete traženja"  
					BORDERSTYLE="3" 
					CMD1CAPTION="Pokaži" 
					CMD2CAPTION="Odustani" 
					CMD3CAPTION=""  
					NEXTFORM=""
                                        ONLOSTFOCUS=""  >
								  															
							
					<INPUT TYPE="label" NAME="lblskladiste" TOP="250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Skladište:"/>
					<INPUT TYPE="combo" 
						NAME="skladisteid" 
						CAPTION="_Skladiste" 
						TOP="250" 
						LEFT="1700"  
						WIDTH="2500" 
						HEIGHT="320" 
						TABINDEX="0" 
						ALLOWEMPTY="false" 
                                                ONLOSTFOCUS="select 'refresh' as sktinventuraglaid"
						SQL="select skladisteid,(Oznaka +' '+Opis) as Naziv  
	                                             from Skladiste  	
		                                     order by Oznaka"/> 

	
					<INPUT TYPE="label" NAME="lbldatum" TOP="750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Datum:"/>
					<INPUT TYPE="combo" 
						NAME="sktinventuraglaid" 
						CAPTION="_datum" 
						TOP="750" 
						LEFT="1700"  
						WIDTH="2500" 
						HEIGHT="320" 
						TABINDEX="1" 
						ALLOWEMPTY="true" 
						SQL="select sktinventuraglaid,convert(varchar,datumdok,104) as Naziv from sktinventuragla 
                                                     where skladisteid = @@skladisteid
                                                     order by datumdok desc"/>
  </FILTERFORM>
  
   

</PROJECT>