<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD1CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="TRUE"
   POPUPMASTER=""
   TOTALROW="FALSE"
	FILLEXPLORER=""
   BUTTONS="Uvjeti:FILTERFORM#Dodaj:DODAJFORM#Izmjeni:UPDATEFORM#(de)Aktiviranje:AKTIVIRAJ#Kopiranje na druge trgovine:KOPITRG" 
   MASTERDBLCLICK="UPDATEFORM">
 
  <NAME>Zabrana prodaje robe u trgovini </NAME>
  <CAPTION>Zabrana prodaje robe u trgovini </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<FILTERFORM NAME="FILTERFORM" HEIGHT="3500" WIDTH="7710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPRobaZabrana @action=1,@operateriid = @@operateriid,  "
		 ONLOAD="select 1 as aktivno" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
				VERSION="1.1"
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="combo" NAME="trgovinaaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="400" LEFT="1500" ONLOSTFOCUS="" 
           SQL="	select t.trgovinaid, opis as [Trgovina2300]
	from trgovina t
	inner join TrgovinePrava tp on t.TrgovinaId = tp.TrgovinaId
	where tp.OperaterID = @@operateriid
  and aktivno = 1
	order by opis
" ONCLICK ="" ONLOSFOCUS=""/>
		<INPUT TYPE="search"    NAME="robaaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="800" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaaid'" />
		<INPUT TYPE="check"    NAME="aktivno"   ALLOWEMPTY="TRUE" CAPTION="Samo aktivno*" TOP="1200" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaaid'" />
	</FILTERFORM>

  <DODAJFORM 
         WIDTH="11000" 
         ONSUBMIT="" 
         ONLOAD="" 
		 VERSION="1.1"
         ONLOADED="select 'invisible' as robaSearch"
				 ONLOADEDD ="select @@trgovinaid as trgovinaid" 
         HEIGHT="8500" 
         CAPTION="Dodavanje nove zabrane"
				 FILLEXPLORER=""
				 FOCUS=""
		 >
	  
	  <INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="400" LEFT="1100" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
  
    <INPUT TYPE="text" NAME="pojam" CAPTION="Traženje pojma*" TOP="800" LEFT="1100" HEIGHT="320" TABINDEX="3" WIDTH="5000"/>

    <INPUT TYPE="search"  CAPTION="Klasa:*" NAME="klmasterrobaid" TOP="1200" LEFT="1100" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" WIDTH="5000"
					SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'"/>
    <INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" TOP="1600" LEFT="1100" />
	  <INPUT TYPE="checkbox" NAME="svetrg" CAPTION="Sve trgovine" TOP="400" LEFT="6300" />
	  <INPUT TYPE="datetime" NAME="datumod" CAPTION="Osim od*" TOP="2000" LEFT="1100" />
	  <INPUT TYPE="datetime" NAME="datumdo" CAPTION=" do *" TOP="2000" LEFT="3000" />
	  
	  <INPUT TYPE="button" NAME="ok" CAPTION="Prikaži robu (F3)" TOP="2700" LEFT="4600" WIDTH="1506" HEIGHT="322" HOTKEY="F3"
         ONCLICK="select 'refresh' as robaSearch# select 'visible' as robaSearch"  />

    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="3000" LEFT="1100" HEIGHT="3500" WIDTH="5000" />
    <INPUT TYPE="grid"
	     NAME="robaSearch"
	     REFRESHAFTERCHILD=""
	     CAPTION="robaSearch"
	     TOP="2500" LEFT="1100" WIDTH="5000" HEIGHT="3500"
	     TABINDEX="-1"
	     AFTERREFRESH=""
	     POPUP=""
	     ONDBLCLICK=""
	     EDITCOLUMNS=""
	     ONCELLEDITED=""
	     CHECKBOXVISIBLE="TRUE"
	     PAGEHEADERCENTER=""
	     PAGEHEADERRIGHT=""
	     PAGEHEADERLEFT=""
	     PAGEFOOTERCENTER=""
	     PAGEFOOTERLEFT=""
       SKIPDEFAULTLOAD="TRUE"
	     PAGEFOOTERRIGHT="@@tkosmomi"
	     PAGEORIENTATION="LANDSCAPE"
	     GROUPBYBOXVISIBLE="FALSE"
	     TOTALROW="FALSE"
	     SQL="spMPRobaZabrana @action=7, @klmasterrobaid = @@klmasterrobaid, @podklase = @@podklase, @pojam = '@@pojam', @robaid = @@robaid" />

    <INPUT TYPE="grid" 
           NAME="trgovine" 
           CAPTION=""  
           INDEX ="6"  
           ALLOWEMPTY="TRUE" 
           MAXLENGTH = "" 
           WIDTH="3500" 
           LEFT="6300" TOP="800"  HEIGHT="5600"
           ENABLED="TRUE" 
           STYLE="1"
			    SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @klpartneriid = null, @action = 4 "/>
    
	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="6700" LEFT="1096" WIDTH="1106" HEIGHT="322" 
			 ONCLICK="FOREACHSELECTED(robaSearch)#
              spMPRobaZabrana @action=8,  @robaid = @(robaSearch..robaid), @trgovinaidniz = '@@nizoznacenihajdijevatrgovine' , @operateriid = @@operateriid #Ok"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6700" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </DODAJFORM>



	<UPDATEFORM
				   WIDTH="9000"
				   ONSUBMIT=""
				   ONLOAD="if (select status from MPRobaZabrana where MPRobaZabranaid = @@id) = 0 begin 
								exec spMPRobaZabrana @action=3,  @id= @@id 
							end 
							else begin 
							 exec spRaiserror 69001,&apos;Status je aktivan. Ne možete mijenjati !&apos; 
							end "
				   ONLOADEDD =""
				   HEIGHT="4500"
				   VERSION="1.1"
				   CAPTION="Izmjenite podatke  "
				   FILLEXPLORER=""
				   FOCUS="trgovinaid"
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="900" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
		<INPUT TYPE="datetime"    NAME="datumod"   ALLOWEMPTY="TRUE" CAPTION="NE datum od *" TOP="1300" LEFT="1500" WIDTH="1200" SQL="" />
		<INPUT TYPE="datetime"    NAME="datumdo"   ALLOWEMPTY="TRUE" CAPTION="NE datum do *" TOP="1700" LEFT="1500" WIDTH="1200" SQL="" />

		<INPUT TYPE="check"    NAME="odbezdatuma"   ALLOWEMPTY="TRUE" CAPTION="Bez datuma" TOP="1300" LEFT="3000" WIDTH="1200" SQL="" />
		<INPUT TYPE="check"    NAME="dobezdatuma"   ALLOWEMPTY="TRUE" CAPTION="Bez datuma" TOP="1700" LEFT="3000" WIDTH="1200" SQL="" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2200" LEFT="1096" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spMPRobaZabrana @action=4,  @id = @@id, @robaid = @@robaid, @trgovinaid = @@trgovinaid , @operateriid = @@operateriid, @datumod = @@datumod , @datumdo = @@datumdo, @odbezdatuma = @@odbezdatuma, @dobezdatuma = @@dobezdatuma  #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2200" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</UPDATEFORM>




	<AKTIVIRAJ
				   WIDTH="8000" 
				   ONSUBMIT="" 
				   ONLOAD="spMPRobaZabrana @action=3, @id = @@id" 
				   HEIGHT="3000" 
				   CAPTION="Želite li promijeniti status uvjeta ? "  
				  FOCUS=""
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" ENABLED="FALSE" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" ENABLED="FALSE" TOP="900" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Promijeni " TOP="1600" LEFT="1096" WIDTH="1106" HEIGHT="322" ONCLICK="spMPRobaZabrana @action=5, @operateriid = @@operateriid , @id = @@id#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1600" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</AKTIVIRAJ>

	<KOPITRG
				   WIDTH="8000"
				   ONSUBMIT=""
				   ONLOAD="spMPRobaZabrana @action=3, @id = @@id "
				   HEIGHT="6000"
				   CAPTION="Kopiranje na druge trgovine"
				  FOCUS=""
		 >
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" ENABLED="FALSE" TOP="400" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
		<INPUT TYPE="check" NAME="jedna" ALLOWEMPTY="TRUE" CAPTION="Kopiraj odabrani artikal*" ENABLED="TRU" TOP="900" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="check" NAME="sve" ALLOWEMPTY="TRUE" CAPTION="Kopiraj svu robu odabrane trgovine*" ENABLED="TRUE" TOP="1400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
    
    <INPUT TYPE="check" NAME="najednu" ALLOWEMPTY="TRUE" CAPTION="Kopiraj odabrani artikl na trgovinu*" ENABLED="TRUE" TOP="1900" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="if @@najednu = 1 or @@natrgovinusve = 1 begin select 'enable' as lokacijaid end else begin select 'disable' as lokacijaid end # select 'refresh' as mpkaseid" ONLOSFOCUS="if @@najednu = 1 or @@natrgovinusve = 1 begin select 'enable' as lokacijaid end else begin select 'disable' as lokacijaid end # select 'refresh' as mpkaseid"/>
    <INPUT TYPE="check" NAME="natrgovinusve" ALLOWEMPTY="TRUE" CAPTION="Kopiraj svu robu odabrane trgovine na trgovinu*" ENABLED="TRUE" TOP="2400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="if @@najednu = 1 or @@natrgovinusve = 1  begin select 'enable' as lokacijaid end else begin select 'disable' as lokacijaid end # select 'refresh' as mpkaseid" ONLOSFOCUS="if @@najednu = 1 or @@natrgovinusve = 1 begin select 'enable' as lokacijaid end else begin select 'disable' as lokacijaid end # select 'refresh' as mpkaseid"/>

    <INPUT TYPE="combo" NAME="lokacijaid" ALLOWEMPTY="FALSE" CAPTION="Kopiraj na*" ENABLED="FALSE" TOP="2900" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>

    <INPUT TYPE="button" NAME="ok" CAPTION="Promijeni " TOP="3500" LEFT="1096" WIDTH="1106" HEIGHT="322" ONCLICK="spMPRobaZabrana @action=6, @operateriid = @@operateriid , @robaid = @@robaid, @sve = @@sve, @jedna = @@jedna, @najednu=@@najednu, @natrgovinusve=@@natrgovinusve, @lokacijaid=@@lokacijaid, @trgovinaid = @@trgovinaid#Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3500" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </KOPITRG>



</PROJECT>
 
