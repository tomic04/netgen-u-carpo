<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTERFORM"  		
		REPORT="Etikete.clsEtikete" 	
		CMD1CAPTION="Parametri:FILTERFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		MASTERDBLCLICK=""
		TOTALROW="FALSE"
		CHECKBOXVISIBLE="FALSE" 
	        POPUPMASTER=""
		COMMANDTIMEOUT="600"> 
 

  <NAME>Analiza broja stavaka na MP računima  </NAME>
  <CAPTION>Analiza broja stavaka na MP računima </CAPTION>


	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="7254"
		WIDTH="6210"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="exec spmpAnalizaBrStavaka @action = 3, @operateriid = @@operateriid , @trgovinaid = @@trgovinaid, @datumod = @@datumod, @datumdo = @@datumdo , @stavke = 1!!"
		ONLOADED="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid "
		ONLOAD="spmpAnalizaBrStavaka @action = 1, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid" 
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum do*" TOP="600" LEFT="1200"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION=" do*" TOP="600" LEFT="3000"/>
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina *" TOP="1000" LEFT="1200" 
			   ONLOSTFOCUS="select 'refresh' as stavke" ONCLICK="spmpAnalizaBrStavaka @action = 1, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid#select 'refresh' as stavke" 
			   SQL="spMPDajTrgovina @operateriid = @@operateriid " />
		<INPUT TYPE="button" NAME="ok" CAPTION="Poništi razrede" TOP="3000" LEFT="4500" WIDTH="1406" HEIGHT="322" ONCLICK="spmpAnalizaBrStavaka @action = 4, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid#select 'refresh' as stavke"  />
		<INPUT TYPE="label" NAME="naslov" ALLOWEMPTY="TRUE" CAPTION="Razredi uvjeta*" TOP="1750" LEFT="1200" STILE="1" SYZE="12" ONLOSTFOCUS="" SQL="" />
		<INPUT TYPE="grid"
		   NAME="stavke"
		   REFRESHAFTERCHILD="TRUE"
		   CAPTION="Razredi pregleda "
		   TOP="2000" LEFT="1200" WIDTH="3350" HEIGHT="3650"
		   AFTERREFRESH=""
		   POPUP=""
		   ONDBLCLICK=""
		   EDITCOLUMNS="[Od1200], [Do1200] "
		   ONCELLEDITED="exec spmpAnalizaBrStavaka @action = 2, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid , @od = @@od, @do = @@do,  @id = @@gridstavkerbr"
		   CHECKBOXVISIBLE="FALSE"
		   PAGEHEADERCENTER=""
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT=""
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   PAGEFOOTERRIGHT="@@thosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="FALSE"
		   TOTALROW="FALSE"
		   SQL="select rbr as rbrid, convert(varchar(2),rbr)+'.' as [Rbr0400], od as [Od1200], do as [Do1200] 
				from ##tmpanalstavke where hostname = host_name() and  susersname = suser_sname () and trgovinaid is null and operateriid = @@operateriid  order by rbr" />


	</FILTERFORM>


	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Krtica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid , @totalgen=1" />
	</KARTICA>

</PROJECT>
