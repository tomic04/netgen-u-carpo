<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":UPDATEFORM" 
   CMD1CAPTION=""
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""   
   BUTTONS="Izmjeni:UPDATEFORM" 
   SETDEFAULTS=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK="" >


  <NAME>Ažuriranje parametara fiskalizacije </NAME>
  <CAPTION>Ažuriranje parametara fiskalizacije </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<UPDATEFORM 
		 HEIGHT="6200" 
         WIDTH="8000" 
         ONSUBMIT="" 
         ONLOAD="" 
		 FOCUS="OIB"
         CAPTION="Izmjena podataka"  
		 >
		
		
	  	 <INPUT TYPE="combo" NAME="partneriid" CAPTION="Partner(vlasnik)" SQL="spMPFiskalPubvars @action = 2" TABINDEX="0" HEIGHT="320" WIDTH="2500" ALLOWEMPTY="FALSE" ENABLED="TRUE" 
				ONLOSTFOCUS ="spMPFiskalPubvars @action= 3, @partneriid  = @@partneriid" MAXLENGTH ="" />
		<INPUT TYPE="text" NAME="oib" CAPTION="OIB" SQL="" TABINDEX="1" HEIGHT="320" WIDTH="1500" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXLENGTH ="11" />
		<INPUT TYPE="date" NAME="datum" CAPTION="Datum" TABINDEX="2" ENABLED="TRUE" />
		 <INPUT TYPE="text" NAME="obveznikPDV" CAPTION="Obveznik PDV-a" VALUE="" HEIGHT="320" WIDTH="300" TABINDEX="4" ALLOWEMPTY="TRUE" ENABLED="TRUE" MAXLENGTH ="1" />
		 <INPUT TYPE="label" NAME="lblporuka" WIDTH="400" CAPTION="1 - Jeste obveznik PDV-a / 0 - Nije obveznik PDV-a" TOP="1450" LEFT="2500" TABINDEX="5" />		
		 <INPUT TYPE="text" NAME="pfx" CAPTION="Ime certifikata" VALUE="" HEIGHT="320" WIDTH="5500" TABINDEX="7" ALLOWEMPTY="TRUE" ENABLED="TRUE" MAXLENGTH ="200" />
		 <INPUT TYPE="text" NAME="lozinkazapfx" CAPTION="Lozinka certifikata" VALUE="" HEIGHT="320" WIDTH="5500" TABINDEX="8" ALLOWEMPTY="TRUE" ENABLED="TRUE" MAXLENGTH ="200" />
		<INPUT TYPE="text" NAME="putanjapfx" CAPTION="Putanja certifikata" VALUE="" HEIGHT="320" WIDTH="5500" TABINDEX="9" ALLOWEMPTY="TRUE" ENABLED="TRUE" MAXLENGTH ="200" />
		<INPUT TYPE="text" NAME="URL" CAPTION="Adresa servera" VALUE="" HEIGHT="320" WIDTH="5500" TABINDEX="10" ALLOWEMPTY="TRUE" ENABLED="TRUE" MAXLENGTH ="200" />
		<INPUT TYPE="number" NAME="timeout" CAPTION="Vrijeme čekanja" VALUE="" HEIGHT="320" WIDTH="800" TABINDEX="11" DECIMALS="0" ALLOWEMPTY="TRUE" ENABLED="TRUE" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="5000" LEFT="196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spMPFiskalPubvars @action=1, @oib='@@oib', @datum=@@datum, @obveznikPDV='@@obveznikPDV', 
			   @pfx='@@pfx' , @lozinkazapfx = '@@lozinkazapfx', @PARTNERIID = @@partneriid, @putanjapfx = '@@putanjapfx', @url = '@@url', @timeout = @@timeout #Ok"  />
		 <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5000" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</UPDATEFORM>



</PROJECT>
 
