<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT=""
		DETAILGRID = "spmpDnevniPromet @action=2, @brojdok = '@@ID',@kasa =@@kasa"
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="Roba:ROBA" 
		CMD4CAPTION=""
 		CMD5CAPTION="Promet prošle godine:PROSGOD" 
		CMD6CAPTION="Print.dok.:vrstadokid-MPBlagajnaGla"
    MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE"
	  POPUPMASTER=""
       PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
    COMMANDTIMEOUT="300"> 
 

  <NAME>Dnevni promet robe </NAME>
  <CAPTION>Dnevni promet robe </CAPTION>


  <FILTER_FORM
    NAME="FILTER_FORM"
    CAPTION="Parametri"
		WIDTH="7600" 
    HEIGHT="2000" 
	VERSION="1.1"
		ONSUBMIT="spmpDnevniPromet @action = 1, @operateriid=@@operateriid, " 
		ONLOAD="select @@trgovinaid as trgovinaid"
		
		FILLEXPLORER="TRUE"
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" >

    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="400" LEFT="1500"
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>




  </FILTER_FORM>
	
	
	<ROBA
	  NAME="FILTER_FORM"
	  CAPTION="Parametri"
		  WIDTH="10000"
	  HEIGHT="9000"
	  VERSION="1.2"
		  ONSUBMIT="select 'refresh' as  robagrid "
		  ONLOAD="select @@trgovinaid as trgovinaid"
		
		  FILLEXPLORER="TRUE"
		  CMD1CAPTION="Pokaži"
		  CMD2CAPTION="Odustani" >

		<INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />
		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="200" LEFT="1500"
				   SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>

		<INPUT TYPE="grid" NAME="robagrid" CAPTION="Dani u tjednu" TOP="600" LEFT="200" HEIGHT="7000" WIDTH="9000" GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="FALSE"
	   SQL ="spmpDnevniPromet @action = 3, @trgovinaid = @@trgovinaid,  @operateriid=@@operateriid "/>



	</ROBA>

	<PROSGOD
  NAME="PROSGOD"
  CAPTION="Usporedba prošla godina"
	  WIDTH="10000"
  HEIGHT="9000"
  VERSION="1.2"
	  ONSUBMIT=""
	  ONLOAD=""
		
	  FILLEXPLORER="TRUE"
	  CMD1CAPTION=""
	  CMD2CAPTION="Odustani" >


		<INPUT TYPE="grid" NAME="robagrid" CAPTION="Usporedba prošla godina" TOP="600" LEFT="200" HEIGHT="7000" WIDTH="9000" GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="FALSE"
	   SQL ="spmpDnevniPromet @action = 4, @trgovinaid = @@trgovinaid,  @operateriid=@@operateriid "/>

	</PROSGOD>
	
</PROJECT> 