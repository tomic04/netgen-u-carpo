	<NAME>Ažuriranje rokova isporuke po partnerima </NAME>
	<CAPTION>Ažuriranje rokova isporuke po partnerima </CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>



<FILTERFORM NAME="FILTERFORM" 
		 HEIGHT="2000" 
		 WIDTH="7700" 
		 CAPTION="Izaberite trgovinu "
		 ONSUBMIT="spMPParAsortIsporuka @action = 1, "
		 ONLOAD="select @@trgovinaid as trgovinaid " 
		 NEXTFORM=""
		 FOCUS="" 
		 FILLEXPLORER="TRUE" 
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="trgovinaid"    CAPTION="Trgovina"    ENABLED="TRUE"  WIDTH="3000" SQL="spmpdajtrgovina @operateriid = @@operateriid"/>
</FILTERFORM>

	<UPDATE_FORM NAME="UPDATE_FORM"
			 HEIGHT="3000"
			 WIDTH="7700"
			 CAPTION="Izmjena podataka za partnera "
			 ONSUBMIT="spMPParAsortIsporuka @action = 2, @trgovinaid = @@trgovinaid,  "
			 ONLOAD="spMPParAsortIsporuka @action = 3, @trgovinaid = @@trgovinaid, @partneriid = @@partneriid "
			 NEXTFORM=""
			 FOCUS="email"
			 CMD1CAPTION="Spremi"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="text"    NAME="partner"    CAPTION="Partner"    ENABLED="FALSE"  WIDTH="3000" />
		<INPUT TYPE="number"    NAME="danaisporuke"   CAPTION="Dana isporuke"   ENABLED="TRUE"  DECIMALS="0" WIDTH="800"  />
		<INPUT TYPE="number "    TOP="-3000" NAME="partneriid"    CAPTION="Partner"    ENABLED="FALSE"  WIDTH="3000" />
	</UPDATE_FORM>

</PROJECT>