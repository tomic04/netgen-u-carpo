<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		MASTERDBLCLICK=":KARTICA"
	    POPUPMASTER=""
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @trazi ='' "> 

 
  <NAME>Otpisana roba u MP</NAME>
  <CAPTION>Otpisana roba u MP</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		ONSUBMIT="spMPOtpisanaRoba @action=1, @operateriid = @@operateriid, @nenc = @@nenc," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid " 
		HEIGHT="3000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="100" LEFT="2000" TABINDEX="3"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="500" LEFT="2000" TABINDEX="4"/>

		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="900" LEFT="2000"  WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true" 
                SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t where t.aktivno = 1" TABINDEX="30"/>
		
		<INPUT TYPE="TRAZILICA" CAPTION="Roba*" NAME="robaid" TOP="1300" LEFT="2000" TEXT="" WIDTH="5500" HEIGHT="320"
			    SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" TABINDEX="40" /> 
		
		<INPUT TYPE="TRAZILICA" CAPTION="Klasa*" NAME="klasaid" TOP="1700" LEFT="2000" WIDTH="5500" HEIGHT="320"
				SQL="klMasterRoba#klmasterrobaid#Naziv%" TABINDEX="50" /> 
		
		<INPUT TYPE="combo" NAME="napomena" CAPTION="Napomena stavke*" TOP="2100" LEFT="2000" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"
				SQL="select distinct d.mprazlogpovrataid, ro.Opis from MaloprodajaGla g inner join MaloprodajaDet d on g.MaloprodajaGlaId=d.MaloprodajaGlaID inner join 				MPRazlogOtpisa ro on d.mprazlogpovrataid=ro.MPRazlogOtpisaid where g.VrstaDokId in (174,278) and g.Status=2 and g.DatumDok>'20200101'" TABINDEX="60" />
	  
		<INPUT TYPE="VB.checkbox" NAME="podklase" TOP="2500" LEFT="2000" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase" TABINDEX="70" />


</FORM1>


</PROJECT> 