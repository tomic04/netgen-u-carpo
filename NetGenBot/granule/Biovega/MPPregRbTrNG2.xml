		<INPUT TYPE="button" NAME="" CAPTION="Etiketa bijela ljepljiva" TOP="500" LEFT="200" WIDTH="2500" HEIGHT="406"
	ONCLICK=":repx/rptBiovegaMPEtikete_62x39(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />

		<INPUT TYPE="button" NAME="" CAPTION="Etiketa standardna 54x39" TOP="1000" LEFT="200" WIDTH="2500" HEIGHT="406"
	ONCLICK=":repx/rptBiovegaMPEtikete_54x39(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />
		<INPUT TYPE="button" NAME="" CAPTION="Etiketa akcijska 62x39" TOP="1000" LEFT="3000" WIDTH="2500" HEIGHT="406"
	ONCLICK=":repx/rptBiovegaMPEtikete_62x39(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />

		<INPUT TYPE="button" NAME="" CAPTION="Etiketa dvostruka 54x39" TOP="1500" LEFT="200" WIDTH="2500" HEIGHT="406"
	ONCLICK=":repx/rptBiovegaMPEtikete_54x39_2(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />
		<INPUT TYPE="button" NAME="" CAPTION="Etiketa akcijska dvostruka 62x39" TOP="1500" LEFT="3000" WIDTH="2500" HEIGHT="406"
	ONCLICK=":repx/rptBiovegaMPEtikete_62x39_2(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />

		<INPUT TYPE="button" NAME="" CAPTION="Izlaz"			 TOP="2000" LEFT="4224" WIDTH="1386" HEIGHT="406" ONCLICK="CLOSE"  />
	
	</MULTISELECTETIKETE>


</PROJECT> 