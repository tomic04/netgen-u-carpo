ONCLICK=":repx/rptBiovegaMPEtikete_70x39(@trgovinaid=@@trgovinaidx,@action=1,@id=null,@nacin=4,@string='',@winlabel=1,@operateriid=@@operateriid,@multiselect=1)"  />
