<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
ONLOAD=":FILTERFORM"  
CMD1CAPTION="Parametri:FILTERFORM"
CMD2CAPTION=""
CMD3CAPTION="Iz uvjeta:DAJUVJETI"
CMD4CAPTION="" 
CMD5CAPTION="" 
CMD6CAPTION=""   
CMD7CAPTION="Lista"   
CMD8CAPTION=""
CHECKBOXVISIBLE="FALSE"
DETCHECKBOXVISIBLE="FALSE"
GROUPBOXVISIBLE="FALSE"
TOTALROWVISIBLE="FALSE"
DETTOTALROWVISIBLE="FALSE"
REPORT="" 
DETAILGRID = ""
MASTERDBLCLICK=""
POPUPMASTER="Filter:FILTERFORM"
PAGEHEADERLEFT=""
PAGEHEADERRIGHT="@@tkosmomi"
SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">



  <MASTERCOLUMNS>
    <COLUMN INDEX="9" NAME="KOLIČINA0900" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
    <COLUMN INDEX="10" NAME="NC1000" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
  </MASTERCOLUMNS>


  <NAME>Pregled najniže MPC u zadnjih N dana  </NAME>
  <CAPTION>Pregled najniže MPC u zadnjih N dana </CAPTION>
 
  <KOMENTAR> </KOMENTAR>


<FILTERFORM 
	FILLEXPLORER="TRUE" 
	REPORT=""  
	WIDTH="6300" 
	ONSUBMIT="spmpZadnjaNajnizaMPC @action = 1,  " 
	ONLOAD="select @@datum as datum, @@dana as dana, @@trgovinaid as trgovinaid " 
	ONLOADED="select @@30 as dana "
	HEIGHT="3500" 
	VERSION="1.1"
	CAPTION="Upišite uvjete pregleda "  
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION=""  
	NEXTFORM=""  >
    
	<INPUT TYPE="datetime" NAME="datum" CAPTION="NA dan:*" WIDTH="1200" TOP="400" LEFT="1500" SQL="" ALLOWEMPTY="TRUE" />
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="4000" TOP="800" LEFT="1500" SQL="spmpdajtrgovinang @operateriid = @@operateriid" ALLOWEMPTY="FALSE" />
	<INPUT TYPE="search" NAME="robaid"          CAPTION="Roba:*"  TOP="1200" LEFT="1500"   SQL="viroba#robaid#%naziv%#%jmnaziv%#%userid%#!barcode" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
	<INPUT TYPE="number" NAME="dana"          CAPTION="U zadnjih N dana :*"  TOP="1600" LEFT="1500"   WIDTH="800" SQL="" ONLOSTFOCUS="" BACKCOLOR="" DECIMALS="0" />

</FILTERFORM>

	<DAJUVJETI
		FILLEXPLORER="TRUE"
		REPORT=""
		WIDTH="6300"
		ONSUBMIT="  "
		ONLOAD="spmpZadnjaNajnizaMPC @action = 3, @iduvjeti1 = @@rab1id, @iduvjeti2 = @@rab2id"
		ONLOADED="select @@30 as dana "
		HEIGHT="5000"
		VERSION="1.4"
		CAPTION="Pregled uvjeta prodaje "
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""
		NEXTFORM=""  >

		<INPUT TYPE="datetime" NAME="datumod" CAPTION="Od datuma*" WIDTH="1200" TOP="400" LEFT="1500" SQL="" ALLOWEMPTY="TRUE" ENABLED="FALSE"/>
		<INPUT TYPE="datetime" NAME="datumdo" CAPTION="Do datuma*" WIDTH="1200" TOP="800" LEFT="1500" SQL="" ALLOWEMPTY="TRUE" ENABLED="FALSE" />
		<INPUT TYPE="number" NAME="popust" CAPTION="Popust*" WIDTH="1000" TOP="1200" LEFT="1500" SQL="" ALLOWEMPTY="FALSE"  ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="mpcijena"          CAPTION="MPC:*"  WIDTH="1000" TOP="1600" LEFT="1500"   SQL="viroba#robaid#%naziv%#%jmnaziv%#%userid%#!barcode" ONLOSTFOCUS="" BACKCOLOR=""  ENABLED="FALSE" />
		<INPUT TYPE="text" NAME="uvjetopis"          CAPTION="Tip popusta:*"  TOP="2000" LEFT="1500"   SQL="" ONLOSTFOCUS="" BACKCOLOR=""  ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="prioritet"          CAPTION="Prioritet :*"  TOP="2400" LEFT="1500"   WIDTH="800" SQL="" ONLOSTFOCUS="" BACKCOLOR="" DECIMALS="0"  ENABLED="FALSE"/>
		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="4000" TOP="2800" LEFT="1500" SQL="spmpdajtrgovinang @operateriid = @@operateriid" ALLOWEMPTY="FALSE" ENABLED="FALSE" />
		<INPUT TYPE="combo" NAME="opis" CAPTION="Vrsta cjenika*" WIDTH="4000" TOP="3200" LEFT="1500" SQL="select vrcjenikid, opis from vrcjenik where vrcjenikid= @@vrcjenmikid " ALLOWEMPTY="FALSE" ENABLED="FALSE" />

	</DAJUVJETI>


</PROJECT>
 
