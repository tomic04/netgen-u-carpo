<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT

	DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id"
	MASTERDBLCLICK=""
	BUTTONS="Pronađi:FILTERFORM#Print dok.:vrstadokid-MaloprodajaGla"
	POPUPMASTER="Pronađi:FILTERFORM" 
	TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
	SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
	ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
			'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 
			'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="FALSE"
	DETTOTALROWVISIBLE="FALSE"
	DETCHECKBOXVISIBLE="FALSE">



	<NAME>MP Nivelacija</NAME>
	<CAPTION>MP Nivelacija</CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas', @sifradok = '100' " />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @sifradok = '100' " />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @sifradok = '100' " />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = '100' " />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '100' " />


	
<FILTERFORM 
	NAME="FILTERFORM" 
	HEIGHT="6000" WIDTH="7500" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @sifradok = '100', @operateriid= @@operateriid, @trgovinaid = @@xtrgovinid, @datumod = '@@xdatumod', @datumdo = '@@xdatumdo', @lokacijeid = @@xlokacijeid,  @trazibroj = '@@trazibroj'"
	ONLOAD="select @@xdatumod as xdatumod, @@xdatumdo as datumdo, @@xtrgovinaid as trgovinaid,@@xlokacijeid as lokacijeid" 
	FILLEXPLORER="TRUE" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	<INPUT TYPE="date" NAME="xdatumod" TOP="500" LEFT="1500" CAPTION="Datum od*" WIDTH="1500" DEFAULT="firstdayofyear"/>
	<INPUT TYPE="date" NAME="xdatumdo" TOP="1000" LEFT="1500" CAPTION="Datum do*" WIDTH="1500" DEFAULT="today"/>
	<INPUT TYPE="combo" NAME="xtrgovinaid" TOP="1500" LEFT="1500" WIDTH="3500" CAPTION="Trgovina izlaza*" ALLOWEMPTY="TRUE" ONLOSTFOCUS="" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @vrstatrg='M' " />
	<INPUT TYPE="combo" NAME="xlokacijeid" TOP="2000" LEFT="1500" WIDTH="5500" CAPTION="Trgovina ulaza*" ALLOWEMPTY="TRUE" SQL="select trgovinaid, opis as naziv from trgovina where aktivno = 1 and vrstatrg= 'M'" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
	<INPUT TYPE="combo" NAME="xstatus" TOP="2500" LEFT="1500" ALLOWEMPTY="TRUE" CAPTION="Status*" SQL="select 1 as status,&apos;Otvoren &apos; as naziv union all select 2 as status,&apos;Zaključen &apos; as naziv" />
	<INPUT TYPE="text" NAME="trazibroj" TOP="3000" LEFT="1500" WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta*" ONLOSTFOCUS=""/>
</FILTERFORM>

</PROJECT>