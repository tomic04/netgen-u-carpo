<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD="spMPMinKolPeriod @action = 2"  		
		REPORT="" 	
		CMD1CAPTION="Dodaj robu:DODAJNOVO" 
		CMD2CAPTION="Izmjeni robu:IZMJENIART" 
		CMD3CAPTION="Obriši robu:OBRISIART" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION="Filter:FILTERFORM"  
		CMD7CAPTION=""  
		CMD8CAPTION=""  
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="TRUE"
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"
		ONCLOSED="spMPMinKolPeriod @action = 6, @operateriid = @@operateriid"
	    POPUPMASTER=""
		COMMANDTIMEOUT="300"> 
 

  <NAME>Minimalne količine za period za robu</NAME>
  <CAPTION>Minimalne količine za period za robu</CAPTION>


	<DODAJART NAME="DODAJART"
		HEIGHT="9000"
		WIDTH="8000"
		CAPTION="Dodaj artikl "
		ONSUBMIT="spMPMinKolPeriod @action = 1, @operateriid=@@operateriid, @datumod=@@datumod, @datumdo=@@datumdo, @trgovinalista='@@trgovinalista', @kolicina=@@kolicina, @robaid=@@robaid--,"
		ONLOAD="select STRING_AGG (trgovinaid,'~') as trgovinalista from Trgovina where not  (opis  like '%webshop%' or opis  like '%sajmovi%' ) and aktivno=1"
		FILLEXPLORER=""
		NEXTFORM=""
		CMD1CAPTION="Dodaj"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />

		<INPUT TYPE="multidrop"  NAME="trgovinalista"      CAPTION="Trgovina"   ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid" />
		
		<INPUT TYPE="TRAZILICA" CAPTION="Roba" NAME="robaid"  TEXT="" WIDTH="5500"
				SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" />
		
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   DECIMALS="4" ENABLED="" />
	
		
<!--
		<INPUT TYPE="button" NAME="ok"      CAPTION="Dodaj više roba"
				 ONCLICK="spMPMinKolPeriod @action = 3, @operateriid = @@operateriid, @robaid=@@robaid#select 'refresh' as grdrobaOdabir#select '' as roba , 'robaid' as focus, robaid = null"   />

		<INPUT TYPE="grid"
			 NAME="grdrobaOdabir"
			   WIDTH="6000" HEIGHT="2000"
			 CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE"
			  PAGEHEADERLEFT=""
			  PAGEHEADERCENTER=""
			  PAGEHEADERRIGHT=""
			  PAGEFOOTERLEFT="@@TKOSMOMI"
			  SKIPDEFAULTLOAD="FALSE"
			  ONDBLCLICK="spMPMinKolPeriod @action = 5, @operateriid = @@operateriid, @robaid = @(grdrobaOdabir..robaid)#select 'refresh' as grdrobaOdabir"
			  PAGEFOOTERCENTER=""
			  EDITCOLUMNS=""
			 GROUPBYBOXVISIBLE="FALSE"
			 ONCELLEDITED=""
			  PAGEFOOTERRIGHT=""
			  SQL="exec spMPMinKolPeriod @action = 4, @operateriid = @@operateriid"   />

 -->	

	</DODAJART>

	<IZMJENIART NAME="IZMJENIART"
	HEIGHT="9000"
	WIDTH="8000"
	CAPTION="Izmjeni  artikl "
	ONSUBMIT="spMPMinKolPeriod @action = 8, @id=@@id, @kolicina=@@kolicina, @datumod=@@datumod, @datumdo=@@datumdo  --,"
	ONLOAD="spMPMinKolPeriod @action = 7, @id=@@id"
	FILLEXPLORER=""
	NEXTFORM=""
	CMD1CAPTION="Izmjeni"
	CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" ENABLED="TRUE"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" ENABLED="TRUE" />

		<INPUT TYPE="text"  NAME="trgovina"      CAPTION="Trgovina"   ENABLED="FALSE"  />
		<INPUT TYPE="text"   NAME="roba"     CAPTION="Roba" ENABLED="FALSE" />
		
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   DECIMALS="4" ENABLED="" />
		
	</IZMJENIART>


	<OBRISIART NAME="OBRISIART"
	HEIGHT="9000"
	WIDTH="8000"
	CAPTION="Obriši artikl "
	ONSUBMIT="spMPMinKolPeriod @action = 9, @id=@@id--,"
	ONLOAD="spMPMinKolPeriod @action = 7, @id=@@id"
	FILLEXPLORER=""
	NEXTFORM=""
	CMD1CAPTION="Obriši"
	CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" ENABLED="FALSE"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" ENABLED="FALSE" />

		<INPUT TYPE="text"  NAME="trgovina"      CAPTION="Trgovina"   ENABLED="FALSE"  />
		<INPUT TYPE="text"   NAME="roba"     CAPTION="Roba" ENABLED="FALSE" />

		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   DECIMALS="4" ENABLED="FALSE" />

	</OBRISIART>

	<FILTERFORM NAME="FILTERFORM"
HEIGHT="9000"
WIDTH="8000"
CAPTION="Filter"
ONSUBMIT="spMPMinKolPeriod @action = 10, @status=@@status--,"
ONLOAD=""
FILLEXPLORER="TRUE"
NEXTFORM=""
CMD1CAPTION="Traži"
CMD2CAPTION="Odustani"
	>

		<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="true" CAPTION="Status" 
			   SQL="select 1 as status,&apos;U najavi&apos; as naziv  union all select 2 as status,&apos;Aktivno&apos; as naziv union all select 3 as status,&apos;Isteklo &apos; as naziv" />

	</FILTERFORM>
	
		<DODAJNOVO NAME="DODAJNOVO"
		HEIGHT="13000"
		WIDTH="8000"
				   VERSION ="1.3"
		CAPTION="Dodaj artikl "
		ONSUBMIT=""
		ONLOAD=""
		FILLEXPLORER=""
		NEXTFORM=""
		CMD1CAPTION=""
		CMD2CAPTION=""
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="500" LEFT="1000"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="900" LEFT="1000"/>

		
		<INPUT TYPE="search" CAPTION="Roba*" NAME="robaid"  TEXT="" WIDTH="5500" TOP="1300" LEFT="1000"
				SQL="spMPRobaZaMPNG  @trazi = '@@searchboxrobaid'" 
			   ONLOSTFOCUS="if (select dobavljivostretired from roba where robaid=@@robaid)=1 begin
				EXEC spRaiserror 69001, &apos; Roba je umirovljena i nemože se dodati&apos; 			
			   end
			   #select 'refresh' as  grdTrgovina"/>

	
		<INPUT TYPE="grid"
			 NAME="grdTrgovina"
			   WIDTH="6000" HEIGHT="8000" TOP="1700" LEFT="1000"
			   CAPTION="Trgovina*"
			 CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE"
			  PAGEHEADERLEFT=""
			  PAGEHEADERCENTER=""
			  PAGEHEADERRIGHT=""
			  PAGEFOOTERLEFT="@@TKOSMOMI"
			  SKIPDEFAULTLOAD="TRUE"
			  ONDBLCLICK=""
			  PAGEFOOTERCENTER=""
			  EDITCOLUMNS="Količina"
			 GROUPBYBOXVISIBLE="FALSE"
			 ONCELLEDITED=""
			  PAGEFOOTERRIGHT=""
			  SQL="exec spMPMinKolPeriod @action = 20, @robaid=@@robaid"   />
			
				<INPUT TYPE="button" NAME="ok"     CAPTION="Spremi"  TOP="10100" LEFT="1000" WIDTH="1106" HEIGHT="322" 
		   ONCLICK="FOREACHROW(grdTrgovina)#if @@gridgrdTrgovinaKoličina > 0 and  @@gridgrdTrgovinaKoličina is not null begin
					exec spMPMinKolPeriod @action = 21, @operateriid=@@operateriid, @datumod=@@datumod, @datumdo=@@datumdo, @trgovinaid=@@grdTrgovina, 
					@kolicina=@@gridgrdTrgovinaKoličina, @robaid=@@robaid 
					end
					#Ok"  HOTKEY="F2" />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="10100" LEFT="4000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</DODAJNOVO>




</PROJECT>
