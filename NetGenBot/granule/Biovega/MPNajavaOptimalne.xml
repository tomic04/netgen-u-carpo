<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
	POPUPMASTER=""
	MASTERDBLCLICK=""
	BUTTONS="Osvježi prikaz podataka:FILTERFORM#Najavi obnovu:NAJAVI#Izmijeni:IZMIJENI#Obriši najavu:OBRISI#Pregled/Ažuriranje:AZUR#Robe:PREGROBA"
	GROUPBYBOXVISIBLE="TRUE"
	ONLOAD="spMPNajavaOptimalne @action = 3"
	COMMANDTIMEOUT="600"
	CHECKBOXVISIBLE="TRUE">

	<NAME>Najava optimalizacije zaliha  </NAME>
	<CAPTION>>Najava optimalizacije zaliha</CAPTION>


<FILTERFORM
	FILLEXPLORER="">
</FILTERFORM>


<NAJAVI
	NAME="UPDATE_NC" 
	HEIGHT="6000" WIDTH="9000"
	CAPTION="Najava izračuna optimalnih zaliha  "
	ONSUBMIT=""
	ONLOAD="spMPNajavaOptimalne @action = 4 "
	ONLOADED ="select getdate()+1 as datumza"
	VERSION="1.2"
	FILLEXPLORER=""
	CMD1CAPTION=""
	CMD2CAPTION="">

    <INPUT TYPE="datetime" NAME="datumza" TOP="400" LEFT="2800" CAPTION="Najavi za datum *"  WIDTH="2000" ENABLED="TRUE" />
	<INPUT TYPE="multidrop" NAME="trgovina" TOP="800" LEFT="2800" CAPTION="Trgovina*"  WIDTH="3500" ENABLED="TRUE" ALLOWEMPTY="TRUE" SQL="spmpdajtrgovinang @operateriid = @@operateriid" />
	<INPUT TYPE="datetime" NAME="datumprometa" TOP="1200" LEFT="2800" CAPTION="Do datuma prometa*"  WIDTH="1200" ENABLED="TRUE" />
	<INPUT TYPE="number" NAME="danaprometa" TOP="1600" LEFT="2800" CAPTION="Dana prometa za dnevni prosjek*"  WIDTH="800" ENABLED="TRUE" DECIMALS="0" />
	<INPUT TYPE="number" NAME="danaoptimalne" TOP="2000" LEFT="2800" CAPTION="Dana za optimalnu zalihu*"  WIDTH="800" ENABLED="TRUE"  DECIMALS="0" />
  <INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="2400" LEFT="2800" WIDTH="4000" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'"
        ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
  <INPUT TYPE="button" NAME="viseroba"        CAPTION="Više roba" TOP="2400" LEFT="7000" WIDTH="1106" HEIGHT="322" ONCLICK=":VISEROBA"  />  
  <INPUT TYPE="multidrop"    NAME="Klase"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="2800" LEFT="2800" WIDTH="3000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
	<INPUT TYPE="checkbox" NAME="podklase"  CAPTION="Pokaži i podklase" TOP="2800" LEFT="6000"    />
	<INPUT TYPE="multidrop"    NAME="dodklase"   ALLOWEMPTY="TRUE" CAPTION="Dodatna klasa*" TOP="3200" LEFT="2800" WIDTH="3000" 
				SQLL="spmpDajDodKlasa @duzina = 2"  SQL="select klrobaid, left('          ', len(rtrim(sortkey))) +' ' + naziv  
					from klroba where klklrobaid = 10 order by sortkey"/>
	<INPUT TYPE="number" NAME="MinKolicina" TOP="3600" LEFT="2800" CAPTION="Minimalna količina*"  WIDTH="800" ENABLED="TRUE" DECIMALS="0" />
	<INPUT TYPE="checkbox" NAME="samoakcija"  CAPTION="Samo roba u akciji" TOP="4000" LEFT="2800"    />


	<INPUT TYPE="button" NAME="Spremi"            CAPTION="Najavi"  TOP="5000" LEFT="1000" WIDTH="1106" HEIGHT="322"
   ONCLICK="spMPNajavaOptimalne @action = 1 ,@operateriid = @@operateriid, @datumza = @@datumza, @trgovina = '@@trgovina',@datumprometa = @@datumprometa, 
   @danaprometa = @@danaprometa, @danaoptimalne = @@danaoptimalne, @klmasterrobaid = @@klmasterrobaid, @podklase = @@podklase, @dodklasaid = @@dodklasaid,
   @minKolicina = @@minkolicina,  @samoakcija = @@samoakcija , @robaid = @@robaid, @klase = '@@klase', @dodklase = '@@dodklase' #OK "  HOTKEY="" />
	<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="5000" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</NAJAVI>

	<IZMIJENI
		NAME="UPDATE_NC"
		HEIGHT="6000" WIDTH="9000"
		CAPTION="Izmjena najava izračuna optimalnih zaliha  "
		ONSUBMIT=""
		ONLOAD="If ( select DatumOptimalizacije from MPNajavaOptimalne where MPNajavaOptimalneid = @@id ) is null begin 
				select *, zadatum as datumza from MPNajavaOptimalne where MPNajavaOptimalneid = @@id
				end 
				else begin 
					exec spRaiserror 69001, 'Najava je već izračunata. Ne možete ga mijenjati !!'
				end
		
		 "
		ONLOADED =""
    ONLOAD2="spmpNajavaOptimalne @action = 6, @id = @@id, @operateriid = @@operateriid , @trgovinaid = @@trgovinaid  "
		VERSION="1.2"
		FILLEXPLORER=""
		CMD1CAPTION=""
		CMD2CAPTION="">

		<INPUT TYPE="datetime" NAME="datumza" TOP="400" LEFT="2800" CAPTION="Najavi za datum *"  WIDTH="2000" ENABLED="TRUE" />
		<INPUT TYPE="combo" NAME="trgovinaid" TOP="800" LEFT="2800" CAPTION="Trgovina*"  WIDTH="3500" ENABLED="TRUE" ALLOWEMPTY="FALSE" SQL="spmpdajtrgovinang @operateriid = @@operateriid" />
		<INPUT TYPE="datetime" NAME="datumprometa" TOP="1200" LEFT="2800" CAPTION="Do datuma prometa*"  WIDTH="1200" ENABLED="TRUE" />
		<INPUT TYPE="number" NAME="danaprometa" TOP="1600" LEFT="2800" CAPTION="Dana prometa za dnevni prosjek*"  WIDTH="800" ENABLED="TRUE" DECIMALS="0" />
		<INPUT TYPE="number" NAME="danaoptimalne" TOP="2000" LEFT="2800" CAPTION="Dana za optimalnu zalihu*"  WIDTH="800" ENABLED="TRUE"  DECIMALS="0" />
    <INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="2400" LEFT="2800" WIDTH="4000" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'"
          ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
    <INPUT TYPE="button" NAME="viseroba"        CAPTION="Više roba" TOP="2400" LEFT="7000" WIDTH="1106" HEIGHT="322" ONCLICK=":VISEROBA"  />
    <INPUT TYPE="multidrop"    NAME="klase"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="2800" LEFT="2800" WIDTH="3000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
    <INPUT TYPE="checkbox" NAME="podklase"  CAPTION="Pokaži i podklase" TOP="2800" LEFT="6000"    />
    <INPUT TYPE="multidrop"    NAME="dodklase"   ALLOWEMPTY="TRUE" CAPTION="Dodatna klasa*" TOP="3200" LEFT="2800" WIDTH="3000"
          SQLL="spmpDajDodKlasa @duzina = 2"  SQL="select klrobaid, left('          ', len(rtrim(sortkey))) +' ' + naziv  
					from klroba where klklrobaid = 10 order by sortkey"/>
    <INPUT TYPE="number" NAME="MinKolicina" TOP="3600" LEFT="2800" CAPTION="Minimalna količina*"  WIDTH="800" ENABLED="TRUE" DECIMALS="0" />
    <INPUT TYPE="checkbox" NAME="samoakcija"  CAPTION="Samo roba u akciji" TOP="4000" LEFT="2800"    />


    <INPUT TYPE="button" NAME="Spremi"            CAPTION="Spremi"  TOP="5000" LEFT="1000" WIDTH="1106" HEIGHT="322"
	   ONCLICK="spMPNajavaOptimalne @action = 5 ,@operateriid = @@operateriid, @id = @@id,  @datumza = @@datumza,@datumprometa = @@datumprometa, 
   @danaprometa = @@danaprometa, @danaoptimalne = @@danaoptimalne, @klmasterrobaid = @@klmasterrobaid, @podklase = @@podklase, @dodklasaid = @@dodklasaid,
   @minKolicina = @@minkolicina,  @samoakcija = @@samoakcija, @trgovinaid = @@trgovinaid, @robaid = @@robaid, @klase = '@@klase', @dodklase = '@@dodklase'  #OK "  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="5000" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</IZMIJENI>

	<OBRISI
	NAME="UPDATE_NC" 
	HEIGHT="2200" WIDTH="8000"
	CAPTION="Brisanje najave optimalizacije "
	ONLOAD="If ( select datumazur from MPNajavaOptimalne  where MPNajavaOptimalneid = @@id ) is null begin 
				select zadatum as datumza, trgovinaid from MPNajavaOptimalne where MPNajavaOptimalneid = @@id
				end 
				else begin 
					exec spRaiserror 69001, 'Izračun je ažuriran. Ne možete ga brisati !!'
				end "
	ONSUBMIT="spMPNajavaOptimalne @action = 2, @id = @@id,  "
	ONLOADED =""
	FILLEXPLORER=""
	CMD1CAPTION="Obriši"
	CMD2CAPTION="Odustani">

    <INPUT TYPE="date" NAME="datumza" TOP="300" LEFT="2800" CAPTION="Najava za datum *"  WIDTH="2000" ENABLED="FALSE" />
	<INPUT TYPE="combo" NAME="trgovinaid" TOP="700" LEFT="2800" CAPTION="Trgovina *"  WIDTH="3000" ENABLED="FALSE"  SQL="spmpdajtrgovinang @operateriid = @@operateriid" />
</OBRISI>


<AZUR
	NAME="AZUR"
    FILLEXPLORER=""
    CAPTION="Ažuriranje optimalnih zaliha "
    WIDTH="20000" HEIGHT="12000" 
	ONSUBMIT=""
    VERSION="2.4"
    ONLOAD=""
    CMD1CAPTION=""
    CMD2CAPTION="">

    <INPUT TYPE="label" NAME="lbl0" TOP="300" LEFT="200" WIDTH="5500" HEIGHT="320" STYLE="1"/>

    <INPUT TYPE="grid"
      NAME="proknjizi"
      TOP="700"
      LEFT="200"
      WIDTH="19000"
      HEIGHT="9500"
      CAPTION=""
      REFRESHAFTERCHILD="TRUE"
      GROUPBYBOXVISIBLE="TRUE"
      CHECKBOXVISIBLE="FALSE"
		EDITCOLUMNS="Optimalna  za ažuriranje"
		   SQL="spMPNajavaOptimalne @action = 4 , @id = @@id"/>

  <INPUT TYPE="button" NAME="Azur"            CAPTION="Ažuriraj"  TOP="10600" LEFT="1000" WIDTH="1106" HEIGHT="322"
     ONCLICK="FOREACHROW(proknjizi)#update parasortimanstru set kolicina = @@gridproknjiziOptimalna__za_ažuriranje where parasortimanstruid = @@stavke
	 #update MPNajavaOptimalne set datumazur where MPNajavaOptimalneid = @@id#OK "  HOTKEY="" />
  <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="10600" LEFT="2500" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</AZUR>



<KONTROLAOBNOVENC
	NAME="KONTROLAOBNOVENC"
	FILLEXPLORER=""
	CAPTION="Kontrola obnove NC po trgovinama"
	WIDTH="11000" HEIGHT="7000"
	ONSUBMIT=""
	VERSON="1"
	ONLOAD=""
	CMD1CAPTION=""
	CMD2CAPTION="">

	<INPUT TYPE="label" NAME="lbl0" TOP="300" LEFT="200" WIDTH="5500" HEIGHT="320" STYLE="1"/>

	<INPUT TYPE="grid"
		NAME="kontrolanc"
		TOP="700"
		LEFT="200"
		WIDTH="10000"
		HEIGHT="5000"
		CAPTION=""
		REFRESHAFTERCHILD="TRUE"
		GROUPBYBOXVISIBLE="TRUE"
		CHECKBOXVISIBLE="FALSE"
		SQL="spMPNajavaOptimalne @action = 6 , @id = @@id"/>

  <INPUT TYPE="button" NAME="Ponovi"            CAPTION="Ponovi"  TOP="6000" LEFT="456" WIDTH="1106" HEIGHT="322"
       ONCLICK="spMPNajavaOptimalne @action = 8 , @id = @@id , @idkontrole = @@kontrolanc #OK "  HOTKEY="" />
  <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="6000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


</KONTROLAOBNOVENC>

  <VISEROBA
			 WIDTH="8000"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="6000"
			 CAPTION="Odabir artikala za asortiman"
			 CMD1CAPTION=""
			 CMD2CAPTION=""
	 FILLEXPLORER="treeandrefreshmaster"
		 >
    <INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="532" LEFT="1790" WIDTH="4998" TABINDEX="1" COLUMNWIDTH=""
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG  @trazi = '@@searchboxrobaid'"
							ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid # select 'dodaj' as focus" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
    <INPUT TYPE="button" NAME="dodaj" CAPTION="Dodaj" TOP="1000" LEFT="1800" WIDTH="1106" HEIGHT="322" TABINDEX="3"
			   ONCLICK="if @@robaid is not null begin exec spmpOptimalneZaliheNEW @action = 5, @robaid = @@robaid , @trgovinaid = @@trgovinaid , @operateriid = @@operateriid end #select 'refresh' as viseroba #select 'robaid' as focus "/>

    <INPUT TYPE="frame"  NAME="fr1"         CAPTION="" TOP="1500"   LEFT="1200"   WIDTH="4800" HEIGHT="3300"   />

    <INPUT TYPE="grid"
			   NAME="viseroba"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Stavke"
			   TOP="1700" LEFT="1800" WIDTH="5400" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT=""
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpOptimalneZaliheNEW @action = 4, @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />
    <INPUT TYPE="button" NAME="delete" CAPTION="Obriši" TOP="5000" LEFT="2500" WIDTH="1106" HEIGHT="322" TABINDEX="4"   ONCLICK="exec spmpOptimalneZaliheNEW @action = 6, @robaid = @@viseroba , @trgovinaid = @@trgovinaid , @operateriid = @@operateriid #select 'refresh' as viseroba"  />
    <INPUT TYPE="button" NAME="deletesve" CAPTION="Obriši sve" TOP="5000" LEFT="4000" WIDTH="1106" HEIGHT="322" TABINDEX="4"   ONCLICK="exec spmpOptimalneZaliheNEW @action = 7,  @trgovinaid = @@trgovinaid , @operateriid = @@operateriid #select 'refresh' as viseroba"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Kraj odabira" TOP="5000" LEFT="1000" WIDTH="1106" HEIGHT="322" TABINDEX="4"   ONCLICK="close"  />

  </VISEROBA>

  <PREGROBA
			 WIDTH="8000"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="6000"
			 CAPTION="Odabir artikala za asortiman"
			 CMD1CAPTION=""
			 CMD2CAPTION=""
	 FILLEXPLORER="treeandrefreshmaster"
		 >
    <INPUT TYPE="frame"  NAME="fr1"         CAPTION="" TOP="1500"   LEFT="1200"   WIDTH="4800" HEIGHT="3300"   />

    <INPUT TYPE="grid"
			   NAME="viseroba"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Stavke"
			   TOP="1000" LEFT="1800" WIDTH="5400" HEIGHT="3700"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT=""
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpNajavaOptimalne @action = 7, @id = @@id" />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Kraj odabira" TOP="5000" LEFT="1000" WIDTH="1106" HEIGHT="322" TABINDEX="4"   ONCLICK="close"  />

  </PREGROBA>


</PROJECT>