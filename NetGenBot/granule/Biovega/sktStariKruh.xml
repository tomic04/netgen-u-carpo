 group by datumdok, sktprometglaid, convert(varchar(100),memo),broj
 order by broj, DatumDok, sktprometglaid" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="button" NAME="button1" TOP="1224" LEFT="288" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG10" CAPTION="Prihvati" ONCLICK="OK#spPrnStariKruh @action=2, @operateriid=@@operateriid, ++"/>
