<UNDO NAME="UNDO" HEIGHT="2362" WIDTH="7200" CAPTION="Poništavanje" FILLEXPLORER="TRUE">
	<INPUT TYPE="label" NAME="Label33" TOP="446" LEFT="331" HEIGHT="288" WIDTH="936" CAPTION="Knjiženje" TEXT="Label33"/>
	<INPUT TYPE="combo" NAME="sktprometglaid" TOP="446" LEFT="1843" HEIGHT="302" WIDTH="4680" SQL="select sktprometglaid as id, broj + &apos; od &apos; + CONVERT(varchar(12),datumdok,104),  convert(varchar(100),memo) from SktPrometGla 
