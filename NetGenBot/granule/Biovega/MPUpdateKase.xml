<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTER_FORM" 
		 DETAILGRID = "spMPUpdateKase @action=11, @MpKaseId = @@id"
		 DETAILDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION=""
		 CMD2CAPTION="" 
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 		
		 CMD5CAPTION=""
		 CMD6CAPTION="" 
		 CMD7CAPTION="" 
     BUTTONS="Parametri:FILTER_FORM#Unos:INSERT_FORM~REFRESHMASTERGRID#Izmjena:UPDATE_FORM~REFRESHMASTERGRID#Brisanje:DELETE_FORM"
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
     REFRESHAFTERCHILD="TRUE"
     EDITCOLUMNS=""
	   ONCELLEDITED=""
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Ažuriranje blagajne</NAME>
	<CAPTION>Ažuriranje blagajne</CAPTION>
	<AUTOR>16.05.2014 Matija Horvat</AUTOR>


 <FILTER_FORM NAME="FILTER_FORM"
		 HEIGHT="3000"
		 WIDTH="5700"
		 CAPTION="Uvijeti prikaza"
		 ONSUBMIT="spMPUpdateKase @action = 1, @operateriid = @@operateriid, "
		 ONLOAD=""
     ONLOADED=""
     FILLEXPLORER="TRUE"
		 FOCUS="opis"
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani" >

    
    <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5250" HEIGHT="1800" />
    
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="500" LEFT="1200"  WIDTH="3500" HEIGHT="300"  ALLOWEMPTY="TRUE" 
             SQL="spmpdajtrgovinang @operateriid = @@operateriid" ONLOSTFOCUS="select 'refresh' as mpkaseid" />
 
    <INPUT TYPE="combo" NAME="mpkaseid" CAPTION="Kasa :*" TOP="900" LEFT="1200" WIDTH="3500" HEIGHT="300" ALLOWEMPTY="TRUE"
        SQL="select mpkaseid, Kasa from MPkase where (TrgovinaId = @@trgovinaid or @@trgovinaid is null)"/>

    
    
    />
    
</FILTER_FORM>

 <INSERT_FORM
      NAME="TRGOVINE" HEIGHT="8500" WIDTH="5700"
      CAPTION="Unos plana ažuriranja kasa"
      ONSUBMIT=""
      ONLOAD=""
      FILLEXPLORER=""
      CMD1CAPTION=""
      CMD2CAPTION="">

    <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="4250" HEIGHT="7100" />
    <INPUT TYPE="date"    NAME="datumZakazivanje"   CAPTION="Datum planiranja :*" TOP="500" LEFT="1500" DEFAULT="today" />
    
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="7400" LEFT="200" WIDTH="1106" HEIGHT="322"
			 ONCLICK="FOREACHSELECTED(kase)#spMPUpdateKase @action=2,  @datumZakazivanje = @@datumZakazivanje, 
                @mpkaseid = @(kase..mpkaseid), @operateriid = @@operateriid"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Zatvori" TOP="7400" LEFT="1500" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

    <INPUT TYPE="grid" 
         NAME="kase"
         REFRESHAFTERCHILD=""
         CAPTION="Trgovine"
         TOP="1500" LEFT="150" WIDTH="4000" HEIGHT="5300"
         TABINDEX="-1"
         AFTERREFRESH=""
         POPUP=""
         ONDBLCLICK=""
         CHECKBOXVISIBLE="TRUE"
         EDITCOLUMNS=""
         ONCELLEDITED=""
         PAGEHEADERCENTER=""
         PAGEHEADERRIGHT=""
         PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
         PAGEFOOTERCENTER=""
         PAGEFOOTERLEFT=""
         PAGEFOOTERRIGHT="@@tkosmomi"
         PAGEORIENTATION="LANDSCAPE"
         GROUPBYBOXVISIBLE="FALSE"
         TOTALROW="FALSE"
         SQL="spMPUpdateKase @action=5" />

 </INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="3500" 
		 WIDTH="6000" 
		 CAPTION="Izmjena postojećeg plana ažuriranja"
		 ONSUBMIT=""
     ONLOAD="if (select count(*) from mpupdatekase where mpupdatekaseid = @@mpupdatekaseid) = 0 begin 
			        exec spRaiserror 69001, 'Odaberite slog za izmjenu!' 
			       end" 
     ONLOAD2="spMPUpdateKase @action = 111, @id = @@mpupdatekaseid"
     ONLOADED="select @@detid as mpupdatekaseid# spMPUpdateKase @action = 111, @id = @@mpupdatekaseid"
     FILLEXPLORER=""
		 FOCUS="" 
		 CMD1CAPTION="" 
		 CMD2CAPTION="" >

      <INPUT TYPE="text"    NAME="mpupdatekaseid"   CAPTION="" TOP="50" LEFT="50" WIDTH="300" HEIGHT="320" VISIBLE="FALSE"  />
      <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5600" HEIGHT="2100" />
      <INPUT TYPE="date"    NAME="datumZakazivanje"   CAPTION="Datum planiranja :*" TOP="500" LEFT="1500" DEFAULT="today" />
      <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="1300" LEFT="1500"  WIDTH="3500" HEIGHT="300"  ALLOWEMPTY="TRUE"
              SQL="spmpdajtrgovinang @operateriid = @@operateriid" ONLOSTFOCUS="select 'refresh' as mpkaseid" />

      <INPUT TYPE="combo" NAME="mpkaseid" CAPTION="Kasa :*" TOP="1700" LEFT="1500" WIDTH="3500" HEIGHT="300" ALLOWEMPTY="FALSE"
              SQL="select mpkaseid, Kasa from MPkase where (TrgovinaId = @@trgovinaid or @@trgovinaid is null)"/>
      
      <INPUT TYPE="button"    NAME="spremi"   CAPTION="Spremi" TOP="2500" LEFT="200" WIDTH="1100" HEIGHT="320"
             ONCLICK="spMPUpdateKase @action = 3, @id = @@mpupdatekaseid, @datumZakazivanje = @@datumZakazivanje, 
                      @mpkaseid = @@mpkaseid,  @operateriid = @@operateriid"/>
      <INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="2500" LEFT="1600" WIDTH="1100" HEIGHT="320" ONCLICK="close" />
      
</UPDATE_FORM>

  <DELETE_FORM NAME="OSVJEZI_FORM"
       HEIGHT="3500"
       WIDTH="6000"
       CAPTION="Brisanje plana za ažuriranje"
       ONSUBMIT=""
       ONLOAD="if (select count(*) from mpupdatekase where mpupdatekaseid = @@mpupdatekaseid) = 0 begin 
			        exec spRaiserror 69001, 'Odaberite slog za brisanje!' 
			       end"
       NOLOAD2="spMPUpdateKase @action = 111, @id = @@mpupdatekaseid"
       ONLOADED="select @@detid as mpupdatekaseid# spMPUpdateKase @action = 111, @id = @@mpupdatekaseid"
       NEXTFORM=""
       FOCUS=""
       FILLEXPLORER=""
       CMD1CAPTION=""
       CMD2CAPTION="" >

      <INPUT TYPE="text"    NAME="mpupdatekaseid"   CAPTION="" TOP="50" LEFT="50" WIDTH="300" HEIGHT="320" VISIBLE="FALSE" ENABLED="FALSE" />
      <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5600" HEIGHT="2100" />
      <INPUT TYPE="date"    NAME="datumZakazivanje"   CAPTION="Datum planiranja :*" TOP="500" LEFT="1500" DEFAULT="today" ENABLED="FALSE" />
      <INPUT TYPE="number"    NAME="sat"   CAPTION="Vrijeme planiranja :*" TOP="900" LEFT="1500" WIDTH="300" HEIGHT="320" MAXLENGTH="2" DECIMALS="0" ENABLED="FALSE" />
      <INPUT TYPE="number"    NAME="minuta"   CAPTION=":*" TOP="900" LEFT="1950" WIDTH="300" HEIGHT="320" MAXLENGTH="2" DECIMALS="0" ENABLED="FALSE"  />
      <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="1300" LEFT="1500"  WIDTH="3500" HEIGHT="300"  ALLOWEMPTY="TRUE" ENABLED="FALSE"
            SQL="spmpdajtrgovinang @operateriid = @@operateriid" ONLOSTFOCUS="select 'refresh' as mpkaseid" />

      <INPUT TYPE="combo" NAME="mpkaseid" CAPTION="Kasa :*" TOP="1700" LEFT="1500" WIDTH="3500" HEIGHT="300" ALLOWEMPTY="TRUE" ENABLED="FALSE"
            SQL="select mpkaseid, Kasa from MPkase where (TrgovinaId = @@trgovinaid or @@trgovinaid is null)"/>

      <INPUT TYPE="button"    NAME="spremi"   CAPTION="Obriši" TOP="2500" LEFT="200" WIDTH="1100" HEIGHT="320"
           ONCLICK="spMPUpdateKase @action = 4, @id = @@mpupdatekaseid#OK"/>
      <INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="2500" LEFT="1600" WIDTH="1100" HEIGHT="320" ONCLICK="close" />
    
      
  </DELETE_FORM>


</PROJECT>