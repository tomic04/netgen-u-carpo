<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="Promet:FORM2" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		MASTERDBLCLICK=""
	        POPUPMASTER=""
     PAGEHEADERLEFT=""
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Pregled nekurentne robe</NAME>
  <CAPTION>Pregled nekurentne robe</CAPTION>
  

<FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="7100" 
		ONSUBMIT="spMPPregNekurentneRobeNG @action=3,@operateriid=@@operateriid," 
		ONLOAD="select @@trgovinaid as trgovinaid, @@broj1 as broj1, @@stanje as stanje" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="200" LEFT="1200"  WIDTH="5500" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="false" 
            SQL="spmpdajtrgovinang @operateriid = @@operateriid"/>

    <INPUT TYPE="number" NAME="broj1" TOP="700" LEFT="1200" TABINDEX="1" CAPTION="Broj dana*" DECIMALS="0" WIDTH="1900" HEIGHT="320"/> 

    <INPUT TYPE="search" NAME="robaid" CAPTION="Roba*" TABINDEX="2" TOP="1300" LEFT="1200" WIDTH="5500" HEIGHT="320"
            SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" />

    <INPUT TYPE="search"  CAPTION="Klasa*" NAME="klasaid" TOP="1800" LEFT="1200"  WIDTH="5500" HEIGHT="320" TABINDEX="3"
          SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
  
  <!--<INPUT TYPE="combo" NAME="klasaid" CAPTION="Klasa" TOP="1800" LEFT="2200"  WIDTH="5500" HEIGHT="320" TABINDEX="3" ALLOWEMPTY="TRUE" 
 	          SQL="select KlMasterRobaId,  naziv = space(len(sortkey)) + naziv,sortkey from KlMasterRoba order by sortkey"  />-->

		<INPUT TYPE="check" NAME="podklase" CAPTION="pokaži i sve podklase" TOP="2300" LEFT="1200" WIDTH="3500"	HEIGHT="320" />

    <INPUT TYPE="VB.checkbox" NAME="stanje" CAPTION="pokaži samo robe kojima je stanje različito od 0" TOP="2800" LEFT="1200" WIDTH="4000" HEIGHT="320" />

</FORM1>
 

<FORM2	 	FILLEXPLORER="TRUE" 
		WIDTH="12000" 
		ONSUBMIT="" 
		ONLOAD="" 		
		HEIGHT="6000" 
		CAPTION="Promet" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
			<INPUT TYPE="grid" 
             NAME="lbl2" 
             TOP="700" 
             LEFT="200" 
             WIDTH="11000" 		
             HEIGHT="4000" 
             CAPTION="Promet:"
					REFRESHAFTERCHILD="TRUE"
					SQL="spMPPregNekurentneRobeNG @action=2,@robaid=@@id,@klasaid=null,@podklase=null,@Broj1=null,@operateriid=0,@stanje=null, @trgovinaid = @@trgovinaid"/>
			
</FORM2>

</PROJECT> 