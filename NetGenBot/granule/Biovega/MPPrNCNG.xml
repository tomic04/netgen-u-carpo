<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT=""
		BUTTONS="Parametri:FORM1#Brisanje:DELETEFORM#Započeto:ZAPOCETO"
		TOTALROWVISIBLE="FALSE"
		GROUPBYBOXVISIBLE="TRUE"
		CHECKBOXVISIBLE="FALSE"> 
 
  <NAME>Pregled promjena nab.cijene komisijske mp robe</NAME>
  <CAPTION>Pregled promjena nab.cijene komisijske mp robe</CAPTION>
  

<FORM1 	
	    FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spMPNabCijenaPrometQueryNG @action=1, " 
		ONLOAD="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani"> 
		
	<INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Vrsta cjenika" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="TRUE" SQL="spmpDajMPCjenik @operateriid = @@operateriid"/>
	<INPUT TYPE="search" CAPTION="Roba" NAME="robaid" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid" ALLOWEMPTY="FALSE" WIDTH="5500" HEIGHT="320"/> 
	<INPUT TYPE="text" CAPTION="Traženje pojma" NAME="search" WIDTH="5500" HEIGHT="320"/>
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" VALUE="DATE2" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" VALUE="DATE" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="Ind" CAPTION="Status" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select 0 as ind, 'U najavi' as naziv union all select 1 as ind , 'Promijenjen cjenik'  union all select 2 as ind , 'Proknjiženo' "/>

</FORM1>


<DELETEFORM
		WIDTH="5500" 
		ONSUBMIT="spMPNabCijenaPrometQueryNG @action=2, @NCCijenaPrometid=@@id " 
		ONLOAD="if coalesce(@@id,0) = 0 begin exec spRaiserror 69001, &apos;Nema podataka za brisanje !&apos; end"	
		HEIGHT="2500" 
		CAPTION="Obrisati ?" 
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
	<INPUT TYPE="label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati odabrani artikal ? " />
	
</DELETEFORM>

<ZAPOCETO
		WIDTH="15000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="8000"
		CAPTION="Pregled započetih a neproknjiženih promjena nab.cijene"
		CMD1CAPTION=""
		CMD2CAPTION="Odustani"
		FILLEXPLORER="">

	<INPUT TYPE="grid" 
			NAME="grid1"
			REFRESHAFTERCHILD="" 
			CAPTION="Započete promjene nab.cijene " 
			TOP="500" LEFT="500" WIDTH="14000" HEIGHT="6000" 
			SQL="spMPNabCijenaPrometQueryNG @action=3" 
			CHECKBOXVISIBLE="FALSE" 
			GROUPBYBOXVISIBLE="TRUE" 
			TOTALROW="FALSE"/>

</ZAPOCETO>

</PROJECT> 