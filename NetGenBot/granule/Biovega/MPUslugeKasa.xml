<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname'#select dbo.fnTkoSmoMi() as tkosmomi "
	ONLOAD=":FILTERFORM" 
	TREE=""
	MASTERDBLCLICK=""
	BUTTONS="Traži:FILTERFORM#Ažuriraj:INSERTFORM#(De)aktiviranje:AKTIVIRAJ"
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="FALSE"
	POPUPMASTER=""
	TOTALROW="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
	DETTOTALROWVISIBLE="FALSE"
  PAGEHEADERLEFT=""
  PAGEHEADERRIGHT="@@tkosmomi">
 
  <NAME>Usluge za kasu</NAME>
  <CAPTION>Usluge za kasu</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MT 13.05.2010.  </AUTOR>

	<KLASIFIKACIJA  
		FILLEXPLORER="TRUE" 
		ONSUBMIT="spmpUslugeKasa @action=1, @KlasaID=@@node, @podklase = 1, @trgovinaid = @@trgovinaid "/>

<FILTERFORM 
		WIDTH="9000" 
		HEIGHT="3500" 
		ONSUBMITold="spmpUslugeKasa @action =1, @KlasaID=@@node, @podklase = 1,  " 
		ONSUBMIT="spmpUslugeKasa @action =1, " 
		ONLOAD="" 
		CAPTION="Parametri"  
		CMD1CAPTION="Traži" 
		CMD2CAPTION="Izlaz" 
		FILLEXPLORER="TRUE" >

	<INPUT TYPE="search" CAPTION="Roba:*" NAME="robaid" TOP="800" LEFT="1400" WIDTH="6500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" />
	

</FILTERFORM>

	
<INSERTFORM
		WIDTH="7000"
		ONSUBMIT=""
		ONLOAD="exec spmpUslugeKasa @action= 2, @robaid = @@id  "
		HEIGHT="4500"
		FOCUS="barcode" 
		CAPTION="Ažuriranje usluga za kasu  "
		FILLEXPLORER="">




	<INPUT TYPE="search" CAPTION="Usluga:*" NAME="robaid" TOP="800" LEFT="1400" WIDTH="6500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPRobaZaMPNG @usluga = 1 , @trazi = '@@searchboxrobaid'" />
  
  <INPUT TYPE="button" NAME="ok"      CAPTION="Spremi"    TOP="3500" LEFT="1000" WIDTH="1100" HOTKEY="F10" 
         ONCLICK="exec spmpUslugeKasa @action= 3, @operateriid = @@operateriid, @robaid = @@robaid#OK" />
	<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani"  TOP="3500" LEFT="3000" WIDTH="1100" ONCLICK="close" />
		
</INSERTFORM>

	<AKTIVIRAJ
			WIDTH="7000"
			ONSUBMIT=""
			ONLOAD="exec spmpUslugeKasa @action= 2, @robaid = @@id  "
			HEIGHT="4500"
			FOCUS="barcode"
			CAPTION="Ažuriranje usluga za kasu  "
			FILLEXPLORER="">




		<INPUT TYPE="text" CAPTION="Šifra:*" NAME="sifra" TOP="800" LEFT="1400" WIDTH="1200" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="" ENABLED="FALSE" STYLE="1" />
		<INPUT TYPE="text" CAPTION="Usluga:*" NAME="roba" TOP="1300" LEFT="1400" WIDTH="6500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="" ENABLED="FALSE" STYLE="1" />

		<INPUT TYPE="button" NAME="ok"      CAPTION="Promijeni status"    TOP="3500" LEFT="1000" WIDTH="1100" HOTKEY="F10"
			   ONCLICK="exec spmpUslugeKasa @action= 4, @operateriid = @@operateriid, @robaid = @@id#OK" />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani"  TOP="3500" LEFT="3000" WIDTH="1100" ONCLICK="close" />

	</AKTIVIRAJ>



</PROJECT>
 
