<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spMPSmjene @action = 6, @operateriid = @@operateriid" 
   CMD1CAPTION=""
   CMD2CAPTION="Ažuriraj:AZURTRG" 
   CMD3CAPTION="Smjene:SMJENE"
   CMD4CAPTION="" 
   CMD5CAPTION=""
   CMD6CAPTION=""
   DETAILGRID = "spMPSmjene @action = 5, @trgovinaid = @@id " 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK=""
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Ažuriranje MP smjena</NAME>
  <CAPTION>Ažuriranje MP smjena</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


  <OBNOVI
		WIDTH="8000" 
		ONSUBMIT="spMPSmjene @action = 1" 
		ONLOAD="" 
		HEIGHT="2500" 
		FILLEXPLORER="TRUE" 
		CAPTION="Obnova podataka o MP smjenama"  
		FOCUS="Naziv"
		>
	  
		<INPUT TYPE="label" CAPTION="Želite li obnoviti podatke o MP smjenama ?" NAME="varime" TOP="500" LEFT="400" SQL="" TABINDEX="1" STYLE="BOLD" SIZE="12" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="false" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Obnovi" TOP="1500" LEFT="196" TABINDEX ="2" WIDTH="1106" HEIGHT="322" ONCLICK="spMPSmjene @action = 1#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1500" TABINDEX="1" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </OBNOVI>


  <INSERTFORM
		WIDTH="8000"
		ONSUBMIT=""
		ONLOAD="select '00' as odsat, '00' as odmin, '00' as dosat, '00' as domin"
		HEIGHT="3500"
		CAPTION="Unos podatka"
		FOCUS="odsat"
		>

    <INPUT TYPE="Label" CAPTION="Od" NAME="lblodsat" SQL="" TABINDEX="2" LEFT="1000" TOP="1050" WIDTH="400" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="text" CAPTION="" NAME="Odsat" SQL="" TABINDEX="1" LEFT="1400" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="text" CAPTION="" NAME="Odmin" SQL="" TABINDEX="2" LEFT="1800" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="Label" CAPTION="Do" NAME="lbldo" SQL="" TABINDEX="2" LEFT="2300" TOP="1050" WIDTH="500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="text" CAPTION="" NAME="Dosat" SQL="" TABINDEX="3" LEFT="2700" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="text" CAPTION="" NAME="Domin" SQL="" TABINDEX="4" LEFT="3100" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="Label" CAPTION="sati" NAME="lblsati" SQL="" TABINDEX="2" LEFT="3500" TOP="1050" WIDTH="500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" 
           ONCLICK="spMPSmjene @action=2, @odsat = '@@odsat', @odmin = '@@odmin', @dosat = '@@dosat', @domin = '@@domin' #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </INSERTFORM>
	

  <UPDATEFORM 
        WIDTH="8000" 
        ONSUBMIT="" 
        ONLOAD="select * from MPSmjene where MPSmjeneid = @@smjene" 
        HEIGHT="3500" 
        CAPTION="Izmjena podatka"  
		FOCUS="odsat"
		>

    <INPUT TYPE="int" CAPTION="mpsmjeneid" NAME="" SQL="" TABINDEX="2" VISBLE="FALSE" LEFT="1000" TOP="1050" WIDTH="400" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1" decimals="0"/>
    <INPUT TYPE="Label" CAPTION="Od" NAME="lblodsat" SQL="" TABINDEX="2" LEFT="1000" TOP="1050" WIDTH="400" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="text" CAPTION="" NAME="Odsat" SQL="" TABINDEX="1" LEFT="1400" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="text" CAPTION="" NAME="Odmin" SQL="" TABINDEX="2" LEFT="1800" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="Label" CAPTION="Do" NAME="lbldo" SQL="" TABINDEX="2" LEFT="2300" TOP="1050" WIDTH="500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="text" CAPTION="" NAME="Dosat" SQL="" TABINDEX="3" LEFT="2700" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="text" CAPTION="" NAME="Domin" SQL="" TABINDEX="4" LEFT="3100" TOP="1000" WIDTH="300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
    <INPUT TYPE="Label" CAPTION="sati" NAME="lblsati" SQL="" TABINDEX="2" LEFT="3500" TOP="1050" WIDTH="500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1"/>
    <INPUT TYPE="button" NAME="ok" CAPTION="Izmjeni" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" 
           ONCLICK="spMPSmjene @action=3, @MPSmjeneid= @@mpsmjeneid, @odsat = '@@odsat', @odmin = '@@odmin', @dosat = '@@dosat', @domin = '@@domin'#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </UPDATEFORM>


  <DELETEFORM
		WIDTH="8000"
		ONSUBMIT=""
		ONLOAD="select MPSmjeneid,naziv,'Jeste li sigurni da želite obrisati podatak o MP smjeni ?' as poruka from MPSmjene where MPSmjeneid = @@id"
		HEIGHT="3500"
		CAPTION="Brisanje podatka"
		FOCUS="Naziv"
		>

	    <INPUT TYPE="text" CAPTION="" NAME="poruka" SQL="" TABINDEX="2" WIDTH="5000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
	    <INPUT TYPE="text" CAPTION="Naziv" NAME="naziv" SQL="" TABINDEX="2" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Obriši" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPSmjene @action=4, @MPSmjeneid= @@id, @naziv= '@@naziv'#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </DELETEFORM>

  <SMJENE
        NAME="TIPRV_FORM" HEIGHT="7851" WIDTH="6000"
			  CAPTION="Ažuriranje vrsta smjena"
				BORDERSTYLE="3"
				ONSUBMIT=""
				ONLOAD=""
				CANCELONSUBMIT=""
				FILLEXPLORER=""
				NEXTFORM=""
				CMD1CAPTION=""
				CMD2CAPTION="">

    <INPUT TYPE="grid" NAME="smjene" TOP="800" LEFT="200" WIDTH="8300" HIGHT="6000"
					CAPTION="Vrste smjena"
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
					PAGEHEADERCENTER=""
					PAGEHEADERRIGHT=""
					ONDBLCLICK=""
					PAGEHEADERLEFT=""
					PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
					PAGEORIENTATION="LANDSCAPE"
					SQL="spmpsmjene @action = 1" >

    </INPUT>

    <INPUT TYPE="button" NAME="" CAPTION="Dodaj" TOP="6500" LEFT="200" WIDTH="1000" HEIGHT="322" ONCLICK=":INSERTFORM#select 'refresh' as smjene"/>
    <INPUT TYPE="button" NAME="" CAPTION="Izmjeni" TOP="6500" LEFT="1500" WIDTH="1000" HEIGHT="322" ONCLICK=":UPDATEFORM#select 'refresh' as smjene"/>
    <INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="6500" LEFT="4300" WIDTH="1000" HEIGHT="322" ONCLICK="close"/>

  </SMJENE>

  <AZURTRG
        NAME="TIPRV_FORM" HEIGHT="7851" WIDTH="6000"
			  CAPTION="Ažuriranje smjena po trgovinama"
				BORDERSTYLE="3"
				ONSUBMIT=""
				ONLOAD="select oznaka+' '+opis as trgovina from trgovina where trgovinaid = @@id"
				CANCELONSUBMIT=""
				FILLEXPLORER=""
				NEXTFORM=""
				CMD1CAPTION=""
				CMD2CAPTION="Izlaz">
    <INPUT TYPE="text" CAPTION="Trgovina*" NAME="trgovina" SQL="" TOP="300" LEFT="1500" TABINDEX="2" WIDTH="3000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" STYLE="1" />


    <INPUT TYPE="grid" NAME="AZURTRG" TOP="800" LEFT="200" WIDTH="8300" HIGHT="6000"
					CAPTION=""
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
					PAGEHEADERCENTER=""
					PAGEHEADERRIGHT=""
					ONDBLCLICK=""
					PAGEHEADERLEFT=""
          EDITCOLUMNS="Odabir"
			    ONCELLEDITED="spMPSmjene @action = 8 , @odabir = '@@gridAZURTRGOdabir', @mpsmjeneid = @@azurtrg , @trgovinaid =@@id #select 'refresh' as AZURTRG"
           PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
					PAGEORIENTATION="LANDSCAPE"
					SQL="spmpsmjene @action = 7, @trgovinaid = @@id " >


    </INPUT>


  </AZURTRG>

</PROJECT>
 
