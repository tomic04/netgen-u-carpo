<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION=""  
		CMD8CAPTION=""
		MASTERDBLCLICK=""
	    POPUPMASTER=""
		COMMANDTIMEOUT="600"
		ONCLOSED=""
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @trazi ='' "> 

 
  <NAME>Pregled robe u trg. na dan</NAME>
  <CAPTION>Pregled robe u trg. na dan</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		ONSUBMIT="spmpPregledstanjatrgovinanadan @operateriid = @@operateriid,@trgovinaid=@@trgovinaid,
					@robaid=@@robaid, @datumdo=@@datumdo--,"
		ONLOAD="" 
		HEIGHT="4000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">


	  <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="500" LEFT="1500"  WIDTH="6000" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="true" 
                SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t where t.aktivno = 1"/>
		
		<INPUT TYPE="TRAZILICA" CAPTION="Roba*" NAME="robaid" TOP="1000" LEFT="1500" TEXT="" WIDTH="6000" HEIGHT="320"
			    SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" ALLOWEMPTY="FALSE"/>

	  <INPUT TYPE="date" NAME="datumdo" CAPTION="Na datum*" TOP="1500" LEFT="1500" WIDTH="2000"/>


  </FORM1>

	
	
 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Krtica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
                         SQL="exec spMPStanjeKarticaNG @action=0, @nenc = @@nenc, @robaid=@@id, @trgovinaid=@@trgovinaid, @totalgen = 2 " /> 
</KARTICA>


</PROJECT> 