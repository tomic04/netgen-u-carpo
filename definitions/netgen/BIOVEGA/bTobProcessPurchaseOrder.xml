	<FILTER NAME="FILTER" HEIGHT="3528" WIDTH="6336" CAPTION="Filter" ONSUBMIT="spbTobProcessPurchaseOrder_Query @action=&apos;MAIN&apos;, @datumod=&apos;@@fdatumod&apos;, @datumdo=&apos;@@fdatumdo&apos;, @partneriid=@@fpartneriid, @parstruid=@@fparstruid, @datumisporuke=@@datumisporuke --" ONLOAD="select @@fdatumod as fdatumod, @@fdatumdo as fdatumdo, @@fpartneriid as fpartneriid, &apos;@@searchboxfpartneriid&apos; as partner, @@fparstruid as fparstruid, &apos;@@searchboxfparstruid&apos; as lokacija, @@datumisporuke as datumisporuke" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
		<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="72" HEIGHT="2304" WIDTH="6048" TEXT="FrameNG0"/>
		<INPUT TYPE="date" NAME="fdatumdo" TOP="432" LEFT="4032" HEIGHT="302" WIDTH="1728"/>
		<INPUT TYPE="date" NAME="fdatumod" TOP="432" LEFT="2160" HEIGHT="302" WIDTH="1728"/>
		<INPUT TYPE="label" NAME="Label13" TOP="432" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Datum:"/>
		<INPUT TYPE="search" NAME="fpartneriid" TOP="864" LEFT="2160" HEIGHT="302" WIDTH="3600" SQL="select p.PartneriId, p.Sifra, p.Naziv from Partneri p inner join bTobPartneri x on p.PartneriId = x.PartneriId and x.VrstaDok = &apos;ProcessPurchaseOrder&apos; where p.Sifra = &apos;@@searchboxfpartneriid&apos; or p.Naziv like &apos;@@searchboxfpartneriid%&apos;" CAPTION="partner"/>
		<INPUT TYPE="label" NAME="Label14" TOP="864" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Partner:"/>
		<INPUT TYPE="search" NAME="fparstruid" TOP="1296" LEFT="2160" HEIGHT="302" WIDTH="3600" SQL="parstru#parstruid#naziv%#sifra#/and (partneriid=@@partneriid or @@partneriid is null)" CAPTION="lokacija" ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label15" TOP="1296" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Lokacija:"/>
		<INPUT TYPE="date" NAME="datumisporuke" TOP="1728" LEFT="2160" HEIGHT="302" WIDTH="1728" SHOWCHECKBOX="TRUE"/>
		<INPUT TYPE="label" NAME="Label25" TOP="1728" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Datum isporuke:"/>
		<INPUT TYPE="button" NAME="buttonOK" TOP="2520" LEFT="432" HEIGHT="331" WIDTH="1368" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prikaži" ENABLED="TRUE" ONCLICK="OK"/>
		<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2520" LEFT="1930" HEIGHT="331" WIDTH="1368" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

	</FILTER>

