<?xml version="1.0" encoding="windows-1250" ?> 
<PROJECT  
	ONLOAD=""  
	BUTTONS="Izmjeni:IZMJENI"
	MASTERDBLCLICK=""
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	DETTOTALROWVISIBLE="TRUE"
	DETCHECKBOXVISIBLE="FALSE"
	TREE="spTreeKlmasterRoba:FILTERPAR_FORM "
	EDITCOLUMNS=""
	ONCELLEDITED="">
 
  <NAME>Ažuriranje Proizvođača i robnih marki na robi </NAME>
  <CAPTION>Ažuriranje Proizvođača i robnih marki na robi </CAPTION>

	<FILTERPAR_FORM    FILLEXPLORER="TRUE" ONSUBMIT="exec spAzurRobneMarke @action=1,@klmasterrobaid = '@@node'" />


	<FILTERFORM
	NAME="FILTERFORM"
	FILLEXPLORER="ONLYTREE"
	ONSUBMIT=""
	ONLOAD="select @@partneriid as partneriid,@@trgovinaid as trgovinaid , @@datumod as datumod, @@datumdo as datumdo "
	REPORT=""  
	WIDTH="8000" 
	HEIGHT="3500" 
	CAPTION="Parametri"
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	<INPUT TYPE="date" NAME="datod"   CAPTION="Datum od:*" TOP="500" LEFT="1500" WIDTH="1500" HEIGHT="320" DEFAULT="firstdayofmonth" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datdo"   CAPTION=" do:*" TOP="500" LEFT="3500" WIDTH="1500" HEIGHT="320" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid"   CAPTION="Trgovina:*" TOP="900" LEFT="1500" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" 
		   SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @komis = 1 " /> 

</FILTERFORM>

	<IZMJENI
		  WIDTH="8000"
		  ONSUBMIT="spAzurRobneMarke @action = 3, "
		  ONLOAD="spAzurRobneMarke @action = 2 , @robaid = @@id"
		  HEIGHT="2800"
		  CAPTION="Izmjena podataka "
		  BORDERSTYLE="3"
		  CMD1CAPTION="Spremi"
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  CHILDFORM="">

		<INPUT TYPE="combo"
				CAPTION="Roba"
				NAME="robaid"
				TEXT=""
				STYLE="1"
			    SIZE="11" 
				SQL="select robaid, naziv from roba where robaid = @@id" 
				ENABLED="FALSE" 
				TABINDEX="1"
			    WIDTH="5000"
				HEIGHT="320"/>
		<INPUT TYPE="search"
				CAPTION="Proizvođač"
				NAME="proizvodjacid"
				SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#sifra#!adresa"
			    TEXT=""
				TABINDEX="1"
			    WIDTH="5000"
				ONLOSTFOCUS="select 'refresh' as robnamarkaid"
			    HEIGHT="320"/>
		
		<INPUT TYPE="combo"
				CAPTION="Roban marka "
				NAME="robnamarkaid"
			    SQL="select robnamarkaid , opis as naziv from robnamarka where partneriid = @@proizvodjacid" 
				TEXT=""
				TABINDEX="2"
			    WIDTH="5000"
				 
				HEIGHT="320"/>




	</IZMJENI>





</PROJECT>
 
