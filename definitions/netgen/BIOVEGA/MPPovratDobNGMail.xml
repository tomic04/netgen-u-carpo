		<INPUT TYPE="number" NAME="fakcijena" 	  CAPTION="Fak.cijena*" TOP="3700" LEFT="1372" WIDTH="1512" HEIGHT="280" ONLOSTFOCUS="spmpKalkNG @action = 5 , @robaid = @@robaid, @kolicinaulaz= @@kolicina, @fakcijena = @@fakcijena, @fakvrijednost=@@fakvrijednost, @rabatdp = @@rabatdp, @nabcijena = @@nabcijena, @nabvrijednost = @@nabvrijednost, @marza = @@marzap, @mpcijena = @@mpcijena , @mpcpov = @@mpcpov " SQL=""  />
		<INPUT TYPE="number" NAME="fakvrijednost" CAPTION="Fakturni iznos*" TOP="3700" LEFT="4538" WIDTH="1708" HEIGHT="280" ONLOSTFOCUS="spmpKalkNG @action = 6 , @robaid = @@robaid, @kolicinaulaz= @@kolicina, @fakcijena = @@fakcijena, @fakvrijednost=@@fakvrijednost, @rabatdp = @@rabatdp, @nabcijena = @@nabcijena, @nabvrijednost = @@nabvrijednost, @marza = @@marzap, @mpcijena = @@mpcijena , @mpcpov = @@mpcpov " SQL=""  />
		<INPUT TYPE="number" NAME="rabatdp" 	  CAPTION="Rabat %*" TOP="4050" LEFT="1372" WIDTH="700" HEIGHT="280" ONLOSTFOCUS="spmpKalkNG @action = 7 , @robaid = @@robaid, @kolicinaulaz= @@kolicina, @fakcijena = @@fakcijena, @fakvrijednost=@@fakvrijednost, @rabatdp = @@rabatdp, @nabcijena = @@nabcijena, @nabvrijednost = @@nabvrijednost, @marza = @@marzap, @mpcijena = @@mpcijena , @mpcpov = @@mpcpov # " SQL=""  />
		<INPUT TYPE="number" NAME="rabati" 			CAPTION="Rabat kn*" TOP="4050" LEFT="3360" WIDTH="1372" HEIGHT="280" ENABLED ="FALSE" ONLOSTFOCUS="" SQL=""  />
