<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 ONLOAD=":DANAS_FORM"
		 DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id"
		 MASTERDBLCLICK="UPDATE_FORM"
		 PAGEORIENTATION="LANDSCAPE"
		 BUTTONS="Dodaj:INSERTFORM#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Korekcija nab.uvjeta:KOREKCIJA#Pronađi:FILTERFORM#Print dok.:ISPIS_FORM#Pošalji mail:ASSEMBLYLOAD(RepxToPdfExcelToMail.StartProgram)"
		 POPUPMASTER="Izmjeni:UPDATEFORM#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ#Stornoraj:STORNO#Pronađi:FILTERFORM"
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' # select '305' as sifradok "
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 
				'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end "
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 REPORT="">



	<NAME>Povratnica robe dobavljaču iz MP </NAME>
	<CAPTION>Povratnica robe dobavljaču iz MP </CAPTION>


	<DETAILCOLUMNS>
		<COLUMN INDEX="" NAME="kol.ulaz1200" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="" />
	</DETAILCOLUMNS>


	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas', @sifradok = @@sifradok " />
	<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @sifradok = @@sifradok " />
	<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @sifradok = @@sifradok " />
	<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = @@sifradok " />
	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = @@sifradok " />



	<INSERTFORM
		NAME="INSERTFORM" HEIGHT="3500" WIDTH="12000"
		CAPTION="Unos povrata dobavljaču"
		ONSUBMIT=""
		ONLOAD="select convert(varchar,getdate(),112) as datumdok"
		NEXTFORM="UPDATE_FORM"
		FOCUS="datumdok">

		<INPUT TYPE="frame"  NAME="fr1"  CAPTION="Zaglavlje:" TOP="28" LEFT="56" WIDTH="11500" HEIGHT="2200" STYLE="1" DOCK="1" />
		<INPUT TYPE="frame"  NAME="fr3"  CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />

		<INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*"     TOP="400" LEFT="1500" WIDTH="1500"  />
		<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="400"  LEFT="8200" WIDTH="3500"  ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"
			   ONLOSTFOCUS="select 'refresh' as orgshemaid, 'refresh' as osobeid"/>
		<INPUT TYPE="combo"  NAME="vrstadokid"  CAPTION="Vrsta dokumenta*" TOP="750" LEFT="1500" SQL="spMPDajVrstadok @sifra = '305'" ENABLED="FALSE"  />
		<INPUT TYPE="combo"  NAME="osobeid"		CAPTION="Odgovorna osoba*"  TOP="750"  LEFT="8200" SQL="spMPDajosobe @trgovinaid = @@trgovinaid"  WIDTH="3500"/>
		<INPUT TYPE="search" NAME="partneriid"  CAPTION="Partner*"   TOP="1100"  LEFT="1500" WIDTH="5600" SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#sifra#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
		<INPUT TYPE="combo"  NAME="orgshemaid"  CAPTION=""  TOP="-3854"  LEFT="1500" SQL="select orgshemaid from trgovina where trgovinaid = @@trgovinaid"  WIDTH="3500" ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="orgdok"    CAPTION="Zapisnik partnera*" TOP="1100" LEFT="9200" WIDTH="2500"  />
		<INPUT TYPE="text"   NAME="napomena"    CAPTION="URA/Dostav.*"       TOP="1450" LEFT="1500" WIDTH="2500"  />
		<INPUT TYPE="text"   NAME="nap2"    CAPTION="Napomena*"       TOP="1800" LEFT="1500" WIDTH="10200"  />

		<INPUT TYPE="button" NAME="ok"          CAPTION="Stavke >>"  TOP="2500" LEFT="1000" ONCLICK="spMPInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = @@sifradok ,++#Ok"  />
		<INPUT TYPE="button" NAME="cancel"      CAPTION="Odustani"  TOP="2500" LEFT="8000" ONCLICK="close"  />
	</INSERTFORM>



	<UPDATE_FORM
