		<INPUT TYPE="button" NAME="donesi" ANCHOR="9" CAPTION="Donesi" TOP="7200" LEFT="10200" WIDTH="1400" HEIGHT="322" ONCLICK=":DONESI"  />
	</UPDATE_FORM>



