		<INPUT TYPE="number" NAME="nabvrijednost" CAPTION="Nabavna vrijednost*" TOP="4400" LEFT="4592" WIDTH="1708" HEIGHT="280" ONLOSTFOCUS="spmpKalkNG @action = 11 , @robaid = @@robaid, @kolicinaulaz= @@kolicina, @fakcijena = @@fakcijena, @fakvrijednost=@@fakvrijednost, @rabatdp = @@rabatdp, @nabcijena = @@nabcijena, @nabvrijednost = @@nabvrijednost, @marza = @@marzap, @mpcijena = @@mpcijena , @mpcpov = @@mpcpov #if @@MPCZaduzenje = 1 begin select 'marzap' as focus end "  SQL=""  />
		<INPUT TYPE="number" NAME="porezp" 	  CAPTION="% PDV-a *" TOP="4750" LEFT="1372" WIDTH="672" HEIGHT="280" ENABLED ="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="pdvvrijednost" 	  CAPTION="PDV iznos*" TOP="4750" LEFT="3374" WIDTH="1344" HEIGHT="280" ENABLED ="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="mpcijena" 	  CAPTION="MP cijena*" TOP="5100" LEFT="1372" WIDTH="1540" HEIGHT="280" SQL="" ENABLED ="FALSE" />
		<INPUT TYPE="number" NAME="mpcpov" 	  CAPTION="MPC sa pov.*" TOP="5100" LEFT="4020" WIDTH="1540" HEIGHT="280" ENABLED ="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="mpvrijednost" 	  CAPTION="MP iznos*" TOP="5100" LEFT="7050" WIDTH="1680" HEIGHT="280" SQL=""  ENABLED ="FALSE"/>
		<INPUT TYPE="check" NAME="kalkmpc"	  CAPTION="Kalkulacija cijene*" TABINDEX="-1" TOP="3350" LEFT="3500" WIDTH="1596" ENABLED="TRUE" SQL=""  
				ONCLICK="if @@kalkmpc = 1 begin select'enable' as fakcijena,'enable' as fakvrijednost,'enable' as rabatdp,'enable' as nabcijena,'enable' as nabvrijednost end # if @@kalkmpc = 0 begin select'disable' as fakcijena,'disable' as fakvrijednost,'disable' as rabatdp,'disable' as nabcijena,'disable' as nabvrijednost end "/>
		
		<INPUT TYPE="combo"  NAME="razlogpovrataid "      CAPTION="Razlog povrata*" TOP="5450" LEFT="1372" WIDTH="4500" HEIGHT="280" ALLOWEMPTY="FALSE" 
			SQL="spmpRazlogPovrata @action = 111"  ONLOSTFOCUS=""  />
			
		<INPUT TYPE="date"   NAME="rokTrajanja"    CAPTION="Rok trajanja*"     TOP="5450"  LEFT="8000"   />
		<INPUT TYPE="check"   NAME="checkTrajanje"    CAPTION=""     TOP="5500"  LEFT="9450" ONCLICK="if @@checkTrajanje = 1 select 'enable' as rokTrajanja else select 'disable' as rokTrajanja#select 'refresh' as rokTrajanja"  />

		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dodaj (F8)" TOP="5450" LEFT="10200" WIDTH="1428" HEIGHT="322"
			   ONCLICK="spMPInsertGlaIdetNG @action=3,@status = 1, @robaid=@@robaid,@id=@@id,@NabCijena=@@nabcijena, @fakcijena = @@fakcijena, @rabatdp = @@rabatdp, @fakvrijednost = @@fakvrijednost, @kolicinaulaz=@@kolicina, @mpcijena=@@mpcijena, @porukagreska = 1, @rokTrajanja = '@@rokTrajanja', @razlogpovrataid = @@razlogpovrataid, @checkTrajanje = @@checkTrajanje
					#select cmpiznos , nabiznos from maloprodajagla where maloprodajaglaid = @@id
					#select '' as roba , 'robaid' as focus, razlogpovrataid= 0, robaid = null, kolicina = 0, nabcijena = 0, fakcijena = 0 , mpcijena = 0, sktstanje = 0, fakvrijednost=0, rabatdp=0, rabati=0, nabvrijednost=0, porezp=0, pdvvrijednost=0,mpvrijednost=0, mpcpov = 0, indpak=0, kolpakovanje=0, 'refreshmovelast' as stavke 
					#select 0 as kalkmpc #select'disable' as fakcijena,'disable' as fakvrijednost,'disable' as rabatdp,'disable' as nabcijena,'disable' as nabvrijednost" HOTKEY="F8" />

