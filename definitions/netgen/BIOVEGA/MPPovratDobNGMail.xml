			   CAPTION="Stavke"
			   TOP="6350" LEFT="100" WIDTH="10000" HEIGHT="1500"
			   TABINDEX="-1"
			   AFTERREFRESH="select cmpiznos,nabiznos from maloprodajagla where maloprodajaglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU"
			   EDITCOLUMNS="kol.ulaz"
			   ONCELLEDITED="spMPInsertGlaIdetNG @action=4, @maloprodajadetid = @@stavke, @id = @@id, @kolicinaulaz = @(stavke..kol.ulaz)#select 'stavke' as focus #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER="Povratnica dobavljaču br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@tkosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id" />

		<INPUT TYPE="number" NAME="nabiznos" ANCHOR="6" CAPTION="Ukupna Nab.Vrijed.*" TOP="9600" LEFT="5000" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="number" NAME="cmpiznos" ANCHOR="6" CAPTION="Ukupna MP Vrijed.*" TOP="9600" LEFT="9000" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>

		<INPUT TYPE="button" NAME="ok" ANCHOR="6" CAPTION="Spremi (F2)" TOP="9600" LEFT="196" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = @@sifradok, @status = 1, @datumdok= @@datumdok, @napomena = '@@napomena', @nap2 = '@@nap2',@osobeid = @@osobeid, @partneriid = @@partneriid, @orgdok = '@@orgdok'#Ok"  />
		<INPUT TYPE="button" NAME="cancel" ANCHOR="6" CAPTION="Odustani" TOP="9600" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

