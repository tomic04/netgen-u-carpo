		<INPUT TYPE="frame"  NAME="fr3"           CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />

		<INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*"     TOP="400"  LEFT="1500"   />
		<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="400"  LEFT="8200" ENABLED="FALSE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"  WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="broj"        CAPTION="_Broj*"     TOP="750"  LEFT="1500" ENABLED="FALSE" WIDTH="3500" SQL=""  />
		<INPUT TYPE="combo"  NAME="osobeid"		CAPTION="Odgovorna osoba*"  TOP="750"  LEFT="8200" SQL="spMPDajosobe @trgovinaid = @@trgovinaid"  WIDTH="3500"/>
		<INPUT TYPE="combo"  NAME="vrstadokid"  CAPTION="Vrsta dokumenta*" TOP="1100" LEFT="1500" SQL="spMPDajVrstadok @sifra = '305'" ENABLED="FALSE"  />
		<INPUT TYPE="search" NAME="partneriid"  CAPTION="Partner*"   TOP="1450"  LEFT="1500" SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#sifra#!adresa" WIDTH="5600" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
		<INPUT TYPE="text"   NAME="orgdok"    CAPTION="Zapisnik partnera*" TOP="1450" LEFT="9200" WIDTH="2500"  />
		<INPUT TYPE="text"   NAME="napomena"    CAPTION="URA/Dostav.*"       TOP="1800" LEFT="1500" WIDTH="2500"  />
		<INPUT TYPE="text"   NAME="nap2"    CAPTION="Napomena*"       TOP="2150" LEFT="1500" WIDTH="10200"  />

		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="3000" LEFT="1372" WIDTH="8000"  ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'"
				ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid, @TrgovinaId = @@trgovinaid
						 #if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @Skladisteid = @@skladisteid, @datum = @@datumdok,@partneriid = null, @vrstadokid = @@vrstadokid, @sifradok = '305' end
						 
						 #select 'kolicina' as focus#if coalesce(@@indpak,0)=0 begin select 0 as kolicina end" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
