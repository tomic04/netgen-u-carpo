			exec spRaiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
			end	else begin
			if @@id = 0  begin 
			exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos;
			end else begin 
			exec spMPQueryGlaIDetNG @action=3 ,@ID=@@ID, @operateriid = @@operateriid end end" 
		ONLOAD2="select'disable' as fakcijena,'disable' as fakvrijednost,'disable' as rabatdp,'disable' as nabcijena,'disable' as nabvrijednost"
