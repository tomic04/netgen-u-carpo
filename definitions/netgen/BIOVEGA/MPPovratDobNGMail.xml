		<INPUT TYPE="number"   NAME="kolpakovanje"    CAPTION=""       TOP="-1610" LEFT="8000" WIDTH="1500"  />
		<INPUT TYPE="text"   NAME="jmnaziv"	  CAPTION="JM*" TOP="3000" LEFT="10200" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
