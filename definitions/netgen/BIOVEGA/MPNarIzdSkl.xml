				exec spRaiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spRaiserror 69001, &apos;Niste odabrali dokumant! &apos;
				end 
				else begin 
				if (select maloprodajaglaid from wms_exchange where maloprodajaglaid=@@id) is not null and exists (select  top 1 varset from dbo.PubVars where VarIme = 'WMS' and VarSet = '1') begin
					exec spRaiserror 69001, &apos;Dokument je poslan u WMS nemože se mijenjati! &apos;
				
		end
				else begin 
					exec spMPQueryGlaIDetNG @action=3 ,@ID=@@ID, @operateriid = @@operateriid
