	<KOPIRAJ
		 
	FILLEXPLORER=""
	WIDTH="8800"
	ONSUBMIT=""
	ONLOAD="if @@id = 0 begin 
				exec spRaiserror 69001, &apos;Niste odabrali dokument! &apos;
			end
			else begin 
				select maloprodajaglaid , g.trgovinaid, g.broj as brojdok , s.opis as skladiste, datumdok as datum 
				from maloprodajagla g inner join skladiste s on g.skladisteid =s.skladisteid where g.maloprodajaglaid = @@id  
			end "
	HEIGHT="4500"
	FOCUS="povezinar"
	CAPTION="Kopiranje dukmenta u novi dokument  ">

		<INPUT TYPE="text"     NAME="Brojdok" CAPTION="Broj dukumenta*"  TOP="600" LEFT="1500" SQL="" VISIBLE="TRUE" ENABLED="FALSE" STYLE="1" />
		<INPUT TYPE="datetiem"     NAME="datum" CAPTION="Datum dukumenta*"  TOP="1000" LEFT="1500" SQL="" VISIBLE="TRUE" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="text"     NAME="skladiste" CAPTION="Skladište*"  TOP="1400" LEFT="1500" SQL="" VISIBLE="TRUE" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="combo"     NAME="trgovinaid" CAPTION="Sa trgovine*"  TOP="1800" LEFT="1500" ENABLED="FALSE" STYLE="1" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid" />

		<INPUT TYPE="combo"     NAME="trgovina2id" CAPTION="Na trgovina*"  TOP="2600" LEFT="1500" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid" />
		<INPUT TYPE="datetime"     NAME="datumdok" CAPTION="Na datum*"  TOP="3000" LEFT="1500" SQL="" />


		<INPUT TYPE="button" NAME="ok"     CAPTION="Kopiraj"  TOP="1500" LEFT="7000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="exec spmpkopirajDokMp @action = 1 , @id = @@id, @trgovinaid = @@trgovina2id , @datumdok = @@datumdok , @operateriid = @@operateriid#OK"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2500" LEFT="7000" WIDTH="1106" HEIGHT="322" ONCLICK="OK"  />
	</KOPIRAJ>




