		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7840" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="ispravi" CAPTION="Ispravi" TOP="7840" LEFT="2688" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
