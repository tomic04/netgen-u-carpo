		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION="Dodaj:INSERTFORM"
		 CMD3CAPTION="Izmjeni:UPDATE_FORM" 
		 CMD4CAPTION="Zaključi:ZAKLJUCI" 
		 CMD5CAPTION="Storno:STORNO" 		
		 CMD6CAPTION="Kopiraj:KOPIRAJ" 
		 CMD7CAPTION="Print dok.:ISPIS_FORM"
