				#select 'disable' as pak		
			   #select faktor from  jmroba where robaid=@@robaid and defaultind=1
						#if coalesce(@@faktor,0)=0 begin select 'disable' as pak end else begin select 'enable' as pak end
			   #exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid, @mpcijena = @@mpcijena, @indmpc = 1,  @asortimanMP=1, @trgovinaid = @@trgovinaid
