<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpRazlogStorna @action = 0" 
   CMD1CAPTION=""
   CMD2CAPTION="Dodaj:INSERTFORM" 
   CMD3CAPTION="Izmjeni:UPDATEFORM"
   CMD4CAPTION="" 
   CMD5CAPTION=""
   CMD6CAPTION=""
   DETAILGRID = "" 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK=""
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Ažuriranje razloga storna računa</NAME>
  <CAPTION>Ažuriranje razloga storna računa</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>




  <INSERTFORM
		WIDTH="8000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="3500"
    CAPTION="Unos podatka"
		FOCUS="Opis"
		>

    <INPUT TYPE="text" CAPTION="Razlog storna računa*" NAME="opis" SQL="" TABINDEX="1" LEFT="1800" TOP="1000" WIDTH="3300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" 
           ONCLICK="spmpRazlogStorna @action=1, @opis = '@@opis' #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </INSERTFORM>
	

  <UPDATEFORM 
        WIDTH="8000" 
        ONSUBMIT="" 
        ONLOAD="select * from MPrazlogStorna where MPrazlogStornaId = @@id" 
        FOCUS="OPis"
        HEIGHT="3500" 
        CAPTION="Izmjena podatka"  
		
		>

    <INPUT TYPE="text" CAPTION="Razlog storna računa*" NAME="opis" SQL="" TABINDEX="1" LEFT="1800" TOP="1000" WIDTH="3300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="check" CAPTION="Aktivvno" NAME="status" SQL="" TABINDEX="1" LEFT="1800" TOP="1500" WIDTH="3300" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXlenght="2"/>
    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="500" WIDTH="1106" HEIGHT="322"
           ONCLICK="spmpRazlogStorna @action=2, @Id =  @@id,  @opis = '@@opis' , @status = @@status #Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </UPDATEFORM>



</PROJECT>
 
