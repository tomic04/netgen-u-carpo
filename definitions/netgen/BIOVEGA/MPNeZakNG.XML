<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT="" 	
    DETAILGRID = "spMPPregNeZakNGNEW @action=2, @id = @@id"
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="Osvježi:OBNOVI" 
		CMD6CAPTION=""  
		DBLCLICKFORM="PROMET"
    PAGEHEADERLEFT="Od @@datumod do @@datumdo"
    PAGEHEADERRIGHT="@@tkosmomi"
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Pregled nezaklj. dokumenata MP NG</NAME>
  <CAPTION>Pregled nezaklj. dokumenata MP NG</CAPTION>


<FILTER_FORM
    NAME="FILTER_FORM"
    CAPTION="Parametri" 
    FILLEXPLORER="TRUE" 
		WIDTH="9000" 
    HEIGHT="3500" 
		ONSUBMIT="spMPPregNeZakNGnew @action=1, @operateriid = @@operateriid," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstadokid as vrstadokid" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" > 
		
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="true" 
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" DEFAULT="firstdayofmonth"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" DEFAULT="today"/>
    <INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta dokumenta" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
                 SQL="spMPDajVrstadok null"/>
										
</FILTER_FORM>
  
<PROMET 	
    FILLEXPLORER="TRUE" 
		WIDTH="14000"
    HEIGHT="7500"
		ONSUBMIT="" 
		ONLOAD="" 
		CAPTION="Stavke prometa" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" > 
		
    <INPUT TYPE="grid" 
          NAME="stavke" 
          TOP="200" LEFT="200" WIDTH="12000" HEIGHT="6000"
          REFRESHAFTERCHILD="TRUE" 
          CAPTION="_ay" 
          SQL="spMPPregNeZakNGnew @action=2,@id = '@@id'" /> 

</PROMET>		

<OBNOVI
		WIDTH="5500" 
		ONSUBMIT="spMPPregNeZakNGnew @action=1, @operateriid = @@operateriid" 
		ONLOAD="spMPPregNeZakNGnew @action = 3, @id=@@id"		
		HEIGHT="3200" 
		CAPTION="" 
		CMD1CAPTION=""         
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

</OBNOVI> 

</PROJECT> 