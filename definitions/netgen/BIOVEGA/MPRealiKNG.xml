<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Po Klasi:KLASE" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""
		MULTIGRIDLAYOUT="TRUE"
		MASTERDBLCLICK="PROMET"
	  POPUP=""
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @trazi ='' ">> 
 

  <NAME>Realizacija u MP kumulativno</NAME>
  <CAPTION>Realizacija u MP kumulativno</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spMPRealizacijaKum @action=1, @operateriid = @@operateriid, @nenc = @@nenc, " 
		ONLOAD="select @@trgovinaid as trgovinaid, @@datumod as datumod, @@datumdo as datumdo, @@vrstadokid as vrstadokid " 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CHILDFORM="">

    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="1000" LEFT="1500"
               SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t 
                    inner join trgovineprava p on t.trgovinaid = p.trgovinaid where p.operaterid = @@operateriid"/>
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" DEFAULT="firstdayofyear" HEIGHT="320" WIDTH="1500" TOP="1500" LEFT="1500"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" DEFAULT="today" HEIGHT="320" WIDTH="1500" TOP="2000" LEFT="1500" />
	  <INPUT TYPE="check" NAME="podatumu" CAPTION="Kumulativ po datumu*" HEIGHT="320" WIDTH="2500"  TOP="2500" LEFT="1500" />
	  <INPUT TYPE="check" NAME="roba" CAPTION="Kumulativ po robi*" HEIGHT="320" WIDTH="2500"  TOP="2900" LEFT="1500" />
	  <INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta dokumenta*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true" TOP="3300" LEFT="1500"
               SQL="spmpdajvrstadokmoze @action = 2"/>

  </FORM1>

	<KLASE FILLEXPLORER="TRUE" 
		  WIDTH="10000" 
		  STORA=""
		  STARTUPSTORA="" 
		  HEIGHT="7500" 
		  CAPTION="Parametri" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="" 
		  CMD2CAPTION="Povratak" 
		  CMD3CAPTION="Stavke:STAVKE" 
		  CHILDFORM="">

    <INPUT TYPE="grid" 
				  NAME="stavke" 
				  REFRESHAFTERCHILD="TRUE" 
				  LEFT="100"
				  CAPTION="" 
				  WIDTH="9500" 
				  HEIGHT="6300" 
				  TABINDEX="5" 
	  SQL="spMPRealizacijaKum @action=2, @operateriid = @@operateriid,@id = '@@id'" />


	</KLASE>

	<STAVKE FILLEXPLORER="TRUE" 
		  WIDTH="12000" 
		  STORA=""
		  STARTUPSTORA="" 
		  HEIGHT="7500" 
		  CAPTION="Parametri" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Stavke" 
		  CMD2CAPTION="Povratak" 
		  CMD3CAPTION="" 
		  CHILDFORM="">

    <INPUT TYPE="grid" 
				  NAME="stavke" 
				  REFRESHAFTERCHILD="TRUE" 
				  LEFT="100"
				  CAPTION="" 
				  WIDTH="11500" 
				  HEIGHT="6300" 
				  TABINDEX="5" 
	  SQL="spMPRealizacijaKum @action=3, @operateriid = @@operateriid,@id = '@@STAVKE'" />

	</STAVKE>

</PROJECT> 