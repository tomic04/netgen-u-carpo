<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
		CMD1CAPTION="Parametri:FILTERFORM" 
		  CMD2CAPTION="Donos:DONOS"
		 CMD3CAPTION="Izmjena:IZMJENI" 
		  CMD4CAPTION="Briši:BRISI" 
		  CMD5CAPTION="Proknjiži:ZAKLJUCI" 
		  CMD6CAPTION=""
		 CMD7CAPTION="" 
		  CMD8CAPTION="" 
		  POPUPMASTER="" 
		  MASTERDBLCLICK=""
		 GROUPBYBOXVISIBLE="TRUE" 
		  ONLOAD=":FILTERFORM" 
		  FROZENCOLUMNS="0" 
		  AUTOFITCOLUMNS="False"
		 SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"
		 REPORT="">
	
	
<NAME>Donos robe s ručnog terminala </NAME>
<CAPTION>Donos robe s ručnog terminala</CAPTION>
<KOMENTAR>Callisto 1.7.16</KOMENTAR>

	<FILTERFORM NAME="FILTERFORM" HEIGHT="2506" WIDTH="6926" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Pokaži donesene podatke s ručnog terminala " BORDERSTYLE="3" 
	   ONSUBMIT="spMPPrijenosTerminalNG @action=3, @operateriid = @@operateriid, @nenc = @@nenc, "
		 ONLOAD="" CANCELONSUBMIT="" FILLEXPLORER="TRUE" NEXTFORM=""
		 CMD1CAPTION="Pokaži" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" CHILDFORM="">
	<INPUT TYPE="combo" NAME="trgovinaid" TOP="230" LEFT="1152"
		 HEIGHT="302" WIDTH="5501" VISIBLE="TRUE" TEXT=""
		 SQL="spMPDajTrgovina @operateriid = @@operateriid" ALLOWEMPTY="false" REFRESHAFTERCHILD="TRUE" CAPTION="Trgovina"
		 TABINDEX="1" ENABLED="TRUE"/>

	<INPUT TYPE="label" NAME="Label9" TOP="230" LEFT="230"
		 HEIGHT="288" WIDTH="778" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Trgovina:" ENABLED="TRUE"/>

	<INPUT TYPE="date" NAME="datumod" TOP="806" LEFT="1152"
		 HEIGHT="302" WIDTH="1498" VISIBLE="TRUE" VALUE="DATE"
		 TABINDEX="2" CAPTION="Datum od :" ENABLED="TRUE" CHECKBOX="FALSE" ALLOWEMPTY="false"
		/>

	<INPUT TYPE="label" NAME="Label10" TOP="806" LEFT="230"
		 HEIGHT="288" WIDTH="634" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Datum:" ENABLED="TRUE"/>


</FILTERFORM>

<ZAKLJUCI NAME="ZAKLJUCI" HEIGHT="3528" WIDTH="7046" TEXT=""
		 REFRESHAFTERCHILD="TRUE" 
		 CAPTION="Želite li napraviti dokument ?? " 
		  BORDERSTYLE="3" 
		  ONSUBMIT="spMPPrijenosTerminalNG @action=2, @trgovinaid = @@trgovinaid, @datumod = @@datumod, @operateriid = @@operateriid, "
		 ONLOAD="select napomena1 = case when exists (select * from PTPrijenos where OperateriId = @@operateriid AND trgovinaid = @@trgovinaid AND ind = &apos;1&apos; and robaid IS NULL) then &apos;Imate nepovezanih artikala. Nepovezani artikli neće se proknjižiti u dokument. Jeste li sigurni da želite napraviti dokument?&apos; else &apos;Svi artikli su prepoznati, dokument će biti kreiran!&apos; end" CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="Napravi" CMD2CAPTION="Odustrani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" REPORT="" MASTERDBLCLICK=""
		>
	<INPUT TYPE="label" NAME="napomena1" TOP="115" LEFT="115"
		 HEIGHT="1786" WIDTH="3701" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Label49" ENABLED="TRUE"/>

	<INPUT TYPE="text" NAME="napomena" TOP="1055" LEFT="800"
		 HEIGHT="1786" WIDTH="4701" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Napomena:*" ENABLED="TRUE"/>

	<INPUT TYPE="VB.CheckBox" NAME="cbVise" TOP="2030" LEFT="115"
		 HEIGHT="288" WIDTH="3614" VISIBLE="TRUE" VALUE=""
		 CAPTION="Za svaki prijenos napravi poseban dokument" TABINDEX="" ENABLED="TRUE" TEXT="CheckBoxTG1"
		/>


</ZAKLJUCI>

<IZMJENI NAME="IZMJENI" HEIGHT="3902" WIDTH="7085" TEXT=""
		 REFRESHAFTERCHILD="" CAPTION="Izmjeni" BORDERSTYLE="3" 
		 ONSUBMIT=""
		 ONLOAD="select barcode, robaid from ptprijenos where PTPrijenosId=@@id" CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="" CMD2CAPTION="" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="">

	<INPUT TYPE="text" NAME="Barcode" TOP="250" LEFT="2074"
		 HEIGHT="288" WIDTH="3398" VISIBLE="TRUE" BOLD="true"
		 CAPTION="Barcode*" ENABLED="FALSE"/>

	<INPUT TYPE="search" NAME="robaid" TOP="650" LEFT="2059" CAPTION="Roba*" 
		 HEIGHT="302" WIDTH="4478" VISIBLE="TRUE" TEXT=""
		 SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" 
		 TABINDEX="1" ENABLED="TRUE"  ONLOSTFOCUS="exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @datum = @@datumod #select 'focus' as ok"/>

	<INPUT TYPE="number" NAME="mpcijena" TOP="1050" LEFT="2059" CAPTION="MP cijena*" 
		 HEIGHT="302" WIDTH="1100" VISIBLE="TRUE" TEXT=""
		 SQL="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" 
		 TABINDEX="-11" ENABLED="FALSE"/>
	
	<INPUT TYPE="number" NAME="nabcijena" TOP="1450" LEFT="2059" CAPTION="Nab.cijena*" 
		 HEIGHT="302" WIDTH="1100" VISIBLE="TRUE" TEXT=""
		 SQL="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" 
		 TABINDEX="-11" ENABLED="FALSE"/>


	<INPUT TYPE="button" NAME="ok"           CAPTION="Spremi"   TOP="2800" LEFT="456" WIDTH="1106" HEIGHT="322" TABINDEX="2" 
				ONCLICK="spMPPrijenosTerminalNG @action = 4, @id = @@id, @trgovinaid = @@trgovinaid, @operateriid = @@operateriid, @robaid = @@robaid, @mpcijena = @@mpcijena, @nabcijena = @@nabcijena, @datumod = @@datumod#Ok"  HOTKEY="F2" />
	<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2800" LEFT="1756" WIDTH="1106" HEIGHT="322" TABINDEX="3" ONCLICK="close"  />



</IZMJENI>

<DONOS NAME="DONOS" HEIGHT="3506" WIDTH="6926" TEXT=""
		 REFRESHAFTERCHILD="" CAPTION="Donos podataka sa ručnog terminala" 
			BORDERSTYLE="3" ONSUBMIT="spMPPrijenosTerminalNG @action=1, @operateriid = @@operateriid, "
	ONLOAD="select top 1 datum as datumod, trgovinaid, napomena = case when (select top 1 ptprijenosid from ptprijenos where trgovinaid = 11 and datum = '20081206'
	and ind = 1 and operateriid = 7) is not null then 'Postoji neproknjiženi prijenos! Želite li donijeti novi ? ' else '' end from ptprijenos order by ptprijenosid desc"
	CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
	CMD1CAPTION="Donesi" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
	CMD5CAPTION="" CMD6CAPTION="" CHILDFORM="">


	<INPUT TYPE="label" NAME="napomena" TOP="115" LEFT="515"
	 HEIGHT="1786" WIDTH="3701" VISIBLE="TRUE" BOLD="TRUE"
	 CAPTION="Label49" ENABLED="TRUE"/>


	<INPUT TYPE="combo" NAME="trgovinaid" TOP="730" LEFT="1152"
		 HEIGHT="302" WIDTH="5501" VISIBLE="TRUE" TEXT=""
		 SQL="spMPDajTrgovina @operateriid = @@operateriid" ALLOWEMPTY="false" REFRESHAFTERCHILD="TRUE" CAPTION="Trgovina"
		 TABINDEX="1" ENABLED="TRUE"/>

	<INPUT TYPE="label" NAME="Label9" TOP="730" LEFT="230"
		 HEIGHT="288" WIDTH="778" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Trgovina:" ENABLED="TRUE"/>

	<INPUT TYPE="date" NAME="datumod" TOP="1406" LEFT="1152"
		 HEIGHT="302" WIDTH="1498" VISIBLE="TRUE" VALUE="DATE"
		 TABINDEX="2" CAPTION="Datum od :" ENABLED="TRUE" CHECKBOX="FALSE"
		/>

	<INPUT TYPE="label" NAME="Label10" TOP="1406" LEFT="230"
		 HEIGHT="288" WIDTH="634" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Datum:" ENABLED="TRUE"/>


</DONOS>
	<BRISI
	  WIDTH="5500" 
	  ONSUBMIT="spMPPrijenosTerminalNG @action = 5 , @id=@@id, @trgovinaid = @@trgovinaid, @datumod = @@datumod, " 
	  ONLOAD="select 1 as jedanart, 0 as sviart, (select rtrim(cast(userid as varchar)) + ' ' +naziv as Naziv from roba where robaid = (select robaid from ptprijenos where ptprijenosid=@@id)) as pitanje"	
	  HEIGHT="3000" 
	  CAPTION="Obrisati ?" 
	  CMD1CAPTION="Obriši"
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<INPUT TYPE="label" NAME="pitanje" TOP="200" LEFT="200" WIDTH="3500" CAPTION=""/>

		<INPUT TYPE="VB.checkbox" 
						TOP = "700"
						LEFT="200"
						NAME="jedanart" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Obrisati odabrani artikal ? (DA/NE) "/>

		<INPUT TYPE="VB.checkbox" 
						TOP = "1300"
						LEFT="200"
						NAME="sviart" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Obrisati sve artikle ? (DA/NE) "/>

	</BRISI>



</PROJECT>