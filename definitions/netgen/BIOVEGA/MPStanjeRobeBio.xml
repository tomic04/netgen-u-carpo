<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
ONLOAD=":FILTERFORM"  		
REPORT="" 	
CMD1CAPTION="Parametri:FILTERFORM" 
CMD2CAPTION="" 
CMD3CAPTION="" 
CMD4CAPTION=""
CMD5CAPTION="" 
CMD6CAPTION=""  
CMD7CAPTION="Lista"  
CMD8CAPTION=""  
MASTERDBLCLICK=""
CHECKBOXVISIBLE="FALSE"
SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"
POPUPMASTER=""
COMMANDTIMEOUT="300"> 
 

  <NAME>Pregled prometa robe po dokumentima </NAME>
  <CAPTION>Pregled prometa robe po dokumentima </CAPTION>


<FILTERFORM 
	NAME="FILTERFORM"
	HEIGHT="5000" WIDTH="8000"
	VERSION="1.2"
	CAPTION="Upišite uvjete prikaza "
	ONSUBMIT="biovega..spmpStanjeRobeOdPlan @action = 1,  "
	FILLEXPLORER="TRUE"
	NEXTFORM=""
	CMD1CAPTION="Pokaži"
	CMD2CAPTION="Odustani">
		
	<INPUT TYPE="date" NAME="datumod" CAPTION="Promet od" />
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Promet do" />
	<INPUT TYPE="combo" NAME="trgovinaid"
		ALLOWEMPTY="TRUE" CAPTION="Trgovina " ONLOSTFOCUS="select 'refresh' as skladisteid" 
		   SQL="select trgovinaid, opis from biovega..trgovina where aktivno = 1 order by 2" />
	
	<INPUT TYPE="checkbox" NAME="ukupno" CAPTION="Sumarno sve trgovine" />

</FILTERFORM>


<KARTICA 	
	FILLEXPLORER="TRUE"
	WIDTH="15000"
	ONSUBMIT=""
	ONLOAD=""
	HEIGHT="9500"
	CAPTION="Kartica robe"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION="Kraj"
	CMD3CAPTION=""
	CHILDFORM="">

	<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					SQL="spMPStanjeKarticaNG @action = 1, @robaid= @@robaid, @operateriid = @@operateriid , @totalgen=2, @trgovinaid =@@trgovinaid  "/>
</KARTICA>

</PROJECT>
