<Filter NAME="Filter" HEIGHT="3600" WIDTH="6120" CAPTION="Filter" ONSUBMIT="exec spGastroPregledRacuna @datumod = @@date_od, @datumdo = @@date_do, @ind = @@ind, @action = 0, @partneriid = @@partneriid, @parstruid = @@parstruid--" 
        ONLOAD="if (Select rtrim(VarSet) from PubVars where VarIme='FaktureKnjizenje') = 'Biovega' begin select @@date_od as date_od, @@date_do as date_do, 4708 as partneriid, Kupac='BIO-ZRNO d.o.o.', 8171 as ParStruId, Loko='Zrno Bio Bistro'
                end else begin select @@date_od as date_od, @@date_do as date_do end"
        FILLEXPLORER="true" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3" DBCLIPBOARD="FALSE">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="72" HEIGHT="2376" WIDTH="5760" TEXT="FrameNG0" ANCHOR="13"/>
	<INPUT TYPE="search" NAME="partneriid" TOP="432" LEFT="1656" HEIGHT="302" WIDTH="3960" SQL="spTraziPartneri @action = &apos;Partneri&apos;, @uvjet = &apos;@@searchboxpartneriid&apos;" CAPTION="Kupac" TABINDEX="10" ANCHOR="13"/>
	<INPUT TYPE="label" NAME="LblPartner" TOP="432" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Partner:" TEXT="Label17"/>
	<INPUT TYPE="search" NAME="ParStruId" TOP="792" LEFT="1656" HEIGHT="302" WIDTH="3960" SQL="spTraziParStru @action = &apos;Parstru&apos;, @uvjet = &apos;@@searchboxParStruId&apos;, @partneriid = @@partneriid" TABINDEX="15" CAPTION="Loko"/>
	<INPUT TYPE="label" NAME="Label24" TOP="792" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Lokacija:"/>
	<INPUT TYPE="date" NAME="date_od" TOP="1152" LEFT="1656" HEIGHT="302" WIDTH="1728" TABINDEX="20"/>
	<INPUT TYPE="label" NAME="LblDatumOd" TOP="1152" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Datum od:" TEXT="Label14"/>
	<INPUT TYPE="date" NAME="date_do" TOP="1512" LEFT="1656" HEIGHT="302" WIDTH="1728" TABINDEX="30"/>
	<INPUT TYPE="label" NAME="LblDatumDo" TOP="1512" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Datum do:" TEXT="Label15"/>
	<INPUT TYPE="combo" NAME="ind" TOP="1872" LEFT="1656" HEIGHT="302" WIDTH="1742" SQL="select 0 as ind, &apos;prikaži samo neuspjele&apos;
union all
select 1 as ind, &apos;prikaži samo uspjele&apos;" ALLOWEMPTY="true" TABINDEX="40"/>
	<INPUT TYPE="label" NAME="LblStatus" TOP="1872" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Status:" TEXT="Label16"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="2592" LEFT="72" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" TABINDEX="50" ENABLED="TRUE" ONCLICK="OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2592" LEFT="1296" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" TABINDEX="60" ENABLED="TRUE" ONCLICK="CLOSE"/>

</Filter>

