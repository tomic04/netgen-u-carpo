<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	ONLOAD="spMPRobaBiovega @action=1" 
	TREE="" 
	DETAILGRID="spMPRobaBiovega @action=2, @robaid=@@robaid"
	FILLEXPLORER="" 
	BUTTONS="Dodaj:DODAJFORM#Izmjeni:IZMJENIFORM#Obriši:DELETEFORM"
	CMD1CAPTION=""    
	CMD2CAPTION="" 
	CMD6CAPTION=""
	CMD4CAPTION=""
	CMD3CAPTION=""
	CMD5CAPTION=""
	EDITCOLUMNS=""
	ONCELLEDITED=""
	EDITCOLUMNSDET=""
	COMMANDTIMEOUT="300"
	ONCELLEDITEDDET=""
	CHECKBOXVISIBLE="TRUE"
	TOTALROWVISIBLE="FALSE"
	POPUPMASTER=""
	TOTALROW="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
	DETTOTALROWVISIBLE="FALSE"
	MASTERDBLCLICK="">

	<NAME>Mapiranje robe u Biovegi </NAME>
	<CAPTION>Mapiranje robe u Biovegi  </CAPTION>
 
	<KOMENTAR>HD 59562</KOMENTAR>
	<AUTOR> MT 01.04.2021.  </AUTOR>

	<DETAILCOLUMNS CLEARCOLUMS="" HEADERALIGNMENT="2">
		<COLUMN INDEX="" NAME="Količina1200" WIDTH="" CAPTION="" FORMAT="#,##0.0000" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	</DETAILCOLUMNS>

	<DODAJFORM 
		WIDTH="8000" 
		ONSUBMIT="" 
		VERSION="1"
		ONLOAD="select null as robaid, null as robabiovegaid , null as jmid, 1 as koeficijent" 
		HEIGHT="4000" 
		CAPTION="Unos novog artikla"  
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		FILLEXPLORER="" 
		>
		<INPUT TYPE="search" NAME="robaid" CAPTION="Roba (F5)*" TOP="532" WIDTH="4998" TABINDEX="1" COLUMNWIDTH="" 
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaBiovega @action=8, @trazi = '@@searchboxrobaid'" 
							ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>

		<INPUT TYPE="search" NAME="robabiovegaid" CAPTION="Roba u Biovega(F6)*" TOP="1000" WIDTH="4998" TABINDEX="1" COLUMNWIDTH="" 
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaBiovega @action=9, @trazi = '@@searchboxrobabiovegaid'" 
							ONLOSTFOCUS="select 'refresh' as jmid"
							BACKCOLOR="LIGHTYELLOW" HOTKEY="F6"/>

		<INPUT TYPE="combo" CAPTION="Jedinica mjere Biovega:" NAME="jmid" ALLOWEMPTY="FALSE" SQL="SELECT jmId,Naziv FROM biovega..jm where jmid=(select jmid from biovega..roba where robaid=@@robabiovegaid)" TABINDEX="3"  WIDTH="4500" HEIGHT="320" />        
		<INPUT TYPE="number" NAME="koeficijent" CAPTION="Faktor konverzije" TEXT="1" WIDTH="1600" HEIGHT="800" TABINDEX="4" DECIMALS="4" />
		
		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="3000" LEFT="396" WIDTH="1106" HEIGHT="322" TABINDEX="5"   
			   ONCLICK="if @@robaid is null begin exec spRaiserror 69001, 'Niste odabrali robu!!' end
						#if @@robabiovegaid is null begin exec spRaiserror 69001, 'Niste odabrali robu u Biovega!!' end
						#exec spMPRobaBiovega @action=3, @robaid  = @@robaid, @robabiovegaid = @@robabiovegaid, @jmid = @@jmid, @koeficijent = @@koeficijent #OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" TABINDEX="6"   ONCLICK="close"  />

	</DODAJFORM>


	<IZMJENIFORM
		WIDTH="8000"
		ONSUBMIT=""
		VERSION="1"
		ONLOAD="spMPRobaBiovega @action=6, @RobaId=@@RobaId, @RobaBiovegaId=@@RobaBiovegaId"
		HEIGHT="4000"
		CAPTION="Izmjena artikla"
		CMD1CAPTION=""
		CMD2CAPTION=""
		FILLEXPLORER=""
		>
		<INPUT TYPE="TEXT" NAME="Naziv" 			CAPTION="Roba*" TOP="532" WIDTH="4998" TABINDEX="1" COLUMNWIDTH="" ENABLED="FALSE"
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaBiovega @action=8, @trazi = '@@searchboxrobaid'"
							BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="TEXT" NAME="BiovegaNaziv" CAPTION="Roba u Biovega*" TOP="1000" WIDTH="4998" TABINDEX="2" COLUMNWIDTH="" ENABLED="FALSE"
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaBiovega @action=9, @trazi = '@@searchboxrobabiovegaid'" 
							BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="combo" CAPTION="Jedinica mjere Biovega" NAME="jmid" ALLOWEMPTY="FALSE" SQL="SELECT jmId,Naziv FROM biovega..jm" TABINDEX="3"  WIDTH="4500" HEIGHT="320" />        
		<INPUT TYPE="number" NAME="koeficijent" CAPTION="     Faktor konverzije" TEXT="1" WIDTH="1600" HEIGHT="800" TABINDEX="4" DECIMALS="4" />
		
							
		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="3000" LEFT="396" WIDTH="1106" HEIGHT="322" TABINDEX="5"
			   ONCLICK="exec spMPRobaBiovega @action=4, @robaid  = @@robaid, @robabiovegaid = @@robabiovegaid, @jmid = @@jmid, @koeficijent = @@koeficijent  
						#OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" TABINDEX="6"   ONCLICK="close"  />

	</IZMJENIFORM>





	<DELETEFORM
                 WIDTH="6000" 
                 ONSUBMIT="" 
                 ONLOAD="spMPRobaBiovega @action=6, @RobaId=@@RobaId, @RobaBiovegaId=@@RobaBiovegaId" 
                 HEIGHT="5200" 
                 CAPTION="Želite li obrisati odabrani artikl? "  
                 CMD1CAPTION="" 
                 CMD2CAPTION="" 
		 		 FILLEXPLORER="" 

		 >

    <INPUT TYPE="TEXT" NAME="Naziv" 			CAPTION="Roba*" TOP="532" LEFT="1790" WIDTH="4998" TABINDEX="1" COLUMNWIDTH="" ENABLED="FALSE"
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG  @trazi = '@@searchboxrobaid'"
							BACKCOLOR="LIGHTYELLOW" />

    <INPUT TYPE="TEXT" NAME="BiovegaNaziv" CAPTION="Roba u Biovega*" TOP="1000" LEFT="1790" WIDTH="4998" TABINDEX="2" COLUMNWIDTH="" ENABLED="FALSE"
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaBiovega @action=9, @trazi = '@@searchboxrobabiovegaid'"
							BACKCOLOR="LIGHTYELLOW" />

    <INPUT TYPE="combo" CAPTION="Jedinica mjere:" NAME="jmid" ALLOWEMPTY="FALSE" SQL="SELECT jmId,Naziv FROM biovega..jm" TABINDEX="3"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>
    <INPUT TYPE="number" NAME="koeficijent" CAPTION="Faktor konverzije" TEXT="1" WIDTH="1600" HEIGHT="800" TABINDEX="4" DECIMALS="4" ENABLED="FALSE"/>

    <INPUT TYPE="button" NAME="ok" CAPTION="Obriši" TABINDEX="2" TOP="4000" LEFT="396" WIDTH="1106" HEIGHT="322" ONCLICK="exec spMPRobaBiovega @action=5, @robaid  = @@robaid, @robabiovegaid = @@robabiovegaid#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DELETEFORM>
	

</PROJECT>
 
