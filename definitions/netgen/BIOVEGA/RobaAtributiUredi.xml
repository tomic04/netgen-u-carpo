				 NEXTFORM="AZURFORM"
				 CMD2CAPTION="" 
                 ONSUBMIT="" 
                 ONLOAD="spRobaAtributiAzur @action = 2 , @robaid = @@id" 
				 FILLEXPLORER="" 
				 >

		<INPUT TYPE="frame"  NAME="fr2"         CAPTION="Posebni atributi" TOP="4600"   LEFT="56"   WIDTH="4600" HEIGHT="3700"   />
		<INPUT TYPE="frame"  NAME="fr3"         CAPTION="Nutritivne vrijednosti" TOP="4600"   LEFT="4850"   WIDTH="5000" HEIGHT="3700"   />
		<INPUT TYPE="frame"  NAME="fr4"         CAPTION="Uvjeti za čuvanje" TOP="4600"   LEFT="10000"   WIDTH="4600" HEIGHT="3700"   />

		<INPUT TYPE="text" CAPTION="Roba:*" NAME="sifra" TOP="250" LEFT="1500" WIDTH="1200" HEIGHT="320" ENABLED="FALSE" STYLE="1" SIZE="11"/>
		<INPUT TYPE="text" CAPTION="" NAME="robanaziv" TOP="250" LEFT="3000" WIDTH="5700" HEIGHT="320" ENABLED="FALSE" STYLE="1" SIZE="11"/>
		<INPUT TYPE="text" CAPTION="Jedinica mjere:*" NAME="robajm" TOP="250" LEFT="10000"  SQL="" WIDTH="800" HEIGHT="320" ENABLED="FALSE" STYLE="1" SIZE="11"/>
		<INPUT TYPE="text" CAPTION="MPC:*" NAME="MPC" TOP="250" LEFT="12000"  SQL="" WIDTH="800" HEIGHT="320" ENABLED="FALSE" STYLE="1" SIZE="11"/>
		<INPUT TYPE="text" CAPTION="Naziv za Web:*" NAME="webnaziv" TOP="700" LEFT="1500" WIDTH="5000" HEIGHT="320" ENABLED="TRUE" MAXLENGTH="100"/>
		<INPUT TYPE="combo" CAPTION="JM:*" NAME="webJmId" TOP="700" LEFT="11000"   WIDTH="800" HEIGHT="320" ALLOWEMPTY="TRUE" ENABLED="TRUE" SQL="select jmid, naziv from jm order by naziv"/>
		<INPUT TYPE="number" CAPTION="Težina :*" NAME="RobaTezina" TOP="700" LEFT="13000"  SQL="" WIDTH="800" HEIGHT="320" ENABLED="TRUE" DECIMALS="4"/>
		<INPUT TYPE="number" CAPTION="Vrijednost količinska*" NAME="kolvrijednost" TOP="700" LEFT="9500"  SQL="" WIDTH="800" HEIGHT="320" ENABLED="TRUE" DECIMALS="4"/>
		<INPUT TYPE="check" CAPTION="Brza dostava*" NAME="brzadostava" TOP="1100" LEFT="9000"  TABINDEX ="-1" SQL="" WIDTH="2800" HEIGHT="320" ENABLED="TRUE" />
		<INPUT TYPE="check" CAPTION="Publiciraj na WEB:*" NAME="pubind" TOP="1100" LEFT="12000"  TABINDEX ="-1" SQL="" WIDTH="2800" HEIGHT="320" ENABLED="TRUE" />
		
		<INPUT TYPE="search"   NAME="dobavljacid" CAPTION="Dobavljač*"     TOP="1100" LEFT="1500" WIDTH="5000" HEIGHT="320" ENABLED="TRUE"
			   SQL="viPartneri#partneriid#%naziv%#!matbroj" />
		<INPUT TYPE="search"   NAME="proizvodjacid" CAPTION="Proizvođač*"     TOP="1500" LEFT="1500" WIDTH="5000" HEIGHT="320" ENABLED="TRUE" 
			   SQL="viPartneri#partneriid#%naziv%#!matbroj" ONLOSTFOCUS="select 'refresh' as robnamarkaid"/>
		
		<INPUT TYPE="combo" CAPTION="Robna marka :*" NAME="robnamarkaid" TOP="1900" LEFT="1500" WIDTH="4000" HEIGHT="320" ENABLED="TRUE" ALLOWEMPTY="TRUE"  SQL="select robnamarkaid , opis from robnamarka where partneriid = @@proizvodjacid"/>
		<INPUT TYPE="text" CAPTION="Opis za Web:*" NAME="WebOpis" TOP="2300" MAXLENGTH="8000" LEFT="1500" WIDTH="8500" HEIGHT="700" MULTILINE ="TRUE" ENABLED="TRUE"/>
		<INPUT TYPE="text" CAPTION="Sastav:*" NAME="sastav" TOP="3100" MAXLENGTH="5000" MULTILINE ="TRUE" LEFT="1500" WIDTH="8500" HEIGHT="700" ENABLED="TRUE"/>
		<INPUT TYPE="text" CAPTION="Link na Video:*" NAME="link" TOP="3900" LEFT="1500" WIDTH="8500" HEIGHT="320" ENABLED="TRUE"/>
		<INPUT TYPE="text" CAPTION="Ključna riječ(Tag):*" NAME="tag" TOP="4300" LEFT="1500" WIDTH="8500" HEIGHT="320" ENABLED="TRUE"/>
		<INPUT TYPE="picturebox" CAPTION="" NAME="slikalocation" TOP="1500" LEFT="10400" WIDTH="4000" HEIGHT="4000" ENABLED="TRUE"/>

		<INPUT TYPE="grid"
	   NAME="posebni"
	   CAPTION=""
	   TOP="4800"
	   LEFT="120"
	   WIDTH="4400"
	   HEIGHT="3300"
	   SQL="spRobaAtributiAzur @action = 3 , @robaid = @@id "
	   ONCLICK=""
	   EDITCOLUMNS="IND"
	   GROUPBYBOXVISIBLE="FALSE"
	   CHECKBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"/>

		<INPUT TYPE="grid"
	   NAME="nutrit"
	   CAPTION=""
	   TOP="4800"
	   LEFT="5000"
	   WIDTH="4800"
	   HEIGHT="3300"
	   SQL="spRobaAtributiAzur @action = 4 , @robaid = @@id"
	   EDITCOLUMNS="IND# Količina"
	   GROUPBYBOXVISIBLE="FALSE"
	   CHECKBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"/>
		
		<INPUT TYPE="grid"
	   NAME="cuvanje"
	   CAPTION=""
	   TOP="4800"
	   LEFT="10100"
	   WIDTH="4400"
	   HEIGHT="3300"
	   SQL="spRobaAtributiAzur @action = 5 , @robaid = @@id"
	   EDITCOLUMNS="IND"
	   GROUPBYBOXVISIBLE="FALSE"
	   CHECKBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"/>

		<INPUT TYPE="button" NAME="naprijed"  CAPTION="Naprijed -->>"  TOP="8500" LEFT="3200" WIDTH="1600" ONCLICK="MASTERMOVENEXT#OK" />
		<INPUT TYPE="button" NAME="nazad"  CAPTION="&lt;&lt;-- Nazad "  TOP="8500" LEFT="1500" WIDTH="1600" ONCLICK="MASTERMOVEPREVIOUS#OK" />
		<INPUT TYPE="button" NAME="spremi"  CAPTION="Spremi"  TOP="8500" LEFT="7000" WIDTH="1600" 
			   ONCLICK="exec spRobaAtributiAzur @action = 6, @robaid = @@id, @DodOpisNaziva = '@@DodOpisNaziva', @robnamarkaid = @@robnamarkaid, @tezina = @@robatezina , @proizvodjacid = @@proizvodjacid ,@dobavljacid=@@dobavljacid, @sastav = '@@sastav', @tag = '@@tag', @link = '@@link', @pubind = @@pubind, @kolvrijednost = @@kolvrijednost, @webnaziv = '@@webnaziv', @webopis = '@@webopis', @webjmid = @@webjmid, @brzadostava = @@brzadostava
			   #FOREACHROW(posebni)#exec spRobaAtributiAzur @action = 7, @robaid = @@id, @LnRobaPosebniAtributiid = @(posebni..LnRobaPosebniAtributiid), @RobaPosebniAtributiid = @(posebni..RobaPosebniAtributiid), @selectedid = @@gridposebniIND
			   #FOREACHROW(nutrit)#exec spRobaAtributiAzur @action = 8, @robaid = @@id, @LNRobaNutritivneId = @@gridnutritLNRobaNutritivneId, @RobaNutritivneid = @(nutrit..RobaNutritivneid), @selectedid = @@gridnutritIND, @opisnutr= '@@gridnutritKoličina'
			   #FOREACHROW(cuvanje)#exec spRobaAtributiAzur @action = 9, @robaid = @@id, @LNRobaUputeCuvanjaid = @(cuvanje..LNRobaUputeCuvanjaid), @RobaUputeCuvanjaid = @(cuvanje..RobaUputeCuvanjaid), @selectedid = @@gridcuvanjeIND
			   #OK" />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani"  TOP="8500" LEFT="10000" WIDTH="1600" ONCLICK="close" />


	</AZURFORM>
  


  <UPDATEFORM 
                 WIDTH="11000" 
                 ONSUBMIT="" 
                 ONLOAD="	if @@detid=0 begin
								exec spRaiserror 69001, &apos;Ne postoji dodatna jedinica mjere za izmjenu!&apos;
							end
							if (select coalesce(ind_cijene,0) from jmroba where jmrobaId=@@detid) != 1 begin 
								exec spRaiserror 69001, &apos;Možete ispravljati samo artikle s jedinicom mjere za izračun MPC (zeleno)!&apos;
							end
							else begin
								select robanaziv=(select naziv from roba where robaid=jmroba.robaid), 
								jmnaziv=(select naziv from jm where jmid=jmroba.jmid), 
								faktor , jmrobaid=@@detid
								from JmRoba 
								where JmRobaId=@@detid
							end " 
                 HEIGHT="2500" 
                 CAPTION="Izmjena"  
		 FILLEXPLORER="ONLYDET" 
		 >
 	        <INPUT TYPE="text" CAPTION="_Roba:" NAME="robanaziv" TABINDEX="0"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>        
  	        <INPUT TYPE="text" CAPTION="_Jedinica mjere:" NAME="jmnaziv" TABINDEX="1"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>        
		<INPUT TYPE="number" NAME="faktor" CAPTION="Faktor konverzije" TEXT="1" WIDTH="1600" HEIGHT="800" TABINDEX="2" DECIMALS="8" />
		<INPUT TYPE="button" NAME="ok" TOP="1500" LEFT="100" WIDTH="1100" CAPTION="Spremi" ONCLICK="spMPJMzaMPC @action=2, @id=@@detid, @faktor=@@faktor#Ok" TABINDEX="10" />
		<INPUT TYPE="button" NAME="cancel" TOP="1500" LEFT="2000" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" TABINDEX="12" />

  </UPDATEFORM>



  <DELETEFORM
		WIDTH="5500" 
		ONSUBMIT="spMPJMzaMPC @action=3, @id=@@detid" 
		ONLOAD="if @@detid=0 begin
					exec spRaiserror 69001, &apos;Ne postoji dodatna jedinica mjere za brisanje!&apos;
				end
				if (select coalesce(ind_cijene,0) from jmroba where jmrobaId=@@detid) != 1 begin 
							exec spRaiserror 69001, &apos;Možete obisati samo artikle s jedinicom mjere za izračun MPC (zeleno)!&apos;
				end
				else begin
				 select robanaziv=(select naziv from roba where robaid=jmroba.robaid), 
				 jmnaziv=(select naziv from jm where jmid=jmroba.jmid), 
				 faktor from JmRoba where JmRobaId=@@detid
				end "	
		HEIGHT="3000" 
		CAPTION="Obrisati ?" 
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""
		> 
	        <INPUT TYPE="text" CAPTION="_Roba:" NAME="robanaziv" TABINDEX="0"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>        
  	        <INPUT TYPE="text" CAPTION="_Jedinica mjere:" NAME="jmnaziv" TABINDEX="1"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>        
  </DELETEFORM>

	<AKTIVIRAJFORM
		  WIDTH="5500"
		  ONSUBMIT="spMPJMzaMPC @action=5, @id=@@detid"
		  ONLOAD="select robanaziv=(select naziv from roba where robaid=jmroba.robaid), 
						jmnaziv=(select naziv from jm where jmid=jmroba.jmid), 
						faktor from JmRoba where JmRobaId=@@detid"
		  HEIGHT="3000"
		  CAPTION="Aktivirati ?"
		  CMD1CAPTION="Aktiviraj"
		  CMD2CAPTION="Odustani"
		  FILLEXPLORER=""
		>
		<INPUT TYPE="text" CAPTION="_Roba:" NAME="robanaziv" TABINDEX="0"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>
		<INPUT TYPE="text" CAPTION="_Jedinica mjere:" NAME="jmnaziv" TABINDEX="1"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>
	</AKTIVIRAJFORM>

	<DEAKTIVIRAJFORM
		  WIDTH="5500"
		  ONSUBMIT="spMPJMzaMPC @action=6, @id=@@detid"
		  ONLOAD="if @@detid=0 begin
								exec spRaiserror 69001, &apos;Ne postoji dodatna jedinica mjere za deaktiviranje!&apos;
				end
				if (select coalesce(ind_cijene,0) from jmroba where jmrobaId=@@detid) != 1 begin 
							exec spRaiserror 69001, &apos;Ova jedinica mjere nije aktivna!&apos;
				end
				else begin
					select robanaziv=(select naziv from roba where robaid=jmroba.robaid), 
					jmnaziv=(select naziv from jm where jmid=jmroba.jmid), 
					faktor from JmRoba where JmRobaId=@@detid
				end "
		  HEIGHT="3000"
		  CAPTION="Deaktivirati ?"
		  CMD1CAPTION="Deaktiviraj"
		  CMD2CAPTION="Odustani"
		  FILLEXPLORER=""
		>
		<INPUT TYPE="text" CAPTION="_Roba:" NAME="robanaziv" TABINDEX="0"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>
		<INPUT TYPE="text" CAPTION="_Jedinica mjere:" NAME="jmnaziv" TABINDEX="1"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE"/>
	</DEAKTIVIRAJFORM>


	<IZMJENIFORM
		WIDTH="5500" 
		ONSUBMIT="" 
		ONLOAD="if (select vezanicjenikid from TempPromMPC where TempPromMPCId=@@gridstavkeTempPromMPCId) is not null begin 
									exec spRaiserror 69001, &apos;Ne možete ispravljati cijenu na veznom cjeniku !&apos;
				end
			else begin
				
				exec spMPNIvelacijaNG @action=12,@robaid = @@robaid, @datumdok = @@datumdok, @cjenikid  = @@gridstavkecjenikid, @TempPromMPCid = @@gridstavkeTempPromMPCid , @vrcjenikid = @@gridstavkevrcjenikid end"
		HEIGHT="2500" 
		CAPTION="Izmjeni cijenu" 
		FILLEXPLORER=""
		> 

			<INPUT TYPE="number" NAME="nabcijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 2 , @@cijena , @@marza , @@nabcijena) as cijena, 'marza' as focus " CAPTION="Nabavna cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
			<INPUT TYPE="number" NAME="marza" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 3 , @@cijena , @@marza , @@nabcijena) as cijena, 'cijena' as focus " CAPTION="Marža % " TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="3" DECIMALS="2" />
			<INPUT TYPE="number" NAME="cijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 1 , @@cijena , @@marza , @@nabcijena) as marza, 'ok' as focus " CAPTION="MP Cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />

			<INPUT TOP="5000" TYPE="number" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />
			<INPUT TOP="5000" TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<INPUT TOP="5000" TYPE="number" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<INPUT TOP="5000" TYPE="number" NAME="TempPromMPCid" CAPTION="TempPromMPCid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />
			<INPUT TOP="5000" TYPE="number" NAME="vrcjenikid" ALOWEMPTY ="FALSE" CAPTION="vrcjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />

	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi " TABINDEX="1" TOP="1500" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPNIvelacijaNG @action=1, @robaid = @@robaid , @TempPromMPCid = @@TempPromMPCid, @cjenikid = @@cjenikid , @datumdok = @@datumdok , @vrcjenikid = @@vrcjenikid , @cijena = @@cijena , @marza = @@marza , @nabcijena  =@@nabcijena#Ok"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="4" TOP="1500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </IZMJENIFORM> 



</PROJECT>
 
