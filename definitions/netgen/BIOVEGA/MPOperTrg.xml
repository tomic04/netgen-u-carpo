<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
	DETAILGRID = "spMPOperTrg @action = 1, @operateriid = @@id"
	CMD1CAPTION="" 
	CMD2CAPTION=""
	CMD3CAPTION="" 
	CMD4CAPTION="" 
	CMD5CAPTION="" 
	CMD6CAPTION=""
	CMD7CAPTION="" 
	CMD8CAPTION="" 
	BUTTONS="Parametri:FILTERFORM#Dodaj na trgovinu:INSERT_FORM#Izmjeni operatera:UPDATE_FORM#Prebaci sa trgovine:SHIFT_FORM#Obriši:DELETE_FORM#Obriši sa svih trgovina:DELETESVE_FORM#Svi na sve:NASVE"
	POPUPMASTER="Izmjena:IZMJENA" 
	MASTERDBLCLICK="IZMJENA"
	GROUPBYBOXVISIBLE="TRUE" 
	ONLOAD=":FILTERFORM" 
	FROZENCOLUMNS="0" 
	CHECKBOXVISIBLE="FALSE"
  DETAILCHECKBOXVISIBLE="FALSE"
	AUTOFITCOLUMNS="False"
	REPORT=""
  PAGEHEADERLEFT=""
  PAGEHEADERRIGHT="@@tkosmomi"
  SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">
	
	
<NAME>Ažuriranje operatera po trgovinama</NAME>
<CAPTION>Ažuriranje operatera po trgovinama</CAPTION>
<KOMENTAR></KOMENTAR>

	
<FILTERFORM 
	NAME="FILTERFORM" 
	HEIGHT="2500" 
	WIDTH="5353" 
	TEXT=""
	REFRESHAFTERCHILD="TRUE" 
	CAPTION="Upišite uvjete prikaza " 
	BORDERSTYLE="3" 
	ONSUBMIT="spMPOperTrg @action = 0,"
	ONLOAD="" 
	CANCELONSUBMIT="" 
	FILLEXPLORER="TRUE" 
  CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >

  <INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="1300" WIDTH="5000" />
	<INPUT TYPE="combo" NAME="operaterid" CAPTION="Operater:*"  TOP="500" LEFT="1000" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="TRUE"
         SQL="spMPOperTrg @action = 333"/>

	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovinu:*" TOP="900" LEFT="1000" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="TRUE"
          SQL="spMPOperTrg @action = 44, @operateriid = @@id"/>
  <INPUT TYPE="check" NAME="aktivan" CAPTION="Samo aktivni operateri"  TOP="900" LEFT="1000" HEIGHT="302" WIDTH="3000" />
  
</FILTERFORM>
	<NASVE
				CAPTION="Dodjela svih operatera na sve trgovine "
				HEIGHT="2500"
				WIDTH= "7500"
				FILLEXPLORER=""
				FOCUS=""
				ONLOAD2=""
				ONLOADED=""
				ONLOAD="select 'Želite li SVE operatere dodati na sve trgovine ?? ' as poruka, 'odustani' as focus"
		>

		<INPUT TYPE="text" NAME="poruka" CAPTION="" TOP="500" LEFT="500 " WIDTH="5106" HEIGHT="322" ONCLICK="" ENABLED="FALSE" STYLE ="1" />


		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="1200" LEFT="1000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="ok" CAPTION="Dodaj" TOP="1200" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="spMPTrgOpr @action = 12"  />
	</NASVE>

	<INSERT_FORM
	NAME="INSERT_FORM"
	HEIGHT="3500"
	WIDTH="5550"
	REFRESHAFTERCHILD="TRUE"
	CAPTION="Dodavanje operatera u trgovinu"
	BORDERSTYLE="3"
	ONSUBMIT=""
	ONLOAD="if (select count(*) from LnTrgovinaOperateri where operateriid = @@id) > 0 begin
              select 'disable' as sifra
            end"
	ONLOADED="select operateriid as operaterid, naziv, oib from ssoperateri where operateriid = @@id #
			select top 1 sifra from lntrgovinaoperateri where operateriid = @@id"
	FILLEXPLORER=""
	FOCUS="operaterid">

    <INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="2100" WIDTH="5200" />
    <INPUT TYPE="combo" NAME="operaterid" CAPTION="Operater:*"  TOP="500" LEFT="1500" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" ENABLED="FALSE"
           SQL="spMPOperTrg @action = 333"/>

    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="900" LEFT="1500" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE"
             SQL="spMPOperTrg @action = 44, @operateriid = @@id"/>

    <INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1300" LEFT="1500" HEIGHT="302" WIDTH="1500" ALLOWEMPTY="TRUE" MAXLENGTH ="11"/>
    <INPUT TYPE="text" NAME="sifra"  CAPTION="Šifra za kasu:*" TOP="1700" LEFT="1500" WIDTH="3500" BOLD="TRUE" ENABLED="FALSE"  />

    <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2500" LEFT="300" WIDTH="1000" CAPTION="Spremi"
         ONCLICK="spMPOperTrg @action = 2, @id = @@id, @trgovinaid = @@trgovinaid,  @operaterid = @@id, @operateriid = @@operateriid, 
         @oib = '@@oib', @sifra = '@@sifra', @aktivan = 1 #OK "  />
    <INPUT TYPE="button" NAME="cancel" TOP="2500" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</INSERT_FORM>

	<UPDATE_FORM
		NAME="INSERT_FORM"
		HEIGHT="3500"
		WIDTH="5550"
		REFRESHAFTERCHILD="TRUE"
		CAPTION="Izmjena podataka operatera"
		BORDERSTYLE="3"
		ONSUBMIT=""
		ONLOAD="select *, (select top 1 sifra from lntrgovinaoperateri where operateriid = @@id ) as sifra  from ssoperateri where operateriid = @@id"
		ONLOADED=""
		FILLEXPLORER=""
		FOCUS="naziv">


		<INPUT TYPE="text" NAME="naziv" CAPTION="Ime i preuome:*" TOP="900" LEFT="1500" HEIGHT="302" WIDTH="2500" ALLOWEMPTY="TRUE" MAXLENGTH ="50"/>
		<INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1300" LEFT="1500" HEIGHT="302" WIDTH="1500" ALLOWEMPTY="TRUE" MAXLENGTH ="11"/>
		<INPUT TYPE="text" NAME="sifra"  CAPTION="Šifra za kasu:*" TOP="1700" LEFT="1500" WIDTH="1500" BOLD="TRUE" ENABLED="TRUE"  />

		<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2500" LEFT="300" WIDTH="1000" CAPTION="Spremi"
			 ONCLICK="spMPOperTrg @action = 13, @id = @@id, @oib = '@@oib',  @naziv = '@@naziv' , @sifra = '@@sifra' #OK "  />
		<INPUT TYPE="button" NAME="cancel" TOP="2500" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

	</UPDATE_FORM>


	<SHIFT_FORM
    NAME="SHIFT_FORM" 
	  HEIGHT="3700" 
	  WIDTH="5500" 
	  CAPTION="Prebacivanje operatera na drugu trgovinu" 
	  BORDERSTYLE="3" 
	  ONSUBMIT=""
	  ONLOAD=""
    ONLOADED="select operateriid as operaterid,sifra, NazivOpr as naziv, oib from lntrgovinaoperateri where operateriid = @@id "
	  FILLEXPLORER="" 
	  FOCUS="operaterid">

  <INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="2400" WIDTH="5150" />
  <INPUT TYPE="combo" NAME="operaterid" CAPTION="Operater:*" TOP="400" LEFT="1200" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" ENABLED="FALSE"
         SQL="spMPOperTrg @action = 333"/>
  
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Sa trgovine:*" TOP="800" LEFT="1200" STILE="1" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" 
          SQL="spMPOperTrg @action = 33, @operateriid = @@id"/>
  <INPUT TYPE="combo" NAME="trgovina2id" CAPTION="Na trgovinu:*" TOP="1200" LEFT="1200" STILE="1" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" 
          SQL="spMPOperTrg @action = 44, @operateriid = @@id"/>

	<INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1600" LEFT="1200" HEIGHT="302" WIDTH="3500" VISIBLE="TRUE" MAXLENGTH ="11"/>
  <INPUT TYPE="text" NAME="sifra" CAPTION="Šifra za kasu:*"  TOP="2000" LEFT="1200" WIDTH="3500" BOLD="TRUE" ENABLED="FALSE"/>
	
	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2700" LEFT="300" WIDTH="1000" CAPTION="Spremi"
		   ONCLICK="spMPOperTrg @action = 3, @operaterid = @@id, @operateriid = @@operateriid, @LnTrgOperId = @@detid, 
       @trgovinaid = @@trgovinaid , @trgovina2id = @@trgovina2id , @oib = '@@oib', @sifra = '@@sifra'  #OK "  />
	<INPUT TYPE="button" NAME="cancel" TOP="2700" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />
	
</SHIFT_FORM>
	
<DELETE_FORM 
	  NAME="DELETE_FORM" 
	  HEIGHT="3200" 
	  WIDTH="5500" 
	  CAPTION="Brisanje operatera iz trgovine" 
	  BORDERSTYLE="3" 
	  ONSUBMIT=""
	  ONLOAD=""
	  ONLOADED="select l.operateriid as operaterid, l.trgovinaid,  naziv, l.oib, l.sifra from ssoperateri o inner join LnTrgovinaOperateri l on o.Operateriid = l.OperateriID where LnTrgovinaOperateriid = @@detid"
	  FILLEXPLORER="">

  <INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="2100" WIDTH="5150" />
  <INPUT TYPE="combo" NAME="operaterid"  CAPTION="Operater:*" TOP="500" LEFT="1500" HEIGHT="302" WIDTH="3500" VISIBLE="TRUE" ALLOWEMPTY="FALSE" ENABLED="FALSE"
         SQL="spMPOperTrg @action = 333"/>

  <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="900" LEFT="1500" STYLE="1" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" ENABLED="FALSE"
         SQL="spMPOperTrg @action = 33, @operateriid = @@id"/>

  <INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1300" LEFT="1500" HEIGHT="302" WIDTH="3500" STYLE="1" ALLOWEMPTY="TRUE" MAXLENGTH ="11" ENABLED="FALSE"/>
  <INPUT TYPE="text" NAME="sifra" CAPTION="Šifra:*" TOP="1700" LEFT="1500" WIDTH="3500" BOLD="TRUE" STYLE="1" ENABLED="FALSE"  STILE="1" />

	
	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2300" LEFT="300" WIDTH="1000" CAPTION="Obriši"
		   ONCLICK="spMPOperTrg @action = 4, @LnTrgOperId = @@detid#OK "  />
	<INPUT TYPE="button" NAME="cancel" TOP="2300" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</DELETE_FORM>


	<DELETESVE_FORM
	  NAME="DELETE_FORM"
	  HEIGHT="3200"
	  WIDTH="5500"
	  CAPTION="Brisanje operatera sa svih trgovina"
	  BORDERSTYLE="3"
	  ONSUBMIT=""
	  ONLOAD=""
	  ONLOADED="select l.operateriid as operaterid, l.trgovinaid,  naziv, l.oib, l.sifra from ssoperateri o inner join LnTrgovinaOperateri l on o.Operateriid = l.OperateriID where LnTrgovinaOperateriid = @@detid"
	  FILLEXPLORER="">

		<INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="2100" WIDTH="5150" />
		<INPUT TYPE="combo" NAME="operaterid"  CAPTION="Operater:*" TOP="500" LEFT="1500" HEIGHT="302" WIDTH="3500" VISIBLE="TRUE" ALLOWEMPTY="FALSE" ENABLED="FALSE"
			   SQL="spMPOperTrg @action = 333"/>

		<INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1300" LEFT="1500" HEIGHT="302" WIDTH="3500" STYLE="1" ALLOWEMPTY="TRUE" MAXLENGTH ="11" ENABLED="FALSE"/>
		<INPUT TYPE="text" NAME="sifra" CAPTION="Šifra:*" TOP="1700" LEFT="1500" WIDTH="3500" BOLD="TRUE" STYLE="1" ENABLED="FALSE"  STILE="1" />


		<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2300" LEFT="300" WIDTH="1000" CAPTION="Obriši"
			   ONCLICK="spMPOperTrg @action = 444, @operateriid = @@id#OK "  />
		<INPUT TYPE="button" NAME="cancel" TOP="2300" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

	</DELETESVE_FORM>

<DODOPERATER
	  NAME="UNOS"
	  HEIGHT="5500"
	  WIDTH="5500"
    CAPTION="Unos novog operatera"
	  BORDERSTYLE="3"
	  ONSUBMIT=""
	  ONLOAD="select opis as trgovina from trgovina where trgovinaid = @@id"
	  ONLOADED="select max(operateriid)+1 as sifra from ssoperateri "
	  FILLEXPLORER=""
	  FOCUS="operaterid">

    <INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" HEIGHT="4300" WIDTH="5150" />
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="400" LEFT="1500" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="FALSE" ENABLED="TRUE"
           SQL="spMPOperTrg @action = 44"/>
    <INPUT TYPE="text" NAME="naziv" CAPTION="Naziv:*" TOP="800" LEFT="1500" HEIGHT="302" WIDTH="3500" SQL="" ALLOWEMPTY="FALSE"  />
		<INPUT TYPE="text" NAME="inicijali" CAPTION="Inicijali:*" TOP="1200" LEFT="1500" HEIGHT="302" WIDTH="400" VISIBLE="TRUE" ALLOWEMPTY="FALSE" MAXLENGTH ="3"/>
    <INPUT TYPE="text" NAME="oib" CAPTION="OIB:*" TOP="1600" LEFT="1500" HEIGHT="302" WIDTH="1500" VISIBLE="TRUE" SQL="" ALLOWEMPTY="TRUE" MAXLENGTH ="11"/>

		<INPUT TYPE="text" NAME="sifra" CAPTION="Šifra za kasu:*" TOP="2000" LEFT="1500" WIDTH="3500" BOLD="TRUE"  />
		<INPUT TYPE="text" NAME="password" CAPTION="Jupiter lozinka:*" TOP="2400" LEFT="1500" WIDTH="3500" BOLD="TRUE"  ENABLED="FALSE"/>
		<INPUT TYPE="combo" NAME="grupeid" CAPTION="Grupa operatera:*" TOP="2800" LEFT="1500" HEIGHT="302" WIDTH="3500"  ALLOWEMPTY="FALSE" ENABLED="TRUE"
           SQL="select grupeid , naziv from ssgrupe order by 2" />

		<INPUT TYPE="combo" NAME="odjelid" CAPTION="Odjel:*" TOP="3200" LEFT="1500" HEIGHT="302" WIDTH="3500" ALLOWEMPTY="TRUE" ENABLED="FALSE"
           SQL="select odjelid, naziv from odjel" />
		<INPUT TYPE="check" NAME="prava"  CAPTION="Dodaj prava u Jupiteru" TOP="3600" LEFT="1500" WIDTH="3500" BOLD="TRUE" ENABLED="FALSE"/>

		<INPUT TYPE="check" NAME="mpmanager" TOP="4000" LEFT="1500" HEIGHT="302" WIDTH="4000" CAPTION="Poslovođa" ALLOWEMPTY="TRUE"
            SQL="" />
	
		<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="4500" LEFT="300" WIDTH="1000" CAPTION="Spremi"
			   ONCLICK="spMPOperTrg @action = 5, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid, @naziv = '@@naziv', @inicijali = @@inicijali, @sifra = '@@sifra' , @password = '@@password', 
         @grupeid = @@grupeid, @odjelid = @@odjelid, @prava = @@prava, @oib = '@@oib', @mpmanager = @@mpmanager#OK "  />
		<INPUT TYPE="button" NAME="cancel" TOP="4500" LEFT="1600" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</DODOPERATER>

	<PROMOPERATER
	NAME="PROMOPERATER"
	HEIGHT="6000"
	WIDTH="7603"
	TEXT=""
	REFRESHAFTERCHILD="TRUE"
	CAPTION="Izmjena podataka operatera"
	BORDERSTYLE="3"
	ONSUBMIT=""
	ONLOAD="select *, @@operaterid as operaterid , naziv as oldnaziv from ssoperateri where operateriid = @@operaterid"
	CANCELONSUBMIT=""
	ONLOADED="select opis as trgovina from trgovina where trgovinaid = @@id"
	FILLEXPLORER=""
	NEXTFORM=""
	FOCUS="operaterid"
	CMD1CAPTION=""
	CMD2CAPTION=""
	CMD3CAPTION=""
	CMD4CAPTION=""
	CMD5CAPTION=""
	CMD6CAPTION="">


		<INPUT TYPE="text" NAME="oldnaziv" TOP="-1" VISIBLE="FALSE"
	 HEIGHT="302" WIDTH="3000" SQL=""
	 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="TRUE" ONLOSTFOCUS=""
	 CAPTION="" TABINDEX="" ENABLED="TRUE"/>



		<INPUT TYPE="number" NAME="OperateriID" TOP="-1"
			 HEIGHT="302" WIDTH="4032" VISIBLE="FALSE" SQL="" DECIMALS="0"
			 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="TRUE"
			 CAPTION="" TABINDEX="" ENABLED="FALSE"/>


		<INPUT TYPE="text" NAME="trgovina"
			 HEIGHT="302" WIDTH="4032" VISIBLE="TRUE" SQL=""
			 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="TRUE"
			 CAPTION="Trgovina" TABINDEX="" ENABLED="FALSE"/>

		<INPUT TYPE="text" NAME="naziv" TOP=""
			 HEIGHT="302" WIDTH="3000" VISIBLE="TRUE" SQL=""
			 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="TRUE" ONLOSTFOCUS=""
			 CAPTION="Operater" TABINDEX="" ENABLED="TRUE"/>
		

		<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="5000" LEFT="1000" WIDTH="1000" CAPTION="Spremi"
			   ONCLICK="spMPTrgOpr @action = 10, @operateriid = @@OperateriID, @trgovinaid = @@id, @naziv = '@@naziv', @oldnaziv = '@@oldnaziv' #OK "  />
		<INPUT TYPE="button" NAME="cancel" TOP="5000" LEFT="2500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

	</PROMOPERATER>



</PROJECT>