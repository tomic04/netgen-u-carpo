<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD="spBLZakljucakQueryNG @action=0"
   ONLOAD2=""
   MASTERDBLCLICK="IZMJENI_FORM"
   POPUPMASTER=""
   PERMISIO="TRUE"
   DETAILGRID = "spBLPrometGlaQueryNG @Action=10,@Id=@@blagajneid,@BLZakljucciId=@@id"
   TREE="Blagajne:#spBlagajneZakTreeNG @action=2,@operateriid=@@operateriid:MJESEC_FORM0#spBlagajneZakTreeNG @action=0,@operateriid=@@operateriid:MJESEC_FORM#spBlagajneZakTreeNG @action=1,@operateriid=@@operateriid:MJESEC1_FORM"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   POPUPDETAIL=""
   BUTTONS="Ispis zaključka:ISPISZAK_FORM#Ispis dokumenta:ISPISDOK_FORM#Poništi zaključak:PONISTI_ZAK_FORM" 
   CMD6CAPTION=""
   SETDEFAULTS=""
     
>
 
 <NAME>Zaključci</NAME>
 <CAPTION>Zaključci</CAPTION>
 
 <MASTERCOLUMNS CLEARCOLUMS="TRUE" HEADERALIGNMENT="2">
	<COLUMN INDEX="" NAME="VrstaBlagajne" WIDTH="2500" CAPTION="Vrsta blagajne" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0"  />
	<COLUMN INDEX="" NAME="Datum" WIDTH="1500" CAPTION="Datum" FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Broj" WIDTH="1500" CAPTION="Broj" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
	<COLUMN INDEX="" NAME="PrSaldoVal" WIDTH="1500" CAPTION="Prethodni saldo valuta" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="PrSaldoKn" WIDTH="1500" CAPTION="Prethodni saldo" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="UplataVal" WIDTH="1500" CAPTION="Uplata Val" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="IsplataVal" WIDTH="1500" CAPTION="Isplata Val" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
	<COLUMN INDEX="" NAME="UplataKn" WIDTH="1500" CAPTION="Uplata KN" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="IsplataKn" WIDTH="1500" CAPTION="Isplata KN" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Napomena" WIDTH="3000" CAPTION="Napomena" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Blagajna" WIDTH="3000" CAPTION="Blagajna" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
 </MASTERCOLUMNS>
 
  <DETAILCOLUMNS CLEARCOLUMS="TRUE" HEADERALIGNMENT="2">
	<COLUMN INDEX="" NAME="VrstaDokumenta" WIDTH="2000" CAPTION="Vrsta dokumenta" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Datum" WIDTH="1500" CAPTION="Datum" FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Vrijeme" WIDTH="1500" CAPTION="Vrijeme" FORMAT="HH:mm" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Broj" WIDTH="2000" CAPTION="Broj" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="UplataVal" WIDTH="1500" CAPTION="Uplata Val" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="IsplataVal" WIDTH="1500" CAPTION="Isplata Val" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Tecaj" WIDTH="1000" CAPTION="Tečaj" FORMAT="#,##0.0000" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="UplataKn" WIDTH="1000" CAPTION="Uplata KN" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
	<COLUMN INDEX="" NAME="IsplataKn" WIDTH="1000" CAPTION="Isplata KN" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Opis" WIDTH="3000" CAPTION="Opis" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
    	<COLUMN INDEX="" NAME="Storno" WIDTH="1500" CAPTION="Storno" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
    	<COLUMN INDEX="" NAME="Zakljucen" WIDTH="1500" CAPTION="Status" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />  	
 </DETAILCOLUMNS>

 
 <MJESEC_FORM0  FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spBLZakljucakQueryNG @action=21,@node='@@node'" />
 <MJESEC_FORM   FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spBLZakljucakQueryNG @action=20,@id='@@node'" />
 <MJESEC1_FORM  FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spBLZakljucakQueryNG @action=20,@id='@@node'" />
 

 <ISPISZAK_FORM  HEIGHT="1" WIDTH="1" FILLEXPLORER="TRUE"  

	ONLOAD="select bd.Template,*  from BLZakljucci bz
		inner join Blagajne b on b.BlagajneId=bz.BlagajneId
		inner join BLDokumenti bd on bd.blagajneid=b.BlagajneId
		inner join VrstaDok vd on vd.VrstaDokId=bd.vrstadokid
		where bz.BlagajneId=@@Blagajneid and Opis like '%zaključak%'
		and BLZakljucciid=@@BLZakljucciId" 

	ONSUBMIT="" ONLOADED=":REPX/@@template (@id=@@Blzakljucciid)#close" >

   	

 </ISPISZAK_FORM> 
 
 <ISPISDOK_FORM HEIGHT="1" WIDTH="1"  FILLEXPLORER="TRUE"  ONLOAD="select template,@@BLPrometGlaId as BLPrometGlaId  from bldokumenti where bldokumentiid=@@bldokumentiid" ONSUBMIT=""
	ONLOADED=":REPX/@@template (@id=@@BLPrometGlaId)#close"  >

 </ISPISDOK_FORM> 


 <PONISTI_ZAK_FORM  FILLEXPLORER="" PERMISIO="TRUE" ONLOAD="" ONSUBMIT="spBLNaplataPonistiZakljucakNG @Action=0,@ID=@@id,@BLPrometGlaId=@@id,@OperateriId=@@operateriid,@Status=@@status" />

 <STORNIRAJ_FORM  FILLEXPLORER="" ONLOAD="" ONSUBMIT="spBLPrometGlaAzurNG @action=5,@id=@@id,@Status=@@Status" />


  <PONISTI_ZAK_FORM CAPTION="Poništavanje zaključka" PERMISIO="TRUE" HEIGHT="2000" WIDTH= "4500" FILLEXPLORER="" 
                   ONLOAD="select blagajneid as blagajneid from blzakljucci where blzakljucciid=@@id" 
                   ONSUBMIT="" NEXTFORM="" >
     <INPUT TYPE="label" NAME="lbldatum" TOP="300" LEFT="250" WIDTH="400" CAPTION="Želite li doista poništiti označeni zaključak ?"/>
     <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="350" WIDTH="1000" CAPTION="DA" ONCLICK="spBLZakljucciAzurNG @Action = 2,@ID =@@id,@BlagajneId=@@BlagajneId#OK" TABINDEX="0" />
     <INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="2350" WIDTH="1000" CAPTION="NE" ONCLICK="close" TABINDEX="1" />
	 
  </PONISTI_ZAK_FORM> 
 
</PROJECT>
