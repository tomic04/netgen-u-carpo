				 FILLEXPLORER=""
				 FOCUS="vrstapromid"
		 >
	  <INPUT TYPE="combo" NAME="tippopustaid" CAPTION="Tip popusta:¸* " TOP="100" LEFT="1500" SQL =" select MPTipUvjetaPopustaid, opis as naziv from MPTipUvjetaPopusta where vaucher = 1 and IstekLom=1" ALLOWEMPTY="FALSE"
			 ONCLICK="select datumdo = case when '@@comboboxtippopustaid' like '%LOM%'  then 'disable' else 'enable' end,rokdatum = case when '@@comboboxtippopustaid' like '%LOM%' then 'disable' else 'enable'  end, sve = case when '@@comboboxtippopustaid' like '%LOM%'  then 1 else 0 end" />
	  
	  <INPUT TYPE="text" NAME="OPIS" ALLOWEMPTY="TRUE" CAPTION="Opis Vauchera*" MAXLENGTH="300" TOP="500" LEFT="1500" ONLOSTFOCUS="" WIDTH="3000" SQL=" " />
	  <INPUT TYPE="combo" NAME="trgovinaid " ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="900" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" />
	  <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="1300" LEFT="1500" />
	  <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="1300" LEFT="3700" />
	  <INPUT TYPE="check" NAME="sve" CAPTION="Bez ograničenja*" TOP="1300" LEFT="5500" 
			 ONCLICK="select datumdo = case @@sve when 1 then 'disable' else 'enable' end,rokdatum = case @@sve when 1 then 'disable' else 'enable'  end"/>
	  
	  <INPUT TYPE="date" NAME="rokdatum" CAPTION="Rok upotrebe*" TOP="1700" LEFT="1500" 
			 ONLOSTFOCUS="select '@@rokdatum' as datumdo#select 'refresh' as datumdo" ONCLICK="select '@@rokdatum' as datumdo#select 'refresh' as datumdo"/>

	  <INPUT TYPE="check" NAME="viseputa" ALLOWEMPTY="TRUE" TOP="1700" LEFT="4400" CAPTION="Višekratna iskorištenost" ENABLED="FALSE" ONLOSTFOCUS="" SQL="" />
	  <INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="2100" LEFT="1500" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" 
			 SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid', @partneriid = @@partneriid, @skladisteid = @@skladisteid" 
			 ONLOSTFOCUS="if (select robaid from jmroba where robaid=@@robaid and nepovratrobaid is not null) is not null begin
						    exec spRaiserror 69001, 'Roba koju ste izabrali sadrži povratnu naknadu u maloprodajnoj cijeni! Popust (%) koji definirate odnosit će se na MPC bez povratne naknade! '
						    return end"/>
	  <INPUT TYPE="check" CAPTION="Automatski unos" NAME="dod_roba" TOP="2900" LEFT="1500" SQL="" WIDTH="3600" HEIGHT="320" DECIMALS="" ENABLED="FALSE" />
	  <INPUT TYPE="number" CAPTION="% popusta po stavci*" NAME="popust" TOP="2500" LEFT="1500" SQL="" WIDTH="600" HEIGHT="320" ENABLED="TRUE" DECIMALS="2"/>
	  <INPUT TYPE="number" CAPTION="MPC*" NAME="mpcijena" TOP="2500" LEFT="4000" SQL="" WIDTH="600" HEIGHT="320" ENABLED="TRUE" DECIMALS="2"/>
	  
	
	  
	  <INPUT TYPE="number" CAPTION="Komada za popust*" NAME="komada" TOP="3300" LEFT="1500" SQL="" WIDTH="600" HEIGHT="320" ENABLED="TRUE" DECIMALS="0"/>
	  
	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="6000" LEFT="500" WIDTH="1106" HEIGHT="322"
	  ONCLICK="spMPVaucher @action=3,  @operateriid = @@operateriid, @vrcjenikid = @@vrcjenikid, @trgovinaid =@@trgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, 
			 @popust = @@popust , @sve = @@sve, @robaid = @@robaid , 
			@tippopustaid = @@tippopustaid,@zabranipopust=0,
			 @opis = '@@opis', @viseputa = @@viseputa, @dod_roba  = @@dod_roba,
			 @ind_prodaja = @@ind_prodaja, @komada=@@komada, @mpcijena=@@mpcijena, 
			 @rokdatum='@@rokdatum'#ok"/>


	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6000" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



  </DODAJFORM>



	<UPDATEFORM 
				   WIDTH="12000" 
				   ONSUBMIT="select 1" 
				   ONLOAD="if @@id = 0 begin exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos; end 
