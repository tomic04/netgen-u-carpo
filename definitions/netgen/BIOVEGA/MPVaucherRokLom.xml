	</FILTERFORM>

  <DODAJFORM 
                 WIDTH="11000" 
                 ONSUBMIT="select 1" 
                 ONLOAD="" 
				 VERSION="1.4"
				 ONLOADED ="select null as trgovinaid, null as kntnacinplacid, null as vrcjenikid, null as klmasterrobaid, null as popust, 0 as clankart,  1 as viseputa, 1 as dod_roba" 
