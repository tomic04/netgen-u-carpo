			PAGEHEADERRIGHT=""
			PAGEHEADERCENTER=""
			PAGEHEADERLEFT=""
			PAGEFOOTERCENTER=""
			PAGEFOOTERLEFT=""
			PAGEFOOTERRIGHT=""
			PAGEORIENTATION="LANDSCAPE"
			CHECKBOXVISIBLE="FALSE"
 />
	<INPUT TYPE="button" NAME="" CAPTION="Zatvori" TOP="980" LEFT="140" WIDTH="1050" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="" CAPTION="Ispis iz jupitera" TOP="3640" LEFT="224" WIDTH="1386" HEIGHT="406" ONCLICK=":repx/rptMPBioLomIstek(@id=@@id, @komada=@@komada)#ok"  />


	</ETIKETE>

	<OSLOBODIISPIS	FILLEXPLORER=""
