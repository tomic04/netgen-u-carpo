		<INPUT TYPE="combo" NAME="kntnacinplacid " ALLOWEMPTY="TRUE" CAPTION="Način plaćanja*" TOP="700" LEFT="1500" ONLOSTFOCUS="" SQL="spmpDajNacPacanjaKase" ENABLED="FALSE"/>
