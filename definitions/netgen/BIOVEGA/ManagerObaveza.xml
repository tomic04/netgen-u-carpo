<REZERVIRAJ NAME="REZERVIRAJ" HEIGHT="3254" WIDTH="10757" CAPTION="Rezerviraj" ONLOAD="declare 
@kolo int,
@kolf int 
set @kolo=(select sum(kolicina) from lnproponnalog where propondetid=@@id group by propondetid) 
set @kolf=(select sum(kolicina)from lnFakObveza where propondetid=@@id group by propondetid)
if  @kolo&gt;0 or @kolf&gt;0 begin 
raiserror (&apos;Za ovu stavku potoji rezervacija! +close&apos;, 16, 1) 
return 
end 

