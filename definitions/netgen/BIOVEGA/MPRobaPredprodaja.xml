<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpDefPredProdaja @action=1" 
   CMD1CAPTION="Dodaj:DODAJFORM"    
   CMD2CAPTION="Izmjeni:UPDATEFORM"    
   CMD3CAPTION="Aktiviraj:MULTISELECTAKTIVIRAJ" 
   CMD4CAPTION="Deaktiviraj:MULTISELECTDEAKTIVIRAJ"
   CMD5CAPTION=""
   CMD6CAPTION=""
   POPUPMASTER=""
   FILLEXPLORER="FALSE"
   MASTERDBLCLICK="UPDATEFORM">
 
  <NAME>Artikli za predprodaju</NAME>
  <CAPTION>Artikli za predprodaju</CAPTION>
 
 

  <DODAJFORM 
        WIDTH="7500" 
        ONSUBMIT="" 
        ONLOAD="" 
        HEIGHT="4000" 
        CAPTION="Definiranje robe za predprodaju"  
		VERSION=""
		FOCUS="">


	  <INPUT TYPE="search" NAME="robaid" TOP="1000" LEFT="2000" WIDTH="5000" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ALLOWEMPTY="FALSE" CAPTION="Roba za pretprodaju:*"/>
	    
	  <INPUT TYPE="search" NAME="uslugarobaid" TOP="2200" LEFT="2000" WIDTH="5000" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ALLOWEMPTY="FALSE" CAPTION="Vezana usluga:*"/>
	  
	  <INPUT TYPE="check" NAME="aktivno" CAPTION="Aktivno*" VALUE="" TOP="2800" LEFT="2000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	  
	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="3400" LEFT="196" WIDTH="1106" HEIGHT="322"
		ONCLICK="exec spmpDefPredProdaja @action=3, @robaid=@@robaid, @uslugarobaid=@@uslugarobaid, @aktivno=@@aktivno, @operateriid=@@operateriid#OK"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3400" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	  
  </DODAJFORM>
  

  <UPDATEFORM 
        WIDTH="7500" 
        ONSUBMIT="" 
        ONLOAD="spmpDefPredProdaja @action = 2, @id=@@id" 
        HEIGHT="4000" 
        CAPTION="Izmjena robe za predprodaju"  
		VERSION=""
		FOCUS="">

	  <INPUT TYPE="search" NAME="robaid" TOP="1000" LEFT="2000" WIDTH="5000" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ALLOWEMPTY="FALSE" ENABLED="FALSE" CAPTION="Roba za pretprodaju:*"/>
	  	  
	  <INPUT TYPE="search" NAME="uslugarobaid" TOP="2200" LEFT="2000" WIDTH="5000" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" ALLOWEMPTY="FALSE" CAPTION="Vezana usluga:*"/>
	  
	  <INPUT TYPE="check" NAME="aktivno" CAPTION="Aktivno*" VALUE="" TOP="2800" LEFT="2000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	  
	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="3400" LEFT="196" WIDTH="1106" HEIGHT="322"
		ONCLICK="exec spmpDefPredProdaja @action=4, @robaid=@@robaid, @uslugarobaid=@@uslugarobaid, @aktivno=@@aktivno, @operateriid=@@operateriid, @id=@@id#OK"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3400" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	  
  </UPDATEFORM>
  
  <MULTISELECTAKTIVIRAJ NAME="MULTISELECTAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
		CAPTION="Aktivirati vezu ?"
		ONSUBMIT=""
		ONLOAD=""
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		>
		<INPUT TYPE="grid"
		NAME="akt"
		TOP="500"
		LEFT="200"
		WIDTH="8000"
		HEIGHT="5000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION="Aktiviranje veze"
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="exec spmpDefPredProdaja @action = 5 , @operateriid = @@operateriid " />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Aktiviraj"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spmpDefPredProdaja @action = 6, @operateriid = @@operateriid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTAKTIVIRAJ>

	<MULTISELECTDEAKTIVIRAJ NAME="MULTISELECTDEAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
		CAPTION="Deaktivirati vezu ?"
		ONSUBMIT=""
		ONLOAD=""
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		>
		<INPUT TYPE="grid"
		NAME="akt"
		TOP="500"
		LEFT="200"
		WIDTH="8000"
		HEIGHT="5000"
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION="Deaktiviranje veze"
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="exec spmpDefPredProdaja @action = 5 , @operateriid = @@operateriid " />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Deaktiviraj"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spmpDefPredProdaja @action = 7, @operateriid = @@operateriid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTDEAKTIVIRAJ>


</PROJECT>
 
