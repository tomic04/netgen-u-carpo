<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTERFORM"  		
		REPORT="Etikete.clsEtikete" 	
		CMD1CAPTION="Parametri:FILTERFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE"
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"
		ONCLOSED="spMPPregArtng @action = 8, @operateriid = @@operateriid"
	    POPUPMASTER=""
		COMMANDTIMEOUT="300"> 
 

  <NAME>Pregled prometa artikala</NAME>
  <CAPTION>Pregled prometa artikala</CAPTION>


	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="9000"
		WIDTH="8000"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregArtng @operateriid= @@operateriid, @nenc = @@nenc, @datumod=@@datumod,@datumdo=@@datumdo,@vrstapromid=@@vrstapromid,@vrstadokid=@@vrstadokid,
		@trgovinaid=@@trgovinaid,@klmasterrobaid=@@klmasterrobaid,@podklase=@@podklase,@klklrobaid=@@klklrobaid,@dodatnaklasaid=@@dodatnaklasaid,  
		@dobavljacId=@@dobavljacId, @robnamarkaid=@@robnamarkaid--"
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstapromid as vrstapromid , @@vrstadokid as vrstadokid "
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstapromid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	
		<INPUT TYPE="combo" NAME="klmasterrobaid" WIDTH="5500" SQL="select KlMasterRobaid, naziv as naziv from KlMasterRoba order by naziv" ALLOWEMPTY="TRUE" CAPTION="Klasa robe:"/>
		<INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" />
		<INPUT TYPE="combo" NAME="klklrobaid"  WIDTH="3500" 
			   SQL="select klklrobaid, naziv as naziv from KlklRoba " ALLOWEMPTY="TRUE" ONCLICK="select 'refresh' as dodatnaklasaid" CAPTION="Vrsta dodatna klasa robe:"/>
		<INPUT TYPE="combo" NAME="dodatnaklasaid"  WIDTH="5500"
			   SQL="select klrobaid, naziv as naziv from KlRoba where klklrobaid = @@klklrobaid order by naziv" ALLOWEMPTY="TRUE" CAPTION="Dodatna Klasa robe:"/>


		<INPUT TYPE="combo" NAME="DobavljacId"  CAPTION="Dobavljači:" WIDTH="5500"  SQL="select partneriid, naziv from partneri where 
			   partneriid in (select distinct dobavljacid from roba)"
	   ONLOSTFOCUS="" ALLOWEMPTY="TRUE" BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="combo"    NAME="robnamarkaid"   ALLOWEMPTY="TRUE" CAPTION="Robna marka:" WIDTH="5500" HEIGHT="320"
				  SQL="select max(robnamarkaid) as robnamarkaid, opis from robnamarka
					group by opis" />
		
		<INPUT TYPE="TRAZILICA" CAPTION="Roba" NAME="robaid"  TEXT="" WIDTH="5500"
		SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" />

		<INPUT TYPE="button" NAME="ok"      CAPTION="Dodaj"
				 ONCLICK="spMPPregArtng @action = 5, @operateriid = @@operateriid, @robaid=@@robaid#select 'refresh' as grdrobaOdabir#select '' as roba , 'robaid' as focus, robaid = null"   />

		<INPUT TYPE="grid"
			 NAME="grdrobaOdabir"
			   WIDTH="6000" HEIGHT="2000"
			 CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE"
			  PAGEHEADERLEFT=""
			  PAGEHEADERCENTER=""
			  PAGEHEADERRIGHT=""
			  PAGEFOOTERLEFT="@@TKOSMOMI"
			  SKIPDEFAULTLOAD="FALSE"
			  ONDBLCLICK="spMPPregArtng @action = 7, @operateriid = @@operateriid, @robaid = @(grdrobaOdabir..robaid)#select 'refresh' as grdrobaOdabir"
			  PAGEFOOTERCENTER=""
			  EDITCOLUMNS=""
			 GROUPBYBOXVISIBLE="FALSE"
			 ONCELLEDITED=""
			  PAGEFOOTERRIGHT="Jupiter software by Spin"
			  SQL="exec spMPPregArtng @action = 6, @operateriid = @@operateriid"   />

	

	</FILTERFORM>


	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Kartica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMPStanjeKarticaNG @action = 1, @robaid= @@gridgrdrobaOdabirrobaid, @operateriid = @@operateriid , @totalgen=1, @trgovinaid =@@trgovinaid , @datod = @@datumod, @datdo = @@datumdo "/>
	</KARTICA>

</PROJECT>
