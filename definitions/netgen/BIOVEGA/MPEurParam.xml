<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":UPDATEFORM" 
   CMD1CAPTION=""
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""   
   BUTTONS="Izmjeni:UPDATEFORM" 
   SETDEFAULTS=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK="" >


  <NAME>Ažuriranje parametara za Eur </NAME>
  <CAPTION>Ažuriranje parametara za Eur </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<UPDATEFORM 
		 HEIGHT="6200" 
         WIDTH="8000" 
         ONSUBMIT="" 
         ONLOAD="spmpEurParam @action = 1 " 
		 FOCUS="OIB"
         CAPTION="Izmjena podataka za Eur"  
		 >
		
		
	  	
		<INPUT TYPE="number" NAME="tecaj" CAPTION="Tečaj*" SQL="" TOP="1000" LEFT="3000" TABINDEX="1" HEIGHT="320" WIDTH="1000" ALLOWEMPTY="FALSE" ENABLED="TRUE" MAXLENGTH ="11" DECIMALS="5"/>
		<INPUT TYPE="date" NAME="datumdoeur" CAPTION="Početak dvojnog prikaza Jupiter*"  TOP="1500" LEFT="3000"  TABINDEX="2" ENABLED="TRUE" />
		<INPUT TYPE="date" NAME="datumkasadoeur" CAPTION="Početak dvojnog prikaza Kase*" TOP="2000" LEFT="3000"  TABINDEX="2" ENABLED="TRUE" />
		<INPUT TYPE="date" NAME="datumEur" CAPTION="Datum uvođenje Eur-a*" TOP="2500" LEFT="3000"  TABINDEX="2" ENABLED="TRUE" />
		<INPUT TYPE="date" NAME="datumkneur" CAPTION="Datum do plaćanja s KN *"  TOP="3000" LEFT="3000" TABINDEX="2" ENABLED="TRUE" />
		<INPUT TYPE="date" NAME="datumKnkraj" CAPTION="Datum kraja dvojnog prikaza*" TOP="3500" LEFT="3000"  TABINDEX="2" ENABLED="TRUE" />
		<INPUT TYPE="check" NAME="vratitikn" CAPTION="Povrat na kasi u KN*" TOP="4000" LEFT="3000"  TABINDEX="2" ENABLED="TRUE" DECIMALS="0" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="5000" LEFT="196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spmpEurParam @action=2, @datumdoeur = @@datumdoeur, @datumkasadoeur = @@datumkasadoeur, @datumeur = @@datumeur, @datumkneur = @@datumkneur, @datumknkraj = @@datumknkraj, @tecaj =@@tecaj, @vratitikn = @@vratitikn  #Ok"  />
		 <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5000" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</UPDATEFORM>



</PROJECT>
 
