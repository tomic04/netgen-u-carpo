<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  BUTTONS="Pokaži:FILTER#Proknjiži:MULTISELECT_Proknjiži"
		  CMD5CAPTION="Ispis:PRINTMASTER#REFRESHMASTER" 
		  ONLOAD=":FILTER" 
		  GROUPBYBOXVISIBLE="TRUE"
		  CHECKBOXVISIBLE="TRUE" 
		  TOTALROWVISIBLE="FALSE" 
		  DETCHECKBOXVISIBLE="FALSE" 
		  DETTOTALROWVISIBLE="FALSE">
<NAME>Preknjižavanje s konta na konto NG</NAME>
<CAPTION>Preknjižavanje s konta na konto</CAPTION>
<HISTORY>
20.05.2013. SPIN\atomic - ANAT
</HISTORY>

				  
				 
       


	<FILTER NAME="FILTER" HEIGHT="4738" WIDTH="7675" CAPTION="Izaberite parametre upita" ONSUBMIT="spKntPreknjizavanjeNG @action=1," FILLEXPLORER="TRUE">
	
	<INPUT TYPE="search" NAME="PartneriId" TOP="648" LEFT="1728" HEIGHT="302" WIDTH="5515" SQL="Partneri#partneriid#naziv%"/>
	<INPUT TYPE="label" NAME="Label90" TOP="648" LEFT="202" HEIGHT="288" WIDTH="1411" CAPTION="Partner:" TEXT="Label90"/>
	
	<INPUT TYPE="combo" NAME="KntPlanA1Id" TOP="1138" LEFT="1728" HEIGHT="302" WIDTH="5530" SQL="select distinct p.kntplanaid,
																		ltrim(rtrim(p.konto))+' - '+ltrim(rtrim(p.naziv))+' - '+ ltrim(rtrim(coalesce(g.VrstaKonta,'Običan konto'))) as [Naziv] 
																		from kntplana p 
																		inner join kntvrsta g on p.kntvrstaid=g.kntvrstaid 
																		where g.tablica!='Partneri' 
																		order by naziv" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="label" NAME="Label90" TOP="1138" LEFT="202" HEIGHT="288" WIDTH="1397" CAPTION="Stari konto:" TEXT="Label90"/>
	
	<INPUT TYPE="combo" NAME="KntPlanA2Id" TOP="1627" LEFT="1728" HEIGHT="302" WIDTH="5530" SQL="select distinct p.kntplanaid,
																		ltrim(rtrim(p.konto))+' - '+ltrim(rtrim(p.naziv))+' - '+ ltrim(rtrim(coalesce(g.VrstaKonta,'Običan konto'))) as [Naziv] 
																		from kntplana p 
																		left outer join kntvrsta g on p.kntvrstaid=g.kntvrstaid 
																		order by naziv" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="label" NAME="Label90" TOP="1627" LEFT="202" HEIGHT="288" WIDTH="1382" CAPTION="Novi konto:" TEXT="Label90"/>
	
	<INPUT TYPE="combo" NAME="Vrstadokid" TOP="2102" LEFT="1728" HEIGHT="302" WIDTH="5530" SQL="select distinct vd.vrstadokid,
																		ltrim(rtrim(vd.opis)) as [Naziv] 
																		from vrstadok vd 
																		inner join vrstaprom vp on vp.vrstapromid=vd.vrstapromid 
																		where vp.sifra='57' 
																		order by naziv" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="label" NAME="Label90" TOP="2102" LEFT="202" HEIGHT="288" WIDTH="1426" CAPTION="Vrsta temeljnice:" TEXT="Label90"/>
	
	<INPUT TYPE="date" NAME="DatumKnjizenja" TOP="2520" LEFT="1728" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="label" NAME="Label90" TOP="2534" LEFT="202" HEIGHT="288" WIDTH="1469" CAPTION="Datum knjiženja:" TEXT="Label90"/>
	
	<INPUT TYPE="button" NAME="ButtonNG7" TOP="3528" LEFT="3830" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="Prihvati" TOP="3528" LEFT="2448" HEIGHT="331" WIDTH="1080" TEXT="Prihvati" CAPTION="Prihvati" ONCLICK="OK"/>

</FILTER>

<MULTISELECT_Proknjiži NAME="Proknjiži" HEIGHT="2621" WIDTH="5112" CAPTION="Preknjižavanje s konta na konto" ONSUBMIT="spKntPreknjizavanjeNG @action=2, @ssoperateriid=@@operateriid">
	<INPUT TYPE="label" NAME="Label70" TOP="446" LEFT="374" HEIGHT="288" WIDTH="4090" CAPTION="Želite li preknjižiti odabrane račune s konta na konto?"/>
	<INPUT TYPE="button" NAME="ButtonNG0" TOP="1267" LEFT="1195" HEIGHT="302" WIDTH="1080" TEXT="Proknjiži" CAPTION="Proknjiži" ONCLICK="OK" DECIMALS="2"/>
	<INPUT TYPE="button" NAME="ButtonNG1" TOP="1267" LEFT="2549" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" ONCLICK="CLOSE"/>

</MULTISELECT_Proknjiži>
</PROJECT>