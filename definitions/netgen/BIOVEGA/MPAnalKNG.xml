<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""
		GROUPBYBOXVISIBLE="FALSE"
		CHECKBOXVISIBLE="FALSE"
		CMD7CAPTION="Lista"  
		CMD8CAPTION=""
		COMMANDTIMEOUT="500"
		MASTERDBLCLICK="KARTICA"
	        POPUPMASTER=""> 
 

  <NAME>Analiza kartica robe</NAME>
  <CAPTION>Analiza kartica robe</CAPTION>
  

  <FORM1 	
	    FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spMPStanjeQueryNG @action=500, @kartica = 1, @komisija = 2," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@skladisteid as skladisteid, @@neispravno as neispravno" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


                     	<INPUT TYPE="combo" 
                                     	NAME="skladisteid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid=@@operateriid"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>
			

			<INPUT TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 
					


			<INPUT TYPE="VB.checkbox" 
                                   	NAME="neispravno" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
									TABINDEX="5" 
                               		CAPTION="Samo neispravne kartice "/>

  </FORM1>

 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="17000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe"
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="" 
		CMD5CAPTION="" 
		CMD6CAPTION="" 
		
		CHILDFORM=""> 

			<INPUT TYPE="grid" NAME="kartica" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="16500" HEIGHT="8000" TABINDEX="2" CHECKBOXVISIBLE="FALSE"
		 TOTALROW="FALSE" DETTOTALROWVISIBLE="FALSE" GROUPBYBOXVISIBLE="FALSE"
                         SQL="spMPStanjeKarticaNG @action = 1, @robaid = @@id, @prikaz= 0, @trgovinaid = @@skladisteid, @datumod = @@datumod, @datumdo = @@datumdo, @totalgen= 1,@operateriid = @@operateriid " />
	 
	 <INPUT TYPE="button" NAME="cancel" TABINDEX="16" CAPTION="Kraj" TOP="8500" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />
	 <INPUT TYPE="button" NAME="cijena" TABINDEX="16" CAPTION="Cijena" TOP="8500" LEFT="3000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENIFORM"  />
	 <INPUT TYPE="button" NAME="Staracij" TABINDEX="16" CAPTION="Stara cij" TOP="8500" LEFT="5000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTARUMPC"  />
	 <INPUT TYPE="button" NAME="Kolicina" TABINDEX="16" CAPTION="Količina" TOP="8500" LEFT="7000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENIKOL"  />
	 <INPUT TYPE="button" NAME="KolicinaA" TABINDEX="16" CAPTION="Količina A-niv" TOP="8500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENIKOLA"  />
	 <INPUT TYPE="button" NAME="StaracijA" TABINDEX="16" CAPTION="Stara Cij A-niv" TOP="8500" LEFT="11000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTARUMPCA"  />

 </KARTICA>

	<IZMJENIFORM
	  WIDTH="5500" 
	  ONSUBMIT="spMPKontrolaNivelacijaNG @action=8, @maloprodajadetid = @@gridkarticamaloprodajadetid, @vrstadok = '@@gridkarticaVrsta_dokumenta' ," 
	  ONLOAD="if @@gridkarticamaloprodajadetid is not null begin 
				select mpcijena as cijena from maloprodajadet where maloprodajadetid = @@gridkarticamaloprodajadetid
				end
				else begin 
					exec spRaiserror 69001, 'Niste odabrali dokumant nivelacije!'	   
				end "
	  HEIGHT="2500" 
	  CAPTION="Izmjeni cijenu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<INPUT TYPE="number" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENIFORM>
	<IZMJENIKOL
	  WIDTH="5500"
	  ONSUBMIT="spMPKontrolaNivelacijaNG @action=15, @stavke = @@gridkarticamaloprodajadetid, @vrstadok = '@@gridkarticaVrsta_dokumenta' , "
	  ONLOAD="if @@gridkarticamaloprodajadetid is not null begin 
					select kolicinaulaz as kolicina from maloprodajadet where maloprodajadetid= @@gridkarticamaloprodajadetid
				end
				else begin 
					exec spRaiserror 69001, 'Niste odabrali dokumant nivelacije !'	   
				end"
	  HEIGHT="2500"
	  CAPTION="Izmjeni količinu"
	  CMD1CAPTION="Spremi"
	  CMD2CAPTION="Odustani"
	  FILLEXPLORER="">

		<INPUT TYPE="number" NAME="kolicina" CAPTION="Kolicina" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENIKOL>

	<IZMJENIKOLA
	  WIDTH="5500" 
	  ONSUBMIT="spMPKontrolaNivelacijaNG @action=13, @stavke = @@kartica, @vrstadok = '@@gridkarticaVrsta_dokumenta' ," 
	  ONLOAD="if @@gridkarticampniveldetid is not null begin 
					select kolicinaulaz as kolicina from mpniveldet where mpniveldetid= @@gridkarticampniveldetid
				end
				else begin 
					exec spRaiserror 69001, 'Niste odabrali A-nivelaciju!'	   
				end"
	  HEIGHT="2500" 
	  CAPTION="Izmjeni količinu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<INPUT TYPE="number" NAME="kolicina" CAPTION="Kolicina" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENIKOLA>

	<IZMJENISTARUMPC
	  WIDTH="5500" 
	  ONSUBMIT="spMPKontrolaNivelacijaNG @action=9, @stavke = @@gridkarticamaloprodajadetid, @vrstadok = '@@gridkarticaVrsta_dokumenta' ," 
	  ONLOAD="if @@gridkarticamaloprodajadetid is not null begin
					select nabcijena as cijena from maloprodajadet where maloprodajadetid = @@gridkarticamaloprodajadetid
				end
				else begin 
					exec spRaiserror 69001, 'Niste odabrali dokumant nivelacije !'	   
				end"	
	  HEIGHT="2500" 
	  CAPTION="Izmjeni cijenu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<INPUT TYPE="number" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENISTARUMPC>

	<IZMJENISTARUMPCA
	  WIDTH="5500"
	  ONSUBMIT="spMPKontrolaNivelacijaNG @action=14, @stavke = @@kartica, @ANIV = 1, @vrstadok = '@@gridkarticaVrsta_dokumenta' ,"
	  ONLOAD="if @@gridkarticampniveldetid is not null begin 
					select nabcijena+povnaknadaroba as cijena from mpniveldet where mpniveldetid = @@gridkarticampniveldetid
				end
				else begin 
					exec spRaiserror 69001, 'Niste odabrali A-NIvelaciju!'	   
				end"
	  HEIGHT="2500"
	  CAPTION="Izmjeni cijenu"
	  CMD1CAPTION="Spremi"
	  CMD2CAPTION="Odustani"
	  FILLEXPLORER="">

		<INPUT TYPE="number" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENISTARUMPCA>

</PROJECT> 