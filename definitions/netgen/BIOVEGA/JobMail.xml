<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM " 
		 DETAILGRID = "spJobMailAzur @action = 5, @id = @@id "
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 BUTTONS="Uvjeti:FILTERFORM#Dodaj:INSERT_FORM#Izmjeni:UPDATE_FORM#(de)Aktiviranje:STATUS#Mail lista:MAILLISTA#Pregled:PREGLED" 
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Definiranje izvještaja za slanje mail-om</NAME>
	<CAPTION>Definiranje izvještaja za slanje mail-om</CAPTION>
	<AUTOR>6.7.2009. Pekić Dražen </AUTOR>




	<FILTERFORM NAME="FILTERFORM"
			 HEIGHT="2700"
			 WIDTH="7700"
			 CAPTION="Uvjeti pregleda "
			 FILLEXPLORER="TRUE"
			 ONSUBMIT="spJobMailAzur @action = 1,"
			 ONLOAD=" "
			 NEXTFORM=""
			 FOCUS=""
			 CMD1CAPTION="Pokaži"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="projekt"         CAPTION="Projekt"   
			   SQL =" select distinct g.projekt, 
						naziv = case 
						when g.projekt= 'M' then 'Maloprodaja'
						when g.projekt = 'G' then 'Govedarstvo' 
						when g.projekt = 'R' then 'Ribnjačarstvo'
						when g.projekt = 'SV' then 'Svinjogojstvo'
						when g.projekt = 'KN' then 'Kontor'
						when g.projekt = 'KOM' then 'Komercijala'
						else 'Neraspoređeno' end  from JOBMail g" ENABLED="TRUE"  ALLOWEMPTY ="TRUE" STYLE="1" WIDTH="3800"  />


	</FILTERFORM>


	<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Unos izvještaja"
		 ONSUBMIT=""
		 ONLOAD=" " 
		 NEXTFORM=""
		 FOCUS="rbr" 
		 CMD1CAPTION="" 
		 CMD2CAPTION="" >

		<INPUT TYPE="text"    NAME="sifra"         CAPTION="Šifra"   ENABLED="TRUE"  STYLE="1" WIDTH="800"  />
		<INPUT TYPE="text"    NAME="opis"         CAPTION="Opis izvještaja"   ENABLED="TRUE"  WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="stora"         CAPTION="Sored procedure"   ENABLED="TRUE"  WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="projekt"         CAPTION="Prijekt"   ENABLED="TRUE"  WIDTH="500"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi"  TOP="2100" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 2 , @projekt = '@@projekt', @sifra = '@@sifra', @opis = '@@opis', @stora = '@@stora' #Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2100" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


</INSERT_FORM>

	<UPDATE_FORM NAME="UPDATE_FORM"
		 HEIGHT="3500"
		 WIDTH="7700"
		 CAPTION="Unos izvještaja"
		 ONSUBMIT=""
		 ONLOAD=" select * from jobmail where jobmailid = @@id"
		 NEXTFORM=""
		 FOCUS="rbr"
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

		<INPUT TYPE="text"    NAME="sifra"         CAPTION="Šifra"   ENABLED="TRUE"  STYLE="1" WIDTH="800"  />
		<INPUT TYPE="text"    NAME="opis"         CAPTION="Opis izvještaja"   ENABLED="TRUE"  WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="stora"         CAPTION="Sored procedure"   ENABLED="TRUE"  WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="projekt"         CAPTION="Prijekt"   ENABLED="TRUE"  WIDTH="500"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi"  TOP="2100" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 3, @projekt = '@@projekt', @sifra = '@@sifra', @opis = '@@opis', @stora = '@@stora' , @id = @@id  #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2100" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</UPDATE_FORM>

	<STATUS NAME="STATUS"
		 HEIGHT="3500"
		 WIDTH="7700"
		 CAPTION="Brisanje izvještaja"
		 ONSUBMIT=""
		 ONLOAD=" select *, case when status = 0 then 'Neaktivan' else 'Aktivan' end as statust from jobmail where jobmailid = @@id"
		 NEXTFORM=""
		 FOCUS="rbr"
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

		<INPUT TYPE="text"    NAME="sifra"         CAPTION="Šifra"   ENABLED="FALSE"  STYLE="1" WIDTH="800"  />
		<INPUT TYPE="text"    NAME="opis"         CAPTION="Opis izvještaja"   ENABLED="FALSE"  STYLE="1" WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="stora"         CAPTION="Sored procedure"   ENABLED="FALSE"  STYLE="1" WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="projekt"         CAPTION="Prijekt"   ENABLED="FALSE"  STYLE="1" WIDTH="500"  />
		<INPUT TYPE="text"    NAME="statust"         CAPTION="Status"   ENABLED="FALSE"  STYLE="1" WIDTH="1500"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Promjeni status"  TOP="2300" LEFT="1196" WIDTH="1506" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 4, @id = @@id  #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



	</STATUS>

	<MAILLISTA NAME="MAILLISTA"
		 HEIGHT="7500"
		 WIDTH="9000"
		 CAPTION="Mail lista"
		 ONSUBMIT=""
		 ONLOAD=" select *, case when status = 0 then 'Neaktivan' else 'Aktivan' end as statust from jobmail where jobmailid = @@id"
		 NEXTFORM=""
		 FOCUS="rbr"
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

		<INPUT TYPE="text"    NAME="sifra"         CAPTION="Šifra"   ENABLED="FALSE"  STYLE="1" WIDTH="800"  />
		<INPUT TYPE="text"    NAME="opis"         CAPTION="Opis izvještaja"   ENABLED="FALSE"  STYLE="1" WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="stora"         CAPTION="Sored procedure"   ENABLED="FALSE"  STYLE="1" WIDTH="4000"  />
		<INPUT TYPE="text"    NAME="projekt"         CAPTION="Prijekt"   ENABLED="FALSE"  STYLE="1" WIDTH="500"  />
		<INPUT TYPE="text"    NAME="statust"         CAPTION="Status"   ENABLED="FALSE"  STYLE="1" WIDTH="1500"  />

		<INPUT TYPE="grid"
	   NAME="maillista"
	   REFRESHAFTERCHILD="TRUE"
	   CAPTION="Stavke"
	   TOP="2500" LEFT="500" WIDTH="6300" HEIGHT="2800"
	   TABINDEX="-1"
	   AFTERREFRESH=""
	   POPUP=""
	   ONDBLCLICK=""
	   EDITCOLUMNS=""
	   ONCELLEDITED=""
	   DETCHECKBOXVISIBLE="FALSE"
	   CHECKBOXVISIBLE="FALSE"
	   PAGEHEADERCENTER=""
	   PAGEHEADERRIGHT=""
	   PAGEHEADERLEFT="Datum: @@datum##Farma: @@stfarmeid"
	   PAGEFOOTERCENTER=""
	   PAGEFOOTERLEFT=""
	   PAGEFOOTERRIGHT="@@thosmomi"
	   PAGEORIENTATION="LANDSCAPE"
	   GROUPBYBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"
	   SQL="spJobMailAzur @action=5,@id=@@id " />
		<INPUT TYPE="button" NAME="dodaj" CAPTION="Dodaj" TOP="6300" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK=":DODAJMAIL"  />
		<INPUT TYPE="button" NAME="Izmjeni" CAPTION="Izmjeni" TOP="6300" LEFT="2500" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENIMAIL"  />
		<INPUT TYPE="button" NAME="obriš" CAPTION="Obriši" TOP="6300" LEFT="4000" WIDTH="1400" HEIGHT="322" ONCLICK=":BRISIMAIL"  />


		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6300" LEFT="5500" WIDTH="1106" HEIGHT="322" ONCLICK="OK"  />



	</MAILLISTA>

	<DODAJMAIL NAME="DODAJMAIL"
	 HEIGHT="3500"
	 WIDTH="7700"
	 CAPTION="Unos operatera i mail-a "
	 ONSUBMIT=""
	 ONLOAD=" "
	 NEXTFORM=""
	 FOCUS="rbr"
	 CMD1CAPTION=""
	 CMD2CAPTION="" >

		<INPUT TYPE="combo"    NAME="ooperateriid "         CAPTION="Operater"   SQL="select operateriid , naziv from ssoperateri order by naziv" ENABLED="TRUE"  STYLE="1" WIDTH="3800"  />
		<INPUT TYPE="text"    NAME="email"         CAPTION="E-mail"   ENABLED="TRUE"  WIDTH="4000"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi"  TOP="2100" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 6 , @operateriid= @@ooperateriid, @email= '@@email' , @id = @@id#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2100" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		
	</DODAJMAIL>

	<IZMJENIMAIL NAME="IZMJENIMAIL"
	 HEIGHT="3500"
	 WIDTH="7700"
	 CAPTION="Izmjena operatera i mail-a "
	 ONSUBMIT=""
	 ONLOAD="spJobMailAzur @action = 8, @id = @@maillista"
	 NEXTFORM=""
	 FOCUS="rbr"
	 CMD1CAPTION=""
	 CMD2CAPTION="" >

		<INPUT TYPE="combo"    NAME="ooperateriid "         CAPTION="Operater"   SQL="select operateriid , naziv from ssoperateri order by naziv" ENABLED="TRUE"  STYLE="1" WIDTH="3800"  />
		<INPUT TYPE="text"    NAME="email"         CAPTION="E-mail"   ENABLED="TRUE"  WIDTH="4000"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi"  TOP="2100" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 7 , @operateriid= @@ooperateriid, @email= '@@email' , @id = @@maillista#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2100" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</IZMJENIMAIL>

	<BRISIMAIL NAME="BRISIMAIL"
	 HEIGHT="3500"
	 WIDTH="7700"
	 CAPTION="Brisanje operatera i mail-a "
	 ONSUBMIT=""
	 ONLOAD="spJobMailAzur @action = 8, @id = @@maillista"
	 NEXTFORM=""
	 FOCUS="rbr"
	 CMD1CAPTION=""
	 CMD2CAPTION="" >

		<INPUT TYPE="combo"    NAME="ooperateriid "         CAPTION="Operater"   SQL="select operateriid , naziv from ssoperateri order by naziv" ENABLED="FALSE"  STYLE="1" WIDTH="3800"  />
		<INPUT TYPE="text"    NAME="email"         CAPTION="E-mail"   ENABLED="FALSE"  WIDTH="4000"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Obriši"  TOP="2100" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spJobMailAzur @action = 9 , @id = @@maillista#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2100" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</BRISIMAIL>

	<PREGLED NAME="STATUS"
			 HEIGHT="11000"
			 WIDTH="13700"
			 CAPTION="Pregled izvještaja"
			 ONSUBMIT=""
			 ONLOAD=" select * from jobmail where jobmailid = @@id"
			 NEXTFORM=""
			 FOCUS="rbr"
			 CMD1CAPTION=""
			 CMD2CAPTION="" >

		<INPUT TYPE="text"    NAME="sifra"         CAPTION="Šifra"   ENABLED="FALSE"  STYLE="1" WIDTH="800"  />
		<INPUT TYPE="text"    NAME="opis"         CAPTION="Opis izvještaja"   ENABLED="FALSE"  STYLE="1" WIDTH="4000"  />
		<INPUT TYPE="grid"
	   NAME="maillista"
	   REFRESHAFTERCHILD="TRUE"
	   CAPTION="Stavke"
	   TOP="1300" LEFT="500" WIDTH="12800" HEIGHT="8500"
	   TABINDEX="-1"
	   AFTERREFRESH=""
	   POPUP=""
	   ONDBLCLICK=""
	   EDITCOLUMNS=""
	   ONCELLEDITED=""
	   DETCHECKBOXVISIBLE="FALSE"
	   CHECKBOXVISIBLE="FALSE"
	   PAGEHEADERCENTER=""
	   PAGEHEADERRIGHT=""
	   PAGEHEADERLEFT="Datum: @@datum##Farma: @@stfarmeid"
	   PAGEFOOTERCENTER=""
	   PAGEFOOTERLEFT=""
	   PAGEFOOTERRIGHT="@@thosmomi"
	   PAGEORIENTATION="LANDSCAPE"
	   GROUPBYBOXVISIBLE="FALSE"
	   TOTALROW="FALSE"
	   SQL="spJobMail @action=3,@sifra='@@sifra' " />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="10000" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



	</PREGLED>

</PROJECT>