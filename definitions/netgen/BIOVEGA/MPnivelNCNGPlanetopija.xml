	<INPUT TYPE="number" NAME="rabatdp" CAPTION="Novi ulazni rabat %*" TOP="1300" LEFT="2000" WIDTH="1500" HEIGHT="320" DECIMALS="2"
		    ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 3, @@fakcijena, @@rabatdp, @@rabat2p, @@rabat3p, @@cijena) as cijena, 'cijena' as focus "/>
	<INPUT TYPE="number" NAME="cijena" CAPTION="Nova nabavna cijena*" TOP="1700" LEFT="2000" WIDTH="1500" HEIGHT="320" DECIMALS="2"
		   ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 1, @@fakcijena, @@rabatdp, @@rabat2p, @@rabat3p, @@cijena) as rabatdp, 'ok' as focus "/>
	<INPUT TOP="-5000" TYPE="number" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" DECIMALS="2" />
	<INPUT TOP="-5000" TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" />
