<UPDATEFORM 
	WIDTH="11000" 
	ONSUBMIT="" 
	ONLOAD="if (select vezanicjenikid from TempPromNC where TempPromNCId=@@id) is not null begin 
				exec spRaiserror 69001, &apos;Ne možete ispravljati cijenu na vezanom cjeniku !&apos;
			end
			else begin
			if coalesce(@@id,0) = 0 begin 
				exec spRaiserror 69001, &apos;Nemate šta mijenjati  !&apos;
			end
			else begin
			if (select coalesce(akcija,0) from TempPromNC where TempPromNCId=@@id) =1 begin 
				exec spRaiserror 69001, &apos;Budući da se radi o akciji, podaci nisu dostupni za ispravak ! Potrebno je obrisati početak i kraj akcije i unijeti ponovno ispravne podatke !&apos;
			end
			else begin
			exec spMPNivelacijaNCNG @action=12, @datumdok=@@datumdok, @robaid=@@robaid, @TempPromNCId=@@id
			end end end" 
	ONLOADED="if (select coalesce(akcija,0) from TempPromNC where TempPromNCId=@@id) = 2 begin
				select 'disable' as nabcijena, 'disable' as marza, 'disable' as cijena end"
	HEIGHT="5500" 
	CAPTION="Izmjena nivelacije"  
	FILLEXPLORER="" >

	<INPUT TYPE="text" CAPTION="Roba:*" NAME="roba" TOP="500" LEFT="1000" SQL="" WIDTH="7000" HEIGHT="320" ENABLED="FALSE" />
	<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum nivelacije:*" TOP="1000" LEFT="2000" VALUE="DATE" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" 
		    ONLOSTFOCUS="if day(@@datumdok)=1 and month(@@datumdok)=1 begin 
							exec spRaiserror 69001, &apos;Upozorenje: izabrali ste datum početka godine, što nije moguće zbog početnog stanja!&apos;
						end"/>
	<INPUT TYPE="check" NAME="akcija" CAPTION="Akcija*" VALUE="" TOP="1000" LEFT="4000 " HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" ONCLICK="" ONLOSTFOCUS="" ENABLED="FALSE"/>

	<INPUT TYPE="number" NAME="staracijena" ONLOSTFOCUS="" ENABLED="FALSE" CAPTION="Stara nabavna cijena*" TOP="1500" LEFT="4500" WIDTH="1500" HEIGHT="320" DECIMALS="2" />
	<INPUT TYPE="number" NAME="Fakcijena" CAPTION="Nova fakturna cijena*" TOP="1900" LEFT="4500" WIDTH="1500" HEIGHT="320"  DECIMALS="2"
		   ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 2, @@fakcijena, @@rabatdp, @@cijena) as cijena, 'rabatdp' as focus "/>
	<INPUT TYPE="number" NAME="rabatdp" CAPTION="Novi ulazni rabat %*" TOP="2300" LEFT="4500" WIDTH="1500" HEIGHT="320" DECIMALS="2"
		    ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 3, @@fakcijena, @@rabatdp, @@cijena) as cijena, 'cijena' as focus "/>
	<INPUT TYPE="number" NAME="cijena" CAPTION="Nova nabavna cijena*" TOP="2700" LEFT="4500" WIDTH="1500" HEIGHT="320" DECIMALS="2"
		   ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 1, @@fakcijena, @@rabatdp, @@cijena) as rabatdp, 'ok' as focus "/>

	<INPUT TOP="-5000" TYPE="number" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" DECIMALS="0" />
	<INPUT TOP="-5000" TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" />
	<INPUT TOP="-5000" TYPE="number" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" DECIMALS="2" />
	<INPUT TOP="-5000" TYPE="number" NAME="TempPromNCid" CAPTION="TempPromNCid" TEXT="" WIDTH="2500" HEIGHT="320" DECIMALS="0" />
	<INPUT TOP="-5000" TYPE="number" NAME="vrcjenikid" ALOWEMPTY ="FALSE" CAPTION="vrcjenikid" TEXT="" WIDTH="2500" HEIGHT="320" DECIMALS="0" />
	
	<INPUT TYPE="button" NAME="ok" CAPTION="Spremi " TOP="3500" LEFT="196" WIDTH="1106" HEIGHT="322" 
		   ONCLICK="spMPNivelacijaNCNG @action=1, @robaid=@@robaid, @TempPromNCid=@@id, @datumdok=@@datumdok, @cijena=@@cijena, @operateriid=@@operateriid, @Fakcijena=@@Fakcijena, @rabatdp=@@rabatdp#Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</UPDATEFORM>

	

<DELETEFORM
	WIDTH="5500" 
	ONSUBMIT="spMPNivelacijaNCNG @action=11, @TempPromNCid=@@id, " 
	ONLOAD="if (select vezanicjenikid from TempPromNC where TempPromNCId=@@id) is not null begin 
				exec spRaiserror 69001, &apos;Ne možete brisati cijenu na vezanom cjeniku !&apos;
			end else begin 
			if coalesce(@@id,0) = 0 begin 
				exec spRaiserror 69001, &apos;Nema podataka za brisanje !&apos;
			end else begin 
				select 1 as jedanart, 0 as sviart, (select rtrim(cast(userid as varchar)) + ' ' +naziv as Naziv from roba where robaid = (select robaid from TempPromNC where TempPromNCid=@@id)) as pitanje
			end end "	
	HEIGHT="3000" 
	CAPTION="Obrisati ?" 
	CMD1CAPTION="Obriši"
