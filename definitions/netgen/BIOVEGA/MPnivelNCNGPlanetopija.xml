	<INPUT TYPE="button" NAME="cancel" CAPTION="Gotovo" TOP="5500" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="ok" CAPTION="Izmjeni nab.uvjete robe u odabranom cjeniku" TOP="5300" LEFT="3500" WIDTH="2000" HEIGHT="644" 
		   ONCLICK=":IZMJENI1ROBU"  />
</DODAJFORM>



