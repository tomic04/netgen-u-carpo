<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
ONLOAD="spMPNivelacijaNCNG @action=3, @operateriid=@@operateriid" 
BUTTONS="Dodaj novu izmjenu nab.uvjeta:FORM1#Obriši odabrane izmjene nab.uvjeta:MULTISELECTDELETEFORM#Izmjeni odabranu stavku:UPDATEFORM#Proknjiži SVE izmjene nab.uvjeta:PROKNJIZIFORM#Pregled cjenika:DAJCJENIK"
POPUPMASTERnePotrebanTEST="Izmjeni datum odabranim izmjenama nab.cijene:MULTISELECTUPDATEDATUM"
MASTERDBLCLICK="UPDATEFORM"
CHECKBOXVISIBLE="TRUE"
GROUPBYBOXVISIBLE="TRUE"
TOTALROWVISIBLE="FALSE">
 
<NAME>Izmjena nabavnih uvjeta u cjeniku </NAME>
<CAPTION>Izmjena nabavnih uvjeta u cjeniku </CAPTION>
 
<KOMENTAR> </KOMENTAR>
<AUTOR> Ksenija Čavec 20181024 </AUTOR>


<FORM1
	NAME="FORM1"
	HEIGHT="3500"
	WIDTH="7502"
	ONLOAD=""
	CAPTION="Unos novih nabavnih uvjeta robe">

	<INPUT TYPE="button" NAME="ok"     CAPTION="Pojedinačni unos nab.uvjeta za 1 robu" TOP="500" LEFT="456" WIDTH="4000" HEIGHT="322" ONCLICK=":DODAJFORM(@robaid=null,@TempPromNCid=null)#OK"  HOTKEY="" />
	<INPUT TYPE="button" NAME="ok"     CAPTION="Izmjena nab.uvjeta za više roba" TOP="1000" LEFT="456" WIDTH="4000" HEIGHT="322" ONCLICK=":DODAJFORMZBIRNO(@robaid=null)#OK"  HOTKEY="" />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="5500" WIDTH="1106" HEIGHT="322" ONCLICK="close" />

</FORM1>


<DODAJFORMZBIRNO
	WIDTH="15000"
	ONSUBMIT=""
	ONLOAD="select convert(datetime,convert(varchar(12),getdate()+1)) as dat3, null as robaid, null as search, null as klasaid, null as podklase, 0 as rabatdp"
	ONLOADED="select convert(varchar(10),@@dat3+1,104) as DatDo, 0 as akcija#select 'disable' as DatDo"
	HEIGHT="9500"
	CAPTION="Nova nivelacija nab.cijene"
	FILLEXPLORER="" >

	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="400" LEFT="2000" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" SQL=" spMPDajTrgovinaKomisija @operateriid=@@operateriid"/>
	<INPUT TYPE="date" NAME="dat3" CAPTION="Datum nivelacije NC:*" VALUE="DATE" TOP="750" LEFT="2000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" ONLOSTFOCUS=""/>
	<INPUT TYPE="check" NAME="akcija" CAPTION="Akcija*" VALUE="" TOP="780" LEFT="4000 " HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"
				 ONCLICK="if @@akcija = 1 begin select 'enable' as DatDo end#if @@akcija = 0 begin select 'disable' as DatDo end#select convert(varchar(10),@@dat3+1,112) as DatDo#select @@DatDo as DatDo" ONLOSTFOCUS="" />
	<INPUT TYPE="date" NAME="DatDo" CAPTION="Datum do kada vrijedi promjena nab.cijene:*" VALUE="DATE" TOP="750" LEFT="8000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" ONCLICK=""
		   ONLOSTFOCUS="if day(@@DatDo)=1 and month(@@DatDo)=1 begin 
								exec spRaiserror 69001, &apos;Upozorenje: kao kraj akcije izabrali ste datum početka godine, što nije moguće zbog početnog stanja!&apos;
							end" />
	<INPUT TYPE="number" NAME="rabatdp" CAPTION="Novi ulazni rabat:*" TOP="1100" LEFT="2000" WIDTH="1000" HEIGHT="320" DECIMALS="2" ONLOSTFOCUS=""/>

	<INPUT TYPE="number" NAME="rabat2p" CAPTION="Novi ulazni rabat 2 %*" TOP="1100" LEFT="5000" WIDTH="1000" HEIGHT="320" DECIMALS="2"
		ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 3, @@fakcijena, @@rabatdp, @@rabat2p, @@rabat3p, @@cijena) as cijena, 'rabat3p' as focus "/>
	<INPUT TYPE="number" NAME="rabat3p" CAPTION="Novi ulazni rabat 3 %*" TOP="1100" LEFT="8000" WIDTH="1000" HEIGHT="320" DECIMALS="2"
		ONLOSTFOCUS="select [dbo].[fnMPNCKalkNEW] (@@robaid, 3, @@fakcijena, @@rabatdp, @@rabat2p, @@rabat3p, @@cijena) as cijena, 'cijena' as focus "/>
	
	<INPUT TYPE="text" CAPTION="Traženje pojma:*" NAME="search" TOP="1450" LEFT="2000" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" />
	<INPUT TYPE="combo" CAPTION="Klasa:*" NAME="klasaid" TOP="1800" LEFT="2000" WIDTH="7500" HEIGHT="320"
		   SQL="select KlMasterRobaId, rtrim(oznaka)+' '+naziv as naziv from KlMasterRoba order by sortkey" ALLOWEMPTY="TRUE" />
	<INPUT TYPE="checkbox" NAME="podklase" TOP="2150" LEFT="2500" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase"/>

	<INPUT TYPE="button" NAME="ok" CAPTION="POKAŽI ROBU" TOP="2100" LEFT="11500" WIDTH="2000" HEIGHT="322" 
		   ONCLICK="select 'refresh' as grid1"  />

	<INPUT TYPE="grid"
				NAME="grid1"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="Odabrana roba*"
				SKIPDEFAULTLOAD="TRUE"
				TOP="2500"
				LEFT="1500"
				WIDTH="12800"
				HEIGHT="5500"
				CHECKBOXVISIBLE="FALSE"
				EDITCOLUMNSne="[Nova fak.cijena1000],[Novi ulazni rabat %1000],[Nova nab.cijena1000]"
				ONCELLEDITEDne="spMPnivelacijaNCNG @action=16, @novacijena=@(grid1..Nova nab.cijena1000), @fakcijena=@(grid1..Nova fak.cijena1000), @rabatdp=@(grid1..Novi ulazni rabat %1000), @robaid=@@grid1, @vrcjenikid=@@vrcjenikid#select 'grid1' as focus"
				ENTERKEYBEHAVIOR="1"
				ONENTERKEYne="select [dbo].[fnMPNCKalkNEW] (@@grid1, 2, @(grid1..Nova fak.cijena1000), @(grid1..Novi ulazni rabat %1000), @(grid1..Nova nab.cijena1000)) as [Nova nab.cijena1000]"
				SQL="spMPnivelacijaNCNG @action=15, @operateriid=@@operateriid, @search='@@search', @klasaid=@@klasaid, @podklase=@@podklase, @trgovinaid=@@trgovinaid, @datumdok=@@dat3, @rabatdp=@@rabatdp, @rabat2p=@@rabat2p, @rabat3p=@@rabat3p, @akcija=@@akcija, @datdo=@@datdo"
				TOTALROW="FALSE"/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Gotovo" TOP="8300" LEFT="300" WIDTH="1106" HEIGHT="322"
			ONCLICK="spMPnivelacijaNCNG @action=17, @operateriid=@@operateriid, @datumdok=@@dat3, @trgovinaid=@@trgovinaid, @akcija = @@akcija, @DatDo=@@DatDo#Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8300" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</DODAJFORMZBIRNO>



<DODAJFORM
	WIDTH="11000"
	ONSUBMIT=""
	ONLOAD="select convert(varchar(10),getdate()+1,112) as dat3, null as robaid, null as TempPromNCid"
	HEIGHT="6500"
	CAPTION="Nova nivelacija nabavnih uvjeta"
	FILLEXPLORER="">

	<INPUT TYPE="search" CAPTION="Roba:*" NAME="robaid" SQL="spMPRobaZaMPNG @trazi='@@searchboxrobaid' " ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid=@@robaid#select 'refresh' as stavke" ALLOWEMPTY="FALSE" TOP="500" LEFT="1000" WIDTH="9000" HEIGHT="320" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
