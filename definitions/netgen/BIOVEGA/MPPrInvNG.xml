<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT=""  	
		CMD1CAPTION="Parametri:FORM1"
		CMD2CAPTION="Detali INV.:DETALJI"
		CMD5CAPTION="Ispis:rs:/Biovega/MPDokumenti/rptMPPregInv(@operateriid = @@operateriid, @trgovinaid = @@zaispistrgovinaid, @robaid = @@zaispisrobaid, @klasaid = @@zaispisklasaid, @podklase = @@zaispispodklase, @search = '@@zaispissearch', @mpinventuraglaid = @@ID, @razlike = @@zaispisRazlike, @manjak = @@zaispisManjak, @visak = @@zaispisVisak, @vrstapregid = @@zaispisvrstapregid, @tarifaid = @@zaispistarifaid, @stvarna = @@zaispisstvarna)"
		CHECKBOXVISIBLE="FALSE"
		MASTERDBLCLICK="FORM1"
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"> 
 

  <NAME>Pregled Inventure MP </NAME>
  <CAPTION>Pregled Inventure MP </CAPTION>
  

<FORM1 	
		FILLEXPLORER="TRUE" 
		WIDTH="9500" 
		ONSUBMIT="spMPPregInventureNG @action=1, @operateriid = @@operateriid, @nenc = @@nenc, @trgovinaid = @@zaispistrgovinaid, @robaid = @@zaispisrobaid, @klasaid = @@zaispisklasaid, @podklase = @@zaispispodklase, @search = '@@zaispissearch', @mpinventuraglaid = @@MPinventuraglaid, @razlike = @@zaispisRazlike, @manjak = @@zaispisManjak, @visak = @@zaispisVisak, @vrstapregid = @@zaispisvrstapregid, @tarifaid = @@zaispistarifaid, @stvarna = @@zaispisstvarna, @mpsirovina=@@mpsirovina!!" 
		ONLOAD="select @@trgovinaid as trgovinaid, @@MPinventuraglaid as MPinventuraglaid, @@klasaid as klasaid" 
		HEIGHT="6000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" > 
		


            <INPUT TYPE="combo" CAPTION="Trgovina:*" NAME="zaispistrgovinaid" WIDTH="6500" HEIGHT="320" TOP="500" ALLOWEMPTY="FALSE" SQL="spMPDajTrgovina @operateriid=@@operateriid" ONCLICK="select 'refresh' as MPinventuraglaid" />
			<INPUT TYPE="search" CAPTION="Roba:*" NAME="zaispisrobaid" WIDTH="6500" HEIGHT="320" TOP="900" SQL="roba#robaid#%Naziv%#robakod%#userid%#barcode%" /> 
			<INPUT TYPE="text" CAPTION="Traženje pojma:*" NAME="zaispissearch" WIDTH="6500" HEIGHT="320" TOP="1300"/>
			<INPUT TYPE="combo" CAPTION="Klasa:*" NAME="zaispisklasaid" WIDTH="5500" HEIGHT="320" TOP="1700" ALLOWEMPTY="TRUE" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey" /> 
			<INPUT TYPE="checkbox" CAPTION="pokaži i sve podklase*" NAME="zaispispodklase" WIDTH="3500" HEIGHT="320" TOP="2000" />
           		<INPUT TYPE="combo" CAPTION="Inventura:*" NAME="MPinventuraglaid" WIDTH="5500" HEIGHT="420" TOP="2400" ALLOWEMPTY="FALSE" 
					   SQL="select MPinventuraglaid, convert(varchar(10),datumdok,104) + ' ' +rtrim(v.opis)+ ' Broj '+broj as Naziv 
							from MPinventuragla g 
							inner join vrstadok v on g.vrstadokid = v.vrstadokid where trgovinaid = @@zaispistrgovinaid and v.opis not like '%donos%'order by datumdok desc, 2" />
			<INPUT TYPE="checkbox" CAPTION="Sve razlike" NAME="zaispisRazlike" WIDTH="1500" HEIGHT="420" LEFT="1200" TOP="3000" />
			<INPUT TYPE="checkbox" CAPTION="Samo višak" NAME="zaispisVisak" WIDTH="1500" HEIGHT="420" LEFT="3200" TOP="3000" />
			<INPUT TYPE="checkbox" CAPTION="Samo manjak" NAME="zaispisManjak" WIDTH="1500" HEIGHT="420" LEFT="5200" TOP="3000" />
			<INPUT TYPE="checkbox" CAPTION="Stvarna količina različita od 0" NAME="zaispisstvarna" WIDTH="2000" HEIGHT="400" LEFT="7200" TOP="3000" />
			<INPUT TYPE="combo" CAPTION="Vrsta pregleda:*" NAME="zaispisvrstapregid" WIDTH="5500" HEIGHT="320" TOP="3700" ALLOWEMPTY="FALSE" SQL="select 1 as vrstapregid, 'Sva roba' as naziv union all select 2, 'Samo vlastita roba' union all select 3, 'Samo komisijska roba'"/>
			<INPUT TYPE="combo" CAPTION="Grupe poreza:*" NAME="zaispistarifaid" WIDTH="5500" HEIGHT="320" TOP="4100" ALLOWEMPTY="TRUE" SQL="select tarifaid, naziv as naziv from tarifa"/>
			<INPUT TYPE="combo" CAPTION="Vrsta robe:*" NAME="mpsirovina" WIDTH="5500" HEIGHT="320" TOP="4500" ALLOWEMPTY="TRUE" SQL="select 0 as mpsirovina, 'Roba koja nije mp sirovina' as naziv union all select 1, 'Samo mp sirovine' "/>

</FORM1>
  
 

<KARTICA 	
		FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<INPUT TYPE="grid" NAME="grid1" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid" /> 
</KARTICA>


	<DETALJI
			FILLEXPLORER="TRUE"
			WIDTH="8000"
			ONSUBMIT=""
			ONLOAD="spMPPregInventureNG @action=5, @operateriid = @@operateriid, @mpinventuraglaid = @@mpinventuraglaid , @robaid = @@robaid"
			HEIGHT="7500"
			CAPTION="Detalji unosa roba u inventuru "
			BORDERSTYLE="3"
			CMD1CAPTION=""
			CMD2CAPTION="Kraj"
			CMD3CAPTION=""
			CHILDFORM="">
		<INPUT TYPE="number" CAPTION="Stvarna količina:*" NAME="kolicinastvarna" WIDTH="1500" HEIGHT="320" TOP="400" LEFT="1500" ENABLED="FALSE"/>
		<INPUT TYPE="number" CAPTION="Knjižna količina:*" NAME="kolicinaknjizna" WIDTH="1500" HEIGHT="320" TOP="400" LEFT="4500" ENABLED="FALSE"/>
		<INPUT TYPE="number" CAPTION="Razlika:*" NAME="razlika " WIDTH="1500" HEIGHT="320" TOP="800" LEFT="1500" ENABLED="FALSE" STYLE="1"/>

		<INPUT TYPE="grid" NAME="grid1" TOP="1200" LEFT = "200" WIDTH="7500" HEIGHT="4300" SQL="spMPPregInventureNG @action=4, @operateriid = @@operateriid, @mpinventuraglaid = @@mpinventuraglaid , @robaid = @@robaid " />
	</DETALJI>

</PROJECT> 