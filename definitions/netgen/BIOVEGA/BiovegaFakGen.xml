<PRINT NAME="Ispis" HEIGHT="2246" WIDTH="7171" CAPTION="Odaberite predložak ispisa" ONLOAD="select &apos;&apos; as ispis">
	<INPUT TYPE="combo" NAME="template" TOP="216" LEFT="1512" HEIGHT="360" WIDTH="4968" SQL="if (select left(template, 1) from vrstadok where opis = &apos;Faktura&apos;)=&apos;#&apos;	
		select templateid, opis
		from templates where oznaka =(select template  from vrstadok where opis = &apos;Faktura&apos;)
	else 
		select vrstadokid, opis
		from vrstadok where opis = &apos;IOS OBRAZAC&apos;"/>
	<INPUT TYPE="label" NAME="Label24" TOP="216" LEFT="216" HEIGHT="360" WIDTH="1296" CAPTION="Predložak:" TEXT="Label24"/>
	<INPUT TYPE="button" NAME="button1" TOP="648" LEFT="4104" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG10" CAPTION="Ispiši" ONCLICK="select replace(template, &apos;:&apos;, &apos;/&apos;) as ispis  from templates where templateid=@@template#:@@ispis(@id=@@id;)#OK"/>
	<INPUT TYPE="button" NAME="button2" TOP="648" LEFT="5400" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG11" CAPTION="Odustani" ONCLICK="CLOSE"/>
	<INPUT TYPE="text" NAME="ispis" TOP="1080" LEFT="1944" HEIGHT="317" WIDTH="1440" VISIBLE="false"/>

