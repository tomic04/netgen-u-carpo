<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 DETAILGRID = "spMPPorukeLoy @action = 3, @mpporukeloyglaid = @@id"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="Uvjeti:FILTERFORM"
		 CMD2CAPTION1="Dodaj:INSERTFORM"
		 CMD3CAPTION1="Izmijeni:UPDATE_FORM"
		 CMD4CAPTION1="(De)Aktiviraj:AKTIVIRAJ"
		 CMD5CAPTION1="(De)Aktiviraj:AKTIVIRAJ"
		 CMD6CAPTION1=""
		 CMD7CAPTION1=""
		 CMD8CAPTION1=""
		 INCLUDE=""
		 BUTTONS="Filter:FILTERFORM#Dodaj:INSERTFORM#Izmijeni:UPDATE_FORM#(De)Aktiviraj:AKTIVIRAJ"
		 POPUPMASTER="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER"
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE"
		 ONLOAD=":FILTERFORM"
		 FROZENCOLUMNS="0"
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
	     DETCHECKBOXVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="TRUE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' "
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmijeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end "
		 REPORT="">



	<NAME>Administracija poruka za LOYALTY</NAME>
	<CAPTION>Administracija poruka za LOYALTY</CAPTION>

  <DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPPorukeLoy @action=1,@node='danas'" />
  <JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPPorukeLoy @action=1,@node='jucer'" />
  <TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPPorukeLoy @action=1,@node='ovajmj'" />
  <PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPPorukeLoy @action=1,@node='proslimj'" />
  <FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPPorukeLoy @action=1,@node='@@node'" />



  <FILTERFORM NAME="FILTERFORM" HEIGHT="2400" WIDTH="5350"
		 CAPTION="Upišite uvjete prikaza "
		 ONSUBMIT="spMPPorukeLoy @action = 1, @node='filter', "
		 ONLOAD="select @@datumdo as datumdo, @@stfarmeid as stfarmeid, 1 as pocetak"
		 FILLEXPLORER="TRUE"
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani"
		 >
      <INPUT TYPE="frame"  NAME="fr1"           CAPTION="Vremensko razdoblje u kojem je poruka poslana" STYLE="2" TOP="28" LEFT="56" WIDTH="5000" HEIGHT="1200"   />
		  <INPUT TYPE="date" NAME="datumod" CAPTION="Od*" TOP="500" LEFT="1000" DEFAULT="firstdayofmonth"/>
      <INPUT TYPE="date" NAME="datumdo" CAPTION="Do*" TOP="500" LEFT="2800" DEFAULT="today"/>
		  
  </FILTERFORM>

  <AKTIVIRAJ NAME="AKTIVIRAJ" HEIGHT="2000" WIDTH="5350"
		 CAPTION=" "
		 ONSUBMIT=""
		 ONLOAD=""
		 FILLEXPLORER=""
		 NEXTFORM="">

    <INPUT TYPE="label"  NAME="pitanje"           CAPTION="Želite li promijeniti status poruke? " STYLE="1" TOP="300" LEFT="300" WIDTH="6500" HEIGHT="3600"   />
    <INPUT TYPE="button" NAME="ok" CAPTION="Izmijeni" TOP="1000" LEFT="500" WIDTH="1106" HEIGHT="322"
         ONCLICK="spMPPorukeLoy @action = 12, @mpporukeloyglaid = @@id, @operateriid = @@operateriid#select 'refresh' as master#Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1000" LEFT="2500" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </AKTIVIRAJ>

  <INSERTFORM NAME="INSERTFORM" HEIGHT="5000" WIDTH="6850"
       CAPTION="Unos nove poruke"
       ONSUBMIT=""
       ONLOAD=""
       NEXTFORM="UPDATE_FORM"
       FOCUS="operaterslanjaid"
       CMD1CAPTION=""
       CMD2CAPTION=""
		>

      <INPUT TYPE="frame"  NAME="fr1"           CAPTION="" STYLE="2" TOP="28" LEFT="56" WIDTH="6500" HEIGHT="3600"   />
      <INPUT TYPE="date" NAME="datumKreiranja" CAPTION="Datum kreiranja*" TOP="500" LEFT="5200" WIDTH="1100" DEFAULT="today" ENABLED="FALSE" />  
      <INPUT TYPE="combo" NAME="operaterslanjaid" TOP="500" LEFT="1300" WIDTH="2700" SQL="select operateriid, naziv from ssoperateri where operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Operater slanja*" ENABLED="FALSE"/>
      <INPUT TYPE="text" NAME="naslov"	TOP="1000" LEFT="1300" WIDTH="5000"  HEIGHT="2500" ALLOWEMPTY="TRUE" CAPTION="Naslov poruke*" />  
      <INPUT TYPE="text" NAME="poruka"	TOP="1300" LEFT="1300" WIDTH="5000" MULTILINE="TRUE" HEIGHT="2000" ALLOWEMPTY="TRUE" CAPTION="Tekst poruke*" />
     
      <INPUT TYPE="button" NAME="ok" CAPTION="Primatelji&gt;&gt;&gt;" TOP="3900" LEFT="500" WIDTH="2000" HEIGHT="322"
			     ONCLICK="spMPPorukeLoy @action=2,@operaterslanjaid = @@operaterslanjaid,@naslov = '@@naslov',  @poruka = '@@poruka', @datum = @@datumkreiranja#Ok"  />
      <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3900" LEFT="2800" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </INSERTFORM>

  <UPDATE_FORM
		CAPTION="Izmijeni poruku "
		HEIGHT="8600"
		WIDTH= "11500"
    VERSION="1.2"
		FILLEXPLORER=""
		FOCUS="stavke"
		ONLOAD2=""
		ONLOADED="spMPPorukeLoy @action = 11, @mpporukeloyglaid = @@id#select 'disable' as ispravi"
		ONLOAD="if(select aktivno from mpporukeloygla where mpporukeloyglaid = @@id ) = 1 begin 
    			exec spRaiserror 69001, 'Poruka je Aktivirana. Ne možete ju mijenjati ! '

    end "
		>

    <INPUT TYPE="frame"  NAME="fr1"           CAPTION="Pošiljatelj" TOP="200" LEFT="56" STYLE="2" WIDTH="7900" HEIGHT="2400"   />
    <INPUT TYPE="combo" NAME="operaterSlanjaID" TOP="500" LEFT="1500" WIDTH="2500" SQL="select operateriid, naziv from ssoperateri where operateriid=@@operateriid" ALLOWEMPTY="FALSE" ENABLED="FALSE" CAPTION="Operater slanja*" ONLOSTFOCUS=""/>
    <INPUT TYPE="date" NAME="datumKreiranja" CAPTION="Kreirano*" TOP="500" LEFT="5750" WIDTH="1100" DEFAULT="firstdayofyear" ENABLED="FALSE" />
    <INPUT TYPE="text" NAME="vrijemeKreiranja" CAPTION="" TOP="500" LEFT="6950"  ENABLED="FALSE" WIDTH="900"/>
    <INPUT TYPE="text" NAME="naslov"	TOP="900" LEFT="1500" WIDTH="6350"  HEIGHT="2500" ALLOWEMPTY="TRUE" ENABLED="TRUE" CAPTION="Naslov poruke*" />
    <INPUT TYPE="text" NAME="poruka" CAPTION="Tekst poruke*" TOP="1200" LEFT="1500" ENABLED="TRUE" WIDTH="6350" HEIGHT="1300" MULTILINE="TRUE"/>

    <INPUT TYPE="button" NAME="DODAJCLANA" CAPTION="Odaberi primatelje" TOP="1700" LEFT="8000" WIDTH="2106" HEIGHT="322" ONCLICK=":DODAJCLANA#select 'refresh' as stavke"  />
    <INPUT TYPE="button" NAME="DODAJSVE" CAPTION="Pošalji svima" TOP="2200" LEFT="8000" WIDTH="2106" HEIGHT="322" ONCLICK="spMPPorukeLoy @action = 9, @MPPorukeLoyglaid = @@id#select 'refresh' as stavke "  />



    <INPUT TYPE="grid"
         NAME="stavke"
         REFRESHAFTERCHILD=""
         CAPTION="Stavke"
         TOP="2650" LEFT="1500" WIDTH="5100" HEIGHT="4200"
         TABINDEX="-1"
         AFTERREFRESH=""
         POPUP=""
         ONDBLCLICK=""
         EDITCOLUMNS=""
         ONCELLEDITED=""
         DETCHECKBOXVISIBLE="FALSE"
         PAGEHEADERCENTER=""
         PAGEHEADERRIGHT=""
         PAGEHEADERLEFT=""
         PAGEFOOTERCENTER=""
         PAGEFOOTERLEFT=""
         PAGEFOOTERRIGHT="@@thosmomi"
         PAGEORIENTATION="LANDSCAPE"
         GROUPBYBOXVISIBLE="TRUE"
         TOTALROW="TRUE"
         SQL="spMPPorukeLoy @action=3, @mpporukeloyglaid=@@id " >
    </INPUT>

    <INPUT TYPE="button" NAME="obrisi" CAPTION="Obriši" TOP="4000" LEFT="7550" WIDTH="1200" HEIGHT="322" 
           ONCLICK="FOREACHSELECTED(stavke)#exec spmpPorukeLoy @action=15, @mpporukeloydetid = @@stavke#select 'refresh' as stavke"  />

    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="7600" LEFT="196" WIDTH="1200" HEIGHT="322" ONCLICK="update mpporukeloygla set poruka = '@@poruka', naslov = '@@naslov' where mpporukeloyglaid = @@id #Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7600" LEFT="1556" WIDTH="1200" HEIGHT="322" ONCLICK="close"  />
    
  </UPDATE_FORM>


  <DODAJCLANA
	 WIDTH="9200"
	 ONSUBMIT=""
	 VERSION ="3"
	 ONLOAD="if ( select count(*) from mpporukeloydet where mpporukeloyglaid = @@id and sifraclana = '') > 0 begin 

    			exec spRaiserror 69001, 'Poruka je već dodijeljena svim članovina. Ne možete birati posebnog člana '
			return 
	end "
	 HEIGHT="9700"
	 CAPTION="Dodavanje članova na vaucher"
		 >
    <INPUT TYPE="search" NAME="partneriid" ALLOWEMPTY="TRUE" CAPTION="Partner*" TOP="500" LEFT="1500" ONLOSTFOCUS="" WIDTH="3000"
			   SQL="vipartneri#partneriid#naziv%#%mjestanaziv%#sifra#!adresa" />
    <INPUT TYPE="search" NAME="mpclanoviid" ALLOWEMPTY="TRUE" CAPTION="Član*" TOP="500" LEFT="5500" ONLOSTFOCUS="" WIDTH="3000"
			   SQL="spmpdajClana @trazi = '@@searchboxmpclanoviid'" />
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum rođenja od*" TOP="900" LEFT="1500" />
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="900" LEFT="3700" />
    <INPUT TYPE="check" NAME="nedatum" CAPTION="Bez obzira na datim" TOP="1300" LEFT="1500" />
    <INPUT TYPE="number" NAME="mjesec" CAPTION="Mjesec rođenja*" TOP="1700" LEFT="1500" SQL="" ALLOWEMPTY="TRUE" WIDTH="600" DECIMALS="0"/>
    <INPUT TYPE="date" NAME="datumrodjenja" CAPTION="Datum rođenja*" TOP="1700" LEFT="3200" />
    <INPUT TYPE="check" NAME="datumrodjne" CAPTION="Bez" TOP="1700" LEFT="5000" />
    <INPUT TYPE="combo" NAME="mjestaid" CAPTION="Mjesto*" TOP="2100" LEFT="1500" SQL="select mjestaid, naziv from mjesta order by 2 " ALLOWEMPTY="TRUE"/>
    <INPUT TYPE="combo" NAME="spol" CAPTION="Spol*" TOP="2500" LEFT="1500" ALLOWEMPTY="TRUE" WIDTH="1500"
			   SQL="select 'Ž' as spol, 'Žensko' as naziv union all select 'M' as spol, 'MUŠKO' as naziv "/>
    <INPUT TYPE="number" NAME="Brojbodovaod*" CAPTION="Broj bodova od*" TOP="2900" LEFT="1500" SQL="" WIDTH="600" ALLOWEMPTY="TRUE" DECIMALS="0"/>
    <INPUT TYPE="number" NAME="Brojbodovado*" CAPTION="do*" TOP="2900" LEFT="2500" SQL="" WIDTH="600" ALLOWEMPTY="TRUE" DECIMALS="0"/>

    <INPUT TYPE="button" NAME="pokazi" CAPTION="Pokaži*" TOP="3400" LEFT="1000" WIDTH="1106" HEIGHT="322"
				 ONCLICK="select 'refresh' as gridclan"  />

    <INPUT TYPE="grid" NAME="gridclan" CAPTION="Odabrani članovi" SKIPDEFAULTLOAD="TRUE" TOP="4000" LEFT="300" HEIGHT="4500" WIDTH="3600"
			   GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="TRUE"
			   SQL ="spmpVaucher @action = 14 , @partneriid = @@partneriid , @datumod = @@datumod , @datumdo = @@datumdo , @mjestaid = @@mjestaid,
			   @spol = '@@spol' , @nedatum = @@nedatum, @brojbodovaod = @@brojbodovaod, @brojbodovado = @@brojbodovado, 
			   @datumrodjenja = @@datumrodjenja, @nedatumrodj = @@datumrodjne, @mjesec = @@mjesec, @mpclanoviid = @@mpclanoviid "/>


    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="8700" LEFT="196" WIDTH="1106" HEIGHT="322"
						 ONCLICK="FOREACHSELECTED(gridclan)#exec spmpPorukeLoy @action=10, @MPPorukeLoyglaid = @@id, @mpclanoviid = @@gridclan#Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8700" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </DODAJCLANA>

  <BRISICLANA
 WIDTH="6200"
 ONSUBMIT=""
 VERSION ="2"
 ONLOAD="select mpclanvaucherid, sifra, rtrim(ime)+' ' + prezime as clan 
					from mpclanovi c 
					inner join mpclanvaucher cv on c.sifra = cv.sifraclana 
					where mpclanvaucherid = @@mpclanvaucherid"
 HEIGHT="3000"
 CAPTION="Brisanje člana "
		 >

    <INPUT TYPE="number" NAME="mpclanvaucherid" CAPTION="" TOP="500" LEFT="1500" VISIBLE="FALSE" ENABLED="FALSE" STYILE="1"/>
    <INPUT TYPE="text" NAME="sifra" CAPTION="Šifra člana*" TOP="500" LEFT="1500" ENABLED="FALSE" STYILE="1"/>
    <INPUT TYPE="text" NAME="clan" CAPTION="Član*" TOP="1000" LEFT="1500" SQL=" " ALLOWEMPTY="TRUE" ENABLED="FALSE" STYILE="1"/>


    <INPUT TYPE="button" NAME="ok" CAPTION="Obriši" TOP="2000" LEFT="196" WIDTH="1106" HEIGHT="322"
						 ONCLICK="delete mpclanvaucher where mpclanvaucherid = @@mpclanvaucherid#Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </BRISICLANA>

  <KONTROLA_FORM NAME="KONTROLA_FORM"
     HEIGHT="8000" WIDTH="9800"
     CAPTION="Pregled primatelja po razinama"
     ONLOAD=""
     ONLOADED=""
		>

    <INPUT TYPE="label" NAME="lblInfo"	TOP="600" LEFT="300" WIDTH="5000" SIZE="8" STYLE="3" HEIGHT="500" 
           CAPTION="Odabrani operateri su već dodani kao primatelji na sljedećim razinama."/>
    
    <INPUT TYPE="grid"
          NAME="razine"
          REFRESHAFTERCHILD=""
          CAPTION="Primatelj vec postoji"
          TOP="1500" LEFT="150" WIDTH="9100" HEIGHT="5000"
          TABINDEX="-1"
          AFTERREFRESH=""
          POPUP=""
          ONDBLCLICK=""
          EDITCOLUMNS=""
          ONCELLEDITED=""
          DETCHECKBOXVISIBLE="FALSE"
          PAGEHEADERCENTER=""
          PAGEHEADERRIGHT=""
          PAGEHEADERLEFT=""
          PAGEFOOTERCENTER=""
          PAGEFOOTERLEFT=""
          PAGEFOOTERRIGHT="@@thosmomi"
          PAGEORIENTATION="LANDSCAPE"
          GROUPBYBOXVISIBLE="FALSE"
          TOTALROW="TRUE"
          SQL="spMPPorukeLoy @action=7, @mpporukeloyglaid=@@id, @operateriid = @@operateri2id, @grupeid = @@grupeid, @trgovinaid = @@trgovinaid " >
    </INPUT>

    <INPUT TYPE="button" NAME="cancel"       CAPTION="Zatvori" TOP="6800" LEFT="1800" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </KONTROLA_FORM>



</PROJECT>