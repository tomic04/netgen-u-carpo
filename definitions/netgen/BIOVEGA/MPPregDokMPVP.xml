<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spmpPregDokVPMP @action=2,@operateriid=@@operateriid,@id=@@id,@vrstadokid = @@vrstadokid "
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION="Print dok.:vrstadokid-MaloprodajaGla"
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE33="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:OVAJMJ#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:DATUM#spMPTreeNG @action=3:DATUM#spMPTreeNG @action=5:VRSTADOKFORM"
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"  
		 MULTIGRIDLAYOUT="TRUE" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname', @aktivni =1, @trazi = ''"
		 ONLOAD2="" 
		 REPORT="">

	<NAME>Pregled VP dokumenata iz MP</NAME>
	<CAPTION>Pregled VP dokumenata iz MP </CAPTION>

<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="5254" 
	WIDTH="7710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spmpPregDokVPMP @action = 1,  @operateriid= @@operateriid, "
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo " 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	DBCLIPBOARD="false"
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	>
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
	<INPUT TYPE="combo" NAME="vrstapromid" 
		ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="select vrstapromid , opis from VrstaProm where Sifra in ( '30', '09' ) " />
	<INPUT TYPE="combo" NAME="vrstadokid" 
		ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="select vrstadokid, v.opis  from VrstaDok v
																			inner join vrstaprom vp on v.VrstaPromId = vp.vrstapromid 
																			where ( ( vp.Sifra in  ( '30', '09' )  and @@vrstapromid  is null ) 
																			or ( @@vrstapromid is not null and v.VrstaPromId = @@vrstapromid ) ) 
																			and v.opis like '%MP%'
																			" />
	<INPUT TYPE="combo" NAME="trgovinaid" 
		ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	<INPUT TYPE="search" NAME="partneriid"  
		CAPTION="Partner"   SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
	<INPUT TYPE="combo" NAME="skladisteid"
		ALLOWEMPTY="TRUE" CAPTION="Skladište" SQL="spmpDajSkladiste @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />
</FILTERFORM>

	<VRSTADOKFORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node'" />

	<DATUM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node',  @vrstapromid = @@vrstapromid" />

	<OVAJMJ FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = 'ovajmj',  @vrstapromid = @@vrstapromid" />

	<DANAS_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas',  @vrstapromid = @@vrstapromid" />
	
	<JUCER_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @vrstapromid = @@vrstapromid" />
	
	<PROSLIMJESEC_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',  @vrstapromid = @@vrstapromid" />

	
</PROJECT>