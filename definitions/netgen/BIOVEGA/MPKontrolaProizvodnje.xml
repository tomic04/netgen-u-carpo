      MASTERDBLCLICK=""
      POPUPMASTER="Filter:FILTERFORM"
   PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">

	<DETAILCOLUMNS>
		<COLUMN INDEX="" NAME="Količina1200" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="" />
	</DETAILCOLUMNS>
	
	
  <NAME>Kontrola razduženja sirovina </NAME>
  <CAPTION>Kontrola razduženja sirovina</CAPTION>
 
  <KOMENTAR> </KOMENTAR>


	<NORMATIV
					REFRESHAFTERCHILD=""
					FILLEXPLORER=""
                  REPORT=""
                  WIDTH="9600"
				  ONLOAD=""
                  ONSUBMIT=""
					
					HEIGHT="5300"
                  CAPTION="Pregled normativa proizvoda "
					MASTERDBLCLICK=""
                    BORDERSTYLE="3"
                  CMD1CAPTION=""
                  CMD2CAPTION="Odustani"
					FOCUS=""
				  CMD3CAPTION=""
				  CMD4CAPTION=""
				  CMD5CAPTION=""
                  CMD6CAPTION=""  >
		<INPUT TYPE="grid"
				NAME="stavkenorm"
				REFRESHAFTERCHILD="TRUE"
				CHECKBOXVISIBLE="FALSE"
				LEFT="100"
				CAPTION=""
