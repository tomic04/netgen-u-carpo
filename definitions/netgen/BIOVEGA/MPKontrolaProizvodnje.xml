			<COLUMN INDEX="" NAME="Količina1200" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>

	</NORMATIV>
	
    <INSERTFORM
					REFRESHAFTERCHILD=""
					FILLEXPLORER="" 
                  REPORT=""  
                  WIDTH="12000" 
				  ONLOAD="select 1"
                  ONSUBMIT="spMPProizvodiNG @action = 2, @operateriid = @@operateriid, " 
					
					HEIGHT="6100" 
                  CAPTION="Unos Proizvoda i normativa"  
					MASTERDBLCLICK=""
                    BORDERSTYLE="3" 
                  CMD1CAPTION="Normativ>>>" 
                  CMD2CAPTION="Odustani"
					FOCUS="robaid" 
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                  CMD6CAPTION=""  
					
                                  NEXTFORM="UPDATEFORM"  >




						<INPUT TYPE="TRAZILICA" 
											CAPTION="Proizvod" 
											NAME="Robaid" 
											SQL="viRoba#robaid#Naziv%#userid#barcode#robakod"
											TEXT=""
											TABINDEX="3" 
											WIDTH="5000" 
											HEIGHT="320"/>


	</INSERTFORM>


	<UPDATEFORM
				FILLEXPLORER="" 
				REPORT=""  
				WIDTH="11000" 
				ONLOAD="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@ID ),0) = 1  or (select datumdo from mpproizvodigla where mpproizvodiglaid = @@ID ) is not null begin 
                        exec spRaiserror 69001, 'Proizvod je ili bio aktivan. Ne može se više ispravljati !' 
						end
						else begin
							exec spMPProizvodiNG @action=3,@mpproizvodiglaid=@@ID
						end"
				ONSUBMIT="" 
				  HEIGHT="5500" 
				CAPTION="Ažuriranje normativa"  
				  MASTERDBLCLICK=""
				  BORDERSTYLE="3" 
				CMD1CAPTION="Spremi" 
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""	 
				CMD4CAPTION="Dodaj:DODAJSTAVKU"
				CMD5CAPTION=""	 		 
				CMD6CAPTION="Obriši:BRISISTAVKU"  
					
				NEXTFORM=""  >
		

		<INPUT TYPE="text" 
							CAPTION="Proizvod" 
							NAME="naziv" 
							TEXT=""
							TABINDEX="0" 
							WIDTH="5000" 
							STYLE="1" 
							ENABLED="FALSE" 
							HEIGHT="320"/>



		<INPUT TYPE="grid"
				NAME="stavkenorm"
				REFRESHAFTERCHILD="TRUE"
				CHECKBOXVISIBLE="FALSE"
				LEFT="100"
				CAPTION=""
				WIDTH="10500"
				HEIGHT="3700"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action = 4,@mpproizvodiglaid=@@id" >
			<COLUMN INDEX="" NAME="Količina1200" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>


	</UPDATEFORM>



	<DODAJSTAVKU
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7500" 
                         ONSUBMIT="" 
                         ONLOAD="" 
                         HEIGHT="3100" 
                         CAPTION="Prijava nove sirovine"  
                         BORDERSTYLE="3" 
                         CMD1CAPTION="" 
                         CMD2CAPTION=""					
                                  >


		<INPUT TYPE="TRAZILICA" 
				CAPTION="Sirovina*" 
				NAME="Robaid" 
				SQL="viroba#robaid#Naziv%#userid#barcode#robakod"
				TEXT=""
			    LEFT="2000" 
			    TOP="500" 
				STYLE="1" 
				WIDTH="5000" 
			    TABINDEX="1" 
				HEIGHT="320" ONLOSTFOCUS=""/>



		<INPUT TYPE="number" 
				NAME="kolicina" 
				CAPTION="Količina*" 
				TEXT="" 
			    LEFT="2000" 
			    TOP="1000" 
			    TABINDEX="2" 
				WIDTH="1500" 
				HEIGHT="320" 
				DECIMALS="4" />
		<INPUT TYPE="checkbox"
				NAME="rezervni"
				CAPTION="Rezervna sirovina*"
				TEXT=""
			    LEFT="2000" 
			    TABINDEX="6" 
			    TOP="1500" 
				WIDTH="3500"
				HEIGHT="320"
				DECIMALS="0" />

		<INPUT TYPE="button" NAME="Spremi"  CAPTION="Spremi" TOP="2000" LEFT="1186" WIDTH="1400" HEIGHT="322" TABINDEX="3" 
			   ONCLICK="exec spMPProizvodiNG @action=5, @mpproizvodiglaid = @@id, @robaid = @@robaid, @kolicina = @@kolicina, @rezervni = @@rezervni#OK"  />
		<INPUT TYPE="button" NAME="Odustani"  CAPTION="Odustani" TOP="2000" LEFT="2684" WIDTH="1400" HEIGHT="322" TABINDEX="4" ONCLICK="close"  />


	</DODAJSTAVKU>




	<POKAZIFORM
				FILLEXPLORER="" 
				REPORT=""  
				WIDTH="11000" 
				ONLOAD="exec spMPProizvodiNG @action=3,@mpproizvodiglaid=@@ID"
				ONSUBMIT="" 
				  HEIGHT="5500" 
				CAPTION="Ažuriranje normativa"  
				  MASTERDBLCLICK=""
				  BORDERSTYLE="3" 
				CMD1CAPTION="" 
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""	 
				CMD4CAPTION=""
				CMD5CAPTION=""	 		 
				CMD6CAPTION=""  
					
				NEXTFORM=""  >

		<INPUT TYPE="date" 
					NAME="datumod" 
					CAPTION="Datum početka" 
					VALUE="DATE1" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1" 
					ENABLED="FALSE"
					CHECKBOX="FALSE"/>
		<INPUT TYPE="TRAZILICA" 
							CAPTION="Proizvod" 
							NAME="Naziv" 
							TEXT=""
							TABINDEX="0" 
							WIDTH="5000" 
							ENABLED="FALSE" 
							HEIGHT="320"/>



		<INPUT TYPE="grid" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				LEFT="100"
				CAPTION="" 
				WIDTH="10500" 
				HEIGHT="3000" 
				TABINDEX="5" 
									SQL="spMPProizvodiNG @action = 4,@mpproizvodiglaid=@@id" 
                                          />



	</POKAZIFORM>



	<FILTERFORM 
						   FILLEXPLORER="TRUE" 
						   REPORT=""  
						   WIDTH="9000" 
						   ONSUBMIT="spmpkontrolaProizvodnje @action = 1,  " 
						   ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
						   HEIGHT="3000" 
						   CAPTION="Upišite uvjete pregleda "  
						   BORDERSTYLE="3" 
									CMD1CAPTION="Pokaži" 
									CMD2CAPTION="Odustani" 
									CMD3CAPTION=""  
									NEXTFORM=""  >




		<INPUT TYPE="date" 
					NAME="datumod" 
						CAPTION="Datum od" 
					VALUE="DATE2" 
					HEIGHT="320" 
					WIDTH="1500" 
						CHECKBOX="FALSE"/>

		<INPUT TYPE="date" 
					NAME="datumdo" 
						CAPTION="Datum do" 
					VALUE="DATE" 
					HEIGHT="320" 
					WIDTH="1500" 
					CHECKBOX="FALSE"/>
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovinaid" ONLOSTFOCUS="" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid" />

		<INPUT TYPE="search" NAME="sirovinaid"  WIDTH="5000" SQL="spMPRobaZaMPNG @trazi = '@@searchboxsirovinaid' " ALLOWEMPTY="TRUE" CAPTION="Sirovina:"/>

	</FILTERFORM>


	<BRISANJE
		  WIDTH="7500"
		  ONSUBMIT="exec spMPProizvodiNG @action=15,@MPproizvodiglaid=@@ID,"
		  ONLOAD="exec spMPProizvodiNG @action=3,@MPproizvodiglaid=@@ID"
		  HEIGHT="3200"
		  CAPTION="Brisanje proizvoda i normativa ?"
		  BORDERSTYLE="3"
		  CMD1CAPTION="Obriši"
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  BOLD="TRUE"
		  CHILDFORM="">

		<INPUT TYPE="text"
				NAME="naziv"
				CAPTION="Proizvod"
				STYLE="1" 
				TEXT=""
				WIDTH="4500"
				HEIGHT="320"
				TABINDEX="1"
				BOLD="TRUE"
				ENABLED="FALSE" />



		<INPUT TYPE="label" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite obisati proizvod i normativ  ? "/>
	</BRISANJE>



	<STATUSA
		  WIDTH="7500" 
		  ONSUBMIT="exec spMPProizvodiNG @action=7,@MPproizvodiglaid=@@ID,@operateriid= @@operateriid," 
		  ONLOAD="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@ID ),0) = 1   begin 
                        exec spRaiserror 69001, 'Proizvod je već aktivan. Ne može se aktivirati !' 
						end
							else begin 
								exec spMPProizvodiNG @action=3,@MPproizvodiglaid=@@ID
						end "
		  HEIGHT="3200" 
		  CAPTION="Aktiviranje proizvoda i normativa ?" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Ažuriraj"         
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  BOLD="TRUE"	
		  CHILDFORM="">

		<INPUT TYPE="text" 
				NAME="naziv" 
				CAPTION="Proizvod" 
				TEXT="" 
				WIDTH="4500" 
				HEIGHT="320" 
				TABINDEX="1" 
				BOLD="TRUE" 
				ENABLED="FALSE" />

		<INPUT TYPE="date"
					NAME="datumod"
					CAPTION="Datum aktiviranja"
					VALUE="DATE1"
					HEIGHT="320"
					WIDTH="1500"
					TABINDEX="1"
					ENABLED="TRUE"
					CHECKBOX="FALSE"/>


		<INPUT TYPE="label1a" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite Aktivirati proizvod i normativ  ? "/>
		<INPUT TYPE="label2a" NAME="stat" BOLD="TRUE" TOP="1800" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Stari aktivni normativ će biti ugašen !"/>
	</STATUSA>


  
 

  <BRISISTAVKU
		WIDTH="5500" 
		ONSUBMIT="delete mpproizvodidet where mpproizvodidetid = @@stavkenorm" 
		ONLOAD="spMPProizvodiNG @action = 6, @mpproizvodidetid=@@stavkenorm"		
		HEIGHT="3200" 
		CAPTION="Brisanje stavke" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Obriši"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

	  <INPUT TYPE="label" NAME="stat"  LEFT="100" TOP="300" BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati stavku ? "/>



	  <INPUT TYPE="number"  KOMENTAR="ova kontrola služi samo da sačuva ID stavke , pozicionirana je tako da se nevidi na formi"
					NAME="mpproizvodidetid" 
					TOP="5600" 
					LEFT="2200" 
					CAPTION="mpproizvodidetid" 
					TEXT="" 
					WIDTH="2500" 
					HEIGHT="320" 
					TABINDEX="5" 
					ENABLED="FALSE"
					DECIMALS="0" />

		
		
  </BRISISTAVKU> 



  




</PROJECT>
 
