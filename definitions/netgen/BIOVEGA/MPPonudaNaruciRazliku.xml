<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 ONLOAD=":FILTERFORM" 
		 MASTERDBLCLICK=""
		 MULTIGRIDLAYOUT="TRUE" 
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="Dodaj artikl:DODAJART" 
		 CMD5CAPTION="Obriši artikl:OBRISIART" 		
		 CMD6CAPTION="Obriši sve odabrane:MULTISELECTDEL"
		 CMD7CAPTION="Izmjeni količinu:IZMJENIART"
		 CMD8CAPTION="Dodaj web narudžbu:WEBNAR"
		 CMD9CAPTION=""
		 CMD10CAPTION="Kreiraj narudžbu za skl:KRENAR"
		 POPUPMASTER="Parametri:FILTERFORM" 
	     TREE=""
		 GROUPBYBOXVISIBLE="TRUE"
		 CHECKBOXVISIBLE="TRUE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE" >

	<NAME>Webshop - Potrebe za isporuku</NAME>
	<CAPTION>Webshop - Potrebe za isporuku</CAPTION>


	<KRENAR NAME="KRENAR" HEIGHT="3197" WIDTH="5501"
			CAPTION="Kreirat narudžbu  ?"
			ONSUBMIT="spmpPonudaNaruciRazliku @action = 8,  @operateriid= @@operateriid"
			ONLOAD=""
			 FILLEXPLORER=""
			 CMD1CAPTION="Zaključi"
			 CMD2CAPTION="Odustani"
		>

		<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite kreirati narudžbu  ? " />
	</KRENAR>

	<WEBNAR NAME="WEBNAR" HEIGHT="3197" WIDTH="5501"
				CAPTION="Dodaj narudžbu  ?"
				ONSUBMIT="spmpPonudaNaruciRazliku @action = 1,  @operateriid= @@operateriid--,"
				ONLOAD=""
				 FILLEXPLORER=""
				 >

		<INPUT TYPE="text" NAME="orgdok" CAPTION="Web dokument broj*" TOP="500" LEFT="1500" WIDTH="1800" HEIGHT="317" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Dodaj" TOP="1000" LEFT="1500" WIDTH="1106" HEIGHT="322"
			   ONCLICK="exec spmpPonudaNaruciRazliku @action = 9 , @operateriid = @@operateriid, @orgdok ='@@orgdok'#ok"  />
		<INPUT TYPE="button" NAME="close" CAPTION="Odustani" TOP="1000" LEFT="3000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close"  />

	</WEBNAR>
		
<FILTERFORM NAME="FILTERFORM" 
		FILLEXPLORER="TRUE"
		WIDTH="9800"
		ONSUBMIT="spmpPonudaNaruciRazliku @action = 1,  @operateriid= @@operateriid--,"
		ONLOAD=""
			VERSION="1.2"
		HEIGHT="10000"
		FOCUS="povezinar"
		CAPTION="Izbor narudžbenica ">

	<INPUT TYPE="date" NAME="datod" TOP="200" LEFT="1300" CAPTION="Datum od*" />
	<INPUT TYPE="date" NAME="datdo" TOP="200" LEFT="3700" CAPTION="Datum do*" />
	<INPUT TYPE="combo" NAME="MPNacinisporukeID" ALLOWEMPTY="true" CAPTION="Način isporuke*" TOP="700" LEFT="1300"
	SQL="select distinct  mpnacinisporukegrupaid, opis from MPNacinisporuke where aktivno=1" />

	<INPUT TYPE="button" NAME="" CAPTION="Pokaži" TOP="700" LEFT="6700" WIDTH="1500" HEIGHT="322" ONCLICK="select 'refresh' as povezinar"/>
	
		<INPUT TYPE="frame"  NAME="fr1"  CAPTION="Narudžbenice za preuzimanje" TOP="1300" LEFT="50" WIDTH="8300" HEIGHT="250" STYLE="1"  />
		<INPUT TYPE="frame"  NAME="fr2"  CAPTION="Stavke narudžbenice" TOP="5000" LEFT="50" WIDTH="8300" HEIGHT="250"  STYLE="1" />


		<INPUT TYPE="grid"  
			NAME="povezinar"
			TOP="1600"
			LEFT="200"
			WIDTH="8200"
			HEIGHT="3000"
			CHECKBOXVISIBLE="TRUE"
			TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
			GROUPBYBOXVISIBLE="FALSE"
			CAPTION="_Zadnje narudžbenice skladištu"
			REFRESHAFTERCHILD=""
			   SKIPDEFAULTLOAD="TRUE"
			VISIBLE="TRUE"
			ONCLICK="select 'refresh' as povezinar1"
			SQL="spmpPonudaNaruciRazliku @action = 2, @datumod=@@datod, @datumdo=@@datdo,@MPNacinisporukeID=@@MPNacinisporukeID  " />

		<INPUT TYPE="grid"  
			NAME="povezinar1"
			TOP="5300"
			LEFT="200"
			WIDTH="8200"
			HEIGHT="4500"
			CHECKBOXVISIBLE="FALSE"
			TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
			GROUPBYBOXVISIBLE="FALSE"
			   SKIPDEFAULTLOAD="TRUE"
			CAPTION=""
			REFRESHAFTERCHILD=""
			VISIBLE="TRUE"
			SQL="spmpPonudaNaruciRazliku @action = 21, @id = @@povezinar" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Preuzmi"  TOP="1500" LEFT="10000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="delete TotalGenMultiSelectTemp where susersname= suser_sname()#FOREACHSELECTED(povezinar)#insert into totalgenmultiselecttemp(id,operateriid,hostname,susersname) values (@@povezinar,@@operateriid,host_name(),suser_sname())#spmpPonudaNaruciRazliku @action = 3, @operateriid = @@operateriid#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2500" LEFT="10000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		

</FILTERFORM>

	<DODAJART
	 NAME="DODAJART" HEIGHT="4000" WIDTH="6000"
	 CAPTION="Dodavanje artikla"
	 ONLOAD=""
	 ONSUBMIT="spmpPonudaNaruciRazliku @action = 1,  @operateriid= @@operateriid--,"
	 FILLEXPLORER="TRUE" 
	 >

		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba" WIDTH="4000" ALLOWEMPTY="FALSE" HEIGHT="317"
				   SQL="spMPRobaZaMPNG @trgovinaid = 18 , @trazi = '@@searchboxrobaid', @operateriid = @@operateriid"  BACKCOLOR="LIGHTYELLOW" HOTKEY=""/>
		<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina"   WIDTH="1500" HEIGHT="302" DECIMALS="4" VALUE="1"
		   ONLOSTFOCUS="" SQL=""  />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Dodaj"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaNaruciRazliku @action = 4, @robaid=@@robaid, @kolicina=@@kolicina#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
			   
	</DODAJART>

	<OBRISIART
	NAME="OBRISIART"
	HEIGHT="3000" WIDTH="7000"
	CAPTION="Brisanje stavke"
	ONLOAD="exec spmpPonudaNaruciRazliku @action = 6, @robaid=@@id" 
	 ONSUBMIT="spmpPonudaNaruciRazliku @action = 1,  @operateriid= @@operateriid--,"
	FILLEXPLORER="TRUE"  >

		<INPUT TYPE="text"   NAME="userid"       CAPTION="Šifra"      HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="FALSE" />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaNaruciRazliku @action = 5, @robaid=@@robaid#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</OBRISIART>

	<IZMJENIART
NAME="IZMJENIART"
HEIGHT="3000" WIDTH="7000"
CAPTION="Izmjena stavke"
ONLOAD="exec spmpPonudaNaruciRazliku @action = 6, @robaid=@@id"
 ONSUBMIT="spmpPonudaNaruciRazliku @action = 1,  @operateriid= @@operateriid--,"
FILLEXPLORER="TRUE"  >

		<INPUT TYPE="text"   NAME="userid"       CAPTION="Šifra"      HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="4000"   ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="" />

		<INPUT TYPE="button" NAME="ok"           CAPTION="Izmjeni"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spmpPonudaNaruciRazliku @action = 7, @robaid=@@robaid, @kolicina=@@kolicina#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</IZMJENIART>
	
		<MULTISELECTDEL
			 WIDTH="8000"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="5200"
			 CAPTION="Želite li obrisati odabrane artikle? "
			 CMD1CAPTION=""
			 CMD2CAPTION=""
			 FILLEXPLORER=""
		 >
		
		<INPUT TYPE="grid"
			   NAME="aktiviraj"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Želite li obrisati označene artikle iz narudžbe ? "
			   TOP="500" LEFT="300" WIDTH="6000" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpPonudaNaruciRazliku @action = 51 , @operateriid = @@operateriid" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Obriši" TABINDEX="2" TOP="4000" LEFT="396" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpPonudaNaruciRazliku @action=52, @operateriid= @@operateriid#OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</MULTISELECTDEL>

	

	

</PROJECT>