<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	ONLOAD=":FILTERFORM" 
	DETAILGRID="spmpKontrolaOtpremeZaBiovegu @action = 2, @id = @@id" 
	CMD1CAPTION="Parametri:FILTERFORM" 
	CMD2CAPTION="" 
	_CMD3CAPTION="Zbirno roba:ZBIRNO" 
	CMD4CAPTION="" 
	_CMD5CAPTION="Ponovi prijenos:MULTISELECTPREBACI" 
	CMD6CAPTION=""   
	CMD7CAPTION="Lista"   
	CMD8CAPTION="Print dok."   
	REPORT="" 
	MASTERDBLCLICK=""
	POPUPMASTER="">

	<NAME>Kontrola otpreme za Biovegu</NAME>
	<CAPTION>Kontrola otpreme za Biovegu</CAPTION>
	<KOMENTAR></KOMENTAR>

	<FILTERFORM
		FILLEXPLORER="TRUE"
		REPORT=""
		WIDTH="5000"
		VERSION="2"
		ONSUBMIT="spmpKontrolaOtpremeZaBiovegu @action = 1,  "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo"
		HEIGHT="2800"
		CAPTION="Upis parametara pregleda "
		BORDERSTYLE="3"
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""
		NEXTFORM=""  >
		<INPUT TYPE="date"
			NAME="datumod"
			CAPTION="Datum do "
			WIDTH="1500"
			HEIGHT="320"
			TABINDEX="1"
			ALLOWEMPTY="FALSE"
			ONCLICK="" 
			SQL=""  />

		<INPUT TYPE="date"
			NAME="datumdo"
			CAPTION="Datum do "
			WIDTH="1500"
			HEIGHT="320"
			TABINDEX="1"
			ALLOWEMPTY="FALSE"
			ONCLICK=""
			SQL=""  />
			
		<INPUT TYPE="combo"
			NAME="parstruid"
			CAPTION="Lokacija"
			WIDTH="3000"
			HEIGHT="320"
			TABINDEX="1"
			ALLOWEMPTY="TRUE"
			ONCLICK=""
			SQL="select parstruid, naziv from parstru where partneriid=6628"  />
			
		<INPUT TYPE="check"
			NAME="nepovezano"
			CAPTION="Samo neprebačene"
			WIDTH="1500"
			HEIGHT="320"
			TABINDEX="1"
			ALLOWEMPTY="FALSE"
			ONCLICK=""
			SQL=""  />

	</FILTERFORM>

	<ZBIRNO
		FILLEXPLORER="TRUE"
		WIDTH="10000"
		VERSION="1"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="7500"
		CAPTION="Nepovezana roba  "
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""
		NEXTFORM="">

		<INPUT TYPE="grid"
			NAME="stavke"
			REFRESHAFTERCHILD="TRUE"
			CAPTION="_ay"
			TOP="200"
			LEFT="200"
			WIDTH="12000"
			HEIGHT="6000"
			TABINDEX="5"
			SQL="spmpKontrolaOtpremeZaBiovegu @action=3,@datumod = @@datumod, @datumdo = @@datumdo "/>
	</ZBIRNO>

	<MULTISELECTPREBACI
		FILLEXPLORER=""
		WIDTH="7000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="7500"
		CAPTION="Ponavljanje prijenosa "
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION=""
		CMD3CAPTION=""
		NEXTFORM="">

		<INPUT TYPE="grid"
			NAME="prebaci"
			REFRESHAFTERCHILD="TRUE"
			VERSION="1"
			CAPTION="_ay"
			TOP="200"
			LEFT="200"
			WIDTH="5000"
			HEIGHT="6000"
			TABINDEX="5"
			SQL="select t.id, g.datumdok as [Datum1200], g.broj as [Broj2000] from totalgenmultiselecttemp t inner join biovega..pronotpgla g on t.id = g.pronotpglaid where t.operateriid = @@operateriid "/>

		<INPUT TYPE="button" NAME="ponoviok"     CAPTION="Ponovi"  TOP="6500" LEFT="456" TABINDEX="2" WIDTH="1106" HEIGHT="322" ENABLED="TRUE" 
			ONCLICK="FOREACHROW(prebaci)#spmpKontrolaOtpremeZaBiovegu @action = 4 ,@id = @@prebaci#OK"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6500" LEFT="1756" TABINDEX="1" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTPREBACI>
</PROJECT>
 
