<?xml version="1.0" encoding="windows-1250" ?> 
<PROJECT  
	ONLOAD=":FILTERFORM"  
	BUTTONS="Parametri:FILTERFORM#Kartica:MPKARTICA(@mastergridid = @@id, @datumod  = @@datod, @datumdo = @@datdo, @skladisteid = @@trgovinaid)"
	MASTERDBLCLICK=""
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	DETTOTALROWVISIBLE="TRUE"
	INCLUDE="MPKarticaRobe.xml" 
	DETCHECKBOXVISIBLE="FALSE"
	TREE="spMPTreeKomisNG @action=1 , @trgovinaid = @@trgovinaid :FILTERPAR_FORM"
	EDITCOLUMNS=""
	ONCELLEDITED="">
 
  <NAME>Realizacija komisijske robe </NAME>
  <CAPTION>Realizacija komisijske robe </CAPTION>

	<FILTERPAR_FORM    FILLEXPLORER="TRUE" ONSUBMIT="exec spMPRealizacijaKomisije  @operateriid=@@operateriid , @datumod = @@datod, @datumdo = @@datdo , @trgovinaid = @@trgovinaid  , @partneriid = @@node" />


	<FILTERFORM
	NAME="FILTERFORM"
	FILLEXPLORER="ONLYTREE"
	ONSUBMIT=""
	ONLOAD="select @@partneriid as partneriid,@@trgovinaid as trgovinaid , @@datumod as datumod, @@datumdo as datumdo "
	REPORT=""  
	WIDTH="8000" 
	HEIGHT="3500" 
	CAPTION="Parametri"
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	<INPUT TYPE="date" NAME="datod"   CAPTION="Datum od:*" TOP="500" LEFT="1500" WIDTH="1500" HEIGHT="320" DEFAULT="firstdayofmonth" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datdo"   CAPTION=" do:*" TOP="500" LEFT="3500" WIDTH="1500" HEIGHT="320" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid"   CAPTION="Trgovina:*" TOP="900" LEFT="1500" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" 
		   SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @komis = 1 " /> 

</FILTERFORM>

	


</PROJECT>
 
