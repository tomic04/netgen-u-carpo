<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="" DETAILGRID = "spMPVaganaRoba @action=3,@robaid= @@id "
      TREE="spTreeKlaseRobe:KLASIFIKACIJA"
   MASTERDBLCLICK="UPDATEFORM"
   CMD1CAPTION="Traži:FILTERFORM"    
   CMD2CAPTION="" 
   CMD3CAPTION="Izmjeni:UPDATEFORM"
   CMD4CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="FALSE"
   TOTALROWVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
	>
 
  <NAME>Ažuriranje vagane robe</NAME>
  <CAPTION>Ažuriranje vagane robe</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MT 02.06.2009.  </AUTOR>

  <KLASIFIKACIJA  FILLEXPLORER="TRUE" ONSUBMIT="spMPVaganaRoba @action=1, @KlasaID=@@node" />

  <FILTERFORM 
                 WIDTH="7000" 
                 HEIGHT="2500" 
                 ONSUBMIT="spMPVaganaRoba @action=0, " 
                 ONLOAD="" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Gotovo" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER="TRUE" 
		 >
  	        <INPUT TYPE="TRAZILICA" CAPTION="Roba : " NAME="robaid" 
			SQL="ViRobabezusluga#RobaId#Naziv%#Userid#Robakod#%barcode%" 
			TABINDEX="0"   />        
		<INPUT TYPE="TRAZILICA" CAPTION="Klasa : " NAME="klasaid" SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
			TABINDEX="3" 
			 
			/> 

	  
  </FILTERFORM>

  <UPDATEFORM 
                 WIDTH="7000" 
                 VERSION="1"
                 ONSUBMIT="" 
                 ONLOAD="select r.naziv as robanaziv, 
								coalesce(b.barcode,r.barcode) as barcode, 
								r.vaganaroba
								from Roba r
								left outer join barcode b on r.robaid=b.robaid and b.defaultind=1
								where r.RobaId=@@id " 
                 HEIGHT="7500" 
                 CAPTION="Izmjena"  
		 FILLEXPLORER="" 
		 >
		<INPUT TYPE="text" CAPTION="_Roba :*" NAME="robanaziv" TABINDEX="0"  WIDTH="4500" HEIGHT="320" ENABLED="FALSE" TOP="400" LEFT="1000" />
		<INPUT TYPE="text" NAME="barcode" CAPTION="Barkod :*" TEXT="1" WIDTH="1600" HEIGHT="800" TABINDEX="1" DECIMALS="0" TOP="800" LEFT="1000"/>
		<INPUT TYPE="checkbox" NAME="vaganaroba" CAPTION="Vagana roba*" TEXT="1" TABINDEX="2" TOP="1200" LEFT="1000"/>
    <INPUT TYPE="grid"
			   NAME="trgovine"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="trgovine"
			   TOP="1500" LEFT="80" WIDTH="9400" HEIGHT="4500"
			   TABINDEX="-1"
			   AFTERREFRESH="select sum(nvrijednost) as nvrijednost from mpnardet where mpnarglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU"
			   EDITCOLUMNS="DA"
			   ONCELLEDITED="spMPVaganaRoba @action=4,@robaid = @@id, @ind = @(trgovine..DA1000), @trgovinaid = @(trgovine..trgovinaid)"
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER="Narudžba br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@tkosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spMPVaganaRoba @action=3,@robaid= @@id" />



    <INPUT TYPE="button" NAME="ok" TOP="6500" LEFT="100" WIDTH="1100" CAPTION="Spremi" ONCLICK="spMPVaganaRoba @action=2, @id=@@id, @vaganaroba=@@vaganaroba, @barcode='@@barcode'#Ok" TABINDEX="10" />
		<INPUT TYPE="button" NAME="cancel" TOP="6500" LEFT="2000" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" TABINDEX="12" />

  </UPDATEFORM>
</PROJECT>
 

