<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FORM1" 
   CMD1CAPTION="Filter:FORM1"    
   CMD2CAPTION=""    
   CMD3CAPTION="Stavke računa:STAVKE" 
   CMD4CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   POPUPMASTER=""
	 MULTIGRIDLAYOUT="TRUE" 
   MASTERDBLCLICK="FORM1">
 
  <NAME>Pregled prometa po članu</NAME>
  <CAPTION>Pregled prometa po članu</CAPTION>
 
 

  <FORM1 
                         FILLEXPLORER="TRUE"
						WIDTH="8000" 
                         ONSUBMIT="spMPPregRobeMPClanPL @action=0," 
                         ONLOAD="select @@trgivinaid as trgovinaid , @@datod as datod, @@datdo as datdo " 
                         HEIGHT="4000" 
                         CAPTION="Novi bod"
			 BORDERSTYLE="3"   
                         CMD1CAPTION="Pokaži" 
                         CMD2CAPTION="Odustani" >

			<INPUT TYPE="combo" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="spmpDajTrgovina @operateriid=@@operateriid" 
					TEXT=""
					TABINDEX="1" 
					ALLOWEMPTY="TRUE"
					WIDTH="4500" 
					ENABLED="TRUE"
					HEIGHT="320"/>


           <INPUT TYPE="date" 
				NAME="datod" 
				CAPTION="Od " 
				SQL=""  
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="1" 
				CHECKBOX="FALSE" />


			<INPUT TYPE="date" 
				NAME="datdo" 
				CAPTION="Do " 
				TABINDEX="2" 
				TEXT="" 
				DECIMALS="0" 
				HEIGHT="320"/>



			<INPUT TYPE="TRAZILICA" 
				CAPTION="Član " 
				NAME="mpclanoviid" 
				SQL="mpclanovi#mpclanoviid#ime%#prezime%#%sifra%"
				TABINDEX="3" 
				TEXT="" 
				DECIMALS="0" 
				WIDTH="4000" 
				HEIGHT="320"/>

				<INPUT TYPE="VB.checkbox" 
                                   	NAME="Sve" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="Pokaži cijeli promet člana bez obzira na datum"/>

			  <INPUT TYPE="VB.checkbox"
						  NAME="racun"
						  WIDTH="3500"
						  HEIGHT="320"
						  CAPTION="Kumulativ po računu"/>




  </FORM1>

	<STAVKE
				FILLEXPLORER="TRUE"
				WIDTH="11500"
				ONSUBMIT=""
				ONLOAD="select broj from mpblagajnagla where mpblagajnaglaid = @@id"
				HEIGHT="6000"
				CAPTION="Pregled računa: @@broj "
				BORDERSTYLE="3"
				CMD1CAPTION=""
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""
				CHILDFORM="">




		<INPUT TYPE="grid"
								NAME="lbl2"
									TOP="700"
									LEFT="200"
								WIDTH="11000"
								HEIGHT="4000"
								CAPTION="Pregled mp računa"
				REFRESHAFTERCHILD="TRUE"
				SQL="spMPPregBodMPClanNG @action=2,@mpblagajnaglaid=@@id"/>

	</STAVKE>



</PROJECT>
 
