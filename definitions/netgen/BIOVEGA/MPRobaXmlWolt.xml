<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="" DETAILGRID = ""
      TREE="spTreeKlMasterRoba:KLASIFIKACIJA"
   MASTERDBLCLICK=""
   CMD1CAPTION="Traži:FILTERFORM"    
   CMD2CAPTION="" 
   CMD3CAPTION="Aktiviraj:MULTISELECTAKTIVIRAJ"
   CMD4CAPTION="Deaktiviraj:MULTISELECTDEAKT"
   CMD5CAPTION=""
   CMD6CAPTION="Pripremi XML:XMLFORM"
   CHECKBOXVISIBLE="TRUE"
   TOTALROWVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   COMMANDTIMEOUT="300"
	>
 
  <NAME>Roba za XML Wolt</NAME>
  <CAPTION>Roba za XML Wolt</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> </AUTOR>

  <KLASIFIKACIJA  FILLEXPLORER="TRUE" ONSUBMIT="spmpWoltXml @action=61, @KlasaID=@@node" />

  <FILTERFORM 
                 WIDTH="7000" 
                 HEIGHT="2500" 
                 ONSUBMIT="spmpWoltXml @action=6, " 
                 ONLOAD="" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Gotovo" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER="TRUE" 
		 >
  	        <INPUT TYPE="TRAZILICA" CAPTION="Roba : " NAME="robaid" 
			SQL="ViRobabezusluga#RobaId#Naziv%#Userid#Robakod#%barcode%" 
			TABINDEX="0"   />        
		<INPUT TYPE="TRAZILICA" CAPTION="Klasa : " NAME="klasaid" SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
			TABINDEX="3" 
			 
			/> 

	  
  </FILTERFORM>

	<MULTISELECTAKTIVIRAJ
			 WIDTH="6000"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="5200"
			 CAPTION="Želite li aktivirati označene robe?"
			 CMD1CAPTION=""
			 CMD2CAPTION=""
			 FILLEXPLORER=""
		 >

		<INPUT TYPE="grid"
			   NAME="aktiviraj"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Želite li aktivirati označene robe ? "
			   TOP="500" LEFT="300" WIDTH="10000" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpWoltXml @action = 7 , @operateriid = @@operateriid" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Aktiviraj" TABINDEX="2" TOP="4000" LEFT="396" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpWoltXml @action=8, @operateriid= @@operateriid#ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</MULTISELECTAKTIVIRAJ>

	<MULTISELECTDEAKT
			 WIDTH="6000"
			 ONSUBMIT=""
			 ONLOAD=""
			 HEIGHT="5200"
			 CAPTION="Želite li deaktivirati označene robe?"
			 CMD1CAPTION=""
			 CMD2CAPTION=""
			 FILLEXPLORER=""

		 >

		<INPUT TYPE="grid"
			   NAME="deaktiviraj"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Želite li deaktivirati označene robe ? "
			   TOP="500" LEFT="300" WIDTH="10000" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpWoltXml @action = 7 , @operateriid = @@operateriid" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Deaktiviraj" TABINDEX="2" TOP="4000" LEFT="396" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpWoltXml @action=9, @operateriid= @@operateriid#ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</MULTISELECTDEAKT>

	<XMLFORM
		 WIDTH="6000"
		 ONSUBMIT=""
		 ONLOAD=""
		 HEIGHT="5200"
		 CAPTION="Pošalji podatke"
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		 FILLEXPLORER=""

		 >

		<INPUT TYPE="grid"
			   NAME="podaci"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Pošalji podatke"
			   TOP="500" LEFT="300" WIDTH="10000" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":"
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpWoltXml @action = 101" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Pošalji" TABINDEX="2" TOP="4000" LEFT="396" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpWoltXml @action = 100, @operateriid= @@operateriid#ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</XMLFORM>
  
</PROJECT>
 

