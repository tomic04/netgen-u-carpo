<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  	
	CMD1CAPTION="Filter:FILTERFORM" 
	CMD2CAPTION="Proknjiži:PROKNJIZI"
	CMD3CAPTION="" 
	CMD7CAPTION="Ispis:PRINTMASTER" 
	POPUPMASTER="" 
	MASTERDBLCLICK=""
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE" 
	ONLOAD=":FILTERFORM" 
	FROZENCOLUMNS="0" 
	AUTOFITCOLUMNS="TRUE"
	COMMANDTIMEOUT="600"
	PAGEHEADERLEFT="Od @@datumod do @@datumdo"
	PAGEHEADERRIGHT="@@tkosmomi"
	SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
	>

<NAME>Projekt</NAME>
<CAPTION>Pregled dozvoljenog kala U MP </CAPTION>
<KOMENTAR></KOMENTAR>

	<FILTERFORM NAME="FILTERFORM"
		 HEIGHT="4000" WIDTH="8800" TEXT=""
			 REFRESHAFTERCHILD="TRUE" CAPTION="Uvjeti"
		 BORDERSTYLE="3"
		 ONSUBMIT="spMPPregKala @action=0, @operateriid=@@operateriid,"
			 ONLOAD=""
		 CANCELONSUBMIT=""
		 FILLEXPLORER="TRUE"
			 CMD1CAPTION="Prihvati"
		 CMD2CAPTION="Odustani"
		 >

		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="400" LEFT="1500" HEIGHT="302" WIDTH="6800"  ALLOWEMPTY="FALSE" ENABLED="TRUE" VISIBLE="TRUE"
					SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"
					ONLOSTFOCUS="" />

		<INPUT TYPE="checkbox" NAME="robaSaKalo" CAPTION="Pokaži samo robe koje imaju definiran % kala" TOP="800" LEFT="1500"/>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="1200" LEFT="1500" HEIGHT="302" WIDTH="1728" VISIBLE="TRUE"  ENABLED="True"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="1200" LEFT="4500" HEIGHT="302" WIDTH="1728" VISIBLE="TRUE"  ENABLED="True"/>
	</FILTERFORM>

	<ISPIS NAME="ISPIS"
     HEIGHT="4000" WIDTH="8800" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Uvjeti"
     BORDERSTYLE="3"
     ONSUBMIT="spMPObracunKalaNG @action=3, @operateriid=@@operateriid,"
		 ONLOAD=""
     CANCELONSUBMIT=""
     FILLEXPLORER="TRUE"
		 CMD1CAPTION="Prihvati"
     CMD2CAPTION="Odustani"
		 >

		<INPUT TYPE="combo" NAME="Combo1" CAPTION="Inventura*" TOP="400" LEFT="1500" HEIGHT="302" WIDTH="6800"  ALLOWEMPTY="FALSE" ENABLED="TRUE" VISIBLE="TRUE"
					SQL="spMPDajInventure @operateriid = @@operateriid, @action=0 "
					ONLOSTFOCUS="spMPObracunKalaNG @action=2, @Combo1=@@Combo1" />

		<INPUT TYPE="search" NAME="robaid" CAPTION="Roba*" TOP="800" LEFT="1500" WIDTH="5054" HEIGHT="320" ALLOWEMPTY="TRUE"
			   SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
		<INPUT TYPE="text" NAME="search" CAPTION="Traženje pojma*" TOP="1200" LEFT="1500" WIDTH="5054" HEIGHT="320" ALLOWEMPTY="TRUE" />
		<INPUT TYPE="combo" NAME="klasaid" CAPTION="Klasa robe*" TOP="1600" LEFT="1500" WIDTH="5054" HEIGHT="320" ALLOWEMPTY="TRUE"
			   SQL="select KlMasterRobaid, oznaka+&apos;&apos;+naziv as naziv from KlMasterRoba order by SortKey"  />
		<INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" TOP="2000" LEFT="1500"/>
		<INPUT TYPE="checkbox" NAME="robaSaKalo" CAPTION="Pokaži samo robe koje imaju definiran % kala" TOP="2400" LEFT="1500"/>
		<INPUT TYPE="date" NAME="datumod" CAPTION="" TOP="2700" LEFT="1500" HEIGHT="302" WIDTH="1728" VISIBLE="False"  ENABLED="True"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="" TOP="2700" LEFT="4500" HEIGHT="302" WIDTH="1728" VISIBLE="False"  ENABLED="True"/>
	</ISPIS>

	<PROKNJIZI NAME="PROKNJIZI" HEIGHT="3802" WIDTH="7000" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Proknjižiti?" BORDERSTYLE="3" ONSUBMIT="spMPPregKala @action=1, @operateriid=@@operateriid,"
		 ONLOAD="SELECT @@trgovinaid as trgovinaid, @@datumod as datumod, @@datumdo as datumdo " CANCELONSUBMIT="" FILLEXPLORER="TRUE" NEXTFORM=""
		CMD1CAPTION="Proknjiži" CMD2CAPTION="Odustani"
		 >

	<INPUT TYPE="label" NAME="lbl1" TOP="100" LEFT="100"
		 HEIGHT="500" WIDTH="6800" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Nastat će dokument Kalo za zelene stavke, kao i za crvene ali samo do iznosa inventurne razlike. Prije knjiženja provjerite!" ENABLED="TRUE" TEXT="Label10"/>

	<INPUT TYPE="combo" NAME="trgovinaid" TOP="922" LEFT="1000"
		 HEIGHT="302" WIDTH="5069" VISIBLE="True" SQL="SELECT trgovinaid, opis from trgovina where trgovinaid=@@trgovinaid"
		 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD=""
		 CAPTION="Trgovina*" ENABLED="FALSE"/>

	<INPUT TYPE="date" NAME="datumod" TOP="1382" LEFT="1000"
		 HEIGHT="302" WIDTH="1728" VISIBLE="True" VALUE=""
		 TABINDEX="" CAPTION="Od datuma:*" ENABLED="False"/>

	<INPUT TYPE="date" NAME="datumdo" TOP="1843" LEFT="1000"
		 HEIGHT="302" WIDTH="1728" VISIBLE="True" VALUE=""
		 TABINDEX="9" CAPTION="Do datuma:*" ENABLED="False" SQL=""
		/>

</PROKNJIZI>
</PROJECT>