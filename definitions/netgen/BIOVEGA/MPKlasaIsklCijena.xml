<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpMPKlaseIskljuciCijenaDan @action = 1" 
   CMD1CAPTION=""
   CMD2CAPTION="" 
   CMD3CAPTION="Dodaj:INSERTFORM"
   CMD4CAPTION="" 
   CMD5CAPTION="Obriši:DELETEFORM"
   CMD6CAPTION=""
   DETAILGRID = "" 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK=":UPDATEFORM"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Isključenje klase za prikaz cijene na dan</NAME>
  <CAPTION>Isključenje klase za prikaz cijene na dan</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR></AUTOR>

  
  <INSERTFORM
		WIDTH="6000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="3500"
    VERSION="1.2"
    CAPTION="Unos"
		FOCUS="Opis"
		>

	  <INPUT TYPE="combo" CAPTION="Klasa:*" NAME="klmasterrobaid" TOP="500" LEFT="1000" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="TRUE"
				  SQL="select KlMasterRobaId, naziv from KlMasterRoba order by sortkey" />
	  <INPUT TYPE="checkbox" CAPTION="Uključi podklase*" NAME="podklase" TOP="1500" LEFT="1000" WIDTH="3500" HEIGHT="320" />


	  <INPUT TYPE="button" NAME="ok"           CAPTION="Spremi"   TOP="2000" LEFT="500" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpMPKlaseIskljuciCijenaDan @action = 2,@operateriid=@@operateriid, @klmasterrobaid=@@klmasterrobaid, @podklase=@@podklase
						      #ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close"  />
  </INSERTFORM>
	

  <DELETEFORM
      WIDTH="6000"
      ONSUBMIT=""
      ONLOAD="spmpMPKlaseIskljuciCijenaDan @action = 11, @id=@@id"
      HEIGHT="3500"
      VERSION="1.2"
      CAPTION="Brisanje"
      FOCUS=""
		>
	  <INPUT TYPE="combo" CAPTION="Klasa:*" NAME="klmasterrobaid" TOP="500" LEFT="1000" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE"
					   SQL="select KlMasterRobaId, naziv from KlMasterRoba order by sortkey" />
	  <INPUT TYPE="checkbox" CAPTION="Uključi podklase*" NAME="podklase" TOP="1500" LEFT="1000" WIDTH="3500" HEIGHT="320" ENABLED="FALSE" />


	  <INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ENABLED="TRUE"
			   ONCLICK="spmpMPKlaseIskljuciCijenaDan @action = 3, @id=@@id #ok"  HOTKEY="F2" />
    
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close"  />
  </DELETEFORM>

</PROJECT>
 
