		<INPUT TYPE="label" NAME="LabelBrojListova 30x39" TOP="5048" LEFT="288" HEIGHT="302" WIDTH="1210" CAPTION="Br. listova 30x39" TEXT="Label14" ONCLICK=""/>
		<INPUT TYPE="text" NAME="30bl" TOP="5236" LEFT="547" HEIGHT="446" WIDTH="821" TEXT="" SIZE="14" ONCLICK="" ENABLED="FALSE"/>
		
		<INPUT TYPE="label" NAME="LabelBrojListova 70x39" TOP="5848" LEFT="288" HEIGHT="302" WIDTH="1210" CAPTION="Br. listova 70x39" TEXT="Label15" ONCLICK=""/>
		<INPUT TYPE="text" NAME="70bl" TOP="6036" LEFT="547" HEIGHT="446" WIDTH="821" TEXT="" SIZE="14" ONCLICK="" ENABLED="FALSE"/>
		
		<INPUT TYPE="button" NAME="BtnIspis" TOP="7344" LEFT="259" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Ispiši" ENABLED="TRUE" 
			   ONCLICK=":ETIKETE"/>
		<INPUT TYPE="button" NAME="buttonCLOSE" TOP="7344" LEFT="1411" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

		<INPUT TYPE="text" NAME="ime" TOP="7488" LEFT="6264" HEIGHT="288" WIDTH="1440" VISIBLE="false"/>
		<INPUT TYPE="text" NAME="radio" TOP="7488" LEFT="4651" HEIGHT="288" WIDTH="1440" VISIBLE="false"/>
		<INPUT TYPE="text" NAME="tipdetalj" TOP="7488" LEFT="8651" HEIGHT="288" WIDTH="1440" VISIBLE="false"/>

	
	</MAINFORM>


	<RAZDOBLJE NAME="Razdoblje" HEIGHT="3960" WIDTH="2232" CAPTION="Razdoblje" BORDERSTYLE="3">
		<INPUT TYPE="text" NAME="action" TOP="29" LEFT="1627" HEIGHT="288" WIDTH="288" VISIBLE="false"/>
