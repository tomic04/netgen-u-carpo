		<INPUT TYPE="label" NAME="lblPP" TOP="2736" LEFT="230" HEIGHT="288" WIDTH="1728" CAPTION="prošlo polugodište" ONCLICK="select 9 as action#ok"/>
		<INPUT TYPE="label" NAME="lblPG" TOP="3024" LEFT="230" HEIGHT="288" WIDTH="1728" CAPTION="prošla godina" ONCLICK="select 10 as action#ok"/>
