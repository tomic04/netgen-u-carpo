		<INPUT TYPE="radio" NAME="zbirne" TOP="2880" LEFT="288" HEIGHT="288" WIDTH="1786" VISIBLE="TRUE" CAPTION="Zbirne" ENABLED="TRUE" 
			   ONCLICK="select 2 as radio#exec spMPDetQueryEtikete 3, @@glava, @@radio, '@@nizplavihajdijevadetalji',@@operateriid"/>
