	<NAME>Ispis Etiketa</NAME>
	<CAPTION>Ispis Etiketa</CAPTION>


	<MAINFORM
		INCLUDE=""
		NAME=" MAINFORM "
		HEIGHT="10000"
		WIDTH="15000"
		CAPTION="Ispis naljepnica"
		ONLOAD="select 1 as dokument, 0 as tipdetalj, 2 as action, '' as ime,  getdate() as datumdo,  dateadd(mm,-1,getdate()) as datumod, 1 as zbirne, 2 as radio"
		ONLOADED="select 1 as zbirne, 2 as radio, &apos;disable&apos; as BtnIspis, 2 as action"
		ONLOAD2="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname'"
		MAXIMIZEBOX="TRUE"
		WINDOWSTATE="0"
		VERSION="1.1"
		 >
		
				<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="144" HEIGHT="922" WIDTH="6264" TEXT="FrameNG0"/>
		<INPUT TYPE="frame" NAME="FrameNG9" TOP="2592" LEFT="144" HEIGHT="1512" WIDTH="2304" TEXT="FrameNG3" CAPTION="Vrste naljepnica"/>
		
		<INPUT TYPE="button" NAME="ButtonRazdoblje" TOP="403" LEFT="360" HEIGHT="331" WIDTH="1008" TEXT="ButtonNG11" CAPTION="Razdoblje" ONCLICK=":RAZDOBLJE#spDatumi @action = @@action"/>
		<INPUT TYPE="button" NAME="ButtonPokazi" TOP="403" LEFT="6624" HEIGHT="331" WIDTH="1296" TEXT="ButtonNG0" CAPTION="Pokaži" ONCLICK="select &apos;refresh&apos; as glava
			#exec spMPDetQueryEtikete 3, @@glava, @@radio, '@@nizplavihajdijevadetalji',@@operateriid
			#if @@detalji = 0 select &apos;disable&apos; as BtnIspis else select &apos;enable&apos; as BtnIspis"/>
		
		<INPUT TYPE="date" NAME="datumdo" TOP="432" LEFT="4306" HEIGHT="302" WIDTH="1728" />
		<INPUT TYPE="date" NAME="datumod" TOP="432" LEFT="2030" HEIGHT="302" WIDTH="1728" />
