		<INPUT TYPE="grid" NAME="detalji" TOP="4248" LEFT="2592" HEIGHT="2952" WIDTH="7760" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" 
			   SQL="spMPDetQueryEtikete 0,  @@glava" 
			   ONCLICK="exec spMPDetQueryEtikete 3, @@glava, @@radio, '@@nizplavihajdijevadetalji',@@operateriid">
			
			<COLUMN INDEX="" NAME="Naziv" WIDTH="4500" CAPTION="Roba" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="JM" WIDTH="800" CAPTION="JM" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="Kolicina" WIDTH="1000" CAPTION="Količina" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="CIJENA" WIDTH="1000" CAPTION="Cijena" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="BROJ" WIDTH="1000" CAPTION="Broj dokumenta" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="robakod" WIDTH="800" CAPTION="RobaKod" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="id2" WIDTH="1200" CAPTION="id2" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="barcode" WIDTH="1200" CAPTION="Barkod" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="Datumdok" WIDTH="1000" CAPTION="Datum dokumenta" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="Iznospak" WIDTH="1000" CAPTION="Iznos pakiranja" FORMAT="" VISIBLE="false" AGREGATEFUNCTION="" />

		</INPUT>
		
