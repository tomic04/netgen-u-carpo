		<INPUT TYPE="label" NAME="LabelDo" TOP="461" LEFT="3888" HEIGHT="288" WIDTH="432" CAPTION="Do:" ONCLICK=""/>
		<INPUT TYPE="label" NAME="LabelDok" TOP="1152" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Dokument:" TEXT="Label17" 
			   ONCLICK="ok"/>
		
		<INPUT TYPE="grid" NAME="glava" TOP="1152" LEFT="2592" HEIGHT="3024" WIDTH="7760" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" SKIPDEFAULTLOAD="TRUE" 
			   SQL="exec spMPGlaQueryEtikete @@Dokument ,@@datumod, @@datumdo,0,@@trgovinaid " 
			   ONCLICK="select &apos;refresh&apos; as detalji
			   #exec spMPDetQueryEtikete 3, @@glava, @@radio, '@@nizplavihajdijevadetalji',@@operateriid
			   #if @@detalji = 0 select &apos;disable&apos; as BtnIspis else select &apos;enable&apos; as BtnIspis">
			
			<COLUMN INDEX="" NAME="Broj" WIDTH="2500" CAPTION="Broj dokumenta" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="DatumDok" WIDTH="1000" CAPTION="Datum dokumenta" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
			<COLUMN INDEX="" NAME="PartnerNaziv" WIDTH="3500" CAPTION="Dobavljač" FORMAT="" VISIBLE="true" AGREGATEFUNCTION="" />
		</INPUT>
		
		<INPUT TYPE="combo" NAME="Dokument" TOP="1440" LEFT="288" HEIGHT="302" WIDTH="2160" 
			   SQL="select 1 as oznakaid, 'Direktno zaduženje iz MP' as naziv
			   union all
			   select 2 as oznakaid, 'Izdatnica iz VP u MP' as naziv
			   union all
			   select 4 as oznakaid, 'Nivelacija' as naziv
			   union all
			   select 5 as oznakaid, 'Predispozicija ulaz' as naziv
			   union all
			   select 6 as oznakaid, 'Početno stanje' as naziv" 
			   ALLOWEMPTY="false" ONLOSTFOCUS=""/>
		
		<INPUT TYPE="label" NAME="LabelTrgovina" TOP="1800" LEFT="288" HEIGHT="288" WIDTH="1296" CAPTION="Trgovina:" TEXT="Label18" ONCLICK=""/>
