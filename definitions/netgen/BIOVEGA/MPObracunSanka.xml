<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION="Donos utrška:UTRZAK"
		 CMD3CAPTION="Obračun proizvodnje:PROIZVODNJA" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Pregled utroška sirovina "
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT=""
		 PAGEORIENTATION="LANDSCAPE"
     PAGEHEADERLEFT="Od @@datumod do @@datumdo"
     PAGEHEADERRIGHT="@@tkosmomi"
     SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">

	
	<NAME>Pregled utroška sirovina </NAME>
	<CAPTION>Pregled utroška sirovina  </CAPTION>
	<AUTOR>4.6.2009. im </AUTOR>

	<MASTERCOLUMNS>
		
		<COLUMN INDEX="9" NAME="" WIDTH="1100" CAPTION="" FORMAT="#,##0.0000" VISIBLE="" AGREGATEFUNCTION="2"/>
		<COLUMN INDEX="11" NAME="" WIDTH="1100" CAPTION="" FORMAT="#,##0.0000" VISIBLE="" AGREGATEFUNCTION="2"/>
	</MASTERCOLUMNS>


<FILTERFORM NAME="FILTERFORM" 
		 HEIGHT="5254" 
		 WIDTH="7710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPPregPromSirovina @action = 2,  @operateriid= @@operateriid, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" >
		 
		 <INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:" DEFAULT="firstdayofmonth"/>
		 <INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:" />
	     <INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:"   ALLOWEMPTY="TRUE"  ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />

    <INPUT TYPE="search"  CAPTION="Klasa" NAME="klasaid" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW"
      SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
  
    <!--<INPUT TYPE="search" NAME="klasaid"  CAPTION="Klasa:"    SQL="viklaserobe#klmasterrobaid#%naziv%" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />-->  
	
    <INPUT TYPE="search" NAME="robaid"          CAPTION="Roba:"    SQL="viroba#robaid#%naziv%#%jmnaziv%#%robakod%#!barcode" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />  
				 
</FILTERFORM>


	<UTRZAK NAME="FILTERFORM"
			 HEIGHT="6000"
			 WIDTH="7710"
			 VERSION="1"	
			CAPTION="Donos utška sa blagajne"
			 ONSUBMIT="spMPPregPromSirovina @action = 3,   "
			 ONLOAD="select @@trgovinaid as trgovinaid , @@datumod as datumod , @@datumdo as datumdo "
			 FILLEXPLORER="TRUE"
			 NEXTFORM=""
			 CMD1CAPTION="Donesi"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:*" DEFAULT="" ENABLED="FALSE" TOP="500" LEFT="1000"/>
		<INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:*" ENABLED="FALSE" TOP="900" LEFT="1000"/>
		<INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:*"   ALLOWEMPTY="TRUE"  ENABLED="FALSE" ONLOSTFOCUS="" TOP="1300" LEFT="1000" SQL="spMPDajTrgovina @operateriid = @@operateriid " />


		<INPUT TYPE="grid" NAME="utrzak" TOP="1800" LEFT="200" WIDTH="5500" HEIGHT="2500"
			CAPTION="Preneseni utršci"
			TOTALROW="FALSE"
			CHECKBOXVISIBLE="TRUE"
			PAGEHEADERCENTER=""
			PAGEHEADERRIGHT=""
			GROUPBYBOXVISIBLE="FALSE"
			ONCLICK="select 'refresh' as dani"
			ONDBLCLICK=""
			PAGEHEADERLEFT=""
			PAGEFOOTERCENTER=""
			PAGEFOOTERLEFT=""
			PAGEFOOTERRIGHT=""
			PAGEORIENTATION="LANDSCAPE"
			SQL="spMPPregPromSirovina @action = 4, @trgovinaid = @@trgovinaid , @datumod = @@datumod , @datumdo = @@datumdo" >
		</INPUT>



		<!--<INPUT TYPE="search" NAME="klasaid"  CAPTION="Klasa:"    SQL="viklaserobe#klmasterrobaid#%naziv%" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />-->


	</UTRZAK>

	<PROIZVODNJA NAME="PROIZVODNJA"
			 HEIGHT="6000"
			 WIDTH="7710"
			 VERSION="1"
			CAPTION="Obračun proizvodnje"
			 ONSUBMIT="exec spmpobracunProizvodnjeJob @action = 0,   "
			 ONLOAD="select @@trgovinaid as trgovinaid , @@datumod as datumod , @@datumdo as datumdo "
			 FILLEXPLORER="TRUE"
			 NEXTFORM=""
			 CMD1CAPTION="Obračunaj"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:*" DEFAULT="" ENABLED="FALSE" TOP="500" LEFT="1000"/>
		<INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:*" ENABLED="FALSE" TOP="900" LEFT="1000"/>
		<INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:*"   ALLOWEMPTY="TRUE"  ENABLED="FALSE" ONLOSTFOCUS="" TOP="1300" LEFT="1000" SQL="spMPDajTrgovina @operateriid = @@operateriid " />


		<INPUT TYPE="grid" NAME="utrzak" TOP="1800" LEFT="200" WIDTH="5500" HEIGHT="2500"
			CAPTION="Razduženja sirovina"
			TOTALROW="FALSE"
			CHECKBOXVISIBLE="TRUE"
			PAGEHEADERCENTER=""
			PAGEHEADERRIGHT=""
			GROUPBYBOXVISIBLE="FALSE"
			ONCLICK="select 'refresh' as dani"
			ONDBLCLICK=""
			PAGEHEADERLEFT=""
			PAGEFOOTERCENTER=""
			PAGEFOOTERLEFT=""
			PAGEFOOTERRIGHT=""
			PAGEORIENTATION="LANDSCAPE"
			SQL="spMPPregPromSirovina @action = 5, @trgovinaid = @@trgovinaid , @datumod = @@datumod , @datumdo = @@datumdo" >
		</INPUT>



		<!--<INPUT TYPE="search" NAME="klasaid"  CAPTION="Klasa:"    SQL="viklaserobe#klmasterrobaid#%naziv%" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />-->


	</PROIZVODNJA>


</PROJECT>