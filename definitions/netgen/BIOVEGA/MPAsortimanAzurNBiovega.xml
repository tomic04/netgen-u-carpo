	<DODAJFORM 
                 WIDTH="8000" 
                 ONSUBMIT="" 
                 ONLOAD="select coalesce('@@node',0) as partneriid, null as robaid, '' as sifra1 , (select naziv from partneri where partneriid = coalesce('@@node',0) ) as Partner, 1 as doduMP" 
