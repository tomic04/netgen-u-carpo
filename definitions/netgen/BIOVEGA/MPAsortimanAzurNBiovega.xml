                 CAPTION="Unos novog artikla u asortiman"  
                 CMD1CAPTION="" 
                 CMD2CAPTION="" 
		 FILLEXPLORER="" 
		 >
		<INPUT TYPE="search" NAME="partneriid"  CAPTION="Partner*"  TOP="100" LEFT="1790" TABINDEX="-11" SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="532" LEFT="1790" WIDTH="4998" TABINDEX="1" COLUMNWIDTH="" 
							COLUMNCAPTION="" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG  @trazi = '@@searchboxrobaid'" 
							ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
		<INPUT TYPE="text" CAPTION="Šifra kod dobavljača:*" NAME="sifra1" TOP="1032"  LEFT="1790"  TABINDEX="5"   WIDTH="800" HEIGHT="320" ENABLED="TRUE" ALOWEMPTY ="FALSE"/>
		<INPUT TYPE="checkbox" NAME="doduMP"  CAPTION="Dodaj u asortiman MP" TABINDEX="-11" TOP="1032" LEFT="3500"    />
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="Tipovi objekata:" TOP="1500"   LEFT="1200"   WIDTH="4800" HEIGHT="3300"   />

		<INPUT TYPE="grid" 
			   NAME="tipovi" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="1700" LEFT="1800" WIDTH="5400" HEIGHT="3000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=":" 
			   EDITCOLUMNS="[Asortiman(DA/NE)1200], [Količina1000]"
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"	
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="select parasortimantipid, Naziv as [Naziv1900], cast(1 as bit) as Asortiman1200 , 
			   cast(3 as money) as [Količina1000], j.faktor as [Pakovanje1000] from parasortimantip left outer join jmroba j on @@robaid = j.robaid and j.defaultind = 1 where naziv not like 'xx%'" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="5000" LEFT="396" WIDTH="1106" HEIGHT="322" TABINDEX="3"   
			   ONCLICK="if @@robaid is null begin exec spRaiserror 69001, 'Niste odabrali robu!!' end
						#if @@partneriid is null begin exec spRaiserror 69001, 'Niste odabrali partnera!!' end
						#FOREACHROW(tipovi)#if @@robaid is not null and @@partneriid is not null and '@(tipovi..Asortiman1200)' =  'true'  begin 
								exec spMPParAsortimanPregledNG @action=2, @partneriid = @@partneriid, @robaid  = @@robaid, @sifra1 = '@@sifra1', @tipid = @@tipovi , @doduMP = @@doduMP, @kolicina =  @(tipovi..Količina1000), @operateriid=@@operateriid end 
						#OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5000" LEFT="1756" WIDTH="1106" HEIGHT="322" TABINDEX="4"   ONCLICK="close"  />

	</DODAJFORM>


