<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD=""
   TREE=""
   DETAILGRID=""
   FILLEXPLORER="TRUE"
	BUTTONS=""
   CMD1CAPTION=""
	AUTOMATICSORT="FALSE"
   CMD2CAPTION=""
   CMD6CAPTION=""
   CMD4CAPTION=""
   CMD3CAPTION=""
   CMD5CAPTION="MAINFORM:MAINFORM"
	FILTERMODE="TRUE" 
   
		 EDITCOLUMNS=""
	ONCELLEDITED=""
	EDITCOLUMNSDET=""
	ONCELLEDITEDDET=""
   CHECKBOXVISIBLE="FALSE"
   TOTALROWVISIBLE="FALSE"
   ENTERKEYBEHAVIOR="0"
   POPUPMASTER=""
	COMMANDTIMEOUT="300"
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK="">

	<NAME>Dani kreiranja automatske narudžbe MP</NAME>
  <CAPTION>Dani kreiranja automatske narudžbe MP</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> </AUTOR>

	<MAINFORM CAPTION="Dani kreiranja automatske narudžbe MP" 
			  WIDTH="15000" HEIGHT="8000" COMMANDTIMEOUT="300" WINDOWSTATE="2" 
			  VERSION="4" DBCLIPBOARD="FALSE" ONLOAD="" FILLEXPLORER="">


		<INPUT TYPE="PANEL" DOCK="2" HEIGHT="800" NAME="panel2"/>
		<INPUT TYPE="PANEL" DOCK="1" HEIGHT="1000" NAME="panel1"/>

		<INPUT TYPE="combo" NAME="skladisteid"  CAPTION="Skladište*" WIDTH="3500" TOP="400" LEFT="1000" SQL="select skladisteid, opis as naziv from skladiste  where skladisteid in (2, 213)"
			   ONLOSTFOCUS="" ALLOWEMPTY="TRUE" BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="button" NAME="b0"  TOP="400" LEFT="5000" CAPTION="Pokaži podatke" WIDTH="1500" ONCLICK="select 'refresh' as stavke" />



		<INPUT TYPE="grid"  
			   CHECKBOXVISIBLE="FALSE" 
			   TOTALROW="FALSE" 
			   EDITCOLUMNS="spmpdaniisporukeskt @action = 1" 
			   NAME="stavke"
			   ONCELLEDITED="spmpdaniisporukeskt @action = 3, @lastvalue = '@@lastvalue', @editedcolumn = '@@editedcolumn', @skladisteid = @@skladisteid, @trgovinaid=@@trgovinaid, @operateriid=@@operateriid"
			   SQL="spmpdaniisporukeskt @action=2, @skladisteid=@@skladisteid "
			   DOCK="5" 
			   SKIPDEFAULTLOAD="true" />

		<INPUT TYPE="button1" TOP="120" LEFT="2000" HEIGHT="500" CAPTION="IZLAZ" ONCLICK="close" PARENT="panel2"/>
	


	</MAINFORM>


</PROJECT>
 
