<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
	ONLOAD=":FORM1"  		
	BUTTONS="Parametri:FORM1#Kartica robe:MPKARTICA#Print dok.:repx/rptMPAutomNivelacija"
	DETAILGRID="spMPPregAutomNivelacijaNG @action=2,@MPNivelGlaid=@@ID"
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	DETTOTALROWVISIBLE="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
   PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Zapisnik o promjeni cijena - automatski</NAME>
  <CAPTION>Zapisnik o promjeni cijena - automatski</CAPTION>
  

 <FORM1 	
	FILLEXPLORER="TRUE" 
	WIDTH="8000" 
	ONSUBMIT="spMPPregAutomNivelacijaNG @action=1, @operateriid = @@operateriid," 
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
	HEIGHT="3000" 
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	 <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*"  VALUE="DATE2" DEFAULT="firstdayofmonth" TOP="400" LEFT="1000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	 <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" VALUE="DATE"  TOP="800" LEFT="1000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	 <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="1200" LEFT="1000" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid"/>


 </FORM1>



<MPKARTICA
	FILLEXPLORER="TRUE" 
	WIDTH="14000" 
	ONSUBMIT="" 
	ONLOAD="" 
	HEIGHT="7500" 
	CAPTION="Kartica robe" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION="" 
	NEXTFORM=""> 
	
			
	<INPUT TYPE="grid" 
		NAME="stavke" 
		REFRESHAFTERCHILD="TRUE" 
		CHECKBOXVISIBLE="FALSE"
		CAPTION="_ay" 
		TOP="200" 
		LEFT="200"  
		WIDTH="13500" 
		HEIGHT="6000" 
		SQL="spMPPregAutomNivelacijaNG @action=3,@MPNivelGlaid=@@id, @robaid=@@robaid" /> 

</MPKARTICA>		






</PROJECT> 