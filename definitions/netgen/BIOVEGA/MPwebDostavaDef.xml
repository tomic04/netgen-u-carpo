<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Unesi:DOSTAVAINSERT" CMD2CAPTION="Izmijeni:DOSTAVAUPDATE" CMD3CAPTION="Obriši:DOSTAVADELETE" CMD5CAPTION="Ispiši:PRINTMASTER " 
		  ONLOAD="smmpwebdostave @action=1" GROUPBYBOXVISIBLE="FALSE" FROZENCOLUMNS="0" MASTERDBLCLICK="NUTRITIVNEUPDATE" 
		  CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE" HELPKOD="">
<NAME>Projekt</NAME>
<CAPTION>MP WEB dostava</CAPTION>
<KOMENTAR>CallistoII 2.9.0</KOMENTAR>
<HISTORY>
</HISTORY>


	<DOSTAVAINSERT NAME="DOSTAVAINSERT" HEIGHT="4000" WIDTH="5890" CAPTION="Unesi robu i prag za webshop" REFRESHAFTERCHILD="TRUE" VERSION="1" BORDERSTYLE="3">

		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TABINDEX="0" TOP="500" LEFT="1200" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'"
						ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid"
						BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>

		<INPUT TYPE="number" NAME="iznosod"	  CAPTION="Iznos (prag) od*" TABINDEX="-1" TOP="1000" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />
		<INPUT TYPE="number" NAME="iznosdo"	  CAPTION="Iznos (prag) do*" TABINDEX="-1" TOP="1500" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />
		<INPUT TYPE="number" NAME="iznosx"	  CAPTION="Iznos dostave *" TABINDEX="-1" TOP="2000" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />
		
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="3000" LEFT="1368" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" 
		   TEXT="ButtonNG1" CAPTION="Odustani" TABINDEX="50" ENABLED="TRUE" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="3000" LEFT="216" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" 
		   TEXT="ButtonNG0" CAPTION="Spremi" TABINDEX="40" ENABLED="TRUE" ONCLICK="smmpwebdostave @action=2, @iznosod=@@iznosod, @iznosdo=@@iznosdo, @iznos=@@iznosx, @robaid =@@robaid#OK"/>

</DOSTAVAINSERT>

	<DOSTAVADELETE NAME="DOSTAVADELETE" HEIGHT="4000" WIDTH="5890" CAPTION="Obriši robu i prag za webshop">

		<INPUT TYPE="text"   NAME="nazivrobe"     CAPTION="Roba*" TOP="500" LEFT="1200" HEIGHT="317" WIDTH="4997"  TABINDEX="0" ENABLED="FALSE" />

		<INPUT TYPE="number" NAME="iznosod"	  CAPTION="Iznos (prag) od*" TABINDEX="-1" TOP="1000" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />
		<INPUT TYPE="number" NAME="iznosdo"	  CAPTION="Iznos (prag) do*" TABINDEX="-1" TOP="1500" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />
		<INPUT TYPE="number" NAME="iznosx"	  CAPTION="Iznos dostave *" TABINDEX="-1" TOP="2000" LEFT="1200" WIDTH="1596" ENABLED="FALSE" SQL="" />

	<INPUT TYPE="button" NAME="button1" TOP="3000" LEFT="216" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG2" CAPTION="Obriši" TABINDEX="20" 
		   ONCLICK="smmpwebdostave @action=4, @id=@@id#OK"/>
	<INPUT TYPE="button" NAME="button2" TOP="3000" LEFT="1368" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG3" CAPTION="Odustani" TABINDEX="10" ONCLICK="CLOSE"/>

</DOSTAVADELETE>

		<DOSTAVAUPDATE NAME="DOSTAVAUPDATE" HEIGHT="4000" WIDTH="5890" CAPTION="Izmijeni robu i prag za webshop" 
					   ONLOAD="smmpwebdostave @action=11, @id=@@id" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">

			<INPUT TYPE="text"   NAME="nazivrobe"     CAPTION="Roba*" TOP="500" LEFT="1200" HEIGHT="317" WIDTH="4997"  TABINDEX="0" ENABLED="FALSE" />

			<INPUT TYPE="number" NAME="iznosod"	  CAPTION="Iznos (prag) od*" TABINDEX="-1" TOP="1000" LEFT="1200" WIDTH="1596" ENABLED="" SQL="" />
			<INPUT TYPE="number" NAME="iznosdo"	  CAPTION="Iznos (prag) do*" TABINDEX="-1" TOP="1500" LEFT="1200" WIDTH="1596" ENABLED="" SQL="" />
			<INPUT TYPE="number" NAME="iznosx"	  CAPTION="Iznos dostave *" TABINDEX="-1" TOP="2000" LEFT="1200" WIDTH="1596" ENABLED="" SQL="" />
			
	<INPUT TYPE="button" NAME="buttonOK" TOP="3000" LEFT="216" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Spremi" TABINDEX="40" ENABLED="TRUE" 
		   ONCLICK="smmpwebdostave @action=3, @id=@@id, @iznosod=@@iznosod, @iznosdo=@@iznosdo, @iznos=@@iznosx#OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="3000" LEFT="1368" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" TABINDEX="50" ENABLED="TRUE" ONCLICK="CLOSE"/>

</DOSTAVAUPDATE>


</PROJECT>