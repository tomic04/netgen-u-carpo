<FILTERFORM NAME="FILTERFORM" HEIGHT="5530" WIDTH="5890" CAPTION="Parametri" ONSUBMIT="spRealizacijaNabaveTotalNG @DatumOd=@@DatumOd, @DatumDo=@@DatumDo,
@RobaId=@@RobaId, @PartneriId=@@PartneriId, @SkladisteId=@@SkladisteId, @KlasaId=@@KlMasterRobaId, @podklase=@@PodKlase, @action=@@action--" ONLOAD="select @@DatumOd as DatumOd, @@DatumDo as DatumDo, @@SkladisteID as SkladisteId, @@KlMasterRobaId as KlMasterRobaId, @@PodKlase as PodKlase, @@RobaId as RobaId, (select naziv from roba where robaid=@@robaid) as Roba, @@PartneriId as PartneriId, (select naziv from partneri where partneriid=@@partneriid) as Partner,@@ParStruId as ParStruId, (select naziv from parstru where parstruid=@@parstruid) as Lokacija, @@DodJMId as DodJMId, @@action as action" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="date" NAME="DatumOd" TOP="115" LEFT="1714" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="label" NAME="Label14" TOP="115" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Datum od:" TEXT="Label14"/>
	<INPUT TYPE="date" NAME="DatumDo" TOP="490" LEFT="1714" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="label" NAME="Label15" TOP="490" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Datum do:" TEXT="Label15"/>
	<INPUT TYPE="combo" NAME="SkladisteId" TOP="864" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="select skladisteid, oznaka +&apos; &apos;+ opis from skladiste" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label16" TOP="864" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Skladište:" TEXT="Label16"/>
	<INPUT TYPE="combo" NAME="KlMasterRobaId" TOP="1224" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="select klmasterrobaid, sortkey + &apos; &apos; + naziv from klmasterroba order by sortkey" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label17" TOP="1224" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Klasa robe:" TEXT="Label17"/>
	<INPUT TYPE="check" NAME="PodKlase" TOP="1685" LEFT="1714" HEIGHT="288" WIDTH="3715" CAPTION="i ispod"/>
	<INPUT TYPE="search" NAME="RobaId" TOP="2088" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="spTraziRoba @action=&apos;Roba&apos;, @uvjet=&apos;@@searchboxrobaid&apos;" CAPTION="Roba"/>
	<INPUT TYPE="label" NAME="Label19" TOP="2088" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Roba:" TEXT="Label19"/>
	<INPUT TYPE="search" NAME="PartneriId" TOP="2462" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="spTraziPartneri @action=&apos;partneri1&apos;, @uvjet=&apos;@@searchboxpartneriid&apos;" CAPTION="Partner"/>
	<INPUT TYPE="label" NAME="Label20" TOP="2462" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Partner:" TEXT="Label20"/>
	<INPUT TYPE="search" NAME="ParStruId" TOP="2808" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="spTraziParstru @action=&apos;Parstru&apos;, @uvjet=&apos;@@searchboxParStruId&apos;, @partneriid=@@partneriid" CAPTION="Lokacija"/>
	<INPUT TYPE="label" NAME="Label21" TOP="2808" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Lokacija:" TEXT="Label21"/>
	<INPUT TYPE="combo" NAME="DodJMId" TOP="3154" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="select jmid,naziv from jm order by naziv" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label22" TOP="3154" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Dodatna JM:" TEXT="Label22"/>
	<INPUT TYPE="combo" NAME="Action" TOP="3917" LEFT="1714" HEIGHT="302" WIDTH="3715" SQL="select 1 as action, &apos;Rekapitulacija po robi i skladištu&apos; as Naziv" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label23" TOP="3917" LEFT="115" HEIGHT="288" WIDTH="1512" CAPTION="Rekapitulacija po:" TEXT="Label23"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="4464" LEFT="101" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" ENABLED="TRUE" ONCLICK="OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="4464" LEFT="1253" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

