<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FORM1" 
   CMD1CAPTION="Filter:FORM1"    
   CMD2CAPTION=""    
   CMD3CAPTION="Analitika po računima:ANALITIKA" 
   CMD4CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   POPUPMASTER=""
   COMMANDTIMEOUT="300"
   MASTERDBLCLICK="FORM1">
 
  <NAME>Pregled prometa po članu</NAME>
  <CAPTION>Pregled prometa po članu</CAPTION>
 
 

  <FORM1 
                         FILLEXPLORER="TRUE"
						 WIDTH="8000" 
                         ONSUBMIT="spMPPregRobeMPClan @action=0," 
                         ONLOAD="select @@trgovinaid as trgovinaid, @@datod as datod, @@datdo as datdo, @@mpclanoviid as mpclanoviid"
                         HEIGHT="4800" 
                         CAPTION="Unesite parametre pregleda"
			             BORDERSTYLE="3"   
                         CMD1CAPTION="Pokaži" 
                         CMD2CAPTION="Odustani" >

			<INPUT TYPE="combo" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="spmpDajTrgovina @operateriid=@@operateriid" 
					TEXT=""
					TABINDEX="1" 
					ALLOWEMPTY="TRUE"
					WIDTH="4500" 
					ENABLED="TRUE"
					HEIGHT="320"/>


           <INPUT TYPE="date" 
				NAME="datod" 
				CAPTION="Od " 
				SQL=""  
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="1" 
				CHECKBOX="FALSE" />


			<INPUT TYPE="date" 
				NAME="datdo" 
				CAPTION="Do " 
				TABINDEX="2" 
				TEXT="" 
				DECIMALS="0" 
				HEIGHT="320"/>



			<INPUT TYPE="search" 
				CAPTION="Član " 
				NAME="mpclanoviid" 
				SQL="spMPDajClana @trazi='@@searchboxmpclanoviid'"
				TABINDEX="3" 
				TEXT="" 
				DECIMALS="0" 
				WIDTH="4000" 
				HEIGHT="320"/>

				<INPUT TYPE="VB.checkbox" 
                                   	NAME="Sve" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="Pokaži cijeli promet člana"/>

	  
				<INPUT TYPE="VB.checkbox"
							NAME="racun"
							WIDTH="3500"
							HEIGHT="320"
							CAPTION="Kumulativ po računu"/>

	  
				<INPUT TYPE="VB.checkbox"
						NAME="clan"
						WIDTH="3500"
						HEIGHT="320"
						CAPTION="Kumulativ po članu"/>

	  
	  <INPUT TYPE="search" NAME="partneriid"  CAPTION="Partner"  SQL="spMPClanoviAzurNG @action = 4, @partner = '@@searchboxpartneriid'"  ALLOWEMPTY="TRUE" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />



  </FORM1>
	<ANALITIKA
		  FILLEXPLORER=""
		  WIDTH="14500"
		  ONSUBMIT=""
		  ONLOAD=""
		  HEIGHT="10000"
		  VWRSION="1.2"
		  CAPTION="Analitika po računima">

		<INPUT TYPE="grid"
			NAME="kartica"
			TOP="700"
			LEFT="300"
			WIDTH="12000"
			CHECKBOXVISIBLE="FALSE"
			TOTALROWVISIBLE="FALSE"
			GROUPBYBOXVISIBLE="FALSE"
			HEIGHT="8000"
			CAPTION=""
			REFRESHAFTERCHILD="TRUE"
			SQL="spMPPregRobeMPClan @action=2,@robaid = @@robaid,  @datod=@@datod, @datdo = @@datdo , @mpclanoviid = @@mpclanoviid, @trgovinaid = @@trgovinaid , @sve = @@sve " />

		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</ANALITIKA>




</PROJECT>
 
