<UPDATE NAME="UPDATE" HEIGHT="2966" WIDTH="5602" CAPTION="Pretvorba povrata" ONSUBMIT="if @@robaidpovzamjena is null OR @@robaidstarizamjena is null raiserror(&apos;Morate odabrati obje stavke!&apos;, 16, 1)
else
exec
spRobaPakiranjaPovratAzur @action = 2, @Sirovinarobaid = &apos;@@robaidpovzamjena&apos;, @robaid = &apos;@@robaidstarizamjena&apos;, @tezina=@@Tezina,@id=@@id--" ONLOAD="select r2.Naziv as Povrat, r1.Naziv as StariKruh, r2.robaid as robaidpovzamjena, r1.robaid as robaidstarizamjena, rp.tezina as tezina  
from robapakiranja rp
inner join roba r1 ON rp.RobaId = r1.RobaId
inner join roba r2 On rp.SirovinaRobaId = r2.RobaId
where RobaPakiranjaId=@@id">
