	<INPUT TYPE="label" NAME="lblRobaid" TOP="878" LEFT="475" HEIGHT="288" WIDTH="1397" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Roba - Stari kruh" ENABLED="TRUE" TEXT="Label28"/>
