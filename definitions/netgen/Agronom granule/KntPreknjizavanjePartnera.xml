<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
 CMD1CAPTION="Parametri:FILTERFORM" 
 CMD2CAPTION="Proknjiži:MULTISELECTPROKNJIZI " 
 CMD3CAPTION="Ispis:PRINTMASTER"  
 ONLOAD=":FILTERFORM" 
 GROUPBYBOXVISIBLE="TRUE" 
 COMMANDTIMEOUT="300"
 FROZENCOLUMNS="0" 
 MASTERDBLCLICK="" 
 CHECKBOXVISIBLE="TRUE"
 PAGEORIENTATION="LANDSCAPE"
 PAGEHEADERCENTER="Knjiženje s partnera na partnera" 
 PAGEHEADERLEFT=""
 PAGEHEADERRIGHT="@@Vrijeme" 
 PAGEFOOTERLEFT="@@TKOSMOMI" 
 PAGEFOOTERRIGHT="Jupiter software by Spin">



 <NAME>Knjiženje s partnera na partnera</NAME>
 <CAPTION>Knjiženje s partnera na partnera</CAPTION>



  <MASTERCOLUMNS>

	   
  </MASTERCOLUMNS>   


<FILTERFORM 
					
                 WIDTH="4200" 
                 ONLOAD="select  (select  rtrim(p.naziv)+''+rtrim(m.naziv)+','+rtrim(s.adresa)
					from Partneri p
					inner join ParStru s on p.PartneriId = s.PartneriId
					inner join Mjesta m on s.MjestaId = m.MjestaId
				where
					p.PartneriId = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))
					and s.Hqind = '*') as tkosmomi, getdate() as Vrijeme"
		 ONLOADED=" "
                 ONSUBMIT="exec spKntPreknjizavanjePartnera 	@Action=1,@DatumKnjizenja=@@DatumKnjizenja,@vrstadokid=@@vrstadokid,@PartnerSTARIid=@@PartnerSTARIid,@PartnerNOVIid=@@PartnerNOVIid,@operateriid=@@operateriid !!"                                                                                          
                 HEIGHT="3700" 
                 CAPTION="Parametri"
		 
                 FILLEXPLORER="TRUE"
  		 >



		<INPUT TYPE="label" NAME="lblpartneri"  TOP="220" LEFT="220" WIDTH="1000" CAPTION="Partner STARI:" TABINDEX="0" />	
		<INPUT TYPE="search" NAME="PartnerSTARIid"   TOP="220"
			   LEFT="1400" WIDTH="2400" SQL="viPartneri#partneriid#%Naziv%#!Sifra#!Adresa#!Telefon1#!Telefon2#!Fax#!MatBroj#!MjestaNaziv" ALLOWEMPTY="FALSE" 
			   CAPTION="partner" ONLOSTFOCUS=""/> 

		

		<INPUT TYPE="label" NAME="lblpartneri"  TOP="820" LEFT="220" WIDTH="1000" CAPTION="Partner NOVI:" TABINDEX="1" />	
		<INPUT TYPE="search" NAME="PartnerNOVIid"   TOP="820"
			   LEFT="1400" WIDTH="2400" SQL="viPartneri#partneriid#%Naziv%#!Sifra#!Adresa#!Telefon1#!Telefon2#!Fax#!MatBroj#!MjestaNaziv" ALLOWEMPTY="FALSE" 
			   CAPTION="partner" ONLOSTFOCUS=""/> 

			
		<INPUT TYPE="label" NAME="lblvrstadok"  TOP="1420" LEFT="220" WIDTH="1000" CAPTION="Vrsta dok.:"/>	   
		<INPUT TYPE="combo"  NAME="vrstadokid"    TOP="1420" LEFT="1400" WIDTH="2400" ALLOWEMPTY="FALSE" TABINDEX="2" 
			   SQL="select vd.VrstaDokId,vd.Opis
					   from VrstaDok vd
					   inner join VrstaProm vp on vd.VrstaPromId = vp.VrstaPromId
					   where vp.VrstaPromId in (select VrstaPromId from VrstaProm where Projekt = 'K' and sifra='57')
					   order by vd.Opis "/>
  	               
		<INPUT TYPE="label" NAME="lbldatum"  TOP="2020" LEFT="220" WIDTH="1000" CAPTION="Datum knjiženja:" />
		<INPUT TYPE="date" NAME="DatumKnjizenja"  TOP="2020" LEFT="1400" WIDTH="1500"  CAPTION="Datum knjiženja: " TABINDEX="3" />
	       
		           
		<INPUT TYPE="button" NAME="ok" TOP="2700" LEFT="100" WIDTH="1200" CAPTION="Izvrši" 
		ONCLICK="Ok"/>

		<INPUT TYPE="button" NAME="cancle" TOP="2700" LEFT="1500" WIDTH="1200" CAPTION="Izlaz" 
		ONCLICK="close"/>
		
                  />

</FILTERFORM>

	


  <MULTISELECTPROKNJIZI  FILLEXPLORER="TRUE"  WIDTH="4500"  HEIGHT="1800" 
                  ONLOAD="" 
                  ONSUBMIT="exec spKntPreknjizavanjePartnera @Action=2,@DatumKnjizenja=@@DatumKnjizenja,@vrstadokid=@@vrstadokid,@PartnerSTARIid=@@PartnerSTARIid,@PartnerNOVIid=@@PartnerNOVIid,@operateriid=@@operateriid !!"
		  ONLOADED=""
	          CMD1CAPTION="Da" 
                  CMD2CAPTION="Ne" >

 	        <INPUT TYPE="label"   NAME="lblpitanje" TOP="300" LEFT="250" WIDTH="400" CAPTION="Jeste li sigurni da želite proknjižiti prikazane dokumente?"/>		
		
		
	

</MULTISELECTPROKNJIZI > 

</PROJECT>
