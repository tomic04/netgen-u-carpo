		HEIGHT="9500" 
		WIDTH= "11000" 
		FILLEXPLORER="" 
		FOCUS="stgrloid" 
		ONLOAD2="select sum( kg) as   ukupnokg , count(*) as ukupnokom from stprometdet where stprometglaid = @@id"
		ONLOAD="if (select status from stprometgla  where stprometglaid = @@ID ) = 2 begin 
				exec spraiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spraiserror 69001, &apos;Niste odabrali dokumant !&apos;
				end 
				else begin 
					exec spstPrometQueryGlaIDet @action=3 ,@ID=@@ID, @operateriid = @@operateriid
				end
				end " 
		>

