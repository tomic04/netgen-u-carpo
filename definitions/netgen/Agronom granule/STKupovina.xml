			<INPUT TYPE="combo" NAME="osobeid" ALLOWEMPTY="FALSE" CAPTION="Odgovorna osoba*" TOP="4000" LEFT="1500"
				   SQL="spSTDajOsobe @stfarmeid = @@stfarmeid" />
			<INPUT TYPE="number" NAME="vrstadokid" CAPTION="" DECIMALS="0" TOP="-500"/>

		<INPUT TYPE="button" NAME="ok" CAPTION="Stavke&gt;&gt;&gt;" TOP="4800" LEFT="1196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spSTPrometInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = '501', @vrstadokid = @@vrstadokid , @prnradninalogid = @@prnradninalogid
			   , @status = 1, @stfarmeid = @@stfarmeid, @datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @partneriid = @@partneriid,  @orgdok = '@@orgdok'
