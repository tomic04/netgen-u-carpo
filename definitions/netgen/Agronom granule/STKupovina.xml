	<INPUT TYPE="number" NAME="kg" 	  CAPTION="Težina*" TOP="3200" LEFT="3500" WIDTH="1296" HEIGHT="280" DECIMALS="4" SQL="" TABINDEX="20"  />
		<INPUT TYPE="button" NAME="dodaj" 		      CAPTION="Dodaj (F8)" TOP="3600" LEFT="8580" WIDTH="1428" HEIGHT="322" TABINDEX="30"
			   ONCLICK="spSTPrometInsertGlaIdetNG @action=3,@stgrloid=@@stgrloid,@id=@@id,@kg=@@KG#select sum(kg) from stprometdet where stprometglaid = @@id#select '' as grlo, 'stgrloid' as focus, stgrloid= null, kg= 0, maticnibroj = '' ,  'refreshmovelast' as stavke " HOTKEY="F8" />

		<INPUT TYPE="grid" 
			   NAME="stavke" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="4340" LEFT="56" WIDTH="8750" HEIGHT="3600"
			   TABINDEX="-1"
			   AFTERREFRESH="select sum(kg) as   ukupnokg , count(*) as ukupnokom from stprometdet where stprometglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU" 
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   DETCHECKBOXVISIBLE="FALSE"	
			   PAGEHEADERCENTER="Zaprimanje br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spstPrometQueryGlaIDet @action=2,@operateriid=@@operateriid,@id=@@id " />

	<INPUT TYPE="number" NAME="ukupnokom" CAPTION="Ukupno grla*" TOP="8500" LEFT="7300" WIDTH="1500" DECIMALS="0" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
	<INPUT TYPE="number" NAME="ukupnokg" CAPTION="Ukupno kg*" TOP="8122" LEFT="7300" WIDTH="1500" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
	<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="8500" LEFT="196" WIDTH="1106" HEIGHT="322" 
		   ONCLICK="spSTPrometInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = '501',
		   @datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @partneriid = @@partneriid,  @orgdok = '@@orgdok', @prnradninalogid = @@prnradninalogid#Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="zakljuci" CAPTION="Zaključi" TOP="8500" LEFT="2688" WIDTH="1106" HEIGHT="322" ONCLICK=":ZAKLJUCI#OK"  />
	<INPUT TYPE="button" NAME="printaj" CAPTION="Print.dok" TOP="8500" LEFT="4186" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="ispravi" CAPTION="Ispravi" TOP="4500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU" TABINDEX="40" />
	<INPUT TYPE="button" NAME="obrisi" CAPTION="Obriši" TOP="5000" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK="FOREACHSELECTED(stavke)#:BRISISTAVKU"  TABINDEX="50"/>
	<INPUT TYPE="button" NAME="donesi" CAPTION="Donesi" TOP="5500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":DONESI" TABINDEX="60" />
	<INPUT TYPE="button" NAME="povezi" CAPTION="Poveži sa robom" TOP="6000" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":GRLOROBA"  TABINDEX="70"/>
</UPDATE_FORM>


