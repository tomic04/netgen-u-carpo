<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = '501'  , @TIP = 'G', @vrstadokid = @@vrstadokid " />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '501'  , @TIP = 'G', @vrstadokid = @@vrstadokid " />




