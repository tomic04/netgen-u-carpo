	<INPUT TYPE="search" NAME="partneriid"	TOP="1400" LEFT="2000" ALLOWEMPTY="FALSE" CAPTION="Partner*" ONLOSTFOCUS="" WIDTH="3000"
		   SQL="viPartneri#partneriid#%naziv%#!matbroj"/>
	<INPUT TYPE="text" NAME="orgdok" TOP="1800" LEFT="2000" CAPTION="Org.dokument*" WIDTH="3000"/>
	<INPUT TYPE="text" NAME="napomena" TOP="2200" LEFT="2000" CAPTION="Napomena*" WIDTH="8000"/>

	<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog*"  TOP="1400" LEFT="7000"  WIDTH="3000"
				SQL="spSTRadniNalozi @action = 1, @trazi = '@@searchboxprnradninalogid', @stfarmeid = @@stfarmeid"
				   ONLOSTFOCUS="spSTRadniNalozi @action = 11, @idrn = @@prnradninalogid #if @@prnradninalogid is not null begin (select 'disable' as novirn) end "/>
	
	
