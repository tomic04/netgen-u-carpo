		   ONCLICK=":DODAJGRLO" HOTKEY="" />
	<INPUT TYPE="date" NAME="datumrodjenja" 	  CAPTION="Datum rođenja*" TOP="3600" LEFT="1500" WIDTH="1296" ENABLED="FALSE" HEIGHT="280" DECIMALS="" SQL=""  />
