		 CMD7CAPTION1="Lista" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Filter:FILTERFORM#Dodaj:INSERTFORM1#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Print dok.:vrstadokid-STPrometGla" 
