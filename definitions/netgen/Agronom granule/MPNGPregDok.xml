<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = @@nenc"
		 MASTERDBLCLICK=""
	MULTIGRIDLAYOUT="TRUE" 
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION="Print dok.:vrstadokid-MaloprodajaGla"
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:OVAJMJ#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:DATUM#spMPTreeNG @action=3:DATUM#spMPTreeNG @action=5:VRSTADOKFORM"
     TREETRANSLATE="TRUE"
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' #select dbo.fnTkoSmoMi() as tkosmomi" 
		 ONLOAD2="" 
		 REPORT=""
     PAGEHEADERLEFT="Od @@datumod do @@datumdo"
    PAGEHEADERRIGHT="@@tkosmomi">

	<NAME>Pregled dokumenata MP</NAME>
	<CAPTION>Pregled dokumenata MP </CAPTION>

<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="5254" 
	WIDTH="7710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @nenc = @@nenc,"
	ONLOAD="" 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	>
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
	<INPUT TYPE="combo" NAME="vrstapromid" 
		ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
	<INPUT TYPE="combo" NAME="vrstadokid" 
		ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
	<INPUT TYPE="combo" NAME="trgovinaid" 
		ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	<INPUT TYPE="search" NAME="partneriid"  
		CAPTION="Partner"   SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />
	<INPUT TYPE="combo" NAME="trgovina2id" 
		ALLOWEMPTY="TRUE" CAPTION="Trgovina (ulaza)" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	<INPUT TYPE="combo" NAME="skladisteid"
		ALLOWEMPTY="TRUE" CAPTION="Skladište" SQL="spmpDajSkladiste @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />
	<INPUT TYPE="combo" NAME="operater_dokument"
		ALLOWEMPTY="TRUE" CAPTION="Operater" SQL="select operateriid, naziv from ssoperateri order by naziv" />
</FILTERFORM>

	<VRSTADOKFORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node', @nenc = @@nenc" />

	<DATUM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node',  @vrstapromid = @@vrstapromid, @nenc = @@nenc" />

	<OVAJMJ FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = 'ovajmj',  @vrstapromid = @@vrstapromid, @nenc = @@nenc" />

	<DANAS_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas',  @vrstapromid = @@vrstapromid, @nenc = @@nenc" />
	
	<JUCER_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @vrstapromid = @@vrstapromid, @nenc = @@nenc" />
	
	<PROSLIMJESEC_FORM FILLEXPLORER="TRUE" 
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',  @vrstapromid = @@vrstapromid, @nenc = @@nenc" />

	
</PROJECT>