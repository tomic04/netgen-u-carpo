</FRMEMAILDODAJ>

<ODOBRIOPFORM NAME="ODOBRIOPFORM" HEIGHT="8712" WIDTH="10354" CAPTION="Pregled i ažuriranje predložaka za likvidaciju i likvidatore" ONLOAD="select @@operateriid" ONLOADED="select &apos;predlozak&apos; as focus" TOP="302" BORDERSTYLE="3" REFRESHAFTERCHILD="TRUE">
