<INSERTFORM NAME="INSERTFORM" HEIGHT="2995" WIDTH="6998" CAPTION="Unos statusa" ONSUBMIT="spKUPStatusAzurN @Action=0," ONLOAD="select 1" TOP="302" BORDERSTYLE="3" CMD1CAPTION="Spremi" CMD2CAPTION="Odustani">
