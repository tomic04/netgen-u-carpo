<PROJECT  CMD1CAPTION="Unesi:INSERTFORM" CMD2CAPTION="Izmjeni:UPDATEFORM" CMD3CAPTION="Obriši:DELETEFORM" ONLOAD="select kupstatusid,Korak as [Korak1000],opis as [Opis2000],proknjizi as [Proknjizi1500] from kupstatus order by korak" MASTERDBLCLICK="UPDATEFORM" POPUPMASTER="Pregled operatera:PREGLEDOPFORM#Pregled email adresa operatera:FRMEMAILDODAJ#Pregled operatera za odobravanje:POJEDINOPFORM#Pregled predložaka za odobravanje:ODOBRIOPFORM" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE">
