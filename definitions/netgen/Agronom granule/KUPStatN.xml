	<INPUT TYPE="text" NAME="Korak" TOP="245" LEFT="1699" HEIGHT="317" WIDTH="994" CAPTION="Korak" TABINDEX="0" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="lblOpis" TOP="749" LEFT="202" HEIGHT="317" WIDTH="1498" CAPTION="Opis"/>
	<INPUT TYPE="text" NAME="Opis" TOP="749" LEFT="1699" HEIGHT="317" WIDTH="4003" CAPTION="Opis" TABINDEX="1" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="lblsvi" TOP="1253" LEFT="202" HEIGHT="317" WIDTH="1498" CAPTION="Proknjiži:"/>
	<INPUT TYPE="combo" NAME="Proknjizi" TOP="1253" LEFT="1699" HEIGHT="302" WIDTH="2506" SQL="select 0 as Proknjizi,&apos;NE - 0 &apos; as Naziv
       									union all 
										select 1 as Proknjizi ,&apos;DA - 1&apos; as Naziv" ALLOWEMPTY="false" CAPTION="proknjiži" TABINDEX="2"/>

</INSERTFORM>

