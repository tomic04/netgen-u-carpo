	<INPUT TYPE="grid" NAME="em" TOP="403" LEFT="302" HEIGHT="5400" WIDTH="6998" REFRESHAFTERCHILD="TRUE" TABINDEX="-1" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" EDITCOLUMNS="Email" CHECKBOXVISIBLE="FALSE" PAGEHEADERRIGHT="@@datum" SQL="spKUPOperateriEmailAzur @Action =&apos;pokazi_email&apos;"/>
