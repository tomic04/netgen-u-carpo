<INSERTOPFORM NAME="INSERTOPFORM" HEIGHT="2506" WIDTH="6998" CAPTION="Unos operatera" ONLOAD="select 1" TOP="302" BORDERSTYLE="3">
	<INPUT TYPE="label" NAME="lblsvi" TOP="245" LEFT="202" HEIGHT="317" WIDTH="1498" CAPTION="Operater:"/>
	<INPUT TYPE="combo" NAME="OperateriId" TOP="245" LEFT="1699" HEIGHT="302" WIDTH="4003" SQL="spKUPStatusOperateriQueryN @action=1,@id=@@id" ALLOWEMPTY="false" CAPTION="proknjiži" TABINDEX="2"/>
	<INPUT TYPE="label" NAME="lbladmin" TOP="749" LEFT="202" HEIGHT="317" WIDTH="1498" CAPTION="Administrator:"/>
	<INPUT TYPE="combo" NAME="admin" TOP="749" LEFT="1699" HEIGHT="302" WIDTH="2506" SQL="select 0 as Admin,&apos;NE - 0 &apos; as Naziv
       									union all 
										select 1 as Admin ,&apos;DA - 1&apos; as Naziv" ALLOWEMPTY="false" CAPTION="admin" TABINDEX="2"/>
	<INPUT TYPE="button" NAME="ok" TOP="1296" LEFT="202" HEIGHT="331" WIDTH="1094" TEXT="ButtonNG1" CAPTION="Spremi" TABINDEX="3" ONCLICK="spKUPStatusAzurN @action=3,@operateriid=@@OperateriId,@kupstatusid=@@id,@admin=@@admin#OK"/>
	<INPUT TYPE="button" NAME="cancel" TOP="1296" LEFT="1397" HEIGHT="331" WIDTH="1094" TEXT="ButtonNG2" CAPTION="Odustani" TABINDEX="4" ONCLICK="close"/>

</INSERTOPFORM>

