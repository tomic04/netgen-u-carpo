<PREGLEDOPFORM NAME="PREGLEDOPFORM" HEIGHT="6494" WIDTH="6494" CAPTION="Pregled i ažuriranje operatera" ONLOAD="select @@kupstatusid,@@operateriid" TOP="302" BORDERSTYLE="3" REFRESHAFTERCHILD="TRUE">
	<INPUT TYPE="grid" NAME="Operater" TOP="245" LEFT="202" HEIGHT="5198" WIDTH="5803" REFRESHAFTERCHILD="TRUE" CAPTION="operateri" TABINDEX="0" TOTALROW="FALSE" EDITCOLUMNS="admin1000,voditeljprojekta1500" ONCELLEDITED="update KUPStatusOperateri
                                                  set admin=@@admin,
												      superadmin=@@voditeljprojekta
			                                      where (KUPStatusId = @@KUPStatusId and OperateriId=@@OperateriId)" CHECKBOXVISIBLE="FALSE" SQL="spKUPStatusOperateriQueryN @action=0,@id=@@id"/>
	<INPUT TYPE="button" NAME="ok" TOP="5602" LEFT="202" HEIGHT="331" WIDTH="1094" TEXT="ButtonNG0" CAPTION="Unesi" TABINDEX="2" ONCLICK=":INSERTOPFORM"/>
	<INPUT TYPE="button" NAME="ok" TOP="5602" LEFT="1397" HEIGHT="331" WIDTH="1094" TEXT="ButtonNG1" CAPTION="Obriši" TABINDEX="3" ONCLICK=":DELETEOPFORM"/>
	<INPUT TYPE="button" NAME="cancel" TOP="5602" LEFT="2606" HEIGHT="331" WIDTH="1094" TEXT="ButtonNG2" CAPTION="Odustani" TABINDEX="4" ONCLICK="close"/>

