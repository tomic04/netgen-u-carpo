<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
ONLOAD=":FORM1"  		
CMD1CAPTION="Parametri:FORM1" 
DETAILGRID="spMPPregRacKupacZastitaNG @action=2, @ID= @@id"
CMD2CAPTION="" 
CMD3CAPTION="Analiza fiskalizacije:ANALFISK" 
CMD4CAPTION="Plaćanje:PLACANJE"
CMD5CAPTION="Izmjeni napomenu:NAPOMENA" 
CMD6CAPTION="Print dok.:vrstadokid-mpblagajnagla"
CMD7CAPTION=""
PAGEHEADERCENTER="Pregled računa MP @@NoviRed Od @@datumod do @@datumdo"
PAGEHEADERRIGHT="@@tkosmomi"
MASTERDBLCLICK="PLACANJE"
GROUPBYBOXVISIBLE="TRUE" 
CHECKBOXVISIBLE="FALSE"
TOTALROWVISIBLE="TRUE"
DETTOTALROWVISIBLE="TRUE"
DETCHECKBOXVISIBLE="FALSE"
POPUPMASTER=""> 
 

  <NAME>Pregled računa MP </NAME>
  <CAPTION>Pregled računa MP </CAPTION>
  

<FORM1 	
	FILLEXPLORER="TRUE" 
	WIDTH="9000" HEIGHT="5500"
	ONSUBMIT="spMPPregRacKupacZastitaNGNacPlac @action=1, @operateriid = @@operateriid, @trgovinaid = @@xtrgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @storno = @@storno, @r1 = @@r1, @operid = @@operid, @kntnacinplacid = @@kntnacinplacid, @MPKupacIskaznicaid = @@MPKupacIskaznicaid, @MPBankaNaplateid = @@MPBankaNaplateid !!" 
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@xtrgovinaid as trgovinaid, char(13)+char(10) as NoviRed" 
	VERSION="1.3"
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani"> 

	<INPUT TYPE="combo" NAME="xtrgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid" ONLOSTFOCUS="select 'refresh' as operid"/>
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="kntnacinplacid" CAPTION="Način plaćanja" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
		   SQL="select kntnacinplacid, Naziv as naziv from  kntnacinplac 
				where 
				grupanacinplac is not null"/>
	<INPUT TYPE="combo" NAME="MPBankaNaplateid" CAPTION="Banka" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE"
		   SQL="select MPBankaNaplateid, Naziv from MPBankaNaplate order by 2"/>
	<INPUT TYPE="combo" NAME="storno" CAPTION="Storno" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE" SQL="select 0 as storno, 'Svi mp računi' as naziv union all select 1, 'Stornirani' "/>
	<INPUT TYPE="combo" NAME="r1" CAPTION="R1 računi" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE" SQL="select 0 as r1, 'Svi mp računi' as naziv union all select 1, 'R1 računi' "/>
	<INPUT TYPE="combo" NAME="operid" CAPTION="Operater" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
		   SQL="select l.Operateriid AS operid, o.naziv  
				from dbo.LnTrgovinaOperateri l with(nolock)
				inner join dbo.Trgovina t with(nolock) on l.trgovinaid = t.trgovinaid
				left outer join ssOperateri o with(nolock) on l.Operateriid = o.OperateriID
				left outer join trgovineprava tp with(nolock) on l.operateriid = tp.operaterid and l.trgovinaid = tp.trgovinaid 
				left outer join odjel od with(nolock) on l.odjelid = od.odjelid
				where (l.trgovinaid = @@xtrgovinaid or @@xtrgovinaid is null)
				order by l.nazivopr"/>
	<INPUT TYPE="combo" NAME="MPKupacIskaznicaid" CAPTION="Kupac zaštitnih sredstava" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE"
			   SQL="select mk.MPKupacIskaznicaid, (mk.iskaznicazastita+' '+mk.naziv) as naziv 
				from dbo.MPKupacIskaznica mk with(nolock)
				order by 2"/>
</FORM1>

	
<PLACANJE
	FILLEXPLORER="TRUE" 
	WIDTH="7000" 
	ONSUBMIT="" 
	ONLOAD="" 
	HEIGHT="5000" 
	CAPTION="Stavke prometa" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani"> 

	<INPUT TYPE="grid" 
		NAME="stavke" 
		REFRESHAFTERCHILD="TRUE"
		CHECKBOXVISIBLE="FALSE"	
		CAPTION="_ay" 
		TOP="200" 
		LEFT="200"  
		WIDTH="6000" 
		HEIGHT="3000" 
		SQL="spMPPregRacKupacZastitaNG @action=3, @id = @@id" /> 

</PLACANJE>


<ANALFISK 	
	FILLEXPLORER="TRUE"
	WIDTH="8600"
	ONSUBMIT=""
	ONLOAD=""
	HEIGHT="8000"
	CAPTION="Analziza fiskalizacije "
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION="Odustani">

	<INPUT TYPE="grid"
		NAME="analfisk"
		REFRESHAFTERCHILD="TRUE"
		CHECKBOXVISIBLE="FALSE"	
		CAPTION="_ay"
		TOP="200"
		LEFT="200"
		WIDTH="8400"
		HEIGHT="6500"
		SQL="spMPPregRacKupacZastitaNG @action=6, @datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@xtrgovinaid " />

</ANALFISK>

	<NAPOMENA NAME="NAPOMENA" HEIGHT="6000" WIDTH="8610"
	   CAPTION=""
	   ONSUBMIT=""
		ONLOAD="spMPPregRacKupacZastitaNG @action=7,  @id= @@id"
	   FILLEXPLORER=""
	   NEXTFORM=""
		ONLOAD2=""
	   ONLOADED="select 'Upišite napomenu za račun ' + broj as formcaption from mpblagajnagla where mpblagajnaglaid = @@id"
	   CMD1CAPTION=""
	   CMD2CAPTION=""
		 >

		<INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" WIDTH="8250" HEIGHT="3000"/>
		<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena za račun*:*" MULTILINE="TRUE" TOP="400" LEFT="1600" WIDTH="6550" HEIGHT="2000"/>
		<INPUT TYPE="button" NAME="spremi" CAPTION="Spremi"  TOP="2500" LEFT="400" WIDTH="1100" HEIGHT="320" HOTKEY=""
			   ONCLICK="spMPPregRacKupacZastitaNG @action=8,  @id= @@id, @napomena = '@@napomena'#OK"/>
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani"  TOP="2000" LEFT="1800" WIDTH="1100" HEIGHT="320" HOTKEY=""
			   ONCLICK="close"/>

	</NAPOMENA>

	<RACUNR1
	  NAME="RACUNR1"
	  HEIGHT="4500" WIDTH="6000"
	  CAPTION="R1 KUPAC "
	  ONLOAD="spmpBlagajna @action = 21, @id = @@id"
	  ONLOADED=""
	  ONLOAD2="">

		<INPUT TYPE="search" NAME="trazur1" CAPTION="TRAŽI*" TOP="400" LEFT="900" HEIGHT="302" WIDTH="2500"  DECIMALS="4" ENABLED="TRUE" SQL="mpkupcir1#mpkupcir1id#naziv%#OIB%"
				   ONLOSTFOCUS="select * from MPKupciR1 where MPKupciR1Id = @@trazur1 " ONCLICK="select * from MPKupciR1 where MPKupciR1Id = @@trazur1 "/>
		<INPUT TYPE="text" NAME="MPKupciR1Id" CAPTION="" TOP="800" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" VISIBLE="FALSE" ENABLED="TRUE" ONLOSTFOCUS=""/>
		<INPUT TYPE="text" NAME="naziv" CAPTION="Naziv*" TOP="800" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
		<INPUT TYPE="text" NAME="adresa" CAPTION="Adresa*" TOP="1200" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
		<INPUT TYPE="combo" NAME="mjestaid" CAPTION="Mjesto*" TOP="1600" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="4" ENABLED="TRUE" SQL="select mjestaid, naziv+ hptbroj as naziv from mjesta" ONLOSTFOCUS=""/>
		<INPUT TYPE="text" NAME="OIB" CAPTION="OIB*" TOP="2000" LEFT="900" HEIGHT="302" WIDTH="1206"  DECIMALS="" MAXLENGHT="11" ENABLED="TRUE" ONLOSTFOCUS=""/>

		<INPUT TYPE="button" NAME="ok"           CAPTION="Ispiši"   TOP="2700" LEFT="456" WIDTH="1106" HEIGHT="322"
				   ONCLICK="spmpBlagajna @action = 22, @id = @@id, @MPKupciR1Id = '@@MPKupciR1Id', @mjestaid = @@mjestaid, @r1adresa = '@@adresa', @oib = '@@oib', @r1naziv = '@@naziv' 
						#ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2700" LEFT="1756" WIDTH="1106" HEIGHT="322"
				   ONCLICK="close"  />
	</RACUNR1>

</PROJECT> 