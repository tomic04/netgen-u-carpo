		<INPUT TYPE="search"   NAME="robakomId"  CAPTION="Roba(kom):"  TABINDEX="5" ALLOWEMPTY="FALSE"  SQL="viroba#robaid#naziv%#userid#robakod#jmnaziv!"  />
