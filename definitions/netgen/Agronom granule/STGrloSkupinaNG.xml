		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"         CAPTION="Naziv skupine:"  TABINDEX="0"  ENABLED="TRUE"  WIDTH="4000"  />
		 <INPUT TYPE="text"    NAME="Sifra"		   CAPTION="Šifra:"          TABINDEX="1"  ENABLED="TRUE"  WIDTH="1000"   SQL=""  />
