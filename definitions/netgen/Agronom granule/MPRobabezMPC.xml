<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
    ONLOAD=":FILTERFORM"  
    CMD1CAPTION="Parametri:FILTERFORM"
    CMD2CAPTION=""
	  CMD3CAPTION="Dodaj u cjenik:DODCJENIK"
    CMD4CAPTION="Ažuriraj:AZURDOK" 
    CMD5CAPTION="" 
    CMD6CAPTION=""   
    CMD7CAPTION="Lista"   
    CMD8CAPTION=""
	  CHECKBOXVISIBLE="FALSE"
	  DETCHECKBOXVISIBLE="FALSE"
    GROUPBOXVISIBLE="FALSE"
    TOTALROWVISIBLE="FALSE"
    DETTOTALROWVISIBLE="FALSE"
    REPORT="" 
	  DETAILGRID = ""
    MASTERDBLCLICK=""
    POPUPMASTER="Filter:FILTERFORM"
   PAGEHEADERLEFT=""
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">



  <MASTERCOLUMNS>
    <COLUMN INDEX="9" NAME="KOLIČINA0900" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
    <COLUMN INDEX="10" NAME="NC1000" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
  </MASTERCOLUMNS>


  <NAME>Pregled roba bez MP cijene u prometu  </NAME>
  <CAPTION>Pregled roba bez MP cijene u prometu</CAPTION>
 
  <KOMENTAR> </KOMENTAR>


	<FILTERFORM 
			FILLEXPLORER="TRUE" 
			REPORT=""  
			WIDTH="6300" 
			ONSUBMIT="spmpRobaBezMPC @action = 1, @bezmpc = 1,  " 
			ONLOAD="select @@datumod as datumod, @@datumdo as datumdo" 
      ONLOADED="select @@status as status, 1 as fransiza "
			HEIGHT="3000" 
			CAPTION="Upišite uvjete pregleda "  
			BORDERSTYLE="3" 
			CMD1CAPTION="Pokaži" 
			CMD2CAPTION="Odustani" 
			CMD3CAPTION=""  
			NEXTFORM=""  >
    
    <INPUT TYPE="datetime" NAME="datumod" CAPTION="Datum od:*" WIDTH="1200" TOP="400" LEFT="1500"
           SQL="" ALLOWEMPTY="TRUE" />
    <INPUT TYPE="datetime" NAME="datumdo" CAPTION="Datum do:*" WIDTH="1200" TOP="800" LEFT="1500"
           SQL="" ALLOWEMPTY="TRUE" />


    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="4000" TOP="1200" LEFT="1500" SQL="spmpdajtrgovinang @operateriid = @@operateriid" 
         ALLOWEMPTY="TRUE" />
    <INPUT TYPE="check" NAME="fransiza" CAPTION="Bez franšiza*" WIDTH="4000" TOP="1600" LEFT="1500" SQL=""
         ALLOWEMPTY="TRUE" />


  </FILTERFORM>

  <DODCJENIK
    REFRESHAFTERCHILD=""
    WIDTH="7500"
    VERSION="1.2"
    ONLOAD=""
    ONSUBMIT="spmpRobaBezMPC @action = 2, @operateriid = @@operateriid, @mpc = 1"
    HEIGHT="3500"
    CAPTION="Unos Proizvoda i normativa"
    MASTERDBLCLICK=""
    ONLOADED=""
    BORDERSTYLE="3"
    CMD1CAPTION="Spremi"
    CMD2CAPTION="Odustani"
    FOCUS="datum"
    NEXTFORM=""  >

    <INPUT TYPE="Datetime" NAME="Datum" CAPTION="Datum"  SQL="" WIDTH="1200" HEIGHT="320"/>
    <INPUT TYPE="TRAZILICA" NAME="Robaid" CAPTION="Roba"  SQL="viRoba#robaid#Naziv%#userid#barcode#robakod" WIDTH="4000" HEIGHT="320"/>
    <INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Cjenik"  SQL="select vrcjenikid, opis from vrcjenik where indmp = 1" WIDTH="3000" HEIGHT="320"/>
    <INPUT TYPE="number" NAME="mpc" CAPTION="MPC"  SQL="" WIDTH="1000" HEIGHT="320"/>



  </DODCJENIK>

  <AZURDOK
    FILLEXPLORER=""
    VERSION="1.1"
    REPORT=""
    WIDTH="6000"
    ONLOAD=""
    ONSUBMIT="spmpRobaBezMPC @action = 3, @operateriid = @@operateriid , @datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@trgovinaid, @bezmpc = 1"
    HEIGHT="3000"
    CAPTION="Ažuriranje dokumenata"
    MASTERDBLCLICK=""
    BORDERSTYLE="3"
    CMD1CAPTION="Ažuriraj"
    CMD2CAPTION="Odustani"
    CMD3CAPTION=""
    CMD4CAPTION=""
    CMD5CAPTION=""
    CMD6CAPTION=""
    NEXTFORM=""  >

    <INPUT TYPE="label" CAPTION="AŽURIRATI DOKUMENTE ? " TOP="1000" LEFT="500" NAME="" WIDTH="5000" STYLE="1" ENABLED="" SIZE="10" HEIGHT="320"/>
  </AZURDOK>

  <DODAJSTAVKU
    FILLEXPLORER=""
          REPORT=""
          WIDTH="7500"
          ONSUBMIT=""
          ONLOAD=""
          HEIGHT="3100"
          CAPTION="Prijava nove sirovine"
          BORDERSTYLE="3"
          CMD1CAPTION=""
    CMD2CAPTION="">

    <INPUT TYPE="TRAZILICA" CAPTION="Sirovina*" NAME="Robaid" TOP="500" LEFT="2000" WIDTH="5000" HEIGHT="320" SQL="viroba#robaid#Naziv%#userid#barcode#robakod" STYLE="1"  ONLOSTFOCUS=""/>
    <INPUT TYPE="number" NAME="kolicina" CAPTION="Količina*" LEFT="2000" TOP="1000" WIDTH="1500" HEIGHT="320" DECIMALS="10" />
    <INPUT TYPE="checkbox" NAME="rezervni" CAPTION="Rezervna sirovina*" LEFT="2000" TOP="1500" WIDTH="3500" HEIGHT="320" DECIMALS="0" />
    <INPUT TYPE="button" NAME="Spremi"  CAPTION="Spremi" TOP="2000" LEFT="1186" WIDTH="1400" HEIGHT="322" TABINDEX="3"
      ONCLICK="exec spMPProizvodiGlaIdet @action=5, @mpproizvodiglaid =@@mpproizvodiglaid, @robaid = @@robaid, @kolicina = @@kolicina, @rezervni = @@rezervni#OK"  />
    <INPUT TYPE="button" NAME="Odustani"  CAPTION="Odustani" TOP="2000" LEFT="2684" WIDTH="1400" HEIGHT="322" TABINDEX="4" ONCLICK="close"  />
  </DODAJSTAVKU>

  <BRISANJE
	WIDTH="7500"
	ONSUBMIT="exec spMPProizvodiGlaIdet @action=15,@MPproizvodiglaid=@@ID,"
	ONLOAD="exec spMPProizvodiGlaIdet @action=3,@MPproizvodiglaid=@@ID"
	HEIGHT="3200"
	CAPTION="Brisanje proizvoda i normativa ?"
	BORDERSTYLE="3"
	CMD1CAPTION="Obriši"
	CMD2CAPTION="Odustani"
	BOLD="TRUE">

    <INPUT TYPE="text" NAME="naziv" CAPTION="Proizvod" STYLE="1" WIDTH="4500" HEIGHT="320" BOLD="TRUE" ENABLED="FALSE" />
    <INPUT TYPE="label" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite obisati proizvod i normativ  ? "/>

  </BRISANJE>


  <BRISISTAVKU
    WIDTH="5500"
    ONSUBMIT="delete mpproizvodidet where mpproizvodidetid = @@stavkenorm"
    ONLOAD="spMPProizvodiGlaIdet @action = 6, @mpproizvodidetid=@@stavkenorm"
    HEIGHT="3200"
    CAPTION="Brisanje stavke"
    BORDERSTYLE="3"
    CMD1CAPTION="Obriši"
    CMD2CAPTION="Odustani" >

    <INPUT TYPE="label" NAME="stat"  LEFT="100" TOP="300" BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati stavku ? "/>
    <INPUT TYPE="number"  KOMENTAR="ova kontrola služi samo da sačuva ID stavke , pozicionirana je tako da se nevidi na formi" NAME="mpproizvodidetid" TOP="5600" LEFT="2200" CAPTION="mpproizvodidetid" WIDTH="2500" HEIGHT="320" ENABLED="FALSE" DECIMALS="0" />

  </BRISISTAVKU>


  <STATUSA
     WIDTH="7500"
     ONSUBMIT="exec spMPProizvodiGlaIdet @action=7, @MPproizvodiglaid = @@id, @operateriid= @@operateriid,"
     ONLOAD="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@id ),0) = 1   begin 
			          exec spRaiserror 69001, 'Proizvod je već aktivan!' 
		        end
		        else begin 
			          exec spMPProizvodiGlaIdet @action=3, @MPproizvodiglaid=@@id
		        end "
     HEIGHT="3200"
     CAPTION="Aktiviranje proizvoda i normativa ?"
     BORDERSTYLE="3"
     CMD1CAPTION="Ažuriraj"
     CMD2CAPTION="Odustani"
     BOLD="TRUE"	>

    <INPUT TYPE="text" NAME="naziv" CAPTION="Proizvod" WIDTH="4500" HEIGHT="320" BOLD="TRUE" ENABLED="FALSE" />
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum aktiviranja" VALUE="DATE1" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
    <INPUT TYPE="label1a" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite Aktivirati proizvod i normativ  ? "/>
    <INPUT TYPE="label2a" NAME="stat" BOLD="TRUE" TOP="1800" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Stari aktivni normativ će biti ugašen !"/>
  </STATUSA>

</PROJECT>
 
