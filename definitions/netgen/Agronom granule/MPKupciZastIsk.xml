<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD1CAPTION="Parametri:FILTERFORM"
   CMD2CAPTION="Dodaj:INSERTFORM" 
   CMD3CAPTION="Izmjeni:UPDATEFORM"
   CMD4CAPTION="Obriši:DELETEFORM" 
   CMD5CAPTION=""
   CMD6CAPTION=""
   DETAILGRID = "" 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER="Obriši:DELETEFORM#Izmjeni:UPDATEFORM"
   TOTALROW="FALSE"
   MASTERDBLCLICK=":UPDATEFORM"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Zaštitne iskaznice - Kupci</NAME>
  <CAPTION>Zaštitne iskaznice - Kupci</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MH 25.04.2016.</AUTOR>



  <FILTERFORM 
		NAME="FILTERFORM" 
		HEIGHT="2754" 
		WIDTH="6710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPKupciIskaznicaZastita @action = 0, "
		ONLOAD=""
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		VERSION="1.2"
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
		 >

    <INPUT TYPE="text" NAME="trazur1" CAPTION="TRAŽI*" TOP="400" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="4" ENABLED="TRUE" 
           SQL=""
			   ONLOSTFOCUS="" />

  </FILTERFORM>
  
  <INSERTFORM
		NAME="INSERTFORM"
		WIDTH="6000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="3500"
		VERSION="1.2"
		CAPTION="Unos kupca"
		FOCUS="naziv"
		>

   
    <INPUT TYPE="text" NAME="naziv" CAPTION="Naziv*" TOP="400" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="adresa" CAPTION="Adresa*" TOP="800" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="mjesto" CAPTION="Mjesto*" TOP="1200" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS="" SQL="" />
    <INPUT TYPE="text" NAME="iskaznicazastita" CAPTION="Iskaznica*" TOP="1600" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" MAXLENGHT="30" ENABLED="TRUE" ONLOSTFOCUS=""/>

    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="456" WIDTH="1106" HEIGHT="322"
		ONCLICK="spMPKupciIskaznicaZastita @action = 1, @kupacmjesto = '@@mjesto', @kupacadresa = '@@adresa', @iskaznicazastita = '@@iskaznicazastita', @kupacnaziv = '@@naziv' #ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2300" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </INSERTFORM>
	

  <UPDATEFORM 
		NAME="UPDATEFORM"
		WIDTH="6000"
		ONSUBMIT=""
		ONLOAD="select coalesce(MPKupacIskaznicaId,0) as kupacid, naziv, adresa, mjesto, iskaznicazastita from MPKupacIskaznica where MPKupacIskaznicaId = @@id"
		HEIGHT="4000"
		VERSION="1.3"
		CAPTION="Izmjena kupca"
		FOCUS="naziv"
		>

    <INPUT TYPE="text" NAME="kupacid" CAPTION="" TOP="400" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" VISIBLE="FALSE" ENABLED="TRUE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="naziv" CAPTION="Naziv*" TOP="400" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="adresa" CAPTION="Adresa*" TOP="800" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="mjesto" CAPTION="Mjesto*" TOP="1200" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="TRUE" ONLOSTFOCUS="" SQL="" />
    <INPUT TYPE="text" NAME="iskaznicazastita" CAPTION="Iskaznica*" TOP="1600" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" MAXLENGHT="30" ENABLED="TRUE" ONLOSTFOCUS=""/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2800" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spMPKupciIskaznicaZastita @action = 1,  @MPKupacIskaznicaId = @@id, @kupacmjesto = '@@mjesto', @kupacadresa = '@@adresa',@kupacnaziv = '@@naziv' , @iskaznicazastita = '@@iskaznicazastita' #ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2800" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </UPDATEFORM>

  <DELETEFORM
		NAME="DELETEFORM"
		WIDTH="6000"
		ONSUBMIT=""
		ONLOAD="select coalesce(MPKupacIskaznicaId,0) as kupacid, naziv, adresa, mjesto, iskaznicazastita  from MPKupacIskaznica where MPKupacIskaznicaId = @@id"
		HEIGHT="3500"
		VERSION="1.2"
		CAPTION="Brisanje kupca"
		FOCUS=""
		>

    <INPUT TYPE="text" NAME="kupacid" CAPTION="" TOP="400" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" VISIBLE="FALSE" ENABLED="FALSE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="naziv" CAPTION="Naziv*" TOP="400" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="FALSE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="adresa" CAPTION="Adresa*" TOP="800" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="FALSE" ONLOSTFOCUS=""/>
    <INPUT TYPE="text" NAME="mjesto" CAPTION="Mjesto*" TOP="1200" LEFT="900" HEIGHT="302" WIDTH="4500"  DECIMALS="" ENABLED="FALSE" ONLOSTFOCUS="" SQL="" />
	<INPUT TYPE="text" NAME="iskaznicazastita" CAPTION="Iskaznica*" TOP="1600" LEFT="900" HEIGHT="302" WIDTH="3500"  DECIMALS="" MAXLENGHT="30" ENABLED="FALSE" ONLOSTFOCUS=""/>

    <INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2300" LEFT="456" WIDTH="1106" HEIGHT="322" ENABLED="TRUE" ONCLICK="spMPKupciIskaznicaZastita @action = 2,  @MPKupacIskaznicaId = @@id #ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2300" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </DELETEFORM>

</PROJECT>
 
