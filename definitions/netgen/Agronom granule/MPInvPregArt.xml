<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
	DETAILGRID =""
	CMD1CAPTION="Parametri:FILTERFORM" 
	CMD2CAPTION=""
	CMD3CAPTION="Kartica:MPKARTICA" 
	CMD4CAPTION="" 
	CMD5CAPTION="" 
	CMD6CAPTION=""
	CMD7CAPTION="" 
	CMD8CAPTION="" 
	BUTTONS="Parametri:FILTERFORM"
	POPUPMASTER="" 
	MASTERDBLCLICK=""
	GROUPBYBOXVISIBLE="TRUE" 
	ONLOAD=":FILTERFORM" 
	FROZENCOLUMNS="0" 
	CHECKBOXVISIBLE="FALSE"
	AUTOFITCOLUMNS="FALSE"
	REPORT="">
	
	
<NAME>Pregled robe po inventurama i trgovinama </NAME>
<CAPTION>Pregled robe po inventurama i trgovinama </CAPTION>


<FILTERFORM
	NAME="FILTERFORM"
	HEIGHT="3500"
	WIDTH="7603"
	TEXT=""
	REFRESHAFTERCHILD="TRUE"
	CAPTION="Upišite uvjete prikaza "
	BORDERSTYLE="3"
	ONSUBMIT="spmpPregInvArt @action = 1, @operateriid=@@operateriid, "
	ONLOAD="" 
	CANCELONSUBMIT=""
	FILLEXPLORER="TRUE"
	NEXTFORM=""
	CMD1CAPTION="Pokaži"
	CMD2CAPTION="Odustani"
	CMD3CAPTION=""
	CMD4CAPTION=""
	CMD5CAPTION=""
	CMD6CAPTION=""
	REPORT="">


  <INPUT TYPE="date" NAME="datum" CAPTION="Datum inventure :" TOP="" LEFT="" WIDTH="2000"/>

  <INPUT TYPE="search"
		CAPTION="Roba"
		NAME="robaid"
		SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid' "
		TABINDEX=""
		TEXT=""
		WIDTH="5500"
		HEIGHT="320"/>
  <INPUT TYPE="search"  CAPTION="Klasa robe:" NAME="klmasterrobaid" TOP="" LEFT="" WIDTH="5500"
      SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'"/>

  <!--<INPUT TYPE="combo" NAME="klmasterrobaid" TOP="250" LEFT="7000" WIDTH="5500" 
         SQL="select KlMasterRobaid, oznaka+&apos;&apos;+naziv as naziv from KlMasterRoba order by SortKey" ALLOWEMPTY="TRUE" CAPTION="Klasa robe:*"/>-->

  <INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" TOP="" LEFT=""/>
  <INPUT TYPE="checkbox" NAME="razlike" CAPTION="pokaži samo robe sa razlikom" TOP="" LEFT=""/>

</FILTERFORM>

  <MPKARTICA
    HEIGHT="7500"
    WIDTH="16000"
    CAPTION="Kartica: '@@Naziv_robe' "
    ONSUBMIT=""
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
        PAGEHEADERRIGHT="@@tkosmomi"
     PAGEHEADERLEFT="Od @@datum do @@datum"
      CHECKBOXVISIBLE="TRUE"
    ONLOADstaro="select @@datum as datod, @@datum as datdo, 2 as totalgen, @@trgovinaid as trgid"
    ONLOAD="select convert(char(4),year(@@datum))+'0101' as datod, @@datum as datdo, 2 as totalgen, @@trgovinaid as trgid"
    ONLOADED="select 1 as rbtnKumulativ"
  >


    <INPUT TYPE="int" NAME="trgid" TOP="300" LEFT="1300" CAPTION="" VISBLE="FALSE" />

    <INPUT TYPE="date" NAME="datod" TOP="300" LEFT="1300" CAPTION="Datum od*" />
    <INPUT TYPE="date" NAME="datdo" TOP="300" LEFT="3700" CAPTION="Datum do*" />

    <INPUT TYPE="frame" NAME="frm" TOP="50" LEFT="200" CAPTION="" WIDTH="10500" HEIGHT="680"/>

    <INPUT TYPE="radio" NAME="rbtnKumulativ" CAPTION="Kumulativ" TOP="250" LEFT="5600" WIDTH="1300" HEIGHT="420"
           ONCLICK="select 'refresh' as karticagrid# select 'visible' as karticagrid, 'invisible' as karticagrid2"/>

    <INPUT TYPE="radio" NAME="rbtnAnalitika" CAPTION="Analitika" TOP="250" LEFT="7000" WIDTH="1500" HEIGHT="420"
           ONCLICK="select 'refresh' as karticagrid2# select 'visible' as karticagrid2, 'invisible' as karticagrid"/>

    <INPUT TYPE="button" NAME="" CAPTION="Pokaži" TOP="300" LEFT="9000" WIDTH="1500" HEIGHT="322"
           ONCLICK=" if @@rbtnKumulativ = 1 begin
                      select 'refresh' as karticagrid
                      select 'visible' as karticagrid
                      select 'invisible' as karticagrid2
                    end
                    else begin
                       select 'refresh' as karticagrid2
                       select 'visible' as karticagrid2
                       select 'invisible' as karticagrid
                    end
         select 'refresh' as grid"/>

    <INPUT TYPE="grid" NAME="karticagrid" TOP="800" LEFT="200" WIDTH="15500" HIGHT="6000"
            CAPTION="Kartica robe"
          TOTALROW="FALSE"
          CHECKBOXVISIBLE="FALSE"
            PAGEHEADERCENTER=""
          PAGEHEADERRIGHT="Kartica MP stanja za robu '@@opis'"
          PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Trgovina: @@comboboxskladisteid"
          PAGEFOOTERCENTER=""
          PAGEFOOTERLEFT=""
          PAGEFOOTERRIGHT=""
          PAGEORIENTATION="LANDSCAPE"
          SQL="exec spMPStanjeKarticaNG @action=0, @robaid=@@robaid, @DatumOd=@@Datod, @DatumDo=@@Datdo, @trgovinaid=@@trgid, @totalgen = @@totalgen , @datod = @@datod, @datdo = @@datdo" >

      <COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
      <COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
      <COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
    </INPUT>

    <INPUT TYPE="grid" NAME="karticagrid2" TOP="800" LEFT="200" WIDTH="15500" HIGHT="6000"
            CAPTION="Kartica robe"
          TOTALROW="FALSE"
          CHECKBOXVISIBLE="FALSE"
            PAGEHEADERCENTER=""
          PAGEHEADERRIGHT="Analitika kartice MP stanja za robu '@@opis'"
          PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Trgovina: @@comboboxskladisteid"
          PAGEFOOTERCENTER=""
          PAGEFOOTERLEFT=""
          PAGEFOOTERRIGHT=""
           VISIBLE="FALSE"
          PAGEORIENTATION="LANDSCAPE"
          SQL="exec spMPStanjeKarticaAnalitika @action=0, @robaid=@@gridstavkerobaid, @DatumOd=@@DatumOd, @DatumDo=@@DatumDo, @trgovinaid=@@trgovinaid, @totalgen = @@totalgen , @datod = @@datod, @datdo = @@datdo" >

      <COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
      <COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
      <COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
    </INPUT>

    <INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="6500" LEFT="200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>
    <INPUT TYPE="button" NAME="" CAPTION="Računi" TOP="6500" LEFT="2200" WIDTH="1500" HEIGHT="322"
           ONCLICK=":RACUNI"/>

    <INPUT TYPE="button" NAME="" CAPTION="Ispis kartice kumulativ" TOP="6500" LEFT="4200" WIDTH="2200" HEIGHT="322" ONCLICK="printgrid(karticagrid)"/>
    <INPUT TYPE="button" NAME="" CAPTION="Ispis kartice analitika" TOP="6500" LEFT="6500" WIDTH="2200" HEIGHT="322" ONCLICK="printgrid(karticagrid2)"/>
  </MPKARTICA>



	
</PROJECT>