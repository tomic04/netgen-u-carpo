<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spstPrometQueryGlaIDet @action=2,@operateriid=@@operateriid,@id=@@id"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER#Skl.dokument:SKLDOK#Print dok.:vrstadokid-STPrometGla" 
		 POPUPMASTER="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER" 
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spSTTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spSTTreeNG @action=2:FILTERODDO_FORM#spSTTreeNG @action=3:FILTERODDO_FORM#spSTTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 MULTIGRIDLAYOUT="true" 
		 DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT="">

	<MASTERCOLUMNS>
		<COLUMN INDEX="" NAME="Broj grla1200" WIDTH="1200" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" />
	</MASTERCOLUMNS>


	<NAME>Pregled dokumenata prometa glrla</NAME>
	<CAPTION>Pregled dokumenata prometa grla</CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='danas', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid, @vrsta='G'  "/>
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='jucer', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid, @vrsta='G'  " />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='ovajmj', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid , @vrsta='G' " />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='proslimj', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid , @vrsta='G' " />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='@@node', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid, @vrsta='G'   " />
<PONISTIFILTER		ONLOAD="select null as vrstapromid, null as vrtsadokid, null as farmeid " ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='@@node', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid, @vrsta='G'   " />




	<FILTERFORM NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spstPrometQueryGlaIDet @action = 1,   @operateriid= @@operateriid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid,@@vrstadokid as vrstadokid, @@vrstapromid as vrstapromid, @@strazlogizlucenja as strazlogizlucenja" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
			<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
			<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="farmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="FALSE" CAPTION="Farma" ONLOSTFOCUS="select 'refresh' as osobeid"/>
			<INPUT TYPE="combo" NAME="Vrstapromid" ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa" SQL="select vrstapromid, opis as naziv from vrstaprom where projekt = 'G'" ONLOSTFOCUS="select 'refresh' as vrstadokid"/>
			<INPUT TYPE="combo" NAME="vrstadokid" ALLOWEMPTY="true" CAPTION="Vrsta dokumenta" SQL="spSTDajVrstadok @vrstapromid = @@vrstapromid " />
			<INPUT TYPE="text"	 NAME="trazibroj"  WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta" ONLOSTFOCUS=""/>
</FILTERFORM>



<ZAKLJUCI NAME="ZAKLJUCI" HEIGHT="3197" WIDTH="5501" 
		CAPTION="Zaključiti dokument  ?" 
		ONSUBMIT="spSTZakljucidok @id=@@id, @operateriid = @@operateriid "
		ONLOAD5="if (select status from maloprodajagla where maloprodajaglaid= @@ID ) > 0 begin 
                        exec spRaiserror 69001,  'Dokument je zaključen. Ne može se više zaključivati!' 
						end
						else begin
                        exec spstPrometQueryGlaIDet @action=3,@ID=@@ID
					end" 
		ONLOAD="exec spstPrometQueryGlaIDet @action=3,@ID=@@ID" 
		 FILLEXPLORER="" 	
		 CMD1CAPTION="Zaključi" 
		 CMD2CAPTION="Odustani" 
		>
			<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" TABINDEX="1" ENABLED="FALSE"/>
			<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Broj dokumenta:" />
			<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? " />
</ZAKLJUCI>



<OTKLJUCAJ 
		 NAME="OTKLJUCAJ" HEIGHT="3197" WIDTH="5501" 
		 CAPTION="Otključavanje dokumenta  ?" 
		 ONSUBMIT="spMPOtkljucakDokNG @id=@@id"
		 ONLOAD="if (select status from maloprodajagla where maloprodajaglaid= @@ID ) > 0 begin 
                        exec spRaiserror 69001,  'Dokument je zaključen. Ne može se više otključavati!' 
						end
						else begin
                        exec spstPrometQueryGlaIDet @action=3,@ID=@@ID
					end"
		 FILLEXPLORER="" 
		 CMD1CAPTION="Otključaj" CMD2CAPTION="Odustani"
		>
		<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2779"  ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label57" TOP="360" LEFT="288" HEIGHT="288" WIDTH="1728" BOLD="FALSE" CAPTION="Broj narudžbe:" />
		<INPUT TYPE="label" NAME="stat" TOP="1267" LEFT="374" HEIGHT="418" WIDTH="4003"  BOLD="TRUE" CAPTION="Jeste li sigurni da želite otključati dokument  ? " />
</OTKLJUCAJ>



<BRISISTAVKU NAME="BRISISTAVKU" 
		HEIGHT="2902" WIDTH="7502"  
		CAPTION="Brisanje stavke" 
		ONLOAD="spstPrometQueryGlaIDet @action = 5,  @id= @@stavke" 
		>
			<INPUT TYPE="text"   NAME="maticnibroj"       CAPTION="Životni broj"      HEIGHT="317" WIDTH="4997"  TABINDEX="77" ENABLED="FALSE"/>
			<INPUT TYPE="number" NAME="kg" CAPTION="KG"   HEIGHT="302" WIDTH="1206"  DECIMALS="4" TABINDEX="1" ENABLED="FALSE" />
			<INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="spSTPrometInsertGlaIdetNG @action = 5, @stprometdetid = @@stavke #select 'refresh' as stavke#Ok"  HOTKEY="F2" />
			<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</BRISISTAVKU>

	<SKLDOK
	FILLEXPLORER=""
	WIDTH="8500"
		ONSUBMIT=""
	ONLOAD="spSTSktQueryGlaIDetNG @action = 8 , @id = @@id "
	HEIGHT="6000"
	CAPTION="Skladišni dokument"
		>
		<INPUT TYPE="text"   NAME="brdokizl"       CAPTION="Dokument izlučenja*"      TOP ="400" LEFT="2000" HEIGHT="317" WIDTH="1500"  ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="brdokskl"       CAPTION="Skladišni dokument*"      TOP ="400" LEFT="5000" HEIGHT="317" WIDTH="1500"   ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="datumdok"       CAPTION="Datum*"      TOP ="800" LEFT="2000" HEIGHT="317" WIDTH="1500"   ENABLED="FALSE"/>



		<INPUT TYPE="grid"
				NAME="kprometa"
				TOP="1200"
				LEFT="200"
				WIDTH="8000"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="3000"
				CAPTION="Skladišni dokument predatnice  "
		REFRESHAFTERCHILD="TRUE"
		SQL="spSTSktQueryGlaIDetNG @action = 9, @id = @@id" />

		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="5100" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</SKLDOK>




</PROJECT>