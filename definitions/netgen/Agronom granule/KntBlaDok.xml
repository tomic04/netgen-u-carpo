   CMD6CAPTION=""
   SETDEFAULTS=""
   ONLOAD2=""   
>
 
 <NAME>Blagajnički dokumenti</NAME>
 <CAPTION>Blagajnički dokumenti</CAPTION>
 
 <MASTERCOLUMNS CLEARCOLUMS="TRUE" HEADERALIGNMENT="2">
