<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD="spBLDokumentiQueryNG @action=0"
   MASTERDBLCLICK="IZMJENI_FORM"
   POPUPMASTER=""
   DETAILGRID = "spBLStavkeQueryNG @Action=0,@BlDokumentiId=@@id"
   TREE="Blagajne:#spBlagajneDokTreeNG @action=0,@operateriid=@@operateriid:MJESEC_FORM#spBlagajneDokTreeNG @action=1,@operateriid=@@operateriid:MJESEC1_FORM"
