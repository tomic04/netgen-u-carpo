	<COLUMN INDEX="" NAME="Sufix" WIDTH="1500" CAPTION="Sufix" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
	<COLUMN INDEX="" NAME="BrojDokDuz" WIDTH="1000" CAPTION="Dužina broja" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Template" WIDTH="3000" CAPTION="Template" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="IndZakljucak" WIDTH="1500" CAPTION="Poništi zaključak" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
