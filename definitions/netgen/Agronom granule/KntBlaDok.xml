	<COLUMN INDEX="" NAME="Konto" WIDTH="1800" CAPTION="Konto" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="KntInd" WIDTH="950" CAPTION="Analitika" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="OrgJedinica" WIDTH="800" CAPTION="Org. jedinica" FORMAT="#,##0.00" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Napomena" WIDTH="3500" CAPTION="Napomena" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
	<COLUMN INDEX="" NAME="Tko" WIDTH="1200" CAPTION="Tko" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Veza" WIDTH="1200" CAPTION="Veza" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
    <COLUMN INDEX="" NAME="DatumUmirovljenja" WIDTH="1200" CAPTION="Umirovljeno" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />  	
 </DETAILCOLUMNS>
 
 
 <MJESEC_FORM  FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spBLDokumentiQueryNG @action=0,@id='@@node'" />
 <MJESEC1_FORM  FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spBLDokumentiQueryNG @action=0,@id='@@node'" />
 

 <UNESI_FORM CAPTION="Nova vrsta dokumenta" HEIGHT="6700" WIDTH= "5200" FILLEXPLORER="" 
			   ONLOAD="select @@node as blagajneid,6 as brojdokduz,0 as indzakljucak" 
			   ONSUBMIT="" NEXTFORM=""
			   >
	
	<INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="4900" WIDTH="4800" CAPTION=""/>
	
	<INPUT TYPE="label" NAME="lblblagajna" TOP="350" LEFT="100" WIDTH="800" HEIGHT="320" CAPTION="Blagajna:"/>						
	<INPUT TYPE="combo" NAME="blagajneid" HOTKEY="" BACKCOLOR="" CAPTION="blagajne" TOP="300" LEFT="1700" 
				WIDTH="3000" HEIGHT="2000" 
				SQL="exec spBlagajneQueryNG 1, 0, @@operateriid" 
				ONLOSTFOCUS="" />
	
    <INPUT TYPE="label" NAME="lblvrstadokid" TOP="850" LEFT="100" WIDTH="800" HEIGHT="320" CAPTION="Vrsta dokumenta:"/>						
    <INPUT TYPE="combo" NAME="vrstadokid" HOTKEY="" BACKCOLOR="" CAPTION="vrstadok" TOP="800" LEFT="1700" ALLOWEMPTY="FALSE"
				WIDTH="3000" HEIGHT="2000" 
				SQL="select d.vrstadokid,d.opis as naziv from vrstadok d inner join vrstaprom p on d.vrstapromid = p.vrstapromid where p.sifra = '201'" 
				ONLOSTFOCUS="" />

	<INPUT TYPE="label" NAME="lblprefix" TOP="1350" LEFT="100" WIDTH="1000" HEIGHT="" CAPTION="Prefix:"/>
 	<INPUT TYPE="text" NAME="prefix" TOP="1300" LEFT="1700" WIDTH="3000" HEIGHT="700" CAPTION="prefix" ENABLED="TRUE" MULTILINE="TRUE"/>
	
	<INPUT TYPE="label" NAME="lblsufix" TOP="2250" LEFT="100" WIDTH="1000" HEIGHT="" CAPTION="Sufix:"/>
 	<INPUT TYPE="text" NAME="sufix" TOP="2200" LEFT="1700" WIDTH="3000" HEIGHT="700" CAPTION="sufix" ENABLED="TRUE" MULTILINE="TRUE"/>
	
	<INPUT TYPE="label" NAME="lbltemplate" TOP="3150" LEFT="100" WIDTH="1000" HEIGHT="" CAPTION="Template:"/>
 	<INPUT TYPE="text" NAME="template" TOP="3100" LEFT="1700" WIDTH="3000" HEIGHT="700" CAPTION="template" ENABLED="TRUE" MULTILINE="TRUE"/>
	
	<INPUT TYPE="label" NAME="lblduzbroja" TOP="4050" LEFT="100" HEIGHT="288" WIDTH="1210" CAPTION="Dužina broja:"  ENABLED="TRUE"/>
	<INPUT TYPE="text" NAME="brojdokduz" TOP="4000" LEFT="1700" HEIGHT="302" WIDTH="1205" ENABLED="TRUE"/>	   
	
	<INPUT TYPE="check" NAME="indzakljucak" TOP="4600" LEFT="1700" HEIGHT="288" WIDTH="245" CAPTION="" ONCLICK="" TEXT=""/>	
	<INPUT TYPE="label" NAME="lblponzak" TOP="4650" LEFT="100" WIDTH="1000" CAPTION="Poništi zaključak"/>
	 
	<INPUT TYPE="button" NAME="ok5" HOTKEY="" TOP="5150" LEFT="100" WIDTH="1300" HEIGHT="400" CAPTION="Spremi" 
	       ONCLICK="spBLDokumentiAzurNG @action=0,@blagajneid=@@blagajneid,@VrstaDokId=@@vrstadokid,@Prefix='@@prefix',@Sufix='@@sufix'
		           ,@Template='@@template',@BrojDokDuz=@@BrojDokDuz,@IndZakljucak=@@indzakljucak
				   #OK"/>
					
    <INPUT TYPE="button" NAME="ok7" HOTKEY="" TOP="5150" LEFT="1500" WIDTH="1300" HEIGHT="400" CAPTION="Odustani" ONCLICK="cancel"/>
	
	<INPUT TYPE="statusstrip"  NAME="s1"    TEXT1="@@version"  TEXT2="" TEXT3="" />	

</UNESI_FORM>

 
 
