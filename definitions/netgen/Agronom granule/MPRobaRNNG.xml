<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION="Print.dok.:vrstadokid-MPBlagajnaGla"
    MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE"
	  POPUPMASTER=""
       PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
    COMMANDTIMEOUT="300"> 
 

  <NAME>Pregled prodane robe po MP računu NG</NAME>
  <CAPTION>Pregled prodane robe po MP računu NG</CAPTION>


  <FILTER_FORM
    NAME="FILTER_FORM"
    CAPTION="Parametri"
		WIDTH="7600" 
    HEIGHT="5000" 
		ONSUBMIT="spMPProdanaRobaRN @action=1, @operateriid = @@operateriid," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, 0 as podklase, @@trgovinaid as trgovinaid, @@klasaid as klasaid"
		
		FILLEXPLORER="TRUE"
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" >

    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="400" LEFT="1500"
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>
    <INPUT TYPE="combo" NAME="vrstarobeid" CAPTION="Vrsta robe*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE"  TOP="800" LEFT="1500" 
              SQL="select 0 as vrstarobeid,'Sva roba' as naziv  union all select 1 as vrstarobeid,'Samo roba s popustom' as naziv"/>
    <INPUT TYPE="search" NAME="robaid"	 WIDTH="5500" TOP="1200" LEFT="1500"
		   SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" ALLOWEMPTY="TRUE" CAPTION="Roba*" ONLOSTFOCUS=""/>

    <INPUT TYPE="search"  CAPTION="Klasa*" NAME="klasaid"  TOP="1600" LEFT="1500"  WIDTH="5500" HEIGHT="320"
          SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
    
    <!--<INPUT TYPE="combo" CAPTION="Klasa*" NAME="klasaid" TOP="1200" LEFT="1500"
           SQL="select KlMasterRobaid, oznaka + ' ' +naziv as naziv from KlMasterRoba order by sortkey" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE"/>-->

    <INPUT TYPE="check" NAME="podklase" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase" ENABLED="TRUE" ALLOWEMPTY="TRUE" TOP="2000" LEFT="1500" />
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od - do*" HEIGHT="320" WIDTH="1200" DEFAULT="firstdayofmonth" TOP="2400" LEFT="1500"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="-*" HEIGHT="320" WIDTH="1200" DEFAULT="today" TOP="2400" LEFT="2850"/>

    <INPUT TYPE="number" NAME="satod" CAPTION="Od (HH:mm):*" TOP="2900" LEFT="1500" HEIGHT="302" WIDTH="300"  DECIMALS="0" MAXLENGTH = "2"/>
    <INPUT TYPE="number" NAME="minod" CAPTION=":*" TOP="2900" LEFT="2000" HEIGHT="302" WIDTH="300"  DECIMALS="0" MAXLENGTH = "2" />
    <INPUT TYPE="number" NAME="satdo" CAPTION="Do (HH:mm)*" TOP="3300" LEFT="1500" HEIGHT="302" WIDTH="300" DECIMALS="0" MAXLENGTH = "2"/>
    <INPUT TYPE="number" NAME="mindo" CAPTION="-" TOP="3300" LEFT="2000" HEIGHT="302" WIDTH="300" DECIMALS="0" MAXLENGTH = "2"/>

  </FILTER_FORM>

</PROJECT> 