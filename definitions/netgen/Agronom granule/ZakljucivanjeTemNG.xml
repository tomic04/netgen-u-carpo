<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  ONLOAD=":MAINFORM" GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE" WINDOWSTATE="2">
<NAME>Zaključivanje temeljnica</NAME>
<CAPTION>Zaključivanje temeljnica</CAPTION>


<MAINFORM NAME="MAINFORM" HEIGHT="2635" WIDTH="5688" CAPTION="Odredite parametre za zaključivanje ili poništavanje zaključka temeljnica" FOCUS="MASTER" MAXIMIZEBOX="TRUE">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="72" HEIGHT="1368" WIDTH="5198" TEXT="FrameNG0" ANCHOR="13"/>
	<INPUT TYPE="label" NAME="lblod" TOP="432" LEFT="202" HEIGHT="317" WIDTH="936" CAPTION="Razdoblje:"/>
	<INPUT TYPE="label" NAME="lblprijemdo" TOP="432" LEFT="2995" HEIGHT="317" WIDTH="331" CAPTION="-"/>
	<INPUT TYPE="date" NAME="datumod" TOP="432" LEFT="1195" HEIGHT="302" WIDTH="1498" VALUE="DATE" TABINDEX="0" CAPTION="Datum od" DEFAULT="firstdayoflastmonth" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" TOP="432" LEFT="3499" HEIGHT="302" WIDTH="1498" VALUE="DATE" TABINDEX="1" CAPTION="do" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="vrstadokid" TOP="792" LEFT="1195" HEIGHT="302" WIDTH="3802"  SQL="select vd.VrstaDokId,vd.Opis
					   from VrstaDok vd
					   inner join VrstaProm vp on vd.VrstaPromId = vp.VrstaPromId
					   where vp.VrstaPromId in (select VrstaPromId from VrstaProm where Projekt = &apos;K&apos;)
					   order by vd.Opis" ALLOWEMPTY="false" ANCHOR="13"/>
	<INPUT TYPE="label" NAME="lblvrstadok" TOP="792" LEFT="202" HEIGHT="288" WIDTH="994" CAPTION="Vrsta dok.:" />
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="1584" LEFT="3197" HEIGHT="360" WIDTH="1440" VISIBLE="TRUE" TEXT="ButtonNG2" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="buttonpON" TOP="1584" LEFT="1642" HEIGHT="360" WIDTH="1440" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Poništi zaključke" ENABLED="TRUE" ONCLICK=":Ponistavanje" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="1584" LEFT="72" HEIGHT="360" WIDTH="1440" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Zaključi" ENABLED="TRUE" ONCLICK=":Zakljucavanje" ANCHOR="6"/>

</MAINFORM>

<Zakljucavanje NAME="Zakljucavanje" HEIGHT="2174" WIDTH="4363" CAPTION="Zaključivanje temeljnica" ONSUBMIT="spKntZakljucivanjeTem @action=1,@datumod=@@datumod,@datumdo=@@datumdo,@vrstadokid=@@vrstadokid">
	<INPUT TYPE="label" NAME="Label70" TOP="446" LEFT="374" HEIGHT="288" WIDTH="3442" CAPTION="Jeste li sigurni da želite zaključiti temeljnice?"/>
	<INPUT TYPE="button" NAME="ButtonNG1" TOP="1051" LEFT="1987" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" ONCLICK="CLOSE" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="ButtonNG0" TOP="1051" LEFT="706" HEIGHT="331" WIDTH="1080" TEXT="Zaključi" CAPTION="Zaključi" ONCLICK="OK" DECIMALS="2" ANCHOR="6"/>

</Zakljucavanje>

<Ponistavanje NAME="Ponistavanje" HEIGHT="2174" WIDTH="4363" CAPTION="Poništavanje zaključaka" ONSUBMIT="spKntZakljucivanjeTem @action=2,@datumod=@@datumod,@datumdo=@@datumdo,@vrstadokid=@@vrstadokid">
	<INPUT TYPE="label" NAME="Label70" TOP="446" LEFT="374" HEIGHT="288" WIDTH="3442" CAPTION="Jeste li sigurni da želite poništiti zaključke?"/>
	<INPUT TYPE="button" NAME="ButtonNG1" TOP="1051" LEFT="1987" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" ONCLICK="CLOSE" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="ButtonNG0" TOP="1051" LEFT="706" HEIGHT="331" WIDTH="1080" TEXT="Zaključi" CAPTION="Poništi" ONCLICK="OK" DECIMALS="2" ANCHOR="6"/>

</Ponistavanje>

</PROJECT>