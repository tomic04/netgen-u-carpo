<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD=":FILTERFORM"
      CMD1CAPTION="Uvjeti:FILTERFORM"
      CMD2CAPTION=""
      CMD5CAPTION="Lista"
      CMD8CAPTION="Dokument"
		 BUTTONS="Uvjeti:FILTERFORM#Ispis:repx/rptMPRekapPorezPP(@datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@trgovinaid, @vrstapromid = @@vrstapromid, @vrstadokid = @@vrstadokid, @operateriid = @@operateriid)" 
      REPORT=""
      MASTERDBLCLICK=""
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname'#select dbo.fnTkoSmoMi() as tkosmomi" 
	  CHECKBOXVISIBLE="FALSE"
		DETAILGRID = "exec spMPRekapPorezNG @action=2, @operateriid = 7, @trgovinaid=@@trgovinaid,@vrstadokid=null,@vrstapromid=106,@datumdo=@@datumdo,@datumod=@@datumod, @id= @@id"
		 PAGEHEADERCENTER="Izvješće o obračunu poreza na potrošnju"
	     PAGEHEADERRIGHT="@@tkosmomi"
	     PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo "
	     PAGEFOOTERCENTER=""
	     PAGEFOOTERLEFT=""
	     PAGEFOOTERRIGHT=""
	     PAGEORIENTATION="LANDSCAPE"   POPUPMASTER="" >
		
	
	<NAME>Rekapitulacija poreza na potrošnju po dokumentima u MP </NAME>
	<CAPTION>Rekapitulacija poreza na potrošnju po dokumentima u MP </CAPTION>

	<KOMENTAR> ASDASD </KOMENTAR>

	<MASTERCOLUMNS>
		<COLUMN INDEX="" NAME="Stopa%1000" WIDTH="" CAPTION="" FORMAT="" VISIBLE="" AGREGATEFUNCTION="0" />
	</MASTERCOLUMNS>



	<FILTERFORM
						   FILLEXPLORER="TRUE"
						   REPORT=""
						   WIDTH="9000"
						   ONSUBMIT="spMPRekapPorezNG @action = 1, @operateriid = @@operateriid, "
						   ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstapromid as vrstapromid"
						   HEIGHT="3800"
						   CAPTION="Upišite uvjete "
						   BORDERSTYLE="3"
									CMD1CAPTION="Pokaži ->>"
									CMD2CAPTION="Odustani"
									CMD3CAPTION=""
									NEXTFORM=""  >

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="FALSE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="" SQL="select vrstadokid, opis from vrstadok where mppredznak = -1 and aktivni = 1" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />




	</FILTERFORM>


	<FILTERFORM1
						 FILLEXPLORER="TRUE"
						 REPORT=""
						 WIDTH="8000"
						 ONSUBMIT=""
						 ONLOAD=""
						 HEIGHT="4800"
						 CAPTION="Upišite uvjete pregleda "
						 BORDERSTYLE="3"
								  CMD1CAPTION="Pokaži"
								  CMD2CAPTION="Odustani"
								  CMD3CAPTION=""
								  NEXTFORM=""  >

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstapromid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />


	</FILTERFORM1>




</PROJECT>

