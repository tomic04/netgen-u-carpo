<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Lista:Lista#REFRESHMASTER" 
		  CMD2CAPTION="Naprijed:Naprijed" 
		  CMD3CAPTION="Nazad:Nazad#REFRESHMASTER" 
		  CMD5CAPTION="Novi:Novi#REFRESHMASTER" 
		  CMD6CAPTION="Poništi obračun:PONOBR#REFRESHMASTER" 
		  CMD7CAPTION="Ispis:PRINTMASTER"
		   
		  CMD8CAPTION="Ispis obračuna:MULTIBLUE_PRINT"
		  ONLOAD=":Lista" 
POPUP="Fakturiraj:FAKTURIRAJ"
		  ONDBLCLICK=":Naprijed"
		  REFRESHAFTERCHILD="TRUE"
		  GROUPBYBOXVISIBLE="TRUE" 
		  MASTERDBLCLICK="Naprijed" 
		  CHECKBOXVISIBLE="FALSE" 
		  TOTALROWVISIBLE="FALSE"
		  DETCHECKBOXVISIBLE="FALSE"
		  DETTOTALROWVISIBLE="FALSE"
		  MULTIGRIDLAYOUT="true">
	
<NAME>KTEukp</NAME>
<CAPTION>Kamate ukupno</CAPTION>
<KOMENTAR>CallistoII 2.14.0</KOMENTAR>
<HISTORY>
28.11.2012. SPIN\atomic - ANAT
</HISTORY>

<Lista ONSUBMIT="spKteUKPQuery @action=1" FILLEXPLORER="true"/>

<Naprijed ONSUBMIT="spKteUKPQuery @action=0,@id=@@id" FILLEXPLORER="true" MULTIGRIDLAYOUT="true" />
	
<Nazad ONSUBMIT="spKteUKPQuery @action=-1,@id=@@id" FILLEXPLORER="true" MULTIGRIDLAYOUT="true"/>


	
<Novi NAME="Novi obračun" HEIGHT="5805" WIDTH="7502" CAPTION="Novi obračun">
	<INPUT TYPE="combo" NAME="stopa" TOP="490" LEFT="2203" HEIGHT="302" WIDTH="4694" SQL="select kteVrsteStopaID, Opis as naziv from KteVrsteStopa" ALLOWEMPTY="False"/>
	<INPUT TYPE="label" NAME="LabelVS" TOP="490" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Vrsta stope:" TEXT="Label14"/>
	
	<INPUT TYPE="date" NAME="DatumDo" TOP="990" LEFT="4176" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="date" NAME="DatumOd" TOP="990" LEFT="2203" HEIGHT="302" WIDTH="1728"/>
	<INPUT TYPE="label" NAME="Labeldat" TOP="990" LEFT="360" HEIGHT="288" WIDTH="1296" CAPTION="Razdoblje:" TEXT="Label70"/>
	
	<INPUT TYPE="combo" NAME="konto" TOP="1490" LEFT="2203" HEIGHT="302" WIDTH="4709" SQL="
select KntPlanAId,konto+&apos; &apos;+naziv as [Naziv] from kntplana 
where kntvrstaid in (select kntvrstaid from kntvrsta where tablica in ('Fakture'))
UNION ALL
select KntPlanAId,konto+&apos; &apos;+naziv as [Naziv] from kntplana 
where konto in ('120100','120103')
"/>
	<INPUT TYPE="label" NAME="LabelKonto" TOP="1490" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Konto:" TEXT="Label14"/>
	
	<INPUT TYPE="label" NAME="LabelN" TOP="1990" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Napomena:" TEXT="Label16"/>
	<INPUT TYPE="text" NAME="Napomena" TOP="1990" LEFT="2203" HEIGHT="302" WIDTH="4680" TABINDEX="20" DECIMALS="0"/>
	
	<INPUT TYPE="date" NAME="DatumFak" TOP="2490" LEFT="2203" HEIGHT="302" WIDTH="1584" TABINDEX="10" DECIMALS="0"/>
	<INPUT TYPE="label" NAME="Label16" TOP="2490" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Datum fakture:" TEXT="Label16"/>
	
	<INPUT TYPE="search" NAME="PartneriId" TOP="2990" LEFT="2203" HEIGHT="302" WIDTH="4709" SQL="Partneri#PartneriId#Naziv%"/>
	<INPUT TYPE="label" NAME="Label25" TOP="2990" LEFT="360" HEIGHT="288" WIDTH="1296" CAPTION="Partner:" TEXT="Label25"/>
	
	<INPUT TYPE="combo" NAME="VrstaObracuna" TOP="3490" LEFT="2203" HEIGHT="302" WIDTH="4709" SQL="select 2 as VrstaObracunaid, &apos;2-Obračun kamata na UPLATE &apos; as naziv
																							union all select 3 as VrstaObracunaid, &apos;3-Obračun kamata na otvorene i zatvorene stavke &apos; as naziv
																							union all select 4 as VrstaObracunaid, &apos;4-Obračun kamata na zatvorene stavke &apos; as naziv
																							union all select 5 as VrstaObracunaid, &apos;5-Obračun na dio računa za gnojiva&apos; as naziv
union all select 6 as VrstaObracunaid, &apos;6-Obračun kamata na otvorene stavke&apos; as naziv" ALLOWEMPTY="FALSE"/>
	<INPUT TYPE="label" NAME="LabelVO" TOP="3490" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Vrsta obračuna:" TEXT="Label14"/>
	
	<INPUT TYPE="combo" NAME="Kultura" TOP="3990" LEFT="2203" HEIGHT="302" WIDTH="4709" SQL="select Kultureid,Naziv as [Naziv] from Kulture" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="LabelK" TOP="3990" LEFT="360" HEIGHT="288" WIDTH="1728" CAPTION="Kultura:" TEXT="Label14"/>
	
	<INPUT TYPE="button" NAME="ButtonNG2" TOP="4525" LEFT="2390" HEIGHT="331" WIDTH="1080" TEXT="Kreiraj" CAPTION="Kreiraj" TABINDEX="30" ONCLICK="spKteUKPDonos @action=2,  @partneriid=@@partneriid,@IDstopa=@@stopa,@datumod=@@datumod,@datumdo=@@datumdo,@kntplanaid=@@konto,@DatumFakture=@@datumFak,@VrstaObracunaid=@@VrstaObracuna,@Kultureid=@@kultura,@Napomena='@@Napomena'#OK"/>
	<INPUT TYPE="button" NAME="ButtonNG1" TOP="4525" LEFT="3758" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" TABINDEX="40" ONCLICK="CLOSE"/>

</Novi>
	

<PONOBR NAME="Poništi obračun" HEIGHT="2246" WIDTH="6192" CAPTION="Brisanje cijelog obračuna" ONLOAD="spKteUKPQuery @action=88,@ID=@@id">
	<INPUT TYPE="label" NAME="labelh1" TOP="331" LEFT="778" HEIGHT="288" WIDTH="9000" CAPTION="Jeste li sigurni da želite poništiti obračun?"/>
	<INPUT TYPE="button" NAME="ButtonNG2" TOP="994" LEFT="1814" HEIGHT="331" WIDTH="1080" TEXT="Prihvati" CAPTION="Obriši" TABINDEX="30" ONCLICK="spKteUKPQuery @action=8,@ID=@@id#OK"/>
	<INPUT TYPE="button" NAME="ButtonNG1" TOP="994" LEFT="3182" HEIGHT="331" WIDTH="1080" TEXT="Odustani" CAPTION="Odustani" TABINDEX="40" ONCLICK="CLOSE"/>

</PONOBR>

<FAKTURIRAJ
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="8000" 
                         ONSUBMIT="spKteUKPQuery @action=9,@ID=@@ID " 
                         ONLOAD="spKteUKPQuery @action=66,@ID=@@ID" 
                         HEIGHT="4800" 
                         CAPTION="Fakturiraj"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Fakturiraj" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
					NEXTFORM=""  >

			<INPUT TYPE="VB.Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="3500" HEIGHT="320" CAPTION="Jeste li sigurni?" />                                  

	</FAKTURIRAJ>


<MULTIBLUE_PRINT NAME="MULTIBLUE_PRINT" HEIGHT="1613" WIDTH="3139" CAPTION="Ispis" ONLOAD="select &apos;rptKteUkp_Multi&apos; as imereporta">
	<INPUT TYPE="label" NAME="LabelIspis" TOP="115" LEFT="202" HEIGHT="288" WIDTH="2606" CAPTION="Želite li ispisati označene dokumente?"/>
	<INPUT TYPE="button" NAME="button1" TOP="590" LEFT="202" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG28" CAPTION="Ispiši" TABINDEX="10" ONCLICK=":repx/rptKteUkp_Multi() #CLOSE"/>
	<INPUT TYPE="button" NAME="button2" TOP="590" LEFT="1642" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG29" CAPTION="Odustani" TABINDEX="20" ONCLICK="CLOSE"/>

</MULTIBLUE_PRINT>


</PROJECT>