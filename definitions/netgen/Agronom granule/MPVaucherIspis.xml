<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD1CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETAILGRID="spmpVaucher @action = 13, @id = @@id"
   DETTOTALROWVISIBLE="TRUE"
	FILLEXPLORER=""
   BUTTONS="Pronađi:FILTERFORM#Etikete:ETIKETE" 
   MASTERDBLCLICK="UPDATEFORM">
 
  <NAME>VAUCHERI </NAME>
  <CAPTION>VAUCHERI</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<FILTERFORM NAME="FILTERFORM" HEIGHT="5200" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPVaucher @action=1, @operateriid=@@operateriid, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="check" NAME="sve" CAPTION="Bez obzira na datum" />
		<INPUT TYPE="combo" NAME="aktivno" ALLOWEMPTY="TRUE" CAPTION="Status" ONLOSTFOCUS="" SQL="select 2 as aktivno, 'Aktivno' as Naziv union all select '1', 'Neaktivno'" />
	</FILTERFORM>

  

	<ETIKETE	FILLEXPLORER="TRUE"
	WIDTH="7000"
	ONSUBMIT=""
	ONLOAD="if @@id = 0 begin exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos; end 
	else begin if (select status from mpuvjetikase where mpuvjetikaseid=@@id) &lt;&gt; 2 begin 
	exec spRaiserror 69001, &apos;Moguć je ispis samo aktivnih zapisa !&apos; end 
	else begin if exists (select top 1 mpuvjetikaseid from MPUvjetiKaseDodVauc where  mpuvjetikaseid=@@id and Vrijemeispisa is not null) begin
	exec spRaiserror 69001, &apos;Ispis je napravljen i više nije moguć !&apos; end 
				end
				end"
ONLOAD2="select komada  as komada from MPUvjetiKaseDodVauc where mpuvjetikaseid=@@id"
				HEIGHT="5000"
	CAPTION="Štampanje etiketa "
	BORDERSTYLE="3"
	CMD3CAPTION=""
	NEXTFORM=""
	REFRESHAFTERCHILD="TRUE">


	<INPUT TYPE="number" NAME="komada" CAPTION="Broj komada za ispis:*" TOP="140" LEFT="1960" WIDTH="2996" HEIGHT="294" SQL="" ENABLED="FALSE" DECIMALS="0"/>
	
	<INPUT TYPE="grid" NAME="stavke" CAPTION="Štampanje iz Jupitera" TOP="546" LEFT="1400" WIDTH="5250" HEIGHT="2968" 
		   SQL="spMPVaucher @action=11, @id=@@id"
			PAGEHEADERRIGHT=""
			PAGEHEADERCENTER=""
			PAGEHEADERLEFT=""
			PAGEFOOTERCENTER=""
			PAGEFOOTERLEFT=""
			PAGEFOOTERRIGHT=""
			PAGEORIENTATION="LANDSCAPE"
			CHECKBOXVISIBLE="FALSE"
 />
	<INPUT TYPE="button" NAME="" CAPTION="Zatvori" TOP="980" LEFT="140" WIDTH="1050" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="" CAPTION="Ispis iz jupitera" TOP="3640" LEFT="224" WIDTH="1386" HEIGHT="406" ONCLICK=":repx/rptAgronomMONaljepniceIstekLom(@id=@@id, @komada=@@komada)#close"  />


	</ETIKETE>


</PROJECT>
 

