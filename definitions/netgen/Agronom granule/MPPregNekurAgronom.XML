<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
ONLOAD=":FORM1"  		
REPORT="" 	
CMD1CAPTION="Parametri:FORM1" 
CMD2CAPTION="Promet:FORM2" 
CMD3CAPTION="" 
CMD4CAPTION=""
CMD5CAPTION="" 
CMD6CAPTION=""  
MASTERDBLCLICK=""
POPUPMASTER=""
CHECKBOXVISIBLE="FALSE"
DETCHECKBOXVISIBLE="FALSE"
TOTALROWVISIBLE="FALSE"
DETTOTALROWVISIBLE="FALSE"
COMMANDTIMEOUT="300"
PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid, za klasu robe: @@searchboxklasaid"
PAGEHEADERCENTER="Pregled nekurentne robe u zadnjih @@broj1 dana"
PAGEHEADERRIGHT="@@tkosmomi"
SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 

  <NAME>Pregled nekurentne robe</NAME>
  <CAPTION>Pregled nekurentne robe</CAPTION>
  

<FORM1 	
	FILLEXPLORER="TRUE" 
	HEIGHT="4500" WIDTH="7100"
	ONSUBMIT="spMPPregNekurentneRobeAgronomNG @action=1,@operateriid=@@operateriid," 
	ONLOAD="select @@trgovinaid as trgovinaid, @@broj1 as broj1, @@stanje as stanje" 
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani"> 
		
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="200" LEFT="1200"  WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE" 
            SQL="spmpdajtrgovinang @operateriid = @@operateriid"/>
    <INPUT TYPE="number" NAME="broj1" TOP="600" LEFT="1200" CAPTION="Broj dana*" DECIMALS="0" WIDTH="1900" HEIGHT="320"/> 
    <INPUT TYPE="search" NAME="robaid" CAPTION="Roba*" TOP="1000" LEFT="1200" WIDTH="5500" HEIGHT="320"
            SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" />
    <INPUT TYPE="search"  CAPTION="Klasa*" NAME="klasaid" TOP="1400" LEFT="1200"  WIDTH="5500" HEIGHT="320"
          SQL="spMPDajKlase @trazi = '@@searchboxklasaid'"/>
	<!--<INPUT TYPE="combo" NAME="klasaid" CAPTION="Klasa" TOP="1800" LEFT="2200"  WIDTH="5500" HEIGHT="320" TABINDEX="3" ALLOWEMPTY="TRUE" 
		  SQL="select KlMasterRobaId,  naziv = space(len(sortkey)) + naziv,sortkey from KlMasterRoba order by sortkey"  />-->
	<INPUT TYPE="check" NAME="podklase" CAPTION="pokaži i sve podklase" TOP="1800" LEFT="1200" WIDTH="3500"	HEIGHT="320" />
	<INPUT TYPE="combo" NAME="bojaid" CAPTION="Boja*" TOP="2200" LEFT="1200"  WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE"
            SQL="select id, boja from ManRobaBoja order by boja"/>
    <INPUT TYPE="check" NAME="stanje" CAPTION="pokaži samo robe kojima je stanje različito od 0" TOP="2800" LEFT="1200" WIDTH="4000" HEIGHT="320" />

</FORM1>
 

<FORM2	 	
	FILLEXPLORER="TRUE"
	HEIGHT="6000" WIDTH="12000" 
	ONSUBMIT="" 
	ONLOAD="" 			 
	CAPTION="Promet" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani"> 
		
	<INPUT TYPE="grid" 
		NAME="lbl2" 
		TOP="700" 
		LEFT="200" 
		WIDTH="11000" 		
		HEIGHT="4000" 
		CAPTION="Promet:"
		REFRESHAFTERCHILD="TRUE"
		SQL="spMPPregNekurentneRobeAgronomNG @action=2,@robaid=@@id,@klasaid=null,@podklase=null,@Broj1=null,@operateriid=0,@stanje=null, @trgovinaid = @@trgovinaid"/>
			
</FORM2>

</PROJECT> 