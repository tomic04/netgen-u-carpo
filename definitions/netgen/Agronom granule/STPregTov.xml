<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spSTRadniNalozi @action=4, @idrn = @@id, @datumod=@@datumod, @datumdo=@@datumdo"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER#Zaključak turnusa:ZAKLJUCITURNUS#Obračun tova:OBRACUN#Print dok.:vrstadokid-STPrometGla" 
		 POPUPMASTER="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER" 
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spSTTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spSTTreeNG @action=2:FILTERODDO_FORM#spSTTreeNG @action=3:FILTERODDO_FORM#spSTTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spSTPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' , @sifradok = '89' , @trazi='%tov%'" 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT=""
		 COMMANDTIMEOUT="600">



	<NAME>Pregled tova</NAME>
	<CAPTION>Pregled tova</CAPTION>

	<MASTERCOLUMNS>
		<COLUMN INDEX="8" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="9" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="10" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="11" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="12" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="13" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="14" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="15" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0.00" VISIBLE="" AGREGATEFUNCTION="2" STYLE="1"/>
		<COLUMN INDEX="16" NAME="" WIDTH="" CAPTION="" FORMAT="#,##0.00" VISIBLE="" AGREGATEFUNCTION="3" STYLE="1"/>
	</MASTERCOLUMNS>


	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spSTRadniNalozi @action=3,@operateriid=@@operateriid,@node='danas', @vrstadokid = @@vrstadokid "/>
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spSTRadniNalozi @action=3,@operateriid=@@operateriid,@node='jucer',  @vrstadokid = @@vrstadokid " />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spSTRadniNalozi @action=3,@operateriid=@@operateriid,@node='ovajmj', @vrstadokid = @@vrstadokid " />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spSTRadniNalozi @action=3,@operateriid=@@operateriid,@node='proslimj', @vrstadokid = @@vrstadokid " />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spSTRadniNalozi @action=3,@operateriid=@@operateriid,@node='@@node', @vrstadokid = @@vrstadokid  " />
<PONISTIFILTER		ONLOAD="select null as vrstapromid, null as vrtsadokid, null as farmeid " ONSUBMIT="spstPrometQueryGlaIDet @action=1,@operateriid=@@operateriid,@node='@@node', @vrstapromid = @@vrstapromid , @vrstadokid = @@vrstadokid  " />




	<FILTERFORM NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spSTRadniNalozi @action = 3,  @operateriid= @@operateriid, @vrstadokid = @@vrstadokid,@idrn = @@prnradninalogid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid,@@vrstadokid as vrstadokid, @@vrstapromid as vrstapromid, @@strazlogizlucenja as strazlogizlucenja" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
			<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
			<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS="select 'refresh' as osobeid"/>
			<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 1, @stfarmeid = @@stfarmeid, @trazi = '@@searchboxprnradninalogid'"/>
			<INPUT TYPE="combo" NAME="status" ONCLICK="" SQL="select 0 as status , 'Otvoren' as naziv union all select 1,'Zatvoren'" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Status" ONLOSTFOCUS="select 'refresh' as osobeid"/>
	</FILTERFORM>



	<OBRACUN NAME="POKAZIFORM" HEIGHT="9000" WIDTH="11002"
			 CAPTION="Obračun tova "
			 ONLOAD="select * from prnradninalog where prnradninalogid = @@id "
			 CMD2CAPTION="Povratak"
		>

		
		<INPUT TYPE="text"   NAME="broj"             CAPTION="Broj RN:*"        TOP="144" LEFT="2160" HEIGHT="317" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="date"   NAME="datumdok"         CAPTION="Datum RN:*"       TOP="504" LEFT="2160" HEIGHT="302" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="text"  NAME="opis"  CAPTION="Turnus:*"  TOP="504 " LEFT="5160" HEIGHT="302" WIDTH="1500" SQL="" ALLOWEMPTY="FALSE" ENABLED="FALSE" />
		<INPUT TYPE="grid"
			   NAME="stavke"
			   TOP="1000"
			   LEFT="58"
			   HEIGHT="6989"
			   WIDTH="50198"
				GROUPBYBOXVISIBLE="false"
				COLUMNHEADERS="2"
			   CHECKBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spstObracunTova @action = 1, @prnradninalogid  = @@id" >
			<COLUMN INDEX="2" NAME="" WIDTH="" CAPTION="aaaaaaaaaaaaaaa" FORMAT="" AGREGATEFUNCTION="0" VISIBLE="" FORECOLOR="" BACKCOLOR="" ALIGN="RIGHT"/>


		</INPUT>
		</OBRACUN>

	<ZAKLJUCITURNUS NAME="ZAKLJUCITURNUS" HEIGHT="4000" WIDTH="7000"
		 CAPTION="Zaključak turnusa "
		 ONLOAD="if (select status from prnradninalog where prnradninalogid = @@id ) = 1 begin 
						exec spRaiserror 69001,  ' Turnus je već zaključen. Ne možete ga zaključiti  !'
					end 
					else begin   
						exec spSTRadniNalozi  @action = 5,  @prnradninalogid = @@id 
					end "
		 CMD2CAPTION=""
		>
		<INPUT TYPE="text"   NAME="brprn"             CAPTION="Broj RN:*"        TOP="144" LEFT="2500" HEIGHT="317" WIDTH="1498" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="text"  NAME="opisprn"  CAPTION="Turnus:*"  TOP="500 " LEFT="2500" HEIGHT="302" WIDTH="1500" SQL="" ALLOWEMPTY="FALSE" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="date"   NAME="datumprn"         CAPTION="Datum početka tova RN:*"       TOP="1000" LEFT="2500" HEIGHT="302" WIDTH="1498" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="date"   NAME="Datkraj"         CAPTION="Datum zadnjeg prometa stoke za RN:*"       TOP="1500" LEFT="2500" HEIGHT="302" WIDTH="1498" ENABLED="FALSE" STYLE="1"/>
		<INPUT TYPE="number"   NAME="brojgrla"         CAPTION="Broj grla u turnusu* "       TOP="2000" LEFT="2500" HEIGHT="302" WIDTH="900" ENABLED="FALSE" STYLE="1" DECIMALS="0"/>

		<INPUT TYPE="button" NAME="ok" CAPTION="Zaključi" TOP="3000" LEFT="1196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spSTRadniNalozi  @action=6,@operateriid=@@operateriid,@prnradninalogid = @@id, @Datkraj = @@datkraj, @brojgrla = @@brojgrla #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3000" LEFT="2456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



	</ZAKLJUCITURNUS>








</PROJECT>