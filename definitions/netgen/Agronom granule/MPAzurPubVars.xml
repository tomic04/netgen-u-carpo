<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spMPAzurPubvars @action = 2" 
   CMD2CAPTION=""    
   CMD4CAPTION="Izmjeni:UPDATEFORM" 
   CMD3CAPTION=""
   CMD1CAPTION="Obnovi:OBNOVI"
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK="">

	
  <NAME>Ažuriranje parametara MP </NAME>
  <CAPTION>Ažuriranje parametara MP </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<OBNOVI
			   WIDTH="8000" 
			   ONSUBMIT="spMPAzurPubvars @action = 1" 
			   ONLOAD="" 
			   HEIGHT="2500" 
				FILLEXPLORER="TRUE" 
				CAPTION="Obnova parametara "  
			  FOCUS="Naziv"
		 >
		<INPUT TYPE="label" CAPTION="Želite li obnoviti paremetre MP ? " NAME="varime" TOP="500" LEFT="400" SQL="" TABINDEX="1" STYLE="BOLD" SIZE="12" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="false" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Obnovi" TOP="1500" LEFT="196" TABINDEX ="2" WIDTH="1106" HEIGHT="322" ONCLICK="spMPAzurPubvars @action = 1#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1500" TABINDEX="1" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</OBNOVI>




	<UPDATEFORM 
                 WIDTH="8000" 
                 ONSUBMIT="" 
                 ONLOAD="select * from pubvars where pubvarsid = @@id" 
                 HEIGHT="3500" 
                 CAPTION="Izmjena podataka"  
				FOCUS="Naziv"
		 >
	  	        <INPUT TYPE="text" CAPTION="Naziv parametra" NAME="varime" SQL="" TABINDEX="1" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="false" />
				  <INPUT TYPE="text" CAPTION="Parametar" NAME="varset" SQL="" TABINDEX="2" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" />
				  <INPUT TYPE="text" NAME="varopis" CAPTION="Opis" VALUE="" HEIGHT="320" WIDTH="5500" TABINDEX="3" ALLOWEMPTY="FALSE" />

				  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPAzurPubvars @action=3, @pubvarsid= @@id, @varset= '@@varset' , @varime = '@@varime' , @varopis = '@@varopis'#Ok"  />
				  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </UPDATEFORM>







</PROJECT>
 
