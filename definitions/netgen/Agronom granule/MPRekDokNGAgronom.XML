<?xml version="1.0" encoding="windows-1250" ?>


<PROJECT  
ONLOAD=":FILTERFORM"  
CMD1CAPTION="Uvjeti:FILTERFORM" 
CMD2CAPTION="" 
CMD3CAPTION="" 
CMD4CAPTION="" 
CMD5CAPTION="Ispis liste:PRINTMASTER" 
CMD6CAPTION=""   
CMD7CAPTION="Lista"   
CMD8CAPTION=""   
REPORT="" 
MASTERDBLCLICK=""
PAGEHEADERRIGHT="@@tkosmomi"
PAGEHEADERLEFT="Od @@datod do @@datdo"
POPUPMASTER=""
COMMANDTIMEOUT="600"
PAGEORIENTATION="LANDSCAPE"
SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">
 
  <NAME>Rekapitulacija prometa po dokumentima </NAME>
  <CAPTION>Rekapitulacija prometa po dokumentima </CAPTION>
 
  <KOMENTAR> </KOMENTAR>


<FILTERFORM 		
	FILLEXPLORER="TRUE" 
	WIDTH="9000" 
	ONSUBMIT="spMPRekapDokAgronomNG @action=1, @operateriid = @@operateriid," 
	ONLOAD="select @@trgovinaid as trgovinaid, @@datod as datod, @@datdo as datdo" 
	HEIGHT="4500" 
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION="" 
	CHILDFORM=""> 
		

	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid"/>
	<INPUT TYPE="date" NAME="datod" CAPTION="Datum od" WIDTH="1500" HEIGHT="320" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datdo" CAPTION="Datum do" WIDTH="1500" HEIGHT="320"  CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta dokumenta " WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spmpDajVrstadok"/>
	<INPUT TYPE="combo" NAME="combo1" CAPTION="Vrsta robe " WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
		   SQL="select 1 as id, ' Vlastita roba' as naziv union all select 0, 'Trgovačka roba'"/>
	<INPUT TYPE="search" NAME="klmasterrobaid" CAPTION="Klasa:" WIDTH="5500" HEIGHT="320" 
		   SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'" BACKCOLOR="LIGHTYELLOW"/>
	<INPUT TYPE="check"	NAME="podklase" CAPTION="pokaži i sve podklase" />

</FILTERFORM>


</PROJECT> 