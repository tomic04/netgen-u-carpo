<PROJECT  ONLOAD=":MAINFORM" GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" DETAILDBLCLICK=":UPDATE" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE">
