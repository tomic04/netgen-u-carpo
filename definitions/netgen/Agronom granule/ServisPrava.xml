<INSERT NAME="INSERT" HEIGHT="2304" WIDTH="5976" CAPTION="Dodaj operatera" ONLOAD="select @@master as servisid" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3" ONLOADED="if (select count(o.operateriid) from ssoperateri o where o.operateriid not in (select operateriid from servisprava where servisid=@@servisid))=0 begin
	select &apos;disable&apos; as operateriid
end">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="14" LEFT="72" HEIGHT="1282" WIDTH="5616" TEXT="FrameNG0"/>
	<INPUT TYPE="combo" NAME="servisid" TOP="360" LEFT="1598" HEIGHT="302" WIDTH="3600" SQL="select servisid, rtrim(naziv) from servis order by naziv" ALLOWEMPTY="FALSE" CAPTION="servisid" ENABLED="FALSE" ONLOSTFOCUS="select &apos;refresh&apos; as operateriid"/>
	<INPUT TYPE="label" NAME="Label13" TOP="403" LEFT="216" HEIGHT="288" WIDTH="2160" CAPTION="Servis" TEXT="Label13"/>
	<INPUT TYPE="combo" NAME="operateriid" TOP="720" LEFT="1598" HEIGHT="302" WIDTH="3600" SQL="select o.operateriid, rtrim(o.naziv) from ssoperateri o where o.operateriid not in (select operateriid from servisprava where servisid=@@servisid) order by o.naziv" ALLOWEMPTY="FALSE" CAPTION="operateriid"/>
	<INPUT TYPE="label" NAME="Label14" TOP="763" LEFT="216" HEIGHT="288" WIDTH="2160" CAPTION="Operater" TEXT="Label14"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="1368" LEFT="144" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Dodaj" ENABLED="TRUE" ONCLICK="if not exists(select * from ssoperateri o where o.operateriid not in (select operateriid from servisprava where servisid=@@servisid)) raiserror (&apos;Svi operateri imaju dodijeljena prava!&apos;,16,1)
else exec spServisPravaAzurNG @action=0,++#select &apos;refresh&apos; as operateriid#OKStay"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="1368" LEFT="1296" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

</INSERT>

<UPDATE NAME="UPDATE" HEIGHT="2333" WIDTH="5976" CAPTION="Izmjeni operatera" ONLOAD="if coalesce(@@detail,0)=0 raiserror (&apos;Operater mora biti zadan!&apos;,16,1) else exec spServisPravaQueryNG @action=4, @id=@@detail" ONLOAD2="select @@operaterid as operateriid" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="14" LEFT="58" HEIGHT="1282" WIDTH="5616" TEXT="FrameNG0"/>
	<INPUT TYPE="combo" NAME="servisid" TOP="360" LEFT="1598" HEIGHT="302" WIDTH="3600" SQL="select servisid, rtrim(naziv) from servis order by naziv" ALLOWEMPTY="FALSE" CAPTION="servisid" ENABLED="FALSE"/>
	<INPUT TYPE="label" NAME="Label13" TOP="403" LEFT="216" HEIGHT="288" WIDTH="2160" CAPTION="Servis" TEXT="Label13"/>
	<INPUT TYPE="combo" NAME="operateriid" TOP="720" LEFT="1598" HEIGHT="302" WIDTH="3600" SQL="select o.operateriid, rtrim(o.naziv) from ssoperateri o where o.operateriid not in (select operateriid from servisprava where servisid=@@servisid) or o.operateriid=(select operateriid from servisprava where servispravaid=@@servispravaid) order by o.naziv" ALLOWEMPTY="FALSE" CAPTION="operateriid"/>
	<INPUT TYPE="label" NAME="Label14" TOP="763" LEFT="216" HEIGHT="288" WIDTH="2160" CAPTION="Operater" TEXT="Label14"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="1368" LEFT="144" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Spremi" ENABLED="TRUE" ONCLICK="spServisPravaAzurNG @action=1, @id=@@detail,++#OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="1368" LEFT="1296" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

</UPDATE>

<DELETE NAME="DELETE" HEIGHT="1800" WIDTH="7416" CAPTION="Brisanje operatera" ONLOAD="if coalesce(@@detail,0)=0 raiserror (&apos;Operater mora biti zadan!&apos;,16,1) else select s.naziv as nazivser, o.naziv as nazivop from servisprava sp inner join servis s on sp.servisid=s.servisid inner join ssoperateri o on sp.operateriid=o.operateriid where servispravaid=@@detail" ONLOAD2="select @@id as servispravaid, @@servispravaid as servispravaid">
	<INPUT TYPE="frame" NAME="FrameNG3" TOP="29" LEFT="58" HEIGHT="792" WIDTH="7056" TEXT="FrameNG3"/>
	<INPUT TYPE="label" NAME="Label19" TOP="360" LEFT="216" HEIGHT="302" WIDTH="6696" CAPTION="Je ste li sigurni da želite obrisati prava za operatera @@nazivop za servis @@nazivser ?" MULTILINE="TRUE"/>
	<INPUT TYPE="button" NAME="button1" TOP="864" LEFT="158" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG6" CAPTION="Obriši" ONCLICK="spServisPravaAzurNG @action=2, @id=@@detail#OK"/>
	<INPUT TYPE="button" NAME="button2" TOP="864" LEFT="1310" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG7" CAPTION="Odustani" ONCLICK="CLOSE"/>
	<INPUT TYPE="text" NAME="nazivser" TOP="907" LEFT="5314" HEIGHT="288" WIDTH="850" VISIBLE="FALSE" CAPTION="_nazivser"/>
	<INPUT TYPE="text" NAME="nazivop" TOP="907" LEFT="6192" HEIGHT="288" WIDTH="806" VISIBLE="FALSE" CAPTION="_nazivop"/>

</DELETE>

<FILTER NAME="FILTER" HEIGHT="2650" WIDTH="5659" CAPTION="FILTER" ONSUBMIT="spServisPravaQueryNG @action=3, @servisid=@@node" FILLEXPLORER="TRUE">

</FILTER>

<REFRESHTREEFORM NAME="REFRESHTREEFORM" HEIGHT="1872" WIDTH="4954" CAPTION="REFRESHTREEFORM" FILLEXPLORER="true">

</REFRESHTREEFORM>

<MAINFORM NAME="MAINFORM" HEIGHT="10008" WIDTH="11477" CAPTION="Dodavanje operatera servisu" MAXIMIZEBOX="TRUE" WINDOWSTATE="2">
	<INPUT TYPE="grid" NAME="master" TOP="86" LEFT="72" HEIGHT="3715" WIDTH="11203" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" SQL="spServisPravaQueryNG @action=2" ONCLICK="select &apos;refresh&apos; as detail" ANCHOR="13"/>
	<INPUT TYPE="grid" NAME="detail" TOP="3888" LEFT="72" HEIGHT="5141" WIDTH="11203" REFRESHAFTERCHILD="TRUE" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" SQL="spServisPravaQueryNG @action=3, @servisid=@@master" ANCHOR="15"/>
	<INPUT TYPE="button" NAME="ButtonNG23" TOP="9101" LEFT="72" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG23" CAPTION="Dodaj" ONCLICK=":INSERT" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="ButtonNG27" TOP="9101" LEFT="3931" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG27" CAPTION="Završi" ONCLICK="CLOSE" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="ButtonNG24" TOP="9101" LEFT="1282" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG24" CAPTION="Izmjeni" ONCLICK=":UPDATE" ANCHOR="6"/>
	<INPUT TYPE="button" NAME="ButtonNG26" TOP="9101" LEFT="2491" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG26" CAPTION="Obriši" ONCLICK=":DELETE" ANCHOR="6"/>

</MAINFORM>
</PROJECT>