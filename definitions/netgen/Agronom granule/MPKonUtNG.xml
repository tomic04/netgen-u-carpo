				HEIGHT="320" 
				CAPTION="Samo računi bez utrška"/>
  </FORM1>

  <DONESIUTRZAK
		NAME="PONOVI" HEIGHT="3197" WIDTH="6501" TEXT=""
		REFRESHAFTERCHILD="TRUE" CAPTION="Napravi prijenos utrška ?" BORDERSTYLE="3" ONSUBMIT=""
		ONLOAD="select g.trgovinaid, g.mpkaseid, k.kasa , g.datumdok from maloprodajagla g inner join mpkase k on g.mpkaseid = k.mpkaseid where maloprodajaglaid = @@id"
		CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		BOLD="TRUE" CHILDFORM="">

    <INPUT TYPE="date"
				NAME="datumdok"
				CAPTION="Datum "
        ENABLED="FALSE"
        STYLE="1"
				HEIGHT="320"
				WIDTH="1500"
				TABINDEX="4"
				CHECKBOX="FALSE"/>


    <INPUT TYPE="combo"
				NAME="trgovinaid"
				CAPTION="Trgovina"
				WIDTH="4000"
				HEIGHT="320"
        STYLE="1"
        TABINDEX="0"
        ENABLED="FALSE"
				ALLOWEMPTY="false"
			    ONLOSTFOCUS="select 'refresh' as kasa"
			    ONCLICK="select 'refresh' as kasa"
				SQL="spmpdajTrgovina @operateriid = @@operateriid "/>
    
		<INPUT TYPE="combo"
				NAME="kasa"
				CAPTION="Kasa"
				WIDTH="700"
				HEIGHT="320"
				TABINDEX="0"
               STYLE="1"
           ENABLED="FALSE"
				ALLOWEMPTY="false"
				SQL="select kasa from mpkase where trgovinaid = @@trgovinaid order by kasa"/>

    <INPUT TYPE="button" NAME="ok"     CAPTION="Ponovi"  TOP="2000" LEFT="456" TABINDEX="2" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpdonosSaBlagajne @action = 1 , @kasa =  '@@kasa' ,@datumdok = @@datum 
         #OK"  HOTKEY="" />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="1756" TABINDEX="1" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </DONESIUTRZAK>

  <PONOVI 
		NAME="PONOVI" HEIGHT="3197" WIDTH="5501" TEXT=""
		REFRESHAFTERCHILD="TRUE" CAPTION="Ponoviti prijenos utrška ?" BORDERSTYLE="3" ONSUBMIT=""
		ONLOAD="" CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		BOLD="TRUE" CHILDFORM="">

		<INPUT TYPE="date" 
				NAME="datumod" 
				CAPTION="Datum od" 
				VALUE="DATE2" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="4" 
				CHECKBOX="FALSE"/>

		<INPUT TYPE="date" 
				NAME="datumdo" 
				CAPTION="Datum do" 
				VALUE="DATE" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="5" 
				CHECKBOX="FALSE"/>

		<INPUT TYPE="combo" 
				NAME="kasa" 
				CAPTION="Kasa" 
				WIDTH="2000" 
				HEIGHT="320" 
				TABINDEX="0" 
				ALLOWEMPTY="false" 
				SQL="select kasa from mpkase order by kasa"/>
				
		<INPUT TYPE="button" NAME="ok"     CAPTION="Ponovi"  TOP="2000" LEFT="456" TABINDEX="2" WIDTH="1106" HEIGHT="322" ONCLICK="#close#spMPInsertRacunaJob @datumod = @@datumod, @datumdo =  @@datumdo , @kasa = @@kasa#exec spRaiserror 69001, 'Ponovljeni prijenos utrška - OK !'"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="1756" TABINDEX="1" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
				
  </PONOVI>


