		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
		<INPUT TYPE="combo" 
			    NAME="trgovinaid" 
			    CAPTION="Trgovina" 
			    WIDTH="5500" 
			    HEIGHT="320" 
			    TABINDEX="0" 
			    ALLOWEMPTY="true" 
			    SQL="spmpdajtrgovinang @operateriid = @@operateriid "/>

		<INPUT TYPE="date" 
				NAME="datumod" 
				CAPTION="Datum od" 
				VALUE="DATE2" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="4" 
				CHECKBOX="FALSE"/>

		<INPUT TYPE="date" 
				NAME="datumdo" 
				CAPTION="Datum do" 
				VALUE="DATE" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="5" 
				CHECKBOX="FALSE"/>
										
