		<INPUT TYPE="button" NAME="ok" CAPTION="Stavke&gt;&gt;&gt;" TOP="4000" LEFT="1196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spSTLista @action = 2, @operateriid = @@operateriid, @status = 1, @broj = '@@broj', @naziv = '@@naziv',
