		WIDTH= "11000" 
		FILLEXPLORER="" 
		FOCUS="stgrloid" 
		ONLOAD2="select sum( kg) as   ukupnokg , count(*) as ukupnokom from stlistadet where stlistaglaid = @@id"
		ONLOAD="if (select status from stlistagla  where stlistaglaid = @@ID ) > 1 begin 
				exec spRaiserror 69001,  &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spRaiserror 69001,  &apos;Niste odabrali dokument !&apos;
				end 
