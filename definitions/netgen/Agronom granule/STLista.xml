<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spSTLista @action = 0, @operateriid = @@operateriid, @node='proslimj'" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spSTLista @action = 0, @operateriid = @@operateriid, @node='@@node'" />




<FILTERFORM NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710"
			 CAPTION="Upišite uvjete prikaza "
			 ONSUBMIT="spSTLista @action = 0,  @operateriid= @@operateriid, "
			 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@farmeid as farmeid,@@skladisteid as skladisteid"
			 FILLEXPLORER="TRUE"
			 NEXTFORM=""
			 CMD1CAPTION="Pokaži"
			 CMD2CAPTION="Odustani"
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
		<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""
			   SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" />
		<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="true" CAPTION="Status" 
			   SQL="select 1 as status,&apos;Otvoren&apos; as naziv union all select 2 as status,&apos;Zaključen&apos; as naziv" />
		<INPUT TYPE="text"	 NAME="trazibroj"  ALLOWEMPTY="TRUE" CAPTION="Broj liste" ONLOSTFOCUS=""/>
</FILTERFORM>
	

