<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTERFORM"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FILTERFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION=""  
		CMD8CAPTION=""  
		PAGEHEADERCENTER="Pregled PS robe po trgovinama"
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE" 
    POPUPMASTER=""
     PAGEHEADERLEFT=""
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 
  <NAME>Pregled PS trgovina </NAME>
  <CAPTION>Pregled PS trgovina  </CAPTION>

	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="2254"
		WIDTH="7710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregPS @action = 1, "
		ONLOAD="select @@datumdok as datumdok, @@trgovinaid as trgovinaid, dbo.fnTkoSmoMi() as tkosmomi "
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina " ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid " />
		

	</FILTERFORM>


	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Krtica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMPStanjeKarticaNG @action = 1, @robaid= @@robaid, @operateriid = @@operateriid , @totalgen=1, @trgovinaid =@@trgovinaid , @datod = @@datumod, @datdo = @@datumdo "/>
	</KARTICA>

</PROJECT>
