<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
ONLOAD=":FILTERFORM"  		
REPORT="" 	
CMD1CAPTION="Parametri:FILTERFORM" 
CMD2CAPTION="" 
CMD3CAPTION="Kartica:KARTICA" 
CMD4CAPTION=""
CMD5CAPTION="" 
CMD6CAPTION=""  
CMD7CAPTION="Lista"  
CMD8CAPTION=""  
PAGEHEADERCENTER="Pregled prometa robe po dokumentima @@NoviRed Od @@datumod do @@datumdo"
MASTERDBLCLICK=""
CHECKBOXVISIBLE="FALSE" 
COMMANDTIMEOUT="300"
POPUPMASTER=""
PAGEHEADERLEFT=""
PAGEHEADERRIGHT="@@tkosmomi"
SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 
  <NAME>Pregled prometa robe po dokumentima </NAME>
  <CAPTION>Pregled prometa robe po dokumentima </CAPTION>

	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="5254"
		WIDTH="7710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregArtng @operateriid= @@operateriid, "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstapromid as vrstapromid , @@vrstadokid as vrstadokid, char(13)+char(10) as NoviRed, dbo.fnTkoSmoMi() as tkosmomi "
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstapromid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
		
    <INPUT TYPE="search" NAME="klmasterrobaid" CAPTION="Klasa robe:" SQL="spMPDajKlase @trazi = '@@searchboxklmasterrobaid'" />
		
    <INPUT TYPE="checkbox" NAME="podklase" CAPTION="i ispod nje" />
		<INPUT TYPE="combo" NAME="klklrobaid"  WIDTH="3500" 
			   SQL="select klklrobaid, naziv as naziv from KlklRoba " ALLOWEMPTY="TRUE" ONCLICK="select 'refresh' as dodatnaklasaid" CAPTION="Vrsta dodatna klasa robe:"/>
		<INPUT TYPE="combo" NAME="dodatnaklasaid"  WIDTH="5500"
			   SQL="select klrobaid, naziv as naziv from KlRoba where klklrobaid = @@klklrobaid order by naziv" ALLOWEMPTY="TRUE" CAPTION="Dodatna Klasa robe:"/>

	</FILTERFORM>


	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Krtica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMPStanjeKarticaNG @action = 1, @robaid= @@robaid, @operateriid = @@operateriid , @totalgen=1, @trgovinaid =@@trgovinaid , @datod = @@datumod, @datdo = @@datumdo "/>
	</KARTICA>

</PROJECT>
