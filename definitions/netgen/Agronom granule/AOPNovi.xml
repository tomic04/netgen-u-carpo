<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD="spKntAOPOBRASCIQuery @action='master_grid',@id='@@node'"
   MASTERDBLCLICK="UPDATEDETFORM"
   POPUPMASTER="Ažuriraj konta::INSERTKONTOFORM~REFRESHMASTERGRID#Boja pozadine:select distinct bojapozadine as setcustomcolorsforcolorpicker from KntAopObrazacDet where bojapozadine is not null~select coalesce(bojapozadine,'white') as setcolorforcolorpicker from KntAopObrazacDet where KntAopObrazacDetId=@@id~COLORPICKER(update KntAopObrazacDet set BojaPozadine='@@selectedcolor' where KntAopObrazacDetId=@@id)~REFRESHMASTERGRID#Boja slova:select distinct bojaslova as setcustomcolorsforcolorpicker from KntAopObrazacDet where bojaslova is not null~select coalesce(bojaslova,'black') as setcolorforcolorpicker from KntAopObrazacDet where KntAopObrazacDetId=@@id~COLORPICKER(update KntAopObrazacDet set BojaSlova='@@selectedcolor' where KntAopObrazacDetId=@@id)~REFRESHMASTERGRID"
   DETAILGRID="spKntAOPOBRASCIQuery @action='det_grid',@Id=@@id"
   TREE="spKntAOPOBRASCITreeAzur @action='tree':GODINA_FORM"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   BUTTONS="Unesi:INSERTDETFORM#Ispravi:UPDATEDETFORM#Obriši:DELETEDETFORM#Ažuriraj konta:INSERTKONTOFORM#AOPObrasci:TREEFORM#Umetni:UMETNIFORM" 
   CMD6CAPTION=""
   SETDEFAULTS=""	 
>
 
 <NAME>AOP</NAME>
 <CAPTION>AOP</CAPTION>

 <GODINA_FORM  FILLEXPLORER="TRUE" ONLOAD="" ONSUBMIT="spKntAOPOBRASCIQuery @action='master_grid',@id='@@node'" />



  <UMETNIFORM HEIGHT="2700" WIDTH="6500"  CAPTION="Umetni ?"
               ONLOAD="select '@@AOP' as aop,@@KntAOPObrazacGlaId as KntAOPObrazacGlaId,naziv as lblnaziv from kntaopobrazacgla where KntAOPObrazacGlaId=@@KntAOPObrazacGlaId" >

    <INPUT TYPE="label" NAME="lblnaziv" TOP="430" LEFT="2800" WIDTH="1400" CAPTION=""/>
    
    <INPUT TYPE="text" NAME="KntAOPObrazacGlaId" TOP="400" LEFT="1800" WIDTH="1000" CAPTION="AOP obrazac*" ENABLED="false" />

    <INPUT TYPE="text" NAME="AOP" TOP="800" LEFT="1800" WIDTH="1000" CAPTION="AOP od kojeg krećemo*" ENABLED="false" />
    
    <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="1200" LEFT="400" WIDTH="1000" CAPTION="Umetni"
         ONCLICK="spKntAOPUmetni @action='umetni',@KntAOPObrazacGlaId=@@KntAOPObrazacGlaId,@aopodkojegkrecemo='@@AOP'#OK" TABINDEX="0" />
    
    <INPUT TYPE="button" NAME="cancel" TOP="1200" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close" TABINDEX="1" />
  </UMETNIFORM>

  

  <INSERTDETFORM HEIGHT="3800" WIDTH="9000" CAPTION="Dodaj" ONLOAD="" >

      <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2500" WIDTH="8700" TEXT="FrameNG1" CAPTION="" />
	  
	    <INPUT TYPE="label"   NAME="lblrednibroj"   CAPTION="Redni broj:" TOP="300" LEFT ="200" />
      <INPUT TYPE="text"    NAME="rednibroj"   CAPTION="Redni broj" TOP="300" LEFT ="1300" WIDTH="1000" MAXLENGTH="10" />
	  
      <INPUT TYPE="label"   NAME="lblaop"   CAPTION="AOP:" TOP="750" LEFT ="200" />
      <INPUT TYPE="text"    NAME="aop"   CAPTION="AOP" TOP="750" LEFT ="1300" WIDTH="1000" MAXLENGTH="5"/>
	  
	  <INPUT TYPE="label" NAME="lblaopformula" TOP="1200" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="AOP formula:"/>
	  <INPUT TYPE="text" NAME="aformula" TOP="1200" LEFT="1300" HEIGHT="288" WIDTH="4000" CAPTION="AOP formula" ONCLICK=""/>
	  
	  <INPUT TYPE="label" NAME="lbln" TOP="1650" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Naziv:"/>
	  <INPUT TYPE="text" NAME="naziv" TOP="1650" LEFT="1300" HEIGHT="288" WIDTH="7000" CAPTION="Naziv" ONCLICK=""/>
	  
	  <INPUT TYPE="label"   NAME="lblnivo"   CAPTION="Nivo:" TOP="2050" LEFT ="200" />
      <INPUT TYPE="number"    NAME="nivo"   CAPTION="Nivo" TOP="2050" LEFT ="1300" WIDTH="1000" MAXLENGTH="1" DECIMALS="0"/>

      <INPUT TYPE="button"  NAME="ok" CAPTION="Spremi" TOP="2850" LEFT ="200" WIDTH="1000" 
	         ONCLICK="spKntAOPOBRASCIAzur @action='det_unesi',@rednibroj='@@rednibroj',@aop='@@aop',@aopformula='@@aformula'
			         ,@naziv='@@naziv',@nivo=@@nivo,@KntAOPObrazacGlaId='@@node'
			         #OK"/>
					  
      <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="2850" LEFT ="1300" WIDTH="1000" ONCLICK="close" />
	  
  </INSERTDETFORM>

  <UPDATEDETFORM HEIGHT="3800" WIDTH="9000"  CAPTION="Izmjeni" 
                  ONLOAD="select rednibroj,aop,aopformula as aformula,naziv,nivo from KntAOPObrazacDet where KntAOPObrazacDetId=@@id" >
				  		  
	  <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2500" WIDTH="8700" TEXT="FrameNG1" CAPTION=""/>
	  
	  <INPUT TYPE="label"   NAME="lblrednibroj"   CAPTION="Redni broj:" TOP="300" LEFT ="200" />
    <INPUT TYPE="text"    NAME="rednibroj"   CAPTION="Redni broj" TOP="300" LEFT ="1300" WIDTH="1000" MAXLENGTH="10"/>
	  
    <INPUT TYPE="label"   NAME="lblaop"   CAPTION="AOP:" TOP="750" LEFT ="200" />
    <INPUT TYPE="text"    NAME="aop"   CAPTION="AOP" TOP="750" LEFT ="1300" WIDTH="1000" MAXLENGTH="5"/>
	  
	  <INPUT TYPE="label" NAME="lblaopformula" TOP="1200" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="AOP formula:"/>
	  <INPUT TYPE="text" NAME="aformula" TOP="1200" LEFT="1300" HEIGHT="288" WIDTH="4000" CAPTION="AOP formula" ONCLICK=""/>
	  
	  <INPUT TYPE="label" NAME="lbln" TOP="1650" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Naziv:"/>
	  <INPUT TYPE="text" NAME="naziv" TOP="1650" LEFT="1300" HEIGHT="288" WIDTH="7000" CAPTION="Naziv" ONCLICK=""/>
	  
	  <INPUT TYPE="label"   NAME="lblnivo"   CAPTION="Nivo:" TOP="2050" LEFT ="200" />
    <INPUT TYPE="number"    NAME="nivo"   CAPTION="Nivo" TOP="2050" LEFT ="1300" WIDTH="1000" MAXLENGTH="1" DECIMALS="0"/>

    <INPUT TYPE="button"  NAME="ok"      CAPTION="Spremi"  TOP="2850" LEFT ="200" WIDTH="1000" 
	         ONCLICK="spKntAOPOBRASCIAzur @action='det_izmjeni',@rednibroj='@@rednibroj',@aop='@@aop',@aopformula='@@aformula'
			         ,@naziv='@@naziv',@nivo=@@nivo,@Id=@@id
                     #OK"/>
					  
    <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="2850" LEFT ="1300" WIDTH="1000" ONCLICK="close"/>
 
 </UPDATEDETFORM>
 
 
   <DELETEDETFORM HEIGHT="1700" WIDTH="5500"  CAPTION="Obriši" 
                  ONLOAD="" >
				  
	 <INPUT TYPE="label" NAME="lbldatum" TOP="300" LEFT="400" WIDTH="400" CAPTION="Jeste li sigurni da želite obrisati odabrani obrazac ?"/>
     <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="400" WIDTH="1000" CAPTION="Obriši" 
	        ONCLICK="spKntAOPOBRASCIAzur @action='det_obrisi',@Id=@@id#OK" TABINDEX="0" />
     <INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close" TABINDEX="1" />
  </DELETEDETFORM>
  
  
 <INSERTKONTOFORM HEIGHT="10900" WIDTH="13800"  FILLEXPLORER="" CAPTION="Ažuriranje konta" ONLOAD="select '' as filter, 0 as prikazisvakonta">

   <INPUT TYPE="check" NAME="PrikaziSvaKonta" ONCLICK="select 'refresh' as kontagrid" TOP="250" LEFT="5300" HEIGHT="288" WIDTH="1900" CAPTION="Prikaži sva konta"  />
   <INPUT TYPE="label" NAME="lblfilter" TOP="250" LEFT="7300" HEIGHT="288" WIDTH="994" CAPTION="Filter:"/>
   <INPUT TYPE="text" NAME="filter" TOP="200" LEFT="8100" HEIGHT="288" WIDTH="4000" CAPTION="Filter" ONLOSTFOCUS="select 'refresh' as kontagrid"/>
   
   <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="200" LEFT ="12400" WIDTH="1000" ONCLICK="OK"/>
	
   <INPUT TYPE="grid"   NAME="aopkontagrid"  WIDTH="6200" HEIGHT="9500" LEFT="150" TOP="700" CHECKBOXVISIBLE="FALSE"
         EDITCOLUMNS="Predznak0800,BDSP0800"
		 ONCELLEDITED="spKntAOPOBRASCIAzur @action='updateaopkonta',@predznak='@@gridaopkontagridPredznak',@bdsp='@@gridaopkontagridBDSP',@Id=@@gridaopkontagridKntAopObrazacKontaId#select 'refresh' as aopkontagrid"
		 ONDBLCLICK="spKntAOPOBRASCIAzur @action='aop_obrisi',@id=@@gridaopkontagridKntAopObrazacKontaId#select 'refresh' as aopkontagrid,'refresh' as kontagrid"
         SQL="spKntAOPOBRASCIQuery @action='aopkonta',@Id=@@id"/>
		 
   <INPUT TYPE="grid"   NAME="kontagrid"  WIDTH="6200" HEIGHT="9500" LEFT="7300" TOP="700" CHECKBOXVISIBLE="FALSE"
         EDITCOLUMNS=""
		 ONDBLCLICK="spKntAOPOBRASCIAzur @action='aop_unesi',@id=@@id,@kntplanaid=@@gridkontagridKntPlanAid#select 'refresh' as aopkontagrid,'refresh' as kontagrid"
         SQL="spKntAOPOBRASCIQuery @action='svakonta',@str='@@filter',@Id=@@id, @PrikaziSvaKonta=@@prikazisvakonta"/>
		 
   <INPUT TYPE="button" NAME="b1" CAPTION="-&gt;"  TOP="4300" LEFT="6400" WIDTH="800" HEIGHT="322" 
          ONCLICK="FOREACHBLUEROW(aopkontagrid)#spKntAOPOBRASCIAzur @action='aop_obrisi',@id=@@gridaopkontagridKntAopObrazacKontaId#select 'refresh' as aopkontagrid,'refresh' as kontagrid"   HOTKEY="" />
				   
   <INPUT TYPE="button" NAME="b2" CAPTION="&lt;-"  TOP="5200" LEFT="6400" WIDTH="800" HEIGHT="322" 
          ONCLICK="FOREACHBLUEROW(kontagrid)#spKntAOPOBRASCIAzur @action='aop_unesi',@id=@@id,@kntplanaid=@@gridkontagridKntPlanAid
				   #select 'refresh' as aopkontagrid,'refresh' as kontagrid"  HOTKEY="" />				  
					     
 </INSERTKONTOFORM>	 
 
  <TREEFORM  HEIGHT="6998" WIDTH="6300"
         CAPTION="AOP Obrasci" 
         ONLOAD=""
		 FILLEXPLORER="ONLYTREE"
         MAXIMIZEBOX="TRUE" WINDOWSTATE=""
             VERSION="2"
         ONESCKEY="click(cmdGotovo)"
		 ONCLOSED="click(cmdGotovo)">

    <INPUT TYPE="group"  NAME="topgroupbox"    DOCK="2" CAPTION="" HEIGHT="700"   />
	
    <INPUT TYPE="tree"   NAME="leftgrid" DOCK="5" SQL="spKntAOPOBRASCITreeAzur @action='tree' :LIJEVIGRIDFORMA"  
         ONCLICK=""  CHECKBOXVISIBLE="FALSE" WIDTH="5600"  GROUPBYBOXVISIBLE="FALSE" HEIGHT="5500"
		 POPUP="Dodaj::INSERTTREEFORM~select 'refresh' as leftgrid#Izmjeni::UPDATETREEFORM~select 'refresh' as leftgrid#Obriši::DELETETREEFORM~select 'refresh' as leftgrid#Pregled operatera:OPFORM"/>
        	
	<INPUT TYPE="button" NAME="cmdDodaj" TOP="6000" LEFT="100" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Dodaj" ANCHOR="6"
			ONCLICK=":INSERTTREEFORM#select top 1 sortkey as sort from KntAOPObrazacGla order by KntAOPObrazacGlaId desc#select 'refresh' as leftgrid#select '@@sort' as findnode "/>
	<INPUT TYPE="button" NAME="cmdIzmjeni" TOP="6000" LEFT="1200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG45" CAPTION="Izmjeni" ANCHOR="6"
			ONCLICK=":UPDATETREEFORM#select sortkey as sort from KntAOPObrazacGla where KntAOPObrazacGlaId=@@leftgrid#select 'refresh' as leftgrid#select '@@sort' as findnode"/>
	<INPUT TYPE="button" NAME="cmdObrisi" TOP="6000" LEFT="2300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG46" CAPTION="Obriši" ANCHOR="6"
			ONCLICK=":DELETETREEFORM#select 'refresh' as leftgrid"/>

    <INPUT TYPE="button" NAME="cmdKopiraj" TOP="6000" LEFT="3400" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG46" CAPTION="Kopiraj" ANCHOR="6"
			ONCLICK=":KOPIRAJTREEFORM#select 'refresh' as leftgrid"/>
    
	<INPUT TYPE="button" NAME="cmdGotovo" TOP="6000" LEFT="4900" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG46" CAPTION="Gotovo" ANCHOR="6"
			ONCLICK="select sortkey as findnode from KntAOPObrazacGla where KntAOPObrazacGlaId=@@leftgrid#OK"/>	
			
    <INPUT TYPE="text" NAME="sort" CAPTION="" TOP="300" LEFT ="1000" WIDTH="4000" VISIBLE="FALSE"/>
	
</TREEFORM>

<INSERTTREEFORM HEIGHT="3200" WIDTH="5500" CAPTION="Dodaj" ONLOAD="" >

      <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2000" WIDTH="5200" TEXT="FrameNG1" CAPTION=""/>
	  
      <INPUT TYPE="label"   NAME="naziv"   CAPTION="Naziv:" TOP="300" LEFT ="200" />
      <INPUT TYPE="text"    NAME="naziv"   CAPTION="Naziv" TOP="300" LEFT ="1000" WIDTH="4000"/>
	  
	  <INPUT TYPE="label" NAME="lbltip" TOP="850" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Tip:"/>
	  <INPUT TYPE="text" NAME="tip" TOP="850" LEFT="1000" HEIGHT="288" WIDTH="800" CAPTION="Tip" ENABLED="TRUE" MAXLENGTH="1"/>
	  
	  <INPUT TYPE="label" NAME="lblmjekum" TOP="1450" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Mjesečni kumulativ:"/>
	  <INPUT TYPE="check" NAME="indmjekum" TOP="1400" LEFT="1700" HEIGHT="288" WIDTH="245" CAPTION="Mjesečni kumulativ" ONCLICK=""/>
	  
	  <INPUT TYPE="label" NAME="lblindorg" TOP="1450" LEFT="2700" HEIGHT="288" WIDTH="994" CAPTION="Org.jedinica:"/>
	  <INPUT TYPE="check" NAME="indorg" TOP="1400" LEFT="3800" HEIGHT="288" WIDTH="245" CAPTION="Org.jedinica" ONCLICK=""/>

      <INPUT TYPE="button"  NAME="ok" CAPTION="Spremi" TOP="2200" LEFT ="200" WIDTH="1000" 
	         ONCLICK="spKntAOPOBRASCITreeAzur @action='tree_unesi',@naziv='@@naziv',@KntAOPObrazacGlaId=@@leftgrid
			         ,@IndMjeKum=@@IndMjeKum,@IndOrg=@@IndOrg,@Tip='@@Tip'
					  #OK"/>
					  
      <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="2200" LEFT ="1300" WIDTH="1000" ONCLICK="close" />
	  
  </INSERTTREEFORM>

  <UPDATETREEFORM HEIGHT="3200" WIDTH="5500"  CAPTION="Izmjeni" 
                  ONLOAD="select naziv,indmjekum,indorg,tip from KntAOPObrazacGla where KntAOPObrazacGlaId=@@leftgrid" >
				  		  
	  <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2000" WIDTH="5200" TEXT="FrameNG1" CAPTION=""/>
	  
      <INPUT TYPE="label"   NAME="n"   CAPTION="Naziv:" TOP="300" LEFT ="200" />
      <INPUT TYPE="text"    NAME="naziv"   CAPTION="Naziv" TOP="300" LEFT ="1000" WIDTH="4000"/>
	  
	  <INPUT TYPE="label" NAME="lbltip" TOP="850" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Tip:"/>
	  <INPUT TYPE="text" NAME="tip" TOP="850" LEFT="1000" HEIGHT="288" WIDTH="800" CAPTION="Tip" ENABLED="TRUE" MAXLENGTH="1"/>
	  
	  <INPUT TYPE="label" NAME="lblmjekum" TOP="1450" LEFT="200" HEIGHT="288" WIDTH="994" CAPTION="Mjesečni kumulativ:"/>
	  <INPUT TYPE="check" NAME="indmjekum" TOP="1400" LEFT="1700" HEIGHT="288" WIDTH="245" CAPTION="Mjesečni kumulativ" ONCLICK=""/>
	  
	  <INPUT TYPE="label" NAME="lblindorg" TOP="1450" LEFT="2700" HEIGHT="288" WIDTH="994" CAPTION="Org.jedinica:"/>
	  <INPUT TYPE="check" NAME="indorg" TOP="1400" LEFT="3800" HEIGHT="288" WIDTH="245" CAPTION="Org.jedinica" ONCLICK=""/>

      <INPUT TYPE="button"  NAME="ok"      CAPTION="Spremi"  TOP="2200" LEFT ="200" WIDTH="1000" 
	         ONCLICK="spKntAOPOBRASCITreeAzur @action='tree_izmjeni',@naziv='@@naziv',@id=@@leftgrid,@IndMjeKum=@@IndMjeKum,@IndOrg=@@IndOrg,@Tip='@@Tip'
					  #OK"/>
					  
      <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="2200" LEFT ="1300" WIDTH="1000" ONCLICK="close"/>
 
 </UPDATETREEFORM>
   
   <DELETETREEFORM HEIGHT="1700" WIDTH="5500"  CAPTION="Obriši" 
                  ONLOAD="select @@leftgrid as leftgrid" >
	 <INPUT TYPE="label" NAME="lbldatum" TOP="300" LEFT="400" WIDTH="400" CAPTION="Jeste li sigurni da želite obrisati odabrani obrazac ?"/>
     <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="400" WIDTH="1000" CAPTION="Obriši" 
	        ONCLICK="spKntAOPOBRASCITreeAzur @action='tree_obrisi',@id=@@leftgrid#select 'refresh' as kategorijagrid#OK" TABINDEX="0" />
     <INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close" TABINDEX="1" />
  </DELETETREEFORM>


  
  
  <KOPIRAJTREEFORM HEIGHT="1700" WIDTH="5500"  CAPTION="Kopiraj"
                   ONLOAD="if (@@leftgrid is null) or (@@leftgrid=0) begin EXEC spRaiserror 69001, 'Odaberite AOP !' end"
                   ONLOADED="select @@leftgrid as leftgrid,
                            'Jeste li sigurni da želite kopirati AOP obrazac : ' + ltrim(rtrim(Naziv)) + ' ?' as lblPoruka 
                            , 'Copy of ' + ltrim(rtrim(Naziv)) as novinaziv
                            from KntAopObrazacGla 
                            where KntAOPObrazacGlaId=@@leftgrid" 
                   >
    <INPUT TYPE="label" NAME="lblPoruka" TOP="300" LEFT="400" WIDTH="400" CAPTION=""/>
    <INPUT TYPE="text" NAME="novinaziv"  VISIBLE="false" />
    <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="400" WIDTH="1000" CAPTION="Kopiraj"
         ONCLICK="spKntAOPOBRASCITreeAzur @action='tree_kopiraj',@id=@@leftgrid,@novinaziv='@@novinaziv'#select 'refresh' as kategorijagrid#OK" TABINDEX="0" />
    <INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close" TABINDEX="1" />
  </KOPIRAJTREEFORM>

  
  
  
  <OPFORM FILLEXPLORER="" WIDTH="6000" 
                         ONSUBMIT="" 
                         ONLOAD="select @@leftgrid as aopglaid" 
                         HEIGHT="10500" 
			             TOP="300" 
                         CAPTION="Pregled i ažuriranje operatera"  
                         BORDERSTYLE="3"                              								  
                                  NEXTFORM=""  
                                  CHILDFORM=""
								  REFRESHAFTERCHILD="TRUE">

				       	<INPUT TYPE="grid" 
									NAME="Operater" 
									REFRESHAFTERCHILD="TRUE" 
									CAPTION="operateri" 
									TOP="250" 
									LEFT="200"  
									WIDTH="5500" 
									HEIGHT="9200" 
									TABINDEX="0" 
									CHECKBOXVISIBLE="TRUE"
									EDITCOLUMNS=""
									ONCELLEDITED=""
				                    SQL="spKntAOPOBRASCIQuery @action='operateri_grid',@id=@@aopglaid" />
									
		<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="9600" LEFT="200" WIDTH="1100" CAPTION="Spremi" 
		       ONCLICK="spKntAOPOBRASCIQuery @action='operateri_delete',@id=@@aopglaid#FOREACHSELECTED(Operater)#spKntAOPOBRASCIQuery @action='operateri_insert',@id=@@aopglaid,@operateriid=@@gridoperateroperateriid#OK" />												  		
        <INPUT TYPE="button" NAME="cancel" TOP="9600" LEFT="1400" WIDTH="1100" CAPTION="Odustani" ONCLICK="close"/>									 
                     	
 
        <INPUT TYPE="text" NAME="aopglaid" TOP="850" LEFT="1000" HEIGHT="288" WIDTH="800" CAPTION="Tip" ENABLED="TRUE" MAXLENGTH="1" VISIBLE="FALSE"/>
   </OPFORM> 
 
</PROJECT>
