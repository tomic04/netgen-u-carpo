                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="3" 
                              		ALLOWEMPTY="true" 
                            		SQL="select kupstatusid,opis as Naziv from kupstatus order by korak asc"/> 																	
							
                      <KONTROLA TYPE="VB.Label" NAME="lblzaprimljen" TOP="1750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Zaprimljeno:"/>
