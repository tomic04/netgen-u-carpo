                            		LEFT="1700"  
                                    WIDTH="2500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="4" 
                              		ALLOWEMPTY="true" 
                            		SQL="select 0 as Daid,'Nezaprimljeni-0'as Naziv
					union all
					select 1 as Daid ,'Zaprimljeni - 1' as Naziv
					union all
					select 2 as Daid, 'Arhivirani - 2' as Naziv"/> 
                                     
                       

