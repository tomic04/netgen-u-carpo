	<ZAKLJUCI1 NAME="ZAKLJUCI" HEIGHT="2528" WIDTH="7046" TEXT=""
		 REFRESHAFTERCHILD="TRUE" 
		 CAPTION="Želite li Prebaciti utrške ?? " 
		  BORDERSTYLE="3" 
		  VERSION="1"
		  ONSUBMIT=""
		 ONLOAD="if @@maloprodajaglaid > 0 begin 
		 				exec spRaiserror 69001, &apos;Utržak je već prenesen . Ne može se više prenositi !&apos;
			end 
			else begin 
				select @@trgovinaid as trgovinaid, @@blagajna as blagajnaid , @@datum_prometa as datum , 
				'@@prodajnomjesto' as prodajnomjesto, @@xblagajna as xblagajna
		  end " CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="" CMD2CAPTION="" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" REPORT="" MASTERDBLCLICK=""
		>
	<INPUT TYPE="text" NAME="xblagajna" TOP="100" LEFT="1800"
		 HEIGHT="1786" WIDTH="1500" VISIBLE="TRUE" BOLD="TRUE"
		 CAPTION="Blagajna*" ENABLED="FALSE"/>
		<INPUT TYPE="date" NAME="Datum" TOP="500" LEFT="1800"
			 HEIGHT="1786" WIDTH="1500" VISIBLE="TRUE" BOLD="TRUE"
			 CAPTION="Datum*" ENABLED="FALSE"/>
		<INPUT TYPE="text" NAME="Prodajnomjesto" TOP="1000" LEFT="1800"
			 HEIGHT="1786" WIDTH="2500" VISIBLE="TRUE" BOLD="TRUE"
			 CAPTION="Prodajno mjesto*" ENABLED="FALSE"/>
		<INPUT TYPE="text" NAME="blagajnaid" TOP="100" LEFT="800"
		 HEIGHT="1786" WIDTH="1500" VISIBLE="FALSE" BOLD="TRUE"
		 CAPTION="" ENABLED="FALSE"/>
	<INPUT TYPE="number" NAME="trgovinaid" TOP="100" LEFT="800"
		 HEIGHT="1786" WIDTH="4701" VISIBLE="FALSE" BOLD="FALSE"
		 CAPTION="" ENABLED="TRUE" DECIMALS="0"/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Prebaci" TOP="1500" LEFT="196" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spmpPrijenosRemaris @action=5, @operateriid = @@operateriid, @racuni = @@racuni, @fakture = @@fakture,@blagajnaid = @@blagajnaid, @trgovinaid = @@trgovinaid , @datum = @@datum#Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	/>


</ZAKLJUCI1>
<ZAKLJUCI2 NAME="ZAKLJUCI" HEIGHT="4000" WIDTH="7046" TEXT=""
			 REFRESHAFTERCHILD="TRUE"
			 CAPTION="Želite li Prebaciti fakturu ?? "
			  BORDERSTYLE="3"
			  VERSION="3"
			  ONSUBMIT=""
			 ONLOADXX="If (select top 1 partneriid from partneri where poreznibroj = '@@oib') is null  begin exec spRaiserror 69001, &apos;Ne postoji partner u Jupiteru . Ne može se prenijeti faktura !&apos; end 
          else begin select @@trgovinaid as trgovinaid, @@blagajna as blagajnaid , @@datum_prometa as datum , @@id as id , 
			 '@@fakid' as broj, @@xblagajna as xblagajna, '@@prodajnomjesto' as prodajnomjesto, '@@kupac' as kupac end " 
			 ONLOAD="select @@trgovinaid as trgovinaid, @@blagajna as blagajnaid , @@datum_prometa as datum , @@id as id , 
			 '@@fakid' as broj, @@xblagajna as xblagajna, '@@prodajnomjesto' as prodajnomjesto, '@@kupac' as kupac" 
       ONLOADED=""     
           CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
			 CMD1CAPTION="" CMD2CAPTION="" CMD3CAPTION="" CMD4CAPTION=""
			 CMD5CAPTION="" CMD6CAPTION="" REPORT="" MASTERDBLCLICK=""
		>
	<INPUT TYPE="text" NAME="xblagajna" TOP="100" LEFT="1800"
		 HEIGHT="1786" WIDTH="1500" VISIBLE="TRUE" BOLD="TRUE"
		 CAPTION="Blagajna*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="blagajnaid" TOP="100" LEFT="1800"
		 HEIGHT="1786" WIDTH="1500" VISIBLE="FALSE" BOLD="TRUE"
		 CAPTION="" ENABLED="FALSE"/>
	<INPUT TYPE="date" NAME="Datum" TOP="500" LEFT="1800"
			 HEIGHT="1786" WIDTH="1500" VISIBLE="TRUE" BOLD="TRUE"
			 CAPTION="Datum*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="broj" TOP="1000" LEFT="1800"
		 HEIGHT="1786" WIDTH="1500" VISIBLE="TRUE" BOLD="TRUE"
		 CAPTION="Broj fakture*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="Prodajnomjesto" TOP="1500" LEFT="1800"
		 HEIGHT="1786" WIDTH="2500" VISIBLE="TRUE" BOLD="TRUE"
		 CAPTION="Prodajno mjesto*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="kupac" TOP="2000" LEFT="1800"
		 HEIGHT="1786" WIDTH="3000" VISIBLE="TRUE" BOLD="TRUE"
		 CAPTION="Kupac*" ENABLED="FALSE"/>

	<INPUT TYPE="number" NAME="trgovinaid" TOP="100" LEFT="800"
			 HEIGHT="1786" WIDTH="4701" VISIBLE="FALSE" BOLD="FALSE"
			 CAPTION="" ENABLED="TRUE" DECIMALS="0"/>

		<INPUT TYPE="button" NAME="ok" CAPTION="Prebaci" TOP="3000" LEFT="196" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpPrijenosRemaris @action=5, @operateriid = @@operateriid, @racuni = @@racuni, @fakture = @@fakture,@blagajnaid = @@blagajnaid, @trgovinaid = @@trgovinaid , @datum = @@datum, @id = @@id#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3000" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


		/>


</ZAKLJUCI2>

	<DONOS NAME="DONOS" HEIGHT="3506" WIDTH="6926" TEXT=""
		 REFRESHAFTERCHILD="" CAPTION="Donos podataka Iz remarisa" 
			BORDERSTYLE="3" 
	   ONSUBMIT="spMPPrijenosTerminalNG @action=1, @operateriid = @@operateriid, "
		 ONLOAD="select getdate() as datumod, 11 as trgovinaid, napomena = case when (select top 1 ptprijenosid from ptprijenos where trgovinaid = 11 and datum = '20081206' and ind = 1 and operateriid = 7) is not null then 'Postoji neproknjiženi prijenos! Želite li donijeti novi ? ' else '' end" 
			CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="" CMD2CAPTION="" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" CHILDFORM=""
	   >


	<INPUT TYPE="check" NAME="racun" TOP="500" LEFT="1152"
		 HEIGHT="302" WIDTH="1498" VISIBLE="TRUE" VALUE="DATE"
		 TABINDEX="2" CAPTION="Prijenos MP računa :*" ENABLED="TRUE" CHECKBOX="FALSE"
		/>
	<INPUT TYPE="check" NAME="fakture" TOP="1000" LEFT="1152"
		 HEIGHT="302" WIDTH="1498" VISIBLE="TRUE" VALUE="DATE"
		 TABINDEX="2" CAPTION="Prijenos Faktura :*" ENABLED="TRUE" CHECKBOX="FALSE"
		/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Donesi" TOP="2000" LEFT="196" WIDTH="1106" HEIGHT="322" 
