<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spMPAzurNCCjenik @action = 2,@robaid=@@id"
		 MASTERDBLCLICK=""
		 BUTTONS="Parametri:FILTERFORM#Kartica NC=0:KARTICA0#Ažuriraj:AZURNC" 
		 POPUPMASTER="" 
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT="">

	<NAME>Ažuriranje NC u MP cjenicima1</NAME>
	<CAPTION>Ažuriranje NC u MP cjenicima1</CAPTION>


	<AZURNC 
		FILLEXPLORER="" 
		WIDTH="6500" 
		ONSUBMIT=""
		ONLOAD="select '' as trazilica, null as klasaid, 0 as podklase" 		
		HEIGHT="8000" 
		CAPTION="Ažuriranje NC " 
		>


		<INPUT TYPE="grid" 
		NAME="azurNC" 
		TOP="700"
		LEFT="200"
		WIDTH="6500"
		HEIGHT="6000"
		CHECKBOXVISIBLE="FALSE" 
		TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
			EDITCOLUMNS="NC1200"
		ONCELLEDITED="spMPAzurNCCjenik @action = 3 , @cjenikid = @(azurNC..cjenikid), @nc =  @(azurNC..NC1200), @godina = @@godina " 
		GROUPBYBOXVISIBLE="FALSE"		
		CAPTION="_Zadnje primke dobavljača"
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="spMPAzurNCCjenik @action = 2,@robaid=@@id" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Spremi"  TOP="7000" LEFT="456" WIDTH="1106" HEIGHT="322" ONCLICK="Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7000" LEFT="2500" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</AZURNC>

	<KARTICA0 	FILLEXPLORER="TRUE" 
		   WIDTH="14000" 
		   ONSUBMIT="" 
		   ONLOAD="" 
		   HEIGHT="9500" 
		   CAPTION="Kartica robe"
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="" 
		   CMD3CAPTION="" 
		   CMD4CAPTION="" 
		   CMD5CAPTION="" 
		   CMD6CAPTION="" 
		
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="kartica0" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="13500" HEIGHT="8000" TABINDEX="2" CHECKBOXVISIBLE="FALSE"
	 TOTALROW="FALSE" DETTOTALROWVISIBLE="FALSE" GROUPBYBOXVISIBLE="FALSE"
					 SQL="spMPAzurNCCjenik @action = 4, @robaid = @@id, @godina = @@godina " />

		<INPUT TYPE="button" NAME="cancel" TABINDEX="16" CAPTION="Kraj" TOP="8500" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

	</KARTICA0>


	<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="2254" 
	WIDTH="7710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPAzurNCCjenik @action = 1,  "
	ONLOAD="select year(getdate()) as godina" 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	>
	<INPUT TYPE="text" NAME="godina" CAPTION="Godina:" DECIMALS="0" WIDTH="1000"/>
	<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina " ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
</FILTERFORM>


	
</PROJECT>