<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Uvjeti:FILTERFORM" 
		 CMD2CAPTION="Unos:INSERT_FORM#REFRESHMASTERGRID"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spSTTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spSTTreeNG @action=2:FILTERODDO_FORM#spSTTreeNG @action=3:FILTERODDO_FORM#spSTTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Evidencija prirasta"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">

	<MASTERCOLUMNS>
		<COLUMN INDEX="7" NAME="" WIDTH="1200" CAPTION="" FORMAT="#,##0.000" VISIBLE="" AGREGATEFUNCTION="2" />
		
	</MASTERCOLUMNS>
	
	<NAME>Evidencija prirasta</NAME>
	<CAPTION>Evidencija prirasta</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>

	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid,@node='danas'" />
	<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid,@node='jucer'" />
	<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid,@node='ovajmj'" />
	<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid,@node='proslimj'" />
	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid,@node='@@node'" />


	<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTPrirast @action = 1, @operateriid= @@operateriid " 
		 FILLEXPLORER="TRUE" >
    </POKAZI_FORM>

	
	<FILTERFORM NAME="FILTERFORM" HEIGHT="3000" WIDTH="6710"
		 CAPTION="Upišite uvjete prikaza "
		 ONSUBMIT="spstPrirast @action = 1,  @operateriid= @@operateriid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid"
		 FILLEXPLORER="TRUE"
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani"
		 >
		
		 <INPUT TYPE="date" NAME="datumod" CAPTION="Od datuma" DEFAULT="getdate()"/>
		 <INPUT TYPE="date" NAME="datumdo" CAPTION="Do datuma" DEFAULT="getdate()"/>
		 <INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""/>
	</FILTERFORM>


	<INSERT_FORM
		WIDTH="9600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="select @@datumdok as datumdok, @@stfarmeid as stfarmeid"
		HEIGHT="3500"
		FILLEXPLORER=""
		REFRESHAFTERCHILD=""
		CAPTION="Unos prirasta "
		FOCUS="datum" 
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke:" TOP="50" LEFT="56" WIDTH="9300" HEIGHT="3200"   />
		<INPUT TYPE="date" NAME="datum" TOP="200" CAPTION="Datum*" TABINDEX="1" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" TABINDEX="2" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as unosv"/>
		<INPUT TYPE="combo" NAME="LNSTKategorijaSkupinaId" 	  CAPTION="Kategorija grla*" TOP="1000"  WIDTH="3596" ENABLED="TRUE" HEIGHT="280" DECIMALS="" TABINDEX="3" SQL="spstdajKategorije @action  = 3"  />
		<INPUT TYPE="combo" NAME="STSpolTeletaid" SQL="select STSpolTeletaid, opis as naziv from STSpolTeleta" ALLOWEMPTY="FALSE" TOP="1400"  TABINDEX="4" CAPTION="Spol*"/>
		<INPUT TYPE="number"   NAME="prirast"      CAPTION="Planirani prirast u KG*" TABINDEX="5" TOP="1800"   DECIMALS="3"  WIDTH="1000" ONLOSTFOCUS=""/>			
		
		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Spremi" TOP="2500" LEFT="2000"  TABINDEX="6" SQL="" 
			   ONCLICK="exec spSTPrirast @action = 2 ,@STSpolTeletaid = @@STSpolTeletaid, @LNSTKategorijaSkupinaId = @@LNSTKategorijaSkupinaId, @stfarmeid = @@stfarmeid, @prirast = @@prirast, @datum = @@datum, @operateriid = @@operateriid #OK" />
		<INPUT TYPE="button"   NAME="odustani"    CAPTION="Odustani" TOP="2500" LEFT="5000"  TABINDEX="7" SQL=""
			   ONCLICK="close" />

	</INSERT_FORM>

	

	<UPDATE_FORM
		WIDTH="7600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="select * from stprirast where stprirastid =@@id"
		HEIGHT="3500"
		FILLEXPLORER=""
		REFRESHAFTERCHILD=""
		CAPTION="Izmjena prirasta "
		FOCUS="datum"
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke:" TOP="50" LEFT="56" WIDTH="9300" HEIGHT="3200"   />
		<INPUT TYPE="date" NAME="datum" TOP="200" CAPTION="Datum*" TABINDEX="1" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" TABINDEX="2" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as unosv"/>
		<INPUT TYPE="combo" NAME="LNSTKategorijaSkupinaId" 	  CAPTION="Kategorija grla*" TOP="1000"  WIDTH="3596" ENABLED="TRUE" HEIGHT="280" DECIMALS="" TABINDEX="3" SQL="spstdajKategorije @action  = 3"  />
		<INPUT TYPE="combo" NAME="STSpolTeletaid" SQL="select STSpolTeletaid, opis as naziv from STSpolTeleta" ALLOWEMPTY="FALSE" TOP="1400"  TABINDEX="4" CAPTION="Spol*"/>
		<INPUT TYPE="number"   NAME="prirast"      CAPTION="Prirast u KG*" TABINDEX="5" TOP="1800"   DECIMALS="3"  WIDTH="1000" ONLOSTFOCUS=""/>

		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Spremi" TOP="2500" LEFT="2000"  TABINDEX="6" SQL=""
			   ONCLICK="exec spSTPrirast @action = 3 ,@id = @@id, @STSpolTeletaid = @@STSpolTeletaid, @LNSTKategorijaSkupinaId = @@LNSTKategorijaSkupinaId, @stfarmeid = @@stfarmeid, @prirast = @@prirast, @datum = @@datum, @operateriid = @@operateriid #OK" />
		<INPUT TYPE="button"   NAME="odustani"    CAPTION="Odustani" TOP="2500" LEFT="4000"  TABINDEX="7" SQL=""
			   ONCLICK="close" />




	</UPDATE_FORM>


	<DELETE_FORM
		WIDTH="9600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="exec spstvaganja @action = 5, @id=@@id"
		HEIGHT="10000"
		FILLEXPLORER=""
		REFRESHAFTERCHILD=""
		CAPTION="Brisanje prirasta "
		FOCUS="datum"
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke:" TOP="50" LEFT="56" WIDTH="9300" HEIGHT="3200"   />
		<INPUT TYPE="date" NAME="datum" TOP="200" CAPTION="Datum*" ENABLED="FALSE" TABINDEX="1" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" TABINDEX="2" ONCLICK="" ENABLED="FALSE" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as unosv"/>
		<INPUT TYPE="combo" NAME="LNSTKategorijaSkupinaId" 	  CAPTION="Kategorija grla*" TOP="1000"  WIDTH="3596" ENABLED="FALSE" HEIGHT="280" DECIMALS="" TABINDEX="3" SQL="spstdajKategorije @action  = 3"  />
		<INPUT TYPE="combo" NAME="STSpolTeletaid" SQL="select STSpolTeletaid, opis as naziv from STSpolTeleta" ENABLED="FALSE" ALLOWEMPTY="FALSE" TOP="1400"  TABINDEX="4" CAPTION="Spol*"/>
		<INPUT TYPE="number"   NAME="prirast"      CAPTION="Prirast u KG*" TABINDEX="5" TOP="1800"   DECIMALS="2"  WIDTH="1000" ENABLED="FALSE" ONLOSTFOCUS=""/>

		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Obriši" TOP="1800" LEFT="7800"  TABINDEX="6" SQL=""
			   ONCLICK="exec spstprirast @action = 4 , @id = @@id#OK" />

		<INPUT TYPE="grid"
					NAME="unosv"
					TOP="3500"
					LEFT="56"
					WIDTH="9300"
					HEIGHT="5000"
					CHECKBOXVISIBLE="TRUE"
		            POPUP=""
		            ONDBLCLICK=""
				    TOTALROWVISIBLE="FALSE"
					EDITCOLUMNS=""
					ONCELLEDITED=""
					GROUPBYBOXVISIBLE="FALSE"
					CAPTION="Evidencija prirasta"
					REFRESHAFTERCHILD="TRUE"
					VISIBLE="TRUE"
					SQL="spSTPrirast @action = 1,  @operateriid= @@operateriid,@node='danas', @stfarmeid = @@stfarmeid " />



		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DELETE_FORM>

	
</PROJECT>