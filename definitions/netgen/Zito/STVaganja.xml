<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Uvjeti:FILTERFORM" 
		 CMD2CAPTION="Unos:INSERT_FORM#REFRESHMASTERGRID"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spSTTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spSTTreeNG @action=2:FILTERODDO_FORM#spSTTreeNG @action=3:FILTERODDO_FORM#spSTTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Kontrolna vaganja grla"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Kontrolna vaganja grla </NAME>
	<CAPTION>Kontrolna vaganja grla </CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>

	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='danas'" />
	<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='jucer'" />
	<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='ovajmj'" />
	<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='proslimj'" />
	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='@@node'" />


	<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTVaganja @action = 1, @operateriid= @@operateriid " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

	<FILTERFORM NAME="FILTERFORM" HEIGHT="3000" WIDTH="6710"
		 CAPTION="Upišite uvjete prikaza "
		 ONSUBMIT="spstVaganja @action = 1,  @operateriid= @@operateriid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid"
		 FILLEXPLORER="TRUE"
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani"
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Od datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Do datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""/>
		<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 1, @stfarmeid = @@stfarmeid, @trazi = '@@searchboxprnradninalogid'"/>
	</FILTERFORM>


	<INSERT_FORM
		WIDTH="9600"
		NEXTFORM="INSERT_FORM"
		ONSUBMIT=""
		ONLOAD="select @@datumdok as datumdok, @@stfarmeid as stfarmeid, '@@napomena' as napomena"
		HEIGHT="10000"
			FILLEXPLORER=""
		REFRESHAFTERCHILD=""
		CAPTION="Unos vaganja "
		FOCUS="stfarmeid" 
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke :" TOP="50" LEFT="56" WIDTH="9300" HEIGHT="2500"   />
		<INPUT TYPE="date" NAME="datumdok" TOP="200" CAPTION="Datum vaganja*" TABINDEX="1" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" TABINDEX="2" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as unosv"/>
		<INPUT TYPE="text" NAME="napomena" TOP="1000" TABINDEX="-1" CAPTION="Napomena*" />

		<INPUT TYPE="search" NAME="stgrloid" 	  TABINDEX="3" CAPTION="Grlo*" TOP="1600" LEFT="1500" WIDTH="1296" HEIGHT="280" DECIMALS="4"
					SQL="spSTDajGrlo @trazi = '@@searchboxstgrloid', @stfarmeid = @@stfarmeid, @operateriid = @@operateriid, @sifradok = '502'"
					ONLOSTFOCUS="exec spSTKontrolaUpisaGrla @stgrloid = @@stgrloid , @stfarmeid = @@stfarmeid, @tov = 0  "/>
		<INPUT TYPE="date" NAME="datumrodjenja" 	  CAPTION="Datum rođenja*" TOP="1600" LEFT="4000" WIDTH="1296" ENABLED="FALSE" HEIGHT="280" DECIMALS="" SQL=""  />
		<INPUT TYPE="text" NAME="spolopis" 			CAPTION="Spol*" TOP="1600" LEFT="6500" WIDTH="600" ENABLED="FALSE" HEIGHT="280" DECIMALS="" SQL=""  />
		<INPUT TYPE="text" NAME="kategorija" 		CAPTION="Kategorija-Skupina*" TOP="2100" LEFT="1500" WIDTH="2596" ENABLED="FALSE" HEIGHT="280" DECIMALS="" SQL=""  />
		<INPUT TYPE="text" NAME="stkategorijaid" 	  CAPTION="" TOP="-	3600" LEFT="5700" WIDTH="2596" ENABLED="FALSE" HEIGHT="280" DECIMALS="" SQL=""  />
		<INPUT TYPE="number"   NAME="kg"      CAPTION="KG*" TABINDEX="4" TOP="2100" LEFT="5000"  DECIMALS="2"  WIDTH="1000" ONLOSTFOCUS=""/>
		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Spremi" TOP="2100" LEFT="7800"  TABINDEX="5" SQL="" 
			   ONCLICK="exec spstvaganja @action = 2 , @stgrloid = @@stgrloid, @stfarmeid = @@stfarmeid, @kg = @@kg, @datumdok = @@datumdok, @operateriid = @@operateriid , @napomena = '@@napomena'#OK" />
		<INPUT TYPE="button"   NAME="donesi"    CAPTION="Donesi" TOP="1600" LEFT="7800"  ONCLICK=":DONOSZAVAGANJE" TABINDEX="6" SQL="" />

		<INPUT TYPE="grid"
					NAME="unosv"
					TOP="3000"
					LEFT="200"
					WIDTH="8500"
					HEIGHT="5000"
					CHECKBOXVISIBLE="TRUE"
					TOTALROWVISIBLE="FALSE"
					EDITCOLUMNS="KG"
					ONCELLEDITED=""
					GROUPBYBOXVISIBLE="FALSE"
					CAPTION="Grla sa radnog naloga"
					REFRESHAFTERCHILD="TRUE"
					VISIBLE="TRUE"
					SQL="spstVaganja @action = 1,  @operateriid= @@operateriid,@node='danas', @stfarmeid = @@stfarmeid " />



		<INPUT TYPE="button" NAME="cancel" CAPTION="Kraj" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</INSERT_FORM>


	<DONOSZAVAGANJE
		WIDTH="8600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="select @@datumdok as datumdok, @@stfarmeid as stfarmeid, '@@napomena' as napomena, null as prnradninalogid"
		HEIGHT="10000"
			FILLEXPLORER=""
		REFRESHAFTERCHILD=""
		CAPTION="Donos grla po RN - za unos vaganja "
		FOCUS="stgrloid"
		>

		<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog*" WIDTH="1500" TOP="500" SQL="spSTRadniNalozi @action = 1, @stfarmeid = @@stfarmeid, @trazi = '@@searchboxprnradninalogid'"
			   ONLOSTFOCUS="spSTRadniNalozi @action = 11, @idrn = @@prnradninalogid #if @@prnradninalogid is not null begin (select 'disable' as novirn) end "/>
		<INPUT TYPE="text" NAME="datumrn" CAPTION="Datum RN*" ENABLED="FALSE" TOP="500" LEFT="4500" WIDTH="1500"/>
		<INPUT TYPE="text" NAME="opisrn" CAPTION="Opis RN*" ENABLED="FALSE" TOP="1000" WIDTH="2500"/>

		<INPUT TYPE="button"   NAME="ok"    CAPTION="Pokaži" TOP="1000" LEFT="5800"  SQL="" ONCLICK="select 1 as pokazi #select 'refresh' as donosv#select 'visible' as donosv" />

		<INPUT TYPE="grid"
					NAME="donosv"
					TOP="3000"
					LEFT="200"
					WIDTH="7100"
					HEIGHT="5000"
					CHECKBOXVISIBLE="TRUE"
					TOTALROWVISIBLE="FALSE"
					EDITCOLUMNS="KG"
					ONCELLEDITED=""
					GROUPBYBOXVISIBLE="FALSE"
					CAPTION="Grla sa radnog naloga"
					REFRESHAFTERCHILD="TRUE"
					VISIBLE="FALSE"
					SQL="spSTDonosGrla @action = 5	, @stfarmeid =@@stfarmeid, @prnradninalogid = @@prnradninalogid, @pokazi = @@pokazi" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Prebaci"  TOP="9000" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="FOREACHROW(donosv)#if @(donosv..kg0900) &lt;>  0 begin exec spSTvaganja @action = 2,@Stgrloid = @@donosv , @KG= @(donosv..kg0900) , @datumdok = @@datumdok, @stfarmeid = @@stfarmeid, @prnradninalogid = @@prnradninalogid ,@operateriid = @@operateriid end #OK"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DONOSZAVAGANJE>



	<UPDATE_FORM
			FILLEXPLORER=""
		REFRESHAFTERCHILD=""
			WIDTH="7600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="exec spstvaganja @action = 5, @id  =@@id"
		HEIGHT="3200"
		CAPTION="Unos vaganja "
		FOCUS="kg"
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke :" TOP="50" LEFT="56" WIDTH="7300" HEIGHT="2000"   />
		<INPUT TYPE="date" NAME="datumdok" TOP="200" CAPTION="Datum vaganja*" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as stfarme2id, 'refresh' as osobeid"/>
		<INPUT TYPE="text" NAME="napomena" TOP="1000" CAPTION="Napomena*" />

		<INPUT TYPE="search" NAME="stgrloid" 	  CAPTION="Grlo*" TOP="1600" WIDTH="1296" HEIGHT="280" DECIMALS="4" ENABLED="FALSE" STYLE="1"
					SQL="spSTDajGrlo @trazi = '@@searchboxstgrloid', @stfarmeid = @@stfarmeid, @operateriid = @@operateriid, @sifradok = '502'"
					ONLOSTFOCUS="exec spSTKontrolaUpisaGrla @stgrloid = @@stgrloid , @stfarmeid = @@stfarmeid, @tov = 0  "/>
		<INPUT TYPE="number"   NAME="KG"      CAPTION="KG*" TOP="1600" LEFT="4000"  DECIMALS="2"  WIDTH="1000" ONLOSTFOCUS=""/>
		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Spremi" TOP="2300" LEFT="1500"  SQL="" 
			   ONCLICK="exec spstvaganja @action = 3 , @id = @@id, @stgrloid = @@stgrloid, @stfarmeid = @@stfarmeid, @kg = @@kg, @datumdok = @@datumdok, @operateriid = @@operateriid , @napomena = '@@napomena'#OK" />
		<INPUT TYPE="button"   NAME="cancel"    CAPTION="Odustani" TOP="2300" LEFT="3500"   ONCLICK="close" />

	</UPDATE_FORM>


	<DELETE_FORM
			FILLEXPLORER=""
		REFRESHAFTERCHILD=""
			WIDTH="7600"
		NEXTFORM=""
		ONSUBMIT=""
		ONLOAD="exec spstvaganja @action = 5, @id  =@@id"
		HEIGHT="3200"
		CAPTION="Unos vaganja "
		FOCUS="kg"
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Unos stavke :" TOP="50" LEFT="56" WIDTH="7300" HEIGHT="2000"  ENABLED="FALSE" STYLE="1" />
		<INPUT TYPE="date" NAME="datumdok" TOP="200" CAPTION="Datum vaganja*" ENABLED="FALSE" STYLE="1" />
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="600" ONCLICK="" ENABLED="FALSE" STYLE="1" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma*" ONLOSTFOCUS="select 'refresh' as stfarme2id, 'refresh' as osobeid"/>
		<INPUT TYPE="text" NAME="napomena" TOP="1000" CAPTION="Napomena*" ENABLED="FALSE" STYLE="1" />

		<INPUT TYPE="search" NAME="stgrloid" 	  CAPTION="Grlo*" TOP="1600" WIDTH="1296" HEIGHT="280" DECIMALS="4" ENABLED="FALSE" STYLE="1"
					SQL="spSTDajGrlo @trazi = '@@searchboxstgrloid', @stfarmeid = @@stfarmeid, @operateriid = @@operateriid, @sifradok = '502'"
					ONLOSTFOCUS="exec spSTKontrolaUpisaGrla @stgrloid = @@stgrloid , @stfarmeid = @@stfarmeid, @tov = 0  "/>
		<INPUT TYPE="number"   NAME="KG"      CAPTION="KG*" TOP="1600" LEFT="4000"  DECIMALS="2"  ENABLED="FALSE" STYLE="1" WIDTH="1000" ONLOSTFOCUS=""/>
		<INPUT TYPE="button"   NAME="spremi"    CAPTION="Obriši" TOP="2300" LEFT="1500"  SQL=""
			   ONCLICK="exec spstvaganja @action = 4 , @id = @@id#OK" />
		<INPUT TYPE="button"   NAME="cancel"    CAPTION="Odustani" TOP="2300" LEFT="3500"   ONCLICK="close" />

	</DELETE_FORM>



</PROJECT>