<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD="spOrgShemaKonfig @action=10"
      SETDEFAULTS="select (select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas"
      CMD1CAPTION="Dodaj / Izmjeni:UPDATEFORM" 
      CMD2CAPTION="Ispis:PRINTMASTER" 
      CMD3CAPTION=""
      POPUPMASTER="Ispis:PRINTMASTER"
      MASTERDBLCLICK=":UPDATEFORM"
      CHECKBOXVISIBLE="FALSE"  
      PAGEHEADERCENTER=""
      PAGEHEADERRIGHT=""
	  PAGEHEADERLEFT=""
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@tkosmomi"
	  PAGEFOOTERRIGHT="@@datdanas##Jupiter Software by SPIN"
	  PAGEORIENTATION="LANDSCAPE"	  

      >

 
  <NAME>OrgshemaKonfig</NAME>
  <CAPTION>Konfigurator organizacijske sheme</CAPTION> 
  <KOMENTAR> ASDASD </KOMENTAR>
  
   


   
<UPDATEFORM 
					
                 WIDTH="6000" 
                 ONSUBMIT="spOrgShemaKonfig @action=1, "                  
		 ONLOAD="select orgshemaid,kultureid,sezona,Povr_HA from orgshema where orgshemaid=@@id "                                                    
                 HEIGHT="3300" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Izvrši" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER=""
  		 >
  	       
                		                   
                <INPUT TYPE="combo" CAPTION="Org. jedinica:*" NAME="orgshemaid"   TOP="200" LEFT="1300" WIDTH="2300" HEIGHT="300" 
                  ALLOWEMPTY="FALLS" ENABLED="FALSE" SQL="select orgshemaid,ltrim(rtrim(naziv)) from orgshema" /> 
                   

		<INPUT TYPE="combo" CAPTION="Kultura:*" NAME="kultureid"   TOP="700" LEFT="1300" WIDTH="2300" HEIGHT="300" 
                  ALLOWEMPTY="TRUE" SQL="select k.kultureid, k.naziv from kulture  k order by k.naziv" />
 


		<INPUT TYPE="text" CAPTION="Sezona:*" NAME="sezona"   TOP="1200" LEFT="1300" WIDTH="2300" HEIGHT="300" 
                  ALLOWEMPTY="TRUE"  /> 

		<INPUT TYPE="number" CAPTION="Površina ha:*" NAME="Povr_HA"   TOP="1700" LEFT="1300" WIDTH="1000" HEIGHT="300" 
                  ALLOWEMPTY="TRUE" DECIMALS="3"  /> 


		

                           

  </UPDATEFORM>




 



</PROJECT>
 


