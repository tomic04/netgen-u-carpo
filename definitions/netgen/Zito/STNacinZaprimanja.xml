<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTNacinZaprimanja @action = 1, @operateriid= @@operateriid " 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Pokaži:POKAZI_FORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Načini zaprimanja"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Načini zaprimanja</NAME>
	<CAPTION>Načini zaprimanja</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTNacinZaprimanja @action = 1, @operateriid= @@operateriid " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="4100" 
		 WIDTH="7700" 
		 CAPTION="Unos načina zaprimanja"
		 ONSUBMIT="spSTNacinZaprimanja @action = 3, @operateriid= @@operateriid, "
		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"                  CAPTION="Naziv načina zaprimanja:"  TABINDEX="0"  ENABLED="TRUE"  />
		 <INPUT TYPE="number"  NAME="StatusId"		        CAPTION="Status kod zaprimanja:"    TABINDEX="1"  ENABLED="TRUE"  WIDTH="500"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="text"    NAME="Vrsta"		            CAPTION="Vrsta:"                    TABINDEX="2"  ENABLED="TRUE"  WIDTH="500"  SQL=""  />
         <INPUT TYPE="text"    NAME="Sifra"		            CAPTION="Šifra:"                    TABINDEX="3"  ENABLED="TRUE"  WIDTH="500"  SQL=""  />
	     <INPUT TYPE="combo"   NAME="vrstadokid"            CAPTION="Vrsta dokumenta:"          TABINDEX="4"  ENABLED="TRUE"  ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="select vrstadokid ,opis as naziv from vrstadok where  vrstapromid in (select vrstapromid from vrstaprom where projekt = 'S')" />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="4100" 
		 WIDTH="7700" 
		 CAPTION="Izmjena načina zaprimanja"
		 ONSUBMIT="spSTNacinZaprimanja @action = 4, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from stnacinZaprimanja where stnacinZaprimanjaId=@@id" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"                  CAPTION="Naziv načina zaprimanja:"  TABINDEX="0"  ENABLED="TRUE"  />
		 <INPUT TYPE="number"  NAME="StatusId"		        CAPTION="Status kod zaprimanja:"    TABINDEX="1"  ENABLED="TRUE"  WIDTH="500"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="text"    NAME="Vrsta"		            CAPTION="Vrsta:"                    TABINDEX="2"  ENABLED="TRUE"  WIDTH="500"  SQL=""  />
         <INPUT TYPE="text"    NAME="Sifra"		            CAPTION="Šifra:"                    TABINDEX="3"  ENABLED="TRUE"  WIDTH="500"  SQL=""  />
	     <INPUT TYPE="combo"   NAME="vrstadokid"            CAPTION="Vrsta dokumenta:"          TABINDEX="4"  ENABLED="TRUE"  ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="select vrstadokid ,opis as naziv from vrstadok where  vrstapromid in (select vrstapromid from vrstaprom where projekt = 'S')" />
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="4100" 
		 WIDTH="7700" 
		 CAPTION="Brisanje načina zaprimanja ? Jeste li sigurni ?!"
		 ONSUBMIT="spSTNacinZaprimanja @action = 5, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from stnacinZaprimanja where stnacinZaprimanjaId=@@id" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"                  CAPTION="Naziv načina zaprimanja:"  TABINDEX="0"  ENABLED="FALSE"  />
		 <INPUT TYPE="number"  NAME="StatusId"		        CAPTION="Status kod zaprimanja:"    TABINDEX="1"  ENABLED="FALSE"  WIDTH="500"  DECIMALS="0"  SQL=""  />
         <INPUT TYPE="text"    NAME="Vrsta"		            CAPTION="Vrsta:"                    TABINDEX="2"  ENABLED="FALSE"  WIDTH="500"  SQL=""  />
         <INPUT TYPE="text"    NAME="Sifra"		            CAPTION="Šifra:"                    TABINDEX="3"  ENABLED="FALSE"  WIDTH="500"  SQL=""  />
	     <INPUT TYPE="combo"   NAME="vrstadokid"            CAPTION="Vrsta dokumenta:"          TABINDEX="4"  ENABLED="FALSE"  ALLOWEMPTY="TRUE"  ONLOSTFOCUS="" SQL="select vrstadokid ,opis as naziv from vrstadok where  vrstapromid in (select vrstapromid from vrstaprom where projekt = 'S')" />
</DELETE_FORM>

</PROJECT>