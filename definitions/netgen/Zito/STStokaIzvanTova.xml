<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Uvjeti:FILTERFORM#Kartica:KARTICE" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 MULTIGRIDLAYOUT="TRUE" 
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT="">



	<NAME>Pregled zaprimljenih grla koja nisu u tovu</NAME>
	<CAPTION>Pregled zaprimljenih grla koja nisu u tovu</CAPTION>



	<FILTERFORM NAME="FILTERFORM" HEIGHT="4000" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spSTStadoQuery @action = 2,  @operateriid= @@operateriid, "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Od datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Do datuma" DEFAULT="getdate()"/>
		<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""/>
		
	</FILTERFORM>

	<KARTICE NAME="KARTICE"
				HEIGHT="3902" WIDTH="7502"
				CAPTION="Kartice grla: "
		  >
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica prometa"  TOP="500" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAPROMETA"  HOTKEY="" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica mlijeka"      TOP="1000" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAMLIJEKA"  HOTKEY="" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Kartica reprodukcije"      TOP="1500" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":KARTICAREPRODUKCIJE"  HOTKEY="" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Zdravstvena kartica"      TOP="2000" LEFT="456" WIDTH="2106" HEIGHT="322" ONCLICK=":ZDRAVSTVENAKARTICA"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani"            TOP="2500" LEFT="3756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</KARTICE >


	<KARTICAPROMETA
		FILLEXPLORER=""
		WIDTH="9600"
			ONSUBMIT=""
		ONLOAD=""
		HEIGHT="6000"
		CAPTION="Kartica prometa grla"
				>
		<INPUT TYPE="grid"
				NAME="kprometa"
				TOP="700"
				LEFT="200"
				WIDTH="9500"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="4000"
				CAPTION="Krtica prometa grla "
		REFRESHAFTERCHILD="TRUE"
		SQL="stKarticaGrla @action = 1, @stgrloid = @@id" />

		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="5100" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</KARTICAPROMETA>


</PROJECT>