<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		 DETAILGRID = "spmpkontrolaMPRobno @action=2,@id=@@id"
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Dokumenti:DOKUMENTI" 
		CMD4CAPTION=""
 		CMD5CAPTION="Popravi:POPRAVI" 
		CMD6CAPTION=""
		MULTIGRIDLAYOUT="TRUE"
		MASTERDBLCLICK="PROMET"
	  POPUP=""
		SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname',  @trazi ='' ">> 
 

  <NAME>Kontrola MP - Robno</NAME>
  <CAPTION>Kontrola MP - Robno</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spmpkontrolaMPRobno @action = 1," 
		ONLOAD="select @@trgovinaid as trgovinaid, @@datumod as datumod, @@datumdo as datumdo " 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CHILDFORM="">

    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="1000" LEFT="1500"
               SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t 
                    inner join trgovineprava p on t.trgovinaid = p.trgovinaid where p.operaterid = @@operateriid"/>
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" DEFAULT="firstdayofyear" HEIGHT="320" WIDTH="1500" TOP="1500" LEFT="1500"/>
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" DEFAULT="today" HEIGHT="320" WIDTH="1500" TOP="2000" LEFT="1500" />

  </FORM1>

	<DOKUMENTI
		FILLEXPLORER=""
		WIDTH="12000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="6900"
		VERSION="5"
		CAPTION="Analiza po dokumentima ">


		<INPUT TYPE="grid"
			NAME="dokumenti"
			TOP="200"
			LEFT="200"
			WIDTH="11000"
			HEIGHT="5000"
			CHECKBOXVISIBLE="FALSE"
			TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
			GROUPBYBOXVISIBLE="FALSE"
			CAPTION=""
			REFRESHAFTERCHILD="TRUE"
			VISIBLE="TRUE"
			SQL="spmpNajavaObnoveNC @action=55, @operateriid = @@operateriid, @trgovinaid = @@id, @datumod = @@datumod, @datumdo = @@datumdo  " />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5500" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DOKUMENTI>

	<POPRAVI
  NAME="UPDATE_NC"
  HEIGHT="2200" WIDTH="8000"
  CAPTION="Korekcija razlike "
  ONLOAD="select trgovinaid, opis as Trgovina from trgovina where trgovinaid  = @@id  "
  ONSUBMIT="spmpNajavaObnoveNC @action=7, @trgovinaid = @@id, @datumod = @@datumod, @datumdo = @@datumdo!!  "
  ONLOADED =""
  FILLEXPLORER=""
  CMD1CAPTION="Popravi"
  CMD2CAPTION="Odustani">

		<INPUT TYPE="text" NAME="trgovinaid" TOP="500" LEFT="2800" HEIGHT="490" WIDTH="2000" CAPTION="" ENABLED="FALSE"  VISIBLE="FALSE"/>
		<INPUT TYPE="text" NAME="Trgovina" TOP="500" LEFT="2800" HEIGHT="490" WIDTH="2000" CAPTION="Trgovina*" ENABLED="FALSE" />

	</POPRAVI>
 
</PROJECT> 