<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT>

	<AMBALAZA
			FILLEXPLORER=""
			WIDTH="8000"
			ONSUBMIT=""
			FOCUS="robaid" 
			ONLOAD="select null as robaid, 0 as kolicinaamb"
			HEIGHT="7000"
			CAPTION="Unos ambalaže"
		>

		<INPUT TYPE="search"     NAME="robaid" CAPTION="Tražilica*"  TOP="200" LEFT="1500" SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid', @ambalaza = 0" 
					ONLOSTFOCUS="exec spmpambalazaNG @action = 6, @robaid = @@robaid" />
		<INPUT TYPE="number"     NAME="kolicinaamb" CAPTION="Količina*"  TOP="700" LEFT="1500" SQL=""  />
		<INPUT TYPE="button"   NAME="dodaj"    CAPTION="Dodaj" TOP="600" LEFT="6000"  SQL="" 
			   ONCLICK="exec spmpambalazaNG @action = 0 , @robaid = @@robaid,  @kolicina = @@kolicinaamb, @maloprodajaglaid = @@id 
						#select '' as roba, null as robaid, 0 as kolicinaamb, 'refreshmovelast' as ambalaza# select 'robaid' as focus" />

		<INPUT TYPE="grid"
					NAME="ambalaza"
					TOP="1200"
					LEFT="200"
					WIDTH="7200"
					HEIGHT="4000"
					CHECKBOXVISIBLE="FALSE"
					TOTALROWVISIBLE="FALSE"
					EDITCOLUMNS="[Količina1200]"
					ONCELLEDITED="exec spmpambalazaNG @action = 1 , @mpambalazaid = @@ambalaza, @kolicina = @@gridambalazaKoličina#select 'refresh' as ambalaza "
					GROUPBYBOXVISIBLE="FALSE"
					CAPTION="Ambalaža"
					REFRESHAFTERCHILD="TRUE"
					VISIBLE="TRUE"
					SQL="exec spmpAmbalazaNG @action = 3, @maloprodajaglaid = @@id" />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Kraj" TOP="5600" LEFT="1256" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="obrisiamb" CAPTION="Obriši" TOP="5600" LEFT="2956" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="exec spmpAmbalazaNG @action = 2, @MPAmbalazaid = @@ambalaza#select 'refersh' as ambalaza#select 'refresh' as ambalaza"  />
	</AMBALAZA>


</PROJECT>

