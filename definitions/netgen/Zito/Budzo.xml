<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Parametri:FILTERFORM"
		 CMD2CAPTION="Unesi:INSERTFORM"
		 CMD3CAPTION="Obriši:OBRISIFORM"
		 ONLOAD="spProPlanBudzetOrgshema @action=0"
		 GROUPBYBOXVISIBLE="TRUE"
		 FROZENCOLUMNS="0"
		 CHECKBOXVISIBLE="FALSE"
		>
<NAME>Projekt</NAME>
<CAPTION>Novi projekt</CAPTION>
<KOMENTAR>CallistoII 1.8.0</KOMENTAR>

<INSERTFORM NAME="INSERTFORM"
		 HEIGHT="2160"
		 WIDTH="7171"
		 CAPTION="Unos"
		 ONSUBMIT="spProPlanBudzetOrgshema @action=2,"
		 REFRESHAFTERCHILD="TRUE"
		 BORDERSTYLE="3"
		 CMD1CAPTION="Prihvati"
		 CMD2CAPTION="Odustani"
		>
	<INPUT TYPE="search" NAME="orgshemaid"
		 TOP="115"
		 LEFT="1296"
		 HEIGHT="302"
		 WIDTH="5602"
		 VISIBLE="TRUE"
		 SQL="orgshema#orgshemaid#naziv%"
		 ALLOWEMPTY="TRUE"
		 REFRESHAFTERCHILD="TRUE"
		 CAPTION="Org. jedinica*"
		 TABINDEX="0"
		 ENABLED="TRUE"
		/>
	<INPUT TYPE="search" NAME="robaid"
		 TOP="518"
		 LEFT="1310"
		 HEIGHT="302"
		 WIDTH="5602"
		 VISIBLE="TRUE"
		 SQL="roba#robaid#userid%#robakod%#naziv%"
		 ALLOWEMPTY="TRUE"
		 REFRESHAFTERCHILD="TRUE"
		 CAPTION="Roba (F5)*"
		 TABINDEX="1"
		 ENABLED="TRUE"
		 HOTKEY="F5"
		/>

</INSERTFORM>

<FILTERFORM NAME="FILTERFORM"
		 HEIGHT="1699"
		 WIDTH="7085"
		 CAPTION="Parametri"
		 ONSUBMIT="spProPlanBudzetOrgShema @action=1, @id=0,"
		 FILLEXPLORER="TRUE"
		 CMD1CAPTION="Prihvati"
		 CMD2CAPTION="Odustani"
		>
	<INPUT TYPE="combo" NAME="orgshemaid"
		 TOP="216"
		 LEFT="1368"
		 HEIGHT="302"
		 WIDTH="5515"
		 VISIBLE="TRUE"
		 SQL="select orgshemaid, oznaka + &apos; &apos; + naziv from orgshema where orgshemaid in (select orgshemaid from proplanbudzetorgshema)"
		 ALLOWEMPTY="TRUE"
		 REFRESHAFTERCHILD="FALSE"
		 CAPTION="Orgshema"
		 ENABLED="TRUE"
		/>
	<INPUT TYPE="label" NAME="lblPartner"
		 TOP="216"
		 LEFT="173"
		 HEIGHT="317"
		 WIDTH="1498"
		 VISIBLE="TRUE"
		 BOLD="FALSE"
		 CAPTION="Orgshema"
		 ENABLED="TRUE"
		/>

</FILTERFORM>

<OBRISIFORM NAME="OBRISIFORM"
		 HEIGHT="1987"
		 WIDTH="2938"
		 CAPTION="Obriši"
		 ONSUBMIT="spProPlanBudzetOrgShema @action=3,@ID=@@id"
		 CMD1CAPTION="Prihvati"
		 CMD2CAPTION="Odustani"
		>
	<INPUT TYPE="label" NAME="Label13"
		 TOP="202"
		 LEFT="202"
		 HEIGHT="432"
		 WIDTH="2520"
		 VISIBLE="TRUE"
		 BOLD="FALSE"
		 CAPTION="Jeste li sigurni da želite obrisati?"
		 ENABLED="TRUE"
		/>

</OBRISIFORM>

<RESET NAME="RESET"
		 HEIGHT="3902"
		 WIDTH="7085"
		 CAPTION="Reset"
		 ONSUBMIT="spProPlanBudzetOrgshema @action=0"
		 FILLEXPLORER="TRUE"
		>

</RESET>
</PROJECT>