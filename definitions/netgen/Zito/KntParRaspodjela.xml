<FILTERFORM NAME="FILTERFORM" HEIGHT="8496" WIDTH="4493" CAPTION="Prikaz po osobama" ONSUBMIT="spKntParRaspodjela @action=1,@Partneriid=@@partneriid,@chkkumulativ=@@chkkumulativ,@nizoznacenihajdijevagridosobe=&apos;@@nizoznacenihajdijevagridosobe&apos;,@nizoznacenihajdijevagridklase=&apos; &apos;!!" ONLOAD="select char(13) as NR,convert(varchar,getdate(),104) as datdosp,(dateadd(d,-1,left(convert(varchar,getdate(),112),6)+&apos;01&apos;)) AS datdo,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = &apos;NasId&apos;))) as tkosmomi,getdate() as datdanas,
                         (select m.naziv  from partneri p
			 inner join parstru ps on ps.partneriid=p.partneriid
			 inner join mjesta m on m.mjestaid=ps.mjestaid
			 where p.partneriid = convert(integer,(select VarSet from PubVars where VarIme = &apos;NasId&apos;))
			 and ps.hqind=&apos;*&apos;) AS mjesto" FILLEXPLORER="TRUE">
	<INPUT TYPE="search" NAME="partneriid" TOP="245" LEFT="1094" HEIGHT="302" WIDTH="2995" SQL="partneri#partneriid#Naziv%" ALLOWEMPTY="FALSE" CAPTION="Partner:*" ONLOSTFOCUS="select naziv as nazivpartner,telefon1 as telefon,fax from vipartneri where partneriid=@@partneriid"/>
	<INPUT TYPE="grid" NAME="gridosobe" TOP="850" LEFT="547" HEIGHT="6005" WIDTH="3701" REFRESHAFTERCHILD="TRUE" CAPTION="Komercijalisti" GROUPBYBOXVISIBLE="FALSE" CHECKBOXVISIBLE="TRUE" SQL="exec spKntParRaspodjela 3" DOCK="0"/>
	<INPUT TYPE="check" NAME="chkkumulativ" TOP="6998" LEFT="1094" HEIGHT="331" WIDTH="3197" CAPTION="Kumulativ"/>
	<INPUT TYPE="button" NAME="ok" TOP="7502" LEFT="101" HEIGHT="331" WIDTH="1195" TEXT="ButtonNG0" CAPTION="Izvrši" ONCLICK="Ok"/>
	<INPUT TYPE="button" NAME="cancle" TOP="7502" LEFT="1498" HEIGHT="331" WIDTH="1195" TEXT="ButtonNG1" CAPTION="Izlaz" ONCLICK="close"/>

</FILTERFORM>

