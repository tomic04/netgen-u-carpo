<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT>

	<VETKARTICA
		  FILLEXPLORER=""
		  MAXIMIZEBOX="TRUE"
		  DETAILGRID = ""
		  WIDTH="14500"
		  ONSUBMIT=""
		  ONLOAD="select 0 as dijagnoze, @@stgrloid as stgrloid"
		  ONLOADED="select 'refresh' as xprepter, 'refresh' as xterap"
		  ONLOAD2="Select maticnibroj from stgrlo where stgrloid = @@id"
		  HEIGHT="9800"
		  CAPTION="Veterinarska kartica grla - matični broj @@maticnibroj "
		  BORDERSTYLE="3"
		  FOCUS="glava"
		  CMD1CAPTION=""
		  CMD2CAPTION=""
		  CMD3CAPTION=""
		  REFRESHAFTERCHILD="TRUE" >

		<INPUT TYPE="text" NAME="maticnibroj" CAPTION="_Broj*" TOP="-3000" LEFT="1500" WIDTH="2506" HEIGHT="280" SQL="" TABINDEX="-1" ENABLED="FALSE"/>
		<INPUT TYPE="number" DECIMALS="0" NAME="stgrloid" VISIBLE="FALSE"/>
		<!--
		<INPUT TYPE="check" NAME="Sve" CAPTION="Sve terapije" TOP="8400" LEFT="9500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="select null as xprepter, 'refresh' as xterap"/>
        -->
		
		<INPUT TYPE="check" NAME="Sve" CAPTION="Sve terapije" TOP="8400" LEFT="9500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="select 'refresh' as xterap"/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8700" LEFT="1500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="close"/>
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="Dijagnoze" TOP="28"   LEFT="56"   WIDTH="14050" HEIGHT="4200"   />
		<INPUT TYPE="frame"  NAME="fr2"         CAPTION="Prepisane terapije" TOP="4200"   LEFT="56"   WIDTH="7000" HEIGHT="4200"   />
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="Terapiranja" TOP="4200"   LEFT="7100"   WIDTH="7000" HEIGHT="4200"   />


		<INPUT TYPE="grid"
				   NAME="xdijagnoze"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="200" LEFT="256" WIDTH="13700" HEIGHT="4000"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK="select 'refresh' as xprepter"
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTDijagQueryGlaiDet @action = 6, @id = @@stgrloid" />

		<INPUT TYPE="grid"
				   NAME="xprepter"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="4400" LEFT="256" WIDTH="6800" HEIGHT="4000"
				   POPUP=""
				   ONCLICK="select 'refresh' as xterap"
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTDijagQueryGlaiDet @action = 2, @id = @@xdijagnoze" />

		<INPUT TYPE="grid"
		   NAME="xterap"
		   REFRESHAFTERCHILD="TRUE"
		   CAPTION="Stavke"
		   SKIPDEFAULTLOAD2="TRUE"
		   TOP="4400" LEFT="7200" WIDTH="6800" HEIGHT="4000"
		   POPUP=""
		   ONCLICK=""
		   ONDBLCLICK=""
		   EDITCOLUMNS=""
		   ONCELLEDITED=""
		   CHECKBOXVISIBLE="FALSE"
		   PAGEHEADERCENTER=""
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT=""
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   PAGEFOOTERRIGHT="@@thosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="TRUE"
		   TOTALROW="FALSE"
		   SQL="spSTTerapijaQuery @action = 8, @stgrloid = @@stgrloid, @stdijagdetid = @@xprepter, @Sve = @@Sve" />

	</VETKARTICA>

</PROJECT> 