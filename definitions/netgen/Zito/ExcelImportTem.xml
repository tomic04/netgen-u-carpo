<root>
    <form type="master">
    <method name="ExcelImportTem" dll="ExcelImportTem" class="ExcelImportTem.MainForm" method="Run" />
        <managerlayout>
            <grid type="master">
            </grid>
        </managerlayout>
        <panelbuttons>
		<buttons>
			<button name="btnXml" caption="XML" type="add">
				<event type="click">
					<!-- unutar eventa pozivamo akciju tipa method run. U value upisujemo naziv definiran u elementu method linija 6 u xml-u -->
					<action type="method run" value="ExcelImportTem">
						<!-- pomoću elementa parameter proslijeđujemo metodi tj. formi parametre koje traži kroz value atribut-->
						<parameter name="server" value="jupiter2012" />
						<parameter name="database" value="tele2" />
						<parameter name="username" value="" />
                        <parameter name="password" value="" />
                        <parameter name="password" value="@@operateriid" />
                        <parameter name="parent" value="" />
                        <parameter name="pTop" value="" />
                        <parameter name="pLeft" value="" />
                        <parameter name="path" value="" />
                        <parameter name="table" value="" />
                        </action>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
    </form>
</root>