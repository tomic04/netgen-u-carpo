<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		 ONLOAD="exec spSTBolesti @action = 1 "
		 DETAILGRID = "exec spSTBolesti @action = 2, @id=@@id, @vrsta='G'"
		 MASTERDBLCLICK=""
		 BUTTONS="Dodaj:INSERT_FORM#Izmjeni bolest:UPDATEBOLESTI#Ažuriranje dijagnoza:UPDATE_FORM" 
		 CMD6CAPTION=""
		 POPUPMASTER=""
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="LANDSCAPE">

 

  <NAME>Bolesti i dijagnoze u govedarstvu </NAME>
  <CAPTION>Bolesti i dijagnoze u govedarstvu</CAPTION>




	<INSERT_FORM
		  WIDTH="8000" 
		ONSUBMIT="exec spSTBolesti @action = 3 , " 
		ONLOAD="" 
		HEIGHT="3500" 
		CAPTION="Nova grupa bolesti " 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


			<INPUT TYPE="text" 
					NAME="sifra" 
					TOP="500" 
					LEFT="2000" 
					TABINDEX="0" 
					CAPTION="Šifra*" 
					TEXT="" 
					WIDTH="400" HEIGHT="320"/> 



			<INPUT TYPE="text" 
                   	NAME="Opis" 
					CAPTION="Grupa bolesti*" 
                    TOP="1000" 
                    LEFT="2000"  
					TABINDEX="1" 
					TEXT="" 
					WIDTH="4000" HEIGHT="320"/> 



  </INSERT_FORM>


	<UPDATEBOLESTI
		  WIDTH="8000"
		ONSUBMIT="exec spSTBolesti @action = 4, @id = @@id, "
		ONLOAD="select * from stbolesti where stbolestiid = @@id "
		HEIGHT="3500"
		CAPTION="Izmjena grupe bolesti "
		BORDERSTYLE="3"
		CMD1CAPTION="Spremi"
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""
		CHILDFORM="">



		<INPUT TYPE="text"
				NAME="sifra"
				TOP="500"
				LEFT="2000"
				TABINDEX="0"
				CAPTION="Šifra*"
				TEXT=""
				WIDTH="400" HEIGHT="320"/>



		<INPUT TYPE="text"
				NAME="Opis"
				CAPTION="Grupa bolesti*"
				TOP="1000"
				LEFT="2000"
				TABINDEX="1"
				TEXT=""
				WIDTH="4000" HEIGHT="320"/>



	</UPDATEBOLESTI>




	<UPDATE_FORM
		  WIDTH="9500"
		ONSUBMIT=""
		ONLOAD="select @@id as sstbolestiid"
		HEIGHT="6500"
		CAPTION="Grupa bolesti - dijagnoze "
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION=""
		CMD3CAPTION=""
		CHILDFORM="">



		<INPUT TYPE="combo"
				NAME="sstbolestiid"
				TOP="300"
				LEFT="1500"
				TABINDEX="0"
				CAPTION="Grupa bolesti*"
				SQL="select stbolestiid , opis from stbolesti "
			    ONLOSTFOCUS="select 'refresh' as ddijagnoze"
			    ONCLICK="select 'refresh' as ddijagnoze"
				WIDTH="4000" HEIGHT="320"/>




		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY=""   TOP="5400" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="OK"/>


		<INPUT TYPE="grid"
			   NAME="ddijagnoze"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Dijagnoze"
			   TOP="1000" LEFT="100" WIDTH="7000" HEIGHT="4000"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP=""
			   ONDBLCLICK=""
			   EDITCOLUMNS=""
			   ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER=""
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT=""
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@tkosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="exec spSTBolesti @action = 2,@id=@@sstbolestiid,@vrsta='G'" />

			<INPUT TYPE="button" NAME="ok" CAPTION="Nova" HOTKEY=""   TOP="1300" LEFT="7500" WIDTH="1106" HEIGHT="322" ONCLICK=":DODDIJAG"/>
			<INPUT TYPE="button" NAME="ok" CAPTION="Izmjeni" HOTKEY=""   TOP="1900" LEFT="7500" WIDTH="1106" HEIGHT="322" ONCLICK=":IZMJENIDIJAG"/>
			<INPUT TYPE="button" NAME="ok" CAPTION="Obriši" HOTKEY=""   TOP="2500" LEFT="7500" WIDTH="1106" HEIGHT="322" ONCLICK=":BRISIDIJAG"/>


		
		

	</UPDATE_FORM>



	<DODDIJAG
	  WIDTH="8000"
	ONSUBMIT=""
	ONLOAD="select @@id as xstbolestiid"
	HEIGHT="3500"
	CAPTION="Nova dijagnoza"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION=""
	CMD3CAPTION=""
	CHILDFORM="">


		<INPUT TYPE="combo"
				NAME="xstbolestiid"
				TOP="300"
				LEFT="2000"
				TABINDEX="0"
				CAPTION="Grupa bolesti*"
				SQL="select stbolestiid , opis from stbolesti"
			    ONLOSTFOCUS=""
			    ONCLICK=""
				WIDTH="4000" HEIGHT="320"/>

		<INPUT TYPE="text"
				NAME="sifra"
				TOP="800"
				LEFT="2000"
				TABINDEX=""
				CAPTION="Šifra*"
				TEXT=""
				WIDTH="800" HEIGHT="320"/>



		<INPUT TYPE="text"
				NAME="Opis"
				CAPTION="Dijagnoza*"
				TOP="1300"
				LEFT="2000"
				TABINDEX=""
				TEXT=""
				WIDTH="4000" HEIGHT="320"/>

		<INPUT TYPE="combo"
				NAME="vrsta"
				CAPTION="Vrsta grla*"
				TOP="1800"
				LEFT="2000"
				TABINDEX=""
				ALLOWEMPTY="TRUE"
				SQL ="select 'G' as vrsta, 'Goveda' as naziv union all select 'S', 'Svinje'"
			   TEXT=""
				WIDTH="2000" HEIGHT="320"/>

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" HOTKEY=""   TOP="2400" LEFT="1500" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="exec spSTBolesti @action = 5, @sifradijag = '@@sifra', @opisdijag = '@@opis', @id= @@xstbolestiid, @vrsta = '@@vrsta' #OK "/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY=""   TOP="2400" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"/>


	</DODDIJAG>

	<IZMJENIDIJAG
	  WIDTH="8000"
	ONSUBMIT=""
	ONLOAD="exec spSTBolesti @action = 7, @dijagid = @@ddijagnoze, @id = @@id"
	ONLOADED=""
	HEIGHT="3500"
	CAPTION="Izmjena dijagnoze"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION=""
	CMD3CAPTION=""
	CHILDFORM="">


		<INPUT TYPE="combo"
				NAME="stbolestiid"
				TOP="300"
				LEFT="2000"
				TABINDEX="0"
				CAPTION="Grupa bolesti*"
				SQL="select stbolestiid , opis from stbolesti "
			    ONLOSTFOCUS=""
			    ONCLICK=""
				WIDTH="4000" HEIGHT="320"/>

		<INPUT TYPE="text"
				NAME="sifra"
				TOP="800"
				LEFT="2000"
				TABINDEX=""
				CAPTION="Šifra*"
				TEXT=""
				WIDTH="800" HEIGHT="320"/>



		<INPUT TYPE="text"
				NAME="Opis"
				CAPTION="Dijagnoza*"
				TOP="1300"
				LEFT="2000"
				TABINDEX=""
				TEXT=""
				WIDTH="4000" HEIGHT="320"/>

		<INPUT TYPE="combo"
				NAME="vrsta"
				CAPTION="Vrsta grla*"
				TOP="1800"
				LEFT="2000"
				TABINDEX=""
				ALLOWEMPTY="TRUE"
				SQL ="select 'G' as vrsta, 'Goveda' as naziv union all select 'S', 'Svinje'"
			   TEXT=""
				WIDTH="2000" HEIGHT="320"/>


		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" HOTKEY=""   TOP="2400" LEFT="1500" WIDTH="1106" HEIGHT="322"
			   ONCLICK="exec spSTBolesti @action = 6, @sifradijag = '@@sifra', @opisdijag = '@@opis', @id= @@stbolestiid, @dijagid = @@ddijagnoze, @vrsta = '@@vrsta'#OK "/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY=""   TOP="2400" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"/>
	</IZMJENIDIJAG>

	<BRISIDIJAG
	  WIDTH="8000"
	ONSUBMIT=""
	ONLOAD="exec spSTBolesti @action = 7, @dijagid = @@dijagnoze, @id = @@id"
	HEIGHT="3500"
	CAPTION="Brisanje dijagnoze"
	BORDERSTYLE="3"
	CMD1CAPTION=""
	CMD2CAPTION=""
	CMD3CAPTION=""
	CHILDFORM="">



		<INPUT TYPE="text"
				NAME="sifra"
				TOP="500"
				LEFT="2000"
				TABINDEX=""
				ENABLED="FALSE" 
				CAPTION="Šifra*"
				TEXT=""
				WIDTH="400" HEIGHT="320"/>



		<INPUT TYPE="text"
				NAME="Opis"
				CAPTION="Dijagnoza*"
				TOP="1000"
				LEFT="2000"
				ENABLED="FALSE" 
				TABINDEX=""
				TEXT=""
				WIDTH="4000" HEIGHT="320"/>

		<INPUT TYPE="button" NAME="ok" CAPTION="Briši" HOTKEY=""   TOP="1900" LEFT="1500" WIDTH="1106" HEIGHT="322" ONCLICK="exec spSTBolesti @action = 8, @dijagid = @@dijagnoze#OK "/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY=""   TOP="1900" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"/>


	</BRISIDIJAG>






 

</PROJECT> 