,@datumod=@@datumod,@datumdo=@@datumdo"/>
	<INPUT TYPE="label" NAME="Label42" TOP="1699" LEFT="259" HEIGHT="288" WIDTH="1296" CAPTION="Datum od:" TEXT="Label42"/>
	<INPUT TYPE="date" NAME="Datumdo" TOP="2045" LEFT="1728" HEIGHT="302" WIDTH="1728" ONLOSTFOCUS="select &apos;refresh&apos; as secugovoridetid # exec spFakturaZitoPrefak @action = 33, @secobjektiid= @@secobjektiid, @FaktureObracunid=@@node
,@datumod=@@datumod,@datumdo=@@datumdo"/>
	<INPUT TYPE="label" NAME="Label43" TOP="2045" LEFT="259" HEIGHT="288" WIDTH="1296" CAPTION="Datum do:" TEXT="Label43"/>
	<INPUT TYPE="combo" NAME="secugovoridetid" TOP="2434" LEFT="1728" HEIGHT="302" WIDTH="4320" SQL="select secugovoridetid, g.Broj+ coalesce(convert(varchar,d.DatumOd,104),&apos;&apos;)+&apos;-&apos; + coalesce(convert(varchar,d.DatumDo,104),&apos;&apos;) as broj 
from secugovoridet d
inner join secugovorigla g on g.secugovoriglaid=d.secugovoriglaid
 where secobjektiid=@@secobjektiid
 and 
(
		(
		@@datumod between coalesce(g.DatumPocetka,@@datumod) and coalesce(g.datumZavrsetka,@@datumod)
		or @@datumdo between coalesce(g.DatumPocetka,@@datumdo) and coalesce(g.datumZavrsetka,@@datumdo)
			or (g.DatumPocetka between @@datumod and @@datumdo and g.DatumZavrsetka between @@datumod and @@datumdo)
		) 
	and
		(
		@@datumod between coalesce(d.datumod,@@datumod) and coalesce(d.datumdo,@@datumdo)
		or @@datumdo between coalesce(d.datumod,@@datumod) and coalesce(d.datumdo,@@datumdo)
		or (d.DatumOd between @@datumod and @@datumdo and d.DatumOd between @@datumod and @@datumdo)
		)
	)
 and d.SecVrstaZastiteId=@@SecVrstaZastiteId
 order by broj" ALLOWEMPTY="true" ONLOSTFOCUS="exec spFakturaZitoPrefak @action = 34, @secugovoridetid= @@secugovoridetid, @FaktureObracunid=@@node"/>
