	<INPUT TYPE="label" NAME="lblorg" TOP="806" LEFT="259" HEIGHT="288" WIDTH="1296" CAPTION="Podružnica" TEXT="Label41"/>
	<INPUT TYPE="combo" NAME="SecVrstaZastiteId" TOP="1195" LEFT="1728" HEIGHT="302" WIDTH="4320" SQL="select SecVrstaZastiteId, Naziv as naziv from SecVrstaZastite where SecVrstaZastiteId in (2,7) order by SecVrstaZastiteId" ENABLED="true" ONLOSTFOCUS="select &apos;refresh&apos; as secugovoridetid"/>
