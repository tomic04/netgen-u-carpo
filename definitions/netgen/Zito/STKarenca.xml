<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD="spSTKarenca @action = 1"  		
		REPORT=""
		DETAILGRID="spSTKarenca @action = 5, @robaid = @@id"
		CMD1CAPTION="Pokaži:POKAZI" 
		CMD2CAPTION="Dodaj:DODAJ" 
		CMD3CAPTION="AŽuriranje:AZUR" 
		CMD4CAPTION="Tip karence:TIPKARENCE"
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		MASTERDBLCLICK="FORM3"
	        POPUPMASTER=""> 

 

  <NAME>Karenca</NAME>
  <CAPTION>Karenca</CAPTION>


	<POKAZI
			ONSUBMIT="spSTKarenca @action = 1 " 
		FILLEXPLORER="TRUE" >
</POKAZI>


	<DODAJ
		 
			FILLEXPLORER=""
			WIDTH="7000"
			ONSUBMIT=""
			ONLOAD="Select naziv as roba from roba where robaid = @@id"
			HEIGHT="5000"
			CAPTION="Ažuriranje karence"
			FOCUS=""
		>

		<INPUT TYPE="search" NAME="robaid" 	CAPTION="Lijek*" TOP="500" LEFT="1000" WIDTH="4998"  ALLOWEMPTY="FALSE" ENABLED="TRUE" STYLE="1" HEIGHT="280"
			   SQL="spSTRobazaSKL @trazi = '@@searchboxrobaid',  @klasa='lijek'"
		 ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid#if @@robaid is not null begin exec spSTDajArtikal @robaId = @@robaid, @vp=0 end#select naziv as roba from roba where robaid = @@robaid#select 'refresh' as roba" />
		<INPUT TYPE="grid"
		NAME="karenca"
		TOP="1200"
		LEFT="200"
		WIDTH="6600"
		HEIGHT="2000"
		CHECKBOXVISIBLE="TRUE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS="Dana1200"
		ONCELLEDITED="spSTKarenca @action = 6 , @sttipkarenceid = @@karenca, @robaid = @@robaid, @dana = @(karenca..Dana1200) "
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION=""
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="spSTKarenca @action = 4" />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3900" LEFT="1300" WIDTH="1106" HEIGHT="322" ONCLICK="OK"  />
	</DODAJ>


	<AZUR
		 
			FILLEXPLORER=""
			WIDTH="7000"
			ONSUBMIT=""
			ONLOAD="Select naziv as roba from roba where robaid = @@id"
			HEIGHT="5000"
			CAPTION="Ažuriranje karence"
			FOCUS=""
		>

		<INPUT TYPE="text" NAME="roba" 	CAPTION="Lijek*" TOP="500" LEFT="1000" WIDTH="4998"  ALLOWEMPTY="FALSE" ENABLED="FALSE" STYLE="1" HEIGHT="280"
			   SQL="spSTRobazaSKL @trazi = '@@searchboxrobaid',  @klasa='lijek'"/>


		<INPUT TYPE="grid"
		NAME="karenca"
		TOP="1200"
		LEFT="200"
		WIDTH="6600"
		HEIGHT="2000"
		CHECKBOXVISIBLE="TRUE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS="Dana1200"
		ONCELLEDITED="spSTKarenca @action = 6 , @sttipkarenceid = @@karenca, @robaid = @@ID, @dana = @(karenca..Dana1200) "
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION=""
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="spSTKarenca @action = 4, @robaid = @@id" />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3900" LEFT="1300" WIDTH="1106" HEIGHT="322" ONCLICK="OK"  />
	</AZUR>



	<TIPKARENCE
		 
			FILLEXPLORER=""
			WIDTH="6000"
			ONSUBMIT=""
			ONLOAD=""
			HEIGHT="5000"
			CAPTION="Ažuriranje tipova karence"
			FOCUS="stfarmeid"
		>



		<INPUT TYPE="grid"
		NAME="tipkarence"
		TOP="700"
		LEFT="200"
		WIDTH="6600"
		HEIGHT="3000"
		CHECKBOXVISIBLE="TRUE"
		TOTALROWVISIBLE="FALSE"
			EDITCOLUMNS=""
		GROUPBYBOXVISIBLE="FALSE"
		CAPTION=""
		REFRESHAFTERCHILD="TRUE"
		VISIBLE="TRUE"
		SQL="select STTipKarenceid, opis as [Tip karence4500] from STTipKarence" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Dodaj"  TOP="3900" LEFT="300" WIDTH="1106" HEIGHT="322" ONCLICK=":TIPDODAJ#OK"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Izmjeni"  TOP="3900" LEFT="1700" WIDTH="1106" HEIGHT="322" ONCLICK=":TIPIZMJENI#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Obriši"  TOP="3900" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK=":TIPBRISI#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3900" LEFT="4300" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</TIPKARENCE>


	<TIPDODAJ
	  WIDTH="8000"
	  ONSUBMIT="insert STTipkarence (opis) values('@@opis')"
	  ONLOAD=""
	  HEIGHT="2500"
	  CAPTION="Novi unos "
	  BORDERSTYLE="3"
	  CMD1CAPTION="Spremi"
	  CMD2CAPTION="Odustani"
	  CMD3CAPTION=""
	  CHILDFORM="">


		<INPUT TYPE="text" NAME="opis" 	CAPTION="Tip karence*" TOP="500" LEFT="1500" WIDTH="4998"  ALLOWEMPTY="FALSE" HEIGHT="280"
			   SQL=""
		 ONLOSTFOCUS=""
		BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>

	</TIPDODAJ>

	<TIPIZMJENI
		  WIDTH="8000"
		  ONSUBMIT="update STTipkarence set opis= '@@opis' where STTipkarenceid = @@tipkarence"
		  ONLOAD="select * from STTipkarence where STTipkarenceid = @@tipkarence"
		  HEIGHT="2500"
		  CAPTION="Izmjena"
		  BORDERSTYLE="3"
		  CMD1CAPTION="Spremi"
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  CHILDFORM="">


		<INPUT TYPE="text" NAME="opis" 	CAPTION="Tip karence*" TOP="500" LEFT="1500" WIDTH="4998"  ALLOWEMPTY="FALSE" HEIGHT="280"
			   SQL=""
		 ONLOSTFOCUS=""
		BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>

	</TIPIZMJENI>

	<TIPBRISI
	  WIDTH="8000"
	  ONSUBMIT=""
	  ONLOAD="select * from STTipkarence where STTipkarenceid = @@tipkarence"
	  HEIGHT="2500"
	  CAPTION="BRISANJE"
	  BORDERSTYLE="3"
	  CMD1CAPTION=""
	  CMD2CAPTION=""
	  CMD3CAPTION=""
	  CHILDFORM="">


		<INPUT TYPE="text" NAME="opis" 	CAPTION="Tip karence*" TOP="500" LEFT="1500" WIDTH="4998"  ENABLED="FALSE" ALLOWEMPTY="FALSE" HEIGHT="280"
			   SQL=""
		 ONLOSTFOCUS=""
		BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
		<INPUT TYPE="button" NAME="ok"     CAPTION="Obriši"  TOP="1500" LEFT="1000" WIDTH="1106" HEIGHT="322" ONCLICK="If (select count(*) from STkarenca where STTipkarenceID = @@tipkarence) = 0 begin delete STTipKarence where STTipkarenceid = @@tipkarence end #OK"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"     CAPTION="Odustani"  TOP="1500" LEFT="3000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  HOTKEY="" />

	</TIPBRISI>


</PROJECT> 