<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTNacinOsjemenjivanja @action = 1, @operateriid= @@operateriid " 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Pokaži:POKAZI_FORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Načini osjemenjivanja"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Načini osjemenjivanja</NAME>
	<CAPTION>Načini osjemenjivanja</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTNacinOsjemenjivanja @action = 1, @operateriid= @@operateriid " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="1800" 
		 WIDTH="7700" 
		 CAPTION="Unos načina osjemenjivanja"
		 ONSUBMIT="spSTNacinOsjemenjivanja @action = 3, @operateriid= @@operateriid, "
		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"    CAPTION="Naziv:"   TABINDEX="0"  ENABLED="TRUE"  />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="1800" 
		 WIDTH="7700" 
		 CAPTION="Izmjena načina osjemenjivanja"
		 ONSUBMIT="spSTNacinOsjemenjivanja @action = 4, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from STNacinOsjemenjivanja where STNacinOsjemenjivanjaId=@@id" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"    CAPTION="Naziv:"   TABINDEX="0"  ENABLED="TRUE"  />
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="1800" 
		 WIDTH="7700" 
		 CAPTION="Brisanje načina osjemenjivanja ? Jeste li sigurni ?!"
		 ONSUBMIT="spSTNacinOsjemenjivanja @action = 5, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from STNacinOsjemenjivanja where STNacinOsjemenjivanjaId=@@id" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"    CAPTION="Naziv:"   TABINDEX="0"  ENABLED="FALSE"  />
</DELETE_FORM>

</PROJECT>