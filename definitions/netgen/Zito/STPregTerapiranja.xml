		<INPUT TYPE="number"   NAME="dana"      CAPTION="" TOP="200" LEFT="9500"  DECIMALS="0"  WIDTH="500" ONLOSTFOCUS="select 'refresh' as donost"/>
		<INPUT TYPE="label"    NAME="labeldana" CAPTION="dana" TOP="250" LEFT="10100"   />

		<INPUT TYPE="button" NAME="ok"      CAPTION="Prebaci"  TOP="9000" LEFT="456" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="FOREACHROW(donost)#if @(donost..Količina0800) > 0 begin 
					if (select dbo.fnMPAsortiman ( @(donost..robaid) , 0 , @@partneriid , @@trgovinaid) )  = 1  begin
						exec spMPInsertGlaIdetNG @action = 8,@robaid = @(donost..robaid), @id = @@id , @kolicinaulaz = @(donost..količina0800), @mpcijena = @(donost..cijena0800), @nabcijena =@(donost..Nabavna cijena 0800) , @indpakovanje = 1 
						end 
						else begin 
							exec spmpKontrolaOdabraneRobeNG @action = 11 , @robaid = @(donost..robaid)
				   end
				   end
							   #select sum(nvrijednost) as nvrijednost from mpnardet where mpnarglaid = @@id#Ok"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
