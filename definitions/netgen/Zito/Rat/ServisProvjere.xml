	<INPUT TYPE="grid" NAME="gridlokacije" TOP="1253" LEFT="403" HEIGHT="4334" WIDTH="6048" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" SQL="SELECT ps.parstruid, ps.naziv as Lokacija, p.naziv as Partner
