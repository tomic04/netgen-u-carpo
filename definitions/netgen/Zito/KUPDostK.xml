<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA="spKUPPrometQuery 5,@OperateriId=@@operateriid,@dostavnaknjigaid=1" 
   CMD1CAPTION="Pregled:FILTERFORM"    
   CMD2CAPTION="Zaprimi:ZAPFORM" 
   CMD3CAPTION="Proslijedi:MULTISELECTPROFORM"   
   POPUP="Povijest:POVFORM#Proknjiži u URU:KnjigaUra2.clsUraDoc#Preglednik:KUPPreglednik.clsKlasaP#Zaprimi i arhiviraj:ZAKFORM#Poništi arhiviranje:PONZAKFORM">
 
  <NAME>Dostavna knjiga</NAME>
  <CAPTION>Dostavna knjiga</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
   <ZAPFORM
					FILLEXPLORER="" 
					REPORT=""  
					WIDTH="9000" 
					STORA="spKUPPrometAzur 4,@ID=@@id,@OperateriId=@@operateriid" 
					STARTUPSTORA="" 
					HEIGHT="8500" 
					TOP="300" 
					CAPTION=""  
					BORDERSTYLE="3" 
					CMD1CAPTION="Odustani" 
					CMD2CAPTION="" 
					CMD3CAPTION=""
					CMD4CAPTION=""								  
					NEXTFORM=""  >
   </ZAPFORM>
   
   <MULTISELECTPROFORM
					FILLEXPLORER="" 
					REPORT=""  
					WIDTH="7000" 
					STORA="" 
					STARTUPSTORA="" 
					HEIGHT="2500" 
					TOP="300" 
					CAPTION="Proslijedi"  
					BORDERSTYLE="3" 
					CMD1CAPTION="Dalje >>" 
					CMD2CAPTION="Odustani" 							  
					NEXTFORM="PROFORM2"  >
					
					
					<KONTROLA TYPE="VB.Label" NAME="lblsvi2" TOP="250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Operater:"/>
					<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="operaterto" 
						CAPTION="operater" 
						TOP="250" 
						LEFT="1700"  
						WIDTH="2500" 
						HEIGHT="320" 
						TABINDEX="1" 
						ALLOWEMPTY="false" 
						SQL="select  * from ssoperateri where operateriid in (select distinct operateriid from kupstatusoperateri)
						     order by naziv"/>	

   </MULTISELECTPROFORM>
   
   
   <PROFORM2
   					FILLEXPLORER="" 
					REPORT=""  
					WIDTH="7000" 
					STORA="spKUPPrometAzur @action = 3,@ID=@@id,@OperateriIdFrom=@@operateriid,@OperateriIdTo=@@operaterto,@KupStatusId=@@KUPStatusId,@orgshemaid=@@orgshemaid" 
					STARTUPSTORA="select @@operaterto" 
					HEIGHT="2500" 
					TOP="300" 
					CAPTION="Proslijedi"  
					BORDERSTYLE="3" 
					CMD1CAPTION="Proslijedi" 
					CMD2CAPTION="Odustani" 							  
					NEXTFORM="">
					
                    <KONTROLA TYPE="VB.Label" NAME="lblsvi2" TOP="250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Operater:"/>
					<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="operaterto" 
						CAPTION="_operater" 
						TOP="250" 
						LEFT="1700"  
						WIDTH="2500" 
						HEIGHT="320" 
						TABINDEX="1" 
						ALLOWEMPTY="false" 
						ENABLED="FALSE"
						SQL="select operateriid,naziv from ssoperateri where operateriid=@@operaterto"/>
					
					<KONTROLA TYPE="VB.Label" NAME="lblsvi" TOP="750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Status:"/>
					<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="KUPStatusId" 
						CAPTION="_status" 
						TOP="750" 
						LEFT="1700"  
						WIDTH="4000" 
						HEIGHT="320" 
						TABINDEX="0" 
						ALLOWEMPTY="false"
						ENABLED="TRUE"									
						SQL="select s.kupstatusid,s.opis as naziv 
                             from kupstatus s inner join kupstatusoperateri o on s.kupstatusid=o.kupstatusid
                             where o.operateriid =@@operaterto 
					         order by s.korak" />
							 
					<KONTROLA TYPE="VB.Label" NAME="lblorg" TOP="750" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Status:"/>
						<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                    NAME="orgshemaid" 
                                	CAPTION="_orgshemaid" 
                               		TOP="7750" 
                            		LEFT="1700"  
                                    WIDTH="4000" 
                                 	HEIGHT="320" 
                                  	TABINDEX="0" 
                              		ALLOWEMPTY="false"                                    								
                            		SQL="select kupstatusid as naziv
						               from kupprometlog 
									   where kupprometlogid in 
									     (select max(kupprometlogid) from kupprometlog where kupprometid=@@id group by kupprometid)"/>				 
										 
											
   </PROFORM2>
   
   <POVFORM
   					FILLEXPLORER="" 
					REPORT=""  
					WIDTH="9000" 
					STORA="" 
					STARTUPSTORA="" 
					HEIGHT="8500" 
					TOP="300" 
					CAPTION="Povijest"  
					BORDERSTYLE="3" 
					CMD1CAPTION="Odustani" 
					CMD2CAPTION="" 
					CMD3CAPTION=""
					CMD4CAPTION=""								  
					NEXTFORM=""  
					CHILDFORM=""
					REFRESHAFTERCHILD="">

					<KONTROLA TYPE="GridEX20.GridEX" 
						NAME="Povijest" 
						REFRESHAFTERCHILD="TRUE" 
						CAPTION="povijest" 
						TOP="250" 
						LEFT="200"  
						WIDTH="8500" 
						HEIGHT="7200" 
						TABINDEX="0" 
						SQL="spKUPPrometQuery @action=2,@ID=@@id" />
</POVFORM>
   
  
   <FILTERFORM 
					FILLEXPLORER="TRUE" 
					REPORT=""  
					WIDTH="8000" 
					STORA="spKUPPrometQuery @action = 3,@OperateriId=@@operateriid,@dostavnaknjigaid=1, " 
					STARTUPSTORA="SELECT null" 
					HEIGHT="3500" 
					CAPTION="Izaberi uvjete traženja"  
					BORDERSTYLE="3" 
					CMD1CAPTION="Pokaži" 
					CMD2CAPTION="Odustani" 
					CMD3CAPTION=""  
					NEXTFORM=""  >
								  
					<KONTROLA TYPE="VB.Label" 
                                    	NAME="lblprijemod" 
                                      	TOP="250" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
					<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumprijemaod" 
                                   	TOP="250" 
                                   	LEFT="1700" 
                                    	CAPTION="prijem od" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="0" 
                                    	CHECKBOX="FALSE"/>
										
					<KONTROLA TYPE="VB.Label" 
						NAME="lblprijemdo" 
						TOP="250" 
						LEFT="3500" 
						WIDTH="1500" 
						HEIGHT="320" 
						CAPTION="-"/>
                     	
					<KONTROLA TYPE="MSComCtl2.DTPicker" 
						NAME="datumprijemado" 
						TOP="250" 
						LEFT="4000" 
						CAPTION="prijemdo" 
						VALUE="DATE" 
						HEIGHT="320" 
						WIDTH="1500" 
						TABINDEX="1" 
						CHECKBOX="FALSE"/>		  

					<KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="750" LEFT="200" WIDTH="1500" CAPTION="Partner"/> 
					<KONTROLA TYPE="TRAZILICA" 
						CAPTION="Partner" 
						NAME="partneriid" 
						SQL="Partneri#partneriid#%naziv%" 
						TOP="750" 
						LEFT="1700" 
						TEXT=""
						TABINDEX="2" 
						WIDTH="4500" 
						HEIGHT="320"/>                 																	
							
					<KONTROLA TYPE="VB.Label" NAME="lblzaprimljen" TOP="1250" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Zaprimljeno:"/>
					<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="DAid" 
						CAPTION="zaprimljeno" 
						TOP="1250" 
						LEFT="1700"  
						WIDTH="2500" 
						HEIGHT="320" 
						TABINDEX="4" 
						ALLOWEMPTY="true" 
						SQL="select 0 as Daid,'Nezaprimljeni-0'as Naziv
										union all
										select 1 as Daid ,'Zaprimljeni - 1' as Naziv
										union all
										select 2 as Daid ,'Arhivirani - 2' as Naziv"/> 
  </FILTERFORM>
  
  <ZAKFORM
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="9000" 
                         STORA="spKUPPrometAzur 10,@ID=@@id,@operateriid=@@operateriid" 
                         STARTUPSTORA="" 
                         HEIGHT="8500" 
			             TOP="300" 
                         CAPTION=""  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="" 
                                  CMD3CAPTION=""
                                  CMD4CAPTION=""								  
                                  NEXTFORM=""  
                                  CHILDFORM=""
								  REFRESHAFTERCHILD="">

				       
									
																	                 	
 
   </ZAKFORM>
   
   <PONZAKFORM
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="9000" 
                         STORA="spKUPPrometAzur 11,@ID=@@id,@operateriid=@@operateriid" 
                         STARTUPSTORA="" 
                         HEIGHT="8500" 
			             TOP="300" 
                         CAPTION=""  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="" 
                                  CMD3CAPTION=""
                                  CMD4CAPTION=""								  
                                  NEXTFORM=""  
                                  CHILDFORM=""
								  REFRESHAFTERCHILD="">

				       
									
																	                 	
 
   </PONZAKFORM>

</PROJECT>