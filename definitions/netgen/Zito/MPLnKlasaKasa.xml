<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   TREE="spTreeKlasaKasa:FILTERKLASAFORM" 
   DETAILGRID=""
   FILLEXPLORER="TRUE" 
	 BUTTONS="Odaberi trgovinu:FILTERFORM#Rasporedi označene:MULTISELECTAKTIVIRAJ#Vrati u neraspoređeno:MULTISELECTDEAKTIVIRAJ"
   CMD1CAPTION=""    
   CMD2CAPTION="" 
   CMD6CAPTION=""
   CMD4CAPTION=""
   CMD3CAPTION=""
   CMD5CAPTION=""
   CHECKBOXVISIBLE="TRUE"
   TOTALROWVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK=""
   CAPTION=""
    PAGEHEADERLEFT=""
    PAGEHEADERRIGHT="@@tkosmomi"
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">

	<NAME>Ažuriranje robe za klase na kasi  </NAME>
  <CAPTION>Ažuriranje robe za klase na kasi</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MH 19.08.2013.  </AUTOR>

	<FILTERKLASAFORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPKlasaKasa @action=6, @mpklasakasaid='@@node', @trgovinaid = @@trgovinaid" />

	<FILTERFORM
				   WIDTH="8000" 
				   ONSUBMIT="spMPKlasaKasa @action = 5, " 
				   FILLEXPLORER="TRUE" 
				   ONLOAD="spMPKlasaKasa @action=99" 
				   FOCUS="trgovinaid" 
				   HEIGHT="2500" 
				   CAPTION="Odaberite trgovinu"  
				   CMD1CAPTION="Pokaži" 
				   CMD2CAPTION="Izlaz" 
		 >
    
		<INPUT TYPE="combo" NAME="trgovinaid" TOP="300" LEFT="1500" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" CAPTION="Trgovina*" 
           SQL="spMPDajTrgovinaNG @action = 1, @operateriid = @@operateriid, @komis=0" 
           ONLOSTFOCUS="select 'Ažuriranje robe za trgovinu ' + rtrim(opis) as caption from trgovina where trgovinaid=@@trgovinaid"/>

	</FILTERFORM>



	<MULTISELECTAKTIVIRAJ NAME="MULTISELECTAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
		CAPTION="Označenu robu stavi u klasu:"
		ONSUBMIT=""
		ONLOAD=""
    ONLOADED=""
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION=""
		>

    <INPUT TYPE="combo" NAME="mpklasakasaid" TOP="500" LEFT="1000" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" CAPTION="Klasa kase*"
           SQL="spMPKlasaKasa @action = 1, @operateriid = @@operateriid" ONLOSTFOCUS=""/>
    
		<INPUT TYPE="grid"
		      NAME="akt"
		      TOP="1000"
		      LEFT="200"
		      WIDTH="7000"
		      HEIGHT="4500"
		      CHECKBOXVISIBLE="FALSE"
		      TOTALROWVISIBLE="FALSE"
			      EDITCOLUMNS=""
		      GROUPBYBOXVISIBLE="FALSE"
		      CAPTION="Aktiviranje narudžbe robe"
		      REFRESHAFTERCHILD="TRUE"
		      VISIBLE="TRUE"
		      SQL="exec spMPKlasaKasa @action = 7 , @operateriid = @@operateriid " />
    
		<INPUT TYPE="button" NAME="ok"     CAPTION="Spremi"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spMPKlasaKasa @action = 8, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid, @mpklasakasaid = @@mpklasakasaid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</MULTISELECTAKTIVIRAJ>

	<MULTISELECTDEAKTIVIRAJ NAME="MULTISELECTDEAKTIVIRAJ" HEIGHT="7197" WIDTH="7501"
        	CAPTION="Označenu robu stavi u neraspoređeno"
		      ONSUBMIT=""
		      ONLOAD=""
          ONLOADED=""
		     FILLEXPLORER=""
		     CMD1CAPTION=""
		     CMD2CAPTION=""
		>
    <INPUT TYPE="grid"
		      NAME="akt"
		      TOP="1000"
		      LEFT="200"
		      WIDTH="7000"
		      HEIGHT="4500"
		      CHECKBOXVISIBLE="FALSE"
		      TOTALROWVISIBLE="FALSE"
			      EDITCOLUMNS=""
		      GROUPBYBOXVISIBLE="FALSE"
		      CAPTION="Aktiviranje narudžbe robe"
		      REFRESHAFTERCHILD="TRUE"
		      VISIBLE="TRUE"
		      SQL="exec spMPKlasaKasa @action = 77 , @operateriid = @@operateriid " />

    <INPUT TYPE="button" NAME="ok"     CAPTION="Spremi"  TOP="5900" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="EXEC spMPKlasaKasa @action = 9, @operateriid = @@operateriid, @trgovinaid = @@trgovinaid, @mpklasakasaid = @@gridaktMPKlasaKasaid  #Ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5900" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </MULTISELECTDEAKTIVIRAJ>




	<DEAKTIVIRAJ NAME="AKTIVIRAJ" HEIGHT="3197" WIDTH="5501" 
		CAPTION="Deaktivirati asortiman ?" 
		ONSUBMIT="spMPParAsortimanPregledNG @action=8, @partneriid = @@node, "
		ONLOAD="if (select count(*) from parasortiman where partneriid = @@node) = 0 begin 
					exec spRaiserror 69001, 'Nema stavaka asortimana! Ne možete aktivirati' end 
					else begin 
						select naziv as asort from partneri where partneriid = @@node
					end" 
		 FILLEXPLORER="" 	
		 CMD1CAPTION="Dektiviraj" 
		 CMD2CAPTION="Odustani" 
		>
		<INPUT TYPE="text"  NAME="asort" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" TABINDEX="1" ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Asortiman dobavljača :" />
		<INPUT TYPE="checkbox" NAME="doduMP"  CAPTION="Deaktiviraj u asortimanu MP" TOP="900" LEFT="2300"    />
		<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite deaktivirati asortiman? " />
	</DEAKTIVIRAJ>

</PROJECT>
 
