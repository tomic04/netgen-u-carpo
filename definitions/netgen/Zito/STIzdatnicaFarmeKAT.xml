<ZAKLJUCI NAME="ZAKLJUCI" HEIGHT="3197" WIDTH="5501" 
		CAPTION="Zaključiti dokument ?" 
		ONSUBMIT="if (select COUNT(*) from sktprometdet where sktprometglaid = @@id ) = 0 begin 
                        raiserror 19001 'Nema stavaka na dokumentu. Ne možete ga zaključiti !' 
						end
						else begin
                        update sktprometgla set status = 2 where sktprometglaid = @@id
						raiserror 19001 'Dokument je zaključen !'
					end"
		ONLOAD="if (select status from sktprometgla where sktprometglaid= @@ID ) > 1 begin 
                        raiserror 19001 'Dokument je već zaključen. Ne može se više zaključiti !' 
						end
						else begin
                        exec spSTSktQueryGlaIDetNG @action=3,@ID=@@ID
					end" 
		ONLOADS="exec spSTSktQueryGlaIDetNG @action=3,@ID=@@ID" 
		 FILLEXPLORER="" 	
		 CMD1CAPTION="Zaključi" 
		 CMD2CAPTION="Odustani" 
		>
			<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" TABINDEX="1" ENABLED="FALSE"/>
			<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Broj izdatnice:" />
			<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? " />
</ZAKLJUCI>

