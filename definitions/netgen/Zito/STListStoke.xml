<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 ONLOAD=":FILTER_FORM"
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 BUTTONS="Uvjeti:FILTER_FORM#Ispis liste:PRINTMASTER" 
		 CMD6CAPTION=""
		 INCLUDE="" 
		 POPUPMASTER=""
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname', @sifradok='504', @trazi = 'dijagn'" 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT=""
		 PAGEHEADERCENTER="LIST STOKE"
		 PAGEHEADERRIGHT="Farma: @@comboboxstfarmeid"
		 PAGEHEADERLEFT="Od @@datumod do @@datumdo"
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="LANDSCAPE">


	<NAME>LIST STOKE</NAME>
	<CAPTION>LIST STOKE</CAPTION>
	<AUTOR>23.4.2009. kč </AUTOR>




	<FILTER_FORM HEIGHT="3000" WIDTH="7000"
			 CAPTION="Upišite uvjete prikaza"
			 ONSUBMIT="spStListStoke @action = 1, @operateriid = @@operateriid,"
			 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo , @@farmeid as farmeid" 
			 FILLEXPLORER="TRUE">

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od *" TOP="300" LEFT="1000" WIDTH="1400" HEIGHT="280" SQL=""/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do *" TOP="300" LEFT="3500" WIDTH="1400" HEIGHT="280" SQL=""/>
		<INPUT TYPE="combo" NAME="stfarmeid" TOP="800" LEFT="1000" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="TRUE" CAPTION="Farma*" ONLOSTFOCUS=""/>
		<INPUT TYPE="button" NAME="ok"         TOP="2000" LEFT="1000" CAPTION="Pokaži"   ONCLICK="ok" />
		<INPUT TYPE="button" NAME="cancel"     TOP="2000" LEFT="2500" CAPTION="Odustani"   ONCLICK="close" />
	</FILTER_FORM>



	



</PROJECT>