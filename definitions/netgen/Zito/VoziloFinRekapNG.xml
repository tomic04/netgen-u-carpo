<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Uvjeti:FILTERFORM" 
		 CMD2CAPTION="Analitička kartica:KARTICAFORM"
		 CMD3CAPTION="Sintetička kartica:SINKARTICAFORM" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="Ispis liste:PRINTREPXMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="TRUE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 ONLOAD2="" 
		 REPORT=""
		SETDEFAULTS="select naziv as firma from jupitersystem..firme where dbonaziv=db_name() "
		PAGEHEADERLEFT="#ISEMPTY(@@combo1)# @@comboboxcombo1  # TIP: @@comboboxcombo1  !! #ISEMPTY(@@DatumOd )# # Datum od: @@DatumOd !! # ISEMPTY(@@DatumOd )# # Datum do: @@Datumdo"  PAGEHEADERRIGHT="Firma: @@firma"
		COMMANDTIMEOUT ="10000">
		


	<NAME>Rekapitulacija troškova strojeva</NAME>
	<CAPTION>Rekapitulacija troškova strojeva</CAPTION>
	

<FILTERFORM NAME="FILTERFORM" 
		 HEIGHT="2880" 
		 WIDTH="7085" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spVoziloKarticaFinsum @action=0,"
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@combo1 as combo1" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" >
		 <INPUT TYPE="date"   NAME="datumod"  CAPTION="Datum od:" DEFAULT="firstdayofmonth"/>
		 <INPUT TYPE="date"   NAME="datumdo"  CAPTION="Datum do:" />
		 <INPUT TYPE="combo"  NAME="combo1" 	CAPTION="Tip stroja:" ALLOWEMPTY="TRUE" SQL="select voztipid, tip as naziv from voztip order by sortkey"  />
		 <INPUT TYPE="check"  NAME="check1" 	CAPTION="Prikaži stavke bez troškova u periodu" />

</FILTERFORM>


<KARTICAFORM NAME="KARTICAFORM" 
		 HEIGHT="8453" 
		 WIDTH="12254" 
		 CAPTION="Analitička Kartica vozila" 
		 STARTUP=""
		 ONLOAD="select o.invbroj from vozilo t
			left outer join osimovina o on t.osimovinaid=o.osimovinaid
			 where t.voziloid=@@ID" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM="">
		<INPUT TYPE="grid"   NAME="combo1" TOP="86" LEFT="86"
		 HEIGHT="7272" WIDTH="11981" CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE" SQL="spVoziloKarticaFin @action=0, @datumod=@@datumod,@datumdo=@@datumdo,@trazilica2=@@ID" 
		PAGEHEADERLEFT="Inv. broj: @@invbroj !!Datum od: @@DatumOd !!Datum do: @@Datumdo"  PAGEHEADERRIGHT="Firma: @@firma" />
		<INPUT TYPE="button" NAME="ButtonNG64" TOP="7550" LEFT="200" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG75" CAPTION="Zatvori" TABINDEX="17" ONCLICK="CLOSE"/>
		<INPUT TYPE="button" NAME="ButtonNG64" TOP="7550" LEFT="1800" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG75" CAPTION="Ispiši" TABINDEX="17" ONCLICK="PRINTREPXGRID(combo1)"/>
		<INPUT TYPE="text"   NAME="invbroj" VISIBLE="FALSE" />
</KARTICAFORM>

<SINKARTICAFORM NAME="SINKARTICAFORM" 
		 HEIGHT="8453" 
		 WIDTH="12254" 
		 CAPTION="Sintetička Kartica vozila" 
		 STARTUP=""
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM="">
		<INPUT TYPE="grid"   NAME="combo1" TOP="86" LEFT="86"
		PAGEHEADERLEFT="Inv. broj: @@invbroj !!Datum od: @@DatumOd !!Datum do: @@Datumdo"  PAGEHEADERRIGHT="Firma: @@firma"
		 HEIGHT="7272" WIDTH="11981" CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE" SQL="spVoziloKarticaFin @action=1, @datumod=@@datumod,@datumdo=@@datumdo,@trazilica2=@@ID"  />
		<INPUT TYPE="button" NAME="ButtonNG64" TOP="7550" LEFT="200" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG75" CAPTION="Zatvori" TABINDEX="17" ONCLICK="CLOSE"/>
		<INPUT TYPE="button" NAME="ButtonNG64" TOP="7550" LEFT="1800" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG75" CAPTION="Ispiši" TABINDEX="17" ONCLICK="PRINTREPXGRID(combo1)"/>
		<INPUT TYPE="text"   NAME="invbroj" VISIBLE="FALSE" />
		
</SINKARTICAFORM>


</PROJECT>




 