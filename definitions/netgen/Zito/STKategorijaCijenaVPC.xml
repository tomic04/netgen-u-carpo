	CMD6CAPTION=""
	INCLUDE=""
	POPUPMASTER=""
	POPUPDETAIL=""
	TREE="spstTreeNG @action = 7, @vrsta = '@@vrsta':FILTERODDO_FORM	"
	GROUPBYBOXVISIBLE="TRUE"
	FROZENCOLUMNS="0"
	AUTOFITCOLUMNS="False"
	CHECKBOXVISIBLE="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	DETTOTALROWVISIBLE="FALSE"
	SETDEFAULTS=""
	 ONLOAD2=""
  REPORT=""
	PAGEHEADERCENTER="Kategorija - Cijena "
	PAGEHEADERRIGHT=""
	PAGEHEADERLEFT=""
	PAGEFOOTERCENTER=""
	PAGEFOOTERLEFT=""
	PAGEFOOTERRIGHT="@@tkosmomi"
	PAGEORIENTATION="LANDSCAPE">


  <MASTERCOLUMNS>
    <COLUMN INDEX="" NAME="Težina od1200" WIDTH="1200" CAPTION="" FORMAT="#,##0.##0" VISIBLE="" AGREGATEFUNCTION="3" />
    <COLUMN INDEX="" NAME="Težina do1200" WIDTH="1200" CAPTION="" FORMAT="#,##0.##0" VISIBLE="" AGREGATEFUNCTION="3" />
    <COLUMN INDEX="" NAME="Velep. cijena1200" WIDTH="1200" CAPTION="" FORMAT="#,##0.###" VISIBLE="" AGREGATEFUNCTION="3" />

  </MASTERCOLUMNS>
  
  
	<NAME>Interni cjenik stoke VPC</NAME>
	<CAPTION>Interni cjenik stoke VPC</CAPTION>
  <AUTOR>26.03.2013. matija horvat</AUTOR>

	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spSTKategorijaCijene @action = 22 , @node = @@node" />

	<FILTER_FORM HEIGHT="3000" WIDTH="7000"
			 CAPTION="Odaberite vrstu stoke ZA koju želte ažurirati cjene"
			 ONSUBMIT=""
			 ONLOAD=""
			 FILLEXPLORER="Treeandrefreshmaster">

		<INPUT TYPE="combo" NAME="Vrsta"	TOP="800" LEFT="1000" ONCLICK="" SQL="spSTDajVrsta @operateriid = @@operateriid " ALLOWEMPTY="FALSE" CAPTION="Vrsta stoke*" ONLOSTFOCUS=""/>
		<INPUT TYPE="button" NAME="ok"         TOP="2000" LEFT="1000" CAPTION="Pokaži"   ONCLICK="#OK" />
		<INPUT TYPE="button" NAME="cancel"     TOP="2000" LEFT="2500" CAPTION="Odustani"   ONCLICK="close" />
	</FILTER_FORM>



	<DODAJ NAME="DODAJ"
		HEIGHT="5300" WIDTH="7502"
		CAPTION="Unos cjenika"
		FOCUS="datumod"
		ONLOAD="select '@@lnstkategorijaskupinaid' as kljuc, @@id as vrstadokid "
			   
		>
    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="3200"  ENABLED="TRUE"/>
    <INPUT TYPE="text"   NAME="kljuc"         CAPTION="" TOP =" -3000" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL=""/>
    <INPUT TYPE="label"   NAME="info"         CAPTION="*Ostavite praznu težinsku kategoriju za pridjeljivanje cjenika svim težinskim kategorijama" SIZE="7" TOP="3900" LEFT="200" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="label"   NAME="info2"         CAPTION=" koje pripadaju odabranoj farmi." SIZE="7" TOP="4100" LEFT="250" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="label"   NAME="info3"         CAPTION="**Ostavite prazan spol za pridjeljivanje cjenika MUŠKOM i ŽENSKOM spolu." SIZE="7" TOP="4400" LEFT="200" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="label"   NAME="label1"         CAPTION="*" SIZE="7" TOP="2000" LEFT="4400" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="label"   NAME="label2"         CAPTION="**" SIZE="7" TOP="2400" LEFT="4400" HEIGHT="317" ENABLED="TRUE"/>
    
    
    <INPUT TYPE="combo"   NAME="stfarmeid"         CAPTION="Farma*" TOP="400" LEFT="1900" HEIGHT="317" WIDTH="3500"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid" ONLOSTFOCUS="select 'refresh' as STTezinskaKategorijaid"/>
		<INPUT TYPE="Date"   NAME="datumod"         CAPTION="Vrijedi od*" TOP="800" LEFT="1900" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="Date"   NAME="datumdo"         CAPTION="Vrijedi do*" TOP="1200" LEFT="1900" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="combo"   NAME="lnstkategorijaskupinaid"         CAPTION="Kategorija*" TOP="1600" LEFT="1900" HEIGHT="317" WIDTH="3500"  STYLE="1" ENABLED="TRUE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije where vrsta = 'G'"/>
    <INPUT TYPE="combo"   NAME="STTezinskaKategorijaid"         CAPTION="Težinska kategorija (kg)*" TOP="2000" LEFT="1900" HEIGHT="317" WIDTH="2500" ALLOWEMPTY="TRUE"  STYLE="1" ENABLED="TRUE" SQL="spSTKategorijaKG @action = 11, @stfarmeid = @@stfarmeid"/>
    <INPUT TYPE="combo" NAME="stspolteletaid" CAPTION="Spol*" TOP="2400" LEFT="1900" WIDTH="2500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select stspolteletaid ,opis as naziv from stspolteleta"  />
    <INPUT TYPE="button" NAME="add"        CAPTION="Dodaj težinsku kategoriju" TOP="2000" LEFT="4600" WIDTH="2200" HEIGHT="322" ONCLICK=":DODAJ_TEZINU#select 'refresh' as STTezinskaKategorijaid"  />

    <INPUT TYPE="number" NAME="VPC" CAPTION="Velep. cijena*"  TOP="2800" LEFT="1900" HEIGHT="302" WIDTH="1206"  DECIMALS="4" ENABLED="TRUE" />

    <INPUT TYPE="picturebox" NAME="pic5" LOCATION="c:\st_frame.png" TOP="3200" LEFT="100" WIDTH="7000" HEIGHT="600" CAPTION="" ONCLICK="" TABINDEX="-1" />
    
    <INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3400" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaCijene  @action = 33, @operateriid = @@operateriid,  @lnstkategorijaskupinaid = @@lnstkategorijaskupinaid, 
                   @STTezinskaKategorijaid = @@STTezinskaKategorijaid, @vpc = @@vpc, @datumod = @@datumod, @datumdo = @@datumdo, 
                   @stfarmeid = @@stfarmeid, @stspolteletaid = @@stspolteletaid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3400" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DODAJ>


	<IZMJENI NAME="IZMJENI"
		HEIGHT="4500" WIDTH="7502"
		CAPTION="Izmjena cjenika"
		FOCUS="datumod"
		ONLOAD="if  @@id = 0 begin
                raiserror 19001 ' Niste odabrali cjenik kojeg želite ispraviti !'
		        end
            else begin
                select * from stKategorijeCijeneVPC where stKategorijeCijeneVPCid = @@stKategorijeCijeneVPCid
           end"
    >
    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="3200"  ENABLED="TRUE"/>
    <INPUT TYPE="text"   NAME="kljuc"         CAPTION="" TOP =" -3000" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL=""/>
    

    <INPUT TYPE="combo"   NAME="stfarmeid"         CAPTION="Farma*" TOP="400" LEFT="1900" HEIGHT="317" WIDTH="3500"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid" ONLOSTFOCUS="select 'refresh' as STTezinskaKategorijaid"/>
    <INPUT TYPE="Date"   NAME="datumod"         CAPTION="Vrijedi od*" TOP="800" LEFT="1900" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="Date"   NAME="datumdo"         CAPTION="Vrijedi do*" TOP="1200" LEFT="1900" HEIGHT="317" ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="lnstkategorijaskupinaid"         CAPTION="Kategorija*" TOP="1600" LEFT="1900" HEIGHT="317" WIDTH="3500"  STYLE="1" ENABLED="TRUE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije where vrsta = 'G'"/>
    <INPUT TYPE="combo"   NAME="STTezinskaKategorijaid"         CAPTION="Težinska kategorija (kg)*" TOP="2000" LEFT="1900" HEIGHT="317" WIDTH="2500" ALLOWEMPTY="TRUE"  STYLE="1" ENABLED="TRUE" SQL="spSTKategorijaKG @action = 11, @stfarmeid = @@stfarmeid"/>
    <INPUT TYPE="combo" NAME="stspolteletaid" CAPTION="Spol*" TOP="2400" LEFT="1900" WIDTH="2500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select stspolteletaid ,opis as naziv from stspolteleta"  />
    
    <INPUT TYPE="number" NAME="VPC" CAPTION="Velep. cijena*"  TOP="2800" LEFT="1900" HEIGHT="302" WIDTH="1206"  DECIMALS="4" ENABLED="TRUE" />

    <INPUT TYPE="picturebox" NAME="pic5" LOCATION="c:\st_frame.png" TOP="3200" LEFT="100" WIDTH="7000" HEIGHT="600" CAPTION="" ONCLICK="" TABINDEX="-1" />

    <INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3400" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaCijene  @action = 44, @id = @@id, @operateriid = @@operateriid,  @STTezinskaKategorijaid = @@STTezinskaKategorijaid,
                  @lnstkategorijaskupinaid = @@lnstkategorijaskupinaid, @vpc = @@vpc, @datumod = @@datumod, @datumdo = @@datumdo, 
                  @stfarmeid = @@stfarmeid, @stspolteletaid = @@stspolteletaid #Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3400" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</IZMJENI>


  <PRAZNINE NAME="PRAZNINE"
      HEIGHT="11000" WIDTH="8502"
      CAPTION="Provjera nedefiniranih razdoblja VPC cjenika"
      ONLOAD=""
      ONLOADED="SELECT 'invisible' as prazninegrid"
		>
    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="8000" HEIGHT="1300"  ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="stfarme1id"         CAPTION="Farma" HEIGHT="317" WIDTH="4997"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
    
    <INPUT TYPE="combo"   NAME="lnstkategorijaskupina1id"         CAPTION="Kategorija" HEIGHT="317" WIDTH="4997"  STYLE="1" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije"/>
    
    <INPUT TYPE="label"   NAME="info"         CAPTION="*Prikaz svih nedefiniranih razdoblja razvrstanih po farmi, težinskoj kategoriji i spolu od 1.12.2012." SIZE="7" TOP="1600" LEFT="2750" HEIGHT="317" ENABLED="TRUE"/>
    
    <INPUT TYPE="button" NAME="pokazi"            CAPTION="Traži "  TOP="1500" LEFT="200" WIDTH="1106"  HEIGHT="322"
					ONCLICK="select 'refresh' as prazninegrid#select 'visible' as prazninegrid"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"        CAPTION="Zatvori" TOP="1500" LEFT="1600" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



    <INPUT TYPE="grid"
				   NAME="prazninegrid"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="2000" LEFT="100" WIDTH="8100" HEIGHT="8380"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTKategorijaCijene  @action = 55, @lnstkategorijaskupinaid = @@lnstkategorijaskupina1id, @stfarmeid = @@stfarme1id" 
    />
    
    
    
    
    
    
    
  </PRAZNINE>

	<KATEGORIJACIJENA
		  FILLEXPLORER=""
		  MAXIMIZEBOX="TRUE"
		  DETAILGRID = ""
		  WIDTH="21500"
		  ONSUBMIT=""
		  ONLOAD=""
		  ONLOADED="select 'refresh' as xprepter, 'refresh' as xterap"
		  ONLOAD2=""
		  HEIGHT="11600"
		  CAPTION="Ažuriranje cijena kategorija stoke "
		  BORDERSTYLE="3"
		  FOCUS="glava"
		  CMD1CAPTION=""
		  CMD2CAPTION=""
		  CMD3CAPTION=""
		  REFRESHAFTERCHILD="TRUE" >

		
		<!--
		<INPUT TYPE="check" NAME="Sve" CAPTION="Sve terapije" TOP="8400" LEFT="9500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="select null as xprepter, 'refresh' as xterap"/>
                -->
		
        <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8700" LEFT="1500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="close"/>
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="KAtegorije - skupine grla" TOP="500"   LEFT="56"   WIDTH="14050" HEIGHT="3800"   />
		<INPUT TYPE="frame"  NAME="fr2"         CAPTION="Vrste prometa " TOP="4400"   LEFT="56"   WIDTH="7000" HEIGHT="4200"   />
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="Cijene" TOP="4400"   LEFT="7100"   WIDTH="7000" HEIGHT="4200"   />


		<INPUT TYPE="grid"
				   NAME="xdijagnoze"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="700" LEFT="256" WIDTH="13700" HEIGHT="3500"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK="select 'refresh' as xprepter"
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="select lnstkategorijaskupinaid , opisk as [Kategorija2500], opisg as [Skupina grla2500] from vistkategorije where vrsta = '@@vrsta'" />

		<INPUT TYPE="grid"
				   NAME="xprepter"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="4600" LEFT="256" WIDTH="6800" HEIGHT="3800"
				   POPUP=""
				   ONCLICK="select 'refresh' as xterap"
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTDijagQueryGlaiDet @action = 2, @id = @@xdijagnoze" />

		<INPUT TYPE="grid"
		   NAME="xterap"
		   REFRESHAFTERCHILD="TRUE"
		   CAPTION="Stavke"
		   SKIPDEFAULTLOAD2="TRUE"
		   TOP="4600" LEFT="7200" WIDTH="6800" HEIGHT="3800"
		   POPUP=""
		   ONCLICK=""
		   ONDBLCLICK=""
		   EDITCOLUMNS=""
		   ONCELLEDITED=""
		   CHECKBOXVISIBLE="FALSE"
		   PAGEHEADERCENTER=""
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT=""
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   PAGEFOOTERRIGHT="@@thosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="TRUE"
		   TOTALROW="FALSE"
		   SQL="spSTTerapijaQuery @action = 8, @stgrloid = @@stgrloid, @stdijagdetid = @@xprepter, @Sve = @@Sve" />

	</KATEGORIJACIJENA>


  <DODAJ_TEZINU NAME="DODAJ_TEZINU"
      HEIGHT="3500" WIDTH="7502"
      CAPTION="Dodavanje težinske kategorije"
      FOCUS=""
      ONLOAD=""
			   
		>

    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="2200"  ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="stfarmeid"  CAPTION="Farma*" TOP="500" LEFT="1500" HEIGHT="317" WIDTH="3000"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
    
    <INPUT TYPE="number" NAME="odkg" 	  CAPTION="Težina od (kg)*" TOP="900" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>
    <INPUT TYPE="number" NAME="dokg" 	  CAPTION="Težina do (kg)*" TOP="1300" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>

    <INPUT TYPE="picturebox" NAME="pic5" LOCATION="c:\st_frame.png" TOP="2200" LEFT="100" WIDTH="7000" HEIGHT="600" CAPTION="" ONCLICK="" TABINDEX="-1" />
    
    <INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="2400" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaKG  @action = 2, @odkg = @@odkg, @dokg = @@dokg, @stfarmeid = @@stfarmeid#Ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="2400" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
  </DODAJ_TEZINU>







</PROJECT> 