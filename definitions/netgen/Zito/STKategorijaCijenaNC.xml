<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT


	ONLOAD=":FILTER_FORM"
	DETAILGRID = ""
	MASTERDBLCLICK=""
	BUTTONS="Uvjeti:FILTER_FORM#Dodaj:DODAJ#Izmjeni:IZMJENI#Provjeri praznine:PRAZNINE"
	CMD6CAPTION=""
	INCLUDE=""
	POPUPMASTER=""
	POPUPDETAIL=""
	TREE="spstTreeNG @action = 7, @vrsta = '@@vrsta':FILTERODDO_FORM	"
	GROUPBYBOXVISIBLE="TRUE"
	FROZENCOLUMNS="0"
	AUTOFITCOLUMNS="False"
	CHECKBOXVISIBLE="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	DETTOTALROWVISIBLE="FALSE"
	SETDEFAULTS=""
	ONLOAD2=""
	REPORT=""
	PAGEHEADERCENTER="Kategorija - Cijena "
	PAGEHEADERRIGHT=""
	PAGEHEADERLEFT=""
	PAGEFOOTERCENTER=""
	PAGEFOOTERLEFT=""
	PAGEFOOTERRIGHT="@@tkosmomi"
	PAGEORIENTATION="LANDSCAPE">


  <MASTERCOLUMNS>
    <COLUMN INDEX="" NAME="Nab.cijena1200" WIDTH="1200" CAPTION="" FORMAT="#,##0.00" VISIBLE="" AGREGATEFUNCTION="3" />
    

  </MASTERCOLUMNS>
  
  
	<NAME>Interni cjenik stoke NC</NAME>
	<CAPTION>Interni cjenik stoke NC</CAPTION>
  <AUTOR>26.03.2013. matija horvat</AUTOR>

	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spSTKategorijaCijene @action = 2 , @vrstadokid = @@vrstadokid , @node = @@node" />

	<FILTER_FORM HEIGHT="3000" WIDTH="7000"
			 CAPTION="Odaberite vrstu stoke ZA koju želte ažurirati cjene"
			 ONSUBMIT=""
			 ONLOAD=""
			 FILLEXPLORER="Treeandrefreshmaster">

		<INPUT TYPE="combo" NAME="Vrsta"	TOP="800" LEFT="1000" ONCLICK="" SQL="spSTDajVrsta @operateriid = @@operateriid " ALLOWEMPTY="FALSE" CAPTION="Vrsta stoke*" ONLOSTFOCUS=""/>
		<INPUT TYPE="button" NAME="ok"         TOP="2000" LEFT="1000" CAPTION="Pokaži"   ONCLICK="#OK" />
		<INPUT TYPE="button" NAME="cancel"     TOP="2000" LEFT="2500" CAPTION="Odustani"   ONCLICK="close" />
	</FILTER_FORM>



	<DODAJ NAME="DODAJ"
		HEIGHT="4400" WIDTH="7502"
		CAPTION="Unos stavke cjenika"
		FOCUS="datumod"
		ONLOAD="select '@@node' as kljuc, @@id as vrstadokid "
			   
		>
    
		<INPUT TYPE="combo"   NAME="stfarmeid"         CAPTION="Farma" HEIGHT="317" WIDTH="4997"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
		<INPUT TYPE="Date"   NAME="datumod"         CAPTION="Vrijedi od" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="Date"   NAME="datumdo"         CAPTION="Vrijedi do" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="combo"   NAME="lnstkategorijaskupinaid"         CAPTION="Kategorija" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije where lnstkategorijaskupinaid = @@kljuc"/>
		<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 111, @stfarmeid =@@stfarmeid ,  @trazi = '@@searchboxprnradninalogid'"
				   ONLOSTFOCUS="spSTRadniNalozi @action = 111, @trazi = '@@searchboxprnradninalogid', @stfarmeid = @@stfarmeid "/>
		
		<INPUT TYPE="number" NAME="NC" CAPTION="Nab.cijena"   HEIGHT="302" WIDTH="1206"  DECIMALS="4" ENABLED="TRUE" />
		<INPUT TYPE="text"   NAME="kljuc"         CAPTION="" TOP =" -3000" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL=""/>
    <INPUT TYPE="label"   NAME="info"         CAPTION="*Ostavite prazan RN za pridjeljivanje cjenika svim turnusima." SIZE="7" TOP="3500" LEFT="3000" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3400" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaCijene  @action = 3, @operateriid = @@operateriid,  @lnstkategorijaskupinaid = @@lnstkategorijaskupinaid, 
                   @nc=@@nc, @datumod = @@datumod, @datumdo = @@datumdo, @stfarmeid = @@stfarmeid, @prnradninalogid = @@prnradninalogid#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3400" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</DODAJ>


	<IZMJENI NAME="IZMJENI"
		HEIGHT="4000" WIDTH="7502"
		CAPTION="Ispravak stavke cjenika"
		FOCUS="datumod"
		ONLOAD="if  @@id = 0 begin
                raiserror 19001 ' Niste odabrali cjenik kojeg želite ispraviti !'
		        end
            else begin
                select * from stKategorijeCijene where stKategorijeCijeneid = @@stKategorijeCijeneid
           end"
			   
		>
		<INPUT TYPE="combo"   NAME="stfarmeid"         CAPTION="Farma" HEIGHT="317" WIDTH="4997"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
		<INPUT TYPE="Date"   NAME="datumod"         CAPTION="Vrijedi od" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="Date"   NAME="datumdo"         CAPTION="Vrijedi do" HEIGHT="317" ENABLED="TRUE"/>
		<INPUT TYPE="combo"   NAME="lnstkategorijaskupinaid"         CAPTION="Kategorija" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije where lnstkategorijaskupinaid = @@lnstkategorijaskupinaid"/>
		<INPUT TYPE="search" NAME="prnradninalogid" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 111, @stfarmeid =@@stfarmeid ,  @trazi = '@@searchboxprnradninalogid'"
				   ONLOSTFOCUS="spSTRadniNalozi @action = 111, @trazi = '@@searchboxprnradninalogid', @stfarmeid = @@stfarmeid "/>
		
		<INPUT TYPE="number" NAME="NC" CAPTION="Nab.cijena"   HEIGHT="302" WIDTH="1206"  DECIMALS="4" ENABLED="TRUE" />
		<INPUT TYPE="text"   NAME="kljuc"         CAPTION="" TOP =" -3000" HEIGHT="317" WIDTH="4997"  STYLE="1" ENABLED="FALSE" SQL=""/>
		<INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3000" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaCijene  @action = 4, @id = @@stKategorijeCijeneid, @operateriid = @@operateriid,  
                  @lnstkategorijaskupinaid = @@lnstkategorijaskupinaid, @nc=@@nc, @datumod = @@datumod, @datumdo = @@datumdo, @stfarmeid = @@stfarmeid, 
                  @prnradninalogid = @@prnradninalogid#Ok"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</IZMJENI>


  <PRAZNINE NAME="PRAZNINE"
      HEIGHT="11000" WIDTH="8502"
      CAPTION="Provjera nedefiniranih razdoblja NC cjenika"
      ONLOAD=""
      ONLOADED="SELECT 'invisible' as prazninegrid"
		>
    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="8000" HEIGHT="1300"  ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="stfarme1id"         CAPTION="Farma" HEIGHT="317" WIDTH="4997"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
    <INPUT TYPE="search" NAME="prnradninalog1id" CAPTION="Radni nalog" WIDTH="1500" SQL="spSTRadniNalozi @action = 111, @stfarmeid =@@stfarmeid ,  @trazi = '@@searchboxprnradninalog1id'"
				   ONLOSTFOCUS="spSTRadniNalozi @action = 111, @stfarmeid = @@stfarmeid,  @trazi = '@@searchboxprnradninalog1id' "/>
    <INPUT TYPE="combo"   NAME="lnstkategorijaskupina1id"         CAPTION="Kategorija" HEIGHT="317" WIDTH="4997"  STYLE="1" ALLOWEMPTY="TRUE" ENABLED="TRUE" SQL="select lnstkategorijaskupinaid , kategorija from vistkategorije"/>
    
    <INPUT TYPE="label"   NAME="info"         CAPTION="*Za sve RN koji prolaze filter uzima se razdoblje od otvaranja do zatvaranja RN-a." SIZE="7" TOP="1600" LEFT="2900" HEIGHT="317" ENABLED="TRUE"/>
    
    <INPUT TYPE="button" NAME="pokazi"            CAPTION="Traži "  TOP="1500" LEFT="300" WIDTH="1106"  HEIGHT="322"
					ONCLICK="select 'refresh' as prazninegrid#select 'visible' as prazninegrid"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"        CAPTION="Zatvori" TOP="1500" LEFT="1700" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />



    <INPUT TYPE="grid"
				   NAME="prazninegrid"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="2000" LEFT="100" WIDTH="8100" HEIGHT="8380"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTKategorijaCijene  @action = 5, @lnstkategorijaskupinaid = @@lnstkategorijaskupina1id, @stfarmeid = @@stfarme1id, @prnradninalogid = @@prnradninalog1id" 
    />
    
    
    
    
    
    
    
  </PRAZNINE>

	<KATEGORIJACIJENA
		  FILLEXPLORER=""
		  MAXIMIZEBOX="TRUE"
		  DETAILGRID = ""
		  WIDTH="21500"
		  ONSUBMIT=""
		  ONLOAD=""
		  ONLOADED="select 'refresh' as xprepter, 'refresh' as xterap"
		  ONLOAD2=""
		  HEIGHT="11600"
		  CAPTION="Ažuriranje cijena kategorija stoke "
		  BORDERSTYLE="3"
		  FOCUS="glava"
		  CMD1CAPTION=""
		  CMD2CAPTION=""
		  CMD3CAPTION=""
		  REFRESHAFTERCHILD="TRUE" >

		
		<!--
		<INPUT TYPE="check" NAME="Sve" CAPTION="Sve terapije" TOP="8400" LEFT="9500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="select null as xprepter, 'refresh' as xterap"/>
                -->
		
        <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="8700" LEFT="1500" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="close"/>
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="KAtegorije - skupine grla" TOP="500"   LEFT="56"   WIDTH="14050" HEIGHT="3800"   />
		<INPUT TYPE="frame"  NAME="fr2"         CAPTION="Vrste prometa " TOP="4400"   LEFT="56"   WIDTH="7000" HEIGHT="4200"   />
		<INPUT TYPE="frame"  NAME="fr1"         CAPTION="Cijene" TOP="4400"   LEFT="7100"   WIDTH="7000" HEIGHT="4200"   />


		<INPUT TYPE="grid"
				   NAME="xdijagnoze"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="700" LEFT="256" WIDTH="13700" HEIGHT="3500"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK="select 'refresh' as xprepter"
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="select lnstkategorijaskupinaid , opisk as [Kategorija2500], opisg as [Skupina grla2500] from vistkategorije where vrsta = '@@vrsta'" />

		<INPUT TYPE="grid"
				   NAME="xprepter"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="4600" LEFT="256" WIDTH="6800" HEIGHT="3800"
				   POPUP=""
				   ONCLICK="select 'refresh' as xterap"
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spSTDijagQueryGlaiDet @action = 2, @id = @@xdijagnoze" />

		<INPUT TYPE="grid"
		   NAME="xterap"
		   REFRESHAFTERCHILD="TRUE"
		   CAPTION="Stavke"
		   SKIPDEFAULTLOAD2="TRUE"
		   TOP="4600" LEFT="7200" WIDTH="6800" HEIGHT="3800"
		   POPUP=""
		   ONCLICK=""
		   ONDBLCLICK=""
		   EDITCOLUMNS=""
		   ONCELLEDITED=""
		   CHECKBOXVISIBLE="FALSE"
		   PAGEHEADERCENTER=""
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT=""
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   PAGEFOOTERRIGHT="@@thosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="TRUE"
		   TOTALROW="FALSE"
		   SQL="spSTTerapijaQuery @action = 8, @stgrloid = @@stgrloid, @stdijagdetid = @@xprepter, @Sve = @@Sve" />

	</KATEGORIJACIJENA>









</PROJECT> 