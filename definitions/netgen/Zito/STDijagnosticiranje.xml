	<ZAKLJUCI_FORM NAME="ZAKLJUCI" HEIGHT="3900" WIDTH="5500" 
		CAPTION="Zaključiti terapiju?" 
		ONSUBMIT=""
		ONLOAD="if (select datumkraj from stdijaggla where stdijagglaid = @@ID ) is not null  begin 
                        raiserror 19001 'Terapija je već zaključena. Ne može se više zaključivati!' 
						end else begin select datumdok,broj,getdate() as DatumKraj from stdijaggla where stdijagglaid = @@ID end" >
		
		<!--
		<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="1325" HEIGHT="317" WIDTH="2794" CAPTION="Broj terapije:*" TABINDEX="1" ENABLED="FALSE"/>
        -->
		
		<INPUT TYPE="combo" NAME="stfarmeid" CAPTION="Farma:*" TOP="360" LEFT="1325" WIDTH="4004" HEIGHT="294" SQL="select dg.stfarmeid,f.orgnaziv
from stdijaggla dg
inner join stfarme f on dg.stfarmeid=f.stfarmeid
where dg.stdijagglaid = @@ID" ONLOSTFOCUS="" ALLOWEMPTY="FALSE" ENABLED="FALSE" />
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dijagnoze:*" TOP="760" LEFT="1325" WIDTH="1400" HEIGHT="280" ONLOSTFOCUS=""  SQL="select datumdok from stdijaggla where stdijagglaid = @@ID"  ENABLED="FALSE"/>
		<INPUT TYPE="combo" NAME="stgrloid" 	  CAPTION="Grlo:*" TOP="1160" LEFT="1325" WIDTH="1800" HEIGHT="280" DECIMALS=""
					SQL="select dg.stgrloid,g.maticnibroj
from stdijaggla dg
inner join stgrlo g on dg.stgrloid=g.stgrloid
where dg.stdijagglaid = @@ID"
