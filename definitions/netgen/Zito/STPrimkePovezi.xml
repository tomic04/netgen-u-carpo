<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spSTPrimkePovezi @action=2, @id= @@id"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Filter:FILTERFORM#Povezivanje:POVEZI#Raskini vezu:RASKINIVEZU#Stavke zaprimanja:STAVKEZAPRIMANJA" 
		 POPUPMASTER="Filter:FILTERFORM#Ponisti filter:PONISTIFILTER" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spSTPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' , @sifradok = '89' , @trazi='tov'" 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT="">



	<NAME>Povezivanje primki i zaprimanja grla kod kupovine </NAME>
	<CAPTION>Povezivanje primki i zaprimanja grla kod kupovine </CAPTION>



	<MASTERCOLUMNS>
		<COLUMN INDEX="12" NAME="" WIDTH="1500" CAPTION="" FORMAT="#,##0" VISIBLE="" AGREGATEFUNCTION="2"/>
	</MASTERCOLUMNS>




	<FILTERFORM NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spSTPrimkePovezi @action = 1,  @operateriid= @@operateriid,  "
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@stfarmeid as stfarmeid" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
			<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
			<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="stfarmeid" ONCLICK="" SQL="spSTDAjFarme @action = 0, @operateriid=@@operateriid, @vrsta='G'" ENABLED="TREE" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS="select 'refresh' as osobeid"/>
	</FILTERFORM>


	<POVEZI
				CAPTION="Povezivanje primke sa zaprimanje goveda"
				HEIGHT="7000"
				WIDTH= "11000"
				FILLEXPLORER=""
				FOCUS=""
				ONLOAD2=""
				ONLOADED="spSTPrimkePovezi @action=5,@id=@@id"
				ONLOAD="if (select stprometglaid from stprometgla where nabpriglaid = @@id) is not null begin raiserror 19001 &apos;Dokument je već povezan. Ne može se više povezivati!&apos;end "
				>

				<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Primka:" TOP="28" LEFT="56" WIDTH="10300" HEIGHT="1600"   />
				<INPUT TYPE="text" NAME="broj"   TOP="200" LEFT="2000" CAPTION="Broj dokumenta:*" ENABLED="FALSE" WIDTH="2000"/>
				<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum zaprimanja*" TOP="200" LEFT="6000" ENABLED="FALSE"/>
				<INPUT TYPE="text" NAME="dobavljac" CAPTION="Dobavljač*" TOP="600" LEFT="2000" ENABLED="FALSE" WIDTH="3000"/>
				<INPUT TYPE="text" NAME="skladiste" CAPTION="Skladište*" TOP="600" LEFT="6000" ENABLED="FALSE" WIDTH="3000"/>
				<INPUT TYPE="number" NAME="kolicina" CAPTION="Ukupna količina*" TOP="1000" LEFT="2000" ENABLED="FALSE" WIDTH="1500" decimals="3"/>



		<INPUT TYPE="grid"
					 NAME="zaprimanja"
					 REFRESHAFTERCHILD=""
					 CAPTION="Nepovezana zaprimanja"
					 TOP="2000" LEFT="56" WIDTH="8750" HEIGHT="3078"
					 TABINDEX="-1"
					 AFTERREFRESH=""
					 POPUP=""
					 ONDBLCLICK=":prikazidetalje"
					 EDITCOLUMNS=""
					 ONCELLEDITED=""
					 DETCHECKBOXVISIBLE="FALSE"
					 PAGEHEADERCENTER=""
					 PAGEHEADERRIGHT=""
					 PAGEHEADERLEFT=""
					 PAGEFOOTERCENTER=""
					 PAGEFOOTERLEFT=""
					 PAGEFOOTERRIGHT="@@thosmomi"
					 PAGEORIENTATION="LANDSCAPE"
					 GROUPBYBOXVISIBLE="FALSE"
					 TOTALROW="FALSE"
					 SQL="spSTPrimkePovezi @action=3,@operateriid=@@operateriid,@id=@@id " >
				</INPUT>

				<INPUT TYPE="button" NAME="ok" CAPTION="Poveži" TOP="5500" LEFT="196" WIDTH="1106" HEIGHT="322" 
					   ONCLICK="FOREACHSELECTED(zaprimanja)#spSTPrimkePovezi @action = 4, @id = @@id, @stprometglaid = @@zaprimanja#Ok"  />
				<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
				<INPUT TYPE="button" NAME="detalji" CAPTION="Detalji ulaza" TOP="5500" LEFT="2688" WIDTH="1106" HEIGHT="322" ONCLICK=":STAVKEULAZA"  />


		</POVEZI>
	<RASKINIVEZU
				CAPTION="Raskidanje veze primke i zaprimanja grla"
				HEIGHT="6000"
				WIDTH= "11000"
				FILLEXPLORER=""
				FOCUS=""
				ONLOAD2=""
				ONLOADED="spSTPrimkePovezi @action=5,@id=@@id"
				ONLOAD="if (select stprometglaid from stprometgla where nabpriglaid = @@id) is null begin raiserror 19001 &apos;Dokument nije povezan. Ne može se više raskinuti veza!&apos;end 
							else begin 
								( select * from stprometgla where nabpriglaid = @@id ) 
							end "
				>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Primka:" TOP="28" LEFT="56" WIDTH="10000" HEIGHT="1600"   />
		<INPUT TYPE="text" NAME="broj"   TOP="200" LEFT="2000" CAPTION="Broj dokumenta:*" ENABLED="FALSE" WIDTH="2000"/>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum zaprimanja*" TOP="200" LEFT="6000" ENABLED="FALSE"/>
		<INPUT TYPE="text" NAME="dobavljac" CAPTION="Dobavljač*" TOP="600" LEFT="2000" ENABLED="FALSE" WIDTH="3000"/>
		<INPUT TYPE="text" NAME="skladiste" CAPTION="Skladište*" TOP="600" LEFT="6000" ENABLED="FALSE" WIDTH="3000"/>
		<INPUT TYPE="number" NAME="kolicina" CAPTION="Ukupna količina*" TOP="1000" LEFT="2000" ENABLED="FALSE" WIDTH="1500" decimals="3"/>


		<INPUT TYPE="frame"  NAME="fr2"           CAPTION="ZAprimanje na farmu:" TOP="2000" LEFT="56" WIDTH="10000" HEIGHT="1600"   />
		<INPUT TYPE="text" NAME="broj"   TOP="2200" LEFT="2000" CAPTION="Broj dokumenta zaprimanja:*" ENABLED="FALSE" WIDTH="2000"/>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum zaprimanja*" TOP="2600" LEFT="6000" ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="ukupnokg" CAPTION="Ukupna količina*" TOP="3000" LEFT="2000" ENABLED="FALSE" WIDTH="1500" decimals="3"/>



		<INPUT TYPE="button" NAME="ok" CAPTION="Raskini" TOP="4500" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spSTPrimkePovezi @action = 6, @id = @@id#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="4500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="detalji" CAPTION="Detalji ulaza" TOP="4500" LEFT="2688" WIDTH="1106" HEIGHT="322" ONCLICK=":STAVKEULAZA"  />


	</RASKINIVEZU>

	<STAVKEULAZA
			CAPTION="Stavke dokumenta zaprimanja"
			HEIGHT="5000"
			WIDTH= "8000"
			FILLEXPLORER=""
			FOCUS=""
			ONLOAD2=""
			ONLOADED=""
			ONLOAD="select @@zaprimanja as stid"
				>
		<INPUT TYPE="number" NAME="stid"   TOP="2200" LEFT="2000" CAPTION="Broj dokumenta zaprimanja:*" VISIBLE="FALSE" ENABLED="FALSE" WIDTH="2000"/>

		<INPUT TYPE="grid"
					 NAME="detalji"
					 REFRESHAFTERCHILD=""
					 CAPTION="Stavke zaprimanja"
					 TOP="500" LEFT="56" WIDTH="8750" HEIGHT="3078"
					 TABINDEX="-1"
					 AFTERREFRESH=""
					 POPUP=""
					 ONDBLCLICK=""
					 EDITCOLUMNS=""
					 ONCELLEDITED=""
					 CKBOXVISIBLE="FALSE"
					 PAGEHEADERCENTER=""
					 PAGEHEADERRIGHT=""
					 PAGEHEADERLEFT=""
					 PAGEFOOTERCENTER=""
					 PAGEFOOTERLEFT=""
					 PAGEFOOTERRIGHT="@@thosmomi"
					 PAGEORIENTATION="LANDSCAPE"
					 GROUPBYBOXVISIBLE="FALSE"
					 TOTALROW="FALSE"
					 SQL="spSTPrometQueryGlaIDet @action=2,@operateriid=@@operateriid,@id=@@stid " >
		</INPUT>

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3800" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</STAVKEULAZA>

	<STAVKEZAPRIMANJA
			CAPTION="Stavke dokumenta zaprimanja"
			HEIGHT="7000"
			WIDTH= "9000"
			FILLEXPLORER=""
			FOCUS=""
			ONLOAD2=""
			ONLOADED=""
			ONLOAD="select * from stprometgla where stprometglaid = @@stprometglaid"
				>

		<INPUT TYPE="text" NAME="broj"   TOP="200" LEFT="2000" CAPTION="Broj dokumenta zaprimanja:*" ENABLED="FALSE" WIDTH="2000"/>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum zaprimanja*" TOP="200" LEFT="6000" ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="ukupnokg" CAPTION="Ukupno kg*" TOP="600" LEFT="2000" ENABLED="FALSE" WIDTH="1500" decimals="3"/>
		<INPUT TYPE="number" NAME="ukupnogrla" CAPTION="Ukupno kom*" TOP="600" LEFT="6000" ENABLED="FALSE" WIDTH="1500" decimals="3"/>
		<INPUT TYPE="grid"
					 NAME="detalji"
					 REFRESHAFTERCHILD=""
					 CAPTION="Stavke zaprimanja"
					 TOP="1000" LEFT="56" WIDTH="8750" HEIGHT="4500"
					 TABINDEX="-1"
					 AFTERREFRESH=""
					 POPUP=""
					 ONDBLCLICK=""
					 EDITCOLUMNS=""
					 ONCELLEDITED=""
					 CKBOXVISIBLE="FALSE"
					 PAGEHEADERCENTER=""
					 PAGEHEADERRIGHT=""
					 PAGEHEADERLEFT=""
					 PAGEFOOTERCENTER=""
					 PAGEFOOTERLEFT=""
					 PAGEFOOTERRIGHT="@@thosmomi"
					 PAGEORIENTATION="LANDSCAPE"
					 GROUPBYBOXVISIBLE="FALSE"
					 TOTALROW="FALSE"
					 SQL="spSTPrometQueryGlaIDet @action=2,@operateriid=@@operateriid,@id=@@stprometglaid " >
		</INPUT>

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5800" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</STAVKEZAPRIMANJA>

</PROJECT>