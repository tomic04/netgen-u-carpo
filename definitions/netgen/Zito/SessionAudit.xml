<FILTERFORM NAME="FILTERFORM" HEIGHT="3110" WIDTH="6854" CAPTION="Parametri" ONSUBMIT="spssOperateriSessionAuditQuery" ONLOAD="select @@granulaid as granulaid, @@aplikacijeid as aplikacijeid, 
@@operateriid as operateriid, @@datumod as datumod, @@datumdo as datumdo" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3" CMD1CAPTION="Prihvati" CMD2CAPTION="Odustani">
	<INPUT TYPE="date" NAME="datumdo" TOP="288" LEFT="4464" HEIGHT="302" WIDTH="1728" VISIBLE="TRUE" TABINDEX="2" ENABLED="TRUE"/>
	<INPUT TYPE="date" NAME="datumod" TOP="288" LEFT="1440" HEIGHT="302" WIDTH="1728" VISIBLE="TRUE" TABINDEX="1" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="Label9" TOP="288" LEFT="259" HEIGHT="288" WIDTH="1008" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Od datuma:" ENABLED="TRUE" TEXT="Label9"/>
	<INPUT TYPE="label" NAME="Label10" TOP="288" LEFT="3312" HEIGHT="288" WIDTH="1008" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Do datuma:" ENABLED="TRUE" TEXT="Label10"/>
	<INPUT TYPE="combo" NAME="operateriid" TOP="720" LEFT="1440" HEIGHT="302" WIDTH="3528" SQL="select operateriid, naziv from ssoperateri" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" TABINDEX="3"/>
	<INPUT TYPE="label" NAME="Label11" TOP="720" LEFT="259" HEIGHT="288" WIDTH="1008" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Operater:" ENABLED="TRUE" TEXT="Label11"/>
	<INPUT TYPE="combo" NAME="aplikacijeid" TOP="1123" LEFT="1440" HEIGHT="302" WIDTH="3557" VISIBLE="TRUE" SQL="select aplikacijeid, naziv from ssaplikacije" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" TABINDEX="4" ENABLED="TRUE" ONLOSTFOCUS="select &apos;refresh&apos; as granulaid"/>
	<INPUT TYPE="label" NAME="Label13" TOP="1152" LEFT="259" HEIGHT="288" WIDTH="1051" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Aplikacija:" ENABLED="TRUE" TEXT="Label13"/>
	<INPUT TYPE="combo" NAME="granulaid" TOP="1526" LEFT="1440" HEIGHT="302" WIDTH="3557" VISIBLE="TRUE" SQL="select max(meniid) as meniid, m.opis as naziv from jupitersystem..ssoperaterisessionaudit a 
left outer join ssmeni m  on a.auditcommand=m.parametar 
where a.auditcommand is not null and a.auditcommand &lt;&gt;&apos;&apos;
and (m.aplikacijeid=@@aplikacijeid or @@aplikacijeid is null)
group by m.opis
order by 1 desc" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE" TABINDEX="5" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="Label14" TOP="1555" LEFT="259" HEIGHT="288" WIDTH="1066" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Granula:" ENABLED="TRUE" TEXT="Label14"/>

</FILTERFORM>
