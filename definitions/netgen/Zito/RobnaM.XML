<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA="select r.RobnaMarkaid,r.Opis,r.Sifra,r.Partneriid,p.Naziv as [Partner] from RobnaMarka r inner join partneri p on r.partneriid=p.partneriid"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="Dodaj:FORM2" 
		CMD3CAPTION="Izmjeni:FORM3" 
		CMD4CAPTION="Obriši:FORM4"
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM="FORM3"
	        POPUP=""> 

 

  <NAME>Robna Marka</NAME>
  <CAPTION>Roba Marka</CAPTION>
 
  <FORM1 
		FILLEXPLORER="TRUE" 
		REPORT=""  
		WIDTH="8000" 
		STORA="select r.RobnaMarkaid,r.Opis,r.Sifra,r.Partneriid,p.Naziv from RobnaMarka r inner join partneri p on r.partneriid=p.partneriid where r.opis like '%@@oznaka%' or r.sifra like '%@@oznaka%' " 
		STARTUPSTORA="" 
		HEIGHT="3300" 
		CAPTION="RobnaMarka" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokazi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="" > 

  			<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Oznaka"/>
	 		<KONTROLA TYPE="VB.TextBox" NAME="Oznaka" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="Opis" TEXT="" WIDTH="5500" HEIGHT="320"/> 

  </FORM1>

 

  <FORM2 
		WIDTH="8000" 
		STORA="insert into RobnaMarka(opis,sifra,partneriid) values( '@@opis','@@sifra','@@partneriid' )" 
		STARTUPSTORA="" 
		HEIGHT="2800" 
		CAPTION="Novi RobnaMarka" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
			<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Opis"/>
			<KONTROLA TYPE="VB.TextBox" NAME="opis" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="VarIme" TEXT="" WIDTH="5500" HEIGHT="320"/> 


	                <KONTROLA TYPE="VB.Label" NAME="lbl2" TOP="700" LEFT="200" WIDTH="1500" CAPTION="Šifra"/> 
			<KONTROLA TYPE="VB.TextBox" NAME="sifra" TOP="700" LEFT="2200" TABINDEX="1" CAPTION="VarSet" TEXT="" WIDTH="5500" HEIGHT="320"/> 

 
                	<KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1200" LEFT="200" WIDTH="1500" CAPTION="Partner"/> 
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partner" 
					NAME="partneriid" 
					SQL="Partneri#partneriid#%naziv%" 
					TOP="1200" 
					LEFT="2200" 
					TEXT=""
					TABINDEX="2" 
					WIDTH="5000" 
					HEIGHT="320"/>
  </FORM2>
 


   <FORM3 
		WIDTH="8000" 
		STORA="update RobnaMarka set opis='@@opis',sifra='@@sifra',partneriid=@@partneriid where RobnaMarkaid=@@id" 
		STARTUPSTORA="select r.RobnaMarkaid,r.Opis,r.Sifra,r.Partneriid,p.Naziv as [Partner] from RobnaMarka r inner join partneri p on r.partneriid=p.partneriid where RobnaMarkaid=@@id" 
		HEIGHT="2800" 
		CAPTION="Izmjeni RobnaMarku" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Opis"/>
			<KONTROLA TYPE="VB.TextBox" NAME="opis" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="VarIme" TEXT="" WIDTH="5500" HEIGHT="320"/> 


	                <KONTROLA TYPE="VB.Label" NAME="lbl2" TOP="700" LEFT="200" WIDTH="1500" CAPTION="Šifra"/> 
			<KONTROLA TYPE="VB.TextBox" NAME="sifra" TOP="700" LEFT="2200" TABINDEX="1" CAPTION="VarSet" TEXT="" WIDTH="5500" HEIGHT="320"/> 

 
                	<KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1200" LEFT="200" WIDTH="1500" CAPTION="Partner"/> 
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partner" 
					NAME="partneriid" 
					SQL="Partneri#partneriid#%naziv%" 
					TOP="1200" 
					LEFT="2200" 
					TEXT=""
					TABINDEX="2" 
					WIDTH="5000" 
					HEIGHT="320"/>

  </FORM3>

 

  <FORM4 
		WIDTH="5500" 
		STORA="delete from RobnaMarka where RobnaMarkaid=@@id" 
		STARTUPSTORA="" 
		HEIGHT="3200" 
		CAPTION="Obriši RobnaMarka ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Obriši"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

   			<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati slog ? "/>
  </FORM4> 

 
 

</PROJECT> 