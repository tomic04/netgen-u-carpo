<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTER_FORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Parametri:FILTER_FORM"
		 CMD2CAPTION="Unos:INSERT_FORM" 
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 		
		 CMD5CAPTION=""
		 CMD6CAPTION="" 
		 CMD7CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 EDITCOLUMNS=""
		 ONCELLEDITED=""
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Stolovi</NAME>
	<CAPTION>Stolovi</CAPTION>
	<AUTOR>30.06.2014 matija horvat </AUTOR>


 <FILTER_FORM NAME="FILTER_FORM"
		 HEIGHT="2400"
		 WIDTH="6000"
		 CAPTION="Uvijeti prikaza"
		 ONSUBMIT="spMPStolovi @action = 1, "
		 ONLOAD="select @@partneriid as partneriid"
     ONLOADED=""
     FILLEXPLORER="TRUE"
		 FOCUS="opis"
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani" >


   <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5600" HEIGHT="900" />
   <INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="400"  LEFT="1500" WIDTH="3500"  ALLOWEMPTY="TRUE" ENABLED="TRUE" 
          SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"/>

</FILTER_FORM>
  
<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3000" 
		 WIDTH="6400" 
		 CAPTION="Dodavanje novog stola"
		 ONSUBMIT=""
		 ONLOADED=""
		 ONLOAD="" 
	   FILLEXPLORER=""
		 FOCUS="partneriid" 
		 CMD1CAPTION="" 
		 CMD2CAPTION="" >

    <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6000" HEIGHT="1800" />
    <INPUT TYPE="text"    NAME="broj"   CAPTION="Broj:*"  ENABLED="TRUE" TOP="400" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="text"    NAME="opis"   CAPTION="Opis:*"  ENABLED="TRUE" TOP="800" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="1200"  LEFT="1500" WIDTH="3500"  ALLOWEMPTY="TRUE" ENABLED="TRUE"
        SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"/>
  
      <INPUT TYPE="button"    NAME="spremi"   CAPTION="Spremi" TOP="2000" LEFT="200" WIDTH="1100" HEIGHT="320"
         ONCLICK="spMPStolovi @action = 2, @broj = '@@broj', @opis = '@@opis', @trgovinaid = @@trgovinaid#OK"/>
      <INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="2000" LEFT="1600" WIDTH="1100" HEIGHT="320" ONCLICK="close" />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="3000" 
		 WIDTH="6400" 
		 CAPTION="Izmjena postojećeg stola"
		 ONSUBMIT=""
		 ONLOAD="spMPStolovi @action=11, @mpstoloviId = @@id"
     ONLOADED=""
		 FILLEXPLORER=""
		 FOCUS="" 
		 CMD1CAPTION="" 
		 CMD2CAPTION="" >

    <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6000" HEIGHT="1800" />

    <INPUT TYPE="text"    NAME="broj"   CAPTION="Broj:*"  ENABLED="TRUE" TOP="400" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="text"    NAME="opis"   CAPTION="Opis:*"  ENABLED="TRUE" TOP="800" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="1200"  LEFT="1500" WIDTH="3500"  ALLOWEMPTY="TRUE" ENABLED="TRUE"
        SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"/>
  
		<INPUT TYPE="button"    NAME="spremi"   CAPTION="Spremi" TOP="2000" LEFT="200" WIDTH="1100" HEIGHT="320"
			ONCLICK="spMPStolovi @action = 3, @mpstoloviId = @@id, @broj = '@@broj', @opis = '@@opis', @trgovinaid = @@trgovinaid#OK"/>
		<INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="2000" LEFT="1600" WIDTH="1100" HEIGHT="320" ONCLICK="close" />
</UPDATE_FORM>

	<DELETE_FORM NAME="DELETE_FORM"
       HEIGHT="3000"
       WIDTH="6400"
       CAPTION="Brisanje stola"
       ONSUBMIT="spMPStolovi @action = 4, @mpstoloviId = @@id!!  "
       ONLOAD="spMPStolovi @action=11, @mpstoloviId = @@id"
       ONLOADED="select @@partneriid as partneriid"
       NEXTFORM=""
       FOCUS=""
       FILLEXPLORER=""
       CMD1CAPTION="Obriši"
       CMD2CAPTION="Odustani" >

		<INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6000" HEIGHT="2800" />
    
    <INPUT TYPE="text"    NAME="broj"   CAPTION="Broj:*"  ENABLED="FALSE" TOP="400" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="text"    NAME="opis"   CAPTION="Opis:*"  ENABLED="FALSE" TOP="800" LEFT="1500" WIDTH="3500" HEIGHT="300" />
    <INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="1200"  LEFT="1500" WIDTH="3500"  ALLOWEMPTY="TRUE" ENABLED="FALSE"
        SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'"/>
      
  </DELETE_FORM>


  
</PROJECT>