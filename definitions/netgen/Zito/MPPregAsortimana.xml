<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION="Print dok.:vrstadokid-MaloprodajaGla"
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD=":FILTERFORM"  
		 MULTIGRIDLAYOUT="TRUE" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT="">

	<NAME>Lista asortimana</NAME>
	<CAPTION>Lista asortimana</CAPTION>

<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="5254" 
	WIDTH="7710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPPregAsortimana @action = 1, "
	ONLOAD="select @@trgovinaid as trgovinaid, @@partneriid as partneriid, @@check2 as check2, @@check3 as check3, 
		@@trazilica2 as trazilica2, @@trazilica3 as trazilica3, '@@searchboxpartneriid' as Partner, '@@searchboxtrazilica2' as Proizvođač,
		'@@searchboxtrazilica3' as [Robna marka]" 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	>
	<INPUT TYPE="combo" NAME="TrgovinaId" 
		ALLOWEMPTY="TRUE" CAPTION="Trgovina:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	<INPUT TYPE="search" NAME="partneriid"  
		CAPTION="Partner"   SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa"/>
	<INPUT TYPE="check" NAME="check2" CAPTION="Asortiman dobavljača"/>
	<INPUT TYPE="check" NAME="check3" CAPTION="Asortiman kupca"/>
	<INPUT TYPE="search" NAME="trazilica2"  
		CAPTION="Proizvođač"   SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa"/>
	<INPUT TYPE="search" NAME="trazilica3"  
		CAPTION="Robna marka"   SQL="robnamarka#robnamarkaid#%opis%#partneriid"/>
</FILTERFORM>

</PROJECT>