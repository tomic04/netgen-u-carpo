	<FILTERFORM NAME="FILTERFORM" HEIGHT="2254" WIDTH="6710"
		 CAPTION="Upišite uvjete prikaza "
		 ONSUBMIT="spSTVrstaDokAzur @action=0, "
		 ONLOAD=""
		 FILLEXPLORER="TRUE"
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani"
		 >
		<INPUT TYPE="combo" NAME="vrstapromid" ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa " ONLOSTFOCUS="" SQL="select vrstapromid, opis as Naziv from vrstaprom order by naziv" />
		<INPUT TYPE="check" NAME="samoMP" ALLOWEMPTY="TRUE" CAPTION="Prikaži samo ST vrste dokumenta " ONLOSTFOCUS="" SQL="" />
	</FILTERFORM>

	<DODAJFORM
				   WIDTH="8000"
				   ONSUBMIT=""
				   ONLOAD="spSTVrstaDokAzur @action=1, @vrstadokid = @@id"
				   HEIGHT="9000"
				   CAPTION="Unos podataka"
				  FOCUS="vrstapromid"
		 >
		<INPUT TYPE="combo" NAME="vrstapromid" CAPTION="Vrsta prometa* " TOP="300" VALUE="" HEIGHT="320" WIDTH="2500" TABINDEX="1" CHECKBOX="FALSE" SQL="select vrstapromid, opis as Naziv from vrstaprom order by naziv "/>
		<INPUT TYPE="text" CAPTION="Opis*" NAME="opis" SQL="" TABINDEX="2" TOP="700" WIDTH="4500" HEIGHT="320" ENABLED="TRUE" />
		<INPUT TYPE="text" CAPTION="Prefix*" NAME="Prefix" SQL="" TABINDEX="3" TOP="1100" WIDTH="4500" HEIGHT="320" ENABLED="TRUE" />
		<INPUT TYPE="text" CAPTION="Sufix*" NAME="Sufix" SQL="" TABINDEX="4" TOP="1500" WIDTH="4500" HEIGHT="320" ENABLED="TRUE" />
		<INPUT TYPE="text" CAPTION="Template*" NAME="Template" SQL="" TABINDEX="5" TOP="1900" WIDTH="4500" HEIGHT="320" ENABLED="TRUE" />
