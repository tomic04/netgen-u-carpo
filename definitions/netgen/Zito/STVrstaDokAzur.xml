		<INPUT TYPE="combo" CAPTION="Aktivni dok.*" NAME="aktivni"  TABINDEX="7" TOP="2700" WIDTH="1500" HEIGHT="320" ENABLED="TRUE" SQL="select 1 as aktivni, 'DA' as naziv union all select 0,'NE'"/>
		<INPUT TYPE="number" NAME="MPIzdatnicaZakljuci"		CAPTION="Zakljucuje se ( 1 - da / 0 - ne ) *" TOP="5900" TABINDEX="15"  DECIMALS ="0" ONLOSTFOCUS=""/>
		<INPUT TYPE="number" CAPTION="Predznak *"	  NAME="mppredznak " TOP="3500" SQL="" TABINDEX="9" WIDTH="500" HEIGHT="320" ENABLED="TRUE" DECIMALS="0"/>
		<INPUT TYPE="number" NAME="kolicinaminus"		CAPTION="Količina minus*" TOP="5500" TABINDEX="14"  DECIMALS ="0" ONLOSTFOCUS=""/>
		<INPUT TYPE="number" CAPTION="Sort*" NAME="sortid" SQL="" TOP="6900" TABINDEX="10" WIDTH="500" HEIGHT="320" ENABLED="TRUE" DECIMALS="0"/>


		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="8200" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spSTVrstaDokAzur @action=3, @vrstadokid = @@id, @vrstapromid = '@@vrstapromid', @opis = '@@opis'  , 
													@prefix = '@@prefix' , @Sufix = '@@Sufix' , @Template = '@@Template' , @NextVrdid = @@NextVrdid , @Aktivni = @@Aktivni , 
													 @MPPredznak  = @@MPPredznak  , @kolicinaminus =  @@kolicinaminus, @sortid = @@sortid, @MPIzdatnicaZakljuci = @@MPIzdatnicaZakljuci#Ok"  />
