<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Filter:FILTERFORM" CMD3CAPTION="Ispis:MULTIBLUEPRINT" CMD7CAPTION="Ispis" CMD8CAPTION="Report" ONLOAD="SELECT r.robaid
	, r.userid AS Šifra
	, r.naziv AS Artikl
	, kl.naziv AS Klasa
FROM roba r
	INNER JOIN klmasterroba kl ON kl.klmasterrobaid = r.klmasterrobaid
WHERE EXISTS (SELECT *
	FROM visktpromet vi
	WHERE vi.robaid = r.robaid AND vi.skladisteid = 210)
ORDER BY 	kl.sortkey
, 			r.naziv

" GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" DETCHECKBOXVISIBLE="FALSE" DETTOTALROWVISIBLE="FALSE" VERSION="1.2">
<NAME>Projekt</NAME>
<CAPTION>Ispis naljepnica</CAPTION>
<KOMENTAR>CallistoII 2.22.0</KOMENTAR>
<HISTORY>
25.09.2017. SPIN\sschonberger - STJEPAN-LAP
</HISTORY>

