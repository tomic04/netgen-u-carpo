	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2405" LEFT="1267" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

</FILTERFORM>

