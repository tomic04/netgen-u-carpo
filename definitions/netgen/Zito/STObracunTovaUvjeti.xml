<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTObracunTovaUvjeti @action = 1 " 
		 DETAILGRID = "spSTObracunTovaUvjeti @action = 2, @datum = @@datum, @stfarmeid = @@node"
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Kopiranje:KOPIRAJ" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE="spsttreeng @action = 8, @operateriid = @@operateriid :FILTERODDO_FORM "
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Obračun tova - uvjeti </NAME>
	<CAPTION>Obračun tova - uvjeti</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>

	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spSTObracunTovaUvjeti @action = 1 ,  @stfarmeid = @@node" />


	<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="5000" 
		 WIDTH="7700" 
		 CAPTION="Unos uvjeta tova"
		 ONSUBMIT="spSTObracunTovaUvjeti @action = 3, @operateriid= @@operateriid, @stfarmeid = @@node, "
		 ONLOAD="select orgnaziv as farma from stfarme where stfarmeid = @@node" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >


		<INPUT TYPE="text"    NAME="farma"    CAPTION="Farma"     ENABLED="FALSE"  STYLE="1" WIDTH="3500" />
		<INPUT TYPE="date"    NAME="datum"    CAPTION="Datum"    ENABLED="TRUE"  WIDTH="1500" />
		<INPUT TYPE="combo"    NAME="vrsta"    CAPTION="Vrsta prometa"    ENABLED="TRUE"  WIDTH="1500" SQL="select 'R' as vrsta, 'Rashodi' as naziv union all select 'P', 'Prihodi'"/>
		<INPUT TYPE="text"    NAME="sort"    CAPTION="Sort"     ENABLED="TRUE"  WIDTH="500" />
		<INPUT TYPE="text"    NAME="opis"    CAPTION="Opis"     ENABLED="TRUE"  WIDTH="3500" />
		<INPUT TYPE="text"    NAME="uvjet"	         CAPTION="Konta:"    ENABLED="TRUE"  WIDTH="3500"  SQL=""  />
		<INPUT TYPE="combo"    NAME="orgshemaid"	         CAPTION="Or.shema:"    ENABLED="TRUE"  WIDTH="5000"  SQL="select orgshemaid, oznaka+'   '+ naziv as naziv from orgshema"  />
		<INPUT TYPE="number"    NAME="faktor"	         CAPTION="Koeficijent:"    ENABLED="TRUE"  WIDTH="1200"  SQL=""  />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="5000" 
		 WIDTH="7700" 
		 CAPTION="Izmjena uvjeta tova"
		 ONSUBMIT="spSTObracunTovaUvjeti @action = 4, @id = @@STObracunTovaUvjetiid, @operateriid= @@operateriid, @stfarmeid = @@node, "
		 ONLOAD="select u.*, f.orgnaziv as farma  from  STObracunTovaUvjeti u inner join stfarme f on u.stfarmeid = f.stfarmeid where STObracunTovaUvjetiid = @@STObracunTovaUvjetiid" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="text"    NAME="farma"    CAPTION="Farma"     ENABLED="FALSE"  STYLE="1" WIDTH="3500" />
		<INPUT TYPE="date"    NAME="datum"    CAPTION="Datum"    ENABLED="TRUE"  WIDTH="1500" />
		<INPUT TYPE="combo"    NAME="vrsta"    CAPTION="Vrsta prometa"    ENABLED="TRUE"  WIDTH="1500" SQL="select 'R' as vrsta, 'Rashodi' as naziv union all select'P', 'Prihodi'"/>
		<INPUT TYPE="text"    NAME="sort"    CAPTION="Sort"     ENABLED="TRUE"  WIDTH="500" />
		<INPUT TYPE="text"    NAME="opis"    CAPTION="Opis"     ENABLED="TRUE"  WIDTH="3500" />
         <INPUT TYPE="text"    NAME="uvjet"	         CAPTION="Konta:"    ENABLED="TRUE"  WIDTH="3500"  SQL=""  />
		<INPUT TYPE="combo"    NAME="orgshemaid"	         CAPTION="Or.shema:"    ENABLED="TRUE"  WIDTH="5000"  SQL="select orgshemaid, oznaka+'   '+ naziv as naziv  from orgshema"  />
		<INPUT TYPE="number"    NAME="faktor"	         CAPTION="Koeficijent:"    ENABLED="TRUE"  WIDTH="1200"  SQL=""  />
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="3000" 
		 WIDTH="7700" 
		 CAPTION="Brisanje uvjeta tova"
		 ONSUBMIT="spSTObracunTovaUvjeti @action = 5, @id = @@STObracunTovaUvjetiid, @operateriid= @@operateriid, "
		 ONLOAD="select * from  STObracunTovaUvjeti where STObracunTovaUvjetiid = @@STObracunTovaUvjetiid" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="date"    NAME="datum"    CAPTION="Datum"    ENABLED="FALSE"  WIDTH="1500" />
		<INPUT TYPE="text"    NAME="opis"    CAPTION="Opis"     ENABLED="FALSE"  WIDTH="3500" />
         <INPUT TYPE="text"    NAME="uvjet"	         CAPTION="Konta:"    ENABLED="FALSE"  WIDTH="3500"  SQL=""  />
		<INPUT TYPE="number"    NAME="faktor"	         CAPTION="Koeficijent:"    ENABLED="FALSE"  WIDTH="1200"  SQL=""  />
</DELETE_FORM>

	<KOPIRAJ NAME="KOPIRAJ"
	 HEIGHT="3000"
	 WIDTH="7700"
	 CAPTION="Kopiranje uvjeta "
	 ONSUBMIT="spSTObracunTovaUvjeti @action = 6, @operateriid= @@operateriid, "
	 ONLOAD=""
	 NEXTFORM=""
	 FOCUS=""
	 CMD1CAPTION="Spremi"
	 CMD2CAPTION="Odustani" >


		<INPUT TYPE="date "    NAME="datum"    CAPTION="Datum "     ENABLED="TRUE"  STYLE="1" WIDTH="1500" SQL=""/>
		<INPUT TYPE="combo"    NAME="stfarmeid"    CAPTION="Farma SA koje se kopira "     ENABLED="TRUE"  STYLE="1" WIDTH="3500" SQL="spstdajFarme @operateriid = @@operateriid"/>
		<INPUT TYPE="combo"    NAME="stfarme2id"    CAPTION="Farma NA koje se kopira "     ENABLED="TRUE"  STYLE="1" WIDTH="3500" SQL="spstdajFarme @operateriid = @@operateriid"/>
	</KOPIRAJ>


</PROJECT>