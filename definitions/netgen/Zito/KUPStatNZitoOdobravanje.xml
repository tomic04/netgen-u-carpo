<PARTNERIPOOPERATERU NAME="PARTNERIPOOPERATERU" HEIGHT="12000" WIDTH="14000" CAPTION="Pregled i ažuriranje partnera po operateru" ONLOAD="" 
                     ONLOADED="dbo.spKUPStatusVisibility @indLijevo=1" 
					 TOP="302" BORDERSTYLE="3" REFRESHAFTERCHILD="TRUE" VERSION="61">

	<INPUT TYPE="frame" NAME="FrameNG2" TOP="100" LEFT="144" HEIGHT="10500" WIDTH="13500" TEXT="FrameNG2"/>
	<INPUT TYPE="frame" NAME="FrameNG2" TOP="10600" LEFT="144" HEIGHT="700" WIDTH="13500" TEXT="FrameNG3"/>
	
	<INPUT TYPE="grid" NAME="leftpartneri" TOP="350" LEFT="300" HEIGHT="10100" WIDTH="6600" TOTALROW="FALSE" EDITCOLUMNS="" ONCELLEDITED="" CHECKBOXVISIBLE="FALSE" SQL="dbo.spKUPPregledPartneraPoOperaterima" ONCLICK="select &apos;refresh&apos; as rightkupoperateri" FILTERMODE="TRUE"/>	
	<INPUT TYPE="grid" NAME="rightkupoperateri" TOP="350" LEFT="7000" HEIGHT="10100" WIDTH="6400" REFRESHAFTERCHILD="TRUE" CAPTION="Operateri za odobravanje" TABINDEX="0" TOTALROW="FALSE" EDITCOLUMNS="" CHECKBOXVISIBLE="FALSE" SQL="dbo.spKUPPregledOperateraPoKoracima @partneriid=@@leftpartneri" FILTERMODE="TRUE" ONCLICK=""/>
		
	<INPUT TYPE="grid" NAME="leftoperateri" TOP="350" LEFT="300" HEIGHT="10100" WIDTH="6600" REFRESHAFTERCHILD="TRUE" CAPTION="Operateri za odobravanje" TABINDEX="0" TOTALROW="FALSE" EDITCOLUMNS="" CHECKBOXVISIBLE="false" SQL="dbo.spKUPPregledOperateraPoKoracima" ONCLICK="select &apos;refresh&apos; as rightkuppartneri" FILTERMODE="TRUE"/>
	<INPUT TYPE="grid" NAME="rightkuppartneri" TOP="350" LEFT="7000" HEIGHT="10100" WIDTH="6400" TOTALROW="FALSE" EDITCOLUMNS="" ONCELLEDITED="" CHECKBOXVISIBLE="FALSE" SQL="dbo.spKUPPregledPartneraPoOperaterima @operateriid=@@leftoperateri"  FILTERMODE="TRUE"/>	
	
	<!-- <INPUT TYPE="grid" NAME="gpred" TOP="1296" LEFT="202" HEIGHT="6365" WIDTH="4320" TOTALROW="FALSE" EDITCOLUMNS="Predloďż˝ak3500" ONCELLEDITED="dbo.spKUPOdobriOperateri @action=4,@id=@@gpred,@Naziv=&apos;@@gridgpredPredloďż˝ak&apos;" CHECKBOXVISIBLE="FALSE" SQL="dbo.spKUPOdobriOperateri @action=3" ONCLICK="select &apos;refresh&apos; as odobri"/> -->	
	<INPUT TYPE="button" NAME="ok" TOP="10800" LEFT="180" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG5" CAPTION="Spremi" TABINDEX="2" 
	       ONCLICK="if @@indLijevo=0 begin select 'cmdlijevo' as click end else begin select 'cmddesno' as click end"/>
		
	<INPUT TYPE="button" NAME="cmdlijevo" TOP="10800" LEFT="180" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG5" CAPTION="SpremiLijevo" TABINDEX="2" VISIBLE="FALSE"
	       ONCLICK="FOREACHBLUEROW(rightkupoperateri)#dbo.spKUPPartneriZaOperateraAzur @action=&apos;spremi&apos;,@operateriid=@@rightkupoperateri,@partneriid=@@leftpartneri#select &apos;refresh&apos; as rightkupoperateri"/>
	
	<INPUT TYPE="button" NAME="cmddesno" TOP="10800" LEFT="180" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG5" CAPTION="SpremiDesno" TABINDEX="2" VISIBLE="FALSE"
	       ONCLICK="FOREACHBLUEROW(rightkuppartneri)#dbo.spKUPPartneriZaOperateraAzur @action=&apos;spremi&apos;,@operateriid=@@leftoperateri,@partneriid=@@rightkuppartneri#select &apos;refresh&apos; as rightkuppartneri"/>
	
	
	<INPUT TYPE="button" NAME="cmdObrisi" TOP="10800" LEFT="1300" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG88" CAPTION="Obriši" TABINDEX="3" 
	       ONCLICK="if @@indLijevo=0 begin select 'cmdLijevoObrisi' as click end else begin select 'cmdDesnoObrisi' as click end"/>
		   
	<INPUT TYPE="button" NAME="cmdLijevoObrisi" TOP="10800" LEFT="1300" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG89" CAPTION="Obriši" TABINDEX="2" 
	       ONCLICK=":DELETE_PARTNER_OPER_FORM#FOREACHBLUEROW(rightkupoperateri)#dbo.spKUPPartneriZaOperateraAzur @action=&apos;obrisi&apos;,@operateriid=@@rightkupoperateri,@partneriid=@@leftpartneri#select &apos;refresh&apos; as rightkupoperateri" VISIBLE="false"/>	
		   
	<INPUT TYPE="button" NAME="cmdDesnoObrisi" TOP="10800" LEFT="1300" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG91" CAPTION="Obriši" TABINDEX="2" 
	       ONCLICK=":DELETE_PARTNER_OPER_FORM#FOREACHBLUEROW(rightkuppartneri)#dbo.spKUPPartneriZaOperateraAzur @action=&apos;obrisi&apos;,@operateriid=@@leftoperateri,@partneriid=@@rightkuppartneri#select &apos;refresh&apos; as rightkuppartneri" VISIBLE="false"/>
	
    <INPUT TYPE="button" NAME="cmdLijevoDesno" TOP="10800" LEFT="6500" HEIGHT="400" WIDTH="1500" TEXT="ButtonNG6" CAPTION="Promijeni strane" TABINDEX="3" ONCLICK="dbo.spKUPStatusVisibility @indLijevo=@@indLijevo"/>
   
	<INPUT TYPE="button" NAME="cancel" TOP="10800" LEFT="12500" HEIGHT="400" WIDTH="1094" TEXT="ButtonNG6" CAPTION="Odustani" TABINDEX="4" ONCLICK="close"/>

	 <INPUT TYPE="number" NAME="indLijevo" TOP="6221" LEFT="1944" HEIGHT="346" WIDTH="1800" CAPTION="" DECIMALS="0"  ENABLED="true" VISIBLE="FALSE"/>
	
</PARTNERIPOOPERATERU>

