 <NACINPLAC_FORM CAPTION="Način plaćanja" HEIGHT="1800" WIDTH= "5100" FILLEXPLORER="" ONSUBMIT="" NEXTFORM="" ONLOAD="" >
 
   	<INPUT TYPE="frame" NAME="fr3" TOP="100" LEFT="50" HEIGHT="600" WIDTH="4800" CAPTION=""/>
   
   	<INPUT TYPE="label" NAME="lblnacinplac"  TOP="300" LEFT="200" WIDTH="1000" CAPTION="Način plaćanja:"/>	   
   	<INPUT TYPE="combo"  NAME="kntnacinplacid" TOP="300" LEFT="1700" WIDTH="3000" ALLOWEMPTY="TRUE" 
          SQL="select * from KntNacinPlac where kntnacinplacid not in (select kntnacinplacid from BLNacinPlacanja)" ONLOSTFOCUS=""/>
   
   	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="200" WIDTH="1200" CAPTION="Spremi" 
          ONCLICK="spBLNacinPlacanjaAzurNG @Action = 0,@BlagajneId=@@id,@KntNacinPlacId=@@kntnacinplacid#OK"/>
   	<INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1200" CAPTION="Odustani" ONCLICK="close"/>
 </NACINPLAC_FORM>
 
 
