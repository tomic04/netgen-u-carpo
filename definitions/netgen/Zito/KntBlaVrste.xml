<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
	ONLOAD="spBlagajneQueryNG @action=0" 
	GROUPBYBOXVISIBLE="true" 
	MASTERDBLCLICK="IZMIJENI_FORM" 
	CHECKBOXVISIBLE="FALSE"
	PAGEORIENTATION="LANDSCAPE"
	PAGEHEADERCENTER="EBA" 
	PAGEHEADERLEFT=""
	PAGEHEADERRIGHT="@@DatumVrijeme" 
	PAGEFOOTERLEFT="@@TKOSMOMI" 
	PAGEFOOTERRIGHT="Jupiter software by Spin"
	ONENTERKEY="IZMIJENI_FORM"
    	BUTTONS="Dodaj:UNESI_FORM#Izmjeni:IZMIJENI_FORM#Obriši:OBRISI_FORM"	
	>
<NAME>Vrste blagajni</NAME>
<CAPTION>Vrste blagajni</CAPTION>

<MASTERCOLUMNS CLEARCOLUMS="TRUE" HEADERALIGNMENT="2">
    	<COLUMN INDEX="" NAME="Naziv" WIDTH="3000" CAPTION="Naziv" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="OznakaValute" WIDTH="1000" CAPTION="Oznaka valute" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="" NAME="Devizna" WIDTH="1200" CAPTION="Devizna" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
   	<COLUMN INDEX="" NAME="PartneriNaziv" WIDTH="2000" CAPTION="Banka" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
    	<COLUMN INDEX="" NAME="VrstaTecaja" WIDTH="2000" CAPTION="Vrsta tečaja" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />    
    	<COLUMN INDEX="" NAME="IsKnjizenje" WIDTH="1200" CAPTION="Knjiženje" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
    	<COLUMN INDEX="" NAME="Konto" WIDTH="2000" CAPTION="Konto" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" /> 
    	<COLUMN INDEX="" NAME="VrstaDok" WIDTH="2000" CAPTION="Vrsta dokumenta" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
  	<COLUMN INDEX="" NAME="IsCekovi" WIDTH="1200" CAPTION="Evidencija čekova" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />  
    	<COLUMN INDEX="" NAME="DatumOtvaranja" WIDTH="1300" CAPTION="Datum otvaranja" FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />       		
	<COLUMN INDEX="" NAME="Napomena" WIDTH="1800" CAPTION="Napomena" FORMAT="" VISIBLE="TRUE" AGREGATEFUNCTION="0" />   
	<COLUMN INDEX="" NAME="DatumUmirovljenja" WIDTH="1300" CAPTION="Datum umirovljenja" FORMAT="dd.MM.yyyy" VISIBLE="TRUE" AGREGATEFUNCTION="0" />
 </MASTERCOLUMNS>


<UNESI_FORM CAPTION="Unos" HEIGHT="9500" WIDTH= "5800" FILLEXPLORER="" 
			 ONLOAD="select 0 as chkknjizenje,getdate() as datotvaranja
			                 ,0 as chkcekovi,0 as chkdevizna,0 as id"            
			 ONSUBMIT="" NEXTFORM="" 
			 ONLOADED="select 0 as id#select 'disable' as partneriid,'disable' as vrstatecajaid,'refresh' as nacinplac
			           ,'disable' as ok33,'disable' as ok34,'disable' as ok35,'disable' as ok36,'disable' as chkcekovi" >
    
	<INPUT TYPE="frame" NAME="fr1" TOP="50" LEFT="100" HEIGHT="6400" WIDTH="5400" CAPTION=""/>
	 
	<INPUT TYPE="label" NAME="lblnaziv" TOP="250" LEFT="200" WIDTH="1000" HEIGHT="" CAPTION="Naziv:"/>
 	<INPUT TYPE="text" NAME="naziv" TOP="200" LEFT="1400" WIDTH="4000" HEIGHT="700" CAPTION="naziv" ENABLED="TRUE" MULTILINE="FALSE"/>
	
	<INPUT TYPE="label" NAME="lbldevvaluta"  TOP="550" LEFT="200" WIDTH="1000" CAPTION="Valuta:"/>	   
    	<INPUT TYPE="combo"  NAME="valuteid" TOP="500" LEFT="1400" WIDTH="1500" ALLOWEMPTY="FALSE" 
	       SQL="select * from Valute order by oznaka" ONLOSTFOCUS=""/>
	
	<INPUT TYPE="check" NAME="chkdevizna" TOP="850" LEFT="1400" WIDTH="1600" HEIGHT="330" CAPTION="Devizna" 
	       ONCLICK="if @@chkdevizna=1 begin
		               select 'enable' as partneriid,'enable' as vrstatecajaid
				    end
					else begin
					   select 'disable' as partneriid,'disable' as vrstatecajaid
					end"/>
	
	<INPUT TYPE="label" NAME="lblbanka"  TOP="1250" LEFT="200" WIDTH="1000" CAPTION="Banka:"/>	   
    	<INPUT TYPE="combo"  NAME="partneriid" TOP="1200" LEFT="1400" WIDTH="4000" ALLOWEMPTY="TRUE" SQL="spBLOOPUzmiBankeNG" ONLOSTFOCUS=""/>
	
	<INPUT TYPE="label" NAME="lblvrtecaj"  TOP="1650" LEFT="200" WIDTH="1000" CAPTION="Vrsta tečaja:"/>	   
    	<INPUT TYPE="combo"  NAME="vrstatecajaid" TOP="1600" LEFT="1400" WIDTH="4000" ALLOWEMPTY="FALSE" SQL="spBLUzmiVrsteTecajaNG" ONLOSTFOCUS=""/>
	
	<INPUT TYPE="label" NAME="lbldatotvaranja" TOP="2050" LEFT="200" WIDTH="400" CAPTION="Datum otvaranja:"/>
	<INPUT TYPE="date" NAME="datotvaranja" TOP="2000" LEFT="1400" WIDTH="1200" CAPTION="datumotv"/>
		   
	<INPUT TYPE="label" NAME="lblkonto" TOP="2450" LEFT="200" WIDTH="800" CAPTION="Konto:"/>
	<INPUT TYPE="search" NAME="kntplanaid" HOTKEY="" BACKCOLOR="LIGHTYELLOW" CAPTION="kontotra" TOP="2400" LEFT="1400"  WIDTH="4000"  
	       SQL="spBlKntPlanAQueryNG @Action = 21,@id=null,@konto='@@searchboxkntplanaid'" ONLOSTFOCUS="" />
		   
	<INPUT TYPE="label" NAME="lblvrstadokid" TOP="2850" LEFT="200" WIDTH="800" HEIGHT="320" CAPTION="Vrsta dokumenta:"/>						
    	<INPUT TYPE="combo" NAME="vrstadokid" HOTKEY="" BACKCOLOR="" CAPTION="vrstadok" TOP="2800" LEFT="1400" ALLOWEMPTY="TRUE"
				WIDTH="4000" HEIGHT="2000" 
				SQL="select vrstadokid, naziv=vd.opis 
					 	from vrstadok vd 
 						inner join VrstaProm vp on vp.VrstaPromId=vd.vrstapromid
 						where vp.Projekt='K'
 						order by vd.opis" 
				ONLOSTFOCUS="" />	   
	 
	<INPUT TYPE="check" NAME="chkknjizenje"  TOP="3250" LEFT="1400" WIDTH="2000" HEIGHT="330" CAPTION="Automatsko knjiženje" ONCLICK=""/>
	
	<INPUT TYPE="label" NAME="lblnapomena" TOP="3650" LEFT="200" WIDTH="1000" HEIGHT="" CAPTION="Napomena:"/>
 	<INPUT TYPE="text" NAME="napomena" TOP="3600" LEFT="1400" WIDTH="4000" HEIGHT="700" CAPTION="napomena" ENABLED="TRUE" MULTILINE=""/>
	
	<INPUT TYPE="text" NAME="id" TOP="3600" LEFT="51400" WIDTH="4000" HEIGHT="700" CAPTION="id" ENABLED="TRUE" TABINDEX="-1" MULTILINE=""/>
	
    	<INPUT TYPE="grid" 
		NAME="nacinplac" 
		REFRESHAFTERCHILD="TRUE" 
		CAPTION="" 
		TOP="4050" 
		LEFT="200"  
		WIDTH="5200" 
		HEIGHT="2200"			
		ONDBLCLICK=""
		POPUP=""
		EDITCOLUMNS=""
		ONCELLEDITED=""
		CHECKBOXVISIBLE="FALSE"	
		PAGEHEADERCENTER=""
		PAGEHEADERRIGHT="@@DatumVrijeme"
		PAGEHEADERLEFT=""
		PAGEFOOTERCENTER=""
		PAGEFOOTERLEFT="@@TKOSMOMI"
		PAGEFOOTERRIGHT="Jupiter software by Spin"
		PAGEORIENTATION=""
		GROUPBYBOXVISIBLE="False"
		AFTERREFRESH=""
		SKIPDEFAULTLOAD="FALSE"
		SQL="spBLNacinPlacanjaQueryNG @action=0,@id=@@id" />
		
	<INPUT TYPE="button" NAME="ok33" HOTKEY="" TOP="6600" LEFT="200" WIDTH="1000" CAPTION="Dodaj" ONCLICK=":NACINPLAC_FORM#select 'refresh' as nacinplac" />	  
    	<INPUT TYPE="button" NAME="ok34" HOTKEY="" TOP="6600" LEFT="1200" WIDTH="1000" CAPTION="Obriši" ONCLICK="" />
	
	<INPUT TYPE="button" NAME="ok35" HOTKEY="" TOP="6600" LEFT="2400" WIDTH="500" CAPTION="" ONCLICK="" IMAGEINDEX="3" />	  
    	<INPUT TYPE="button" NAME="ok36" HOTKEY="" TOP="6600" LEFT="2900" WIDTH="500" CAPTION="" ONCLICK="" IMAGEINDEX="4" />
	
	<INPUT TYPE="check" NAME="chkcekovi"  TOP="6600" LEFT="4000" WIDTH="1600" HEIGHT="330" CAPTION="Evidencija čekova" ONCLICK=""/>
		
    	<INPUT TYPE="frame" NAME="fr2" TOP="7000" LEFT="50" HEIGHT="100" WIDTH="5600" CAPTION=""/>
	
	<INPUT TYPE="label" NAME="lbldatumirovljenja" TOP="7350" LEFT="200" WIDTH="400" CAPTION="Datum umirovljenja:"/>
	<INPUT TYPE="date" NAME="datumirovljenja" TOP="7300" LEFT="1600" WIDTH="1500" CAPTION="datmir" SHOWCHECKBOX="TRUE"/>
	
	<INPUT TYPE="frame" NAME="fr3" TOP="7700" LEFT="50" HEIGHT="100" WIDTH="5600" CAPTION=""/>
	
	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="7950" LEFT="700" WIDTH="1500" HEIGHT="400"  CAPTION="Spremi" 
	                     ONCLICK="spBlagajneAzurNG @Action = 0,@Naziv='@@naziv',@devizna=@@chkdevizna,@PartneriId=@@partneriid
								                ,@VrstaTecaja = '@@vrstatecajaid'
						                        ,@ValuteId = @@valuteid,@DatumOtvaranja = @@datotvaranja,@DatumUmirovljenja =@@datumirovljenja
                                                ,@Napomena = '@@napomena',@IsCekovi = 0,@KntPlanAId = @@kntplanaid,@VrstaDokId = @@vrstadokid
												,@ISKnjizenje = @@chkknjizenje#OK" />	  
    	<INPUT TYPE="button" NAME="ok1" HOTKEY="" TOP="7950" LEFT="3000" WIDTH="1500" HEIGHT="400"  CAPTION="Odustani" ONCLICK="OK" />
	
	<INPUT TYPE="statusstrip"  NAME="s1"    TEXT1="@@version"  TEXT2="" TEXT3="" />	

	
 </UNESI_FORM>
 
