<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD="spZRTecajevi @Action = 'pokazi_tecajeve'"
   MASTERDBLCLICK="FRTECAJIZMJENI"
   POPUPMASTER=""
   DETAILGRID = ""
   TREE="spZRKlaseTree:TECAJ_FORM"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   BUTTONS="Dodaj:FRTECAJDODAJ#Izmjeni:FRTECAJIZMJENI#Obriši:FRTECAJOBRISI" 
   POPUPDETAIL="Obriši:OBRISIFORM"
   SETDEFAULTS=""	 
>
 
 <NAME>Tečajevi</NAME>
 <CAPTION>Tečajevi</CAPTION>
 
 <TECAJ_FORM  FILLEXPLORER="TRUE" 
               ONSUBMIT="spZRTecajevi @Action ='klik_na_drvo',@id=@@node" />
 
<FRTECAJDODAJ CAPTION="Unos tečaja" HEIGHT="3400" WIDTH= "7000" FILLEXPLORER="treeandmaster" 
			 ONLOAD=""
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS=""			 >
				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2000" WIDTH="6700" TEXT="FrameNG1" CAPTION=""/>	
	
	<INPUT TYPE="label" NAME="lblKlase"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Klasa tečaja:"/>	   
	<INPUT TYPE="combo"  NAME="ZRKlTecajeviId"  TOP="500" LEFT="1500" WIDTH="3000" ALLOWEMPTY="FALSE"
		   SQL="spZRTecajevi @Action ='cbklasa'"/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="1000" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="1000" LEFT="1500"  HEIGHT="300" WIDTH="4700" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" MAXLENGTH=""/>	

    <INPUT TYPE="label" NAME="lbltrajanje" TOP="1500" LEFT="200" WIDTH="1800" CAPTION="Trajanje tečaja:"/>
	<INPUT TYPE="number" NAME="trajanje"  TOP="1500" LEFT="1500" CAPTION="trajanje" TEXT="" WIDTH="800" HEIGHT="800"  DECIMALS="0" ONLOSTFOCUS=""	/>	
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="2500" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spZRTecajevi @action='unesi_tecaj',@ZRKlTecajeviId=@@ZRKlTecajeviId,@Naziv='@@naziv',@Trajanje=@@trajanje#OK"/>
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="2500" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>				
	
 </FRTECAJDODAJ>
 
 <FRTECAJIZMJENI CAPTION="Izmjena tečaja" HEIGHT="3400" WIDTH= "7000" FILLEXPLORER="treeandmaster" 
			 ONLOAD="spZRTecajevi @action='izmjeni',@ZRTecajeviId=@@id"
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS="" >
				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="2000" WIDTH="6700" TEXT="FrameNG1" CAPTION=""/>	
	
	<INPUT TYPE="label" NAME="lblKlase"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Klasa tečaja:"/>	   
	<INPUT TYPE="combo"  NAME="ZRKlTecajeviId"  TOP="500" LEFT="1500" WIDTH="3000" ALLOWEMPTY="FALSE"
		   SQL="spZRTecajevi @Action ='cbklasa'"/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="1000" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="1000" LEFT="1500"  HEIGHT="300" WIDTH="4400" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" MAXLENGTH=""/>	

    <INPUT TYPE="label" NAME="lbltrajanje" TOP="1500" LEFT="200" WIDTH="1800" CAPTION="Trajanje tečaja:"/>
	<INPUT TYPE="number" NAME="trajanje"  TOP="1500" LEFT="1500" CAPTION="trajanje" TEXT="" WIDTH="800" HEIGHT="800"  DECIMALS="0" ONLOSTFOCUS=""	/>	
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="2500" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spZRTecajevi @action='izmjeni_tecaj',@ZRKlTecajeviId=@@ZRKlTecajeviId,@Naziv='@@naziv',@Trajanje=@@trajanje,@ZRTecajeviId=@@id#OK"/>	   
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="2500" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>				
	
   </FRTECAJIZMJENI>
   

 <FRTECAJOBRISI NAME="Brisanje" HEIGHT="1699" WIDTH="4205" CAPTION="Brisanje" FILLEXPLORER="treeandmaster" >
	       <INPUT TYPE="label" NAME="lbld" TOP="302" LEFT="245" HEIGHT="288" WIDTH="403" CAPTION="Jeste li sigurni da želite obrisati označeni slog ?"/>
	       <INPUT TYPE="button" NAME="ok" TOP="806" LEFT="245" HEIGHT="331" WIDTH="994" TEXT="ButtonNG214" CAPTION="Obriši" TABINDEX="0" 
		          ONCLICK="spZRTecajevi @action='obrisi_tecaj',@ZRTecajeviId=@@id#OK"/>
	       <INPUT TYPE="button" NAME="cancel" TOP="806" LEFT="1354" HEIGHT="331" WIDTH="994" TEXT="ButtonNG215" CAPTION="Odustani" TABINDEX="1" ONCLICK="close"/>

 </FRTECAJOBRISI>
  
</PROJECT>
