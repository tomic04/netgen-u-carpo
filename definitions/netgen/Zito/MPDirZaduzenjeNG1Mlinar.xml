           ONCLICK="spMPInsertGlaIdetNG @action=1, @operateriid=@@operateriid, @status = 1, @trgovinaid = @@trgovinaid, @datumdok = @@datumdok, @vrstadokid = @@vrstadokid, @partneriid = @@partneriid , @napomena = '@@napomena', @osobeid = @@osobeid, @ind_prim=1, @ind_kalk = 0 
                    #:DONOSIZNAR#ok"  />
    
  </INSERT_FORM>


  
  <UPDATE_FORM
      CAPTION="Izmjena dokumenta "
      HEIGHT="9000"
      WIDTH= "11000"
      FILLEXPLORER=""
      FOCUS="datumdok"
      ONLOAD="if (select status from maloprodajagla where maloprodajaglaid = @@ID ) = 2 or 
              ((select ind_kalk from maloprodajagla where maloprodajaglaid = @@ID) > 0 and (select count(*) from maloprodajadet where maloprodajaglaid = @@ID) > 0) begin 
				       exec spRaiserror 69001, &apos;Dokument je zaključen . Ne može se više ispravljati !&apos;
				      end else begin
				      if @@id = 0  begin 
						    exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos;
				      end else begin 
					      exec spMPQueryGlaIDetNG @action=3, @ID=@@ID, @operateriid = @@operateriid	end	end"
      ONLOADED="spmpOperaterlock @action = 1, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#select 'refresh' as stavke "
      ONESCKEY="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
      ONCLOSED="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok">

