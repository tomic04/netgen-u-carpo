    <INPUT TYPE="date"   NAME="datumdok"    CAPTION="Datum*"     TOP="300"  LEFT="1400" ONLOSTFOCUS="" />
    <INPUT TYPE="text"   NAME="broj"        CAPTION="_Broj*"     TOP="300"  LEFT="4000" ENABLED="FALSE" WIDTH="3500" HEIGHT="280" />
    <INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*"  TOP="650"  LEFT="1400" ENABLED="FALSE" WIDTH="3500" HEIGHT="280"
           SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" ONLOSTFOCUS="select 'refresh' as partneriid, 'refresh' as osobeid"/>
    <INPUT TYPE="combo"  NAME="osobeid"		CAPTION="Odgovorna osoba*"  TOP="650"  LEFT="7000" WIDTH="3500" HEIGHT="280" ALLOWEMPTY="FALSE" SQL="spMPDajosobe @trgovinaid = @@trgovinaid" />
    <INPUT TYPE="combo" NAME="partneriid"  CAPTION="Partner*"   TOP="1000"  LEFT="1400" WIDTH="3500" HEIGHT="280"
           SQL="spmpDajPartnerAsortiman  @trgovinaid = @@trgovinaid  " ONLOSTFOCUS="select 'refresh' as stavke" BACKCOLOR="LIGHTYELLOW" />
    <INPUT TYPE="text"  NAME="napomena"  CAPTION="Broj dostavnice/računa*"  TOP="1000"  LEFT="7000" SQL=""  WIDTH="3500" HEIGHT="280"/>
    <INPUT TYPE="combo"  NAME="vrstadokid"  CAPTION="Vrsta dokumenta*" TOP="1350" LEFT="1400" ENABLED="FALSE"  WIDTH="3500" HEIGHT="280"
           SQL="select vrstadokid,opis from vrstadok where vrstapromid=(select vrstapromid from vrstaprom where sifra='99')" />
    
    <INPUT TYPE="grid"
			   NAME="stavke"
			   REFRESHAFTERCHILD="TRUE"
			   CAPTION="Stavke"
			   TOP="2000" LEFT="56" WIDTH="10500" HEIGHT="5700"
			   TABINDEX="-1"
			   AFTERREFRESH="select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   POPUP=""
			   ONDBLCLICK=""
			   EDITCOLUMNS="[Količina1000]"
         SKIPDEFAULTLOAD="TRUE"
         AUTOMATICSORT="FALSE"
         ONCELLEDITED=""
			   CHECKBOXVISIBLE="FALSE"
			   PAGEHEADERCENTER="MP Primka br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@tkosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spmpPrimkaMlinar @action = 1 , @id = @@id,  @trgovinaid = @@trgovinaid, @partneriid = @@partneriid, @datumdok = @@datumdok  " />

    <INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno MPV*" TOP="8000" LEFT="8000" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>

    <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="8000" LEFT="196" WIDTH="1106" HEIGHT="322" HOTKEY="F2"
			   ONCLICK="spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@datumdok= @@datumdok, @osobeid = @@osobeid, @partneriid = @@partneriid, @status = 1, @napomena = '@@napomena' 
         #delete maloprodajadet where maloprodajaglaid = @@id 
         #FOREACHROW(Stavke)#if @(Stavke..Količina1000) > 0 begin exec spMPInsertGlaIdetNG @action = 3,  @robaid = @@Stavke , @id = @@id , @kolicinaulaz = @(Stavke..Količina1000), @mpcijena = @(Stavke..MPC1000), @nabcijena =@(Stavke..nabid), @fakcijena = @(Stavke..fakid), @rabatdp = @(Stavke..rabid) end 
         #Ok"  />
    <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani (Esc)" TOP="8000" LEFT="1456"  HEIGHT="322" ONCLICK="close"  />

    <INPUT TYPE="button" NAME="donosnar" CAPTION="Donesi sa narudžbenice" TOP="8000" LEFT="3500" WIDTH="2100" HEIGHT="322" ONCLICK=":DONOSIZNAR#ok"  />

  </UPDATE_FORM>



<FILTERFORM 
  NAME="FILTERFORM" 
  HEIGHT="4500" WIDTH="7500" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPQueryGlaIDetNG @action = 1, @sifradok = '99', @operateriid = @@operateriid, @dir = 1, @trgovinaid = @@xtrgovinid, @datumod = '@@xdatumod', @datumdo = '@@xdatumdo', @partneriid = @@xpartneriid,  @trazibroj = '@@trazibroj'!!"
	ONLOAD="select @@xdatumod as xdatumod, @@xdatumdo as datumdo" 
	FILLEXPLORER="TRUE" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >
  
			<INPUT TYPE="date" NAME="xdatumod" CAPTION="Datum od" DEFAULT="firstdayofmonth"/>
			<INPUT TYPE="date" NAME="xdatumdo" CAPTION="Datum do" DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="xtrgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina" 
             SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @vrstatrg='M'" ONLOSTFOCUS="select 'refresh' as partneriid" />
			<INPUT TYPE="search" NAME="xpartneriid"  ALLOWEMPTY="TRUE" CAPTION="Partner" SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#!adresa" BACKCOLOR="LIGHTYELLOW" />
			<INPUT TYPE="combo" NAME="xstatus" ALLOWEMPTY="true" CAPTION="Status" 
             SQL="select 0 as status,&apos;Otvoren&apos; as naziv  union all select 1 as status,&apos;Naloženo &apos; as naziv union all select 2 as status,&apos;Zaprimljeno &apos; as naziv" />
			<INPUT TYPE="text" NAME="trazibroj" WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta" ONLOSTFOCUS=""/>
</FILTERFORM>



<ZAKLJUCI 
  NAME="ZAKLJUCI" HEIGHT="3200" WIDTH="5500" 
  CAPTION="Zaključiti dokument  ?" 
  ONSUBMIT=""
  ONLOAD="if (select status from maloprodajagla where maloprodajaglaid= @@ID ) > 1 begin 
            exec spRaiserror 69001, 'Dokument je zaključen. Ne može se više zaključivati!' 
			    end	else begin
            exec spMPQueryGlaIDetNG @action=3,@ID=@@ID	end" 
  FILLEXPLORER="" 
  ONLOADED="spmpOperaterlock @action = 1, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'"
  ONESCKEY="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
  ONCLOSED="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"	>
  
  <INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="1800" HEIGHT="320" WIDTH="2800" CAPTION="_broj" ENABLED="FALSE"/>
  <INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Broj MP primke:" />
  <INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="400" HEIGHT="490" WIDTH="4500" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? " />
  
  <INPUT TYPE="button" NAME="ok" ANCHOR="9" CAPTION="Zaključi" TOP="2000" LEFT="500" WIDTH="1050" HEIGHT="322"
         ONCLICK="OK#if (select count(*) from maloprodajadet where maloprodajaglaid = @@id ) = 0 begin 
			              exec spRaiserror 69001, 'Dokument nema stavaka. Ne može se zaključiti !' end 
			           else begin 
			              exec spmpzakljucidokNG @id=@@id, @ind_kalk = 0 end"  />
  <INPUT TYPE="button" NAME="cancel" ANCHOR="9" CAPTION="Odustani" TOP="2000" LEFT="1800" WIDTH="1050" HEIGHT="322" ONCLICK="close"  />
</ZAKLJUCI>



<OTKLJUCAJ 
		 NAME="OTKLJUCAJ" HEIGHT="3200" WIDTH="5500" 
		 CAPTION="Otključavanje dokumenta  ?" 
		 ONSUBMIT="update maloprodajagla set status = 1 where maloprodajaglaid = @@ID"
		 ONLOAD="if (select status from maloprodajagla where maloprodajaglaid= @@ID ) &lt;> 2 or  (select ind_kalk from maloprodajagla where maloprodajaglaid= @@ID ) &lt;> 0 begin 
              exec spRaiserror 69001, 'Dokument se ne može više otključavati!' 
						end else begin
              exec spMPQueryGlaIDetNG @action=3,@ID=@@ID end"
		 FILLEXPLORER="" 
		 CMD1CAPTION="Otključaj" 
     CMD2CAPTION="Odustani">

  <INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="1800" HEIGHT="320" WIDTH="2800" CAPTION="_broj" ENABLED="FALSE"/>
  <INPUT TYPE="label" NAME="Label57" TOP="360" LEFT="288" HEIGHT="288" WIDTH="1800" BOLD="FALSE" CAPTION="Broj MP primke:" />
	<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="400" HEIGHT="490" WIDTH="4500"  BOLD="TRUE" CAPTION="Jeste li sigurni da želite otključati dokument  ? " />
</OTKLJUCAJ>



