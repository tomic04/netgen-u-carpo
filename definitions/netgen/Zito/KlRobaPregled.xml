<FILTERFORM NAME="FILTERFORM" HEIGHT="1656" WIDTH="7085" CAPTION="Form" ONSUBMIT="If @@KlasaId is not null begin

select Sortkey as [Sortkey1500], naziv as [Naziv3000], Oznaka as [Oznaka1000] from klroba 
where klklrobaid=@@KlasaId
order by sortkey 
	end

	else begin
select Sortkey as [Sortkey1500], naziv as [Naziv3000], Oznaka as [Oznaka1000] from klmasterroba 
order by sortkey
	end--
" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="combo" NAME="KlasaId" TOP="115" LEFT="1843" HEIGHT="302" WIDTH="4291" SQL="select klklrobaid, naziv from klklroba" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label18" TOP="115" LEFT="216" HEIGHT="288" WIDTH="1555" CAPTION="Klasifikacija robe:" TEXT="Label18"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="605" LEFT="1382" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="605" LEFT="230" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" ENABLED="TRUE" ONCLICK="OK"/>

</FILTERFORM>
</PROJECT>