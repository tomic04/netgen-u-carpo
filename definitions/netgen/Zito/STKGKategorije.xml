<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTKategorijaKG @actioN = 1 " 
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Pokaži:POKAZI_FORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="select 'disable' as Pokaži, 'disable' as Brisanje" 
		 REPORT=""
		 PAGEHEADERCENTER="Kategorije grla"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">

	<MASTERCOLUMNS>
		<COLUMN INDEX="4" NAME=" " CAPTION="" FORMAT="#,##0.##0" />
		<COLUMN INDEX="5" NAME=" " CAPTION="" FORMAT="#,##0.##0" />
	</MASTERCOLUMNS>

	<NAME>Težinske kategorije stoke</NAME>
	<CAPTION>Težinske kategorije stoke</CAPTION>
	<AUTOR>26.03.2013. matija horvat</AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTKategorija @action = 1, @operateriid= @@operateriid , @vrsta = 'G' " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM"
      HEIGHT="4000" WIDTH="7502"
      CAPTION="Dodavanje težinske kategorije"
      FOCUS=""
      ONLOAD=""
			   
		>

    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="2200"  ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="stfarmeid"  CAPTION="Farma*" TOP="500" LEFT="1500" HEIGHT="317" WIDTH="3000"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>
    
    <INPUT TYPE="number" NAME="odkg" 	  CAPTION="Težina od (kg)*" TOP="900" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>
    <INPUT TYPE="number" NAME="dokg" 	  CAPTION="Težina do (kg)*" TOP="1300" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>

    
    
    <INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3000" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaKG  @action = 2, @odkg = @@odkg, @dokg = @@dokg, @stfarmeid = @@stfarmeid#Ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM"
      HEIGHT="4000" WIDTH="7502"
      CAPTION="Izmjena težinske kategorije"
      FOCUS=""
      ONLOAD="if  @@id = 0 begin
                raiserror 19001 ' Odaberite kilažnu kategoriju koju želite ispraviti !'
		         end
             else begin
                select * from STTezinskaKategorija where STTezinskaKategorijaId = @@id
             end"
     >

    <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="2200"  ENABLED="TRUE"/>
    <INPUT TYPE="combo"   NAME="stfarmeid"  CAPTION="Farma*" TOP="500" LEFT="1500" HEIGHT="317" WIDTH="3000"   ENABLED="TRUE" SQL="spstdajfarme @operateriid = @@operateriid"/>

    <INPUT TYPE="number" NAME="odkg" 	  CAPTION="Težina od (kg)*" TOP="900" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>
    <INPUT TYPE="number" NAME="dokg" 	  CAPTION="Težina do (kg)*" TOP="1300" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS=""/>

    
    <INPUT TYPE="button" NAME="ok"            CAPTION="Spremi "  TOP="3000" LEFT="456" WIDTH="1106"  HEIGHT="322"
					ONCLICK="spSTKategorijaKG  @action = 3, @odkg = @@odkg, @dokg = @@dokg, @stfarmeid = @@stfarmeid, @id = @@id #Ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</UPDATE_FORM>
  
<DELETE_FORM 
     NAME="DELETE_FORM"
		 HEIGHT="4000" WIDTH="7502"
		 CAPTION="Brisanje težinske kategorije grla ? Jeste li sigurni ?!"
     ONLOAD="if  @@id = 0 begin
              raiserror 19001 ' Odaberite kilažnu kategoriju koju želite obrisati !'
              end
              else begin
              select * from STTezinskaKategorija where STTezinskaKategorijaId = @@id
              end"
		 ONSUBMIT="spSTKategorija @action = 5, @operateriid= @@operateriid, @ID=@@ID, "
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

 
  <INPUT TYPE="frame"   NAME="frm"         CAPTION="" TOP="50" LEFT="100" WIDTH="7000" HEIGHT="2200"  ENABLED="TRUE"/>
  <INPUT TYPE="combo"   NAME="stfarmeid"  CAPTION="Farma*" TOP="500" LEFT="1500" HEIGHT="317" WIDTH="3000"   ENABLED="FALSE" SQL="spstdajfarme @operateriid = @@operateriid"/>

  <INPUT TYPE="number" NAME="odkg" 	  CAPTION="Težina od (kg)*" TOP="900" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS="" ENABLED="FALSE"/>
  <INPUT TYPE="number" NAME="dokg" 	  CAPTION="Težina do (kg)*" TOP="1300" LEFT="1500" WIDTH="1000" HEIGHT="280" DECIMALS="4" SQL=""  ONLOSTFOCUS="" ENABLED="FALSE"/>

  <INPUT TYPE="combo" NAME="stspolteletaid" CAPTION="Spol*" TOP="1700" LEFT="1500" WIDTH="3000" HEIGHT="320" ALLOWEMPTY="False" SQL="select stspolteletaid ,opis as naziv WHERE stspolteleta = @@stspolteletaid" ENABLED="FALSE" />

  <INPUT TYPE="button" NAME="ok"            CAPTION="Obriši "  TOP="3000" LEFT="456" WIDTH="1106"  HEIGHT="322"
        ONCLICK="spSTKategorijaKG  @action = 4, @id = @@id #Ok"  HOTKEY="F2" />
  <INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="3000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</DELETE_FORM>

</PROJECT>