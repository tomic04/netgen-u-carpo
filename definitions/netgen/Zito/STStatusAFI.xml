<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spSTStatusAFI @action = 2 " 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Pokaži:POKAZI_FORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Ispis liste:PRINTMASTER" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Statusi grla u AFIfarm"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Statusi grla u AFIfarm</NAME>
	<CAPTION>Statusi grla u AFIfarm</CAPTION>
	<AUTOR>28.09.2016. Matija Horvat </AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spSTStatusAFI @action = 1, @operateriid= @@operateriid " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3000" 
		 WIDTH="5000" 
		 CAPTION="Unos novog statusa"
		 ONSUBMIT="spSTStatusAFI @action = 3, "
		 ONLOAD="" 
		 VERSION="1.2"
		 NEXTFORM=""
		 FOCUS="status" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="text"    NAME="status"   CAPTION="Status:*"     ENABLED="TRUE" TOP="400" WIDTH="3000" LEFT="1000"  />
		<INPUT TYPE="text"    NAME="GynStatus"   CAPTION="Gyn Status:*"     ENABLED="TRUE" TOP="800" WIDTH="3000" LEFT="1000" />
		<INPUT TYPE="text"    NAME="Code"   CAPTION="Code:*"     ENABLED="TRUE" TOP="1200" WIDTH="1000" LEFT="1000" />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="3000" 
		 WIDTH="5000" 
		 VERSION="1.2"
		 CAPTION="Izmjena postojećeg statusa"
		 ONSUBMIT="spSTStatusAFI @action = 4, @STKategorijaAFIID = @@ID, "
		 ONLOAD="select * from STKategorijaAFI where STKategorijaAFIId = @@id" 
		 NEXTFORM=""
		 FOCUS="status" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="text"    NAME="status"   CAPTION="Status:*"     ENABLED="TRUE" TOP="400" WIDTH="3000" LEFT="1000"  />
		<INPUT TYPE="text"    NAME="GynStatus"   CAPTION="Gyn Status:*"     ENABLED="TRUE" TOP="800" WIDTH="3000" LEFT="1000" />
		<INPUT TYPE="text"    NAME="Code"   CAPTION="Code:*"     ENABLED="TRUE" TOP="1200" WIDTH="1000" LEFT="1000" />
		
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="3000" 
		 WIDTH="5000" 
		 VERSION="1.2"
		 CAPTION="Brisanje statusa? Jeste li sigurni ?!"
		 ONSUBMIT="spSTStatusAFI @action = 5, @STKategorijaAFIID = @@ID, "
		 ONLOAD="select * from STKategorijaAFI where STKategorijaAFIId = @@id" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="text"    NAME="status"   CAPTION="Status:*"     ENABLED="FALSE" TOP="400" WIDTH="3000" LEFT="1000"  />
		<INPUT TYPE="text"    NAME="GynStatus"   CAPTION="Gyn Status:*"     ENABLED="FALSE" TOP="800" WIDTH="3000" LEFT="1000" />
		<INPUT TYPE="text"    NAME="Code"   CAPTION="Code:*"     ENABLED="FALSE" TOP="1200" WIDTH="1000" LEFT="1000" />
</DELETE_FORM>

</PROJECT>