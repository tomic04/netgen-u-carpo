<FILTER NAME="FILTER" HEIGHT="3816" WIDTH="7085" CAPTION="Uvjeti prikaza" ONSUBMIT="spKoopLimitiPregledNG1 @partneriid=@@Fpartneriid, @kultureid=@@Fkultureid, @klmasterrobaid=@@Fklmasterrobaid, @godina=@@Fgodina --" ONLOAD="select @@Fkultureid as Fkultureid, @@Fklmasterrobaid as Fklmasterrobaid, @@Fpartneriid as Fpartneriid, &apos;@@searchboxFpartneriid&apos; as Partner, coalesce(@@Fgodina,year(getdate())) as Fgodina" FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="72" HEIGHT="2376" WIDTH="6840" TEXT="FrameNG0"/>
	<INPUT TYPE="combo" NAME="Fkultureid" TOP="432" LEFT="2160" HEIGHT="302" WIDTH="4320" SQL="select KultureId, rtrim(Naziv) from Kulture order by Naziv" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label13" TOP="432" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Kultura:"/>
	<INPUT TYPE="combo" NAME="Fklmasterrobaid" TOP="864" LEFT="2160" HEIGHT="302" WIDTH="4320" SQL="select KlMasterRobaId, space(len(SortKey)-2) + Naziv from KlMasterRoba order by SortKey" ALLOWEMPTY="TRUE"/>
	<INPUT TYPE="label" NAME="Label14" TOP="864" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Klasa robe:"/>
	<INPUT TYPE="search" NAME="Fpartneriid" TOP="1296" LEFT="2160" HEIGHT="302" WIDTH="4320" SQL="Partneri#PartneriId#Naziv%#PorezniBroj%#Sifra%" CAPTION="Partner"/>
	<INPUT TYPE="label" NAME="Label15" TOP="1296" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Partner:"/>
	<INPUT TYPE="combo" NAME="Fgodina" TOP="1728" LEFT="2160" HEIGHT="302" WIDTH="1440" SQL="select year(getdate())-3 as id, year(getdate())-3 as naziv
union all
select year(getdate())-2 as id, year(getdate())-2 as naziv
union all
select year(getdate())-1 as id, year(getdate())-1 as naziv
union all
select year(getdate()) as id, year(getdate()) as naziv
union all
select year(getdate())+1 as id, year(getdate())+1 as naziv
union all
select year(getdate())+2 as id, year(getdate())+2 as naziv
union all
select year(getdate())+3 as id, year(getdate())+3 as naziv" DECIMALS="0"/>
	<INPUT TYPE="label" NAME="Label16" TOP="1728" LEFT="432" HEIGHT="288" WIDTH="1728" CAPTION="Godina:"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="2808" LEFT="432" HEIGHT="331" WIDTH="1368" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prikaži" ENABLED="TRUE" ONCLICK="OK"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2808" LEFT="2160" HEIGHT="331" WIDTH="1368" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>

</FILTER>
