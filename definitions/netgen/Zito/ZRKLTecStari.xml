<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD="spZRKlaseTecajevi @Action = 'pokazi_klase'"
   MASTERDBLCLICK="FRKLASEIZMJENI"
   POPUPMASTER=""
   DETAILGRID = ""
   TREE="spZRKlaseTree:KLASE_FORM"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   BUTTONS="Dodaj:FRKLASEDODAJ#Izmjeni:FRKLASEIZMJENI#Obriši:FRKLASEOBRISI" 
   POPUPDETAIL="Obriši:OBRISIFORM"
   SETDEFAULTS=""	 
>
 
 <NAME>Klase tečajeva</NAME>
 <CAPTION>Klase tečajeva</CAPTION>
 
 <KLASE_FORM  FILLEXPLORER="TRUE" 
               ONSUBMIT="spZRKlaseTecajevi @Action ='klik_na_drvo',@id=@@node" />
 
<FRKLASEDODAJ CAPTION="Unos klase" HEIGHT="2400" WIDTH= "6000" FILLEXPLORER="" 
			 ONLOAD=""
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS=""			 >
				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="1000" WIDTH="5700" TEXT="FrameNG1" CAPTION=""/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="500" LEFT="1000"  HEIGHT="300" WIDTH="4400" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" MAXLENGTH=""/>		  
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="1400" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spZRKlaseTecajevi @action='unesi_klase',@Naziv='@@naziv'#OK"/>
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="1400" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>				
	
 </FRKLASEDODAJ>
 
 <FRKLASEIZMJENI CAPTION="Izmjena klase" HEIGHT="2400" WIDTH= "6000" FILLEXPLORER="" 
			 ONLOAD="spZRKlaseTecajevi @action='izmjeni',@ZRKlTecajeviId=@@id"
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS="" >
				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="1000" WIDTH="5700" TEXT="FrameNG1" CAPTION=""/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="500" LEFT="1000"  HEIGHT="300" WIDTH="4400" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" />	
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="1400" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spZRKlaseTecajevi @action='izmjeni_klase',@Naziv='@@naziv',@ZRKlTecajeviId=@@id#OK"/>	   
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="1400" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>				
	
   </FRKLASEIZMJENI>
   

 <FRKLASEOBRISI NAME="Brisanje" HEIGHT="1699" WIDTH="4205" CAPTION="Brisanje" FILLEXPLORER="" >
	       <INPUT TYPE="label" NAME="lbld" TOP="302" LEFT="245" HEIGHT="288" WIDTH="403" CAPTION="Jeste li sigurni da želite obrisati označeni slog ?"/>
	       <INPUT TYPE="button" NAME="ok" TOP="806" LEFT="245" HEIGHT="331" WIDTH="994" TEXT="ButtonNG214" CAPTION="Obriši" TABINDEX="0" 
		          ONCLICK="spZRKlaseTecajevi @action='obrisi_klase',@ZRKlTecajeviId=@@id#OK"/>
	       <INPUT TYPE="button" NAME="cancel" TOP="806" LEFT="1354" HEIGHT="331" WIDTH="994" TEXT="ButtonNG215" CAPTION="Odustani" TABINDEX="1" ONCLICK="close"/>

 </FRKLASEOBRISI>
  
</PROJECT>
