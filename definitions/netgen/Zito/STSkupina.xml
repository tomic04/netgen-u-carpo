		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Unos skupine grla"
		 ONSUBMIT="spSTSkupina @action = 3, @operateriid= @@operateriid, "
		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"         CAPTION="Naziv skupine:"  TABINDEX="0"  ENABLED="TRUE"  WIDTH="4000"  />
		 <INPUT TYPE="text"    NAME="Sifra"		   CAPTION="Šifra:"          TABINDEX="1"  ENABLED="TRUE"  WIDTH="1000"   SQL=""  />
		 <INPUT TYPE="text"    NAME="SkupinaU"	   CAPTION="U skupinu:"      TABINDEX="2"  ENABLED="TRUE"  WIDTH="5000"  SQL=""  />
         <INPUT TYPE="text"    NAME="Spol"		   CAPTION="Spol:"           TABINDEX="3"  ENABLED="TRUE"  WIDTH="1000"   SQL=""  />
</INSERT_FORM>

<UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Izmjena skupine grla"
		 ONSUBMIT="spSTSkupina @action = 4, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from STSkupina where STSkupinaId=@@id" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"         CAPTION="Naziv skupine:"  TABINDEX="0"  ENABLED="TRUE"  WIDTH="4000"  />
		 <INPUT TYPE="text"    NAME="Sifra"		   CAPTION="Šifra:"          TABINDEX="1"  ENABLED="TRUE"  WIDTH="1000"   SQL=""  />
		 <INPUT TYPE="text"    NAME="SkupinaU"	   CAPTION="U skupinu:"      TABINDEX="2"  ENABLED="TRUE"  WIDTH="5000"  SQL=""  />
         <INPUT TYPE="text"    NAME="Spol"		   CAPTION="Spol:"           TABINDEX="3"  ENABLED="TRUE"  WIDTH="1000"   SQL=""  />
</UPDATE_FORM>

<DELETE_FORM NAME="DELETE_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 CAPTION="Brisanje skupine grla ? Jeste li sigurni ?!"
		 ONSUBMIT="spSTSkupina @action = 5, @operateriid= @@operateriid, @ID=@@ID, "
		 ONLOAD="select * from STSkupina where STSkupinaId=@@id" 
		 NEXTFORM=""
		 FOCUS="" 
		 CMD1CAPTION="Obriši" 
		 CMD2CAPTION="Odustani" >

		 <INPUT TYPE="text"    NAME="Opis"         CAPTION="Naziv skupine:"  TABINDEX="0"  ENABLED="FALSE"  WIDTH="4000"  />
		 <INPUT TYPE="text"    NAME="Sifra"		   CAPTION="Šifra:"          TABINDEX="1"  ENABLED="FALSE"  WIDTH="1000"   SQL=""  />
