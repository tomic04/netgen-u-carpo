<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Parametri:MAINFORM" ONLOAD=":MAINFORM" GROUPBYBOXVISIBLE="FALSE" FROZENCOLUMNS="0" MASTERDBLCLICK="KARTICA" 
		  CHECKBOXVISIBLE="FALSE">
<NAME>Ambulantni dnevnik</NAME>
<CAPTION>Ambulantni dnevnik</CAPTION>
<KOMENTAR>CallistoII 2.1.1</KOMENTAR>

<MAINFORM   HEIGHT="8006" WIDTH="11002" CAPTION="Ambulantni dnevnik" ONLOAD="SELECT convert(char(4),year(getdate()))+&apos;0101&apos; as datumod,		
				(select rtrim(p.naziv)+&apos;, &apos;+rtrim(m.naziv)+&apos;, &apos;+rtrim(s.adresa)
					from Partneri p
					inner join ParStru s on p.PartneriId = s.PartneriId
					inner join Mjesta m on s.MjestaId = m.MjestaId
				where
					p.PartneriId = convert(integer,(select VarSet from PubVars where VarIme = &apos;NasId&apos;))
					and s.Hqind = &apos;*&apos;) as tkosmomi, 1 as evidkat, getdate() as DatumVrijeme, char(13)+char(10) as NoviRed" MAXIMIZEBOX="TRUE" WINDOWSTATE="0">

	<INPUT TYPE="group" NAME="topgroupbox" TOP="144" LEFT="2160" HEIGHT="1094" WIDTH="1440" VISIBLE="TRUE" CAPTION="Unesite parametre upita : " ENABLED="TRUE" DOCK="1"/>
	<INPUT TYPE="button" NAME="b1" TOP="144" LEFT="202" HEIGHT="317" WIDTH="1498" TEXT="ButtonNG34" CAPTION="Ispis" ONCLICK="PRINTGRID(mastergrid)" PARENT="bottomgroupbox"/>
	<INPUT TYPE="button" NAME="b1" TOP="144" LEFT="4205" HEIGHT="317" WIDTH="1498" TEXT="ButtonNG35" CAPTION="Kraj" ONCLICK="close" PARENT="bottomgroupbox"/>
	<INPUT TYPE="combo" NAME="stfarmeidid" TOP="245" LEFT="994" HEIGHT="302" WIDTH="4493" SQL="spstDajFarme @operateriid = @@operateriid" ALLOWEMPTY="FALSE" CAPTION="Farma:*"/>
	<INPUT TYPE="check" NAME="evidkat" SQL="" DECIMALS="2" ALLOWEMPTY="FALSE" TOP="245" LEFT="5702" CAPTION="Evidencija kategorija*"/>	
	<INPUT TYPE="button" NAME="b0" TOP="245" LEFT="8702" HEIGHT="720" WIDTH="994" TEXT="ButtonNG33" CAPTION="Pokaži" ONCLICK="select &apos;refresh&apos; as mastergrid" PARENT="topgroupbox"/>

	<INPUT TYPE="group" NAME="bottomgroupbox" TOP="504" LEFT="2160" HEIGHT="547" WIDTH="1440" VISIBLE="TRUE" ENABLED="TRUE" DOCK="2"/>
	<INPUT TYPE="date" NAME="datumod" TOP="706" LEFT="994" HEIGHT="302" WIDTH="2002" CAPTION="Datum od:*"/>
	<INPUT TYPE="date" NAME="datumdo" TOP="706" LEFT="3485" HEIGHT="302" WIDTH="2002" CAPTION="do:*"/>

	<INPUT TYPE="grid" NAME="mastergrid" TOP="864" LEFT="2160" HEIGHT="2160" WIDTH="2880" TOTALROW="FALSE" CHECKBOXVISIBLE="FALSE" PAGEORIENTATION="LANDSCAPE"
				PAGEHEADERCENTER="Ambulantni dnevnik @@NoviRed Farma: @@comboboxstfarmeidid" PAGEHEADERRIGHT="Od @@datumod do @@datumdo" PAGEFOOTERLEFT="@@TKOSMOMI" PAGEFOOTERRIGHT="Jupiter software by Spin" SQL="if year(@@datumod)&lt;&gt;year(@@datumdo) begin 
				raiserror 19001 &apos;Ambulantni dnevnik može se pregledavati samo u istoj godini ! Molim ponovite upit !&apos;
				end exec spSTAmbDnev @@stfarmeid,@@datumod,@@datumdo,@@operateriid,@@evidkat" DOCK="5"/>

</MAINFORM >
  
</PROJECT>