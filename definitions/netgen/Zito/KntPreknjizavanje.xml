<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Pokaži:FILTERFORM" 
      CMD2CAPTION="Makni sve:UPDATEFORM" 
      CMD3CAPTION="Označi sve:UPDATEFORM2" 
      CMD4CAPTION="Makni ili Označi:UPDATEFORM3" 
      CMD5CAPTION="Proknjiži:PROKNJIZI" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION=""   
      REPORT="" 
      DBLCLICKFORM="UPDATEFORM3"
      POPUP="Proknjiži:PROKNJIZI">
 
  <NAME>Preknjižavanje računa s konta na konto</NAME>
  <CAPTION>Preknjižavanje računa s konta na konto</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

  
  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spKntPreknjizavanjeTotalGen @action=1," 
                         STARTUPSTORA="select getdate() as DatumKnjizenja" 
                         HEIGHT="5600" 
                         CAPTION="Izaberi parametre upita"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl0" 
                                      	TOP="600" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Partner:"/>

			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partner:" 
					NAME="partneriid" 
					SQL="Partneri#partneriid#naziv%" 
					TEXT=""
					TOP="600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
					TABINDEX="0" 
					HEIGHT="320"/>

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl1" 
                                      	TOP="1200" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Stari konto"/>
                     	<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" 
                                     	NAME="kntplana1id" 
                                    	CAPTION="Stari konto" 
                                     	TOP="1100"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="" 
                                 	SQL="select distinct p.kntplanaid,ltrim(rtrim(p.konto))+' - '+ltrim(rtrim(p.naziv))+' - '+ ltrim(rtrim(coalesce(g.VrstaKonta,'Običan konto'))) as [Naziv]  from kntplana p  inner join kntvrsta g on p.kntvrstaid=g.kntvrstaid where  g.tablica!='Partneri'   order by naziv"  /> 


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      	TOP="1700" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Novi konto"/>
                     	<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" 
                                     	NAME="kntplana2id" 
                                    	CAPTION="Novi konto" 
                                     	TOP="1600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="" 
                                 	SQL="select distinct p.kntplanaid,ltrim(rtrim(p.konto))+' - '+ltrim(rtrim(p.naziv))+' - '+ ltrim(rtrim(coalesce(g.VrstaKonta,'Običan konto'))) as [Naziv]  from kntplana p left outer join kntvrsta g on p.kntvrstaid=g.kntvrstaid  order by naziv"  /> 


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl3" 
                                      	TOP="2200" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Vrsta temeljnice"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta temeljnice" 
                                     	TOP="2100"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="" 
                                 	SQL="select distinct vd.vrstadokid,ltrim(rtrim(vd.opis)) as [Naziv]  from vrstadok vd inner join vrstaprom vp on vp.vrstapromid=vd.vrstapromid where vp.sifra='57'  order by naziv"  /> 



                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl4" 
                                      	TOP="2700" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Datum Knjiženja"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="DatumKnjizenja" 
                                   	TOP="2600" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum Knjiženja" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

  			
 
  </FILTERFORM>


  <UPDATEFORM 
                         FILLEXPLORER="True" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spKntPreknjizavanjeTotalGen @action=2" 
                         STARTUPSTORA="" 
                         HEIGHT="2600" 
                         CAPTION="Izaberi fakturu"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Poveži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

 
  </UPDATEFORM>


  <UPDATEFORM2 
                         FILLEXPLORER="True" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spKntPreknjizavanjeTotalGen @action=3" 
                         STARTUPSTORA="" 
                         HEIGHT="2600" 
                         CAPTION="Izaberi fakturu"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Poništi" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

 
  </UPDATEFORM2>

  <UPDATEFORM3 
                         FILLEXPLORER="True" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spKntPreknjizavanjeTotalGen @action=4,@KntTmpPreknjizavanjeid=@@id" 
                         STARTUPSTORA="" 
                         HEIGHT="2600" 
                         CAPTION="Izaberi fakturu"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Poništi" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

 
  </UPDATEFORM3>


  <PROKNJIZI
                         FILLEXPLORER="True" 
                         REPORT=""  
                         WIDTH="5000" 
                         STORA="spKntPreknjizavanjeTotalGen @action=5" 
                         STARTUPSTORA="" 
                         HEIGHT="2200" 
                         CAPTION="Preknjižavanje računa s konta na konto"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Proknjiži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="600" 
                                       	LEFT="200" 
                               		WIDTH="5500"
                                   	HEIGHT="320"  
                               		CAPTION="Želite preknjižiti odabrane račune s konta na konto?"/>
                     	
 
  </PROKNJIZI>

</PROJECT>
 
