<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT>

	<KARTICAREPRO
		  FILLEXPLORER=""
		  MAXIMIZEBOX="FALSE"
		  DETAILGRID = ""
		  WIDTH="14500"
		  ONSUBMIT=""
		  ONLOAD="select @@stgrloid as stgrloid"
		  ONLOADED="select maticnibroj , datrodenja from stgrlo where stgrloid = @@stgrloid"
		  ONLOAD2=""
		  HEIGHT="10000"
		  CAPTION="Kartica reprodukcije grla  "
		  BORDERSTYLE="3"
		  FOCUS="glava"
		  CMD1CAPTION=""
		  CMD2CAPTION=""
		  CMD3CAPTION=""
		  REFRESHAFTERCHILD="" >

		<INPUT TYPE="text" NAME="maticnibroj" CAPTION="Životni broj*" TOP="200" LEFT="1500" WIDTH="1500" HEIGHT="280" SQL="" TABINDEX="-1" ENABLED="FALSE"/>
		<INPUT TYPE="date" NAME="datrodenja" CAPTION="Datum rođenja*" TOP="200" LEFT="5000" WIDTH="1500" HEIGHT="280" SQL="" TABINDEX="-1" ENABLED="FALSE"/>
		<INPUT TYPE="number" DECIMALS="0" NAME="stgrloid" VISIBLE="FALSE"/>


    
    <INPUT TYPE="frame"  NAME="fr1"         CAPTION="Osjemenjivanja" TOP="500"   LEFT="56"   WIDTH="7000" HEIGHT="4000"   />
    <INPUT TYPE="frame"  NAME="fr2"         CAPTION="Kontrole steonosti" TOP="500"   LEFT="7100"   WIDTH="7000" HEIGHT="4000"   />
    <INPUT TYPE="frame"  NAME="fr3"         CAPTION="Teljenja" TOP="4500"   LEFT="56"   WIDTH="14050" HEIGHT="4100"   />


    <INPUT TYPE="grid"
				   NAME="xosjem"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="750" LEFT="256" WIDTH="6600" HEIGHT="3500"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK="select 'refresh' as xkontr"
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spstKarticaGrla @action = 3, @stgrloid= @@stgrloid" />

    <INPUT TYPE="grid"
				   NAME="xkontr"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="750" LEFT="7300" WIDTH="6600" HEIGHT="3500"
				   POPUP=""
				   ONCLICK="select 'refresh' as xtelenje"
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spstKarticaGrla @action = 4, @stgrloid= @@stgrloid, @streprodukcijaid = @@xosjem" />
    
    <INPUT TYPE="grid"
				   NAME="xtelenje"
				   REFRESHAFTERCHILD="TRUE"
				   CAPTION="Stavke"
				   SKIPDEFAULTLOAD2="TRUE"
				   TOP="4700" LEFT="256" WIDTH="13700" HEIGHT="3600"
				   POPUP=""
				   ONDBLCLICK=""
				   EDITCOLUMNS=""
				   ONCELLEDITED=""
				   CHECKBOXVISIBLE="FALSE"
				   PAGEHEADERCENTER=""
				   PAGEHEADERRIGHT=""
				   PAGEHEADERLEFT=""
				   PAGEFOOTERCENTER=""
				   PAGEFOOTERLEFT=""
				   ONCLICK=""
				   PAGEFOOTERRIGHT="@@thosmomi"
				   PAGEORIENTATION="LANDSCAPE"
				   GROUPBYBOXVISIBLE="TRUE"
				   TOTALROW="FALSE"
				   SQL="spstKarticaGrla @action = 5, @stgrloid= @@stgrloid, @sve = @@sve, @streprodukcijaid = @@xkontr" />

    <INPUT TYPE="check" NAME="Sve" CAPTION="Sva teljenja" TOP="8700" LEFT="8000" WIDTH="1506" HEIGHT="400" SQL="" ONCLICK="select 'refresh' as xtelenje"/>
    <INPUT TYPE="button" NAME="cancel"     CAPTION="Odustani"  TOP="8700" LEFT="2000" WIDTH="1506" HEIGHT="380" ONCLICK="close"  HOTKEY="F2" />

	</KARTICAREPRO>







</PROJECT> 