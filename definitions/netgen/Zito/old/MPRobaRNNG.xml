<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""
    MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE"
	  POPUPMASTER=""> 
 

  <NAME>Pregled prodane robe po MP računu NG</NAME>
  <CAPTION>Pregled prodane robe po MP računu NG</CAPTION>


  <FILTER_FORM
    NAME="FILTER_FORM"
    CAPTION="Parametri"
		WIDTH="9000" 
    HEIGHT="4000" 
		ONSUBMIT="spMPProdanaRobaRN @action=1, @operateriid = @@operateriid," 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, 0 as podklase, @@trgovinaid as trgovinaid, @@klasaid as klasaid"
		
		FILLEXPLORER="TRUE"
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" >

    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true" 
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>
    <INPUT TYPE="search" NAME="robaid"	 WIDTH="5500"
		   SQL="spMPRobaZaMPNG  @trazi = '@@searchboxrobaid'" ALLOWEMPTY="TRUE" CAPTION="Roba" ONLOSTFOCUS=""/>
    <INPUT TYPE="combo" CAPTION="Klasa" NAME="klasaid" SQL="select KlMasterRobaid, naziv as naziv from KlMasterRoba order by naziv" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE"/>

    <INPUT TYPE="check" NAME="podklase" WIDTH="3500" HEIGHT="320" CAPTION="pokaži i sve podklase" ENABLED="TRUE" ALLOWEMPTY="TRUE" />
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" DEFAULT="firstdayofmonth" />
    <INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" DEFAULT="today"/>

</FILTER_FORM>

</PROJECT> 