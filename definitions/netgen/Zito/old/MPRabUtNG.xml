<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	ONLOAD=":FILTERFORM"
	DETAILGRID="spMPRabatUtrskaNG @action = 22, @ID = @@ID"
	BUTTONS="Uvjeti:FILTERFORM#Kumulativ:KUMULATIV#Print dok.:repx/rptMPZapisnikOPopustu(@id=@@ID)"
	MASTERDBLCLICK="KUMULATIV"
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	POPUPMASTER="">
 
  <NAME>Zapisnik o sniženju cijena - odobreni popust</NAME>
  <CAPTION>Zapisnik o sniženju cijena - odobreni popust </CAPTION>
 

<FILTERFORM 
	FILLEXPLORER="TRUE" 
	REPORT=""  
	WIDTH="8000" 
	ONSUBMIT="spMPRabatUtrskaNG @action = 0, @operateriid = @@operateriid," 
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
	HEIGHT="3800" 
	CAPTION="Izaberi dokumente"  
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION=""  
	NEXTFORM=""  >



	<INPUT TYPE="date" NAME="datumod" TOP="1000" LEFT="1200" CAPTION="Datum od*" VALUE="DATE2" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="date" NAME="datumdo" TOP="1000" LEFT="4200" CAPTION="Datum do*" VALUE="DATE" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="1500" LEFT="1200"  WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE" SQL="spMPDajTrgovina @operateriid = @@operateriid"  /> 

</FILTERFORM>



<KUMULATIV 
	FILLEXPLORER="" 
	REPORT=""  
	WIDTH="16000" 
	ONSUBMIT="" 
	ONLOAD="" 
	HEIGHT="8800" 
	CAPTION="Pregled kumulativa"  
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani"
	NEXTFORM=""  >


	
	<INPUT TYPE="grid" 
		NAME="stavke" 
		REFRESHAFTERCHILD="TRUE" 
		CAPTION="_ay" 
		TOP="500" 
		LEFT="200"  
		WIDTH="15700" 
		HEIGHT="7000" 
		TABINDEX="6" 
		SQL="spMPRabatUtrskaNG @action = 3, @trgovinaid = @@trgovinaid , @datumod = @@datumod, @datumdo = @@datumdo " /> 

</KUMULATIV>




</PROJECT>
 
