<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
	ONLOAD=":FORM1"  		
	BUTTONS="Parametri:FORM1"> 
 

  <NAME>Pregled promjene NC u Cjeniku</NAME>
  <CAPTION>Pregled promjene NC u Cjeniku</CAPTION>
  

 <FORM1 	
	FILLEXPLORER="TRUE" 
	WIDTH="9000" 
	ONSUBMIT="spMPNabCijeneQueryNG @action=1, " 
	ONLOAD="" 
	HEIGHT="4000" 
	CAPTION="Parametri" 
	BORDERSTYLE="3" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" > 


	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" 
		   SQL="spMPDajTrgovina @operateriid=@@operateriid"/>
	<INPUT TYPE="search" NAME="partneriid" CAPTION="Partner" WIDTH="5500" HEIGHT="320"
		   SQL="vipartneri#partneriid#Naziv%#poreznibroj#%mjestanaziv%#!adresa" />
	<INPUT TYPE="search" NAME="robaid" CAPTION="Roba" WIDTH="5500" HEIGHT="320"
		   SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'"/> 
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" DEFAULT="firstdayofyear"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>

 </FORM1>


</PROJECT> 