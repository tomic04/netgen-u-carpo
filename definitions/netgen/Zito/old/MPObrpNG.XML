<?xml version="1.0" encoding="windows-1250" ?>


<PROJECT
   ONLOAD=":FILTERFORM"
      CMD1CAPTION=""
      CMD2CAPTION=""
      CMD3CAPTION=""
      CMD4CAPTION=""
      CMD5CAPTION=""
      CMD6CAPTION=""
      CMD7CAPTION=""
      CMD8CAPTION=""
	  CHECKBOXVISIBLE="TRUE"
	  DETCHECKBOXVISIBLE="FALSE"
	  DETTOTALROWVISIBLE="FALSE"
	  TOTALROWVISIBLE="FALSE"
	  DETAILGRID = "spMPProizvodiNG @action=10, @operateriid= @@operateriid, @maloprodajaglaid=@@id"
      REPORT=""
      MASTERDBLCLICK=""
	  BUTTONS="Uvjeti:FILTERFORM#Sirovine:SIROVINE#Ažuriraj:AZURIRAJ#Dokumenti:DOKUMENTI"
      POPUPMASTER="">

	<NAME>Obračun proizvodnje u MP </NAME>
	<CAPTION>Obračun proizvodnje u MP </CAPTION>

	<KOMENTAR> </KOMENTAR>


	<FILTERFORM TEXT="Izaberi dokumente"
					TOP="4392"
					LEFT="3200"
					VISIBLE="True"
					HEIGHT="3500"
					WIDTH="8006"
					CAPTION="Izaberi dokumente"
					NAME="FILTERFORM"
					BORDERSTYLE="3"
					ONSUBMIT="spMPProizvodiNG @action=9, @operateriid= @@operateriid, "
					ONLOAD="select getdate() as datumod, getdate() as datumdo"
					FOCUS="trgovinaid"
					FILLEXPLORER="True"
					NEXTFORM=""
					CHILDFORM=""
					CMD1CAPTION="Pokaži"
					CMD2CAPTION="Odustani"
					CMD3CAPTION="" CMD4CAPTION="" CMD5CAPTION="" CANCELONSUBMIT="">
		<INPUT TYPE="combo"
				TABINDEX="3"
				CAPTION="Trgovina"
				VISIBLE="True"
				HEIGHT="302"
				WIDTH="4501"
				SQL="spMPDajTrgovina @operateriid = @@operateriid "
				ALLOWEMPTY="TRue"
				NAME="trgovinaid"
				TYPETG="combo"
				ENABLED="True"/>
		<INPUT TYPE="date"
				TABINDEX="2"
				VISIBLE="True"
				HEIGHT="288"
				WIDTH="1498"
				TYPETG="date"
				CAPTION="Datum od"
				NAME="datumod"
				ENABLED="True"/>
		<INPUT TYPE="date"
				TABINDEX="3"
				VISIBLE="True"
				HEIGHT="288"
				WIDTH="1498"
				TYPETG="date"
				CAPTION="Datum do"
				NAME="datumdo"
				ENABLED="True"/>
		<INPUT TYPE="combo"
				CAPTION="Status"
				TABINDEX="4"
				VISIBLE="True"
				HEIGHT="302"
				WIDTH="4501"
				SQL="select 0 as ststusid, 'Neobrađeno' as naziv union all select 1,'Obrađeno'"
				ALLOWEMPTY="TRUE"
				NAME="statusid"
				TYPETG="combo"
				ENABLED="True"/>

	</FILTERFORM>



	<PROIZVODI
						   FILLEXPLORER=""
						   REPORT=""
						   WIDTH="11200"
						   ONSUBMIT=""
						   ONLOAD=""
						   HEIGHT="7000"
						   CAPTION="Prodani proizvodi po dokumentu"
						   BORDERSTYLE="3"
						   CMD1CAPTION=""
						   CMD2CAPTION="Odustani"
						  CMD3CAPTION=""
						  CMD4CAPTION="SIROVINE:SIRART"
						  CMD5CAPTION=""
						  CMD6CAPTION=""
						  NEXTFORM=""  >



		<INPUT TYPE="grid"
				NAME="Proizvodi"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=10, @operateriid= @@operateriid, @maloprodajaglaid=@@id"
                                          />


	</PROIZVODI>
	<SIROVINE
						   FILLEXPLORER=""
						   REPORT=""
						   WIDTH="11200"
						   ONSUBMIT=""
						   ONLOAD=""
						   HEIGHT="7000"
						   CAPTION="Utrošene sirovine po dokumentu "
						   BORDERSTYLE="3"
						   CMD1CAPTION=""
						   CMD2CAPTION="Odustani"
						  CMD3CAPTION=""
						  CMD4CAPTION=""
						  CMD5CAPTION=""
						  CMD6CAPTION=""
						  NEXTFORM=""  >



		<INPUT TYPE="grid"
				NAME="Sirovine"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				CHECKBOXVISIBLE="FALSE"
		        TOTALROWVISIBLE="FALSE"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=11, @operateriid= @@operateriid, @maloprodajaglaid=@@id" >
			<COLUMN INDEX="" NAME="Količina1300" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>
		/>


	</SIROVINE>

	<SIRART
						   FILLEXPLORER=""
						   REPORT=""
						   WIDTH="11200"
						   ONSUBMIT=""
						   ONLOAD=""
						   HEIGHT="7000"
						   CAPTION="Utrošene sirovine po proizvodu"
						   BORDERSTYLE="3"
						   CMD1CAPTION=""
						   CMD2CAPTION="Odustani"
						  CMD3CAPTION=""
						  CMD4CAPTION=""
						  CMD5CAPTION=""
						  CMD6CAPTION=""
						  NEXTFORM=""  >



		<INPUT TYPE="grid"
				NAME="SirovineArt"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=12, @operateriid= @@operateriid, @maloprodajadetid=@@Proizvodi"
                                          />


	</SIRART>


	<DOKUMENTI
					   FILLEXPLORER=""
					   REPORT=""
					   WIDTH="11200"
					   ONSUBMIT=""
					   ONLOAD=""
					   HEIGHT="7000"
					   CAPTION="Pregled dokumenta obrade proizvoda i sirovina"
					   BORDERSTYLE="3"
					   CMD1CAPTION=""
					   CMD2CAPTION="Odustani"
					  CMD3CAPTION=""
					  CMD4CAPTION="Stavke:STAVKEDOK"
					  CMD5CAPTION=""
					  CMD6CAPTION=""
					  NEXTFORM=""  >



		<INPUT TYPE="grid"
				NAME="Dokumenti"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
			    CHECKBOXVISIBLE="FALSE"
				LEFT="100"
				WIDTH="32000"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=13, @operateriid= @@operateriid, @maloprodajaglaid=@@id"
                                          />


	</DOKUMENTI>

	<STAVKEDOK
					   FILLEXPLORER=""
					   REPORT=""
					   WIDTH="11200"
					   ONSUBMIT=""
					   ONLOAD=""
					   HEIGHT="7000"
					   CAPTION="Pregled stavaka dokumenta"
					   BORDERSTYLE="3"
					   CMD1CAPTION=""
					   CMD2CAPTION="Odustani"
					  CMD3CAPTION=""
					  CMD4CAPTION=""
					  CMD5CAPTION=""
					  CMD6CAPTION=""
					  NEXTFORM=""  >



		<INPUT TYPE="grid"
				NAME="ştavkedok"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				LEFT="100"
				WIDTH="11000"
			    CHECKBOXVISIBLE="FALSE"
				HEIGHT="5500"
				TABINDEX="5"
				SQL="spMPProizvodiNG @action=14, @operateriid= @@operateriid, @maloprodajaglaid=@@dokumenti"
                                          />


	</STAVKEDOK>




	<AZURIRAJ
		WIDTH="8700"
		ONSUBMIT=""
		ONLOAD="select @@trgovinaid as trgovinaid, getdate() as datum, poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = getdate() 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end "
		HEIGHT="4200"
		CAPTION="Obračun proizvodnje ?"
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION=""
		CMD3CAPTION=""
		CHILDFORM="">
		<INPUT TYPE="combo"
				TABINDEX="1"
				CAPTION="Trgovina"
				VISIBLE="True"
				HEIGHT="302"
				WIDTH="4501"
				SQL="spMPDajTrgovina @operateriid = @@operateriid "
				ALLOWEMPTY="TRue"
				NAME="trgovinaid"
				TYPETG="combo"
			    ONLOSTFOCUS="select poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = @@datum 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end #select 'refresh' as poruke"
				ENABLED="True"/>

		<INPUT TYPE="date"
				TABINDEX="2"
				VISIBLE="True"
				HEIGHT="288"
				WIDTH="1498"
				TYPETG="date"
				CAPTION="Datum "
				NAME="datum"
			    ONLOSTFOCUS="select poruka = case when (select count(*) from maloprodajagla where 
							trgovinaid = @@trgovinaid 
							and datumdok = @@datum 
							and vrstadokid in (select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '109') and opis like '%proiz%')) &gt; 0 then 'POSTOJIOBRAČUN ZA UPISANI DATUM. MOŽETE GA PONOVITI!'else 'NEMA ' end #select 'refresh' as poruke"
				ENABLED="TRUE"/>
		<INPUT TYPE="text"
				TABINDEX="2"
				VISIBLE="True"
				HEIGHT="288"
				WIDTH="5000"
				CAPTION="Status obračuna"
				NAME="poruka"
				ENABLED="FALSE"/>
		<INPUT TYPE="checkbox" NAME="ponovi" CAPTION="Ponovi obračun" />

		<INPUT TYPE="button" NAME="OK" TABINDEX="3" CAPTION="Obračunaj" TOP="2100" LEFT="800" WIDTH="1400" HEIGHT="322" 
			   ONCLICK="if (select coalesce(indproi,0) from trgovina where trgovinaid = @@trgovinaid) = 0 begin 
									raiserror 19001 &apos;Trgovina nema proizvodnju. Nije potreban obračun !!&apos;
								end 
								else begin 
									exec spMPProizvodiNG  @action = 8, @trgovinaid = @@trgovinaid, @datum = @@datum , @operateriid = @@operateriid, @ponovi = @@ponovi, @obrproiz = 1
								end #OK"  />
		<INPUT TYPE="button" NAME="Odustani" TABINDEX="4" CAPTION="Odustani" TOP="2100" LEFT="2300" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

	</AZURIRAJ>



</PROJECT>
