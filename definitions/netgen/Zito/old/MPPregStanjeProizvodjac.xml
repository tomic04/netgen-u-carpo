<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTERFORM"  		
		REPORT=""
		DETAILGRID="spMPPregRobeProizvidjac @action = 2 ,@robaid  = @@id , @datumdo = @@datumdo" 
		CMD1CAPTION="Parametri:FILTERFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION=""  
		CMD8CAPTION=""  
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE" 
      PAGEHEADERRIGHT="Na dan: @@datumdo"  
      PAGEHEADERCENTER="Popis stanja robe po proizvođaču @@searchboxpartneriid"                                                             
      PAGEHEADERLEFT=""
      PAGEFOOTERCENTER=""
      PAGEFOOTERLEFT=""
      PAGEFOOTERRIGHT=""

	        POPUPMASTER=""> 
 

  <NAME>Pregled Stanja robe po proizvođaču </NAME>
  <CAPTION>Pregled Stanja robe po proizvođaču </CAPTION>


	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="2254"
		WIDTH="7710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregRobeProizvidjac @action = 1 , @operateriid= @@operateriid, "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@partneriid as partneriid "
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Stanje na dan" />
		<INPUT TYPE="search" NAME="partneriid" CAPTION="Proizviđač"  SQL="vipartneri#partneriid#Naziv%#poreznibroj#%mjestanaziv%#!adresa" ALLOWEMPTY="TRUE" />

	</FILTERFORM>


	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Krtica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid , @totalgen=1" />
	</KARTICA>

</PROJECT>
