<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>

<PROJECT  
	FILLEXPLORER="" 
	ONLOAD=":FILTERFORM"  
	BUTTONS="Parametri:FILTERFORM#Dodaj:DODAJIZNOS#Izmjeni:IZMJENIIZNOS#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ"
	MASTERDBLCLICK="IZMJENIIZNOS"
	POPUPMASTER="Parametri:FILTERFORM#Izmjeni:IZMJENIIZNOS#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ">

  <NAME>Poravnavanje Knjige Popisa u maloprodaji </NAME>
  <CAPTION>Poravnavanje Knjige Popisa u maloprodaji </CAPTION>
 


<FILTERFORM
	NAME="FILTERFORM"
	FILLEXPLORER="TRUE" 
	WIDTH="7000" 
	ONSUBMIT="spMPPoravnajKPNG @action=1, "
	ONLOAD="" 
	HEIGHT="4000" 
	CAPTION="Upišite uvjete prikaza"
	CMD1CAPTION="Pokaži" 
    CMD2CAPTION="Odustani">

	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" VALUE="DATE2" TOP="500" LEFT="1500" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" DEFAULT="firstdayofyear"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" VALUE="DATE" TOP="1000" LEFT="1500" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="4500" TOP="1500" LEFT="1500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="spMPDajTrgovina @operateriid=@@operateriid"  /> 
	<INPUT TYPE="combo" NAME="status" CAPTION="Status*" TOP="2000" LEFT="1500" WIDTH="2500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select 1 as status, 'Otvoren' as naziv union all select 2 as status, 'Zaključen' as naziv"  />


</FILTERFORM>


<DODAJIZNOS
	NAME="DODAJIZNOS"
	FILLEXPLORER=""
	ONSUBMIT=""
	WIDTH="7500"
	HEIGHT="4500"
	CAPTION="Unos poravnavanja Knjige popisa">

	<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum*" VALUE="DATE1" TOP="500" LEFT="1500" HEIGHT="320" WIDTH="1500" ENABLED="TRUE" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaId" CAPTION="Trgovina*" TOP="1000" LEFT="1500" HEIGHT="320" WIDTH="4500" ENABLED="TRUE" SQL="spMPDajTrgovina @operateriid=@@operateriid"/>
	<INPUT TYPE="combo" NAME="osobeid" CAPTION="Odgovorna osoba*" TOP="1500" LEFT="1500" HEIGHT="320" WIDTH="3500" ALLOWEMPTY="FALSE" SQL="spMPDajOsobe"  />
	<INPUT TYPE="number" NAME="mpiznos" CAPTION="MP Iznos*" TOP="2000" LEFT="1500" HEIGHT="320" WIDTH="1500" DECIMALS="2" />
	<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena*" TOP="2500" LEFT="1500" HEIGHT="320" WIDTH="5500" ENABLED="TRUE" />

	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="3500" LEFT="500" WIDTH="1000" CAPTION="Spremi"
		   ONCLICK="spMPPoravnajKPNG @action=2, @operateriid=@@operateriid, @datumdok=@@datumdok, @trgovinaid=@@trgovinaid, @osobeid=@@osobeid, @mpiznos=@@mpiznos, @napomena='@@napomena'#Ok"  />
	<INPUT TYPE="button" NAME="cancel" TOP="3500" LEFT="2500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</DODAJIZNOS>


<IZMJENIIZNOS
	NAME="IZMJENIIZNOS"
	FILLEXPLORER=""
	WIDTH="7500"
	ONSUBMIT=""
	ONLOAD="if (select status from mpnivelgla where mpnivelglaid= @@ID ) = 2 begin 
			raiserror 19001 'Dokument je zaključen. Ne može se mijenjati !' end 
			else begin
			exec spMPPoravnajKPNG @action=3,@ID=@@ID end"
	HEIGHT="4500"
	CAPTION="Izmjena poravnavanja Knjige popisa">

	<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum*" VALUE="DATE1" TOP="500" LEFT="1500" HEIGHT="320" WIDTH="1500" ENABLED="TRUE" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="TrgovinaId" CAPTION="Trgovina*" TOP="1000" LEFT="1500" HEIGHT="320" WIDTH="4500" ENABLED="FALSE" SQL="spMPDajTrgovina @operateriid = @@operateriid" />
	<INPUT TYPE="combo" NAME="osobeid" CAPTION="Odgovorna osoba*" TOP="1500" LEFT="1500" HEIGHT="320" WIDTH="3500" ALLOWEMPTY="FALSE" SQL="spMPDajOsobe"  />
	<INPUT TYPE="number" NAME="mpiznos" CAPTION="MP Iznos*" TOP="2000" LEFT="1500" HEIGHT="320" WIDTH="1500" DECIMALS="2" />
	<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena*" TOP="2500" LEFT="1500" HEIGHT="320" WIDTH="5500" ENABLED="TRUE" />

	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="3500" LEFT="500" WIDTH="1000" CAPTION="Spremi"
		   ONCLICK="spMPPoravnajKPNG @action=4, @id = @@id, @operateriid=@@operateriid, @datumdok=@@datumdok, @trgovinaid=@@trgovinaid, @osobeid=@@osobeid, @mpiznos=@@mpiznos, @napomena='@@napomena'#Ok"  />
	<INPUT TYPE="button" NAME="cancel" TOP="3500" LEFT="2500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</IZMJENIIZNOS>


<ZAKLJUCI
	NAME="ZAKLJUCI"
	FILLEXPLORER=""
	WIDTH="5500"
	ONSUBMIT=""
	ONLOAD="if (select status from mpnivelgla where mpnivelglaid= @@ID ) = 2 begin 
			raiserror 19001 'Dokument je zaključen. Ne može se više zaključiti!' end
			else begin
			exec spMPPoravnajKPNG @action=3,@ID=@@ID end"
	HEIGHT="3500" 
	CAPTION="Zaključiti dokument?"> 

	<INPUT TYPE="text" NAME="brojdok" CAPTION="Broj dokumenta*" TOP="500" LEFT="1500" HEIGHT="320" WIDTH="2500" ENABLED="FALSE" />
	<INPUT TYPE="label" NAME="stat" CAPTION="Jeste li sigurni da želite zaključiti dokument ?" TOP="1500" LEFT="400" HEIGHT="320" WIDTH="3500" />

	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2500" LEFT="500" WIDTH="1000" CAPTION="Zaključi"
	   ONCLICK="exec spMPPoravnajKPNG @action=5, @id = @@id#exec spMPPoravnajKPNG @action=1, @datumod=@@datumod, @datumdo=@@datumdo, @trgovinaid=@@trgovinaid, @status=@@status#Ok"  />
	<INPUT TYPE="button" NAME="cancel" TOP="2500" LEFT="2500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</ZAKLJUCI>


<OTKLJUCAJ
	NAME="OTKLJUCAJ"
	FILLEXPLORER=""
	WIDTH="5500" 
	ONSUBMIT=""
	ONLOAD="if coalesce((select status from mpnivelgla where mpnivelglaid = @@ID ),0) &lt;&gt; 2 begin 
			raiserror 19001 'Dokument nije zaključen. Ne može se otključavati!' end
			else begin
			exec spMPPoravnajKPNG @action=3,@ID=@@ID end"
	HEIGHT="3500" 
	CAPTION="Otključati dokument?">

	<INPUT TYPE="text" NAME="brojdok" CAPTION="Broj dokumenta*" TOP="500" LEFT="1500" HEIGHT="320" WIDTH="2500" ENABLED="FALSE" />
	<INPUT TYPE="label" NAME="stat" CAPTION="Jeste li sigurni da želite otključati dokument ?" TOP="1500" LEFT="400" HEIGHT="320" WIDTH="3500" />

	<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2500" LEFT="500" WIDTH="1000" CAPTION="Otključaj"
	   ONCLICK="spMPPoravnajKPNG @action=6, @id = @@id, @operateriid=@@operateriid#exec spMPPoravnajKPNG @action=1, @datumod=@@datumod, @datumdo=@@datumdo, @trgovinaid=@@trgovinaid, @status=@@status#Ok"  />
	<INPUT TYPE="button" NAME="cancel" TOP="2500" LEFT="2500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

</OTKLJUCAJ>


</PROJECT>

