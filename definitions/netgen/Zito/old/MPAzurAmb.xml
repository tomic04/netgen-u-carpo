<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
		 DETAILGRID = "spMPAZurAmbOtpada @action=2,@operateriid=@@operateriid,@id=@@id"
		 MASTERDBLCLICK="UPDATE_FORM"
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION=""
		 CMD3CAPTION="Izmjeni:UPDATE_FORM" 
		 CMD4CAPTION="Zaključi:ZAKLJUCI" 
		 CMD5CAPTION="" 	
		 CMD6CAPTION=""
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM#Izmjeni:UPDATE_FORM" 
		 TREE=""
		 ONLOAD=":FILTERFORM" 
		 GROUPBYBOXVISIBLE="FALSE" 
		 ONLOAD2="" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="FALSE"
		 REPORT="">
	>
 
  <NAME>Ažuriranje ambalažnog otpada</NAME>
  <CAPTION>Ažuriranje ambalažnog otpada</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> MT 02.06.2009.  </AUTOR>


	<FILTERFORM NAME="FILTERFORM" HEIGHT="3254" WIDTH="6710" 
			 CAPTION="Upišite uvjete prikaza " 
			 ONSUBMIT="spMPAZurAmbOtpada @action = 1, @operateriid = @@operateriid ,  "
			 ONLOAD="" 
			 FILLEXPLORER="TRUE" 
			 NEXTFORM=""
			 CMD1CAPTION="Pokaži" 
			 CMD2CAPTION="Kraj" 
		 >
		<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina"   SQL="spMPDajTrgovina @operateriid=@@operateriid"  WIDTH="3500"/>
		<INPUT TYPE="date"   NAME="datumod"    CAPTION="Datum od "       />
		<INPUT TYPE="date"   NAME="datumdo"    CAPTION="Datum od "     />
	</FILTERFORM>

	<UPDATE_FORM 
		CAPTION="Izmjeni dokmument [ @@id ]" 
		HEIGHT="9500" 
		WIDTH= "9000" 
		FILLEXPLORER="" 
		FOCUS="robaid" 
		ONLOAD="exec spMPAZurAmbOtpada @action=3 ,@ID=@@ID, @operateriid = @@operateriid" 
		>

		<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Zaglavlje:" TOP="408" LEFT="56" WIDTH="8750" HEIGHT="1900"   />
		<INPUT TYPE="date"   NAME="datumdok"      CAPTION="Datum*" TOP="610" LEFT="2490" WIDTH="1596" HEIGHT="280" SQL=""  />
		<INPUT TYPE="text"   NAME="broj"          CAPTION="Broj zaključka*" TOP="1010" LEFT="2490" WIDTH="2002" HEIGHT="280" SQL="" ENABLED="FALSE"  />
		<INPUT TYPE="number" NAME="kolicina"	  CAPTION="Količina ambalaže*" TOP="1410" LEFT="2490" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="vrijednost"	  CAPTION="Kol.na skladištu*" TOP="1810" LEFT="2490" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />

		<INPUT TYPE="frame"  NAME="fr2"           CAPTION="Stavke dokumenta :" TOP="3000" LEFT="56" WIDTH="8750" HEIGHT="2=50"   />

		<INPUT TYPE="grid" 
			   NAME="stavke" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="4140" LEFT="56" WIDTH="8750" HEIGHT="3078"
			   TABINDEX="-1"
			   AFTERREFRESH=""
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU" 
			   EDITCOLUMNS="Nova kol.1200"
			   ONCELLEDITED="spMPAZurAmbOtpada @action=4, @maloprodajadetid = @@stavke, @kolicinanaruceno = @(stavke..Nova kol.1200)#select 'stavke' as focus "
			   CHECKBOXVISIBLE="FALSE"	
			   PAGEHEADERCENTER="Utržak br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="TRUE"
			   SQL="spMPAZurAmbOtpada @action=2,@operateriid=@@operateriid,@id=@@id" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="7840" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPAZurAmbOtpada @action=5,@id = @@id, @operateriid=@@operateriid#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7840" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</UPDATE_FORM>



</PROJECT>
 
