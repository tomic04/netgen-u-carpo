<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
    ONLOAD=":FILTERFORM"  
    CMD1CAPTION="Parametri:FILTERFORM"
    CMD2CAPTION="Dodaj:INSERTFORM"
	  CMD3CAPTION="Izmjeni:UPDATEFORM"
    CMD4CAPTION="Trgovine:PREGPOTRG" 
    CMD5CAPTION="Aktiviraj:STATUSA" 
    CMD6CAPTION="Ispis:repx/rptMPProizvodi(@id = @@id)"   
    CMD7CAPTION="Kopiraj:KOPIRAJ"   
    CMD8CAPTION="Lista"
	CMD9CAPTION="Kopiraj SVE:KOPIRAJSVE"
	  CHECKBOXVISIBLE="FALSE"
	  DETCHECKBOXVISIBLE="FALSE"
    GROUPBOXVISIBLE="FALSE"
    TOTALROWVISIBLE="FALSE"
    DETTOTALROWVISIBLE="FALSE"
    REPORT="" 
	  DETAILGRID = ""
    MASTERDBLCLICK=""
    POPUPMASTER="Filter:FILTERFORM"
   PAGEHEADERLEFT=""
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi">



  <MASTERCOLUMNS>
    <COLUMN INDEX="9" NAME="KOLIČINA0900" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
    <COLUMN INDEX="10" NAME="NC1000" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="11" NAME="NC1000" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
	<COLUMN INDEX="12" NAME="NC1000" CAPTION="" FORMAT="#,###0.###0" AGREGATEFUNCTION="0" />
  </MASTERCOLUMNS>


  <NAME>Pregled proizvoda i normativa </NAME>
  <CAPTION>Pregled proizvoda i normativa</CAPTION>
 
  <KOMENTAR> </KOMENTAR>


	<FILTERFORM 
			FILLEXPLORER="TRUE" 
			REPORT=""  
			WIDTH="6300" 
			ONSUBMIT="spMPProizvodiGlaIdet @action = 8,  @operateriid= @@operateriid, " 
			ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
      ONLOADED="select @@status as status"
			HEIGHT="3000" 
			CAPTION="Upišite uvjete pregleda "  
			BORDERSTYLE="3" 
			CMD1CAPTION="Pokaži" 
			CMD2CAPTION="Odustani" 
			CMD3CAPTION=""  
			NEXTFORM=""  >
    
    <INPUT TYPE="search" NAME="robaid" CAPTION="Proizvod:*" WIDTH="4000" TOP="400" LEFT="1500"
           SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid', @mpsirovina = 0 " ALLOWEMPTY="TRUE" />
    
    <INPUT TYPE="search" NAME="robanormid" CAPTION="Roba iz normativa:*" WIDTH="4000" TOP="800" LEFT="1500"
           SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobanormid'" ALLOWEMPTY="TRUE" />
    
    <INPUT TYPE="combo" NAME="status" ALLOWEMPTY="FALSE" CAPTION="Status normativa:*" TOP="1200" LEFT="1500" WIDTH="4000"
           SQL="select 0 as id, 'Svi' as naziv union all select 1 as id, 'Aktivni' as naziv union all select 2 as id, 'Neaktivni' as naziv" />

    <INPUT TYPE="check" NAME="nc0" ALLOWEMPTY="FALSE" CAPTION="NC = 0 :" TOP="1600" LEFT="1500" WIDTH="4000"
           SQL="" />

  </FILTERFORM>

  <INSERTFORM
    REFRESHAFTERCHILD=""
    WIDTH="12000"
    ONLOAD=""
    ONSUBMIT="spMPProizvodiGlaIdet @action = 2, @operateriid = @@operateriid, "
    HEIGHT="6100"
    CAPTION="Unos Proizvoda i normativa"
    MASTERDBLCLICK=""
    ONLOADED=""
    BORDERSTYLE="3"
    CMD1CAPTION="Normativ>>>"
    CMD2CAPTION="Odustani"
    FOCUS="robaid"
    NEXTFORM="UPDATEFORM"  >

    <INPUT TYPE="TRAZILICA" NAME="Robaid" CAPTION="Proizvod"  SQL="viRoba#robaid#Naziv%#userid#barcode#robakod" WIDTH="5000" HEIGHT="320"/>
    

  </INSERTFORM>

  <UPDATEFORM
    FILLEXPLORER=""
    REPORT=""
    WIDTH="11000"
    ONLOAD="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@id ),0) = 1  or (select datumdo from mpproizvodigla where mpproizvodiglaid = @@id ) is not null begin 
			exec spRaiserror 69001, 'Proizvod je aktivan ili je bio aktivan. Ne može se više ispravljati !' 
		end
		else begin
			exec spMPProizvodiGlaIdet @action=3,@mpproizvodiglaid=@@id
		end"
    ONSUBMIT=""
    HEIGHT="6300"
    CAPTION="Ažuriranje normativa"
    MASTERDBLCLICK=""
    BORDERSTYLE="3"
    CMD1CAPTION="Spremi"
    CMD2CAPTION="Odustani"
    CMD3CAPTION=""
    CMD4CAPTION="Dodaj:DODAJSTAVKU"
    CMD5CAPTION=""
    CMD6CAPTION="Obriši:BRISISTAVKU"
    NEXTFORM=""  >

    <INPUT TYPE="text" CAPTION="Proizvod" NAME="naziv" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320"/>
    <INPUT TYPE="text" CAPTION="JM" NAME="jm" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320"/>
    <INPUT TYPE="number" CAPTION="" NAME="mpproizvodiglaid" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320" VISIBLE="FALSE" DECIMALS="0"/>

    <INPUT TYPE="grid"
      NAME="stavkenorm"
      REFRESHAFTERCHILD="TRUE"
      CHECKBOXVISIBLE="FALSE"
      LEFT="100"
      CAPTION=""
      WIDTH="10500"
      HEIGHT="3700"
      TABINDEX="5"
      SQL="spMPProizvodiGlaIdet @action = 4,@mpproizvodiglaid=@@id" >
      <COLUMN INDEX="" NAME="Količina1200" WIDTH="" CAPTION="Količina" FORMAT="#,##0.0000000000" VISIBLE="TRUE" />
    </INPUT>
  </UPDATEFORM>

  <DODAJSTAVKU
    FILLEXPLORER=""
          REPORT=""
          WIDTH="7500"
          ONSUBMIT=""
          ONLOAD=""
          HEIGHT="3600"
          CAPTION="Prijava nove sirovine"
          BORDERSTYLE="3"
          CMD1CAPTION=""
    CMD2CAPTION="">

    <INPUT TYPE="search" CAPTION="Sirovina*" NAME="Robaid" TOP="500" LEFT="1500" WIDTH="5000" HEIGHT="320" 
           SQL="spMPRobaZaMPNG @trazi = '@@searchboxrobaid'" STYLE="1"  
           ONLOSTFOCUS="select jm.naziv as jm0600 from jm jm inner join roba r on jm.jmid = r.jmid where r.robaid = @@robaid"/>
    <INPUT TYPE="text" NAME="jm0600" CAPTION="JM*"  TOP="900" LEFT="1500"  WIDTH="1000" STYLE="1" ENABLED="FALSE" HEIGHT="320"/>
    <INPUT TYPE="number" NAME="kolicina" CAPTION="Količina*" LEFT="1500" TOP="1500" WIDTH="1500" HEIGHT="320" DECIMALS="10" />
    <INPUT TYPE="checkbox" NAME="rezervni" CAPTION="Rezervna sirovina*" LEFT="1500" TOP="2000" WIDTH="3500" HEIGHT="320" DECIMALS="0" />
    <INPUT TYPE="button" NAME="Spremi"  CAPTION="Spremi" TOP="2500" LEFT="500" WIDTH="1400" HEIGHT="322" TABINDEX="3"
      ONCLICK="exec spMPProizvodiGlaIdet @action=5, @mpproizvodiglaid =@@mpproizvodiglaid, @robaid = @@robaid, @kolicina = @@kolicina, @rezervni = @@rezervni#OK"  />
    <INPUT TYPE="button" NAME="Odustani"  CAPTION="Odustani" TOP="2500" LEFT="2000" WIDTH="1400" HEIGHT="322" TABINDEX="4" ONCLICK="close"  />
  </DODAJSTAVKU>

  <BRISANJE
	WIDTH="7500"
	ONSUBMIT="exec spMPProizvodiGlaIdet @action=15,@MPproizvodiglaid=@@ID,"
	ONLOAD="exec spMPProizvodiGlaIdet @action=3,@MPproizvodiglaid=@@ID"
	HEIGHT="3200"
	CAPTION="Brisanje proizvoda i normativa ?"
	BORDERSTYLE="3"
	CMD1CAPTION="Obriši"
	CMD2CAPTION="Odustani"
	BOLD="TRUE">

    <INPUT TYPE="text" NAME="naziv" CAPTION="Proizvod" STYLE="1" WIDTH="4500" HEIGHT="320" BOLD="TRUE" ENABLED="FALSE" />
    <INPUT TYPE="label" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite obisati proizvod i normativ  ? "/>

  </BRISANJE>


  <BRISISTAVKU
    WIDTH="5500"
    ONSUBMIT="delete mpproizvodidet where mpproizvodidetid = @@stavkenorm"
    ONLOAD="spMPProizvodiGlaIdet @action = 6, @mpproizvodidetid=@@stavkenorm"
    HEIGHT="3200"
    CAPTION="Brisanje stavke"
    BORDERSTYLE="3"
    CMD1CAPTION="Obriši"
    CMD2CAPTION="Odustani" >

    <INPUT TYPE="label" NAME="stat"  LEFT="100" TOP="300" BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati stavku ? "/>
    <INPUT TYPE="number"  KOMENTAR="ova kontrola služi samo da sačuva ID stavke , pozicionirana je tako da se nevidi na formi" NAME="mpproizvodidetid" TOP="5600" LEFT="2200" CAPTION="mpproizvodidetid" WIDTH="2500" HEIGHT="320" ENABLED="FALSE" DECIMALS="0" />

  </BRISISTAVKU>


  <STATUSA
     WIDTH="11000"
     ONSUBMIT=""
     ONLOADDDDD="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@id ),0) = 1   begin 
			          exec spRaiserror 69001, 'Proizvod je već aktivan!' 
		        end
		        else begin 
			          exec spMPProizvodiGlaIdet @action=3, @MPproizvodiglaid=@@id
		        end "
     ONLOAD="exec spMPProizvodiGlaIdet @action=3, @MPproizvodiglaid=@@id"
     HEIGHT="8200"
     VERSION="2"
     CAPTION="Aktiviranje proizvoda i normativa ?"
     BORDERSTYLE="3"
     CMD1CAPTION=""
     CMD2CAPTION=""
     BOLD="TRUE"	>

    <INPUT TYPE="number" NAME="mpproizvodiglaid" CAPTION="" WIDTH="4500" HEIGHT="320" BOLD="TRUE" ENABLED="FALSE" VISIBLE="FALSE" DECIMALS="0"/>
    <INPUT TYPE="text" NAME="naziv" CAPTION="Proizvod" WIDTH="4500" HEIGHT="320" BOLD="TRUE" ENABLED="FALSE" />
    <INPUT TYPE="date" NAME="datumod" CAPTION="Datum aktiviranja" VALUE="DATE1" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
    <INPUT TYPE="label0a" NAME="stat" BOLD="TRUE" TOP="3000" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" 
           CAPTION="ODABERITE TRGOVINE NA KOJE SE VEŽE NORMATIV !!  "/>
    <INPUT TYPE="label1a" NAME="stat" BOLD="TRUE" TOP="4000" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Jeste li sigurni da želite Aktivirati proizvod i normativ  ? "/>
    <INPUT TYPE="label2a" NAME="stat" BOLD="TRUE" TOP="5000" LEFT="400" WIDTH="3500" STYLE="1" FORECOLOR="RED" SIZE="10" CAPTION="Stari aktivni normativ će biti ugašen !"/>


    <INPUT TYPE="combo" NAME="mpregijeID" CAPTION="Regija*" VALUE="DATE1" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE" ALLOWEMPTY="TRUE" TOP="200" LEFT="7000" 
           SQL="select * from mpregije" ONCLICK="select 'refresh' as trgovinena"/>

    <INPUT TYPE="grid" NAME="trgovinena" CAPTION=""  INDEX ="6"  ALLOWEMPTY="TRUE" MAXLENGTH = "" HEIGHT="6000" WIDTH="4000" LEFT="6500" TOP="800" ENABLED="TRUE" STYLE="1"
     SQL="spMPProizvodiGlaIdet @operateriid = @@operateriid, @mpregijeid = @@mpregijeID, @action = 17, @mpproizvodiglaid = @@mpproizvodiglaid  "/>

    <INPUT TYPE="button" NAME="cancel" TABINDEX="-1" CAPTION="Odustani" TOP="7000" LEFT="2000" WIDTH="1000" HEIGHT="322" ONCLICK="close"  />

    <INPUT TYPE="button" NAME="ok" TABINDEX="-1" CAPTION="Aktiviraj" TOP="7000" LEFT="3500" WIDTH="2000" HEIGHT="322"
			   ONCLICK="FOREACHSELECTED(trgovinena)#exec spMPProizvodiGlaIdet @action=7, @MPproizvodiglaid = @@id, @trgovinaid = @@trgovinena, @operateriid= @@operateriid, @datumod = @@datumod #OK " HOTKEY="F2" />


  </STATUSA>

  <PREGPOTRG
  FILLEXPLORER=""
  REPORT=""
  WIDTH="7000"
  VERSION="2"
  ONLOAD="exec spMPProizvodiGlaIdet @action=3,@mpproizvodiglaid=@@id"
  ONSUBMIT=""
  CMD1CAPTION=""
  CMD2CAPTION="Odustani"
  HEIGHT="6300"
  CAPTION="Dodjeljen trgovinama"
  MASTERDBLCLICK=""
  BORDERSTYLE="3"
 >

    <INPUT TYPE="text" CAPTION="Proizvod*" NAME="naziv" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320" TOP="300" LEFT="1000"/>
    <INPUT TYPE="text" CAPTION="JM*" NAME="jm" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320" TOP="600" LEFT="1000"/>
    <INPUT TYPE="number" CAPTION="" NAME="mpproizvodiglaid" WIDTH="5000" STYLE="1" ENABLED="FALSE" HEIGHT="320" VISIBLE="FALSE" DECIMALS="0"/>

    <INPUT TYPE="grid"
      NAME="potrg"
      REFRESHAFTERCHILD="TRUE"
      CHECKBOXVISIBLE="FALSE"
       
           VERSION="2"
      GROUPBOXVISIBLE="FALSE"
      TOTALROWVISIBLE="FALSE"
      TOP="1000"
      LEFT="100"
      CAPTION=""
      WIDTH="6500"
      HEIGHT="3700"
      TABINDEX="5"
      SQL="spMPProizvodiGlaIdet @action = 16,@mpproizvodiglaid=@@id" >
      
    </INPUT>

  </PREGPOTRG>

  <KOPIRAJ
  FILLEXPLORER=""
  REPORT=""
  WIDTH="9500"
  VERSION="2.1"
  ONLOAD=""
  ONSUBMIT=""
  CMD1CAPTION=""
  CMD2CAPTION=""
  HEIGHT="6300"
  CAPTION="Kopiranje proizvoda sa trgovine na trgovinu "
  MASTERDBLCLICK=""
  BORDERSTYLE="3"
 >

    <INPUT TYPE="combo" CAPTION="Trgovina SA koje se kopira*" NAME="trgovinaid" WIDTH="5000" STYLE="1" ENABLED="TRUE" HEIGHT="320" TOP="300" LEFT="2000" 
           ALLOWEMPTY="TRUE" ONLOSTFOCUS =" select 'refresh' as kopi" SQL="spmpdajtrgovinang @operateriid = @@operateriid"/>
    <INPUT TYPE="combo" CAPTION="Trgovina NA koju se kopira*" NAME="trgovina2id" WIDTH="5000" STYLE="1" ENABLED="TRUE" HEIGHT="320" TOP="800" LEFT="2000" 
           ALLOWEMPTY="TRUE" ONLOSTFOCUS =" select 'refresh' as kopi" SQL="spmpdajtrgovinang @operateriid = @@operateriid"/>

    <INPUT TYPE="grid"
      NAME="kopi"
      REFRESHAFTERCHILD="TRUE"
      CHECKBOXVISIBLE="FALSE"
      VERSION="2"
      GROUPBOXVISIBLE="FALSE"
      TOTALROWVISIBLE="FALSE"
      TOP="1300"
      LEFT="500"
      CAPTION=""
      WIDTH="6500"
      HEIGHT="3700"
      TABINDEX="5"
      SQL="spMPProizvodiGlaIdet @action = 18, @trgovinaid=@@trgovinaid,  @trgovina2id = @@trgovina2id" >



    </INPUT>
    <INPUT TYPE="button" NAME="cancel" TABINDEX="" CAPTION="Odustani" TOP="5300" LEFT="1500" WIDTH="1000" HEIGHT="322" ONCLICK="close"  />
    <INPUT TYPE="button" NAME="kopp" TABINDEX="" CAPTION="Kopiraj" TOP="5300" LEFT="3500" WIDTH="1000" HEIGHT="322" ONCLICK="spMPProizvodiGlaIdet @action = 19, @trgovinaid=@@trgovinaid,  @trgovina2id = @@trgovina2id#OK"  />

  </KOPIRAJ>

	<KOPIRAJSVE
	  FILLEXPLORER=""
	  REPORT=""
	  WIDTH="7000"
	  VERSION="2.5"
	  ONLOAD="select MPProizvodiGlaID as MPProizvodiGla2ID, r.naziv + ' (' + cast(r.userid as varchar(15)) + ')' as naziv from mpproizvodigla pg inner join roba r on pg.robaid = r.robaid where mpproizvodiglaid = @@id"
	  ONSUBMIT=""
	  CMD1CAPTION=""
	  CMD2CAPTION=""
	  HEIGHT="6900"
	  CAPTION="Kopiranje proizvoda na druge trgovine "
	  MASTERDBLCLICK=""
	  BORDERSTYLE="3"
	  ONLOADED="select 0 as imaNorm, 1 as odgovor"
	 >

		<INPUT TYPE="text" NAME="MPProizvodiGla2ID" CAPTION=""  TOP="100" LEFT="7000" WIDTH="1000" HEIGHT="320"  ENABLED="FALSE"  />
		<INPUT TYPE="text"   NAME="imaNorm"    CAPTION=""       TOP="-1610" LEFT="8000" WIDTH="1500"  VISIBLE="FALSE"/>

		<INPUT TYPE="text" NAME="naziv" CAPTION="Proizvod*"  TOP="300" LEFT="1500" WIDTH="5000" HEIGHT="320"  ENABLED="FALSE"  />

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum važenja od*"  TOP="700" LEFT="1500" WIDTH="1500" HEIGHT="320"  ENABLED="TRUE"  />

		<INPUT TYPE="combo" NAME="mpregijeid" CAPTION="Regija*" TOP="1100" LEFT="1500" WIDTH="5000" HEIGHT="300" ALLOWEMPTY="TRUE"
           SQL="select mpregijeid, naziv from mpregije" ONLOSTFOCUS="select 'refresh' as kopiTrgovina"/>


		<INPUT TYPE="grid"
		  NAME="kopiTrgovina"
		  REFRESHAFTERCHILD="FALSE"
		  CHECKBOXVISIBLE="TRUE"
		  VERSION="2"
		  GROUPBOXVISIBLE="FALSE"
		  TOTALROWVISIBLE="FALSE"
		  TOP="1600"
		  LEFT="1500"
		  CAPTION=""
		  WIDTH="5000"
		  HEIGHT="3700"
		  TABINDEX="5"
		  SQL="spMPProizvodiGlaIdet @action = 21, @operateriid = @@operateriid, @vrstatrg='M', @mpregijeid = @@mpregijeid, @mpproizvodiglaid = @@MPProizvodiGla2ID" >



		</INPUT>
		<INPUT TYPE="button" NAME="cancel" TABINDEX="" CAPTION="Odustani" TOP="5600" LEFT="1500" WIDTH="1000" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="kopp" TABINDEX="" CAPTION="Kopiraj" TOP="5600" LEFT="3500" WIDTH="1000" HEIGHT="322"
			   ONCLICK="exec spMPProizvodiGlaIdet @action = 22, @mpproizvodiglaid = @@MPProizvodiGla2ID, @trgovinaIDlista = '@@nizoznacenihajdijevakopiTrgovina'
						#:PROVEDI_FORMA@@imaNorm
						#if coalesce(@@odgovor,0) = 0 exec spRaiserror 69001, 'Kopiranje je poništeno.'
						#if exists (select * from dbo.sysobjects where id = object_id(N'[dbo].[MPInfoPoruka]') and OBJECTPROPERTY(id, N'IsUserTable') = 1) 
							truncate table MPInfoPoruka
						#FOREACHSELECTED(kopiTrgovina)#spMPProizvodiGlaIdet @action = 20,  @operateriid = @@operateriid, @trgovinaid = @(kopiTrgovina..trgovinaid), @mpproizvodiglaid = @@MPProizvodiGla2ID, @datumod = @@datumod
						#:INFO_FORM2		
						#OK"  />

	</KOPIRAJSVE>


	<PROVEDI_FORMA1
	   NAME="PROVEDI_FORMA" HEIGHT="2200" WIDTH="6000"
	   CAPTION="Potvrda kopiranja"
	   ONSUBMIT=""
	   ONLOAD="select 1 as odgovor"
	   FILLEXPLORER=""
	   VERSION="1.7"
	   FOCUS=""
	   ONLOADED=""
	   CMD1CAPTION="" CMD2CAPTION=""
			>
		<INPUT TYPE="label"  NAME="lblUpit"  CAPTION="Neke odabrane trgovine već imaju aktivan normativ za ovaj proizvod." TOP="100" LEFT="400" WIDTH="1200"  ENABLED="TRUE" SIZE="9"/>
		<INPUT TYPE="label"  NAME="lblUpit"  CAPTION="Sigurno želite prepisati aktivaciju?" TOP="400" LEFT="1400" WIDTH="1200"  ENABLED="TRUE" SIZE="9"/>
		<INPUT TYPE="number"  NAME="odgovor"		TABINDEX="-5" TOP="100" LEFT="1000" WIDTH="1500" ALLOWEMPTY="FALSE" CAPTION="Postotak" SQL="" DECIMALS="0" ENABLED="FALSE" VISIBLE="FALSE"/>

		<INPUT TYPE="button" NAME="ok" TABINDEX="22" CAPTION="Kopiraj" TOP="1100" LEFT="500" WIDTH="1106" HEIGHT="422"
			   ONCLICK="select 1 as odgovor
					   #OK"  />
		<INPUT TYPE="button" NAME="cancel" TABINDEX="22" CAPTION="Odustani" TOP="1100" LEFT="2000" WIDTH="1200" HEIGHT="422"
			   ONCLICK="select 0 as odgovor#OK"  />

	</PROVEDI_FORMA1>

	<INFO_FORM2 NAME="INFO_FORM2"
		 HEIGHT="7200"
		 WIDTH="8700"
		 CAPTION="Rezultat spremanja"
		 ONSUBMIT=""
		 ONLOAD="if not exists (select * from dbo.sysobjects where id = object_id(N'[dbo].[MPInfoPoruka]') and OBJECTPROPERTY(id, N'IsUserTable') = 1) 
					create table MPInfoPoruka (PorukaText varchar(1500) null, error bit null)"
		 ONLOAD2=" "
              
		 ONLOADED="if(select count(*) from MPInfoPoruka) = 0 begin
					  insert into MPInfoPoruka(porukatext, error)
					  select 'Spremanje je uspješno izvršeno.', 0
					end
					else begin
					  insert into MPInfoPoruka(porukatext, error)
					  select 'Preostali podaci su uspješno spremljeni.', 0
					end#select 'refresh' as gridPoruka"
		 NEXTFORM=""
		 FOCUS="odustani"
		 version="1.202"
		 FILLEXPLORER=""
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

		<INPUT TYPE="grid"
			NAME="gridPoruka"
			REFRESHAFTERCHILD=""
			CAPTION="Stavke"
			TOP="200" LEFT="100" WIDTH="8100" HEIGHT="6000"
			TABINDEX="-1"
			PAGEFOOTERRIGHT="@@tkosmomi"
			PAGEORIENTATION="LANDSCAPE"
			GROUPBYBOXVISIBLE="TRUE"
			CHECKBOXVISIBLE="FALSE"
			TOTALROW="FALSE"
			   SIZE="7"
			SQL="select case when [error] = 1 then 'Greška' else 'Obavijest' end as [Tip poruke]
				,porukatext as [Info6000]
            , formatid = case when porukatext IS null then 'regular' else 'regular' end  
            , RowColorID = case when [error] = 1 then 'white' else 'white' end
            , RowForeColorID  = case 
			            when [error] = 1 then 'red'
			            when [error] = 0 then 'green'
			            else 'black' end
            From MPInfoPoruka " />
		<INPUT TYPE="button"    NAME="odustani"   CAPTION="Zatvori" TOP="6500" LEFT="7000" WIDTH="1100" HEIGHT="320"
			   ONCLICK="truncate table MPInfoPoruka#close" />

	</INFO_FORM2>
	
</PROJECT>
 
