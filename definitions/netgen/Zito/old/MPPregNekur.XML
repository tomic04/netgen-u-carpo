		CMD6CAPTION=""  
		MASTERDBLCLICK=""
	        POPUPMASTER=""> 
 

  <NAME>Pregled nekurentne robe</NAME>
  <CAPTION>Pregled nekurentne robe</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		ONSUBMIT="spMPPregNekurentneRobeNG @action=1,@operateriid=@@operateriid," 
		ONLOAD="select @@trgovinaid as trgovinaid, @@broj1 as broj1, @@stanje as stanje" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


			<INPUT TYPE="label" 
                                   	NAME="lbl32" 
                                      	TOP="200" 
                                       	LEFT="200" 
                               		WIDTH="1500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>

                     	<INPUT TYPE="combo" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Način" 
                                     	TOP="200" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="false" 
                                 	SQL="spmpdajtrgovinang @operateriid = @@operateriid"/>

			<INPUT TYPE="label" 
					NAME="lbl4" 
					TOP="700" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Broj dana"/> 

			<INPUT TYPE="number" 
					NAME="broj1" 
					TOP="700" 
					LEFT="2200" 
					TABINDEX="1" 
					CAPTION="Broj dana" 
					TEXT="" 
					DECIMALS="0" 
					WIDTH="1900" 
					HEIGHT="320"/> 

 			<INPUT TYPE="label" 
					NAME="lbl1" 
					TOP="1300" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Roba"/> 

			<INPUT TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%" 
					TABINDEX="2" 
					TOP="1300" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<INPUT TYPE="label" 
                                   	NAME="lbl322" 
                                      	TOP="1800" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Klasa"/>

                     	<INPUT TYPE="combo" 
                                     	NAME="klasaid" 
                                    	CAPTION="Klasa" 
                                     	TOP="1800" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="TRUE" 
 	                              	SQL="select KlMasterRobaId,  naziv = space(len(sortkey)) + naziv,sortkey from KlMasterRoba order by sortkey"  />

			<INPUT TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                                      	TOP="2300" 
                                       	LEFT="2200" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<INPUT TYPE="VB.checkbox" 
                                   	NAME="stanje" 
                                      	TOP="2800" 
                                       	LEFT="2200" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži samo robe kojima je stanje različito od 0"/>

  </FORM1>
 

<FORM2	 	FILLEXPLORER="TRUE" 
		WIDTH="12000" 
