  <NAME>Pregled robe po trgovinama</NAME>
  <CAPTION>Pregled robe po trgovinama</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		ONSUBMIT="spMPPregRobeTrgovinaNG @action=1, @operateriid = @@operateriid," 
		ONLOAD="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


			<INPUT TYPE="label" 
                                   	NAME="lbl32" 
                                      	TOP="200" 
                                       	LEFT="200" 
                               		WIDTH="1500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>

                     	<INPUT TYPE="combo" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Način" 
                                     	TOP="200" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

			
 			<INPUT TYPE="label" 
					NAME="lbl1" 
					TOP="700" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Roba"/> 

			<INPUT TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" 
					TOP="700" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 
					
			<INPUT TYPE="label" 
					NAME="lbl11" 
					TOP="1200" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Traženje pojma"/> 

			<INPUT TYPE="text" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TOP="1200" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					
 			<INPUT TYPE="label" 
					NAME="lbl2" 
					TOP="1700" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Klasa"/> 

			<INPUT TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TOP="1700" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

 			<INPUT TYPE="label" 
					NAME="lbl3" 
					TOP="2200" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Dodatna jedinica mjere"/> 

			<INPUT TYPE="combo"
					NAME="jmid"
					CAPTION="Dodatna jedinica mjere"
					TOP="2200" 
					LEFT="2200" 
					WIDTH="5500"
					HEIGHT="320"
					ALLOWEMPTY="true"
					SQL="select distinct j.jmid, naziv from jm j inner join jmroba jm on j.jmid = jm.jmid order by naziv"/>

			<INPUT TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                                      	TOP="2800" 
                                       	LEFT="2200" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<INPUT TYPE="VB.checkbox" 
                                   	NAME="stanje" 
                                      	TOP="3300" 
                                       	LEFT="2200" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži samo robe kojima je stanje različito od 0"/>

  </FORM1>

