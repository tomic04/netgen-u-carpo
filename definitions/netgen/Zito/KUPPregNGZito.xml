 <NARUDZBE_FORM CAPTION="@@caption" HEIGHT="9400" WIDTH= "9300" FILLEXPLORER="" 
                 ONSUBMIT="" ONLOAD="dbo.spKUPNabNarGlaQuery @id=@@kupprometid"
                 ONLOADED="if @@status=0 and (@@potvrdaind=0 or @@potvrdaind = null) 
					          select 'Narudžba, Nezaključena' as formcaption#
					       if @@status=0 and @@potvrdaind=1						   
					          select 'Narudžba, Nezakljucena - Čeka potvrdu' as formcaption#
				           if @@status=1 and (@@potvrdaind=0 or @@potvrdaind = null)					   
					          select 'Narudžba, Zakljucena' as formcaption#  
				           if @@status=1 and @@potvrdaind=1					   
					          select 'Narudžba, Potvrđena' as formcaption#						   
				           if @@status=5 and @@potvrdaind=1 					   
					          select 'Narudžba, Zaključena - Čeka potvrdu' as formcaption#
					       if @@status is null and @@potvrdaind=0 					   
					          select 'Narudžba' as formcaption#
					        select '@@dobavljac' as partneritra,'@@lokacija' as parstrutra"	
				>
	 
