<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD1CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="TRUE"
   POPUPMASTER=""
   TOTALROW="FALSE"
	FILLEXPLORER=""
   BUTTONS="Uvjeti:FILTERFORM#Dodaj:DODAJFORM#Izmjeni:UPDATEFORM#(de)Aktiviranje:AKTIVIRAJ" 
   MASTERDBLCLICK="UPDATEFORM">
 
  <NAME>Dozvola minusa na blagajni </NAME>
  <CAPTION>Dozvola minusa na blagajni </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


	<FILTERFORM NAME="FILTERFORM" HEIGHT="2500" WIDTH="7710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPDozvolaMinusa @action=1,@operateriid = @@operateriid,  "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="" ONLOSFOCUS=""/>
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="800" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
	</FILTERFORM>

  <DODAJFORM 
                 WIDTH="9000" 
                 ONSUBMIT="" 
                 ONLOAD="" 
				 ONLOADEDD ="select @@trgovinaid as trgovinaid" 
                 HEIGHT="3500" 
                 CAPTION="Unsite podatke  "
				 FILLEXPLORER=""
				 FOCUS="vrstapromid"
		 >
	  <INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
	  <INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="900" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />

	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2200" LEFT="1096" WIDTH="1106" HEIGHT="322" 
			 ONCLICK="spMPDozvolaMinusa @action=2,  @robaid = @@robaid, @trgovinaid = @@trgovinaid , @operateriid = @@operateriid #Ok"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2200" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </DODAJFORM>



	<UPDATEFORM
				   WIDTH="9000"
				   ONSUBMIT=""
				   ONLOAD="if (select status from MPDozvolaMinus where MPDozvolaMinusid = @@id) = 0 begin 
								exec spMPDozvolaMinusa @action=3,  @id= @@id 
							end 
							else begin 
							raiserror 19001 &apos;Status je aktivan. Ne možete mijenjati !&apos; 
							end "
				   ONLOADEDD =""
				   HEIGHT="3500"
				   CAPTION="Izmjenite podatke  "
				   FILLEXPLORER=""
				   FOCUS="trgovinaid"
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" TOP="900" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2200" LEFT="1096" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spMPDozvolaMinusa @action=4,  @id = @@id, @robaid = @@robaid, @trgovinaid = @@trgovinaid , @operateriid = @@operateriid #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2200" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</UPDATEFORM>




	<AKTIVIRAJ
				   WIDTH="8000" 
				   ONSUBMIT="" 
				   ONLOAD="spMPDozvolaMinusa @action=3, @id = @@id" 
				   HEIGHT="3000" 
				   CAPTION="Želite li promijeniti status uvjeta ? "  
				  FOCUS=""
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina*" ENABLED="FALSE" TOP="400" LEFT="1500" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONCLICK ="select 'refresh' as mpkaseid" ONLOSFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="search"    NAME="robaid"   ALLOWEMPTY="TRUE" CAPTION="Roba*" ENABLED="FALSE" TOP="900" LEFT="1500" WIDTH="5000" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Promijeni " TOP="1600" LEFT="1096" WIDTH="1106" HEIGHT="322" ONCLICK="spMPDozvolaMinusa @action=5, @operateriid = @@operateriid , @id = @@id#Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1600" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</AKTIVIRAJ>


	<IZMJENIFORM
		WIDTH="5500" 
		ONSUBMIT="" 
		ONLOAD="if (select vezanicjenikid from TempPromMPC where TempPromMPCId=@@gridstavkeTempPromMPCId) is not null begin 
									raiserror 19001 &apos;Ne možete ispravljati cijenu na veznom cjeniku !&apos;
				end
			else begin
				if coalesce(@@gridstavkeTempPromMPCId,0) = 0 and coalesce(@@gridstavkecjenikid,0) = 0 begin 
							raiserror 19001 &apos;NIste odabrali robu !&apos;
				end
				else begin
				
				exec spMPNIvelacijaNG @action=12,@robaid = @@robaid, @datumdok = @@datumdok, @cjenikid  = @@gridstavkecjenikid, @TempPromMPCid = @@gridstavkeTempPromMPCid , @vrcjenikid = @@gridstavkevrcjenikid end end"
		HEIGHT="2500" 
		CAPTION="Izmjeni cijenu" 
		FILLEXPLORER=""
		> 

			<INPUT TYPE="number" NAME="nabcijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 2 , @@cijena , @@marza , @@nabcijena) as cijena, 'marza' as focus " CAPTION="Nabavna cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
			<INPUT TYPE="number" NAME="marza" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 3 , @@cijena , @@marza , @@nabcijena) as cijena, 'cijena' as focus " CAPTION="Marža % " TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="3" DECIMALS="2" />
			<INPUT TYPE="number" NAME="cijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 1 , @@cijena , @@marza , @@nabcijena) as marza, 'ok' as focus " CAPTION="MP Cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />

			<INPUT TOP="5000" TYPE="number" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />
			<INPUT TOP="5000" TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<INPUT TOP="5000" TYPE="number" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<INPUT TOP="5000" TYPE="number" NAME="TempPromMPCid" CAPTION="TempPromMPCid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />
			<INPUT TOP="5000" TYPE="number" NAME="vrcjenikid" ALOWEMPTY ="FALSE" CAPTION="vrcjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="0" />

	  <INPUT TYPE="button" NAME="ok" CAPTION="Spremi " TABINDEX="1" TOP="1500" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPNIvelacijaNG @action=1, @robaid = @@robaid , @TempPromMPCid = @@TempPromMPCid, @cjenikid = @@cjenikid , @datumdok = @@datumdok , @vrcjenikid = @@vrcjenikid , @cijena = @@cijena , @marza = @@marza , @nabcijena  =@@nabcijena#Ok"  />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="4" TOP="1500" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </IZMJENIFORM> 



  <DODAJROBUUCJENIKFORM
		WIDTH="6500" 
		HEIGHT="3500" 
		ONSUBMIT="spMPNIvelacijaNG @action=0,@operateriid=@@operateriid," 
		ONLOAD="if @@robaid is null begin 
							raiserror 19001 &apos;NIste odabrali robu !&apos;
				end
				else begin select @@datumdok as datumdok,@@robaid as robaid, (select naziv from roba where robaid=@@robaid) as nazivrobe
				end "		
		CAPTION="Dodaj robu u cijenik : @@nazivrobe" 
		> 
			<INPUT TYPE="number" NAME="nabcijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 2 , @@cijena , @@marza , @@nabcijena) as cijena, 'marza' as focus " CAPTION="Nabavna cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />
			<INPUT TYPE="number" NAME="marza" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 3 , @@cijena , @@marza , @@nabcijena) as cijena, 'cijena' as focus " CAPTION="_Marža" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="1" DECIMALS="2" />
			<INPUT TYPE="number" NAME="cijena" ONLOSTFOCUS="select [dbo].[fnMPKalk] (@@robaid , 1 , @@cijena , @@marza , @@nabcijena) as marza, 'vrcjenikid' as focus " CAPTION="MP Cijena" TEXT="" WIDTH="1500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
			<INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Vrsta cjenika" WIDTH="3500" HEIGHT="320" TABINDEX="3" ALLOWEMPTY="FALSE" SQL="spmpDajMPCjenik @operateriid = @@operateriid"/>

			<INPUT TYPE="button" TOP="2300" LEFT="300" name="okbotun" CAPTION="Spremi" TABINDEX="4" ONCLICK="OK" />
			<INPUT TYPE="button" TOP="2300" LEFT="1600" name="exitbotun"  CAPTION="Odustani" TABINDEX="5" ONCLICK="CLOSE" />
			<INPUT TOP="5000" TYPE="number" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<INPUT TOP="5000" TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<INPUT TOP="5000" TYPE="number" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
  </DODAJROBUUCJENIKFORM> 



  <DAJCJENIK
  
                 WIDTH="14000" 
                 ONSUBMIT="" 
                 ONLOAD="select @@vrcjenikid as vrcjenikid, @@robaid as robaid, roba=(select naziv from roba where robaid=@@robaid)" 
                 HEIGHT="6500" 
                 CAPTION="CJENIK"  
                 CMD2CAPTION="Gotovo" 
                 CMD3CAPTION="Pokaži:DAJCJENIK" 
		 CMD4CAPTION="" 
		 FILLEXPLORER="" 
		 >
                       	<INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Vrsta cjenika" WIDTH="5500" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="true" SQL="spmpDajMPCjenik @operateriid = @@operateriid"/>
	  	        <INPUT TYPE="TRAZILICA" CAPTION="Roba" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userid#Robakod#%barcode%" TABINDEX="0"  WIDTH="4500" HEIGHT="320" />        
			<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" CAPTION="Cijene po cijenicima" WIDTH="10500" HEIGHT="4000" TABINDEX="2" SQL="spMPNIvelacijaNG @action=6,@robaid=@@robaid, @vrcjenikid = @@vrcjenikid"  /> 
  </DAJCJENIK>
  

  <DONESI
                 WIDTH="7000" 
                 ONSUBMIT="spMPNIvelacijaNG @action = 10," 
                 ONLOAD="" 
                 HEIGHT="2500" 
                 CAPTION="Donos robe sa cjenika za nivelaciju "  
                 CMD1CAPTION="Donesi" 
                 CMD2CAPTION="Odustani" 
		 FILLEXPLORER="" 
		 >
	  		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
	  		<INPUT TYPE="combo" NAME="vrcjeniksaid" CAPTION="Cjenik sa : " WIDTH="4000" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="false" SQL="select vrcjenikid as vrcjeniksaid,opis as naziv from vrcjenik where vrcjenikid not in (select vrcjenik2id  from mpvezanicjenik) order by coalesce(Datumaktiviranja,'20990101') desc "/>
	  		<INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Cjenik na: " WIDTH="4000" HEIGHT="320" TABINDEX="0" ALLOWEMPTY="false" SQL="select distinct t.vrcjenikid , v.opis as naziv from trgovina t inner join vrcjenik v on t.vrcjenikid = v.vrcjenikid and t.vrcjenikid not in (select vrcjenik2id  from mpvezanicjenik)" />
  </DONESI>


</PROJECT>
 
