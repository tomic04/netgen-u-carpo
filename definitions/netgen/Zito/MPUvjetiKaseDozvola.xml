<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	ONLOAD=":FILTERFORM" 
	CHECKBOXVISIBLE="TRUE"
	POPUPMASTER=""
	TOTALROW="FALSE"
	FILLEXPLORER=""
	BUTTONS="Pronađi:FILTERFORM#Dodaj:DODAJFORM#Izmjeni:UPDATEFORM#Obriši:DELETEFORM#(de)Aktiviraj:AKTIVIRAJ" 
	MASTERDBLCLICK="UPDATEFORM">
 
	<NAME>Dozvoljena roba na kasi </NAME>
	<CAPTION>Dozvoljena roba na kasi </CAPTION>
 
	<KOMENTAR> </KOMENTAR>
	<AUTOR> KK 23.02.2009.  </AUTOR>

	<FILTERFORM NAME="FILTERFORM" HEIGHT="2000" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spmpuvjetikaseDozvola @action=1, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		<INPUT TYPE="combo" NAME="aktivno" ALLOWEMPTY="TRUE" CAPTION="Status*" TOP="400" LEFT="1000" ONLOSTFOCUS="" SQL="select 1 as aktivno, 'Aktivno' as Naziv union all select '0', 'Neaktivno'" />
	</FILTERFORM>

	<DODAJFORM 
        WIDTH="9000" 
        ONSUBMIT="" 
        ONLOAD="" 
		ONLOADED ="select @@trgovinaid as trgovinaid, null as klmasterrobaid" 
		HEIGHT="3500" 
        CAPTION="Unos podataka"
		FILLEXPLORER=""
		FOCUS="trgovinaid"
		>
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="FALSE" CAPTION="Trgovina*" TOP="400" LEFT="1500" SQL="spMPDajTrgovina @operateriid  = @@operateriid" ONLOSTFOCUS="select 'refresh' as mpkaseid"/>
		<INPUT TYPE="combo" NAME="mpkaseid" ALLOWEMPTY="FALSE" CAPTION="Kasa*" TOP="1000" LEFT="1500" ONLOSTFOCUS="" SQL="select mpkaseid, kasa from mpkase where trgovinaid = @@trgovinaid and pomocnakasa = 1 " />
		<INPUT TYPE="combo"    NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1600" LEFT="1500" WIDTH="5000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2200" LEFT="1096" WIDTH="1106" HEIGHT="322" 
			 ONCLICK="spmpuvjetikaseDozvola @action=3, @klmasterrobaid =  @@klmasterrobaid,@mpkaseid = @@mpkaseid #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2200" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</DODAJFORM>

	<UPDATEFORM 
				   WIDTH="12000" 
				   ONSUBMIT="select 1" 
				   ONLOAD="spmpuvjetikaseDozvola @action=2, @id = @@id" 
				   HEIGHT="5500" 
				   CAPTION="Izmjena podataka"
				   FILLEXPLORER=""
				   FOCUS="vrstapromid"

		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ENABLED="FALSE" CAPTION="Trgovina*" TOP="400" LEFT="1500" SQL="spMPDajTrgovina @operateriid  = @@operateriid" />
		<INPUT TYPE="combo" NAME="mpkaseid" ENABLED="FALSE" CAPTION="Kasa*" TOP="1000" LEFT="1500" SQL="select mpkaseid, kasa from mpkase" />
		<INPUT TYPE="combo" NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1600" LEFT="1500" WIDTH="5000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="4400" LEFT="1096" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spmpuvjetikaseDozvola @action=4, @id=@@id, @klmasterrobaid =  @@klmasterrobaid#Ok"  />
	
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="4400" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</UPDATEFORM>

	<DELETEFORM
				   WIDTH="8000" 
				   ONSUBMIT="" 
				   ONLOAD="spmpuvjetikaseDozvola @action=2, @id = @@id" 
				   HEIGHT="5000" 
				   CAPTION="Želite li obrisati uvjet ? "  
				  FOCUS="vrstapromid"
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ENABLED="FALSE" CAPTION="Trgovina*" TOP="400" LEFT="1500" SQL="spMPDajTrgovina @operateriid  = @@operateriid" />
		<INPUT TYPE="combo" NAME="mpkaseid" ENABLED="FALSE" CAPTION="Kasa*" TOP="1000" LEFT="1500" SQL="select mpkaseid, kasa from mpkase" />
		<INPUT TYPE="combo" NAME="klmasterrobaid"   ENABLED="FALSE" CAPTION="Klasa Robe*" TOP="1600" LEFT="1500" WIDTH="5000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Briši (F2)" TOP="3600" LEFT="1096" WIDTH="1106" HEIGHT="322" ONCLICK="spmpuvjetikaseDozvola @action=5,  @id = @@id #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3600" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</DELETEFORM>

	<AKTIVIRAJ
		WIDTH="8000" 
		ONSUBMIT="" 
				   ONLOAD="spmpuvjetikaseDozvola @action=2, @id = @@id" 
				   HEIGHT="5000" 
				   CAPTION="Želite li promijeniti status uvjeta ? "  
				  FOCUS=""
		 >
		<INPUT TYPE="combo" NAME="trgovinaid" ENABLED="FALSE" CAPTION="Trgovina*" TOP="400" LEFT="1500" SQL="spMPDajTrgovina @operateriid  = @@operateriid" />
		<INPUT TYPE="combo" NAME="mpkaseid" ENABLED="FALSE" CAPTION="Kasa*" TOP="1000" LEFT="1500" SQL="select mpkaseid, kasa from mpkase" />
		<INPUT TYPE="combo" NAME="klmasterrobaid"   ENABLED="FALSE" CAPTION="Klasa Robe*" TOP="1600" LEFT="1500" WIDTH="5000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Promijeni " TOP="3600" LEFT="1096" WIDTH="1106" HEIGHT="322" ONCLICK="spmpuvjetikaseDozvola @action=6,  @id = @@id #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3600" LEFT="2356" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</AKTIVIRAJ>

</PROJECT>
 
