<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 ONLOAD=":FILTER_FORM"
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 BUTTONS="Uvjeti:FILTER_FORM#Vet.kartica:VETKARTICA(@stgrloid = @@id)#Ispis liste:PRINTMASTER" 
		 CMD6CAPTION=""
		 INCLUDE="STKarticaVet.xml" 
		 POPUPMASTER=""
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 FROZENCOLUMNS="0" AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname', @sifradok='504', @trazi = 'dijagn'" 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT=""
		 PAGEHEADERCENTER="Pregled grla u karenci"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="LANDSCAPE">


	<NAME>Pregled grla u karenci</NAME>
	<CAPTION>Pregled grla u karenci</CAPTION>
	<AUTOR>23.4.2009. kč </AUTOR>




	<FILTER_FORM HEIGHT="2500" WIDTH="7000"
			 CAPTION="Upišite uvjete prikaza"
			 ONSUBMIT="spSTPregKarence @action = 1, @operateriid = @@operateriid,"
			 ONLOAD="select @@farmeid as farmeid" 
			 FILLEXPLORER="TRUE">

		<INPUT TYPE="combo" NAME="farmeid" ONCLICK="" SQL="spStDAjFarme @action = 0, @operateriid=@@operateriid" ALLOWEMPTY="TRUE" CAPTION="Farma" ONLOSTFOCUS=""/>
		<INPUT TYPE="combo" NAME="STTipKarenceid" ONCLICK="" SQL="select * from sttipkarence" ALLOWEMPTY="TRUE" CAPTION="Tip karence" ONLOSTFOCUS=""/>
		<INPUT TYPE="button" NAME="ok"         TOP="1000" LEFT="1000" CAPTION="Pokaži"   ONCLICK="ok" />
		<INPUT TYPE="button" NAME="cancel"     TOP="1000" LEFT="2500" CAPTION="Odustani"   ONCLICK="close" />
	</FILTER_FORM>



	



</PROJECT>