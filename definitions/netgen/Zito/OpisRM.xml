<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Parametri:MAINFORM" 
          ONLOAD=":MAINFORM" 
          GROUPBYBOXVISIBLE="FALSE" 
          CHECKBOXVISIBLE="FALSE">

  <NAME>Klase tečajeva</NAME>
  <CAPTION>Klase tečajeva</CAPTION>


<MAINFORM NAME="MAINFORM" HEIGHT="6998" WIDTH="5600"
         CAPTION="Opis radnog mjesta" 
         ONLOAD=""
         MAXIMIZEBOX="TRUE" WINDOWSTATE="" >

    <INPUT TYPE="group"  NAME="topgroupbox"    DOCK="2" CAPTION="" HEIGHT="700"   />
	
    <INPUT TYPE="tree"   NAME="leftgrid" DOCK="5" SQL="spOpisRMTree :LIJEVIGRIDFORMA"  
         ONCLICK="select 'refresh' as kategorijagrid"  CHECKBOXVISIBLE="FALSE" WIDTH="5600"  GROUPBYBOXVISIBLE="FALSE" HEIGHT="5500"
		 POPUP="Dodaj::INSERTTREEFORM~select 'refresh' as leftgrid#Izmjeni::UPDATETREEFORM~select 'refresh' as leftgrid#Premjesti::MOVETREEFORM~select 'refresh' as leftgrid#Obriši::DELETETREEFORM~select 'refresh' as leftgrid"/>
        	
	<INPUT TYPE="button" NAME="cmdDodaj" TOP="6000" LEFT="100" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Dodaj" ANCHOR="6"
			ONCLICK=":INSERTTREEFORM#select 'refresh' as leftgrid"/>
	<INPUT TYPE="button" NAME="cmdIzmjeni" TOP="6000" LEFT="1200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG45" CAPTION="Izmjeni" ANCHOR="6"
			ONCLICK=":UPDATETREEFORM#select 'refresh' as leftgrid"/>
	<INPUT TYPE="button" NAME="cmdPremjesti" TOP="6000" LEFT="2300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG46" CAPTION="Premjesti" ANCHOR="6"
			ONCLICK=":MOVETREEFORM#select 'refresh' as leftgrid"/>
	<INPUT TYPE="button" NAME="cmdObrisi" TOP="6000" LEFT="4000" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG46" CAPTION="Obriši" ANCHOR="6"
			ONCLICK=":DELETETREEFORM#select 'refresh' as leftgrid"/>
 
</MAINFORM>

<INSERTTREEFORM CAPTION="Unos opisa radnog mjesta" HEIGHT="2400" WIDTH= "6000" FILLEXPLORER="" 
			 ONLOAD=""
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS=""			 >				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="1000" WIDTH="5700" TEXT="FrameNG1" CAPTION=""/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="500" LEFT="1000"  HEIGHT="300" WIDTH="4400" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" MAXLENGTH=""/>		  
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="1400" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spOpisRM @action='unesi_opis',@Naziv='@@naziv',@OpisRMId=@@leftgrid#select 'refresh' as kategorijagrid#OK"/>
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="1400" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>					
</INSERTTREEFORM>

 
<UPDATETREEFORM CAPTION="Izmjena opisa radnog mjesta" HEIGHT="2400" WIDTH= "6000" FILLEXPLORER="" 
			 ONLOAD="spOpisRM @action='izmjeni',@OpisRMId=@@leftgrid"
             ONLOADED=""					 
			 ONSUBMIT="" NEXTFORM=""
             SETDEFAULTS="" >				
    <INPUT TYPE="frame" NAME="fr1" TOP="100" LEFT="50" HEIGHT="1000" WIDTH="5700" TEXT="FrameNG1" CAPTION=""/>	
    
	<INPUT TYPE="label" NAME="lblnaziv"  TOP="500" LEFT="200" WIDTH="1000" CAPTION="Naziv:"/>	   
	<INPUT TYPE="text" NAME="naziv" TOP="500" LEFT="1000"  HEIGHT="300" WIDTH="4400" CAPTION="" ENABLED="TRUE" MULTILINE="TRUE" />	
		   
	<INPUT TYPE="button" NAME="cmdSpremi" TOP="1400" LEFT="200" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Spremi" 
	       ONCLICK="spOpisRM @action='izmjeni_opis',@naziv='@@naziv',@OpisRMId=@@leftgrid#select 'refresh' as kategorijagrid#OK"/>	   
	<INPUT TYPE="button" NAME="cmdOdustani" TOP="1400" LEFT="1300" HEIGHT="331" WIDTH="1000" TEXT="ButtonNG44" CAPTION="Odustani" 
	       ONCLICK="close"/>					
</UPDATETREEFORM>
   

<MOVETREEFORM HEIGHT="7000" WIDTH="3900"  CAPTION="Odaberi novu poziciju " ONLOAD="" >
    <INPUT TYPE="tree"   NAME="movegrid" DOCK="0" SQL="spOpisRMTree :LIJEVIGRIDFORMA"  ONCLICK="select 'refresh' as kategorijagrid"  CHECKBOXVISIBLE="FALSE" LEFT="100" WIDTH="3600"  HEIGHT="5800" GROUPBYBOXVISIBLE="FALSE" POPUP="" />
    <INPUT TYPE="button"  NAME="ok"      CAPTION="Premjesti" TOP="6100" LEFT ="200" WIDTH="1000" ONCLICK="spOpisRM @action='premjesti_opis',@OpisRMId=@@leftgrid,@moveid=@@movegrid#select 'refresh' as kategorijagrid#OK"/>
    <INPUT TYPE="button"  NAME="cancel"  CAPTION="Odustani" TOP="6100" LEFT ="1300" WIDTH="1000" ONCLICK="close"/>
</MOVETREEFORM>
  
  
<DELETETREEFORM HEIGHT="1700" WIDTH="5500"  CAPTION="Obriši" 
                  ONLOAD="select @@leftgrid as leftgrid" >
	 <INPUT TYPE="label" NAME="lbldatum" TOP="300" LEFT="400" WIDTH="400" CAPTION="Jeste li sigurni da želite obrisati odabranu kategoriju ?"/>
     <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="400" WIDTH="1000" CAPTION="Obriši" 
	        ONCLICK="spOpisRM @action='obrisi_opis',@OpisRMId=@@leftgrid#select 'refresh' as kategorijagrid#OK" TABINDEX="0" />
     <INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close" TABINDEX="1" />
</DELETETREEFORM>


</PROJECT>