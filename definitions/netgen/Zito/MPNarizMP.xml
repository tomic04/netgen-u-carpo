			<INPUT TYPE="combo" NAME="trgovinaid" ONCLICK="select 'refresh' as osobeid" SQL="select trgovinaid , opis as naziv from trgovina where aktivno = 1 and trgovinaid = 18 order by oznaka" ALLOWEMPTY="FALSE" CAPTION="Iz trgovine" />
			<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena" />
			<INPUT TYPE="combo" NAME="osobeid" SQL="spMPDajOsobe @trgovinaid = @@trgovinaid" ALLOWEMPTY="FALSE" CAPTION="Odgovorna osoba"/>
