<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=11,@operateriid=@@operateriid,@node='@@node', @sifradok = '110', @vrstadokid = @@vrstadokid, @nenc = 1" />



<INSERTFORM NAME="INSERTFORM" HEIGHT="4500" WIDTH="8000" 
		 CAPTION="Unos narudžbenice iz druge trgovine"
		 ONSUBMIT="spMPInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = '110', @status = 0,"
		 ONLOAD="select convert(varchar,getdate(),112) as datumdok" 
		 NEXTFORM="UPDATE_FORM"
		 CMD1CAPTION="Stavke&gt;&gt;&gt;" 
		 CMD2CAPTION="Odustani" 
		>
			<INPUT TYPE="text" NAME="broj"   CAPTION="Broj dokumenta:" ENABLED="FALSE"/>
			<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:" />
