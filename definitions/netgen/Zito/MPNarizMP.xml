		<INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno*" TOP="7322" LEFT="9594" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="button" NAME="ok" TABINDEX="7" CAPTION="Spremi (F2)" TOP="7840" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = '110',@datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @partneriid = @@partneriid#Ok" HOTKEY="F2" />
