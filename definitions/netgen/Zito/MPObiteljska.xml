   CMD2CAPTION="Dodaj:DODAJ"    
   CMD6CAPTION="Podaci o članu:PRIKAZI" 
   CMD4CAPTION="Obitelj:OBITELJ"
   CMD5CAPTION=""
   CMD3CAPTION="Izmjeni:IZMJENI"
   POPUPMASTER=""
   DETAILGRID = "spMPObiteljskaKartica @action=3,@MPClanoviid=@@MPClanoviid"
   MASTERDBLCLICK="FORM1">
 
  <NAME>Obiteljska kartica </NAME>
  <CAPTION>Obiteljska kartica </CAPTION>



	<FILTERFORM
						   FILLEXPLORER="TRUE"
						  WIDTH="7500"
						   ONSUBMIT="spMPObiteljskaKartica @action = 1, @mpclanoviid = @@mpclanoviid, "
						   ONLOAD=""
						   HEIGHT="3500"
						   CAPTION="Upišite paramatre pregleda"
						  BORDERSTYLE="3"
						   CMD1CAPTION="Pokaži"
						   CMD2CAPTION="Odustani" >


		<INPUT TYPE="text"
		CAPTION="Ime "
		NAME="ime"
		TABINDEX="1"
		TEXT=""
		WIDTH="3500"
		HEIGHT="320"/>

		<INPUT TYPE="text"
		CAPTION="Prezime"
		NAME="prezime"
		TABINDEX="2"
		TEXT=""
		WIDTH="3500"
		HEIGHT="320"/>

		<INPUT TYPE="text"
					CAPTION="Šifra člana"
					NAME="sifra"
					TABINDEX="3"
					TEXT=""
					WIDTH="1500"
					HEIGHT="320"/>



	</FILTERFORM>

	<DODAJ
					   FILLEXPLORER="TRUE"
					  WIDTH="7500"
					   ONSUBMIT="spMPObiteljskaKartica @action = 1, "
					   ONLOAD=""
					   HEIGHT="2500"
					   CAPTION="Upišite nositelja obiteljske kartice"
					  BORDERSTYLE="3"
					   CMD1CAPTION=""
					   CMD2CAPTION="" >

		<INPUT TYPE="search" NAME="mpclanoviid"  CAPTION="Nositelj obiteljska kartice*"   TOP="600"  LEFT="2500" HEIGHT="2500" SQL="spMPObiteljskaKartica @action = 6, @trazilica = @@searchboxmpclanoviid" BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="button" NAME="ok"          CAPTION="Spremi"  TOP="1600" LEFT="2028" ONCLICK="spMPObiteljskaKartica @action=2,@mpclanoviid = @@mpclanoviid #select prezime , ime from mpclanovi where mpclanoviid = @@mpclanoviid#Ok"  />
		<INPUT TYPE="button" NAME="cancel"      CAPTION="Odustani"  TOP="1600" LEFT="4028" ONCLICK="close"  />



	</DODAJ>




	<FORM2
			FILLEXPLORER="TRUE"
			WIDTH="12000"
			ONSUBMIT=""
			ONLOAD="select 1"
			HEIGHT="6000"
			CAPTION="Pregled promet člana"
			BORDERSTYLE="3"
			CMD1CAPTION=""
			CMD2CAPTION="Odustani"
			CMD3CAPTION="Stavke:DAJSTAVKE"
			CHILDFORM="">




		<INPUT TYPE="grid" 
                                   	NAME="lbl2" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="11500" 		
                                   	HEIGHT="4000" 
                               		CAPTION="Pregled mp računa"
					REFRESHAFTERCHILD="TRUE"
					SQL="spMPObiteljskaKartica @action=1,@mpclanoviid=@@id"/>
			      
  </FORM2>

  <OBITELJ 
			FILLEXPLORER="TRUE" 
			WIDTH="12000" 
			ONSUBMIT="" 
			ONLOAD="select *, rtrim(ime)+' '+rtrim(prezime) as imeiprezime from mpclanovi where mpclanoviid = @@mpclanoviid" 		
			HEIGHT="6000" 
			CAPTION="Članovi obitelji" 
			BORDERSTYLE="3" 
			CMD1CAPTION="" 
			CMD2CAPTION="" 
			CMD3CAPTION="" 
			CHILDFORM="">

	  <INPUT TYPE="text"
			  CAPTION="Ime i prezime*"
			  NAME="Imeiprezime"
			  ENABLED="FALSE"
			  TABINDEX="1"
			  TEXT=""
			  TOP="400" 
			  LEFT="2300" 
			 WIDTH="3500"
			  HEIGHT="320" />

	  <INPUT TYPE="text"
			  CAPTION="Broj kartice*"
			  NAME="Sifra"
			  ENABLED="FALSE"
			  TABINDEX="1"
			  TEXT=""
			  TOP="400"
			  LEFT="7000"
			 WIDTH="3500"
			  HEIGHT="320" />



	  <INPUT TYPE="grid" 
				NAME="obitelj" 
                TOP="1000" 
                LEFT="200" 
                WIDTH="11500" 		
                HEIGHT="3500" 
                CAPTION="Pregled članova obitelji"
				REFRESHAFTERCHILD="TRUE"
				TOTALROWVISIBLE="TRUE"
				 CHECKBOXVISIBLE="FALSE"
			 SQL="spMPObiteljskaKartica @action=3,@MPClanoviid=@@MPClanoviid"/>
	  <INPUT TYPE="button" NAME="ok"          CAPTION="Odustani"  TOP="5000" LEFT="2028" ONCLICK="close"  />
	  <INPUT TYPE="button" NAME="ok"          CAPTION="Dodaj"  TOP="5000" LEFT="4028" ONCLICK=":DODAJCLANA"  />
	  <INPUT TYPE="button" NAME="cancel"      CAPTION="Obriši"  TOP="5000" LEFT="6028" ONCLICK=":BRISICLANA"  />

  </OBITELJ>

	<DODAJCLANA
					   FILLEXPLORER=""
					  WIDTH="7500"
					   ONSUBMIT=""
					   ONLOAD=""
					   HEIGHT="2500"
					   CAPTION="Upišite ćlana obitelji"
					  BORDERSTYLE="3"
					   CMD1CAPTION=""
					   CMD2CAPTION="" >

		<INPUT TYPE="search" NAME="mpclanovi2id"  CAPTION="Član obitelji*"   TOP="600"  LEFT="2500" HEIGHT="2500" SQL="MPClanovi#mpclanoviid#ime%#prezime%#sifra#!adresa" BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="button" NAME="ok"          CAPTION="Spremi"  TOP="1600" LEFT="2028" ONCLICK="spMPObiteljskaKartica @action=4,@mpclanoviid = @@mpclanoviid , @mpclanovi2id = @@mpclanovi2id #Ok"  />
		<INPUT TYPE="button" NAME="cancel"      CAPTION="Odustani"  TOP="1600" LEFT="4028" ONCLICK="close"  />



	</DODAJCLANA>


	<BRISICLANA
					   FILLEXPLORER=""
					  WIDTH="7500"
					   ONSUBMIT=""
					   ONLOAD="select rtrim(sifra) +' '+rtrim(ime)+' '+rtrim(prezime) as clan From mpclanovi where mpclanoviid= @@gridobiteljmpclanovi2id"
					   HEIGHT="2500"
					   CAPTION="Želite li obrisati člana obitelji"
					  BORDERSTYLE="3"
					   CMD1CAPTION=""
					   CMD2CAPTION="" >

		<INPUT TYPE="text" NAME="clan"  CAPTION="Član obitelji*"   ENABLED="FALSE"  TOP="600"  LEFT="2500" HEIGHT="2500" SQL="MPClanovi#mpclanoviid#ime%#prezime%#sifra#!adresa" BACKCOLOR="LIGHTYELLOW" />

		<INPUT TYPE="button" NAME="ok"          CAPTION="Obriši"  TOP="1600" LEFT="2028" TABINDEX="2" ONCLICK="spMPObiteljskaKartica @action=5,@mpclanoviObiteljid = @@obitelj#Ok"  />
		<INPUT TYPE="button" NAME="cancel"      CAPTION="Odustani"  TOP="1600" LEFT="4028" TABINDEX="1" ONCLICK="close"  />



	</BRISICLANA>



	<PRIKAZI  	
		  FILLEXPLORER="" 
		  WIDTH="9000" 
		  ONSUBMIT="" 
		  ONLOAD="select * from mpclanovi where mpclanoviid = @@mpclanoviid" 
		  HEIGHT="9300" 
		  CAPTION="Novi član" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="" 
		  CMD2CAPTION="Povratak" 
		  CMD3CAPTION=""
		  NEXTFORM="KOPIRAJ"
		>

		<INPUT TYPE="date" 
			 NAME="datumotvaranja" 
			 CAPTION="Datum otvaranja " 
			 SQL=""  
			 HEIGHT="320" 
			 WIDTH="1500" 
			 ENABLED="FALSE"
			 TABINDEX="1" 
			 CHECKBOX="FALSE" />

		<INPUT TYPE="combo" 
				CAPTION="Trgovina" 
				NAME="TrgovinaId" 
				SQL="spmpDajTrgovina @operateriid=@@operateriid" 
				TEXT=""
				TABINDEX="4" 
				WIDTH="5500" 
				ENABLED="FALSE"
				HEIGHT="320"/>

		<INPUT TYPE="text" 
					CAPTION="Sifra" 
					NAME="Sifra" 
					TABINDEX="0" 
					ENABLED="FALSE"
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320" />

		<INPUT TYPE="text" 
				CAPTION="Ime" 
				NAME="Ime" 
				ENABLED="FALSE"
				TABINDEX="1" 
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />

		<INPUT TYPE="text" 
				CAPTION="Prezime" 
				NAME="Prezime" 
				ENABLED="FALSE"
				TABINDEX="2" 
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />

		<INPUT TYPE="text" 
				CAPTION="Adresa" 
				NAME="Adresa" 
				ENABLED="FALSE"
				TABINDEX="3" 
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />

		<INPUT TYPE="combo" 
				CAPTION="Mjesto" 
				NAME="mjestaid" 
				ENABLED="FALSE"
				SQL="select mjestaid, naziv+' '+rtrim(hptbroj) as naziv from mjesta" 
				TABINDEX="4" 
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />

		<INPUT TYPE="text" 
				CAPTION="Mail" 
				NAME="mail" 
				ENABLED="FALSE"
				TABINDEX="5" 
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />

		<INPUT TYPE="date" 
						NAME="DatumRodjenja" 
							CAPTION="Datum rođenja" 
						VALUE="" 
						HEIGHT="320" 
						WIDTH="1500" 
						TABINDEX="6" 
					  ENABLED="FALSE"
					  CHECKBOX="FALSE" />


		<INPUT TYPE="combo" 
									NAME="hrspremeid" 
									CAPTION="Sprema" 
								WIDTH="5500" 
								HEIGHT="320" 
				ENABLED="FALSE"
									TABINDEX="9" 
								ALLOWEMPTY="true" 
								SQL="select hrspremeid, rtrim(oznaka) + ' ' + naziv as [Naziv] from hrspreme" />

		<INPUT TYPE="number" 
				NAME="brojclanovaobitelji" 
				CAPTION="Broj članova obitelji" 
				TEXT="" 
				ENABLED="FALSE"
				WIDTH="500" 
				HEIGHT="320" 
				TABINDEX="10" 
				DECIMALS="0" />

		<INPUT TYPE="number" 
				NAME="brojdjece" 
				CAPTION="Broj djece" 
				ENABLED="FALSE"
				TEXT="" 
				WIDTH="500" 
				HEIGHT="320" 
				TABINDEX="11" 
				DECIMALS="0" />

		<INPUT TYPE="text" 
				NAME="brojoi" 
				CAPTION="Broj OI" 
				ENABLED="FALSE"
				TEXT="" 
				WIDTH="2500" 
				HEIGHT="320" 
				TABINDEX="12" />
		<INPUT TYPE="text" 
				CAPTION="Spol" 
				NAME="Spol" 
				TABINDEX="14" 
				ENABLED="FALSE"
				TEXT="M" 
				WIDTH="500" 
				HEIGHT="320" />

		<INPUT TYPE="text" 
					  CAPTION="Broj Telefona" 
					  NAME="Brojtelefon" 
					  TABINDEX="15" 
					  ENABLED="FALSE"
					  TEXT="" 
					  WIDTH="5500" 
					  HEIGHT="320" />

		<INPUT TYPE="text" 
				CAPTION="Broj mobitela" 
				NAME="BrojMob" 
				TABINDEX="16" 
				ENABLED="FALSE"
				TEXT="" 
				WIDTH="5500" 
				HEIGHT="320" />
		<INPUT TYPE="number" 
				NAME="pocetnibodovi" 
				CAPTION="Broj ulaznih bodova" 
				TEXT="" 
				ENABLED="FALSE"
				WIDTH="500" 
				HEIGHT="320" 
				TABINDEX="10" 
				DECIMALS="0" />
		<INPUT TYPE="text" 
				CAPTION="Napomena" 
				NAME="Napomena" 
				TABINDEX="18" 
				TEXT="" 
				ENABLED="FALSE"
				WIDTH="5500" 
				HEIGHT="320" />



	</PRIKAZI>


</PROJECT>

