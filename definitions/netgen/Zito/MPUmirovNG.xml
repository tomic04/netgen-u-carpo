<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Parametri:FILTERFORM" CMD2CAPTION="Sve trg.:SVETRGOVINE"
		 CMD3CAPTION="Umirovi:UMIROVLJENJE" CMD4CAPTION="Aktiraj:AKTIVIRAJ" CMD5CAPTION="Kartica:KARTICA" CMD6CAPTION=""
		 CMD7CAPTION="" CMD8CAPTION="" POPUPMASTER="Umirovi:UMIROVLJENJE" MASTERDBLCLICK="UMIROVLJENJE"
		 GROUPBYBOXVISIBLE="TRUE" ONLOAD=":FILTERFORM" FROZENCOLUMNS="0" AUTOFITCOLUMNS="False"
		 REPORT="">
<NAME>Umirovljenje robe u trgovini</NAME>
<CAPTION>Umirovljenje robe u trgovini</CAPTION>
<KOMENTAR>Callisto 1.7.9</KOMENTAR>

<FILTERFORM NAME="FILTERFORM" HEIGHT="4298" WIDTH="8000" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Upišite uvjete prikaza " BORDERSTYLE="3" ONSUBMIT="spMPUmiroviRobuNG @action = 100, "
		 ONLOAD="select @@trgovinaid as trgovinaid, @@stanje as stanje, @@umirovljen as umirovljen, @@danaa as danaa" 
		 CANCELONSUBMIT="" FILLEXPLORER="TRUE" NEXTFORM=""
		 CMD1CAPTION="Pokaži" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" REPORT="">
	
	<INPUT TYPE="combo" NAME="trgovinaid" 
		 HEIGHT="302" WIDTH="3456" TOP="300" VISIBLE="TRUE" SQL="spMPDajTrgovina @operateriid = @@operateriid "
		 TEXT="" VALUE="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE"
		 CAPTION="Trgovina*" TABINDEX="0" ENABLED="TRUE"/>

	<INPUT TYPE="TRAZILICA" 
			CAPTION="Roba: *" 
			NAME="robaid" 
			SQL="virobabezusluga#robaid#Naziv%#userid#barcode"
			TEXT=""
			TABINDEX="2" 
			TOP="800"
			WIDTH="5000" 
			HEIGHT="320"/>

	<INPUT TYPE="combo" NAME="umirovljen" 
		 HEIGHT="302" WIDTH="2880" TOP="1300" EMPTY="FALSE" VISIBLE="TRUE" SQL="select 1 as umirovljen,&apos;Umirovljena&apos; as naziv union all select 2 as umirovljen,&apos;Aktivna&apos; as naziv union all select 3 as umirovljen,&apos;Umirovljena u svim trgovinama&apos; as naziv "
		 TEXT="" VALUE="" ALLOWEMPTY="true" REFRESHAFTERCHILD="TRUE"
		 CAPTION="Status robe: *" TABINDEX="3" ENABLED="TRUE"/>



	<INPUT TYPE="label"    NAME="labelpromet" CAPTION="Roba bez prometa u " TOP="2400" LEFT="350"   />
	<INPUT TYPE="number"   NAME="danaa"      CAPTION="" TOP="2300" LEFT="1950"  DECIMALS="0"  WIDTH="500"/>
	<INPUT TYPE="label"    NAME="labeldana" CAPTION="dana" TOP="2400" LEFT="2500"   />


</FILTERFORM>

<UMIROVLJENJE NAME="UMIROVLJENJE" HEIGHT="3312" WIDTH="7502" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Umirovljenje robe" BORDERSTYLE="3" 
		 ONSUBMIT="spMPUmiroviRobuNG @action = 1,@robaid=@@id, @trgovinaid =  @@trgovinaid,"
		 ONLOAD="select r.robaid, r.userid, r.naziv as naziv, @@trgovinaid as trgovinaid from roba r where robaid =@@id" 
		 CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" 
		 CMD3CAPTION="" 
		 CMD4CAPTION=""
		 CMD5CAPTION="" 
		 CMD6CAPTION="" 
		 REPORT="">
	<INPUT TYPE="label" NAME="Label24" TOP="200" 
		 HEIGHT="288" WIDTH="1915" VISIBLE="TRUE" BOLD="FALSE"
		 CAPTION="Želite li umiroviti artikal ?" ENABLED="TRUE"/>

	<INPUT TYPE="text" NAME="userid" TOP="600" 
		 HEIGHT="317" WIDTH="4997" VISIBLE="TRUE" TEXT=""
		 CAPTION="Šifra*" TABINDEX="77" ENABLED="FALSE"/>


	<INPUT TYPE="text" NAME="naziv" TOP="1000" 
		 HEIGHT="317" WIDTH="4997" VISIBLE="TRUE" TEXT=""
		 CAPTION="Naziv robe*" TABINDEX="77" ENABLED="FALSE"/>




</UMIROVLJENJE>
	<AKTIVIRAJ NAME="UMIROVLJENJE" HEIGHT="3312" WIDTH="7502" TEXT=""
			 REFRESHAFTERCHILD="TRUE" CAPTION="Umirovljenje robe" BORDERSTYLE="3" ONSUBMIT="spMPUmiroviRobuNG @action = 2,@robaid=@@id, @trgovinaid = @@trgovinaid,"
			 ONLOAD="select r.robaid, r.userid, r.naziv as naziv, @@trgovinaid as trgovinaid  from roba r where robaid =@@id" CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
			 CMD1CAPTION="Spremi" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
			 CMD5CAPTION="" CMD6CAPTION="" REPORT="">
		<INPUT TYPE="label" NAME="Label24" TOP="130" LEFT="230"
			 HEIGHT="288" WIDTH="1915" VISIBLE="TRUE" BOLD="FALSE"
			 CAPTION="Želite li aktivirati artikal ?" ENABLED="TRUE"/>

		<INPUT TYPE="text" NAME="userid" TOP="893" LEFT="1498"
			 HEIGHT="317" WIDTH="4997" VISIBLE="TRUE" TEXT=""
			 CAPTION="Šifra" TABINDEX="77" ENABLED="FALSE"/>

		<INPUT TYPE="label" NAME="Label27" TOP="893" LEFT="230"
			 HEIGHT="288" WIDTH="1152" VISIBLE="TRUE" BOLD="FALSE"
			 CAPTION="Šifra:" ENABLED="TRUE"/>

		<INPUT TYPE="text" NAME="naziv" TOP="1253" LEFT="1498"
			 HEIGHT="317" WIDTH="4997" VISIBLE="TRUE" TEXT=""
			 CAPTION="Naziv robe" TABINDEX="77" ENABLED="FALSE"/>

		<INPUT TYPE="label" NAME="Label28" TOP="1253" LEFT="230"
			 HEIGHT="288" WIDTH="1152" VISIBLE="TRUE" BOLD="FALSE"
			 CAPTION="Naziv robe:" ENABLED="TRUE"/>


	</AKTIVIRAJ>

	<KARTICA 	FILLEXPLORER="TRUE" 
		   WIDTH="15000" 
		   ONSUBMIT="" 
		   ONLOAD="" 
		   HEIGHT="9500" 
		   CAPTION="Krtica robe" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="Kraj" 
		   CMD3CAPTION="" 
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
					 SQL="spMaloprodajaStanjeKartica @action = 1, @mpstanjeid= @@id, @operateriid = @@operateriid ,@totalgen=1, @godina = @@godina  " />
	</KARTICA>

	<SVETRGOVINE FILLEXPLORER="TRUE" 
		   WIDTH="15000" 
		   ONSUBMIT="" 
		   ONLOAD="" 
		   HEIGHT="9500" 
		   CAPTION="Stanje u svim trgovinama" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="" 
		   CMD3CAPTION="" 
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="svetrg" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
					 SQL="spMPUmiroviRobuNG @action = 101, @robaid = @@id" />
		<INPUT TYPE="button" NAME="ok" CAPTION="Umirovi" HOTKEY=""   TABINDEX="2" TOP="8500" LEFT="500" WIDTH="1106" HEIGHT="322" ONCLICK="FOREACHSELECTED(svetrg)#spMPUmiroviRobuNG @action = 1,@robaid=@@id, @trgovinaid =  @(svetrg..trgovinaid)#Ok"/>
		<INPUT TYPE="button" NAME="ok1" CAPTION="Aktiviraj" HOTKEY=""   TABINDEX="3" TOP="8500" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="FOREACHSELECTED(svetrg)#spMPUmiroviRobuNG @action = 2,@robaid=@@id, @trgovinaid =  @(svetrg..trgovinaid)#Ok"/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TABINDEX="1" TOP="8500" LEFT="4000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</SVETRGOVINE>

</PROJECT>


