<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spSTErrorLogPopisStadaImport @action=2, @id = '@@id'"
		 MASTERDBLCLICK=""
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1="" 
		 INCLUDE="" 
		 BUTTONS="Filter:FILTERFORM" 
		 POPUPMASTER="" 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOADED=""   
		 ONLOAD=":FILTERFORM" 
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 REPORT="">



	<NAME>Uvoz osnovnih podataka grla iz AFIfarm-a</NAME>
	<CAPTION>Uvoz osnovnih podataka grla iz AFIfarm-a</CAPTION>


	<FILTERFORM NAME="FILTERFORM" HEIGHT="2254" WIDTH="5710"
			 CAPTION="Upišite uvjete prikaza "
			 ONSUBMIT="spSTErrorLogPopisStadaImport @action = 1, "
			 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo"
			 FILLEXPLORER="TRUE"
			VERSION="1.1"
			 NEXTFORM=""
			 CMD1CAPTION="Pokaži"
			 CMD2CAPTION="Odustani"
		 >
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
		
	</FILTERFORM>



	<IMPORT_FILE 
		 NAME="IMPORT_FILE" HEIGHT="2670" WIDTH="8000" 
		 CAPTION="Uvoz iz datoteke"
		 ONSUBMIT=""
		 ONLOAD="select 'D:\JupiterSpin\PAKETI\Stočarstvo\StočarstvoV8\AFIfarm-Import\PopisStada\MalaBranjevinaPopisStada20160818.txt' as [file]" 
		 NEXTFORM=""
		 VERSION="1.1"
		 CMD1CAPTION="" 
		 CMD2CAPTION="" 
		 MAXIMIZEBOX="TRUE" 
		 MINIMIZEBOX="TRUE"
		 COMMANDTIMEOUT="600"
		>
		<INPUT TYPE="text" NAME="file" TOP="400" LEFT="1000" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Datoteka:*" ENABLED="TRUE"/>

		<INPUT TYPE="button" NAME="browse1" CAPTION="Pronađi datoteku..." TOP="380" LEFT="6000" WIDTH="1500" HEIGHT="322" ENABLED="TRUE"
			   ONCLICK="SHOWOPENFILEDIALOG()#select '@@selectedfile' as [file]" HOTKEY="" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Izvrši" TOP="1100" LEFT="1000" WIDTH="1200" HEIGHT="322" HOTKEY=""
			   ONCLICK="
					select 'Uvoz podataka u tijeku...' as lblStatusFile2
					#spSTPrijenosPopisStadaAFI2 @file = '@@file', @operateriid = @@operateriid
					#select 'invisible' as lblStatusFile2#select 'visible' as lblStatusFile3
					#select 'refresh' as master
					#OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1100" LEFT="2500" WIDTH="1200" HEIGHT="322" HOTKEY=""
			   ONCLICK="close"   />

		<INPUT TYPE="label" NAME="lblStatusFile" TOP="1800" LEFT="1000" WIDTH="1500" ALLOWEMPTY="TRUE" CAPTION="Status uvoza: " ENABLED="TRUE" SIZE="10" STYLE="1"/>
		<INPUT TYPE="label" NAME="lblStatusFile2" TOP="1830" LEFT="2600" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Nije pokrenut." ENABLED="TRUE" SIZE="9" FORECOLOR="#F31F18"/>
		<INPUT TYPE="label" NAME="lblStatusFile3" TOP="1830" LEFT="2600" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Uvoz podataka završen." ENABLED="TRUE" SIZE="9" VISIBLE="FALSE" FORECOLOR="#0C6A17"/>
		
	</IMPORT_FILE>


	<IMPORT_FOLDER
		 NAME="IMPORT_FOLDER" HEIGHT="2670" WIDTH="8000"
		 CAPTION="Uvoz iz mape"
		 ONSUBMIT=""
		 ONLOAD="select 'D:\JupiterSpin\PAKETI\Stočarstvo\StočarstvoV8\AFIfarm-Import\PopisStada\' as [path]"
		 NEXTFORM=""
		 CMD1CAPTION=""
		 VERSION="1.1"
		 CMD2CAPTION=""
		 MAXIMIZEBOX="TRUE"
		 MINIMIZEBOX="TRUE"
		 COMMANDTIMEOUT="600"
		>
		<INPUT TYPE="text" NAME="path" TOP="400" LEFT="1000" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Mapa:*" ENABLED="TRUE"/>

		<INPUT TYPE="button" NAME="browse1" CAPTION="Pronađi mapu..." TOP="380" LEFT="6000" WIDTH="1500" HEIGHT="322" ENABLED="TRUE"
			   ONCLICK="SHOWFOLDERBROWSERDIALOG()#select '@@selectedpath' as [path]" HOTKEY="" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Izvrši" TOP="1100" LEFT="1000" WIDTH="1200" HEIGHT="322" HOTKEY=""
			   ONCLICK="select 'Uvoz podataka u tijeku...' as lblStatusFolder2
					#spSTPrijenosPopisStadaAFI2 @folder = '@@path', @operateriid = @@operateriid
					#select 'invisible' as lblStatusFolder2#select 'visible' as lblStatusFolder3
					#select 'refresh' as master
					#OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1100" LEFT="2500" WIDTH="1200" HEIGHT="322" HOTKEY=""
			   ONCLICK="close"   />

		<INPUT TYPE="label" NAME="lblStatusFolder" TOP="1800" LEFT="1000" WIDTH="1500" ALLOWEMPTY="TRUE" CAPTION="Status uvoza: " ENABLED="TRUE" SIZE="10" STYLE="1"/>
		<INPUT TYPE="label" NAME="lblStatusFolder2" TOP="1830" LEFT="2600" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Nije pokrenut." ENABLED="TRUE" SIZE="9" FORECOLOR="#F31F18"/>
		<INPUT TYPE="label" NAME="lblStatusFolder3" TOP="1830" LEFT="2600" WIDTH="5000" ALLOWEMPTY="TRUE" CAPTION="Uvoz podataka završen." ENABLED="TRUE" SIZE="9" VISIBLE="FALSE" FORECOLOR="#0C6A17"/>
	</IMPORT_FOLDER>




</PROJECT>