<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTER_FORM" 
		 DETAILGRID = "spMPRegije @action = 11, @mpregijeid = @@id"
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Parametri:FILTER_FORM"
		 CMD2CAPTION="" 
		 CMD3CAPTION="Ažuriranje regija:REGIJA_FORM" 
		 CMD4CAPTION="Ažuriranje trgovina:INSERT_FORM" 		
		 CMD5CAPTION=""
		 CMD6CAPTION="" 
		 CMD7CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 EDITCOLUMNS=""
		 ONCELLEDITED=""
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Regije trgovina</NAME>
	<CAPTION>Regije trgovina</CAPTION>
	<AUTOR>24.02.2015 matija horvat </AUTOR>


 <FILTER_FORM NAME="FILTER_FORM"
		 HEIGHT="2800"
		 WIDTH="6000"
		 CAPTION="Uvijeti prikaza"
		 ONSUBMIT="spMPRegije @action = 1, "
		 ONLOAD="select @@partneriid as partneriid"
     ONLOADED=""
     FILLEXPLORER="TRUE"
		 FOCUS="opis"
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani" >


   <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5600" HEIGHT="1600" />
   <INPUT TYPE="combo" NAME="mpregijeid" CAPTION="Regija*" TOP="400" LEFT="1500" WIDTH="4000" HEIGHT="300" ALLOWEMPTY="TRUE"
           SQL="select mpregijeid, naziv from mpregije" ONLOSTFOCUS=""/>
   <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" TOP="800" LEFT="1500" WIDTH="4000" HEIGHT="300" ALLOWEMPTY="TRUE"
           SQL="spMPDajTrgovinaNG @operateriid = @@operateriid " ONLOSTFOCUS=""/>
  

</FILTER_FORM>

  <REGIJA_FORM NAME="REGIJA_FORM"
		 HEIGHT="5600"
		 WIDTH="5800"
		 CAPTION="Ažuriranje regije"
		 ONSUBMIT=""
		 ONLOADED=""
		 ONLOAD=""
	   FILLEXPLORER=""
		 FOCUS="partneriid"
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

    <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="6400" HEIGHT="4400" />
   
    <INPUT TYPE="text"    NAME="naziv"   CAPTION="Naziv regije*" TOP="400" LEFT="1000" WIDTH="5300" HEIGHT="280" />

    <INPUT TYPE="grid"
             NAME="regije"
             REFRESHAFTERCHILD="TRUE"
             TOP="800" LEFT = "150"
             WIDTH="4600" HEIGHT="3500"
             TABINDEX="2"
             CHECKBOXVISIBLE="TRUE"
             SQL="select r.mpregijeid, r.naziv as [Naziv regije4000] from mpregije r" />


    <INPUT TYPE="button"    NAME="dodaj"   CAPTION="Dodaj (F5)" TOP="800" LEFT="4800" WIDTH="1500" HEIGHT="320"
       ONCLICK="spMPRegije @action = 2, @naziv = '@@naziv'#select 'refresh' as regije#select '' as naziv#select 'naziv' as focus" HOTKEY="F5"/>
    <INPUT TYPE="button"    NAME="obrisi"   CAPTION="Obriši (F8)" TOP="1200" LEFT="4800" WIDTH="1500" HEIGHT="320" HOTKEY="F8"
       ONCLICK="FOREACHSELECTED(regije)#spMPRegije @action = 3, @mpregijeid = @@regije#select 'refresh' as regije"/>
    
    <INPUT TYPE="button"    NAME="odustani"   CAPTION="Zatvori (ESC)" TOP="4600" LEFT="500" WIDTH="1500" HEIGHT="320" ONCLICK="close"  HOTKEY="ESC"/>
  </REGIJA_FORM>
  
  
<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="6600" 
		 WIDTH="6000" 
		 CAPTION="Dodavanje trgovine u regiju"
		 ONSUBMIT=""
		 ONLOADED=""
		 ONLOAD="" 
	   FILLEXPLORER=""
		 FOCUS="partneriid" 
		 CMD1CAPTION="" 
		 CMD2CAPTION="" >

      <INPUT TYPE="frame"    NAME="frm"   CAPTION="" TOP="50" LEFT="100" WIDTH="5700" HEIGHT="5600" />
  
      <INPUT TYPE="combo" NAME="mpregijexid" CAPTION="Regija*" TOP="400" LEFT="700" WIDTH="5000" HEIGHT="300" ALLOWEMPTY="FALSE" 
         SQL="select mpregijeid, naziv from mpregije order by naziv" ONCLICK="SELECT 'refresh' as trgovine"/>
      

      <INPUT TYPE="grid" 
             NAME="trgovine" 
             REFRESHAFTERCHILD="TRUE" 
             TOP="800" LEFT = "700" 
             WIDTH="5000" HEIGHT="4500" 
             TABINDEX="2"
             EDITCOLUMNS="[U regiji0900]"
             CHECKBOXVISIBLE="FALSE"
             SQL="spMPRegije @action = 111, @mpregijeid = @@mpregijexid, @operateriid = @@operateriid" />

      <INPUT TYPE="button" NAME="ok" 		  CAPTION="Spremi" TABINDEX="2" TOP="5800" LEFT="1280" WIDTH="1428" HEIGHT="322"
       ONCLICK="FOREACHROW(trgovine)#spMPRegije @action = 22 , @mpregijeid = @@mpregijexid, @trgovinaid = @(trgovine..trgovinaid), @regija = @(trgovine..U regiji0900)#OK" HOTKEY="F8" />
      <INPUT TYPE="button" NAME="cancel" 		CAPTION="Odustani" TABINDEX="3" TOP="5800" LEFT="3280" WIDTH="1428" HEIGHT="322" ONCLICK="close" HOTKEY="F8" />

  
</INSERT_FORM>





</PROJECT>