<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=""
		 BUTTONS="Parametri:FILTERFORM#Ispis liste:PRINTMASTER"
		 POPUPMASTER="Parametri:FILTERFORM" 
		 GROUPBYBOXVISIBLE="FALSE"   
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 SETDEFAULTS="" 
		 PAGEHEADERCENTER="Pregled prometa artikala MP iz VP"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="LANDSCAPE">


	<NAME>Pregled prometa artikala MP iz VP</NAME>
	<CAPTION>Pregled prometa artikala MP iz VP</CAPTION>
	<AUTOR>10.5.2010. kč </AUTOR>



<FILTERFORM NAME="FILTERFORM" 
		 HEIGHT="4000" 
		 WIDTH="9000" 
		 ONSUBMIT="spMPPrmArtMPizVPNG @action = 1,  @operateriid= @@operateriid,"
		 CAPTION="Upišite uvjete prikaza " 
		 FILLEXPLORER="TRUE">
		 
		 <INPUT TYPE="date"   NAME="datumod"         CAPTION="Datum od:*" DEFAULT="firstdayofmonth" TOP="200" LEFT="1200" WIDTH="2000" HIGHT="322" />
		 <INPUT TYPE="date"   NAME="datumdo"         CAPTION="Datum do:*" TOP="600" LEFT="1200" WIDTH="2000" HIGHT="322" />
	     <INPUT TYPE="combo"  NAME="trgovinaid"      CAPTION="Trgovina:*" TOP="1000" LEFT="1200" WIDTH="5000" HIGHT="322" ALLOWEMPTY="FALSE" ONLOSTFOCUS="select 'refresh' as skladisteid" 
				SQL="select t.* , left(t.oznaka,3)+ ' ' +t.opis  as naziv , left(t.oznaka,3)+ ' ' +t.opis  as opis 
					from trgovina t 
					inner join trgovineprava tp on t.trgovinaid = tp.trgovinaid
					where tp.operaterid = @@operateriid  and aktivno = 1 and t.vrstatrg='V'
					order by t.oznaka" />
	     <INPUT TYPE="combo" NAME="klmasterrobaid"  CAPTION="Klasa:*" TOP="1400" LEFT="1200" WIDTH="5000" HIGHT="322" SQL="select KlMasterRobaid, oznaka+&apos;&apos;+naziv as naziv from KlMasterRoba order by SortKey" ALLOWEMPTY="TRUE" ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />  
		 <INPUT TYPE="search" NAME="robaid"          CAPTION="Roba:*" TOP="1800" LEFT="1200" WIDTH="7000" HIGHT="322" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid, @trazi = '@@searchboxrobaid' " ONLOSTFOCUS="" BACKCOLOR="LIGHTYELLOW" />


		<INPUT TYPE="button" NAME="ok" CAPTION="Pokaži" TOP="3000" LEFT="500" WIDTH="1500" HEIGHT="322" ONCLICK="OK"/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3000" LEFT="2200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>

</FILTERFORM>



</PROJECT>