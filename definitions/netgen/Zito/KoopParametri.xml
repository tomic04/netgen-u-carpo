<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD="spKOOPParametri @actioN = 1" 
		 DETAILGRID = "spKOOPParametri @action= 2 , @grupa = @@id, @ind = @@indid"
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="" 
		 CMD2CAPTION=""
		 CMD3CAPTION="" 
		 CMD4CAPTION="" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 BUTTONS="Kopiraj:KOPIRAJ#Izmjena:UPDATE_FORM#AKTIVIRANJE:AKTIVIRANJE" 
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER="Kategorije"
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Parametri obračuna tova</NAME>
	<CAPTION>Parametri obračuna tova</CAPTION>
	<AUTOR>6.7.2009. ivica matić </AUTOR>


  <POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spRBKategorija @action = 1, @operateriid= @@operateriid , @ind = @@indid" 
		 FILLEXPLORER="TRUE" >
  </POKAZI_FORM>

  <AKTIVIRANJE NAME="POKAZI_FORM"
			 ONSUBMIT="spKOOPParametri @action= 3 , @grupa = @@id, @ind = @@indid"
			 FILLEXPLORER="TRUE" >
  </AKTIVIRANJE>


  <UPDATE_FORM NAME="UPDATE_FORM" 
		 HEIGHT="5000" 
		 WIDTH="9500" 
		 CAPTION="Izmjena grupe parametara"
		 ONSUBMIT=""
		 ONLOAD="select @@indid as indid" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >


	  <INPUT TYPE="number" NAME="indid" CAPTION="" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="" DECIMALS="0 " VISIBLE="FALSE"/>
	  <INPUT TYPE="grid"
		   NAME="grupa"
		   REFRESHAFTERCHILD="TRUE"
		   CAPTION="Grupa"
		   SKIPDEFAULTLOAD2="TRUE"
		   TOP="300" LEFT="256" WIDTH="8500" HEIGHT="3000"
		   POPUP=""
		   ONDBLCLICK=""
		   EDITCOLUMNS="[Utrošak po KG1200]"
		   ONCELLEDITED="spKOOPParametri  @action = 4, @id = @@KoopKategorijaStokeId, @utrosak = @@gridgrupaUtrošak_po_KG, @operateriid = @@operateriid, @ind = @@indid"
		   CHECKBOXVISIBLE="FALSE"
		   PAGEHEADERCENTER=""
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT=""
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   ONCLICK=""
		   PAGEFOOTERRIGHT="@@thosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="TRUE"
		   TOTALROW="FALSE"
		   SQL="spKOOPParametri @action = 2, @grupa = @@id, @ind = @@indid" />

  </UPDATE_FORM>

  <KOPIRAJ NAME="KOPIRAJ"
		   HEIGHT="1700"
		   WIDTH="4700"
		   CAPTION="Kopiranje grupe"
		   ONLOAD ="select @@indid as indid, @@grupa as grupa"
		   ONSUBMIT=""
		   FILLEXPLORER="" >

	  <INPUT TYPE="label" NAME="lblInfo" CAPTION="Želite kopirati odabranu grupu?" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="" />
	  <INPUT TYPE="number" NAME="indid" CAPTION="" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="" DECIMALS="0 " VISIBLE="FALSE"/>
	  <INPUT TYPE="number" NAME="grupa" CAPTION="" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="" DECIMALS="0 " VISIBLE="FALSE"/>
	  <INPUT TYPE="button" NAME="ok" CAPTION="Kopiraj" TOP="500" LEFT="400" ONCLICK="spKOOPParametri @action = 5, @operateriid = @@operateriid, @grupa =  @@grupa,  @ind = @@indid#OK" />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="500" LEFT="2000" ONCLICK="CLOSE" />
	  
	  
	  
  </KOPIRAJ>

  <AKTIVIRANJE NAME="Aktiviranje"
		   HEIGHT="1700"
		   WIDTH="4700"
		   CAPTION="Aktiviranje grupe"
		   ONLOAD ="select @@indid as indid"
		   ONSUBMIT=""
		   FILLEXPLORER="" >

		<INPUT TYPE="label" NAME="lblInfo" CAPTION="Želite aktivirati odabranu grupu?" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="spKOOPParametri @action = 5#OK" />
		  <INPUT TYPE="number" NAME="indid" CAPTION="" TOP="100" LEFT="200" WIDTH="2000" ONCLICK="" DECIMALS="0 " VISIBLE="FALSE"/>
		  <INPUT TYPE="button" NAME="ok" CAPTION="Aktiviraj" TOP="500" LEFT="400" ONCLICK="spKOOPParametri @action = 3, @grupa = @@id, @operateriid = @@operateriid, @ind = @@indid#OK" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="500" LEFT="2000" ONCLICK="CLOSE" />



  </AKTIVIRANJE>
	


</PROJECT>