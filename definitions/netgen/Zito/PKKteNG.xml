<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
	TREE="Sve:SVE_FORM#Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM"
	CMD1CAPTION="Novi:NOVIOBRACUN" 
	CMD2CAPTION="Poništi obračun:PONISTIOBRACUN" 
	CMD3CAPTION="Ispis:" 
	CMD4CAPTION="Ispis obračun:" 
	POPUP="Obriši partnera čiji je obr manji od:SELEKTIVNOBRISANJE#Obriši račun:OBRISIRACUN#Obriši partnera sa obračuna:OBRISIPARTNERA#Fakturiraj(multiselect):FAKTURIRAJ"
	REPORT="rptKteUkp.clsReport"
	DETAILGRID="sppkKteNG @action=2,@ID=@@ID"
>
 
<NAME>Obračun kamata na kredite</NAME>
<CAPTION>Obračun kamata na kredite</CAPTION>

	<SVE_FORM	        FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='sve'" />
	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='danas'" />
	<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='jucer'" />
	<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='ovajmj'" />
	<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='proslimj'" />
	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="sppkKteNG @action=1,@node='@@node'" />

	<SELEKTIVNOBRISANJE
		WIDTH="8000" 
		STORA="sppkKteNG @action=6,@ID=@@ID, " 
		STARTUPSTORA="sppkKteNG @action=66,@ID=@@ID" 
		HEIGHT="4800" 
		CAPTION="Brisanje partnera iz obračuna  za iznos manji od ..."  
		CMD1CAPTION="Obriši" 
		CMD2CAPTION="Odustani" 
	>

		<INPUT TYPE="Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="3500" HEIGHT="320" CAPTION="Brisanje partnera iz obračuna  za iznos manji od ..." />
		<INPUT TYPE="Label"  NAME="lbl1" TOP="1700" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Iznos" />
		<INPUT TYPE="Number"  NAME="iznos" TOP="1700" LEFT="2200" TABINDEX="0" CAPTION="" />
	</SELEKTIVNOBRISANJE>

	<OBRISIPARTNERA
		WIDTH="8000" 
		STORA="sppkKteNG @action=7,@ID=@@ID " 
		STARTUPSTORA="sppkKteNG @action=66,@ID=@@ID" 
		HEIGHT="4800" 
		CAPTION="Brisanje partnera iz obračuna"  
		CMD1CAPTION="Obriši" 
		CMD2CAPTION="Odustani" 
	>

		<INPUT TYPE="Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="3500" HEIGHT="320" CAPTION="Jeste li sigurni?" />                                  

	</OBRISIPARTNERA>
	
	<OBRISIRACUN
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="sppkKteNG @action=8,@ID=@@ID" 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Obriši račun sa obračuna ?"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Obriši" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

		<INPUT TYPE="Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Jeste li sigurni ?" />
	</OBRISIRACUN>

	<NOVIOBRACUN
		FILLEXPLORER=""
		WIDTH="8000" 
		ONSUBMIT="sppkKteNG @action=3, " 
		HEIGHT="5800" 
		CAPTION="Novi obračun"  
		CMD1CAPTION="Kreiraj" 
		CMD2CAPTION="Odustani" 
	>

		<INPUT TYPE="label" NAME="lbl0" TOP="700" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Vrsta stope"/>
		<INPUT TYPE="combo" NAME="IDstopa" TOP="600" LEFT="2200" WIDTH="5500" HEIGHT="320" CAPTION="Vrsta stope" TABINDEX="1" ALLOWEMPTY="FALSE" SQL="select kteVrsteStopaID, Opis as naziv from KteVrsteStopa"  />
		<INPUT TYPE="label" NAME="lbl1" TOP="1100" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Razdoblje"/>
		<INPUT TYPE="date" NAME="datumod" TOP="1000" LEFT="2200" CAPTION="Datum od" VALUE="" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE"/>
		<INPUT TYPE="date" NAME="datumdo" TOP="1000" LEFT="4200" CAPTION="Datum do" VALUE="" HEIGHT="320" WIDTH="1500" TABINDEX="3" CHECKBOX="FALSE"/>
		<INPUT TYPE="label" NAME="lbl2" TOP="1500" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Vrsta kredita "/>
		<INPUT TYPE="combo" NAME="vrstadokid " CAPTION="Vrsta kredita " TOP="1400" LEFT="2200" WIDTH="5500" HEIGHT="320" TABINDEX="4" ALLOWEMPTY="FALSE" SQL="spPKDajKredite"  />
		<INPUT TYPE="label" NAME="lbl3" TOP="1900" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Napomena"/>
		<INPUT TYPE="text" NAME="Napomena" CAPTION="Napomena" TOP="1800" LEFT="2200" WIDTH="5500" HEIGHT="320" TABINDEX="5" ALLOWEMPTY="True"  />
		<INPUT TYPE="Label" NAME="lbl4" TOP="2500" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Datum Kamate :"/>
		<INPUT TYPE="date" NAME="DatumFakture" CAPTION="DatumFakture" TOP="2400" LEFT="2200" WIDTH="1500" HEIGHT="320" TABINDEX="6" ALLOWEMPTY="True"  />
		<INPUT TYPE="Label" NAME="lbl5" TOP="3000" LEFT="200" WIDTH="1500" CAPTION="Partner"/>
		<INPUT TYPE="TRAZILICA" CAPTION="Osoba" NAME="pkosobeid" SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner" TOP="2900" LEFT="2200" TEXT="" TABINDEX="7" WIDTH="4500" HEIGHT="320"/>
		<INPUT TYPE="Label" NAME="lbl6" TOP="3500" LEFT="200" WIDTH="1400" HEIGHT="320" CAPTION="Vrsta obračuna:"/>
		<INPUT TYPE="Combo" NAME="VrstaObracunaid" CAPTION="VrstaObracunaid" TOP="3400" LEFT="2200" WIDTH="5500" HEIGHT="320" TABINDEX="8" ALLOWEMPTY="FALSE" SQL="select 3 as VrstaObracunaid, '3-Obračun kamata na otvorene i zatvorene stavke ' as naziv						"  /> 
 
	</NOVIOBRACUN>

	<PONISTIOBRACUN
		WIDTH="8000"
		HEIGHT="4800"
		STORA="sppkKteNG @action=5,@ID=@@ID" 
		STARTUPSTORA="sppkKteNG @action=4,@ID=@@ID" 
		CAPTION="Brisanje cijelog obračuna"
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani"
	>

		<INPUT TYPE="Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="3500" HEIGHT="320" CAPTION="Jeste li sigurni?" />

	</PONISTIOBRACUN>

	<FAKTURIRAJ
		WIDTH="8000" 
		STORA="sppkKteNG @action=9,@ID=@@ID , @operateriid = @@operateriid" 
		STARTUPSTORA="sppkKteNG @action=66,@ID=@@ID" 
		HEIGHT="4800" 
		CAPTION="Fakturiraj"  
		CMD1CAPTION="Fakturiraj" 
		CMD2CAPTION="Odustani" 
	>

	<INPUT TYPE="Label"  NAME="lbl0" TOP="700" LEFT="200" WIDTH="3500" HEIGHT="320" CAPTION="Jeste li sigurni?" />                                  

	</FAKTURIRAJ>

</PROJECT>
 