<?xml version="1.0" encoding="windows-1250" ?>


<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="" 
      CMD3CAPTION="Analitika:ANALITIKA" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="" 
      DBLCLICKFORM=""
      POPUP="">
 
  <NAME>Kontrola MP - Financijsko </NAME>
  <CAPTION>Kontrola MP - Financijsko </CAPTION>
 
  <KOMENTAR> </KOMENTAR>


<FILTERFORM 		
	
	
		WIDTH="9000" 
		STORA="spMPKontrolaKPFin @action=3, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		FILLEXPLORER="TRUE" 
		CHILDFORM=""> 
		


                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajOrgshema @operateriid=@@operateriid"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>


	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					NAME="vrstadokid" 
					CAPTION="Vrsta dokumenata " 
					WIDTH="5500" 
				HEIGHT="320" 
					TABINDEX="1" 
				ALLOWEMPTY="true" 
				SQL="select vrstadokid , opis as naziv from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where projekt = 'M') and kp = 1 order by vrstapromid"/>

	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
				NAME="kp" 
				CAPTION="Vrsta robe " 
				WIDTH="5500" 
			HEIGHT="320" 
				TABINDEX="1" 
			ALLOWEMPTY="true" 
			SQL="select 1 as id, ' Vlastita roba' as naziv union all select 2, 'Tuđa roba'"/>


</FILTERFORM>

	<ANALITIKA
						   FILLEXPLORER="" 
						   REPORT=""  
						   WIDTH="15000" 
						   STORA="" 
						   STARTUPSTORA="select * from maloprodajagla where maloprodajaglaid = @@id" 
						   HEIGHT="8800" 
						   CAPTION="Analitika po vrsti dokumenta  "  
						   BORDERSTYLE="3" 
						   CMD1CAPTION="" 
						   CMD2CAPTION="Odustani"
						   CMD3CAPTION=""	 
						  CMD4CAPTION="Obnovi"
						  CMD5CAPTION=""	 		 
						  CMD6CAPTION=""  
					
									NEXTFORM=""  >

		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION=""
				LEFT = "200"
				WIDTH="14000" 
				HEIGHT="7000" 
				TABINDEX="5" 
				SQL="spMPKontrolaKPFin @action = 4 ,@trgovinaid = @@trgovinaid, @datumod = @@datumod, @datumdo=@@datumdo, @vrstadokid = @@Id" 
                                          />


	</ANALITIKA>

	<AZUR
		  WIDTH="5500" 
		  STORA="spMPKontrolaKPFin  @action = 5,@id=@@id" 
		  STARTUPSTORA=""		
		  HEIGHT="3200" 
		  CAPTION="Ažurirati ?" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Ažuriraj"         
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  CHILDFORM="">

		<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite ažurirati dokument ?" />
	</AZUR>


</PROJECT> 