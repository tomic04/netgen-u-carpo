<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="Etikete.clsEtikete" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Detalji:DETALJI" 
		CMD4CAPTION=""
 		CMD5CAPTION="Ispravi:ISPRAVI" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Dokument"  
		DBLCLICKFORM=""
	        POPUP=""> 
 

  <NAME>Ispravak sind. kredita </NAME>
  <CAPTION>Ispravak sind. kredita</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8500" 
		STORA="spMPQueryGlaIDet @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		

            <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="trgovinaid" 
			CAPTION="Trgovina" 
			WIDTH="5500" 
			HEIGHT="320" 
            TABINDEX="1" 
            ALLOWEMPTY="true" 
            SQL="spMPDajTrgovina @operateriid = @@operateriid"/>

		  <KONTROLA TYPE="MSComCtl2.DTPicker" 
									NAME="datumod" 
										CAPTION="Datum od" 
									VALUE="DATE2" 
									HEIGHT="320" 
									WIDTH="1500" 
									TABINDEX="2" 
										CHECKBOX="FALSE"/>

		  <KONTROLA TYPE="MSComCtl2.DTPicker" 
					  NAME="datumdo" 
					  CAPTION="Datum do" 
					  VALUE="DATE" 
					  HEIGHT="320" 
					  WIDTH="1500" 
					  TABINDEX="3" 
						  CHECKBOX="FALSE"/>

		  <KONTROLA TYPE="TRAZILICA" 
			  CAPTION="Partner" 
			  NAME="partneriid" 
			  SQL="Partneri#partneriid#naziv%" 
			  TEXT=""
			  TABINDEX="4" 
			  WIDTH="5000" 
			  HEIGHT="320"/>

	  
	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
		  CAPTION="Vrsta dokumenta" 
			  NAME="vrstadokid " 
			  ALLOWEMPTY="FALSE" 
			  SQL="select vrstadokid , opis as naziv from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '106') and vrstadokid in (select vrstadokid from kntnacinplac where oznkredit = '1')" 
			  TEXT=""
			  TABINDEX="6" 
			  WIDTH="5000" 
			  HEIGHT="320"/>


  </FORM1>
	<DETALJI 	FILLEXPLORER="TRUE" 
		   WIDTH="14000" 
		   STORA="" 
		   STARTUPSTORA="" 
		   HEIGHT="7500" 
		   CAPTION="Stavke prometa" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="Odustani" 
		   CMD3CAPTION="" 
		   NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="12000" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spMPQueryGlaIDet @action=2, @id = @@ID" 
                                          />

	</DETALJI>
	<ISPRAVI
		  WIDTH="9000"
				  STORA="spMPIspraviSind @operateriid = @@operateriid, @id = @@id, "
		  STARTUPSTORA="select p.naziv as partner, rtrim(pko.prezime)+' ' +pko.ime as osoba 
						from pkosobekrediti pkok 
						inner join pkkrediti pkk on pkok.pkkreditiid = pkk.pkkreditiid 
						inner join partneri p on pkk.partneriid = p.partneriid
						inner join pkosobe pko on pkok.pkosobeid = pko.pkosobeid
						where pkok.racunid = @@id"
		  HEIGHT="5500"
		  CAPTION="Ispravak partnera na sind. otpremnici "
				  CMD1CAPTION="Ispravi"
		  CMD2CAPTION="Odustani"
		  FILLEXPLORER="" >
		<KONTROLA TYPE="MSComCtl2.DTPicker"
			NAME="datum"
			CAPTION="Datum ispravka:"
			VALUE="DATE"
			HEIGHT="320"
			WIDTH="1500"
			ENABLE="FALSE"
			CHECKBOX="FALSE" />


		<KONTROLA TYPE="TMEdit2.TextMEdit2"
			CAPTION="_Stari partner: "
			NAME="partner"
			SQL=""
			TEXT=""
			WIDTH="7500"
			ENABLE="FALSE"
			HEIGHT="320"/>
		<KONTROLA TYPE="TMEdit2.TextMEdit2"
			CAPTION="_Osoba: "
			NAME="osoba"
			SQL=""
			TEXT=""
			WIDTH="7500"
			ENABLE="FALSE"
			HEIGHT="320"/>
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Novi Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#naziv%" 
			TEXT=""
			TABINDEX="4" 
			WIDTH="5000" 
			HEIGHT="320"/>



	</ISPRAVI>




</PROJECT> 