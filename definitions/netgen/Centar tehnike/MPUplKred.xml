<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	STARTUPSTORA=":FORM1"  		
	CMD1CAPTION="Filter:FORM1" 
	CMD2CAPTION="Dodaj:DODAJFORM"    
   	CMD3CAPTION="Izmjeni:IZMJENIFORM" 
   	CMD4CAPTION="Kartica:KARTICA"
   	CMD5CAPTION=""
   	CMD6CAPTION=""
	CMD8CAPTION="Uplatnica"
	REPORT="RS:/Konikom/MPDokumenti/rptMPUplataKredita(@@id)"
	DBLCLICKFORM=""
	POPUP=""> 
 
 	<NAME>Uplate kredita - pojedinačno </NAME>
	<CAPTION>Uplate kredita - pojedinačno </CAPTION>
  
  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		STORA="spMPUplataKredita @action=111, " 
		STARTUPSTORA="" 
		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datumod" 
				CAPTION="Datum od" 
				VALUE="DATE1" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="1" 
				CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
  			NAME="datumdo" 
                        CAPTION="Datum do" 
                        VALUE="DATE2" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="2" 
                        CHECKBOX="FALSE"/>
		<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="PkOsobeId" 
					SQL="ViPKosobe#pkosobeid#Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]" 
					TEXT=""
					TABINDEX="3" 
					WIDTH="5000" 
					HEIGHT="320"/>
		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
				NAME="trgovinaid" 
				CAPTION="Za trgovinu:" 
				WIDTH="5000" 
			HEIGHT="320" 
				TABINDEX="4" 
			ALLOWEMPTY="FALSE" 
			SQL="spMPDajTrgovina @operateriid = @@operateriid " />


		<KONTROLA TYPE="CbEx3.ComboBoxEx3" NAME="statusId" 
						  HEIGHT="288" WIDTH="3440" VISIBLE="TRUE" TEXT="" SQL="select 1 as statusid, 'Uneseno' as Naziv union all select 2 , 'Proknjiženo'" ALLOWEMPTY="TRUE"  
						  CAPTION="Satus: " TABINDEX="5" ENABLED="TRUE"/>


	</FORM1>

	<DODAJFORM
		WIDTH="9000" 
                STORA="spMPUplataKredita @action=2, @operateriid = @@operateriid," 
		STARTUPSTORA="if coalesce(@@id,0) != 0 begin select u.pkosobeid as pkosobeid , rtrim(pko.prezime)+' ' +pko.ime as Osoba, 'Uplata rate' as napomena from uplateKredita u inner join pkosobe pko on u.pkosobeid = pko.pkosobeid where uplatekreditaid = @@id end 
					else begin select @@pkosobeid as pkosobeid, @@id as id, (select top 1 rtrim(prezime)+' ' +ime from pkosobe where pkosobeid= @@pkosobeid) as Osoba , 'Uplata rate' as napomena end" 
		HEIGHT="5500" 
		CAPTION="Nova uplata"  
        CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

								<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Za trgovinu:" 
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid " />




		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="2" 
			CHECKBOX="FALSE" />

		<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="PkOsobeId" 
					SQL="ViPKosobe#pkosobeid#%Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]#partner" 
					TEXT=""
					TABINDEX="3" 
					WIDTH="5000" 
					HEIGHT="320"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="pkosobekreditiid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="FALSE" 
			REFRESHAFTERCHILD="TRUE"
            SQL="spMPUplataKredita @action = 8, @uplatekreditaid = @@id, @pkosobeid = @@pkosobeid"/>
		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="Napomena" 
				CAPTION="Napomena: " 
				TEXT="" 
				WIDTH="2500" 
				HEIGHT="320" 
				TABINDEX="5" 
				ENABLED="TRUE" />

		<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="6" 
				TEXT="" 
				DECIMALS="2" 
				WIDTH="1500" 
				HEIGHT="320"/>


	</DODAJFORM>

	<IZMJENIFORM
		WIDTH="9000" 
        STORA="spMPUplataKredita @action=3,@operateriid = @@operateriid," 
		STARTUPSTORA="spMPUplataKredita @action=4,@uplatekreditaid = @@id,@operateriid = @@operateriid," 
		HEIGHT="5500" 
		CAPTION="Izmjena uplate"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >


		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                             	NAME="trgovinaid" 
                                	CAPTION="Trgovina:" 
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid " />

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                             	NAME="orgshemaid" 
                                	CAPTION="Mjesto uplate: " 
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="OrgShema#Orgshemaid#%Naziv%" />


		<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="PkOsobeId" 
					SQL="ViPKosobe#pkosobeid#Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]" 
					TEXT=""
					TABINDEX="3" 
					WIDTH="5000" 
					ENABLED="TRUE" 
					HEIGHT="320"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="pkosobekreditiid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
						ENABLE = "TRUE"
                        ALLOWEMPTY="FALSE" 
						
			REFRESHAFTERCHILD="TRUE"
            SQL="spMPUplataKredita @action = 8, @uplatekreditaid = @@id , @pkosobeid = @@pkosobeid"/>
		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="Napomena" 
				CAPTION="Napomena: " 
				TEXT="" 
				WIDTH="2500" 
				HEIGHT="320" 
				TABINDEX="5" 
				ENABLED="TRUE" />

		<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="6" 
				TEXT="" 
				DECIMALS="2" 
				WIDTH="1500" 
			ENABLE = "FALSE"
				HEIGHT="320"/>

			<KONTROLA TOP="6000" TYPE="CM6.curMEdit6" NAME="UplateKreditaid" CAPTION="UplateKreditaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />


	</IZMJENIFORM>

  <BRISIFORM
		WIDTH="9000" 
                STORA="spMPUplataKredita @action=6," 
		STARTUPSTORA="spMPUplataKredita @action=5,@uplatekreditaid = @@id" 
		HEIGHT="5500" 
		CAPTION="Brisanje uplate"  
                CMD1CAPTION="Obriši" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >
		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			ENABLE="FALSE"
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="7500" 
			ENABLE="FALSE"
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="faktureid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			ENABLE="FALSE"
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select zakljucakid as faktureid, partija as Naziv from MaloprodajaGla where partneriid=@@partneriid"/>

			<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="4" 
				TEXT="" 
				ENABLE="FALSE"
				DECIMALS="2" 
				WIDTH="1500" 
				HEIGHT="320"/>

			<KONTROLA TOP="6000" TYPE="CM6.curMEdit6" NAME="UplateKreditaid" CAPTION="UplateKreditaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
  </BRISIFORM>

  


	<KARTICA
		WIDTH="14000" 
		HEIGHT="9000" 
        STORA="" 
		STARTUPSTORA="select @@pkosobeid as pkosobeid, (select top 1 naziv from viPKosobe where pkosobeid = @@pkosobeid) as Partner" 
		CAPTION="Kartica"  
                CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		FILLEXPLORER="" >
			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="7500" TABINDEX="2" 
                         SQL="spPKKarticaKredita @action=2, @UplateKreditaid = @@id, @pkosobeid = @@pkosobeid, @partneriid = @@partneriid" /> 


		</KARTICA>


	<KNJIZENJE
	WIDTH="9000" 
			STORA="spMPUplataKredita @action=10,@operateriid = @@operateriid," 
	STARTUPSTORA="spMPUplataKredita @action=4,@uplatekreditaid = @@id,@operateriid = @@operateriid," 
	HEIGHT="4500" 
	CAPTION="Knjiženje uplate"  
			CMD1CAPTION="Proknjiži" 
	CMD2CAPTION="Odustani" 
	FILLEXPLORER="" >


		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			ENABLE="FALSE" 
			CHECKBOX="FALSE" />

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                             	NAME="trgovinaid" 
                                	CAPTION="Trgovina:" 
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="FALSE" 
									ENABLED="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid " />

		<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="PkOsobeId" 
					SQL="ViPKosobe#pkosobeid#Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]" 
					TEXT=""
					TABINDEX="3" 
					WIDTH="5000" 
					ENABLED="FALSE" 
					HEIGHT="320"/>

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					NAME="partija" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
						ENABLE = "FALSE"
                        ALLOWEMPTY="FALSE" />
						

		<KONTROLA TYPE="CMEditVB6.CurMEdit" 
			CAPTION="Uplaćeni iznos:" 
			NAME="iznos" 
			TABINDEX="5" 
			TEXT="" 
			DECIMALS="2" 
			WIDTH="1500" 
			ENABLE = "FALSE"
			HEIGHT="320"/>

		<KONTROLA TOP="6000" TYPE="CM6.curMEdit6" NAME="UplateKreditaid" CAPTION="UplateKreditaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />


	</KNJIZENJE>




</PROJECT> 