<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		 ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica MP:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="Kartica NC:KARTICANC" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		DBLCLICKFORM=""
	        POPUP=""> 
 

  <NAME>Pregled robe po trgovinama</NAME>
  <CAPTION>Pregled robe po trgovinama</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8500" 
		ONSUBMIT="spMPPregRobeTrgovinaNew @action=1, @operateriid = @@operateriid," 
		ONLOAD="select year(getdate()) as godina " 
		HEIGHT="6000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">



	  <INPUT TYPE="text" 
						  NAME="godina" 
						  CAPTION="Godina" 
						  TEXT="" 
						  WIDTH="600" 
						  HEIGHT="320" 
						  TABINDEX="1" 
						  DECIMALS="0" />			

                     	<INPUT TYPE="combo" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

			
			<INPUT TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 
					

			<INPUT TYPE="text" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					

			<INPUT TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TABINDEX="5" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<INPUT TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<INPUT TYPE="VB.checkbox" 
                                   	NAME="stanje" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži samo robe kojima je stanje različito od 0"/>

	  <INPUT TYPE="combo"
				  NAME="robnamarkaid"
				  CAPTION="Robna marka"
				  WIDTH="5500"
			  HEIGHT="320"
				  TABINDEX="2"
			  ALLOWEMPTY="true"
			  SQL="select robnamarkaid, opis as naziv from robnamarka order by opis "/>



			<INPUT TYPE="combo" 
					CAPTION="Dodatna klasa robe" 
					NAME="klrobaid" 
					SQL="select klrobaid, naziv from (
select klrobaid, klklrobaid,&apos;__&apos;+naziv as naziv,sortkey from klroba k
where k.naziv&lt;&gt;&apos;&apos;
union all
select 1000000+klklrobaid as klrobaid, klklrobaid,naziv, &apos;0&apos; as sortkey from klklroba kk
where kk.naziv&lt;&gt;&apos;&apos;
)x order by klklrobaid, sortkey"
					TABINDEX="6" 
					TEXT="" 
					ALLOWEMPTY="TRUE"
					REFRESHAFTERCHILD="TRUE"
					WIDTH="5500" 
					HEIGHT="320"/> 

			<INPUT TYPE="VB.checkbox" 
                                   	NAME="ispoddodklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="i ispod nje"/>



  </FORM1>

 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
                         SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid ,@totalgen=1, @godina = @@godina  " /> 
</KARTICA>

	<KARTICANC 	FILLEXPLORER="TRUE" 
		   WIDTH="15000" 
		   STORA="" 
		   STARTUPSTORA="" 
		   HEIGHT="9500" 
		   CAPTION="Kartica robe po nab.cijenama" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="Kraj" 
		   CMD3CAPTION="" 
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid2" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
					 SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid ,@totalgen=2 , @godina = @@godina " />
	</KARTICANC>



</PROJECT> 