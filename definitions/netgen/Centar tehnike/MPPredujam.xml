<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FORM1" 
   DETAILGRID = "spMppredujam @action=3,@fiskbroj = '@@fiskbrojid', @godina = @@godinaid"
   CMD1CAPTION="Filter:FORM1"        
   CMD2CAPTION="Dodaj:INSERT_FORM"
   CMD3CAPTION="Izmjeni:UPDATE_FORM"   
   CMD4CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   POPUPMASTER=""
   TOTALROWVISIBLE="TRUE"
   CHECKBOXVISIBLE="FALSE"
   DETCHECKBOXVISIBLE="FALSE"
   DETTOTALROWVISIBLE="FALSE"
   MASTERDBLCLICK="FORM1"
    PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   VERSION="1.7">
 
  <NAME>Pregled predujmova </NAME>
  <CAPTION>Pregled predujmova</CAPTION>
 
 

  <FORM1 
                         FILLEXPLORER="TRUE"
						WIDTH="8000" 
                         ONSUBMIT="spMppredujam @action=2, @operateriid = @@operateriid, " 
                         ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, 1 as bezdatuma" 
                         HEIGHT="4000" 
                         CAPTION="Popunte uvjete"
			 BORDERSTYLE="3"   
                         CMD1CAPTION="Pokaži" 
                         CMD2CAPTION="Odustani" >

			<INPUT TYPE="combo" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="spmpDajTrgovina @operateriid=@@operateriid" 
					TEXT=""
					TABINDEX="1" 
					ALLOWEMPTY="TRUE"
					WIDTH="4500" 
					ENABLED="TRUE"
					HEIGHT="320"/>


           <INPUT TYPE="date" 
				NAME="datumod" 
				CAPTION="Od " 
				SQL=""  
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="1" 
				CHECKBOX="FALSE" />


			<INPUT TYPE="date" 
				NAME="datumdo" 
				CAPTION="Do " 
				TABINDEX="2" 
				TEXT="" 
				DECIMALS="0" 
				HEIGHT="320"/>

			<INPUT TYPE="check" 
				NAME="bezdatuma" 
				CAPTION="Bez obzira na datum " 
				TABINDEX="2" 
				TEXT="" 
				DECIMALS="0" 
				HEIGHT="320"/>
				
			<INPUT TYPE="check" 
				NAME="saldoch" 
				CAPTION="Saldo različit od 0" 
				TABINDEX="2" 
				TEXT="" 
				DECIMALS="0" 
				HEIGHT="320"/>
	  

  </FORM1>
	<INSERT_FORM NAME="INSERTFORM" HEIGHT="5000" WIDTH="8000"
			 CAPTION="Unos novog predujma"
			 ONSUBMIT=""
			 ONLOAD=""
			 NEXTFORM=""
			 CMD1CAPTION=""
			 CMD2CAPTION=""
			 VERSION="1.1">
		
		
		<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*" TABINDEX="3" TOP="100" LEFT="1400" WIDTH="3500"  ONCLICK="select 'refresh' as mpkaseid" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="spMPDajTrgovina @operateriid=@@operateriid" />
		<INPUT TYPE="date"  NAME="datumdok"	TABINDEX="8" TOP="450" LEFT="1400" WIDTH="1500" SQL="" ALLOWEMPTY="FALSE" CAPTION="Datum*"/>
		<INPUT TYPE="number" NAME="iznos"		CAPTION="Iznos*" TABINDEX="9" TOP="800" LEFT="1400" ONLOSTFOCUS=""/>
		<INPUT TYPE="text"   NAME="napomenaracun"	CAPTION="Kupac*" TABINDEX="7" TOP="1150" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="napomenastavka"	CAPTION="Napomena*" TABINDEX="7" TOP="1500" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="fiskbroj"	CAPTION="Račun broj*" TABINDEX="7" TOP="1850" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="brojdok"	CAPTION="Po računu*" TABINDEX="7" TOP="2200" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="combo"  NAME="mpkaseid"	CAPTION="Kasa*" TABINDEX="7" TOP="2550" LEFT="1400" WIDTH="3500" ALLOWEMPTY="TRUE" ONLOSTFOCUS="" SQL="select mpkaseid,Kasa from MPKase where trgovinaid=@@trgovinaid"/>
		<INPUT TYPE="text"  NAME="godina"	CAPTION="Godina*" TABINDEX="7" TOP="2900" LEFT="1400" ONLOSTFOCUS=""/>
		
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dodaj" TABINDEX="2" TOP="3500" LEFT="1280" WIDTH="1428" HEIGHT="322"
			   ONCLICK="spMPPredujam @action=5, @trgovinaid=@@trgovinaid,@datumdok=@@datumdok,@iznos='@@iznos',@napomenaracun='@@napomenaracun',@napomenastavka='@@napomenastavka', @fiskbroj='@@fiskbroj', @brojdok='@@brojdok', @mpkaseid=@@mpkaseid,@godina='@@godina' #OK" />
		<INPUT TYPE="button" NAME="cancel" 		CAPTION="Odustani" TABINDEX="3" TOP="3500" LEFT="3280" WIDTH="1428" HEIGHT="322" ONCLICK="close"  />
	</INSERT_FORM>
	
	<UPDATE_FORM NAME="UPDATEFORM" HEIGHT="4000" WIDTH="8000"
			 CAPTION="Izmjena predujma"
			 ONSUBMIT=""
			 ONLOAD="exec spMPPredujam @action=7, @detid=@@detid"
			 NEXTFORM=""
			 CMD1CAPTION=""
			 CMD2CAPTION="">
		
		
		<INPUT TYPE="combo"  NAME="trgovinaid"  CAPTION="Trgovina*" TABINDEX="3" TOP="100" LEFT="1400" WIDTH="3500" ONCLICK="select 'refresh' as mpkaseid" ALLOWEMPTY="FALSE" ENABLED="FALSE" SQL="spMPDajTrgovina @operateriid=@@operateriid" />
		<INPUT TYPE="date"  NAME="datumdok"	TABINDEX="8" TOP="450" LEFT="1400" WIDTH="1500" SQL="" ALLOWEMPTY="FALSE" CAPTION="Datum*" ENABLED="FALSE"/>
		<INPUT TYPE="number" NAME="iznos"		CAPTION="Iznos*" TABINDEX="9" TOP="800" LEFT="1400" ONLOSTFOCUS=""/>
		<INPUT TYPE="text"   NAME="NapomenaRacun"	CAPTION="Kupac*" TABINDEX="7" TOP="1150" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="NapomenaStavka"	CAPTION="Napomena*" TABINDEX="7" TOP="1500" LEFT="1400" WIDTH="3500"/>
		<INPUT TYPE="text"   NAME="FiskBroj"	CAPTION="Račun broj*" TABINDEX="7" TOP="1850" LEFT="1400" WIDTH="3500" ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="brojdok"	CAPTION="Po računu*" TABINDEX="7" TOP="2200" LEFT="1400" WIDTH="3500" ENABLED="FALSE"/>
		<INPUT TYPE="text"   NAME="Kasa"	CAPTION="Kasa*" TABINDEX="7" TOP="2550" LEFT="1400" WIDTH="3500" ENABLED="FALSE" ALLOWEMPTY="TRUE" ONLOSTFOCUS="" SQL="select mpkaseid,Kasa from MPKase where trgovinaid=@@trgovinaid"/>
		
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Spremi" TABINDEX="2" TOP="3000" LEFT="1280" WIDTH="1428" HEIGHT="322"
			   ONCLICK="spMPPredujam @action=6, @id=@@id, @iznos='@@iznos',@NapomenaRacun='@@NapomenaRacun',@NapomenaStavka='@@NapomenaStavka', @fiskbroj='@@fiskbroj', @kasa='@@kasa', @trgovinaid=@@trgovinaid , @godina='@@godina' , @datumdok=@@datumdok, @brojdok='@@brojdok' #OK" />
		<INPUT TYPE="button" NAME="cancel" 		CAPTION="Odustani" TABINDEX="3" TOP="3000" LEFT="3280" WIDTH="1428" HEIGHT="322" ONCLICK="close"  />
	</UPDATE_FORM>

 

</PROJECT>
 
