<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<PROJECT
   BUTTONS=""
	 POPUPMASTER=""
	 MASTERDBLCLICK=""
	 GROUPBYBOXVISIBLE="TRUE"
   DETAILGRID="spMPKasaPolog @action=1, @trgovinaid = @@id"
	 ONLOAD=""
       FROZENCOLUMNS="0"
	 COMMANDTIMEOUT="300"
	 CHECKBOXVISIBLE="FALSE">

  <NAME>MP kasa polog</NAME>
  <CAPTION>MP kasa polog</CAPTION>

  <MAINFORM
      NAME="MAINFORM"
      HEIGHT="9000"
      WIDTH="15500"
      CAPTION="MP kasa polog"
      ONLOAD=""
      MAXIMIZEBOX="FALSE"
      WINDOWSTATE="2"
      FILLEXPLORER=""
      REFRESHAFTERCHILD="">

    <INPUT TYPE="grid"
          NAME="gridKasa"
          REFRESHAFTERCHILD="TRUE"
          CAPTION="Kase"
          SKIPDEFAULTLOAD2="TRUE"
          TOP="100" LEFT="100" WIDTH="8800" HEIGHT="2500"
          POPUP=""
          ONDBLCLICK=""
          EDITCOLUMNS=""
          ONCELLEDITED=""
          CHECKBOXVISIBLE="FALSE"
          PAGEHEADERCENTER=""
          PAGEHEADERRIGHT=""
          PAGEHEADERLEFT=""
          PAGEFOOTERCENTER=""
          PAGEFOOTERLEFT=""
          ONCLICK=""
          PAGEFOOTERRIGHT="@@thosmomi"
          PAGEORIENTATION="LANDSCAPE"
          GROUPBYBOXVISIBLE="FALSE"
          SQL="spMPKasaPolog @action = 1, @operateriid=@@operateriid, @trgovinaid = @@gridmasterTrgovinaId"
          DOCK="5"
           />
    
    <INPUT TYPE="grid"
           NAME="master"
			     REFRESHAFTERCHILD=""
			     CAPTION=""
			     TOP="150" LEFT="100" HEIGHT="4400" WIDTH="14500"
			     TABINDEX="-1"
			     AFTERREFRESH=""
			     POPUP=""
			     ONDBLCLICK=""
				   ONCLICK="select 'refresh' as gridKasa "
			     EDITCOLUMNS=""
           ONCELLEDITED=""
			     DETCHECKBOXVISIBLE="FALSE"
			     PAGEHEADERCENTER=""
			     PAGEHEADERRIGHT=""
			     PAGEHEADERLEFT=""
			     PAGEFOOTERCENTER=""
			     PAGEFOOTERLEFT=""
			     PAGEFOOTERRIGHT="@@thosmomi"
			     PAGEORIENTATION="LANDSCAPE"
			     GROUPBYBOXVISIBLE="FALSE"
				    CHECKBOXVISIBLE="FALSE"
           TOTALROW="TRUE"
			      SQL="spMPKasaPolog @action = 0 "
           DOCK="1" 
           />

    
    


    

    <INPUT TYPE="group" NAME="groupButtons" TOP="6400" LEFT="8500" HEIGHT="1200" WIDTH="3800" VISIBLE="TRUE" ENABLED="TRUE"  DOCK="2" />
    <INPUT TYPE="button" NAME="kasa" TOP="300" LEFT="200" HEIGHT="700" WIDTH="1400" CAPTION="Polog" ONCLICK=":POLOGUNOS_FORM"  PARENT="groupButtons"/>

  </MAINFORM >


<!-- 
  <POLOGFORM
      NAME="POLOGFORM"
      HEIGHT="2600"
      WIDTH="3850"
      CAPTION="Polog"
      ONSUBMIT=""
		  ONLOAD=""
      ONLOADED=""
      MAXIMIZEBOX="FALSE"
      WINDOWSTATE="3"
      FILLEXPLORER=""
      REFRESHAFTERCHILD="TRUE">

    <INPUT TYPE="frame"  NAME="fr2"           CAPTION="" TOP="50" LEFT="100" WIDTH="3400" HEIGHT="1300" />
    <INPUT TYPE="button" NAME="unosPOLOG" TOP="300" LEFT="200" HEIGHT="400" WIDTH="1400" CAPTION="Ažuriranje" ONCLICK=":POLOGUNOS_FORM" />

    <INPUT TYPE="button" NAME="cancel" TOP="1500" LEFT="2000" HEIGHT="400" WIDTH="1400" STYLE="1" CAPTION="Zatvori" ONCLICK="close" />
  </POLOGFORM >
-->


  <POLOGUNOS_FORM
	    NAME="POLOGUNOS_FORM" HEIGHT="3800" WIDTH="6603"
	    CAPTION="Ažuriranje pologa u kasi"
	    BORDERSTYLE="3"
	    ONSUBMIT=""
	    ONLOAD="select opis as trgovina from trgovina where trgovinaid = @@gridmasterTrgovinaId "
      ONLOADED="select mpkaseid, kasa as kasa from mpkase where mpkaseid = @@gridgridKasampkaseid#select @@gridgridKasaIznos_pologa as duguje "
	    CANCELONSUBMIT=""
	    FILLEXPLORER=""
	    NEXTFORM=""
	    FOCUS="duguje"
	    CMD1CAPTION=""
	    CMD2CAPTION="">

    <INPUT TYPE="frame"  NAME="fr2"           CAPTION="" TOP="30" LEFT="100" WIDTH="6000" HEIGHT="2500"   />
    <INPUT TYPE="text" NAME="trgovina" HEIGHT="302" WIDTH="4000" VISIBLE="TRUE" SQL="" ALLOWEMPTY="FALSE" CAPTION="Trgovina" ENABLED="FALSE"/>
    <INPUT TYPE="text" NAME="kasa" HEIGHT="302" WIDTH="1400" VISIBLE="TRUE" SQL="" ALLOWEMPTY="FALSE" CAPTION="Kasa" ENABLED="FALSE"/>
    <INPUT TYPE="number" NAME="mpkaseid" HEIGHT="302" WIDTH="1400"  SQL="" ALLOWEMPTY="FALSE" CAPTION="" ENABLED="FALSE" VISIBLE="FALSE"/>
    <INPUT TYPE="number"   NAME="duguje"       CAPTION="_Iznos pologa*"    TOP="1000" LEFT="" WIDTH="" DECIMALS="2" ENABLED="TRUE" SQL=""/>

    <INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="2700" LEFT="500" WIDTH="1000" CAPTION="Spremi"
        ONCLICK="spMPKasaPolog @action = 2, @id = @@gridgridKasampkasapologid, @duguje = @@duguje , @mpkaseid = @@mpkaseid#OK "  />
    <INPUT TYPE="button" NAME="cancel" TOP="2700" LEFT="1700" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />

  </POLOGUNOS_FORM>



</PROJECT>
