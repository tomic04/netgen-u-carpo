						CAPTION="Vrsta kredita " TABINDEX="4" ENABLED="TRUE"/>


					  <KONTROLA TYPE="CbEx3.ComboBoxEx3" NAME="statusid" 
					HEIGHT="288" WIDTH="3440" VISIBLE="TRUE" TEXT="" SQL="select 3 as statusid, 'Zaključeno' as Naziv union all select 2, 'Uneseno' " ALLOWEMPTY="TRUE"  
					CAPTION="Status: " TABINDEX="5" ENABLED="TRUE"/>







  </FORM1>
	
	
	<RATE 	FILLEXPLORER="TRUE" 
		WIDTH="6500" 
