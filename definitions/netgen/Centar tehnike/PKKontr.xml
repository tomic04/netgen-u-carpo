		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">


	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" NAME="trgovinaid" 
						HEIGHT="288" WIDTH="3440" VISIBLE="TRUE" TEXT="" SQL="spMPDajTrgovina @operateriid = @@operateriid" ALLOWEMPTY="TRUE"  
						CAPTION="Trgovina: " TABINDEX="1" ENABLED="TRUE"/>

	  <KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumod" CAPTION="Datum od :" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE" />

