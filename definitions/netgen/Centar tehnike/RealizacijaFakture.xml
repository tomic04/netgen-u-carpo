@datumdo=&apos;@@fdatumdo&apos;,
@klpartneriid=@@fklpartneriid,
@partneriid=@@fpartneriid,
@parstruid=@@fparstruid,
@osobeid=@@fosobeid,
@orgshemaid=@@forgshemaid,
@robaid=@@frobaid,
@klmasterrobaid=@@fklmasterrobaid,
@naziv=&apos;@@fnaziv&apos;,
@robnamarkaid=@@frobnamarkaid,
@jmid=@@fjmid,
@nezakljuceni=@@fnezakljuceni,
@rekappocemu=@@frekappocemu,
@ispod_klase_robe=@@fispod_klase_robe,
@ispod_orgsheme=@@fispod_orgsheme,
@ispod_klase_partnera=@@fispod_klase_partnera,
@vrstadokid=@@fvrstadokid,@KlParstruId=@@fklparstruid,@ispod_klase_parstru=@@fispod_klase_parstru,@klrobaid=@@fklrobaid,@ispoddodklase=@@fispod_dod_klase_robe, @klpartneri_sve=@@fklpartneri_sve, @klparstru_sve=@@fklparstru_sve, @dodklasa_sve=@@fdodklasa_sve, @psosobeid=@@fpsosobeid, @jm_sve=@@fjm_sve!!" ONLOAD="select &apos;@@fdatumod&apos; as fdatumod,

&apos;@@fdatumod&apos; as datumod, &apos;@@fdatumdo&apos; as datumdo, fdatumdo=&apos;@@fdatumdo&apos;,



fklpartneriid=@@fklpartneriid,

(select partneriid as fpartneriid from partneri where partneriid=@@fpartneriid) as fpartneriid,

(select parstruid as fparstruid from parstru where parstruid=@@fparstruid) as fparstruid,

(select naziv from partneri where partneriid=@@fpartneriid) as partner,
(select naziv from parstru where parstruid=@@fparstruid) as lokacija,
fosobeid=@@fosobeid,

forgshemaid=@@forgshemaid,

(select robaid as frobaid from roba where robaid=@@frobaid) as frobaid,

(select cast(userid as varchar) + &apos; &apos; + naziv from roba where robaid=@@frobaid) as uvjet,

fklmasterrobaid=@@fklmasterrobaid,

fnaziv=&apos;@@fnaziv&apos;,

frobnamarkaid=@@frobnamarkaid,

fjmid=@@fjmid,

fnezakljuceni=@@fnezakljuceni,

frekappocemu=@@frekappocemu,

fispod_klase_robe=@@fispod_klase_robe,

fispod_orgsheme=@@fispod_orgsheme,

fispod_klase_partnera=@@fispod_klase_partnera,

fvrstadokid=@@fvrstadokid, fklparstruid=@@fklparstruid, fispod_klase_parstru=@@fispod_klase_parstru,fispod_dod_klase_robe=@@fispod_dod_klase_robe,fklrobaid=@@fklrobaid, fklpartneri_sve=@@fklpartneri_sve, fklparstru_sve=@@fklparstru_sve, fdodklasa_sve=@@fdodklasa_sve, fpsosobeid=@@fpsosobeid,
fjm_sve=@@fjm_sve" FILLEXPLORER="true" ONLOAD2="select coalesce(@@fdatumod, (cast(YEAR(getdate()) as varchar) +&apos;0101&apos;)) as fdatumod, coalesce(@@fdatumod, (cast(YEAR(getdate()) as varchar) +&apos;0101&apos;)) as datumod" ICON="FilterSearch.ico" DBCLIPBOARD="true" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="frame" NAME="FrameNG0" TOP="72" LEFT="144" HEIGHT="6192" WIDTH="6955" TEXT="FrameNG0"/>
	<INPUT TYPE="frame" NAME="FrameNG73" TOP="6336" LEFT="144" HEIGHT="922" WIDTH="6955" TEXT="FrameNG73"/>
	<INPUT TYPE="label" NAME="LabelOdDatuma" TOP="432" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Od datuma:" TEXT="Label20"/>
	<INPUT TYPE="date" NAME="fdatumdo" TOP="432" LEFT="5040" HEIGHT="302" WIDTH="1872" TABINDEX="20" ONVALUECHANGED="select convert(datetime, &apos;@@fdatumdo&apos;) as datumdo"/>
	<INPUT TYPE="date" NAME="fdatumod" TOP="432" LEFT="1728" HEIGHT="302" WIDTH="1872" TABINDEX="10" ONVALUECHANGED="select convert(datetime, &apos;@@fdatumod&apos;) as datumod"/>
	<INPUT TYPE="label" NAME="LabelDoDatuma" TOP="432" LEFT="4090" HEIGHT="288" WIDTH="936" CAPTION="Do datuma:" TEXT="Label22"/>
	<INPUT TYPE="label" NAME="LabelKlPartnera" TOP="792" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Klasa partnera:" TEXT="Label54"/>
	<INPUT TYPE="check" NAME="fispod_klase_partnera" TOP="792" LEFT="4939" HEIGHT="288" WIDTH="835" CAPTION="i ispod" TABINDEX="50" TEXT="CheckBoxTG10"/>
	<INPUT TYPE="check" NAME="fklpartneri_sve" TOP="792" LEFT="5832" HEIGHT="288" WIDTH="1094" CAPTION="prikaži sve" TABINDEX="52" TEXT="CheckBoxTG6"/>
	<INPUT TYPE="combo" NAME="fklpartneriid" TOP="792" LEFT="1728" HEIGHT="302" WIDTH="3096" SQL="select KlPartneriID, naziv from KlPartneri order by SortKey" ALLOWEMPTY="true" TABINDEX="40"/>
	<INPUT TYPE="check" NAME="fklparstru_sve" TOP="1152" LEFT="5832" HEIGHT="288" WIDTH="1094" CAPTION="prikaži sve" TABINDEX="56" TEXT="CheckBoxTG7"/>
