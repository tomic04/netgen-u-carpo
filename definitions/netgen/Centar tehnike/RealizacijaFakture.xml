	<INPUT TYPE="combo" NAME="fklparstruid" TOP="1152" LEFT="1728" HEIGHT="302" WIDTH="3096" SQL="select KlPartneriID, Naziv
			from KlPartneri
			order by SortKey" ALLOWEMPTY="true" TABINDEX="53"/>
	<INPUT TYPE="label" NAME="LabelKlLokacije" TOP="1152" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Klasa lokacija:" TEXT="Label29"/>
	<INPUT TYPE="search" NAME="fpartneriid" TOP="1512" LEFT="1728" HEIGHT="302" WIDTH="5184" SQL="spTraziPartneri @action=&apos;Partneri&apos;, @uvjet=&apos;@@searchboxfpartneriid&apos;" CAPTION="Partner" TABINDEX="60"/>
	<INPUT TYPE="label" NAME="LabelPartner" TOP="1512" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Partner:" TEXT="Label19"/>
	<INPUT TYPE="search" NAME="fparstruid" TOP="1872" LEFT="1728" HEIGHT="302" WIDTH="5184" SQL="spTraziParstru @action=&apos;Parstru&apos;, @Uvjet=&apos;@@searchboxfparstruid&apos;, @partneriid=@@fpartneriid" CAPTION="Lokacija" TABINDEX="70" ONLOSTFOCUS="select ps.partneriid as fpartneriid, p.naziv as partner 
from parstru ps inner join partneri p on ps.partneriid=p.partneriid 
where parstruid=@@fparstruid"/>
	<INPUT TYPE="label" NAME="LabelLokacija" TOP="1872" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Lokacija:" TEXT="Label55"/>
	<INPUT TYPE="combo" NAME="fosobeid" TOP="2232" LEFT="1728" HEIGHT="302" WIDTH="5184" SQL="sposobequery @action=16" ALLOWEMPTY="true" TABINDEX="80"/>
	<INPUT TYPE="label" NAME="LabelKomercijalist" TOP="2232" LEFT="288" HEIGHT="288" WIDTH="1368" CAPTION="Komercijalist:" TEXT="Label56"/>
	<INPUT TYPE="combo" NAME="fpsosobeid" TOP="2592" LEFT="1728" HEIGHT="302" WIDTH="5184" SQL="select distinct l.OsobeId, rtrim(o.Ime) + &apos; &apos; + RTRIM(o.prezime) as KomercijalistLokacije  
from parstru l 
inner join osobe o on l.osobeid = o.osobeid 
where l.osobeid is not null
