<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		 DETAILGRID = "spMPMinMaxKonikom @action=7,@id = @@id, @trgovinaid = @@trgovinaid"
		REPORT="" 	
		INCLUDE="" 
		CMD1CAPTION="Filter:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Katica:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION=""  
		MASTERDBLCLICK="FORMEDIT"
	        POPUPMASTER=""> 
 
  <NAME>Što naručiti - min i max zalihe </NAME>
  <CAPTION>Što naručiti - min i max zalihe </CAPTION>

  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		ONSUBMIT="spMPMinMaxKonikom @action=61,@operateriid = @@operateriid, " 
		ONLOAD="" 
		HEIGHT="2500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
			<INPUT TYPE="combo" 
					CAPTION="Trgovina:" 
					NAME="trgovinaid" 
					SQL="spmpDajTrgovina @operateriid = @@operateriid " 
					TEXT=""
					TABINDEX="4" 
					ALLOWEMPTY="TRUE"
					WIDTH="5500" 
					ENABLED="TRUE"
					HEIGHT="320"/>
		<INPUT TYPE="TRAZILICA"
				CAPTION="Klasa"
				NAME="klasaid"
				SQL="ViKlaseRobe#klmasterrobaid#Naziv%"
				TABINDEX="3"
				TEXT=""
				WIDTH="5500"
				HEIGHT="320"/>

		<INPUT TYPE="VB.checkbox"
						NAME="podklase"
						WIDTH="3500"
						HEIGHT="320"
						CAPTION="pokaži i sve podklase"/>

		<INPUT TYPE="search" 
			NAME="robaid" 
			CAPTION="Roba"  		
			TABINDEX="3" 
			WIDTH="5500" 
			HEIGHT="320"
			SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" /> 
					
		<INPUT TYPE="text" 
			NAME="search" 
			CAPTION="Traženje pojma"  
			TABINDEX="4"
			WIDTH="5500" 
			HEIGHT="320"/>

	</FORM1>

  
	<KARTICA1 	FILLEXPLORER="TRUE"
		   WIDTH="15000"
		   ONSUBMIT=""
		   ONLOAD="SELECT YEAR(GETDATE()) as godina  "
		   HEIGHT="9500"
		   CAPTION="Krtica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Kraj"
		   CMD3CAPTION=""
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2"
					 SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@robaid, @operateriid = @@operateriid ,@totalgen=1, @godina = @@godina, @trgovinaid = @@trgovinaid " />
	</KARTICA1>
	<KARTICA 	FILLEXPLORER="TRUE"
		   WIDTH="18500"
		   ONSUBMIT=""
		   ONLOAD=""
		   HEIGHT="9500"
		   CAPTION="Kartica robe"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION=""
		   CMD3CAPTION=""
		   CMD4CAPTION=""
		   CMD5CAPTION=""
		   CMD6CAPTION=""
		
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="gridkartica" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="18000" HEIGHT="8000" TABINDEX="2" CHECKBOXVISIBLE="FALSE"
	 TOTALROW="FALSE" GROUPBYBOXVISIBLE="FALSE"
					 SQL="spMaloprodajaStanjeKartica @action = 1, @robaid = @@robaid, @prikaz= 0, @trgovinaid = @@trgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @totalgen= 1,@operateriid = @@operateriid " />

		<INPUT TYPE="button" NAME="cancel" TABINDEX="16" CAPTION="Kraj" TOP="8500" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

	</KARTICA>



</PROJECT> 