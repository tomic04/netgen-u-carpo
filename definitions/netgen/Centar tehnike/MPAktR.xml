					HEIGHT="320" 
					TABINDEX="2" 
					REFRESHAFTERCHILD = "TRUE"
                   	SQL="select coalesce(dbo.fnMPZadnjaNC(@@robaid, @@trgovinaid, getdate()),0)" 
					DECIMALS="2" />

			<KONTROLA TYPE="CM6.curMEdit6" 
					NAME="MPCijena" 
					CAPTION="MP cijena" 
					ENABLED="TRUE"
					TEXT="" 
					WIDTH="1000" 
					HEIGHT="320" 
					TABINDEX="3" 
					DECIMALS="2" 
					REFRESHAFTERCHILD = "TRUE"
                   	SQL="select coalesce(dbo.fnMPDajMPC(@@robaid,@@trgovinaid, getdate()),0)" 
/>


  </DODAJ>


