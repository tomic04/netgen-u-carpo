		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid=@@operateriid"/>

		
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
                   	ALLOWEMPTY="FALSE" 
					SQL="roba#robaid#Naziv%#robakod%" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

										
										
										
  </FORM1>

  <DODAJ 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="10000" 
                         STORA="spMPAktRobe @action=2, @operateriid = @@operateriid,@trgovinaid = @@trgovinaid, " 
                         STARTUPSTORA="" 
                         HEIGHT="3800" 
                         CAPTION="Aktiviranje robe"  
						DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="KRAJ"
			                      NEXTFORM=""  >



			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%" 
					TABINDEX="1" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 
					
			<KONTROLA TYPE="CM6.curMEdit6" 
					NAME="nabcijena" 
					CAPTION="Nab.cijena" 
					ENABLED="TRUE"
					TEXT="" 
