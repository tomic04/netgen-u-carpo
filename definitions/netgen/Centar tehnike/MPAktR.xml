  <NAME>Aktivacija robe </NAME>
  <CAPTION>Aktivacija robe na PS </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPAktRobe @action=1, @operateriid = @@operateriid, " 
