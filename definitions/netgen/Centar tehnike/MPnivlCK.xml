<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA="spMPnivelacijaTotalGen @action=3, @operateriid = @@operateriid" 
   CMD1CAPTION="Dodaj:DODAJFORM"    
   CMD2CAPTION="Obriši:DELETEFORM" 
   CMD3CAPTION="Izmjeni:UPDATEFORM"
   CMD4CAPTION="Proknjiži:PROKNJIZIFORM"
   CMD5CAPTION=""
   POPUP=""
   DBLCLICKFORM="">
 
  <NAME>Izmjena MP cijena u cjeniku u % </NAME>
  <CAPTION>Izmjena MP cijena u cjeniku u % </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR>KK 12.06.2007  </AUTOR>

  <DODAJFORM 
                         WIDTH="11000" 
                         STORA="" 
                         STARTUPSTORA="select getdate()+1 as datumdok, null as robaid, null as search, null as klasaid, null as podklase, 0 as postotak" 
                         HEIGHT="4500" 
                         CAPTION="Nova nivelacija - odabir robe"  
                         CMD1CAPTION="ODABERI" 
                         CMD2CAPTION="ODUSTANI" 
						CMD4CAPTION="" 
						CMD5CAPTION="" 
						NEXTFORM = 'DODAJFORM2'
						FILLEXPLORER="" >
							

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="vrcjenikid" 
            CAPTION="Vrsta cjenika" 
            WIDTH="3500" 
            HEIGHT="320" 
            TABINDEX="1" 
            ALLOWEMPTY="FALSE" 
            SQL="select distinct t.vrcjenikid , v.opis as naziv from trgovina t inner join vrcjenik v on t.vrcjenikid = v.vrcjenikid"/>
            
			<KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE" />
			<KONTROLA TYPE="CM6.curMEdit6" NAME="postotak" CAPTION="% promjene" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
  	        <KONTROLA TYPE="TRAZILICA" CAPTION="Roba:" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userid#Robakod" TABINDEX="3"  WIDTH="4500" HEIGHT="320" />        
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					
					
					
					
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#%Naziv%" 
					TABINDEX="5" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>

								 
  </DODAJFORM>

  <DODAJFORM2
                         WIDTH="14000" 
                         STORA="spMPnivelacijaTotalGen @action=8,@operateriid = @@operateriid," 
                         STARTUPSTORA="select @@datumdok as datumdok, @@robaid as robaid, '@@postotak' as postotak, '@@search' as search, @@klasaid as klasaid, @@podklase as podklase, @@vrcjenikid as vrcjenikid" 
                         HEIGHT="9500" 
                         CAPTION="Nova nivelacija"  
                         CMD1CAPTION="ODABERI" 
                         CMD2CAPTION="ODUSTANI" 
						CMD4CAPTION="Osvježi:DODAJFORM2" 
						CMD5CAPTION="" 
						FILLEXPLORER="" >

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrcjenikid" 
                                    	CAPTION="Vrsta cjenika" 
                                    	WIDTH="3500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select distinct t.vrcjenikid , v.opis as naziv from trgovina t inner join vrcjenik v on t.vrcjenikid = v.vrcjenikid"/>
            <KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<KONTROLA TYPE="CM6.curMEdit6" NAME="postotak" CAPTION="% promjene" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="1" DECIMALS="2" />
  	        <KONTROLA TYPE="TRAZILICA" CAPTION="Roba:" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userid#Robakod" TABINDEX="0"  WIDTH="4500" HEIGHT="320" />        
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					
					
					
					
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" CAPTION="Odabrana roba" WIDTH="10500" HEIGHT="5000" TABINDEX="2" 
                         SQL="spMPnivelacijaTotalGen @action=7,@operateriid = @@operateriid,@robaid = @@robaid, @postotak = @@postotak, @search= '@@search', @klasaid = @@klasaid, @podklase = @@podklase, @vrcjenikid = @@vrcjenikid"  /> 

								 
  </DODAJFORM2>
  


  <UPDATEFORM 
                         WIDTH="11000" 
                         STORA="spMPnivelacijaTotalGen @action=9,@TempPromMPCid=@@id , @operateriid = @@operateriid, " 
                         STARTUPSTORA="select [Roba]=(select naziv from roba where robaid=TempPromMPC.robaid), staracijena, novacijena, postotak from TempPromMPC where TempPromMPCId=@@id" 
                         HEIGHT="5500" 
                         CAPTION="Izmjena nivelacije artikla"  
                         CMD1CAPTION="Spremi" 
                         CMD2CAPTION="Odustani" 
						CMD4CAPTION="" 
						CMD5CAPTION="" 
						FILLEXPLORER="" >

			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Roba" 
					NAME="Roba" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>
						<KONTROLA TYPE="CM6.curMEdit6" NAME="postotak"  CAPTION="% promjene" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
						<KONTROLA TYPE="CM6.curMEdit6" NAME="staracijena" CAPTION="Stara cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
						<KONTROLA TYPE="CM6.curMEdit6" NAME="novacijena" CAPTION="Nova cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />

								 
  </UPDATEFORM>

	<DELETEFORM
		  WIDTH="5500" 
		  STORA="spMPnivelacijaTotalGen @action = 11 , @TempPromMPCid=@@id, " 
		  STARTUPSTORA="select 1 as jedanart, 0 as sviart, (select rtrim(cast(userid as varchar)) + ' ' +naziv as Naziv from roba where robaid = (select robaid from TempPromMPC where TempPromMPCid=@@id)) as pitanje"	
		  HEIGHT="3000" 
		  CAPTION="Obrisati ?" 
		  CMD1CAPTION="Obriši"
		  CMD2CAPTION="Odustani" 
		  FILLEXPLORER="">

		<KONTROLA TYPE="VB.Label" NAME="pitanje" TOP="200" LEFT="200" WIDTH="3500" CAPTION=""/>

		<KONTROLA TYPE="VB.checkbox" 
						TOP = "700"
						LEFT="200"
						NAME="jedanart" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Obrisati odabrani artikal ? (DA/NE) "/>

		<KONTROLA TYPE="VB.checkbox" 
						TOP = "1300"
						LEFT="200"
						NAME="sviart" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Obrisati sve artikle ? (DA/NE) "/>

	</DELETEFORM>




	<DELETEFORMX
		WIDTH="5500" 
		STORA="delete from TempPromMPC where TempPromMPCid=@@id" 
		STARTUPSTORA=""	
		HEIGHT="2500" 
		CAPTION="Obrisati ?" 
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati odabrani red ? " />
	
  </DELETEFORMX> 


  <PROKNJIZIFORM
		WIDTH="5500" 
		STORA="spMPnivelacijaTotalGen @action=4,@operateriid=@@operateriid" 
		STARTUPSTORA=""	
		HEIGHT="2500" 
		CAPTION="Proknjižiti ?" 
		CMD1CAPTION="Proknjiži"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite proknjižiti nivelaciju ? " />
	
  </PROKNJIZIFORM> 
  

  <IZMJENIFORM
		WIDTH="5500" 
		STORA="spMPnivelacijaTotalGen @action=1, " 
		STARTUPSTORA="if left('@@grid1',1) = 'T' begin select substring('@@grid1',2,10) as TempPromMPCid,vrcjenikid as cjenikid,@@datumdok as datumdok,@@robaid as robaid,novacijena as cijena from TempPromMPC where robaid=@@robaid and TempPromMPCid=substring('@@grid1',2,10) end else begin select substring('@@grid1',2,10) as vrcjenikid,@@datumdok as datumdok,@@robaid as robaid,mpcijena as  cijena from cjenik where robaid=@@robaid and vrcjenikid=(select vrcjenikid from cjenik where cjenikid=substring('@@grid1',2,10)) end "
		HEIGHT="2500" 
		CAPTION="Izmjeni cijenu" 
		CMD1CAPTION="Spremi"         
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 

			<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />

			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<KONTROLA TOP="5000" TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="TempPromMPCid" CAPTION="TempPromMPCid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="vrcjenikid" CAPTION="vrcjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />

  </IZMJENIFORM> 


  <DODAJROBUUCJENIKFORM
		WIDTH="6500" 
		STORA="spMPnivelacijaTotalGen @action=0,@operateriid=@@operateriid," 
		STARTUPSTORA="select @@datumdok as datumdok,@@robaid as robaid"		
		HEIGHT="2500" 
		CAPTION="Dodaj robu u cijenik" 
		CMD1CAPTION="Spremi"         
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrcjenikid" 
                                    	CAPTION="Vrsta cjenika" 
                                    	WIDTH="3500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select distinct t.vrcjenikid , v.opis as naziv from trgovina t inner join vrcjenik v on t.vrcjenikid = v.vrcjenikid"/>

			<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="MP Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="1" DECIMALS="2" />
			<KONTROLA TYPE="CM6.curMEdit6" NAME="nabcijena" CAPTION="Nabavna cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />

			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="cjenikid" CAPTION="cjenikid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
			<KONTROLA TOP="5000" TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
			<KONTROLA TOP="5000" TYPE="CM6.curMEdit6" NAME="robaid" CAPTION="robaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />

  </DODAJROBUUCJENIKFORM> 


  <DAJCJENIK
  
                         WIDTH="14000" 
                         STORA="" 
                         STARTUPSTORA="select @@vrcjenikid as vrcjenikid, @@robaid as robaid, roba=(select naziv from roba where robaid=@@robaid)" 
                         HEIGHT="6500" 
                         CAPTION="CJENIK"  
                         CMD2CAPTION="Gotovo" 
                         CMD3CAPTION="Pokaži:DAJCJENIK" 
						CMD4CAPTION="" 
						FILLEXPLORER="" >

						
                       	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrcjenikid" 
                                    	CAPTION="Vrsta cjenika" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select distinct t.vrcjenikid , v.opis as naziv from trgovina t inner join vrcjenik v on t.vrcjenikid = v.vrcjenikid"/>
                       
	  	        <KONTROLA TYPE="TRAZILICA" CAPTION="Roba" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userid#Robakod" TABINDEX="0"  WIDTH="4500" HEIGHT="320" />        

			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" CAPTION="Cijene po cijenicima" WIDTH="10500" HEIGHT="4000" TABINDEX="2" 
                         SQL="spMPnivelacijaTotalGen @action=6,@robaid=@@robaid, @vrcjenikid = @@vrcjenikid, @operateriid = @@operateriid"  /> 

								 
  </DAJCJENIK>
  
  

</PROJECT>
 
