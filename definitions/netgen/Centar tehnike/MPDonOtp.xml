<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Stavke:STAVKE" 
		CMD4CAPTION="Otpremnice:DONESI"
 		CMD5CAPTION="Doneseno:DONESENO" 
		CMD6CAPTION=""  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Donos Otpremnica na zamjenu šifri</NAME>
  <CAPTION>Donos Otpremnica na zamjenu šifri</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPOtpremniceZamjena @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

			


                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="5" 
                                    	CHECKBOX="FALSE"/>
										

										

  </FORM1>
	<STAVKE 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="7500" 
		CAPTION="Stavke dokumenta" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		NEXTFORM=""> 
		
		

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="14300" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spMPDokDetalji @action=1,@id = @@id" 
                                          /> 

</STAVKE>

	<DONESI  
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         STORA="" 
                         STARTUPSTORA="" 
                         HEIGHT="8800" 
                         CAPTION="Odabir otpremnica"  
						DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="POKAŽI" 
                                  CMD2CAPTION="KRAJ"
			
                                  NEXTFORM="DONESI2"  >

		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#naziv%" 
			TEXT=""
			TABINDEX="4" 
			WIDTH="5000" 
			HEIGHT="320"/>



  </DONESI>
	<DONESI2
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         STORA="spMPOtpremniceZamjena @action=3, @operateriid = @@operateriid,@id = @@otpremnice, @maloprodajaglaid = @@id ," 
                         STARTUPSTORA="select @@partneriid as partneriid" 
                         HEIGHT="8800" 
                         CAPTION="Odabir otpremnica"  
						DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="DONESI" 
                                  CMD2CAPTION="KRAJ"
                                  CMD3CAPTION="STAVKE:STAVKE2"
			
                                  NEXTFORM=""  >

		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#naziv%" 
			TEXT=""
			TABINDEX="4" 
			WIDTH="5000" 
			HEIGHT="320"/>


		<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="Otpremnice" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="ay" 
					TOP="1000" 
					LEFT="200"  
					WIDTH="14500" 
					HEIGHT="6700" 
					TABINDEX="5" 
                      SQL="spMPOtpremniceZamjena @action=2,@partneriid  = @@partneriid, @datumod = @@datumod, @datumdo = @@datumdo" 
                                          />



	</DONESI2>

	<STAVKE2
		FILLEXPLORER="TRUE" 
	WIDTH="15000" 
	STORA="" 
	STARTUPSTORA="" 
	HEIGHT="7500" 
	CAPTION="Stavke dokumenta" 
	BORDERSTYLE="3" 
	CMD1CAPTION="" 
	CMD2CAPTION="Odustani" 
	CMD3CAPTION="" 
	NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="14300" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spMPDokDetalji @action=1,@id = @@otpremnice" 
                                          />

	</STAVKE2>

	<DONESENO
				FILLEXPLORER="TRUE" 
			WIDTH="15000" 
			STORA="" 
			STARTUPSTORA="" 
			HEIGHT="7500" 
			CAPTION="Donesene stavke na dokument " 
			BORDERSTYLE="3" 
			CMD1CAPTION="" 
			CMD2CAPTION="Odustani" 
			CMD3CAPTION="Obriši:DELETEFORM" 
			CMD4CAPTION="Proknjiži:PROKNJIZI" 
			NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="donstavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="14300" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spMPOtpremniceZamjena @action=4,@id = @@id" 
                                          />

	</DONESENO>


	<DELETEFORM
	  WIDTH="5500" 
	  STORA="spMPOtpremniceZamjena @action=5, @operateriid = @@operateriid, " 
	  STARTUPSTORA="select @@donstavke as maloprodajaglaid, broj from maloprodajagla where maloprodajaglaid = @@donstavke"	
	  HEIGHT="3000" 
	  CAPTION="Obrisati ?" 
	  CMD1CAPTION="Obriši"
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<KONTROLA TYPE="VB.Label" NAME="pitanje" TOP="200" LEFT="200" WIDTH="3500" BOLD="TRUE" CAPTION="Želite li obrisati donesene stavke odabrane otpremnice ??"/>
		<KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="broj" TOP="1200" LEFT="700" WIDTH="3500" BOLD="TRUE" ENABLED="FALSE" CAPTION="Broj otpremnice"/>
		<KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="maloprodajaglaid" TOP="777700" LEFT="200" WIDTH="3500" BOLD="TRUE" CAPTION=""/>


	</DELETEFORM>

	<PROKNJIZI
	  WIDTH="5500" 
	  STORA="spMPOtpremniceZamjena @action=6, @operateriid = @@operateriid, " 
	  STARTUPSTORA="select top 1 maloprodajaglaid , broj from maloprodajagla where maloprodajaglaid = (select top 1 maloprodajaglaid from ##tempdon where maloprodajagla2id = @@donstavke)"	
	  HEIGHT="3000" 
	  CAPTION="Proknjižiti ?" 
	  CMD1CAPTION="Proknjiži"
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<KONTROLA TYPE="VB.Label" NAME="pitanje" TOP="200" LEFT="200" WIDTH="3500" BOLD="TRUE" CAPTION="Želite li proknjižiti donesene stavke na dokument ??"/>
		<KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="broj" TOP="1200" LEFT="700" WIDTH="3500" BOLD="TRUE" ENABLED="FALSE" CAPTION="Broj otpremnice"/>
		<KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="maloprodajaglaid" TOP="777700" LEFT="200" WIDTH="3500" BOLD="TRUE" CAPTION=""/>


	</PROKNJIZI>



</PROJECT> 