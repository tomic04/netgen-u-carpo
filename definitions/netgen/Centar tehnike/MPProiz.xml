<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Parametri:FILTERFORM" 
      CMD2CAPTION="Dodaj:INSERTFORM" 
      CMD3CAPTION="Izmjeni:UPDATEFORM" 
      CMD4CAPTION="" 
      CMD5CAPTION="Status:STATUS" 
      CMD6CAPTION="Pokaži:POKAZIFORM"   
      CMD7CAPTION="Lista"   
      CMD8CAPTION=""   
      REPORT="" 
      DBLCLICKFORM="UPDATEFORM"
      POPUP="Filter:FILTERFORM#Izmjeni:UPDATEFORM">
 
  <NAME>Proizvodi i normativi u MP</NAME>
  <CAPTION>Proizvodi i normativi u MP</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

    <INSERTFORM 
                  FILLEXPLORER="" 
                  REPORT=""  
                  WIDTH="12000" 
				  STARTUPSTORA="select 1"
                  STORA="spMPProizvodi @action = 2, @operateriid = @@operateriid, " 
					
					HEIGHT="6100" 
                  CAPTION="Unos Proizvoda i normativa"  
					DBLCLICKFORM=""
                    BORDERSTYLE="3" 
                  CMD1CAPTION="Normativ>>>" 
                  CMD2CAPTION="Odustani"
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                  CMD6CAPTION=""  
					
                                  NEXTFORM="UPDATEFORM"  >



                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	CAPTION="Datum početka" 
                                   	VALUE="DATE1" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
									ENABLED="TRUE"
                                    CHECKBOX="FALSE"/>

						<KONTROLA TYPE="TRAZILICA" 
											CAPTION="Robaid" 
											NAME="Robaid" 
											SQL="viRoba#robaid#Naziv%#userid#barcode#robakod"
											TEXT=""
											TABINDEX="3" 
											WIDTH="5000" 
											HEIGHT="320"/>


	</INSERTFORM>


	<UPDATEFORM
				FILLEXPLORER="" 
				REPORT=""  
				WIDTH="11000" 
				STARTUPSTORA="if coalesce((select ind from mpproizvodigla where mpproizvodiglaid = @@ID ),0) = 1 begin 
                        exec spRaiserror 69001, 'Proizvod je aktivan. Ne može se više ispravljati !' 
						end
						else begin
							exec spMPProizvodi @action=3,@mpproizvodiglaid=@@ID
						end"
				STORA="" 
				  HEIGHT="5500" 
				CAPTION="Ažuriranje normativa"  
				  DBLCLICKFORM=""
				  BORDERSTYLE="3" 
				CMD1CAPTION="Spremi" 
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""	 
				CMD4CAPTION="Dodaj:DODAJSTAVKU"
				CMD5CAPTION=""	 		 
				CMD6CAPTION="Obriši:BRISISTAVKU"  
					
				NEXTFORM=""  >

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumod" 
					CAPTION="Datum početka" 
					VALUE="DATE1" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1" 
					ENABLED="FALSE"
					CHECKBOX="FALSE"/>
		<KONTROLA TYPE="TRAZILICA" 
							CAPTION="Proizvod" 
							NAME="Naziv" 
							TEXT=""
							TABINDEX="0" 
							WIDTH="5000" 
							ENABLED="FALSE" 
							HEIGHT="320"/>



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				LEFT="100"
				CAPTION="" 
				WIDTH="10500" 
				HEIGHT="3000" 
				TABINDEX="5" 
									SQL="spMPProizvodi @action = 4,@mpproizvodiglaid=@@id" 
                                          />



	</UPDATEFORM>



	<DODAJSTAVKU
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7500" 
                         STORA="spMPProizvodi @action=5, @mpproizvodiglaid = @@id," 
                         STARTUPSTORA="" 
                         HEIGHT="3100" 
                         CAPTION="Prijava nove sirovine"  
                         BORDERSTYLE="3" 
                         CMD1CAPTION="Spremi" 
                         CMD2CAPTION="Odustani"					
                                  >


		<KONTROLA TYPE="TRAZILICA" 
				CAPTION="Sirovina" 
				NAME="Robaid" 
				SQL="viroba#robaid#Naziv%#userid#barcode#robakod"
				TEXT=""
				TABINDEX="1" 
				WIDTH="5000" 
				HEIGHT="320"/>



		<KONTROLA TYPE="CM6.curMEdit6" 
				NAME="kolicina" 
				CAPTION="Količina" 
				TEXT="" 
				WIDTH="2500" 
				HEIGHT="320" 
				TABINDEX="2" 
				DECIMALS="4" />


	</DODAJSTAVKU>




	<POKAZIFORM
				FILLEXPLORER="" 
				REPORT=""  
				WIDTH="11000" 
				STARTUPSTORA="exec spMPProizvodi @action=3,@mpproizvodiglaid=@@ID"
				STORA="" 
				  HEIGHT="5500" 
				CAPTION="Ažuriranje normativa"  
				  DBLCLICKFORM=""
				  BORDERSTYLE="3" 
				CMD1CAPTION="" 
				CMD2CAPTION="Odustani"
				CMD3CAPTION=""	 
				CMD4CAPTION=""
				CMD5CAPTION=""	 		 
				CMD6CAPTION=""  
					
				NEXTFORM=""  >

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumod" 
					CAPTION="Datum početka" 
					VALUE="DATE1" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1" 
					ENABLED="FALSE"
					CHECKBOX="FALSE"/>
		<KONTROLA TYPE="TRAZILICA" 
							CAPTION="Proizvod" 
							NAME="Naziv" 
							TEXT=""
							TABINDEX="0" 
							WIDTH="5000" 
							ENABLED="FALSE" 
							HEIGHT="320"/>



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				LEFT="100"
				CAPTION="" 
				WIDTH="10500" 
				HEIGHT="3000" 
				TABINDEX="5" 
									SQL="spMPProizvodi @action = 4,@mpproizvodiglaid=@@id" 
                                          />



	</POKAZIFORM>



	<FILTERFORM 
						   FILLEXPLORER="TRUE" 
						   REPORT=""  
						   WIDTH="9000" 
						   STORA="spMPproizvodi @action = 1,  @operateriid= @@operateriid, " 
						   STARTUPSTORA="" 
						   HEIGHT="3000" 
						   CAPTION="Izaberi proizvode i normative"  
						   BORDERSTYLE="3" 
									CMD1CAPTION="Pokaži" 
									CMD2CAPTION="Odustani" 
									CMD3CAPTION=""  
									NEXTFORM=""  >




		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumod" 
						CAPTION="Datum od" 
					VALUE="DATE2" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="3" 
						CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumdo" 
						CAPTION="Datum do" 
					VALUE="DATE" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1" 
					CHECKBOX="FALSE"/>

		<KONTROLA TYPE="TRAZILICA" 
				CAPTION="Robaid" 
				NAME="Robaid" 
				SQL="viMPProizvod#robaid#Naziv%#userid#barcode#!mpcijena#"
				TEXT=""
				TABINDEX="1" 
				WIDTH="5000" 
				HEIGHT="320"/>

	</FILTERFORM>





	<STATUS
		  WIDTH="7500" 
		  STORA="exec spMPproizvodi @action=7,@MPproizvodiglaid=@@ID," 
		  STARTUPSTORA="exec spMPproizvodi @action=3,@MPproizvodiglaid=@@ID"
		  HEIGHT="3200" 
		  CAPTION="Ažurirati status proizvoda i normativa ?" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Ažuriraj"         
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  BOLD="TRUE"	
		  CHILDFORM="">

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="naziv" 
				CAPTION="Proizvod" 
				TEXT="" 
				WIDTH="4500" 
				HEIGHT="320" 
				TABINDEX="1" 
				BOLD="TRUE" 
				ENABLED="FALSE" />



		<KONTROLA TYPE="VB.Label" NAME="stat" BOLD="TRUE" TOP="1400" LEFT="400" WIDTH="3500" CAPTION="Jeste li sigurni da želite ažurirati status proizvoda i normativa  ? "/>
	</STATUS>

	<ISPORUCI
		WIDTH="5500" 
		STORA="spMPOtprema 22222,@id=@@id," 
					STARTUPSTORA="if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 1 begin 
                        exec spRaiserror 69001, 'Dokument je otvoren. Ne može otpremiti !' 
						end
						else if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 3 begin
							exec spRaiserror 69001, 'Dokument je isporučen. Ne može se više isporučiti  !' 
						end
						else begin
							exec spMPOtprema @action=11,@ID=@@ID
						end"

		HEIGHT="3200" 
		CAPTION="Zaključiti dokument  ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Isporuči"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
						<KONTROLA TYPE="TMEdit2.TextMEdit2" 
								NAME="brojdok" 
								CAPTION="Broj otpreme" 
								TEXT="" 
								WIDTH="1500" 
								HEIGHT="320" 
								TABINDEX="1" 
								ENABLED="FALSE" />
						<KONTROLA TYPE="TMEdit2.TextMEdit2" 
								NAME="BrojRacuna" 
								CAPTION="Broj računa" 
								TEXT="" 
								WIDTH="1500" 
								HEIGHT="320" 
								TABINDEX="1" 
								ENABLED="FALSE" />



                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumotpreme" 
                                   	CAPTION="Datum isporuke" 
                                   	VALUE="" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
									ENABLED="TRUE"
                                    CHECKBOX="FALSE"/>

   			<KONTROLA TYPE="VB.Label" NAME="stat"  LEFT="100" TOP="300" WIDTH="3500" CAPTION="Jeste li sigurni da želite zaključiti isporuku dokumenta  ? "/>
  </ISPORUCI> 


  
 

  <BRISISTAVKU
		WIDTH="5500" 
		STORA="delete mpproizvodidet where mpproizvodidetid = @@stavke" 
		STARTUPSTORA="spMPproizvodi @action = 6, @mpproizvodidetid=@@stavke"		
		HEIGHT="3200" 
		CAPTION="Brisanje stavke" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Obriši"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

	  <KONTROLA TYPE="VB.Label" NAME="stat"  LEFT="100" TOP="300" BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati stavku ? "/>



	  <KONTROLA TYPE="CM6.curMEdit6"  KOMENTAR="ova kontrola služi samo da sačuva ID stavke , pozicionirana je tako da se nevidi na formi"
					NAME="mpproizvodidetid" 
					TOP="5600" 
					LEFT="2200" 
					CAPTION="mpproizvodidetid" 
					TEXT="" 
					WIDTH="2500" 
					HEIGHT="320" 
					TABINDEX="5" 
					ENABLED="FALSE"
					DECIMALS="0" />

		
		
  </BRISISTAVKU> 



  




</PROJECT>
 
