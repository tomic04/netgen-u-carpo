                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajTrgovina @operateriid=@@operateriid"/>

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="mpkaseid" 
                                    	CAPTION="Kasa" 
                                   	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="true" 
									REFRESHAFTERCHILD = "TRUE"
                                 	SQL="select mpkaseid, kasa as naziv from mpkase where trgovinaid = @@trgovinaid" />




                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
