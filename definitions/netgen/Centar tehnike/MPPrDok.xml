                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>
										

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstapromid" 
                                    	CAPTION="Vrsta prometa" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="5" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select vrstapromid,opis as Naziv from vrstaprom where projekt = 'M'"/>
										
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="FALSE" 
									REFRESHAFTERCHILD="TRUE" 
                                 	SQL="select vrstadokid, opis as naziv from vrstadok where vrstapromid =@@vrstapromid"/>

										
										
