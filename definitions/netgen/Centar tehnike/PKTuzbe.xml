<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 MASTERDBLCLICK="UPDATE_FORM"
		 CMD1CAPTION="&amp;Parametri:FILTERFORM" 
		 CMD2CAPTION="&amp;Dodaj:INSERTFORM"
		 CMD3CAPTION="&amp;Izmjeni:UPDATE_FORM" 
		 CMD4CAPTION="&amp;Zaključi:ZAKLJUCI" 
		 CMD5CAPTION="&amp;Obriši:DELETE_FORM" 		
		 CMD6CAPTION="&amp;Print dok.:PRINTMASTER"
		 CMD7CAPTION="Lista" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Filter:FILTERFORM#Izmjeni:UPDATEFORM#Zaključi:ZAKLJUCI" 
		 GROUPBYBOXVISIBLE="FALSE" 
		 ONLOAD=":FILTERFORM" FROZENCOLUMNS="0" AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 REPORT="">

	<NAME>PKTuzbe</NAME>
	<CAPTION>PK Tužbe</CAPTION>

	<INSERTFORM NAME="INSERTFORM" HEIGHT="3900" WIDTH="7000" 
			 CAPTION="Unos PK Tužbe"
			 ONSUBMIT=""
			 ONLOAD="select convert(varchar,getdate(),112) as DatumTuzbe" 
			 NEXTFORM=""
			 CMD1CAPTION="" 
			 CMD2CAPTION=""
			 FOCUS="DatumTuzbe"
			 FILLEXPLORER=""
		>
		<INPUT TYPE="date"   NAME="DatumTuzbe"       CAPTION="Datum*"     TABINDEX="1" TOP="200"  LEFT="1200" WIDTH="1500" SQL=""  />
		<INPUT TYPE="search" NAME="PKOsobeid"	     CAPTION="Osoba*"     TABINDEX="2" TOP="600"  LEFT="1200" WIDTH="3500" SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner"  ONLOSTFOCUS="select 'refresh' as pkosobekreditiid"/>
		<INPUT TYPE="combo"  NAME="pkosobekreditiid" CAPTION="Kredit*"	  TABINDEX="3" TOP="1000" LEFT="1200" WIDTH="2500" SQL="select pkosobekreditiid, partija as naziv from pkosobekrediti where pkosobeid=@@pkosobeid" ALLOWEMPTY="FALSE" ONLOSTFOCUS="select sum(duguje-potrazuje) as glavnica from pkkreditiprometdet where pkosobekreditiid=@@pkosobekreditiid"/>
		<INPUT TYPE="number" NAME="glavnica"	     CAPTION="Glavnica*"  TABINDEX="4" TOP="1400" LEFT="1200" WIDTH="2500" SQL="" />
		<INPUT TYPE="number" NAME="kamata"	         CAPTION="Kamate*"    TABINDEX="5" TOP="1800" LEFT="1200" WIDTH="2500" SQL="" />
		<INPUT TYPE="number" NAME="TroskoviSpora"	 CAPTION="Troškovi spora*"    TABINDEX="6" TOP="2200" LEFT="1200" WIDTH="2500" SQL="" />
		<INPUT TYPE="text"	 NAME="napomena"	     CAPTION="Napomena_*" TABINDEX="7" TOP="2600" LEFT="1200" WIDTH="3500" SQL="" />

		<INPUT TYPE="button" NAME="ok" TABINDEX="11" CAPTION="Spremi" TOP="3000" LEFT="3500" WIDTH="1000" HEIGHT="322" 
				ONCLICK="spPKTuzbe @action=2, @pkosobekreditiid=@@pkosobekreditiid, @operateriid=@@operateriid , @datumtuzbe = @@datumtuzbe , @napomena = '@@napomena', @glavnica=@@glavnica, @kamata=@@kamata, @TroskoviSpora=@@TroskoviSpora#OK"  />
		<INPUT TYPE="button" NAME="cancel" TABINDEX="12" CAPTION="Odustani" TOP="3000" LEFT="1000" WIDTH="1000" HEIGHT="322" ONCLICK="close"  />
	</INSERTFORM>


	<UPDATE_FORM 
		CAPTION="Izmjena PK Tužbe"
		HEIGHT="3900" WIDTH="7000" 
		FILLEXPLORER="" 
		ONLOAD="if coalesce((select status from PKTuzbe  where PKTuzbeId = @@ID ) ,0)> 1  begin 
				exec spRaiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spRaiserror 69001, &apos;Niste odabrali dokumant !&apos;
				end 
				else begin 
					exec spPKTuzbe @action=0 ,@PKTuzbeID=@@ID
				end 
				end" 
		ONLOAD2=""
		>
		<INPUT TYPE="date"   NAME="DatumTuzbe"       CAPTION="Datum*"     TABINDEX="1" TOP="200"  LEFT="1200" WIDTH="1500" SQL=""  />
		<INPUT TYPE="search" NAME="PKOsobeid"	     CAPTION="Osoba*"     TABINDEX="2" TOP="600"  LEFT="1200" WIDTH="3500" SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner"  ONLOSTFOCUS="select 'refresh' as pkosobekreditiid"/>
		<INPUT TYPE="combo"  NAME="pkosobekreditiid" CAPTION="Kredit*"	  TABINDEX="3" TOP="1000" LEFT="1200" WIDTH="2500" SQL="select pkosobekreditiid, partija as naziv from pkosobekrediti where pkosobeid=@@pkosobeid" ALLOWEMPTY="FALSE" />
		<INPUT TYPE="number" NAME="glavnica"	     CAPTION="Glavnica*"  TABINDEX="4" TOP="1400" LEFT="1200" WIDTH="2500" SQL="" ONLOSTFOCUS=""/>
		<INPUT TYPE="number" NAME="kamata"	         CAPTION="Kamate*"    TABINDEX="5" TOP="1800" LEFT="1200" WIDTH="2500" SQL="" />
		<INPUT TYPE="number" NAME="TroskoviSpora"	 CAPTION="Troškovi spora*"    TABINDEX="6" TOP="2200" LEFT="1200" WIDTH="2500" SQL="" />
		<INPUT TYPE="text"	 NAME="napomena"	     CAPTION="Napomena_*" TABINDEX="7" TOP="2600" LEFT="1200" WIDTH="3500" SQL="" />

		<INPUT TYPE="button" NAME="ok" TABINDEX="11" CAPTION="Spremi" TOP="3000" LEFT="3500" WIDTH="1000" HEIGHT="322"
				ONCLICK="spPKTuzbe @action=3, @PKTuzbeId=@@id, @pkosobekreditiid=@@pkosobekreditiid, @operateriid=@@operateriid , @datumtuzbe = @@datumtuzbe , @napomena = '@@napomena', @glavnica=@@glavnica, @kamata=@@kamata, @TroskoviSpora=@@TroskoviSpora#OK"  />
		<INPUT TYPE="button" NAME="cancel" TABINDEX="12" CAPTION="Odustani" TOP="3000" LEFT="1000" WIDTH="1000" HEIGHT="322" ONCLICK="close"  />

	</UPDATE_FORM>


<DELETE_FORM 
		CAPTION="Brisanje tužbe" 
		HEIGHT="1800" 
		WIDTH= "7400" 
		>
			<INPUT TYPE="label" NAME="lblporuka" TOP="300" LEFT="400" WIDTH="400" CAPTION="Jeste li sigurni da želite obrisati označenu stavku ?"/>
			<INPUT TYPE="button" NAME="ok" HOTKEY="" TOP="800" LEFT="400" WIDTH="1000" CAPTION="Obriši" ONCLICK="spPKTuzbe @action=4, @PKTuzbeId=@@id#select 'refresh' as stavke#Ok"  />
			<INPUT TYPE="button" NAME="cancel" TOP="800" LEFT="1500" WIDTH="1000" CAPTION="Odustani" ONCLICK="close"  />
</DELETE_FORM>

<FILTERFORM NAME="FILTERFORM" HEIGHT="3254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spPKTuzbe @action = 1, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
			<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
			<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
			<INPUT TYPE="search" NAME="pkosobeid" ALLOWEMPTY="TRUE" CAPTION="Osoba" ONLOSTFOCUS="select 'refresh' as pkosobekreditiid" SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner" />
			<INPUT TYPE="combo" NAME="pkosobekreditiid" ALLOWEMPTY="true" CAPTION="Kredit" SQL="select pkosobekreditiid, partija as naziv from pkosobekrediti where pkosobeid=@@pkosobeid" />
</FILTERFORM>

<ZAKLJUCI NAME="ZAKLJUCI" HEIGHT="3500" WIDTH="7000"
		CAPTION="Tužba riješena (plaćena) ?" 
		ONSUBMIT="spPKTuzbe @action=5, @PKTuzbeId = @@id, "
		ONLOAD="if (select status from PKTuzbe where PKTuzbeId= @@ID ) >= 2 begin 
                        exec spRaiserror 69001, 'Dokument je zaključen. Ne može se više zaključivati!' 
						end
						else begin
                        exec spPKTuzbe @action=0,@PKTuzbeID=@@ID
					end" 
		 FILLEXPLORER="" 	
		 CMD1CAPTION="Zaključi" 
		 CMD2CAPTION="Odustani" 
		>
		<INPUT TYPE="date"   NAME="DatumTuzbe"       CAPTION="Datum*"     TABINDEX="1" TOP="200"  LEFT="1000" WIDTH="1500" SQL=""  />
		<INPUT TYPE="search" NAME="PKOsobeid"	     CAPTION="Osoba*"     TABINDEX="2" TOP="600"  LEFT="1000" WIDTH="3500" SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner"  ONLOSTFOCUS="select 'refresh' as pkosobekreditiid"/>
		<INPUT TYPE="combo"  NAME="pkosobekreditiid" CAPTION="Kredit*"	  TABINDEX="3" TOP="1000" LEFT="1000" WIDTH="2500" SQL="select pkosobekreditiid, partija as naziv from pkosobekrediti where pkosobeid=@@pkosobeid" ALLOWEMPTY="FALSE" />
		<INPUT TYPE="number" NAME="glavnica"	     CAPTION="Glavnica*"  TABINDEX="4" TOP="1400" LEFT="1000" WIDTH="2500" SQL="" ONLOSTFOCUS=""/>
		<INPUT TYPE="number" NAME="kamata"	         CAPTION="Kamate*"    TABINDEX="5" TOP="1800" LEFT="1000" WIDTH="2500" SQL="" />
		<INPUT TYPE="text"	 NAME="napomena"	     CAPTION="Napomena_*" TABINDEX="6" TOP="2200" LEFT="1000" WIDTH="3500" SQL="" />
</ZAKLJUCI>

<OTKLJUCAJ 
		 NAME="OTKLJUCAJ" HEIGHT="3197" WIDTH="5501" 
		 CAPTION="Otključavanje dokumenta  ?" 
		 ONSUBMIT="spMPOdkljucajDokNG @id  = @@id, @operateriid = @@operateriid "
		 ONLOAD="if (select status from maloprodajagla where maloprodajaglaid= @@ID )  = 3 or  (select status from maloprodajagla where maloprodajaglaid= @@ID )  = 1 begin 
                        exec spRaiserror 69001, 'Dokument nije u statusu za otključavanje. Ne može se više otključavati!' 
						end
						else begin
                        exec spMPQueryGlaIDetNG @action=3,@ID=@@ID
					end"
		 FILLEXPLORER="" 
		 CMD1CAPTION="Otključaj" CMD2CAPTION="Odustani"
		>
		<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2779"  CAPTION="_broj" ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label57" TOP="360" LEFT="288" HEIGHT="288" WIDTH="1728" BOLD="FALSE" CAPTION="Broj dokumenta:" />
		<INPUT TYPE="label" NAME="stat" TOP="1267" LEFT="374" HEIGHT="418" WIDTH="4003"  BOLD="TRUE" CAPTION="Jeste li sigurni da želite otključati dokument  ? " />
</OTKLJUCAJ>

</PROJECT>