<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="Promet:FORM2" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM=""
	        POPUP=""> 
 

  <NAME>Pregled nekurentne robe</NAME>
  <CAPTION>Pregled nekurentne robe</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPPregNekurentneRobe @action=1,@operateriid=@@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>


			<KONTROLA TYPE="CMEditVB6.CurMEdit" 
					NAME="broj1" 
					TABINDEX="2" 
					CAPTION="Broj dana" 
					TEXT="" 
					DECIMALS="0" 
					WIDTH="1900" 
					HEIGHT="320"/> 


			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>
	  <KONTROLA TYPE="TMEdit2.TextMEdit2" 
			  CAPTION="Traženje pojma" 
			  NAME="search" 
			  TABINDEX="4" 
			  TEXT="" 
			  WIDTH="5500" 
			  HEIGHT="320"/>

	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="klasaid" 
                                    	CAPTION="Klasa" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="5" 
                                   	ALLOWEMPTY="TRUE" 
 	                              	SQL="select KlMasterRobaId,  naziv = space(len(sortkey)) + naziv,sortkey from KlMasterRoba order by sortkey"  />

			<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                                      	TOP="2300" 
                                       	LEFT="2200" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="stanje" 
                                      	TOP="2800" 
                                       	LEFT="2200" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži samo robe kojima je stanje različito od 0"/>

  </FORM1>
 

<FORM2	 	FILLEXPLORER="TRUE" 
		WIDTH="12000" 
		STORA="" 
		STARTUPSTORA="" 		
		HEIGHT="6000" 
		CAPTION="Promet" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		

			
			
			<KONTROLA TYPE="GridEX20.GridEX" 
                                   	NAME="lbl2" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="11000" 		
                                   	HEIGHT="4000" 
                               		CAPTION="Promet:"
					REFRESHAFTERCHILD="TRUE"
					SQL="spMPPregNekurentneRobe @action=2,@robaid=@@id,@klasaid=null,@podklase=null,@Broj1=null,@operateriid=0,@stanje=null"/>
			


  </FORM2>


</PROJECT> 