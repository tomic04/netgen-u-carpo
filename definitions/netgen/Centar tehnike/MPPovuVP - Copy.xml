<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '119', @vrstadokid  = @@vrstadokid, @nenc = 1" />



<INSERTFORM NAME="INSERTFORM" HEIGHT="4000" WIDTH="8000" 
		 CAPTION="Unos Povratnica iz MP u VP"
		 ONSUBMIT="spMPInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = '119',  @status = 0,"
		 ONLOAD="select convert(varchar,getdate(),112) as datumdok, @@vrstadokid as vrstadokid" 
		 NEXTFORM="UPDATE_FORM"
		 FOCUS='datumdok'
		 CMD1CAPTION="Stavke&gt;&gt;&gt;" 
		 CMD2CAPTION="Odustani" 
		>
			<INPUT TYPE="text"  NAME="broj"       TABINDEX="1" CAPTION="Broj dokumenta:" ENABLED="FALSE"/>
			<INPUT TYPE="date"  NAME="datumdok"   TABINDEX="2" CAPTION="Datum dokumenta:" ONLOSTFOCUS="select 'refresh' as osobeid"/>
			<INPUT TYPE="combo" NAME="trgovinaid" TABINDEX="3" ONCLICK="select 'refresh' as osobeid" SQL="spMPDajTrgovina @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Trgovina izlaz" />
			<INPUT TYPE="combo" NAME="skladisteid" TABINDEX="4" SQL="spmpdajskladiste @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Skladište" />
			<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena" TABINDEX="5"/>
			<INPUT TYPE="combo" NAME="osobeid" TABINDEX="6" SQL="spMPDajOsobe @trgovinaid = @@trgovinaid" ALLOWEMPTY="FALSE" CAPTION="Odgovorna osoba"/>
			<INPUT TYPE="combo" NAME="vrstadokid" CAPTION="Vrsta povratnice" SQL="spmpdajvrstadok @sifra = '119'"/>
</INSERTFORM>



