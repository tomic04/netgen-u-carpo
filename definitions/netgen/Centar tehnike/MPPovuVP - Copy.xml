	<STORNO NAME="STORNO" HEIGHT="3197" WIDTH="5501" 
			CAPTION="Stornirati dokument  ?" 
			ONSUBMIT=""
			ONLOAD="if (select storno from maloprodajagla where maloprodajaglaid= @@ID ) = 'S'  begin 
	                        exec spRaiserror 69001, 'Dokument je već storniran. Ne možete ga stornirati !' 
						end
						else begin
							if (select status from maloprodajagla where maloprodajaglaid= @@ID ) &lt;&gt; 2 begin 
								exec spRaiserror 69001, 'Dokuiment nije zaključen. Ne možete ga stornirati !' 
							end
						else begin
                        exec spMPQueryGlaIDetNG @action=3,@ID=@@ID
						end						
					end" 
