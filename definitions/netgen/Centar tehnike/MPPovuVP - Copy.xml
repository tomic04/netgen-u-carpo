		<INPUT TYPE="date"   NAME="datumdok"      CAPTION="Datum*" TABINDEX="1" TOP="210" LEFT="1490" WIDTH="1596" HEIGHT="280" SQL=""  />
		<INPUT TYPE="text"   NAME="broj"          CAPTION="Broj*" TABINDEX="-1" TOP="210" LEFT="3780" WIDTH="2002" HEIGHT="280" SQL="" ENABLED="FALSE"  />
		<INPUT TYPE="combo"  NAME="trgovinaid"    CAPTION="Trgovina izlaz*" TABINDEX="-1" TOP="554" LEFT="1490" WIDTH="3500" HEIGHT="294" ALLOWEMPTY="FALSE" ENABLED="FALSE" SQL="spMPDajTrgovina @operateriid=@@operateriid"  ONCLICK="select 'refresh' as skladisteid, 'refresh' as osobeid"/>
		<INPUT TYPE="combo"  NAME="skladisteid"   CAPTION="Skladište*" TABINDEX="-1" TOP="854" LEFT="1490" WIDTH="3500" HEIGHT="294" ALLOWEMPTY="FALSE" SQL="spMPDajSkladiste @trgovinaid = @@trgovinaid ,@operateriid=@@operateriid"  />
		<INPUT TYPE="text"   NAME="napomena"      CAPTION="Napomena*" TABINDEX="2" TOP="1190" LEFT="1490" WIDTH="3568" HEIGHT="280" ALLOWEMPTY="TRUE" SQL=""  />
		<INPUT TYPE="combo"  NAME="osobeid "      CAPTION="Odgovorna osoba*" TABINDEX="3" TOP="1490" LEFT="1490" WIDTH="2568" HEIGHT="280" ALLOWEMPTY="FALSE" SQL="spMPDajOsobe @trgovinaid = @@trgovinaid"  />

		<INPUT TYPE="frame"  NAME="fr2"           CAPTION="Nova stavka dokumenta :" TOP="2000" LEFT="56" WIDTH="8750" HEIGHT="2950"   />
		<INPUT TYPE="search" NAME="robaid" 	  CAPTION="Roba (F5)*" TABINDEX="4" TOP="2226" LEFT="1372" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" 
					ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid
						#if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @Skladisteid = @@skladisteid, @datum = @@datumdok,@partneriid = null, @vrstadokid = @@vrstadokid, @sifradok = '99' end" 
					BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
		<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina*" TABINDEX="5" TOP="2562" LEFT="1372" WIDTH="1296" HEIGHT="280" DECIMALS="4" SQL=""  />
		<INPUT TYPE="text"   NAME="jmnaziv"	  CAPTION="JM*" TABINDEX="-1" TOP="2562" LEFT="3372" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="mpcijena"	  CAPTION="MP Cijena*" TABINDEX="-1" TOP="2862" LEFT="1372" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL="select dbo.fnMPdajMPC(@@robaid, @@trgovinaid, @@datumdok )"  />
		<INPUT TYPE="number" NAME="nabcijena"	  CAPTION="Nabavna cijena*" TABINDEX="-1" TOP="3162" LEFT="1372" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dodaj (F8)" TABINDEX="6" TOP="3750" LEFT="7280" WIDTH="1428" HEIGHT="322" ONCLICK="spMPInsertGlaIdetNG @action=3,@robaid=@@robaid,@id=@@id,@NabCijena=@@nabcijena,@kolicinaulaz=@@kolicina, @mpcijena=@@mpcijena, @porukagreska = 1#select cmpiznos from maloprodajagla where maloprodajaglaid = @@id#select '' as roba , 'robaid' as focus, robaid = null, kolicina = 0, nabcijena = 0, mpcijena = 0, sktstanje = 0, 'refreshmovelast' as stavke " HOTKEY="F8" />

		<INPUT TYPE="grid" 
			   NAME="stavke" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="4140" LEFT="56" WIDTH="8750" HEIGHT="3078"
			   TABINDEX="-1"
			   AFTERREFRESH="select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU" 
			   EDITCOLUMNS="kol.ulaz"
			   ONCELLEDITED="spMPInsertGlaIdetNG @action=4, @maloprodajadetid = @@stavke, @id = @@id, @kolicinaulaz = @(stavke..kol.ulaz)#select 'stavke' as focus #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   CHECKBOXVISIBLE="TRUE"	
			   PAGEHEADERCENTER="Narudžba br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 1" />

		<INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno*" TOP="7322" LEFT="6594" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="button" NAME="ok" TABINDEX="7" CAPTION="Spremi (F2)" TOP="7840" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = '119',@datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @skladisteid = @@skladisteid#Ok" HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" TABINDEX="8" CAPTION="Odustani" TOP="7840" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="ispravi" TABINDEX="9" CAPTION="Ispravi" TOP="7840" LEFT="2688" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
		<INPUT TYPE="button" NAME="obrisi" TABINDEX="10" CAPTION="Obriši" TOP="7840" LEFT="4186" WIDTH="1400" HEIGHT="322" ONCLICK=":BRISISTAVKU"  />
		<INPUT TYPE="button" NAME="donesi" TABINDEX="11" CAPTION="Donesi" TOP="7840" LEFT="5684" WIDTH="1400" HEIGHT="322" ONCLICK=":DONESI"  />
</UPDATE_FORM>


