	<BILJESKE 	FILLEXPLORER="TRUE"
		   WIDTH="14000"
		   ONSUBMIT=""
		   ONLOAD="if coalesce(( select pko.partneriid  as partneriid From pkosobekrediti pko 
					inner join pkosobe po on pko.PKOsobeid = po.PKOsobeId 
					where pkosobekreditiid=@@id),0)  = 0  begin 
							exec spRaiserror 69001, &apos;Odobrana osoba nije i PARTNER ! Ne možete dodavati bilješku !&apos;			
					end 
					else begin 
						select pko.partneriid  as partneriid From pkosobekrediti pko 
						inner join pkosobe po on pko.PKOsobeid = po.PKOsobeId 
						where pkosobekreditiid=@@id 
					end "
		   HEIGHT="7500"
		   CAPTION="Stavke prometa"
			TOTALROW="FALSE"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION=""
		   CMD3CAPTION=""
		   CMD4CAPTION=""
		   NEXTFORM="">

		<INPUT TYPE="number" NAME="partneriid" 			VISIBLE="FALSE" DECIMALS="0" CAPTION="" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>


		<INPUT TYPE="grid"
