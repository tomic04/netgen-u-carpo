<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD="spMPVezaniCjeniciNG @action=111,@operateriid=@@operateriid"  		
		REPORT="" 	
		CMD1CAPTION="Cjenik:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="Aktiviraj mp cjenik:AKTIVIRANJECJENIKA"
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION=""  
		MASTERDBLCLICK="STAVKECJENIKA"
		GROUPBYBOXVISIBLE="FALSE" 
		POPUPMASTER=""
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="FALSE"> 
 
  <NAME>MP cjenici</NAME>
  <CAPTION>MP cjenici</CAPTION>


  <FORM1
	  NAME="FORM1"
	  HEIGHT="5000" 
	  WIDTH="7502"
	  ONLOAD=""
	  CAPTION="Rad s mp cjenikom ">

		<INPUT TYPE="button" NAME="ok"     CAPTION="Otvori novi mp cjenik"  TOP="500" LEFT="456" WIDTH="3500" HEIGHT="322" ONCLICK=":NOVICJENIK#OK"  HOTKEY="" />
	    <INPUT TYPE="button" NAME="ok"     CAPTION="Izmijeni naziv neaktiviranog cjenika"  TOP="1000" LEFT="456" WIDTH="3500" HEIGHT="322" ONCLICK=":EDITCJENIK#OK"  HOTKEY="" />
		<INPUT TYPE="button" NAME="ok"     CAPTION="Obriši neaktivirani cjenik" TOP="1500" LEFT="456" WIDTH="3500" HEIGHT="322" ONCLICK=":BRISICJENIK#OK"  HOTKEY="" />
	    <INPUT TYPE="button" NAME="ok"     CAPTION="Pokaži stavke cjenika" TOP="2000" LEFT="456" WIDTH="3500" HEIGHT="322" ONCLICK=":STAVKECJENIKA#OK"  HOTKEY="" />
	    <INPUT TYPE="button" NAME="ok"     CAPTION="Donesi stavke sa drugog cjenika" TOP="2500" LEFT="456" WIDTH="3500" HEIGHT="322" ONCLICK=":DONESISTAVKECJENIKA#OK"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3500" LEFT="5500" WIDTH="1106" HEIGHT="322" ONCLICK="close" />
	  
  </FORM1 >
	
  <NOVICJENIK 
	  WIDTH="9000"
	  ONSUBMIT=""
	  ONLOAD="select 1 as glavni"
	  HEIGHT="4500"
	  CAPTION="Novi cjenik"
	  FILLEXPLORER="" >

	  <INPUT TYPE="text" NAME="Opis" CAPTION="Naziv cjenika:*" TOP="500" LEFT="2500" HEIGHT="320" WIDTH="5500" VISIBLE="TRUE" ENABLED="TRUE"/>
	  <INPUT TYPE="combo" NAME="vrcjenikid"	CAPTION="Cjenik iz kojeg se kopira:*" TOP="1000" LEFT="2500" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where datumaktiviranja is not null and indmp=1"/>
	  <INPUT TYPE="number" NAME="PostotakNoviC" CAPTION="% promjene novog cjenika:*" ENABLED="TRUE" ALLOWEMPTY="FALSE" TOP="1500" LEFT="3500" WIDTH="1000" HEIGHT="320" DECIMALS="2"/>

	  <INPUT TYPE="checkbox" NAME="glavni" CAPTION="Novi cjenik je samostalni cjenik" TOP="2000" LEFT="2500" WIDTH="5500" ONCLICK="" ENABLED="FALSE" />

	  <INPUT TYPE="button" NAME="ok"     CAPTION="Otvori novi mp cjenik" TOP="3500" LEFT="456" WIDTH="3000" HEIGHT="322" 
			 ONCLICK="spMPVezaniCjeniciNG @action=2, @operateriid=@@operateriid,@Opis='@@Opis',@vrcjenikid=@@vrcjenikid,@PostotakNoviC=@@PostotakNoviC, @glavni=1, @vezani=null, @vrcjenik2id=null, @PostotakVezaniC=0#OK" />
	  <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="3500" LEFT="3756" WIDTH="1106" HEIGHT="322" ONCLICK="close" />

  </NOVICJENIK>

  <EDITCJENIK
	NAME="IZMIJENI"
	HEIGHT="3500"
	WIDTH="8000"
	CAPTION="Izmijeniti cjenik ?"
	ONSUBMIT="spMPVezaniCjeniciNG @action=22,"
	ONLOAD="select @@id as vrcjenikid"
	FILLEXPLORER=""
	CMD1CAPTION="Spremi"
	CMD2CAPTION="Odustani">

	  <INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Cjenik:*" TOP="500" LEFT="1800" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" BOLD="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid=@@vrcjenikid" />
	  <INPUT TYPE="text" NAME="Opis" CAPTION="Novi naziv cjenika:*" TOP="1000" LEFT="1800" HEIGHT="320" WIDTH="5500" VISIBLE="TRUE" ENABLED="TRUE"/>

  </EDITCJENIK>
	
  <BRISICJENIK
	  NAME="BRISI" 
	  HEIGHT="2197" 
	  WIDTH="5501" 
	  CAPTION="Obrisati cjenik ?"
	  ONSUBMIT="spMPVezaniCjeniciNG @action=4,"
	  ONLOAD="select @@id as vrcjenikid"
	  FILLEXPLORER="" 
	  CMD1CAPTION="Obriši" 
	  CMD2CAPTION="Odustani">

	  <INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Cjenik:*" TOP="500" LEFT="1000" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" BOLD="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid=@@vrcjenikid" />

  </BRISICJENIK>


  <STAVKECJENIKA
	  WIDTH="11000"
	  ONSUBMIT=""
	  ONLOAD="select @@id as vrcjenikid"
	  HEIGHT="7500"
	  CAPTION="Stavke cjenika"
	  CMD1CAPTION="Povratak"
	  FILLEXPLORER="" >

	  <INPUT TYPE="grid" NAME="grid1" LEFT="300" CAPTION="" CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE" WIDTH="10000" HEIGHT="6000" SQL="spMPVezaniCjeniciNG @action=5, @operateriid=@@operateriid,@vrcjenikid=@@vrcjenikid"  />

  </STAVKECJENIKA>

  <DONESISTAVKECJENIKA
	  WIDTH="7000"
	  ONSUBMIT="spMPVezaniCjeniciNG @action=3, "
	  ONLOAD="select @@id as vrcjenikid"
	  ONLOAD2=""
	  HEIGHT="3500"
	  CAPTION="Donos robe sa drugog cjenika "
	  CMD1CAPTION="Donesi"
	  CMD2CAPTION="Odustani"
	  FILLEXPLORER="" >


	  <INPUT TYPE="combo" NAME="vrcjenikid" CAPTION="Na cjenik:*" TOP="500" LEFT="2000" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="false" ENABLED="FALSE" BOLD="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid=@@vrcjenikid" />
	  <INPUT TYPE="combo" NAME="vrcjeniksaid" CAPTION="Cjenik sa:*" TOP="1000" LEFT="2000" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="false" ENABLED="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where datumaktiviranja is not null and indmp=1" />
	  <INPUT TYPE="number" NAME="PostotakNoviC" CAPTION="% promjene novog cjenika:*" TOP="1500" ENABLED="TRUE" ALLOWEMPTY="FALSE" WIDTH="1000" HEIGHT="320" DECIMALS="2" LEFT="3500"/>

  </DONESISTAVKECJENIKA>

 
  <AKTIVIRANJECJENIKA 
	  NAME="AKTIVIRANJECJENIKA" 
	  HEIGHT="3398" 
	  WIDTH="7603" 
	  CAPTION="Aktiviranje mp cjenika" 
	  BORDERSTYLE="3"
	  ONSUBMIT="spMPVezaniCjeniciNG @action=6,@operateriid=@@operateriid,"
	  ONLOAD="select @@id as vrcjenikid, convert(varchar(10),getdate(),112) as datum" 
	  FILLEXPLORER="" 
	  CMD1CAPTION="Aktiviraj" 
	  CMD2CAPTION="Odustani" >

	  <INPUT TYPE="combo" NAME="vrcjenikid"	CAPTION="Cjenik:*"	TOP="500" LEFT="2000" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" BOLD="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid=@@vrcjenikid" />
	  <INPUT TYPE="date" NAME="datum" TOP="1000" LEFT="2000" HEIGHT="302" WIDTH="1498" CAPTION="Datum aktiviranja:*" ENABLED="FALSE" />

  </AKTIVIRANJECJENIKA>


  <DEAKTIVIRANJECJENIKA
	NAME="DEAKTIVIRANJECJENIKA"
	HEIGHT="3398"
	WIDTH="7603"
	CAPTION="Deaktiviranje mp cjenika"
	BORDERSTYLE="3"
	ONSUBMIT="spMPVezaniCjeniciNG @action=17,"
	ONLOAD="select @@id as vrcjenikid"
	FILLEXPLORER=""
	CMD1CAPTION="Deaktiviraj"
	CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo" NAME="vrcjenikid"	CAPTION="Cjenik:*"	TOP="500" LEFT="1000" WIDTH="4000" HEIGHT="320" ALLOWEMPTY="false" ENABLED="FALSE" BOLD="TRUE" SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid=@@vrcjenikid" />
		<INPUT TYPE="date" NAME="datum" TOP="1000" LEFT="2000" HEIGHT="302" WIDTH="1498" CAPTION="Datum aktiviranja:*" SQL="select convert(varchar(10),datumaktiviranja,112) from vrcjenik where vrcjenikid=@@vrcjenikid" ENABLED="FALSE" />

  </DEAKTIVIRANJECJENIKA>


</PROJECT> 