		   NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="12000" 
				HEIGHT="6000" 
				TABINDEX="5" 
