  <NAME>Zaduženje osoba kreditima </NAME>
  <CAPTION>Zaduženje osoba kreditima</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		STORA="spPKStanjeSaldaOsoba @action=2, " 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
