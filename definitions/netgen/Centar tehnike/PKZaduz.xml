						DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="KRAJ"
			
                                  NEXTFORM=""  >



			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
