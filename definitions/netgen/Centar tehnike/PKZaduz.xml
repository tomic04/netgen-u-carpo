		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		

            <KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datum" CAPTION="Stanje na dan: " VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="1" CHECKBOX="FALSE" />

			

			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="pkosobeid" 
					SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partneri" 
					NAME="partneriid" 
					SQL="viPKKrediti#partneriid#%Naziv%#Kredit%#Ugovor%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>


					  <KONTROLA TYPE="CbEx3.ComboBoxEx3" NAME="vrstadokid" 
						HEIGHT="288" WIDTH="3440" VISIBLE="TRUE" TEXT="" SQL="spPKDajKredite" ALLOWEMPTY="TRUE"  
						CAPTION="Vrsta kredita " TABINDEX="" ENABLED="TRUE"/>



	  <KONTROLA TYPE="VB.checkbox" 
                                   	NAME="Ind" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="Pokaži samo sa saldom "/>



	  <KONTROLA TYPE="VB.checkbox" 
								NAME="dospjelo" 
								WIDTH="4000" 
								HEIGHT="320" 
								CAPTION="Pokaži samo dospjelo"/>

	  <KONTROLA TYPE="VB.checkbox" 
								NAME="analitika" 
								WIDTH="4000" 
								HEIGHT="320" 
								CAPTION="Pokaži analitiku po partijama"/>



  </FORM1>
 <PROMET 	FILLEXPLORER="TRUE" 
