		CMD3CAPTION="" 
		CMD4CAPTION="Potvrda:RS:/Konikom/MPDokumenti/rptPkPotvrda(@@id)" 
		NEXTFORM=""> 
		
		

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
