		NEXTFORM=""  >


	</PRINTKARTICA>

	<MULTISELECT_PNAMJERE NAME="MULTISELECT_PNAMJERE" HEIGHT="4493" WIDTH="9994" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Pismo namjere" BORDERSTYLE="3" STORA=":RS:/Konikom/MPdokumenti/rptPkPismoNamjere"
		 STARTUPSTORA="select oid=@@operateriid,z.ParZiroId
from ParZiro z
inner join Partneri p on z.PartneriId = p.PartneriId
left outer join Partneri b on z.BankeId = b.PartneriId 
where z.PartneriId = (select Convert (integer,VarSet) from PubVars where VarIme = &apos;NasId&apos;)	
and defaultind=1
" CANCELSTORA="" FILLEXPLORER="TRUE" NEXTFORM=""
		 CMD1CAPTION="Ispis" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" CHILDFORM="">
		<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" NAME="parziroid" TOP="130" LEFT="2088"
			 HEIGHT="302" WIDTH="2506" VISIBLE="True" SQL="select z.ParZiroId,z.Ziro,b.Naziv, z.defaultind
from ParZiro z
inner join Partneri p on z.PartneriId = p.PartneriId
left outer join Partneri b on z.BankeId = b.PartneriId 
where z.PartneriId = (select Convert (integer,VarSet) from PubVars where VarIme = &apos;NasId&apos;)	
and b.naziv is not null
"
			 TEXT="Žiro račun:" VALUE="" ALLOWEMPTY="True" REFRESHAFTERCHILD=""
			 CAPTION="Klasa partnera:" TABINDEX="" ENABLED="True"/>

		<KONTROLA TYPE="VB.Label" NAME="lblKlPar" TOP="130" LEFT="130"
			 HEIGHT="288" WIDTH="1728" VISIBLE="True" BOLD="FALSE"
			 CAPTION="Žiro račun:" ENABLED="True" TEXT="Klasa partnera:"/>

		<KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="oid" TOP="1152" LEFT="2074"
			 HEIGHT="288" WIDTH="2578" VISIBLE="false" TEXT=""
			 CAPTION="" TABINDEX="" ENABLED="TRUE"/>


	</MULTISELECT_PNAMJERE>



</PROJECT> 