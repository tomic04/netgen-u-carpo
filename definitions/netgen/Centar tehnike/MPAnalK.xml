<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION=""  
		DBLCLICKFORM="KARTICA"
	        POPUP=""> 
 

  <NAME>Analiza kartica robe</NAME>
  <CAPTION>Analiza kartica robe</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMaloprodajaStanjeQuery @action=500, @kartica = 1, @komisija = 2," 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="skladisteid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajTrgovina @operateriid=@@operateriid"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>
			

			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 
					


			<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="neispravno" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
									TABINDEX="5" 
                               		CAPTION="Samo neispravne kartice "/>

  </FORM1>

 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="17000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="Cijena:IZMJENIFORM" 
		CMD4CAPTION="Stara Cij:IZMJENISTARUMPC" 
		CMD5CAPTION="Količina A-Niv:IZMJENIKOL" 
		CMD6CAPTION="Stara Cij A-Niv:IZMJENISTARUMPCA" 
		
		CHILDFORM=""> 

			<KONTROLA TYPE="GridEX20.GridEX" NAME="gridkartica" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="16500" HEIGHT="8000" TABINDEX="2" 
                         SQL="spMaloprodajaStanjeKartica @action = 1, @robaid = @@id, @prikaz= 0, @trgovinaid = @@skladisteid, @datumod = @@datumod, @datumdo = @@datumdo, @totalgen= 1,@operateriid = @@operateriid " /> 
</KARTICA>

	<IZMJENIFORM
	  WIDTH="5500" 
	  STORA="spMPKontrolaNivelacija @action=8, @stavke = @@gridkartica, " 
	  STARTUPSTORA="select mpcijena as cijena from maloprodajadet where maloprodajadetid = @@gridkartica"
	  HEIGHT="2500" 
	  CAPTION="Izmjeni cijenu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENIFORM>
	<IZMJENIKOL
	  WIDTH="5500" 
	  STORA="spMPKontrolaNivelacija @action=13, @stavke = @@gridkartica, " 
	  STARTUPSTORA="select kolicinaulaz as kolicina from mpniveldet where mpnivelglaid= @@gridkartica"
	  HEIGHT="2500" 
	  CAPTION="Izmjeni količinu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<KONTROLA TYPE="CM6.curMEdit6" NAME="kolicina" CAPTION="Kolicina" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENIKOL>

	<IZMJENISTARUMPC
	  WIDTH="5500" 
	  STORA="spMPKontrolaNivelacija @action=9, @stavke = @@gridkartica, @ANIV = 1, " 
	  STARTUPSTORA="select nabcijena as cijena from maloprodajadet where maloprodajadetid = @@gridkartica"
	  HEIGHT="2500" 
	  CAPTION="Izmjeni cijenu" 
	  CMD1CAPTION="Spremi"         
	  CMD2CAPTION="Odustani" 
	  FILLEXPLORER="">

		<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENISTARUMPC>

	<IZMJENISTARUMPCA
	  WIDTH="5500"
	  STORA="spMPKontrolaNivelacija @action=14, @stavke = @@gridkartica, @ANIV = 1, "
	  STARTUPSTORA="select nabcijena as cijena from mpniveldet where mpniveldetid = @@gridkartica"
	  HEIGHT="2500"
	  CAPTION="Izmjeni cijenu"
	  CMD1CAPTION="Spremi"
	  CMD2CAPTION="Odustani"
	  FILLEXPLORER="">

		<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="0" DECIMALS="2" />


	</IZMJENISTARUMPCA>

</PROJECT> 