<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  
 CMD1CAPTION="Parametri:FILTERFORM" 
 CMD2CAPTION="Proknjiži:PROKNJIZIFORM " 
 CMD3CAPTION="Ispis:PRINTMASTER"  
 ONLOAD=":FILTERFORM" 
 GROUPBYBOXVISIBLE="TRUE" 
 COMMANDTIMEOUT="500"
 FROZENCOLUMNS="0" 
 MASTERDBLCLICK="" 
 CHECKBOXVISIBLE="FALSE"
 PAGEORIENTATION="LANDSCAPE"
 PAGEHEADERCENTER="Materijalno knjiženje" 
 PAGEHEADERLEFT="Materijalno knjiženje za: @@comboboxdatum"
 PAGEHEADERRIGHT="@@Vrijeme" 
 PAGEFOOTERLEFT="@@TKOSMOMI" 
 PAGEFOOTERRIGHT="Jupiter software by Spin">



 <NAME>Materijalno knjiženje</NAME>
 <CAPTION>Materijalno knjiženje</CAPTION>



  <MASTERCOLUMNS>

	   <COLUMN INDEX="" NAME="Konto" WIDTH="1100" CAPTION="Konto" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Opis" WIDTH="2500" CAPTION="Opis" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Duguje" WIDTH=" 1000" CAPTION="Duguje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Potrazuje" WIDTH=" 1000" CAPTION="Potražuje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Naziv" WIDTH="2500" CAPTION="Orgshema" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Rbr" WIDTH="800" CAPTION="RBR" FORMAT="" VISIBLE="FALSE" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Tablica" WIDTH="800" CAPTION="Tablica" FORMAT="" VISIBLE="FALSE" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="Datumknjizenja" WIDTH="800" CAPTION="DatumKnjiženja" FORMAT="" VISIBLE="FALSE" FORECOLOR="" BACKCOLOR="" />
	   <COLUMN INDEX="" NAME="DatumDokumenta" WIDTH="800" CAPTION="DatumDokumenta" FORMAT="" VISIBLE="FALSE" FORECOLOR="" BACKCOLOR="" />
  </MASTERCOLUMNS>   


<FILTERFORM 
					
                 WIDTH="4000" 
                 ONLOAD="select  0 as Broj, (select  rtrim(p.naziv)+''+rtrim(m.naziv)+','+rtrim(s.adresa)
					from Partneri p
					inner join ParStru s on p.PartneriId = s.PartneriId
					inner join Mjesta m on s.MjestaId = m.MjestaId
				where
					p.PartneriId = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))
					and s.Hqind = '*') as tkosmomi, getdate() as Vrijeme"
                 ONSUBMIT="spKntMatKnjizenje @Action=1,@Datum=@@Datum,@operaterid=0!!"                                               
                 HEIGHT="2000" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Izvrši" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER="TRUE"
  		 >
  	               
		<INPUT TYPE="label" NAME="lbldatum"  TOP="220" LEFT="220" WIDTH="1000" CAPTION="Datum knjiženja:"/>
	        <INPUT TYPE="combo"   NAME="datum"   ALLOWEMPTY="FALSE"  TOP="200" LEFT="1400" WIDTH="1500" 
			SQL="if object_id('tempdb..#tt') is not null drop table #tt select distinct datum into #tt from robnopromet  order by 1 desc
                             select  distinct convert(varchar,r.datum,112) as datum,convert(varchar,r.datum,104) as naziv 
                                     from #tt r  with (nolock)  order by 1 desc"   />
                           

</FILTERFORM>

	


  <PROKNJIZIFORM  FILLEXPLORER="TRUE" 
                  ONLOAD="spKntMatKnjizenje @Action=2,@Datum=@@Datum,@operaterid=0" 
                  ONSUBMIT="spkntMatknjizenjequeryNG"
		  ONLOADED=""/>



	 

</PROJECT>
