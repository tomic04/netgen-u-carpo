		CMD3CAPTION="Kartica:PROMET" 
		CMD4CAPTION="P.namjere:MULTISELECT_PNAMJERE"
 		CMD5CAPTION="Kart.Prt:PRINTKARTICA" 
		CMD6CAPTION="Bilješke:BILJESKE"
