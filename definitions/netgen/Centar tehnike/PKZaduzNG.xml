		   HEIGHT="7500" 
		   CAPTION="Kartica osobe" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="" 
		   CMD3CAPTION="" 
		   CMD4CAPTION="" 
		   NEXTFORM="">



		<INPUT TYPE="grid" 
				NAME="kartosob" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="Kartica osobe" 
				TOP="200" 
				CHECKBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   LEFT="200"  
				WIDTH="12000" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spPKKarticaKreditaNG @action=2,@pkosobeid =  @@pkosobeid,  @pkosobekreditiid = @@pkosobekreditiid " 
                                          />
		<INPUT TYPE="button" NAME="ispis" CAPTION="Ispiši" TOP="6600" LEFT="500" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPdokumenti/rptPkKarticaKredita#close" HOTKEY="" />
		<INPUT TYPE="button" NAME="potvrda" CAPTION="Potvrda" TOP="6600" LEFT="2300" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPDokumenti/rptPkPotvrda(@@id)#close" HOTKEY="" />
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="6600" LEFT="4000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close" HOTKEY="" />


	</KARTICAOSOBE>

	<FORM2 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         ONSUBMIT="" 
                         ONLOAD="" 
                         HEIGHT="8800" 
                         CAPTION="Stavke prometa"  
						MASTERDBLCLICK=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="KRAJ"
			
                                  NEXTFORM=""  >



			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="2800" 
					LEFT="200"  
					WIDTH="13500" 
					HEIGHT="5000" 
					TABINDEX="5" 
                      SQL="spGRNalogMP @action = 902,@id=@@id" 
                                          /> 


  </FORM2>

	<PRINTKARTICA
		FILLEXPLORER=""
		REPORT=""
		WIDTH="4000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="2000"
		CAPTION="Kartica kredira"
		MASTERDBLCLICK=""
		BORDERSTYLE="3"
		CMD1CAPTION=""
		CMD2CAPTION=""

		NEXTFORM=""  >

		<INPUT TYPE="button" NAME="ispis" CAPTION="Ispiši" TOP="1000" LEFT="500" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPdokumenti/rptPkKarticaKredita#close" HOTKEY="" />
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="1000" LEFT="2400" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close" HOTKEY="" />

	</PRINTKARTICA>

	<MULTISELECT_PNAMJERE NAME="MULTISELECT_PNAMJERE" HEIGHT="4493" WIDTH="9994" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Pismo namjere" BORDERSTYLE="3" ONSUBMIT=""
		 ONLOAD="select oid=@@operateriid,z.ParZiroId
							from ParZiro z
							inner join Partneri p on z.PartneriId = p.PartneriId
							left outer join Partneri b on z.BankeId = b.PartneriId 
							where z.PartneriId = (select Convert (integer,VarSet) from PubVars where VarIme = &apos;NasId&apos;)	
							and defaultind=1" CANCELONSUBMIT="" FILLEXPLORER="TRUE" NEXTFORM=""
		 CMD1CAPTION="" CMD2CAPTION="" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" CHILDFORM="">
		
		<INPUT TYPE="combo" NAME="parziroid" TOP="130" LEFT="2088"
			 HEIGHT="302" WIDTH="2506" VISIBLE="True" SQL="select z.ParZiroId,z.Ziro,b.Naziv, z.defaultind
							from ParZiro z
							inner join Partneri p on z.PartneriId = p.PartneriId
							left outer join Partneri b on z.BankeId = b.PartneriId 
							where z.PartneriId = (select Convert (integer,VarSet) from PubVars where VarIme = &apos;NasId&apos;)	
							and b.naziv is not null"
			 TEXT="Žiro račun:" VALUE="" ALLOWEMPTY="True" REFRESHAFTERCHILD=""
			 CAPTION="Klasa partnera:" TABINDEX="" ENABLED="True"/>

		<INPUT TYPE="label" NAME="lblKlPar" TOP="130" LEFT="130"
			 HEIGHT="288" WIDTH="1728" VISIBLE="True" BOLD="FALSE"
			 CAPTION="Žiro račun:" ENABLED="True" TEXT="Klasa partnera:"/>

		<INPUT TYPE="text" NAME="oid" TOP="1152" LEFT="2074"
			 HEIGHT="288" WIDTH="2578" VISIBLE="false" TEXT=""
			 CAPTION="" TABINDEX="" ENABLED="TRUE"/>

		<INPUT TYPE="button" NAME="ispis" CAPTION="Ispiši" TOP="3500" LEFT="1600" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPdokumenti/rptPkPismoNamjere ( @oid = @@oid, @parziroid = @@parziroid )#close " HOTKEY="" />
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="3500" LEFT="4400" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close" HOTKEY="" />



	</MULTISELECT_PNAMJERE>



