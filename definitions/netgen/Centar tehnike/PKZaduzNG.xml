			<INPUT TYPE="TRAZILICA" 
					CAPTION="Osoba" 
					NAME="pkosobeid" 
					SQL="viPKOsobeKredita#pkosobeid#%Naziv%#Adresa#Mjesto#[JMBG]%#[Broj OI]%#!Partner" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<INPUT TYPE="TRAZILICA" 
					CAPTION="Partner" 
					NAME="partneriid" 
					SQL="viPKKrediti#partneriid#%Naziv%#Adresa#Kredit%#Ugovor%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>


					  <INPUT TYPE="combo" NAME="vrstadokid" 
						HEIGHT="288" WIDTH="3440" VISIBLE="TRUE" TEXT="" SQL="spPKDajKredite" ALLOWEMPTY="TRUE"  
						CAPTION="Vrsta kredita " TABINDEX="" ENABLED="TRUE"/>



	  <INPUT TYPE="VB.checkbox" 
                                   	NAME="Ind" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="Pokaži samo sa saldom "/>



	  <INPUT TYPE="VB.checkbox" 
								NAME="dospjelo" 
								WIDTH="4000" 
								HEIGHT="320" 
								CAPTION="Pokaži samo dospjelo"/>

	  <INPUT TYPE="VB.checkbox" 
								NAME="analitika" 
								WIDTH="4000" 
								HEIGHT="320" 
								CAPTION="Pokaži analitiku po partijama"/>



  </FORM1>

	<BILJESKE 	FILLEXPLORER="TRUE"
		   WIDTH="14000"
		   ONSUBMIT=""
		   ONLOAD="select  @@partneriid  as partneriid"
		   HEIGHT="7500"
		   CAPTION="Stavke prometa"
			TOTALROW="FALSE"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION=""
		   CMD3CAPTION=""
		   CMD4CAPTION=""
		   NEXTFORM="">

		<INPUT TYPE="number" NAME="partneriid" 			VISIBLE="FALSE" DECIMALS="0" CAPTION="" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>


		<INPUT TYPE="grid"
				NAME="biljeske"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="_ay"
				TOP="200"
				LEFT="200"
				WIDTH="12000"
				HEIGHT="6000"
			    ONLOAD=""
				TABINDEX="5"
				  SQL="spmpParBiljeske @action=3,@partneriid  = @@partneriid "
                                          />
		<INPUT TYPE="button" NAME="dodaj" CAPTION="Dodaj" TOP="6500" LEFT="200" WIDTH="1106" HEIGHT="322"
			   ONCLICK=":DODBILJ" HOTKEY="" />
		<INPUT TYPE="button" NAME="sadrzaj" CAPTION="Pregled" TOP="6500" LEFT="2200" WIDTH="1106" HEIGHT="322"
			   ONCLICK=":SADRZAJ" HOTKEY="" />
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="6500" LEFT="4400" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close" HOTKEY="" />


	</BILJESKE>


	<DODBILJ NAME="DODBILJ"
		HEIGHT="6002" WIDTH="9502"
		CAPTION="Dodavanje bilješke"
		FOCUS=""
		ONLOAD="select operateriid , naziv as operater from ssoperateri where operateriid = @@operateriid">

		<INPUT TYPE="frame" NAME="fr2" CAPTION="Nova bilješka:" TOP="352" LEFT="56" WIDTH="9000" HEIGHT="4300"   />
		<INPUT TYPE="text" NAME="operater " 			CAPTION="Operater*" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>
		<INPUT TYPE="date" NAME="Datum" CAPTION="Datum*" TOP="1100" LEFT="1400" WIDTH="1302" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="text" NAME="tema" CAPTION="O čemu*" TOP="1500" LEFT="1400" WIDTH="4000" HEIGHT="280" SQL=""  ENABLED="TRUE" />
		<INPUT TYPE="text" NAME="sadrzaj" CAPTION="Što*" MULTILINE="TRUE" TOP="1900" LEFT="1400" WIDTH="6000" HEIGHT="2280" SQL="" ENABLED="TRUE" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" HOTKEY="F8" TOP="5000" LEFT="1000" WIDTH="1428" HEIGHT="322"
			   ONCLICK="spmpParBiljeske @action = 0, @partneriid = @@partneriid , @operateriid = @@operateriid, @datum = @@datum , @tema = '@@tema', @sadrzaj = '@@sadrzaj'#OK"/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY="" TOP="5000" LEFT="3000" WIDTH="1428" HEIGHT="322" ONCLICK="close"/>
	</DODBILJ>


	<SADRZAJ NAME="DODBILJ"
HEIGHT="6002" WIDTH="9502"
CAPTION="Pregled bilješke"
FOCUS=""
ONLOAD="spmpParBiljeske @action = 4,@ParKontaktId = @@biljeske">

		<INPUT TYPE="frame" NAME="fr2" CAPTION="Pregled bilješke" TOP="352" LEFT="56" WIDTH="9000" HEIGHT="4300"   />
		<INPUT TYPE="text" NAME="operater " 			CAPTION="Operater*" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>
		<INPUT TYPE="date" NAME="Datum" CAPTION="Datum*" TOP="1100" LEFT="1400" WIDTH="1302" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="text" NAME="tema" CAPTION="O čemu*" TOP="1500" LEFT="1400" WIDTH="4000" HEIGHT="280" SQL=""  ENABLED="FALSE" />
		<INPUT TYPE="text" NAME="sadrzaj" CAPTION="Što*" MULTILINE="TRUE" TOP="1900" LEFT="1400" WIDTH="6000" HEIGHT="2280" SQL="" ENABLED="FALSE" />

		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY="" TOP="5000" LEFT="3000" WIDTH="1428" HEIGHT="322" ONCLICK="close"/>
	</SADRZAJ>

	<IZMJENIBILJ NAME="IZMJENIBILJ"
		HEIGHT="6002" WIDTH="9502"
		CAPTION="Izmjena bilješke"
		FOCUS=""
		ONLOAD="spmpParBiljeske @action = 4,@ParKontaktId = @@biljeske">

		<INPUT TYPE="frame" NAME="fr2" CAPTION="Nova bilješka:" TOP="352" LEFT="56" WIDTH="9000" HEIGHT="4300"   />
		<INPUT TYPE="text" NAME="ParKontaktId" 			CAPTION="" VISIBLE="FALSE" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>
		<INPUT TYPE="text" NAME="operater " 			CAPTION="Operater*" TOP="702" LEFT="1400" WIDTH="4998" ALLOWEMPTY="FALSE" HEIGHT="280" ENABLED="FALSE" SQL="" ONLOSTFOCUS="" BACKCOLOR="" HOTKEY=""/>
		<INPUT TYPE="date" NAME="Datum" CAPTION="Datum*" TOP="1100" LEFT="1400" WIDTH="1302" HEIGHT="280" SQL=""  />
		<INPUT TYPE="text" NAME="tema" CAPTION="O čemu*" TOP="1500" LEFT="1400" WIDTH="4000" HEIGHT="280" SQL=""  ENABLED="TRUE" />
		<INPUT TYPE="text" NAME="sadrzaj" CAPTION="Što*" MULTILINE="TRUE" TOP="1900" LEFT="1400" WIDTH="6000" HEIGHT="2280" SQL="" ENABLED="TRUE" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Spremi" HOTKEY="F8" TOP="5000" LEFT="1000" WIDTH="1428" HEIGHT="322"
			   ONCLICK="spmpParBiljeske @action = 1, @ParKontaktId = @@ParKontaktId, @partneriid = @@partneriid , @operateriid = @@operateriid, @datum = @@datum , @tema = '@@tema', @sadrzaj = '@@sadrzaj'#OK"/>
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" HOTKEY="" TOP="5000" LEFT="3000" WIDTH="1428" HEIGHT="322" ONCLICK="close"/>
	</IZMJENIBILJ>



	<PROMET 	FILLEXPLORER="TRUE" 
		WIDTH="14000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="7500" 
		CAPTION="Kartica kredita" 
		BORDERSTYLE="3"
		TOTALROW="FALSE"
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="" 
		NEXTFORM=""> 
		
		

			<INPUT TYPE="grid" 
					NAME="kartkred" 
					REFRESHAFTERCHILD="TRUE" 
					CHECKBOXVISIBLE="FALSE"
				    TOTALROW="FALSE"
				    CAPTION="Kartica kredita" 
					TOP="200" 
					LEFT="200"  
					WIDTH="12000" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spPKKarticaKreditaNG @action=1,@pkosobekreditiid = @@pkosobekreditiid" 
                                          />
		<INPUT TYPE="button" NAME="ispis" CAPTION="Ispiši" TOP="6600" LEFT="500" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPdokumenti/rptPkKarticaKredita#close" HOTKEY="" />
		<INPUT TYPE="button" NAME="potvrda" CAPTION="Potvrda" TOP="6600" LEFT="2300" WIDTH="1106" HEIGHT="322"
	   ONCLICK=":RS:/Konikom/MPDokumenti/rptPkPotvrda(@@id)#close" HOTKEY="" />
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani" TOP="6600" LEFT="4000" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close" HOTKEY="" />


	</PROMET>
