  <NAME>Zaduženje osoba kreditima </NAME>
  <CAPTION>Zaduženje osoba kreditima</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		ONSUBMIT="spPKStanjeSaldaOsobaNG @action=2, " 
		ONLOAD="select 1 as ind, 1 as analitika, @@xdatum as xdatum, @@pkosobeid as pkosobeid, ime+' '+prezime as osoba from pkosobe where pkosobeid = @@pkosobeid " 
