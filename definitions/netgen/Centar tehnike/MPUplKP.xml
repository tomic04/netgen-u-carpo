<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	STARTUPSTORA=":FORM1"  		
	REPORT="" 	
	CMD2CAPTION=""    
   	CMD3CAPTION="Duple:DUPLE" 
   	CMD4CAPTION=""
   	CMD5CAPTION="Kartica:KARTICA"
	CMD1CAPTION="Filter:FORM1" 
  	CMD6CAPTION="Ućešće:UCESCE"
	DBLCLICKFORM=""
	POPUP=""> 
 
 	<NAME>Pregled uplata kredita </NAME>
	<CAPTION>Pregled uplata kredita </CAPTION>
  
  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		STORA="spMPUplataKreditaQuery @action=1, " 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">
		
		<KONTROLA TYPE="CbEx3.ComboBoxEx3"
						NAME="vrstadokid"
						CAPTION="Vrsta kredita:"
						WIDTH="5000"
					HEIGHT="320"
						TABINDEX="3"
					ALLOWEMPTY="TRUE"
					SQL="sppkdajkredite" />

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
                	NAME="datumod" 
                        CAPTION="Datum od" 
                        VALUE="DATE1" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="3" 
                        CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
  			NAME="datumdo" 
                        CAPTION="Datum do" 
                        VALUE="DATE2" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="4" 
                        CHECKBOX="FALSE"/>

						<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina:" 
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid " /> 
		
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Kupac:" 
					NAME="partneriid" 
					SQL="Partneri#partneriid#naziv%" 
					TEXT=""
					TABINDEX="1" 
					WIDTH="5000" 
					HEIGHT="320"/>


						</FORM1>

	<DODAJFORM
		WIDTH="9000" 
                STORA="spMPUplataKredita @action=2, " 
		STARTUPSTORA="select @@partneriid as partneriid, (select naziv from partneri where partneriid = @@partneriid ) as Partner" 
		HEIGHT="5500" 
		CAPTION="Nova uplata"  
        CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

		
		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#%Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="7500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="faktureid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="false" 
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select zakljucakid as faktureid,  broj+' od '+convert(varchar(10),datumdok,112) + ' '+ str(mpiznos,12,2)+' kn' as Naziv from MaloprodajaGla where partneriid=@@partneriid"/>

			<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="4" 
				TEXT="" 
				DECIMALS="2" 
				WIDTH="1500" 
				HEIGHT="320"/>

								 
  </DODAJFORM>

	<IZMJENIFORM
		WIDTH="9000" 
                STORA="spMPUplataKredita @action=3," 
		STARTUPSTORA="spMPUplataKredita @action=4,@uplatekreditaid = @@id" 
		HEIGHT="5500" 
		CAPTION="Izmjena uplate"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >


		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			ENABLE = "FALSE"
			WIDTH="7500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="faktureid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE"
 	                SQL="spMPUplataKredita @action = 8, @uplatekreditaid = @@id, @partneriid = @@partneriid"/>

			<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="4" 
				TEXT="" 
				DECIMALS="2" 
				WIDTH="1500" 
			ENABLE = "FALSE"
				HEIGHT="320"/>

			<KONTROLA TOP="6000" TYPE="CM6.curMEdit6" NAME="UplateKreditaid" CAPTION="UplateKreditaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />

								 
  </IZMJENIFORM>

  <BRISIFORM
		WIDTH="9000" 
                STORA="spMPUplataKredita @action=6," 
		STARTUPSTORA="spMPUplataKredita @action=5,@uplatekreditaid = @@id" 
		HEIGHT="5500" 
		CAPTION="Brisanje uplate"  
                CMD1CAPTION="Obriši" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >
		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datum" 
			CAPTION="Datum uplate:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			ENABLE="FALSE"
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="partneriid" 
			SQL="Partneri#partneriid#Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="7500" 
			ENABLE="FALSE"
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="faktureid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			ENABLE="FALSE"
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select zakljucakid as faktureid, partija as Naziv from MaloprodajaGla where partneriid=@@partneriid"/>

			<KONTROLA TYPE="CMEditVB6.CurMEdit" 
                CAPTION="Uplaćeni iznos:" 
				NAME="iznos" 
				TABINDEX="4" 
				TEXT="" 
				ENABLE="FALSE"
				DECIMALS="2" 
				WIDTH="1500" 
				HEIGHT="320"/>

			<KONTROLA TOP="6000" TYPE="CM6.curMEdit6" NAME="UplateKreditaid" CAPTION="UplateKreditaid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
  </BRISIFORM>

  


	<KARTICA
		WIDTH="14000" 
		HEIGHT="9000" 
        STORA="" 
		STARTUPSTORA="select @@partneriid as partneriid, (select naziv from partneri where partneriid = @@partneriid ) as Partner" 
		CAPTION="Kartica"  
                CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		FILLEXPLORER="" >
			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="7500" TABINDEX="2" 
                         SQL="spPKKarticaKredita @action=1, @UplateKreditaid = @@id, @partneriid = @@partneriid" /> 


		</KARTICA>

	<UCESCE
		WIDTH="16000" 
		HEIGHT="9000" 
        STORA="" 
		STARTUPSTORA="select @@partneriid as partneriid, (select naziv from partneri where partneriid = @@partneriid ) as Partner" 
		CAPTION="Kartica"  
                CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		FILLEXPLORER="" >
		<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="15500" HEIGHT="7500" TABINDEX="2" 
					 SQL="spMPUplataKreditaQuery @action=2, @datumod = @@datumod, @datumdo = @@datumdo, @trgovinaid = @@trgovinaid" />


	</UCESCE>


	<DUPLE
	WIDTH="16000"
	HEIGHT="9000"
	STORA=""
	STARTUPSTORA=""
	CAPTION="Duple uplate "
			CMD1CAPTION=""
	CMD2CAPTION="Kraj"
	FILLEXPLORER="" >
		<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="15500" HEIGHT="7500" TABINDEX="2"
					 SQL="spMPUplataKreditaQuery @action=3, @datumod = @@datumod, @datumdo = @@datumdo" />


	</DUPLE>



</PROJECT> 