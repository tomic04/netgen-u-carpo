<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FORM1"
		REPORT="rptGotRNMMP.clsReport(@@ID)"
		CMD1CAPTION="Parametri:FORM1"
		 DETAILGRID = "spmpPregRacNG @action=2,@iD= @@id"
		CMD2CAPTION=""
		CMD3CAPTION="FSKALIZACIJA : FISKALIZACIJA(@@id)#:VRIJEMEJIR#REFRESHMASTER"
		CMD4CAPTION=""
 		CMD5CAPTION=""
		CMD6CAPTION=""
		MASTERDBLCLICK="PROMET">


	<NAME>Pregled nefiskaliziranih računa MP </NAME>
	<CAPTION>Pregled nefiskaliziranih računa MP </CAPTION>


	<FORM1 	FILLEXPLORER="TRUE"
		  WIDTH="9000"
		  ONSUBMIT="spmpPregRacNG @action=4, @operateriid = @@operateriid,"
		  ONLOAD="select @@datumod as datumod , @@datumdo as datumdo , @@trgovinaid as trgovinaid"
		  HEIGHT="4000"
		  CAPTION="Parametri"
		  BORDERSTYLE="3"
		  CMD1CAPTION="Pokaži"
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  CHILDFORM="">




		<INPUT TYPE="combo"
						NAME="trgovinaid"
						CAPTION="Trgovina"
						WIDTH="5500"
					HEIGHT="320"
						TABINDEX="1"
					ALLOWEMPTY="true"
					SQL="spMPDajTrgovina @operateriid=@@operateriid"/>



	</FORM1>

	<VRIJEMEJIR 	FILLEXPLORER=""
	  WIDTH="9000"
	  ONSUBMIT="spmpPregRacNG @action=5, @id = @@id"
	  ONLOAD=""
	  HEIGHT="4000"
		CAPTION="Parametri"
	  BORDERSTYLE="3"
	  CMD1CAPTION="Pokaži"
	  CMD2CAPTION="Odustani"
	  CMD3CAPTION=""
	  CHILDFORM="">
	</VRIJEMEJIR>



	<STAVKE 	FILLEXPLORER="TRUE"
		  WIDTH="14000"
		  ONSUBMIT=""
		  ONLOAD=""
		  HEIGHT="7500"
		  CAPTION="Stavke prometa"
		  BORDERSTYLE="3"
		  CMD1CAPTION=""
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  NEXTFORM="">



		<INPUT TYPE="grid"
				NAME="stavke"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="_ay"
				TOP="200"
				LEFT="200"
				WIDTH="12000"
				HEIGHT="6000"
				TABINDEX="5"
				  SQL="spmpPregRacNG @action=2,@id	= '@@id'"
                                          />

	</STAVKE>

	<PLACANJE 	FILLEXPLORER="TRUE"
		  WIDTH="14000"
		  ONSUBMIT=""
		  ONLOAD=""
		  HEIGHT="7500"
		  CAPTION="Stavke prometa"
		  BORDERSTYLE="3"
		  CMD1CAPTION=""
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  NEXTFORM="">



		<INPUT TYPE="grid"
				NAME="stavke"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="_ay"
				TOP="200"
				LEFT="200"
				WIDTH="12000"
				HEIGHT="6000"
				TABINDEX="5"
				  SQL="spmpPregRacNG @action=3,@id	= '@@id'"
                                          />

	</PLACANJE>






</PROJECT>


