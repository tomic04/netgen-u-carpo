<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = "spMPPregstimulacije @action = 2 , @trgovinaid = @@trgovinaid , @operateriid = @@id, @datumod = @@datumod , @datumdo = @@datumdo, @nenc = @@nenc, @robnamarkaid = @@robnamarkaid, @robaid=@@robaid, @search='@@search', @klasaid=@@klasaid, @podklase=@@podklase"
		 CMD1CAPTION="Uvjeti:FILTERFORM" 
		 CMD3CAPTION="Detalji:DETALJI1" 
		 CMD4CAPTION="" 
		 CMD5CAPTION=""
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="" 
		 POPUPDETAIL=""
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname' " 
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"
		 COMMANDTIMEOUT="600"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="TRUE"
		 DETTOTALROWVISIBLE="TRUE"
		 ONLOAD2="" 
		 REPORT=""
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT="Period od @@datumod do @@datumdo"
		 PAGEHEADERLEFT="Djelatnik:@@operater"
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT="Trgovina: @@comboboxtrgovinaid"
		 PAGEFOOTERRIGHT=""
		 PAGEORIENTATION="PORTRAIT">



	<NAME>Pregled stimulacije djelatnika</NAME>
	<CAPTION>Pregled stimulacije djelatnika</CAPTION>
	<AUTOR>DP</AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spMPProvizije @action = 1 " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

	<FILTERFORM NAME="FILTERFORM"
		 HEIGHT="7300"
		 WIDTH="7700"
		 FILLEXPLORER="TRUE" 
		 CAPTION="Uvjeti"
		 ONSUBMIT="spMPPregstimulacije @action = 4, @nenc = @@nenc, @trgovinaid = @@trgovinaaid , @datumod = @@datumod, @datumdo = @@datumdo, @operateriid=@@operateriid,
		 @operateri2id = @@ooperateriid, @robnamarkaid = @@robnamarkaid, @robaid=@@robaid, @search='@@search', @klasaid=@@klasaid, @podklase=@@podklase!!"
		 ONLOAD="select @@trgovinaaid  as trgovinaaid, @@ooperateriid as ooperateriid, @@datumod as datumod, @@datumdo as datumdo"
		 NEXTFORM=""
		 FOCUS="Opis"
		 VERSION="1.1"
		 CMD1CAPTION=""
		 CMD2CAPTION="" >

		<INPUT TYPE="date"    NAME="datumod"   ALLOWEMPTY="FALSE" CAPTION="Datum od *" TOP="500" SQL=""  />
		<INPUT TYPE="date"    NAME="datumdo"   ALLOWEMPTY="FALSE" CAPTION="Datum do *" TOP="1000" SQL=""  />
		<INPUT TYPE="combo"    NAME="trgovinaaid"   ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="1500" SQL="spmpdajtrgovina @operateriid = @@operateriid"  />
		<INPUT TYPE="combo"    NAME="ooperateriid"   ALLOWEMPTY="TRUE" CAPTION="Operater*" TOP="2000" SQL="spMPDajOperatere"  />
		<INPUT TYPE="combo"    NAME="robnamarkaid"   ALLOWEMPTY="TRUE" CAPTION="Robna marka*" TOP="2500" SQL="select robnamarkaid , opis from robnamarka"  />
		
				<INPUT TYPE="search" NAME="robaid" CAPTION="Roba*"  TOP="3000"
				SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" /> 
					
		<INPUT TYPE="text" NAME="search" CAPTION="Traženje pojma*"   TOP="3500"/>
		<INPUT TYPE="search" NAME="klasaid" CAPTION="Klasa*"    TOP="4000"
				SQL="ViKlaseRobe#klmasterrobaid#Naziv%" /> 

		<INPUT TYPE="check" NAME="podklase" CAPTION="pokaži i sve podklase*"  TOP="4500" />

		<INPUT TYPE="button" NAME="ok" CAPTION="Odaberi" TOP="5200" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="OK"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="5200" LEFT="4000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	</FILTERFORM>

	<DETALJI NAME="POKAZI_FORM"
		 ONSUBMIT="spMPProvizije @action = 1 "
		 FILLEXPLORER="TRUE" >
	</DETALJI>

	<DETALJI1 	FILLEXPLORER="TRUE"
		   WIDTH="19500"
		   STORA=""
		   STARTUPSTORA=""
		   HEIGHT="7500"
		   CAPTION="Stavke operatera @@operater "
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Odustani"
		   CMD3CAPTION=""
		   NEXTFORM="">



		<INPUT TYPE="grid"
				NAME="analitika"
				REFRESHAFTERCHILD="TRUE"
				CAPTION=""
				TOP="200"
				LEFT="200"
				WIDTH="19000"
				HEIGHT="6000"
				DOCK="5"
				TABINDEX="5"
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT="Period od @@datumod do @@datumdo"
		 PAGEHEADERLEFT="Djelatnik:@@operater"
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT="Trgovina: @@comboboxtrgovinaid"
		 PAGEFOOTERRIGHT=""
		 PAGEORIENTATION="PORTRAIT"
			   SQL="spMPPregstimulacije @action = 3,  @operateri2id = @@id, @datumod = @@datumod, @datumdo = @@datumdo, @nenc = @@nenc"
                                          />

	</DETALJI1>

</PROJECT>