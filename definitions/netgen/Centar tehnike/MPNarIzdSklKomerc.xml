		<INPUT TYPE="combo"  NAME="sskladisteid"   CAPTION="Skladište*" TOP="854" LEFT="1490" WIDTH="3500" HEIGHT="294" ALLOWEMPTY="FALSE" SQL="spmpdajskladisteNG @trgovinaid = @@trgovinaid, @operateriid=@@operateriid, @oznaka = '070'"  />
