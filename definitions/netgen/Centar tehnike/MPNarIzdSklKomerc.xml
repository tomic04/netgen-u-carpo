		FOCUS="robaid" 
		ONLOAD="if (select status from maloprodajagla  where maloprodajaglaid = @@ID ) &lt;&gt; 1 or (select odobreno from maloprodajagla  where maloprodajaglaid = @@ID ) =1 begin 
				exec spRaiserror 69001, &apos;Dokument je ODOBREN. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spRaiserror 69001, &apos;Niste odabrali dokumant !&apos;
				end 
				else begin 
					exec spMPQueryGlaIDetNG @action=3 ,@ID=@@ID, @operateriid = @@operateriid
