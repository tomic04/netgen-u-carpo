<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '104', @nenc = 1, @veceodstatusa = 0 ,@manjeodstatusa = 2,@vrstadokid = @@vrstadokid " />





<UPDATE_FORM 
