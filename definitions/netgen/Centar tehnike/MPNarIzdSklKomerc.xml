<DONOSTERMINAL 
		FILLEXPLORER="" 
		WIDTH="13500" 
      		ONSUBMIT=""
		ONLOAD="spMPPrijenosTerminalNG @action=11, @operateriid = @@operateriid, @trgovinaid=@@trgovinaid, @trgovinacijena = @@trgovinaid,  @datumod=@@datumdok, @vrstadokid= @@vrstadokid" 		
		ONLOAD2="select 7 as  dana" 
		HEIGHT="10000" 
		CAPTION="Donos robe sa ručnog terminala" 
		>
    				<INPUT TYPE="grid" 
	                        NAME="donost" 
	                        TOP="700" 
	                        LEFT="200" 
	                        WIDTH="13000"
				CHECKBOXVISIBLE="FALSE" 
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"		
	                        HEIGHT="8000" 
        	                CAPTION="_Stavke za donos sa ručnog terminala"
	        		REFRESHAFTERCHILD="TRUE"
        			SQL="spMPPrijenosTerminalNG @action=33, @operateriid = @@operateriid, @trgovinaid=@@trgovinaid, @trgovinacijena = @@trgovinaid,  @datumod=@@datumdok, @vrstadokid = @@vrstadokid, @dana = @@dana" />
	<INPUT TYPE="label"    NAME="labelpromet" CAPTION="Pokaži promet u " TOP="250" LEFT="8100"   />
	<INPUT TYPE="number"   NAME="dana"      CAPTION="" TOP="200" LEFT="9500"  DECIMALS="0"  WIDTH="500" ONLOSTFOCUS="select 'refresh' as donost"/>
	<INPUT TYPE="label"    NAME="labeldana" CAPTION="dana" TOP="250" LEFT="10100"   />

	<INPUT TYPE="button" NAME="ok"      CAPTION="Prebaci"  TOP="9000" LEFT="456" WIDTH="1106" HEIGHT="322" 
