		 ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid, @asortimanMP=1, @trgovinaid = @@trgovinaid
						#if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @Skladisteid = @@skladisteid, @datum = @@datumdok,@partneriid = null, @vrstadokid = @@vrstadokid, @sifradok = '99' end
						#:PAKOVANJE22
						#exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid, @mpcijena = @@mpcijena, @indmpc = 1
						#select 'focus' as kolicina" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
		<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina*" TOP="2562" LEFT="1500" WIDTH="1296" HEIGHT="280" DECIMALS="4" SQL=""  />
		<INPUT TYPE="text"   NAME="jmnaziv"	      CAPTION="JM*" TOP="2562" LEFT="3372" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number"   NAME="kolpakovanje"	      CAPTION="Količina pakovanje*"  TOP="2562" LEFT="5770" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number"   NAME="indpak"	      CAPTION="" TOP="222562" LEFT="7770" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="mpcijena"	  CAPTION="MP Cijena*" TOP="2862" LEFT="1500" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL="select dbo.fnMPdajMPC(@@robaid, @@trgovinaid, @@datumdok )"  />
		<INPUT TYPE="number" NAME="nabcijena"	  CAPTION="Nabavna cijena*" TOP="3162" LEFT="1500" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="sktstanje"	  CAPTION="Kol.na skladištu*" TOP="3462" LEFT="1500" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="button" NAME="ok" 		      CAPTION="Dodaj (F8)" TOP="3550" LEFT="7280" WIDTH="1428" HEIGHT="322" ONCLICK="spMPInsertGlaIdetNG @action=3,@robaid=@@robaid,@id=@@id,@NabCijena=@@nabcijena,@kolicinaulaz=@@kolicina,@kolicinanaruceno = @@kolicina, @mpcijena=@@mpcijena, @porukagreska = 1, @indpakovanje= 1#select cmpiznos from maloprodajagla where maloprodajaglaid = @@id#select '' as roba , 'robaid' as focus, robaid = null, kolicina = 0, nabcijena = 0, mpcijena = 0, sktstanje = 0, 'refreshmovelast' as stavke " HOTKEY="F8" />

		<INPUT TYPE="grid" 
			   NAME="stavke" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="4140" LEFT="56" WIDTH="8750" HEIGHT="3078"
			   TABINDEX="-1"
			   AFTERREFRESH="select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU" 
			   EDITCOLUMNS="Naručena količina0800"
			   ONCELLEDITED="spMPInsertGlaIdetNG @action=4, @maloprodajadetid = @@stavke, @id = @@id, @kolicinaulaz = @(stavke..Naručena količina0800), @kolicinanaruceno = @(stavke..Naručena količina0800)#select 'stavke' as focus #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   CHECKBOXVISIBLE="FALSE"	
			   PAGEHEADERCENTER="Narudžba br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 1, @odobravanje = 1" />

		<INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno*" TOP="7322" LEFT="6594" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
	<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="7840" LEFT="196" WIDTH="1106" HEIGHT="322" ONCLICK="spMPInsertGlaIdetNG @action=2,@id = @@id, @operateriid=@@operateriid,@sifradok = '104',@datumdok= @@datumdok, @napomena = '@@napomena',@status=1,@osobeid = @@osobeid, @skladisteid = @@sskladisteid#Ok"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7840" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="zakljuci" CAPTION="Odobri" TOP="7840" LEFT="2688" WIDTH="1106" HEIGHT="322" ONCLICK=":ZAKLJUCI#OK"  />
	<INPUT TYPE="button" NAME="printaj" CAPTION="Print.dok" TOP="7840" LEFT="4186" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	<INPUT TYPE="button" NAME="ispravi" CAPTION="Ispravi" TOP="4500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
</UPDATE_FORM>

