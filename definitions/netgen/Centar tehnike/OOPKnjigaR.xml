<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      MASTERDBLCLICK="" 
      DETAILDBLCLICK=""
      ONLOAD=":FILTERFORM"
      TREE=""
      POPUPMASTER="Poveži djelatnika:PARTNERIFORM#Formiraj obustave:OBUSFORM"
      POPUPDETAIL=""
      BUTTONS="Filter:FILTERFORM" 
	  REPORT=""
      TIMER=""
      DETAILGRID=""
	  CHECKBOXVISIBLE="FALSE"
>
 
<NAME>Knjiga radnika</NAME>
<CAPTION>Knjiga radnika</CAPTION>







	<PARTNERIFORM WIDTH="6000" HEIGHT="2000" 
                        ONSUBMIT="" 
                        ONLOAD="select @@PKOsobeId as PKOsobeId"
						FILLEXPLORER=""
						CAPTION="Izbor djelatnika" 
						ONLOSTFOCUS="" 
						CMD1CAPTION="" 
						CMD2CAPTION="">


     <INPUT TYPE="label" NAME="" TOP="100" LEFT="200" WIDTH="1500" HEIGHT="500" CAPTION="Osoba:" ONCLICK="" />
    
	<INPUT TYPE="combo" NAME="HRKadroviid" CAPTION=""  TOP="100" LEFT="1900"  WIDTH="3200" HEIGHT="330" TABINDEX="0" 
			SQL="select  hrkadroviid, Naziv=rtrim(prezime)+' '+rtrim(ime) from hrkadrovi order by prezime,ime" 
			S1QL="select  hrkadroviid, Naziv=rtrim(prezime)+' '+rtrim(ime) from hrkadrovi where PKOsobeId is  null order by prezime,ime" 
			ONCLICK="" /> 

	<INPUT TYPE="button" NAME="" TOP="900" LEFT="200" WIDTH="1500" HEIGHT="500" CAPTION="Spremi" 
			ONCLICK="spHRHadroviPartneriPovezi @hrkadroviid=@@hrkadroviid,@PKOsobeId=@@PkOsobeId#OK" />
	
	</PARTNERIFORM>
	
	
	
	
	

<OBUSFORM WIDTH="4800" HEIGHT="2000" 
                        ONSUBMIT="" 
                        ONLOAD="select @@datumodid as datumod, @@datumdoid as datumdo"
						FILLEXPLORER=""
						CAPTION="Kreiranje obustava" 
						ONLOSTFOCUS="" 
						CMD1CAPTION="" 
						CMD2CAPTION="">


    
			
			
	<INPUT TYPE="button" NAME="" TOP="500" LEFT="400" WIDTH="1500" HEIGHT="500" CAPTION="Kreiraj" TABINDEX="1" 
			ONCLICK="spHRKadroviPartneriAzur @datumod=@@datumod,@datumdo=@@datumdo #OK" />
	
<INPUT TYPE="button" NAME="" TOP="500" LEFT="2500" WIDTH="1500" HEIGHT="500" CAPTION="Odustani" TABINDEX="2" 
			ONCLICK="CLOSE" />
	



	


	</OBUSFORM>
	
	
	
	<FILTERFORM WIDTH="9000" HEIGHT="1800" 
                        ONSUBMIT="spHRKadroviPartneriQuery @action=1," 
                        ONLOAD="spHRInterneObustave"
						FILLEXPLORER="TRUE"
						CAPTION="Razdoblje:" 
						ONLOSTFOCUS="" 
						CMD1CAPTION="" 
						CMD2CAPTION="">


     <INPUT TYPE="label" NAME="lbl1" TOP="370" LEFT="350" WIDTH="1000" HEIGHT="500" CAPTION="Razdoblje:" ONCLICK="" />
    
	<INPUT TYPE="date" NAME="DatumOd" CAPTION=""  TOP="350" LEFT="1400"  WIDTH="1500" HEIGHT="330" TABINDEX="0" 
			
			ONCLICK="" /> 
	 <INPUT TYPE="label" NAME="lbl2" TOP="350" LEFT="3200" WIDTH="800" HEIGHT="500" CAPTION="-" ONCLICK="" />		
			
	<INPUT TYPE="date" NAME="DatumDo" CAPTION=""  TOP="350" LEFT="3600"  WIDTH="1500" HEIGHT="330" TABINDEX="1" 
			
			ONCLICK="" /> 
			
			
	<INPUT TYPE="button" NAME="Butt" TOP="300" LEFT="6500" WIDTH="1500" HEIGHT="500" CAPTION="Prikaži" TABINDEX="2" 
			ONCLICK="OK" />
	
			
	
	

	
	


	</FILTERFORM>
	
	
</PROJECT>