<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="Stavke:STAVKE" 
      CMD3CAPTION="" 
      CMD4CAPTION="Ažuriraj:AZUR" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="" 
      DBLCLICKFORM="STAVKE"
      POPUP="">
 
  <NAME>Kontrola MP nivelacija</NAME>
  <CAPTION>Kontrola MP nivelacija</CAPTION>
 
  <KOMENTAR> </KOMENTAR>




  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spMPKontrolaNivelacija @action=1, @operateriid= @@operateriid, " 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Izaberi dokumente"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >




                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                   	TOP="1000" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      	TOP="1600" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                     	TOP="1500" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid "  /> 



  </FILTERFORM>



  <STAVKE 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         STORA="" 
                         STARTUPSTORA="select * from maloprodajagla where maloprodajaglaid = @@id" 
                         HEIGHT="8800" 
                         CAPTION="Stavke dokumenta nivelacije"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="Odustani"
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                                  CMD6CAPTION=""  
					
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lblBroj" 
                                      	TOP="300" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Broj dokumenta"/>
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					NAME="Broj" 
					TOP="200" 
					LEFT="2200" 
					CAPTION="Opis" 
					TEXT="" 
					WIDTH="1500" 
					HEIGHT="320" 
					TABINDEX="0" 
					ENABLED="FALSE" />

                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500"
                                   	HEIGHT="320"  
                                    	CAPTION="Datum dokumenta"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdok" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum dokumenta" 
                                   	VALUE="" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
					ENABLED="FALSE"
                                    	CHECKBOX="FALSE"/>


 

                      	<KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1900" LEFT="200" WIDTH="1500" CAPTION="Trgovina"/> 

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="select TrgovinaId,Opis as naziv  from trgovina order by 2" 
					TOP="1900" 
					LEFT="2200" 
					TEXT=""
					TABINDEX="4" 
					WIDTH="5500" 
					ENABLED="FALSE"
					HEIGHT="320"/>

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="2800" 
					LEFT="200"  
					WIDTH="13500" 
					HEIGHT="5000" 
					TABINDEX="5" 
                                        SQL="STORA="spMPKontrolaNivelacija  @action = 2,@id=@@id" 
                                          /> 


  </STAVKE>





  <AZUR
		WIDTH="5500" 
		STORA="STORA="spMPKontrolaNivelacija  3,@id=@@id" 
		STARTUPSTORA="select stat = case when status = 99 then 'Dokument je isporučen. Ne može se više isporučivati!' else 'Jeste li sigurni da želite ažurirati dokument '+(select broj from maloprodajagla where maloprodajaglaid = @@id )+' ?' end from maloprodajagla where maloprodajaglaid = @@id"		
		HEIGHT="3200" 
		CAPTION="AŽURIRATI  ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Ažuriraj"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="'Jeste li sigurni da želite ažurirati dokument '+(select broj from maloprodajagla where maloprodajaglaid = @@id )+' ?' end from maloprodajagla where maloprodajaglaid = @@id"/>
  </AZUR> 







</PROJECT>
 
