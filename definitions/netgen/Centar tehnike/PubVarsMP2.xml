<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  STARTUPSTORA="spMPpubVars @action=1"  
	  CMD1CAPTION="Filter:FILTERFORM" 
	  CMD2CAPTION="Novi:INSERTFORM" 
	  CMD3CAPTION="Ispravi:UPDATEFORM" 
	  CMD4CAPTION="Obriši:DELETEFORM" 
	  CMD5CAPTION="" 
	  CMD6CAPTION=""  
      	  REPORT="sktprometgla" 
      	  DBLCLICKFORM="UPDATEFORM"
	  POPUP="Dodaj:KORAK1#Izmjeni:UPDATEFORM#Obriši:DELETEFORM"
>
 
  <NAME>Pubvars wizzard</NAME>
  <CAPTION>Pubvars wizzard</CAPTION>


  <INSERTFORM WIDTH="8000" STORA="spMPpubVars @action=2,@id = @@id," STARTUPSTORA="" HEIGHT="2800" CAPTION="Izmjeni pubvars" BORDERSTYLE="3" CMD1CAPTION="Spremi" CMD2CAPTION="Odustani" CMD3CAPTION="" >
    		<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="VarIme"/>
    		<KONTROLA TYPE="VB.TextBox" NAME="VarIme" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="VarIme" TEXT="" WIDTH="5500" HEIGHT="320"/>
 
                <KONTROLA TYPE="VB.Label" NAME="lbl2" TOP="700" LEFT="200" WIDTH="1500" CAPTION="VarSet"/>
                <KONTROLA TYPE="VB.TextBox" NAME="VarSet" TOP="700" LEFT="2200" TABINDEX="1" CAPTION="VarSet" TEXT="" WIDTH="5500" HEIGHT="320"/>
 
                <KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1200" LEFT="200" WIDTH="1500" CAPTION="VarOpis"/>
                <KONTROLA TYPE="VB.TextBox" NAME="VarOpis" TOP="1200" LEFT="2200" TABINDEX="2" CAPTION="VarOpis" TEXT="" WIDTH="5500" HEIGHT="320"/>
  </INSERTFORM>
 

  <UPDATEFORM WIDTH="8000" STORA="spMPpubVars @action=3,@id = @@id, " 
		STARTUPSTORA="select * from pubVars where pubvarsid=@@id" HEIGHT="2800" CAPTION="Izmjeni pubvars" BORDERSTYLE="3" CMD1CAPTION="Spremi" CMD2CAPTION="Odustani" CMD3CAPTION="" >
    		<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="VarIme"/>
    		<KONTROLA TYPE="VB.TextBox" NAME="VarIme" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="VarIme" TEXT="" WIDTH="5500" HEIGHT="320"/>
 
                <KONTROLA TYPE="VB.Label" NAME="lbl2" TOP="700" LEFT="200" WIDTH="1500" CAPTION="VarSet"/>
                <KONTROLA TYPE="VB.TextBox" NAME="VarSet" TOP="700" LEFT="2200" TABINDEX="1" CAPTION="VarSet" TEXT="" WIDTH="5500" HEIGHT="320"/>
 
                <KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1200" LEFT="200" WIDTH="1500" CAPTION="VarOpis"/>
                <KONTROLA TYPE="VB.TextBox" NAME="VarOpis" TOP="1200" LEFT="2200" TABINDEX="2" CAPTION="VarOpis" TEXT="" WIDTH="5500" HEIGHT="320"/>
  </UPDATEFORM>




  <DELETEFORM WIDTH="8000" STORA="delete from  pubvars  where pubvarsid=@@id" STARTUPSTORA="select * from pubvars where pubvarsid=@@id" HEIGHT="2800" CAPTION="Obriši pubvars" BORDERSTYLE="3" CMD1CAPTION="Obriši" CMD2CAPTION="Odustani" CMD3CAPTION="" >
    		<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Brisanje 1,2 3, kreni!"/>
  </DELETEFORM>




  <FILTERFORM FILLEXPLORER="TRUE" REPORT=""  WIDTH="8000" STORA="select * from pubvars where varime like '%@@varime%'" STARTUPSTORA="" HEIGHT="2800" CAPTION=" Filter" BORDERSTYLE="3" CMD1CAPTION="Traži" CMD2CAPTION="Odustani" CMD3CAPTION=""  NEXTFORM=""  >
		<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Traži"/>
		<KONTROLA TYPE="VB.TextBox" NAME="VarIme" TOP="200" LEFT="2200" TABINDEX="0" CAPTION="Opis" TEXT="" WIDTH="5500" HEIGHT="320"/>
  </FILTERFORM>
 
  
</PROJECT>
 