<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT  CMD1CAPTION="Filter:FilterForm" CMD5CAPTION="Ispis:MULTISELECTPRINT" ONLOAD=":FilterForm" GROUPBYBOXVISIBLE="TRUE" FROZENCOLUMNS="0" CHECKBOXVISIBLE="true">
<NAME>Projekt</NAME>
<CAPTION>Tovarni list</CAPTION>
<KOMENTAR>CallistoII 2.3.5</KOMENTAR>
<HISTORY>
19.11.2009. SPIN\mcvenic - MARTINA
</HISTORY>

<FilterForm NAME="FilterForm" HEIGHT="6134" WIDTH="5386" CAPTION="Filter" ONLOAD ="select @@datumod as datumod, @@datumdo as datumdo, @@skladisteid as skladisteid" ONSUBMIT="spTovarniListQuery @Action=0," FILLEXPLORER="true" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
	<INPUT TYPE="date" NAME="datumdo" TOP="259" LEFT="3614" HEIGHT="302" WIDTH="1498" VISIBLE="True" TABINDEX="1" CAPTION="Do datuma:" ENABLED="True"/>
	<INPUT TYPE="label" NAME="lblDo" TOP="259" LEFT="2707" HEIGHT="288" WIDTH="950" VISIBLE="True" BOLD="FALSE" CAPTION="Do datuma:" ENABLED="True" TEXT="Do datuma:"/>
	<INPUT TYPE="date" NAME="datumod" TOP="259" LEFT="1037" HEIGHT="302" WIDTH="1498" VISIBLE="True" TABINDEX="2" CAPTION="Od datuma:" ENABLED="True" DEFAULT="firstdayofmonth"/>
	<INPUT TYPE="label" NAME="lblOd" TOP="259" LEFT="158" HEIGHT="288" WIDTH="864" VISIBLE="True" BOLD="FALSE" CAPTION="Od datuma:" ENABLED="True" TEXT="Od datuma:"/>
	<INPUT TYPE="combo" NAME="vrstapromid" TOP="749" LEFT="1613" HEIGHT="302" WIDTH="3038" VISIBLE="TRUE" TABINDEX="3"
	          SQL="select 9 as id, &apos;Nalog za otpremu&apos; as naziv 
                   union all
                   select 6 as id, &apos;Prijemni list&apos; as naziv
				   union all 
					select 104 , 'Izdatnica iz VP u MP '"
		   ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="FALSE" ENABLED="TRUE"/>
	<INPUT TYPE="label" NAME="Label20" TOP="749" LEFT="158" HEIGHT="288" WIDTH="1310" VISIBLE="TRUE" BOLD="FALSE" CAPTION="Vrsta dokumenta:" ENABLED="TRUE" TEXT="Label20"/>
	<INPUT TYPE="combo" NAME="skladisteid" TOP="1195" LEFT="1613" HEIGHT="302" WIDTH="3038" TABINDEX="4" SQL="select skladisteid, opis from skladiste order by oznaka" ALLOWEMPTY="true"/>
	<INPUT TYPE="label" NAME="Label22" TOP="1195" LEFT="158" HEIGHT="288" WIDTH="1310" CAPTION="Skladište:" TEXT="Label22"/>
	<INPUT TYPE="search" NAME="partneriid" TOP="1598" LEFT="1613" HEIGHT="302" WIDTH="3038" TABINDEX="5" SQL="partneri#partneriid#naziv%" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE"/>
	<INPUT TYPE="label" NAME="Label23" TOP="1598" LEFT="158" HEIGHT="288" WIDTH="1310" CAPTION="Kupac / Dobavljač:" TEXT="Label23"/>
	<INPUT TYPE="combo" NAME="trgovinaid" TOP="1978" LEFT="1613" HEIGHT="302" WIDTH="3038" TABINDEX="6" SQL="spmpDajTrgovina @operateriid = @@operateriid" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE"/>
	<INPUT TYPE="label" NAME="Label23" TOP="1998" LEFT="158" HEIGHT="288" WIDTH="1310" CAPTION="Trgovina:" TEXT="Label23"/>
	<INPUT TYPE="text" NAME="mjesto" TOP="2304" LEFT="1613" HEIGHT="288" WIDTH="3038" TABINDEX="7" />
	<INPUT TYPE="label" NAME="Label15" TOP="2304" LEFT="158" HEIGHT="288" WIDTH="1310" CAPTION="Mjesto:" TEXT="Label15"/>
	<INPUT TYPE="combo" NAME="osobeid" TOP="2750" LEFT="1613" HEIGHT="302" WIDTH="3038" TABINDEX="8" SQL="select o.osobeid, rtrim(coalesce(o.Ime,&apos;&apos;))+
					&apos; &apos; + rtrim(coalesce(o.Prezime,&apos;&apos;)) as Naziv 
					from osobe o
					inner join LnOsoPar op on o.OsobeId = op.OsobeId
					where op.ParStruId in (select ParStruId from ParStru
					where PartneriId = 
					(select Convert(integer,VarSet) from PubVars where VarIme =&apos;NasId&apos;))
					order by 2 asc"/>
	<INPUT TYPE="label" NAME="Label17" TOP="2750" LEFT="158" HEIGHT="288" WIDTH="1310" CAPTION="Vozač:" TEXT="Label17"/>
	<INPUT TYPE="text" NAME="regoznaka" TOP="3211" LEFT="1613" HEIGHT="288" WIDTH="3038" TABINDEX="9"/>
	<INPUT TYPE="label" NAME="Label16" TOP="3211" LEFT="158" HEIGHT="518" WIDTH="1310" CAPTION="Registarska oznaka:" TEXT="Label16"/>
	<INPUT TYPE="check" NAME="nezakljuceni" TOP="4306" LEFT="158" HEIGHT="288" WIDTH="3211" TABINDEX="10" CAPTION="Prikaži nezaključene dokumente" TEXT="Prikaži nezaključene dokumente"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="5098" LEFT="1282" HEIGHT="331" WIDTH="1080" TABINDEX="12" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" ENABLED="TRUE" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="5098" LEFT="130" HEIGHT="331" WIDTH="1080" TABINDEX="11" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" ENABLED="TRUE" ONCLICK="OK"/>

</FilterForm>

<MULTISELECTPRINT NAME="MULTISELECTPRINT" HEIGHT="1800" WIDTH="4867" CAPTION="Ispis">
	<INPUT TYPE="label" NAME="Label22" TOP="259" LEFT="288" HEIGHT="288" WIDTH="4118" CAPTION="Želite li ispisati tovarne listove za odabrane dokumente?"/>
	<INPUT TYPE="button" NAME="button1" TOP="806" LEFT="302" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG5" CAPTION="Prihvati" 
	       ONCLICK=":rs:/Konikom/rptKonikomTovarniList(@datumod=@@datumod,@datumdo=@@datumdo,@vrstapromid=@@vrstapromid,@mjesto=@@mjesto,@regoznaka=@@regoznaka,@osobeid=@@osobeid)#close"/>
	<INPUT TYPE="button" NAME="button2" TOP="806" LEFT="1454" HEIGHT="331" WIDTH="1080" TEXT="ButtonNG6" CAPTION="Odustani" ONCLICK="CLOSE"/>

</MULTISELECTPRINT>
</PROJECT>