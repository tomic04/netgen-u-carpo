<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id"
		 MASTERDBLCLICK=""
		 CMD1CAPTION="Parametri:FILTERFORM"
		 CMD2CAPTION=""
		 CMD3CAPTION="Izmjeni:IZMJENI"
		 CMD4CAPTION=""
		 CMD5CAPTION=""
		 CMD6CAPTION="Print dok.:vrstadokid-MaloprodajaGla"
		 CMD7CAPTION="Lista"
		 CMD8CAPTION=""
		 POPUPMASTER="Filter:FILTERFORM"
		 TREE=""
		 GROUPBYBOXVISIBLE="TRUE"
		 ONLOAD=":FILTERFORM"
		 MULTIGRIDLAYOUT="TRUE"
		 FROZENCOLUMNS="0"
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS=""
		 ONLOAD2=""
		 REPORT="">

	<NAME>Promjena datuma na dokumentima</NAME>
	<CAPTION>Promjena datuma na dokumentima</CAPTION>

	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="5254"
		WIDTH="7710"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid, @@vrstadokid as vrstadokid"
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="FALSE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="select VrstaDokId, Opis as naziv  from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra in (99,104,109,110,116,119)) order by 1" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina " ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
	</FILTERFORM>

	<IZMJENI NAME="IZMJENI"
	HEIGHT="3254"
	WIDTH="7710"
	CAPTION="Izmjeni datum na dokumentu "
	ONSUBMIT=""
	ONLOADED="select * from maloprodajagla where maloprodajaglaid = @@id#select 'novidatum' as focus"
	ONLOAD="if (select max(datumobrade) from mpobrada where trgovinaid = (select trgovinaid from maloprodajagla where maloprodajaglaid = @@id)) >= (select datumdok from maloprodajagla where maloprodajaglaid = @@id) begin exec spRaiserror 69001, &apos;Period za izabrani dokument je već zaključen!&apos;end "
	FILLEXPLORER=""
	NEXTFORM=""
	CMD1CAPTION=""
	CMD2CAPTION=""
	>
		<INPUT TYPE="text" NAME="broj" CAPTION="Broj dokumenta" ENABLED="FALSE"/>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta" ENABLED="FALSE"/>
		<INPUT TYPE="date" NAME="novidatum" CAPTION="Novi datum" ENABLED="TRUE" />
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Promjeni&gt;&gt;&gt;" TABINDEX="2" TOP="2400" LEFT="1280" WIDTH="1428" HEIGHT="322"
			   ONCLICK="if (select max(datumobrade) from mpobrada where trgovinaid = (select trgovinaid from maloprodajagla where maloprodajaglaid = @@id)) >= '@@novidatum' begin exec spRaiserror 69001, &apos;Period za upisani datum je već zaključen!&apos;end
			   #update  maloprodajagla set datumdok = '@@novidatum' where maloprodajaglaid = @@id#OK" 
			   ONLOSTFOCUS="" HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" 		CAPTION="Odustani" TABINDEX="3" TOP="2400" LEFT="3280" WIDTH="1428" HEIGHT="322" ONCLICK="close" HOTKEY="F8" />

	</IZMJENI>


	<VRSTADOKFORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node'" />

	<DATUM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = '@@node',  @vrstapromid = @@vrstapromid" />

	<OVAJMJ FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid, @node = 'ovajmj',  @vrstapromid = @@vrstapromid" />

	<DANAS_FORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas',  @vrstapromid = @@vrstapromid" />

	<JUCER_FORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @vrstapromid = @@vrstapromid" />

	<PROSLIMJESEC_FORM FILLEXPLORER="TRUE"
		ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',  @vrstapromid = @@vrstapromid" />


</PROJECT>