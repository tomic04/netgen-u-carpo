<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="" 
      CMD2CAPTION="Unos - F2:UNOSROBE" 
      CMD3CAPTION="Zaključi:ZAKLJUCI" 
      CMD4CAPTION="Filter:FILTERFORM" 
      CMD5CAPTION="Obriši:OBRISI" 
      CMD6CAPTION="Obriši sve:OBRISISVE"   
      CMD7CAPTION="Lista"   
      CMD8CAPTION=""  
      DBLCLICKFORM="" 
      POPUP=""
      REPORT=""
      RIGHTHEADER="tkosmomi1"
      GRIDALLOWEDIT = "TRUE" 
      GRIDALLOWADDNEW="FALSE"
      GRIDALLOWDELETE="TRUE"
      GRIDROWHEADERS="TRUE"
      GRIDALLOWEDITCOLUMNS = "" 
>
 
<NAME>MP nivelacija za više trgovina</NAME>
<CAPTION>MP nivelacija za više trgovina</CAPTION>

	<PRIKAZ FILLEXPLORER="TRUE" STORA="spMPNivelTotalGen" />

	<OBRISI FILLEXPLORER="TRUE" STORA="spMPNivelTotalGen @action=1,@id=@@id" />

	<OBRISISVE FILLEXPLORER="TRUE" STORA="spMPNivelTotalGen @action=2,@id=@@id" />



	<UNOSROBE 	FILLEXPLORER="TRUE" WIDTH="7600" 
                        STORA="spMPNivelTotalGen @action=0," 
                        STARTUPSTORA="select 1" 
			CANCELSTORA="spMPNivelTotalGen"
			HEIGHT="2800" 
			CAPTION="Unos robe" 
			BORDERSTYLE="3" 
			CMD1CAPTION="Spremi" 
			CMD2CAPTION="Odustani" 
			NEXTFORM="">

   			<KONTROLA TYPE="VB.Label" NAME="lbl1" TOP="200" LEFT="200" WIDTH="1500" CAPTION="Roba"/>
  			<KONTROLA TYPE="TRAZILICA" CAPTION="robaid" TABINDEX="0" NAME="robaid" SQL="viMPStanjeZaKasu#robaId#Naziv%#Userkod#Robakod" TOP="200" LEFT="2200" TEXT="" WIDTH="5000" HEIGHT="320"/>

	</UNOSROBE>

  	<FILTERFORM
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spMPNivelTotalGen " 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Izaberi uvjete"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >



                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Datum"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datum" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum" 
                                   	VALUE="" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>
                     	


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                   	TOP="1500" 
                                     	LEFT="200" 
                                     	WIDTH="1500"
                                   	HEIGHT="320"  
                                   	CAPTION="Trgovina"/>
                      	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                	CAPTION="Trgovina" 
                               		TOP="1400" 
                            		LEFT="2200"  
                                     	WIDTH="5500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="1" 
                              		ALLOWEMPTY="FALSE" 
                            		SQL="select trgovinaid,rtrim(oznaka)+' '+opis as naziv from trgovina order by 2"  /> 
 
 
  	</FILTERFORM>


  	<ZAKLJUCI
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spMPNivelTotalGen @action = 3, @operateriid = @@operateriid , " 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Izaberi dokumente"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >



                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Datum"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datum" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum" 
                                   	VALUE="" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>
                     	


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                   	TOP="1500" 
                                     	LEFT="200" 
                                     	WIDTH="1500"
                                   	HEIGHT="320"  
                                   	CAPTION="Trgovina"/>
                      	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                	CAPTION="Trgovina" 
                               		TOP="1400" 
                            		LEFT="2200"  
                                     	WIDTH="5500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="1" 
                              		ALLOWEMPTY="FALSE" 
                            		SQL="select top 1 t.trgovinaid , tr.opis as naziv from ##tempniv t inner join trgovina tr on t.trgovinaid = tr.trgovinaid where t.suser_sname=ltrim(rtrim(suser_sname())) and t.host_name=ltrim(rtrim(host_name())) "  /> 
 
 
  	</ZAKLJUCI>


 
</PROJECT>
 