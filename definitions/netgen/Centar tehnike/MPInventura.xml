		<INPUT TYPE="search" NAME="partneriid"  CAPTION="Partner*"   TOP="1400"  LEFT="5000" ENABLED="FALSE" SQL="vipartneri#partneriid#%naziv%#%mjestanaziv%#sifra#!adresa" BACKCOLOR="LIGHTYELLOW" />


