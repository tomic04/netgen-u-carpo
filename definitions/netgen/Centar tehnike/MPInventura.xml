		<INPUT TYPE="button" NAME="cancel" TABINDEX="12" CAPTION="Odustani" TOP="3300" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />
	</INSERTFORM>


	<UPDATE_FORM 
