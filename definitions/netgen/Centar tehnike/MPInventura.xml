		 SQL="select 1 as sortpoid, 'Klasifikacija + naziv robe' as naziv 
				union all 
				select 2 , 'Klasifikacija + pristupna šifra'
				union all 
				select 3 , 'Pristupna šifra ' 
				union all 
				select 4, 'Naziv robe'" 
			ALLOWEMPTY="FALSE" CAPTION="Sortirano po*"/>
