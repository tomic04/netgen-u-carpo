<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	ONLOAD=":FILTERFORM"  
	BUTTONS="Parametri:FILTERFORM#Pripremi promjenu stope:DONESI#Datum:DATUM#Promjena MPC:PROMMPC#Ispis:PRINTMASTER"
	POPUPMASTER="Dodaj:INSERTFORM#Obriši:DELETEFORM"
	GROUPBYBOXVISIBLE="TRUE"
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="FALSE"
	TREE="spTreeKlMasterRoba:KLASIFIKACIJA"
	EDITCOLUMNS="[Nova stopa], [Prom MPC]"
	ONCELLEDITED="spPdvPromjena @action = 3, @robaid= @@robaid, @datum = @@datumpromjene, @novastopa = @@Nova_stopa, @vpindcij = '@@Prom_VPC', @mpindcij =  '@@Prom_MPC' "
	FILLEXPLORER="TRUE">
	
	<NAME>Promjena stope PDV-a</NAME>
  <CAPTION>Promjena stope PDV-a</CAPTION>

	<KLASIFIKACIJA  FILLEXPLORER="TRUE" ONSUBMIT="spPdvPromjena @action=1, @klmasterrobaid=@@node, @datum = @@datumpromjene" />


	<INSERTFORM
		FILLEXPLORER=""
		WIDTH="9000" 
		HEIGHT="4000" 
		CAPTION="Odaberite artikal i odaberite novu stopu poreza">
	  
		<INPUT TYPE="search" NAME="robaid" CAPTION="Roba:*" TOP="200" LEFT="1000" WIDTH="5500" HEIGHT="320" SQL="viroba#robaid#naziv%#userid#barcode" />
		<INPUT TYPE="combo" NAME="NoviPoreziid" CAPTION="Nova stopa poreza:*" TOP="550" LEFT="1000" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" 
			SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv 
					from porezi p 
					inner join tarifa t on p.tarifaid = t.tarifaid 
					order by poreziid desc"  />

		<INPUT TYPE="button" NAME="ok" CAPTION="Dodaj" TOP="1000" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="exec spPdvPromjena @action = 2, @datum = @@datumpromjene,++"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="1000" LEFT="3000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />
	
</INSERTFORM>

	
<DONESIXX
		FILLEXPLORER="" 
		WIDTH="9000" 
		ONSUBMIT="spPdvPromjena @action = 4 , @operateriid = @@operateriid, @datum = @@datumpromjene," 
		ONLOAD="" 
		HEIGHT="8800" 
		CAPTION="Donos robe "  
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani"
		NEXTFORM="DONESI2"  >
	
		<INPUT TYPE="combo" NAME="NoviPoreziid" CAPTION="Nova stopa poreza:*" TOP="400" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />
		<INPUT TYPE="combo" NAME="StariPoreziid" CAPTION="Stara stopa poreza:*" TOP="800" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="TRUE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />
		<INPUT TYPE="search" NAME="klmasterrobaid" CAPTION="Klasa:*" TOP="1200" SQL="klmasterroba#klmasterrobaid#naziv%" WIDTH="5500" HEIGHT="320"/>


</DONESIXX>


<DONESI
		FILLEXPLORER="" 
		REPORT=""  
		WIDTH="11000" 
		ONSUBMIT="" 
		ONLOAD="spPdvPromjena @action = 10 , @operateriid = @@operateriid" 
		HEIGHT="8800" 
		CAPTION="Donos robeeeee "  
		BORDERSTYLE="3"
		CHECKBOXVISIBLE="FALSE"
		CMD1CAPTION="" 
		CMD2CAPTION=""
		CMD3CAPTION=""	 
		CMD4CAPTION=""
		CMD5CAPTION=""	 		 
		CMD6CAPTION=""  
		NEXTFORM=""  >
	
		<INPUT TYPE="combo" NAME="StariPoreziid" CAPTION="Stara stopa poreza:*" TOP="400" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />
		<INPUT TYPE="combo" NAME="NoviPoreziid" CAPTION="Nova stopa poreza:*" TOP="800" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />

	<INPUT TYPE="check" NAME="indmpc" CAPTION="Promjeni MPC:*" TOP="800" LEFT="6000" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />

	<INPUT TYPE="button" NAME="ok" CAPTION="Pokaži" TOP="800" LEFT="8000" WIDTH="1400" HEIGHT="322" 
		   ONCLICK="spPdvPromjena @action = 4 , @operateriid = @@operateriid, @datum = @@datumpromjene, @NoviPoreziid = @@NoviPoreziid, @StariPoreziid = @@StariPoreziid#select 'refresh' as stavke#select 'visible' as stavke"  />

	<INPUT TYPE="grid" NAME="stavke" VISIBLE="FALSE" CAPTION="Stavke" TOP="1200" LEFT="200" WIDTH="10000" HEIGHT="5500" CHECKBOXVISIBLE="FALSE" SQL="spPdvPromjena @action = 6 , @operateriid = @@operateriid" />

	<INPUT TYPE="button" NAME="ok" CAPTION="EVIDENTIRAJ" TOP="7500" LEFT="1500" WIDTH="1400" HEIGHT="322" 
		   ONCLICK="spPdvPromjena @action = 7 , @operateriid = @@operateriid,  @datum = @@datumpromjene, @NoviPoreziid = @@NoviPoreziid, @StariPoreziid = @@StariPoreziid, @indmpc = @@indmpc#OK"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7500" LEFT="3000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

</DONESI>

	
<NEODABRANO
		FILLEXPLORER="" 
		REPORT=""  
		WIDTH="12000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="8800" 
		CAPTION="Neodabrana roba za promjenu stope PDV-a"  
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""	 
		CMD4CAPTION=""
		CMD5CAPTION=""	 		 
		CMD6CAPTION=""  
		EDITCOLUMNS="Nova"
		ONCELLEDITED="spPdvPromjena @action = 3, @robaid= @@neodabrano, @datum = @@datumpromjene, @novastopa = @@GridNeodabranoNova_stopa_% "
		NEXTFORM=""  >
	
		<INPUT TYPE="grid" NAME="neodabrano" CAPTION="Neodabrano" TOP="200" LEFT="200" WIDTH="11000" HEIGHT="7500" SQL="spPdvPromjena @action = 8 , @datum = @@datumpromjene" />
</NEODABRANO>


<OBRISISTAVKU
		FILLEXPLORER="" 
		REPORT=""  
		WIDTH="7500" 
		ONSUBMIT="spPdvPromjena @action = 5, @operateriid = @@operateriid, " 
		ONLOAD="select robaid, naziv as roba from ##tempprompdv where robaid = @@stavke and operateriid = @@operateriid and susersname = suser_sname () " 
		HEIGHT="3900" 
		CAPTION="Želite li obrisati robu ? "  
		BORDERSTYLE="3" 
		CMD1CAPTION="Obriši" 
		CMD2CAPTION="Odustani">

		<INPUT TYPE="text" NAME="Roba" CAPTION="Roba_" WIDTH="3500" HEIGHT="320" ENABLED="FALSE" />
		<INPUT TYPE="text" NAME="robaid" CAPTION="Roba" TOP="700000" WIDTH="1500" HEIGHT="320" ENABLED="FALSE" />
</OBRISISTAVKU>


<FILTERFORM 
		FILLEXPLORER="TRUE" 
		REPORT=""  
		WIDTH="5000" 
		ONSUBMIT="spPdvPromjena @action = 1, " 
		ONLOAD="select '20120301' as datumpromjene" 
		HEIGHT="2800" 
		CAPTION="Upišite datum !"  
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION=""  
		NEXTFORM=""  >

		<INPUT TYPE="date" NAME="datumpromjene" CAPTION="Datum:*" TOP="700" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>

</FILTERFORM>


<IZMJENI
		WIDTH="8500" 
		ONSUBMIT="spPdvPromjena @action = 3, @robaid= @@id, @datum = @@datumpromjene" 
		ONLOAD="select convert(varchar(20),userid) +' ' +naziv as roba, p.poreziid as  StariPoreziid from roba r  inner  join porezi p on r.tarifaid = p.tarifaid where robaid = @@id"		
		HEIGHT="3200" 
		CAPTION="Izmjena stavke" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

		<INPUT TYPE="text" NAME="roba" TOP="400" CAPTION="Roba*" WIDTH="5500" HEIGHT="320"/>
		<INPUT TYPE="combo" NAME="NoviPoreziid" CAPTION="Nova stopa PDV-a:*" TOP="800" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE" SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid order by poreziid desc"  />
		<INPUT TYPE="combo" NAME="StariPoreziid" CAPTION="Stara stopa PDV-a:*" TOP="1200" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="FALSE" 
			   SQL="select poreziid, rtrim(t.naziv) +' '+ convert( varchar(10),p.stopa1)+'%'  as Naziv from porezi p inner join tarifa t on p.tarifaid = t.tarifaid where p.poreziid =  @@StariPoreziid order by poreziid desc"  />
</IZMJENI>


<DATUM
		WIDTH="5500" 
		ONSUBMIT="spPdvPromjena @action = 9, " 
		ONLOAD="select @@datumpromjene as staridatum"		
		HEIGHT="3200" 
		CAPTION="Želite li promjeniti datum promjene stope PDV-a ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Promjeni"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">
	
		<INPUT TYPE="date" NAME="staridatum" CAPTION="Stari datum:*" TOP="500" HEIGHT="320" WIDTH="1500" ENABLED="FALSE" CHECKBOX="FALSE"/>
		<INPUT TYPE="date" NAME="novidatum" CAPTION="Novi datum:*" TOP="1000" HEIGHT="320" WIDTH="1500" CHECKBOX="FALSE"/>
</DATUM>


	<PROMMPC
		WIDTH="11500"
		ONSUBMIT="spPdvPromjena @action = 11, @datum = @@datumpromjene,"
		ONLOAD=""
		HEIGHT="3200"
		CAPTION="Promjena MP cijene ???"
		BORDERSTYLE="3"
		CMD1CAPTION="Promjeni"
		CMD2CAPTION="Odustani"
		CMD3CAPTION=""
		CHILDFORM="">

		<INPUT TYPE="label" NAME="daprom" CAPTION="Ova izmjena se odnosi na sve artikle i poništit će sva dosadašnja podešavanja promjene MPC " STYLE="1" TOP="500" SIZE="11" LEFT="1000" HEIGHT="320" WIDTH="7500" ENABLED="TRUE" CHECKBOX="FALSE"/>
		<INPUT TYPE="check" NAME="daprom" CAPTION="Ima promjene MPC na svim artiklima" TOP="1100" LEFT="1000" HEIGHT="320" WIDTH="3500" ENABLED="TRUE" CHECKBOX="FALSE"/>
		<INPUT TYPE="check" NAME="neprom" CAPTION="Nema promjene MPC na svim artiklima" TOP="1600" LEFT="1000" HEIGHT="320" WIDTH="3500" CHECKBOX="FALSE"/>
	</PROMMPC>


</PROJECT>
 
