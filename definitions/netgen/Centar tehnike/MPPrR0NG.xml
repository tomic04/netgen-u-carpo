<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Račun:STAVKE" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		MASTERDBLCLICK="PROMET"
	        POPUPMASTER=""> 
 

  <NAME>Pregled stornirane robe na MP računima</NAME>
  <CAPTION>Pregled stornirane robe na MP računima</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spMPPregRobe0NG @action=11, " 
		ONLOAD="" 
		HEIGHT="4000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<INPUT TYPE="combo" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajTrgovina @operateriid=@@operateriid"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumod" 
                                   	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>
										
										
										
  </FORM1>
 <PROMET 	FILLEXPLORER="" 
		WIDTH="14000" 
		ONSUBMIT=":RS:/Konikom/MPDokumenti/rptMpRnl(@@STAVKE)" 
		ONLOAD="" 
		HEIGHT="7500" 
		CAPTION="Računi" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Ispis" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="Stavke:STAVKE" 
		NEXTFORM=""> 
		
		

			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="12000" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spMPPregRobe0NG @action=1,@id = '@@id',@datumod = @@datumod, @datumdo = @@datumdo , @trgovinaid = @@trgovinaid" 
                                          /> 

</PROMET>		

  <STAVKE 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         ONSUBMIT="" 
                         ONLOAD="" 
                         HEIGHT="8800" 
                         CAPTION="Stavke računa"  
						MASTERDBLCLICK=""
                         BORDERSTYLE="3" 
                                  CMD2CAPTION="KRAJ"
                                  NEXTFORM=""  >



			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					WIDTH="11500" 
					HEIGHT="7000" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					TABINDEX="5" 
                      SQL="spMPBlagajnaQueryGlaIdetNG @action=2,@id = @@mpblagajnaglaid" 
                                          /> 


  </STAVKE>


</PROJECT> 