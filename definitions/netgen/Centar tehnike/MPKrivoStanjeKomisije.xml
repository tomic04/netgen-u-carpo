<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="Kartica:MPKARTICA (@skladisteid = @@Trgovinaid, @mastergrid = @@id, @datod = @@datumod, @datdo = @@datumdo )" 
      CMD3CAPTION="Komisijske trgovine:KOMTRG" 
      CMD4CAPTION="" 
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT=""
	COMMANDTIMEOUT="600"
	  SETDEFAULTS="select 2 as totalgen"	
	  GROUPBYBOXVISIBLE="TRUE" 
	  INCLUDE="MPKarticaRobe.xml" 
	  MASTERDBLCLICK=":MPKARTICA"
      POPUPMASTER="">
 
  <NAME>Kontrola komisijske robe - kriva stanja </NAME>
  <CAPTION>Kontrola komisijske robe - kriva stanja </CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>




  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="9000" 
                         ONSUBMIT="spmpKontrolaKomisijskeRobe  @action = 4 , " 
                         ONLOAD="select @@trgovinaid as trgovinaid , @@datumdo as datumdo , CONVERT(char(4),year(getdate()))+'0101'as datumod" 
                         HEIGHT="3800"
                         CAPTION="Upišite uvjete "  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži ->>" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

	  <INPUT TYPE="combo" 
					  NAME="Trgovinaid" 
					  CAPTION="Trgovina" 
					  WIDTH="5500" 
				  HEIGHT="320" 
					  TABINDEX="1" 
				  ALLOWEMPTY="TRUE" 
				  SQL="spMPDajTrgovina @@operateriid"  />



                     	<INPUT TYPE="date" 
	                               	NAME="datumdo" 
                                   	CAPTION="Stanje na dan" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
									ONCLICK="select CONVERT(char(4),year(@@datumdo))+'0101'as datumod#select 'refresh' as datumod"
                                    	CHECKBOX="FALSE"/>

	  <INPUT TYPE="date"
				  NAME="datumod"
				  CAPTION="Stanje na dan"
				  VALUE="DATE"
				  HEIGHT="320"
					TOP="-1000"
				  WIDTH="1500"
				  TABINDEX="3"
					  CHECKBOX="FALSE"/>



  </FILTERFORM>


	<KOMTRG
		HEIGHT="5500"
		WIDTH="5800"
		CAPTION="Trgovine u kojima ima komisijske robe "
		ONSUBMIT=""
		CHECKBOXVISIBLE="FALSE"
		ONLOAD="">


		<INPUT TYPE="grid" NAME="komtrg" TOP="800" LEFT="200" WIDTH="5000" HEIGHT="3000"
					CAPTION="Komisijske trgovine "
					TOTALROW="FALSE"
					CHECKBOXVISIBLE="FALSE"
					PAGEHEADERCENTER=""
					PAGEHEADERRIGHT=""
					PAGEHEADERLEFT=""
					PAGEFOOTERCENTER=""
					PAGEFOOTERLEFT=""
					PAGEFOOTERRIGHT=""
					PAGEORIENTATION="LANDSCAPE"
					SQL="exec spmpKontrolaKomisijskeRobe  @action=2">

			<COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
			<COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
			<COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>

		<INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="4000" LEFT="200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>

	</KOMTRG>

	<OBNOVA
		HEIGHT="5500"
		WIDTH="5800"
		CAPTION="Trgovine u kojima ima komisijske robe "
		ONSUBMIT=""
		CHECKBOXVISIBLE="FALSE"
		ONLOAD="spmpKontrolaKomisijskeRobe @action = 3 , @trgovinaid = @@trgovinaid">



	</OBNOVA>



</PROJECT>
 
