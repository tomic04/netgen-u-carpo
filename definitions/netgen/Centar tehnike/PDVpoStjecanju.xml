<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Prikaz:FILTERFORM" 
      CMD2CAPTION="Prebaci u knjigu IRA:PREBACIFORM " 
      CMD3CAPTION="Ispis:PRINTMASTER" 
      POPUPMASTER=""
      MASTERDBLCLICK=""
      CHECKBOXVISIBLE="FALSE"  
      PAGEHEADERCENTER=""
      PAGEHEADERRIGHT="u periodu: @@datod do @@datdo"
	  PAGEHEADERLEFT=""
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@tkosmomi##@@mjesto"
	  PAGEFOOTERRIGHT="@@datdanas##Jupiter Software by SPIN"
	  PAGEORIENTATION="LANDSCAPE"	  

      >

 
  <NAME>PDV po stjecanju</NAME>
  <CAPTION>PDV po stjecanju</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
   
   
   
   
   <FILTERFORM 
					
                 WIDTH="4300" 
                 ONLOAD="select @@datod as datod , @@datdo as datdo ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas,
                         (select m.naziv  from partneri p
			 inner join parstru ps on ps.partneriid=p.partneriid
			 inner join mjesta m on m.mjestaid=ps.mjestaid
			 where p.partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))
			 and ps.hqind='*') AS mjesto"
                 ONSUBMIT="spKntPDVpoStjecanju @action=0, "                                                               
                 HEIGHT="2000" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Izvrši" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER="TRUE"
  		 >
  	        <INPUT TYPE="date" CAPTION="Datum od:" NAME="datod" DEFAULT="firstdayoflastmonth" TABINDEX="0"  WIDTH="1200" HEIGHT="320"/>
        
		<INPUT TYPE="date" CAPTION="Datum do:" NAME="datdo" TABINDEX="3" WIDTH="1200" HEIGHT="320"/> 
	
                 />
                           

  </FILTERFORM>







<PREBACIFORM   CAPTION="Prebaci u IRU" HEIGHT="1700" WIDTH= "4200" 
		   FILLEXPLORER="" 
                   ONLOAD="" 
                   ONSUBMIT="spKntPDVpoStjecanju @action=1,@operateriid=@@operateriid"
                   CMD1CAPTION="OK" 
                   CMD2CAPTION="Odustani" 
                   NEXTFORM="" >

                 <INPUT TYPE="label" NAME="lblpitanje" TOP="300" LEFT="250" WIDTH="400" CAPTION="Jeste li sigurni da želite prebaciti?"/>
     
             
  </PREBACIFORM>

</PROJECT>
 


