<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="Etikete.clsEtiketeVP" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Etikete"  
		DBLCLICKFORM=""
	        POPUP=""> 
 

  <NAME>Pregled robe po skladištima</NAME>
  <CAPTION>Pregled robe po skladištima</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		STORA="spSKTPregRobeSkladiste @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="skladisteid" 
                                    	CAPTION="Skladište" 
                                    	WIDTH="4500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select skladisteid, rtrim(oznaka)+ ' ' +opis as naziv from skladiste"/>

			
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


			<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="stanje" 
                               		WIDTH="4000" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži samo robe kojima je stanje različito od 0"/>

  </FORM1>

 <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="9500" 
		CAPTION="Krtica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="14500" HEIGHT="8000" TABINDEX="2" 
                         SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid " /> 
</KARTICA>		

</PROJECT> 