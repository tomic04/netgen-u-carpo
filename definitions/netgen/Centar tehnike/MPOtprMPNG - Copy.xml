<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
	SETDEFAULTS="spmpPermissionNG @action = 0, @operateriid = @@operateriid, @object= '@@xmlname' , @sifradok = '303'"
	ONLOAD=""
	ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end , 
			'Zakljuci' = case when @@Zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 
			'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end "
	DETAILGRID = "spMPOtpremaNG @action=4,@operateriid=@@operateriid,@id=@@id"
	MASTERDBLCLICK="UPDATE_FORM"
	BUTTONS="Parametri:FILTERFORM#Dodaj:INSERTFORM#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Isporuči:ISPORUCI#Print dok.:vrstadokid-MPOtpremaGla"
	POPUPMASTER="Parametri:FILTERFORM#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Isporuči:ISPORUCI#Poništi:PONISTI" 
	TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
	GROUPBYBOXVISIBLE="TRUE"
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="FALSE"
	DETTOTALROWVISIBLE="FALSE"
	DETCHECKBOXVISIBLE="FALSE"
	REPORT="">



	<NAME>Otprema iz MP</NAME>
	<CAPTION>Otprema iz MP</CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid,@node='danas'" />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid,@node='jucer'" />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid,@node='ovajmj'" />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid,@node='proslimj'" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid,@node='@@node'" />


<INSERTFORM NAME="INSERTFORM" HEIGHT="4500" WIDTH="11000" 
	CAPTION="Unos nove dostave iz maloprodaje"
	ONLOAD="select convert(varchar,getdate(),112) as datumdok, null as bojracuna" 
	FOCUS="datumdok" 
	NEXTFORM="UPDATE_FORM" >

	<INPUT TYPE="frame"  NAME="fr1"  CAPTION="Zaglavlje:" TOP="28" LEFT="50" WIDTH="11500" HEIGHT="3300" STYLE="1" DOCK="1"/>
	<INPUT TYPE="frame"  NAME="fr3"  CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />
	
	<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:*" TOP="400" LEFT="1500" WIDTH="1500"/>
	<INPUT TYPE="combo" NAME="trgovinaid"  CAPTION="Trgovina:*" TOP="400" LEFT="7000" WIDTH="3500"  ALLOWEMPTY="FALSE" 
		   SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" />
	<INPUT TYPE="text" NAME="brojdok" CAPTION="_Broj dokumenta:*" TOP="750" LEFT="1500" WIDTH="2500" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="BrojRacuna" CAPTION="Broj računa:*" TOP="750" LEFT="7000" WIDTH="3500"  />
	<INPUT TYPE="text" NAME="Kupac" CAPTION="Kupac:*" TOP="1100" LEFT="1500" WIDTH="9000" />
	<INPUT TYPE="text" NAME="Adresa" CAPTION="Adresa:*" TOP="1450" LEFT="1500" WIDTH="9000" />
	<INPUT TYPE="text" NAME="Telefon" CAPTION="Telefon:*" TOP="1800" LEFT="1500" WIDTH="2500" />
	<INPUT TYPE="combo" NAME="Mjestaid"  CAPTION="Mjesto:*" ALLOWEMPTY="FALSE" TOP="1800" LEFT="7000" WIDTH="3500" 
		   SQL="select mjestaid, naziv  from mjesta order by naziv" />
	<INPUT TYPE="date" NAME="planiranidatumotpreme" TOP="2150" LEFT="2000" WIDTH="2000" CAPTION="Planirani datum otpreme:*" />
	<INPUT TYPE="combo" NAME="skladisteid" CAPTION="Skladište:*" TOP="2150" LEFT="7000" WIDTH="3500" ALLOWEMPTY="TRUE" 
		   SQL="spmpdajskladiste @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" />
	<INPUT TYPE="combo" NAME="nacinisporuke"  CAPTION="Način isporuke:*" TOP="2500" LEFT="1500" WIDTH="2500" ALLOWEMPTY="FALSE" 
		   SQL="select 1 as nacinisporuke, 'Osobno' as naziv union all select 2 as nacinisporuke, 'Dostava' as naziv order by 1 desc" />
	<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena:*" TOP="2850" LEFT="1500" WIDTH="9000"/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Stavke&gt;&gt;&gt;" ANCHOR="6" TOP="3600" LEFT="8000" WIDTH="1400" HEIGHT="322"
		ONCLICK="#if (@@skladisteid is not null and @@skladisteid not in (select skladisteid from lntrgovinaskladiste where trgovinaid=@@trgovinaid)) begin exec spRaiserror 69001, &apos;Potrebno je odabrati odgovarajuće skladište !&apos;return end 
				 #exec spMPOtpremaNG @action=2, @operateriid=@@operateriid, ++#ok#:UPDATEFORM"  />
	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" ANCHOR="6" TOP="3600" LEFT="1000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

	
</INSERTFORM>



<UPDATE_FORM 
		CAPTION="Izmjeni dokument : @@brojdok [ @@id ]" 
		HEIGHT="9500" 
		WIDTH= "11000" 
		FILLEXPLORER="" 
		FOCUS="robaid" 
		ONLOAD="if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 2 begin 
					exec spRaiserror 69001, 'Dokument je zaključen. Ne može se više ispravljati !' 
				end	else begin
				if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 3 begin
					exec spRaiserror 69001, 'Dokument je isporučen. Ne može se više ispracvljati !' 
				end else begin
				if coalesce(@@id,0) = 0  begin 
					exec spRaiserror 69001, &apos;Niste odabrali dokument !&apos;
				end else begin 
				exec spMPOtpremaNG @action=11,@ID=@@ID end end end" >

	<INPUT TYPE="frame"  NAME="fr4"           CAPTION=""  WIDTH="1800" STYLE="1" DOCK="4" />
	<INPUT TYPE="frame"  NAME="fr2"           CAPTION="Nova stavka dokumenta :" TOP="3300" LEFT="50" WIDTH="11500" HEIGHT="1100"   STYLE="1" DOCK="1"  />
	<INPUT TYPE="frame"  NAME="fr1"           CAPTION="Zaglavlje:" TOP="28" LEFT="50" WIDTH="11500" HEIGHT="3300"  STYLE="1" DOCK="1" />
	<INPUT TYPE="frame"  NAME="fr3"           CAPTION=""  HEIGHT="800"  STYLE="1" DOCK="2" />

	
	<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta:*" TOP="400" LEFT="1500" WIDTH="1500"/>
	<INPUT TYPE="combo" NAME="trgovinaid"  CAPTION="Trgovina:*" TOP="400" LEFT="7000" WIDTH="3500"  ALLOWEMPTY="FALSE"
		   SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="brojdok" CAPTION="_Broj dokumenta:*" TOP="750" LEFT="1500" WIDTH="2500" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="BrojRacuna" CAPTION="Broj računa:*" TOP="750" LEFT="7000" WIDTH="3500"  />
	<INPUT TYPE="text" NAME="Kupac" CAPTION="Kupac:*" TOP="1100" LEFT="1500" WIDTH="9000" />
	<INPUT TYPE="text" NAME="Adresa" CAPTION="Adresa:*" TOP="1450" LEFT="1500" WIDTH="9000" />
	<INPUT TYPE="text" NAME="Telefon" CAPTION="Telefon:*" TOP="1800" LEFT="1500" WIDTH="2500" />
	<INPUT TYPE="combo" NAME="Mjestaid"  CAPTION="Mjesto:*" ALLOWEMPTY="FALSE" TOP="1800" LEFT="7000" WIDTH="3500"
		   SQL="select mjestaid, naziv  from mjesta order by naziv" />
	<INPUT TYPE="date" NAME="planiranidatumotpreme" TOP="2150" LEFT="2000" WIDTH="2000" CAPTION="Planirani datum otpreme:*" />
	<INPUT TYPE="combo" NAME="skladisteid" CAPTION="Skladište:*" TOP="2150" LEFT="7000" WIDTH="3500" ALLOWEMPTY="TRUE"
		   SQL="spmpdajskladiste @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" />
	<INPUT TYPE="combo" NAME="nacinisporuke"  CAPTION="Način isporuke:*" TOP="2500" LEFT="1500" WIDTH="2500" ALLOWEMPTY="FALSE"
		   SQL="select 1 as nacinisporuke, 'Osobno' as naziv union all select 2 as nacinisporuke, 'Dostava' as naziv order by 1 desc" />
	<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena:*" TOP="2850" LEFT="1500" WIDTH="9000"/>
	
	<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="3500" LEFT="1500" WIDTH="8000" ALLOWEMPTY="FALSE" HEIGHT="280" 
		SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" 
		ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid
				#if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @datum = @@datumdok, @vrstadokid = @@vrstadokid end
				#if @@robaid is not null begin exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid, @indmpc = 1 ,@mpcijena = @@mpcijena end" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
	<INPUT TYPE="text"   NAME="jmnaziv"	  CAPTION="JM*" TOP="3500" LEFT="9800" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
	<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina*" TOP="3850" LEFT="1500" WIDTH="1500" HEIGHT="280" DECIMALS="4" SQL=""  />
	<INPUT TYPE="number" NAME="nabcijena"	  CAPTION="Nabavna cijena*" TOP="3850" LEFT="4500" WIDTH="1500" HEIGHT="280" ENABLED="FALSE" SQL=""  />
	<INPUT TYPE="number" NAME="mpcijena"	  CAPTION="MP Cijena*" TOP="3850" LEFT="7000" WIDTH="1500" HEIGHT="280" ENABLED="FALSE" SQL=""  />

	<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dodaj (F8)" TOP="3850" LEFT="9100" WIDTH="1428" HEIGHT="322" 
		ONCLICK="spMPOtpremaNG @action=3,@robaid=@@robaid,@id=@@id,@kolicina=@@kolicina
				#select '' as roba , 'robaid' as focus, robaid = null, kolicina = 0, nabcijena = 0, mpcijena = 0, 'refreshmovelast' as stavke " HOTKEY="F8" />

	<INPUT TYPE="grid" DOCK="5"
		   NAME="stavke" 
		   REFRESHAFTERCHILD="TRUE" 
		   CAPTION="Stavke" 
		   TOP="4500" LEFT="56" WIDTH="8500" HEIGHT="3000"
		   AFTERREFRESH=""
		   POPUP="Obriši:BRISISTAVKU"
		   ONDBLCLICK=":IZMJENISTAVKU" 
		   EDITCOLUMNS="[Količina1200]"
		   ONCELLEDITED="spMPOtpremaNG @action=33, @stavke = @@stavke, @id = @@id, @kolicina = @@gridstavkeKoličina#select 'stavke' as focus"
		   CHECKBOXVISIBLE="FALSE"	
		   PAGEHEADERCENTER="Dokument br.@@broj"
		   PAGEHEADERRIGHT=""
		   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
		   PAGEFOOTERCENTER=""
		   PAGEFOOTERLEFT=""
		   PAGEFOOTERRIGHT="@@tkosmomi"
		   PAGEORIENTATION="LANDSCAPE"
		   GROUPBYBOXVISIBLE="FALSE"
		   TOTALROW="FALSE"
		   SQL="spMPOtpremaNG @action=4,@operateriid=@@operateriid,@id=@@id" />


	<INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" ANCHOR="6" TOP="8600" LEFT="196" WIDTH="1106" HEIGHT="322" 
		   ONCLICK="spMPOtpremaNG @action=22,@id=@@id, @operateriid=@@operateriid, @datumdok=@@datumdok, @brojracuna='@@brojracuna', @skladisteid=@@skladisteid, @kupac='@@kupac', 
						@mjestaid=@@mjestaid, @adresa='@@adresa', @telefon='@@telefon', @planiranidatumOtpreme='@@planiranidatumOtpreme', @nacinisporuke=@@nacinisporuke, @napomena = '@@napomena'
						#Ok" HOTKEY="F2" />
	<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" ANCHOR="6" TOP="8600" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

	<INPUT TYPE="button" NAME="ispravi"  CAPTION="Ispravi" ANCHOR="9" TOP="5000" LEFT="9300" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
	<INPUT TYPE="button" NAME="obrisi"  CAPTION="Obriši" ANCHOR="9" TOP="5500" LEFT="9300" WIDTH="1400" HEIGHT="322" ONCLICK=":BRISISTAVKU"  />

</UPDATE_FORM>

	

<BRISISTAVKU 
	NAME="BRISISTAVKU"
	HEIGHT="3000" WIDTH="7500"
	CAPTION="Brisanje stavke"
	ONLOAD="spMPOtpremaNG @action = 44, @stavke = @@stavke" >

	<INPUT TYPE="text"   NAME="sifra"       CAPTION="Šifra"      HEIGHT="317" WIDTH="2000" ENABLED="FALSE"/>
	<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="5000"  ENABLED="FALSE"/>
	<INPUT TYPE="number" NAME="kolicina"	CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="FALSE" />

	<INPUT TYPE="button" NAME="ok"           CAPTION="Obriši"   TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spMPOtpremaNG @action = 8, @stavke = @@stavke, @id = @@id#select 'refresh' as stavke#Ok"  HOTKEY="F2" />
	<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</BRISISTAVKU>



<IZMJENISTAVKU 
	NAME="IZMJENISTAVKU"
	HEIGHT="3000" WIDTH="7500"
	CAPTION="Ispravak stavke"
	FOCUS="kolicina"
	ONLOAD="spMPOtpremaNG @action = 44, @stavke = @@stavke">

	<INPUT TYPE="text"   NAME="sifra"       CAPTION="Šifra"      HEIGHT="317" WIDTH="2000" ENABLED="FALSE"/>
	<INPUT TYPE="text"   NAME="roba"         CAPTION="Naziv robe" HEIGHT="317" WIDTH="5000"  ENABLED="FALSE"/>
	<INPUT TYPE="number" NAME="kolicina"	CAPTION="Količina"   HEIGHT="302" WIDTH="1500"  DECIMALS="4" ENABLED="TRUE" />

	<INPUT TYPE="button" NAME="ok"            CAPTION="Spremi (F2)"  TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322"
		ONCLICK="spMPOtpremaNG @action = 33, @stavke = @@stavke, @id = @@id, @kolicina=@@kolicina#select 'refresh' as stavke#Ok"  HOTKEY="F2" />
	<INPUT TYPE="button" NAME="cancel"        CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</IZMJENISTAVKU>

	
	
<FILTERFORM 
	NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPOtpremaNG @action=1,@operateriid=@@operateriid, "
	ONLOAD="select @@datumod as datumod, @@datumdo as datumdo" 
	FILLEXPLORER="TRUE" 
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >

	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofmonth"/>
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
	<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @vrstatrg='M'" />
	<INPUT TYPE="combo" NAME="skladisteid" ALLOWEMPTY="TRUE" CAPTION="Skladište" SQL="spmpdajskladiste @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" />
	<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="TRUE" CAPTION="Status" SQL="select 1 as status,&apos;Otvoren &apos; as naziv union all select 2 as status,&apos;Zaključen &apos; as naziv" />
	<INPUT TYPE="text" NAME="trazibroj" WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta" ONLOSTFOCUS=""/>
	<INPUT TYPE="text" NAME="kupac" WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Kupac" ONLOSTFOCUS=""/>
</FILTERFORM>



<ZAKLJUCI 
	NAME="ZAKLJUCI" HEIGHT="3197" WIDTH="5501" 
	CAPTION="Zaključiti dokument ?" 
	ONSUBMIT="spMPOtpremaNG @action=5, @id=@@id"
	ONLOAD="if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 2 begin 
				exec spRaiserror 69001, 'Dokument je Zaključen. Ne može se više zaključiti!' 
			end
			else if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 3 begin
				exec spRaiserror 69001, 'Dokument je isporučen. Ne može se više zaključiti  !' 
			end
			else if (select count(*) from mpotpremadet where mpotpremaglaid = @@ID ) = 0 begin
				exec spRaiserror 69001, 'Nema stavaka. Ne može se zaključiti !' 
			end
			else begin
			exec spMPOtpremaNG @action=11,@ID=@@ID
			end" 
	FILLEXPLORER="" 	
	CMD1CAPTION="Zaključi" 
	CMD2CAPTION="Odustani" >

	<INPUT TYPE="text"  NAME="brojdok" TOP="360" LEFT="1500" HEIGHT="317" WIDTH="2500" CAPTION="_Broj dokumenta:*" ENABLED="FALSE"/>
	<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? " />
</ZAKLJUCI>



<ISPORUCI
	NAME="ISPORUCI" 
	HEIGHT="3197" WIDTH="5501" 
	CAPTION="Isporučiti dokument ?" 
	ONSUBMIT="spMPOtpremaNG @action=6, @id=@@id,"
	ONLOAD="if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 1 begin 
				exec spRaiserror 69001, 'Dokument je otvoren. Ne može otpremiti !' 
			end
			else if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 3 begin
				exec spRaiserror 69001, 'Dokument je isporučen. Ne može se više isporučiti  !' 
			end
			else begin
				exec spMPOtpremaNG @action=11,@ID=@@ID
			end"
	FILLEXPLORER="" 
	CMD1CAPTION="Isporuči" CMD2CAPTION="Odustani"	>

	<INPUT TYPE="text"  NAME="brojdok" TOP="400" LEFT="1500" HEIGHT="317" WIDTH="2500" CAPTION="_Broj dokumenta:*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="BrojRacuna" CAPTION="_Broj računa:*" TOP="800" LEFT="1500" WIDTH="2500" ENABLED="FALSE" />
	<INPUT TYPE="date" NAME="datumotpreme" CAPTION="Datum isporuke:*" TOP="1200" LEFT="1500" WIDTH="1500"/>
	<INPUT TYPE="label" NAME="stat" TOP="1800" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite zaključiti isporuku dokumenta  ? " />
</ISPORUCI>



<PONISTI
	NAME="PONISTI"
	HEIGHT="3197" WIDTH="5501"
	CAPTION="Poništiti dokument ?"
	ONSUBMIT="spMPOtpremaNG @action=7, @id=@@id"
	ONLOAD="if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 1 begin 
				exec spRaiserror 69001, 'Dokument je otvoren. Ne može ga otvoriti !' 
			end
			else if (select status from mpotpremagla where mpotpremaglaid = @@ID ) = 3 begin
				exec spRaiserror 69001, 'Dokument je isporučen. Ne može se više poništiti  !' 
			end
			else begin
				exec spMPOtpremaNG @action=11,@ID=@@ID
			end"
	FILLEXPLORER=""
	CMD1CAPTION="Poništi" CMD2CAPTION="Odustani"	>

	<INPUT TYPE="text"  NAME="brojdok" TOP="400" LEFT="1500" HEIGHT="317" WIDTH="2500" CAPTION="_Broj dokumenta:*" ENABLED="FALSE"/>
	<INPUT TYPE="text" NAME="BrojRacuna" CAPTION="_Broj računa:*" TOP="800" LEFT="1500" WIDTH="2500" ENABLED="FALSE" />
	<INPUT TYPE="label" NAME="stat" TOP="1800" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite poništiti dokumenta  ? " />
</PONISTI>

</PROJECT>