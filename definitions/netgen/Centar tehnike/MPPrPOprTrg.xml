<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		STARTUPSTORA=":FORM1"
		REPORT=""
		CMD1CAPTION="Parametri:FORM1"
		CMD2CAPTION=""
		CMD3CAPTION="Detalji:DETALJI"
		CMD4CAPTION=""
 		CMD5CAPTION=""
		CMD6CAPTION=""
		CMD7CAPTION="Lista"
		CMD8CAPTION="Dokument"
		DBLCLICKFORM=""
	        POPUP="">


	<NAME>Pregled prometa po operateru - Trgovina </NAME>
	<CAPTION>Pregled prometa po operateru - Trgovina</CAPTION>


	<FORM1 	FILLEXPLORER="TRUE"
		  WIDTH="8500"
		  STORA="spMPPregPromOperater @action=3, @operateriid = @@operateriid,"
		  STARTUPSTORA=""
		  HEIGHT="3500"
		  CAPTION="Parametri"
		  BORDERSTYLE="3"
		  CMD1CAPTION="Pokaži"
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  CHILDFORM="">


		<KONTROLA TYPE="CbEx3.ComboBoxEx3"
		NAME="trgovinaid"
		CAPTION="Trgovina"
		WIDTH="5500"
		HEIGHT="320"
		TABINDEX="1"
		ALLOWEMPTY="FALSE"
		SQL="spMPDajTrgovina @operateriid = @@operateriid"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker"
								  NAME="datumod"
									  CAPTION="Datum od"
								  VALUE="DATE2"
								  HEIGHT="320"
								  WIDTH="1500"
								  TABINDEX="2"
									  CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker"
					NAME="datumdo"
					CAPTION="Datum do"
					VALUE="DATE"
					HEIGHT="320"
					WIDTH="1500"
					TABINDEX="3"
						CHECKBOX="FALSE"/>

		<KONTROLA TYPE="TRAZILICA"
			CAPTION="Operater"
			NAME="operateri2id"
			SQL="ssoperateri#operateriid#%naziv%"
			TEXT=""
			TABINDEX="4"
			WIDTH="5000"
			HEIGHT="320"/>

		<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" NAME="odjelid"
			 HEIGHT="302" WIDTH="4032" VISIBLE="TRUE" SQL="select odjelid, naziv from odjel"
			 TEXT="" VALUE="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="TRUE"
			 CAPTION="Odjel" TABINDEX="5" ENABLED="TRUE"/>




	</FORM1>
	<DETALJI 	FILLEXPLORER="TRUE"
		   WIDTH="14000"
		   STORA=""
		   STARTUPSTORA=""
		   HEIGHT="7500"
		   CAPTION="Stavke prometa"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   CMD2CAPTION="Odustani"
		   CMD3CAPTION=""
		   NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX"
				NAME="stavke"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="_ay"
				TOP="200"
				LEFT="200"
				WIDTH="12000"
				HEIGHT="6000"
				TABINDEX="5"
				  SQL="spMPPregPromOperater @action=2, @operateri2id = @@id, @datumod = @@datumod, @datumdo = @@datumdo"
                                          />

	</DETALJI>

</PROJECT>
