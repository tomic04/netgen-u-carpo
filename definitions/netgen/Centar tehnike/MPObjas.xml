  <CAPTION>Ažuriranje objašnjenja uz doklumente </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8500" 
		STORA="spMPQueryGlaIDet @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		

            <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="trgovinaid" 
			CAPTION="Trgovina" 
			WIDTH="5500" 
			HEIGHT="320" 
            TABINDEX="1" 
            ALLOWEMPTY="true" 
            SQL="spMPDajTrgovina @operateriid = @@operateriid"/>

		  <KONTROLA TYPE="MSComCtl2.DTPicker" 
									NAME="datumod" 
