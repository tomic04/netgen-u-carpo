								CMD2CAPTION="Odustani"					
                                  >


		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				CAPTION="Objašnjenje" 
				NAME="napomena" 
				TEXT=""
				TABINDEX="1" 
				WIDTH="17000" 
				ENABLED="TRUE"
				HEIGHT="320"/>
	</OBJASNIDOK>

	<OBJASNISTAVKA
				   FILLEXPLORER="" 
				   REPORT=""  
