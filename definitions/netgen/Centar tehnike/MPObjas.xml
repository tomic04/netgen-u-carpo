									HEIGHT="320" 
									WIDTH="1500" 
									TABINDEX="2" 
										CHECKBOX="FALSE"/>

		  <KONTROLA TYPE="MSComCtl2.DTPicker" 
					  NAME="datumdo" 
					  CAPTION="Datum do" 
					  VALUE="DATE" 
					  HEIGHT="320" 
					  WIDTH="1500" 
					  TABINDEX="3" 
						  CHECKBOX="FALSE"/>

		  <KONTROLA TYPE="TRAZILICA" 
			  CAPTION="Partner" 
			  NAME="partneriid" 
			  SQL="Partneri#partneriid#naziv%" 
			  TEXT=""
			  TABINDEX="4" 
			  WIDTH="5000" 
			  HEIGHT="320"/>

	  
	  <KONTROLA TYPE="TRAZILICA" 
		  CAPTION="Roba" 
		  NAME="robaid" 
		  SQL="viRoba#robaid#Naziv%#userid#barcode#robakod" 
		  TEXT=""
		  TABINDEX="4" 
		  WIDTH="5000" 
		  HEIGHT="320"/>


	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
		  CAPTION="Vrsta prometa" 
			  NAME="vrstapromid" 
			  ALLOWEMPTY="TRUE" 
			  SQL="spMPDajVrstaProm" 
			  TEXT=""
			  TABINDEX="5" 
			  WIDTH="5000" 
			  HEIGHT="320"/>
