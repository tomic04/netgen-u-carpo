		  CAPTION="Vrsta dokumenta" 
			  NAME="vrstadokid " 
			  ALLOWEMPTY="TRUE" 
			  SQL="spMPDajVrstaDok" 
			  TEXT=""
			  TABINDEX="6" 
			  WIDTH="5000" 
			  HEIGHT="320"/>

	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
		NAME="Skladisteid" 
			CAPTION="Skladište" 
			WIDTH="5500" 
			HEIGHT="320" 
			TABINDEX="7" 
			ALLOWEMPTY="true" 
			SQL="spmpDajSkladiste"/>

	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
		  NAME="trgovina2id" 
		  CAPTION="Trgovina 2" 
		  WIDTH="5500" 
		  HEIGHT="320" 
		  TABINDEX="8" 
		  ALLOWEMPTY="true" 
		  SQL="spMPDajTrgovina @operateriid = @@operateriid"/>


