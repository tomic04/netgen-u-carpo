	<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" NAME="klasaid" TOP="734" LEFT="1613"
		 HEIGHT="302" WIDTH="4277" VISIBLE="TRUE" SQL="select klmasterrobaid, naziv= 
  case when len(sortkey) = 1 then 
    naziv
  when len(sortkey) = 2 then 
    &apos;  &apos; + naziv
  when len(sortkey) = 3 then
    &apos;   &apos; + naziv
  when len(sortkey) = 4 then 
    &apos;    &apos; + naziv
  when len(sortkey) = 5 then
    &apos;     &apos; + naziv
  when len(sortkey) = 6 then
    &apos;      &apos; + naziv
  when len(sortkey) = 7 then 
    &apos;       &apos; + naziv
  when len(sortkey) = 8 then
    &apos;        &apos; + naziv
  else
    &apos;         &apos; + naziv
  end 
from klmasterroba 
order by sortkey




"
		 TEXT="" VALUE="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="FALSE"
		 CAPTION="klasa" TABINDEX="2" ENABLED="TRUE"/>

