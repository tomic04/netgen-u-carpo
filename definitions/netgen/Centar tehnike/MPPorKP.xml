<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Parametri:FILTERFORM" 
      CMD2CAPTION="Dodaj:DODAJIZNOS" 
      CMD3CAPTION="Izmjeni:IZMJENIIZNOS" 
      CMD4CAPTION="Zaključi:ZAKLJUCI" 
      CMD5CAPTION="Otključaj:OTKLJUCAJ" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Print dok."   
      REPORT="" 
      DBLCLICKFORM="IZMJENIIZNOS"
      POPUP="Filter:FILTERFORM#Izmjeni:IZMJENIIZNOS#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ">
 
  <NAME>Poravnavanje KP u maloprodaji </NAME>
  <CAPTION>>Poravnavanje KP u maloprodaji </CAPTION>
 
  <KOMENTAR> </KOMENTAR>

  



	<DODAJIZNOS
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7500" 
                         STORA="spMPPoravnajKP @action=2, @id = @@id," 
                         STARTUPSTORA="" 
                         HEIGHT="4100" 
                         CAPTION="Unos iznosa poravnavanja"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani"					
                                  >
		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumdok" 
					CAPTION="Datum: " 
					VALUE="DATE1" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1	" 
					ENABLED="TRUE"
					CHECKBOX="FALSE"/>



		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
				CAPTION="Trgovina" 
				NAME="TrgovinaId" 
				SQL="spMPdajTrgovina @operateriid = @@operateriid" 
				TEXT=""
				TABINDEX="2" 
				WIDTH="4500" 
				ENABLED="TRUE"
				HEIGHT="320"/>


		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="osobeid" 
						CAPTION="Odgovorna osoba " 
						WIDTH="3500" 
					HEIGHT="320" 
						TABINDEX="3" 
					ALLOWEMPTY="TRUE" 
					SQL="spOsobeQuery @action = 16 "  />


		<KONTROLA TYPE="CM6.curMEdit6" 
				NAME="mpiznos" 
				CAPTION="MP Iznos" 
				TEXT="" 
				WIDTH="1500" 
				HEIGHT="320" 
				TABINDEX="4" 
				DECIMALS="4" />

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
		NAME="napomena" 
		CAPTION="Napomena" 
		TEXT="" 
		WIDTH="4500" 
		HEIGHT="320" 
		TABINDEX="1" 
		ENABLED="TRUE" />



	</DODAJIZNOS>

  
  
  


  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="7000" 
                         STORA="spMPPoravnajKP @action = 1,  @operateriid= @@operateriid, " 
                         STARTUPSTORA="" 
                         HEIGHT="3800" 
                         CAPTION="Upišite uvjete prikaza "  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >



									
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="3500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="4" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid "  /> 



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="status" 
                                    	CAPTION="Status" 
                                    	WIDTH="2500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select 1 as status,'Otvoren' as naziv  union all select 2 as status,'Zaključen ' as naziv "  /> 


  </FILTERFORM>





  <ZAKLJUCI
		WIDTH="5500" 
		STORA="spMPPoravnajKP 5,@id=@@id," 
					STARTUPSTORA="if (select status from mpnivelgla where mpnivelglaid= @@ID ) = 2 begin 
                        exec spRaiserror 69001, 'Dokument je Zaključen. Ne može se više zaključiti!' 
						end
						else begin
							exec spMPPoravnajKP @action=3,@ID=@@ID
					end"
		HEIGHT="3200" 
		CAPTION="Zaključiti dokument  ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Zaključi"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		BOLD="TRUE"	
		CHILDFORM=""> 

								<KONTROLA TYPE="TMEdit2.TextMEdit2" 
								NAME="brojdok" 
								CAPTION="Broj dokumenta" 
								TEXT="" 
								WIDTH="1500" 
								HEIGHT="320" 
								TABINDEX="1" 
								ENABLED="FALSE" />



   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="1400" LEFT="400" WIDTH="3500" CAPTION="Jeste li sigurni da želite zaključiti dokument  ? "/>
  </ZAKLJUCI>

	<OTKLJUCAJ
		  WIDTH="5500" 
		  STORA="spMPPoravnajKP 6,@id=@@id," 
					  STARTUPSTORA="if coalesce((select status from mpnivelgla where mpnivelglaid = @@ID ),0) &lt;&gt; 2 begin 
                        exec spRaiserror 69001, 'Dokument nije zaključen. Ne može se otključavati!'  
						end
						else begin
							exec spMPPoravnajKP @action=3,@ID=@@ID
					end"
		  HEIGHT="3200" 
		  CAPTION="Otključavanje dokumenta  ?" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Otključaj"         
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  BOLD="TRUE"	
		  CHILDFORM="">

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
		NAME="brojdok" 
		CAPTION="Broj dokumenta" 
		TEXT="" 
		WIDTH="1500" 
		HEIGHT="320" 
		TABINDEX="1" 
		ENABLED="FALSE" />



		<KONTROLA TYPE="VB.Label" NAME="stat" TOP="1400" LEFT="400" WIDTH="3500" CAPTION="Jeste li sigurni da želite otključati dokument  ? "/>
	</OTKLJUCAJ>



	<IZMJENIIZNOS
						   FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="7500" 
                         STORA="spMPPoravnajKP @action=4, @id = @@id," 
       					STARTUPSTORA="if (select status from mpnivelgla where mpnivelglaid= @@ID ) = 2 begin 
                        exec spRaiserror 69001, 'Dokument je Zaključen. Ne može se mijenjati !' 
						end
						else begin
							exec spMPPoravnajKP @action=3,@ID=@@ID
					end"
                         HEIGHT="4100" 
                         CAPTION="Izmjena iznosa poravnavanja"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani"					
                                  >
		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumdok" 
					CAPTION="Datum: " 
					VALUE="DATE1" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="1	" 
					ENABLED="TRUE"
					CHECKBOX="FALSE"/>



		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
				CAPTION="Trgovina" 
				NAME="TrgovinaId" 
				SQL="spMPdajTrgovina @operateriid = @@operateriid" 
				TEXT=""
				TABINDEX="2" 
				WIDTH="4500" 
				ENABLED="False"
				HEIGHT="320"/>


		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
						NAME="osobeid" 
						CAPTION="Odgovorna osoba " 
						WIDTH="3500" 
					HEIGHT="320" 
						TABINDEX="3" 
					ALLOWEMPTY="TRUE" 
					SQL="spOsobeQuery @action = 16 "  />


		<KONTROLA TYPE="CM6.curMEdit6" 
				NAME="mpiznos" 
				CAPTION="MP Iznos" 
				TEXT="" 
				WIDTH="1500" 
				HEIGHT="320" 
				TABINDEX="4" 
				DECIMALS="4" />

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
		NAME="napomena" 
		CAPTION="Napomena" 
		TEXT="" 
		WIDTH="4500" 
		HEIGHT="320" 
		TABINDEX="1" 
		ENABLED="TRUE" />


  </IZMJENIIZNOS>

  




</PROJECT>
 
