  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="exec dbo.spCarinaRacuni @action=0," 
                         STARTUPSTORA="" 
                         HEIGHT="2500" 
                         CAPTION="Izaberi dokumente"  
                         BORDERSTYLE="3" 
