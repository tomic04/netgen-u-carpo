<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FILTER_FORM"  		
		REPORT=""
		DETAILGRID = ""
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="Računi:RACUNI" 
		CMD3CAPTION="Roba:ROBA" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION="Print.dok.:vrstadokid-MPBlagajnaGla"
    MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE"
	  POPUPMASTER=""
       PAGEHEADERLEFT="Od @@datumod do @@datumdo"
   PAGEHEADERRIGHT="@@tkosmomi"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
    COMMANDTIMEOUT="300"> 
 

  <NAME>Dnevni promet robe </NAME>
  <CAPTION>Dnevni promet robe </CAPTION>

	<MASTERCOLUMNS>
		<COLUMN INDEX="6" NAME="" WIDTH="" CAPTION="" FORMAT="" VISIBLE="" AGREGATEFUNCTION="2" />

	</MASTERCOLUMNS>


	<FILTER_FORM
    NAME="FILTER_FORM"
    CAPTION="Parametri"
		WIDTH="7600" 
    HEIGHT="2000" 
	VERSION="1.1"
		ONSUBMIT="spmpDnevniPromet @action = 4,  " 
		ONLOAD="select @@trgovinaid as trgovinaid"
		
		FILLEXPLORER="TRUE"
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" >

    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />
    <INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="400" LEFT="1500"
               SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>




  </FILTER_FORM>

	<RACUNI
	  NAME="FILTER_FORM"
	  CAPTION="Parametri"
		  WIDTH="10000"
	  HEIGHT="12000"
	  VERSION="1.4"
		  ONSUBMIT=" "
		  ONLOAD=""
		
		  FILLEXPLORER="TRUE"
		  CMD1CAPTION=""
		  CMD2CAPTION="" >

		<INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />

		<INPUT TYPE="grid" NAME="racunigrid" CAPTION="Računi" TOP="600" LEFT="200" HEIGHT="6000" WIDTH="9000" GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="FALSE" ONCLICK="select 'refresh' as robagrid"
	   SQL ="spmpDnevniPromet @action = 1, @trgovinaid = @@trgovinaid "/>

		<INPUT TYPE="grid" NAME="robagrid" CAPTION="Roba" TOP="6800" LEFT="200" HEIGHT="4000" WIDTH="9000" GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="FALSE"
	   SQL ="spmpDnevniPromet @action=2, @brojdok = '@@gridracunigridBroj_računa',@kasa ='@@gridracunigridKasa'"/>

		
		<INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="11000" LEFT="2500" WIDTH="1100" HEIGHT="320" ONCLICK="close" />


	</RACUNI>



	<ROBA
	  NAME="FILTER_FORM"
	  CAPTION="Parametri"
		  WIDTH="10000"
	  HEIGHT="9000"
	  VERSION="1.3"
		  ONSUBMIT="select 'refresh' as  robagrid "
		  ONLOAD="select @@trgovinaid as trgovinaid"
		
		  FILLEXPLORER="TRUE"
		  CMD1CAPTION=""
		  CMD2CAPTION="" >

		<INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="7200" HEIGHT="3700" />
		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina*" WIDTH="5500" HEIGHT="320" ALLOWEMPTY="true"  TOP="200" LEFT="1500"
				   SQL="spMPDajTrgovinaNG @operateriid = @@operateriid"/>

		<INPUT TYPE="grid" NAME="robagrid" CAPTION="Dani u tjednu" TOP="600" LEFT="200" HEIGHT="7000" WIDTH="9000" GROUPBYBOXVISIBLE="FALSE" ALLOWEMPTY="" CHECKBOXVISIBLE="FALSE"
	   SQL ="spmpDnevniPromet @action = 3, @trgovinaid = @@trgovinaid "/>

		<INPUT TYPE="button"    NAME="pokazi"   CAPTION="POKAŽI" TOP="8000" LEFT="1000" WIDTH="1100" HEIGHT="320"
			 ONCLICK="select 'refresh' as  robagrid"/>
		<INPUT TYPE="button"    NAME="odustani"   CAPTION="Odustani" TOP="8000" LEFT="2500" WIDTH="1100" HEIGHT="320" ONCLICK="close" />


	</ROBA>
</PROJECT> 