<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTERFORM"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FILTERFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="Ponovi:PONOVI"
 		CMD5CAPTION="" 
		CMD6CAPTION="Legenda:LEGENDA"  
		CMD7CAPTION=""  
		CMD8CAPTION="Etikete"  
		PAGEHEADERCENTER="Pregled utržaka @@NoviRed Od @@datumod do @@datumdo"
		MASTERDBLCLICK=""
		CHECKBOXVISIBLE="FALSE" 
    MULTIGRIDLAYOUT="TRUE"
    POPUPMASTER=""
    PAGEHEADERLEFT=""
    PAGEHEADERRIGHT="@@tkosmomi"
    PERMISSIO="TRUE"
    SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"> 
 
  <NAME>Pregled prijenosa utržaka po kasama </NAME>
  <CAPTION>Pregled prijenosa utržaka po kasama </CAPTION>

	<FILTERFORM NAME="FILTERFORM"
		HEIGHT="2400"
		WIDTH="4350"
		CAPTION="Upišite uvjete prikaza "
		ONSUBMIT="spMPPregNeprUtr @operateriid= @@operateriid, "
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo"
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Pokaži"
		CMD2CAPTION="Odustani"
	>
    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="4000" HEIGHT="1150"/>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="400" LEFT="1500" WIDTH="1200" HEIGHT="300"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="800" LEFT="1500" WIDTH="1200" HEIGHT="300"/>
		
	</FILTERFORM>

  <PONOVI NAME="PONOVI"
		HEIGHT="3400"
		WIDTH="4350"
		CAPTION="Upišite datum i blagajnu za koju ponavljate prijenos  "
		ONSUBMIT="spmpdonosSaBlagajne @action = 1 , "
		ONLOAD="select '@@kasa' as kasa, oznaka as trgovina from mpkase k inner join trgovina t on k.trgovinaid = t.trgovinaid where kasa = @@kasa"
		FILLEXPLORER=""
		NEXTFORM=""
		CMD1CAPTION="Ponovi"
		CMD2CAPTION="Odustani"
	>
    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="4000" HEIGHT="1150"/>
    <INPUT TYPE="date" NAME="datumdok" CAPTION="Datum *" TOP="400" LEFT="1500" WIDTH="1200" HEIGHT="300"/>
    <INPUT TYPE="text" NAME="trgovina" CAPTION="Trgovina*" TOP="800" LEFT="1500" WIDTH="1200" HEIGHT="300" ENABLED="FALSE" STYLE="1"/>
    <INPUT TYPE="text" NAME="kasa" CAPTION="Blagajna*" TOP="1200" LEFT="1500" WIDTH="1200" HEIGHT="300" ENABLED="FALSE" STYLE="1"/>

  </PONOVI>

  <LEGENDA NAME="LEGENDA"
		HEIGHT="2800"
		WIDTH="4350"
		CAPTION="Legenda"
		ONSUBMIT=""
		ONLOAD=""
		FILLEXPLORER="TRUE"
		NEXTFORM=""
		CMD1CAPTION="Zatvori"
		CMD2CAPTION=""
	>
    <INPUT TYPE="frame" NAME="frm" CAPTION="" TOP="50" LEFT="50" WIDTH="4000" HEIGHT="1650" BACKCOLOR="silver" />
    
    <INPUT TYPE="text"    NAME="legenda1"   CAPTION="Nepreneseni utržak*" ENABLED="FALSE" TOP="350" LEFT="1800" WIDTH="1" BACKCOLOR="silver" PARENT="frm"/>
    <INPUT TYPE="label"    NAME="legenda4"   CAPTION="............................................." TOP="450" LEFT="1900"  WIDTH="4800" BACKCOLOR="darksalmon"/>
    <INPUT TYPE="text"    NAME="legenda2"   CAPTION="Neradni dan trgovine*" ENABLED="FALSE" TOP="650" LEFT="1800" WIDTH="1" BACKCOLOR="#65C485" PARENT="frm"/>
    <INPUT TYPE="label"    NAME="legenda4"   CAPTION="............................................." TOP="750" LEFT="1900"  WIDTH="4800" BACKCOLOR="#65C485"/>
    <INPUT TYPE="text"    NAME="legenda3"   CAPTION="Državni praznik*" ENABLED="TRUE" TOP="950" LEFT="1800" WIDTH="1" BACKCOLOR="#BAABF0" PARENT="frm"/>
    <INPUT TYPE="label"    NAME="legenda4"   CAPTION="............................................." TOP="1050" LEFT="1900"  WIDTH="4800" BACKCOLOR="#BAABF0"/>
    <INPUT TYPE="text"    NAME="legenda3"   CAPTION="Preneseni utržak*" ENABLED="TRUE" TOP="1250" LEFT="1800" WIDTH="1" BACKCOLOR="white" PARENT="frm"/>
    <INPUT TYPE="label"    NAME="legenda4"   CAPTION="............................................." TOP="1350" LEFT="1900"  WIDTH="4800" BACKCOLOR="white"/>
  </LEGENDA>



  <STATUS_FORM NAME="STATUS_FORM"
    HEIGHT="9900"
    WIDTH="5000"
    CAPTION="Status kasa"
    ONSUBMIT=""
    ONLOADED=""
    ONLOAD=""
    FILLEXPLORER=""
    FOCUS=""
    CMD1CAPTION=""
    CMD2CAPTION="" >

    <INPUT TYPE="grid"
        NAME="kase"
        REFRESHAFTERCHILD="TRUE"
        CAPTION="Stavke"
        TOP="50" LEFT="56" WIDTH="4500" HEIGHT="8500"
        TABINDEX="-1"
        AFTERREFRESH=""
        POPUP=""
        ONDBLCLICK=""
        EDITCOLUMNS=""
        SKIPDEFAULTLOAD="FALSE"
        ONCELLEDITED=""
        CHECKBOXVISIBLE="TRUE"
        PAGEHEADERCENTER=""
        PAGEHEADERRIGHT=""
        PAGEHEADERLEFT=""
        PAGEFOOTERCENTER=""
        PAGEFOOTERLEFT=""
        PAGEFOOTERRIGHT=""
        PAGEORIENTATION="LANDSCAPE"
        GROUPBYBOXVISIBLE="FALSE"
        TOTALROW="FALSE"
        SQL="exec [dbo].[spMPKasaCopy] @action = 2" />

    <INPUT TYPE="button"    NAME="odustani"   CAPTION="Zatvori (ESC)" TOP="8700" LEFT="300" WIDTH="1700" HEIGHT="520" ONCLICK="close" HOTKEY="ESC" />

    <INPUT TYPE="button"    NAME="refresh"   CAPTION="Osvježi" TOP="8700" LEFT="2300" WIDTH="1700" HEIGHT="520"
         ONCLICK="FOREACHSELECTED(kase)#BLAGAJNAENABLE(@@gridkasempkaseid)#select 'refresh' as kase"  />

  </STATUS_FORM>
  
</PROJECT>
