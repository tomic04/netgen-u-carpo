<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Promet:PROMET" 
		CMD4CAPTION="Kartica:KARTICA"
 		CMD5CAPTION="" 
		CMD6CAPTION=""
		  PAGEHEADERRIGHT="Period od @@datumod do @@datumdo "  
		  PAGEHEADERCENTER=""                                                             
		  PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid"
		  PAGEFOOTERCENTER=""
		  PAGEFOOTERLEFT="Vrsta dokumenta: @@comboboxvrstadokid"
		  PAGEFOOTERRIGHT=""
		PAGEORIENTATION="LANDSCAPE" 
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname'" 
		MASTERDBLCLICK="PROMET"
	        POPUPMASTER=""
		COMMANDTIMEOUT="120"> 
 

  <NAME>Realizacija robe u MP </NAME>
  <CAPTION>Realizacija robe u MP </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spMPRealizacijaRobe @action=1, @operateriid = @@operateriid, @nenc = @@nenc , " 
		ONLOAD="select @@datumod as datumod , @@datumdo as datumdo , @@trgovinaid as trgovinaid" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<INPUT TYPE="combo" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
									ONLOSTFOCUS=""
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

	  <INPUT TYPE="combo"
					  NAME="orgshemaid"
					  CAPTION="Org. shema"
					  WIDTH="5500"
				  HEIGHT="320"
					  TABINDEX="1"
				  ALLOWEMPTY="true"
				  SQL="select distinct t.orgshemaid ,  o.naziv  from Trgovina t inner join OrgShema o on t.OrgShemaId = o.OrgShemaId inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>


	  <INPUT TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#%Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<INPUT TYPE="text" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					
					
					
					
			<INPUT TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<INPUT TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>


                     	<INPUT TYPE="date" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="5" 
                                    	CHECKBOX="FALSE"/>
										

                     	<INPUT TYPE="combo" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spmpdajvrstadokmoze 2,null"/>

	  <INPUT TYPE="combo"
					  NAME="robnamarkaid"
					  CAPTION="Robna marka"
					  WIDTH="5500"
				  HEIGHT="320"
					  TABINDEX="6"
				  ALLOWEMPTY="true"
				  SQL="select robnamarkaid, opis as naziv from robnamarka "/>

  </FORM1>
 <PROMET 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="select null as trgovinaid" 
		HEIGHT="7500" 
		CAPTION="Stavke prometa" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="Napomena:NAPOMENADOK" 
		NEXTFORM="">

	 <INPUT TYPE="combo"
					 NAME="trgovinaid"
					 CAPTION="Vrsta dokumenta"
					 WIDTH="5500"
						TOP="-11111"
				 HEIGHT="320"
					 TABINDEX="6"
				 ALLOWEMPTY="true"
				 SQL=""/>


	 <INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="14300" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spMPRealizacijaRObe @action=2,@RObaID = @@id, @trgovinaid = @@trgovinaid , @datumod = @@datumod, @datumdo = @@datumdo" 
                                          /> 

</PROMET>
	<KARTICA 	FILLEXPLORER="TRUE" 
		   WIDTH="16000" 
		   ONSUBMIT="" 
		   ONLOAD="" 
		   HEIGHT="9500" 
		   CAPTION="Kartica robe" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="Kraj" 
		   CMD3CAPTION="" 
		   CMD4CAPTION="" 
		   CMD5CAPTION="" 
		
		   CHILDFORM="">

		<INPUT TYPE="grid" NAME="gridkartica" REFRESHAFTERCHILD="TRUE" TOP="200" LEFT = "200" WIDTH="15500" HEIGHT="8000" TABINDEX="2" TOTALROW="FALSE"
					 SQL="spMaloprodajaStanjeKartica @action = 1, @robaid = @@id, @prikaz= 0, @trgovinaid = @@trgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @totalgen= 1,@operateriid = @@operateriid " />
	</KARTICA>



	<FORM2 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="12000" 
                         ONSUBMIT="" 
                         ONLOAD="" 
                         HEIGHT="8800" 
                         CAPTION="Stavke prometa"  
						MASTERDBLCLICK=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="KRAJ"
			
                                  NEXTFORM=""  >



			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="2800" 
					LEFT="200"  
					WIDTH="14500" 
					HEIGHT="5000" 
					TABINDEX="5" 
                      SQL="spGRNalogMP @action = 902,@id=@@id" 
                                          /> 


  </FORM2>

	<NAPOMENADOK
					   FILLEXPLORER="" 
					   REPORT=""  
					   WIDTH="19000" 
					   ONSUBMIT=""
					   ONLOAD="spMPObjasnjenje @action = 1, @maloprodajaglaid = @@stavke" 
					   HEIGHT="2000" 
					   CAPTION="Ažuriranje objašnjenja uz dokument "  
					   BORDERSTYLE="3" 
								CMD1CAPTION="" 
								CMD2CAPTION="Odustani"					
                                  >


		<INPUT TYPE="text" 
				CAPTION="Objašnjenje" 
				NAME="napomena" 
				TEXT=""
				TABINDEX="1" 
				WIDTH="17000" 
				ENABLED="FALSE"
				BOLD="TRUE" 
				HEIGHT="320"/>
	</NAPOMENADOK>

</PROJECT> 