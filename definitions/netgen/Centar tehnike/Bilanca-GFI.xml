<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM#select case when '@@izvjestaj'='GFI-POD' then 'disable' else 'enable' end as TSI#select case when '@@izvjestaj'='TSI-POD' then 'disable' else 'enable' end as GFI"  
      CMD1CAPTION="Parametri:FILTERFORM#select case when '@@izvjestaj'='GFI-POD' then 'disable' else 'enable' end as TSI#select case when '@@izvjestaj'='TSI-POD' then 'disable' else 'enable' end as GFI" 
      CMD2CAPTION="GFI:GFIPODFORM#AOPuExcel.clsGFIPOD(GFI-POD602.xls)" 
      CMD3CAPTION="TSI:TSIPODFORM#AOPuExcel.clsGFIPOD(TI-POD_4.0.0.xls)" 
      CMD4CAPTION="Ispis:PRINTMASTER" 
      POPUPMASTER=""
      COMMANDTIMEOUT="120"
      MASTERDBLCLICK=""
      CHECKBOXVISIBLE="FALSE"  
      PAGEHEADERCENTER=""
      PAGEHEADERRIGHT="u periodu: @@datumod do @@datumdo"
	  PAGEHEADERLEFT=""
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@tkosmomi##@@mjesto"
	  PAGEFOOTERRIGHT="@@datdanas##Jupiter Software by SPIN"
	  PAGEORIENTATION="LANDSCAPE"	  
      		
      >

 
  <NAME>Bilanca-GFI</NAME>
  <CAPTION>Bilanca-GFI</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
   
   
  <MASTERCOLUMNS>	
		 <COLUMN INDEX="" NAME="Klasa" WIDTH="600" CAPTION="Klasa" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Razred" WIDTH="800" CAPTION="Razred" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Sintetika" WIDTH="800" CAPTION="Sintetika" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Konto" WIDTH="800" CAPTION="Konto" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="BA" WIDTH="600" CAPTION="BA" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="BP" WIDTH="500" CAPTION="BP" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="RDG" WIDTH="500" CAPTION="RDG" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="AOP" WIDTH="800" CAPTION="AOP" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="AOP_dod" WIDTH="800" CAPTION="AOP_dod" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="AOP_TSI" WIDTH="800" CAPTION="AOP_TSI" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="RBRB" WIDTH="600" CAPTION="RBRB" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Naziv" WIDTH="2500" CAPTION="Naziv" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PSDuguje" WIDTH="1500" CAPTION="PSDuguje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PSPotrazuje" WIDTH="1500" CAPTION="PSPotrazuje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Duguje" WIDTH="1500" CAPTION="Duguje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Potrazuje" WIDTH="1500" CAPTION="Potrazuje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Ukp_dug" WIDTH="1500" CAPTION="Ukp_dug" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Ukp_pot" WIDTH="1500" CAPTION="Ukp_pot" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="Saldo" WIDTH="1500" CAPTION="Saldo" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="SaldoPG" WIDTH="1500" CAPTION="SaldoPG" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PG_PS" WIDTH="1500" CAPTION="PG_PS" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PG_Duguje" WIDTH="1500" CAPTION="PG_Duguje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PG_Potrazuje" WIDTH="1500" CAPTION="PG_Potrazuje" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		 <COLUMN INDEX="" NAME="PG_Saldo" WIDTH="1500" CAPTION="PG_Saldo" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />

  </MASTERCOLUMNS>
   
   
   <FILTERFORM 
					
                 WIDTH="4000" 
                 ONLOAD="select @@datod as datod , @@datdo as datdo,(select convert(datetime,convert(varchar(4),year(getdate()))+'1231')) as datumdo  ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas,
                         (select m.naziv  from partneri p
			 inner join parstru ps on ps.partneriid=p.partneriid
			 inner join mjesta m on m.mjestaid=ps.mjestaid
			 where p.partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))
			 and ps.hqind='*') AS mjesto"
                 ONSUBMIT="spBilancapoAOP @datumod=@@datumod,@datumdo=@@datumdo,@action='@@izvjestaj'!!"                                                         
                 HEIGHT="2500" 
                 CAPTION="Parametri"  
                 CMD1CAPTION="Izvrši" 
                 CMD2CAPTION="Izlaz" 
		 FILLEXPLORER="TRUE"
  		 >
  	        <INPUT TYPE="date" CAPTION="Datum od:" NAME="datumod" DEFAULT="firstdayofyear" TABINDEX="0"  WIDTH="1200" HEIGHT="320"  />
        
		<INPUT TYPE="date" CAPTION="Datum do:" NAME="datumdo" DEFAULT="" 
		 TABINDEX="1" WIDTH="1200" HEIGHT="320"/> 

		<INPUT TYPE="label" NAME="lblizvjestaj"  TOP="1050" LEFT="220" WIDTH="1000" CAPTION="Izvještaj:"/>	   
		<INPUT TYPE="combo"  NAME="izvjestaj"    TOP="1050" LEFT="1950" WIDTH="1200" ALLOWEMPTY="FALSE" TABINDEX="2"  
			   SQL="select  'GFI-POD' union all select  'TSI-POD' "/>

	      

  </FILTERFORM>


  <GFIPODFORM 					
                 WIDTH="" 
                 ONLOAD=""
                 ONSUBMIT="spBilancapoAOP @datumod=@@datumod,@datumdo=@@datumdo,@action='GFI-POD'"                                                         
                 HEIGHT="" 
                 FILLEXPLORER="FALSE"
  		 >
  	  
  </GFIPODFORM>

  

  <TSIPODFORM 					
                 WIDTH="" 
                 ONLOAD=""
                 ONSUBMIT="spBilancapoAOP @datumod=@@datumod,@datumdo=@@datumdo,@action='TSI-POD'"                                                         
                 HEIGHT="" 
                 FILLEXPLORER="FALSE"
  		 >
  	  
  </TSIPODFORM>
		

                           

</PROJECT>
 


