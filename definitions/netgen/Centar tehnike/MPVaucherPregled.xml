<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="Nispravni računi:NEISPRAVNIRAC" 
      CMD3CAPTION="Neispravni vaucher-i:NEISPRAVNIV" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Print dok."   
      REPORT="" 
      MASTERDBLCLICK="IZMJENI"
      POPUPMASTER="Filter:FILTERFORM#Dodaj:DODAJ#Izmjeni:IZMJENI">
 
  <NAME>Izdavanje Vaucher-a </NAME>
  <CAPTION>>Izdavanje Vaucher-a</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

  








	<FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="7000" 
                         ONSUBMIT="spmpVaucherPregled @action = 1,  @operateriid= @@operateriid, " 
                         ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
                         HEIGHT="3800" 
                         CAPTION="Upišite uvjete prikaza "  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >



									
                     	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" VALUE="DATE2" HEIGHT="320" WIDTH="1500" TABINDEX="1" CHECKBOX="FALSE"/>

                     	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="2" CHECKBOX="FALSE"/>

					<INPUT TYPE="check" NAME="sve" CAPTION="Bez obzira na datum" WIDTH="2500" HEIGHT="320" TABINDEX="5" ALLOWEMPTY="true" SQL=""  />
					<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina" WIDTH="3500" HEIGHT="320" TABINDEX="3" ALLOWEMPTY="true" SQL="spMPDajTrgovina @operateriid = @@operateriid "  /> 

                     	<INPUT TYPE="text" NAME="brojvaucher" CAPTION="Broj Vaucher-a_" WIDTH="2500" HEIGHT="320" TABINDEX="4" ALLOWEMPTY="true" SQL=""  />


							<INPUT TYPE="combo" NAME="realizirani" CAPTION="Prikaži :" WIDTH="2500" HEIGHT="320" TABINDEX="6" ALLOWEMPTY="FALSE"
							SQL="select 0 as realizirani, 'SVE' as naziv union all select 1 , 'REALIZIRANE' union all select 2 , 'NEREALIZIRANE'"  />


	</FILTERFORM>


	<NEISPRAVNIRAC
			FILLEXPLORER=""
			WIDTH="16000"
				ONSUBMIT=""
			ONLOAD=""
			HEIGHT="10000"
			CAPTION="Pregled neispravnih računa"
		>
		<INPUT TYPE="grid"
				NAME="neisprr"
				TOP="700"
				LEFT="200"
				WIDTH="15000"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="8000"
				CAPTION="_Stavke za donos sa ručnog terminala"
		REFRESHAFTERCHILD="TRUE"
		SQL="spMPVaucherPregled @action=2, @operateriid = @@operateriid, @trgovinaid=@@trgovinaid, @datumod = @@datumod, @datumdo=@@datumdo, @sve= @@sve" />

		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="ispravi"  CAPTION="Ispravi" TOP="9000" LEFT="4756" WIDTH="1106" HEIGHT="322" ONCLICK=":ISPRAVIRAC"  />


	</NEISPRAVNIRAC>

	<NEISPRAVNIV
			FILLEXPLORER=""
			WIDTH="10000"
				ONSUBMIT=""
			ONLOAD=""
			HEIGHT="10000"
			CAPTION="Pregled neispravnih izdanih vauchera"
		>
		<INPUT TYPE="grid"
				NAME="neisprv"
				TOP="700"
				LEFT="200"
				WIDTH="9500"
				CHECKBOXVISIBLE="FALSE"
				TOTALROWVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				HEIGHT="8000"
				CAPTION="_Stavke za donos sa ručnog terminala"
		REFRESHAFTERCHILD="TRUE"
		SQL="spMPVaucherPregled @action=3, @operateriid = @@operateriid, @trgovinaid=@@trgovinaid, @datumod = @@datumod, @datumdo=@@datumdo, @sve= @@sve" />

		<INPUT TYPE="button" NAME="cancel"  CAPTION="Odustani" TOP="9000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


	</NEISPRAVNIV>


	<ISPRAVIRAC
                         FILLEXPLORER=""
                         REPORT=""
                         WIDTH="7500"
                         ONSUBMIT="update mpblagajnagla set napomena = '@@napomena' where mpblagajnaglaid = @@mpblagajnaglaid"
                         ONLOAD="select mpblagajnaglaid, napomena, broj, datumdok from mpblagajnagla where mpblagajnaglaid = @@neisprr"
                         HEIGHT="2500"
                         CAPTION="Dodavanje novog Vaucher-a"
                         BORDERSTYLE="3"
                                  CMD1CAPTION="Spremi"
                                  CMD2CAPTION="Odustani"
                                  >
		<INPUT TYPE="text"
					NAME="broj"
					CAPTION="Broj računa"
					VALUE=""
					HEIGHT="320"
					WIDTH="3000"
					TABINDEX="1	"
					ENABLED="FALSE"
					STYLE="1"
					CHECKBOX="FALSE"/>

		<INPUT TYPE="text"
					NAME="napomena"
					CAPTION="Vaucher"
					VALUE=""
					HEIGHT="320"
					WIDTH="3000"
					TABINDEX="1	"
					ENABLED="TRUE"
					CHECKBOX="FALSE"/>
		<INPUT TYPE="text"
					NAME="mpblagajnaglaid "
					CAPTION="Broj računa"
					VALUE=""
					HEIGHT="320"
					WIDTH="3000"
					TABINDEX="1	"
					VISIBLE="FALSE"
					STYLE="1"
					CHECKBOX="FALSE"/>




	</ISPRAVIRAC>





</PROJECT>
 
