<?xml version="1.0" encoding="windows-1250" ?>


<PROJECT  
   ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Uvjeti:FILTERFORM" 
      CMD2CAPTION="" 
      CMD3CAPTION="Analitika:ANALITIKA" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="" 
      MASTERDBLCLICK=""
      POPUPMASTER="">
 
  <NAME>Kontrola MP - Financijsko </NAME>
  <CAPTION>Kontrola MP - Financijsko </CAPTION>
 
  <KOMENTAR> </KOMENTAR>


<FILTERFORM 		
	
	
		WIDTH="9000" 
		ONSUBMIT="spMPKontrolaKPFinNG @action=3, @operateriid = @@operateriid," 
		ONLOAD="select @@orgshemaid as orgshemaid , @@datumod as datumod , @@datumdo as datumdo" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		FILLEXPLORER="TRUE" 
		CHILDFORM=""> 
		


                     	<INPUT TYPE="combo" 
                                     	NAME="OrgShemaId" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajOrgshema @action = 1, @operateriid=@@operateriid"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumod" 
                                    CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                     	<INPUT TYPE="date" 
                                 	NAME="datumdo" 
                                    CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>


	<INPUT TYPE="combo" 
					NAME="vrstadokid" 
					CAPTION="Vrsta dokumenata " 
					WIDTH="5500" 
				HEIGHT="320" 
					TABINDEX="1" 
				ALLOWEMPTY="true" 
				SQL="select vrstadokid , opis as naziv from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where projekt = 'M') and kp = 1 order by vrstapromid"/>

	<INPUT TYPE="combo" 
				NAME="kp" 
				CAPTION="Vrsta robe " 
				WIDTH="5500" 
			HEIGHT="320" 
				TABINDEX="1" 
			ALLOWEMPTY="true" 
			SQL="select 1 as id, ' Vlastita roba' as naziv union all select 2, 'Tuđa roba'"/>


</FILTERFORM>

	<ANALITIKA
						   FILLEXPLORER="" 
						   REPORT=""  
						   WIDTH="15000" 
						   ONSUBMIT="" 
						   ONLOAD="" 
						   HEIGHT="8800" 
						   CAPTION="Analitika po vrsti dokumenta  "  
						   BORDERSTYLE="3" 
						   CMD1CAPTION="" 
						   CMD2CAPTION="Odustani"
						   CMD3CAPTION=""	 
						  CMD4CAPTION="Obnovi"
						  CMD5CAPTION=""	 		 
						  CMD6CAPTION=""  
					
									NEXTFORM=""  >

		<INPUT TYPE="grid" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION=""
				LEFT = "200"
				WIDTH="14000" 
				HEIGHT="7000" 
				TABINDEX="5" 
				SQL="spMPKontrolaKPFin @action = 4 ,@orgshemaid = @@orgshemaid , @datumod = @@datumod, @datumdo=@@datumdo, @vrstadokid = @@Id" 
                                          />


	</ANALITIKA>

	<AZUR
		  WIDTH="5500" 
		  ONSUBMIT="spMPKontrolaKPFin  @action = 5,@id=@@id" 
		  ONLOAD=""		
		  HEIGHT="3200" 
		  CAPTION="Ažurirati ?" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Ažuriraj"         
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  CHILDFORM="">

		<INPUT TYPE="label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite ažurirati dokument ?" />
	</AZUR>


</PROJECT> 