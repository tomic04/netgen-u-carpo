<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Brisanje:DELETEFORM" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM=""
	        POPUP=""> 
 

  <NAME>Pregled promjene MPC u Cjeniku</NAME>
  <CAPTION>Pregled promjene MPC u Cjeniku</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPCijenaPrometQuery @action=1, " 
		STARTUPSTORA="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrcjenikid" 
                                    	CAPTION="Vrsta cjenika" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select vrcjenikid, opis as naziv from vrcjenik"/>

			

			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#%Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="2" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

							
					
					

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="5" 
                                    	CHECKBOX="FALSE"/>
										
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="Ind" 
                                    	CAPTION="Status" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select 0 as ind, 'U najavi' as naziv union all select 1 as ind , 'Promjenjen cjenik'  union all select 2 as ind , 'Proknjiženo' "/>


										

  </FORM1>

    <DELETEFORM
		WIDTH="5500" 
		STORA="spMPCijenaPrometQuery @action=2, @MPCijenaPrometid=@@id, " 
		STARTUPSTORA=""	
		HEIGHT="2500" 
		CAPTION="Obrisati ?" 
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati odabrani artikal ? " />
	
  </DELETEFORM> 


</PROJECT> 