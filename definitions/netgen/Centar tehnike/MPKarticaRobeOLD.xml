<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT>

<MPKARTICA
	HEIGHT="7500" 
	WIDTH="16000" 
	CAPTION="Kartica: '@@opis' "
	ONSUBMIT=""
    CHECKBOXVISIBLE="TRUE"
	ONLOAD="select convert(varchar(15),userid)+'  '+naziv  as opis, @@datumod as datumod, @@datumdo as datumdo, coalesce(@@totalgen,2) as  totalgen from roba where robaid=@@mastergrid "
	ONLOADDD="select sifra+'  '+[naziv robe] as opis, @@datumod as datod, @@datumdo as datdo, coalesce(@@totalgen,2) as  totalgen from ##temp50 where robaid=@@mastergrid and trgovinaid=@@skladisteid">>

	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od*" TOP="200" LEFT="1300"  />
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do*" TOP="200" LEFT="3700"  />

	<INPUT TYPE="button" NAME="" CAPTION="Pokaži" TOP="200" LEFT="6000" WIDTH="1500" HEIGHT="322" ONCLICK="select 'refresh' as grid"/>

	<INPUT TYPE="grid" NAME="grid" TOP="800" LEFT="200" WIDTH="15500" HIGHT="6000"
			    CAPTION="Kartica robe"
				TOTALROW="FALSE"
				CHECKBOXVISIBLE="FALSE"
			    PAGEHEADERCENTER=""
				PAGEHEADERRIGHT="Kartica MP stanja za robu '@@opis'"
				PAGEHEADERLEFT="Razdoblje: od @@datumod do @@datumdo  Trgovina: @@comboboxskladisteid"
				PAGEFOOTERCENTER=""
				PAGEFOOTERLEFT=""
				PAGEFOOTERRIGHT=""
				PAGEORIENTATION="LANDSCAPE"  
				SQL="exec spMPStanjeKarticaNG @action=0, @robaid=@@mastergrid, @DatumOd=@@DatumOd, @DatumDo=@@DatumDo, @trgovinaid=@@skladisteid, @totalgen = @@totalgen , @datod = @@datod, @datdo = @@datdo" >
			
				<COLUMN INDEX="" NAME="kol.ulaz0800" WIDTH="" CAPTION="Kol.Ulaz" FORMAT="#,##0.0000" VISIBLE="TRUE	" />
				<COLUMN INDEX="" NAME="kol.Izlaz0800" WIDTH="" CAPTION="Kol.Izlaz" FORMAT="#,##0.0000" VISIBLE="TRUE" />
				<COLUMN INDEX="" NAME="stanje0800" WIDTH="" CAPTION="Stanje" FORMAT="#,##0.0000" VISIBLE="TRUE" />
		</INPUT>
		
	<INPUT TYPE="button" NAME="" CAPTION="Izlaz" TOP="6500" LEFT="200" WIDTH="1500" HEIGHT="322" ONCLICK="close"/>
	<INPUT TYPE="button" NAME="" CAPTION="Ispis kartice" TOP="6500" LEFT="2200" WIDTH="1500" HEIGHT="322" ONCLICK="printgrid(grid)"/>

</MPKARTICA>


</PROJECT>

