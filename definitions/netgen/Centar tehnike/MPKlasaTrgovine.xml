<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD="spmpklaseTrgovine @action = 2" 
   CMD1CAPTION=""
   CMD2CAPTION="" 
   CMD3CAPTION="Dodaj:INSERTFORM"
   CMD4CAPTION="" 
   CMD5CAPTION="Izmjeni:IZMJENIFORM"
   CMD6CAPTION=""
   DETAILGRID = "" 
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK=""
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi">

	
  <NAME>Definiranje klase trgovine</NAME>
  <CAPTION>Definiranje klase trgovine</CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR></AUTOR>

  
  <INSERTFORM
		WIDTH="6000"
		ONSUBMIT=""
		ONLOAD=""
		HEIGHT="5500"
    VERSION="1.3"
    CAPTION="Unos"
		FOCUS="Opis"
		>

	  <INPUT TYPE="combo" CAPTION="Klasa trgovine:*" NAME="MPKlaseTrgovinaid" TOP="1500" LEFT="1200" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="FALSE"
				  SQL="spmpklaseTrgovine @action = 0"  ONLOSTFOCUS="spmpklaseTrgovine @action=1, @id=@@MPKlaseTrgovinaid"/>
	  
	  <INPUT TYPE="multidrop" CAPTION="Trgovine:*" NAME="trgovinalistaid" TOP="1000" LEFT="1200" WIDTH="4500" HEIGHT="320" 
			 SQL="select trgovinaid, oznaka+'-'+opis as Trgovina from Trgovina where aktivno=1 order by oznaka"/>

		<INPUT TYPE="text" NAME="Opis" CAPTION="Opis klase:*" MULTILINE="TRUE" TOP="2000" LEFT="1200" WIDTH="4500" HEIGHT="1500" ENABLED="FALSE"/>

	  <INPUT TYPE="button" NAME="ok"           CAPTION="Spremi"   TOP="4000" LEFT="500" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spmpklaseTrgovine @action = 4,@MPKlaseTrgovinaid=@@MPKlaseTrgovinaid, @trgovinalistaid='@@trgovinalistaid'
						      #ok"  HOTKEY="F2" />
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="4000" LEFT="1756" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close"  />
  </INSERTFORM>


	<IZMJENIFORM
		WIDTH="6000"
      ONSUBMIT=""
      ONLOAD="spmpklaseTrgovine @action = 3, @id=@@id"
      HEIGHT="3500"
      VERSION="1.2"
      CAPTION="Brisanje"
      FOCUS=""
		>
		<INPUT TYPE="combo" CAPTION="Klasa trgovine:*" NAME="MPKlaseTrgovinaid" TOP="500" LEFT="1200" WIDTH="4500" HEIGHT="320" ALLOWEMPTY="TRUE"
					SQL="spmpklaseTrgovine @action = 0" />

		<INPUT TYPE="combo" CAPTION="Trgovine:*" NAME="trgovinaid" TOP="1500" LEFT="1200" WIDTH="4500" HEIGHT="320" ENABLED="FALSE"
			   SQL="select trgovinaid, oznaka+'-'+opis as Trgovina from Trgovina where aktivno=1"/>
		


	  <INPUT TYPE="button" NAME="ok"           CAPTION="Izmjeni"   TOP="2500" LEFT="456" WIDTH="1106" HEIGHT="322" ENABLED="TRUE"
			   ONCLICK="spmpklaseTrgovine @action = 5, @trgovinaid=@@id, @MPKlaseTrgovinaid=@@MPKlaseTrgovinaid #ok"  HOTKEY="F2" />
    
    <INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="2500" LEFT="1756" WIDTH="1106" HEIGHT="322"
			   ONCLICK="close"  />
  </IZMJENIFORM>

</PROJECT>
 
