<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM" 
   CMD1CAPTION="Filter:FILTERFORM"    
   CMD2CAPTION="Dodaj:DODAJFORM"    
   CMD3CAPTION="Obriši:DELETEFORM" 
   CMD4CAPTION="Izmjeni:UPDATEFORM"
   CMD5CAPTION="Proknjiži:PROKNJIZIFORM"
   CMD6CAPTION=""
   POPUP=""
   DBLCLICKFORM="UPDATEFORM">
 
  <NAME>Izmjena nabavnih cijena u cjeniku </NAME>
  <CAPTION>Izmjena nabavnih cijena u cjeniku </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR>KK 12.06.2007  </AUTOR>

  <FILTERFORM 
                         WIDTH="9000" 
                         STORA="spMPnabavnaTotalGen @action=3," 
                         STARTUPSTORA="" 
                         HEIGHT="2500" 
                         CAPTION="Filter"  
                         CMD1CAPTION="Pokaži" 
                         CMD2CAPTION="Odustani" 
						CMD4CAPTION="" 
						FILLEXPLORER="TRUE" >

                         <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="select TrgovinaId,Opis as naziv  from trgovina order by 2" 
					TABINDEX="0" 
					WIDTH="5500" 
					ENABLED="TRUE"
					HEIGHT="320"/>
					
								<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partneri" 
					NAME="partneriid" 
					SQL="vipartneri#partneriid#%Naziv%" 
					TABINDEX="1" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

								 
  </FILTERFORM>

  <DODAJFORM 
                         WIDTH="9000" 
                         STORA="spMPnabavnaTotalGen @action=1,@operateriid=@@operateriid," 
                         STARTUPSTORA="select coalesce((select top 1 datum from TempPromNC order by 1 desc),getdate()+1) as datumdok, (select varset from pubvars where varime='TGaktivnatrgovina') as trgovinaid, (select varset from pubvars where varime='TGaktivnipar') as partneriid, (select naziv from partneri where partneriid= (select varset from pubvars where varime='TGaktivnipar') ) as partner" 
                         HEIGHT="4000" 
                         CAPTION="Nova nivelacija"  
                         CMD1CAPTION="Spremi" 
                         CMD2CAPTION="Odustani" 
			 CMD4CAPTION="" 
			 FILLEXPLORER="" >

                        <KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum dokumenta:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
                        
			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="select TrgovinaId,Opis as naziv  from trgovina order by 2" 
					TABINDEX="0" 
					WIDTH="5500" 
					ENABLED="FALSE"
					HEIGHT="320"/>
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="_Partner" 
					NAME="partner" 
					TABINDEX="0" 
					TEXT="" 
					ENABLED="FALSE"
					WIDTH="5500" 
					HEIGHT="320"/> 

 
	  	        <KONTROLA TYPE="TRAZILICA" CAPTION="Roba:" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userid#Robakod#Barcode%" TABINDEX="1"  WIDTH="4500" HEIGHT="320" />        
			<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Nova cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
			<KONTROLA TYPE="CM6.curMEdit6" NAME="staracijena" CAPTION="Stara cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="3" DECIMALS="2" ENABLED="FALSE" REFRESHAFTERCHILD="TRUE" 
			SQL="spMPnabavnaTotalGen @action = 5, @robaid = @@robaid , @trgovinaid = @@trgovinaid, @partneriid = @@partneriid "
			/>

			<KONTROLA TYPE="CM6.curMEdit6" NAME="partneriid" TOP="4000" CAPTION="Partneriid" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="-1" DECIMALS="2" />
  </DODAJFORM>
  

  <UPDATEFORM 
                         WIDTH="9000" 
                         STORA="spMPnabavnaTotalGen @action=1,@TempPromNCid=@@id , " 
                         STARTUPSTORA="select datum as datumdok,robaid,[Roba]=(select naziv from roba where robaid=TempPromNC.robaid) from TempPromNC where TempPromNCid=@@id" 
                         HEIGHT="4000" 
                         CAPTION="Izmjena nivelacije"  
                         CMD1CAPTION="Spremi" 
                         CMD2CAPTION="Odustani" 
			 CMD4CAPTION="" 
			 CMD5CAPTION="" 
			 FILLEXPLORER="" >

                        <KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum nivelacije:" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="-1" CHECKBOX="FALSE" />
	  	        <KONTROLA TYPE="TRAZILICA" CAPTION="Roba" NAME="robaid" SQL="virobabezusluga#RobaId#Naziv%#Userkod#Robakod#Barcode%" TABINDEX="0" WIDTH="4500" HEIGHT="320" ENABLED="FALSE" />        
			<KONTROLA TYPE="CM6.curMEdit6" NAME="cijena" CAPTION="Nova cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="2" DECIMALS="2" />
			<KONTROLA TYPE="CM6.curMEdit6" NAME="staracijena" CAPTION="Stara cijena" TEXT="" WIDTH="2500" HEIGHT="320" TABINDEX="3" DECIMALS="2" ENABLED="FALSE" />
  </UPDATEFORM>


  <DELETEFORM
		WIDTH="5500" 
		STORA="delete from TempPromNC where TempPromNCid=@@id" 
		STARTUPSTORA=""	
		HEIGHT="2500" 
		CAPTION="Obrisati ?" 
		CMD1CAPTION="Obriši"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati odabrani red ? " />
  </DELETEFORM> 


  <PROKNJIZIFORM
		WIDTH="5500" 
		STORA="spMPnabavnaTotalGen @action=4,@operateriid=@@operateriid" 
		STARTUPSTORA=""	
		HEIGHT="2500" 
		CAPTION="Proknjižiti ?" 
		CMD1CAPTION="Proknjiži"
		CMD2CAPTION="Odustani" 
		FILLEXPLORER=""> 
	
   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite proknjižiti nivelaciju ? " />
	
  </PROKNJIZIFORM> 
  


  

</PROJECT>
 
