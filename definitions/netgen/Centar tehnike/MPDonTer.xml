</DONOS>
	<BRISI
	  WIDTH="5500" 
	  STORA="spMPPrijenosTerminal @action = 5 , @id=@@id, @trgovinaid = @@trgovinaid, @datumod = @@datumod, " 
	  STARTUPSTORA="select 1 as jedanart, 0 as sviart, (select rtrim(cast(userid as varchar)) + ' ' +naziv as Naziv from roba where robaid = (select robaid from ptprijenos where ptprijenosid=@@id)) as pitanje"	
	  HEIGHT="3000" 
	  CAPTION="Obrisati ?" 
	  CMD1CAPTION="Obriši"
	  CMD2CAPTION="Odustani" 
