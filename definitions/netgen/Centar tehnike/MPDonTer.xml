		 STARTUPSTORA="select getdate() as datumod, 11 as trgovinaid, napomena = case when (select top 1 ptprijenosid from ptprijenos where trgovinaid = 11 and datum = '20081206' and ind = 1 and operateriid = 7) is not null then 'Postoji neproknjiženi prijenos! Želite li donijeti novi ? ' else '' end" 
			CANCELSTORA="" FILLEXPLORER="" NEXTFORM=""
