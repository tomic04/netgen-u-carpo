		 CMD5CAPTION="" CMD6CAPTION="" CHILDFORM="">


	<KONTROLA TYPE="VB.Label" NAME="napomena" TOP="115" LEFT="515"
	 HEIGHT="1786" WIDTH="3701" VISIBLE="TRUE" BOLD="TRUE"
