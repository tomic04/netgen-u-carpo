		 STARTUPSTORA="select napomena = case when exists (select * from PTPrijenos where OperateriId = @@operateriid AND trgovinaid = @@trgovinaid AND ind = &apos;1&apos; and robaid IS NULL) then &apos;Imate nepovezanih artikala. Nepovezani artikli neće se proknjižiti u dokument. Jeste li sigurni da želite napraviti dokument?&apos; else &apos;Svi artikli su prepoznati, dokument će biti kreiran!&apos; end" CANCELSTORA="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="Napravi" CMD2CAPTION="Odustrani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" REPORT="" DBLCLICKFORM=""
		>
	<KONTROLA TYPE="VB.Label" NAME="napomena" TOP="115" LEFT="115"
