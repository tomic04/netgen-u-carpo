		 TEXT="" VALUE="" ALLOWEMPTY="FALSE" REFRESHAFTERCHILD="TRUE"
		 CAPTION="Trgovina" TABINDEX="0" ENABLED="TRUE"/>

	<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Roba: " 
			NAME="robaid" 
			SQL="virobabezusluga#robaid#Naziv%#userid#barcode"
			TEXT=""
			TABINDEX="2" 
			WIDTH="5000" 
			HEIGHT="320"/>

	<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" NAME="umirovljen" 
		 HEIGHT="302" WIDTH="2880" EMPTY="FALSE" VISIBLE="TRUE" SQL="select 1 as umirovljen,&apos;Umirovljena&apos; as naziv union all select 2 as umirovljen,&apos;Aktivna&apos; as naziv "
		 TEXT="" VALUE="" ALLOWEMPTY="true" REFRESHAFTERCHILD="TRUE"
		 CAPTION="Status robe: " TABINDEX="3" ENABLED="TRUE"/>


	<KONTROLA TYPE="CBEx3VB6.ComboBoxEx3" NAME="stanje" 
		 HEIGHT="302" WIDTH="2880" VISIBLE="True" SQL="select 1 as stanje,&apos;Roba sa stanjem 0&apos; as naziv union all select 2 as stanje,&apos;Roba na stanju&apos; as naziv"
		 TEXT="" VALUE="" ALLOWEMPTY="TRUE" REFRESHAFTERCHILD="true"
		 CAPTION="Stanje robe:" TABINDEX="4" ENABLED="True"/>


</FILTERFORM>

<UMIROVLJENJE NAME="UMIROVLJENJE" HEIGHT="3312" WIDTH="7502" TEXT=""
