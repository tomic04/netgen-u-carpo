		 STORA="spMPUmiroviRobu @action = 1,@id=@@id,"
		 STARTUPSTORA="select s.mpstanjeid,s.robaid, r.userid, r.naziv as naziv from mpstanje s inner join roba r on s.robaid=r.robaid where mpstanjeid=@@id" 
