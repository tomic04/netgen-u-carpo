<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   ONLOAD=":FILTERFORM" 
   CMD2CAPTION=""    
   CMD4CAPTION="" 
   CMD3CAPTION=""
   CMD1CAPTION=""
   CMD5CAPTION=""
   CMD6CAPTION=""
   CHECKBOXVISIBLE="FALSE"
   POPUPMASTER=""
   TOTALROW="FALSE"
   MASTERDBLCLICK="UPDATEFORM"
   BUTTONS="Parametri:FILTERFORM#Dodaj:DODAJFORM#Izmjeni:UPDATEFORM#Obriši:DELETEFORM"
   SETDEFAULTS="select dbo.fnTkoSmoMi() as tkosmomi"
   PAGEHEADERRIGHT="@@tkosmomi"
>
 
  <NAME>Ažuriranje pos koda banke u MP  </NAME>
  <CAPTION>Ažuriranje pos koda banke u MP </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR> KK 23.02.2009.  </AUTOR>


  <FILTERFORM NAME="FILTERFORM" HEIGHT="2254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPBankaPOSKod @action=0, "
		 ONLOAD="" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="Pokaži" 
		 CMD2CAPTION="Odustani" 
		 >
		 <INPUT TYPE="combo" NAME="posbanka" ALLOWEMPTY="TRUE" CAPTION="Prikaz " ONLOSTFOCUS="" 
		 SQL="select 'ZABA ' as posbanka union all select 'PBZ ' union all select 'RBA ' union all select 'ERSTE ' union all select 'OTP ' union all select 'MONRI '" />
  </FILTERFORM>



  <DODAJFORM 
                WIDTH="7500" 
                ONSUBMIT="" 
                ONLOAD="select '@@posbanka' as posbanka" 
                ONLOADED=""
                HEIGHT="2500" 
                CAPTION="Unos podataka"  
		DETCHECKBOXVISIBLE="FALSE"	
		DETTOTALROWVISIBLE="FALSE"
		FOCUS="kod"
		 >

		 <INPUT TYPE="combo" CAPTION="Banka" NAME="posbanka" ALLOWEMPTY="FALSE" 
			SQL="select 'ZABA ' as posbanka2 union all select 'PBZ ' union all select 'RBA ' union all select 'ERSTE ' union all select 'OTP '" 	 
			TABINDEX="1" WIDTH="2000" HEIGHT="320" ENABLED="FALSE" />
	  	 <INPUT TYPE="text" CAPTION="Kod" NAME="kod" SQL="" TABINDEX="2" WIDTH="1000" HEIGHT="320" ENABLED="TRUE" />
		 <INPUT TYPE="text" CAPTION="Opis koda" NAME="OpisKoda" SQL="" TABINDEX="3" WIDTH="4000" HEIGHT="320" ENABLED="TRUE" />
		 <INPUT TYPE="number" CAPTION="Ind.koda" NAME="indkod" SQL="" TABINDEX="4" WIDTH="500" HEIGHT="320" ENABLED="TRUE" DECIMALS="0"/>

	  	 <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322"
			ONCLICK="spMPBankaPOSKod @action=3, @posbanka = '@@posbanka', @kod = '@@kod' , @OpisKoda = '@@OpisKoda' , @indkod = @@indkod #OK"  />
	  	 <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	  
	  
  </DODAJFORM>




  <UPDATEFORM 
                WIDTH="7500" 
                ONSUBMIT="" 
                ONLOAD="spMPBankaPOSKod @action=1, @MPBankaPOSKodid = @@MPBankaPOSKodid" 
                HEIGHT="2500" 
                CAPTION="Izmjena podataka"  
		DETCHECKBOXVISIBLE="FALSE"	
		DETTOTALROWVISIBLE="FALSE"
		FOCUS="kod"
		 >

		 <INPUT TYPE="combo" CAPTION="Banka" NAME="posbanka" ALLOWEMPTY="FALSE"
			SQL="select 'ZABA ' as posbanka union all select 'PBZ ' union all select 'RBA ' union all select 'ERSTE ' union all select 'OTP '" 
			TABINDEX="1" WIDTH="2000" HEIGHT="320" ENABLED="FALSE" />
	  	 <INPUT TYPE="text" CAPTION="Kod" NAME="kod" SQL="" TABINDEX="2" WIDTH="1000" HEIGHT="320" ENABLED="TRUE" />
		 <INPUT TYPE="text" CAPTION="Opis koda" NAME="OpisKoda" SQL="" TABINDEX="3" WIDTH="4000" HEIGHT="320" ENABLED="TRUE" />
		 <INPUT TYPE="number" CAPTION="Ind.koda" NAME="indkod" SQL="" TABINDEX="4" WIDTH="500" HEIGHT="320" ENABLED="TRUE" DECIMALS="0"/>

	  	 <INPUT TYPE="button" NAME="ok" CAPTION="Spremi (F2)" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322"
			ONCLICK="spMPBankaPOSKod @action=2, @MPBankaPOSKodid = @@MPBankaPOSKodid, @posbanka = '@@posbanka', @kod = '@@kod' , @OpisKoda = '@@OpisKoda' , @indkod = @@indkod #OK"  />
	  	 <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />


  </UPDATEFORM>



  <DELETEFORM 
                WIDTH="7500" 
                ONSUBMIT="" 
                ONLOAD="spMPBankaPOSKod @action=1, @MPBankaPOSKodid = @@MPBankaPOSKodid" 
                HEIGHT="2500" 
                CAPTION="Brisanje podataka"  
		DETCHECKBOXVISIBLE="FALSE"	
		DETTOTALROWVISIBLE="FALSE"
		FOCUS=""
		 >

		 <INPUT TYPE="combo" CAPTION="Banka" NAME="posbanka" ALLOWEMPTY="FALSE"
			SQL="select 'ZABA ' as posbanka union all select 'PBZ ' union all select 'RBA ' union all select 'ERSTE ' union all select 'OTP '" 
			TABINDEX="1" WIDTH="2000" HEIGHT="320" ENABLED="FALSE" />
	  	 <INPUT TYPE="text" CAPTION="Kod" NAME="kod" SQL="" TABINDEX="2" WIDTH="1000" HEIGHT="320" ENABLED="FALSE" />
		 <INPUT TYPE="text" CAPTION="Opis koda" NAME="OpisKoda" SQL="" TABINDEX="3" WIDTH="4000" HEIGHT="320" ENABLED="FALSE" />
		 <INPUT TYPE="number" CAPTION="Ind.koda" NAME="indkod" SQL="" TABINDEX="4" WIDTH="500" HEIGHT="320" ENABLED="FALSE" DECIMALS="0"/>

	  	 <INPUT TYPE="button" NAME="ok" CAPTION="Obriši (F2)" TOP="2300" LEFT="196" WIDTH="1106" HEIGHT="322"
			ONCLICK="spMPBankaPOSKod @action=4, @MPBankaPOSKodid = @@MPBankaPOSKodid #OK"  />
	  	 <INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2300" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

  </DELETEFORM>


</PROJECT>
 
