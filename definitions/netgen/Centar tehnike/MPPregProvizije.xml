<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT
   ONLOAD=":FILTERFORM"
      CMD1CAPTION="Uvjeti:FILTERFORM"
      CMD2CAPTION=""
      CMD7CAPTION="Lista"
      CMD8CAPTION="Dokument"
      REPORT=""
      MASTERDBLCLICK=""
	  CHECKBOXVISIBLE="FALSE"
      POPUPMASTER="">

	<NAME>Pregled provizija po načinu plaćanja</NAME>
	<CAPTION>Pregled provizija po načinu plaćanja</CAPTION>

	<KOMENTAR> ASDASD </KOMENTAR>




	<FILTERFORM
						   FILLEXPLORER="TRUE"
						   REPORT=""
						   WIDTH="9000"
						   ONSUBMIT="spmpPregProvizije @action =1, @operateriid = @@operateriid , "
						   ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid"
						   HEIGHT="3800"
						   CAPTION="Upišite uvjete "
						   BORDERSTYLE="3"
									CMD1CAPTION="Pokaži ->>"
									CMD2CAPTION="Odustani"
									CMD3CAPTION=""
									NEXTFORM=""  >

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
		<INPUT TYPE="combo" NAME="kntnacinplacid"
			ALLOWEMPTY="TRUE" CAPTION="Način plaćanja:" ONLOSTFOCUS="" SQL="spmpDajNacPacanjaKase" />




	</FILTERFORM>


	<FILTERFORM1
						 FILLEXPLORER="TRUE"
						 REPORT=""
						 WIDTH="8000"
						 ONSUBMIT=""
						 ONLOAD=""
						 HEIGHT="4800"
						 CAPTION="Upišite uvjete pregleda "
						 BORDERSTYLE="3"
								  CMD1CAPTION="Pokaži"
								  CMD2CAPTION="Odustani"
								  CMD3CAPTION=""
								  NEXTFORM=""  >

		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="vrstapromid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta prometa:" ONLOSTFOCUS="select 'refresh' as vrstadokid" SQL="spMPDajVrstaProm  " />
		<INPUT TYPE="combo" NAME="vrstadokid"
			ALLOWEMPTY="TRUE" CAPTION="Vrsta dokumenta:" ONLOSTFOCUS="" SQL="spMPDajVrstaDok  @vrstapromid = @@vrstapromid" />
		<INPUT TYPE="combo" NAME="trgovinaid"
			ALLOWEMPTY="TRUE" CAPTION="Trgovina (izlaza)" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />


	</FILTERFORM1>




</PROJECT>

