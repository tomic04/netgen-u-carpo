<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	STARTUPSTORA=":FORM1"  		
	REPORT="" 	
	CMD2CAPTION="Dodaj:DODAJFORM"    
   	CMD3CAPTION="Izmjeni:IZMJENIFORM" 
   	CMD4CAPTION=""
	CMD1CAPTION="Filter:FORM1" 
	CMD5CAPTION="Promet:PROMET" 
	CMD6CAPTION="Zaključi:ZAKLJUCI" 
	DBLCLICKFORM=""
	REFRESHAFTERCHILD="TRUE"
	POPUP=""> 
 
 	<NAME>Evidencija zaprimanja i vraćanja čekova - KREDIT</NAME>
	<CAPTION>Evidencija zaprimanja i vraćanja čekova - KREDIT</CAPTION>
  
  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		STORA="spPologCekovaQuery @action=1, " 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Osoba: " 
		
			  NAME="PKOsobeid" 
			SQL="ViPKosobe#pkosobeid#Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]" 
			TABINDEX="1" 
			TEXT="" 
			WIDTH="5500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
                	NAME="datumod" 
                        CAPTION="Datum od" 
                        VALUE="DATE1" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="3" 
                        CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
  			NAME="datumdo" 
                        CAPTION="Datum do" 
                        VALUE="DATE2" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="4" 
                        CHECKBOX="FALSE"/>
	</FORM1>

	<DODAJFORM
		WIDTH="9000" 
                STORA="spPologCekovaAzur @action=1, @operateriid = @@operateriid, " 
		STARTUPSTORA="select getdate() as datumdok, @@pkosobeid as pkosobeid, @@bankaid as bankaid, @@pkosobekreditiid as pkosobekreditiid" 
		HEIGHT="5500" 
		CAPTION="Novi ček"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datumdok" 
			CAPTION="Datum dokumenta:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Osoba: " 
			NAME="PKOsobeid" 
			SQL="ViPKosobe#pkosobeid#Naziv%#Mjesto#ADRESA#JMBG#[Broj OI]" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="5500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="pkosobekreditiid" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="FALSE" 
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select pkosobekreditiid, partija as Naziv from pkosobekrediti where pkosobeid=@@pkosobeid"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="BankaId" 
                        CAPTION="Banka" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="TRUE" 
						
			REFRESHAFTERCHILD="TRUE" 
 	                SQL="select partneriid, naziv from partneri where partneriid in
				(select partneriid from lnPartneri where klPartneriId=
				(select varset from pubvars where VarIme='KlasaBanke')  ) order by naziv"/>

               	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                       	NAME="BrojCeka" 
			TEXT=""
                      	CAPTION="Broj čeka" 
                       	WIDTH="5500" 
                       	HEIGHT="320" 
                       	TABINDEX="5" />
								 
  </DODAJFORM>

	<IZMJENIFORM
		WIDTH="9000" 
                STORA="spPologCekovaAzur @action=2, @Id=@@Id, @operateriid = @@operateriid,  " 
		STARTUPSTORA="spPologCekovaQuery @action=2, @Id=@@Id" 
		HEIGHT="5500" 
		CAPTION="Izmjena čeka"  
        CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
			CAPTION="Partner" 
			NAME="Partner" 
			TABINDEX="2" 
			ENABLED="FALSE" 
			WIDTH="5500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
			NAME="Partija" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE"
			ENABLED="FALSE"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="BankaId" 
                        CAPTION="Banka" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE" 
 	                SQL="select partneriid, naziv from partneri where partneriid in
				(select partneriid from lnPartneri where klPartneriId=
				(select varset from pubvars where VarIme='KlasaBanke')  ) order by naziv"/>

               	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                       	NAME="brojceka" 
                      	CAPTION="Broj čeka" 
                       	WIDTH="5500" 
                       	HEIGHT="320" 
                       	TABINDEX="5" />
								 
  </IZMJENIFORM>

	<VRATIFORM
		WIDTH="9000" 
                STORA="spPologCekovaAzur @action=3, @Id=@@pologcekovaid, " 
		STARTUPSTORA="spPologCekovaQuery @action=3, @Id=@@promet" 
		HEIGHT="5500" 
		CAPTION="Vrati ček"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

                         
		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
			CAPTION="Partner" 
			NAME="Partner" 
			SQL="select naziv from partneri where partneriid = @@partneriid" 
			TABINDEX="1" 
			ENABLED="FALSE" 
			WIDTH="5500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
			NAME="Partija" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE"
			ENABLED="FALSE"
 	                SQL="select MaloprodajaGlaId, partija as Naziv from MaloprodajaGla where partneriid=@@PartneriId"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="BankaId" 
                        CAPTION="Banka" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE" 
			ENABLED="FALSE"
 	                SQL="select partneriid, naziv from partneri where partneriid in
				(select partneriid from lnPartneri where klPartneriId=
				(select varset from pubvars where VarIme='KlasaBanke')  ) order by naziv"/>

               	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                       	NAME="BrojCeka" 
			TEXT=""
                      	CAPTION="Broj čeka" 
                       	WIDTH="5500" 
                       	HEIGHT="320" 
			ENABLED="FALSE"
                       	TABINDEX="5" />

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datumPovrata" 
			CAPTION="Datum povrata:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="6" 
			CHECKBOX="FALSE" />

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
			CAPTION="pologcekovaid" 
			NAME="pologcekovaid" 
			SQL="" 
			TOP="66666"
			LEFT="66666" 
			TABINDEX="1" 
			ENABLED="FALSE" 
			WIDTH="5500" 
			HEIGHT="320"/>



	</VRATIFORM>

	<ZAKLJUCI
				 FILLEXPLORER="" 
				 REPORT=""  
				 WIDTH="8000" 
				 STORA="spPologCekovaAzur @action=4, @Id=@@Id, " 
				 STARTUPSTORA="spPologCekovaQuery @action = 3, @Id=@@Id" 
				 HEIGHT="6500" 
				 CAPTION="Želite li zaključiti ček ?? "  
				DBLCLICKFORM=""
				 BORDERSTYLE="3" 
						  CMD1CAPTION="Zaključi" 
						  CMD2CAPTION="Odustrani"
			
						  NEXTFORM=""  >

		<KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datumdok" CAPTION="Datum kredita" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="1" ENABLED="FALSE" CHECKBOX="FALSE" />
		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="BrojCeka" 
				CAPTION="Broj čeka" 
				TEXT="" 
				WIDTH="3500" 
				HEIGHT="320" 
				TABINDEX="1" 
				ENABLED="FALSE" />

		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="banka" 
				CAPTION="_Banka" 
				TEXT="" 
				WIDTH="3500" 
				HEIGHT="320" 
				TABINDEX="1" 
				ENABLED="FALSE" />


		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="partija" 
				CAPTION="Partija: " 
				TEXT="" 
				WIDTH="2500" 
				HEIGHT="320" 
				TABINDEX="1" 
				ENABLED="FALSE" />
		<KONTROLA TYPE="TMEdit2.TextMEdit2" 
				NAME="partner" 
				CAPTION="Osoba: " 
				TEXT="" 
				WIDTH="3500" 
				HEIGHT="320" 
				TABINDEX="1" 
				ENABLED="FALSE" />




	</ZAKLJUCI>
	
	<PROMET
		FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="7500" 
		CAPTION="Popis čekova " 
		BORDERSTYLE="3" 
		CMD1CAPTION="Odustani" 
		CMD2CAPTION="" 
		CMD3CAPTION="Vrati:VRATIFORM" 
		NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="Promet" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="12000" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spPologCekovaQuery @action = 6, @Id=@@Id" 
                                          />

	</PROMET>



</PROJECT> 