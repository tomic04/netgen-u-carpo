<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Po Klasi:KLASE" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Realizacija u MP kumulativno</NAME>
  <CAPTION>Realizacija u MP kumulativno</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPRealizacijaKum @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

			
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="5" 
                                    	CHECKBOX="FALSE"/>
										

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spmpdajvrstadokmoze 2,null"/>
										

  </FORM1>

	<KLASE FILLEXPLORER="TRUE" 
		  WIDTH="10000" 
		  STORA=""
		  STARTUPSTORA="" 
		  HEIGHT="7500" 
		  CAPTION="Parametri" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="" 
		  CMD2CAPTION="Povratak" 
		  CMD3CAPTION="Stavke:STAVKE" 
		  CHILDFORM="">

		<KONTROLA TYPE="GridEX20.GridEX" 
				  NAME="stavke" 
				  REFRESHAFTERCHILD="TRUE" 
				  LEFT="100"
				  CAPTION="" 
				  WIDTH="9500" 
				  HEIGHT="6300" 
				  TABINDEX="5" 
	  SQL="spMPRealizacijaKum @action=2, @operateriid = @@operateriid,@id = '@@id'" 
                                          />


	</KLASE>

	<STAVKE FILLEXPLORER="TRUE" 
		  WIDTH="12000" 
		  STORA=""
		  STARTUPSTORA="" 
		  HEIGHT="7500" 
		  CAPTION="Parametri" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Stavke" 
		  CMD2CAPTION="Povratak" 
		  CMD3CAPTION="" 
		  CHILDFORM="">

		<KONTROLA TYPE="GridEX20.GridEX" 
				  NAME="stavke" 
				  REFRESHAFTERCHILD="TRUE" 
				  LEFT="100"
				  CAPTION="" 
				  WIDTH="11500" 
				  HEIGHT="6300" 
				  TABINDEX="5" 
	  SQL="spMPRealizacijaKum @action=3, @operateriid = @@operateriid,@id = '@@STAVKE'" 
                                          />


	</STAVKE>



</PROJECT> 