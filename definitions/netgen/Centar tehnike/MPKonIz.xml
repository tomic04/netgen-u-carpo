<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="Promet MP:PROMETMP"
 		CMD5CAPTION="Promet SKL:PROMETSKL" 
		CMD6CAPTION="Promet OTP:PROMETOTP"  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Analiza izdatnica iz VP u MP  </NAME>
  <CAPTION>Analiza izdatnica iz VP u MP </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPKontrolaIzdatnica @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>

					  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
									  NAME="sifra" 
									  CAPTION="Vrsta prometa" 
									  WIDTH="5500" 
								  HEIGHT="320" 
									  TABINDEX="4" 
								  ALLOWEMPTY="false" 
								  SQL="select '104' as sifra, 'Izdatnica iz VP u MP' as naziv union all select '302' , 'Povratnica iz MP u VP' union all select '106' , 'Otpremnica MP' union all select '302' , 'Fakture MP'"/>

					  <KONTROLA TYPE="VB.checkbox" 
									  NAME="Razlike" 
									  WIDTH="3500" 
									  HEIGHT="320" 
									  CAPTION="Samo razlike"/>



  </FORM1>
