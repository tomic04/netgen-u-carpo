<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
  SETDEFAULTS="select 1 as ind"
	BUTTONS="Izmjeni:UPDATEFORM#Promoviraj status:MULTISELECT_FORMA(@ind=1)#Vrati status:MULTISELECT_FORMA(@ind=-1)#Osvježi prikaz:REFRESHMASTERGRID#Ispis:vrstadokid-ProNOtpGla" 
	ONLOAD="dbo.spProNOtpGlaQuery_Otprema @statusotpreme = 3" 	
	DETAILGRID = "exec dbo.spProNOtpDetQuery_Otprema @pronotpglaid = @@id"	
  DETCHECKBOXVISIBLE="FALSE"
  MASTERDBLCLICK=":UPDATEFORM"
  HELPKOD="MER290"
  POPUP="Izmjeni:UPDATEFORM#Promoviraj status:MULTISELECT_FORMA(@ind=1)#Vrati status:MULTISELECT_FORMA(@ind=-1)#Osvježi prikaz:REFRESHMASTERGRID"
 >

	<NAME>Nalozi za otpremu</NAME>
	<CAPTION>Nalozi za otpremu</CAPTION>


	<MASTERCOLUMNS HEADERALIGNMENT="2">
	<COLUMN INDEX="" NAME="Status otpreme" WIDTH="1500"/>
	<COLUMN INDEX="" NAME="Naziv partnera" WIDTH="2500"/>
	<COLUMN INDEX="" NAME="Lokacija isporuke" WIDTH="2500"/>
	</MASTERCOLUMNS>


	<DETAILCOLUMNS  HEADERALIGNMENT="2">
	<COLUMN INDEX="" NAME="Šifra"       WIDTH="1000"  />
	<COLUMN INDEX="" NAME="Naziv"       WIDTH="3000"  />
	<COLUMN INDEX="" NAME="Otpremljeno" WIDTH="1500"   FORMAT="#,##0.00"  />
	<COLUMN INDEX="" NAME="Naloženo"    WIDTH="1500"   FORMAT="#,##0.00"  />
	<COLUMN INDEX="" NAME="Jed. mjere"  WIDTH="500"    CAPTION="JM"/>
	<COLUMN INDEX="" NAME="Klasa"       WIDTH="2800"  />
	</DETAILCOLUMNS>


	<UPDATEFORM 
		CAPTION="Otpremljena količina" 
		HEIGHT="7000" 
		WIDTH= "11000" 
		FILLEXPLORER="onlydet" 
		FOCUS="stavke" 
		ONESCKEY="click(btn1)"
	>

      <INPUT TYPE="grid"
				NAME="stavke"
				CAPTION="Stavke"
				CHECKBOXVISIBLE="FALSE"
				GROUPBYBOXVISIBLE="FALSE"
				TOP="100" LEFT="100" WIDTH="10500" HEIGHT="5600"
				EDITCOLUMNS="Otpremljeno"
				ONCELLEDITED="exec dbo.spProNOtpDetAzur_Otprema @pronotpdetid = @@stavke, @kolicina = @(stavke..otpremljeno)"
				SQL="exec dbo.spProNOtpDetQuery_Otprema @pronotpglaid = @@id, @check=1"
			>
          <COLUMN INDEX="" NAME="Šifra"       WIDTH="1000"  />
          <COLUMN INDEX="" NAME="Naziv"       WIDTH="3000"  />
          <COLUMN INDEX="" NAME="Otpremljeno" WIDTH="1500"   FORMAT="#,##0.00"  />
          <COLUMN INDEX="" NAME="Naloženo"    WIDTH="1500"   FORMAT="#,##0.00"  />
          <COLUMN INDEX="" NAME="Jed. mjere"  WIDTH="500"    CAPTION="JM"/>
          <COLUMN INDEX="" NAME="Klasa"       WIDTH="2800"  />
      </INPUT>
      
			<INPUT TYPE="button" NAME="btn1" TOP="5900" LEFT="200" WIDTH="1000" CAPTION="Gotovo" ONCLICK="ok"  />
			<INPUT TYPE="button" NAME="btn2" TOP="5900" LEFT="1300" WIDTH="1000" CAPTION="Donos" ONCLICK=":ImportTerminal.clsImportTerminalNalogNG#select 'refresh' as stavke"  />
		
		</UPDATEFORM>

  

		<MULTISELECT_FORMA HEIGHT="2500" WIDTH="5000" CAPTION="Pripremljeno za utovar" ONLOAD="select @@ind as ind"
			ONSUBMIT=""
		>
			<INPUT TYPE="label"  TOP="600"  LEFT="590"  HEIGHT="288" WIDTH="1037" CAPTION="Jeste li sigurni ?" />
			<INPUT TYPE="button" TOP="1500" LEFT="173"  HEIGHT="331" WIDTH="1080" CAPTION="Prihvati" ONCLICK="exec dbo.spProNOtpGla_IzmijeniStatusOtpremeNG @operateriid=@@operateriid, @promoviraj=@@ind#if '@@ind'='0' select 'PROMOVIRAJ' as form#OK"/>
			<INPUT TYPE="button" TOP="1500" LEFT="1368" HEIGHT="331" WIDTH="1080" CAPTION="Odustani" ONCLICK="OK"/>
      <INPUT TYPE="text" TOP="5000" LEFT="590" HEIGHT="288" WIDTH="1037" VISIBLE="FALSE" NAME="ind" CAPTION="_ind"/>
      <INPUT TYPE="text" TOP="6000" LEFT="590" HEIGHT="288" WIDTH="1037" VISIBLE="FALSE" NAME="form" CAPTION="_form"/>
    </MULTISELECT_FORMA>

  <PROMOVIRAJ HEIGHT="2900" WIDTH="6000" CAPTION="Promoviraj" ONLOAD="select 1 as ind" ONSUBMIT="spProNOtpGla_IzmijeniStatusOtpremeNG @operateriid=@@operateriid, @promoviraj=@@ind, @indikator_datuma=1">
    <INPUT TYPE="label"  TOP="600"  LEFT="590"  HEIGHT="288" WIDTH="1037" CAPTION="Na nekim nalozima je datum dokumenta različit od datuma zaključivanja." />      
    <INPUT TYPE="label"  TOP="1000"  LEFT="590"  HEIGHT="288" WIDTH="1037" CAPTION="Želite li izmjeniti datume dokumenta na današnji i zaključiti ih ?" />
    <INPUT TYPE="button" TOP="1900" LEFT="173"  HEIGHT="331" WIDTH="1080" CAPTION="Prihvati" ONCLICK="OK"/>
    <INPUT TYPE="button" TOP="1900" LEFT="1368" HEIGHT="331" WIDTH="1080" CAPTION="Odustani" ONCLICK="CLOSE"/>


    <INPUT TYPE="text" TOP="5000" LEFT="590" HEIGHT="288" WIDTH="1037" NAME="ind" CAPTION="_ind"/>
  </PROMOVIRAJ>

</PROJECT>