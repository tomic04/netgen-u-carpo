<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Promet:PROMET" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION="Izmjeni partnere:PARTNERI"  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Pregled neispravnih kredita</NAME>
  <CAPTION>Pregled neispravnih kredita</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		STORA="spPKPregNepovezanih @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		


			<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl32" 
                                      	TOP="200" 
                                       	LEFT="200" 
                               		WIDTH="1500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                     	TOP="200" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>
			<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl69" 
                                      	TOP="1000" 
                                       	LEFT="200" 
                               		WIDTH="1500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Vrsta dokumenta"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                     	TOP="900" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select vrstadokid, Naziv  from kntnacinplac  where oznkredit = 1 and vrstadokid is not null"/>


                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbldat" 
                                      	TOP="2100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	TOP="2000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                   	TOP="2000" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>
										
			<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl66" 
                                      	TOP="2500" 
                                       	LEFT="200" 
                               		WIDTH="1500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Vrsta pregleda"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstapregid" 
                                    	CAPTION="VrstaPregleda" 
                                     	TOP="2400" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="0" 
                                   	ALLOWEMPTY="false" 
                                 	SQL="select 1 as vrstapregid, 'Nepovezani' as naziv union all select 2, 'Krivo povezani - partneri' union all select 3, 'Krivo povezani - iznosi' union all select 4,'Krediti bez računa'"/>
										

  </FORM1>
 <PROMET 	FILLEXPLORER="TRUE" 
		WIDTH="14000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="7500" 
		CAPTION="Stavke prometa" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		NEXTFORM=""> 
		
		

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="12000" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spMPStavkeDok @action=1,@id = '@@id'" 
                                          /> 

</PROMET>		

  <PARTNERI 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="10000" 
                         STORA="" 
                         STARTUPSTORA="spPKPregNepovezanih @action = 10, @id = '@@id' " 
                         HEIGHT="4800" 
                         CAPTION="IZMJENA PARTNERA"  
						 DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                         CMD1CAPTION="SPREMI" 
                         CMD2CAPTION="Odustani"
                         NEXTFORM=""  >


 			<KONTROLA TYPE="VB.Label" 
					NAME="lbl1" 
					TOP="700" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Partner 1"/> 

					
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partneri" 
					NAME="partneriid" 
					SQL="viPKKrediti#partneriid#%Naziv%#Kredit%#Ugovor%" 
					TABINDEX="1" 
					TOP="700" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="7500" 
					HEIGHT="320"/> 
					

 			<KONTROLA TYPE="VB.Label" 
					NAME="lblp1" 
					TOP="1300" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Partner 2"/> 

					
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partneri" 
					NAME="partneri2id" 
					SQL="viPKKrediti#partneriid#partneirid#%Naziv%#Kredit%#Ugovor%" 
					TABINDEX="1" 
					TOP="1200" 
					LEFT="2200" 
					TEXT="" 
					WIDTH="7500" 
					HEIGHT="320"/> 
                    


  </PARTNERI>


</PROJECT> 