<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="Etikete.clsEtikete" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Detalji:DETALJI" 
		CMD4CAPTION=""
 		CMD5CAPTION="Etikete:ETIKETE" 
		CMD6CAPTION=""  
		CMD7CAPTION="Lista"  
		CMD8CAPTION="Dokument"  
		DBLCLICKFORM=""
	        POPUP="">


	<NAME>Pregled dokumenata maloprodaje za štampanje etiketa </NAME>
	<CAPTION>Pregled dokumenata maloprodaje za štampanje etiketa </CAPTION>


	<FORM1 	FILLEXPLORER="TRUE" 
		  WIDTH="8500" 
		  STORA="spMPQueryGlaIDetNG @action=1, @operateriid = @@operateriid, @veceodstatusa = 0 , " 
		  STARTUPSTORA="" 
		  HEIGHT="5500" 
		  CAPTION="Parametri" 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Pokaži" 
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		  CHILDFORM="">


		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
		NAME="trgovinaid" 
		CAPTION="Trgovina" 
		WIDTH="5500" 
		HEIGHT="320" 
		TABINDEX="1" 
		ALLOWEMPTY="true" 
		SQL="spMPDajTrgovina @operateriid = @@operateriid"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
								  NAME="datumod" 
									  CAPTION="Datum od" 
								  VALUE="DATE2" 
								  HEIGHT="320" 
								  WIDTH="1500" 
								  TABINDEX="2" 
									  CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
					NAME="datumdo" 
					CAPTION="Datum do" 
					VALUE="DATE" 
					HEIGHT="320" 
					WIDTH="1500" 
					TABINDEX="3" 
						CHECKBOX="FALSE"/>



		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			CAPTION="Vrsta prometa" 
				NAME="vrstapromid" 
				ALLOWEMPTY="TRUE" 
				SQL="spMPDajVrstaProm" 
				TEXT=""
				TABINDEX="5" 
				WIDTH="5000" 
				HEIGHT="320"/>
		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			CAPTION="Vrsta dokumenta" 
				NAME="vrstadokid " 
				ALLOWEMPTY="TRUE" 
				SQL="spMPDajVrstaDok" 
				TEXT=""
				TABINDEX="6" 
				WIDTH="5000" 
				HEIGHT="320"/>


	</FORM1>
	<DETALJI 	FILLEXPLORER="TRUE" 
		   WIDTH="14000" 
		   STORA="" 
		   STARTUPSTORA="" 
		   HEIGHT="7500" 
		   CAPTION="Stavke prometa" 
		   BORDERSTYLE="3" 
		   CMD1CAPTION="" 
		   CMD2CAPTION="Odustani" 
		   CMD3CAPTION="" 
		   NEXTFORM="">



		<KONTROLA TYPE="GridEX20.GridEX" 
				NAME="stavke" 
				REFRESHAFTERCHILD="TRUE" 
				CAPTION="_ay" 
				TOP="200" 
				LEFT="200"  
				WIDTH="12000" 
				HEIGHT="6000" 
				TABINDEX="5" 
				  SQL="spMPQueryGlaIDet @action=2, @id = @@ID" 
                                          />

	</DETALJI>

	<ETIKETE 	FILLEXPLORER="FALSE" 
	   WIDTH="7000" 
	   STORA="spMPPripremaNaljepnica  @trgovinaid = @@trgovinaid, @action = 1, @id = @@id, @operateriid = @@operateriid, @string= ''," 
	   STARTUPSTORA="" 
	   HEIGHT="3000" 
	   CAPTION="Štampanje etiketa " 
	   BORDERSTYLE="3" 
	   CMD1CAPTION="Izvrši" 
	   CMD2CAPTION="Odustani" 
	   CMD3CAPTION="" 
	   NEXTFORM="">

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			CAPTION="Vrsta dokumenta" 
				NAME="nacin" 
				ALLOWEMPTY="FALSE" 
				SQL="select 2 as nacinid, 'Zbirne     '  as naziv union all select '1' as nacinid, 'Pojedinačne ' as Naziv " 
				TEXT=""
				TABINDEX="6" 
				WIDTH="3000" 
				HEIGHT="320"/>


		<KONTROLA TYPE="VB.checkbox" 
						NAME="winlabel" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Priprema za WIn Label"/>

		<KONTROLA TYPE="VB.checkbox" 
						NAME="Jupiter" 
						WIDTH="3500" 
						HEIGHT="320" 
						CAPTION="Štampanje iz Jupitera"/>


	</ETIKETE>


</PROJECT>
