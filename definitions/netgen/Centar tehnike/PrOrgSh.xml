<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM"  
      CMD1CAPTION="Prikaz:FILTERFORM" 
      CMD2CAPTION="Kartica konta:FORM@@vrdat" 
      CMD3CAPTION="Ispis:PRINTMASTER" 
      CMD5CAPTION="Kartica stara :KarticaKonta.clsKartica(@datumod=@@dod,@datumdo=@@ddo,@kontonaziv=@@naziv,@konto=@@aid,@orgshemaid=@@orgshemaid,@kntplanaid=@@kntplanaid)"
      MASTERDBLCLICK=""
	  CHECKBOXVISIBLE="FALSE"  
      PAGEHEADERCENTER="Pregled prometa po org.shemi"
	  PAGEHEADERRIGHT=""
	  PAGEHEADERLEFT="Od: @@dod do: @@ddo ##Konto : @@searchboxkntplanaid"
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@datdanas"
	  PAGEFOOTERRIGHT="@@tkosmomi"
	  PAGEORIENTATION="LANDSCAPE"
      SETDEFAULTS="select convert(varchar,(dateadd(month,datediff(month,0,getdate())-1,0)),112) as dod"	  
      >
 
  <NAME>Pregled prometa po org.shemi</NAME>
  <CAPTION>Pregled prometa po org.shemi</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
  
 

   <FILTERFORM 
					FILLEXPLORER="TRUE" 
					REPORT=""  
					WIDTH="7500" 
					ONSUBMIT="spKntOrgShemaPosebnoNG @action=1," 
					ONLOAD="select @@dod as dod,@@ddo as ddo,@@vrdat as vrdat, 1 as podorgsheme,@@orgshemaid as orgshemaid,@@check2 as check2, @@kntplansid as kntplansid,'@@searchboxkntplanaid' as konto , @@kntplanaid as kntplanaid, (select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas " 
					HEIGHT="4100" 
					CAPTION="Izaberite uvjete traženja"  
					BORDERSTYLE="3" 
					CMD1CAPTION="" 
					CMD2CAPTION="" 
					CMD3CAPTION=""  
					NEXTFORM=""  >
								  
                    
					<INPUT TYPE="date" 
						NAME="dod"  
						CAPTION="Razdoblje:" 
						VALUE="DATE"								
						HEIGHT="320" 
						WIDTH="1500"									
						DEFAULT=""
						CHECKBOX="FALSE"/>

                    <INPUT TYPE="label" NAME="lbldatdo" TOP="200" LEFT="3500" WIDTH="1500" HEIGHT="320" CAPTION="-"/> 	
					<INPUT TYPE="date" 
						NAME="ddo" 
                        TOP="150"						
						LEFT="3800" 
						CAPTION="-" 
						VALUE="DATE" 
						HEIGHT="320" 
						WIDTH="1500" 
						CHECKBOX="FALSE"/>

			
			<INPUT TYPE="combo"  NAME="vrdat"   TOP="150" LEFT="5500" WIDTH="1500"
			   SQL="select 0 as vrdat,'Datum knjiženja' as Naziv
					union
					select 1 as vrdat,'Datum dokumenta' as Naziv"/>


	
						
                    <INPUT TYPE="combo" 
						NAME="orgshemaid" 
						CAPTION="Org.shema:"   
						WIDTH="4250" 
						HEIGHT="320"  
						ALLOWEMPTY="TRUE" 
						SQL="select orgshemaid,naziv = space(len(sortkey)-2) + naziv,sortkey from orgshema order by sortkey" /> 
							
					<INPUT TYPE="check" NAME="podorgsheme"  WIDTH="3200" HEIGHT="330" CAPTION="Prikaži i sve ispod" VALUE="1" ONCLICK="" />		
					
					<INPUT TYPE="check" NAME="check2"  WIDTH="3200" HEIGHT="330" CAPTION="Prikaži samo klasu 4 i 7" ONCLICK="" />
					
					<INPUT TYPE="combo" 
						NAME="kntplansid" 
						CAPTION="S konto:"   
						WIDTH="4250" 
						HEIGHT="320"  
						ALLOWEMPTY="TRUE" 
						SQL="spKntOrgShemaPosebnoNG @action=2" /> 

					<INPUT TYPE="frame" NAME="fr1" TOP="2300" LEFT="100" HEIGHT="700" WIDTH="6100" CAPTION="Konto"/>					 
					<INPUT TYPE="TRAZILICA" 
						CAPTION="konto" 
						NAME="kntplanaid" 
						SQL="KntPlanA#kntplanaid#konto%#naziv%"
						TEXT="" 
						TOP="2500"
						LEFT="300"
						WIDTH="5700" 
						HEIGHT="320"
						BACKCOLOR="LIGHTYELLOW"/>   						
				    
                    <INPUT TYPE="button" NAME="ok1" HOTKEY="F4" TOP="3200" LEFT="200" WIDTH="1100" CAPTION="OK (F4)" 
					       ONCLICK="OK" />							  
					<INPUT TYPE="button" NAME="cancel" TOP="3200" LEFT="1450" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" />
							
  </FILTERFORM>


 <FORM0  FILLEXPLORER="TRUE" ONLOAD="select kntplanaid as ktoid from kntplana where konto='@@konto'"  
           ONLOADED="" WIDTH="15500" HEIGHT="9500" CAPTION="Kartica konta @@konto po datumu knjiženja" >

		<INPUT TYPE="grid" NAME="kartica" TOP="200" LEFT="200" HEIGHT="8000" WIDTH="15000"
		REFRESHAFTERCHILD="TRUE" CAPTION="Kartica konta @@konto  po datumu knjiženja  @@dod" GROUPBYBOXVISIBLE="true"  
		TOTALROW="FALSE" 
		CHECKBOXVISIBLE="FALSE" PAGEHEADERRIGHT="@@Ddatdanas" PAGEFOOTERLEFT="@@TKOSMOMI" PAGEFOOTERRIGHT="Jupiter software by Spin" 
                 SQL="spKntKarticaKontaQueryPODATKNJ @action=0,@id=@@ktoid,@datod='@@dod',@datdo='@@ddo',@konto=@@ktoid,@orgshemaid=@@orgshemaid" >                        

  		<COLUMN INDEX="" NAME="DatumKnjizenja" WIDTH="1100" CAPTION="Datum knj." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="DatumDokumenta" WIDTH="1100" CAPTION="Datum dok." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />	
		<COLUMN INDEX="" NAME="Duguje" WIDTH="1200" CAPTION="Duguje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="Potrazuje" WIDTH="1200" CAPTION="Potražuje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="Slozi" WIDTH="600" CAPTION="Slozi" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="iddok" WIDTH="600" CAPTION="iddok" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="sufix" WIDTH="600" CAPTION="sufix" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />



		</INPUT>
            
		<INPUT TYPE="button" NAME="Dokument" TOP="8500" LEFT="0800" WIDTH="1100" CAPTION="Dokument" ONCLICK=":FORMTEMELJNICA" /> 
		<INPUT TYPE="button" NAME="cancel" TOP="8500" LEFT="2250" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" /> 
							
  </FORM0>



 <FORM1  FILLEXPLORER="TRUE" ONLOAD="select kntplanaid as ktoid  from kntplana where konto='@@konto'" 
           ONLOADED="" WIDTH="15500" HEIGHT="9500" CAPTION="Kartica konta @@konto po datumu dokumenta" >

		<INPUT TYPE="grid" NAME="kartica" TOP="200" LEFT="200" HEIGHT="8000" WIDTH="15000"
		REFRESHAFTERCHILD="TRUE" CAPTION="Kartica konta po datumu dokumenta" GROUPBYBOXVISIBLE="true" 
		TOTALROW="FALSE" 
		CHECKBOXVISIBLE="FALSE" PAGEHEADERRIGHT="@@Ddatdanas" PAGEFOOTERLEFT="@@TKOSMOMI" PAGEFOOTERRIGHT="Jupiter software by Spin" 
                 SQL="spKntKarticakontaQueryPoDATDOK @action=0,@id=@@ktoid,@datod='@@dod',@datdo='@@ddo',@konto=@@ktoid,@orgshemaid=@@orgshemaid">   

		<COLUMN INDEX="" NAME="DatumKnjizenja" WIDTH="1100" CAPTION="Datum knj." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="DatumDokumenta" WIDTH="1100" CAPTION="Datum dok." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />	
		<COLUMN INDEX="" NAME="Duguje" WIDTH="1200" CAPTION="Duguje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="Potrazuje" WIDTH="1200" CAPTION="Potražuje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="Slozi" WIDTH="600" CAPTION="Slozi" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="iddok" WIDTH="600" CAPTION="iddok" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="sufix" WIDTH="600" CAPTION="sufix" FORMAT="" VISIBLE="DISABLE" FORECOLOR="" BACKCOLOR="" />



		</INPUT>   

	<INPUT TYPE="button" NAME="Dokument" TOP="8500" LEFT="0800" WIDTH="1100" CAPTION="Dokument" ONCLICK=":FORMTEMELJNICA" /> 

	<INPUT TYPE="button" NAME="cancel" TOP="8500" LEFT="2250" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" />                  
            						
  </FORM1>



 <FORMTEMELJNICA  FILLEXPLORER="TRUE" ONLOAD="" 
           ONLOADED="" WIDTH="15500" HEIGHT="9500" CAPTION="Temeljnica @@gridkarticaOpis Datum knjiženja: @@gridkarticaDatum_knj  Broj: @@gridkarticaBrojDok" >

		<INPUT TYPE="grid" NAME="TEMELJNICA" TOP="200" LEFT="200" HEIGHT="8000" WIDTH="15000"
		REFRESHAFTERCHILD="TRUE" CAPTION="Temeljnica" GROUPBYBOXVISIBLE="true" 
		TOTALROW="TRUE" 
		CHECKBOXVISIBLE="FALSE" PAGEHEADERRIGHT="@@Ddatdanas" PAGEFOOTERLEFT="@@TKOSMOMI" PAGEFOOTERRIGHT="Jupiter software by Spin" 
                 SQL="spKntPrometQueryKarticaPoDATDOK @id=@@gridkarticaKntTemId">   


		<COLUMN INDEX="" NAME="Konto" WIDTH="1100" CAPTION="Konto" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="naziv" WIDTH="2100" CAPTION="Naziv" FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="DatumKnjizenja" WIDTH="1100" CAPTION="Datum knj." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="DatumDokumenta" WIDTH="1100" CAPTION="Datum dok." FORMAT="" VISIBLE="" FORECOLOR="" BACKCOLOR="" />	
		<COLUMN INDEX="" NAME="Duguje" WIDTH="1200" CAPTION="Duguje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="Potrazuje" WIDTH="1200" CAPTION="Potražuje" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		<COLUMN INDEX="" NAME="devdug" WIDTH="1200" CAPTION="DevDug" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
	   	<COLUMN INDEX="" NAME="devpot" WIDTH="1200" CAPTION="DevPot" FORMAT="#,##0.00" VISIBLE="" FORECOLOR="" BACKCOLOR="" />
		
		



		</INPUT>   

	<INPUT TYPE="button" NAME="cancel" TOP="8500" LEFT="1450" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" />                  
            						
  </FORMTEMELJNICA>




</PROJECT>
 
