<?xml version="1.0" encoding="windows-1250" ?> 
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Parametri:FILTERFORM" 
      CMD2CAPTION="Izmjeni:UPDATEFORM" 
      CMD3CAPTION="Proknjiži:PROKNJIZIFORM" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="" 
      DBLCLICKFORM="UPDATEFORM"
      POPUP="">
 
  <NAME>Pregled komisijske MP robe za odjavu</NAME>
  <CAPTION>Pregled komisijske MP robe za odjavu</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

  <FILTERFORM 
                         FILLEXPLORER="true" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spMPPregKomisijskeMPRobeNew @action=1," 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Filter"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM="" >


                      					
                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="500" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje:"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datod" 
                                   	TOP="500" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datdo" 
                                   	TOP="500" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      	TOP="1100" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina:" 
                                     	TOP="1100" 
                                     	LEFT="2200"  
                                    	WIDTH="5000" 
                                   	HEIGHT="320" 
                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid " /> 

			<KONTROLA TYPE="VB.Label" 
					NAME="lbl3" 
					TOP="1700" 
					LEFT="200" 
					WIDTH="1500" 
					CAPTION="Partner"/> 

			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Partner" 
					NAME="partneriid" 
					SQL="Partneri#partneriid#naziv%" 
					TOP="1700" 
					LEFT="2200" 
					TEXT=""
					TABINDEX="4" 
					WIDTH="5000" 
					HEIGHT="320"/>



  </FILTERFORM>


  <UPDATEFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="4000" 
                         STORA="spMPPregKomisijskeMPRobeNew @action=2, @id=@@id, @datod=null,@datdo=null," 
                         STARTUPSTORA="" 
                         HEIGHT="2500" 
                         CAPTION="Izmjena stavke"  
			 DBLCLICKFORM="IZMIJENISTAVKU"
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Spremi" 
                                  CMD2CAPTION="Odustani"
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                                  CMD6CAPTION=""
                                  NEXTFORM=""  >


                      	 <KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="500" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Količina:"/>

                     	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                                 	NAME="kolicina" 
                                   	TOP="500" 
                                   	LEFT="1200" 
                                    	CAPTION="" 
                                   	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>


  </UPDATEFORM>


  <PROKNJIZIFORM 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="5000" 
                         STORA="spMPPregKomisijskeMPRobeNew @action=3, @datod=null,@datdo=null, @operateriid=@@operateriid" 
                         STARTUPSTORA="" 
                         HEIGHT="2000" 
                         CAPTION="Knjiženje dokumenta"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Odjavi" 
                                  CMD2CAPTION="Odustani"
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                                  CMD6CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl1" 
                                      	TOP="300" 
                                       	LEFT="200" 
                               		WIDTH="4000" 		
                                   	HEIGHT="800" 
					BOLD="TRUE"
                               		CAPTION="Jeste li sigurni da želite odjaviti stavke s navedenim količinama?" /> 

  </PROKNJIZIFORM>

</PROJECT>
 
