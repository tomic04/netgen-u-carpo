<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = @@nenc"
		 ONLOAD=":FORM1" 
		 MASTERDBLCLICK=""
		 MULTIGRIDLAYOUT="TRUE" 
		 CMD1CAPTION="Parametri:FILTERFORM" 
		 CMD2CAPTION="Načini plaćanja:NACPLAC2"
		 CMD3CAPTION="" 
		 CMD4CAPTION="Promjena vrste trgovine/pregleda:FORM1" 
		 CMD5CAPTION="" 		
		 CMD6CAPTION="Print dok.:vrstadokid-MaloprodajaGla"
		 POPUPMASTER="Parametri:FILTERFORM" 
	     TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE" 
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE" >

	<NAME>Pregled utržaka MP</NAME>
	<CAPTION>Pregled utržaka MP </CAPTION>


	<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @node='danas', @sifradok=@@sifradok" />
	<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @node='jucer', @sifradok=@@sifradok" />
	<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @node='ovajmj', @sifradok=@@sifradok" />
	<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @node='proslimj', @sifradok=@@sifradok" />
	<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @node='@@node', @sifradok=@@sifradok" />




<FORM1
	NAME="FORM1" HEIGHT="4000" WIDTH="9000"
	CAPTION="Izbor vrste trgovine odnosno vrste dokumenta"
	FILLEXPLORER="" >

	<INPUT TYPE="combo" NAME="sifradok" CAPTION="Vrsta trgovine/pregleda:*" TOP="1000" LEFT="2300" HEIGHT="302" WIDTH="6000" VISIBLE="TRUE"
		   SQL="select 98 as id, 'Pregled mp utržaka za maloprodaje iz vlastite trgovačke mreže' as naziv union all select 97, 'Pregled zaključaka blagajne za maloprodaje iz veleprodaje' " 
		   ALLOWEMPTY="FALSE" ENABLED="TRUE"/>

	<INPUT TYPE="button" NAME="ok" CAPTION="Odaberi" TOP="2000" LEFT="1200" WIDTH="1400" HEIGHT="322" ONCLICK="ok"  />

</FORM1>
	
		
<FILTERFORM NAME="FILTERFORM" 
	HEIGHT="3000" 
	WIDTH="7500" 
	CAPTION="Upišite uvjete prikaza " 
	ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @operateriid= @@operateriid, @nenc = @@nenc, @sifradok=@@sifradok, "
	ONLOAD="If @@sifradok=98 begin select 'M' as vrstatrg end else begin select 'V' as vrstatrg end" 
	FILLEXPLORER="TRUE" 
	NEXTFORM=""
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani">
	
	<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od:" />
	<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do:" />
	<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina:" SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @vrstatrg=@@vrstatrg " />
	
</FILTERFORM>


<NACPLAC2
	NAME="NACPLAC2" HEIGHT="5000" WIDTH="7500"
	CAPTION="Pregled načina plaćanja utrška"
	ONSUBMIT=""
	ONLOAD=""
	CANCELONSUBMIT="" FILLEXPLORER="" >

		<INPUT TYPE="grid"
			   NAME="GridTG6" TOP="200" LEFT="200"
			   HEIGHT="3000" WIDTH="7000" VISIBLE="TRUE"
			   SQL="spMPUtrzakTotalGen @action = 7, @id=@@id"
			   CHECKBOXVISIBLE="FALSE"/>

		<INPUT TYPE="button" NAME="cancel" CAPTION="Povratak" TOP="3700" LEFT="3000" WIDTH="1400" HEIGHT="322" ONCLICK="close"  />

</NACPLAC2>
	
</PROJECT>