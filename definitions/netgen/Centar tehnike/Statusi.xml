<INSERTOPFORM NAME="INSERTOPFORM" HEIGHT="6797" WIDTH="9994" CAPTION="Dodaj/ukloni operatera" ONLOAD="if (select aktivan from statusi where statusiid = @@statusiid) = 0 begin 
raiserror (&apos;Opcija dodaj/ukloni operatera nije moguća za isključene statuse!&apos;, 16, 1)
return
end
select @@statusiid as statusiid" FILLEXPLORER="ONLYDET" TOP="302" BORDERSTYLE="3">
	<INPUT TYPE="frame" NAME="fr1" TOP="101" LEFT="101" HEIGHT="5602" WIDTH="4406" TEXT="FrameNG2" CAPTION="Operateri koji nisu dodijeljeni statusu:"/>
	<INPUT TYPE="frame" NAME="fr1" TOP="101" LEFT="5299" HEIGHT="5602" WIDTH="4406" TEXT="FrameNG3" CAPTION="Operateri dodijeljeni statusu:"/>
	<INPUT TYPE="grid" NAME="operater" TOP="346" LEFT="202" HEIGHT="5198" WIDTH="4205" REFRESHAFTERCHILD="TRUE" CAPTION="dblclick za dodaj operatera" TABINDEX="0" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" ONDBLCLICK="spStatusiOperateriAzur @action=0,@operateriid=@@gridoperateropid,@statusiid=@@statusiid#select &apos;refresh&apos; as operater,&apos;refresh&apos; as operater1" CHECKBOXVISIBLE="TRUE" SQL="select operateriid as opid,&apos;brown&apos;as formatid,Naziv as [Operater3000] 
									     from ssoperateri
										 where operateriid not in (select operateriid from statusioperateri where statusiid=@@statusiid)"/>
	<INPUT TYPE="grid" NAME="operater1" TOP="346" LEFT="5400" HEIGHT="5198" WIDTH="4205" REFRESHAFTERCHILD="TRUE" CAPTION="dblclick za ukloni operatera" TABINDEX="0" GROUPBYBOXVISIBLE="FALSE" TOTALROW="FALSE" ONDBLCLICK="spStatusiOperateriAzur @action=1,@operateriid=@@gridoperater1opid,@statusiid=@@statusiid#select &apos;refresh&apos; as operater,&apos;refresh&apos; as operater1" CHECKBOXVISIBLE="TRUE" SQL="select so.operateriid as opid,&apos;green&apos;as formatid,o.Naziv as [Operater3000] 
									     from statusioperateri so inner join ssoperateri o on so.operateriid=o.operateriid
										 where so.statusiid=@@statusiid"/>
	<INPUT TYPE="button" NAME="ok" TOP="2405" LEFT="4550" HEIGHT="331" WIDTH="706" TEXT="ButtonNG4" CAPTION="-&gt;" TABINDEX="1" ONCLICK="FOREACHSELECTED(operater)#spStatusiOperateriAzur @action=0,@operateriid=@@gridoperateropid,@statusiid=@@statusiid#select &apos;refresh&apos; as operater,&apos;refresh&apos; as operater1"/>
