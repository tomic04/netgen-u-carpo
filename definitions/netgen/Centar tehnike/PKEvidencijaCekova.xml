<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
	STARTUPSTORA=":FORM1"  		
	REPORT="" 	
	CMD1CAPTION="Dodaj:DODAJFORM"    
   	CMD2CAPTION="Izmjeni:IZMJENIFORM" 
   	CMD3CAPTION="Vrati:VRATIFORM"
	CMD4CAPTION="Filter:FORM1" 
	DBLCLICKFORM=""
	POPUP=""> 
 
 	<NAME>Evidencija zaprimanja i vračanja čekova vezanih za Konikom kredit</NAME>
	<CAPTION>Evidencija zaprimanja i vračanja čekova vezanih za Konikom kredit</CAPTION>
  
  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		STORA="spPologCekovaQuery @action=1, " 
		STARTUPSTORA="" 
		HEIGHT="4500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="pkosobeid" 
			SQL="viPKOsobe#pkosobeid#%Naziv%#[JMBG]%#[Broj OI]%#!Partner" 
			TABINDEX="1" 
			TEXT="" 
			WIDTH="7500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
                	NAME="datumod" 
                        CAPTION="Datum od" 
                        VALUE="DATE1" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="3" 
                        CHECKBOX="FALSE"/>

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
  			NAME="datumdo" 
                        CAPTION="Datum do" 
                        VALUE="DATE2" 
                        HEIGHT="320" 
                        WIDTH="1500" 
                        TABINDEX="4" 
                        CHECKBOX="FALSE"/>
	</FORM1>

	<DODAJFORM
		WIDTH="9000" 
                STORA="spPologCekovaAzur @action=1, " 
		STARTUPSTORA="select getdate() as datumdok" 
		HEIGHT="5500" 
		CAPTION="Novi ček"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datumdok" 
			CAPTION="Datum dokumenta:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="_pkosobeid" 
			SQL="Partneri#partneriid#%Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="7500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="MaloprodajaGlaId" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select MaloprodajaGlaId, partija as Naziv from MaloprodajaGla where partneriid=@@_pkosobeid"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="BankaId" 
                        CAPTION="Banka" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE" 
 	                SQL="select partneriid, naziv from partneri where partneriid in
				(select partneriid from lnPartneri where klPartneriId=
				(select varset from pubvars where VarIme='KlBankaFix'))"/>

               	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                       	NAME="BrojCeka" 
                      	CAPTION="Broj čeka" 
                       	WIDTH="5500" 
                       	HEIGHT="320" 
                       	TABINDEX="5" />
								 
  </DODAJFORM>

	<IZMJENIFORM
		WIDTH="9000" 
                STORA="spPologCekovaAzur @action=1, @datumdok=@@datumdok, @MaloprodajaGlaId=@@KreditId,@BankaId=@@BankaId,@BrojCeka=@@BrojCeka" 
		STARTUPSTORA="select getdate() as datumdok" 
		HEIGHT="5500" 
		CAPTION="Novi ček"  
                CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		FILLEXPLORER="" >

		<KONTROLA TYPE="MSComCtl2.DTPicker" 
			NAME="datumdok" 
			CAPTION="Datum dokumenta:" 
			VALUE="DATE" 
			HEIGHT="320" 
			WIDTH="1500" 
			TABINDEX="1" 
			CHECKBOX="FALSE" />
                         
		<KONTROLA TYPE="TRAZILICA" 
			CAPTION="Partner" 
			NAME="pkosobeid" 
			SQL="Partneri#partneriid#%Naziv%#[matbroj]%" 
			TABINDEX="2" 
			TEXT="" 
			WIDTH="7500" 
			HEIGHT="320"/> 

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="KreditId" 
                        CAPTION="Kredit" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="3" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE"
 	                SQL="select MaloprodajaGlaId, partija as Naziv from MaloprodajaGla where partneriid=@@pkosobeid"/>

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
			NAME="BankaId" 
                        CAPTION="Banka" 
                        WIDTH="5500" 
                        HEIGHT="320" 
                        TABINDEX="4" 
                        ALLOWEMPTY="TRUE" 
			REFRESHAFTERCHILD="TRUE" 
 	                SQL="select partneriid, naziv from partneri where partneriid in
				(select partneriid from lnPartneri where klPartneriId=
				(select varset from pubvars where VarIme='KlBankaFix'))"/>

               	<KONTROLA TYPE="TMEdit2.TextMEdit2" 
                       	NAME="brojceka" 
                      	CAPTION="Broj čeka" 
                       	WIDTH="5500" 
                       	HEIGHT="320" 
                       	TABINDEX="5" />
								 
  </IZMJENIFORM>

</PROJECT> 