<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FILTER_FORM"  		
		CMD1CAPTION="Parametri:FILTER_FORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="Kartica MP:KARTICA" 
		CMD4CAPTION=""
 		CMD5CAPTION="Kartica NC:KARTICANC" 
		CMD6CAPTION="Etikete:MULTISELECTETIKETE"  
		CMD7CAPTION="Lista"  
		CMD8CAPTION=""  
		DBLCLICKFORM=""
	    POPUP=""> 
 

  <NAME>Pregled robe po trgovinama</NAME>
  <CAPTION>Pregled robe po trgovinama</CAPTION>
  

	<FILTER_FORM 	
		NAME="FILTER_FORM"
		FILLEXPLORER="TRUE" 
		WIDTH="8500" 
		HEIGHT="5500"
		ONSUBMIT="spMPPregRobeTrgovina @action=1, @operateriid = @@operateriid," 
		ONLOAD="select year(getdate()) as godina " 
		CAPTION="Parametri" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		
		>

		<INPUT TYPE="number" NAME="godina" CAPTION="Godina" TEXT="" WIDTH="600" HEIGHT="320" TABINDEX="1" DECIMALS="0" />			
		<INPUT TYPE="combo"  NAME="trgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="2" ALLOWEMPTY="true" 
                SQL="spmpDajTrgovina @operateriid = @@operateriid"/>
		<INPUT TYPE="search" NAME="robaid" CAPTION="Roba"  TABINDEX="3" WIDTH="5500" HEIGHT="320"
				SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" /> 
					
		<INPUT TYPE="text" NAME="search" CAPTION="Traženje pojma"  TABINDEX="4" WIDTH="5500" HEIGHT="320"/>
		<INPUT TYPE="search" NAME="klasaid" CAPTION="Klasa"  TABINDEX="5" WIDTH="5500" HEIGHT="320"
				SQL="ViKlaseRobe#klmasterrobaid#Naziv%" /> 

		<INPUT TYPE="check" NAME="podklase" CAPTION="pokaži i sve podklase" WIDTH="3500" HEIGHT="320" TABINDEX="6" />
		<INPUT TYPE="check" NAME="stanje" CAPTION="pokaži samo robe kojima je stanje različito od 0" WIDTH="4000" HEIGHT="320" TABINDEX="7" />

		<INPUT TYPE="search" NAME="partneriid" CAPTION="Dobavljač" TABINDEX="8" WIDTH="5500" HEIGHT="320"
				SQL="partneri#partneriid#Naziv%" />


	</FILTER_FORM>

	<KARTICA 	
		FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		> 

		<INPUT TYPE="grid" 
			NAME="grid1" 
			REFRESHAFTERCHILD="TRUE" 
			TOP="200" LEFT = "200" 
			WIDTH="14500" HEIGHT="8000" 
			SQL="spMaloprodajaStanjeKartica @action = 1, @idreda = @@id, @operateriid = @@operateriid ,@totalgen = 1, @godina = @@godina  " /> 
			
	</KARTICA>

	<KARTICANC 	
		FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="9500" 
		CAPTION="Kartica robe po nab.cijenama" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		>

		<INPUT TYPE="grid" 
			NAME="grid1" 
			REFRESHAFTERCHILD="TRUE" 
			TOP="200" LEFT = "200" 
			WIDTH="14500" HEIGHT="8000" 
			SQL="spMaloprodajaStanjeKartica @action = 1, @idreda = @@id, @operateriid = @@operateriid ,@totalgen = 2 , @godina = @@godina " />
			
	</KARTICANC>

	<MULTISELECTETIKETE 
		FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		ONSUBMIT="" 
		ONLOAD="spMPKonikomNaljepnice @trgovinaid = @@trgovinaid , @action = 1, @id = null, @operateriid = @@operateriid, @nacin = 4, @multiselect = 1" 
		HEIGHT="9500" 
		CAPTION="" 
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		>

	</MULTISELECTETIKETE>


</PROJECT> 