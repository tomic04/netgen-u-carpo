<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA="spMPOtvoriCjenik @action = 1, @operateriid = @@operateriid " 
   CMD1CAPTION="Otvori:NOVICJENIK"    
   CMD2CAPTION="Aktiviraj:AKTIVIRAJ" 
   CMD3CAPTION="Stavke:STAVKE"
   CMD4CAPTION="Briši:BRISI"
   CMD5CAPTION="Donesi:DONESI"
   CMD6CAPTION=""
   POPUP=""
   DBLCLICKFORM="">
 
  <NAME>Otvaranje novog MP cjenika </NAME>
  <CAPTION>Otvaranje novog MP cjenika  </CAPTION>
 
  <KOMENTAR> </KOMENTAR>
  <AUTOR>KK 12.06.2007  </AUTOR>

	<NOVICJENIK 
						   WIDTH="8000" 
                         STORA="spMPOtvoriCjenik @action = 2, @operateriid =@@operateriid," 
                         STARTUPSTORA="" 
                         HEIGHT="3500" 
                         CAPTION="Novi cjenik"  
                         CMD1CAPTION="Otvori" 
                         CMD2CAPTION="Odustani" 
						CMD4CAPTION="" 
						CMD5CAPTION="" 
						FILLEXPLORER="" >

	  <KONTROLA TYPE="TMEdit2VB6.TextMEdit2" NAME="Opis" CAPTION="Naziv cjenika:" 
			 HEIGHT="317" WIDTH="2498" VISIBLE="TRUE" TEXT=""
					   TABINDEX="1" ENABLED="TRUE"/>

	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
								  NAME="vrcjenikid" 
								  CAPTION="Cjenik iz kojeg se kopira" 
								  WIDTH="3500" 
							  HEIGHT="320" 
								  TABINDEX="2" 
							  ALLOWEMPTY="TRUE" 
							  SQL="spmpDajMPCjenik @operateriid = @@operateriid"/>

		<KONTROLA TYPE="CMEditVB6.CurMEdit" NAME="postotak" 
			 HEIGHT="302" WIDTH="1901" VISIBLE="TRUE" TEXT=""
			 CAPTION="Postotak promjene " DECIMALS="2" TABINDEX="3" ENABLED="TRUE"
		/>


	</NOVICJENIK>
  

  <STAVKE
                         WIDTH="11000" 
                         STORA="" 
                         STARTUPSTORA="" 
                         HEIGHT="7500" 
                         CAPTION="Stavke cjenika"  
                         CMD1CAPTION="Povratak" 
                         CMD2CAPTION="" 
			 CMD4CAPTION="" 
			 CMD5CAPTION="" 
			 FILLEXPLORER="" >


			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" REFRESHAFTERCHILD="TRUE" LESFT="300" CAPTION="" WIDTH="8000" HEIGHT="6000" TABINDEX="2" 
                         SQL="spMPOtvoriCjenik @action = 5, @operateriid =@@operateriid,@id=@@id"  /> 

								 
  </STAVKE>


  <DONESI
  
                         WIDTH="7000" 
                         STORA="spMPOtvoriCjenik @action = 3,@id = @@id, " 
                         STARTUPSTORA="if (select datumaktiviranja from vrcjenik where vrcjenikid = @@ID ) is not null begin 
                        exec spRaiserror 69001, &apos;Cjenik je već aktiviran. Ne može se donijeti roba !&apos; 
						end
						else begin
							select 1
						end" 
                         HEIGHT="2500" 
                         CAPTION="Donos robe sa drugog cjenika "  
                         CMD1CAPTION="Donesi" 
                         CMD2CAPTION="Odustani" 
						CMD4CAPTION="" 
						FILLEXPLORER="" >


	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                  NAME="vrcjenikid" 
                                  CAPTION="Na cjenik: " 
                                  WIDTH="4000" 
                                  HEIGHT="320" 
                                  TABINDEX="0" 
                                  ALLOWEMPTY="false" 
								  ENABLED="FALSE" 
								  BOLD="TRUE" 
                                  SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid = @@id" />

	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                  NAME="vrcjeniksaid" 
                                  CAPTION="Sa cjenika: " 
                                  WIDTH="4000" 
                                  HEIGHT="320" 
                                  TABINDEX="0" 
                                  ALLOWEMPTY="false" 
								  ENABLED="TRUE" 
                                  SQL="spmpDajMPCjenik @operateriid = @@operateriid" />
	  <KONTROLA TYPE="CMEditVB6.CurMEdit" NAME="postotak" 
	   HEIGHT="302" WIDTH="1901" VISIBLE="TRUE" TEXT=""
	   CAPTION="Postotak promjene " DECIMALS="2" TABINDEX="3" ENABLED="TRUE" />


  </DONESI>
	<BRISI NAME="BRISI" HEIGHT="2197" WIDTH="5501" TEXT=""
			 REFRESHAFTERCHILD="TRUE" CAPTION="Obrisati cjenik ???" BORDERSTYLE="3" STORA="spMPOtvoriCjenik @action = 4,@ID=@@ID,"
			 STARTUPSTORA="" CANCELSTORA="" FILLEXPLORER="" NEXTFORM=""
			 CMD1CAPTION="Obriši" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
			 CMD5CAPTION="" CMD6CAPTION="" BOLD="TRUE" CHILDFORM=""
		>

		<KONTROLA TYPE="VB.Label" NAME="stat" LEFT="200"  TOP ="200"  BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite obrisati cjenik ? " />

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
									NAME="vrcjenikid" 
									CAPTION="Cjenik : " 
									TOP ="800" 
									LEFT="200" 
									WIDTH="4000" 
									HEIGHT="320" 
									TABINDEX="0" 
									ALLOWEMPTY="false" 
									ENABLED="FALSE" 
									BOLD="TRUE" 
									SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid = @@id" />

	</BRISI>

	<AKTIVIRAJ NAME="BRISI" HEIGHT="3197" WIDTH="5501" TEXT=""
		 REFRESHAFTERCHILD="TRUE" CAPTION="Aktiviranje cjenika " BORDERSTYLE="3" STORA="spMPOtvoriCjenik @action = 6,@ID=@@ID,"
		 STARTUPSTORA="" CANCELSTORA="" FILLEXPLORER="" NEXTFORM=""
		 CMD1CAPTION="Aktiviraj" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
		 CMD5CAPTION="" CMD6CAPTION="" BOLD="TRUE" CHILDFORM=""
		>

		<KONTROLA TYPE="VB.Label" NAME="stat" LEFT="200"  TOP ="200"  BOLD="TRUE" WIDTH="3500" CAPTION="Jeste li sigurni da želite aktivirati cjenik ? " />

		<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
									NAME="vrcjenikid" 
									CAPTION="Cjenik : " 
									TOP ="800" 
									LEFT="200" 
									WIDTH="4000" 
									HEIGHT="320" 
									TABINDEX="0" 
									ALLOWEMPTY="false" 
									ENABLED="FALSE" 
									BOLD="TRUE" 
									SQL="select vrcjenikid, opis as naziv from vrcjenik where vrcjenikid = @@id" />

		<KONTROLA TYPE="MSComCtl2.DTPicker" NAME="datum" TOP="1400" LEFT="200"
	 HEIGHT="302" WIDTH="1498" VISIBLE="TRUE" VALUE=""
	 TABINDEX="3" CAPTION="Datum aktiviranja: " ENABLED="TRUE" CHECKBOX="FALSE"
		/>



	</AKTIVIRAJ>





</PROJECT>
 
