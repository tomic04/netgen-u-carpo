<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION="Popravi:POPRAVI"
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		COMMANDTIMEOUT="600"
		MASTERDBLCLICK=""
	    POPUPMASTER="">

  <NAME>Kontrola sindikalnih kredita </NAME>
  <CAPTION>Kontrola sindikalnih kredita</CAPTION>
  

  <FORM1 	
		FILLEXPLORER="TRUE" 
		WIDTH="7000" 
		ONSUBMIT="spMPKontrolaSK @action = 1, " 
		ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid" 
		HEIGHT="2900" 
		CAPTION="Parametritttt" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">



	  <INPUT TYPE="date" 
				NAME="datumod" 
				CAPTION="Datum od" 
				VALUE="DATE2" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="1" 
				CHECKBOX="FALSE"/>

		<INPUT TYPE="date" 
				NAME="datumdo" 
				CAPTION="Datum do" 
				VALUE="DATE" 
				HEIGHT="320" 
				WIDTH="1500" 
				TABINDEX="2" 
				CHECKBOX="FALSE"/>
	  <INPUT TYPE="combo"  NAME="trgovinaid" CAPTION="Trgovina" SQL="spMPDajTrgovinaNG @operateriid=@@operateriid, @sk=1" ALLOWEMPTY="TRUE" />

	  <INPUT TYPE="check"
			  NAME="neispravno"
			  CAPTION="Pokaži samo neispravne "
			  HEIGHT="320"
			  WIDTH="2500"
			  TABINDEX="3"
			  CHECKBOX="FALSE"/>



  </FORM1>






  <POPRAVI
		NAME="OTKLJUCAJ" HEIGHT="3197" WIDTH="5501" TEXT=""
		REFRESHAFTERCHILD="TRUE" CAPTION="Ispravak  dokumenta kredita ?" BORDERSTYLE="3" ONSUBMIT="spMPKontrolaSK @action = 2,@id=@@id,"
		ONLOAD="select broj from maloprodajagla where maloprodajaglaid = @@id " 
		CANCELONSUBMIT="" FILLEXPLORER="" NEXTFORM=""
		CMD1CAPTION="Popravi" CMD2CAPTION="Odustani" CMD3CAPTION="" CMD4CAPTION=""
		CMD5CAPTION="" CMD6CAPTION="" BOLD="TRUE" CHILDFORM="">
		
		<INPUT TYPE="text" NAME="broj" TOP="360" LEFT="2304"
				HEIGHT="317" WIDTH="1498" VISIBLE="TRUE" TEXT=""
				CAPTION="" TABINDEX="1" ENABLED="FALSE"/>

		<INPUT TYPE="label" NAME="Label57" TOP="360" LEFT="288"
				HEIGHT="288" WIDTH="1728" VISIBLE="TRUE" BOLD="FALSE"
				CAPTION="Broj kredita:" ENABLED="TRUE"/>

		<INPUT TYPE="label" NAME="stat" TOP="1267" LEFT="374"
				HEIGHT="418" WIDTH="4003" VISIBLE="TRUE" BOLD="TRUE"
				CAPTION="Jeste li sigurni da želite ispraviti odabrani kredit? " ENABLED="TRUE"/>
  </POPRAVI>


</PROJECT> 