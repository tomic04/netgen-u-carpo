<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA="select KntNacinPlacid,naziv,  (select naziv from partneri where partneriid=KntNacinPlac.partneriid) as [Naziv partnera2825], (select konto +'     ' + naziv from kntplana where kntnacinplac.konto=kntplana.konto) as [konto4500], danaodgode  from KntNacinPlac order by naziv"
		REPORT="" 	
		CMD1CAPTION="Izmjeni:UPDATEFORM" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM="UPDATEFORM"
	        POPUP=""  > 

  <NAME>NacPlaAZ</NAME>
  <CAPTION>Izmjena načina plaćanja</CAPTION>
  
    <UPDATEFORM
		FILLEXPLORER="TRUE" 
		WIDTH="8000" 
		STORA="update KntNacinPlac set  partneriid=@@partner, konto=@@konto, danaodgode=@@danaodgode where KntNacinPlacid=@@id"
		STARTUPSTORA="select * , [partner]=(select naziv from partneri where partneriid=KntNacinPlac.partneriid) from KntNacinPlac where KntNacinPlacid=@@id" 
		HEIGHT="3500" 
		CAPTION="Izmjena načina plaćanja" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""  > 

  			<KONTROLA TYPE="VB.Label" 
  					NAME="lbl0"
  					 TOP="400" 
  					 LEFT="200" 
					WIDTH="1500"
					HEIGHT="320"  
					CAPTION="Način plaćanja:"/>
					
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					NAME="naziv" 
					CAPTION="Način plaćanja" 
					TOP="400"
					LEFT="2200"  
					WIDTH="5500" 
					HEIGHT="320" 
					TABINDEX="0" 
					ALLOWEMPTY="FALSE" 
					ENABLED="FALSE"
					SQL="select naziv from KntNacinPlac where KntNacinPlacid=@@id"/> 

             		<KONTROLA TYPE="VB.Label" 
				             	NAME="lbl1"
				             	TOP="900"
				             	LEFT="200"
				             	WIDTH="1500"
				             	CAPTION="Konto:"/>
             
             		<KONTROLA TYPE="CbEx3.ComboBoxEx3"
					           NAME ="konto"
					           CAPTION="Konto"
					           TOP="900"
					           LEFT="2200" 
					           WIDTH="5500" 	
							HEIGHT="320"
							TABINDEX="1"
							ALLOWEMPTY="FALSE" 
             					 SQL="select konto, konto +'     '  + rtrim(naziv) as naziv from kntplana where left(konto,1)=1 order by konto" /> 

			<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      TOP="1400" 
                                      LEFT="200" 
                               		WIDTH="5500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Dani odgode:" />
			
			<KONTROLA TYPE="CM6.curMEdit6" 
                                     	NAME="danaodgode" 
                                    	CAPTION="Dana odgode" 
                                    	DECIMALS="0"
                                     	TOP="1400" 
                                     	LEFT="2200"  
                                    	WIDTH="500" 
                                   	HEIGHT="320" 
                                   	TABINDEX="2" />
                                     				
                   <KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl3" 
                                      TOP="1900" 
                                      LEFT="200" 
                               		WIDTH="5500" 		
                                   	HEIGHT="320" 
                               		CAPTION="Partner" />
			
			<KONTROLA TYPE="TRAZILICA" 
                                     	NAME="partner" 
                                    	CAPTION="Partner:" 
                                     	TOP="1900" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                   	TABINDEX="0"
                                     	SQL="partneri#PartneriId#Naziv%#Sifra#Matbroj" />

  </UPDATEFORM>

</PROJECT>