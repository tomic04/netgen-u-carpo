<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT
		ONLOAD=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Detalji:DETALJI" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""
		PAGEHEADERRIGHT="Period od @@datumod do @@datumdo "  
		PAGEHEADERCENTER=""                                                             
		PAGEHEADERLEFT="Trgovina: @@comboboxtrgovinaid"
		PAGEFOOTERCENTER=""
		PAGEFOOTERLEFT="Vrsta dokumenta: @@comboboxvrstadokid"
		PAGEFOOTERRIGHT=""
		PAGEORIENTATION="LANDSCAPE" 
		SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname'" 
		MASTERDBLCLICK="PROMET"
	        POPUPMASTER=""
		CHECKBOXVISIBLE="FALSE"
		TOTALROWVISIBLE="TRUE"
		COMMANDTIMEOUT="120"> 
 

  <NAME>Pregled prometa po operateru </NAME>
  <CAPTION>Pregled prometa po operateru </CAPTION>



	<FORM1 	

		FILLEXPLORER="TRUE" 
		WIDTH="8500" 
		ONSUBMIT="spMPPregPromOperater @action=1, @operateriid = @@operateriid, " 
		ONLOAD="" 
		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 


                <INPUT TYPE="combo" 
                NAME="trgovinaid" 
                CAPTION="Trgovina" 
                WIDTH="5500" 
                HEIGHT="320" 
                TABINDEX="1" 
                ALLOWEMPTY="true" 
		ONLOSTFOCUS=""
                SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>


                <INPUT TYPE="date" 
                NAME="datumod" 
                CAPTION="Datum od" 
                VALUE="DATE2" 
                HEIGHT="320" 
                WIDTH="1500" 
                TABINDEX="4" 
                CHECKBOX="FALSE"
		DEFAULT="firstdayofmonth"/>


                <INPUT TYPE="date" 
                NAME="datumdo" 
                CAPTION="Datum do" 
                VALUE="DATE" 
                HEIGHT="320" 
                WIDTH="1500" 
                TABINDEX="5" 
                CHECKBOX="FALSE"
		DEFAULT="today"/>


		<INPUT TYPE="TRAZILICA" 
		CAPTION="Operater" 
		NAME="operateri2id" 
		SQL="ssoperateri#operateriid#%naziv%" 
		TABINDEX="3" 
		TEXT="" 
		WIDTH="5000" 
		HEIGHT="320"/> 


                <INPUT TYPE="combo" 
                NAME="odjelid" 
                CAPTION="Odjel" 
                WIDTH="4032" 
                HEIGHT="302" 
                TABINDEX="1" 
                ALLOWEMPTY="true" 
		ONLOSTFOCUS=""
                SQL="select odjelid, naziv from odjel"/>


	</FORM1>



	<DETALJI 	
		   FILLEXPLORER="TRUE"
		   WIDTH="20000"
		   ONLOAD=""
		   HEIGHT="13000"
		   CAPTION="Stavke prometa"
		   BORDERSTYLE="3"
		   CMD1CAPTION=""
		   VERSION="1.8"
		   CMD2CAPTION="Odustani"
		   CMD3CAPTION=""
		   NEXTFORM="">


	 	   <INPUT TYPE="grid" 
			NAME="stavke" 
			REFRESHAFTERCHILD="TRUE" 
			CAPTION="_ay" 
			TOP="200" 
			LEFT="200"  
			WIDTH="19000" 
			HEIGHT="11000" 
			TABINDEX="5" 
                      SQL="spMPPregPromOperater @action=2, @operateri2id = @@id, @datumod = @@datumod, @datumdo = @@datumdo" /> 


	</DETALJI>

</PROJECT>
