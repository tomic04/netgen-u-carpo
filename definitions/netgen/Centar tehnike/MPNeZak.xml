<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="" 	
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="Promet:PROMET" 
		CMD4CAPTION=""
 		CMD5CAPTION="Osvježi:OBNOVI" 
		CMD6CAPTION=""  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Pregled nezaključenih dokumenata MP </NAME>
  <CAPTION>Pregled nezaključenih dokumenata MP</CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPPregNeZak @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="3500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select t.trgovinaid,ltrim(rtrim(t.oznaka)) + ' ' + ltrim(rtrim(t.opis)) as [Naziv]  from trgovina t inner join trgovineprava p on t.trgovinaid=p.trgovinaid where p.operaterid=@@operateriid"/>

			


                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="4" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="5" 
                                    	CHECKBOX="FALSE"/>
										

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajVrstadok null"/>
										

  </FORM1>
 <PROMET 	FILLEXPLORER="TRUE" 
		WIDTH="14000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="7500" 
		CAPTION="Stavke prometa" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		NEXTFORM=""> 
		
		

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="12000" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spMPPregNeZak @action=2,@id = '@@id'" 
                                          /> 

</PROMET>		

  <OBNOVI
		WIDTH="5500" 
		STORA="spMPPregNeZak @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="spMPPregNeZak @action = 3, @id=@@id"		
		HEIGHT="3200" 
		CAPTION="" 
		BORDERSTYLE="3" 
		CMD1CAPTION=""         
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CHILDFORM=""
		NEXTFORM=""> 

  </OBNOVI> 



</PROJECT> 