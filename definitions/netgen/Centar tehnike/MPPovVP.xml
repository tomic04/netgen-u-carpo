<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Filter:FILTERFORM" 
      CMD2CAPTION="" 
      CMD3CAPTION="Pokaži:POKAZIFORM" 
      CMD4CAPTION="Zaključi:ZAKLJUCI" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION="Lista"   
      CMD8CAPTION="Dokument"   
      REPORT="maloprodajagla" 
      DBLCLICKFORM="UPDATEFORM"
      POPUP="Filter:FILTERFORM#Izmjeni:UPDATEFORM#Isporuči:ZAKLJUCI#Poništi:PONISTI">
 
  <NAME>Povratnica iz MP u VP </NAME>
  <CAPTION>Povratnica iz MP u VP </CAPTION>
 
  <KOMENTAR> </KOMENTAR>




  <POKAZIFORM 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="13400" 
                         STORA="" 
                         STARTUPSTORA="select trgovinaid,skladisteid,datumdok,broj,orgshemaid from maloprodajagla where maloprodajaglaid = @@id" 
                         HEIGHT="8800" 
                         CAPTION="Izmjena dokumenta"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="Odustani"
				  CMD3CAPTION=""	 
				  CMD4CAPTION=""
				  CMD5CAPTION=""	 		 
                                  CMD6CAPTION=""  
					
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lblBroj" 
                                      	TOP="300" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Broj dokumenta"/>
			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					NAME="Broj" 
					TOP="200" 
					LEFT="2200" 
					CAPTION="Opis" 
					TEXT="" 
					WIDTH="1500" 
					HEIGHT="320" 
					TABINDEX="0" 
					ENABLED="FALSE" />


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Org. shema"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="OrgShemaId" 
                                    	CAPTION="Trgovina" 
                                     	TOP="600" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
					ENABLED="FALSE"
                                 	SQL="select  orgshemaid,naziv from orgshema "  /> 


                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500"
                                   	HEIGHT="320"  
                                    	CAPTION="Datum dokumenta"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdok" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum dokumenta" 
                                   	VALUE="" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
					ENABLED="FALSE"
                                    	CHECKBOX="FALSE"/>


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                   	TOP="1500" 
                                     	LEFT="200" 
                                     	WIDTH="1500"
                                   	HEIGHT="320"  
                                   	CAPTION="Skladište"/>
                      	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="skladisteid" 
                                	CAPTION="Razlog" 
                               		TOP="1400" 
                            		LEFT="2200"  
                                     	WIDTH="5500" 
                                 	HEIGHT="320" 
                                  	TABINDEX="3" 
                              		ALLOWEMPTY="False" 
					ENABLED="FALSE"
                            		SQL="select skladisteid,opis as naziv from skladiste order by 2"  /> 
 

                      	<KONTROLA TYPE="VB.Label" NAME="lbl3" TOP="1900" LEFT="200" WIDTH="1500" CAPTION="Trgovina"/> 

			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					CAPTION="Trgovina" 
					NAME="TrgovinaId" 
					SQL="select TrgovinaId,Opis as naziv  from trgovina order by 2" 
					TOP="1900" 
					LEFT="2200" 
					TEXT=""
					TABINDEX="4" 
					WIDTH="5500" 
					ENABLED="FALSE"
					HEIGHT="320"/>

			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="2800" 
					LEFT="200"  
					WIDTH="13500" 
					HEIGHT="5000" 
					TABINDEX="5" 
                                        SQL="spGRNalogMP @action = 904,@id=@@id" 
                                          /> 


  </POKAZIFORM>



  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spGRNalogMP @action=1112, @operateriid= @@operateriid, " 
                         STARTUPSTORA="" 
                         HEIGHT="4800" 
                         CAPTION="Izaberi dokumente"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Vrsta dokumenta"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="vrstadokid" 
                                    	CAPTION="Vrsta dokumenta" 
                                     	TOP="600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="2" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select vrstadokid , opis as naziv from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra in ( '119')) and aktivni = 1 order by 1 desc"  /> 

									
                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                   	TOP="1000" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      	TOP="1600" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Trgovina"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                     	TOP="1500" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="4" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="spMPDajTrgovina @operateriid = @@operateriid "  /> 



                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl4" 
                                      	TOP="2100" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
                               		CAPTION="Skladište"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="skladisteid" 
                                    	CAPTION="Skladište" 
                                     	TOP="2000" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="5" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select skladisteid, opis as Naziv from skladiste"  /> 

						<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl3" 
                                      	TOP="2500" 
                                       	LEFT="200" 
                               		WIDTH="2000" 
                                   	HEIGHT="320" 
                               		CAPTION="Status"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="status" 
                                    	CAPTION="Status" 
                                     	TOP="2400" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="6" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="select 1 as status,'Ne zaprimljeno' as naziv  union all select 2 as status,'Zaprimljeno' as naziv  "  /> 


  </FILTERFORM>





  <ZAKLJUCI
		WIDTH="5500" 
		STORA="spMPZakljuciSkl 4,@id=@@id" 
		STARTUPSTORA="select stat = case when status = 99 then 'Dokument je zaprimljen. Ne može se više zaprimiti!' else 'Jeste li sigurni da želite zaključiti zaprimanje dokumenta '+(select broj from maloprodajagla where maloprodajaglaid = @@id )+' ?' end from maloprodajagla where maloprodajaglaid = @@id"		
		HEIGHT="3200" 
		CAPTION="Ažurirati ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Ažuriraj"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite zaključiti zaprimanje dokumenta  ? "/>
  </ZAKLJUCI> 





  <PONISTI
		WIDTH="5500" 
		STORA="spMPPonistiIzdSkl @id=@@id, @action = 1" 
		STARTUPSTORA="select stat = case when status = 99 then 'Dokument nije isporučen. Ne može se poništiti isporuka !' else 'Jeste li sigurni da želite poništiti zaprimanje dokumenta '+(select broj from maloprodajagla where maloprodajaglaid = @@id )+' ?' end from maloprodajagla where maloprodajaglaid = @@id"		
		HEIGHT="3200" 
		CAPTION="Poništiti zaprimanje ?" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Poništi"         
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

   			<KONTROLA TYPE="VB.Label" NAME="stat" TOP="500" LEFT="200" WIDTH="3500" CAPTION="Jeste li sigurni da želite poništiti zaprimanje dokumenta +(select broj from maloprodajagla where maloprodajaglaid = @@id )+' ?' "/>
  </PONISTI> 






</PROJECT>
 
