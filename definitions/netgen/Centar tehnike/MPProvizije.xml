<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT 
		 ONLOAD=":FILTERFORM" 
		 DETAILGRID = ""
		 MASTERDBLCLICK=":UPDATE_FORM"
		 CMD1CAPTION="Uvjeti:FILTERFORM" 
		 CMD2CAPTION="Unos:INSERT_FORM"
		 CMD3CAPTION="Izmjena:UPDATE_FORM" 
		 CMD4CAPTION="Brisanje:DELETE_FORM" 
		 CMD5CAPTION="Kopiranje:KOPIRAJ"
		 CMD7CAPTION="" 
		 CMD8CAPTION="" 
		 POPUPMASTER="Izmjena:UPDATE_FORM" 
		 POPUPDETAIL=""
		 TREE=""
		 GROUPBYBOXVISIBLE="FALSE"   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="FALSE"
		 CHECKBOXVISIBLE="FALSE"
		 DETCHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="" 
		 ONLOAD2="" 
		 REPORT=""
		 COMMANDTIMEOUT="600"
		 PAGEHEADERCENTER=""
		 PAGEHEADERRIGHT=""
		 PAGEHEADERLEFT=""
		 PAGEFOOTERCENTER=""
		 PAGEFOOTERLEFT=""
		 PAGEFOOTERRIGHT="@@tkosmomi"
		 PAGEORIENTATION="PORTRAIT">


	<NAME>Provizije djelatnika</NAME>
	<CAPTION>Provizije djelatnika</CAPTION>
	<AUTOR>DP</AUTOR>


<POKAZI_FORM NAME="POKAZI_FORM" 
		 ONSUBMIT="spMPProvizije @action = 1 " 
		 FILLEXPLORER="TRUE" >
</POKAZI_FORM>

	<FILTERFORM NAME="FILTERFORM"
		 HEIGHT="2800"
		 WIDTH="7700"
		 FILLEXPLORER="TRUE" 
		 CAPTION="Uvjeti"
		 ONSUBMIT="spMPProvizije @action = 1, "
		 ONLOAD="select null as trgovinaid, null as klmasterobaid, 0 as koeficijent, 0 as minruc"
		 NEXTFORM=""
		 FOCUS="Opis"
		 CMD1CAPTION="Pokaži"
		 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="trgovinaid"   ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="500" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />
		<INPUT TYPE="combo"    NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
	</FILTERFORM>

	<INSERT_FORM NAME="INSERT_FORM" 
		 HEIGHT="3500" 
		 WIDTH="7700" 
		 FILLEXPLORER="TRUE" 
		 CAPTION="Unos provizija"
		 ONSUBMIT="spMPProvizije @action = 2, "
		 ONLOAD="" 
		 NEXTFORM=""
		 FOCUS="Opis" 
		 CMD1CAPTION="Spremi" 
		 CMD2CAPTION="Odustani" >

	<INPUT TYPE="combo"    NAME="trgovinaid"   ALLOWEMPTY="FALSE" CAPTION="Trgovina*" TOP="500" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />
	<INPUT TYPE="combo"    NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
	<INPUT TYPE="number"    NAME="koeficijent"    CAPTION="Koeficijent:*"   TABINDEX="2"  TOP="1500" ENABLED="TRUE"  />
		<INPUT TYPE="number"    NAME="minruc"    CAPTION="Min. RUC:*"   TABINDEX="2"  TOP="2000" ENABLED="TRUE"  />

	</INSERT_FORM>

	<KOPIRAJ NAME="INSERT_FORM"
	 HEIGHT="3500"
	 WIDTH="7700"
	 FILLEXPLORER="TRUE"
	 CAPTION="Kopiranje provizija"
	 ONSUBMIT="spMPProvizije @action = 3, "
	 ONLOAD=""
	 NEXTFORM=""
	 FOCUS="Opis"
	 CMD1CAPTION="Spremi"
	 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="trgovinaid"   ALLOWEMPTY="FALSE" CAPTION="Trgovina sa *" TOP="500" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />
		<INPUT TYPE="combo"    NAME="trgovina2id"   ALLOWEMPTY="FALSE" CAPTION="Trgovina na *" TOP="1000" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />

	</KOPIRAJ>



	<UPDATE_FORM NAME="INSERT_FORM"
			 HEIGHT="3500"
			 WIDTH="7700"
			 FILLEXPLORER="TRUE" 
			 CAPTION="Izmjena provizija"
			 ONSUBMIT="spMPProvizije @action = 3, @id = @@id, "
			 ONLOAD="select * from mpprovizije where mpprovizijeid = @@id"
			 NEXTFORM=""
			 FOCUS="Opis"
			 CMD1CAPTION="Spremi"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="trgovinaid"   ALLOWEMPTY="FALSE" CAPTION="Trgovina*" TOP="500" SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />
		<INPUT TYPE="combo"    NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1000" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
		<INPUT TYPE="number"    NAME="koeficijent"    CAPTION="Koeficijent:*"   TABINDEX="2"  TOP="1500" ENABLED="TRUE"  />
		<INPUT TYPE="number"    NAME="minruc"    CAPTION="Min. RUC:*"   TABINDEX="2"  TOP="2000" ENABLED="TRUE"  />
	</UPDATE_FORM>

	<DELETE_FORM NAME="DELETE_FORM"
			 HEIGHT="3500"
			 WIDTH="7700"
			 CAPTION="Brisanje provizija"
			 ONSUBMIT="delete mpprovizije where mpprovizijeid  = @@id "
			 ONLOAD="select * from mpprovizije where mpprovizijeid = @@id"
			 NEXTFORM=""
			 FOCUS="Opis"
			 CMD1CAPTION="Obriši"
			 CMD2CAPTION="Odustani" >

		<INPUT TYPE="combo"    NAME="trgovinaid"   ALLOWEMPTY="TRUE" CAPTION="Trgovina*" TOP="500" ENABLED="FALSE"  SQL="spmpdajtrgovinaNG @operateriid = @@operateriid, @sk = 1"  />
		<INPUT TYPE="combo"    NAME="klmasterrobaid"   ALLOWEMPTY="TRUE" CAPTION="Klasa Robe*" TOP="1000" ENABLED="FALSE" SQL="select KlMasterRobaId, naziv,sortkey from KlMasterRoba order by sortkey"  />
		<INPUT TYPE="number"    NAME="koeficijent"    CAPTION="Koeficijent:*"   TABINDEX="2"  TOP="1500" ENABLED="FALSE"  />
		<INPUT TYPE="number"    NAME="minruc"    CAPTION="Min. RUC:*"   TABINDEX="2"  TOP="2000" ENABLED="FALSE"  />
	</DELETE_FORM>


</PROJECT>