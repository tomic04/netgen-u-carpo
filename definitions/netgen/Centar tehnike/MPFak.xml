<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
   STARTUPSTORA=":FILTERFORM"  
      CMD1CAPTION="Filter:FILTERFORM" 
      CMD2CAPTION="Poveži:UPDATEFORM" 
      CMD3CAPTION="Poništi:UPDATEFORM2" 
      CMD4CAPTION="" 
      CMD5CAPTION="" 
      CMD6CAPTION=""   
      CMD7CAPTION=""   
      CMD8CAPTION=""   
      REPORT="" 
      DBLCLICKFORM="UPDATEFORM"
      POPUP="">
 
  <NAME>Pridruživanje ulazne fakture dobavljača direktnoj primci u maloprodaji.</NAME>
  <CAPTION>Pridruživanje ulazne fakture dobavljača direktnoj primci u maloprodaji.</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

  
  <FILTERFORM 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spMaloprodajaZaduzenje @action=301,@skladisteid=0," 
                         STARTUPSTORA="" 
                         HEIGHT="3600" 
                         CAPTION="Izaberi parametre upita"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Partneri"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="partneriid" 
                                    	CAPTION="Partner" 
                                     	TOP="600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="TRUE" 
                                 	SQL="select distinct p.partneriid,ltrim(rtrim(p.naziv)) as [Naziv]  from partneri p inner join maloprodajagla g on p.partneriid=g.partneriid  order by naziv"  /> 


                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                   	TOP="1000" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>


  			
 
  </FILTERFORM>


  <UPDATEFORM 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="update maloprodajagla set fakturedobid=@@fakturedobid where maloprodajaglaid=@@id" 
                         STARTUPSTORA="" 
                         HEIGHT="2600" 
                         CAPTION="Izaberi fakturu"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Poveži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Fakture dobavljača"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="fakturedobid" 
                                    	CAPTION="Partner" 
                                     	TOP="600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select FaktureDobId,convert(varchar(35),coalesce(DatumDok,''),105) + '      ' + ltrim(rtrim(coalesce(broj,''))) + '   =   ' + ltrim(str(IznosFakture-IznosPoreza)) + ' kn' as [Naziv]  from fakturedob where partneriid=(select partneriid from maloprodajagla where maloprodajaglaid=@@ID) and fakturedobid not in (select fakturedobid from maloprodajagla where fakturedobid = maloprodajagla.fakturedobid) and fakturedobid not in (select fakturedobid from nabprigla where fakturedobid = nabprigla.fakturedobid) and fakturedobid not in (select fakturedobid from robnokalkgla where fakturedobid = robnokalkgla.fakturedobid) order by datumdok desc"  /> 



 
  </UPDATEFORM>


  <UPDATEFORM2 
                         FILLEXPLORER="" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="update maloprodajagla set fakturedobid=null where maloprodajaglaid=@@id" 
                         STARTUPSTORA="" 
                         HEIGHT="2600" 
                         CAPTION="Izaberi fakturu"  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Poništi" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >


                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl0" 
                                      	TOP="700" 
                                       	LEFT="200" 
                               		WIDTH="1500"
                                   	HEIGHT="320"  
                               		CAPTION="Fakture dobavljača"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="fakturedobid" 
                                    	CAPTION="Partner" 
                                     	TOP="600"
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select FaktureDobId,convert(varchar(35),coalesce(DatumDok,''),105) + '      ' + ltrim(rtrim(coalesce(broj,''))) + '   =   ' + ltrim(str(IznosFakture-IznosPoreza)) + ' kn' as [Naziv]  from fakturedob where fakturedobid = (select fakturedobid from maloprodajagla where maloprodajaglaid = @@ID)"  /> 



 
  </UPDATEFORM2>


</PROJECT>
 
