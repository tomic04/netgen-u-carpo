<FILTERFORM NAME="FILTERFORM" HEIGHT="4254" WIDTH="6710" 
		 CAPTION="Upišite uvjete prikaza " 
		 ONSUBMIT="spMPQueryGlaIDetNG @action = 1,  @sifradok = '104', @operateriid= @@operateriid, @vrstadokid = @@vrstadokid, @datumod = @@datumod , @datumdo = @@datumdo, @trgovinaid = @@trgovinaid, @skladisteid = @@skladisteid, @trazibroj = '@@trazibroj', @status = @@status!!"
		 ONLOAD="select @@datumod as datumod, @@datumdo as datumdo, @@trgovinaid as trgovinaid,@@skladisteid as skladisteid" 
		 FILLEXPLORER="TRUE" 
		 NEXTFORM=""
		 CMD1CAPTION="" 
		 CMD2CAPTION="" 
		 >
			<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" DEFAULT="firstdayofyear"/>
			<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" DEFAULT="today"/>
			<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina" ONLOSTFOCUS="select 'refresh' as skladisteid" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
			<INPUT TYPE="combo" NAME="skladisteid" ALLOWEMPTY="TRUE" CAPTION="Skladište" SQL="spmpDajSkladiste @trgovinaid = @@trgovinaid , @operateriid = @@operateriid" />
			<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="true" CAPTION="Status" SQL="select 0 as status,&apos;Otvoren&apos; as naziv  union all select 1 as status,&apos;Naloženo &apos; as naziv union all select 2 as status,&apos;Zaprimljeno &apos; as naziv" />
			<INPUT TYPE="text"	 NAME="trazibroj"  WIDTH="2500" ALLOWEMPTY="TRUE" CAPTION="Broj dokumenta" ONLOSTFOCUS=""/>
