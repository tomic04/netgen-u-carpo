	</INSERTFORM2>


	<INSERTFORM1 NAME="INSERTFORM" HEIGHT="5670" WIDTH="8000" 
		 CAPTION="Unos Izdatnice iz VP U MP "
		 ONSUBMIT="spMPInsertGlaIdetNG @action=1,@operateriid=@@operateriid,@sifradok = '104',@status = 1,"
		 ONLOAD="select convert(varchar,getdate(),112) as datumdok, @@vrstadokid as vrstadokid" 
		 NEXTFORM="UPDATE_FORM"
		 CMD1CAPTION="Stavke&gt;&gt;&gt;" 
		 CMD2CAPTION="Odustani" 
		>
			<INPUT TYPE="text" NAME="broj"   CAPTION="Broj dokumenta:" ENABLED="FALSE"/>
			<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum dokumenta" />
