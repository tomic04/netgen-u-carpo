			<INPUT TYPE="combo" NAME="skladisteid" SQL="spmpdajskladiste @trgovinaid = @@trgovinaid, @operateriid=@@operateriid" ALLOWEMPTY="FALSE" CAPTION="Skladište" />
			<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena" />
			<INPUT TYPE="combo" NAME="osobeid" SQL="spMPDajOsobe @trgovinaid = @@trgovinaid" ALLOWEMPTY="FALSE" CAPTION="Odgovorna osoba"/>
			<INPUT TYPE="combo" NAME="osobe2id" SQL="select rajonid as osobe2id, rtrim(sifra)+' '+opis as naziv from rajoni where skladisteid = @@skladisteid" ALLOWEMPTY="FALSE" CAPTION="Rajon"/>
			<INPUT TYPE="combo" NAME="nacinplacanjaid" SQL="select pronacinisporukeid, naziv from pronacinisporuke" ALLOWEMPTY="FALSE" CAPTION="Tura"/>
			<INPUT TYPE="text" NAME="vrstadokid" CAPTION="" TOP="-1100"/>
	</INSERTFORM1>



<UPDATE_FORM 
		CAPTION="Izmjeni dokmument [ @@id ]" 
		HEIGHT="9500" 
		WIDTH= "11000" 
		FILLEXPLORER="" 
		FOCUS="robaid" 
		ONLOAD="if (select status from maloprodajagla  where maloprodajaglaid = @@ID ) = 2 begin 
				exec spRaiserror 69001, &apos;Dokument je zaključen. Ne može se više ispravljati !&apos;
				end
			else begin
				if @@id = 0  begin 
						exec spRaiserror 69001, &apos;Niste odabrali dokumant !&apos;
				end 
				else begin 
					exec spMPQueryGlaIDetNG @action=3 ,@ID=@@ID, @operateriid = @@operateriid
				end
				end "
    ONLOADED="spmpOperaterlock @action = 1, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'"
    ONESCKEY="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
    ONCLOSED="spmpOperaterlock @action = 2, @id = @@id, @operateriid = @@operateriid, @tablica='maloprodajagla'#Ok"
		 
		>

