<PROJECT 
		 DETAILGRID = "spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id"
		 MASTERDBLCLICK="UPDATE_FORM"
		 CMD1CAPTION1="" 
		 CMD2CAPTION1=""
		 CMD3CAPTION1="" 
		 CMD4CAPTION1="" 
		 CMD5CAPTION1="" 		
		 CMD6CAPTION1=""
		 CMD7CAPTION1="" 
		 CMD8CAPTION1=""
		 COMBO11="select '' as tree, '' as opis 
	 union all 
	 select 'Danas:DANAS_FORM#Jučer:JUCER_FORM' as tree, opis  
	 from trgovina"

		 INCLUDE="MPAmbalaza.xml" 
		 BUTTONS="Filter:FILTERFORM#Dodaj:INSERTFORM1#Izmjeni:UPDATE_FORM#Zaključi:ZAKLJUCI#Ambalaža:AMBALAZA#Kontrola:KONTROLA#Print dok.:MULTISELECTISPIS_FORM" 
		 POPUPMASTER="Filter:FILTERFORM#Izmjeni:UPDATEFORM#Zaključi:ZAKLJUCI#Otključaj:OTKLJUCAJ#Stornoraj:STORNO" 
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE" 
		 ONLOAD="select vrstadokid from vrstadok where vrstapromid in (select vrstapromid from vrstaprom where sifra = '104') and mpizdatnicaZakljuci = 0 "   
		 FROZENCOLUMNS="0" 
		 AUTOFITCOLUMNS="False"
		 CHECKBOXVISIBLE="TRUE"
		 TOTALROWVISIBLE="FALSE"
	     DETCHECKBOXVISIBLE="FALSE"	
		 DETTOTALROWVISIBLE="FALSE"
		 SETDEFAULTS="spMPPermissionNG @action = 0 , @operateriid = @@operateriid, @object = '@@xmlname', @sifradok = '104',  @mpizdatnicaZakljuci = 0 , @trazi = 'zadu'#select dbo.fnTkoSmoMi() as tkosmomi" 
		 ONLOAD2="select 'Dodaj' = case when @@dodaj=1 then 'enable' else 'disable' end , 'Izmjeni' = case when @@izmjeni=1 then 'enable' else 'disable' end ,
				'Zaključi' = case when @@zakljuci=1 then 'enable' else 'disable' end, 'Obrisi' = case when @@Obrisi=1 then 'enable' else 'disable' end , 
				'Storno' = case when @@storno=1 then 'enable' else 'disable' end , 'otkljucaj' = case when @@otkljucaj=1 then 'enable' else 'disable' end " 
		 REPORT=""
     PAGEHEADERRIGHT="@@tkosmomi"
     PAGEHEADERLEFT="Od @@datumod do @@datumdo">



	<NAME>Izdatnica iz VP u MP </NAME>
	<CAPTION>Izdatnica iz VP u MP </CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='danas', @sifradok = '104', @vrstadokid = @@vrstadokid , @nenc = 1" />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='jucer', @sifradok = '104', @vrstadokid = @@vrstadokid , @nenc = 1" />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @sifradok = '104', @vrstadokid = @@vrstadokid , @nenc = 1" />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='proslimj',@sifradok = '104', @vrstadokid = @@vrstadokid , @nenc = 1" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPQueryGlaIDetNG @action=1,@operateriid=@@operateriid,@node='@@node', @sifradok = '104', @vrstadokid = @@vrstadokid , @nenc = 1" />


	<INSERTFORM2 NAME="INSERTFORM" HEIGHT="2000" WIDTH="8000"
			 CAPTION="Odaberite vrstau dokumenta"
			 ONSUBMIT=""
			 ONLOAD=""
			 NEXTFORM=""
			 CMD1CAPTION=""
			 CMD2CAPTION=""
		>
		<INPUT TYPE="combo" NAME="vrstadokid" ALLOWEMPTY="TRUE" TOP="200" LEFT="2000" CAPTION="Vrsta dokumena*" SQL="spmpDajVrstaDok '104'" />
		<INPUT TYPE="button" NAME="ok" 		  CAPTION="Dokument&gt;&gt;&gt;" TABINDEX="2" TOP="800" LEFT="1280" WIDTH="1428" HEIGHT="322"
			   ONCLICK="if @@vrstadokid is null begin exec spRaiserror 69001, &apos;Niste odabrali dokumant !&apos;
							end#close#:INSERTFORM1" HOTKEY="F8" />
