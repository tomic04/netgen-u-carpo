		<INPUT TYPE="text"   NAME="broj"          CAPTION="Broj*" TOP="210" LEFT="3780" WIDTH="2002" HEIGHT="280" SQL="" ENABLED="FALSE"  />
		<INPUT TYPE="combo"  NAME="trgovinaid"    CAPTION="Trgovina*" TOP="554" LEFT="1490" WIDTH="3500" HEIGHT="294" ALLOWEMPTY="FALSE" ENABLED="FALSE" SQL="spMPDajTrgovina @operateriid=@@operateriid"  ONCLICK="select 'refresh' as skladisteid, 'refresh' as osobeid"/>
		<INPUT TYPE="combo"  NAME="sskladisteid"   CAPTION="Skladište*" TOP="854" LEFT="1490" WIDTH="3500" HEIGHT="294" ALLOWEMPTY="FALSE" SQL="spMPDajSkladiste @trgovinaid = @@trgovinaid ,@operateriid=@@operateriid"  />
		<INPUT TYPE="text"   NAME="napomena"      CAPTION="Napomena*" TOP="1190" LEFT="1490" WIDTH="3568" HEIGHT="280" ALLOWEMPTY="TRUE" SQL=""  />
		<INPUT TYPE="combo"  NAME="osobeid "      CAPTION="Odgovorna osoba*" TOP="1490" LEFT="1490" WIDTH="2568" HEIGHT="280" ALLOWEMPTY="FALSE" SQL="spMPDajOsobe @trgovinaid = @@trgovinaid"  />

		
	<INPUT TYPE="combo" NAME="osobe2id" SQL="select rajonid as osobe2id, rtrim(sifra)+' '+opis as naziv from rajoni where skladisteid = @@skladisteid" TOP="1190" LEFT="6000" ALLOWEMPTY="FALSE" CAPTION="Rajon*"/>
	<INPUT TYPE="combo" NAME="nacinplacanjaid" SQL="select pronacinisporukeid, naziv from pronacinisporuke" ALLOWEMPTY="FALSE" TOP="1490" LEFT="6000" CAPTION="Tura*"/>

	<INPUT TYPE="frame"  NAME="fr2"           CAPTION="Nova stavka dokumenta :" TOP="2000" LEFT="56" WIDTH="10300" HEIGHT="2050"   />
		<INPUT TYPE="search" NAME="robaid" 			CAPTION="Roba (F5)*" TOP="2226" LEFT="1372" WIDTH="4998"  ALLOWEMPTY="FALSE" HEIGHT="280" SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid', @partneriid = @@asortMPid, @skladisteid = @@skladisteid" 
		 ONLOSTFOCUS="exec spmpKontrolaOdabraneRobeNG  @robaid = @@robaid, @asortimanMP=1, @trgovinaid = @@trgovinaid
						#if @@robaid is not null begin exec spMPDajArtikalNG @robaId = @@robaid, @TrgovinaId = @@trgovinaid, @Skladisteid = @@skladisteid, @datum = @@datumdok,@partneriid = null, @vrstadokid = @@vrstadokid, @sifradok = '99' end
						#exec spmpKontrolaOdabraneRobeNG @robaid = @@robaid, @mpcijena = @@mpcijena, @indmpc = 1" BACKCOLOR="LIGHTYELLOW" HOTKEY="F5"/>
		<INPUT TYPE="number" NAME="kolicina" 	  CAPTION="Količina*" TOP="2562" LEFT="1372" WIDTH="1296" HEIGHT="280" DECIMALS="4" SQL=""  
			   ONLOSTFOCUS="if coalesce((select kkvalobavezan from roba where robaid = @@robaid ),0) =1 and coalesce((select kkvalobavezan from skladiste where skladisteid = @@skladisteid),0) = 1 begin select  'disable' as  spremistavku , 'KONTIGENTI' as form end 
								else begin select 'enable' as spremistavku, 'spremistavku' as focus end 
			   #if coalesce((select kkvalobavezan from roba where robaid = @@robaid ),0) =1 and coalesce((select kkvalobavezan from skladiste where skladisteid = @@skladisteid),0) = 1 begin 
						select 0 as kolicina, 0 as mpcijena , 'refresh' as mpcijena, '' as roba, null as robaid, 0 as nabcijenaskl, 0 as sktstanje, 0 as kolpakovanje, '' as jmnaziv , 'robaid' as focus, 'enable' as spremistavku
				end "/>
		<INPUT TYPE="text"   NAME="jmnaziv"	      CAPTION="JM*" TOP="2562" LEFT="3372" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number"   NAME="kolpakovanje"	      CAPTION="Količina pakovanje*" TOP="2562" LEFT="5772" WIDTH="700" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="mpcijena"	  CAPTION="MP Cijena*" TOP="2862" LEFT="1372" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL="select dbo.fnMPdajMPC(@@robaid, @@trgovinaid, @@datumdok )"  />
		<INPUT TYPE="number" NAME="nabcijenaskl"	  CAPTION="Nabavna cijena*" TOP="3162" LEFT="1372" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="number" NAME="sktstanje"	  CAPTION="Kol.na skladištu*" TOP="3462" LEFT="1372" WIDTH="1596" HEIGHT="280" ENABLED="FALSE" SQL=""  />
		<INPUT TYPE="button" NAME="spremistavku" 		      CAPTION="Dodaj (F8)" TOP="3550" LEFT="7280" WIDTH="1428" HEIGHT="322" 
			   ONCLICK="spMPInsertGlaIdetNG @action=3,@robaid=@@robaid,@id=@@id,@NabCijena=@@nabcijenaskl,@kolicinaulaz=@@kolicina,@kolicinanaruceno = @@kolicina, @mpcijena=@@mpcijena, @porukagreska = 1, @indpakovanje= 1
			   #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id#select '' as roba , 'robaid' as focus, robaid = null, kolicina = 0, nabcijena = 0, mpcijena = 0, sktstanje = 0, 'refreshmovelast' as stavke " HOTKEY="F8" />

		<INPUT TYPE="grid" 
			   NAME="stavke" 
			   REFRESHAFTERCHILD="TRUE" 
			   CAPTION="Stavke" 
			   TOP="4140" LEFT="56" WIDTH="8750" HEIGHT="3078"
			   TABINDEX="-1"
			   AFTERREFRESH="select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   POPUP="Obriši:BRISISTAVKU"
			   ONDBLCLICK=":IZMJENISTAVKU" 
			   EDITCOLUMNS="kol.ulaz"
			   ONCELLEDITED="spMPInsertGlaIdetNG @action=4, @maloprodajadetid = @@stavke, @id = @@id, @kolicinaulaz = @(stavke..kol.ulaz), @kolicinanaruceno = @(stavke..kol.ulaz)#select 'stavke' as focus #select cmpiznos from maloprodajagla where maloprodajaglaid = @@id"
			   DETCHECKBOXVISIBLE="FALSE"	
			   PAGEHEADERCENTER="Dokument br.@@broj"
			   PAGEHEADERRIGHT=""
			   PAGEHEADERLEFT="Datum: @@datum##Trgovina: @@trgovina"
			   PAGEFOOTERCENTER=""
			   PAGEFOOTERLEFT=""
			   PAGEFOOTERRIGHT="@@thosmomi"
			   PAGEORIENTATION="LANDSCAPE"
			   GROUPBYBOXVISIBLE="FALSE"
			   TOTALROW="FALSE"
			   SQL="spMPQueryGlaIDetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 0" />

		<INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno*" TOP="7322" LEFT="6594" WIDTH="2100" HEIGHT="280" SQL="" TABINDEX ="-1"  BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="button" NAME="OK" CAPTION="Spremi (F2)" TOP="7840" LEFT="196" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="exec spmpDonesiAmbalazu @action = 1, @maloprodajaglaid = @@id#spMPInsertGlaIdetNG @action=2,@id = @@id,@status = 1,@operateriid=@@operateriid,@sifradok = '104',@datumdok= @@datumdok, @napomena = '@@napomena',@osobeid = @@osobeid, @skladisteid = @@sskladisteid, @osobe2id =@@osobe2id , @nacinplacanjaid = @@nacinplacanjaid #Ok"  />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7840" LEFT="1456" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="zakljuci" CAPTION="Zaključi" TOP="7840" LEFT="2688" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="printaj" CAPTION="Print.dok" TOP="7840" LEFT="4186" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
		<INPUT TYPE="button" NAME="ispravi" CAPTION="Ispravi" TOP="4500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":IZMJENISTAVKU"  />
		<INPUT TYPE="button" NAME="obrisi" CAPTION="Obriši" TOP="5000" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK="FOREACHSELECTED(stavke)#:BRISISTAVKU"  />
		<INPUT TYPE="button" NAME="donesi" CAPTION="Donesi" TOP="5500" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":DONESI"  />
  	    <INPUT TYPE="button" NAME="ambalaza" CAPTION="Ambalaža" TOP="6000" LEFT="9000" WIDTH="1400" HEIGHT="322" ONCLICK=":AMBALAZA"  />
</UPDATE_FORM>


