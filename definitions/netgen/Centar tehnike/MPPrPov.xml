	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
					  NAME="Trgovinaid" 
					  CAPTION="Trgovina" 
					  WIDTH="5500" 
				  HEIGHT="320" 
					  TABINDEX="1" 
				  ALLOWEMPTY="TRUE" 
				  SQL="spMPDajTrgovina @@operateriid"  />


	  <KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
	                               	NAME="datumdo" 
                                   	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="3" 
                                    	CHECKBOX="FALSE"/>
	  <KONTROLA TYPE="CbEx3.ComboBoxEx3" 
