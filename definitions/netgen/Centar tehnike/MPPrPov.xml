		  HEIGHT="320"/>

	  <KONTROLA TYPE="VB.checkbox" 
					  NAME="podklase" 
					  WIDTH="3500" 
					  HEIGHT="320" 
					  CAPTION="pokaži i sve podklase"/>




  </FILTERFORM>


    <FILTERFORM1 
                         FILLEXPLORER="TRUE" 
                         REPORT=""  
                         WIDTH="8000" 
                         STORA="spObilazakRoba " 
                         STARTUPSTORA="select partneriid from partneri where partneriid = @@partneriid" 
                         HEIGHT="4800" 
                         CAPTION="Upišite uvjete "  
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="Pokaži" 
                                  CMD2CAPTION="Odustani" 
                                  CMD3CAPTION=""  
                                  NEXTFORM=""  >

                     	<KONTROLA TYPE="VB.Label" 
                                    	NAME="lbl1" 
                                      	TOP="1100" 
                                    	LEFT="200" 
                                   	WIDTH="1500" 
                                   	HEIGHT="320" 
                                    	CAPTION="Razdoblje"/>
                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumod" 
                                   	TOP="1000" 
                                   	LEFT="2200" 
                                    	CAPTION="Datum od" 
                                   	VALUE="DATE2" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="1" 
                                    	CHECKBOX="FALSE"/>

                     	<KONTROLA TYPE="MSComCtl2.DTPicker" 
                                 	NAME="datumdo" 
                                   	TOP="1000" 
                                   	LEFT="4200" 
                                    	CAPTION="Datum do" 
                                   	VALUE="DATE" 
                                  	HEIGHT="320" 
                                   	WIDTH="1500" 
                                 	TABINDEX="2" 
                                    	CHECKBOX="FALSE"/>

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lbl2" 
                                      	TOP="1600" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                 	HEIGHT="320" 
                               		CAPTION="Partner"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="Partneriid" 
                                    	CAPTION="Partner" 
                                     	TOP="1500" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="3" 
                                   	ALLOWEMPTY="FALSE"
									ENABLED="FALSE"
                                 	SQL="select partneriid, naziv from partneri order by naziv"  /> 

                      	<KONTROLA TYPE="VB.Label" 
                                   	NAME="lblparstru" 
                                      	TOP="2100" 
                                       	LEFT="200" 
                               		WIDTH="1500" 
                                 	HEIGHT="320" 
                               		CAPTION="Lokacija"/>
                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                     	NAME="parstruid" 
                                    	CAPTION="Lokacija" 
                                     	TOP="2000" 
                                     	LEFT="2200"  
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="4" 
                                   	ALLOWEMPTY="FALSE" 
                                 	SQL="select ps.parstruid, rtrim(ps.naziv)+', '+rtrim(m.hptbroj)+' '+rtrim(m.naziv)+', '+ rtrim(ps.adresa) as naziv from parstru ps left outer join mjesta m on ps.mjestaid = m.mjestaid where ps.partneriid = @@partneriid order by 2"  /> 


