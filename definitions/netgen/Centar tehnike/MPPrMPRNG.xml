<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
  	ONLOAD=":FORM1"  		
		REPORT="rptGotRNMMP.clsReport(@@ID)" 	
		CMD1CAPTION="Parametri:FORM1" 
		DETAILGRID = "spmpPregRacNG @action=2,@iD= @@id"
		CMD2CAPTION="" 
		CMD3CAPTION="Analiza fiskalizacije:ANALFISK" 
		CMD4CAPTION="Plaćanje:PLACANJE"
 		CMD5CAPTION="" 
		CMD6CAPTION="Print dok:vrstadokid-MPBlagajnagla"  
		PAGEHEADERCENTER="Pregled računa MP @@NoviRed Od @@datumod do @@datumdo"
		PAGEHEADERRIGHT="@@tkosmomi"
    MASTERDBLCLICK="PROMET"
    POPUPMASTER=""> 
 

  <NAME>Pregled računa MP </NAME>
  <CAPTION>Pregled računa MP </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		ONSUBMIT="spmpPregRacNG @action=1, @operateriid = @@operateriid,  @trgovinaid = @@xtrgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @storno = @@storno, @operid = @@operid, @brojfisk='@@brojfisk'!!" 
		ONLOAD="select @@datumod as datumod , @@datumdo as datumdo , @@xtrgovinaid as trgovinaid, char(13)+char(10) as NoviRed" 
		HEIGHT="4000" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		
		<INPUT TYPE="combo" NAME="xtrgovinaid" CAPTION="Trgovina" WIDTH="5500" HEIGHT="320" TABINDEX="1" ALLOWEMPTY="true" SQL="spMPDajTrgovina @operateriid=@@operateriid"/>
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" VALUE="DATE2" HEIGHT="320" WIDTH="1500" TABINDEX="3" CHECKBOX="FALSE"/>
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="4" CHECKBOX="FALSE"/>
		<INPUT TYPE="combo" NAME="storno" CAPTION="Storno" WIDTH="5500" HEIGHT="320" TABINDEX="5" ALLOWEMPTY="false" SQL="select 0 as storno, 'Svi računi'as naziv union all select 1 , 'Stornirani' "/>
		<INPUT TYPE="combo" NAME="operid" CAPTION="Operater" WIDTH="5500" HEIGHT="320" TABINDEX="6" ALLOWEMPTY="TRUE" SQL="select tp.OperaterID as operid, o.Naziv from TrgovinePrava tp 
							inner join ssOperateri o on tp.OperaterID=o.OperateriID where tp.trgovinaid=@@trgovinaid"/>
		<INPUT TYPE="text" NAME="brojfisk" CAPTION="Fiskalni broj računa" WIDTH="5500" HEIGHT="320" TABINDEX="7" />
	  <INPU2T TYPE="button" NAME="ok" HOTKEY="" TOP="3000" LEFT="1000" WIDTH="1200" CAPTION="Pokaži"
		 ONCLICK="spmpPregRacNG @action=1, @operateriid = @@operateriid, @trgovinaid = @@xtrgovinaid, @datumod = @@datumod, @datumdo = @@datumdo, @storno = @@storno, @operid = @@operid#OK "  />
	  <INPU2T TYPE="button" NAME="cancel" TOP="3000" LEFT="2500" WIDTH="1200" CAPTION="Odustani" ONCLICK="close"  />


  </FORM1>

  <STAVKE 	FILLEXPLORER="TRUE" 
		WIDTH="14000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="7500" 
		CAPTION="Stavke prometa" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		NEXTFORM=""> 
		
		

			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="12000" 
					HEIGHT="6000" 
					TABINDEX="5" 
                      SQL="spmpPregRacNG @action=2,@id	= '@@id'" 
                                          /> 

</STAVKE>		

  <PLACANJE 	FILLEXPLORER="TRUE" 
		WIDTH="5000" 
		ONSUBMIT="" 
		ONLOAD="" 
		HEIGHT="5000" 
		CAPTION="Stavke prometa" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		NEXTFORM=""> 
		
		

			<INPUT TYPE="grid" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="200" 
					LEFT="200"  
					WIDTH="4700" 
					HEIGHT="3000" 
					TABINDEX="5" 
                      SQL="spmpPregRacNG @action=3,@id	= '@@id'" 
                                          /> 

</PLACANJE>


	<ANALFISK 	FILLEXPLORER="TRUE"
		  WIDTH="8600"
		  ONSUBMIT=""
		  ONLOAD=""
		  HEIGHT="8000"
		  CAPTION="Analziza fiskalizacije "
		  BORDERSTYLE="3"
		  CMD1CAPTION=""
		  CMD2CAPTION="Odustani"
		  CMD3CAPTION=""
		  NEXTFORM="">



		<INPUT TYPE="grid"
				NAME="analfisk"
				REFRESHAFTERCHILD="TRUE"
				CAPTION="_ay"
				TOP="200"
				LEFT="200"
				WIDTH="8400"
				HEIGHT="6500"
				TABINDEX="5"
				  SQL="spmpPregRacNG @action=6,@datumod = @@datumod, @datumdo = @@datumdo , @trgovinaid = @@xtrgovinaid "
                                          />

	</ANALFISK>





</PROJECT> 