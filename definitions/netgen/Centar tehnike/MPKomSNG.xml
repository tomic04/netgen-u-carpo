<?xml version="1.0" encoding="windows-1250" ?> 
<PROJECT  
	ONLOAD=":FILTERFORM"  
	BUTTONS="Parametri:FILTERFORM#Kartica:FORM2"
	MASTERDBLCLICK="FORM2"
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE">
 
  <NAME>Pregled stanja komisijske MP robe</NAME>
  <CAPTION>Pregled stanja komisijske MP robe</CAPTION>
 
  <KOMENTAR> </KOMENTAR>

<FILTERFORM 
	FILLEXPLORER="TRUE" 
	REPORT=""  
	ONSUBMIT="exec spMPPregStanjaKomisijskeMPRobeNG @action=1, "
	WIDTH="8000" 
	HEIGHT="3500" 
	CAPTION="Parametri"
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	<INPUT TYPE="number" NAME="godina" CAPTION="Godina:*" TOP="500" LEFT="1000" WIDTH="1900" HEIGHT="320" DECIMALS="0" ENABLED="TRUE"/> 
	<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="900" LEFT="1000"  WIDTH="5000" HEIGHT="320" ALLOWEMPTY="FALSE" ENABLED="TRUE"
		   SQL="spMPDajTrgovina @operateriid = @@operateriid " /> 
	<INPUT TYPE="search" NAME="partneriid" CAPTION="Partner:*" TOP="1300" LEFT="1000" WIDTH="5000" HEIGHT="320" ENABLED="TRUE"
		   SQL="viPartneri#partneriid#%naziv%#!matbroj"/>

</FILTERFORM>

	
	
<FORM2	 	
	FILLEXPLORER="TRUE" 
	WIDTH="12000" 
	HEIGHT="6500" 
	CAPTION="Kartica"> 


	<INPUT TYPE="grid" 
		NAME="stavke" 
		TOP="200" 
		LEFT="200" 
		WIDTH="11500" 		
		HEIGHT="5500" 
		CHECKBOXVISIBLE="FALSE"
		TOTALROW="FALSE"
		CAPTION="Kartica:"
		SQL="spMPPregStanjaKomisijskeMPRobeNG @action=2,@robaid=@@id,@trgovinaid=@@trgovinaid, @godina=@@godina"/>

	<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="7000" LEFT="1000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />

</FORM2>

	
</PROJECT>
 
