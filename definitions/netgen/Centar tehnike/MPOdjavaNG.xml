<?xml version="1.0" encoding="windows-1250" ?> 
<PROJECT  
	ONLOAD=":FILTERFORM"  
	BUTTONS="Parametri:FILTERFORM#Napravi dokument odjave:PROKNJIZIFORM#Kartica:MPKARTICA(@mastergridid = @@robaid, @datumod  = @@datpocid, @datumdo = @@datdo, @datod  = @@datpocid, @datdo = @@datdo, @skladisteid = @@trgovinaid, @totalgen = 2)"
	DETAILGRID = "exec spMPPregKomisijskeMPRobeNewNG @action=2, @datod=@@datod, @datdo=@@datdo, @TrgovinaId=@@TrgovinaId, @robaid=@@robaid, @partneriid = @@node"
	MASTERDBLCLICK=""
	COMMANDTIMEOUT="600"
	GROUPBYBOXVISIBLE="TRUE" 
	CHECKBOXVISIBLE="FALSE"
	TOTALROWVISIBLE="TRUE"
	INCLUDE="MPKarticaRobe.xml" 
	DETTOTALROWVISIBLE="TRUE"
	DETCHECKBOXVISIBLE="FALSE"
	TREE="spMPTreeKomisNG @action=1 , @trgovinaid = @@trgovinaid , @datum = @@datdo:FILTERPAR_FORM"
	EDITCOLUMNS="Količina za odjavu1200"
	ONCELLEDITED="if (select datumzak from MPOdjavaKomisZbirno where MPOdjavaKomisZbirnoid=@@id) is not null begin 
                        exec spRaiserror 69001, 'Dokument odjave za robu je kreiran. Količina se više ne može mijenjati!' end
						else begin
                        update MPOdjavaKomisZbirno set kolicina=@@količina_za_odjavu, vrijemezadnjeizmjene=getdate() where MPOdjavaKomisZbirnoid=@@id end">
 
  <NAME>Pregled komisijske MP robe za odjavu</NAME>
  <CAPTION>Pregled komisijske MP robe za odjavu</CAPTION>

	<FILTERPAR_FORM    FILLEXPLORER="TRUE" ONSUBMIT="exec spMPPregKomisijskeMPRobeNewNG @action=1,@operateriid=@@operateriid , @datod = @@datod, @datdo = @@datdo , @trgovinaid = @@trgovinaid  , @partneriid = @@node" />


	<FILTERFORM
	NAME="FILTERFORM"
	FILLEXPLORER="ONLYTREE"
	ONSUBMIT="exec spMPPregKomisijskeMPRobeNewNG @action=1,@operateriid=@@operateriid, "
	ONLOAD="select @@partneriid as partneriid,@@trgovinaid as trgovinaid , @@datod as datumod, @@datdo as datumdo "
	REPORT=""  
	WIDTH="8000" 
	HEIGHT="3500" 
	CAPTION="Parametri"
	CMD1CAPTION="Pokaži" 
	CMD2CAPTION="Odustani" >


	<INPUT TYPE="date" NAME="datdo"   CAPTION=" Datum odjave *" TOP="500" LEFT="1500" WIDTH="1500" HEIGHT="320" CHECKBOX="FALSE"/>
	<INPUT TYPE="combo" NAME="trgovinaid"   CAPTION="Trgovina*" TOP="900" LEFT="1500" WIDTH="3500" HEIGHT="320" ALLOWEMPTY="FALSE" 
		   SQL="spMPDajTrgovinaNG @operateriid = @@operateriid, @komis = 1 " /> 

</FILTERFORM>

	

<PROKNJIZIFORM 
	FILLEXPLORER="" 
	REPORT=""  
	WIDTH="8000" 
	ONSUBMIT="" 
	ONLOAD="" 
	HEIGHT="2000" 
	CAPTION="Kreiranje dokumenta mp odjave" >


	<INPUT TYPE="label" NAME="lbl1" TOP="300" LEFT="200" WIDTH="5000" HEIGHT="800" BOLD="TRUE"
		   CAPTION="Jeste li sigurni da želite kreirati dokument mp odjave sa stavkama s navedenim količinama?" />
	
	<INPUT TYPE="button" NAME="ok"           CAPTION="Odjavi"   TOP="1000" LEFT="456" WIDTH="1106" HEIGHT="322"
		   ONCLICK="spMPPregKomisijskeMPRobeNewNG @action=3, @datod=@@datod, @datdo=@@datdo, @operateriid=@@operateriid, @partneriid=@@node, @trgovinaid=@@trgovinaid#Ok"  HOTKEY="" />
	<INPUT TYPE="button" NAME="cancel"       CAPTION="Odustani" TOP="1000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	
</PROKNJIZIFORM>

</PROJECT>
 
