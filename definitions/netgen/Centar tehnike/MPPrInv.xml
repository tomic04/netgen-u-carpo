                         HEIGHT="8800" 
                         CAPTION="Stavke prometa"  
						DBLCLICKFORM=""
                         BORDERSTYLE="3" 
                                  CMD1CAPTION="" 
                                  CMD2CAPTION="KRAJ"
			
                                  NEXTFORM=""  >



			<KONTROLA TYPE="GridEX20.GridEX" 
					NAME="stavke" 
					REFRESHAFTERCHILD="TRUE" 
					CAPTION="_ay" 
					TOP="2800" 
					LEFT="200"  
					WIDTH="13500" 
					HEIGHT="5000" 
					TABINDEX="5" 
                      SQL="spGRNalogMP @action = 902,@id=@@id" 
                                          /> 


  </FORM2>

   <KARTICA 	FILLEXPLORER="TRUE" 
		WIDTH="15000" 
		STORA="" 
		STARTUPSTORA="" 
		HEIGHT="9500" 
		CAPTION="Krtica robe" 
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="Kraj" 
		CMD3CAPTION="" 
		CHILDFORM=""> 

			<KONTROLA TYPE="GridEX20.GridEX" NAME="grid1" 
					REFRESHAFTERCHILD="TRUE" 
					TOP="200" 
					LEFT = "200" 
					WIDTH="14500" 
					HEIGHT="8000" 
					TABINDEX="2" 
                    SQL="spMaloprodajaStanjeKartica @action = 1, @idreda= @@id, @operateriid = @@operateriid" /> 
</KARTICA>		


</PROJECT> 