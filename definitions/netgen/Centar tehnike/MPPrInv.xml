<?xml version="1.0" encoding="windows-1250" ?>

<PROJECT  
		STARTUPSTORA=":FORM1"  		
		REPORT="IspisInventure.clsTotal"
		CMD1CAPTION="Parametri:FORM1" 
		CMD2CAPTION="" 
		CMD3CAPTION="" 
		CMD4CAPTION=""
 		CMD5CAPTION="" 
		CMD6CAPTION=""  
		DBLCLICKFORM="PROMET"
	        POPUP=""> 
 

  <NAME>Pregled Inventura MP </NAME>
  <CAPTION>Pregled Inventura MP </CAPTION>
  

  <FORM1 	FILLEXPLORER="TRUE" 
		WIDTH="9000" 
		STORA="spMPPregInventure @action=1, @operateriid = @@operateriid," 
		STARTUPSTORA="" 
		HEIGHT="5500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM=""> 
		



                     	<KONTROLA TYPE="TRAZILICA" 
                                     	NAME="trgovinaid" 
                                    	CAPTION="Trgovina" 
                                    	WIDTH="5500" 
                                   	HEIGHT="320" 
                                     	TABINDEX="1" 
                                   	ALLOWEMPTY="true" 
                                 	SQL="vitrgovina#trgovinaid#%Oznaka%#%Naziv%"/>



			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Roba" 
					NAME="robaid" 
					SQL="roba#robaid#%Naziv%#robakod%#userid%#barcode%" 
					TABINDEX="3" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

			<KONTROLA TYPE="TMEdit2.TextMEdit2" 
					CAPTION="Traženje pojma" 
					NAME="search" 
					TABINDEX="4" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/>

					
					
			<KONTROLA TYPE="TRAZILICA" 
					CAPTION="Klasa" 
					NAME="klasaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					TABINDEX="5" 
					TEXT="" 
					WIDTH="5500" 
					HEIGHT="320"/> 

					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="podklase" 
                               		WIDTH="3500" 
                                   	HEIGHT="320" 
                               		CAPTION="pokaži i sve podklase"/>

                     	<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                    NAME="MPinventuraglaid" 
                                    CAPTION="Inventura " 
                                    WIDTH="5500" 
                                    HEIGHT="320" 
                                    TABINDEX="2" 
                                    ALLOWEMPTY="FALSE" 
				    REFRESHAFTERCHILD="TRUE" 
				    SQL="select MPinventuraglaid, convert(varchar(10),datumdok,104) + ' Broj inv.: '+broj as Naziv from MPinventuragla where trgovinaid = @@trgovinaid"/>
													


					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="Razlike" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
					LEFT="1200" 
					TOP="3000" 
                               		CAPTION="Sve razlike"/>


					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="Visak" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
					LEFT="3200" 
					TOP="3000"
                               		CAPTION="Samo višak"/>

					<KONTROLA TYPE="VB.checkbox" 
                                   	NAME="Manjak" 
                               		WIDTH="1500" 
                                   	HEIGHT="320" 
					LEFT="5200" 
					TOP="3000"
                               		CAPTION="Samo Manjak"/>


			<KONTROLA TYPE="VB.Label" 
                                    NAME="lbl8" 
                                    CAPTION="Vrsta pregleda" 
				    TOP="3500"
				    LEFT="200"
                                    WIDTH="5500" 
                                    HEIGHT="320" 
                                    TABINDEX="6" 
                                    SQL=""/>
					


			<KONTROLA TYPE="CbEx3.ComboBoxEx3" 
                                    NAME="vrstapregid" 
                                    CAPTION="Vrsta pregleda" 
				    TOP="3500"
				    WIDTH="5500" 
                                    HEIGHT="320" 
                                    TABINDEX="6" 
                                    ALLOWEMPTY="FALSE" 
				    SQL="select 1 as vrstapregid, 'Sva roba' as naziv union all select 2, 'Samo vlastita roba' union all select 3, 'Samo komisijska roba'"/>
					

  </FORM1>
 <PROMET 	FILLEXPLORER="TRUE" 
		WIDTH="14000" 
		STORA="" 
