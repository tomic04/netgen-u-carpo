					  CAPTION="Min iznos" 
					  TEXT="" 
					  ENABLED="TRUE"
					  ALLOWEMPTY="FALSE" 
					  WIDTH="1500" 
					  HEIGHT="320" 
					  TABINDEX="7" 
					  DECIMALS="2" />
					  
		<INPUT TYPE="number" 
