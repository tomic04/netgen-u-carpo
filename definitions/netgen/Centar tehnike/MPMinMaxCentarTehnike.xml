  <NAME>Ažuriranje Min i Max zaliha po trgovinama</NAME>
  <CAPTION>Ažuriranje Min i Max zaliha po trgovinama</CAPTION>

  	<FORM1
		FILLEXPLORER="TRUE" 
		WIDTH="10000" 
		ONSUBMIT="spMPMinMaxKonikom @action=11,@operateriid = @@operateriid, " 
		ONLOAD="" 
		HEIGHT="2500" 
		CAPTION="Parametri" 
		BORDERSTYLE="3" 
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		CHILDFORM="">

		<INPUT TYPE="combo"
		CAPTION="Trgovina:"
		NAME="trgovinaid"
		SQL="spmpDajTrgovina @operateriid = @@operateriid "
		TEXT=""
		TABINDEX="1"
		ALLOWEMPTY="TRUE"
		WIDTH="5500"
		ENABLED="TRUE"
		HEIGHT="320"/>

		<INPUT TYPE="TRAZILICA"
				CAPTION="Klasa"
				NAME="klasaid"
				SQL="ViKlaseRobe#klmasterrobaid#Naziv%"
				TABINDEX="2"
				TEXT=""
				WIDTH="5500"
				HEIGHT="320"/>

		<INPUT TYPE="VB.checkbox"
						NAME="podklase"
						WIDTH="3500"
						HEIGHT="320"
						CAPTION="pokaži i sve podklase"/>

		<INPUT TYPE="search" 
			NAME="robaid" 
			CAPTION="Roba"  		
			TABINDEX="3" 
			WIDTH="5500" 
			HEIGHT="320"
			SQL="spMPRobaZaMPNG @trgovinaid = @@trgovinaid , @trazi = '@@searchboxrobaid'" /> 
					
		<INPUT TYPE="text" 
			NAME="search" 
			CAPTION="Traženje pojma"  
			TABINDEX="4"
			WIDTH="5500" 
			HEIGHT="320"/>




	</FORM1>

  
  <FORMADD  	
		FILLEXPLORER="" 
		WIDTH="9000" 
		ONSUBMIT="spMPMinMaxKonikom @action=21,@operateriid = @@operateriid, " 
		ONLOAD="select 1  as rbtnKlasa" 
		HEIGHT="3300" 
		CAPTION="Nova klasa robe " 
		BORDERSTYLE="3" 
		CMD1CAPTION="Spremi" 
		CMD2CAPTION="Odustani" 
		CMD3CAPTION="" 
		> 
		
    <INPUT TYPE="radio" NAME="rbtnKlasa" CAPTION="Klasa" TOP="" LEFT="" HEIGHT="" WIDTH="3000" ONCLICK="select robaid=null, mpccijena=0, maxiznos=0, miniznos=0, vrstekolicina=0, kolicina=0
	#select 'enable' as klmasterrobaid, 'disable' as robaid, 'disable' as kolicina, 'enable' as maxiznos, 'enable' as miniznos"/>
    <INPUT TYPE="radio" NAME="rbtnRoba" CAPTION="Roba" TOP="" LEFT="" HEIGHT="" WIDTH="3000" ONCLICK="select klmasterrobaid=null, mpccijena=0, maxiznos=0, miniznos=0, vrstekolicina=0, kolicina=0
	#select 'enable' as robaid, 'disable' as klmasterrobaid, 'enable' as kolicina, 'disable' as maxiznos, 'disable' as miniznos"/>
		
		<INPUT TYPE="combo"
		CAPTION="Trgovina:"
		NAME="trgovinaid"
		SQL="spmpDajTrgovina @operateriid = @@operateriid "
		TEXT=""
		TABINDEX="1"
		ALLOWEMPTY="FALSE"
		WIDTH="5500"
		ENABLED="TRUE"
		HEIGHT="320"/>
		
			<INPUT TYPE="TRAZILICA" 
					CAPTION="Klasa robe " 
					NAME="klmasterrobaid" 
					SQL="ViKlaseRobe#klmasterrobaid#Naziv%" 
					ONLOSTFOCUS="select dbo.fnmpdajmpc(@@robaid,@@trgovinaid,getdate()) as  mpccijena#select 'vrstekolicina' as focus"
					TEXT=""
					TABINDEX="2" 
					WIDTH="5500" 
					ALLOWEMPTY="FALSE" 
					ENABLED="FALSE"
					HEIGHT="320"/>

	  <INPUT TYPE="TRAZILICA"
			  CAPTION="Roba"
			  NAME="robaid"
			  SQL="ViRobaBezUsluga#robaid#userid#Naziv%"
			  ONLOSTFOCUS="select dbo.fnmpdajmpc(@@robaid,@@trgovinaid,getdate()) as  mpccijena#select 'vrstekolicina' as focus"
			  TEXT=""
			  TABINDEX="3"
			  WIDTH="5500"
			  ALLOWEMPTY="FALSE"
			  ENABLED="FALSE"
			  HEIGHT="320"/>

	  <INPUT TYPE="number" 
					NAME="vrstekolicina" 
					CAPTION="Količina za vrstu artikala"
					ONLOSTFOCUS="if @@rbtnRoba=1 begin select @@vrstekolicina*@@mpccijena as maxiznos end#if @@rbtnRoba=1 begin select 'kolicina' as focus end else begin select 'maxiznos' as focus end "					
					TEXT="" 
					ENABLED="TRUE"
					ALLOWEMPTY="FALSE" 
					WIDTH="800" 
					HEIGHT="320" 
					TABINDEX="4" 
					DECIMALS="0" />
					
			  <INPUT TYPE="number" 
					NAME="kolicina" 
					CAPTION="Min količina"
					ONLOSTFOCUS="if @@rbtnRoba=1 begin select @@kolicina*@@mpccijena as miniznos end#select 'robaid' as focus"
					TEXT="" 
					ENABLED="FALSE"
					ALLOWEMPTY="FALSE" 
					WIDTH="800" 
					HEIGHT="320" 
					TABINDEX="5" 
					DECIMALS="0" />
					
	  <INPUT TYPE="number" 
					NAME="maxiznos" 
					CAPTION="Max iznos" 
					ONLOSTFOCUS="select 'miniznos' as focus"
					TEXT="" 
					ENABLED="FALSE"
					ALLOWEMPTY="FALSE" 
					WIDTH="1500" 
					HEIGHT="320" 
					TABINDEX="6" 
					DECIMALS="2" />

	  <INPUT TYPE="number" 
					NAME="miniznos" 
					CAPTION="Min iznos" 
					ONLOSTFOCUS="select 'klmasterrobaid' as focus"
					TEXT="" 
					ENABLED="FALSE"
					ALLOWEMPTY="FALSE" 
					WIDTH="1500" 
					HEIGHT="320" 
					TABINDEX="7" 
					DECIMALS="2" />
					
		<INPUT TYPE="number" 
					NAME="mpccijena" 
					CAPTION="MP cijena" 
					TEXT="" 
					ENABLED="FALSE"
					ALLOWEMPTY="FALSE" 
					WIDTH="1500" 
					HEIGHT="320" 
					TABINDEX="8" 
					DECIMALS="2" />



  </FORMADD>

	<FORMEDIT  	
		  FILLEXPLORER="" 
		  WIDTH="9000" 
		  ONSUBMIT="spMPMinMaxKonikom @action=3,@id = @@id, @operateriid = @@operateriid, " 
		  ONLOAD="spMPMinMaxKonikom @action=4,@id = @@id" 
		  ONACTIVATED="select dbo.fnmpdajmpc(@@robaid,@@trgovinaid,getdate()) as  mpccijena"
		  ONLOADED="if @@robaid is null begin select 'disable' as kolicina, 'enable' as maxiznos, 'enable' as miniznos end else begin select 'enable' as kolicina, 'disable' as maxiznos, 'disable' as miniznos end"
		  HEIGHT="3300" 
		  CAPTION="Izmjeni uvjete kredita " 
		  BORDERSTYLE="3" 
		  CMD1CAPTION="Spremi" 
		  CMD2CAPTION="Odustani" 
		  CMD3CAPTION="" 
		>
