	<INPUT TYPE="radio" NAME="rbtnKlasa" CAPTION="Klasa" ENABLED="" TOP="" LEFT="" HEIGHT="" WIDTH="3000" ONCLICK="select 'disable' as mkolicina, 'enable' as maxiznos, 'enable' as miniznos"/>
    <INPUT TYPE="radio" NAME="rbtnRoba" CAPTION="Roba" ENABLED="" TOP="" LEFT="" HEIGHT="" WIDTH="3000" ONCLICK="select 'enable' as mkolicina, 'disable' as maxiznos, 'disable' as miniznos"/>
	-->
	<INPUT TYPE="combo"
