<StanjeAmbalazeParametri NAME="StanjeAmbalazeParametri" HEIGHT="3600" WIDTH="5112" CAPTION="Parametri za prikaz stanja ambalaže" ONSUBMIT="declare @polokaciji int, @partneriid int, @parstruid int set @polokaciji=coalesce(@@fpolokaciji,0) set @partneriid=coalesce(@@fpartneriid,0) set @parstruid=coalesce(@@fparstruid,0)
exec spAmbPrometGlaQuery @action=4, @polokaciji=@polokaciji, @datumdo=@@datumdo, @datumod=@@datumod, @parstruid=@parstruid, @partneriid=@partneriid!!" ONLOAD="select @@DatumOd as DatumOd, @@DatumDo as DatumDo, @@fpolokaciji as fPoLokaciji,  (select naziv from partneri where partneriid=@@fpartneriid) as partner, (select partneriid as fpartneriid from partneri where partneriid=@@fpartneriid) as fpartneriid, (select naziv from parstru where parstruid=@@fparstruid) as lokacija, (select parstruid from parstru where parstruid=@@fparstruid) as parstruid" FILLEXPLORER="true" ONLOAD2="select coalesce(@@datumod, (cast(YEAR(getdate()) as varchar) +&apos;0101&apos;)) as datumod" ICON="FilterSearch.ico" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3" PAGEHEADERRIGHT="@@tkosmomi">
	<INPUT TYPE="frame" NAME="FrmStanjeAmbalaze" TOP="72" LEFT="144" HEIGHT="2376" WIDTH="4608" TEXT="FrmStanjeAmbalaze"/>
	<INPUT TYPE="search" NAME="fpartneriid" TOP="432" LEFT="1512" HEIGHT="302" WIDTH="3024" SQL="partneri#partneriid#naziv%#matbroj%" CAPTION="Partner" TABINDEX="10"/>
	<INPUT TYPE="label" NAME="lblPartner" TOP="432" LEFT="331" HEIGHT="288" WIDTH="1094" CAPTION="Partner:" TABINDEX="11"/>
	<INPUT TYPE="search" NAME="fparstruid" TOP="792" LEFT="1512" HEIGHT="302" WIDTH="3024" SQL="parstru#parstruid#Naziv%#sifra#%Adresa%#/and (partneriid=@@fpartneriid or @@fpartneriid is null)" CAPTION="Lokacija" TABINDEX="20" ONLOSTFOCUS="select ps.partneriid as fpartneriid, p.naziv as partner 
from parstru ps inner join partneri p on ps.partneriid=p.partneriid 
where parstruid=@@fparstruid"/>
	<INPUT TYPE="label" NAME="LabelLokacija" TOP="792" LEFT="331" HEIGHT="288" WIDTH="1094" CAPTION="Lokacija:" TEXT="Label28"/>
	<INPUT TYPE="date" NAME="datumod" TOP="1152" LEFT="1512" HEIGHT="302" WIDTH="1728" TABINDEX="30"/>
	<INPUT TYPE="label" NAME="LabelOdDatuma" TOP="1152" LEFT="331" HEIGHT="288" WIDTH="1094" CAPTION="Od datuma:"/>
	<INPUT TYPE="date" NAME="datumdo" TOP="1512" LEFT="1512" HEIGHT="302" WIDTH="1728" TABINDEX="40"/>
	<INPUT TYPE="label" NAME="LabelDoDatuma" TOP="1512" LEFT="331" HEIGHT="288" WIDTH="1094" CAPTION="Do datuma:"/>
	<INPUT TYPE="check" NAME="fpolokaciji" TOP="1872" LEFT="1512" HEIGHT="288" WIDTH="1642" CAPTION="Prikaži po lokaciji" TABINDEX="50" TEXT="CheckBoxTG0"/>
	<INPUT TYPE="button" NAME="buttonCLOSE" TOP="2592" LEFT="1512" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG1" CAPTION="Odustani" TABINDEX="70" ENABLED="TRUE" ONCLICK="CLOSE"/>
	<INPUT TYPE="button" NAME="buttonOK" TOP="2592" LEFT="144" HEIGHT="331" WIDTH="1080" VISIBLE="TRUE" TEXT="ButtonNG0" CAPTION="Prihvati" TABINDEX="60" ENABLED="TRUE" ONCLICK="OK"/>

