	<INPUT TYPE="date" NAME="DatumDo" TOP="115" LEFT="3600" HEIGHT="302" WIDTH="1728" TABINDEX="20"/>
	<INPUT TYPE="date" NAME="DatumOd" TOP="115" LEFT="1354" HEIGHT="302" WIDTH="1728" TABINDEX="10"/>
	<INPUT TYPE="search" NAME="PartneriId" TOP="562" LEFT="1354" HEIGHT="302" WIDTH="3989" SQL="Partneri#PartneriId#%Naziv%" TABINDEX="30"/>
	<INPUT TYPE="label" NAME="Label14" TOP="562" LEFT="288" HEIGHT="288" WIDTH="979" CAPTION="Partner:" TEXT="Label14"/>
