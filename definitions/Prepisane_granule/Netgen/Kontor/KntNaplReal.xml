	<INPUT TYPE="combo" NAME="OrgShemaId" TOP="965" LEFT="1368" HEIGHT="302" WIDTH="3946" SQL="select OrgShemaId, Naziv from OrgShema" ALLOWEMPTY="TRUE" TABINDEX="40"/>
	<INPUT TYPE="combo" NAME="OsobeId" TOP="1397" LEFT="1354" HEIGHT="302" WIDTH="3960" ALLOWEMPTY="TRUE" SQL="select o.OsobeId, rtrim(coalesce(o.Ime,&apos;&apos;))+&apos; &apos;+rtrim(coalesce(o.Prezime,&apos;&apos;)) as Naziv     
			      
            from Osobe o inner join LnOsoPar op on o.OsobeId = op.OsobeId
            where op.ParStruId in (select ParStruId from ParStru
		                           where PartneriId = (select Convert(integer,VarSet) from PubVars where VarIme = &apos;NasId&apos;))
		    and (o.Ime != &apos;***&apos; and o.Prezime != &apos;***&apos;)				  

			order by Naziv" TABINDEX="50"/>
	<INPUT TYPE="label" NAME="Label24" TOP="1397" LEFT="288" HEIGHT="288" WIDTH="1037" CAPTION="Osoba:" TEXT="Label24"/>
