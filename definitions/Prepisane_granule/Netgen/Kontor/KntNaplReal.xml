<Filter NAME="Filter" HEIGHT="3499" WIDTH="5846" CAPTION="Naplaćena realizacija" DBCLIPBOARD="true" ONLOAD="select convert(varchar, YEAR(GETDATE()))+ &apos;0101&apos; as DatumOd" ONSUBMIT="spKntNaplRealNG @Action = 1," FILLEXPLORER="TRUE" REFRESHAFTERCHILD="TRUE" BORDERSTYLE="3">
