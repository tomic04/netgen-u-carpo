<?xml version="1.0" encoding="windows-1250" ?>
<PROJECT  
      ONLOAD=":FILTERFORM"  
      CMD1CAPTION=""  
      MASTERDBLCLICK=""
	  CHECKBOXVISIBLE="FALSE"  
      PAGEHEADERCENTER=""
	  PAGEHEADERRIGHT=""
	  PAGEHEADERLEFT="##Knjiženje utrška u periodu od: @@datod do: @@datdo"
	  PAGEFOOTERCENTER=""
	  PAGEFOOTERLEFT="@@datdanas"
	  PAGEFOOTERRIGHT="@@tkosmomi"
	  PAGEORIENTATION="LANDSCAPE"
	  COMMANDTIMEOUT="300"
      BUTTONS="Pregled:FILTERFORM#Proknjiži:PROKNJIZIFORM#Ispiši:PRINTMASTER"	  
      >
 
  <NAME>Knjiženje utrška</NAME>
  <CAPTION>Knjiženje utrška</CAPTION>
 
  <KOMENTAR> ASDASD </KOMENTAR>
  
  
   <FILTERFORM 
		FILLEXPLORER="TRUE" 
		REPORT=""  
		WIDTH="6600" 
		ONSUBMIT="spKntMPRacuniNG @action=1,@Operaterid=@@operateriid," 
		ONLOAD="select @@datod as datod , @@datdo as datdo ,(select naziv  from partneri where partneriid = convert(integer,(select VarSet from PubVars where VarIme = 'NasId'))) as tkosmomi,getdate() as datdanas " 
		ONLOAD2="select (dateadd(month,datediff(month,0,getdate())-1,0))as datod,(dateadd(d,-1,left(convert(varchar,getdate(),112),6)+'01')) AS datdo"
		HEIGHT="1900" 
		CAPTION="Izaberite uvjete traženja"  
		BORDERSTYLE="3" 
		CMD1CAPTION="" 
		CMD2CAPTION="" 
		CMD3CAPTION=""  
		NEXTFORM=""  >
					  
		<INPUT TYPE="label" NAME="lblprijemod" TOP="280" LEFT="200" WIDTH="1500" HEIGHT="320" CAPTION="Razdoblje:"/>
		<INPUT TYPE="date" NAME="datod" TOP="250" LEFT="1200" CAPTION="prijem od" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="0" DEFAULT="firstdayoflastmonth" CHECKBOX="FALSE"/>
							
		<INPUT TYPE="label" NAME="lblprijemdo" TOP="250" LEFT="3000" WIDTH="1500" HEIGHT="320" CAPTION="-"/>
		<INPUT TYPE="date" NAME="datdo" TOP="250" LEFT="3500" CAPTION="prijemdo" VALUE="DATE" HEIGHT="320" WIDTH="1500" TABINDEX="1" CHECKBOX="FALSE"/>		  
				  
		<INPUT TYPE="button" NAME="ok1" HOTKEY="F4" TOP="1000" LEFT="200" WIDTH="1100" CAPTION="Izvrši (F4)" ONCLICK="OK" TABINDEX="2" />							  
		<INPUT TYPE="button" NAME="cancel" TOP="1000" LEFT="1450" WIDTH="1100" CAPTION="Odustani" ONCLICK="close" TABINDEX="3" />
				
  </FILTERFORM>

  <PROKNJIZIFORM FILLEXPLORER="" ONLOAD="" ONSUBMIT="spKntMPRacuniNG @action=2,@datod=@@datod,@datdo=@@datdo,@Operaterid=@@operateriid" />
  
</PROJECT>
 
