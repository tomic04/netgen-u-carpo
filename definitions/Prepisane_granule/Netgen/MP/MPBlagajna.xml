<?xml version="1.0" encoding="windows-1250" standalone="yes" ?>
<PROJECT
		 SETDEFAULTS=""
		 DETAILGRID = "spMPBlagajnaQueryGlaIdetNG @action=2,@operateriid=@@operateriid,@id=@@id, @nenc = 1"
		 MASTERDBLCLICK=""
		 BUTTONS="Parametri:FILTERFORM#Zaključak blagajne:ZAKLJUCAK#Plaćanje:PLACANJE#Print dok:vrstadokid-MPBlagajnagla#Print liste:PRINTMASTER#Napomena:NAPOMENA"
		 POPUPMASTER="Parametri:FILTERFORM#Storno računa:STORNO#Zaključak blagajne:ZAKLJUCAK#" 
		 TREE="Danas:DANAS_FORM#Jučer:JUCER_FORM#spMPTreeNG @action=1:TEKUCIMJESEC_FORM#Prošli mjesec:PROSLIMJESEC_FORM#spMPTreeNG @action=2:FILTERODDO_FORM#spMPTreeNG @action=3:FILTERODDO_FORM#spMPTreeNG @action=4:FILTEROPERATERIFORM"
		 GROUPBYBOXVISIBLE="TRUE" ONLOAD="" 
		 CHECKBOXVISIBLE="FALSE"
		 TOTALROWVISIBLE="FALSE"
		 DETTOTALROWVISIBLE="FALSE"
		 PAGEHEADERCENTER=""
	     PAGEHEADERRIGHT=""
	     PAGEHEADERLEFT="Trgovina: @@trgovina"
	     PAGEFOOTERCENTER=""
	     PAGEFOOTERLEFT=""
	     PAGEFOOTERRIGHT=""
	     PAGEORIENTATION="LANDSCAPE">



	<NAME>MP računi</NAME>
	<CAPTION>MP računi</CAPTION>


<DANAS_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action=1,@operateriid=@@operateriid,@node='danas', @vrstatrg = 'V'" />
<JUCER_FORM         FILLEXPLORER="TRUE" ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action=1,@operateriid=@@operateriid,@node='jucer', @vrstatrg = 'V'" />
<TEKUCIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action=1,@operateriid=@@operateriid,@node='ovajmj', @vrstatrg = 'V'" />
<PROSLIMJESEC_FORM  FILLEXPLORER="TRUE" ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action=1,@operateriid=@@operateriid,@node='proslimj', @vrstatrg = 'V'" />
<FILTERODDO_FORM    FILLEXPLORER="TRUE" ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action=1,@operateriid=@@operateriid,@node='@@node', @vrstatrg = 'V'" />



<FILTERFORM 
		NAME="FILTERFORM" HEIGHT="3254" WIDTH="6710" 
		CAPTION="Upišite uvjete prikaza " 
		ONSUBMIT="spMPBlagajnaQueryGlaIdetNG @action = 1,  @operateriid= @@operateriid, @vrstatrg='V', "
		ONLOAD="" 
		FILLEXPLORER="TRUE" 
		NEXTFORM=""
		CMD1CAPTION="Pokaži" 
		CMD2CAPTION="Odustani">
	
		<INPUT TYPE="date" NAME="datumod" CAPTION="Datum od" />
		<INPUT TYPE="date" NAME="datumdo" CAPTION="Datum do" />
		<INPUT TYPE="combo" NAME="trgovinaid" ALLOWEMPTY="TRUE" CAPTION="Trgovina" ONLOSTFOCUS="" SQL="spMPDajTrgovina @operateriid = @@operateriid " />
		<INPUT TYPE="combo" NAME="mpkaseid" ALLOWEMPTY="TRUE" CAPTION="Kasa" ONLOSTFOCUS="" SQL="select mpkaseid, kasa from mpkase where trgovinaid = @@trgovinaid" />
		<INPUT TYPE="combo" NAME="status" ALLOWEMPTY="true" CAPTION="Status" SQL="select 1 as status,&apos;Bez zaključka&apos; as naziv  union all select 2 as status,&apos;U zaključku&apos; as naziv " />
</FILTERFORM>



<PLACANJE 
		NAME="POKAZIFORM" HEIGHT="6998" WIDTH="6002"  
		CAPTION="Plaćanje"
		ONLOAD="if @@id is not null begin exec spMPBlagajnaQueryGlaIdetNG @action=3,@id=@@id end else begin exec spRaiserror 69001, ' Odaberite račun ! ' end ">

		<INPUT TYPE="text" NAME="broj" CAPTION="Broj računa:*" TOP="144" LEFT="2160" HEIGHT="317" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum računa:*" TOP="504" LEFT="2160" HEIGHT="302" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="number" NAME="placeno"	CAPTION="Iznos računa*" TOP="864" LEFT="2160" HEIGHT="302" WIDTH="1000" SQL="" ALLOWEMPTY="FALSE" ENABLED="FALSE" />
		<INPUT TYPE="grid" NAME="placanje" TOP="2002" LEFT="58" HEIGHT="3589" WIDTH="10498" CHECKBOXVISIBLE="FALSE" SQL="exec spMPBlagajnaQueryGlaIdetNG @action = 33,@id=@@id" />
	
		<INPUT TYPE="button" NAME="ok"     CAPTION="Izmjeni"  TOP="6000" LEFT="500" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spMPPonudaPromovirajNG @action = 1, @id = @@id, @operateriid = @@operateriid#:NAPLATA#close"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6000" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</PLACANJE>

	<STORNO NAME="STORNO" HEIGHT="3197" WIDTH="5501"
	CAPTION="Stornirati račun ?"
	ONSUBMIT=""
	ONLOAD="if (select storno from mpblagajnagla where mpblagajnaglaid= @@ID ) = 'S'  begin 
                        exec spRaiserror 69001, 'Dokument je već storniran. Ne možete ga stornirati !' 
					end
					else begin
						if (select status from mpblagajnagla where mpblagajnaglaid= @@ID ) &lt;&gt; 2 begin 
							exec spRaiserror 69001, 'Dokument nije zaključen. Ne možete ga stornirati !' 
						end
					else begin
                    exec spMPBlagajnaQueryGlaIdetNG @action=3,@ID=@@ID
					end						
				end"
	 FILLEXPLORER="">

		<INPUT TYPE="number"  NAME="mpblagajnaglaid" VISIBLE="FALSE" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" ENABLED="FALSE"/>
		<INPUT TYPE="text"  NAME="broj" TOP="360" LEFT="2304" HEIGHT="317" WIDTH="2794" CAPTION="_broj" ENABLED="FALSE"/>
		<INPUT TYPE="label" NAME="Label55" TOP="360" LEFT="288"	 HEIGHT="288" WIDTH="1728" CAPTION="Broj računa:" />
		<INPUT TYPE="label" NAME="stat" TOP="1325" LEFT="331" HEIGHT="490" WIDTH="4234" CAPTION="Jeste li sigurni da želite stornirati dokument  ? " />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Storniraj"  TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322"
			   ONCLICK="#close#spMPStornoBlagNG @action = 1 , @id=@@id, @poruka = 1 , @operateriid = @@operateriid#FISKALIZACIJA(@@mpblagajnaglaid)#OK"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</STORNO>


	<STORNORAC
		NAME="POKAZIFORM" HEIGHT="6998" WIDTH="6002"
		CAPTION="Storniranje računa"
		ONLOAD="if @@id is not null begin exec spMPBlagajnaQueryGlaIdetNG @action=3,@id=@@id end else begin exec spRaiserror 69001, ' Odaberite račun ! ' end ">

		<INPUT TYPE="text" NAME="broj" CAPTION="Broj računa:*" TOP="144" LEFT="2160" HEIGHT="317" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum računa:*" TOP="504" LEFT="2160" HEIGHT="302" WIDTH="1498" ENABLED="FALSE" />
		<INPUT TYPE="number" NAME="placeno"	CAPTION="Iznos računa*" TOP="864" LEFT="2160" HEIGHT="302" WIDTH="1000" SQL="" ALLOWEMPTY="FALSE" ENABLED="FALSE" />

		<INPUT TYPE="button" NAME="ok"     CAPTION="Storniraj"  TOP="6000" LEFT="500" WIDTH="1106" HEIGHT="322"
			   ONCLICK="spMPStornoBlagNG @action = 1, @id = @@id, @operateriid = @@operateriid#:NAPLATA#close"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6000" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
	</STORNORAC>


	<ZAKLJUCAK 
		NAME="ZAKLJUCAK" HEIGHT="6998" WIDTH="6002"  
		CAPTION="Zaključak blagajne"
		ONLOAD="select 0 as ukuzak" >

		<INPUT TYPE="combo" NAME="trgovinaid" CAPTION="Trgovina:*" TOP="144" LEFT="1560" HEIGHT="317" WIDTH="3498" ENABLED="TRUE" 
			SQL="SpMPDajTrgovina @operateriid = @@operateriid, @vrstatrg = 'V'" 
			ONLOSTFOCUS ="select 'refresh' as datumdok
					#select 'refresh' as mpkaseid 
					#exec spMPBlagajnaQueryGlaIdetNG @action = 47,@datumdok=@@datumdok, @trgovinaid = @@trgovinaid, @mpkaseid = @@mpkaseid"/>
		<INPUT TYPE="combo" NAME="mpkaseid" CAPTION="Blagajna:*" TOP="504" LEFT="1560" HEIGHT="317" WIDTH="1000" ENABLED="TRUE" SQL="select mpkaseid, kasa as naziv from mpkase where trgovinaid = @@trgovinaid" ONCLICK=""/>
		<INPUT TYPE="date" NAME="datumdok" CAPTION="Datum zaključka:*" TOP="854" LEFT="1560" HEIGHT="302" WIDTH="1498" ENABLED="TRUE" />
	
		<INPUT TYPE="button" NAME="ok" CAPTION="Pokaži" TOP="854" LEFT="3500" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="select 0 as ukuzak
			   #exec spMPBlagajnaQueryGlaIdetNG @action = 45,@datumdok=@@datumdok, @trgovinaid = @@trgovinaid, @mpkaseid = @@mpkaseid
			   #select 'refresh' as zakljucak
			   #select 'visible' as zakljucak 
			   #select  'visible' as gumbzak"  ONLOSRFOCUS ="" HOTKEY="" />
	
		<INPUT TYPE="number" NAME="ukuzak" CAPTION="Ukupno:*" TOP="5500" LEFT="3560" HEIGHT="302" WIDTH="1498" ENABLED="TRUE" BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="grid" NAME="zakljucak"	TOP="1202" LEFT="58" HEIGHT="3989" WIDTH="10498" VISIBLE="FALSE" CHECKBOXVISIBLE="FALSE" TOTALROW="FALSE"
			SQL="exec spMPBlagajnaQueryGlaIdetNG @action = 44,@datumdok=@@datumdok, @trgovinaid = @@trgovinaid, @mpkaseid = @@mpkaseid" />
	
		<INPUT TYPE="button" NAME="gumbzak" CAPTION="Zaključi"  TOP="6000" LEFT="500" WIDTH="1106" HEIGHT="322" VISIBLE="FALSE" 
			   ONCLICK="exec spMPBlagajnaInsertGlaIdetNG @action = 46,@datumdok=@@datumdok, @trgovinaid = @@trgovinaid, @ukuzak = @@ukuzak, @operateriid = @@operateriid, @mpkaseid = @@mpkaseid"  HOTKEY="" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6000" LEFT="2000" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</ZAKLJUCAK>


<NAPLATA
		FILLEXPLORER="TRUE" 
		WIDTH="5500" 
		ONSUBMIT=""
		ONLOAD="if (select zakljucakid from mpblagajnagla where mpblagajnaglaid = @@id) is not null  
				begin exec spRaiserror 69001, 'Račun je u zaključku blagajne. Ne može se mijenjati plaćanje ! ' 
				end else begin select placeno as cmpiznos, (select sum(iznos) FROM ##tponudanaplata WHERE ponudaglaid = @@id 
								and operateriid = @@operateriid and trgovinaid = @@trgovinaid ) - @@cmpiznos as za_vratiti 
								from mpblagajnagla where mpblagajnaglaid = @@id end" 		
		HEIGHT="7000" 
		CAPTION="Način plaćanja MP računa" >


		<INPUT TYPE="grid" NAME="naplata" TOP="300" LEFT="200" WIDTH="9000"	HEIGHT="5000" CHECKBOXVISIBLE="FALSE" TOTALROWVISIBLE="FALSE" 
			   EDITCOLUMNS="Iznos1000"
			   ONCELLEDITED="spMPPonudaPromovirajNG @action = 2, @id = @@id, @kntnacinplacid = @@naplata,  @operateriid = @@operateriid, @iznosplac = @@placeno
							#select @@za_vratiti as zavratiti
							#select 'naplata' as focus"
			   GROUPBYBOXVISIBLE="FALSE" CAPTION="Stavke ponude za promoviranje" 
			   ONENTERKEY=":UPISIZNOS
							#select 'naplata' as focus
							#spMPPonudaPromovirajNG @action = 3 , @id = @@id, @operateriid = @@operateriid"
			   REFRESHAFTERCHILD="TRUE"	VISIBLE="TRUE"
			   SQL="spMPPonudaPromovirajNG @action = 1, @operateriid = @@operateriid , @id = @@id" />

		<INPUT TYPE="number" NAME="cmpiznos" CAPTION="Ukupno za platiti*" TOP="5500" LEFT="1700" WIDTH="1100" HEIGHT="280" SQL="" TABINDEX ="-1"  ENABLED ="FALSE" BACKCOLOR="greenyellow" STYLE="1"/>
		<INPUT TYPE="number" NAME="za_vratiti" CAPTION="Za vratiti*" TOP="5500" LEFT="4000" WIDTH="1100" HEIGHT="280" SQL="" TABINDEX ="-1"  ENABLED ="FALSE" BACKCOLOR="greenyellow" STYLE="1"/>
	
		<INPUT TYPE="button" NAME="ok"     CAPTION="Spremi"  TOP="6000" LEFT="456" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spMPBlagajnaInsertGlaIdetNG @action = 48, @operateriid = @@operateriid, @id = @@id#close"  HOTKEY="F2" />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="6000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</NAPLATA>

<UPISIZNOS 
		NAME="UPISIZNOS " HEIGHT="3302" WIDTH="7085"
		CAPTION="Iznos plaćanja" 
		ONSUBMIT=""
		ONLOAD="select @@cmpiznos as iznosplac , naziv from kntnacinplac where kntnacinplacid = @@naplata" 
		FILLEXPLORER="">

		<INPUT TYPE="text" NAME="naziv" TOP="700" LEFT="2059" HEIGHT="288" WIDTH="4478" CAPTION="_Način plaćanja:*" ENABLED="FALSE" />
		<INPUT TYPE="number" NAME="iznosplac" TOP="1200" LEFT="2074" HEIGHT="288" WIDTH="1500"  CAPTION="Iznos plaćanja:*" DECIMAL="2" ENABLED="TRUE"  />
	
		<INPUT TYPE="button" NAME="ok"     CAPTION="Prihvati"  TOP="2000" LEFT="456" WIDTH="1106" HEIGHT="322" 
			   ONCLICK="spMPPonudaPromovirajNG @action = 2 , @id = @@id, @kntnacinplacid = @@naplata,  @operateriid = @@operateriid, @iznosplac = @@iznosplac
						#select @@za_vratiti as zavratiti
						#select 'naplata' as focus#OK"   />
		<INPUT TYPE="button" NAME="cancel" CAPTION="Odustani" TOP="2000" LEFT="1756" WIDTH="1106" HEIGHT="322" ONCLICK="close"  />
</UPISIZNOS >


<NAPOMENA NAME="NAPOMENA" HEIGHT="3000" WIDTH="8610"
	   CAPTION=""
	   ONSUBMIT=""
	   ONLOAD="select napomena, vrstadokid from mpblagajnagla where mpblagajnaglaid = @@id"
	   FILLEXPLORER="TRUE"
	   NEXTFORM=""
		ONLOAD2=""
	   ONLOADED="select 'Upišite napomenu za račun ' + broj as formcaption from mpblagajnagla where mpblagajnaglaid = @@id"
	   CMD1CAPTION=""
	   CMD2CAPTION=""
		 >

		<INPUT TYPE="frame" NAME="frm" CAPTION=""  TOP="50" LEFT="50" WIDTH="8250" HEIGHT="1900"/>
		<INPUT TYPE="text" NAME="napomena" CAPTION="Napomena za račun:*" MULTILINE="TRUE" TOP="400" LEFT="1600" WIDTH="6550" HEIGHT="900"/>

		<INPUT TYPE="combo" NAME="porukeid" ALLOWEMPTY="TRUE" CAPTION="Pohranjeni tekstovi*" TOP="1400" LEFT="1600" WIDTH="4500" HEIGHT="600"
			   ONLOSTFOCUS="" SQL="spMPBlagajnaQueryGlaIdetNG @action = 52, @vrstadokid = @@vrstadokid" />
		<INPUT TYPE="label" NAME="lblInfo" CAPTION="*Pohranjeni tekstovi se uzimaju za vrstu dokumenta MP RAČUN." SIZE="7" TOP="2100" LEFT="3500" WIDTH="5000" HEIGHT="300"/>

		<INPUT TYPE="button" NAME="dodaj" CAPTION="Dodaj u napomenu" TOP="1350" LEFT="6200" WIDTH="2000" HEIGHT="422" HOTKEY=""
			   ONCLICK="spMPBlagajnaQueryGlaIdetNG @action = 53, @napomena = '@@napomena', @porukeid = @@porukeid
                  "/>

		<INPUT TYPE="button" NAME="spremi" CAPTION="Spremi"  TOP="2000" LEFT="400" WIDTH="1100" HEIGHT="320" HOTKEY=""
			   ONCLICK="spMPBlagajnaInsertGlaIdetNG @action = 52,  @id= @@id, @napomena = '@@napomena'#OK"/>
		<INPUT TYPE="button" NAME="odustani" CAPTION="Odustani"  TOP="2000" LEFT="1800" WIDTH="1100" HEIGHT="320" HOTKEY=""
			   ONCLICK="close"/>

</NAPOMENA>

</PROJECT>