<!--jupiter2012, PPTELE2_test-->
<!-- 23.01.2025. IF dodao control focus na btnPrikazi jer se inače javi greška SendKeys -->
<!-- 21.01.2022. SV dodao provjeru kod pregleda dmsa dtDMSProvjera da li ide na kupskener ili kuppromet -->
<!--16.12.2021. AA isključen bestfitonrefresh kako bi radio savelayout-->
<!-- 01.09.2021. IF Novi Carpo - bug fixing_tekst caption="Analitika PS" fontsizedelta="1" prebacio u checkedit -->
<!--20.5.2021. AA minsize 200 zbog novih devexa-->
<!--12.3.2021. AA ne prikazuj sumu jer već postoje kao retci u gridu-->
<root>
	<form name="frmFakturaRacun" path="IOSObrazac.frmFakturaRacun.xml"/>
	<form name="frmTemEdit" path="Temeljnice.frmTemEdit.xml"/>
	<form name="frmDMS" path="KnjigaUra.frmDMS.xml"/>
	<form name="frmMaster" caption="Kartica partnera" type="master" template="splitter" maximized="true">
		<event type="load">
			<action type="control focus" value="#btnPrikazi"/>
			<action type="variable value" value="$AnalitikaPS">
				<parameter value="0"/>
			</action>
			<action type="datarun scalar" value="~dtDMSProvjera">
				<parameter name="DMSOznaka"/>
			</action>
		</event>
		<event type="shown">
			<action type="control focus" value="#datOd"/>
		</event>		
		<layout name="panel1" type="collapsable"  minsize="200">
			<group cols="2" rows="7" groupbordervisible="false">
				<columnsdefinition>
					<column size="100" position="1"/>
					<column size="100" position="2"/>				
				</columnsdefinition>			
				<item col="1" row="1" caption="Datum od:" fontsizedelta="1">
					<dateedit name="datOd" savevalue="app" tabindex="1" required="true" fontsizedelta="1">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
						</event>
					</dateedit>
				</item>
				<item col="2" row="1" caption="Datum do:" fontsizedelta="1">
					<dateedit name="datDo" savevalue="app" tabindex="2" required="true" minvalue="#datOd" fontsizedelta="1">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
						</event>				
					</dateedit>
				</item>
				<item col="1" row="2" caption="Konto:" colspan="2" fontsizedelta="1">
					<combomultiedit name="cmbKonto" dataname="~dtKonto" valuefield="KntPlanAId" required="true" displayfield="Konto" savevalue="app" tabindex="3" fontsizedelta="1">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
					</combomultiedit>
				</item>
				<item col="1" row="3" caption="Partner:" colspan="2" fontsizedelta="1">
					<searchedit name="srcPartner" netgenfields="true" dataname="~dtPartner" fieldtext="Partner" fieldvalue="PartneriId"  required="true" savevalue="app" tabindex="4" fontsizedelta="1" savelayout="true">
						<event type="valuechanged">
							<action type="variable value" value="$PartneriId">
								<parameter value="#srcPartner"/>
							</action>
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>	
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
							<!--ulazak u tražilicu izgubi fokus-->
						</event>
					</searchedit>
				</item>
				<item col="1" row="4" caption="Valuta:" colspan="2" fontsizedelta="1">
					<comboedit name="cmbValuta" dataname="~dtValuta" valuefield="ValuteId" displayfield="OznakaNaziv" savevalue="app" tabindex="5" allownull="true" fontsizedelta="1">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
						</event>						
					</comboedit>
				</item>
				<item col="1" row="5" caption="Organizacijska shema:" colspan="2" fontsizedelta="1">
					<combotreeedit name="cmbOrgShema" dataname="~dtGetOrgShema" savevalue="app" parentfieldname="ParentId" valuefield="Id" displayfield="Naziv" allownull="true" fontsizedelta="1" tabindex="6">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
						</event>					
					</combotreeedit>
				</item>
				<item col="1" row="6" >
					<checkedit name="chePS" savevalue="app" tabindex="7" fontsizedelta="1" caption="Analitika PS">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="form caption" value="Kartica partnera"/>
							<action type="footer text" value=""/>
							<action type="variable value" value="$AnalitikaPS" if="#chePS==false">
								<parameter value="0"/>
							</action>
							<action type="variable value" value="$AnalitikaPS" if="#chePS==true">
								<parameter value="1"/>
							</action>							
						</event>
						<!-- rješava problem ne dolaska na gumb prikaži-->
						<event type="leave">
							<action type="control focus" value="#btnPrikazi"/>
						</event>
					</checkedit>
				</item>	
				<item col="1" row="7"/>
			</group>
		</layout>
		<layout name="panel2">
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdGlavni" dataname="~dtGlavni" multiselect="true" async="true" savelayout="true" showfooter="false" fieldsmartspaces="false" bestfitmaxrowcount="200">
						<fields inherited="true"/>
						<print  caption="KARTICA PARTNERA" 
								captionalign="center"
								header="{#srcPartner.text}\nu razdoblju od {#datOd::dd.MM.yyyy}. do {#datDo::dd.MM.yyyy}.\n"/>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrikazi" caption="PRIKAŽI" tabindex="8">
					<event type="click">
						<action if="#datOd&gt;#datDo">
							<action type="message" value="Vremensko razdoblje nije ispravno!"/>
							<action type="control value" value="#datDo">
								<parameter value="#datOd"/>
							</action>
						</action>
						<action else="">
							<action type="validate"/>
							<action type="control populate" value="#grdGlavni"/>
							<action type="footer text" value="Broj stavki: {#grdGlavni.rowcount}"/>
							<action type="form caption" value="Kartica partnera {#srcPartner.text} u razdoblju od {#datOd::dd.MM.yyyy}. do {#datDo::dd.MM.yyyy}."/>
						</action>
					</event>				
				</button>
				<button name="btnRacun" caption="RAČUN">
					<event type="click">
						<action type="form open" value="frmFakturaRacun" if="#grdGlavni.@Tablica==Fakture">
							<parameter name="FaktureId" value="#grdGlavni.@IdDok"/>
							<parameter name="StatusFak" value="2"/>
							<parameter name="PartneriId" value="#srcPartner"/>
							<parameter name="ImeGrida" value="grdGlavni" type="string"/>
						</action>
						<action type="form open" value="frmRacun" if="#grdGlavni.@Tablica==FaktureDob">
							<parameter name="FaktureDobId" value="#grdGlavni.@IdDok"/>
						</action>						
					</event>
				</button>
				<button name="btnPreglednik" caption="PREGLEDNIK">
					<event type="click">
						<action if="#grdGlavni.@Tablica==FaktureDob">
							<action type="datarun reader" value="~dtPoveziKupFaktureDobSkener"/>
							<action if="$DMSOznaka==KupSkener">
							<action type="form open" value="frmDMS" if="~dtPoveziKupFaktureDobSkener.@KupSkenerId!=null"> 
								<parameter name="KupSkenerId" value="~dtPoveziKupFaktureDobSkener.@KupSkenerId"/>
							</action> 
							</action>
							<action if="$DMSOznaka==KupPromet">
							<action type="form open" value="frmDMS" if="~dtPoveziKupFaktureDobSkener.@KupPrometId!=null">
								<parameter name="KupPrometId" value="~dtPoveziKupFaktureDobSkener.@KupPrometId"/>
							</action>	
							</action>								
						</action>
					</event>
				</button>				
				<button name="btnTemeljnica" caption="DOKUMENT">
					<event type="click">
						<action type="form open" value="frmTemEdit" if="#grdGlavni.@KntTemId!=null">
							<parameter name="KntTemId" value="#grdGlavni.@KntTemId"/>
							<parameter name="ZakljInd" value="1" type="int"/>
							<!-- <parameter name="UraInd" value="1" if="#grdGlavni.@Tablica==FaktureDob"/> -->
							<!-- <parameter name="IraInd" value="1" if="#grdGlavni.@Tablica==Fakture"/> -->
							<!--što ako je kntostalo ili -->
						</action>
					</event>
				</button>				
				<button name="btnIspis" caption="ISPIŠI" tabindex="9">
					<event type="click">
						<action type="control print control" value="#grdGlavni"/>
					</event>
				</button>
				<button name="btnHRIspis" caption="ISPIŠI HR" dataname="~dtHRIspis" displayfield="Opis" tabindex="10">
					<event type="click">
						<action type="datarun scalar" value="~dtReplaceTilda">
							<parameter name="NizKonto"/>
						</action>
						<action type="control print" value="#grdGlavni">
							<action type="print template" value="#btnHRIspis.@Template">
								<parameter name="DatumOd" value="#datOd"/>
								<parameter name="DatumDo" value="#datDo"/>
								<parameter name="nizkonto" value="$NizKonto"/>
								<parameter name="PartneriId" value="#srcPartner"/>
								<parameter name="DevValuteId" value="#cmbValuta"/>
								<parameter name="AnalitikaPS" value="$AnalitikaPS"/>
								<parameter name="OrgShemaId" value="#cmbOrgShema"/>
							</action>
						</action>
					</event>
				</button>
				<button name="btnENGIspis" dataname="~dtENGIspis" displayfield="Opis" caption="ISPIŠI ENG" tabindex="11">
					<event type="click">
						<action type="datarun scalar" value="~dtReplaceTilda">
							<parameter name="NizKonto"/>
						</action>					
						<action type="control print" value="#grdGlavni">
							<action type="print template" value="#btnENGIspis.@Template">
								<parameter name="DatumOd" value="#datOd"/>
								<parameter name="DatumDo" value="#datDo"/>
								<parameter name="NizKonto" value="$NizKonto" type="string"/>
								<parameter name="PartneriId" value="#srcPartner"/>
								<parameter name="DevValuteId" value="#cmbValuta"/>
								<parameter name="AnalitikaPS" value="$AnalitikaPS"/>
								<parameter name="OrgShemaId" value="#cmbOrgShema"/>
							</action>
						</action>					
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGlavni" command="spCKntKarticaPartnera">
				<parameter name="@DatOd" value="#datOd"/>
				<parameter name="@DatDo" value="#datDo"/>
				<parameter name="@NizKonto" value="#cmbKonto"/>
				<parameter name="@PartneriId" value="#srcPartner"/>	
				<parameter name="@DevValuteId" value="#cmbValuta"/>
				<parameter name="@AnalitikaPS" value="#chePS"/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
			</data>
			<data name="dtKonto" command="spCKntKarticaPartneraKontrole">
				<parameter name="@Action" value="2"/>
			</data>
			<data name="dtValuta" command="spCKntKarticaPartneraKontrole">
				<parameter name="@Action" value="1"/>
			</data>		
			<data name="dtGetOrgShema" command="spCKntKarticaPartneraKontrole">
				<parameter name="@Action" value="5"/>
			</data>				
			<data name="dtPartner" command="spCKntTemTraziPartneri">
				<parameter name="@Action" value="Partneri"/>
				<parameter name="@Uvjet" value="#srcPartner.text"/>			
			</data>
			<data name="dtHRIspis" command="spCKntKarticaPartneraKontrole">
				<parameter name="@Action" value="3"/>		
			</data>	
			<data name="dtENGIspis" command="spCKntKarticaPartneraKontrole">
				<parameter name="@Action" value="4"/>		
			</data>		
			<data name="dtReplaceTilda" command="spCKntKarticaPartneraRpt">
				<parameter name="@Action" value="1"/>
				<parameter name="@NIzKonto" value="#cmbKonto"/>
			</data>
			<data name="dtPoveziKupFaktureDobSkener" command="spCKntDMS">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="#grdGlavni.@IdDok"/>
			</data>
			<!-- provjera da li je kupskener ili kuppromet iz dmsa -->
			<data name="dtDMSProvjera" command="spCKntKarticaKontaDMSProvjera">
				<parameter name="@Action" value="1"/>
			</data>
		</datalist>
	</form>
	<form name="frmRacun" caption="URA"  width="500" height="570">
		<event type="load">
			<action type="datarun reader" value="~dtPopuni"/>
			<action type="control value" value="#txtBroj">
				<parameter value="~dtPopuni.@Broj"/>
			</action>
			<action type="control value" value="#datDatumdok">
				<parameter value="~dtPopuni.@DatumDok" type="date"/>
			</action>
			<action type="control value" value="#datValuta">
				<parameter value="~dtPopuni.@DatumValute" type="date"/>
			</action>
			<action type="control value" value="#txtIznosFakture">
				<parameter value="~dtPopuni.@IznosFakture" />
			</action>
			<action type="control value" value="#txtPlaceniIznos">
				<parameter value="~dtPopuni.@IznosPlaceni" />
			</action>
			<action type="control value" value="#txtPartner">
				<parameter value="~dtPopuni.@Naziv" />
			</action>
			<action type="control value" value="#txtIznosPoreza">
				<parameter value="~dtPopuni.@IznosPoreza" />
			</action>	
			<action type="control value" value="#txtUgovor">
				<parameter value="~dtPopuni.@OpisKupUgovori" />
			</action>
			<action type="control value" value="#txtOsoba">
				<parameter value="~dtPopuni.@ImePrezime" />
			</action>
			<action type="control value" value="#txtOrgShema">
				<parameter value="~dtPopuni.@NazivOrgShema" />
			</action>
			<action type="control value" value="#txtAdresa">
				<parameter value="~dtPopuni.@Adresa"/>
			</action>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdRacun"/>
			<action type="control disable" value="#txtBroj,#datDatumDok,#datValuta,#txtIznosFakture,
			#txtIznosPoreza,#txtPlaceniIznos,#txtPartner,#txtUgovor,#txtOsoba,#txtOrgShema,#txtAdresa"/>
		</event>
		<layout>
			<group cols="1" rows="2">
				<group col="1" row="1" cols="2" rows="7">
					<item col="1" row="1" caption="Broj:" textposition="left">
						<textedit name="txtBroj" />
					</item>
					<item col="1" row="2" caption="Datum dokumenta:" textposition="left">
						<dateedit name="datDatumDok" />
					</item>
					<item col="2" row="2" caption="Valuta:" textposition="left">
						<dateedit name="datValuta" />
					</item>
					<item col="1" row="5" caption="Iznos fakture:" textposition="left">
						<textedit name="txtIznosFakture" format="n2" />
					</item>
					<item col="1" row="6" caption="Iznos poreza." textposition="left">
						<textedit name="txtIznosPoreza" format="n2" />
					</item>
					<item col="1" row="7" caption="Plaćeni iznos:" textposition="left">
						<textedit name="txtPlaceniIznos" format="n2" />
					</item>		
					<item col="1" row="3" colspan="2" caption="Partner:" textposition="left">
						<textedit name="txtPartner" />
					</item>
					<item col="1" row="4" colspan="2" caption="Adresa:" textposition="left">
						<textedit name="txtAdresa"/>
					</item>
					<item col="2" row="5" caption="Ugovor:" textposition="left">
						<textedit name="txtUgovor" />
					</item>
					<item col="2" row="6" caption="Osoba:" textposition="left">
						<textedit name="txtOsoba" />
					</item>
					<item col="2" row="7" caption="Org. shema:" textposition="left">
						<textedit name="txtOrgShema" />
					</item>				
				</group>
				<group col="1" row="2" cols="1" rows="1">
					<item col="1" row="1">
						<grid name="grdRacun" dataname="~dtRacun">
							<fields>
								<field name="RobaKod" caption="Šifra"/>
								<field name="RobaNaziv" caption="Naziv robe"/>
								<field name="JMNaziv" caption="JM"/>
								<field name="Kolicina" caption="Količina"/>
								<field name="Cijena"/>
								<field name="Iznos" caption="Vrijednost"/>
							</fields>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIzlaz" caption="IZLAZ" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtRacun" command="spCKntKarticaKontaDevRacun">
				<parameter name="@Action" value="2"/>
				<parameter name="@Id" value="$FaktureDobId"/>
			</data>
			<data name="dtPopuni" command="spCKntKarticaKontaDevRacun">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$FaktureDobId"/>
			</data>
		</datalist>
	</form>	
</root>