<root>
<form name="frmPromet" caption="Promet po računu br.: {parent.$BrojRacuna}" width="780" height="500">
		<event type="onload">
			<action type="control populate" value="#grdPromet" />
		</event>
		<layout textposition="top" itemspadding="2" autotaborder="false" focusdirection="downthenacross" >
			<group cols="1" rows="1" groupbordervisible="false" >
				<group cols="1" rows="1" >
					<item col="1" row="1" >
						<grid name="grdPromet" async="true" dataname="~dtPromet" datavalue="~dtPromet"  showfooter="True"  autowidth="true" savelayout="true" >	
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<datalist>
			<data command="spCKntKompPrometQuery" name="dtPromet">
				<parameter name="@Action"  value="0" />
				<parameter name="@DokId"  value="parent.#grdDuznik.@dokid" if="parent.$DuznikInd==1"/>
				<parameter name="@DokId"  value="parent.#grdVjerovnik.@dokid" if="parent.$DuznikInd==0"/>
				<parameter name="@Tablica"  value="Fakture" if="parent.$DuznikInd==1"/>
				<parameter name="@Tablica"  value="FaktureDob" if="parent.$DuznikInd==0"/>
			</data>
		</datalist>
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" caption="Zatvori" type="cancel"/> 
			</buttons>
		</panelbuttons>
	</form>
</root>