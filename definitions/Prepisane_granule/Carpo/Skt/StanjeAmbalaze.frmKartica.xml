<root>
    <form name="frmKartica" caption="Kartica artikla" fixedsize="false" width="800" height="570">
        <layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid netgenfields="true" name="grdKartica" autopopulate="true" dataname="global.~dtKartica">
                            <fields inherited="true">
                                <field name="ind" visible="false" />
                                <field name="VrstaDok" caption="Vrsta dokumenta" />
                                <field name="StatusStr" caption="Status" />
                                <field name="kolicinaulaz" caption="Kolicina ulaz" />
                                <field name="kolicinaizlaz" caption="Kolicina izlaz" />
                            </fields>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="Zatvori">
                    <event type="click">
                        <action type="form close"></action>
                    </event>
                </button>
                <button caption="Ispiši karticu">
                    <event type="click">
                        <action type="control printcontrol" value="#grdKartica"/>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
    </form>
</root>