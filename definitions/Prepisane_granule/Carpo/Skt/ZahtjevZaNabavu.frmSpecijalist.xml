<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmSpecijalist" caption="Dodjela specijalista">
		<layout>
			<group cols="1" rows="1" bordervisible="false">
					<item col="1" row="1" highlight="false" caption="Specijalist:" >
						<comboedit name="cmbSpecijalist" dataname="dtSpecijalist" displayfield="Naziv" valuefield="OperateriId" datavalue=""/>
					</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="&amp;SPREMI" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtSpremi"/>																	
						<action type="form close"/>						
					</event>
				</button>			
				<button name="btnOdustani" caption="&amp;IZLAZ">
					<event type="click">
						<action type="variable value" value="parent.$NabZahDetId">
							<parameter value="$NabZahDetId" type="int"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNG_Combo" name="dtSpecijalist">
				<parameter name="@Action" value="Operateri" />
			</data>
			<data command="spNab_ZahDet_Specijalist" name="dtSpremi">
				<parameter name="@OperateriId" value="@@operateriid" />
				<parameter name="@NabZahGlaId" value="$NabZahGlaId" />
				<parameter name="@OperaterSpecijalistId" value="#cmbSpecijalist" />
				<parameter name="@table" value="parent.#grdStavke.selectedids.table" if="$IndForma==1"/>
				<parameter name="@table" value="parent.#grdDetail.selectedids.table" else=""/>
			</data>				
		</datalist>
	</form>
</root>