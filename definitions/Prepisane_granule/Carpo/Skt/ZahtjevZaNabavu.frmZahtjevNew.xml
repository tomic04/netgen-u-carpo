<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmZahtjevNew" caption="Novi zahtjev">
		<event type="init">
			<action type="datarun reader" value="~dtGetLastData"/>
		</event>
		<event type="shown">
			<action type="control value" value="#txtBroj">
				<parameter value="&lt;novi dokument&gt;"/>
			</action>
			<action type="control disable" value="#txtBroj"/>
			<action type="control value" value="#cmbOrgShema">
				<parameter value="~dtGetLastData.@OrgShemaId"/>
			</action>
			<action type="control value" value="#cmbOdgOsoba">
				<parameter value="~dtGetLastData.@OsobeId"/>
			</action>
			<action type="control focus" value="#cmbOrgShema"/>
		</event>
		<layout>
			<part name="prtZahtjev" path="prtZahtjev.xml"/>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="&amp;UNESI" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtZahtjevUnos">
							<parameter name="NabZahGlaId" type="int"/>
						</action>
						<action type="variable value">
							<parameter name="parent.$NabZahGlaId" value="$NabZahGlaId" type="int"/>
						</action>
						<action type="form close"/>

						<!-- <action type="control populate" value="parent.#tree" if="$NabZahGlaId!=0"/> -->
						<action type="datarun scalar" value="dtDatumZaTree">
							<parameter name="DatumZaTree" value="$DatumZaTree" />
						</action>
						<action type="control focus" value="parent.#tree" if="$NabZahGlaId!=0">
							<parameter value="$DatumZaTree" />
						</action>						
						<action type="control populate" value="parent.#grdMaster" if="$NabZahGlaId!=0"/>
						<action type="control focus" value="parent.#grdMaster" if="$NabZahGlaId!=0">
							<parameter value="parent.$NabZahGlaId" />
						</action>

						<action type="form open" value="frmZahtjevEdit">
							<parameter name="NabZahGlaId" value="$NabZahGlaId" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="&amp;IZLAZ" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_ZahGla_Unos" name="dtZahtjevUnos">
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@OsobeId" value="#cmbOdgOsoba"/>
				<parameter name="@VrstaDokId" value="$VrstaDokId"/>
				<parameter name="@Prefix" value=""/>
				<parameter name="@Sufix" value=""/>
				<parameter name="@DatumDok" value="#datDatum"/>
				<parameter name="@BrojDok" value=""/>
				<parameter name="@Broj" value=""/>
				<parameter name="@Status" value="0"/>
				<parameter name="@Opis" value="#txtOpis" if="#txtOpis!=null"/>
				<parameter name="@Izvor" value="0"/>
				<parameter name="@OperaterLock" value="0"/>
				<parameter name="@NabMetodaNabaveId" value="#cmbNabMetodaNabave"/>
				<parameter name="@NabVrstaTroskaId" value="#cmbNabVrstaTroska"/>
			</data>
			<data command="spNab_ZahGla_GetLastOrgAndOdg" name="dtGetLastData">
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="SELECT LEFT(CONVERT(varchar, DatumDok,112),6) as DatumZaTree from NabZahGla where NabZahGlaId=@NabZahGlaId" type="text" name="dtDatumZaTree">
				<parameter name="@NabZahGlaId" value="$NabZahGlaId" type="int"/>
			</data>				
		</datalist>
	</form>
</root>