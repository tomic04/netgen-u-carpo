<root>
	<form name="frmPregled" caption="Parametri za prikaz stanja ambalaže" width="370">
		<event type="init">
			<action type="datarun reader" value="Global.dtDatumi"/>
			<action type="datarun reader" value="global.~dtDajPartnera"/>
		</event>
		<event type="shown">
			<action type="control value" value="#datDatumOd" if="#datDatumOd!=null">
				<parameter value="global.$Datum_Od"/>
			</action>
			<action type="control value" value="#datDatumOd" if="#datDatumOd==null">
				<parameter value="Now"/>
			</action>
			<action type="control value" value="#datDatumDo" if="#datDatumDo!=null">
				<parameter value="global.$Datum_Do"/>
			</action>
			<action type="control value" value="#datDatumDo" if="#datDatumDo==null">
				<parameter value="Now"/>
			</action>
			<action type="control value" value="#srcPartner">
				<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
			</action>
			<action type="control value" value="#srcParstru">
				<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
			</action> 
			<!-- <action type="control value" value="#srcPartner">
				<parameter value="global.$PartneriId" />
			</action> -->
			<!-- <action type="control value" value="#srcParstru">
				<parameter value="global.$ParStruId" />
			</action>  -->
			<action type="control value" value="#cmbKlPartneri">
				<parameter value="global.$KlPartneriId"/>
			</action>
			<action type="control value" value="#chkIspod">
				<parameter value="global.$Ispod"/>
			</action>
			<action type="control value" value="#cmbSkladiste">
				<parameter value="global.$SkladisteId" />
			</action>
			<action type="control value" value="#cmbKlMasterRoba">
				<parameter value="global.$KlMasterRobaId"/>
			</action>
			<action type="control value" value="#cmbRoba">
				<parameter value="global.$RobaId"/>
			</action> -
			<action type="control value" value="#chkPoLokaciji">
				<parameter value="global.$PrikaziPoLokaciji"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="8" col="1" row="1">
				<item caption="Partner:" col="1" row="1" fontbold="true">
					<!-- <searchedit netgenfields="true" name="srcPartner" fontbold="true" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="Global.~dtPartneri.@partneriid" datatext="Global.~dtParstru.@NazivId"> -->
						<searchedit name="srcPartner" fontbold="true" dataname="Global.dtPartneri">
						 <event type="valuechanged">
							<action type="variable value">
								<parameter name="PartneriId" value="#srcPartner" />
							</action>
							<action type="variable value">
								<parameter name="IndPromijenjeno" value="1" />
							</action>
							<action type="variable value">
								<parameter name="IndLoad" value="0" />
							</action>
						</event>
						<event type="leave">
							 <action type="variable value">
								<parameter name="PartneriId" value="#srcPartner"/>
							</action> 
							<action type="datarun reader" value="global.~dtDajPartnera" if="#srcPartner!=null"/>
							<action type="control value" value="#srcParstru" if="#srcPartner!=null">
								<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
							</action>
							<action type="control value" value="#srcParstru" if="#srcPartner==null">
								<parameter value="null"/>
							</action>  
							 <action type="variable value">
								<parameter name="IndLokacija" value="0" />
							</action>
							<action type="variable value">
								<parameter name="IndPromijenjeno" value="0" />
							</action> 
						</event>
					</searchedit>
				</item>
				<item caption="Lokacija:" col="1" row="2">
					<!-- <searchedit netgenfields="true" name="srcParstru" dataname="global.~dtParstru" fieldtext="NazivId" fieldvalue="ParStruId" datavalue="global.~dtDajPartnera" datatext="global.~dtDajPartnera.@ParStruNaziv"> -->
					<searchedit netgenfields="true" name="srcParstru" dataname="global.~dtParstru">
						<event type="leave">
							<action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null"/>
							<action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
								<parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv"/>
							</action>
						</event>
					</searchedit>
				</item>
				<group cols="2" rows="1" col="1" row="3" caption="" groupbordervisible="false">
					<item col="1" row="3" caption="Klasa partnera:">
						<combotreeedit name="cmbKlPartneri" valuefield="KlPartneriId" displayfield="Naziv" dataname="global.~dtKlPartneri" savevalue="app"/>
					</item>
					<item caption=" " col="2" row="3" highlight="false">
						<checkedit caption="i ispod" name="chkIspod" />
					</item>
				</group>
				<item col="1" row="4" caption="Skladište">
					<combomultiedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="global.~dtSkladiste" savevalue="app" />
				</item>
				<item col="1" row="5" caption="Roba:">
					<combomultiedit name="cmbRoba" valuefield="RobaId" displayfield="Naziv" dataname="global.~dtRoba" savevalue="app"/>
				</item>
				<item col="1" row="6" caption="Klasa robe:">
					<combomultiedit name="cmbKlMasterRoba" valuefield="KlMasterRobaId" displayfield="Naziv" dataname="global.~dtKlMasterRoba" savevalue="app"/>
				</item>
				<group cols="3" rows="1" col="3" row="7" caption="" groupbordervisible="false">
					<item col="1" row="1" caption="Datum od:">
						<dateedit name="datDatumOd" value="" required="" savevalue=""/>
					</item>
					<item col="2" row="1" caption="Datum do:">
						<dateedit name="datDatumDo" value="" required="" savevalue=""/>
					</item>
					<item col="3" row="1" caption=" ">
						<part name="prtBtnRazdoblje" path="prtBtnRazdoblje.xml" />
					</item>
				</group>
				<item caption="" col="1" row="8" highlight="false">
					<checkedit caption="Prikaži po lokaciji" name="chkPoLokaciji" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrikaz" type="add" caption="PRIKAŽI">
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="dohvat podataka...">
						<!-- <action type="validate" /> -->
						<action type="variable value">
							<parameter name="global.$Datum_Od" value="#datDatumOd" type="date"/>
							<parameter name="global.$Datum_Do" value="#datDatumDo" type="date"/>
							<parameter name="global.$PartneriId" value="#srcPartner"/>
							<parameter name="global.$ParStruId" value="#srcParStru"/>
							<parameter name="global.$KlPartneriId" value="#cmbKlPartneri"/>
							<parameter name="global.$Ispod" value="#chkIspod"/>
							<parameter name="global.$SkladisteId" value="#cmbSkladiste" />
							<parameter name="global.$KlMasterRobaId" value="#cmbKlMasterRoba"/>
							<parameter name="global.$RobaId" value="#cmbRoba"/>
							<parameter name="global.$PrikaziPoLokaciji" value="#chkPoLokaciji"/>
						</action>
						<action type="datarun nonquery" value="global.~dtPrikazGrida">
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spDatumi" name="dtDajDatum">
				<parameter name="@action" value="$varDatAction" />
			</data>
		</datalist>
	</form>
</root>