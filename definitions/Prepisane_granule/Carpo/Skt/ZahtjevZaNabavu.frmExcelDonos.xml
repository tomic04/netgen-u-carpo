<root>
    <form name="frmExcelDonos" caption="Donos iz excela" width="" height="" fixedsize="">
		<event type="load">		
			<action type="control populate" value="#grdDonos"></action>		
		</event>
        <layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid name="grdDonos" dataname="dtStavkeGet" multiselect="true" savelayout="true">
							<fields>
								<field name="Šifra" caption="Šifra" />
								<field name="Kod" caption="Kod" />
								<field name="Roba" caption="Roba" />
								<field name="Kolicina" caption="Količina"/>
								<field name="JM" caption="JM"/>
								<field name="OrgShema" caption="Org. shema"/>	
								<field name="Dimenzija" caption="Dimenzija"/>
								<field name="Namjena" caption="Namjena"/>
								<field name="DobavljacSifra" caption="Šifra dobavljača"/>
								<field name="Dobavljac" caption="Dobavljač"/>
								<field name="DatumIsporuke" caption="Datum isporuke"/>	
								<field name="Napomena" caption="Napomena"/>
								<field name="Greska" caption="Greška" />						
							</fields>
 				 			<styles>				
								<style name="fontcolor" value="red" if="#grdDonos.@IndGreska==1" />
							</styles>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="DONESI" type="add" dock="left" function="Donos">
                    <event type="click">
                        <action type="datarun nonquery" value="~dtDonesi"/>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="OBRIŠI" type="delete" dock="left" function="ExcelObrisiStavku">
					<event type="click">
						<action type="confirm" value="Želite li sigurno obrisati označene stavke?">
							<action type="control foreachrow selected" value="#grdDonos" >
								<action type="datarun nonquery" value="~dtExcelObrisiStavku"></action>
							</action>					
							<action type="control populate" value="#grdDonos"/>
						</action>
					</event>
                </button>				
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="dbo.spNab_ZahDet_ExcelDonos" name="dtDonesi">
                <parameter name="@NabZahGlaId" value="$NabZahGlaId" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
				<parameter name="@action" value="1"/>
            </data>	
            <data command="dbo.spNab_ZahDet_ExcelDonos" name="dtStavkeGet">
                <parameter name="@NabZahGlaId" value="$NabZahGlaId" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
				<parameter name="@action" value="0"/>
            </data>
            <data command="dbo.spNab_ZahDet_ExcelObrisi" name="dtExcelObrisiStavku">
                <parameter name="@NabZahDet_ExcelId" value="#grdDonos.@NabZahDet_ExcelId" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
            </data>				
        </datalist>
    </form>
</root>