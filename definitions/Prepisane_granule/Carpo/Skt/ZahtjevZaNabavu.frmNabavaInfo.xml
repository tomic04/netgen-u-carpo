<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmNabavaInfo" caption="Informacije o nabavi" width="750" height="500" >
		<event type="init">
			<action type="datarun reader" value="~dtInfo"/>
		</event>	
		<layout textposition="left">
			<group cols="1" rows="3" bordervisible="false">
				<item col="1" row="1"  caption="Roba:" highlight="false" width="250">
					<textedit name="txtRoba" datavalue="~dtInfo.@Roba" readonly="true"/>
				</item>
				<item col="1" row="2"  caption="Partner:" highlight="false" width="250">
					<textedit name="txtPartner" datavalue="~dtInfo.@Partner" readonly="true"/>
				</item>	  
				<item col="1" row="3">
					<grid name="grdInfo" autopopulate="true" bestfitonrefresh="true" dataname="dtInfoGrid">
						<fields>
							<field name="DatumDok" caption="Datum" formatstring="dd.MM.yyyy. HH:mm"/>
							<field name="VrstaDok" caption="Vrsta dokumenta" />
							<field name="Broj" caption="Broj" />
							<field name="Kolicina" caption="Količina" />
							<field name="RobaJM" caption="JM" />														
							<field name="StatusStr" caption="Status" />
							<field name="Inicijali" caption="Operater" />
							<field name="OsobaNaziv" caption="Odgovorna osoba" />
							<field name="OrgShemaNaziv" caption="Org. shema" />
							<field name="OpisStavke" caption="Opis" />
						</fields>		  
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" type="cancel" caption="&amp;IZLAZ"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spNab_ZahGla_PovijestStatusa" name="dtPovijestStatusa"> -->
			<!-- <parameter name="@ID" value="$NabZahGlaId"/> -->
			<!-- </data> -->
			<data command="spNab_ZahGla_Info" name="dtInfoGrid">
				<parameter name="@id" value="$NabZahDetId" type ="int" />
			</data>	
			<data command="select case (select VarSet from PubVars where VarIme = 'RobaDefKey')
									when 'RobaKod' then r.RobaKod
									when 'UserKod' then r.UserKod
									else convert(varchar, r.UserId) end + ' ' + rtrim(r.naziv) as Roba, p.naziv as Partner
							from roba r left outer join Partneri p on r.ProizvodjacId = p.PartneriId
							where r.RobaId = @RobaId" type="text" name="dtInfo">
				<parameter name="@RobaId" value="$RobaId" type="int"/>
			</data>				
		</datalist>
	</form>
</root>
