<root>
	<form name="frmMaster" type="master" caption="Stanje ambalaže">
		<event type="init">
			<action type="variable value">
				<parameter name="Datum_Od" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="DatumDo" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="PartneriId" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="ParStruId" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="KlPartneriId" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="RobaId" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="SkladisteId" value="null" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="PoLokaciji" value="null" type="int"/>
			</action>
		</event>
		<event type="shown">
			<action type="form open" value="frmPregled" />
			<action type="control populate" value="#grdMaster" />
		</event>
		<managerlayout>
			<grid name="grdMaster" type="master" autopopulate="false" bestfitonrefresh="true" dataname="global.~dtPrikazGrida" showfooter="false">
				<fields inherited="true">
					<field name="!" visible="false" />
					<field name="sifra" caption="Šifra" />
					<field name="jm" caption="JM" />
					<field name="PS" caption="PS" />
					<field name="kolicinaulaz" caption="Količina ulaz" />
					<field name="kolicinaizlaz" caption="Količina izlaz" />
					<field name="PartnerNaziv" caption="Partner" />
					<field name="ParStruNaziv" caption="Lokacija" />
					<field name="NabavnaCijena" caption="Nabavna cijena" />
					<field name="NabavnaVrijednost" caption="Nabavna vrijednost" />
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="frmPregled" caption="Parametri">
					<event type="click">
						<action type="form open" value="frmPregled" />
					</event>
				</button>
				<button name="btnDokumentEdit" caption="Kartica">
					<event type="click">
						<action type="variable value">
							<parameter name="SktPrometDetId" value="#grdMaster.@SktPrometDetId" />
						</action>
						<action type="form open" value="frmKartica">
							<parameter name="SktPrometDetId" value="$SktPrometDetId" />
						</action>
					</event>
				</button>
				<button name="btnDokumentEdit" caption="Ispiši stanje">
					<event type="click">
						<action type="control printcontrol" value="#grdMaster"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
	<form name="frmPregled" path="frmPregled.xml" />
	<form name="frmKartica" path="frmKartica.xml"/>
	<datalist>
		<data command="spAmbPrometGlaQueryCarpo" name="dtPrikazGrida">
			<parameter name="@Action" value="4" />
			<parameter name="@DatumOd" value="global.$Datum_Od" />
			<parameter name="@DatumDo" value="global.$Datum_Do" />
			<parameter name="@PartneriId" value="global.$PartneriId" />
			<parameter name="@ParStruId" value="global.$ParStruId" />
			<parameter name="@KlPartneriId" value="global.$KlPartneriId" />
			<parameter name="@Ispod" value="global.$Ispod" />
			<parameter name="@SkladisteId" value="global.$SkladisteId" />
			<parameter name="@KlMasterRobaId" value="global.$KlMasterRobaId" />
			<parameter name="@RobaId" value="global.$RobaId" />
			<parameter name="@PoLokaciji" value="global.$PrikaziPoLokaciji" />
			</data>
		<!-- partneri -->
		<data command="spTraziPartneri" name="dtPartneri">
			<parameter name="@Action" value="Partneri1" />
			<parameter name="@Uvjet" value="#srcPartner.text" />
			<!-- <parameter name="@broj_lokacija" value="1" /> -->
		</data>
		<data command="spDajPartnera" name="dtDajPartnera">
			<!-- <parameter name="@id" value="#srcParstru" />
			<parameter name="@partneriid" value="#srcPartner" /> -->

			<parameter name="@id" value="global.$ParStruId" />
			<parameter name="@partneriid" value="global.$PartneriId" />
		</data>
		<!-- lokacija -->
		<data command="spTraziParstru" name="dtParstru">
			<parameter name="@action" value="Parstru"/>
			<parameter name="@Ind_Postotak" value="1"/>
			<parameter name="@Uvjet" value="" if="$IndLokacija==1"/>
			<parameter name="@Uvjet" value="#srcParstru.text" else=""/>
			<parameter name="@PartneriId" value="$PartneriId"/>
		</data>
		<!-- klasa partnera -->
		<data command="spAmbPrometPartneriKlasaCarpo" name="dtKlPartneri"/>
		<!-- skladište -->
		<data command="spNG_Combo" name="dtSkladiste">
			<parameter name="@Action" value="Skladiste" />
			<parameter name="@IND" value="1" />
		</data>
		<!-- roba -->
		<data command="spDajRobu" name="dtRoba" />
		<!-- klasa robe -->
		<data command="spNG_Combo" name="dtKlMasterRoba">
			<parameter name="@Action" value="KlMasterRoba"/>
			<parameter name="@Ind" value="1"/>
		</data>
		<!-- kartica -->
		<data command="spAmbPrometDetQueryCarpo" name="dtKartica">
			<parameter name="@Action" value="4"/>
			<parameter name="@RobaId" value="parent.#grdMaster.@robaid"/>
			<parameter name="@partneriid" value="parent.#grdMaster.@PartneriId"/>
			<parameter name="@parstruid" value="parent.#grdMaster.@ParStruId"/>
			<parameter name="@datumod" value="global.$Datum_Od"/>
			<parameter name="@datumdo" value="global.$Datum_Do"/>
		</data>
	</datalist>
</root>