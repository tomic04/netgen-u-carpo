<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmPromjenaStatusa" caption="{$Naslov}">
		<event type="init">
			<action type="variable value">
				<parameter name="Naslov" value="$NaslovTekst"/>
			</action>
		</event>
		<event type="shown">
			<!-- <action type="message" value="global.$ZakljucakInd" /> -->
		</event>
		<layout>
			<group cols="1" rows="2">
				<item col="1" row="1" highlight="false" caption="Jeste li sigurni da želite promijeniti status?">
					<comboedit name="cmbStatus" displayfield="Korak" valuefield="StatusiId" dataname="dtStatus" allownull="false"/>
				</item>
				<item col="1" row="2" highlight="false" caption="Napomena:">
					<memoedit name="txtNapomena"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPromijeni" caption="&amp;PROMIJENI">
					<event type="click">
						<action if="$IzForme==0">
							<action type="control foreachrow selected" value="parent.#grdMaster" if="global.$ZakljucakInd==1">
								<action type="datarun nonquery" value="global.~dtZakljuci"/>
							</action>
							<action type="datarun nonquery" value="~dtVrati" else=""/>
						</action>
						<action else="">
							<action if="global.$ZakljucakInd==1">
								<action type="datarun nonquery" value="global.~dtZakljuci"/>
							</action>
							<action type="datarun nonquery" value="~dtVrati" else=""/>              
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="&amp;IZLAZ" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spStatusi_NG" name="dtStatus">
				<parameter name="@action" value="1" if="global.$ZakljucakInd==1"/>
				<parameter name="@action" value="2" else=""/>
				<parameter name="@tablica" value="NabZahGla"/>				
				<parameter name="@operateriid" value="@@OperateriId" />
				<parameter name="@id" value="$NabZahGlaId" type ="int" />
			</data>	
			<!-- <data command="spNab_ZahGla_GetNextStatus" name="dtStatus"> -->
			<!-- <parameter name="@id" value="$NabZahGlaId"/> -->
			<!-- <parameter name="@operateriid" value="@@operateriid"/> -->
			<!-- </data> -->
			<!-- <data command="spNab_ZahGla_Zakljuci" name="dtZakljuci"> -->
			<!-- <parameter name="@id" value="$NabZahGlaId"/> -->
			<!-- <parameter name="@operateriid" value="@@operateriid"/> -->
			<!-- <parameter name="@statusiid" value="#cmbStatus"/> -->
			<!-- <parameter name="@napomena" value="#txtNapomena"/> -->
			<!-- </data> -->
			<data command="spNab_ZahGla_Zakljuci" name="dtVrati">
				<parameter name="@id" value="$NabZahGlaId"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@statusiid" value="#cmbStatus"/>
				<parameter name="@napomena" value="#txtNapomena"/>
			</data>
		</datalist>
	</form>
</root>