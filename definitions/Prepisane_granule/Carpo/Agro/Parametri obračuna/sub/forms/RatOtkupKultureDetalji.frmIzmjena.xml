<root>
<form name="frmIzmjena" caption="$Naslov" width="1024">
<event type="init">
    <action type="datarun reader" value="~dtGet" />
</event>
<event type="shown">
    <action type="control focus" value="#txtStdVlaga"/>
</event>
<layout>
    <group rows="2" cols="1">
        <!--Osnovni podaci-->
        <group rows="2" cols="5" row="1" col="1" caption="Osnovni podaci" spacing="0,0,0,5">
            <item row="1" col="1" caption="Godina:">
                <textedit name="txtGodina" format="\d{4}" formattype="regex" required="true" datavalue="~dtGet.@Godina" />
            </item>
            <item row="1" col="2" caption="Kultura: " colspan="2" required="true">
                <comboedit name="cmbKulture" dataname="~dtKulture" valuefield="KultureId" displayfield="Naziv" datavalue="~dtGet.@KultureId" required="true">
                    <event type="valuechanged">
                        <action type="control populate" value="#cmbTroskovi" />
                    </event>
                </comboedit>
            </item>
            <item row="1" col="4" caption="Otkupno mjesto: " colspan="2">
                <comboedit name="cmbOtkupnoMjesto" dataname="~dtOtkupnoMjesto" valuefield="OtkupMjId" displayfield="Naziv" datavalue="~dtGet.@OtkupMjId" />
            </item>
            <item row="2" col="1" caption="Oznaka:" required="true">
                <textedit name="txtOznaka" required="true" datavalue="~dtGet.@Oznaka" />
            </item>
            <item row="2" col="2" caption="Naziv:" colspan="2" required="true">
                <textedit name="txtNaziv" required="true" datavalue="~dtGet.@Naziv" />
            </item>
            <item row="2" col="4" caption="Cjenik:" colspan="2">
                <comboedit name="cmbOtkupCjenik" dataname="~dtCjenici" valuefield="OtkupCjenikGlaId" displayfield="Naziv" datavalue="~dtGet.OtkupCjenikGlaId" /> 
            </item>
        </group>
        <!--Parametri-->
        <group rows="1" cols="2" row="2" col="1" caption="Parametri" groupbordervisible="true">
            <columnsdefinition>
                <column position="1" size="50%" />
                <column position="2" size="50%"  />
            </columnsdefinition>
            <!--TABS-->
            <tabs row="1" col="1" padding="4">
                <!--Standardni parametri-->
                <group caption="Standardni" name="tabStandardni" col="1" row="1" cols="2" rows="5">
                    <item row="1" col="1" caption="Vlaga:">
                        <textedit name="txtStdVlaga" format="n2" datavalue="~dtGet.@Standard1" required="true" />
                    </item>
                    <item row="1" col="2" caption="Primjesa:">
                        <textedit name="txtStdPrimjesa" format="n2" datavalue="~dtGet.@Standard2" required="true" />
                    </item>
                    <item row="2" col="1" caption="Hektolitar:">
                        <textedit name="txtStdHektolitar" format="n2" datavalue="~dtGet.@Standard3" />
                    </item>
                    <item row="2" col="2" caption="Ulje:">
                        <textedit name="txtStdUlje" format="n2" datavalue="~dtGet.@ulje" />
                    </item>
                    <item row="3" col="1" caption="Lom:">
                        <textedit name="txtStdLom" format="n2" datavalue="~dtGet.@lom" />
                    </item>
                    <item row="3" col="2" caption="Defekt:">
                        <textedit name="txtStdDefekt" format="n2" datavalue="~dtGet.@defekt"/>
                    </item>
                    <item row="4" col="1" caption="Protein:">
                        <textedit name="txtStdProtein" format="n2" datavalue="~dtGet.@ProteinStd"/>
                    </item>
                    <item row="4" col="2" caption="Gluten:">
                        <textedit name="txtStdGluten" format="n2" datavalue="~dtGet.@GlutenStd"/>
                    </item>
                </group>
                <!--Dodatni parametri-->
                <group caption="Dodatni" name="tabDodatni" col="1" row="1" cols="2" rows="5">
                    <item row="1" col="1" caption="Cijena:">
                        <textedit name="txtCijena" format="n2" datavalue="~dtGet.@Cijena" />
                    </item>
                    <item row="1" col="2" caption="Koeficijent:">
                        <textedit name="txtKoeficijent" format="n2" datavalue="~dtGet.@koeficijent"/>
                    </item>
                    <item row="2" col="1" caption="Ulazni kalo:">
                        <textedit name="txtUlazniKalo" format="n2" datavalue="~dtGet.@ulaznikalo" />
                    </item>
                    <item row="2" col="2" caption="Izlazni kalo:">
                        <textedit name="txtIzlazniKalo" format="n2" datavalue="~dtGet.@izlaznikalo" />
                    </item>
                    <item row="3" col="1" caption="Kalo sušenja:">
                        <textedit name="txtKaloSusenja" format="n2" datavalue="~dtGet.@KaloSusenja" />
                    </item>
                </group>
            </tabs>
            <group row="1" col="2" rows="3" cols="3">
            <rowsdefinition>
                <row position="1" size="48"/>
                <row position="2" size="48"/>
            </rowsdefinition>
            <columnsdefinition>
                <column position="3" size="70" />
            </columnsdefinition>
                <item row="1" col="1" caption="Troškovi:" colspan="2" >
                    <comboedit name="cmbTroskovi" dataname="~dtDajTroskove" valuefield="OtkupTrosakGlaId" displayfield="Naziv" /> 
                </item>
                <item row="1" col="3">
                    <button name="btnUnos" caption="Dodaj">
                        <event type="click">
                            <action type="datarun reader" value="~dtInsert"/>
                            <action type="control populate" value="#grdTroskovi" />
                            <action type="control populate" value="#cmbTroskovi" />
                            <action type="control focus" value="#cmbTroskovi"/>
                        </event>
                    </button>
                </item>
                <item row="2" col="1" rowspan="2" colspan="2">
                    <grid name="grdTroskovi" key="OtkupTrosakGlaId" dataname="~dtTroskovi" autopopulate="true" showgrouppanel="false">
                        
                    </grid>
                </item>
                <item row="2" col="3">
                    <button name="btnObrisi" caption="Obriši">
                        <event type="click">
                            <action type="message" value="Obrisati trošak iz parametara obračuna?" />
                            <action type="datarun nonquery" value="~dtObrisi"/>
                            <action type="control populate" value="#cmbTroskovi" />
                            <action type="control populate" value="#grdTroskovi" />
                            <action type="control focus" value="#cmbTroskovi"/>
                        </event>
                    </button>
                </item>
            </group>
        </group>
    </group>
</layout>
<panelbuttons>
    <buttons>
        <button name="btnSpremi" caption="Spremi">
            <event type="click">
                <action type="validate" />
                <action type="datarun nonquery" value="~dtUpdate" />
                <action type="control populate" value="parent.#grdMaster" />
                <action type="form close" />
            </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
    </buttons>
</panelbuttons>
<datalist>
    <data command="spKultureDetalji" name="dtGet">
        <parameter name="@Action" value="4" />
        <parameter name="@KulturedetaljiId" value="$KultureDetaljiId" />
    </data>
    <data command="spRatOtkup_Controls" name="dtKulture">
        <parameter name="@Action" value="Kulture" />  
    </data>
    <data command="spRatOtkup_Controls" name="dtOtkupnoMjesto">
        <parameter name="@Action" value="OtkupnoMjesto" />  
    </data>
    <data command="spKultureDetalji" name="dtUpdate">
        <parameter name="@Action" value="3" />
        <parameter name="@KultureDetaljiId" value="$KultureDetaljiId" />
        <parameter name="@KultureId" value="#cmbKulture" />
        <parameter name="@Godina" value="#txtGodina" />
        <parameter name="@Cijena" value="#txtCijena" />
        <parameter name="@VlagaStd" value="#txtStdVlaga" />
        <parameter name="@PrimjeseStd" value="#txtStdPrimjesa" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@OtkupMjId" value="#cmbOtkupnoMjesto" />
        <parameter name="@UljeStd" value="#txtStdUlje" />
        <parameter name="@UlazniKalo" value="#txtUlazniKalo" />
        <parameter name="@IzlazniKalo" value="#txtIzlazniKalo" />
        <parameter name="@LomStd" value="#txtStdLom" />
        <parameter name="@DefektStd" value="#txtStdDefekt" />
        <parameter name="@HektolitarStd" value="#txtStdHektolitar" />
        <parameter name="@OtkupCjenikGlaId" value="#cmbOtkupCjenik" />
    </data>
    <data command="spKultureDetalji_Povezivanje" name="dtCjenici">
        <parameter name="@Action" value="1" />
        <parameter name="@KultureId" value="#cmbKulture" />
    </data>
    <data command="spKultureDetalji_Povezivanje" name="dtTroskovi">
        <parameter name="@Action" value="4" />  
        <parameter name="@KultureDetaljiId" value="$KultureDetaljiId" />
    </data>
    <data command="spKultureDetalji_Povezivanje" name="dtDajTroskove">
      <parameter name="@Action" value="2" />
      <parameter name="@KultureId" value="#cmbKulture" />
      <parameter name="@KultureDetaljiId" value="$KultureDetaljiId" />
    </data>
    <data command="spKultureDetalji_Povezivanje" name="dtInsert">
      <parameter name="@Action" value="3" />
      <parameter name="@KultureDetaljiId" value="$KultureDetaljiId" />
      <parameter name="@OtkupTrosakGlaId" value="#cmbTroskovi" />
    </data>
    <data command="spKultureDetalji_Povezivanje" name="dtObrisi">
      <parameter name="@Action" value="5" />
      <parameter name="@LnKultureDetaljiOtkupTrosakGlaId" value="#grdTroskovi.@LnKultureDetaljiOtkupTrosakGlaId" />
    </data>
</datalist>
</form>
</root>