<root>

<!-- 
OPIS: Granula za dodavanje i izmjenu otkupnih mjesta.
Autor: Hrvoje Markutović
Verzija: 1.0
Izmjene: 
	10.10.2023. - (v 1.0) Početno postavljanje. Hrvoje Markutović PT 62420
-->

	<!-- ================================================================================== -->
	<!-- MASTER FORM -->
	<!-- ================================================================================== -->
	<form name="frmMaster" type="master" caption="Otkupna mjesta">
		<managerlayout>
			<!-- ************MASTER GRID***************** -->
			<grid name="grdMaster" type="master" caption="Otkupno mjesto" dataname="~dtGrdOtkupnoMjesto" bestfitonrefresh="true" key="OtkupmjId">
				<!-- <fields> -->
					<!-- <field> -->
					<!-- </field> -->
				<!-- </fields> -->
			</grid>
			<!-- *************DETAIL GRID******************** -->
			<!-- <grid name="grdDetail" caption="" dataname="~"> -->
			<!-- </grid> -->
		</managerlayout>
		<panelbuttons>
			<buttons>
				<!-- ***************INSERT BUTTON************ -->
				<button name="btnInsert" caption="Unesi">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<action type="form open" value="frmAdd">
							<parameter name="VarIns" value=""/>
						</action>
					</event>
				</button>
				<!-- *******************BUTTON FOR EDIT************** -->
				<button name="btnEdit" caption="Izmijeni">
					<menuitem control="#grdMaster"/>
                    <event type="click">
                        <action type="form open" value="frmEdit">
                            <parameter name="VarEdit" value="#grdMaster.@OtkupmjId"/>
                        </action>
                    </event>
                </button>
				<!-- ***********************DELETE BUTTON**************** -->
				<button name="btnDelete" caption="Obriši">
                    <menuitem control="#grdMaster"/>
                    <event type="click">
                        <action type="confirm" value="Želite li obrisati?" caption="Brisanje">
                            <action type="datarun nonquery" value="~dtDelete"/>
                            <action type="control populate" value="#grdMaster"/>
                        </action>
                    </event>
                </button>		
				<!-- ***************Skladiste BUTTON************ -->
				<button name="btnSkladiste" caption="Skladište">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<action type="form open" value="frmSkladiste">
							<parameter name="VarIns" value="#grdMaster.@OtkupmjId"/>
						</action>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<!-- =============STORE===================== -->
		<datalist>
			<data command="spRatOtkupnoMjesto" name="dtGrdOtkupnoMjesto">
				<parameter name="@Action" value="1"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtDelete">
				<parameter name="@Action" value="5"/>
				<parameter name="@OtkupMjId" value="#grdMaster.@OtkupmjId"/>
			</data>
		</datalist>
	</form>
	<!-- ================================================================================== -->
	<!-- FORMA ZA UNOS-->
	<!-- ================================================================================== -->
	<form name="frmAdd" caption="Novi unos" width="450">
		<layout>
			<group rows="7" cols="2">
				<item row="1" col="1" caption="Naziv:" colspan="2">
					<textedit name="txtNaziv" required="true" maxlength=""/>
				</item>
				<item row="2" col="1" caption="Skladište:" colspan="2">
					<comboedit name="cmbSkladiste" dataname="~dtCmbSkladiste" displayfield="Naziv" valuefield="SkladisteId">
					</comboedit>
				</item>
				<item row="3" col="1" caption="Indikator vage" colspan="2">
					<checkedit name="chkIndVage" checked="true" value="1" caption="Indikator vage:"/>
				</item>
				<item row="4" col="1" caption="Oznaka" colspan="2">
					<textedit name="txtOznaka" required="true" maxlength="2"/>
				</item>
				<item row="5" col="1" caption="Kontrolna kuća" colspan="2">
					<searchedit name="srcKontKuca" dataname="~dtSrcKontKuca" fieldvalue="PartneriId" fieldtext="NazivId" netgenfields="true" datavalue="" datatext=""/>
				</item>
				<item row="6" col="1" caption="Mjesto" colspan="2">
					<comboedit name="cmbMjesto" dataname="~dtCmbMjesta" displayfield="Naziv" valuefield="MjestaId"/>
				</item>
				<item row="7" col="1" caption="Klasa partnera" colspan="2">
					<comboedit name="cmbKlPartner" dataname="~dtCmbKlasaPartner" displayfield="Naziv" valuefield="KlPartneriID"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun reader" value="~dtUnos"/>
						<action type="control populate" value="parent.#grdMaster">
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="$OtkupMjIdKey" type="int"/>
							</action>
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spRatOtkupnoMjesto" name="dtCmbSkladiste">
				<parameter name="@Action" value="7"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtCmbKlasaPartner">
				<parameter name="@Action" value="8"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtCmbMjesta">
				<parameter name="@Action" value="9"/>
			</data>
			<data command="spTraziPartneri" name="dtSrcKontKuca">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcKontKuca.text"/>
			</data>
			<data command="spTraziPartneri" name="dtSrcKontKuca">
				<parameter name="@Action" value="Partneri"/>
				<parameter name="@Uvjet" value="#srcKontKuca.text"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtUnos">
				<parameter name="@Action" value="3"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste"/>
				<parameter name="@IndVage" value="#chkIndVage"/>
				<parameter name="@Oznaka" value="#txtOznaka"/>
				<parameter name="@KontrolnaKucaId" value="#srcKontKuca"/>
				<parameter name="@MjestaId" value="#cmbMjesto"/>
				<parameter name="@KlPartneriId" value="#cmbKlPartner"/>
				<parameter name="@OtkupMjIdKey.output.int"/>
			</data>
		</datalist>
	</form>
	<!-- ================================================================================== -->
	<!-- FORMA ZA IZMJENU-->
	<!-- ================================================================================== -->
	<form name="frmEdit" caption="Izmjena otkupnog mjesta" width="450">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<layout>
			<group rows="7" cols="2">
				<item row="1" col="1" caption="Naziv:" colspan="2">
					<textedit name="txtNaziv" required="true" datavalue="~dtGet.@Naziv"/>
				</item>
				<item row="2" col="1" caption="Skladište:" colspan="2">
					<comboedit name="cmbSkladiste" dataname="~dtCmbSkladiste" displayfield="Naziv" valuefield="SkladisteId" datavalue="~dtGet.@SkladisteId"/>
				</item>
				<item row="3" col="1" caption="Indikator vage" colspan="2">
					<checkedit name="chkIndVage" checked="true" caption="Indikator vage:" datavalue="~dtGet.@IndVage"/>
				</item>
				<item row="4" col="1" caption="Oznaka" colspan="2">
					<textedit name="txtOznaka" required="true" maxlength="2" datavalue="~dtGet.@Oznaka"/>
				</item>
				<item row="5" col="1" caption="Kontrolna kuća" colspan="2">
					<searchedit name="srcKontKuca" dataname="~dtSrcKontKuca" fieldvalue="PartneriId" fieldtext="NazivId" netgenfields="true" datavalue="~dtGet.@SkladisteId" datatext="~dtGet.@Kontrolnakuca"/>
				</item>
				<item row="6" col="1" caption="Mjesto" colspan="2">
					<comboedit name="cmbMjesto" dataname="~dtCmbMjesta" displayfield="Naziv" valuefield="MjestaId" datavalue="~dtGet.@mjestaid"/>
				</item>
				<item row="7" col="1" caption="Klasa partnera" colspan="2">
					<comboedit name="cmbKlPartner" dataname="~dtCmbKlasaPartner" displayfield="Naziv" valuefield="KlPartneriID" datavalue="~dtGet.@KlPartneriId"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun reader" value="~dtUnos"/>
						<action type="control populate keepfocus" value="parent.#grdMaster"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spRatOtkupnoMjesto" name="dtCmbSkladiste">
				<parameter name="@Action" value="7"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtCmbKlasaPartner">
				<parameter name="@Action" value="8"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtCmbMjesta">
				<parameter name="@Action" value="9"/>
			</data>
			<data command="spTraziPartneri" name="dtSrcKontKuca">
				<parameter name="@Action" value="Partneri"/>
				<parameter name="@Uvjet" value="#srcKontKuca.text"/>
			</data>
			<data command="spTraziPartneri" name="dtSrcKontKuca">
				<parameter name="@Action" value="Partneri"/>
				<parameter name="@Uvjet" value="#srcKontKuca.text"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtUnos">
				<parameter name="@Action" value="4"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste"/>
				<parameter name="@IndVage" value="#chkIndVage"/>
				<parameter name="@Oznaka" value="#txtOznaka"/>
				<parameter name="@KontrolnaKucaId" value="#srcKontKuca"/>
				<parameter name="@MjestaId" value="#cmbMjesto"/>
				<parameter name="@KlPartneriId" value="#cmbKlPartner"/>
				<parameter name="@OtkupMjId" value="$VarEdit"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtGet">
				<parameter name="@Action" value="2"/>
				<parameter name="@OtkupMjId" value="$VarEdit"/>
			</data>
		</datalist>
	</form>
	<!-- ================================================================================== -->
	<!-- FORMA SKLADIŠTA-->
	<!-- ================================================================================== -->
	<form name="frmSkladiste" caption="Povezivanje skladišta">
		<layout>
			<group rows="2" cols="3">
				<item row="1" col="1" caption="Skladište:" >
					<comboedit name="cmbSkladiste" dataname="~dtCmbSkladiste" displayfield="Naziv" valuefield="SkladisteId"/>
				</item>
				<item row="1" col="2">
					<button name="btnSpremi" caption="Dodaj">
						<event type="click">
							<action type="validate" />
							<action type="datarun reader" value="~dtDodaj"/>
							<action type="control populate" value="#grdSkladista"/>
							<action type="control populate" value="#cmbSkladiste"/>
							<action type="control populate" value="parent.#grdMaster"/>
						</event>
					</button>
				</item>
				<item row="1" col="3">
					<button name="btnOtpovezi" caption="Otpoveži">
						<event type="click">
							<action type="validate" />
							<action type="datarun reader" value="~dtUkloni"/>
							<action type="control populate" value="#grdSkladista"/>
							<action type="control populate" value="#cmbSkladiste"/>
							<action type="control populate" value="parent.#grdMaster"/>
						</event>
					</button>
				</item>
				<item row="2" col="1" colspan="3">
					<grid name="grdSkladista" caption="Skladišta" dataname="~dtGrdSkladista" key="lnSklOtkupId" autopopulate="true" bestfitonrefresh="true">
						<!-- <fields> -->
							<!-- <field> -->
							<!-- </field> -->
						<!-- </fields> -->
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<!-- =============STORE===================== -->
		<datalist>
			<data command="spRatOtkupnoMjesto" name="dtGrdSkladista">
				<parameter name="@Action" value="10"/>
				<parameter name="@OtkupMjId" value="$VarIns"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtCmbSkladiste">
				<parameter name="@Action" value="11"/>
				<parameter name="@OtkupMjId" value="$VarIns"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtDodaj">
				<parameter name="@Action" value="12"/>
				<parameter name="@OtkupMjId" value="$VarIns"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste"/>
			</data>
			<data command="spRatOtkupnoMjesto" name="dtUkloni">
				<parameter name="@Action" value="13"/>
				<parameter name="@lnSklOtkupId" value="#grdSkladista.@lnSklOtkupId"/>
			</data>
		</datalist>
	</form>
</root>