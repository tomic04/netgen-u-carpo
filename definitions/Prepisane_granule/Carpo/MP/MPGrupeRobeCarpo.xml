<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1" loglevel="0">

	<form name="frmMaster" type="master" caption="Grupe robe" maximized="true">

		<event type="init">
			<action type="variable value">
				<parameter name="MPTipkovnicaPredlozakID" value="0" type="int"/>
				<parameter name="nivo" value="1" type="int"/>
			</action>

		</event>

		<event type="load">
			<action type="control value" value="lbNivo">
				<parameter value="Nivo: {$nivo}" />
			</action>
			<action type="control disable" value="#btnStore" if="#grdGrupe.rowcount==0"/>
			<action type="menu disable" value="#menDodaj" if="#grdGrupe.rowcount==0"/>
		</event>

		<event type="shown">
			<action type="form open" value="frmSearch">
			</action>
			<action type="control populate" value="#grdGrupe"/>
		</event>

		<layout textposition="top" itemspadding="3">
			<group rows="2" cols="1">
				<group row="1" col="1" rows="1" cols="2">
					<item row="1" col="1" caption="Grupe" textposition="top">
						<grid name="grdGrupe" dataname="dtGrupe" netgenfields="true" keyfield="MPGrupeRobeid" bestfitonrefresh="true">
							<event type="focusedrowchanged">
								<action type="control populate" value="#grdRoba"/>
								<action type="control disable" value="#btnStore" if="#grdGrupe.rowcount==0"/>
								<action type="control enable" value="#btnStore" else=""/>
								<action type="menu disable" value="#menDodaj" if="#grdGrupe.rowcount==0"/>
								<action type="menu enable" value="#menDodaj" else=""/>
							</event>
							<fields>
								<field name="Predložak1200" editable=""/>
								<field name="Oznaka grupe0700" editable=""/>
								<field name="Naziv grupe2500" editable=""/>
							</fields>
						</grid>
					</item>
					<item row="1" col="2" caption="Roba" textposition="top">
						<grid name="grdRoba" dataname="dtRoba" netgenfields="true" keyfield="RedId" bestfitonrefresh="true">
							<event type="doubleclick">
								<action type="message" value="'Molimo odaberite grupu'" if="#grdGrupe.@MPGrupeRobeid=='null'" >
								</action>
								<action else="" stop="true">
								</action>
								<action type="message" value="'Molimo odaberite jedan od stupaca količine'" if="#grdRoba.focusedfield=='Red0500'" >
								</action>
								<action type="form open" value="frmDodajRobu" else="">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdGrupe.@MPTipkovnicaPredlozakID"/>
									<parameter name="MPGrupeRobeid" value="#grdGrupe.@MPGrupeRobeid"/>
									<parameter name="RedId" value="#grdRoba.@RedId"/>
									<parameter name="Kolona" value="#grdRoba.focusedfield"/>
									<parameter name="Nivo" value="$nivo"/>
								</action>
							</event>
							<menu>
								<menuitem name="menDodaj" caption="Dodaj robu" sort="1">
									<event type="click">
										<action type="message" value="'Molimo odaberite grupu'" if="#grdGrupe.@MPGrupeRobeid=='null'" >
										</action>
										<action type="message" value="'Molimo odaberite jedan od stupaca količine'" if="#grdRoba.focusedfield=='Red0500'" >
										</action>
										<action type="form open" value="frmDodajRobu" else="">
											<parameter name="MPTipkovnicaPredlozakId" value="#grdGrupe.@MPTipkovnicaPredlozakID"/>
											<parameter name="MPGrupeRobeid" value="#grdGrupe.@MPGrupeRobeid"/>
											<parameter name="RedId" value="#grdRoba.@RedId"/>
											<parameter name="Kolona" value="#grdRoba.focusedfield"/>
											<parameter name="Nivo" value="$nivo"/>
										</action>
										<action type="control refreshvalue" value="#grdRoba"/>
									</event>
								</menuitem>
							</menu>
							<fields>
								<field name="Red0500" editable="" />
								<field name="Kolona1 2500" editable="" />
								<field name="Kolona2 2500" editable="" />
								<field name="Kolona3 2500" editable="" />
								<field name="Kolona4 2500" editable="" />
							</fields>
						</grid>
					</item>
					<columnsdefinition>
						<column position="1" size="30%"/>
						<column position="2" size="70%"/>
					</columnsdefinition>
				</group>
				<group row="2" col="1" rows="1" cols="10">
					<item row="1" col="1">
						<button name="btnSearch" caption="Parametri" image="search" fontsizedelta="12" tooltip="Pretraživanje">
							<event type="click">
								<action type="form open" value="frmSearch">
								</action>
								<action type="control populate" value="#grdGrupe"/>
							</event>
						</button>
					</item>
					<item row="1" col="2">
						<button name="btnTemplate" caption="Predložak" image="edit" fontsizedelta="12" tooltip="Ažuriranje parametra">
							<event type="click">
								<action type="form open" value="frmPredlozak">
								</action>
							</event>
						</button>
					</item>
					<item row="1" col="3">
						<button name="btnStore" caption="Povezane trgovine" image="home" fontsizedelta="12">
							<event type="click">
								<action type="form open" value="frmPovezane">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdGrupe.@MPTipkovnicaPredlozakID"/>
								</action>
							</event>
						</button>
					</item>
					<item row="1" col="5">
						<button name="btnFirst" caption="" image="leftbegin" imagelocation="middlecenter">
							<event type="click">
								<action type="variable value">
									<parameter name="$nivo" value="1" type="int"/>
								</action>
								<action type="control value" value="lbNivo">
									<parameter value="Nivo: {$nivo}" />
								</action>
								<action type="control populate" value="#grdRoba"/>
							</event>
						</button>
					</item>
					<item row="1" col="6">
						<button name="btnLeft" caption="" image="left" imagelocation="middlecenter">
							<event type="click">

								<action type="datarun scalar" value="~dtSmanji" if="$nivo&gt;1">
									<parameter name="$nivo" value="~dtSmanji.@nivo"/>
								</action>
								<action type="control value" value="lbNivo">
									<parameter value="Nivo: {$nivo}" />
								</action>
								<action type="control populate" value="#grdRoba"/>
							</event>
						</button>
					</item>
					<item row="1" col="7" >
						<labeledit name="lbNivo" value="" fontbold="true" fontsizedelta="16"  textposition="center"  datavalue="">
						</labeledit>
					</item>
					<item row="1" col="8">
						<button name="btnRight" caption="" image="right" imagelocation="middlecenter">
							<event type="click">

								<action type="datarun scalar" value="~dtPovecaj" if="$nivo&lt;10">
									<parameter name="$nivo" value="~dtPovecaj.@nivo"/>
								</action>
								<action type="control value" value="lbNivo">
									<parameter value="Nivo: {$nivo}" />
								</action>
								<action type="control populate" value="#grdRoba"/>
							</event>
						</button>
					</item>
					<item row="1" col="9">
						<button name="btnLast" caption="" image="rightend" imagelocation="middlecenter">
							<event type="click">
								<action type="variable value">
									<parameter name="$nivo" value="10" type="int"/>
								</action>
								<action type="control value" value="lbNivo">
									<parameter value="Nivo: {$nivo}" />
								</action>
								<action type="control populate" value="#grdRoba"/>
							</event>
						</button>
					</item>
					<columnsdefinition>
						<column position="1" size="200"/>
						<column position="2" size="200"/>
						<column position="3" size="200"/>
						<column position="4" size="100%"/>
						<column position="5" size="100"/>
						<column position="6" size="100"/>
						<column position="7" size="200"/>
						<column position="8" size="100"/>
						<column position="9" size="100"/>
						<column position="10" size="400"/>
					</columnsdefinition>
				</group>
				<rowsdefinition>
					<row position="1" size="100%"/>
					<row position="2" size="100"/>
				</rowsdefinition>
			</group>
		</layout>

		<datalist>
			<data command="spMPGrupeRobeQuerry"  name="dtGrupe">
				<parameter name="@action" value="1" />
				<parameter name="@MPTipkovnicaPredlozakID" value="$MPTipkovnicaPredlozakID" />
			</data> 
			<data command="spMPGrupeRobeQuerry"  name="dtRoba">
				<parameter name="@action" value="11" />
				<parameter name="@MPTipkovnicaPredlozakID" value="#grdGrupe.@MPTipkovnicaPredlozakID" />
				<parameter name="@MPGrupeRobeid" value="#grdGrupe.@MPGrupeRobeid" />
				<parameter name="@trgovinaid" value="" />
				<parameter name="@nivo" value="$nivo" />
			</data> 
			<data command="select (@nivo - 1) as nivo"  type="text" name="dtSmanji">
				<parameter name="@nivo" value="$nivo" />
			</data> 
			<data command="select (@nivo + 1) as nivo"  type="text"  name="dtPovecaj">
				<parameter name="@nivo" value="$nivo" />
			</data> 
		</datalist>

	</form>

	<form name="frmSearch" caption="Parametri">
		<event type="init">
		</event>
		<event type="load">
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="3" cols="3">
				<item row="2" col="2" caption="Predložak" textposition="left">
					<comboedit name="cmbPredlozak" displayfield="Naziv" valuefield="MPTipkovnicaPredlozakID" dataname="~dtPredlozak" savevalue="session">
					</comboedit>
				</item>
				<columnsdefinition>
					<column position="1" size="50%"/>
					<column position="2" size="400"/>
					<column position="3" size="50%"/>
				</columnsdefinition>
				<rowsdefinition>
					<row position="1" size="50%"/>
					<row position="3" size="50%"/>
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnShow" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="parent.$MPTipkovnicaPredlozakID" value="#cmbPredlozak" />
						</action>
						<action type="form close" />

					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="select MPTipkovnicaPredlozakID, naziv from MPTipkovnicaPredlozak"  type="text" name="dtPredlozak">
			</data> 
		</datalist>
	</form>

	<form name="frmPredlozak" caption="Ažuriranje predloška">
		<event type="init">
		</event>
		<event type="load">
			<action type="control populate" value="#grdPredlozak"/>
			<action type="control populate" value="#grdGrupa"/>
			<action type="control disable" value="#btn2" if="#grdPredlozak=='null'"/>
			<action type="control disable" value="#btn3" if="#grdPredlozak=='null'"/>
			<action type="control disable" value="#btn4" if="#grdPredlozak=='null'"/>
			<action type="control disable" value="#btn6" if="#grdPredlozak=='null'"/>
			<action type="control disable" value="#btn7" if="#grdGrupa=='null'"/>
			<action type="control disable" value="#btn8" if="#grdGrupa=='null'"/>
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="4" cols="3">
				<group row="1" col="1" rows="1" cols="1">
					<item row="1" col="1">
						<grid name="grdPredlozak" dataname="dtPredlozci" netgenfields="true" keyfield="MPTipkovnicaPredlozakId" bestfitonrefresh="true">
							<event type="focusedrowchanged">
								<action type="control populate" value="#grdGrupa"/>
								<action type="control disable" value="#btn2" if="#grdPredlozak=='null'"/>
								<action type="control enable" value="#btn2" else=""/>
								<action type="control disable" value="#btn3" if="#grdPredlozak=='null'"/>
								<action type="control enable" value="#btn3" else=""/>
								<action type="control disable" value="#btn4" if="#grdPredlozak=='null'"/>
								<action type="control enable" value="#btn4" else=""/>
								<action type="control disable" value="#btn6" if="#grdPredlozak=='null'"/>
								<action type="control enable" value="#btn6" else=""/>
								<action type="control disable" value="#btn7" if="#grdGrupa=='null'"/>
								<action type="control enable" value="#btn7" else=""/>
								<action type="control disable" value="#btn8" if="#grdGrupa=='null'"/>
								<action type="control enable" value="#btn8" else=""/>
							</event>
							<fields>
							</fields>
						</grid>
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="1">
					<item row="1" col="1">
						<grid name="grdGrupa" dataname="dtGrupe" netgenfields="true" keyfield="MPGrupeRobeid" bestfitonrefresh="true">
							<fields>
							</fields>
						</grid>
					</item>
				</group>
				<group row="1" col="2" rows="5" cols="1">
					<item row="1" col="1">
						<button name="btn1" caption="Dodaj predložak" image="add">
							<event type="click">
								<action type="form open" value="frmAddPredlozak">
								</action>
								<action type="control refreshvalue" value="#grdPredlozak"/>
							</event>
						</button>
					</item>
					<item row="2" col="1">
						<button name="btn2" caption="Izmjeni predložak" image="edit">
							<event type="click">
								<action type="form open" value="frmEditPredlozak">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdPredlozak"/>
								</action>
								<action type="control refreshvalue" value="#grdPredlozak"/>
							</event>
						</button>
					</item>
					<item row="3" col="1">
						<button name="btn3" caption="Aktiviraj / Deaktiviraj" image="check">
							<event type="click">
								<action type="confirm" value="Želite li izmjeniti aktivnost na predlošku: {#grdPredlozak.@Naziv2500}?" >
									<action type="datarun nonquery" value="~dtAktivnost">
										<action type="control refreshvalue" value="#grdPredlozak"/>
									</action>
								</action>
							</event>
						</button>
					</item>
					<item row="4" col="1">
						<button name="btn4" caption="Poveži sa trgovinom" image="link">
							<event type="click">
								<action type="form open" value="frmLink">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdPredlozak"/>
								</action>
							</event>
						</button>
					</item>
					<item row="5" col="1">
						<button name="btn5" caption="Kopiraj predložak" image="note">
							<event type="click">
								<action type="form open" value="frmCopy">
								</action>
								<action type="control refreshvalue" value="#grdPredlozak"/>
							</event>
						</button>
					</item>
				</group>
				<group row="3" col="2" rows="5" cols="1">
					<item row="1" col="1">
						<button name="btn6" caption="Dodaj grupu" image="add">
							<event type="click">
								<action type="form open" value="frmAddGrupa">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdPredlozak"/>
								</action>
								<action type="control refreshvalue" value="#grdGrupa"/>
							</event>
						</button>
					</item>
					<item row="2" col="1">
						<button name="btn7" caption="Izmjeni grupu" image="edit">
							<event type="click">
								<action type="form open" value="frmEditGrupa">
									<parameter name="MPTipkovnicaPredlozakId" value="#grdPredlozak"/>
									<parameter name="MPGrupeRobeid" value="#grdGrupa"/>
								</action>
								<action type="control refreshvalue" value="#grdGrupa"/>
							</event>
						</button>
					</item>
					<item row="3" col="1">
						<button name="btn8" caption="Obriši grupu" image="delete">
							<event type="click">
								<action type="confirm" value="Želite li sigurno obrisati grupu: {#grdGrupa.@Naziv grupe3000}?" >
									<action type="datarun nonquery" value="~dtDelGrupe">
										<action type="control refreshvalue" value="#grdGrupa"/>
									</action>
								</action>
							</event>
						</button>
					</item>
					<item row="4" col="1">
					</item>
					<item row="5" col="1">
						<button name="btn9" caption="Zatvori" image="return">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
				<columnsdefinition>
					<column position="1" size="400"/>
					<column position="2" size="200"/>
					<column position="3" size="100%"/>
				</columnsdefinition>
				<rowsdefinition>
					<row position="1" size="400"/>
					<row position="2" size="50"/>
					<row position="3" size="400"/>
					<row position="4" size="100%"/>
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
			</buttons>
		</panelbuttons>
		<datalist>

			<data command="spMPGrupeRobeQuerry"  name="dtPredlozci">
				<parameter name="@action" value="2" />
			</data>
			<data command="spMPGrupeRobeQuerry"  name="dtGrupe">
				<parameter name="@action" value="22" />
				<parameter name="@MPTipkovnicaPredlozakID" value="#grdPredlozak" />
			</data> 
			<data command="spMPGrupeRobeInsert"  name="dtAktivnost">
				<parameter name="@action" value="7" />
				<parameter name="@MPTipkovnicaPredlozakId" value="#grdPredlozak" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data> 
			<data command="spMPGrupeRobeInsert"  name="dtDelGrupe">
				<parameter name="@action" value="22" />
				<parameter name="@MPGrupeRobeid" value="#grdGrupa" />
			</data> 		
		</datalist>
	</form>

	<form name="frmAddPredlozak" caption="Dodavanje novog predloška">
		<event type="init">
		</event>
		<event type="load">
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Naziv predloška" textposition="left">
					<textedit name="txtNaziv">
					</textedit>
				</item>
				<columnsdefinition>
					<column position="1" size="300"/>
					<column position="2" size="100%"/>
				</columnsdefinition>
				<rowsdefinition>
					<row position="2" size="100%"/>
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtAddPredlozak">
						</action>
						<!--neradi--><!--<action type="control populate keepfocus" value="parent.#grdPredlozak"/>-->
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPGrupeRobeInsert"  name="dtAddPredlozak">
				<parameter name="@action" value="5" />
				<parameter name="@NazivPredlozak" value="#txtNaziv" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data> 
		</datalist>
	</form>

	<form name="frmEditPredlozak" caption="Izmjena postojećeg predloška">
		<event type="init">
			<action type="datarun reader" value="~dtPredlozak">
			</action>
		</event>
		<event type="load">
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Naziv predloška" textposition="left">
					<textedit name="txtNaziv" datavalue="~dtPredlozak.@naziv">
					</textedit>
				</item>
				<columnsdefinition>
					<column position="1" size="300"/>
					<column position="2" size="100%"/>
				</columnsdefinition>
				<rowsdefinition>
					<row position="2" size="100%"/>
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnEdit" caption="Izmjeni">
					<event type="click">
						<action type="datarun nonquery" value="~dtEditPredlozak">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="select naziv from MPTipkovnicaPredlozak where MPTipkovnicaPredlozakId = @MPTipkovnicaPredlozakId"  type="text" name="dtPredlozak">
				<parameter name="@MPTipkovnicaPredlozakId" value="$MPTipkovnicaPredlozakId" />
			</data> 
			<data command="spMPGrupeRobeInsert"  name="dtEditPredlozak">
				<parameter name="@action" value="6" />
				<parameter name="@MPTipkovnicaPredlozakId" value="$MPTipkovnicaPredlozakId" />
				<parameter name="@NazivPredlozak" value="#txtNaziv" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data> 
		</datalist>
	</form>

	<form name="frmLink" caption="Vezanje trgovine sa predloškom">
		<event type="init">
		</event>
		<event type="load">
			<action type="control value" value="cmbPredlozak">
				<parameter value="$MPTipkovnicaPredlozakId" />
			</action>
			<action type="control populate" value="#grdTrgovine">
			</action>
		</event>
		<event type="shown">	
		</event>
		<layout>
			<group rows="4" cols="2">
				<item col="1" row="1" caption="Predložak" textposition="left">
					<comboedit name="cmbPredlozak" displayfield="Naziv" valuefield="MPTipkovnicaPredlozakID" dataname="~dtPredlozak" readonly="true">

					</comboedit>
				</item>
				<item col="1" row="2" caption="Regija" textposition="left">
