	<form name="frmDodajRobu" caption="Ažuriranje robe">
		<event type="init">
			<action type="datarun scalar" value="~dtkolonanaziv">
				<parameter name="$kolona" value="~dtkolonanaziv.@kolona"/>
			</action>
			<action type="datarun reader" value="~dtGrupa">
			</action>
			<action type="datarun reader" value="~dtDohvati">
			</action>
		</event>
		<event type="load">
			<action type="control value" value="cmbPredlozak">
				<parameter value="$MPTipkovnicaPredlozakId" />
			</action>
			<action type="control value" value="txtRed">
				<parameter value="$RedId" />
			</action>
			<action type="control value" value="txtKol">
				<parameter value="$kolona" />
			</action>
			<action type="control value" value="txtNivo">
				<parameter value="$nivo" />
			</action>
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="7" cols="4">
				<item col="1" row="1"  colspan="2" caption="Predložak" textposition="left">
					<comboedit name="cmbPredlozak" displayfield="Naziv" valuefield="MPTipkovnicaPredlozakID" dataname="~dtPredlozak" readonly="true">
					</comboedit>
				</item>
				<item col="3" row="1" caption="Grupa" textposition="left">
					<textedit name="txtGrupa" datavalue="~dtGrupa.@naziv" readonly="true">
					</textedit>
				</item>				
				<item col="1" row="2" caption="Red" textposition="left">
					<textedit name="txtRed" datavalue="" readonly="true">
					</textedit>
				</item>				
				<item col="2" row="2" caption="Kolona" textposition="left">
					<textedit name="txtKol" datavalue="" readonly="true">
					</textedit>
				</item>				
				<item col="3" row="2" caption="Nivo" textposition="left">
					<textedit name="txtNivo" datavalue="" readonly="true">
					</textedit>
				</item>
				<item col="1" row="3" colspan="3" caption="Roba" textposition="left">
					<searchedit name="srcRoba"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" datavalue="~dtDohvati.@robaid" datatext="~dtDohvati.@roba" netgenfields="true">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtKontrolaRoba" if="#srcRoba!='null'&amp;&amp;#srcRoba!=999999999"></action>
							<action type="datarun reader" value="~dtTipro" if="#srcRoba!='null'&amp;&amp;#srcRoba!=999999999">
								<action type="control value" value="txtTipk" >
									<parameter value="~dtTipro.@tipro" />
								</action>
							</action>
							<action type="control value" value="txtTipk"  else="">
								<parameter value="" />
							</action>
						</event>
					</searchedit>
				</item>
				<item col="1" row="4" colspan="3" caption="Tipkovnica naziv" textposition="left">
					<textedit name="txtTipk" datavalue="~dtDohvati.tipro">
					</textedit>
				</item>
				<item row="5" col="2" caption="" textposition="">
					<button name="btnColor" caption="Odaberi boju">
						<event type="click">
							<!-- colorpicker()-->
						</event>
					</button>
				</item>
				<item row="5" col="3" caption="" textposition="">
					<textedit name="txtColor" datavalue="">
					</textedit>
				</item>
				<item row="6" col="3" textposition="right">
					<checkedit caption="Makni boju" name="cheNeColor">
					</checkedit>
				</item>
				<columnsdefinition>
					<column position="1" size="150"/>
					<column position="2" size="200"/>
					<column position="3" size="200"/>
					<column position="4" size="100%"/>
				</columnsdefinition>
				<rowsdefinition>
					<row position="7" size="100%"/>
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="Dodaj">
					<event type="click">
						<action type="datarun nonquery" value="~dtDodaj">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="select MPTipkovnicaPredlozakID, naziv from MPTipkovnicaPredlozak"  type="text" name="dtPredlozak">
			</data> 
			<data command="select LEFT(@kolona, LEN(@kolona)-5) as kolona"  type="text" name="dtkolonanaziv">
				<parameter name="@kolona" value="$kolona" />
			</data>
			<data command="select naziv from MPGrupeRobe where MPGrupeRobeID = @MPGrupeRobeID"  type="text" name="dtGrupa">
				<parameter name="@MPGrupeRobeID" value="$MPGrupeRobeID" />
			</data>
			<data command="spMPGrupeRobeQuerry" name="dtDohvati">
				<parameter name="@action" value="3" />
				<parameter name="@trgovinaid" value="" />
				<parameter name="@MPGrupeRobeid" value="$MPGrupeRobeid" />
				<parameter name="@red" value="$RedId" />
				<parameter name="@kolona" value="$kolona" />
				<parameter name="@nivo" value="$nivo" />
			</data> 
			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trgovinaid" value="" />
				<parameter name="@trazi" value="#srcRoba.text" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spmpKontrolaOdabraneRobeNG" name="dtKontrolaRoba">
				<parameter name="@robaid" value="#srcRoba" />
			</data>
			<data command="select case 
				when tipro is null then cast(coalesce(naziv, null) as varchar(30))
				when tipro = '' then cast(coalesce(naziv, null) as varchar(30))
				else tipro end as tipro 
				from roba where robaid=@robaid" type="text" name="dtTipro">
				<parameter name="@robaid" value="#srcRoba" />
			</data>
			<data command="spmpKontrolaOdabraneRobeNG" name="dtDodaj">
				<parameter name="@action" value="3" />
				<parameter name="@MPGrupeRobeid" value="$mpgruperobeid" />
				<parameter name="@red" value="#txtRed" />
				<parameter name="@kolona" value="#txtKol" />
				<parameter name="@nivo" value="#txtNivo" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@trgovinaid" value="" />
				<parameter name="@tipro" value="#txtTipk" />
				<parameter name="@bojaroba" value="#txtColor" />
				<parameter name="@neboja" value="#cheNeColor" />
			</data>

		</datalist>
	</form>

