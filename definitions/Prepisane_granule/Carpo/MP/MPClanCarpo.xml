<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1" loglevel="0">

	<form name="frmMaster" type="master" caption="MP Članovi - ažuriranje">

		<event type="init">
			<action type="variable value">
				<parameter name="Global.ime" value=""/>
				<parameter name="Global.prezime" value=""/>
				<parameter name="Global.sifra" value="0"/>
				<parameter name="Global.trgovinaid" value="0" type="init"/>
				<parameter name="Global.partneriid" value="0" type="init"/>
			</action>
			<action type="form open" value="frmFilter"></action>
		</event>
		<event type="shown">

		</event>
		<event type="load">
		</event>

		<managerlayout>

			<grid name="grdMaster" type="master" netgenfields="true" keyfield="mpclanoviid" dataname="~dtFiltriraj" multiselect="true" showcheckboxes="true">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjeni">
						<parameter name="id" value="#grdMaster.@mpclanoviid"/>
					</action>
				</event>
				<fields>
				</fields>
			</grid>

		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="Filter">
					<event type="click">
						<action type="form open" value="frmFilter"></action>
					</event>
				</button>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodaj"></action>
						<action type="control refreshvalue" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="control foreachrow selected" value="grdMaster">
							<action type="form open" value="frmIzmjeni">
								<parameter name="id" value="#grdMaster.@mpclanoviid"/>
							</action>
						</action>
						<action type="control refreshvalue" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnPokazi" caption="Pokaži">
					<event type="click">
						<action type="control foreachrow selected" value="grdMaster">
							<action type="form open" value="frmPokazi">
								<parameter name="id" value="#grdMaster.@mpclanoviid"/>
							</action>
						</action>
						<action type="control refreshvalue" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnStatus" caption="Status">
					<event type="click">
						<action type="control foreachrow selected" value="grdMaster">
							<action type="form open" value="frmStatus">
								<parameter name="id" value="#grdMaster.@mpclanoviid"/>
							</action>
						</action>
						<action type="control refreshvalue" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnPoklon" caption="Poklon">
					<event type="click">
						<action type="control foreachrow selected" value="grdMaster">
							<action type="form open" value="frmPoklon">
								<parameter name="id" value="#grdMaster.@mpclanoviid"/>
							</action>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPClanoviAzurNG" name="dtFiltriraj">
				<parameter name="@action" value="3" />
				<parameter name="@ime" value="Global.$ime" if="Global.$ime!=null"/>
				<parameter name="@prezime" value="Global.$prezime" if="Global.$prezime!=null"/>
				<parameter name="@sifra" value="Global.$sifra" if="Global.$sifra!=null"/>
				<parameter name="@trgovinaid" value="Global.$trgovinaid" if="Global.$trgovinaid!=null"/>
				<parameter name="@partneriid" value="Global.$partneriid" if="Global.$partneriid!=null"/>
			</data>
		</datalist>

	</form>

	<form name="frmFilter" path="frmFilter.xml"/>
	<form name="frmDodaj" path="frmDodaj.xml"/>
	<form name="frmIzmjeni" path="frmIzmjeni.xml"/>
	<form name="frmPokazi" path="frmPokazi.xml"/>
	<form name="frmStatus" path="frmStatus.xml"/>
	<form name="frmKopiraj" path="frmKopiraj.xml"/>
	<form name="frmPoklon" path="frmPoklon.xml"/>
	<form name="frmPoklonDodaj" path="frmPoklonDodaj.xml"/>
	<form name="frmPoklonIzmjeni" path="frmPoklonIzmjeni.xml"/>

</root>