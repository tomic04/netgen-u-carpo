<root>

	<form name="frmMaster" type="master" caption="Zaključak perioda maloprodaje" width="500">
		<event type="init">
			<action type="variable value">
				<parameter name="Global.kontrola" value="0"/>
				<parameter name="Global.anivelacija" value="0"/>
				<parameter name="Global.zakljuci" value="0"/>
				<parameter name="Global.brojnezak" value="0"/>
				<parameter name="Global.brojneskl" value="0"/>
			</action>
		</event>
		<event type="load">
			<action type="control disable" value="#btnShow1, #btnShow2, #btnRestore, #btnAnalyze, #btnControl, #btnNivelation, #btnClose" if="#cmbTrgovina==null"  />
		</event>
		<layout>
			<group rows="4" cols="2" groupbordervisible="false">
				<group row="1" col="1" rows="2" cols="2" caption="Uvjeti:">
					<item row="1" col="1" colspan="2" caption="Trgovina:" textposition="left">
						<comboedit name="cmbTrgovina"  required="true" displayfield="naziv" valuefield="trgovinaid" dataname="~dtTrgovine">
							<event type="valuechanged">
								<action type="datarun scalar" value="~dtDat">
									<parameter name="dan" value="~dtDat.@datumod"/>
								</action>
								<action type="control value" value="datOd">
									<parameter value="$dan" />
								</action>
								<action type="control enable" value="#btnShow1, #btnShow2, #btnRestore, #btnAnalyze, #btnControl" if="#cmbTrgovina!=null"  />
								<action type="control disable" value="#btnShow1, #btnShow2, #btnRestore, #btnAnalyze, #btnControl, #btnNivelation, #btnClose" else=""  />
								<action type="control value" value="txtKnjigaPopisa">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtRoba">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtRazlika">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtNezakljucen">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtNeispravan">
									<parameter value="0" />
								</action>
								<action type="control refreshvalue" value="txtPoruka">
								</action>
								<action type="variable value">
									<parameter name="Global.kontrola" value="0" />
								</action>
								<action type="variable value">
									<parameter name="Global.anivelacija" value="0" />
								</action>
								<action type="variable value">
									<parameter name="Global.zakljuci" value="0" />
								</action>
							</event>
						</comboedit>
					</item>
					<item row="2" col="1" caption="Razdoblje od:" textposition="left">
						<dateedit name="datOd" value="now" readonly="true"></dateedit>
					</item>
					<item row="2" col="2" caption="do:" textposition="left">
						<dateedit name="datDo" value="now">
							<event type="valuechanged">
								<action type="control value" value="txtKnjigaPopisa">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtRoba">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtRazlika">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtNezakljucen">
									<parameter value="0" />
								</action>
								<action type="control value" value="txtNeispravan">
									<parameter value="0" />
								</action>
								<action type="control refreshvalue" value="txtPoruka">
								</action>
								<action type="control disable" value="#btnNivelation, #btnClose"/>
								<action type="variable value">
									<parameter name="Global.kontrola" value="0" />
								</action>
								<action type="variable value">
									<parameter name="Global.anivelacija" value="0" />
								</action>
								<action type="variable value">
									<parameter name="Global.zakljuci" value="0" />
								</action>
							</event>
						</dateedit>
					</item>
				</group>
				<group row="2" col="1" rows="7" cols="2" caption="Status dokumenata i salda">
					<item row="1" col="1" caption="Broj nezaključenih dokumenata:" textposition="left">
						<textedit name="txtNezakljucen" value= "0" format="n0" datavalue="" readonly="true"></textedit>
					</item>
					<item row="2" col="1" caption="Broj neispravnih sk. dokumenata:" textposition="left">
						<textedit name="txtNeispravan" value= "0" format="n0" datavalue="" readonly="true"></textedit>
					</item>
					<item row="3" col="1" caption="Saldo knjige popisa:" textposition="left">
						<textedit name="txtKnjigaPopisa" value= "0" format="n2" datavalue="" readonly="true"></textedit>
					</item>
					<item row="4" col="1" caption="Saldo stanja robe:" textposition="left">
						<textedit name="txtRoba" value= "0" format="n2" datavalue="" readonly="true"></textedit>
					</item>
					<item row="5" col="1" caption="Razlika:" textposition="left">
						<textedit name="txtRazlika" value= "0" format="n2" datavalue="" readonly="true"></textedit>
					</item>
					<item row="6" col="1"/>
					<item row="7" col="1"/>
					<item row="1" col="2">
						<button name="btnShow1" caption="Pokaži">
							<event type="click">
								<action type="form open" value="frmNezakljuceni">
									<parameter name="trgovinaid" value="#cmbTrgovina"/>
									<parameter name="datumod" value="#datOd"/>
									<parameter name="datumdo" value="#datDo"/>
								</action>
							</event>
						</button>
					</item>
					<item row="2" col="2">
						<button name="btnShow2" caption="Pokaži">
							<event type="click">
								<action type="form open" value="frmNeispravni">
									<parameter name="trgovinaid" value="#cmbTrgovina"/>
									<parameter name="datumod" value="#datOd"/>
									<parameter name="datumdo" value="#datDo"/>
								</action>
							</event>
						</button>
					</item>
					<item row="3" col="2"/>
					<item row="4" col="2"/>
					<item row="5" col="2">
						<button name="btnRestore" caption="Obnovi">
							<event type="click">
								<action type="datarun reader" value="~dtZakljucak2">
									<action type="control value" value="txtKnjigaPopisa" if="~dtZakljucak2.@saldokp!=null">
										<parameter value="~dtZakljucak2.@saldokp" />
									</action>
									<action type="control value" value="txtRoba" if="~dtZakljucak2.@saldostanja!=null">
										<parameter value="~dtZakljucak2.@saldostanja" />
									</action>
									<action type="control value" value="txtRazlika" if="~dtZakljucak2.@razlikasalda!=null">
										<parameter value="~dtZakljucak2.@razlikasalda" />
									</action>
								</action>
							</event>
						</button>
					</item>
					<item row="6" col="2">
						<button name="btnAnalyze" caption="Analiza kartica">
							<event type="click">
								<action type="form open" value="frmAnaliza">
									<parameter name="trgovinaid" value="#cmbTrgovina"/>
									<parameter name="trgovina" value="#cmbTrgovina.display"/>
									<parameter name="datumod" value="#datOd"/>
									<parameter name="datumdo" value="#datDo"/>
								</action>
							</event>
						</button>
					</item>
					<item row="7" col="2"/>
					<rowsdefinition>
						<row position="1" size="40" />
						<row position="2" size="40" /> 
						<row position="3" size="40" /> 
						<row position="4" size="40" /> 
						<row position="5" size="40" />
						<row position="6" size="40" />  						
					</rowsdefinition>
				</group>
				<group row="3" col="1" rows="1" cols="1" caption="Status obrade zaključka perioda:">
					<item row="1" col="1">
						<textedit name="txtPoruka" readonly="true">
						</textedit>
					</item>
				</group>
				<group row="4" col="1" rows="1" cols="1" groupbordervisible="false">
					<item row="1" col="1"/>
				</group>
				<item row="1" col="2"/>
				<item row="2" col="2"/>
				<item row="3" col="2"/>
				<item row="4" col="2"/>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnControl" caption="1. Kontrola">	
					<event type="click">
						<action type="control value" value="txtKnjigaPopisa">
							<parameter value="0" />
						</action>
						<action type="control value" value="txtRoba">
							<parameter value="0" />
						</action>
						<action type="control value" value="txtRazlika">
							<parameter value="0" />
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam nezaključene dokumente !" />
						</action>
						<action type="datarun reader" value="~dtNivelacija16">
							<action type="variable value">
								<parameter name="Global.brojnezak" value="~dtNivelacija16.@brojnezak" />
							</action>
						</action>
						<action type="control value" value="txtPoruka" >
							<parameter value="Zaključite nezaključene dokumente !" />
						</action>
						<action type="control value" value="txtNezakljucen" >
							<parameter value="Global.$brojnezak" />
						</action>
						<action type="datarun nonquery" value="~dtPoruka1" if="Global.$brojnezak&gt;0">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam skladišne dokumente !" />
						</action>
						<action type="datarun reader" value="~dtSkladiste">
							<action type="variable value">
								<parameter name="Global.brojneskl" value="~dtSkladiste.@brojneskl" />
							</action>
						</action>
						<action type="control value" value="txtNeispravan" >
							<parameter value="Global.$brojneskl" />
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam duple nivelacije !" />
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Riješite neispravne skladišne dokumente !" />
						</action>
						<action type="datarun nonquery" value="~dtPoruka2" if="Global.$brojneskl&gt;0">
						</action>
						<action type="datarun nonquery" value="~dtNivelacija4" if="Global.$brojnezak==0">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam nepotrebne dokumente !" />
						</action>
						<action type="datarun nonquery" value="~dtNivelacija7" if="Global.$brojnezak==0">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam količine na nivelacijama !" />
						</action>
						<action type="datarun nonquery" value="~dtNivelacija10" if="Global.$brojnezak==0">
						</action>
						<action type="control value" value="txtPoruka" if="Global.$brojnezak==0">
							<parameter value="Kontrola nivelacija završena. Provjerite status dokumenata !" />
						</action>
						<action type="variable value" if="Global.$brojnezak==0">
							<parameter name="Global.kontrola" value="1" />
						</action>
						<action type="control enable" value="#btnNivelation" if="Global.$kontrola==1&amp;&amp;#cmbTrgovina!=null"  />
						<action type="control disable" value="#btnNivelation" else=""  />
					</event>
				</button>
				<button name="btnNivelation" caption="2. A-nivelacija">
					<event type="click">
						<action type="datarun nonquery" value="~dtPoruka3" if="Global.$kontrola==0">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Pripremam podatke za automatske nivelacije !" />
						</action>
						<action type="datarun nonquery" value="~dtZakljucak6">
						</action>
						<action type="datarun nonquery" value="~dtZakljucak7">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Kreiram dokumente automatske nivelacije !" />
						</action>
						<action type="datarun nonquery" value="~dtZakljucak5">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Provjeravam salda !" />
						</action>
						<action type="datarun reader" value="~dtZakljucak2">
							<action type="control value" value="txtKnjigaPopisa" if="~dtZakljucak2.@saldokp!=null">
								<parameter value="~dtZakljucak2.@saldokp" />
							</action>
							<action type="control value" value="txtRoba" if="~dtZakljucak2.@saldostanja!=null">
								<parameter value="~dtZakljucak2.@saldostanja" />
							</action>
							<action type="control value" value="txtRazlika" if="~dtZakljucak2.@razlikasalda!=null">
								<parameter value="~dtZakljucak2.@razlikasalda" />
							</action>
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="A-Nivelacije napravljene. Provjerite razliku salda i nesipravne kartice !" />
						</action>
						<action type="variable value">
							<parameter name="Global.anivelacija" value="1" />
						</action>
						<action type="control enable" value="#btnClose" if="Global.$anivelacija==1&amp;&amp;#cmbTrgovina!=null"  />
						<action type="control disable" value="#btnClose" else=""  />						
					</event>
				</button>
				<button name="btnClose" caption="3. Zaključi">
					<event type="click">
						<action type="datarun nonquery" value="~dtPoruka4" if="Global.$zakljuci==1">
						</action>
						<action type="datarun nonquery" value="~dtStanje">
						</action>
						<action type="datarun nonquery" value="~dtZakljucak1">
						</action>
						<action type="control value" value="txtPoruka">
							<parameter value="Zaključak perioda je napravljen !" />
						</action>
						<action type="variable value">
							<parameter name="Global.zakljuci" value="1" />
						</action>	
					</event>
				</button>
				<button name="btnCancel" dock="right" type="cancel" caption="Odustani">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>			
			<data command="spMPDajTrgovinaNG" name="dtTrgovine">
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="select top 1 datumobrade+1 as datumod from mpobrada where trgovinaid=@trgovinaid order by 1 desc;" type="text" name="dtDat">
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
			</data>
			<data command="spMPStanjeQueryNG" name="dtStanje">
				<parameter name="@action" value="500" />
				<parameter name="@kartica" value="1" />
				<parameter name="@komisija" value="2" />
				<parameter name="@neispravno" value="1" />
				<parameter name="@suma" value="1" />
				<parameter name="@robaid" value="null" />
				<parameter name="@skladisteid" value="$trgovinaid" />
				<parameter name="@datumod" value="$datod" />
				<parameter name="@datumdo" value="$datumdo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spMPZakljucakPeriodaMPNG" name="dtZakljucak1">
				<parameter name="@action" value="1" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spMPZakljucakPeriodaMPNG" name="dtZakljucak2">
				<parameter name="@action" value="2" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
			</data>
			<data command="spMPZakljucakPeriodaMPNG" name="dtZakljucak5">
				<parameter name="@action" value="5" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
			</data>
			<data command="spMPZakljucakPeriodaMPNG" name="dtZakljucak6">
				<parameter name="@action" value="6" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
			</data>
			<data command="spMPZakljucakPeriodaMPNG" name="dtZakljucak7">
				<parameter name="@action" value="7" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
			</data>
			<data command="spMPKontrolaNivelacijaNG" name="dtNivelacija16">
				<parameter name="@action" value="16" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spMPTestMPSKL" name="dtSkladiste">
				<parameter name="@action" value="1" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@broj" value="1" />
			</data>
			<data command="spMPKontrolaNivelacijaNG" name="dtNivelacija4">
				<parameter name="@action" value="4" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spMPKontrolaNivelacijaNG" name="dtNivelacija7">
				<parameter name="@action" value="7" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spMPKontrolaNivelacijaNG" name="dtNivelacija10">
				<parameter name="@action" value="10" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@datumod" value="#datOd" />
				<parameter name="@datumdo" value="#datDo" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="exec spRaiserror 69001, 'Postoje nezaključeni dokumenti !'" type="text" name="dtPoruka1">
			</data>
			<data command="exec spRaiserror 69001, 'Postoje neispravni skladišni dokumenti !'" type="text" name="dtPoruka2">
			</data>
			<data command="exec spRaiserror 69001, 'Niste napravili kontrolu dokumenata !'" type="text" name="dtPoruka3">
			</data>
			<data command="exec spRaiserror 69001, 'Period je već zaključen !'" type="text" name="dtPoruka4">
			</data>
		</datalist>

	</form>

	<form name="frmNezakljuceni" caption="Nezaključeni dokumenti u preiodu od: {$datumod} do {$datumdo}">
		<event type="init">
		</event>
		<event type="load">
			<action type="control populate" value="#grdNezakljuceni"/>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<grid name="grdNezakljuceni" dataname="~dtNezakljuceni" netgenfields="true" keyfield="maloprodajaglaid">
						<fields>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnCancel" dock="right" type="cancel" caption="Zatvori"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPPregNeZakNG" name="dtNezakljuceni">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@trgovinaid" value="$trgovinaid" />
				<parameter name="@datumod" value="$datumod" />
				<parameter name="@datumdo" value="$datumdo" />
				<parameter name="@vrstadokid" value="null" />
			</data>
		</datalist>
	</form>

	<form name="frmNeispravni" caption="Neispravni skladišni dokumenti u periodu od: {$datumod} do {$datumdo}">
		<event type="init">
		</event>
		<event type="load">
			<action type="control populate" value="#grdNeispravni"/>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<grid name="grdNeispravni" dataname="~dtNeispravni" netgenfields="true" keyfield="glaid">
						<fields>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnCancel" dock="right" type="cancel" caption="Zatvori"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPTestMPSKL" name="dtNeispravni">
				<parameter name="@action" value="1" />
				<parameter name="@trgovinaid" value="$trgovinaid" />
				<parameter name="@datumod" value="$datumod" />
				<parameter name="@datumdo" value="$datumdo" />
			</data>
		</datalist>
	</form>

	<form name="frmAnaliza" caption="Analiza kartica trgovine {$trgovina} od: {$datumod} do {$datumdo}">
		<event type="init">
			<action type="datarun scalar" value="~dtPocPeriod">
				<parameter name="datod" value="~dtPocPeriod.@datod"/>
			</action>
		</event>
		<event type="load">
			<action type="control populate" value="#grdAnaliza"/>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<grid name="grdAnaliza" dataname="~dtAnaliza" netgenfields="true" keyfield="robaid">
						<fields>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnCard" caption="Kartica">
					<event type="click">
						<action type="form open" value="frmKartica">
							<parameter name="trgovinaid" value="$trgovinaid"/>
							<parameter name="datumod" value="$datumod"/>
							<parameter name="datumdo" value="$datumdo"/>
							<parameter name="robaid" value="#grdAnaliza.@robaid"/>
						</action>
					</event>
				</button>
				<button name="btnCancel" dock="right" type="cancel" caption="Zatvori"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPStanjeQueryNG" name="dtAnaliza">
				<parameter name="@action" value="500" />
				<parameter name="@kartica" value="1" />
				<parameter name="@komisija" value="2" />
				<parameter name="@neispravno" value="1" />
				<parameter name="@skladisteid" value="$trgovinaid" />
				<parameter name="@datumod" value="$datod" />
				<parameter name="@datumdo" value="$datumdo" />
			</data>
			<data command="select convert(char(4),year(@datumod))+'0101' as datod;" type="text" name="dtPocPeriod">
				<parameter name="@datumod" value="$datumod" />
			</data>
		</datalist>
	</form>

