							<parameter name="mpniveldetid" value="#grdKartica.@mpniveldetid"/>
						</action>
					</event>
				</button>
				<button name="btnCancel" dock="right" type="cancel" caption="Kraj"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPStanjeKarticaNG" name="dtKartica">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@robaid" value="$robaid" />
