<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1" loglevel="0">

	<form name="frmMaster" type="master" caption="Trgovina portal">

		<event type="init">
			<action type="variable value">
				<parameter name="Global.Id" value="0" type="int" />
			</action>
		</event>
		<event type="load">
			<action type="control populate" value="#grdMaster" >
			</action>
			<action type="control disable" value="#btnOperater, #btnVrijeme"/>
		</event>
		<event type="shown">
		</event>

		<managerlayout>

			<grid name="grdMaster" type="master" netgenfields="true" keyfield="trgovinaid" dataname="~dtTrgovine" >

				<event type="focusedrowchanged">
					<action type="control populate" value="#grdKase" />
					<action type="control populate" value="#grdOperateri" />
					<action type="control populate" value="#grdVrijeme" />
					<action type="variable value">
						<parameter name="Global.Id" value="#grdMaster.@trgovinaid" type="int" />
					</action>
				</event>
				
				<event type="doubleclick">
					<action type="form open" value="frmIzmTrg"/>
				</event>
				
				<fields>
				</fields>
				
				<menu>
					<!-- meni na masteru -->
					<menuitem name="menPrijavi" caption="Prijavi" sort="1">
						<event type="click">
							<action type="form open" value="frmPrijava">
								<action type="control refreshvalue" value="#grdMaster"/>
							</action>
						</event>
					</menuitem>
					
					<menuitem name="menOdjavi" caption="Odjavi" sort="2">
						<event type="click">							
							<action type="form open" value="frmOdjava">
								<action type="control refreshvalue" value="#grdMaster"/>
							</action>
						</event>
					</menuitem>
				</menu>
				
			</grid>

			<tabs>
				<tab name="tbKase" caption="Kase">
					<grid name="grdKase" dataname="~dtKase" bestfitonrefresh="true" netgenfields="true" keyfield="mpkaseid">
					</grid>
				</tab>
				<tab name="tbOperateri" caption="Operateri">
					<grid name="grdOperateri" dataname="~dtOperateri" bestfitonrefresh="true" netgenfields="true" keyfield="operateriid">
					</grid>
				</tab>
				<tab name="tbVrijeme" caption="Radno vrijeme">
					<grid name="grdVrijeme" dataname="~dtVrijeme" bestfitonrefresh="true" netgenfields="true">
					</grid>

				</tab>	
				<event type="selectedtabchanged">
					<action type="control disable" value="#btnOperater, #btnVrijeme" if="#grdKase.visible==true"/>
					<action type="control enable" value="#btnKasa" if="#grdKase.visible==true"/>
					<action type="control disable" value="#btnKasa, #btnVrijeme" if="#grdOperateri.visible==true"/>
					<action type="control enable" value="#btnOperater" if="#grdOperateri.visible==true"/>
					<action type="control disable" value="#btnOperater, #btnKasa" if="#grdVrijeme.visible==true"/>
					<action type="control enable" value="#btnVrijeme" if="#grdVrijeme.visible==true"/>
				</event>
			</tabs>

		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnTrgovina" caption="Trgovina">
					<event type="click">
						<action type="form open" value="frmTrgovina">
							<parameter name="trgovina" value="#grdMaster.@Trgovina4000" />
						</action>
					</event>
				</button>
				<button name="btnKasa" caption="Kasa">
					<event type="click">
						<action type="form open" value="frmKasa">
							<parameter name="kasaid" value="#grdKase.@MPKaseId"/>
							<parameter name="kasa" value="#grdKase.@Kasa"/>
						</action>
					</event>
				</button>
				<button name="btnOperater" caption="Operater">
					<event type="click">
						<action type="form open" value="frmOperater">
							<parameter name="operater" value="#grdOperateri.@LnTrgOperid"/>
						</action>
					</event>
				</button>
				<button name="btnVrijeme" caption="Radno vrijeme">
					<event type="click">
						<action type="form open" value="frmVrijeme">
						</action>
					</event>
				</button>
				<button name="btnKontrola" caption="Kontrola">
					<event type="click">
						<action type="form open" value="frmKontrola">
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPTrgovineNG" name="dtTrgovine">
				<parameter name="@action" value="1"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spMPKase" name="dtKase">
				<parameter name="@action" value="2"/>
				<parameter name="@trgovinaid" value="#grdMaster.@trgovinaid"/>
			</data>
			<data command="spMPTrgOpr" name="dtOperateri">
				<parameter name="@action" value="7"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@id" value="#grdMaster.@trgovinaid"/>
			</data>
			<data command="spMPTrgovineNG" name="dtVrijeme">
				<parameter name="@action" value="8"/>
				<parameter name="@trgovinaid" value="#grdMaster.@trgovinaid"/>
			</data>
		</datalist>

	</form>

	<form name="frmTrgovina" caption="Trgovina">
		<layout>
			<group rows="3" cols="3">
				<item row="1" col="1">
					<button name="btnAdd" caption="Unos">
						<event type="click">
							<action type="form open" value="frmNovaTrg">
							</action>
							<action type="form close" />
						</event>
					</button>
				</item>
				<item row="1" col="2">
					<button name="btnPrijava" caption="PRIJAVA poslovnog prostora">
						<event type="click">
							<action type="form open" value="frmPrijava">
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="1">
					<button name="btnChange" caption="Izmjena">
						<event type="click">
							<action type="form open" value="frmIzmTrg">
								<parameter name="trgovina" value="$trgovina"/>
							</action>
							<action type="form close" />
						</event>
					</button>
				</item>
				<item row="2" col="2">
					<button name="btnOdjava" caption="ODJAVA poslovnog prostora">
						<event type="click">
							<action type="form open" value="frmOdjava">
							</action>
						</event>
					</button>
				</item>
				<rowsdefinition>
					<row position="1" size="50"></row>
					<row position="2" size="50"></row>
					<row position="3" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="200"></column>
					<column position="2" size="200"></column>
					<column position="3" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Zatvori" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmKasa" caption="Kasa">
		<layout>
			<group rows="4" cols="3">
				<item row="1" col="1">
					<button name="btnAdd" caption="Unos">
						<event type="click">
							<action type="form open" value="frmNovaKasa">
								<parameter name="kasaid" value="$kasaid"/>
							</action>
						</event>
					</button>
				</item>
				<item row="1" col="2">
					<button name="btnAll" caption="Sve kase">
						<event type="click">
							<action type="form open" value="frmSveKase">
								<parameter name="kasaid" value="$kasaid"/>
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="1">
					<button name="btnChange" caption="Izmjena">
						<event type="click">
							<action type="form open" value="frmIzmjeniKasu">
								<parameter name="kasaid" value="$kasaid"/>
								<parameter name="kasa" value="$kasa"/>
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="2">
					<button name="btnZaglavlje" caption="Zaglavlje računa">
						<event type="click">
							<action type="form open" value="frmZagRacun">
								<parameter name="kasaid" value="$kasaid"/>
							</action>
						</event>
					</button>
				</item>
				<item row="3" col="1">
					<button name="btnCopy" caption="Kopiraj">
						<event type="click">
							<action type="form open" value="frmKopirajDefKase">
								<parameter name="kasaid" value="$kasaid"/>
							</action>
						</event>
					</button>
				</item>
				<item row="3" col="2">
					<button name="btnLogin" caption="Login na kasi">
						<event type="click">
							<action type="form open" value="frmLoginKasa">
								<parameter name="kasaid" value="$kasaid"/>
								<parameter name="kasa" value="$kasa"/>
							</action>
						</event>
					</button>
				</item>
				<rowsdefinition>
					<row position="1" size="50"></row>
					<row position="2" size="50"></row>
					<row position="3" size="50"></row>
					<row position="4" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="200"></column>
					<column position="2" size="200"></column>
					<column position="3" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Zatvori" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmOperater" caption="Operater - Trgovina">
		<layout>
			<group rows="3" cols="3">
				<item row="1" col="1">
					<button name="btnAdd" caption="Unos">
						<event type="click">
							<action type="form open" value="frmOperaterDodTrg">
								<parameter name="operaterid" value="$operater"/>
							</action>
						</event>
					</button>
				</item>
				<item row="1" col="2">
					<button name="btnDel" caption="Brisanje">
						<event type="click">
							<action type="form open" value="frmOperaterBrisTrg">
								<parameter name="operaterid" value="$operater"/>
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="1">
					<button name="btnChange" caption="Izmjena">
						<event type="click">
							<action type="form open" value="frmOperaterIzmTrg">
								<parameter name="operaterid" value="$operater"/>
							</action>
						</event>
					</button>
				</item>
				<rowsdefinition>
					<row position="1" size="50"></row>
					<row position="2" size="50"></row>
					<row position="3" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="200"></column>
					<column position="2" size="200"></column>
					<column position="3" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Zatvori" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmVrijeme" caption="Radno vrijeme">
		<layout>
			<group rows="3" cols="2">
				<item row="1" col="1">
					<button name="btnVrijeme" caption="Radno vrijeme">
						<event type="click">
							<action type="form open" value="frmAzurRadVrm">
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="1">
					<button name="btnTipVrijeme" caption="Tip radnog vremena">
						<event type="click">
							<action type="form open" value="frmRadnaVremena">
							</action>
						</event>
					</button>
				</item>
				<rowsdefinition>
					<row position="1" size="50"></row>
					<row position="2" size="50"></row>
					<row position="3" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="200"></column>
					<column position="2" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Zatvori" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmKontrola" caption="Kontrola">
		<event type="init">
		</event>
		<event type="load">
			<action type="control populate" value="#grdKontrola" >
			</action>
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1">
					<grid name="grdKontrola" dataname="~dtKontrola" bestfitonrefresh="true" netgenfields="true">
					</grid>
				</item>
				<rowsdefinition>
					<row position="1" size="500"></row>
					<row position="2" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="600"></column>
					<column position="2" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Zatvori" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPKontrolaTrgPORTAL" name="dtKontrola">
			</data>
		</datalist>
	</form>

	<form name="frmAzurRadVrm" path="frmAzurRadVrm.xml"/>
	<form name="frmKopiraj" path="frmAzurRadVrm.xml"/>
	<form name="frmRadnaVremena" path="frmAzurRadVrm.xml"/>
	<form name="frmDodajVrm" path="frmAzurRadVrm.xml"/>
	<form name="frmIzmjeniVrm" path="frmAzurRadVrm.xml"/>
	<form name="frmBrisiVrm" path="frmAzurRadVrm.xml"/>

	<form name="frmOperaterDodTrg" path="frmOperater.xml"/>
	<form name="frmOperaterDod" path="frmOperater.xml"/>
	<form name="frmOperaterIzmTrg" path="frmOperater.xml"/>
	<form name="frmOperaterIzm" path="frmOperater.xml"/>
	<form name="frmOperaterBrisTrg" path="frmOperater.xml"/>
	
	<form name="frmNovaTrg" path="frmTrgovina.xml"/>
	<form name="frmIzmTrg" path="frmTrgovina.xml"/>
	<form name="frmPrijava" path="frmTrgovina.xml"/>
	<form name="frmOdjava" path="frmTrgovina.xml"/>
	
	<form name="frmNovaKasa" path="frmKasa.xml"/>
	<form name="frmIzmjeniKasu" path="frmKasa.xml"/>
	<form name="frmNacinPlacanja" path="frmKasa.xml"/>
	<form name="frmKopirajPlacanje" path="frmKasa.xml"/>
	<form name="frmKopirajDefKase" path="frmKasa.xml"/>
	<form name="frmParametriPrijenosa" path="frmKasa.xml"/>
	
	<form name="frmSveKase" path="frmKasa.xml"/>
	<form name="frmZagRacun" path="frmKasa.xml"/>
	<form name="frmLoginKasa" path="frmKasa.xml"/>
	<form name="frmDodajLogin" path="frmKasa.xml"/>
	<form name="frmIzmjeniLogin" path="frmKasa.xml"/>
	<form name="frmBrisiLogin" path="frmKasa.xml"/>
	
</root>