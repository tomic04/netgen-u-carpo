<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1" >

	<form name="frmMaster" type="master" caption="Ažuriranje asortimana dobavljača">

		<event type="init">
			<action type="variable value">
				<parameter name="global.partneriid" value="null" type="int"/>
				<parameter name="global.robaid" value="null" type="int"/>
				<parameter name="dodump" value="0" type="int"/>
			</action>
		</event>

		<event type="load">
			<action type="control disable" value="#btnEdit, #btnDel, #btnActivate, #btnDeactivate" if="#grdMaster.rowcount==0" >
			</action>
		</event>

		<event type="shown">
		</event>

		<managerlayout>

			<tree name="dtTree" dataname="dtTree" key="id" caption="Dobavljači" expandallonload="true">
				<event type="focusedrowchanged">
					<action type="variable value">
						<parameter name="global.partneriid" value="#dtTree.@value" />
						<parameter name="global.robaid" value="null" />
					</action>
					<action type="control populate" value="#grdMaster" />
				</event>
				<fields>
					<field name="caption"/>
				</fields>
			</tree>

			<grid name="grdMaster" type="master" dataname="~dtFilter" key="parasortimanid" netgenfields="true" showcheckboxes="true" multiselect="true">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjeni">
						<parameter name="partneriid" value="global.$partneriid"/>
						<parameter name="robaid" value="#grdMaster.@robaid"/>
						<parameter name="parasortimanid" value="#grdMaster.@parasortimanid"/>
					</action>
				</event>
				<event type="focusedrowchanged">
					<action type="control enable" value="#btnEdit, #btnDel, #btnActivate, #btnDeactivate" if="#grdMaster.rowcount!=0" >
					</action>
					<action type="control disable" value="#btnEdit, #btnDel, #btnActivate, #btnDeactivate" else="" >
					</action>
					<!--neradi-->
				</event>

				<menu>
					<menuitem name="menFilter" caption="Filtriraj">
						<event type="click">
							<action type="form open" value="frmFilter">
							</action>
							<action type="control populate" value="#grdMaster" />
						</event>
					</menuitem>
				</menu>
				<fields>
					<field name="Aktivno0800"/>
					<field name="Šifra robe1100"/>
					<field name="Barcode1400"/>
					<field name="Naziv robe3500"/>
					<field name="Klasifikacija3500"/>
					<field name="Dod.klasifikacija3000"/>
					<field name="Šifra kod dobavljača1500"/>
					<field name="JM0600"/>
				</fields>
				<styles>
					<style name="fontcolor" value="red" if="#grdMaster.@Aktivno0800=='NE'" />
				</styles>
			</grid>

		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="Uvjeti">
					<event type="click">
						<action type="form open" value="frmFilter">
						</action>
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
				<button name="btnAdd" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodaj">
							<parameter name="partneriid" value="global.$partneriid"/>
							<parameter name="robaid" value="#grdMaster.@robaid"/>
						</action>
					</event>
				</button>
				<button name="btnEdit" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
							<parameter name="partneriid" value="global.$partneriid"/>
							<parameter name="robaid" value="#grdMaster.@robaid"/>
							<parameter name="parasortimanid" value="#grdMaster.@parasortimanid"/>
						</action>
					</event>
				</button>
				<button name="btnUpload" caption="Donesi">
					<event type="click">
					</event>
				</button>
				<button name="btnDel" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Želite li obrisati odabrane artikle:  {#grdMaster.selectedids.Naziv robe3500}">
							<action type="confirm" value="I za MP asortiman?">
								<action type="variable value">
									<parameter name="dodump" value="1" type="int"/>
								</action>
							</action>							
						</action>
						<action type="control foreachrow selected" value="#grdMaster">
							<action type="datarun nonquery" value="~dtDel">
								
							</action>
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="variable value">
							<parameter name="dodump" value="0" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnActivate" caption="Aktiviraj">
					<event type="click">
						<action type="confirm" value="Želite li aktivirati označene artikle iz asortimana:  {#grdMaster.selectedids.Naziv robe3500}">
							<action type="confirm" value="I za MP asortiman?">
								<action type="variable value">
									<parameter name="dodump" value="1" type="int"/>
								</action>
							</action>							
						</action>
						<action type="control foreachrow selected" value="#grdMaster">
							<action type="datarun nonquery" value="~dtAct">
								<action type="control populate" value="#grdMaster"/>
							</action>
						</action>
						<action type="variable value">
							<parameter name="dodump" value="0" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnDeactivate" caption="Deaktiviraj">
					<event type="click">
						<action type="confirm" value="Želite li deaktivirati označene artikle iz asortimana:  {#grdMaster.selectedids.Naziv robe3500}">
							<action type="confirm" value="I za MP asortiman?">
								<action type="variable value">
									<parameter name="dodump" value="1" type="int"/>
								</action>
							</action>							
						</action>
						<action type="control foreachrow selected" value="#grdMaster">
							<action type="datarun nonquery" value="~dtDeAct">
								<action type="control populate" value="#grdMaster"/>
							</action>
						</action>
						<action type="variable value">
							<parameter name="dodump" value="0" type="int"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPTreePartneri" name="dtTree">
				<parameter name="@action" value="1"/>
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtMaster">
				<parameter name="@action" value="111"/>
				<parameter name="@partneriid" value="#dtTree.@value"/>
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtFilter">
				<parameter name="@action" value="1"/>
				<parameter name="@partneriid" value="global.$partneriid"/>
				<parameter name="@robaid" value="global.$robaid"/>
			</data>

			<data command="spMPParAsortimanPregledNG" name="dtDel">
				<parameter name="@action" value="4"/>
				<parameter name="@id" value="#grdMaster.@parasortimanid"/>
				<parameter name="@dodump" value="$dodump"/>
			</data>

			<data command="spMPParAsortimanPregledNG" name="dtAct">
				<parameter name="@action" value="7"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@dodump" value="$dodump"/>
				<parameter name="@partneriid" value="$global.partneriid"/>
			</data>

			<data command="spMPParAsortimanPregledNG" name="dtDeAct">
				<parameter name="@action" value=""/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@dodump" value="$dodump"/>
				<parameter name="@partneriid" value="$global.partneriid"/>
			</data>
			
			<data command="select 1 as ime" type="text" name="dt1">
			</data>

		</datalist>

	</form>

	<form name="frmFilter" path="frmFilter.xml"/>
	<form name="frmDodaj" path="frmDodaj.xml"/>
	<form name="frmIzmjeni" path="frmIzmjeni.xml"/>

</root>