<parts>
	<part name="prtZaglavlje">

		<group cols="1" rows="2" groupbordervisible="false">
			<group row="1" col="1" rows="6" cols="2" caption="Zaglavlje" groupbordervisible="false">
				<item row="1" col="1" caption="Broj" textposition="left" >
					<textedit name="txtBroj" readonly="true" datavalue="~dtQureyGla.@broj" fontbold="True">
					</textedit>
				</item>
				<item row="2" col="1" caption="Datum" textposition="left" >
					<dateedit name="datDok" required="true" value="now" datavalue="~dtQureyGla.@DatumDok">
					</dateedit>
				</item>
				<item row="3" col="1" caption="Vrsta dokumenta" textposition="left" >
					<comboedit name="txtVrsta" readonly="true" displayfield="naziv" valuefield="vrstadokid" dataname="~dtNapuniVrsDok" datavalue="~dtNapuniVrsDok.@vrstadokid">
					</comboedit>
				</item>
				<item row="4" col="1" caption="Partner" textposition="left" >
					<searchedit name="srcPartner" required="true"  fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtOdaberiPartneri" datavalue="~dtQureyGla.@partneriid" datatext="~dtQureyGla.@partner" >
						<event type="leave">
							<action type="datarun scalar" value="~dtNapuniLokaciju">
								<action type="control populate" value="#cmbLokacija"/>
							</action>
							<action type="datarun scalar" value="~dtIsporukaPartner">
								<parameter name="dan" value="~dtIsporukaPartner.@dana"/>
							</action>
							<action type="control value" value="txtDanValuta">
								<parameter value="$dan" />
							</action>
							<action type="datarun scalar" value="~dtIsporukaDana">
								<parameter name="dandatum" value="~dtIsporukaDana.@dat2isporuke"/>
							</action>
							<action type="control value" value="datDatumValuta">
								<parameter value="$dandatum" />
							</action>
							<action type="variable value">
								<parameter name="partneriid" value="#srcPartner" type="int" />
							</action>
							<action type="control focus" value="#cmbLokacija" />
						</event>
					</searchedit>
				</item>
				<item row="5" col="1" caption="Način isporuke" textposition="left" >
					<comboedit name="cmbIsporuka" required="true" displayfield="naziv" valuefield="pronacinisporukeid" dataname="~dtNapuniIsporuku" datavalue="~dtQureyGla.@pronacinisporukeid">
					</comboedit>
				</item>
				<group row="6" col="1" rows="1" cols="2" groupbordervisible="false">
					<item row="1" col="1" caption="Rabat"  textposition="left" >
						<textedit name="txtRabat" datavalue="~dtQureyGla.@rabat" value="0" format="n2">
						</textedit>
					</item>
					<item row="1" col="2" caption="Učesće" textposition="left" >
						<textedit name="txtUcesce" visible="false" datavalue="~dtQureyGla.@ucesce" value="0" format="n2">
						</textedit>
					</item>
				</group>
				<item row="2" col="2" caption="Trgovina" textposition="left" >
					<comboedit name="cmbTrgovina" required="true" displayfield="Naziv" valuefield="TrgovinaId" dataname="~dtNapuniTrgovinu" datavalue="~dtQureyGla.@trgovinaid">
						<event type="valuechanged">
							<action type="datarun scalar" value="~dtIsporukaPartner">
								<parameter name="dan" value="~dtIsporukaPartner.@dana"/>
							</action>
							<action type="control value" value="txtDanValuta">
								<parameter value="$dan" />
							</action>
							<action type="datarun scalar" value="~dtIsporukaDana">
								<parameter name="dandatum" value="~dtIsporukaDana.@dat2isporuke"/>
							</action>
							<action type="control value" value="datDatumValuta">
								<parameter value="$dandatum" />
							</action>
							<action type="control focus" value="#cmbOdgOsoba" />
						</event>
					</comboedit>
				</item>
				<item row="3" col="2" caption="Odgovorna osoba" textposition="left" >
					<comboedit name="cmbOdgOsoba" required="true" displayfield="Naziv" valuefield="OsobeId" dataname="~dtNapuniOsobu" datavalue="~dtQureyGla.@osobeid" >
					</comboedit>
				</item>
				<item row="4" col="2" caption="Mjesto isporuke" textposition="left" >
					<comboedit name="cmbLokacija" required="true" displayfield="naziv" valuefield="parstruid" dataname="~dtNapuniLokaciju" datavalue="~dtLokacija.@parstruid" >
					</comboedit>
				</item>
				<group row="6" col="2"  rows="1" cols="2" groupbordervisible="false">
					<item row="1" col="1" caption="Dana valute" textposition="left" >
						<textedit name="txtDanValuta" required="true" datavalue="~dtQureyGla.@brojdanaisporuke">
							<event type="leave">
								<action type="datarun scalar" value="~dtIsporukaDana">
									<parameter name="dandatum" value="~dtIsporukaDana.@dat2isporuke"/>
								</action>
								<action type="control value" value="datDatumValuta">
									<parameter value="$dandatum" />
								</action>
							</event>
						</textedit>
					</item>
					<item row="1" col="2" caption="Datum valute" textposition="left" >
						<dateedit name="datDatumValuta" readonly="true" value="now" datavalue="~dtQureyGla.@datumvalute">
						</dateedit>
					</item>
				</group>
			</group>
			<group row="2" col="1" rows="1" cols="2" groupbordervisible="false">
				<item row="1" col="1" caption="Napomena" >
					<textedit name="txtNapomena" datavalue="~dtQureyGla.@napomena">
					</textedit>
				</item>
			</group>
		</group>	

	</part>

	<part name="prStavke">

		<group cols="1" rows="3" groupbordervisible="false">
			<group col="1" row="1" cols="3" rows="1" groupbordervisible="false">
				<item row="1" col="1" colspan="2" caption="Roba" textposition="left" >
					<searchedit name="srcRoba"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" visible="true" fontbold="True" datavalue="~dtStavka.@robaid" datatext="~dtStavka.nazivRobe">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtKontrolaRoba">
							</action>
							<action type="datarun reader" value="~dtPodaciRoba">
							</action>
							<action type="control refreshvalue" value="#txtJM"/>
							<action type="control refreshvalue" value="#txtMPC"/>
							<action type="control refreshvalue" value="#txtNabavna"/>
							<action type="datarun reader" value="~dpKalkuliraj">
								<action type="control refreshvalue" value="#txtMarza"/>
								<action type="control refreshvalue" value="#txtMPV"/>
							</action>
							<action type="control enable" value="#btnAdd" if="#srcRoba!='null'&amp;&amp;#txtKolicina!=0"/>
							
						</event>
					</searchedit>
				</item>
				<item row="1" col="3">
				</item>


			</group>


			<group col="1" row="2" cols="3" rows="3" groupbordervisible="false">
				<item row="1" col="1" caption="Količina" textposition="left" >
					<textedit name="txtKolicina" value="0" datavalue="~dtStavka.@kolicinaulaz" format="n2">
						<event type="leave">
							<action type="datarun reader" value="~dpKalkuliraj">
								<action type="control refreshvalue" value="#txtMarza"/>
								<action type="control refreshvalue" value="#txtMPV"/>
							</action>
							<action type="control enable" value="#btnAdd" if="#srcRoba!='null'&amp;&amp;#txtKolicina!=0"/>
							
						</event>
					</textedit>
				</item>
				<item row="1" col="2" caption="JM"  textposition="left" >
					<textedit name="txtJM" readonly="true" datavalue="~dtPodaciRoba.@jmnaziv" >
					</textedit>
				</item>
				<item row="2" col="1" caption="MP Cijena"  textposition="left" >
					<textedit name="txtMPC" readonly="true" datavalue="~dtPodaciRoba.@mpcpov" value="0" format="n2">
						<event type="leave">
							<action type="datarun reader" value="~dpKalkuliraj">
								<action type="control refreshvalue" value="#txtMarza"/>
								<action type="control refreshvalue" value="#txtMPV"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="2" col="2" caption="Originalna MPC"  textposition="left" >
					<textedit name="txtOMPC" enabled="false" datavalue="~dtPodaciRoba.@ORGmpc" value="0" format="n2">
					</textedit>
				</item>
				<item row="2" col="3" caption="MPC za platit"  textposition="left" >
					<textedit name="txtMPV" readonly="true" datavalue="~dpKalkuliraj.@mpvrijednost" value="0" format="n2">
					</textedit>
				</item>
				<item row="3" col="1" caption="Nabavna Cijena"  textposition="left" >
					<textedit name="txtNabavna" readonly="true" datavalue="~dtPodaciRoba.@nabcijena" value="0" format="n2">
					</textedit>
				</item>
				<item row="3" col="2" caption="Rabat %" textposition="left" >
					<textedit name="txtRabatdp" value="0" format="n2" datavalue="~dtStavka.@dprabat">
						<event type="leave">
							<action type="datarun reader" value="~dpKalkuliraj">
								<action type="control refreshvalue" value="#txtMarza"/>
								<action type="control refreshvalue" value="#txtMPV"/>
							</action>
							
						</event>
					</textedit>
				</item>
				<item row="3" col="3" caption="Marža %"  textposition="left" >
					<textedit name="txtMarza" readonly="true" datavalue="~dpKalkuliraj.@marza" value="0" format="n2">
					</textedit>
				</item>
			</group>

			<group col="1" row="3" cols="1" rows="1" groupbordervisible="false">
				<item row="1" col="1" caption="Napomena stavke" textposition="left" >
					<textedit name="txtNapomenadp" datavalue="~dtStavka.@napomena">
					</textedit>
				</item>
			</group>

		</group>	

	</part>

	<part name="prtUrediStavku" >
		<group rows="1" cols="1" groupbordervisible="false">
			<item row ="1" col="1" height="300">
				<grid name="grdStavke" dataname="~dtQureyStavke" netgenfields="true" keyfield="maloprodajadetid">
					<event type="cellvaluechanged">
						<action type="datarun nonquery" value="~dtIspraviKolicinu"/>
						<action type="datarun nonquery" value="~dpProracun"/>
						<action type="datarun nonquery" value="~dpKalkuliraj"/>
						<action type="control populate keepfocus" value="#grdStavke" />
						<action type="datarun reader" value="~dtIznos">
							<action type="control refreshvalue" value="#txtPlatiti"/>
						</action>
					</event>
					<fields>
						<field name="Vrsta1000" fixed="true"/>
						<field name="Klasa" fixed="true"/>
						<field name="Šifra" fixed="true"/>
						<field name="Naziv3000" fixed="true"/>
						<field name="Jm0600"/>
						<field name="Kol.izlaz1200" editable="true"/>
						<field name="MP CijenaOrg1200"/>
						<field name="MP IznosOrg1200"/>
						<field name="% Rabat"/>
						<field name="Iznos Rabata1200"/>
						<field name="MP Cijena1200"/>
						<field name="MP Iznos1200"/>
						<field name="% PDV-a0800"/>
						<field name="PDV Iznos1200"/>
						<field name="MP Cijena 1200"/>
						<field name="MPC as pov.1200"/>
						<field name="MP Iznos 1200"/>
						<field name="Pov. naknada1000"/>
						<field name="MP Iznos KP1100"/>

					</fields>
				</grid>
			</item>

		</group>

	</part>

</parts>