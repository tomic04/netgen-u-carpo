<parts>
	<part name="prtPodaci">
		<group rows ="19" cols="1" groupbordervisible="false">

			<item row="1" col="1" caption="Trgovina" textposition="left">
				<comboedit name="cmbTrgovina"  required="true" displayfield="naziv" valuefield="trgovinaid" dataname="~dtTrgovine" datavalue="~dtNapuni.@Trgovinaid">
				</comboedit>
			</item>
			<item row="2" col="1" caption="Šifra" textposition="left">
				<textedit name="txtSifra" required="true" datavalue="~dtNapuni.@Sifra">
				</textedit>
			</item>
			<item row="3" col="1" caption="Ime" textposition="left">
				<textedit name="txtIme" required="true" datavalue="~dtNapuni.@Ime">
				</textedit>
			</item>
			<item row="4" col="1" caption="Prezime" textposition="left">
				<textedit name="txtPrezime" required="true" datavalue="~dtNapuni.@Prezime">
				</textedit>
			</item>
			<item row="5" col="1" caption="Adresa" textposition="left">
				<textedit name="txtAdresa" required="true" datavalue="~dtNapuni.Adresa">
				</textedit>
			</item>
			<item row="6" col="1" caption="Mjesto" textposition="left">
				<comboedit name="cmbMjesto" required="true" displayfield="naziv" valuefield="mjestaid" dataname="~dtMjesta" datavalue="~dtNapuni.@mjestaid">
				</comboedit>
			</item>
			<item row="7" col="1" caption="Mail" textposition="left">
				<textedit name="txtMail" datavalue="~dtNapuni.mail" format="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}" formattype="regex">
				</textedit>
			</item>
			<item row="8" col="1"  textposition="left">
				<checkedit caption="Član želi primati obavjesti mailom" value ="0" name="cheInfo" datavalue="~dtNapuni.@infoptt">
				</checkedit>
			</item>
			<item row="9" col="1" caption="Datum Rođenja" textposition="left">
				<dateedit name="datDatum" value="now" datavalue="~dtNapuni.DatumRodjenja">
				</dateedit>
			</item>
			<item row="10" col="1" caption="Sprema" textposition="left">
				<comboedit name="cmbSprema" displayfield="naziv" valuefield="hrspremeid" dataname="~dtSprema" datavalue="~dtNapuni.HRspremeid">
				</comboedit>
			</item>
			<item row="11" col="1" caption="Broj članova obitelji" textposition="left">
				<textedit name="txtObitelj" value="0" format="n0" datavalue="~dtNapuni.@brojclanovaobitelji">
				</textedit>
			</item>
			<item row="12" col="1" caption="Broj djece" textposition="left">
				<textedit name="txtDjeca" value="0" format="n0" datavalue="~dtNapuni.@brojdjece">
				</textedit>
			</item>
			<item row="13" col="1" caption="Broj OI" textposition="left">
				<textedit name="txtOI" datavalue="~dtNapuni.@brojoi">
				</textedit>
			</item>
			<item row="14" col="1" caption="Spol" textposition="left">
				<comboedit name="cmbSpol" displayfield="naziv" valuefield="spolid" dataname="~dtSpol" datavalue="~dtNapuni.@spol">
				</comboedit>
			</item>
			<item row="15" col="1" caption="Broj telefona" textposition="left">
				<textedit name="txtTel" datavalue="~dtNapuni.@BrojTelefon">
				</textedit>
			</item>
			<item row="16" col="1" caption="Broj mobitela" textposition="left">
				<textedit name="txtMob" datavalue="~dtNapuni.@brojmob">
				</textedit>
			</item>
			<item row="17" col="1" caption="Broj ulaznih bodova" textposition="left">
				<textedit name="txtBodovi" value="0" format="n0" datavalue="~dtNapuni.@PocetniBodovi">
				</textedit>
			</item>
			<item row="18" col="1" caption="Napomena" textposition="left">
				<textedit name="txtNapomena" datavalue="~dtNapuni.@napomena">
				</textedit>
			</item>
			<item row="19" col="1" caption="Partner" textposition="left">
				<searchedit name="srcPartner" displayfield="Naziv" valuefield="partneriid" dataname="~dtPartneri" datavalue="~dtNapuni.@partneriid" datatext="~dtNapuni.@partner">
				</searchedit>
			</item>

		</group>	
	</part>
	
		<part name="prtBodovi">
		<group rows="3" cols="1" groupbordervisible="false">
				<item row="1" col="1">
					<dateedit name="datDatumUnosa" required="true" value="now" datavalue="~dtPoklonDohvati.@datumdok"></dateedit>
				</item>
				<item row="2" col="1">
					<textedit name="txtBodovi" required="true" format="n0"  value="0" datavalue="~dtPoklonDohvati.@brojbodova"></textedit>
				</item>
				<item row="3" col="1">
					<textedit name="txtNapomenaBodovi" datavalue="~dtPoklonDohvati.@napomena"></textedit>
				</item>
			</group>
	</part>

	<part name="prtStore">
		<data command="spmpDajTrgovina" name="dtTrgovine">
			<parameter name="@operateriid" value="@@operateriid" />
		</data>
		<data command="select mjestaid, naziv+' '+rtrim(hptbroj) as naziv from mjesta order by drzaveid desc, naziv" type="text" name="dtMjesta">	
		</data>
		<data command="select hrspremeid, rtrim(oznaka) + ' ' + naziv as [Naziv] from hrspreme" type="text" name="dtSprema">	
		</data>
		<data command="select 'Z' as spolid, 'Žensko' as Naziv union all select 'M' , 'Muško'" type="text" name="dtSpol">	
		</data>
		<data command="spMPClanoviAzurNG" name="dtPartneri">
			<parameter name="@action" value="4" />
			<parameter name="@partner" value="#srcPartner.text" />
		</data>
		<data command="select 1 as statusid, 'Aktivan' as Naziv union all select 0, 'Neaktivan'" type="text" name="dtStatus">
		</data>
	</part>
</parts>