<parts>

	<part name="prtRadVrm">
		<group rows="4" cols="3">
			<item row="1" col="1" colspan="2" caption="Opis" textposition="left">
				<textedit name="txtOpis" datavalue="~dtVrijeme.@opis">
				</textedit>
			</item>
			<item row="2" col="1" caption="Od (HH:MM)"  textposition="left">
				<textedit name="txtOdSat" datavalue="~dtVrijeme.@odsat">
				</textedit>
			</item>
			<item row="2" col="2" caption=""  textposition="left">
				<textedit name="txtOdMin" datavalue="~dtVrijeme.@odmin">
				</textedit>
			</item>
			<item row="3" col="1" caption="Do (HH:MM)"  textposition="left">
				<textedit name="txtDoSat" datavalue="~dtVrijeme.@dosat">
				</textedit>
			</item>
			<item row="3" col="2" caption=""  textposition="left">
				<textedit name="txtDoMin" datavalue="~dtVrijeme.@domin">
				</textedit>
			</item>
			<rowsdefinition>
				<row position="1" size="30"></row>
				<row position="2" size="30"></row>
				<row position="3" size="30"></row>
				<row position="4" size="100%"></row>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="115"></column>
				<column position="2" size="50"></column>
				<column position="3" size="100%"></column>
			</columnsdefinition>
		</group>
	</part>

	<part name="prtRadVrmData">
		<data command="select * from mptipradnogvremena where mptipradnogvremenaid = @mptipradnogvremenaid" type="text" name="dtVrijeme">
			<parameter name="@mptipradnogvremenaid" value="$MPTipRadnogVremenaid"/>
		</data>
		<data command="spMPTrgovineNG" name="dtDodajVrm">
			<parameter name="@action" value="10"/>
			<parameter name="@opis" value="#txtOpis"/>
			<parameter name="@odsat" value="#txtOdSat"/>
			<parameter name="@odmin" value="#txtOdMin"/>
			<parameter name="@dosat" value="#txtDoSat"/>
			<parameter name="@domin" value="#txtDoMin"/>
		</data>
		<data command="sspMPTrgovineNG" name="dtIzmjeniVrm">
			<parameter name="@action" value="11"/>
			<parameter name="@mptipradnogvremenaid" value="$MPTipRadnogVremenaid"/>
		</data>
		<data command="spMPTrgovineNG" name="dtBrisiVrm">
			<parameter name="@action" value="12"/>
			<parameter name="@mptipradnogvremenaid" value="$MPTipRadnogVremenaid"/>
		</data>
	</part>

	<part name="prtOperaterTrg">
		<group rows="6" cols="2">
			<item row="1" col="1" caption="Trgovina" textposition="left">
				<comboedit name="cmbTrgovina" displayfield="opis" valuefield="trgovinaid" dataname="~dtTrgovine" datavalue="~dtOperater.@Trgovinaid" >
				</comboedit>
			</item>
			<item row="2" col="1" caption="Operater" textposition="left">
				<comboedit name="cmbOperater" displayfield="naziv" valuefield="operateriid" dataname="~dtOperateri" datavalue="~dtOperater.@operaterid" >
				</comboedit>
			</item>
			<item row="3" col="1" caption="OIB" textposition="left">
				<textedit name="txtOib" datavalue="~dtOperater.@oib">
				</textedit>
			</item>
			<item row="4" col="1" caption="Šifra" textposition="left">
				<textedit name="txtSifra" datavalue="~dtOperater.@sifra">
				</textedit>
			</item>
			<item row="5" col="1" caption="Odjel" textposition="left">
				<comboedit name="cmbOdjel" displayfield="naziv" valuefield="odjelid" dataname="~dtOdjel" datavalue="~dtOperater.@odjelid" >
				</comboedit>
			</item>
			<rowsdefinition>
				<row position="5" size="100%"></row>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="300"></column>
				<column position="2" size="100%"></column>
			</columnsdefinition>
		</group>
	</part>

	<part name="prtOperater">
		<group rows="9" cols="2">
			<item row="1" col="1" caption="Trgovina" textposition="left">
				<textedit name="txtTrgovina">
				</textedit>
			</item>
			<item row="2" col="1" caption="Operater" textposition="left">
				<textedit name="txtOperater" datavalue="~dtOperaterIz.@naziv">
				</textedit>
			</item>
			<item row="3" col="1" caption="Inicijali" textposition="left">
				<textedit name="txtInicijal" datavalue="~dtOperaterIz.@inicijali">
				</textedit>
			</item>
			<item row="4" col="1" caption="OIB" textposition="left">
				<textedit name="txtOib" datavalue="~dtOperaterIz.@OIB">
				</textedit>
			</item>
			<item row="5" col="1" caption="Šifra za kasu" textposition="left">
				<textedit name="txtSifra" datavalue="~dtOperaterIz.@sifra">
				</textedit>
			</item>
			<item row="6" col="1" caption="Jupiter lozinka" textposition="left">
				<textedit name="txtLozinka" datavalue="~dtOperaterIz.@password">
				</textedit>
			</item>
			<item row="7" col="1" caption="Grupa operatera" textposition="left">
				<comboedit name="cmbGrupa" displayfield="naziv" valuefield="grupeid" dataname="~dtGrupa" datavalue="~dtOperaterIz.@grupeid" >
				</comboedit>
			</item>
			<item row="8" col="1" caption="Odjel" textposition="left">
				<comboedit name="cmbOdjel" displayfield="naziv" valuefield="odjelid" dataname="~dtOdjel" datavalue="~dtOperaterIz.@odjelid" >
				</comboedit>
			</item>
			<rowsdefinition>
				<row position="9" size="100%"></row>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="300"></column>
				<column position="2" size="100%"></column>
			</columnsdefinition>
		</group>
	</part>

	<part name="prtOperateriPuni">
		<data command="spMPTrgOpr" name="dtOperater">
			<parameter name="@action" value="1"/>
			<parameter name="@LnTrgovinaOperateriId" value="$operaterid"/>
		</data>
		<data command="select o.*, password as sifra, l.odjelid as odjelid  from ssoperateri o join LnTrgovinaOperateri l on o.operateriid=l.operateriid where o.operateriid = @operaterid and trgovinaid = @trgovinaid" type="text" name="dtOperaterIz">
			<parameter name="@operaterid" value="$operaterid"/>
			<parameter name="@trgovinaid" value="Global.$Id"/>
		</data>
		<data command="select operateriid ,rtrim(ltrim(naziv)) as naziv from ssoperateri order by naziv" type="text"  name="dtOperateri">
		</data>
		<data command="spMPDajTrgovina" name="dtTrgovine">
			<parameter name="@operateriid" value="@@operateriid"/>
		</data>
		<data command="select odjelid, naziv from odjel" type="text"  name="dtOdjel">
		</data>
		<data command="select grupeid , naziv from ssgrupe order by 2" type="text" name="dtGrupa">
		</data>
	</part>

	<part name="prtLogin">
		<group rows="3" cols="2">
			<item row="1" col="1" aption="Ime" textposition="left">
				<textedit name="txtIme" datavalue="~dtLogin.@naziv">
				</textedit>
			</item>
			<item row="2" col="1" aption="Lozinka" textposition="left">
				<textedit name="txtLozinka" datavalue="~dtLogin.@password">
				</textedit>
			</item>
			<rowsdefinition>
				<row position="3" size="100%"></row>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="150"></column>
				<column position="2" size="100%"></column>
			</columnsdefinition>
		</group>	
	</part>

	<part name="prtLoginPuni">
		<data command="select * from mpkasalogin where mpkasaloginid = @login" type="text" name="dtLogin">
			<parameter name="@login" value="$mpkasaloginid"/>
		</data>
		<data command="spmpMenuLOgin" name="dtDodajLogin">
			<parameter name="@action" value="5"/>
			<parameter name="@naziv" value="#txtIme"/>
			<parameter name="@password" value="#txtLozinka"/>
			<parameter name="@mpkaseid" value="$kasaid"/>
		</data>
		<data command="spmpMenuLOgin" name="dtIzmjeniLogin">
			<parameter name="@action" value="6"/>
			<parameter name="@naziv" value="#txtIme"/>
			<parameter name="@password" value="#txtLozinka"/>
			<parameter name="@mpkasaloginid" value="$mpkasaloginid"/>
			<parameter name="@mpkaseid" value="$kasaid"/>
		</data>
		<data command="spmpMenuLOgin" name="dtBrisiLogin">
			<parameter name="@action" value="8"/>
			<parameter name="@mpkasaloginid" value="$mpkasaloginid"/>
		</data>
	</part>

</parts>