<parts>
	<part name="prtDobavljacRoba">
		<group rows ="5" cols="4">
			<item row="1" col="1" colspan="2" caption="Partner" textposition="left" >
				<searchedit name="srcPartner" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtPartneri" datavalue="~dtNapuni.@partneriid" datatext="~dtNapuni.@Partner">
				</searchedit>
			</item>
			<item row="2" col="1" colspan="2" caption="Roba" textposition="left" >
				<searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" datavalue="~dtNapuni.@robaid" datatext="~dtNapuni.@naziv">
					<event type="valuechanged">
						<action type="datarun reader" value="~dtKontrolaRoba">
						</action>
						<action type="control populate" value="#grdObjekti" />
						<action type="control enable" value="#btnSave" if="#srcRoba!='null'"/>
						<action type="control disable" value="#btnSave" if="#srcRoba=='null'"/>
					</event>
				</searchedit>
			</item>
			<item row="3" col="1" caption="Šifra kod dobavljača" textposition="left" >
				<textedit name="txtSifra" datavalue="~dtNapuni.@sifra">
				</textedit>
			</item>
			<item row="3" col="2"   caption="" textposition="right" >
				<checkedit caption="Dodaj u asortiman MP" value ="0" name="chAsoMp"  datavalue="~dtNapuni.@doduMP" >
				</checkedit>
			</item>
			<item row="4" col="1" colspan="3" caption="Tipovi objekata" textposition="top" >
				<grid name="grdObjekti" dataname="~dtObjekti" netgenfields="true" keyfield="parasortimantipid">
					<fields>
						<field name="Naziv1900" />
						<field name="Asortiman1200" editable="true" edittype="checkbox"/>
						<field name="Količina1200" editable="true" formatstring="n2"/>
						<field name="Pakovanje1000" />
					</fields>
				</grid>
			</item>		
		</group>	
	</part>
</parts>