<parts>

	<part name="prtZaglavlje">
		<group rows="9" cols="4" caption="Zaglavlje:">
			<item row="1" col="1" colspan="2" caption="Broj" textposition="left" >
				<textedit name="txtBroj" readonly="true" datavalue="~dtQureyGla.@broj" fontbold="True">
				</textedit>
			</item>
			<item row="2" col="1" colspan="2" caption="Datum" textposition="left" >
				<dateedit name="datDok" required="true" value="now" datavalue="~dtQureyGla.@DatumDok">
				</dateedit>
			</item>
			<item row="3" col="1" colspan="2" caption="Vrsta dokumenta" textposition="left" >
				<comboedit name="txtVrsta" required="true" displayfield="opis" valuefield="vrstadokid" dataname="~dtNapuniVrsDok" datavalue="~dtNapuniVrsDok.@vrstadokid">
				</comboedit>
			</item>
			<item row="4" col="1" colspan="" caption="Vrijedi dana" textposition="left" >
				<textedit name="txtDana" readonly="" datavalue="~dtQureyGla.@vrijedidana" fontbold="" format="n0" value="0">
				</textedit>
			</item>
			<item row="5" col="1" colspan="2" caption="Partner" textposition="left" >
				<searchedit name="srcPartner" required="true"  fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtOdaberiPartneri" datavalue="~dtQureyGla.@partneriid" datatext="~dtQureyGla.@partner" netgenfields="true">
				<event type="valuechanged">
						<action type="control populate" value="#cmbMjIsporuke"/>
					</event>
				</searchedit>
			</item>
			<item row="6" col="1" colspan="2" caption="MP Kupac" textposition="left" >
				<textedit name="txtKupac" readonly="" datavalue="~dtQureyGla.@napomena1" fontbold="" format="">
				</textedit>
			</item>
			<item row="7" col="1" colspan="2" caption="Napomena" textposition="left" >
				<textedit name="txtNapomena" readonly="" datavalue="~dtQureyGla.@napomena2" fontbold="" format="">
				</textedit>
			</item>
			<item row="1" col="3" colspan="" caption="Način isporuke" textposition="left" >
				<comboedit name="txtNacIspo" required="" displayfield="opis" valuefield="mpnacinisporukeid" dataname="~dtNapuniNacisporuk" datavalue="">
				</comboedit>
			</item>
			<item row="2" col="3" colspan="" caption="Trgovina" textposition="left" >
				<comboedit name="cmbTrgovina" required="true" displayfield="Naziv" valuefield="TrgovinaId" dataname="~dtNapuniTrgovinu" datavalue="~dtQureyGla.@trgovinaid">
					<event type="valuechanged">
						<action type="control populate" value="#cmbOdgOsoba"/>
						<action type="control populate" value="#cmbNacPlac"/>
						<action type="control populate" value="#txtVrsta"/>
					</event>
				</comboedit>
			</item>			
			<item row="3" col="3" colspan="" caption="Odgovorna osoba" textposition="left" >
				<comboedit name="cmbOdgOsoba" required="true" displayfield="Naziv" valuefield="OsobeId" dataname="~dtNapuniOsobu" datavalue="~dtQureyGla.@osobeid" >
				</comboedit>
			</item>
			<item row="4" col="3" colspan="" caption="Način plaćanja" textposition="left" >
				<comboedit name="cmbNacPlac" required="" displayfield="Naziv" valuefield="kntnacinplacid" dataname="~dtnacPlac" datavalue="~dtQureyGla.@nacinplacanjaid" >
				</comboedit>
			</item>
			<item row="5" col="3" colspan="" caption="Mjesto isporuke" textposition="left" >
				<comboedit name="cmbMjIsporuke" required="" displayfield="Mjesto" valuefield="parstruid" dataname="~dtMjIsporuke" datavalue="~dtQureyGla.@lokacijeid" >
				</comboedit>
			</item>
			<item row="6" col="3" colspan="" caption="Rok isporuke" textposition="left" >
				<dateedit name="datRok" required="" value="now" datavalue="~dtQureyGla.@dat2isporuke">
				</dateedit>
			</item>
			<item row="7" col="3" colspan="" caption="Rabat" textposition="left" >
				<textedit name="txtRabat" readonly="" datavalue="~dtQureyGla.@rabat" fontbold="" format="n2" value="0">
				</textedit>
			</item>
			<item row="8" col="3"  textposition="left">
				<checkedit caption="Trošak dostave" value="0" name="cheDostava" datavalue="~dtQureyGla.@trosakdostave">
				</checkedit>
			</item>
			

			<rowsdefinition>
				<row position="9" size="100%"/>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="200"/>
				<column position="2" size="200"/>
				<column position="3" size="400"/>
				<column position="4" size="100%"/>
			</columnsdefinition>


		</group>
	</part>

	<part name="prtStavke">
		<group rows="5" cols="4">
			<item row="1" col="1" colspan="2" caption="Roba" textposition="left" >
				<searchedit name="srcRoba"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" visible="true" fontbold="True" datavalue="~dtStavka.@robaid" datatext="~dtStavka.nazivRobe">
					<event type="valuechanged">
						<action type="datarun reader" value="~dtKontrolaRoba" if="#srcRoba!='null'&amp;&amp;@@formname==frmIzmjeni"/>
						<action type="datarun reader" value="~dtDajArtikl" if="#srcRoba!=999999999&amp;&amp;#srcRoba!='null'&amp;&amp;@@formname==frmIzmjeni">
							<action type="control value" value="txtJm" >
								<parameter value="~dtDajArtikl.@jmnaziv" />
							</action>
							<action type="control value" value="txtRab">
								<parameter value="~dtDajArtikl.@rabatdp" />
							</action>
							<action type="control value" value="txtNC">
								<parameter value="~dtDajArtikl.@nabcijena" />
							</action>
							<action type="control value" value="txtMar">
								<parameter value="~dtDajArtikl.@marza" />
							</action>
							<action type="control value" value="txtMPC">
								<parameter value="~dtDajArtikl.@mpcijena" />
							</action>
						</action>
						<action type="control enable" value="#btnAdd" if="#srcRoba!='null'&amp;&amp;#srcRoba!='999999999'&amp;&amp;#txtKol!=0"/>
						<action type="control disable" value="#btnAdd" else=""/>
						<action type="form open" value="frmKol" if="~dtDajArtikl.@indpak!=1&amp;&amp;#srcRoba!='null'&amp;&amp;#srcRoba!='999999999'&amp;&amp;@@formname==frmIzmjeni">
							<parameter name="kolpakovanje" value="~dtDajArtikl.@kolpakovanje"/>
							<action type="control value" value="txtKol" if="~dtDajArtikl.@indpak!=1" >
								<parameter value="$Ukupno" />
							</action>
						</action>

					</event>
				</searchedit>
			</item>
			
			<item row="2" col="1" caption="Količina" textposition="left" >
				<textedit name="txtKol" datavalue="~dtStavka.@kolicina" value="0" format="n4">
					<event type="leave">
						<action type="variable value">
							<parameter name="action" value="4" type="int" />
						</action>
						<action type="datarun reader" value="~dpKalkuliraj">
							<action type="control value" value="txtRab">
								<parameter value="~dpKalkuliraj.@rabatdp" />
							</action>
							<action type="control value" value="txtNC">
								<parameter value="~dpKalkuliraj.@nabcijena" />
							</action>
							<action type="control value" value="txtMar">
								<parameter value="~dpKalkuliraj.@marzap" />
							</action>
							<action type="control value" value="txtMPC">
								<parameter value="~dpKalkuliraj.@mpcijena" />
							</action>
							<action type="control value" value="txtMPI">
								<parameter value="~dpKalkuliraj.@mpvrijednost" />
							</action>
						</action>
						<action type="control enable" value="#btnAdd" if="#srcRoba!='null'&amp;&amp;#srcRoba!='999999999'&amp;&amp;#txtKol!=0"/>
						<action type="control disable" value="#btnAdd" else=""/>
					</event>
				</textedit>
			</item>
			<item row="2" col="2" caption="JM" textposition="left" >
				<textedit name="txtJm" datavalue="~dtStavka.@JM" enabled="false">
				</textedit>
			</item>
			<item row="2" col="3" colspan="" caption="Rok isporuke" textposition="left" >
				<dateedit name="datisporuke" required="" value="now" datavalue="" enabled="">
				</dateedit>
			</item>
			<item row="3" col="1" caption="MP cijena" textposition="left" >
				<textedit name="txtMPC" datavalue="~dtStavka.@mpcijena" value="0" format="n2" enabled="false">
				</textedit>
			</item>
			
			<item row="3" col="2" caption="MP iznos" textposition="left" >
				<textedit name="txtMPI" datavalue="~dtStavka.@mpvrijednost" value="0" format="n2" enabled="false">
				</textedit>
			</item>
			<item row="4" col="1" caption="Rabat %" textposition="left" >
				<textedit name="txtRab" datavalue="~dtStavka.@rabatdp" value="0" format="n2">
					<event type="leave">
						<action type="variable value">
							<parameter name="action" value="7" type="int" />
						</action>
						<action type="datarun reader" value="~dpKalkuliraj">
							<action type="control value" value="txtRab">
								<parameter value="~dpKalkuliraj.@rabatdp" />
							</action>
							<action type="control value" value="txtNC">
								<parameter value="~dpKalkuliraj.@nabcijena" />
							</action>
							<action type="control value" value="txtMar">
								<parameter value="~dpKalkuliraj.@marzap" />
							</action>
							<action type="control value" value="txtMPC">
								<parameter value="~dpKalkuliraj.@mpcijena" />
							</action>
							<action type="control value" value="txtMPI">
								<parameter value="~dpKalkuliraj.@mpvrijednost" />
							</action>
						</action>
					</event>
				</textedit>
			</item>
			<item row="3" col="3"  textposition="right">
				<checkedit caption="Kalkulacija cijene" value="0" name="chekalk" datavalue="" enabled="false">
				</checkedit>
			</item>
			<item row="4" col="2" caption="Marža %" textposition="left" >
				<textedit name="txtMar" datavalue="~dtStavka.@marzap" value="0" format="n2" enabled="false">
				</textedit>
			</item>
			<item row="4" col="3" caption="Nab. cijena" textposition="left" >
				<textedit name="txtNC" datavalue="~dtStavka.@nabcijena" value="0" format="n2" enabled="false">
				</textedit>
			</item>		
			<rowsdefinition>
				<row position="5" size="100%"/>
			</rowsdefinition>
			<columnsdefinition>
				<column position="1" size="250"/>
				<column position="2" size="250"/>
				<column position="3" size="250"/>
				<column position="4" size="100%"/>	
			</columnsdefinition>
		</group>
	</part>

	<part name="prtGridStavke">
		<group rows="1" cols="1" caption="Stavke">
			<item row ="1" col="1" height="300">
				<grid name="grdStavke" dataname="dtQureyStavke" netgenfields="true" keyfield="mpponudadetid" multiselect="true" showcheckboxes="true">
					<event type="doubleclick">
						<action type="form open" value="frmIzmjeniStavku">
							<parameter name="id" value="$id"/>
							<parameter name="detid" value="#grdStavke.@mpponudadetid"/>
							<parameter name="datdok" value="#datdok"/>
						</action>
						<action type="control populate" value="#grdStavke"/>
						<action type="datarun reader" value="~dtIznos">
							<action type="control refreshvalue" value="#txtNabU"/>
							<action type="control refreshvalue" value="#txtMPU"/>
						</action>
						<action type="control focus" value="#srcRoba" />
					</event>
					<fields>

					</fields>
					<menu>
						<menuitem name="menDelItem" caption="Obriši stavku" sort="1">
							<action type="datarun scalar" value="~dtDeleteProvjera">
								<parameter name="promet" value="~dtDeleteProvjera.@mpcijenaprometid"/>
							</action>
							<action type="message" value="'Stavka se ne može brisati jer je za nju vezana promjena MPC !'" if="$promet!='null'">
								<action type="variable value">
									<parameter name="check" value="1" type="int"/>
								</action>
							</action>
							<action type="datarun nonquery" value="~dpDeleteStavka" if="$check!=1"/>
							<action type="variable value">
								<parameter name="check" value="0" type="int"/>
							</action>
							<action type="control populate" value="#grdStavke"/>
							<action type="datarun reader" value="~dtIznos">
								<action type="control refreshvalue" value="#txtNabU"/>
								<action type="control refreshvalue" value="#txtMPU"/>
							</action>
							<action type="control disable" value="#btnCorrect, #btnDelete " if="#grdStavke.rowcount==0"  />
							<action type="control focus" value="#srcRoba" />
						</menuitem>
						<menuitem name="menChgItem" caption="Izmjeni stavku" sort="2">
							<action type="form open" value="frmIzmjeniStavku">
								<parameter name="id" value="$id"/>
								<parameter name="detid" value="#grdStavke.@mpponudadetid"/>
								<parameter name="datdok" value="#datdok"/>
							</action>
							<action type="control populate" value="#grdStavke"/>
							<action type="datarun reader" value="~dtIznos">
								<action type="control refreshvalue" value="#txtNabU"/>
								<action type="control refreshvalue" value="#txtMPU"/>
							</action>
							<action type="control focus" value="#srcRoba" />
						</menuitem>

					</menu>
				</grid>
			</item>
		</group>
	</part>

</parts>