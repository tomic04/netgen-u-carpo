<root>
	<form name="frmIzmjeni" caption="Izmjena podatka o članovima" width="400">
		<event type="init">
			<action type="datarun reader" value="~dtNapuni"/>
		</event>
		<event type="load">
			<action type="control disable" value="#txtSifra" />
			<action type="control disable" value="#txtBodovi" />
		</event>
		<layout>
			<part name="prtPodaci" path="prtMPClan.xml" />
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSave" caption="Spremi">
						<event type="click">
						<action type="datarun nonquery" value="~dtIzmjeni">
						</action>
						<action type="form close" />
					</event>
					</button>
					
					<button name="btnClose" caption="Odustani" type="cancel" ></button>
				</buttons>
			</panelbuttons>
			<datalist>
				<part name="prtStore" path="prtMPClan.xml" />
				<data command="spMPClanoviAzurNG" name="dtNapuni">
					<parameter name="@action" value="5" />
					<parameter name="@id" value="$id" />
				</data>
				<data command="spMPClanoviAzurNG" name="dtIzmjeni">
					<parameter name="@action" value="1" />
					<parameter name="@id" value="$id" />
					<parameter name="@operateriid" value="@@operateriid" />
					<parameter name="@trgovinaid" value="#cmbTrgovina" />
					<parameter name="@sifra" value="#txtSifra" />
					<parameter name="@ime" value="#txtIme" />
					<parameter name="@prezime" value="#txtPrezime" />
					<parameter name="@adresa" value="#txtAdresa" />
					<parameter name="@mjestaid" value="#cmbMjesto" />
					<parameter name="@mail" value="#txtMail" />
					<parameter name="@datumrodjenja" value="#datDatum" />
					<parameter name="@hrspremeid" value="#cmbSprema" />
					<parameter name="@brojclanovaobitelji" value="#txtObitelj" />
					<parameter name="@BrojDjece" value="#txtDjeca" />
					<parameter name="@BrojOI" value="#txtOI" />
					<parameter name="@spol" value="#cmbSpol" />
					<parameter name="@Brojtelefon" value="#txtTel" />
					<parameter name="@brojmob" value="#txtMob" />
					<parameter name="@pocetnibodovi" value="#txtBodovi" />
					<parameter name="@napomena" value="#txtNapomena" />
					<parameter name="@partneriid" value="#srcPartner" />
					<parameter name="@infoptt" value="1" if="#cheInfo=='True'"/>
					<parameter name="@infoptt" value="0" else=""/>						
				</data>
			</datalist>
	</form>
</root>