<root>

	<form name="frmIzmjeniStavku" caption="Izmjena stavke: {~dtStavka.@nazivRobe}, dokumenta: {parent.~dtQureyGla.@Broj}" width="300">
		<event type="init">
			<action type="datarun reader" value="global.dtVrstaDok"/>
			<action type="datarun reader" value="~dtStavka" />
			<action type="datarun reader" value="~dtPodaciRoba" />
			<action type="datarun reader" value="~dpKalkuliraj" />

		</event>
		<event type="load">
			<action type="control disable" value="#srcRoba" />
		</event>
		<event type="shown">
		</event>

		<layout>
			<part name="prStavke" path="prtMPOtpremnica2.xml" />
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnIspravi" caption="Ispravi" dock="left">
					<event type="click">
						<action type="datarun nonquery" value="~dtIspraviStavku">

							<action type="control refreshvalue" value="parent.#grdStavke">
							</action>
							<action type="datarun nonquery" value="~dpKalkuliraj"/>
							<action type="datarun nonquery" value="~dpProracun"/>
							<action type="datarun reader" value="~dtIznos">
								<action type="control refreshvalue" value="parent.#txtPlatiti">
								</action>
							</action>
						</action>
						
						<action type="form close" />

					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel" dock="right">
				</button>

			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPInsertGlaIdetNG" name="dtIspraviStavku">
				<parameter name="@action" value="4"/>
				<parameter name="@id" value="$id"/>
				<parameter name="@maloprodajadetid" value="$detid"/>
				<parameter name="@kolicinaulaz" value="#txtKolicina"/>
				<parameter name="@rabatdp" value="#txtRabatdp" />
				<parameter name="@robaid" value="#srcRoba"/>
				<parameter name="@mpcijena" value="#txtMPC"/>
				<parameter name="@mpcijenaorg" value="#txtOMPC"/>
				<parameter name="@NabCijena" value="#txtNabavna"/>
				<parameter name="@opisdet" value="#txtNapomenadp"/>
				<parameter name="@porukagreska" value="1"/>
			</data>

			<data command="spMPQueryGlaIDetNG" name="dtStavka">
				<parameter name="@action" value="5"/>
				<parameter name="@id" value="$detid"/>
			</data>
			<data command="spmpKalkiNG" name="dpKalkuliraj">
				<parameter name="@action" value="2"/>
				<parameter name="@robaid" value="#srcRoba"/>
				<parameter name="@kolicinaulaz" value="#txtKolicina"/>
				<parameter name="@rabatdp" value="#txtRabatdp"/>
				<parameter name="@nabcijena" value="#txtNabavna"/>
				<parameter name="@mpcpov" value="#txtMPC"/>
			</data>
			<data command="spPKdajTroskoveNG" name="dpProracun">
				<parameter name="@id" value="$id"/>
				<parameter name="@trgovinaid" value="$trgovinaid"/>
				<parameter name="@datum" value="$datumdok"/>
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid"/>
				<parameter name="@dodaj" value="1"/>
			</data>
			<data command="spMPDajArtikalNG" name="dtPodaciRoba">
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@TrgovinaId" value="$trgovinaid" />
				<parameter name="@datum" value="$datumdok" />
				<parameter name="@partneriid" value="$partnerid" />
				<parameter name="@skladisteid" value="$skladiste"/>
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>
			<data command ="select (cmpiznos * @predznak) - (rabatiznos * @predznak) - @ucesce as cmpiznos, (select vrstatrg from trgovina where trgovinaid = @trgovinaid ) as mpizvp from maloprodajagla where maloprodajaglaid = @id" type="text" name="dtIznos">
				<parameter name="@predznak" value="~dtVrstaDok.@predznak" />
				<parameter name="@ucesce" value="$ucesce" />
				<parameter name="@trgovinaid" value="$trgovinaid" />
				<parameter name="@id" value="$id" />
			</data>
		</datalist>

	</form>
</root>