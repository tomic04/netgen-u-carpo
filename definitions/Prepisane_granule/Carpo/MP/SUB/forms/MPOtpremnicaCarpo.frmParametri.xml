<root>
	<form name="frmParametri" caption="Upišite uvjete za prikaz" width="300">
		<event type="load">
			<action type="control value" value="#datOd">
				<parameter value="parent.$DatumOd" />
			</action>
			<action type="control value" value="#datDo">
				<parameter value="parent.$DatumDo" />
			</action>
			<action type="control value" value="#cmbTrgovina">
				<parameter value="parent.$TrgovinaId" />
			</action>
			<action type="control value" value="#cmbStatus">
				<parameter value="parent.$Status" />
			</action>
		</event>
		<layout>
			<group rows="4" cols="1">
				<item row="1" col="1" caption="Datum od:">
					<dateedit name="datOd" required="false" />
				</item>
				<item row="2" col="1" caption="Datum do:">
					<dateedit name="datDo" required="false" />
				</item>
				<item row="3" col="1" caption="Trgovina:">
					<comboedit name="cmbTrgovina" required="false" valuefield="TrgovinaId" displayfield="Opis" dataname="~dtNapuniTrgovinu" />
				</item>
				<item row="4" col="1" caption="Status:">
					<comboedit name="cmbStatus" required="false" valuefield="Status" displayfield="Naziv" dataname="~dtNapuniStatus" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSearch" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="parent.DatumOd" value="#datOd" />
							<parameter name="parent.DatumDo" value="#datDo" />
							<parameter name="parent.TrgovinaId" value="#cmbTrgovina" />
							<parameter name="parent.Status" value="#cmbStatus" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPDajTrgovina" name="dtNapuniTrgovinu">
				<parameter	name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="M" />			
			</data>
			<data command="select 1 as status,&apos;Nezaključen&apos; as naziv union all select 2 as status,&apos;Zaključen &apos; as naziv" type="text" name="dtNapuniStatus">
			</data>
		</datalist>

	</form>
</root>