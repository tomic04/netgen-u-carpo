<root>
	<form name="frmDodaj" caption="Unos novog dokumenta MP web ponude" width="400">
		<event type="init">
			<action type="datarun reader" value="global.dtVrstaDok"/>
		</event>
		<event type="load"/>
		<event type="shown"/>
		<layout>
			<part name="prtZaglavlje" path="prtMPMPPonudaWebCarpo.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="Stavke">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtInsert">
							<parameter name="maloprodajaglaid" />
						</action>
						<action type="form close" />
						<action type="form open" value="frmIzmjeni">
							<parameter name="id" value="$maloprodajaglaid"/>
						</action>
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPDajTrgovinaNG" name="dtNapuniTrgovinu">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="V" />
			</data>
			<data command="spmpDajVrstaDok" name="dtNapuniVrsDok">
				<parameter name="@aktivni" value="1" />
				<parameter name="@sifra" value="~dtVrstaDok.@Sifra" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
			</data>
			<data command="spMPDajOsobe" name="dtNapuniOsobu">
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
			</data>
			<data command="spTraziPartneri" name="dtOdaberiPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data>
			<data command="spMPPonudaInsertGlaIdetNG" name="dtInsert">
				<parameter name="@action" value="1" />
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@status" value="1" />
				<parameter name="@vrstadokid" value="#txtVrsta" />
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@osobeid" value="#cmbOdgOsoba" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@lokacijeid" value="#cmbMjIsporuke" />
				<parameter name="@rabat" value="#txtRabat" />
				<parameter name="@napomena1" value="#txtKupac" />
				<parameter name="@napomena2" value="#txtNapomena" />
				<parameter name="@rokisporuke" value="#datRok" />
				<parameter name="@vrijedidana" value="#txtDana" />
				<parameter name="@trosakdostave" value="#cheDostava" />
				<parameter name="@kntnacinplacid" value="#cmbNacPlac" />
			</data>
			<data command="select k.kntnacinplacid, k.naziv  from mpnacnaplate n inner join kntnacinplac k on n.kntnacinplacid = k.kntnacinplacid where trgovinaid = @trgovinaid" type="text" name="dtnacPlac">
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
			</data>
			<data command="select parstruid, p.naziv as mjesto from parstru p inner join mjesta m on p.mjestaid=m.mjestaid where p.partneriid=@partneriid" type="text" name="dtMjIsporuke">
				<parameter name="@partneriid" value="#srcPartner" />
			</data>
			<data command="select mpnacinisporukeid,  opis  from MPNacinisporuke" type="text" name="dtNapuniNacisporuk"/>
		</datalist>
	</form>
</root>