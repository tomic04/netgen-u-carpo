<root>
	<form name="frmDonos" caption="Donos robe sa" width="300">
		<event type="init">
			<action type="datarun reader" value="global.dtVrstaDok"/>
		</event>
		<layout>
			<group rows="2" cols="1">
				<item row="1" col="1">
					<button name="btnTerminal" caption="Donos sa terminala">
						<event type="click">
							<action type="datarun nonquery" value="~dtTerminal">
								<action type="form open" value="frmDonosTerminal" if="~dtTerminal.rowcount&gt;0">
									<parameter name="id" value="$id"/>
									<parameter name="trgovinaid" value="$trgovinaid"/>
									<parameter name="datumdok" value="$datumdok"/>
								</action>
							</action>
							<action type="datarun reader" value="~dtIznos">
								<action type="control refreshvalue" value="parent.#txtPlatiti"/>
							</action>
							<action type="control populate" value="parent.#grdStavke"/>
							<action type="form close" />
						</event>
					</button>
				</item>
				<item row="2" col="1">
					<button name="btnRoba" caption="Donos iz robe">
						<event type="click">
							<action type="form open" value="frmDonosRoba">
								<parameter name="id" value="$id"/>
								<parameter name="trgovinaid" value="$trgovinaid"/>
								<parameter name="datumdok" value="$datumdok"/>
								<parameter name="skladiste" value="$skladiste"/>
							</action>
							<action type="datarun reader" value="~dtIznos">
								<action type="control refreshvalue" value="parent.#txtPlatiti"/>
							</action>
							<action type="control populate" value="parent.#grdStavke"/>
							<action type="form close" />
						</event>
					</button>
				</item>
				<rowsdefinition>
					<row position="1" size="40" />
					<row position="2" size="40" />
				</rowsdefinition>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPPrijenosTerminalNG" name="dtTerminal">
				<parameter name="@action" value="11"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@trgovinaid" value="$trgovinaid"/>
				<parameter name="@trgovinacijena" value="$trgovinaid"/>
				<parameter name="@datumod" value="$datumdok"/>
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid"/>
			</data>
			<data command ="select (cmpiznos * @predznak) - (rabatiznos * @predznak) - @ucesce as cmpiznos, (select vrstatrg from trgovina where trgovinaid = @trgovinaid ) as mpizvp from maloprodajagla where maloprodajaglaid = @id" type="text" name="dtIznos">
				<parameter name="@predznak" value="~dtVrstaDok.@predznak" />
				<parameter name="@ucesce" value="$ucesce" />
				<parameter name="@trgovinaid" value="$trgovinaid" />
				<parameter name="@id" value="$id" />
			</data>
		</datalist>
	</form>
</root>