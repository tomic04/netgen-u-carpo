<root>
	<form name="frmIzmjeni" caption="Izmjena dokumenta MP Otpremnice {~dtQureyGla.@Broj}" width="300">
		<event type="init">
			<action type="datarun reader" value="global.dtVrstaDok"/>
			<action type="datarun reader" value="~dtQureyGla" />
			<action type="variable value">
				<parameter name="maloprodajaglaid" value="~dtQureyGla.@maloprodajaglaid" type="int" />
			</action>
			<action type="variable value" if ="$partneriid=='null'">
				<parameter name="$partneriid" value="~dtQureyGla.@partneriid"/>
			</action>
			<action type="variable value">
				<parameter name="skladisteid" value="~dtQureyGla.@skladisteid"/>
			</action>
			<action type="datarun reader" value="~dtQureyStavke" />
			<action type="datarun reader" value="~dtNapuniVrsDok"/>
			<action type="datarun reader" value="~dtUcesce"/>
			<action type="datarun reader" value="~dtLokacija"/>
			<action type="datarun reader" value="~dtIznos"/>


		</event>

		<event type="load">
			<action type="control populate" value="#grdStavke"/>
			<action type="control visible" value="#txtUcesce"  >
				<parameter value="true" if="~dtUcesce.@ucesce==1"/>
			</action>
			<action type="control disable" value="#btnAdd" if="#srcRoba=='null'||#txtKolicina==0"/>
			<action type="control disable" value="#btnCorrect, #btnDelete " if="#grdStavke.rowcount==0"  />

		</event>

		<event type="shown">

		</event>

		<layout>
			<group rows="2" cols="1" groupbordervisible="false">
				<group row="1" col="1" rows="1" cols="1" groupbordervisible="false">
					<part name="prtZaglavlje" path="prtMPOtpremnicaCarpo.xml" />
				</group>
				<group row="2" col="1" rows="4" cols="2" groupbordervisible="false">
					<group row="1" col="1" rows="1" cols="1">
						<part name="prStavke" path="prtMPOtpremnicaCarpo.xml" />
					</group>
					<group row="2" col="1" rows="1" cols="3">

						<item row="1" col="1">
							<button name="btnAdd" caption="Dodaj">
								<event type="click">
									<action type="datarun nonquery" value="~dtDodaj"/>
									<action type="datarun nonquery" value="~dpProracun"/>
									<action type="control populate" value="#grdStavke" />
									<action type="datarun reader" value="~dtIznos">
										<action type="control refreshvalue" value="#txtPlatiti"/>
									</action>
									<action type="control refreshvalue" value="#srcRoba, #txtKolicina, #txtRabatdp, #txtNapomenadp" />
									<action type="control value" value="#txtJM">
										<parameter value=""/>
									</action>
									<action type="control value" value="#txtMPC">
										<parameter value="0"/>
									</action>
									<action type="control value" value="#txtMPV">
										<parameter value="0"/>
									</action>
									<action type="control value" value="#txtMarza">
										<parameter value="0"/>
									</action>
									<action type="control value" value="#txtNabavna">
										<parameter value="0"/>
									</action>
									<action type="control enable" value="#btnCorrect, #btnDelete " if="#grdStavke.rowcount!=0"  />
									<action type="control disable" value="#btnAdd" if="#srcRoba=='null'||#txtKolicina==0"/>
								</event>
							</button>

						</item>
						<item row="1" col="2"></item>
						<item row="1" col="3"></item>
						<rowsdefinition>
							<row position="1" size="40" /> 
						</rowsdefinition>
					</group>
					<group row="3" col="1" rows="1" cols="5">
						<group row="1" col="1" rows="1" cols="1" colspan="4" groupbordervisible="false">
							<part name="prtUrediStavku" path="prtMPOtpremnica2.xml" />
						</group>
						<group row="1" col="5" rows="1" cols="1" groupbordervisible="false">
							<group row ="1" col="4" rows ="4" cols="1" groupbordervisible="false">
								<item row ="1" col="1" rowsize="40">
									<button name="btnCorrect" caption="Ispravi">
										<event type="click">
											<action type="form open" value="frmIzmjeniStavku">
												<parameter name="id" value="$id"/>
												<parameter name="detid" value="#grdStavke.@maloprodajadetid"/>
												<parameter name="trgovinaid" value="#cmbTrgovina"/>
												<parameter name="datumdok" value="#datDok"/>
												<parameter name="partnerid" value="#srcPartner"/>
												<parameter name="ucesce" value="#txtUcesce"/>
												<parameter name="skladiste" value="$skladisteid"/>
											</action>
										</event>
									</button>
								</item>
								<item row ="2" col="1">
									<button name="btnDelete" caption="Obriši">
										<event type="click">
											<action type="confirm" value="Želite li sigurno obrisati stavku {#grdStavke.@Naziv3000}?"/>
											<action type="datarun nonquery" value="~dpDeleteStavka">
											</action>
											<action type="control populate" value="#grdStavke"/>
											<action type="datarun nonquery" value="~dpProracun"/>
											<action type="datarun reader" value="~dtIznos">
												<action type="control refreshvalue" value="#txtPlatiti"/>
											</action>
											<action type="control disable" value="#btnCorrect, #btnDelete " if="#grdStavke.rowcount==0"  />
										</event>
									</button>
								</item>
								<item row ="3" col="1">
									<button name="btnPDT" caption="Donesi">
										<event type="click">
											<action type="form open" value="frmDonos">
												<parameter name="id" value="$id"/>
												<parameter name="trgovinaid" value="#cmbTrgovina"/>
												<parameter name="datumdok" value="#datDok"/>
												<parameter name="skladiste" value="$skladisteid"/>
												<parameter name="rabat" value="#txtRabat"/>
												<parameter name="ucesce" value="#txtUcesce"/>
											</action>
										</event>
									</button>
								</item>
								<item row ="4" col="1"></item>
								<rowsdefinition>
									<row position="1" size="40" /> 
									<row position="2" size="40" />
									<row position="3" size="40" />
								</rowsdefinition>
							</group>
						</group>
					</group>
					<group row="4" col="1" rows="1" cols="3" groupbordervisible="false">
						<item row="1" col="1" caption="ZA PLATITI (bez PDV-a):" textposition="left" >
							<textedit name="txtPlatiti" datavalue="~dtIznos.@cmpiznos" fontbold="True" readonly="true" format="n2">
							</textedit>
						</item>
						<item row="1" col="2"></item>
						<item row="1" col="3"></item>
					</group>
					
				</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtUpdateGla">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spmpDajVrstaDok" name="dtNapuniVrsDok">
				<parameter name="@aktivni" value="1" />
				<parameter name="@sifra" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>
			<data command="spMPDajTrgovinaNG" name="dtNapuniTrgovinu">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="M" />
			</data>
			<data command="spMPDajOsobe" name="dtNapuniOsobu">
			</data>
			<data command="spTraziPartneri" name="dtOdaberiPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
			<data  command="smmpbrojdanaisporukepartnera" name="dtIsporukaPartner">
				<parameter name="@lokacijeid" value="#cmbTrgovina" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@datumdok" value="#datDok" />
			</data>
			<data  command="spMPDajDatumIsporukeMPPonude" name="dtIsporukaDana">
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@broj" value="#txtDanValuta" />
			</data>
			<data command="select parstruid as parstruid, naziv as naziv from parstru where partneriid=@partneriid" type="text"  name="dtNapuniLokaciju">
				<parameter name="@partneriid" value="$partneriid" />
			</data>
			<data command="select parstruid as parstruid, naziv as naziv from parstru where parstruid=@parstruid and partneriid=@partneriid" type="text"  name="dtLokacija">
				<parameter name="@parstruid" value="~dtQureyGla.@lokacijeid" />
				<parameter name="@partneriid" value="$partneriid" />
			</data>
			<data command="select pronacinisporukeid, naziv from pronacinisporuke order by naziv" type="text" name="dtNapuniIsporuku">
			</data>
			<data command="spMPInsertGlaIdetNG" name="dtInsertGla">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@status" value="1" />
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@osobeid" value="#cmbOdgOsoba" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@lokacijeid" value="#cmbLokacija" />
				<parameter name="@rabat" value="#txtRabat" />
				<parameter name="@napomena" value="#txtNapomena" />
				<parameter name="@datumvalute" value="#datDatumValuta" />
				<parameter name="@ucesce" value="#txtUcesce" />
				<parameter name="@pronacinisporukeid" value="#cmbIsporuka" />
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>
			<data command="spMPInsertGlaIdetNG" name="dtDodaj">
				<parameter name="@action" value="3"/>
				<parameter name="@robaid" value="#srcRoba"/>
				<parameter name="@id" value="$id"/>
				<parameter name="@NabCijena" value="#txtNabavna" />
				<parameter name="@kolicinaulaz" value="#txtKolicina" />
				<parameter name="@mpcijena" value="#txtMPC" />
				<parameter name="@mpcijenaorg" value="#txtOMPC" />
				<parameter name="@rabatdp" value="#txtRabatdp" />
				<parameter name="@opisdet" value="#txtNapomenadp" />
				<parameter name="@porukagreska" value="1"/>
			</data>
			<data command="spMPInsertGlaIdetNG" name="dtUpdateGla">
				<parameter name="@action" value="2" />
				<parameter name="@id" value="$id" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@napomena" value="#txtNapomena" />
				<parameter name="@osobeid" value="#cmbOdgOsoba" />
				<parameter name="@rabat" value="#txtRabat" />
				<parameter name="@ucesce" value="#txtUcesce" />
				<parameter name="@datumvalute" value="#datDatumValuta" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@lokacijeid" value="#cmbLokacija" />
				<parameter name="@status" value="1" />
				<parameter name="@ProNacinIsporukeId" value="#cmbIsporuka" />
			</data>
			<data command="select coalesce((select varset from pubvars where varime like 'MPOtpremnicaUcesce'),0) as ucesce" type="text" name="dtUcesce">
			</data>
			<data command="spMPQueryGlaIDetNG" name="dtQureyGla">
				<parameter name="@action" value="3" />
				<parameter name="@id" value="$id" />
				<parameter name="@operateriid" value="@@operaterid" />
			</data>
			<data command="spMPQueryGlaIDetNG" name="dtQureyStavke" >
				<parameter name="@action" value="2" />
				<parameter name="@id" value="$id" />
				<parameter name="@operateriid" value="@@operaterid" />
				<parameter name="@nenc" value="$nenc" />
			</data>

			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@trazi" value="#srcRoba.text" />
			</data>
			<data command ="select (cmpiznos * @predznak) - (rabatiznos * @predznak) - @ucesce as cmpiznos, (select vrstatrg from trgovina where trgovinaid = @trgovinaid ) as mpizvp from maloprodajagla where maloprodajaglaid = @id" type="text" name="dtIznos">
				<parameter name="@predznak" value="~dtVrstaDok.@predznak" />
				<parameter name="@ucesce" value="~dtQureyGla.@ucesce" />
				<parameter name="@trgovinaid" value="~dtQureyGla.@trgovinaid" />
				<parameter name="@id" value="$id" />
			</data>
			<data command="spmpKontrolaOdabraneRobeNG" name="dtKontrolaRoba">
				<parameter name="@robaid" value="#srcRoba" />
			</data>
			<data command="spMPDajArtikalNG" name="dtPodaciRoba">
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@TrgovinaId" value="#cmbTrgovina" />
				<parameter name="@Skladisteid" value="~dtQureyGla.skladisteid" />
				<parameter name="@datum" value="#datDok" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>

			<data command="spmpKalkiNG" name="dpKalkuliraj">
				<parameter name="@action" value="2"/>
				<parameter name="@robaid" value="~dtPodaciRoba.@robaid"/>
				<parameter name="@kolicinaulaz" value="#txtKolicina" />
				<parameter name="@rabatdp" value="#txtRabatdp" />
				<parameter name="@nabcijena" value="~dtPodaciRoba.@nabcijena" />
				<parameter name="@mpcpov" value="~dtPodaciRoba.@mpcijena" />
			</data>
			<data command="spMPInsertGlaIdetNG" name="dpDeleteStavka">
				<parameter name="@action" value="5"/>
				<parameter name="@id" value="$id"/>
				<parameter name="@maloprodajadetid" value="#grdStavke.@maloprodajadetid" />
				<parameter name="@maloprodajaGlaId" value="$id" />
			</data>
			<data command="spPKdajTroskoveNG" name="dpProracun">
				<parameter name="@id" value="$id"/>
				<parameter name="@trgovinaid" value="#cmbTrgovina"/>
				<parameter name="@datum" value="#datDok"/>
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid"/>
				<parameter name="@dodaj" value="1"/>
			</data>

			<data command="spMPInsertGlaIdetNG" name="dtIspraviKolicinu">
				<parameter name="@action" value="4"/>
				<parameter name="@id" value="$id"/>
				<parameter name="@maloprodajadetid" value="#grdStavke.@maloprodajadetid"/>
				<parameter name="@kolicinaulaz" value="#grdStavke.focusedvalue"/>
			</data>
		</datalist>

	</form>
</root>