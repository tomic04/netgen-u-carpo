<root>
	<form name="frmOperaterDodTrg" caption="Dodavanje operatera na trgovinu">
		<event type="load">
			<action type="control value" value="cmbTrgovina">
				<parameter value="global.$id" />
			</action>
			<action type="control disable" value="#cmbTrgovina">
			</action>
		</event>
		<layout>
			<part name="prtOperaterTrg" path="prtMPTrgovinaPortalCarpo.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtDodajOperTrg">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnAdd" caption="Dodaj novog operatera">
					<event type="click">
						<action type="form open" value="frmOperaterDod">
							<parameter name="operaterid" value="#cmbOperater"/>
							<parameter name="trgovinaid" value="#cmbTrgovina"/>
							<parameter name="trgovina" value="#cmbTrgovina.@naziv"/>
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtOperateriPuni" path="prtMPTrgovinaPortalCarpo.xml" />
			<data command="spMPTrgOpr" name="dtDodajOperTrg">
				<parameter name="@action" value="4"/>
				<parameter name="@id" value="global.$Id"/>
				<parameter name="@trgovinaid" value="#cmbTrgovina"/>
				<parameter name="@LnTrgOperId" value="$operaterid"/>
				<parameter name="@operateriid" value="#cmbOperater"/>
				<parameter name="@naziv" value="#cmbOperater.@naziv"/>
				<parameter name="@oib" value="#txtOib"/>
				<parameter name="@sifra" value="#txtSifra"/>
				<parameter name="@odjelid" value="#cmbOdjel"/>
			</data>
		</datalist>
	</form>

	<form name="frmOperaterDod" caption="Unos novog operatera">
		<event type="load">
			<action type="control value" value="txtTrgovina">
				<parameter value="$trgovina" />
			</action>
			<action type="control disable" value="#txtTrgovina">
			</action>
		</event>
		<layout>
			<part name="prtOperater" path="prtMPTrgovinaPortalCarpo.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtDodajOper">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnClose" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtOperateriPuni" path="prtMPTrgovinaPortalCarpo.xml" />
			<data command="spMPTrgOpr" name="dtDodajOper">
				<parameter name="@action" value="9"/>
				<parameter name="@trgovinaid" value="$trgovinaid"/>
				<parameter name="@naziv" value="#txtOperater"/>
				<parameter name="@inicijali" value="#txtInicijal"/>
				<parameter name="@sifra" value="#txtSifra"/>
				<parameter name="@password" value="#txtLozinka"/>
				<parameter name="@grupeid" value="#cmbGrupa"/>
				<parameter name="@odjelid" value="#cmbOdjel"/>
				<parameter name="@oib" value="#txtOib"/>
			</data>
		</datalist>
	</form>

	<form name="frmOperaterIzmTrg" caption="Izmjena operatera na trgovini">
		<event type="init">
			<action type="datarun reader" value="~dtOperater"/>
		</event>
		<event type="load">
			<action type="control disable" value="#cmbTrgovina">
			</action>
			<action type="control disable" value="#cmbOperater">
			</action>
		</event>
		<layout>
			<group rows="2" cols="1">
				<group row="1" col="1" rows="1" cols="1">
					<part name="prtOperaterTrg" path="prtMPTrgovinaPortalCarpo.xml" />
				</group>
				<group row="2" col="1" rows="1" cols="1">
					<item row="1" col="1" textposition="right">
						<checkedit caption="Poslovođa" name="chkPos" datavalue="~dtOperater.@mpmanager">
						</checkedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtIzmjeniOperTrg">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnChange" caption="Izmjeni podatke operatera">
					<event type="click">
						<action type="form open" value="frmOperaterIzm">
							<parameter name="operaterid" value="#cmbOperater"/>
							<parameter name="trgovinaid" value="#cmbTrgovina"/>
							<parameter name="trgovina" value="#cmbTrgovina.@naziv"/>
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtOperateriPuni" path="prtMPTrgovinaPortalCarpo.xml" />
			<data command="spMPTrgOpr" name="dtIzmjeniOperTrg">
				<parameter name="@action" value="2"/>
				<parameter name="@id" value="global.$Id"/>
				<parameter name="@trgovinaid" value="#cmbTrgovina"/>
				<parameter name="@LnTrgOperId" value="$operaterid"/>
				<parameter name="@operateriid" value="#cmbOperater"/>
				<parameter name="@naziv" value="#cmbOperater.@naziv"/>
				<parameter name="@oib" value="#txtOib"/>
				<parameter name="@sifra" value="#txtSifra"/>
				<parameter name="@odjelid" value="#cmbOdjel"/>
				<parameter name="@mpmanager" value="1" if="#chkPos==True"/>
				<parameter name="@mpmanager" value="0" if="#chkPos==False"/>
			</data>
		</datalist>
	</form>

	<form name="frmOperaterIzm" caption="Izmjena operatera">
		<event type="init">
			<action type="datarun reader" value="~dtOperaterIz"/>
		</event>
		<event type="load">
			<action type="control value" value="txtTrgovina">
				<parameter value="$trgovina" />
			</action>
			<action type="control disable" value="#txtTrgovina">
			</action>
		</event>

		<layout>
			<part name="prtOperater" path="prtMPTrgovinaPortalCarpo.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtIzmjeniOper">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnClose" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtOperateriPuni" path="prtMPTrgovinaPortalCarpo.xml" />
			<data command="spMPTrgOpr" name="dtIzmjeniOper">
				<parameter name="@action" value="10"/>
				<parameter name="@trgovinaid" value="$trgovinaid"/>
				<parameter name="@operateriid" value="$operaterid"/>
				<parameter name="@naziv" value="#txtOperater"/>
				<parameter name="@inicijali" value="#txtInicijal"/>
				<parameter name="@sifra" value="#txtSifra"/>
				<parameter name="@password" value="#txtLozinka"/>
				<parameter name="@grupeid" value="#cmbGrupa"/>
				<parameter name="@odjelid" value="#cmbOdjel"/>
				<parameter name="@oib" value="#txtOib"/>
			</data>
		</datalist>
	</form>

	<form name="frmOperaterBrisTrg" caption="Obriši operatera na trgovini">
		<event type="init">
			<action type="datarun reader" value="~dtOperater"/>
		</event>
		<event type="load">
			<action type="control disable" value="#cmbTrgovina">
			</action>
			<action type="control disable" value="#cmbOperater">
			</action>
			<action type="control disable" value="#txtOib">
			</action>
			<action type="control disable" value="#txtSifra">
			</action>
			<action type="control disable" value="#cmbOdjel">
			</action>
		</event>
		<layout>
			<part name="prtOperaterTrg" path="prtMPTrgovinaPortalCarpo.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDel" caption="Obriši">
					<event type="click">
						<action type="datarun nonquery" value="~dtBrisiOperTrg">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnClose" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtOperateriPuni" path="prtMPTrgovinaPortalCarpo.xml" />
			<data command="spMPTrgOpr" name="dtBrisiOperTrg">
				<parameter name="@action" value="3"/>
				<parameter name="@id" value="global.$Id"/>
				<parameter name="@trgovinaid" value="#cmbTrgovina"/>
				<parameter name="@LnTrgOperId" value="$operaterid"/>
				<parameter name="@operateriid" value="#cmbOperater"/>
				<parameter name="@naziv" value="#cmbOperater.@naziv"/>
				<parameter name="@oib" value="#txtOib"/>
				<parameter name="@sifra" value="#txtSifra"/>
			</data>
		</datalist>
	</form>


</root>