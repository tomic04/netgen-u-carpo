<root>
	<form name="frmPoklonDodaj" caption="Poklon bonovi - dodavanje" width="400">
		<event type="init">
			
		</event>
		<layout>
			<part name="prtBodovi" path="prtMPClan.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Dodaj">
					<event type="click">
						<action type="datarun nonquery" value="~dtPoklonAdd">
							<action type="form close" />
						</action>

					</event>
					</button>
				<button name="btnClose" caption="Odustani" type="cancel"></button>
				
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPBodoviPoklonNG" name="dtPoklonAdd">
				<parameter name="@action" value="2" />
				<parameter name="@id" value="$id" />
				<parameter name="@datumdok" value="#datDatumUnosa" />
				<parameter name="@brojbodova" value="#txtBodovi" />
				<parameter name="@napomena" value="#txtNapomenaBodovi" />
			</data>
		</datalist>
	</form>
</root>