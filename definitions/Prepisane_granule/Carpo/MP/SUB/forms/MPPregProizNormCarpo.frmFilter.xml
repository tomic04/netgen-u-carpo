<root>
	<form name="frmFilter" caption="Parametri za filtriranje" width="400">

		<event type="init">
		</event>

		<layout>
			<group rows="5" cols="2" groupbordervisible="false">
				<item row="1" col="1" caption="Proizvod" textposition="left">
					<searchedit name="srcProizvod"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtProizvod" savevalue="session" netgenfields="true">
					</searchedit>
				</item>
				<item row="2" col="1" caption="Roba iz normativa" textposition="left">
					<searchedit name="srcRoba"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" savevalue="session"  netgenfields="true">
					</searchedit>
				</item>
				<item row="3" col="1" caption="Status normativa" textposition="left">
					<comboedit name="cmbStatus" displayfield="Naziv" valuefield="Id" dataname="~dtStatus" savevalue="session" >
					</comboedit>
				</item>
				<item row="4" col="1" caption="" textposition="right">
					<checkedit caption="NC=0" value ="0" name="cheNC" savevalue="session" >
				</checkedit>
				</item>
				<rowsdefinition>
					<row position="5" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="400"></column>
					<column position="2" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnOk" caption="Pokaži">
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="Dohvat podataka..." sleep="2000">
						<action type="variable value" value="Global.$proizvod">
							<parameter value="#srcProizvod"/>
						</action>
						<action type="variable value" value="Global.$roba">
							<parameter value="#srcRoba"/>
						</action>
						<action type="variable value" value="Global.$status">
							<parameter value="#cmbStatus"/>
						</action>
						<action type="variable value" value="Global.$nc">
							<parameter value="#cheNC"/>
						</action>
						<action type="form close">
						<action type="control populate" value="parent.#grdMaster"/>
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" >
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPRobaZaMPNG" name="dtProizvod">
				<parameter name="@trazi" value="#srcProizvod.text" />
				<parameter name="@mpsirovina" value="0" />
			</data>
			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trazi" value="#srcRoba.text" />
			</data>
			<data command="select 0 as id, 'Svi' as naziv union all select 1 as id, 'Aktivni' as naziv union all select 2 as id, 'Neaktivni' as naziv" type="text" name="dtStatus">
			</data>
		</datalist>

	</form>
</root>