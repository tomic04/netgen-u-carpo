<root>
	<form name="frmPoklonIzmjeni" caption="Poklon bonovi - izmjena" width="400">
		<event type="init">
			<action type="datarun reader" value="~dtPoklonDohvati" />
		</event>
		<layout>
			<part name="prtBodovi" path="prtMPClan.xml" />
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Izmjeni">
				<event type="click">
						<action type="datarun nonquery" value="~dtPoklonEdit">
							<action type="form close" />
						</action>

					</event></button>
				<button name="btnClose" caption="Odustani" type="cancel"></button>
				
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="select mpclanoviprometid, datumdok, brojbodova, napomena from MPClanoviPromet where MPClanoviPrometId = @MPClanoviPrometId"  type="text" name="dtPoklonDohvati">
				<parameter name="@MPClanoviPrometId" value="$MPClanoviPrometId" />
			</data>
			<data command="spMPBodoviPoklonNG" name="dtPoklonEdit">
				<parameter name="@action" value="3" />
				<parameter name="@id" value="$id" />
				<parameter name="@MPClanoviPrometId" value="$MPClanoviPrometId" />
				<parameter name="@datumdok" value="#datDatumUnosa" />
				<parameter name="@brojbodova" value="#txtBodovi" />
				<parameter name="@napomena" value="#txtNapomenaBodovi" />
			</data>
		</datalist>
	</form>
</root>