<root>
	<form name="frmKopiraj" caption="Kopiranje dokmenta u novi dokument" width="300">

		<event type="init">
			<action type="datarun reader" value="~dtNapuni"/>
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<layout>
			<group rows="3" cols="1">
				<group rows="4" cols="2" row="1" col="1" caption="SA:">
					<item row="1" col="1" caption="Broj dokumenta:">
						<textedit name="txtBroj" datavalue="~dtNapuni.@brojdok" readonly="true"/>
					</item>
					<item row="2" col="1" caption="Datum dokumenta">
						<dateedit name="datSa" datavalue="~dtNapuni.@datum" readonly="true"/>
					</item>
					<item row="3" col="1" caption="Dobavljač:">
						<textedit name="txtDob" datavalue="~dtNapuni.@partner" readonly="true"/>
					</item>
					<item row="4" col="1" caption="Sa trgovine:">
						<comboedit name="cmbTrgovinaSa" required="false" valuefield="TrgovinaId" displayfield="Opis" dataname="~dtTrgovina" datavalue="~dtNapuni.@trgovinaid" readonly="true"/>
					</item>
					<columnsdefinition>
						<column position="1" size="250"/>
						<column position="2" size="100%"/>
					</columnsdefinition>
				</group>
				<group rows="3" cols="2" row="2" col="1" caption="NA:">
					<item row="1" col="1" caption="Na trgovinu:">
						<comboedit name="cmbTrgovinaNa" valuefield="TrgovinaId" displayfield="Opis" dataname="~dtTrgovina" required="true"/>
					</item>
					<item row="2" col="1" caption="Na datum">
						<dateedit name="datNa" value="now" required="true"/>
					</item>
					<rowsdefinition>
						<row position="3" size="100%"/>
					</rowsdefinition>
					<columnsdefinition>
						<column position="1" size="250"/>
						<column position="2" size="100%"/>
					</columnsdefinition>
				</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnCopy" caption="Kopiraj">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtKopiraj"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="select maloprodajaglaid , g.trgovinaid, g.broj as brojdok , p.naziv as partner , datumdok as datum from maloprodajagla g inner join partneri p on g.partneriid =p.partneriid where g.maloprodajaglaid = @id" type="text" name="dtNapuni">
				<parameter name="@id" value="$id" />
			</data> 
			<data command="spmpdajtrgovinaNG" name="dtTrgovina">
				<parameter	name="@operateriid" value="@@operateriid" />		
			</data>
			<data command="spmpkopirajDokMp" name="dtKopiraj">
				<parameter	name="@action" value="1" />
				<parameter	name="@id" value="$id" />		
				<parameter	name="@operateriid" value="@@operateriid" />
				<parameter	name="@trgovinaid" value="#cmbTrgovinaNa" />
				<parameter	name="@datumdok" value="#datNa" />		
			</data>
		</datalist>

	</form>
</root>