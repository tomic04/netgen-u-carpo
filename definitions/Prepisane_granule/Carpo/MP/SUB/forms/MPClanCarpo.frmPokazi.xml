<root>
	<form name="frmPokazi" caption="Kopiraj s postojećeg na novog" width="400">
		<event type="init">
			<action type="datarun reader" value="~dtNapuni"/>
		</event>
		<event type="load">
			<action type="control disable" value="#cmbTrgovina" />
			<action type="control disable" value="#txtSifra" />
			<action type="control disable" value="#txtIme" />
			<action type="control disable" value="#txtPrezime" />
			<action type="control disable" value="#txtAdresa" />
			<action type="control disable" value="#cmbMjesto" />
			<action type="control disable" value="#txtMail" />
			<action type="control disable" value="#cheInfo" />
			<action type="control disable" value="#datDatum" />
			<action type="control disable" value="#cmbSprema" />
			<action type="control disable" value="#txtObitelj" />
			<action type="control disable" value="#txtDjeca" />
			<action type="control disable" value="#txtOI" />
			<action type="control disable" value="#cmbSpol" />
			<action type="control disable" value="#txtTel" />
			<action type="control disable" value="#txtMob" />
			<action type="control disable" value="#txtBodovi" />
			<action type="control disable" value="#txtNapomena" />
			<action type="control disable" value="#srcPartner" />
		</event>
		<layout>
			<group rows="2" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Datum otvaranja" textposition="left">
					<dateedit name="datDatumOtv" datavalue="~dtNapuni.@DatumOtvaranja" enabled="false">
				</dateedit>
				</item>
				<group row="2" col="1" rows="1" cols="1" groupbordervisible="false">
					<part name="prtPodaci" path="prtMPClan.xml" />
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnCopy" caption="Kopiraj">
					<event type="click">
					
							<action type="form open" value="frmKopiraj">
								<parameter name="id" value="~dtNapuni.@mpclanoviid"/>
								<action type="form close" />
						</action>
						</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" ></button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtStore" path="prtMPClan.xml" />
			<data command="spMPClanoviAzurNG" name="dtNapuni">
				<parameter name="@action" value="5" />
				<parameter name="@id" value="$id" />
			</data>
		</datalist>
	</form>
</root>