<root>
	<form name="frmOdRabat" caption="Izmjena rabata na stavkama" width="300">

		<event type="init">
		</event>

		<event type="load">
			<action type="control populate" value="#grdTotal"/>
		</event>

		<event type="shown">
		</event>

		<layout>
			<group rows="3" cols="3">
				<item row="1" col="1" caption="Rabat" textposition="left" >
					<textedit name="txtRab" datavalue="" value="0" format="n2" >
					</textedit>
				</item>
				<item row="2" col="1" colspan="2" caption="Roba" textposition="top" >
					<grid name="grdTotal" dataname="dtGrid" netgenfields="true" keyfield="robaid">
						<fields>

						</fields>
					</grid>
				</item>
				<rowsdefinition>
					<row position="3" size="100%"/>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="150"/>
					<column position="2" size="300"/>
					<column position="3" size="100%"/>
				</columnsdefinition>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtPopDodaj"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="select d.robaid, userid as [Šifra1200], naziv as [Roba5000], rabatdp as [Rabat %1000] from TotalGenMultiSelectTemp t 
				inner join maloprodajadet d on t.id = d.maloprodajadetid
			   inner join roba r on d.robaid = r.robaid where t.operateriid = @operateriid" type="text" name="dtGrid">
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="update maloprodajadet set rabatdp = @popust where maloprodajadetid in (select id from TotalGenMultiSelectTemp where operateriid = @operateriid)" type="text" name="dtPopDodaj">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@popust" value="#txtRab" />
			</data>
		</datalist>

	</form>
</root>