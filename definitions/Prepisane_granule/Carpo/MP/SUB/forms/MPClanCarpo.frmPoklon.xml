<root>
	<form name="frmPoklon" caption="Poklon bonovi" width="400">
		<event type="load">
			<action type="control populate" value="#grdPoklon"/>
		</event>
		<layout>
			<group rows="1" cols="1" groupbordervisible="false">
				<item row="1" col="1">
					<grid name="grdPoklon" dataname="~dtPoklon" netgenfields="true" keyfield="mpclanoviprometid">
						<fields>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnClose" caption="Odustani" type="cancel"></button>
				<button name="btnAdd" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmPoklonDodaj">
							<parameter name="id" value="$id"/>
						</action>
						<action type="control refreshvalue" value="#grdPoklon"/>
					</event>
				</button>
				<button name="btnChange" caption="Izmjeni">
					<event type="click">
					<action type="datarun scalar" value="~dtProvjera">
						<parameter name="vrijednost"/>
					</action>
						<action type="form open" value="frmPoklonIzmjeni" if="$vrijednost!='Ne možete ispravljati podatke prethodne godine !'">
							<parameter name="id" value="$id"/>
							<parameter name="MPClanoviPrometId" value="#grdPoklon.@mpclanoviprometid"/>
						</action>
						<action type="control refreshvalue" value="#grdPoklon"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMPBodoviPoklonNG" name="dtPoklon">
				<parameter name="@action" value="1" />
				<parameter name="@id" value="$id" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="if cast(year(@datum) as char(4)) &lt; cast(year(getdate()) as char(4)) begin exec spRaiserror 69001, 'Ne možete ispravljati podatke prethodne godine !' end" type="text" name="dtProvjera">
				<parameter name="@datum" value="#grdPoklon.@Datum" />
			</data>
		</datalist>
	</form>
</root>