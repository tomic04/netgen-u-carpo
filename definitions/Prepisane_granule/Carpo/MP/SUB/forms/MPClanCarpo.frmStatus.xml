<root>
	<form name="frmStatus" caption="Promjena statusa člana" width="400">
		<event type="init">
			<action type="datarun reader" value="~dtNapuni"/>
		</event>
		<layout>
			<group rows ="4" cols="1">
				<item row="1" col="1" caption="Šifra" textposition="left">
					<textedit name="txtSifra" readonly="true" datavalue="~dtNapuni.@Sifra">
					</textedit>
				</item>
				<item row="2" col="1" caption="Ime" textposition="left">
					<textedit name="txtIme" readonly="true" datavalue="~dtNapuni.@Ime">
					</textedit>
				</item>
				<item row="3" col="1" caption="Prezime" textposition="left">
					<textedit name="txtPrezime" readonly="true" datavalue="~dtNapuni.@Prezime">
					</textedit>
				</item>
				<item row="4" col="1" caption="Status" textposition="left">
					<comboedit name="cmbStatus" readonly="true" displayfield="naziv" valuefield="statusid" dataname="~dtStatus" datavalue="~dtNapuni.@Status">
					</comboedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOk" caption="Promjeni">
					<event type="click">
						<action type="confirm" value="Želite li sigurno promjeniti status člana ?"/>
						<action type="datarun nonquery" value="~dtPromjeniStatus">
						<action type="form close" />
						</action>
					</event>							
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" ></button>
			</buttons>
		</panelbuttons>
		<datalist>
			<part name="prtStore" path="prtMPClan.xml" />
			<data command="spMPClanoviAzurNG" name="dtNapuni">
				<parameter name="@action" value="5" />
				<parameter name="@id" value="$id" />
			</data>
			<data command="spMPClanoviAzurNG" name="dtPromjeniStatus">
				<parameter name="@action" value="2" />
				<parameter name="@id" value="$id" />
			</data>
		</datalist>
	</form>
</root>