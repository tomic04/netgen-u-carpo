<root>
	<form name="frmFilter" caption="Parametri za filtriranje" width="400">

		<event type="init">
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Partner" textposition="left">
					<searchedit name="srcPartner" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtPartneri" savevalue="session" required="true">
					</searchedit>
				</item>
				<item row="2" col="1" caption="Roba" textposition="left">
					<searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" savevalue="session">
					</searchedit>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnShow" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="global.$partneriid" value="#srcPartner" />
							<parameter name="global.$robaid" value="#srcRoba" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trgovinaid" value="null"/>
				<parameter name="@trazi" value="#srcRoba.text"/>
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
		</datalist>

	</form>
</root>