<root>
	<form name="frmFilter" caption="Parametri za filtriranje" width="400">

		<event type="init">

		</event>

		<layout>
			<group rows="5" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Trgovina" textposition="left">
					<comboedit name="cmbTrgovina" displayfield="Naziv" valuefield="TrgovinaId" dataname="~dtNapuniTrgovinu" savevalue="session" >
					</comboedit>
				</item>
				<item row="2" col="1" caption="Ime" textposition="left">
					<textedit name="txtIme" savevalue="session" >
					</textedit>
				</item>
				<item row="3" col="1" caption="Prezime" textposition="left">
					<textedit name="txtPrezime" savevalue="session" >
					</textedit>
				</item>
				<item row="4" col="1" caption="Šifra člana" textposition="left">
					<textedit name="txtSifra" savevalue="session" >
					</textedit>
				</item>
				<item row="5" col="1" caption="Partner" textposition="left">
					<searchedit name="srcPartner"  fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtOdaberiPartneri" savevalue="session" >
					</searchedit>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnOk" caption="Pokaži">
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="Dohvat podataka..." sleep="2000">
						<action type="variable value" value="Global.$ime">
							<parameter value="#txtIme"/>
						</action>
						<action type="variable value" value="Global.$prezime">
							<parameter value="#txtPrezime"/>
						</action>
						<action type="variable value" value="Global.$sifra">
							<parameter value="#txtSifra"/>
						</action>
						<action type="variable value" value="Global.$trgovinaid">
							<parameter value="#cmbTrgovina"/>
						</action>
						<action type="variable value" value="Global.$partneriid">
							<parameter value="#srcPartner"/>
						</action>
						<action type="form close">
						<action type="control populate" value="parent.#grdMaster"/>
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" >
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPDajTrgovinaNG" name="dtNapuniTrgovinu">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="M" />
			</data>
			<data command="spTraziPartneri" name="dtOdaberiPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data>
			
		</datalist>

	</form>
</root>