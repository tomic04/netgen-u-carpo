<root>
	<form name="frmIzmjeni" caption="Unos novog artikla u asortiman" width="400">

		<event type="init">
			<action type="message" value="'Niste odabrali partnera!'" if="$partneriid==0">
			</action>
			<action type="datarun reader" value="~dtNapuni"/>
		</event>

		<event type="load">
			<action type="control disable" value="#srcPartner"/>
			<action type="control disable" value="#srcRoba"/>
			<action type="control populate" value="#grdObjekti" />
		</event>

		<event type="shown">
			<action type="form close" if="$partneriid==0">
			</action>
		</event>

		<layout>
			<part name="prtDobavljacRoba" path="prtMPAsortimanAzurCarpo.xml" />
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSave" caption="Spremi">
					<event type="click">
						<action type="control foreachrow" value="#grdObjekti">
							<action type="datarun nonquery" value="~dtPocisti">
							</action>
							<action type="datarun nonquery" value="~dtIzmjeni" if="#grdObjekti.Asortiman1200=='True'">
							</action>
						</action>
						<action type="control refresh value" value="parent.#grdMaster" />
						<action type="form close">
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trgovinaid" value="null"/>
				<parameter name="@trazi" value="#srcRoba.text"/>
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
			<data command="select p.naziv as Partner, p.partneriid, sifra1 as sifra1 , r.robaid as robaid, r.naziv as naziv from parasortiman pa inner join partneri p on pa.partneriid = p.partneriid inner join roba r on pa.robaid = r.robaid where parasortimanid = @id" type="text" name="dtNapuni">
				<parameter name="@id" value="$parasortimanid" />
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtObjekti">
				<parameter name="@action" value="11" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@id" value="$parasortimanid" />
			</data>
			<data command="spmpKontrolaOdabraneRobeNG" name="dtKontrolaRoba">
				<parameter name="@robaid" value="#srcRoba" />
			</data> 
			<data command="spMPParAsortimanPregledNG" name="dtPocisti">
				<parameter name="@action" value="13" />
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@partneriid" value="#srcPartner" />
			</data> 
			<data command="spMPParAsortimanPregledNG" name="dtIzmjeni">
				<parameter name="@action" value="2" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@sifra1" value="#txtSifra" />
				<parameter name="@tipid" value="#grdObjekti.@parasortimantipid" />
				<parameter name="@doduMP" value="#chAsoMp" />
				<parameter name="@kolicina" value="#grdObjekti.@Količina1000" />
			</data> 
		</datalist>

	</form>
</root>