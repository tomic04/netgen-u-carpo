<root>
	<form name="frmDodaj" caption="Unos novog dokumenta MP otpremnice" width="400">
		<event type="init">
			<action type="datarun reader" value="global.dtVrstaDok"/>
			<action type="datarun reader" value="~dtNapuniVrsDok"/>
			<action type="datarun reader" value="~dtUcesce"/>
		</event>
		<event type="load">
			<action type="control visible" value="#txtUcesce"  >
				<parameter value="true" if="~dtUcesce.@ucesce==1"/>
			</action>
			<!-- <action type="control enable" value="#txtUcesce"  if="~dtUcesce.@ucesce==1" /> -->
		</event>
		<event type="shown">
		</event>
		
		<layout>
				<part name="prtZaglavlje" path="prtMPOtpremnicaCarpo.xml" />
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="Stavke">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtInsert">
							<parameter name="maloprodajaglaid" />
						</action>
						<action type="form close" />
						<action type="form open" value="frmIzmjeni">
							<parameter name="id" value="$maloprodajaglaid"/>
						</action>
						
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel" >
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spmpDajVrstaDok" name="dtNapuniVrsDok">
				<parameter name="@aktivni" value="1" />
				<parameter name="@sifra" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>
			<data command="spMPDajTrgovinaNG" name="dtNapuniTrgovinu">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="M" />
			</data>
			<data command="spMPDajOsobe" name="dtNapuniOsobu">
			</data>
			<data command="spTraziPartneri" name="dtOdaberiPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
			<data  command="smmpbrojdanaisporukepartnera" name="dtIsporukaPartner">
				<parameter name="@lokacijeid" value="#cmbTrgovina" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@datumdok" value="#datDok" />
			</data>
			<data  command="spMPDajDatumIsporukeMPPonude" name="dtIsporukaDana">
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@broj" value="#txtDanValuta" />
			</data>
			<data command="select parstruid as parstruid, naziv as naziv from parstru where partneriid=@partneriid" type="text"  name="dtNapuniLokaciju">
				<parameter name="@partneriid" value="#srcPartner" />
			</data>
			<data command="select pronacinisporukeid, naziv from pronacinisporuke order by naziv" type="text" name="dtNapuniIsporuku">
			</data>
			<data command="spMPInsertGlaIdetNG" name="dtInsert">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@status" value="1" />
				<parameter name="@datumdok" value="#datDok" />
				<parameter name="@trgovinaid" value="#cmbTrgovina" />
				<parameter name="@osobeid" value="#cmbOdgOsoba" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@lokacijeid" value="#cmbLokacija" />
				<parameter name="@rabat" value="#txtRabat" />
				<parameter name="@napomena" value="#txtNapomena" />
				<parameter name="@datumvalute" value="#datDatumValuta" />
				<parameter name="@ucesce" value="#txtUcesce" />
				<parameter name="@pronacinisporukeid" value="#cmbIsporuka" />
				<parameter name="@sifradok" value="~dtVrstaDok.@Sifra" />
				<parameter name="@vrstadokid" value="~dtVrstaDok.@vrstadokid" />
			</data>
			<data command="select coalesce((select varset from pubvars where varime like 'MPOtpremnicaUcesce'),0) as ucesce" type="text" name="dtUcesce">
			</data>
		</datalist>

	</form>
</root>