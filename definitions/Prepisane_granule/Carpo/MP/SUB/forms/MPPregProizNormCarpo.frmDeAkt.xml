<root>
	<form name="frmDeAkt" caption="(De)Aktiviranje proizvoda i normativa ?" width="400">

		<event type="init">	
			<action type="datarun reader" value="~dtDohvati">	
			</action>
		</event>

		<event type="load">
		</event>

		<event type="shown">
			<action type="control value" value="datDatum" if="#datDatum=='null'">
								<parameter value="now" />
							</action>
		</event>

		<layout>
			<group rows="4" cols="2" groupbordervisible="false">
				<item row="1" col="1" caption="Proizvod" textposition="left">
					<textedit name="txtProizvod" datavalue="~dtDohvati.@naziv" readonly="true">
					</textedit>
				</item>
				<item row="2" col="1" caption="Datum (de)aktiviranja" textposition="left" >
					<dateedit name="datDatum" datavalue="~dtDohvati.@datumod" value="now" required="true">
					</dateedit>
				</item>
				<item row="3" col="1" caption="OBAVIJEST:" textposition="left">
					<labeledit name="lbPoruka" value="U slučaju aktiviranja proizvoda i normativa. \nStari aktivni normativ će biti ugašen." fontcolor="red" fontbold="true">
					</labeledit>
				</item>
				<rowsdefinition>
					<row position="4" size="100%"></row>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="400"></column>
					<column position="2" size="100%"></column>
				</columnsdefinition>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="Spremi">
					<event type="click" >
						<action type="datarun nonquery" value="~dtDeAkt">	
						</action>
						<action type="control refreshvalue" value="parent.#grdMaster"/>
						<action type="form close" />	
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" >
				</button>
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spMPProizvodiGlaIdet" name="dtDohvati">
				<parameter name="@action" value="3"/>
				<parameter name="@mpproizvodiglaid" value="$mpproizvodiglaid"/>
			</data>
			<data command="spMPProizvodiGlaIdet" name="dtDeAkt">
				<parameter name="@action" value="76" />
				<parameter name="@mpproizvodiglaid" value="$mpproizvodiglaid"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@naziv" value="#txtProizvod"/>
				<parameter name="@datumod" value="#datDatum"/>
			</data>
		</datalist>

	</form>
</root>