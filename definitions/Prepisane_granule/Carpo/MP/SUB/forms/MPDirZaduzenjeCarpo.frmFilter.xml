<root>
	<form name="frmFilter" caption="Upišite uvjete za prikaz" width="300">

		<event type="init">
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<layout>
			<group rows="7" cols="2">
				<item row="1" col="1" caption="Datum od:">
					<dateedit name="datOd" required="false" value="now" savevalue="session"/>
				</item>
				<item row="2" col="1" caption="Datum do:">
					<dateedit name="datDo" required="false" value="now" savevalue="session"/>
				</item>
				<item row="3" col="1" caption="Partner:">
					<searchedit name="srcPartner" required="false" fieldvalue="partneriid" fieldtext="NazivId" dataname="~dtPartner" savevalue="session"/>
				</item>
				<item row="4" col="1" caption="Trgovina:">
					<comboedit name="cmbTrgovina" required="false" valuefield="TrgovinaId" displayfield="Opis" dataname="~dtTrgovina" savevalue="session"/>
				</item>
				<item row="5" col="1" caption="Status:">
					<comboedit name="cmbStatus" required="false" valuefield="Status" displayfield="Naziv" dataname="~dtStatus" savevalue="session"/>
				</item>
				<item row="6" col="1" caption="Broj dokumenta:">
					<textedit name="txtBroj" required="false" savevalue="session"/>
				</item>
				<rowsdefinition>
					<row position="7" size="100%"/>
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="250"/>
					<column position="2" size="100%"/>
				</columnsdefinition>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSearch" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="parent.$DatumOd" value="#datOd" />
							<parameter name="parent.$DatumDo" value="#datDo" />
							<parameter name="parent.$Partnerid" value="#srcPartner" />
							<parameter name="parent.$TrgovinaId" value="#cmbTrgovina" />
							<parameter name="parent.$Status" value="#cmbStatus" />
							<parameter name="parent.$BrojDok" value="#txtBroj" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spTraziPartneri" name="dtPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
			<data command="spMPDajTrgovina" name="dtTrgovina">
				<parameter	name="@operateriid" value="@@operateriid" />
				<parameter name="@vrstatrg" value="M" />			
			</data>
			<data command="select 1 as status,&apos;Nezaključen&apos; as naziv union all select 2 as status,&apos;Zaključen &apos; as naziv" type="text" name="dtStatus">
			</data>
		</datalist>

	</form>
</root>