<root>
	<form name="frmDodaj" caption="Unos proizvoda i normativa" width="400">

		<event type="init">
		</event>

		<layout>
			<group rows="2" cols="2" groupbordervisible="false">
				<item row="1" col="1" caption="Proizvod" textposition="left">
					<searchedit name="srcProizvod"  fieldtext="NazivId" fieldvalue="robaid" dataname="~dtProizvod" netgenfields="true">
					</searchedit>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnNorm" caption="Normativ >>">
					<event type="click" >
						<action type="datarun scalar" value="~dtDodaj">
							<parameter name="mpproizvodiglaid" />
						</action>
						<action type="form close" />
						<action type="control refreshvalue" value="parent.#grdMaster"/>
						<action type="form open" value="frmIzmjeni">
							<parameter name="mpproizvodiglaid" value="$mpproizvodiglaid"/>
						</action>
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel" >
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPRobaZaMPNG" name="dtProizvod">
				<parameter name="@trazi" value="#srcProizvod.text" />
			</data>
			<data command="spMPProizvodiGlaIdet" name="dtDodaj">
				<parameter name="@action" value="2" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@Robaid" value="#srcProizvod" />
			</data>
		</datalist>

	</form>
</root>