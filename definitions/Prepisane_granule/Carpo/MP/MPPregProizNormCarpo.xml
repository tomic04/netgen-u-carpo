<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1">


	<form name="frmMaster" type="master" caption="Pregled proizvoda i normativa">


		<event type="init">
			<action type="variable value">
				<parameter name="Global.proizvod" value="0"/>
				<parameter name="Global.roba" value="0"/>
				<parameter name="Global.status" value="0" type="init"/>
				<parameter name="Global.nc" value="0" type="init"/>
			</action>
			<action type="form open" value="frmFilter">
			</action>
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<managerlayout>

			<grid name="grdMaster" type="master" netgenfields="true" keyfield="mpproizvodiglaid" dataname="~dtFiltriraj" showgroupedcolumns="true" showgroupsum="false">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjeni">
						<parameter name="mpproizvodiglaid" value="#grdMaster.@mpproizvodiglaid"/>
					</action>
				</event>
				<fields>
					<field name="!Proizvodid" hidden="true" caption="Proizvod:" groupindex="1"></field>
					<field name="Opis" caption="Opis"></field>
					<field name="Šifra1500" caption="Šifra"></field>
					<field name="Naziv5000" caption="Naziv"></field>
					<field name="JM0900" caption="JM"></field>
					<field name="Količina0900" caption="Količina"></field>
					<field name="NC1000" caption="NC"></field>
					<field name="Datum važenja OD" caption="Datum važenja od"></field>
					<field name="Datum važenja DO" caption="Datum važenja do"></field>
					<field name="Aktivan0900" caption="Aktivan"></field>
					<field name="Ima promet0700" caption="Ima promet"></field>
				</fields>
			</grid>

		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="Filter">
					<event type="click">
						<action type="form open" value="frmFilter"></action>
					</event>
				</button>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodaj"></action>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
							<parameter name="mpproizvodiglaid" value="#grdMaster.@mpproizvodiglaid"/>
						</action>
					</event>
				</button>
				<button name="btnDeAkt" caption="(De)Aktiviraj">
					<event type="click">
						<action type="form open" value="frmDeAkt">
							<parameter name="mpproizvodiglaid" value="#grdMaster.@mpproizvodiglaid"/>
						</action>

					</event>
				</button>
				<button name="btnKopiraj" caption="Kopiraj">
					<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite kopirati ovaj normativ? "/>
							<action type="datarun nonquery" value="~dtKopiraj">
								<action type="control refreshvalue" value="#grdMaster"/>
							</action>
						</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPProizvodiGlaIdet" name="dtFiltriraj">
				<parameter name="@action" value="8" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@robaid" value="Global.$proizvod" />
				<parameter name="@robanormid" value="Global.$roba" />
				<parameter name="@status" value="Global.$status" />
				<parameter name="@nc0" value="Global.$nc" />
			</data>
			<data command="spMPProizvodiGlaIdet" name="dtKopiraj">
				<parameter name="@action" value="22" />
				<parameter name="@MPproizvodiglaid" value="#grdMaster.@mpproizvodiglaid" />
			</data>
		</datalist>

	</form>

	<form name="frmFilter" path="MPPregProizNormCarpo.frmFilter.xml"/>
	<form name="frmDodaj" path="MPPregProizNormCarpo.frmDodaj.xml"/>
	<form name="frmIzmjeni" path="MPPregProizNormCarpo.frmIzmjeni.xml"/>
	<form name="frmDeAkt" path="MPPregProizNormCarpo.frmDeAkt.xml"/>
	<form name="frmKopiraj" path="MPPregProizNormCarpo.frmKopiraj.xml"/>+
	<form name="frmDodajStavku" path="MPPregProizNormCarpo.frmIzmjeni.xml"/>
	<form name="frmBrisiStavku" path="MPPregProizNormCarpo.frmIzmjeni.xml"/>


</root>