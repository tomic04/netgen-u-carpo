<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<root version="1.0.0.1" >

	<form name="frmMaster" type="master" caption="Ažuriranje asortimana dobavljača">

		<event type="init">
			<action type="variable value">
				<parameter name="global.partneriid" value="null" type="int"/>
				<parameter name="global.robaid" value="null" type="int"/>
			</action>
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<managerlayout>

			<tree name="dtTree" dataname="dtTree" key="id" caption="Dobavljači" expandallonload="true">
				<event type="focusedrowchanged">
					<action type="variable value">
						<action type="variable value">
							<parameter name="global.partneriid" value="#dtTree.@value" />
							<parameter name="global.robaid" value="null" />
						</action>
					</action>
					<action type="control populate" value="#grdMaster" />
				</event>
				<fields>
					<field name="caption"/>
				</fields>
			</tree>

			<grid name="grdMaster" type="master" dataname="~dtMaster" key="parasortimanid" netgenfields="true" showcheckboxes="" multiselect="" autopopulate="false">

				<event type="doubleclick">
				</event>
				<event type="focusedrowchanged">
				</event>
				<event type="cellvaluechanged">
					<action type="datarun nonquery" value="~dtEditiraj" />
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>
				<event type="checkedchanged">
				</event>
				<!-->
				<event type="showingeditor">
					<action type="editor allow" value="true" if="" />
				</event>
				-->
				<menu>
					<menuitem name="menFilter" caption="Filtriraj">
						<event type="click">
						</event>
					</menuitem>
				</menu>

				<fields>
					<field name="Aktivno0800" />
					<field name="Šifra robe1100" />
					<field name="Barcode1400" />
					<field name="Naziv robe3500" />
					<field name="Klasifikacija3500" />
					<field name="Dod.klasifikacija3000" />
					<field name="Šifra kod dobavljača1500" />
					<field name="JM0600" />
					<field name="ZG10700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG10700" />
					<!--
					<field name="ZG20700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG20700" />
					<field name="ZG30700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG30700" />
					-->
					<field name="ZG40700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG40700" />
					<field name="ZG50700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG50700" />
					<field name="ZG60700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG60700" />
					<field name="ZG70700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG70700" />
					<field name="ZG80700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG80700" />
					<field name="ZG90700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG90700" />
					<field name="ZG100700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG100700" />
					<field name="ZG110700" editable="true" edittype="checkbox"/>
					<field name="Promet ST10700" />
					<field name="ST10700" editable="true" edittype="checkbox"/>
					<!--
					<field name="Promet ST20700" />
					<field name="ST20700" editable="true" edittype="checkbox"/>
					-->
					<field name="Promet ST30700" />
					<field name="ST30700" editable="true" edittype="checkbox"/>
					<field name="Promet ZG10700" />
					<field name="RI10700" editable="true" edittype="checkbox"/>
					<field name="Promet RI10700" />
					<field name="PU10700" editable="true" edittype="checkbox"/>
					<field name="Promet PU10700" />
					<field name="VZ10700" editable="true" edittype="checkbox"/>
					<field name="Promet VZ10700" />
					<field name="DU10700" editable="true" edittype="checkbox"/>
					<field name="Promet DU10700" />
					<field name="OS10700" editable="true" edittype="checkbox"/>
					<field name="Promet OS10700" />
					<field name="ORG0700" editable="true" edittype="checkbox"/>
					<field name="Promet ORG0700" />
					<field name="SAJ0700" editable="true" edittype="checkbox"/>
					<field name="Promet SAJ0700" />
				</fields>

			</grid>

		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="Uvjeti">
					<event type="click">
						<action type="form open" value="frmFilter">
						</action>
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPTreePartneri" name="dtTree">
				<parameter name="@action" value="3"/>
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtMaster">
				<parameter name="@action" value="1"/>
				<parameter name="@partneriid" value="global.$partneriid"/>
				<parameter name="@robaid" value="global.$robaid"/>
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtKolone">
				<parameter name="@action" value="14"/>
			</data>
			<data command="spMPParAsortimanPregledNG" name="dtEditiraj">
				<parameter name="@action" value="15"/>
				<parameter name="@robaid" value="#grdMaster.@robaid"/>
				<parameter name="@partneriid" value="global.$partneriid"/>
				<parameter name="@lastvalue" value="#grdMaster.focusedvalue"/>
				<parameter name="@editedcolumn" value="#grdMaster.focusedfield"/>
			</data>
		</datalist>

	</form>

	<form name="frmFilter" caption="Parametri za filtriranje" width="400">

		<event type="init">
		</event>

		<event type="load">
		</event>

		<event type="shown">
		</event>

		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Partner" textposition="left">
					<searchedit name="srcPartner" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtPartneri" savevalue="session" required="">
					</searchedit>
				</item>
				<item row="2" col="1" caption="Roba" textposition="left">
					<searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" savevalue="session">
					</searchedit>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnShow" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="global.$partneriid" value="#srcPartner" />
							<parameter name="global.$robaid" value="#srcRoba" />
						</action>
						<!-- <action type="control populate" value="parent.#grdMaster" /> -->
						<action type="form close" />
					</event>
				</button>
				<button name="btnClose" caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMPRobaZaMPNG" name="dtRoba">
				<parameter name="@trgovinaid" value="null"/>
				<parameter name="@trazi" value="#srcRoba.text"/>
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
			</data> 
		</datalist>

	</form>



</root>