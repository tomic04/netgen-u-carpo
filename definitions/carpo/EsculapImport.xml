<root>
    <form type="master">
    <method name="Esculap" dll="Esculap" class="Esculap.Parser" method="Start" />
<!--		<event type="init">
			<action type="variable value">
				<parameter name="global.$Close" value="false" type="bool"/>
			</action>
			<action type="form open" value="frmFilter"/>
			<action type="variable value" value="global.$Close" if="dialogresult==cancel">
				<parameter value="true" type="bool"/>
			</action>
		</event> 
		<event type="shown">
			<action type="form close" if="global.$close==true"/>
		</event> -->
        <managerlayout>
            <grid name="grdMaster" type="master" dataname="dtMaster" multiselect="true">
            </grid>
        </managerlayout>
		<panelbuttons displaycontrolsprint="true"> 
			<buttons> 

				
				<button name="btnImport" caption="Odaberi datoteku" type="add">
					<event type="click">
					<!-- unutar eventa pozivamo akciju tipa method run. U value upisujemo naziv definiran u elementu method linija 6 u xml-u -->
						<action type="method run" value="Esculap">
							<!-- pomoću elementa parameter proslijeđujemo metodi tj. formi parametre koje traži kroz value atribut-->
							<parameter name="server" value="jupiter2012" />
							<parameter name="database" value="Spin20160126" />
							<parameter name="username" value="" />
							<parameter name="password" value="" />
							<parameter name="completedMsg" value="" /> 
							<!--ako je value prazan string - ne obavještava-->
							<parameter name="errorMsg" value="" />
							<!--ako je value prazan string - ne obavještava-->
                        </action>
						<!--<action type="form close"/>-->
						<action type="control populate" value="parent.#grdMaster" />
                    </event>
                </button>
				<button name="btnProknjiži" caption="Proknjiži" >
				</button>           
			</buttons>	
			
		</panelbuttons>
		<datalist>
			<data command="spCKntESCULAPQuery" name="dtMaster">
				<parameter name="@Action" value="0" /> 
			</data>
		</datalist>
	</form>	
	<form caption="Uvezi datoteku" name="frmFilter">
	<method name="Esculap" dll="Esculap" class="Esculap.Parser" method="Start" />
        <panelbuttons>
			<buttons>
				<button name="btnImport" caption="Odaberi datoteku" type="add">
					<event type="click">
					<!-- unutar eventa pozivamo akciju tipa method run. U value upisujemo naziv definiran u elementu method linija 6 u xml-u -->
						<action type="method run" value="Esculap">
							<!-- pomoću elementa parameter proslijeđujemo metodi tj. formi parametre koje traži kroz value atribut-->
							<parameter name="server" value="jupiter2012" />
							<parameter name="database" value="Spin20160126" />
							<parameter name="username" value="" />
							<parameter name="password" value="" />
							<parameter name="completedMsg" value="" /> 
							<!--ako je value prazan string - ne obavještava-->
							<parameter name="errorMsg" value="" />
							<!--ako je value prazan string - ne obavještava-->
                        </action>
						<!--<action type="form close"/>-->
						<action type="control populate" value="parent.#grdMaster" />
                    </event>
                </button>
				<button name="btnOdustani" caption="odustani" type="cancel"/>
            </buttons>
        </panelbuttons>
    </form>
</root>