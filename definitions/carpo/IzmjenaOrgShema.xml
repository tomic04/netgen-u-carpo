<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
	<form name="frmMaster"  type="master" caption="Izmjena organizacijskih shema">
		<event type="init">	
			<action type="datarun scalar" value="Global.~dtIspravakQuery">
				<parameter name="IspravakQuery"/>
			</action>
			<action type="variable value">
				<parameter name="Global.$DatumOd" value="null"  />
				<parameter name="Global.$DatumDo" value="null"  />
				<parameter name="Global.$VrstaDokId" value="null"  />
				<parameter name="Global.$OrgShemaId" value="null"  />
			</action> 
		</event> 
		<event type="load">
			<action type="form open" value="frmFilterForm"/>
			<action type="variable value" value="global.$Close" if="dialogresult==cancel"> 
				<parameter value="true" type="bool"/> 
			</action> 
		</event>
		<event type="shown">
			<action type="form close" if="global.$Close==true"/> 
		</event>
		<managerlayout>
			<grid name="grdMaster" async="true" type="master" multiselect="true" autopopulate="false" key="kntprometid"  dataname="dtMaster" savelayout="true" bestfitonrefresh="true">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjenaOrgSheme" >
						<parameter name="Kntprometid" value="#grdMaster.@Kntprometid"/>
					</action>	
				</event>
				<fields inherited="true">
					<field name="KntPrometId" caption="KntPrometId" visible="false"/>
					<field name="Datum Knjiženja" caption="Datum knjiženja" visible="true"/>
					<field name="Datum Dokumenta" caption="Datum dokumenta" visible="true"/>
					<field name="Konto" caption="Konto" visible="true"/>
					<field name="Naziv Konta" caption="Naziv konta" visible="true"/>
					<field name="Vrsta Dokumenta" caption="Vrsta dokumenta" visible="true"/>
					<field name="Broj Temeljnice" caption="Broj temeljnice" visible="true"/>
					<field name="Opis Knjiženja" caption="Opis knjiženja" visible="true"/>
					<field name="Organizacijska Shema" caption="Organizacijska shema" visible="true"/>
					<field name="Duguje" caption="Duguje" visible="true"/>
					<field name="Potražuje" caption="Potražuje" visible="true"/>
					<field name="Partner" caption="Partner" visible="true"/>
					<field name="Račun" caption="Račun" visibe="true"/>
					<field name="Inicijali" caption="Inicijali" visibel="true"/>
					<field name="Dimenzije" caption="Dimenzije" visible="true"/>
				</fields>				
			</grid>	
		</managerlayout>
		<panelbuttons> 
			<buttons> 
				<button name="btnParametri" caption="Pregled" >
					<event type="click">
						<action type="form open" value="frmFilterForm"/>
					</event>
				</button>
				<button name="btnEditDetalj" caption="Izmijeni" >
					<event type="click">
						<action type="form open" value="frmIzmijeni">
							<parameter name="OrgShemaId" value="#grdMaster.@OrgShemaId"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntOrgshemaIspravakQuery" name="dtMaster" timeout="400">
				<parameter name="@DatumOd" value="Global.$DatumOd" /> 
				<parameter name="@DatumDo" value="Global.$DatumDo" /> 
				<parameter name="@VrstaDokId" value="Global.$VrstaDokId" />  
				<parameter name="@OrgShemaId" value="Global.$OrgShemaId"/> 
				<parameter name="@BrojDok" value="Global.$BrojDok"/> 
				<parameter name="@Konto" value="Global.$Konto"/> 
			</data>
		</datalist>
	</form>
	<form name="frmFilterForm"  caption="Izaberi parametre upita">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<layout textposition="top">
			<group rows="5" cols="2" colspan="2">
				<item col="1" row="1" caption="Datum od:" > 
					<dateedit name="datDatumOd" required="true" savevalue="app">
					</dateedit>
				</item>
				<item col="2" row="1" caption="Datum do:" >
					<dateedit name="datDatumDo" value="now" required="true" savevalue="app">
					</dateedit>
				</item>
				<item col="1" row="2"  caption="Vrsta dokumenta:" colspan="2">
					<comboedit name="cmbVrstaDok" required="true" dataname="~dtVrstaDok" valuefield="VrstaDokId" displayfield="Naziv" datavalue="~dtGet.@VrstaDokId" savevalue="app"/>
				</item>
				<item col="1" row="3"  caption="Organizacijska shema:" colspan="2" >
					<comboedit name="cmbOrgShema" required="true" dataname="~dtOrgShemaFilter" valuefield="OrgShemaId" displayfield="Naziv" datavalue="~dtGet.@OrgShemaId" savevalue="app"/>
				</item>
				<item col="1" row="4"  caption="Dio konta:" >
					<textedit name="txtKonto" savevalue="app" >
					</textedit>
				</item>
				<item col="1" row="5"  caption="Broj dokumenta:" >
					<textedit name="txtBrojDok" savevalue="app"  >
					</textedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPokaži" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="Global.$DatumOd" value="#datDatumOd"  />
							<parameter name="Global.$DatumDo" value="#datDatumDo"  />
							<parameter name="Global.$OrgShemaId" value="#cmbOrgShema" />
							<parameter name="Global.$VrstaDokId" value="#cmbVrstaDok"  />
							<parameter name="Global.$Konto" value="#txtKonto" />		
							<parameter name="Global.$BrojDok" value="#txtBrojDok" />
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntOrgshemaIspravakKontrole" name="dtVrstaDok"> 
				<parameter name="@Action" value="0"/>  
				<parameter name="@VrstaDokId" value="#cmbVrstaDok"/> 
			</data>
			<data command="spCKntOrgshemaIspravakKontrole" name="dtOrgShema"> 
				<parameter name="@Action" value="1"/>  
				<parameter name="@VrstaDokId" value="0"/> 
				<parameter name="@VrstaPromId" value="0"/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
			</data>	
			<data command="spCKntOrgshemaIspravakKontrole" name="dtOrgShemaFilter"> 
				<parameter name="@Action" value="2"/>  
			</data>		
			<data command="spCKntOrgshemaIspravakQuery" name="dtIspravakQuery"> 
			</data>		
		</datalist>
	</form>
	<form name="frmIzmijeni" caption="Izmijeni">
		<event type="shown">
			<action type="control value" value="#cmbOrgShema">
				<parameter value="$OrgShemaId" />
			</action>
		</event> 
		<layout textposition="top">	
			<group rows="1" cols="1" colspan="2">
				<item col="1" row="1"  caption="Organizacijska shema:" >	
					<comboedit name="cmbOrgShema" required="true" autopopulate="true" dataname="~dtOrgShemaFilter" valuefield="OrgShemaId" displayfield="Naziv" savevalue="app"/>
				</item>	
			</group>
		</layout>  
		<panelbuttons> 
			<buttons> 
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<!-- <action type="variable value"> -->
							<!-- <parameter name="Global.$OrgShemaId" value="#cmbOrgShema" /> -->
						<!-- </action> -->
						<action type="datarun nonquery" value="~dtDohvatKntPromet"/>
						<action type="form close"/>
						<action type="control populate keepfocus" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons> 
		<datalist>
			<data command="spCKntOrgshemaIspravakKontrole" name="dtOrgShemaFilter"> 
				<parameter name="@Action" value="2"/>  
			</data>	
			<data command="spCKntOrgshemaIspravakAzur" name="dtGet"> 	
				<parameter name="@Action" value="0"/>  	
				<parameter name="@Kntprometid" value="#grdMaster.@kntprometid"/> 
			</data>			
			<data command="spCKntOrgshemaIspravakAzur" name="dtDohvatKntPromet"> 
				<parameter name="@Action" value="2"/>
				<parameter name="@selectedids" value="parent.#grdMaster.selectedids"/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/> 			
			</data>	
		</datalist>	
	</form>
	<form name="frmIzmjenaOrgSheme" caption="Izmjena organizacijske sheme">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<event type="shown">
			<action type="control disable" value="#txtKonto,#txtNazivKonta,#txtRacun, #txtOpis"/>
		</event> 
		<layout textposition="top">	
			<group rows="5" cols="1" colspan="2">	
				<item col="1" row="1"  caption="Konto:">
					<textedit name="txtKonto"  savevalue="app" datavalue="~dtGet.@Konto">
					</textedit>
				</item>
				<item col="1" row="2"  caption="Naziv konta:">
					<textedit name="txtNazivKonta"  savevalue="app" datavalue="~dtGet.@Partner" >
					</textedit>
				</item>
				<item col="1" row="3"  caption="Račun:">
					<textedit name="txtRacun"  savevalue="app" datavalue="~dtGet.@Racun">
					</textedit>
				</item>
				<item col="1" row="4"  caption="Opis:">
					<textedit name="txtOpis"  savevalue="app" datavalue="~dtGet.@Opis">
					</textedit>
				</item>
				<item col="1" row="5"  caption="Organizacijska shema:" >	
					<comboedit name="cmbOrgShema" required="true" autopopulate="true" dataname="~dtOrgShemaFilter" datavalue="~dtGet.@OrgShemaId" valuefield="OrgShemaId" displayfield="Naziv" savevalue="app"/>
				</item>	
			</group>
		</layout>  
		<panelbuttons> 
			<buttons> 
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtUpdateKntPromet"/>
						<action type="control populate keepfocus" value="parent.#grdMaster"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntOrgshemaIspravakKontrole" name="dtOrgShemaFilter">
				<parameter name="@Action" value="2"/>
			</data>
			<data command="spCKntOrgshemaIspravakAzur" name="dtGet"> 	
				<parameter name="@Action" value="0"/> 	
				<parameter name="@Kntprometid" value="$kntprometid"/>
			</data>	
			<data command="spCKntOrgshemaIspravakAzur" name="dtUpdateKntPromet"> 	
				<parameter name="@Action" value="1"/> 	
				<parameter name="@Kntprometid" value="$Kntprometid"/> 
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/> 
			</data>	
		</datalist>	
	</form>
</root>