<?xml version="1.0" encoding="utf-8"?>
<root version="1.0.0.1" loglevel="4">
	<form name="frmZakljucakRS" path="KnjigaIraRS.frmZakljucakRS.xml"/>
	<form name="frmKnjigaIraRSInsert" path="KnjigaIraRS.frmKnjigaIraRSInsert.xml"/>
	<form name="frmAnalitika" path="KnjigaIraRS.frmAnalitika.xml"/>	
	<!--forme iz temeljnica-->
	<form name="frmTemEdit" path="Temeljnice.frmTemEdit.xml"/>	
	<form name="frmTemStavka" path="Temeljnice.frmTemStavka.xml"/>
	<form name="frmTemStavkaEdit" path="Temeljnice.frmTemStavkaEdit.xml"/>	
    <form name="frmTemUra" path="Temeljnice.frmTemUra.xml"/>
    <form name="frmTemIra" path="Temeljnice.frmTemIra.xml"/>	
	<form name="frmMaster" type="master" caption="Knjiga izlaznih računa">
	<event type="init">
			<action type="datarun reader" value="~dtDrvoPozicija"/>
			<action type="datarun reader" value="~dtBlokada"/>
			<action type="datarun reader" value="~dtTekGodina"/>
			<!--BLOKADA-->
			<action type="variable value">
				<parameter name="Global.$BlokadaOd" value="~dtBlokada.@Od" type="date"/>
				<parameter name="Global.$BlokadaDo" value="~dtBlokada.@Do" type="date"/>
			</action>
		</event>
		<event type="load">
			<action type="variable value" >
				<parameter name="PozDrvoZak" value="~dtDrvoPozicija.@Poz" />
				<parameter name="Odustani" value="false" type="bool" />
				<parameter name="NoviId" value="0" type="int"/>
				<parameter name="Godina" value="~dtTekGodina.@TekGod"/>
			</action>
 			<action type="control expand" value="#tree">
				<parameter name="key" value="$Godina"/>
			</action> 
			<action type="control focus" value="#tree">
				<parameter value="$PozDrvoZak"/>
			</action>
		</event>
		<event type="shown">
			<!-- <action type="control disable" value="#btnProknjizi"/> -->
			<action type="datarun scalar" value="~dtNasId">
				<parameter name="global.NasId"/>
			</action>
		</event>
		<managerlayout>
			<tree name="tree" dataname="~dtDrvo" parentfield="ParentId" expandlast="false" caption="Vremenska podjela" key="Id" savevalue="app">
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava"/> 
				</event>				
				<fields>
					<field name="Naziv"/>
				</fields>
			</tree>
			<grid name="grdGlava" dataname="~dtGlava" type="master" fieldsmartspaces="false" bestfitonrefresh="true" async="true" key="FaktureId" multiselect="true" savelayout="true" keyfield="FaktureId" searchfield="FaktureId" wordwrap="true"> 				
				<event type="focusedrowchanged">
					<action type="menu enable" value="#menDokument" if="#grdGlava.@IndGlk==1&amp;&amp;#grdGlava.@KntTemId!=null"/>
					<action type="menu disable" value="#menDokument" else=""/>
					<action type="control disable" value="#btnIzmijeni, #btnObrisi" if="#grdGlava.rowcount==0"/>
					<action type="control enable" value="#btnIzmijeni, #btnObrisi" else=""/>
                    <action type="control disable" value="#btnZak,#btnPonZak" if="#grdGlava.rowcount==0"/>
                    <action type="control enable" value="#btnZak,#btnPonZak" elseif="#grdGlava.rowcount!=0"/>					
					<action type="control disable" value="#btnObrisi" if="#grdGlava.@PartneriId==global.$NasId&amp;&amp;#grdGlava.@StatusKnj==1"/>
					<action type="control enable" value="#btnObrisi" else=""/>             			
					<action type="control populate" value="#grdDetalj"/>
				</event>
				<event type="doubleclick">
					<action if="#grdGlava.rowcount!=0&amp;&amp;#grdGlava.@FaktureId!=null">
						<part name="prtIraIzmijeni" path="prtKnjigaIraRS.xml"/>
					</action>				
				</event>
				<event type="keydown">
					<!--INSERT-->
					<action if="key==45">
						<part name="prtIraUnesi" path="prtKnjigaIraRS.xml"/>
					</action>
					<!--ENTER-->
					<action if="key==13">
						<action if="#grdGlava.rowcount!=0&amp;&amp;#grdGlava.@FaktureId!=null">
							<part name="prtIraIzmijeni" path="prtKnjigaIraRS.xml"/>
						</action>
						<action elseif="#grdGlava.rowcount==0">
							<part name="prtIraUnesi" path="prtKnjigaIraRS.xml"/>
						</action>
					</action>
					<!--DELETE-->
					<action if="key==46">
						<action if="#grdGlava.rowcount!=0&amp;&amp;#grdGlava.@FaktureId!=null">
							<part name="prtIraObrisi" path="prtKnjigaIraRS.xml"/>
						</action>
					</action>
				</event>
				<menu>
					<menuitem name="menDokument" caption="Dokument" sort="1">
						<event type="click">
							<action type="form open" value="frmTemEdit">
								<parameter name="KntTemId" value="#grdGlava.@KntTemId"/>
								<parameter name="IraInd" value="1"/>						
							</action>
							<action type="control populate keepfocus" value="#grdGlava" />
						</event>
					</menuitem>					
				</menu>
				<fields inherited="true">
					<field name="Poredak" visible="false"/>
				</fields>
				<styles>
					<style name="fontcolor" value="black"/>
					<style name="backgroundcolor" value="#CFCFD7" if="#grdGlava.@Broj=='ZA OBRAČUN UKUPNO:'||#grdGlava.@Broj=='KUMULATIV SA:'"/>
                    <style name="bold" value="true" if="#grdGlava.@Broj=='ZA OBRAČUN UKUPNO:'||#grdGlava.@Broj=='KUMULATIV SA:'"/>
                    <style name="italic" value="true" if="#grdGlava.@indglk==0"/>
					<style name="fontcolor" value="blue" if="#grdGlava.@indglk==0"/>
					<style name="italic" value="true" if="#grdGlava.@indglk==2"/>
					<style name="fontcolor" value="red" if="#grdGlava.@indglk==2"/> 
					<!--crveni ako nema poreznih stavki na URI, u tom slučaju nema k.StatusKnj-->
					<style name="fontcolor" value="red" if="#grdGlava.@StatusKnj==null"/>
					<!-- samo polje Partner ako je unos ručni-->
					<style name="fontcolor" value="red" if="#grdGlava.@PartneriId==global.$NasId&amp;&amp;#grdGlava.fieldname==Partner"/>
					<style name="bold" value="true" if="#grdGlava.@PartneriId==global.$NasId&amp;&amp;#grdGlava.fieldname==Partner"/>					
				</styles>
			</grid>
			<grid name="grdDetalj" dataname="~dtDetalj" bestfitonrefresh="true" async="true" key="KntKnjigaIraRSId" multiselect="true" savelayout="true" keyfield="KntKnjigaIraRSId" searchfield="KntKnjigaIraRSId" >
				<fields inherited="true">				
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="&amp;UNESI" type="add" function="Unesi">
					<event type="click">
						<part name="prtIraUnesi" path="prtKnjigaIraRS.xml"/>
					</event>
				</button>
				<button name="btnIzmijeni" caption="&amp;IZMIJENI" type="edit" function="Izmijeni">
					<event type="click">
						<part name="prtIraIzmijeni" path="prtKnjigaIraRS.xml"/>
					</event>
				</button>
				<button name="btnObrisi" caption="&amp;OBRIŠI" type="delete">
					<event type="click">
						<part name="prtIraObrisi" path="prtKnjigaIraRS.xml"/>
					</event>
				</button>
				<button name="btnZak" caption="&amp;ZAKLJUČI" function="Zakljuci">
					<event type="click">
						<part name="prtZakljuci" path="prtKnjigaIraRS.xml"/>
					</event>
				</button>	
				<button name="btnPonZak" caption="PONIŠTI Z&amp;AKLJUČAK" function="PonistiZakljucak">
					<event type="click">
						<part name="prtPonistiZakljucak" path="prtKnjigaIraRS.xml"/>
					</event>
				</button>	
				<button name="btnAnalitika" caption="ANALITIKA">
					<event type="click">
						<action type="form open" value="frmAnalitika">
							<parameter name="node" value="#tree.@Id"/>
							<parameter name="Vrijeme" value="#tree.@Godina"/>
							<parameter name="Naziv" value="#tree.@Naziv"/>
						</action>						
					</event>
				</button>
				<!-- <button name="btnRucni" caption="UNO&amp;S RUČNI" tooltip="Za unos ulaznih računa koji trebaju biti samo u knjizi ulaznih računa,  -->
																			<!-- a neće biti povezani s kontom dobavljača (npr. dani predujmovi).  -->
																			<!-- Za takve račune ne vrijedi shema knjiženja."> -->
					<!-- <event type="click"> -->
						<!-- <action type="form open" value="frmKnjigaIraRucno"> -->
							<!-- <parameter name="KntVrsteKnjigaIraIdInsert"  value="#tree.@KntVrsteKnjigaIraId" /> -->
						<!-- </action> -->
						<!-- <action type="control populate keepfocus" value="#grdGlava" if="$NoviId==null"/> -->
						<!-- <action type="control populate" value="#grdGlava" else="$NoviId!=null"> -->
							<!-- <action type="control focus" value="#grdGlava"> -->
								<!-- <parameter value="$NoviId"/> -->
							<!-- </action>						 -->
						<!-- </action> -->
					<!-- </event> -->
				<!-- </button>	 -->	
				<!-- <button name="btnSearch" caption="&amp;PRONAĐI"> -->
					<!-- <dropdownitem caption="PO BROJU RAČUNA"> -->
						<!-- <event type="click"> -->
							<!-- <action type="search" value="~dtSearchBroj"/> -->
						<!-- </event> 					 -->
					<!-- </dropdownitem> -->
					<!-- <dropdownitem caption="PO BROJU UFE"> -->
						<!-- <event type="click"> -->
							<!-- <action type="search" value="~dtSearchBrojDok"/>	 -->
						<!-- </event> -->
					<!-- </dropdownitem>						 -->
				<!-- </button>				 -->
				<!-- <button name="btnHelp" caption="UPUTI &amp;ME"> -->
					<!-- <event type="click"> -->
					<!-- </event>-->
				<!-- </button> -->
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDrvo" command="spCKntKnjigaIraRSTree"/>		
			<data name="dtGlava" command="spCKntKnjigaIraRSQuery" >
				<parameter name="@Action" value="2" if="#tree.@value==godina"/>
				<parameter name="@Action" value="7" elseif="#tree.@value==nezakljucen"/>
				<parameter name="@Action" value="6" elseif="#tree.@value==danas"/>
				<parameter name="@Action" value="1" elseif="#tree.@value==datumzak"/>
				<parameter name="@node" value="#tree.@id"/>	
				<!-- <parameter name="@DatZak" value="#tree.@datumzakljucka"/> -->
			</data>			
			<data name="dtDetalj" command="spCKntKnjigaIraRSQuery" >
				<parameter name="@Action" value="3"/>
				<parameter name="@FaktureId" value="#grdGlava.@FaktureId"/>
			</data>			
			<data name="dtDrvoPozicija" command="spCKntKnjigaIraRSTreePozicije">	
				<parameter name="@Action" value="DrvoPozicija" type="string"/>
			</data>
			<!-- <data name="dtDrvoPozicijaNovaKnjiga" command="spCKntKnjigaIraTreePozicije"> -->
				<!-- <parameter name="@Action" value="DrvoPozicijaNovaKnjiga"/> -->
			<!-- </data> -->
			<data name="dtBlokada" command="spCKntKnjigaIraRSTreePozicije">
				<parameter name="@Action" value="Blokada" type="string"/>
			</data>
			<data name="dtZadnjiDatZak" command="spCKntKnjigaIraRSTreePozicije">
				<parameter name="@Action" value="ZadnjiDatZak" type="string"/>
				<parameter name="@Godina" value="$Godina"/>
			</data>
			<!-- <data name="dtProknjizi" command="spFaktureKnjizenje"> -->
				<!-- <parameter name="@ID" value="#grdGlava.@FaktureId" /> -->
			<!-- </data> -->
			<data name="dtDatumZaZakljucak" command="spCKntKnjigaIraRSCalc">
				<parameter name="@action" value="DatumZaZakljucak" />
				<parameter name="@node"  value="#tree.@Id" />
			</data>
			<data name="dtPonistiZakljucak" command="spCKntKnjigaIraRSCalc">
				<parameter name="@action" value="PonistiZakljucak"/>
				<parameter name="@DatZakPonisti" value="~dtZadnjiDatZak.@ZadnjiDatZak"/>
				<parameter name="@node" value="#tree.@id"/>
			</data>
			<data name="dtTekGodina" command="spCKntKnjigaIraRSTreePozicije">
				<parameter name="@Action" value="TekGodina" type="string"/>
			</data>
			<data name="dtDrvoNovaIra" command="spCKntKnjigaIraRSTreePozicije">
				<parameter name="@Action" value="DrvoNovaIra" type="string"/>
				<parameter name="@ID" value="$NoviId"/>
			</data>
			<data name="dtPozicijaNezakljucen" command="spCKntKnjigaIraRSTreePozicije">
				<parameter name="@Action" value="PozicijaNezakljucen"/>
				<parameter name="@Node" value="#tree.@Id"/>
			</data>
			<data name="dtObrisiSve" command="spCKntKnjigaIraRSAzur">
				<parameter name="@action" value="2"/>
				<parameter name="@FaktureId" value="#grdGlava.@FaktureId"/>
			</data>			
			<data name="dtNasId" command="spCKntKnjigaIraRSPostavke">
				<parameter name="@Action" value="NasId"/>
			</data>	
			<data name="dtProNaplataRateObrisi" command="spProNaplataRateAzur">
				<parameter name="@action" value="5"/>
				<parameter name="@Id" value="#grdGlava.@FaktureId"/>
				<parameter name="@ProPonGlaId" value="null"/>
				<parameter name="@FaktureId" value="#grdGlava.@FaktureId"/>
				<parameter name="@ProNOtpGlaId" value="null"/>	
				<parameter name="@BrojDana" value="0"/>
				<parameter name="@DatumValute" value="#datValuta"/>
				<parameter name="@Vrijednost" value="#txtIznosSPorezom"/>				
				<parameter name="@KntNacinPlacId" value="null"/>
				<parameter name="@BrojInstr" value=""/>					
			</data>			
		</datalist>
	</form>
