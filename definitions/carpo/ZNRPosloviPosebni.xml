<root version="1.1">

  <form name="frmPosloviPosebni" type="master" caption="Poslovi s posebnim uvjetima rada"  saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtPosloviPosebni" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdPosloviPosebni" />
    </event>
    <managerlayout >
      <grid name="grdPosloviPosebni" type="master" autopopulate="true" dataname="dtPosloviPosebni" key="ZNRPosloviPosebniId" showautofilterrow="true" bestfitonrefresh="true" fieldsmartspaces="false" >
        <fields inherited="true">
          <field name="Clanak" caption="Članak 3. točka" />
          <field name="Naziv"  fixwidth="500" rowautoheight="true"/>
          <field name="Opis" fixwidth="500" rowautoheight="true"/>
          <field name="VrstaNaziv" caption="Vrsta pregleda" />
          <field name="ZdrPregled" caption="Zdravstveno stanje (mj)" />
          <field name="PsihPregled" caption="Psihička sposobnost (mj)" />
        </fields>
      </grid>
    </managerlayout>
    <panelbuttons>
      <buttons>
        <button name="btnUnesi" caption="Unos" type="add" function="UnesiPPU">
          <event type="click">
            <action type="form open" value="frmPromjenaPPU">
              <parameter name="caption" value="Unos posla s posebnim uvjetima rada" />
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate " value="#grdPosloviPosebni" >
                <action type="control focus" value="#grdPosloviPosebni">
                  <parameter value="$Fokus"/>
                </action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmjena" type="edit" function="IzmijeniPPU">
          <event type="click">
            <action type="form open" value="frmPromjenaPPU">
              <parameter name="ZNRPosloviPosebniId" value="#grdPosloviPosebni.@ZNRPosloviPosebniId" />
              <parameter name="caption" value="Izmjena posla s posebnim uvjetima rada" />
            </action>
            <action type="control populate keepfocus" value="#grdPosloviPosebni" />
          </event>
        </button>
        <button name="btnBrisi" caption="Brisanje" type="delete" function="ObrisiMR">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označeni posao s posebnim uvjetima rada?">
              <action type="datarun reader" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdPosloviPosebni"></action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRPosloviPosebni" name="dtPosloviPosebni">
        <parameter name="@Action" value="Master_query"/>
      </data>
      <data command="spZNRPosloviPosebni" name="dtDelete">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@ZNRPosloviPosebniId" value="#grdPosloviPosebni.@ZNRPosloviPosebniId" />
      </data>
    </datalist>
  </form>

  <!--* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->

  <form name="frmPromjenaPPU" caption="$caption" height="250"  width="500" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$ZNRPosloviPosebniId!=null"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="6"   groupbordervisible="false">
        <item caption="Članak 3. točka:" row="1" col="1" highlight="false">
          <textedit name="txtClanak" datavalue="~dtGet.@Clanak"  required="true"/>
        </item>
        <item caption="Naziv:" row="2" col="1" highlight="false">
          <memoedit name="txtNaziv" datavalue="~dtGet.@Naziv"  required="true"/>
        </item>
        <item caption="Opis:" row="3" col="1" highlight="false">
          <memoedit name="txtOpis"  datavalue="~dtGet.@Opis" required="false" />
        </item>
        <item caption="Vrsta pregleda:" row="4" col="1" highlight="false">
          <comboedit name="cmbVrsta"  valuefield="VrstaPregledaId" displayfield="VrstaNaziv" dataname="~dtVrstaPregleda" allownull="false" datavalue="~dtGet.@VrstaPregledaId" />
        </item>
        <item caption="Zdravstveno stanje (mj):" row="5" col="1" highlight="false">
          <textedit name="txtZdr" datavalue="~dtGet.@ZdrPregled"  required="false" />
        </item>
        <item caption="Psihička sposobnost(mj):" row="6" col="1" highlight="false">
          <textedit name="txtPsih"  datavalue="~dtGet.@PsihPregled" required="false" />
        </item>
      </group >
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$ZNRPosloviPosebniId!=null"/>
            <action type="datarun reader" value="~dtUnos" else="" >
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@Fokus" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRPosloviPosebni" name="dtGet">
        <parameter name="@Action" value="Dohvati_izmjena" />
        <parameter name="@ZNRPosloviPosebniId" value="$ZNRPosloviPosebniId"/>
      </data>
      <data command="spZNRPosloviPosebni" name="dtVrstaPregleda">
        <parameter name="@Action" value="Vrsta_pregled" />
      </data>
      <data command="spZNRPosloviPosebni" name="dtIzmjena">
        <parameter name="@Action" value="Izmjena_spremi" />
        <parameter name="@ZNRPosloviPosebniId" value="$ZNRPosloviPosebniId" />
        <parameter name="@Clanak" value="#txtClanak" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Opis" value="#txtOpis" />
        <parameter name="@VrstaPregledaId" value="#cmbVrsta" />
        <parameter name="@ZdrPregled" value="#txtZdr" type="int"/>
        <parameter name="@PsihPregled" value="#txtPsih" type="int"/>
      </data>
      <data command="spZNRPosloviPosebni" name="dtUnos">
        <parameter name="@Action" value="Unos_spremi"/>
        <parameter name="@Clanak" value="#txtClanak" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Opis" value="#txtOpis" />
        <parameter name="@VrstaPregledaId" value="#cmbVrsta" />
        <parameter name="@ZdrPregled" value="#txtZdr" type="int"/>
        <parameter name="@PsihPregled" value="#txtPsih" type="int"/>
      </data>
    </datalist>
  </form>

</root>