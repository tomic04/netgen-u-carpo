<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: FILTERFORM (NetGen) → frmFilter (Carpo)
Svrha: postavljanje globalnih filter parametara za dtMaster u master formi.
-->
<root version="1.2">
  <form name="frmFilter" caption="Izaberi uvjete traženja" type="dialog" width="700" height="260" fixedsize="false">
    <event type="shown">
      <!-- default fokus -->
      <action type="control focus" value="#datDatumOd"/>
    </event>

    <layout>
      <group cols="4" rows="4" groupbordervisible="false">
        <item col="1" row="1" colspan="4" caption="Razdoblje:" textposition="left">
          <label/>
        </item>
        <item col="1" row="2" caption="Od:" textposition="left">
          <dateedit name="datDatumOd" savevalue="app"/>
        </item>
        <item col="2" row="2" caption="Do:" textposition="left">
          <dateedit name="datDatumDo" savevalue="app"/>
        </item>

        <item col="1" row="3" colspan="4" caption="Partner:" textposition="left">
          <searchedit name="srcPartner"
                      dataname="~dtPartneri"
                      fieldvalue="PartneriId"
                      fieldtext="NazivId"
                      savevalue="app"
                      savelayout="true"/>
        </item>

        <item col="1" row="4" colspan="2" caption="Status:" textposition="left">
          <comboedit name="cmbStatus"
                     dataname="~dtKupStatus"
                     valuefield="kupstatusid"
                     displayfield="Naziv"
                     allownull="true"
                     savevalue="app"/>
        </item>
        <item col="3" row="4" colspan="2" caption="Zaprimljeno:" textposition="left">
          <comboedit name="cmbDA"
                     dataname="~dtDA"
                     valuefield="Daid"
                     displayfield="Naziv"
                     allownull="true"
                     savevalue="app"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPokazi" caption="POKAŽI">
          <event type="click">
            <action type="validate"/>
            <action type="variable value">
              <parameter name="global.$Mode" value="'filter'"/>
              <parameter name="global.$DatumOd" value="#datDatumOd"/>
              <parameter name="global.$DatumDo" value="#datDatumDo"/>
              <parameter name="global.$PartneriId" value="#srcPartner"/>
              <parameter name="global.$KupStatusId" value="#cmbStatus"/>
              <parameter name="global.$DAid" value="#cmbDA"/>
              <parameter name="global.$Close" value="false" type="bool"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="variable value">
              <parameter name="global.$Close" value="true" type="bool"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtPartneri" command="spTraziPartneri" timeout="300">
        <parameter name="@action" value="'Partneri'"/>
        <parameter name="@uvjet" value="#srcPartner.text"/>
      </data>

      <data name="dtKupStatus" type="text" timeout="300"
            command="select kupstatusid, opis as Naziv from kupstatus order by korak asc"/>

      <data name="dtDA" type="text" timeout="300"
            command="select 0 as Daid,'Nezaprimljeni-0' as Naziv
                    union all select 1 as Daid,'Zaprimljeni - 1' as Naziv
                    union all select 2 as Daid,'Arhivirani - 2' as Naziv"/>
    </datalist>
  </form>
</root>

