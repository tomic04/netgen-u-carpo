<root version="1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  
  <!--1.0 - subforme OSPrometFin.frmOSPrometFin_Unos.xml
          - uklonila type="detalj" iz detalj grida-->

	<form name="frmMaster" type="master" caption="Imovina - financijski promet">
		<managerlayout>

			<!-- KONTROLA: LOOKUP -->
			<lookup name="filter">
				<comboitem value="Vremenska podjela" />
				<comboitem value="Vrste dokumenata" /> 
			</lookup>

			<!-- KONTROLA: DRVO -->
			<tree name="tree"  allowdrop="false" expandallonload="false" >
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdMaster" />
				</event>

				<data if="#filter==Vremenska podjela" command="spOSPrometFin_Tree" key="sortkey">
					<parameter name="@Action" value="vremenska_podjela" />
				</data>
				<data if="#filter==Vrste dokumenata" command="spOSPrometFin_Tree" key="valueid">
					<parameter name="@Action" value="vrste_dokumenata" />
				</data>
				<fields>
					<field name="Name" />
				</fields>
			</tree>




			<!-- ***KONTROLA: MG*** -->
			<grid name="grdMaster"  type="master" async="true" bestfitonrefresh="true" key="OSPrometGlaId"  multiselect="true" showfooter="true" fieldsmartspaces="false">
				<print caption="Imovina - promet financijski" />
        <!-- KONTROLA: MENU -->
        <!--<menu>
          <menuitem caption="Poništi zaključak" name="PonistiZakljucak" function="PonistiZakljucak">
            <event type="click">
              <action type="confirm" value="Želite li otključati dokument: '{#grdMaster.@Broj}'?">
                <action type="datarun nonquery" value="~dtOtkljucaj">
                  <action type="control populate keepfocus" value="#grdMaster" >
                  </action>

                </action>
              </action>
            </event>
          </menuitem>
        </menu>-->


        <event type="focusedrowchanged">
					<action type="control populate" value="#grdDetail" /> 
					<!--<action type="control disable" value="#btnIzmjena,#btnBrisanje" />-->
					<!--<action type="control enable" value="#btnIzmjena" if="#grdMaster.@statusid==2" />-->
          <action type="control disable" value="#btnIzmjena,#btnBrisanje,#btnZakljuciDok" if="#grdMaster.@statusid==2"/>
          <action type="control enable" value="#btnIzmjena,#btnBrisanje,#btnZakljuciDok" else=""/>

          <action type="control disable" value="#btnPonistiZakljucak" if="#grdMaster.@statusid!=2"/>
          <action type="control enable" value="#btnPonistiZakljucak" else=""/>

          <!--<action type="menu enable" value="#PonistiZakljucak" if="#grdMaster.@statusid==2"></action>
          <action type="menu disable" value="#PonistiZakljucak" else=""></action>-->
          
				</event>
        
        <!--<event type="click">
          <action type="menu disable" value="#PonistiZakljucak" if="#grdMaster.@statusid==2"></action>
        </event>-->
        
				<event type="doubleclick">
				</event>
				<data command="spOSPrometFin_Query" if="#filter==Vremenska podjela" >
					<parameter name="@Action" value="master"  />
					<parameter name="@godina" value="#tree.@godina" />
					<parameter name="@mjesec" value="#tree.@mjesec" />
				</data>
				<data command="spOSPrometFin_Query" if="#filter==Vrste dokumenata" >
					<parameter name="@Action" value="master"  />
					<parameter name="@godina" value="#tree.@godina" />
					<parameter name="@mjesec" value="#tree.@mjesec" />
					<parameter name="@vrstadokid" value="#tree.@vrstadokid" />
				</data>
				<fields inherited="true"  >
					<field name="vpOpis" caption="Vrsta prometa"  /> 
					<field name="vdOpis" caption="Vrsta dokumenta"  /> 
					<field name="Broj" caption="Dokument"  /> 
					<field name="TemDatum" caption="Datum dokumenta"  /> 
					<field name="KolUlaz" caption="Količina ulaz"  /> 
					<field name="KolIzlaz" caption="Količina izlaz"  /> 
					<field name="NabavaDug" caption="Nabava duguje"  /> 
					<field name="NabavaPot" caption="Nabava potražuje"  /> 
					<field name="OtpisDug" caption="Otpis duguje"  /> 
					<field name="OtpisPot" caption="Otpis potražuje"  /> 
					<field name="Operater" caption="Operater"  /> 
					<field name="Osoba" caption="Osoba"  /> 
					<field name="Status" caption="Status"  /> 
				</fields>
				<styles>
					<style name="fontcolor" value="#000000" if="#grdMaster.@statusid==1" />
					<style name="fontcolor" value="#008000" if="#grdMaster.@statusid==2" /> 
				</styles>

				


			</grid>

			<!-- ***KONTROLA: DG*** -->
			<grid name="grdDetail" async="True" bestfitonrefresh="true" key="OSPrometDetId" multiselect="true" showfooter="true" fieldsmartspaces="false">
				<event type="focusedrowchanged">
				</event>
				<event type="doubleclick">
				</event>
				<data command="spOSPrometFin_Query">
					<parameter name="@Action" value="stavke"/>
					<parameter name="@osprometglaid" value="#grdMaster.@OSPrometGlaId"/>
				</data>

				<fields inherited="true"  >
					<field name="invbroj" caption="Inventurni broj"  /> 
					<field name="NazivKratki" caption="Imovina"  /> 
					<field name="DatumPromjene" caption="Datum promjene"  /> 
					<field name="KolUlaz" caption="Količina ulaz"  /> 
					<field name="KolIzlaz" caption="Količina izlaz"  /> 
					<field name="NabavaDug" caption="Nabava duguje"  /> 
					<field name="NabavaPot" caption="Nabava potražuje"  /> 
					<field name="OtpisDug" caption="Otpis duguje"  /> 
					<field name="OtpisPot" caption="Otpis potražuje"  />
          <field name="Opis" caption="Opis"  />
        </fields>
				<styles>
				</styles>

        <!--<menu>
          <menuitem caption="Poništi zaključak" name="PonistiZakljucak">
            <event type="click">
              <action type="confirm" value="Želite li otključati dokument: '{#grdMaster.@Broj}'?">
                <action type="datarun nonquery" value="~dtOtkljucaj">
                  <action type="control populate" value="#grdMaster" >
                    <action type="control focus" value="#grmMaster" >
                      <parameter value="0" />
                    </action>
                  </action>

                </action>
              </action>
            </event>
          </menuitem>
        </menu>-->

			</grid>

		</managerlayout>




		<panelbuttons>
			<buttons>
				<!-- KONTROLA: BUTTON -->
				<button name="btnUnos" caption="Unos dokumenta" type="add" displayfield="Opis" dataname="" function="UnesiFin">
					<event type="click">
						<action type="variable value" value="OSPrometGlaId" >
							<parameter value="#grdMaster.@OSPrometGlaId" type="int" />
						</action> 
						<action type="form open" value="frmOSPrometFin_Unos" >
							<parameter name="OSPrometGlaId" value="0" type="int" />
						</action>
						<action type="control populate" value="#grdMaster" >
							<action type="control focus" value="#grdMaster" >
								<parameter value="$OSPrometGlaId" />
							</action> 
						</action>
					</event>
					<!-- KONTROLA: MENUITEM MASTER -->
					<!-- -  					<menuitem control="#grdMaster" /> -->
				</button>

				<button name="btnIzmjena" caption="Izmjena dokumenta" type="add" displayfield="Opis" dataname=""  function="IzmijeniFin">
					<event type="click">
            <action type="datarun reader" value="~dtKontrolaIzmjenaFin"/>
            <action type="message" value="~dtKontrolaIzmjenaFin.@Poruka" if="~dtKontrolaIzmjenaFin.@IndGreska==1"/>
						<action type="form open" value="frmOSPrometFin_Unos" if="~dtKontrolaIzmjenaFin.@IndGreska==0">
							<parameter name="OSPrometGlaId" value="#grdMaster.@OSPrometGlaId" type="int" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
						<action type="control populate" value="#grdDetail"  />
					</event>
					<!-- KONTROLA: MENUITEM MASTER -->
					<!-- 					<menuitem control="#grdMaster" if="#grdMaster.@StatusId==2" />  -->
				</button>
        <button name="btnZakljuciDok" caption="Zaključi dokument" type="add" function="ZakljuciFin" >
          <event type="click">
            <action type="validate"/>
            <action type="datarun nonquery" value="~dtZakljuciDok">
            </action>
            <action type="control populate keepfocus" value="#grdMaster" >
            </action>

          </event>
        </button>

       <button name="btnPonistiZakljucak" caption="Poništi zaključak" type="add" function="PonistiZakljucakFin" >
            <event type="click">
              <action type="confirm" value="Želite li otključati dokument: '{#grdMaster.@Broj}'?">
                <action type="datarun nonquery" value="~dtOtkljucaj">
                  <action type="control populate keepfocus" value="#grdMaster" >
                  </action>

                </action>
              </action>
            </event>
          </button>

        <button name="btnBrisanje" caption="Brisanje dokumenta" type="del" displayfield="Opis" dataname="" function="ObrisiFin">
					<event type="click">
						<action type="confirm" value="Želite li obrisati dokument: '{#grdMaster.@Broj}'?">
							<action type="datarun nonquery" value="~dtDelete">
								<action type="control populate" value="#grdMaster" >
									<action type="control focus" value="#grdMaster" >
										<parameter value="0" />
									</action>
								</action>

							</action>
						</action>
					</event>
					<!-- KONTROLA: MENUITEM MASTER -->
					<!-- 					<menuitem control="#grdMaster" if="#grdMaster.@StatusId==2" />  -->
				</button>

				<button name="btnKartica" caption="Detaljni pregled" type="" displayfield="Opis" dataname="" function="KaticaFin">
					<event type="click">
						<action type="form open" value="frmOSPrometFin_KarticaOS" >
							<parameter name="OSImovinaId" value="#grdDetail.@OSImovinaId" type="int" />
							<parameter name="NabavaRootId" value="0" type="int" />
							<parameter name="NazivImovina" value="#grdDetail.@NazivImovinaId" />
						</action>
					</event>
					 <!--KONTROLA: MENUITEM MASTER--> 
					<menuitem control="#grdDetail" /> 
				</button>

        <button name="btnKarticaOS" caption="Kartica imovine" type="" displayfield="Opis" dataname="" function="OSKarticaFin">
          <event type="click">
            <action type="form open" value="frmOSKartica" >
              <parameter name="OSImovinaId" value="#grdDetail.@OSImovinaId" type="int" />
              <parameter name="NabavaRootId" value="0" type="int" />
              <parameter name="NazivImovina" value="#grdDetail.@NazivImovinaId" />
            </action>
          </event>
          <!-- KONTROLA: MENUITEM MASTER -->
          <menuitem control="#grdDetail" />
        </button>


				<button name="btnPrint" caption="Ispiši" dataname="Global.dtPrint" displayfield="Opis" function="IspisiFin">
					<event type="click">
						<action type="control print" value="#grdMaster">
							<action type="print template" value="#btnPrint.@Template">
								<parameter name="id" value="#grdMaster.@OSPrometGlaId" />
							</action>
						</action>
					</event>
				</button>

        <!--<button name="btnOtkljucajDok" caption="Poništi zaključak" type="add" dock="right" function="PonistiZakljucak">
          <event type="click">
            <action type="validate"/>
            <action type="datarun nonquery" value="~dtZakljuciDok">
            </action>
            <action type="variable value" value="parent.OSPrometGlaId" >
              <parameter value="$OSPrometGlaId" type="int" />
            </action>
            <action type="form close"/>
          </event>
        </button>-->

		

			</buttons>
		</panelbuttons>
		<datalist>

			<data command="spOSPrometFin_GlaAzur" name="dtDelete">
				<parameter name="@Action" value="2" />
				<parameter name="@OSPrometGlaId" value="#grdMaster.@OSPrometGlaId" />
			</data>

      <data command="spOSPrometFin_GlaAzur" name="dtOtkljucaj">
        <parameter name="@Action" value="11" />
        <parameter name="@OSPrometGlaId" value="#grdMaster.@OSPrometGlaId" />
      </data>

      <data command="spOSPrometFin_GlaAzur" name="dtZakljuciDok">
        <parameter name="@Action" value="10" />
        <parameter name="@OSPrometglaId" value="#grdMaster.@OSPrometGlaId" />
      </data>
      <data command="spOSPrometFin_Help" name="dtKontrolaIzmjenaFin">
        <parameter name="@Action" value="Kontrola_blokade_fin"/>
        <parameter name="@TemDatum" value="#grdMaster.@TemDatum"/>
      </data>

		</datalist>
	</form>

	<form name="frmOSPrometFin_Unos" path="frmOSPrometFin_Unos.xml"/>
	<form name="frmOSPrometFin_UnosDet" path="frmOSPrometFin_Unos.xml"/>
	<form name="frmOSPrometFin_KarticaOS" path="frmOSPrometFin_Unos.xml"/>
  <form name="frmIspisKartice" path="frmOSPrometFin_Unos.xml"/>
  <form name="frmOSKartica" path="frmOSPrometFin_Unos.xml"/>



	<datalist>
		<data command="spCarpoPrint" name="dtPrint">
			<parameter name="@Action" value="GetTemplates" />
			<parameter name="@Id" value="#grdMaster.@OSPrometglaId" type="int" />
			<parameter name="@Tablica" value="OSPrometGla" />
		</data>               

	</datalist>
</root>