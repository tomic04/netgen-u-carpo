<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmMaster" type="master" caption="Indikator povrata">
		<event type="onload">
		</event>
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="dtProPovratIndQuery"  showgrouppanel="False" multiselect="true"  savelayout="true" >
				<event type="doubleclick">
					<action type="form open" value="frmIndikatorPovrataIzmjena">
						<parameter name="ProPovratIndId" value="#grdGlava.@ProPovratIndId" />
					</action>
				</event>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi">
					<event type="click">
						<action type="form open" value="frmIndikatorPovrataUnos">
						</action>
						<action type="control populate keepfocus" value="#grdGlava" />
					</event>					
				</button>
					<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmIndikatorPovrataIzmjena">
							<parameter name="ProPovratIndId" value="#grdGlava.@ProPovratIndId" />
						</action>
						<!-- <action type="control populate focus" value="#grdGlava" />  -->
					</event>
				</button>	
				<button name="btnObrisi" caption="Obriši">
                    <event type="click">
                        <action type="confirm" value="Želite li obrisati stavku?">
                            <action type="datarun nonquery" value="~dtProPovratIndDelete">
                                <action type="control populate" value="#grdGlava" />
                         </action>
                        </action>
                    </event>					
				</button>			
			</buttons>
		</panelbuttons>
		<datalist>
		<data command="spProPovratIndQuery" name="dtProPovratIndQuery">
			<parameter name="@action" value="1" />
		</data>
		<data command="spProPovratIndDelete" name="dtProPovratIndDelete">
			<parameter name="@ProPovratIndId" value="#grdGlava.@ProPovratIndId" />
		</data>		

	</datalist>
	</form>

	<form name="frmIndikatorPovrataUnos" path="frmIndikatorPovrataUnos.xml"/>	
	<form name="frmIndikatorPovrataIzmjena" path="frmIndikatorPovrataIzmjena.xml"/>	
	
</root>