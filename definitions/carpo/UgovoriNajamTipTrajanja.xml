<root>
	<form name="frmGlavna" type="master" caption="Tip razdoblja trajanja ugovora">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtNapuniGrid" multiselect="true">
				<fields>
					<field name="Naziv" caption="Tip razdoblja trajanja ugovora" />
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnesi">
							<parameter name="UgovoriTipTrajanjaID" value="#grdGlava.@UgovoriTipTrajanjaID" />
						</action>
					</event>
				</button>

				<button name="btnIzmjeni" caption="IZMJENI">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="UgovoriTipTrajanjaID" value="#grdGlava.@UgovoriTipTrajanjaID" />
							<parameter name="Naziv" value="#grdGlava.@Naziv" />
						</action>
					</event>
				</button>

				<button name="btnObriši" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />
						<action type="control foreachrow selected" value="#grdGlava">
							<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
			</buttons>
		</panelbuttons>	

		<datalist>
			<data command="spUgovoriNajamTipTrajanja_query" name="dtNapuniGrid">
			</data>
			<data command="spUgovoriNajamTipTrajanja_delete" name="dtDelete">
				<parameter name="UgovoriTipTrajanjaID" value="#grdGlava.@UgovoriTipTrajanjaID" />
			</data>
		</datalist>

	</form>

	<form name="frmUnesi" caption="Unesi">
		<layout>
			<group cols="1" rows="1" col="1" row="1">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" required="true" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="dtInsert" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipTrajanja_insert" name="dtInsert">
				<parameter name="@tipUgovora" value="#txtNaziv" />
			</data>
		</datalist>
	</form>

	<form name="frmIzmjena" caption="Izmjeni">

		<event type="init">
				<action type="datarun reader" value="dtGet" />
		</event>

			<layout>
				<group cols="1" rows="1" col="1" row="1">
					<item col="1" row="1" caption="Naziv:">
						<textedit name="txtNaziv" datavalue="~dtGet.@Naziv" />
					</item>
				</group>
			</layout>


		<panelbuttons>
			<buttons>
				<button name="btnIzmjeni" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtEdit" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="Obriši" dock="right"/>
			</buttons>
		</panelbuttons>	

		<datalist>

			<data command="spUgovoriNajamTipTrajanja_EditQuery" name="dtGet">
				<parameter name="@UgovoriTipTrajanjaID" value="$UgovoriTipTrajanjaID" />
			</data>	

			<data command="spUgovoriNajamTipTrajanja_update" name="dtEdit">
				<parameter name="@UgovoriTipTrajanjaID" value="$UgovoriTipTrajanjaID" />
				<parameter name="@tipUgovora" value="#txtNaziv" />
			</data>
		</datalist>
	</form>

</root>