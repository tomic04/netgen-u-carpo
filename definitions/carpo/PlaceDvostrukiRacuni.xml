<root version="1.0">
	<!--
  Komentari:
  04.08.2021. Jadranka Vučenović Vojvodić - kreirala granulu ver 1.0.
  -->
	<!--
  *******************************************************************************************
  POČETNA FORMA
  *******************************************************************************************
  -->
	<form name="frmPocetna" caption="Djelatnici - izmjena računa" width="730" height="560" saveformsize="false" showversion="true" version="1.0" >
		<event type="init">
			<action type="datarun reader" value="~dtGrid" />
		</event>

		<event type="load">
			<action type="control populate" value="#grdGrid" >     </action>
			<action type="control enable" value="#btnIzmjena,#btnBrisanje" if="#grdGrid.rowcount!=0"/>
			<action type="control disable" value="#btnIzmjena,#btnBrisanje" else=""/>
		</event>

		<layout>
			<group cols="1" rows="5" groupbordervisible="false">
				<item caption="" col="1" row="1" rowspan="5" textposition="left">
					<grid name="grdGrid" key="ID" dataname="~dtGrid" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true">
						<event type="doubleclick">
							<action type="form open" value="frmUnos">
								<parameter name="Tip" value="Izmjena"/>
								<parameter name="caption" value="Izmjena računa {#grdGrid.@Djelatnik}"/>
								<parameter name="Id" value="#grdGrid.@ID"/>
							</action>
							<action type="control populate keepfocus" value="#grdGrid"/>
						</event>
					</grid>
				</item>
			</group>
			<!--kraj omotača-->
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Unesi">
					<event type="click">
						<action type="form open" value="frmUnos">
							<parameter name="Tip" value="Unos"/>
							<parameter name="caption" value="Unos računa"/>
							<parameter name="Id" value="0"/>
						</action>
						<action type="control populate keepfocus" value="#grdGrid"/>
					</event>
				</button>
				<button name="btnIzmjena" caption="Izmijeni">
					<event type="click">
						<action type="form open" value="frmUnos">
							<parameter name="Tip" value="Izmjena"/>
							<parameter name="caption" value="Izmjena računa {#grdGrid.@Djelatnik}"/>
							<parameter name="Id" value="#grdGrid.@ID"/>
						</action>
						<action type="control populate keepfocus" value="#grdGrid"/>
					</event>
				</button>
				<button name="btnBrisanje" caption="Obriši">
					<event type="click">
						<action type="form open" value="frmBrisanje">
							<parameter name="Tip" value="Brisanje"/>
							<parameter name="caption" value="Brisanje odabranih zapisa"/>
							<parameter name="selectedids" value="#grdGrid.selectedids"/>
						</action>
						<action type="control populate keepfocus" value="#grdGrid"/>
						<action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdGrid==null"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlaceDvostrukiRacuniAll" name="dtGrid">
				<parameter name="action" value="MASTER"></parameter>
			</data>
		</datalist>
	</form>

	<!--
  *******************************************************************************************
  FORMA ZA UNOS/IZMJENU
  *******************************************************************************************
  -->

	<form name="frmUnos" caption="$caption" width="430" height="380" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$Id!=0" />
		</event>
		<event type="shown">
			<action type="control disable" value="#btnUnos,#btnOdustani" if="$Id==null"/>
			<action if="$Tip=='Izmjena'">
				<action type="control value" value="#srcDjelatnik">
					<parameter text="~dtGet.@Djelatnik" value="~dtGet.@hrkadroviid" />
				</action>
				<action type="control value" value="#cmbVrstaRacuna">
					<parameter text="~dtGet.@Naziv" value="~dtGet.@oopvrsteracunaid" />
				</action>
				<action type="control value" value="#cmbBanka">
					<parameter text="~dtGet.@Banka" value="~dtGet.@bankaid" />
				</action>
			</action>
		</event>

		<layout >
			<group rows="1" cols="1" groupbordervisible="false">
				<group row="1" col="1" cols="1" rows="5" spacing="2,2,2,2">
					<item caption="Djelatnik:" col="1" row="1" textposition="top" highlight="false" >
						<searchedit name="srcDjelatnik" dataname="~dtDjelatnik" fieldtext="Djelatnik" fieldvalue="hrkadroviid" required="true">
						</searchedit>
					</item>
					<item row="2" col="1" caption="Vrsta računa:" highlight="false" >
						<comboedit name="cmbVrstaRacuna" valuefield="OOPVrsteRacunaId" displayfield="Naziv" dataname="~dtVrsteRacuna" allownull="false">
							<event type="valuechanged">
								<!-- Ako je Gotovina u vrsti računa (uzima id 3 tablice jer je na njemu se nalazi gotovina) onda disable račune, a ako nije onda enabl-a -->
								<action if="#cmbVrstaRacuna==3">								
									<action type="control disable" value="#cmbBanka,#txtRacun" ></action>
									<action type="control value" value="#txtRacun" >
									</action>	
									<action type="control value" value="#cmbBanka" >
									</action>										
								</action>
								<action else="">
									<action type="control enable" value="#cmbBanka,#txtRacun" ></action>
									<action type="control value" value="#txtRacun" >
										<parameter value="~dtGet.@ziroracun" />
									</action>
									<action type="control value" value="#cmbBanka" >
										<parameter value="~dtGet.@BankaId" text="~dtGet.@Banka" />
									</action>
								</action>
							</event>
						</comboedit>
					</item>

					<item row="3" col="1" caption="Banka:" highlight="false" >
						<comboedit name="cmbBanka" valuefield="PartneriId" displayfield="Naziv" dataname="~dtBankaRacuna" allownull="false"/>
					</item>

					<item row="4" col="1" caption="Broj računa:" highlight="false" >
						<textedit name="txtRacun" datavalue="~dtGet.@ziroracun" maxlength="20"/>
					</item>
					<item caption="Postotak:" col="1" row="5" textposition="top" highlight="false" >
						<textedit name="txtPostotak" datavalue="~dtGet.@postotak" format="n2" value="0" allownull="false"/>
					</item>
				</group>
			</group>
			<!--kraj omotača-->
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action if="$Id==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdGrid">
									<action type="control focus" value="parent.#grdGrid">
										<parameter value="$noviID"/>
									</action>
								</action>
								<action type="control enable" value="parent.#btnIzmjena,parent.#btnBrisanje"/>
							</action>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!" />
								<action type="form close" />
							</action>
						</action>
						<action if="$Id!=0">
							<action type="datarun reader" value="~dtIzmjena"></action>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!" />
								<action type="form close" />
							</action>

							<!--<action type="form close"></action>-->
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlaceDvostrukiRacuniAll" name="dtDjelatnik">
				<parameter name="@action" value="getDjelatnik" />
				<parameter name="@text" value="#srcDjelatnik.text" />
			</data>
			<data command="spPlaceDvostrukiRacuniAll" name="dtVrsteRacuna">
				<parameter name="@action" value="getVrsteRacuna" />
			</data>
			<data command="spPlaceDvostrukiRacuniAll" name="dtBankaRacuna">
				<parameter name="@action" value="getBankaRacuna" />
			</data>
			<data command="spPlaceDvostrukiRacuniAll" name="dtGet">
				<parameter name="@action" value="dtGet" />
				<parameter name="@id" value="$Id" type="int"/>
			</data>
			<data command="spPlaceDvostrukiRacuniAll" name="dtUnos">
				<parameter name="@action" value="UNOS"></parameter>
				<parameter name="@Id.output.int" variablename="noviID"></parameter>
				<parameter name="@hrkadroviid" value="#srcDjelatnik"></parameter>
				<parameter name="@oopvrsteracunaid" value="#cmbVrstaRacuna"></parameter>
				<parameter name="@bankaid" value="#cmbBanka"></parameter>
				<parameter name="@ziroracun" value="#txtRacun"></parameter>
				<parameter name="@postotak" value="#txtPostotak"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
			<data command="spPlaceDvostrukiRacuniAll" name="dtIzmjena">
				<parameter name="@action" value="IZMJENA"></parameter>
				<parameter name="@Id" value="$Id"></parameter>
				<parameter name="@hrkadroviid" value="#srcDjelatnik"></parameter>
				<parameter name="@oopvrsteracunaid" value="#cmbVrstaRacuna"></parameter>
				<parameter name="@bankaid" value="#cmbBanka"></parameter>
				<parameter name="@ziroracun" value="#txtRacun"></parameter>
				<parameter name="@postotak" value="#txtPostotak"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>

	<!--
  *******************************************************************************************
  FORMA ZA BRISANJE
  *******************************************************************************************
  -->
	<form name="frmBrisanje" caption ="Brisanje" width="400" height="150" fixedsize="true" saveformsize="false" >
		<event type="shown">
			<action type ="control value" value="#lblPitanje">
				<parameter value="Jeste li sigurni da želite obrisati odabrane zapise?"/>
			</action>
		</event>
		<layout>

			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="true" >
				<item col="1" row="1"  highlight="false">
					<labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
				</item>

			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnBrisi" caption="OBRIŠI" type="del">
					<event type="click">
						<!-- Okini storu -->

						<action type="datarun reader" value="~dtBrisanje"/>

						<action if="$indGreske==0">
							<action type="control populate keepfocus" value="parent.#grdGrid"/>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spPlaceDvostrukiRacuniAll" name="dtBrisanje">
				<parameter name="@Action" value="BRISANJE_VISE" type="string"/>
				<parameter name="@selectedids" value="$selectedids"/>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>



</root>