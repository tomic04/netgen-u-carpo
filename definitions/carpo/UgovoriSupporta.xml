<root>
	<form type="master" name="frmMaster" caption="Ugovori Suppporta">
		<event type="init">
			<action type="variable value" value="global.$Init">
				<parameter value="0"/>
			</action>
			<action type="variable value" value="global.$FormOpen">
				<parameter value="0"/>
			</action>
		</event>
		<managerlayout>
			<grid type="master" name="grdMaster" dataname="~dtMaster" fieldsmartspaces="false" bestfitonrefresh="true" key="suppKorSuppId" savelayout="true">
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdDetail"/>
				</event>
				<event type="doubleclick">
					<action type="form open" value="frmIzmijeni">
						<parameter name="suppKorisnikId" value="#grdMaster.@suppKorisnikId"/>
						<parameter name="Korisnik" value="#grdMaster.@Korisnik"/>
						<parameter name="suppKorSuppId" value="#grdMaster.@suppKorSuppId"/>
						<parameter name="Indy" value="M"/>
					</action>
				</event>
			</grid>
			<grid name="grdDetail" fieldsmartspaces="false" bestfitonrefresh="true" dataname="~dtDetail">
				<event type="doubleclick">
					<action type="form open" value="frmIzmijeni">
						<parameter name="suppKorisnikId" value="#grdMaster.@suppKorisnikId"/>
						<parameter name="Korisnik" value="#grdDetail.@Korisnik"/>
						<parameter name="suppKorSuppId" value="#grdDetail.@suppKorSuppId"/>
						<parameter name="Indy" value="D"/>
					</action>
				</event>
				<menu>
					<menuitem caption="Izmijeni">
						<event type="click">
						<action type="form open" value="frmIzmijeni">
							<parameter name="suppKorisnikId" value="#grdMaster.@suppKorisnikId"/>
							<parameter name="Korisnik" value="#grdDetail.@Korisnik"/>
							<parameter name="suppKorSuppId" value="#grdDetail.@suppKorSuppId"/>
							<parameter name="Indy" value="D"/>
						</action>
					</event>
					</menuitem>
					<menuitem caption="Obriši">
						<event type="click">
							<action type="confirm" value="Sigurno želite obrisati ugovor za {#grdDetail.@Korisnik} od {#grdDetail.@Datum}?"/>
							<action type="datarun nonquery" value="~dtDelete"/>
							<action type="control populate keepfocus" value="#grdMaster"/>
						</event>
					</menuitem>
				</menu>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnIzmijeni" caption="Izmijeni">
					<event type="click">
						<action type="form open" value="frmIzmijeni">
							<parameter name="suppKorisnikId" value="#grdMaster.@suppKorisnikId"/>
							<parameter name="Korisnik" value="#grdMaster.@Korisnik"/>
							<parameter name="suppKorSuppId" value="#grdMaster.@suppKorSuppId"/>
							<parameter name="Indy" value="M"/>
						</action>
					</event>
				</button>
				<button name="btnUgovorAzur" caption="Ažuriranje ugovora" dock="right">
					<event type="click">
						<action type="form open" value="frmFilter"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spSuppUgovoriSupporta">
				<parameter name="@Action" value="MASTER"/>
			</data>
			<data name="dtDetail" command="spSuppUgovoriSupporta">
				<parameter name="@Action" value="DETAIL"/>
				<parameter name="@suppKorisnikId" value="#grdMaster.@suppKorisnikId"/>
			</data>
			<data name="dtDelete" command="spSuppKorSuppDelete">
				<parameter name="@suppKorSuppId" value="#grdDetail.@suppKorSuppId"/>
			</data>
		</datalist>
	</form>
	<form name="frmUgovorAzur" path="frmUgovorAzur2.xml"/>
	<form name="frmIzmijeni" path="frmIzmijeniVertical4.xml"/>
	<!-- <form name="frmIzmijeniA" path="frmIzmijeniA.xml"/> -->
	<form name="frmFilter" path="frmFilter.xml"/>
</root>