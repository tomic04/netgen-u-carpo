		</datalist>
</form>

<form name="frmUnosStavke" caption="Unos stavke">

		<layout >
				<group col="1" row="3" cols="1" rows="8" groupbordervisible="true" caption="Detalj">
					<item col="1" row="1" caption="Datum promjene:"  textposition="left">
						<dateedit name="datDatPromjene" value="now"/>
					</item>
					<item col="1" row="2" caption="Mjesečni iznos najma:"  textposition="left" >
						<textedit name="txtIznosNajma" value="0" format="n0" type="integer" required="true" >
						<event type="leave">
							<action type="control value" value="#txtIznosNajma" if="#txtIznosNajma==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="3" caption="Valuta:"  textposition="left" >
						<comboedit name="cmbValuta"  valuefield="ValuteId"  displayfield="Naziv" dataname="~dtValuta" />
					</item>
					<item col="1" row="4" caption="Trajanje najma u mjesecima:"  textposition="left" >
						<textedit name="txtTrajanjeNajma" value="0" format="n0" type="integer" required="true" >
						<event type="leave">
							<action type="control value" value="#txtTrajanjeNajma" if="#txtTrajanjeNajma==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="5" caption="Godišnja inkrementalna stopa:"  textposition="left" >
						<textedit name="txtIkStopa" value="0" format="n2" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtIkStopa" if="#txtIkStopa==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="6" caption="Fiksni trošak:"  textposition="left">
						<textedit name="txtFiksniTrosak" value="0" format="n2" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtFiksniTrosak" if="#txtFiksniTrosak==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="7" caption="Datum primjene:"  textposition="left">
						<dateedit name="datDatPrimjene" value="now"/>
					</item>
					<item col="1" row="8" caption="Napomena:"  textposition="left">
						<memoedit name="txtNapomena"  multiline="true"   maxlength="200"/>
					</item>
				</group>			
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtUnesiStavku">
							<parameter name="zadnjaStavkaId" value="~dtUnesiStavku.@NajamUgovoriDetId" />

						 </action>
						 <!-- <action type="message" value="$zadnjiUgovorId" /> -->
						 <action type="variable value" value="global.StavkaId">
                                 <parameter value="$zadnjaStavkaId" type="int"/>
                            </action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>

 
 <datalist>

	<data command="spNajamUgovori_DetUnos" name="dtUnesiStavku">
		<parameter name="@DatumPromjene" value="#datDatPromjene" />
		<parameter name="@IznosNajma" value="#txtIznosNajma" />
		<parameter name="@ValuteId" value="#cmbValuta" />
		<parameter name="@TrajanjeNajma" value="#txtTrajanjeNajma" />
		<parameter name="@InkrementalnaStopa" value="#txtIkStopa" />
		<parameter name="@FiksniTrosak" value="#txtFiksniTrosak" />
		<parameter name="@DatumPrimjene" value="#datDatPrimjene" />
		<parameter name="@NapomenaDet" value="#txtNapomena" />
		<parameter name="@OperateriId" value="@@operateriid" />
		<parameter name="@NajamUgovoriGlaId" value="parent.$GlavaId" />
	</data>

	<data command="spNG_Combo" name="dtValuta">
				<parameter name="@Action" value="valute" />
				<parameter name="@Ind" value="1" />
				<parameter name="@Oznaka" value="OznakaNaziv" />
			</data>
 </datalist>
</form>
		

</root>