<?xml version="1.0" encoding="utf-8"?>
<root>
<form name="frmGlavna" type="master" caption="Ugovori Najam">

    <managerlayout>

      <!--Master grid--> 
      <grid type="master" name="grdGlava" dataname="~dtGlavaQuery" bestfitonrefresh="true" key="NajamUgovoriGlaId" fieldsmartspaces="false" >
		<event type="focusedrowchanged" >
          <action type="control populate" value="#grdDetalj" />
		  <action type="control populate" value="#grdDetaljPromet" />
        </event>
		<event type="doubleclick">
            <action type="form open" value="frmIzmjena">
				<parameter name="GlavaId" value="#grdGlava.@NajamUgovoriGlaId" />
			</action>
         </event>

		 <fields >
		 	<field name="Broj" caption="Broj" />
			<field name="VrstaUgovora" caption="Vrsta ugovora"/>
			<field name="Partner" caption="Partner" />
			<field name="DatumUgovora" caption="Datum ugovora" />
			<field name="Operater" caption="Operater" />
			<field name="OdgovornaOsoba" caption="Odgovorna osoba" />
			<field name="Napomena" caption="Napomena" />
			<field name="OrganizacijskaShema" caption="Organizacijska shema" />
			<field name="Lokacija" caption="Lokacija" />
			<field name="Adresa" caption="Adresa" />
		</fields>
 
      </grid>

	        <!--Detalj grid-->
	 <tabs>
		<tab caption="Detalj">			
			<grid name="grdDetalj" bestfitonrefresh="true" dataname="~dtDetalj"   fieldsmartspaces="false">	

			<fields >
				<field name="DatumPromjene" caption="Datum promjene" />
				<field name="IznosNajma" caption="Iznos najma"/>
				<field name="Valuta" caption="Valuta" />
				<field name="TrajanjeNajma" caption="Trajanje najma" />
				<field name="InkrementalnaStopa" caption="Inkrementalna stopa" />
				<field name="FiksniTrosak" caption="Fiksni trosak" />
				<field name="DatumPrimjene" caption="Datum primjene" />
				<field name="Napomena" caption="Napomena" />
			</fields>	
			</grid>	
		</tab>	

		<tab caption="Promet">
			<grid name="grdDetaljPromet" bestfitonrefresh="true" dataname="~dtDetaljPromet" >

			<fields >
				<field name="BrojRata" caption="Broj rata" />
				<field name="DatumOd" caption="Datum od"/>
				<field name="DatumDo" caption="Datum do" />
				<field name="DiskontniFaktor" caption="Diskontni faktor" format="n4" type="decimal" />
				<field name="IznosRate" caption="Iznos rate" />
				<field name="SadasnjaVrijednostObvezeUValuti" caption="Sadasnja vrijednost obveze u valuti" />
				<field name="BrojDana" caption="Broj dana" />
				<field name="OsnovicaKamataUValuti" caption="Osnovica kamata u valuti" />
				<field name="IznosKamateUValuti" caption="Iznos kamate u valuti" />
				<field name="PocetnoStanjeObvezeUValuti" caption="Pocetno stanje obveze u valuti" />
				<field name="ZavrsnoStanjeObvezeUValuti" caption="Zavrsno stanje obveze u valuti" />
				<field name="PocetnoStanjeImovineUKunama" caption="Pocetno stanje imovine u kunama" />
				<field name="IznosAmortizacijeUKunama" caption="Iznos amortizacije u kunama" />
				<field name="NKVImovineUKunama" caption="NKV imovine u kunama" />
				<field name="Tecaj" caption="Tecaj" format="n6" type="decimal"/>
			</fields>

			</grid>
		</tab>				
	</tabs>

    </managerlayout>


	<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" >
					<event type="click">

					 <action type="form open" value="frmUnos"/>
					 <action type="control populate" value="#grdGlava">
						<action type="control focus" value="#grdGlava">
							<parameter value="global.$UgovorId" />
						</action>  
					</action> 
					 <action type="control populate" value="#grdDetalj" />
					 <action type="control populate" value="#grdDetaljPromet" />

					 
					</event> 
				</button> 
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmIzmjena">  
							<parameter name="GlavaId" value="#grdGlava.@NajamUgovoriGlaId" />
							<parameter name="DetaljId" value="#grdDetalj.@NajamUgovoriDetId" />
						</action>
						<action type="control populate" value="#grdGlava" />
						<action type="control focus" value="grdGlava">
							<parameter value="$GlavaId" />
						</action> 
					 	<action type="control populate" value="#grdDetalj" />
					 	<action type="control populate" value="#grdDetaljPromet" />
						
       
					</event>
				</button >
				<button name="btnObrisi" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati ugovor?" />
						<action type="datarun nonquery" value="~dtObrisi" /> 
						<action type="control populate" value="#grdGlava" />
					 	<action type="control populate" value="#grdDetalj" />
					 	<action type="control populate" value="#grdDetaljPromet" />             
					</event>
				</button>

				<button name="btnIspisi" caption="Ispiši" dataname="~dtPrint" displayfield="Opis">
					<event type="click">
						<action type="control print" value="#grdGlava">
							<action type="print template" value="#btnIspisi.@Template">
								<parameter name="id" value="#grdGlava.@NajamUgovoriGlaId" /> 
							</action>
						</action>
						<action type="control populate" value="#grdDetaljPromet" />
						<action type="control populate" value="#grdGlava" />
					 	<action type="control populate" value="#grdDetalj" />
					 	            
					</event>
				</button >

			</buttons>		
		</panelbuttons>	 
						

		<datalist>
		    <data command="spNajamUgovori_GlaGrid" name="dtGlavaQuery" />
			<data command="spNajamUgovori_DetGrid" name="dtDetalj">
				<parameter name="@NajamUgovoriGlaId"  value="#grdGlava.@NajamUgovoriGlaId" />
			</data>
			<data command="spNajamUgovori_PrometGrid" name="dtDetaljPromet" >
			   <parameter name="@NajamUgovoriGlaId"  value="#grdGlava.@NajamUgovoriGlaId" />
			</data>
			<data command="spNajamUgovori_GlaObrisi" name="dtObrisi" >
			   <parameter name="@NajamUgovoriGlaId"  value="#grdGlava.@NajamUgovoriGlaId" />
			</data>
			<data command="spCarpoPrint" name="dtPrint">
				<parameter name="@Action" value="GetTemplates" />
				<parameter name="@Id" value="#grdGlava.@NajamUgovoriGlaId" type="int" />
				<parameter name="@Tablica" value="NajamUgovoriGla" />
			</data>
		</datalist>

 </form>

 <form name="frmUnos" caption="Unos dokumenta">

		<event type="init">
		<action type="datarun reader" value="~dtPubVars" />
          <action type="variable value">
            <parameter name="global.NasId" value="~dtPubVars.@NasId" />
          </action>
		<action type="datarun scalar" value="~dtGetPoljeZaOperatera" />
        </event>

		<event type="load">

		<action type="datarun reader" value="~dtGetPoljeZaOperatera" />
		<action type="control value" value="#cmbOsoba">
			<parameter value="~dtGetPoljeZaOperatera.@OsobeId"/>
		</action>
		</event>

		<layout >
		<group cols="1" rows="3" groupbordervisible="false">

				

				<group col="1" row="1" cols="1" rows="8" groupbordervisible="true" caption="Zaglavlje" > 
					<item col="1" row="1" caption="Broj:"  textposition="left">
						<textedit name="txtBroj" maxlength="20" required="true" />
					</item>
					<item col="1" row="2" caption="Partner:"  textposition="left" >
						<searchedit name="srcPartneri" fontbold="True"  fieldvalue="PartneriID" datavalue="" dataname="~dtGetPartneri" function="srcPartneri" required="true" />
					</item>
					<item col="1" row="3" caption="Datum ugovora:"  textposition="left" >
						<dateedit name="datDatUgo" value="now"/>
					</item>
					<item col="1" row="4" caption="Odgovorna osoba:"  textposition="left" >
						<comboedit name="cmbOsoba"  valuefield="OsobeId"  displayfield="Osoba" dataname="~dtOdgovornaOsoba"  required="true" />
					</item>	
					<item col="1" row="5" caption="Organizacijska jedinica:"  textposition="left" >
						<comboedit name="cmbOrgShema"  valuefield="OrgShemaId"  displayfield="Naziv" dataname="~dtOrgShema"  required="true" />
					</item>
					<item col="1" row="6" caption="Lokacija:"  textposition="left" >
						<searchedit name="srcParstru" fieldvalue="ParStruId" fontbold="True" datavalue="" dataname="~dtGetParstru" />
					</item>
					<item col="1" row="7" caption="Adresa:"  textposition="left" >
						<textedit name="txtAdresa" multiline="true" maxlength="200"/>
					</item>
					<item col="1" row="8" caption="Napomena:"  textposition="left" >
						<memoedit name="txtNapomena" multiline="true" maxlength="200"/>
					</item>
				</group>

				<group col="1" row="3" cols="1" rows="8" groupbordervisible="true" caption="Detalj">
					<item col="1" row="1" caption="Datum promjene:"  textposition="left">
						<dateedit name="datDatPromjene" value="now"/>
					</item>
					<item col="1" row="2" caption="Mjesečni iznos najma:"  textposition="left" >
						<textedit name="txtIznosNajma" value="0" format="n0" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtIznosNajma" if="#txtIznosNajma==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="3" caption="Valuta:"  textposition="left" >
						<comboedit name="cmbValuta"  valuefield="ValuteId"  displayfield="Naziv" dataname="~dtValuta" />
					</item>
					<item col="1" row="4" caption="Trajanje najma u mjesecima:"  textposition="left" >
						<textedit name="txtTrajanjeNajma" value="0" format="n0" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtTrajanjeNajma" if="#txtTrajanjeNajma==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="5" caption="Godišnja inkrementalna stopa:"  textposition="left" >
						<textedit name="txtIkStopa" value="0" format="n2" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtIkStopa" if="#txtIkStopa==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="6" caption="Fiksni trošak:"  textposition="left">
						<textedit name="txtFiksniTrosak" value="0" format="n2" type="integer" required="true">
						<event type="leave">
							<action type="control value" value="#txtFiksniTrosak" if="#txtFiksniTrosak==null">
								<parameter value="0"/>
							</action>
						</event>
						</textedit>
					</item>
					<item col="1" row="7" caption="Datum primjene:"  textposition="left">
						<dateedit name="datDatPrimjene" value="now"/>
					</item>
					<item col="1" row="8" caption="Napomena:"  textposition="left">
						<memoedit name="txtNapomena"  multiline="true"   maxlength="200"/>
					</item>

				</group>
		</group>	
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtUnesi">
							<parameter name="zadnjiUgovorId" value="~dtUnesi.@zadnjiGlaId" />

						 </action>
						 <!-- <action type="message" value="$zadnjiUgovorId" /> -->
						 <action type="variable value" value="global.UgovorId">
                                 <parameter value="$zadnjiUgovorId" type="int"/>
                            </action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>

 
 <datalist>
	<data command="spProd_PopuniPoljaZaOperatera" name="dtGetPoljeZaOperatera">
		<parameter name="@operateriid" value="@@operateriid" />
		<parameter name="@tablica" value="NajamUgovoriGla" />
	</data>

	<data command="spCKntTemTraziPartneri" name="dtGetPartneri">
		<parameter name="@Action" value="Partneri" />
		<parameter name="@Uvjet" value="#srcPartneri.text" />
	</data>

	<data command="spTraziParstru" name="dtGetParstru">
		<parameter name="@Action" value="Parstru" />
		<parameter name="@Uvjet" value="#srcParstru.text" />
		<parameter name="@Ind_postotak" value="1" />
		<parameter name="@PartneriId" value="global.$NasId" />
	</data>

	<data command="spDajPubVarse" name="dtPubVars">

	</data>

	<data command="spTraziOsobe" name="dtOdgovornaOsoba">
		<parameter name="@Action" value="NaseOsobe" />
	</data>

	<data command="spNG_Combo" name="dtValuta">
		<parameter name="@Action" value="valute" />
		<parameter name="@Ind" value="1" />
		<parameter name="@Oznaka" value="OznakaNaziv" />
	</data>

	<data command="spNG_combo" name="dtOrgShema">
		<parameter name="@Action" value="orgshema" />
		<parameter name="@Ind" value="0" />
	</data>

	<data command="spNajamUgovori_GlaIDetUnos" name="dtUnesi">
		<parameter name="@Broj" value="#txtBroj" />
		<parameter name="@PartneriId" value="#srcPartneri" />
		<parameter name="@DatumUgovora" value="#datDatUgo" />
		<parameter name="@OsobeID" value="#cmbOsoba" />
		<parameter name="@NapomenaGla" value="#txtNapomena" />
		<parameter name="@DatumPromjene" value="#datDatPromjene" />
		<parameter name="@IznosNajma" value="#txtIznosNajma" />
		<parameter name="@ValuteId" value="#cmbValuta" />
		<parameter name="@TrajanjeNajma" value="#txtTrajanjeNajma" />
		<parameter name="@InkrementalnaStopa" value="#txtIkStopa" />
		<parameter name="@FiksniTrosak" value="#txtFiksniTrosak" />
		<parameter name="@DatumPrimjene" value="#datDatPrimjene" />
		<parameter name="@NapomenaDet" value="#txtNapomena" />
		<parameter name="@OperateriId" value="@@operateriid" />
		<parameter name="@ParStruId" value="#srcParstru" />
		<parameter name="@OrgShemaId" value="#cmbOrgShema" />
		<parameter name="@Adresa" value="#txtAdresa" />
		
	</data>
 </datalist>
</form>

<form name="frmIzmjena" caption="Izmjena dokumenta">

			<event type="init">
				<action type="datarun reader" value="~dtGet">
					
				 </action>
			</event>

			<event type="load">
				<action type="control populate" value="#grdDetalj" />
			</event>

		<layout >

		<group cols="2" rows="1" groupbordervisible="false">
		   		<columnsdefinition>
					<column size="40%" position="1" />
					 <column size="60%" position="2" />
				</columnsdefinition>

				<group col="1" row="1" cols="1" rows="8" groupbordervisible="true" caption="Zaglavlje" width="250" > 
					<item col="1" row="1" caption="Broj:"  textposition="left">
						<textedit name="txtBroj" maxlength="20" required="true" datavalue="~dtGet.@Broj" />
					</item>
					<item col="1" row="2" caption="Partner:"  textposition="left" >
						<searchedit name="srcPartner" fieldtext="Partner" fieldvalue="PartneriId" dataname="~dtGetPartneri" required="true" fontbold="true" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@Partner" function="srcPartner" />
						
					</item>
					<item col="1" row="3" caption="Datum ugovora:"  textposition="left" >
						<dateedit name="datDatUgo" datavalue="~dtGet.@DatumUgovora" />
					</item>
					<item col="1" row="4" caption="Odgovorna osoba:"  textposition="left" >
						<comboedit name="cmbOsoba"  valuefield="OsobeId"  displayfield="Osoba" dataname="~dtOdgovornaOsoba"  required="true" datavalue="~dtGet.@OsobeId"  />
					</item>	
					<item col="1" row="5" caption="Organizacijska jedinica:"  textposition="left" >
						<comboedit name="cmbOrgShema"  valuefield="OrgShemaId"  displayfield="Naziv"  dataname="~dtOrgShema"  required="true" datavalue="~dtGet.@OrgshemaId">
								
						</comboedit>
					</item>
					<item col="1" row="6" caption="Lokacija:"  textposition="left" >
						<searchedit name="srcParstru" fontbold="True" fieldvalue="ParStruId" dataname="~dtGetParstru" datatext="~dtGet.@Lokacija" datavalue="~dtGet.@ParStruId" />
					</item>
					<item col="1" row="7" caption="Adresa:"  textposition="left" >
						<textedit name="txtAdresa" multiline="true" maxlength="200" datavalue="~dtGet.@Adresa" />
					</item>
					<item col="1" row="8" caption="Napomena:"  textposition="left" >
						<memoedit name="txtNapomena" multiline="true" maxlength="200" datavalue="~dtGet.@Napomena"/>
					</item>
				</group>

				<group col="2" row="2" cols="1" rows="2" groupbordervisible="true" caption="Detalj" position="right">

				  <rowsdefinition>
						<row size="80%" position="1" />
						<row size="20%" position="2" />
					</rowsdefinition>
					<item col="1" row="1">
						<grid name="grdDetalj" bestfitonrefresh="true" dataname="~dtDetalj"  key="NajamUgovoriDetId" >	

							<event type="focusedrowchanged">
								<action type="datarun scalar" value="~dtProvjeraZadnjeg" >
									<parameter name="ZadnjiId"/>								
								</action>
								<action type="control disable" value="#btnDetaljObracunaj" if="$ZadnjiId!=#grdDetalj.@NajamUgovoriDetId" />
								<action type="control enable" value="#btnDetaljObracunaj" else="" />

								<action type="control disable" value="#btnDetaljObrisi" if="$ZadnjiId!=#grdDetalj.@NajamUgovoriDetId" />
								<action type="control enable" value="#btnDetaljObrisi" else="" />
							</event>

							<fields >
						<field name="DatumPromjene" caption="Datum promjene" />
							<field name="IznosNajma" caption="Iznos najma"/>
							<field name="Valuta" caption="Valuta" />
							<field name="TrajanjeNajma" caption="Trajanje najma" />
							<field name="InkrementalnaStopa" caption="Inkrementalna stopa" />
							<field name="FiksniTrosak" caption="Fiksni trosak" />
							<field name="DatumPrimjene" caption="Datum primjene" />
							<field name="Napomena" caption="Napomena" />
						</fields>

			            </grid>
					</item>
					<group col="1" row="2" cols="3" rows="1">
						<item col="1" row="1" >

							<button name="btnDetaljDodaj" caption="Dodaj">
							<event type="click">

							 <action type="datarun nonquery" value="~dtIzmjeni" />

					 			<action type="form open" value="frmUnosStavke"/>

								 <action type="control populate" value="#grdDetalj">
								 	<action type="control focus" value="#grdDetalj">
									<parameter value="global.$StavkaId" />
									</action>
								</action>
							</event>
							</button>
						</item>
						<item col="2" row="1">
							<button name="btnDetaljObrisi" caption="Obriši">
							<event type="click">
								<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?" />
								<action type="datarun nonquery" value="~dtObrisiStavku" />  
								<action type="control populate" value="#grdDetalj" />
							</event>	
							</button>
						</item>
						<item col="3" row="1">
							<button name="btnDetaljObracunaj" caption="Obračunaj">
								<event type="click">
									<action type="confirm" value="Jeste li sigurni da želite obračunati dokument?" />
									<action type="datarun nonquery" value="~dtObracunaj" />
									<action type="message" value="Uspješno kreiran obračun" />
								</event>
							</button>
							
						</item>
					</group>
				</group>
		</group>	
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnIzmjeni" caption="Spremi">
					<event type="click">
					<action type="validate"/>
						<action type="datarun nonquery" value="~dtIzmjeni" />
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
				<button name="btnIspisi" caption="Ispiši" dataname="~dtPrint" displayfield="Opis">
					<event type="click">
						<action type="control print" value="#grdGlava">
							<action type="print template" value="#btnIspisi.@Template">
								<parameter name="id" value="#grdGlava.@NajamUgovoriGlaId" /> 
							</action>
						</action>
					
					 	            
					</event>
				</button >
			</buttons>
		</panelbuttons>


		<datalist>

			<data command="spNajamUgovoriIzracun" name="dtObracunaj">
				<parameter name="@NajamUgovoridetId" value="#grdDetalj.@NajamUgovoriDetId" />
				<parameter name="@OperateriId" value="@@operaterid" />
				<parameter name="@Debug" value="0" />
			</data>
			<data command="spCarpoPrint" name="dtPrint">
				<parameter name="@Action" value="GetTemplates" />
				<parameter name="@Id" value="$GlavaId" type="int" />
				<parameter name="@Tablica" value="NajamUgovoriGla" />
			</data>
			<data command="spNajamUgovori_DetObrisi " name="dtObrisiStavku">
				<parameter name="@NajamUgovoriDetId"  value="#grdDetalj.@NajamUgovoriDetId" />
			</data>

			<data command="spNajamUgovoriNajveciDatPrimjene " name="dtProvjeraZadnjeg">
				<parameter name="@NajamUgovoriGlaId" value="$GlavaId" />
			</data>

			<data command="spNajamUgovori_GlaAzur" name="dtIzmjeni">
				<parameter name="@Broj" value="#txtBroj" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@DatumUgovora" value="#datDatUgo" />
				<parameter name="@OsobeID" value="#cmbOsoba" />
				<parameter name="@NapomenaGla" value="#txtNapomena" />
				<parameter name="@ParStruId" value="#srcParstru" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@Adresa" value="#txtAdresa" />
				<parameter name="@NajamUgovoriGlaId"  value="$GlavaId" />
				<parameter name="@OperateriId" value="@@operateriid" />
			</data>

			<data command="spTraziParstru" name="dtGetParstru">
				<parameter name="@Action" value="Parstru" />
				<parameter name="@Uvjet" value="#srcParstru.text" />
				<parameter name="@Ind_postotak" value="1" />
				<parameter name="@PartneriId" value="global.$NasId" />
			</data>
		    <data command="spNajamUgovori_GlaQuery" name="dtGet">
				<parameter name="@NajamUgovoriGlaId"  value="$GlavaId" />
			</data>
			<data command="spNajamUgovori_DetGrid" name="dtDetalj">
				<parameter name="@NajamUgovoriGlaId"  value="$GlavaId" />
