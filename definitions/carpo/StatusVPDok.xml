<root version="1.0.0.1">
	<form name="frmStatusVPDokumenata" type="master" caption="Status VP dokumenata" maximized="true" statusbar="true">

		<event type="init"> 
			<action type="datarun reader" value="~dtSetDatum" />
			<action type="variable value" >
				<parameter name="NapuniGrid" value="0" />
			</action>
		</event>
		<event type="load">	
			<action type="control populate" value="#grdStavke"></action> 

		</event>
	<event type="shown">

			<action type="control enable" value="#btnStavke" if="#grdStavke.rowcount!=0"/>  
			<action type="control disable" value="#btnStavke" else=""/>
		</event>
	
	<layout itemspadding="20" >
		<group cols="1" rows="2" groupbordervisible="false">
			<group cols="3" rows="1" col="1" row="1" groupbordervisible="true">
					<columnsdefinition>
						<column size="20%" position="1" />
						<column size="40%" position="2" />
						<column size="40%" position="3" />
					</columnsdefinition>
					
				<item col="1" row="1"  textposition="left" caption="Skladište:" >
						<comboedit name="cmbSkladiste" autopopulate="true" valuefield="SkladisteId" displayfield="OznakaOpis"  dataname="dtSkladiste">
						</comboedit>
					</item>
				
					
					<group cols="2" rows="1" col="2" row="1" groupbordervisible="false">
						<column size="50%" position="1" />
						<column size="50%" position="2" />
					<item col="1" row="1" textposition="left" caption="Datum od:" >
							<dateedit  name="datDatumOd" value="" datavalue="~dtSetDatum.@DatumOd" type="date">
							</dateedit>
					</item>
					<item col="2" row="1" textposition="left" caption="Datum do:" >
							<dateedit  name="datDatumDo" value="" datavalue="~dtSetDatum.@DatumDo" type="date">
							</dateedit>
					</item>
					</group>
			</group>

			<group caption="  " padding="5" groupbordervisible="true" cols="1" rows="1" col="1" row="2">
				<item row="1" col="1" highlight="false" >
					<grid name="grdStavke" multiselect="true" printcaptionalign="center" 
					printcaption="Status veleprodajnih dokumenata za period od {#datDatumOd::dd.MM.yyyy.} do {#datDatumDo::dd.MM.yyyy.} "  
					printheader=" \n " headeralign="center" showgrouppanel="true" showfooter="false" savelayout="true">												
						<data command="spCRobnoStatusVPDok">		
							<parameter name="@skladisteid" value="#cmbSkladiste" type="int" if="$NapuniGrid==1"/>
							<parameter name="@skladisteid" value="-1" type="int" else=""/> 
							<parameter name="@DatumOd" value="#datDatumOd" type="date" />
							<parameter name="@DatumDo" value="#datDatumDo" type="date"/>
						</data>
						<fields>	
							<field name="Status" caption="Status" />  
							<field name="datumdok" caption="Datum Dokumenta" />
							<field name="broj" caption="Broj naloga"/>	
							<field name="vrijednostsPDV" caption="Ukupna Vrijednost" />
							<field name="pdv" caption="PDV" />
							<field name="vrijednostbezpdv" caption="Vrijednost Bez PDV-a" />
							<field name="skladiste" caption="Skladiste" />
							<field name="kupac" caption="Kupac" />
							<field name="nabvrijednost" caption="Nabavna Vrijednost" />
							<field name="razlika" caption="Razlika u Cijeni" /> 
							<field name="Proknjizeno" caption="Proknjiženo" /> 
							<field name="orgshema" caption="Org.Shema" />
							<field name="Fakturabroj" caption="Broj Fakture" />	
							
						</fields>	
						<event type="doubleclick">
							<action type="control enable" value="#btnStavke" if="#grdStavke.rowcount!=0"/>
							<action type="control disable" value="#btnStavke" else=""/>
								<action type="form open" value="frmDokument">
									<parameter name="BrojDok" value="#grdStavke.@Broj" />
									<parameter name="DatumDok" value="#grdStavke.@DatumDok" type="date" />
								</action>				
					</event>

						<styles>
							<!-- BOJANJE bojanje-->
								<style name="backgroundcolor" value="white" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==1" />
								<style name="backgroundcolor" value="red" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==2" />
								<style name="backgroundcolor" value="orange" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==3" />
								<style name="backgroundcolor" value="yellow" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==4" />
								<style name="backgroundcolor" value="olive" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==5" />	
								<style name="backgroundcolor" value="aqua" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==6" />		
								<style name="backgroundcolor" value="lightgreen" if="#grdStavke.fieldname==Status&amp;&amp;#grdStavke.cellvalue==7" />
						</styles>
					
					</grid>
				</item>
			</group>
		</group>
	</layout >
	<panelbuttons>
		<buttons>
			<button name="btnIzracunaj" caption="&amp;Izračunaj" dock="left">
				<event type="click" waittype="progress" waitcaption="Obrada" waittext="Punjenje grida..." sleep="1000">
					<action type="variable value" >
						<parameter name="NapuniGrid" value="1" />
					</action>
					<action type="control populate" value="#grdStavke"/>
						
					<action type="control enable" value="#btnStavke" if="#grdStavke.rowcount!=0"/>
					<action type="control disable" value="#btnStavke" else=""/> 
						
				</event>
			</button>
				<button name="btnStavke" caption="&amp;Prikaži Stavke" dock="left">
					<event type="click">
						<action type="form open" value="frmDokument">
							<parameter name="BrojDok" value="#grdStavke.@Broj" />
							<parameter name="DatumDok" value="#grdStavke.@DatumDok" type="date" />
							
						</action>
					</event>
				</button>
			<button name="btnLegenda" caption="&amp;Legenda" dock="right">
				<event type="click">
					<action type="form open" value="frmLegenda">
					</action>
				</event>
			</button>
			
			<button name="btnIspis" caption="Ispiši"  dock="right" >
				<event type="click">
					<action type="control printcontrol" value="#grdStavke"/>
				</event>
			</button>
			<button caption="Izlaz" type="cancel" dock="right">
				<event type="click">
					<action type="form close"/>	
				</event>
			</button>	
		<!--	<button caption="Uputi me" type="HELP" dock="right" /> -->
		</buttons>
	</panelbuttons>
	<datalist>
			<data command="spCRobnoStatusVPSkladisteQuery" name="dtSkladiste">
				<parameter name="@Action" value="0" />
			</data>	

			<data command="select cast(cast(year(getdate()) as CHAR(4))+'0101' as DATE) as DatumOd,cast(getdate() as date) as DatumDo" type="text" name="dtSetDatum"/>
			

		</datalist>	
	
	
	
	</form>
		<form name="frmDokument" path="frmDokument.xml"/>
		<form name="frmLegenda" path="statusVPDok.frmLegenda.xml"/>
	</root>