<root>
	<form type="master" name="frmMaster" caption="Modeli strojeva">
		<managerlayout>
			<grid type="master" name="grdMaster" dataname="~dtMaster" key="VozModelId">
				<fields>
					<field name="Naziv"/>
					<field name="Proizvodjac" caption="Proizvođač"/>
					<field name="TipVozilo" caption="Tip vozila"/>
				</fields>
				<event type="doubleclick">
					<action type="form open" value="frmIzmjeniModel">
						<parameter name="VozModelId" value="#grdMaster.@VozModelId"/>
					</action>
				</event>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodajModel"/>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmIzmjeniModel">
							<parameter name="VozModelId" value="#grdMaster.@VozModelId"/>
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Želite li obrisati označeni zapis?">
							<action type="datarun nonquery" value="~dtObrisi"/>
							<action type="control populate" value="#grdMaster"/>
						</action>
					</event>
				</button>
				<button name="btnIspisi" caption="Ispiši">
					<event type="click">
						<action type="control printcontrol" value="#grdMaster"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
 		<datalist>
			<data name="dtMaster" command="spVozModelQueryCarpo">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtObrisi" command="spVozModelAzurCarpo">
				<parameter name="@Action" value="2"/>
				<parameter name="@ID" value="#grdMaster.@VozModelId"/>
			</data>
		</datalist>
	</form>
	<form name="frmDodajModel" caption="Dodaj model">
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNaziv"/>
				</item>
				<item row="2" col="1" caption="Proizvođač:">
					<comboedit name="cmbProizvodjac" dataname="~dtProizvodjac" valuefield="VozProizvodjacId" displayfield="Naziv"/>
				</item>
				<item row="3" col="1" caption="Tip vozila:">
					<comboedit name="cmbTipVozila" dataname="~dtTipVozila" valuefield="VozTipId" displayfield="Tip"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun scalar" value="~dtSpremi">
							<parameter name="VozModelId"/>
						</action>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="control focus" value="parent.#grdMaster">
							<parameter value="$VozModelId" type="int"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtProizvodjac" command="spVozProizvodjacQuery">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtTipVozila" command="spVozTipQuery">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtSpremi" command="spVozModelAzurCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@VozProizvodjacId" value="#cmbProizvodjac"/>
				<parameter name="@VozTipId" value="#cmbTipVozila"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
			</data>
		</datalist>
	</form>
	<form name="frmIzmjeniModel" caption="Izmjeni model">
		<event type="init">
			<action type="datarun reader" value="~dtDohvati"/>
		</event>
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" caption="Naziv">
					<textedit name="txtNaziv" datavalue="~dtDohvati.@Naziv"/>
				</item>
				<item row="2" col="1" caption="Proizvođač">
					<comboedit name="cmbProizvodjac" datavalue="~dtDohvati.@VozProizvodjacId" dataname="~dtProizvodjac" valuefield="VozProizvodjacId" displayfield="Naziv"/>
				</item>
				<item row="3" col="1" caption="Tip vozila">
					<comboedit name="cmbTipVozila" datavalue="~dtDohvati.@VozTipId" dataname="~dtTipVozila" valuefield="VozTipId" displayfield="Tip"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun scalar" value="~dtSpremi">
							<parameter name="VozModelId"/>
						</action>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="control focus" value="parent.#grdMaster">
							<parameter value="$VozModelId" type="int"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtProizvodjac" command="spVozProizvodjacQuery">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtTipVozila" command="spVozTipQuery">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtSpremi" command="spVozModelAzurCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@VozProizvodjacId" value="#cmbProizvodjac"/>
				<parameter name="@VozTipId" value="#cmbTipVozila"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@ID" value="$VozModelId"/>
			</data>
			<data name="dtDohvati" command="spVozModelQueryCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@ID" value="$VozModelId"/>
			</data>
		</datalist>
	</form>
</root>