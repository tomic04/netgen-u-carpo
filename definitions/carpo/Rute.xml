								<field name="Ucestalost" caption="Učestalost"  editable="true" formatstring="n0"  />
								<field name="Pomak" caption="Pomak"  editable="true" formatstring="n0"  />
								<field name="Aktivno" caption="Aktivno" editable="true" edittype="bit"/>
								<field name="DatumPocetka" caption="Datum početka" editable="true" edittype="date"/>
							</fields>
					</grid>						
				</item>
			</group>
