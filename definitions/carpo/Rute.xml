				<parameter name="@RuteLnParStruDinamikaId" value="~dtInsert.@ID"/>
				<parameter name="@DanInd" value="#grdVrijeme.@ID"/>
				<parameter name="@Ucestalost" value="#grdVrijeme.focusedvalue"/>
				<parameter name="@Ind" value="#grdVrijeme.@Izbor"/>
