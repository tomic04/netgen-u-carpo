	<form name="frmDani" caption="Učestalost" width="500" fixedsize="true">
	
		<event type="init">		
			<action type="datarun reader" value="~dtInsert" />
		</event>
		
		<event type="load">		
			<action type="control populate" value="#grdVrijeme" />
			<action type="variable value" >
				<parameter name="IndOdustani" value="1" type="int"/>
			</action>
