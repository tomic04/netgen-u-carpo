				<parameter name="@RuteLnParStruDinamikaId" value="~dtInsert.@ID"/>
				<parameter name="@DanInd" value="#grdVrijeme.@ID"/>
				<parameter name="@Pomak" value="#grdVrijeme.focusedvalue"/>
				<parameter name="@Ind" value="#grdVrijeme.@Izbor"/>
			</data>
			<data command="spProd_Rute_RuteLnParStruDinamikaDani_UpdateAktivno" name="dtInsertDaniAktivno">
				<parameter name="@RuteLnParStruDinamikaId" value="~dtInsert.@ID"/>
				<parameter name="@DanInd" value="#grdVrijeme.@ID"/>
				<parameter name="@Aktivno" value="#grdVrijeme.focusedvalue"/>
				<parameter name="@Ind" value="#grdVrijeme.@Izbor"/>
			</data>
			<data command="spProd_Rute_RuteLnParStruDinamikaDani_UpdateDatumPocetka" name="dtInsertDaniDatumPocetka">
				<parameter name="@RuteLnParStruDinamikaId" value="~dtInsert.@ID"/>
				<parameter name="@DanInd" value="#grdVrijeme.@ID"/>
				<parameter name="@DatumPocetka" value="#grdVrijeme.focusedvalue"/>
