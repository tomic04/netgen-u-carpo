								<action type="datarun nonquery" value="~dtInsertDaniPomak" if="#grdVrijeme.focusedfield==Pomak&amp;&amp;#grdVrijeme.focusedvalue&gt;=0&amp;&amp;#grdVrijeme.focusedvalue&lt;4&amp;&amp;#grdVrijeme.focusedvalue&lt;#grdVrijeme.@Ucestalost" />
								<action type="datarun nonquery" value="~dtInsertDaniAktivno" if="#grdVrijeme.focusedfield==Aktivno" />
								<action type="datarun nonquery" value="~dtInsertDaniDatumPocetka" if="#grdVrijeme.focusedfield==DatumPocetka" />
