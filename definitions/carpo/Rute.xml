<?xml version="1.0" encoding="utf-8"?>
<root version="8.0.0.2">
	<form name="frmMaster" type="master" caption="Rute">
		<event type="shown">
			<action type="variable value" >
				<parameter name="Aktivan" value="null" type="int"/>
			</action>
			<action type="variable value" >
				<parameter name="Indikator" value="0" type="int"/>
			</action>  			
		</event>
		<managerlayout>
			<tree name="tree" caption="Rajoni/lokacije" valuefield="id" keyfield="Id" expandallonload="true" dataname="dtTreeRute" searchfield="ruteid" allowdrop="true">
				<fields>
                    <field name="caption" />
                </fields>
				<event type="focusedrowchanged"  >
					<action type="control populate" value="#grdGlava" />
					<!-- <action type="message" value="$Aktivan" /> -->
					<action type="variable value" value="$pomocna">
						<parameter value="1"/>
					</action>
				<action type="variable value" value="$staritreeid">
					<parameter name="staritreeid" value="#tree.@Id"/>
				</action>
				</event>
				
				<event type="dragover">
					<!-- ****određujemo nivo u koji se može "dropati"**** -->
					<action type="drop allow" value="true" if="#tree.level==1" />
				</event>
				
				<menu type="drop">
					<menuitem caption="Prenesi">
						<event type="click">
							<action type="variable value" value="$ruteId">
								<parameter name="ruteId" value="#tree.@Id"/>
							</action>
							<action type="variable value" value="$rajoniId">
								<parameter name="Id" value="#tree.@rajonId"/>
							</action>
							<action type="variable value" value="$parentid">
								<parameter name="parentid" value="#tree.@parentid"/>
							</action>								
							<action type="datarun scalar" value="~dtRuteLNParStruPrenesi" >
								<parameter name="$Indikator" type="int" />
							</action>
							<action type="control focus" value="#tree">
								<parameter value="$ruteId" type="int" />
							</action>
							<action type="control populate keepfocus"  value="#grdGlava"/>
							<action type="message" value="'Neke lokacije su već bile u odabranoj ruti i nisu premiještene.'" if="$Indikator==1" />
							<!-- <action type="variable value" value="$Indikator"> -->
								<!-- <parameter  value="0" type="int" /> -->
							<!-- </action> -->
						</event>
					</menuitem>
					<menuitem caption="Kopiraj">
						<event type="click">
							<action type="variable value" value="$ruteId">
								<parameter name="ruteId" value="#tree.@Id"/>
							</action>
							<action type="variable value" value="$parentid">
								<parameter name="parentid" value="#tree.@parentid"/>
							</action>
							<action type="datarun nonquery" value="~dtRuteLNParStruKopiraj" />
							<action type="control focus" value="#tree">
								<parameter value="$ruteId" type="int" />
							</action>
							<action type="control populate keepfocus"  value="#grdGlava"/>							
						</event>
					</menuitem>
					<menuitem type="separator"/>
					<menuitem caption="Odustani"/>
				</menu>
				<menu>
					<menuitem caption="Unesi rajon">
						<event type="click" >
						<action type="form open" value="frmRajoniDodaj">
							<parameter name="$NoviId" value="0" type="int"  />
						</action>

						</event>
					</menuitem>
					<menuitem caption="Unesi rutu">
						<event type="click" >
							<action type="form open" value="frmRutaDodaj">
							<parameter name="NoviId1" value="0" type="int"  />
							<parameter name="Rajon1" value="#tree.@Opis" type="string" />
							<parameter name="RajonId1" value="#tree.@rajonid" type="int" />
						</action>
						</event>
					</menuitem>
					<menuitem caption="Izmjeni">
						<event type="click" >
							<action type="form open" value="frmRajoniIzmjeni" if="#tree.@ruteid==0">
								<parameter name="NoviId2" value="#tree.@Id" type="int" />
								<parameter name="RajonId2" value="#tree.@rajonid" type="int" />
							</action>
							<action type="form open" value="frmRutuIzmijeni" else="">
								<parameter name="NoviId4" value="#tree.@ruteid" type="int" />
								<parameter name="Ruta1" value="#tree.@caption" type="string" />
							</action>
						</event>
					</menuitem>
					<menuitem caption="Obriši">
						<event type="click">
							<action type="confirm" value="'Želite li obrisati rajon?'" if="#tree.@ruteid==0">							
								<action type="datarun scalar" value="~dtRajonObrisi">
									<parameter name="$Noviid8" />
								</action>
								<action type="control populate" value="#tree" if="$Noviid8!=null">
									<action type="control focus" value="#tree">
										<parameter value="$NoviId8" type="int" />
									</action>
								</action>
							</action>
							<action type="confirm" value="'Želite li obrisati rutu?'" else="">							
								<action type="datarun scalar" value="~dtRutuObrisi">
									<parameter name="$Noviid7" />
								</action>
								<action type="control populate" value="#tree" if="$Noviid7!=null">
									<action type="control focus" value="#tree">
										<parameter value="$NoviId7" type="int" />
									</action>
								</action>
							</action>
						</event>
					</menuitem>
				</menu>				
			</tree>
			<grid name="grdGlava" type="master" keyfield="ParStruId" dataname="dtRuteLNParStruQuery" searchfield="parstruid" savelayout="true" multiselect="True" allowdrag="true" >
			
				<event type="cellvaluechanged">
					<action type="datarun nonquery" value="~dtUmirovljeno" if="#grdGlava.focusedfield==Neaktivno" />
					<action type="control populate keepfocus" value="#grdGlava" />
				</event>
				
				<event type="focusedrowchanged">
					<action type="control enable" value="#btnDinamika" if="#grdGlava.rowcount!=0" />
					<action type="control disable" value="#btnDinamika" else="" />
				</event>
				
				<fields inherited="true">
					<field name="Neaktivno" caption="Neaktivno"  editable="true" edittype="bit"/>
				</fields>
			</grid>
		</managerlayout>
			<panelbuttons>
				<buttons>
					<button name="btnPrijaviLokaciju" caption="PRIJAVI LOKACIJU" function="insert">
						<event type="click">
							<action type="form open" value="frmLokacijaDodaj" if="#tree.@ruteid!=0">
								<parameter name="RuteId5" value="#tree.@ruteid" type="int"/>
								<parameter name="Ruta7" value="#tree.@caption"/>
							</action>
							<!-- <action type="control populate keepfocus"  value="#grdGlava"/> -->
						</event>					
					</button>
					<button name="btnObrisiLokaciju" caption="UKLONI LOKACIJU" function="delete">
						<event type="click">
							<action type="confirm" value="'Želite li ukloniti lokacije iz rute?'" >	
								<action type="datarun nonquery" value="~dtRuteLNParStruDelete"/>
								<action type="control populate keepfocus"  value="#grdGlava"/>
							</action>
						</event>					
					</button>
					<button name="btnFilter" caption="FILTER" function="filter">
						<event type="click">
							<action type="form open" value="frmFilter" >
							</action>
							<action type="control populate"  value="#grdGlava"/>
						</event>
					</button>
					<button name="btnSearch" caption="PRONAĐI" function="pronadji">
						<event type="click">		
							<action type="search" value="dtSearch" ></action>
						</event>
					</button>
					<button name="btnDinamika" caption="PARAMETRI DINAMIKE" function="dinamika">
						<event type="click">
							<!-- <action type="message" value="#grdGlava.@RuteLnParStruId" /> -->
							<action type="form open" value="frmDinamika" if="#grdGlava.@RuteLnParStruId!=null" >
								<parameter name="Lokacija5" value="#grdGlava.@Lokacija"/>
								<parameter name="LokacijaId5" value="#grdGlava.@RuteLNParStruId"/>
								<parameter name="Dinamika" value="#grdGlava.@DinamikaId"/>
							</action>
							<action type="control populate keepfocus"  value="#grdGlava"/>
						</event>
					</button>
					<button name="btnUp" image="top" imagelocation="middlecenter" function="sortup">
						<event type="click">
							<action type="variable value" value="$smjer">
								<parameter name="smjer" value="0"/>
							</action>	
							<action type="datarun nonquery" value="~dtRuteLNParStruUp"/>
							<action type="control populate keepfocus"  value="#grdGlava"/>
						</event>					
					</button>
					<button name="btnDown" image="bottom" imagelocation="middlecenter" function="sortdown" >
						<event type="click">
							<action type="variable value" value="$smjer">
								<parameter name="smjer" value="1"/>
							</action>							
							<action type="datarun nonquery" value="~dtRuteLNParStruDown"/>
							<action type="control populate keepfocus"  value="#grdGlava"/>
						</event>					
					</button>		
				</buttons>
			</panelbuttons>		
		<datalist>
			<data command="spProd_Rute_Tree_Query" name="dtTreeRute">
			</data>
			<data command="spProd_Rute_RuteLNParStru_Query" name="dtRuteLNParStruQuery">
				<parameter name="@ID" value="#tree.@id" />
				<parameter name="@Umirovljeno" value="$Aktivan" type="int"/>
			</data>
			<data command="spProd_Rute_RuteLNParStru_Prenesi" name="dtRuteLNParStruPrenesi">
				<parameter name="@ID" value="$ruteId" />
				<parameter name="@IDStari" value="$staritreeid" />
				<parameter name="@ParStruId" value="#grdGlava.selectedids" />					
			</data>				
			<data command="spProd_Rute_RuteLNParStru_Delete" name="dtRuteLNParStruDelete">
				<parameter name="@ID" value="#grdGlava.selectedids" />
				<parameter name="@RuteId" value="#tree.@ruteid" />
			</data>
			<data command="spProd_Rute_RuteLNParStru_Kopiraj" name="dtRuteLNParStruKopiraj">
				<parameter name="@ID" value="$ruteId" />
				<parameter name="@IDStari" value="$staritreeid" />
				<parameter name="@ParStruId" value="#grdGlava.selectedids" />
			</data>
			<data command="spProd_Rute_Rajon_Obrisi" name="dtRajonObrisi">
				<parameter name="@ID" value="#tree.@rajonid" />
			</data>
			<data command="spProd_Rute_Rutu_Obrisi" name="dtRutuObrisi">
				<parameter name="@ID" value="#tree.@ruteid" />
				<parameter name="@RajonId" value="#tree.@rajonid" />
			</data>
			<data command="spProd_Rute_RuteLNParStru_Umirovljen"   name="dtUmirovljeno">
				<parameter name="@ID" value="#grdGlava.@RuteLnParStruId"/>
				<parameter name="@Umirovljeno" value="#grdGlava.@Neaktivno"/>
			</data>
			<data command="spProd_Rute_Lokacija_Search" name="dtSearch">
				<parameter name="@Uvjet" value="#btnSearch.searchtext" />
			</data>
			<data command="spProd_Rute_RuteLNParStru_Up" name="dtRuteLNParStruUp">
				<parameter name="@ID" value="#grdGlava.@RuteLnParStruId" />					
			</data>
			<data command="spProd_Rute_RuteLNParStru_Down" name="dtRuteLNParStruDown">
				<parameter name="@ID" value="#grdGlava.@RuteLnParStruId" />					
			</data>				
		</datalist>
	</form>
	<form name="frmRajoniDodaj" caption="Dodaj rajon" width="400" fixedsize="true">
		<layout >
			<group cols="1" rows="2" >
				<item caption="Naziv:" col="1" row="1">
					<textedit name="txtNaziv"  required="True"  />
				</item>
				<item caption="Šifra:" col="1" row="2">
					<textedit name="txtSifra"  required="True"  />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDodajRajon">
							<parameter name="parent.$Noviid" />
						</action>
						
						<action type="control populate" value="parent.#tree">
							<action type="control focus" value="parent.#tree">
								<parameter value="parent.$NoviId" type="int" />
							</action>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<!-- <button name="btnOdustani" caption="ODUSTANI" > -->
					<!-- <action type="form close"/> -->
				<!-- </button> -->
			<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rute_Rajon_Dodaj" name="dtDodajRajon">
				<parameter name="@Sifra" value="#txtSifra"/>
				<parameter name="@Opis" value="#txtNaziv"/>
			</data>
		</datalist>
	</form>
	
	<form name="frmRutaDodaj" caption="Dodaj rutu" width="400" fixedsize="true">
		<event type="shown">
		
			<action type="control value" value="#txtRajon" >
				<parameter value="$Rajon1" type="string"/>
			</action>
	
		</event>
		<layout >
			<group cols="1" rows="2" >
				<item caption="Rajon:" col="1" row="1">
					<textedit name="txtRajon"  enabled="false"   />
				</item>
				<item caption="Naziv:" col="1" row="2">
					<textedit name="txtNaziv"  required="True"  />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDodajRutu">
							<parameter name="parent.$Noviid1" />
						</action>
						<action type="control populate" value="parent.#tree">
							<action type="control focus" value="parent.#tree">
								<parameter value="parent.$NoviId1" type="int" />
							</action>
						</action>
						<action type="form close"/>

					</event>
				</button>
				<!-- <button name="btnOdustani" caption="ODUSTANI" > -->
					<!-- <action type="form close"/> -->
				<!-- </button> -->
				<button name="btnOdustani1" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rute_Rutu_Dodaj" name="dtDodajRutu">
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@RajonId" value="$RajonId1"/>
			</data>
		</datalist>
	</form>
	
	<form name="frmRajoniIzmjeni" caption="Izmjeni rajon" width="400" fixedsize="true">
	
		<event type="init">		
			<action type="datarun reader" value="~dtRajonQuery" />
		</event>
	
		<event type="load">
			<action type="control value" value="#txtNaziv" >
				<parameter value="~dtRajonQuery.@Opis"/>
			</action>
			<action type="control value" value="#txtSifra" >
				<parameter value="~dtRajonQuery.@Sifra"/>
			</action>
		</event>
	
		<layout >
			<group cols="1" rows="2" >
				<item caption="Naziv:" col="1" row="1">
					<textedit name="txtNaziv"  required="True"  />
				</item>
				<item caption="Šifra:" col="1" row="2">
					<textedit name="txtSifra"  required="True"  />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<action type="validate"/>
						<action type="datarun noquery" value="~dtIzmjeniRajon">
						</action>
						<action type="form close"/>
						
						<action type="control populate" value="parent.#tree">
							<action type="control focus" value="parent.#tree">
								<parameter value="$NoviId2" type="int" />
							</action>
						</action>
						
						<!-- <action type="control populate" value="parent.#grdGrid"> -->
							<!-- <action type="control focus" value="parent.#grdGrid"> -->
								<!-- <parameter value="parent.$NoviId" /> -->
							<!-- </action> -->
						<!-- </action> -->
					</event>
				</button>
				<!-- <button name="btnOdustani1" caption="ODUSTANI" > -->
					<!-- <action type="form close"/> -->
				<!-- </button> -->
				<button name="btnOdustani2" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rute_Rajon_Query" name="dtRajonQuery">
				<parameter name="@ID" value="$RajonId2"/>
			</data>
			<data command="spProd_Rute_Rajon_Izmjeni" name="dtIzmjeniRajon">
				<parameter name="@ID" value="$RajonId2"/>
				<parameter name="@Sifra" value="#txtSifra"/>
				<parameter name="@Opis" value="#txtNaziv"/>
			</data>
		</datalist>
	</form>
	
	<form name="frmRutuIzmijeni" caption="Izmjeni rutu" width="400" fixedsize="true">
		<event type="shown">
		
			<action type="control value" value="#txtNaziv" >
				<parameter value="$Ruta1" type="string"/>
			</action>
	
		</event>
		<layout >
			<group cols="1" rows="1" >
				<item caption="Naziv:" col="1" row="2">
					<textedit name="txtNaziv"  required="True"  />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<action type="validate"/>
						<action type="datarun noquery" value="~dtRutuIzmjeni">
						</action>
						<action type="control populate" value="parent.#tree">
							<action type="control focus" value="parent.#tree">
								<parameter value="$NoviId4" type="int" />
							</action>
						</action>
						<action type="form close"/>

					</event>
				</button>
				<!-- <button name="btnOdustani" caption="ODUSTANI" > -->
					<!-- <action type="form close"/> -->
				<!-- </button> -->
				<button name="btnOdustani1" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rute_Rutu_Izmjeni" name="dtRutuIzmjeni">
				<parameter name="@ID" value="$NoviId4"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				
			</data>
		</datalist>
	</form>
	
	<form name="frmLokacijaDodaj" caption="Odabir lokacije"  width="900" height="500">
		
		<event type="shown">
		
			<action type="control value" value="#Caption2" >
				<parameter value="$Ruta7" type="string"/>
			</action>
	
		</event>
	
		<layout>
			<group cols="3" rows="2" >
				<columnsdefinition>
					<column position="1" size="3%"/>
					<column position="2" size="1%"/>
					<column position="3" size="3%"/>
				</columnsdefinition>

				<item caption="Naziv:" col="1" row="1">
					<textedit name="txtLokacija"    />
				</item>
				<group  cols="1" rows="2" col="2" row="1" padding="0" bordervisible="false">
					<item  row="2" col="1" >
					  <button name="btnIzvrsi5" caption="TRAŽI" >
						<event type="click">
							<action type="control populate" value="#grdLokacija" />
						</event>
					  </button>
					</item>
				</group>
				<group  cols="2" rows="2" col="3" row="1" bordervisible="false">
					<columnsdefinition>
						<column position="1" size="40"/>
						<!-- <column position="2" size="30%"/> -->
					</columnsdefinition>
					<item row="1" col="2"    >
						<labeledit   name="Caption1" value="Ruta:" />
					</item>
					<item row="2" col="2"    >
						<labeledit   name="Caption2"  fontsizedelta="2" />
					</item>
				</group>
				<item row="2" col="1"  colspan="3" >
					<grid name="grdLokacija" key="parstruid" dataname="dtLokacijeQuery" multiselect="true" savelayout="true" >
					
					</grid>		
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi1" caption="PRIJAVI" >
					<event type="click">
						<action type="datarun nonquery" value="~dtRuteLNParStruInsert"/>
						<action type="form close"/>
						<action type="control populate keepfocus"  value="parent.#grdGlava"/>
					</event>
				</button>
				<button name="btnKraj2" caption="ZATVORI" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rute_Lokacija_Query" name="dtLokacijeQuery">
				<parameter name="@ID" value="$RuteId5"/>
				<parameter name="@Uvjet" value="#txtLokacija"/>
			</data>
			<data command="spProd_Rute_RuteLNParStru_Insert" name="dtRuteLNParStruInsert">
				<parameter name="@ID" value="$RuteId5"/>				
				<parameter name="@ParStruId" value="#grdLokacija.selectedids"/>
			</data>
		</datalist>
	</form>
	
	<form name="frmFilter" caption="Filter" width="100" fixedsize="true">
	
		<event type="load">
			<action type="control value" value="#rdoAktivni" if="parent.$Aktivan==0">
				<parameter value="true" />
			</action>
			<action type="control value" value="#rdoUmirovljeni" if="parent.$Aktivan==1">
				<parameter value="true" />
			</action>
			<action type="control value" value="#rdoSvi" if="parent.$Aktivan==null">
				<parameter value="true" />
			</action>
		</event>
	
		<layout textposition="left">
			<group cols="3" rows="3" >
				<columnsdefinition>
					<column position="1" size="25%"/>
					<column position="2" size="60%"/>
					<column position="3" size="20%"/>
				</columnsdefinition>
				<item caption="Pokaži aktivne" col="2" row="1">
					<radioedit name="rdoAktivni"  groupindex="1" >
						<event type="checkedchanged">
						
							<action type="variable value" value="parent.$Aktivan">
								<parameter  value="0" type="int" if="#rdoAktivni==true"/>
								<parameter  value="null" type="int" else=""/>
							</action>
						</event>
					</radioedit>
				</item>
				<item caption="Pokaži neaktivne       " col="2" row="2">
					<radioedit name="rdoUmirovljeni" value="false"  groupindex="1" >
						<event type="checkedchanged">
							
							<action type="variable value" value="parent.$Aktivan">
