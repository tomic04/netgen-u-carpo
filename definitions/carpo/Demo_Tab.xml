<root>
	<form name="master" type="master" caption="Izvještaj otpremnica" width="1100" height="600">
		<event type="init">
		</event> 

		<managerlayout>
			<grid name="grdMG"  type="master" showfooter="True" showgrouppanel="true" bestfitonrefresh="true">
				<data command="spCDZ_Demo_Tab">
					<parameter name="@action" value="0" />
				</data>	
				<fields inherited="true">
				</fields>
				<event type="focusedrowchanged">
					<!-- <action type="control datasourceempty" value="#grdOperateri, #grdKadrovi"/>				 -->
					<action if="#tabs.selectedtab==tabOperateri">
						<action type="control populate" value="#grdOperateri"/>
					</action>
					<action elseif="#tabs.selectedtab==tabKadrovi">
						<action type="control populate" value="#grdKadrovi"/>
					</action>					
				</event>
			</grid>
			<tabs name="tabs">
				<event type="selectedtabchanged">
					<action type="control populate" value="#grdOperateri" if="#tabs.selectedtab==tabOperateri"/>
					<action type="control populate" value="#grdKadrovi" else=""/>
				</event>			
				<tab caption="Operateri" name="tabOperateri">			
					<grid name="grdOperateri" showgrouppanel="true" showautofilterrow="true" savelayout="true" dataname="dtOperateri" multiselect="true">
						<fields>
						</fields>
					</grid>
				</tab>
				<tab caption="Kadrovi" name="tabKadrovi">			
					<grid name="grdKadrovi" showgrouppanel="true" showautofilterrow="true" savelayout="true" dataname="dtKadrovi" multiselect="true">
						<fields>
						</fields>
					</grid>
				</tab>
			</tabs>
		</managerlayout>
		<panelbuttons>
			<buttons>

			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCDZ_Demo_Tab" name="dtOperateri">
				<parameter name="@action" value="1" />
			</data>	
			<data command="spCDZ_Demo_Tab" name="dtKadrovi">
				<parameter name="@action" value="2" />
			</data>					
		</datalist>	
	</form>

</root>