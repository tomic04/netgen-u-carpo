<root>
	<form type="master" name="frmMaster" caption="Izračun licenci">
		<event type="init">
			<action type="variable value">
				<parameter name="global.Od" value="null" type="datetime"/>
				<parameter name="global.Do" value="null" type="datetime"/>
				<parameter name="global.Korisnik" value="null" type="int"/>
				<parameter name="global.Init" value="null" type="int"/>
			</action>
			<action type="form open" value="frmFilter"/>
		</event>
		<managerlayout>
			<grid name="grdMaster" type="master" dataname="~dtMaster" caption="Izračun licenci" showcheckboxes="true" multiselect="true" key="suppKorisnikId" bestfitonrefresh="true">
				<fields>
					<field name="Partner" caption="Support nositelj"/>
					<field name="Partner" caption="Support korisnik"/>
					<field name="VrijednostLic" caption="Vrijednost licence"/>
					<field name="Datum"/>
					<field name="BrojJSCALs" caption="Broj JS CALs"/>
					<field name="VrstaOstCALs" caption="Vrsta Ost CALs"/>
					<field name="BrojOstCALs" caption="Broj Ost CALs"/>
					<field name="Opis" editable="true"/>
					<field name="VrijednostKlijenta" caption="Vrijednost klijenta"/>
					<field name="NovaVrijednostKlijenta" caption="Nova vrijednost klijenta"/>
					<field name="Primijeni" editable="true" edittype="bool"/>
				</fields>
				<event type="showingeditor">
					<action type="editor allow" value="true" if="#grdMaster.focusedfield==Opis"/>
					<action type="editor allow" value="true" if="#grdMaster.focusedfield==Primijeni&amp;&amp;#grdMaster.@VrijednostKlijenta!=#grdMaster.@NovaVrijednostKlijenta"/>
				</event>
				<styles>
					<style name="fontcolor" value="green" if="#grdMaster.@VrijednostKlijenta!=#grdMaster.@NovaVrijednostKlijenta"/>
				</styles>
				<event type="doubleclick">
					<action type="form open" value="frmIzmijeni">
						<parameter name="SuppKorisnikId" value="#grdMaster.@SuppKorisnikId"/>
						<parameter name="Opis" value="#grdMaster.@Opis"/>
						<parameter name="Primijeni" value="#grdMaster.@Primijeni"/>
					</action>
				</event>
			</grid>
			<grid name="grdDetail" dataname="~dtDetail" caption="Dodane licence" showcheckboxes="true" multiselect="true" key="FakDetaljId" bestfitonrefresh="true">
				<fields>
					<field name="Partner" caption="Support nositelj"/>
					<field name="SuppKorisnik" caption="Support korisnik"/>
					<field name="VrijednostLic" caption="Vrijednost licence"/>
					<field name="Rabat" caption="Popust"/>
					<field name="Datum"/>
					<field name="BrojJSCALs" caption="Broj JS CALs"/>
					<field name="VrstaOstCALs" caption="Vrsta Ost CALs"/>
					<field name="BrojOstCALs" caption="Broj Ost CALs"/>
					<field name="Opis"/>
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="control foreachrow selected" value="grdMaster">
							<action type="datarun nonquery" value="~dtDodaj"/>
						</action>
						<action type="control populate" value="#grdDetail, #grdMaster"/>
					</event>
				</button>
				<button name="btnUkloni" caption="Ukloni">
					<event type="click">
						<action type="control foreachrow selected" value="grdDetail">
							<action type="datarun nonquery" value="~dtUkloni"/>
						</action>
						<action type="control populate" value="#grdMaster, #grdDetail"/>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni" dock="right">
					<event type="click">
						<action type="form open" value="frmIzmijeni">
							<parameter name="SuppKorisnikId" value="#grdMaster.@SuppKorisnikId"/>
							<parameter name="Opis" value="#grdMaster.@Opis"/>
							<parameter name="Primijeni" value="#grdMaster.@Primijeni"/>
						</action>
					</event>
				</button>
				<button name="btnFilter" caption="Filter" dock="right">
					<event type="click">
						<action type="form open" value="frmFilter"/>
						<action type="control populate" value="#grdDetail, #grdMaster"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spSuppIzracunLicCarpo">
				<parameter name="@DatumOd" value="global.$Od"/>
				<parameter name="@DatumDo" value="global.$Do"/>
				<parameter name="@SuppKorisnikId" value="global.$Korisnik"/>
				<parameter name="@Tip" value="1"/>
			</data>
			<data name="dtDetail" command="spSuppIzracunLicCarpo">
				<parameter name="@DatumOd" value="global.$Od"/>
				<parameter name="@DatumDo" value="global.$Do"/>
				<parameter name="@SuppKorisnikId" value="global.$Korisnik"/>
				<parameter name="@Tip" value="2"/>
			</data>
			<data name="dtDodaj" command="spBugsSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@SuppKorisnikId" value="#grdMaster.@SuppKorisnikId"/>
				<parameter name="@Opis" value="#grdMaster.@Opis"/>
				<parameter name="@BrojJSCALs" value="#grdMaster.@BrojJSCALs"/>
				<parameter name="@BrojOstCALs" value="#grdMaster.@BrojOstCALs"/>
				<parameter name="@VrstaOstCALs" value="#grdMaster.@VrstaOstCALs"/>
				<parameter name="@VrijednostLic" value="#grdMaster.@VrijednostLic"/>
				<parameter name="@Popust" value="#grdMaster.@Rabat"/>
				<parameter name="@OstaliCALs" value="#grdMaster.@OstaliCALs"/>
				<parameter name="@FakDetaljId" value="#grdMaster.@FakDetaljId"/>
				<parameter name="@FakDatumDok" value="#grdMaster.@Datum"/>
				<parameter name="@changedVrKlijenta" value="#grdMaster.@Primijeni"/>
			</data>
			<data name="dtUkloni" command="spBugsSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@FakDetaljId" value="#grdDetail.@FakDetaljId"/>
			</data>
		</datalist>
	</form>
	<form name="frmIzmijeni" caption="{parent.#grdMaster.@Partner}">
		<event type="load">
			<action type="control value" value="#cmbSupportKorisnik">
				<parameter value="$SuppKorisnikId"/>
			</action>
			<action type="control value" value="#chkPrimijeni">
				<parameter value="$Primijeni"/>
			</action>
			<action type="control value" value="#memOpis">
				<parameter value="$Opis"/>
			</action>
			<action type="control disable" value="#chkPrimijeni" if="parent.#grdMaster.@VrijednostKlijenta==parent.#grdMaster.@NovaVrijednostKlijenta"/>
		</event>
		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Support korisnik:">
					<comboedit name="cmbSupportKorisnik" dataname="~dtSupportKorisnik" valuefield="SuppKorisnikId" displayfield="Naziv"/>
				</item>
				<item row="1" col="2" caption="Primijeni:">
					<checkedit name="chkPrimijeni"/>
				</item>
				<item row="2" col="1" colspan="2" caption="Opis:">
					<memoedit name="memOpis"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtSpremi"/>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSpremi" command="spBugsSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@SuppKorisnikId" value="#cmbSupportKorisnik"/>
				<parameter name="@Opis" value="#memOpis"/>
				<parameter name="@BrojJSCALs" value="parent.#grdMaster.@BrojJSCALs"/>
				<parameter name="@BrojOstCALs" value="parent.#grdMaster.@BrojOstCALs"/>
				<parameter name="@VrstaOstCALs" value="parent.#grdMaster.@VrstaOstCALs"/>
				<parameter name="@VrijednostLic" value="parent.#grdMaster.@VrijednostLic"/>
				<parameter name="@Popust" value="parent.#grdMaster.@Rabat"/>
				<parameter name="@OstaliCALs" value="parent.#grdMaster.@OstaliCALs"/>
				<parameter name="@FakDetaljId" value="parent.#grdMaster.@FakDetaljId"/>
				<parameter name="@FakDatumDok" value="parent.#grdMaster.@Datum"/>
				<parameter name="@changedVrKlijenta" value="#chkPrimijeni"/>
			</data>
			<data name="dtSupportKorisnik" command="spBugsSuppIzracunLicQueryCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@PartneriId" value="parent.#grdMaster.@PartneriId"/>
			</data>
		</datalist>
	</form>
	<form name="frmFilter" caption="Filter">
		<event type="init">
			<action type="datarun reader" value="~dtOd" if="global.$Init==null"/>
			<action type="datarun reader" value="~dtDo" if="global.$Init==null"/>
			<action type="variable value" value="global.$Init">
				<parameter value="1"/>
			</action>
		</event>
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" caption="Od:">
					<dateedit name="datOd" datavalue="~dtOd.@Od" required="true" allownull="false" savevalue="session"/>
				</item>
				<item row="2" col="1" caption="Do:">
					<dateedit name="datDo" datavalue="~dtDo.@Do" required="true" allownull="false" savevalue="session"/>
				</item>
				<item row="3" col="1" caption="Korisnik:">
					<comboedit name="cmbKorisnik" dataname="~dtKorisnik" valuefield="PartneriId" displayfield="Naziv" savevalue="session"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPotvrdi" caption="Potvrdi">
					<event type="click">
						<action type="validate"/>
						<action type="variable value">
							<parameter name="global.$Od" value="#datOd" type="datetime"/>
							<parameter name="global.$Do" value="#datDo" type="datetime"/>
							<parameter name="global.$Korisnik" value="#cmbKorisnik" type="int"/>
						</action>
						<action type="control populate" value="parent.#grdDetail"/>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtOd" command="SELECT DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0) AS Od" type="text"/>
			<data name="dtDo" command="SELECT DATEADD(MONTH, DATEDIFF(MONTH, -1, GETDATE())-1, -1) AS Do" type="text"/>
			<data name="dtKorisnik" command="spBugsSuppQueryCarpo">
				<parameter name="@Action" value="KORISNIK"/>
			</data>
		</datalist>
	</form>
</root>