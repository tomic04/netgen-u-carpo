<!--v 1.0.2. 2.1.2024. AA control focus na neku kontrolu koja nije dateedit jer se inače javi greška SendKeys-->
<!--v 1.0.1. 17.11.2017. ispravak upozorenja s obzirom na povijest blokada -->
<root loglevel="3" version="1.0.2">
	<form name="frmBlokada" caption="Blokada" type="master" width="400" height="400" saveformsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtSelect"/>
		</event>
		<event type="load">
			<action type="control value" value="#datDatumOd">
				<parameter value="~dtSelect.@Od"/>
			</action>
			<action type="control value" value="#datDatumDo">
				<parameter value="~dtSelect.@Do"/>
			</action>
			<action type="control focus" value="#btnSpremi"/>
		</event>
		<event type="shown">
			<action type="datarun scalar" value="~dtSelect">
				<parameter name="ID"/>
			</action>
			<action type="control populate" value="#grdBlokade"/>
		</event>
		<layout>
			<group rows="3" cols="3" groupbordervisible="false" caption="Unesite novu blokadu:">
				<columnsdefinition>
					<column size="200" position="1"/>
					<column size="200" position="2"/>
				</columnsdefinition>
				<rowsdefinition>
					<row size="50" position="1"/>
					<row size="50" position="2"/>
				</rowsdefinition>
				<item col="1" row="1" caption="Od:"  textposition="left">
					<dateedit name="datDatumOd"/>
				</item>
				<item col="2" row="1" caption="Do:"  textposition="left" >
					<dateedit name="datDatumDo"/>
				</item>
				<item row="2" col="1" >
					<button name="btnSpremi" caption="Spremi">
						<event type="click">
							<action type="datarun scalar" value="~dtInsert">
								<parameter name="ID"/>
							</action>
							<action type="control populate" value="#grdBlokade"/>
							<action type="control focus" value="#grdBlokade">
								<parameter value="$ID" type="int"/>
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="2">
					<button name="btnOdustani" type="cancel" caption="Odustani"/>
				</item>
				<item col="1" row="3" colspan="3" caption="Nedavne blokade">
					<grid name="grdBlokade" bestfitonrefresh="true"  dataname="~dtGrid" enabled="true" saveformsize="true" showautofilterrow="false" showgrouppanel="false"   >
						<event type="cellvaluechanged">
							<action type="datarun reader" value="~dtSelect">
								<parameter name="ID"/>
							</action>
						</event>
						<fields >
							<field name="Od" minwidth="90"/>
							<field name="Do" minwidth="90"/>
							<field name="Danas" caption="Datum unosa" minwidth="90"/>
							<field name="Operater"  />
						</fields>	
					<styles>
						<style name="bold" value="true" if="#grdBlokade.@KntBlokadaId==$ID" />
					</styles>
					</grid>
				</item>
			</group>
		</layout>
		<datalist>
			<data name="dtSelect" command="spCKntBlokada" >
				<parameter name="@Action" value="1"/>
			</data>
			<data name="dtInsert" command="spCKntBlokada">
				<parameter name="@Action" value="2"/>
				<parameter name="@Od" value="#datDatumOd"/>
				<parameter name="@Do" value="#datDatumDo"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>
			<data name="dtGrid" command="spCKntBlokada">
				<parameter name="@Action" value="3"/>
			</data>
		</datalist>
	</form>
</root>