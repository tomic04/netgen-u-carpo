<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
	<form name="frmMaster"  type="master" caption="Pregled dimenzija u Kontoru">
		<event type="load">
			<action type="form open" value="frmPregled"/>
			<action type="variable value" value="global.$Close" if="dialogresult==cancel"> 
				<parameter value="true" type="bool"/> 
			</action> 
		</event>
		<event type="shown">
			<action type="form close" if="global.$Close==true"/> 
		</event>
		<managerlayout> 
			<grid name="grdMaster" async="true" type="master" multiselect="true" autopopulate="false" key="kntprometid"  dataname="dtMaster" savelayout="true" bestfitonrefresh="true">
				<event type="doubleclick">
					<action type="form open" value="frmIzmijeniDimenziju" >
						<parameter name="Kntprometid" value="#grdMaster.@Kntprometid"/>
					</action>	
				</event>
				<fields inherited="true">
					<field name="KntPrometId" caption="KntPrometId" visible="false"/>
					<field name="Datum Knjiženja1500" caption="Datum knjiženja" visible="true"/>
					<field name="Datum Dokumenta1500" caption="Datum dokumenta" visible="true"/>
					<field name="Konto1000" caption="Konto" visible="true"/>
					<field name="Naziv Konta2000" caption="Naziv konta" visible="true"/>
					<field name="Vrsta Dokumenta1500" caption="Vrsta dokumenta" visible="true"/>
					<field name="Broj Temeljnice1500" caption="Broj temeljnice" visible="true"/>
					<field name="Opis Knjiženja2000" caption="Opis knjiženja" visible="true"/>
					<field name="Org. Shema2000" caption="Organizacijska shema" visible="true"/>
					<field name="Duguje1000" caption="Duguje" visible="true"/>
					<field name="Potražuje1000" caption="Potražuje" visible="true"/>
					<field name="Partner1000" caption="Partner" visible="true"/>
					<field name="Račun1000" caption="Račun" visibe="true"/>
					<field name="Inicijali0700" caption="Inicijali" visibel="true"/>
					<field name="Dimenzije" caption="Dimenzije" visible="true"/>
				</fields>				
			</grid>	
		</managerlayout>
		<panelbuttons> 
			<buttons> 
				<button name="btnParametri" caption="Pregled" >
					<event type="click">
						<action type="form open" value="frmPregled"/>
					</event>
				</button>
				<button name="btnEditDetalj" caption="Izmijeni" >
					<event type="click">
						<action type="form open" value="frmIzmijeniDimenzijeMulti">
							<parameter name="KntPrometId" value="#grdMaster.@KntPrometId"/>
						</action>
						<action type="variable value">
							<parameter name="Global.$DimVrsteid" value="#cmbDimVrste" />		
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntDimQuery" name="dtMaster" timeout="400">
				<parameter name="@DatumOd" value="Global.$DatumOd" /> 
				<parameter name="@DatumDo" value="Global.$DatumDo" /> 
				<parameter name="@VrstaDokId" value="Global.$VrstaDokId" />  
				<parameter name="@OrgShemaId" value="Global.$OrgShemaId"/> 
				<parameter name="@BrojDok" value="Global.$BrojDok"/> 
				<parameter name="@Konto" value="Global.$Konto"/> 
				<parameter name="@DimVrsteid" value="Global.$DimVrsteid"/> 
				<parameter name="@Dimenzijeid" value="Global.$Dimenzijeid"/> 
			</data>
		</datalist>
	</form>
	<form name="frmPregled"  caption="Izaberi parametre upita">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<layout textposition="top">
			<group rows="7" cols="2" colspan="2">
				<item col="1" row="1" caption="Datum od:" > 
					<dateedit name="datDatumOd" required="true" savevalue="app">
					</dateedit>
				</item>
				<item col="2" row="1" caption="Datum do:" >
					<dateedit name="datDatumDo" value="now" required="true" savevalue="app">
					</dateedit>
				</item>
				<item col="1" row="2"  caption="Vrsta dokumenta:" colspan="2">
					<comboedit name="cmbVrstaDok" required="true" dataname="~dtVrstaDok" valuefield="VrstaDokId" displayfield="Naziv" savevalue="app"/>
				</item>
				<item col="1" row="3"  caption="Organizacijska shema:" colspan="2" >
					<comboedit name="cmbOrgShema" required="true" dataname="~dtOrgShema" valuefield="OrgShemaId" displayfield="Naziv" savevalue="app"/>
				</item>
				<item col="1" row="4"  caption="Dio konta:" colspan="2">
					<textedit name="txtKonto" savevalue="app" >
					</textedit>
				</item>
				<item col="1" row="5"  caption="Broj dokumenta:" colspan="2">
					<textedit name="txtBrojDok" savevalue="app"  >
					</textedit>
				</item>
				<item col="1" row="6"  caption="Vrsta dimenzija:" colspan="2">
					<comboedit name="cmbDimVrste" dataname="~dtDimVrste"  displayfield="naziv" valuefield="DimVrsteid" autopopulate="true" allownull="true" savevalue="app">
					<event type="valuechanged">
						<action type="control populate" value="cmbDimenzije"/>
					</event>
					</comboedit>
				</item>
				<item col="1" row="7"  caption="Dimenzija:" colspan="2">
					<comboedit name="cmbDimenzije" dataname="~dtDimenzije" displayfield="Naziv" valuefield="Dimenzijeid" autopopulate="true" allownull="true" savevalue="app"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPokaži" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="Global.$DatumOd" value="#datDatumOd"  />
							<parameter name="Global.$DatumDo" value="#datDatumDo"  />
							<parameter name="Global.$OrgShemaId" value="#cmbOrgShema" />
							<parameter name="Global.$VrstaDokId" value="#cmbVrstaDok"  />
							<parameter name="Global.$Konto" value="#txtKonto" />		
							<parameter name="Global.$BrojDok" value="#txtBrojDok" />
							<parameter name="Global.$DimVrsteid" value="#cmbDimVrste" />		
							<parameter name="Global.$Dimenzijeid" value="#cmbDimenzije" />
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntDimQueryKontrole" name="dtVrstaDok"> 
				<parameter name="@Action" value="1"/>  
			</data>
			<data command="spCKntDimQueryKontrole" name="dtOrgShema"> 
				<parameter name="@Action" value="2"/>  
			</data>			
			<data command="spCKntDimQueryKontrole" name="dtDimVrste"> 
				<parameter name="@Action" value="3"/>  
				<parameter name="@DimenzijeId" value="#cmbDimenzije"/>
			</data>	
			<data command="spCKntDimQueryKontrole" name="dtDimenzije"> 
				<parameter name="@Action" value="5"/> 
				<parameter name="@DimVrsteId" value="#cmbDimVrste"/>				 
			</data>	
			<data command="spCKntDimQuery" name="dtQuery"> 
			</data>
		</datalist>
	</form>
	<form name="frmIzmijeniDimenzijeMulti" caption="Izmijeni dimenzije">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<event type="shown">
			<action type="control disable" value="#txtKonto,#txtNazivKonta,#txtRacun, #txtOpis, #txtOrgShema"/>
		</event> 
		<!-- <event> -->
			<!-- <action type="control populate" value="#cmbDimenzije"> -->
				<!-- <parameter value="$Dimenzijeid" /> -->
			<!-- </action> -->
		<!-- </event> -->
		<layout textposition="top">	
			<group rows="7" cols="1" colspan="2">	
				<item col="1" row="1"  caption="Konto:">
					<textedit name="txtKonto"  savevalue="app" datavalue="~dtGet.@Konto">
					</textedit>
				</item>
				<item col="1" row="2"  caption="Naziv konta:">
					<textedit name="txtNazivKonta"  savevalue="app" datavalue="~dtGet.@Partner">
					</textedit>
				</item>
				<item col="1" row="3"  caption="Račun:">
					<textedit name="txtRacun"  savevalue="app" datavalue="~dtGet.@Racun">
					</textedit>
				</item>
				<item col="1" row="4"  caption="Opis:">
					<textedit name="txtOpis"  savevalue="app" datavalue="~dtGet.@Opis">
					</textedit>
				</item>
				<item col="1" row="5"  caption="Organizacijska shema:">
					<textedit name="txtOrgShema"  savevalue="app" datavalue="~dtGet.@OrgShemaId" dataname="~dtOrgShema">
					</textedit> 
				 </item> 
				 <item col="1" row="6"  caption="Vrsta dimenzija:" colspan="2">
					<comboedit name="cmbDimVrste" dataname="~dtDimVrste"  displayfield="naziv" datavalue="~dtGet.@DimVrsteId" valuefield="DimVrsteid" autopopulate="true" allownull="true" savevalue="app">
					<event type="valuechanged">
						<action type="control populate" value="cmbDimenzije"/>
					</event>
					</comboedit>
				</item>
				<item col="1" row="7"  caption="Dimenzije:" >
					<comboedit name="cmbDimenzije" required="true" autopopulate="true" dataname="~dtDimenzije" datavalue="~dtGet.@Dimenzijeid" valuefield="Dimenzijeid" displayfield="Naziv" savevalue="app"/>
				</item>	
			</group>
		</layout> 
		<panelbuttons> 
			<buttons> 
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtUpdateDimPrometMulti"/>
						<action type="form close"/>
						<action type="control populate keepfocus" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons> 
		<datalist>
			<data command="spCKntDimQueryKontrole" name="dtOrgShema">
				<parameter name="@Action" value="2"/>
			</data>
			<data command="spCKntDimQueryKontrole" name="dtDimVrste"> 
				<parameter name="@Action" value="3"/>  
				<parameter name="@DimenzijeId" value="#cmbDimenzije"/>
			</data>	
			<data command="spCKntDimQueryKontrole" name="dtDimenzije"> 
				<parameter name="@Action" value="5"/> 
				<parameter name="@DimVrsteId" value="#cmbDimVrste"/>
			</data>
			<data command="spCKntDimAzur" name="dtGet"> 	
				<parameter name="@Action" value="0"/> 	
				<parameter name="@Kntprometid" value="$kntprometid"/>
			</data>	
			<data command="spCKntDimAzur" name="dtUpdateDimPrometMulti"> 	
				<parameter name="@Action" value="2"/> 	
				<parameter name="@selectedids" value="parent.#grdMaster.selectedids"/>
				<parameter name="@Dimenzijeid" value="#cmbDimenzije"/> 
				<parameter name="@DimVrsteId" value="#cmbDimVrste"/> 
			</data>	
		</datalist>	
	</form>
	<form name="frmIzmijeniDimenziju" caption="Izmijeni dimenziju">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<event type="shown">
			<action type="control disable" value="#txtKonto,#txtNazivKonta,#txtRacun, #txtOpis, #txtOrgShema"/>
		</event> 
		<layout textposition="top">	
			<group rows="7" cols="1" colspan="2">	
				<item col="1" row="1"  caption="Konto:">
					<textedit name="txtKonto"  savevalue="app" datavalue="~dtGet.@Konto">
					</textedit>
				</item>
				<item col="1" row="2"  caption="Naziv konta:">
					<textedit name="txtNazivKonta"  savevalue="app" datavalue="~dtGet.@Partner">
					</textedit>
				</item>
				<item col="1" row="3"  caption="Račun:">
					<textedit name="txtRacun"  savevalue="app" datavalue="~dtGet.@Racun">
					</textedit>
				</item>
				<item col="1" row="4"  caption="Opis:">
					<textedit name="txtOpis"  savevalue="app" datavalue="~dtGet.@Opis">
					</textedit>
				</item>
				<item col="1" row="5"  caption="Organizacijska shema:">
					<textedit name="txtOrgShema"  savevalue="app" datavalue="~dtGet.@OrgShemaId" dataname="~dtOrgShema">
					</textedit> 
				</item>
				<item col="1" row="6"  caption="Vrsta dimenzija:" colspan="2">
					<comboedit name="cmbDimVrste" dataname="~dtDimVrste"  displayfield="naziv" valuefield="DimVrsteid"  datavalue="~dtGet.@DimVrsteId"  autopopulate="true" allownull="true" savevalue="app">
					<event type="valuechanged">
						<action type="control populate" value="cmbDimenzije"/>
					</event>
					</comboedit>
				</item>
				<item col="1" row="7"  caption="Dimenzije:" >
					<comboedit name="cmbDimenzije" required="true" autopopulate="true" dataname="~dtDimenzije" datavalue="~dtGet.@Dimenzijeid" valuefield="Dimenzijeid" displayfield="Naziv" savevalue="app"/>
				</item>	
			</group>
		</layout>  
		<panelbuttons> 
			<buttons> 
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtUpdateDimPromet"/>
						<action type="control populate keepfocus" value="parent.#grdMaster"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntDimQueryKontrole" name="dtOrgShema">
				<parameter name="@Action" value="2"/>
			</data>
			<data command="spCKntDimQueryKontrole" name="dtDimVrste"> 
				<parameter name="@Action" value="3"/>  
				<parameter name="@DimenzijeId" value="#cmbDimenzije"/>
			</data>	
			<data command="spCKntDimQueryKontrole" name="dtDimenzije"> 
				<parameter name="@Action" value="5"/> 
				<parameter name="@DimVrsteId" value="#cmbDimVrste"/>
			</data>
			<data command="spCKntDimAzur" name="dtGet"> 	
				<parameter name="@Action" value="0"/> 	
				<parameter name="@Kntprometid" value="$kntprometid"/>
			</data>	
			<data command="spCKntDimAzur" name="dtUpdateDimPromet"> 	
				<parameter name="@Action" value="1"/> 	
				<parameter name="@Kntprometid" value="$Kntprometid"/> 
				<parameter name="@Dimenzijeid" value="#cmbDimenzije"/>
				<parameter name="@DimVrsteId" value="#cmbDimVrste"/>
			</data>	
		</datalist>	
	</form>
</root>