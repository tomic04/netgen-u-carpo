<!--20.7.2018. AA postavljn timeout-->
<root>
	<form type="master" name="frmGlavni" maximized="true" template="splitter" caption="PDV po stjecanju">
		<event type="load">
			<action type="datarun reader" value="~dtPrviDan"/>
		</event>
		<event type="shown">
			<action type="control value" value="#datOd">
				<parameter value="~dtPrviDan.@prvidan"/>
			</action>
			<action type="control value" value="#datDo">
				<parameter value="now" type="date"/>
			</action>	
			<action type="control disable" value="#btnProknjizi"/>
		</event>
		<layout name="panel1" type="collapsable">
			<group cols="1" rows="3" height="50" groupbordervisible="false">
				<columnsdefinition>
					<column size="200" position="1"/>
				</columnsdefinition>
				<rowsdefinition>
					<row size="50" position="1"/>
				</rowsdefinition>
				<item col="1" row="1" caption="Datum od:" tabindex="0">
					<dateedit name="datOd"/>
				</item>
				<item col="1" row="2" caption="Datum do:" tabindex="1">
					<dateedit name="datDo"/>
				</item>
				<item col="1" row="3"/>
			</group>
		</layout>
		<layout name="panel2">
			<group cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdGlavni" dataname="~dtGlavni" showfooter="true" netgenfields="true" bestfitonrefresh="true">
						<fields inherited="true"/>
						<print caption="PDV po stjecanju" captionalign="center" header="Razdoblje od {#datOd::dd.MM.yyyy} do {#datDo::dd.MM.yyyy} \n"/>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPokazi" caption="POKAŽI">
					<event type="click">
						<action type="control populate" value="#grdGlavni"/>
						<action type="panel collapse" value="panel1" if="#grdGlavni.rowcount!=0"/>						
						<action type="control disable" value="#btnProknjizi" if="#grdGlavni.rowcount==0"/>
						<action type="control enable" value="#btnProknjizi" if="#grdGlavni.rowcount!=0"/>						
					</event>
				</button>
				<button name="btnProknjizi" caption="PROKNJIŽI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite prenijeti stavke u Knjigu IRA?"/>
						<action type="datarun nonquery" value="~dtProknjizi"/>
						<action type="control populate" value="#grdGlavni"/>
						<action type="control disable" value="#btnProknjizi" if="#grdGlavni.rowcount==0"/>
						<action type="control enable" value="#btnProknjizi" if="#grdGlavni.rowcount!=0"/>							
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS   SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdGlavni"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGlavni" command="spCKntPDVpoStjecanju" timeout="200">
				<parameter name="@Action" value="0"/>
				<parameter name="@DatOd" value="#datOd"/>
				<parameter name="@DatDo" value="#datDo"/>				
			</data>
			<data name="dtProknjizi" command="spCKntPDVpoStjecanju" timeout="200">
				<parameter name="@Action" value="1"/>
				<parameter name="@DatOd" value="#datOd"/>
				<parameter name="@DatDo" value="#datDo"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>			
			<data type="text" name="dtPrviDan" command="SELECT cast(CONVERT(VARCHAR(8), DATEADD(yy, DATEDIFF(yy,0,getdate()), 0), 112) as datetime) as prvidan"/>
		</datalist>
	</form>
</root>