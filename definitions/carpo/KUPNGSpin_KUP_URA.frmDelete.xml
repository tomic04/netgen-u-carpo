<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: DELETEFORM (NetGen) → frmDelete (Carpo) -->
<root version="1.2">
  <form name="frmDelete" caption="Obrisati?" type="dialog" width="420" height="180" fixedsize="true">
    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1" caption="Jeste li sigurni da želite obrisati stavku?" textposition="left">
          <label/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnObrisi" caption="OBRIŠI">
          <event type="click" waittype="progress" waitcaption="Brisanje" waittext="Brišem...">
            <action type="datarun nonquery" value="~dtDelete"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtDelete" command="spKUPPrometAzurN" timeout="300">
        <parameter name="@action" value="2"/>
        <parameter name="@ID" value="$Id"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

