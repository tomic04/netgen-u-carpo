<root>
	<form name="frmGlavna" type="master" caption="STANJE VP/MP">
		
		<method name="ExeRun" dll="DataSetToExcel_NoArgDll" class="DataSetToExcel_NoArgDll.Program" method="Start" />
		
		<event type="init">
		
			<action type="form open" value="frmUvjet" >
			</action>
			<action type="variable value">
				<parameter name="klmasterrobaid" value="$klmasterrobaid" />
				<parameter name="klasaispod" value="$klasaispod" />
				<parameter name="robaid" value="$robaid" />
				<parameter name="klrobaid" value="$klrobaid" />
				<parameter name="ispoddodklase" value="$ispoddodklase" />
				<parameter name="beznule" value="$beznule" />
				<parameter name="puni" value="$puni" />
				<parameter name="indPrvi" value="1" />
			</action>
			<action type="datarun nonquery" value="~dtPuniMaster" if="$puni==1" waitcaption="Obrada" waittext="učitavanje podataka..." />
			<action type="control populate" value="#grdMaster" if="$puni==1"/>
		</event>
		<managerlayout>
			<grid type="master" name="grdMaster" dataname="~dtPuniMaster" bestfitonrefresh="true" autopopulate="false">

			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUvjet" caption="FILTER">
					<event type="click">
						<action type="form open" value="frmUvjet2">
							<parameter name="klmasterrobaid" value="$klmasterrobaid" />
							<parameter name="klasaispod" value="$klasaispod" />
							<parameter name="robaid" value="$robaid" />
							<parameter name="klrobaid" value="$klrobaid" />
							<parameter name="ispoddodklase" value="$ispoddodklase" />
							<parameter name="beznule" value="$beznule" />
							<parameter name="puni" value="$puni" />
							<parameter name="indPrvi" value="0" />
						</action>
					</event>	
				</button>
				<button name="btnEksport" caption="EXPORT U EXCEL">
					<event type="click">
						<action type="method run" value="ExeRun" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spStanjeVPMP" name="dtPuniMaster" timeout="2000">
				<parameter name="@klmasterrobaid" value="$klmasterrobaid" />
				<parameter name="@klasaispod" value="$klasaispod" />
				<parameter name="@robaid" value="$robaid" />
				<parameter name="@klrobaid" value="$klrobaid" />
				<parameter name="@ispoddodklase" value="$ispoddodklase" />
				<parameter name="@beznule" value="$beznule" />
				<parameter name="@IndCarpo" value="1" />
			</data>
		</datalist>
	</form>
	<form name="frmUvjet" caption="FILTER">
		<event type="close" >
			<!-- <action type="variable value">
				<parameter name="parent.klmasterrobaid" value="#cmbKlasa1" />
				<parameter name="parent.klasaispod" value="#chkIspod1" />
				<parameter name="parent.robaid" value="#srcRoba" />
				<parameter name="parent.klrobaid" value="#cmbKlasa2" />
				<parameter name="parent.ispoddodklase" value="#chkIspod2" />
				<parameter name="parent.beznule" value="#chkNula" />
				<parameter name="parent.puni" value="1" />
			</action> -->
		</event>
			<layout textposition="left" itemspadding="3">
			<group cols="4" rows="4" col="4" row="1">		
				<item col="1" row="1" caption="Klasa robe:" colspan="3">
					<!-- <searchedit name="srcKlasa" fontsizedelta="1" fontbold="True" fieldtext="Naziv" fieldvalue="KlRobaId" entermovenextcontrol="true" dataname="dtKlMasterRoba" function="srcKlasa" />
					 -->
				<comboedit name="cmbKlasa1" dataname="~dtKlMasterRoba" displayfield="Naziv" valuefield="klmasterrobaid" value="" savevalue="app"/>
				</item>
				<item col="4" row="1" caption="i ispod nje:">
					<checkedit name="chkIspod1" value="false" />
				</item>
				<item col="1" row="2" caption="Roba:" colspan="4">
					<searchedit name="srcRoba" fontsizedelta="0" fontbold="True" fieldtext="Roba3000" fieldvalue="RobaId" entermovenextcontrol="true" dataname="~dtSearchRoba" function="srcRoba" />
				</item>
				<item col="1" row="3" caption="Dodatna klasa robe:" colspan="3">
					<comboedit name="cmbKlasa2" dataname="~dtKlMasterRoba" displayfield="naziv" valuefield="klmasterrobaid" value="" />
				</item>
				<item col="4" row="3" caption="i ispod nje:">
					<checkedit name="chkIspod2" value="false" />
				</item>
				<item col="2" row="4" caption="Izbaciti robu sa stanjem 0:" rowspan="1">
					<checkedit name="chkNula" value="true" />
				</item>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="PRIKAŽI">
						<event type="click" >
						<!-- 	<action type="variable value">
								<parameter name="parent.indPrvi" value="1" />
							</action> -->
							<!-- <action type="datarun nonquery" value="~dtSpremi">
							</action> -->
							<action type="variable value">
								<parameter name="parent.klmasterrobaid" value="#cmbKlasa1" />
								<parameter name="parent.klasaispod" value="#chkIspod1" />
								<parameter name="parent.robaid" value="#srcRoba" />
								<parameter name="parent.klrobaid" value="#cmbKlasa2" />
								<parameter name="parent.ispoddodklase" value="#chkIspod2" />
								<parameter name="parent.beznule" value="#chkNula" />
								<parameter name="parent.puni" value="1" />
							</action>
							
							<action type="datarun nonquery" value="parent.~dtPuniMaster" if="$indPrvi==0">
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="datarun nonquery" value="~dtBrisiParametar" />
							<action type="datarun nonquery" value="~dtInsertParametar" />
							<action type="form close" />
						
							
							
						</event>
					</button>
					<button name="btnIzlaz" caption="ODUSTANI" type="cancel" dock="right" />
				</buttons>
			</panelbuttons>
	<datalist>
			<data name="dtSearchRoba" command="spTraziRoba">
				<parameter name="@Action" value="Roba"/>
				<parameter name="@uvjet" value="#srcRoba.text"/>
			</data>
			<data command="spNab_stanjeVpMp_klMasterRoba" name="dtKlMasterRoba" />
			<data command="spVpMPStanjeParametriInsert" name="dtInsertParametar">
				<parameter name="@klmasterrobaid" value="#cmbKlasa1" />
				<parameter name="@klasaispod" value="#chkIspod1" />
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@klrobaid" value="#cmbKlasa2" />
				<parameter name="@ispoddodklase" value="#chkIspod2" />
				<parameter name="@beznule" value="#chkNula" />
				<parameter name="@IndCarpo" value="1" />
			</data>
			<data command="spVpMpStanjeParametriDelete" name="dtBrisiParametar" />
	</datalist>
	</form>
		<form name="frmUvjet2" caption="FILTER">

			<layout textposition="left" itemspadding="3">
			<group cols="4" rows="4" col="4" row="1">		
				<item col="1" row="1" caption="Klasa robe:" colspan="3">
					<!-- <searchedit name="srcKlasa" fontsizedelta="1" fontbold="True" fieldtext="Naziv" fieldvalue="KlRobaId" entermovenextcontrol="true" dataname="dtKlMasterRoba" function="srcKlasa" />
					 -->
				<comboedit name="cmbKlasa1" dataname="~dtKlMasterRoba" displayfield="Naziv" valuefield="klmasterrobaid" value="" savevalue="app"/>
				</item>
				<item col="4" row="1" caption="i ispod nje:">
					<checkedit name="chkIspod1" value="false" />
				</item>
				<item col="1" row="2" caption="Roba:" colspan="4">
					<searchedit name="srcRoba" fontsizedelta="1" fontbold="True" fieldtext="Roba3000" fieldvalue="RobaId" entermovenextcontrol="true" dataname="~dtSearchRoba" function="srcRoba" />
				</item>
				<item col="1" row="3" caption="Dodatna klasa robe:" colspan="3">
					<comboedit name="cmbKlasa2" dataname="~dtKlMasterRoba" displayfield="naziv" valuefield="klmasterrobaid" value="" />
				</item>
				<item col="4" row="3" caption="i ispod nje:">
					<checkedit name="chkIspod2" value="false" />
				</item>
				<item col="2" row="4" caption="Izbaciti robu sa stanjem 0:">
					<checkedit name="chkNula" value="true" />
				</item>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="PRIKAŽI">
						<event type="click" >
						<!-- 	<action type="variable value">
								<parameter name="parent.indPrvi" value="1" />
							</action> -->
							<!-- <action type="datarun nonquery" value="~dtSpremi">
							</action> -->
							<action type="variable value">
								<parameter name="$klmasterrobaid" value="#cmbKlasa1" />
								<parameter name="$klasaispod" value="#chkIspod1" />
								<parameter name="$robaid" value="#srcRoba" />
								<parameter name="$klrobaid" value="#cmbKlasa2" />
								<parameter name="$ispoddodklase" value="#chkIspod2" />
								<parameter name="$beznule" value="#chkNula" />
								<parameter name="$puni" value="1" />
							</action>
							
							<action type="datarun nonquery" value="~dtPuniMaster">
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="datarun nonquery" value="~dtBrisiParametar" />
							<action type="datarun nonquery" value="~dtInsertParametar" />
							<action type="form close" />			
						</event>
					</button>
					<button name="btnIzlaz" caption="ODUSTANI" type="cancel" dock="right" />
				</buttons>
			</panelbuttons>
	<datalist>
			<data name="dtSearchRoba" command="spTraziRoba">
				<parameter name="@Action" value="Roba"/>
				<parameter name="@uvjet" value="#srcRoba.text"/>
			</data>
			<data command="spNab_stanjeVpMp_klMasterRoba" name="dtKlMasterRoba" />
				<data command="spStanjeVPMP" name="dtPuniMaster" timeout="2000">
				<parameter name="@klmasterrobaid" value="$klmasterrobaid" />
				<parameter name="@klasaispod" value="$klasaispod" />
				<parameter name="@robaid" value="$robaid" />
				<parameter name="@klrobaid" value="$klrobaid" />
				<parameter name="@ispoddodklase" value="$ispoddodklase" />
				<parameter name="@beznule" value="$beznule" />
			</data>
			<data command="spVpMPStanjeParametriInsert" name="dtInsertParametar">
				<parameter name="@klmasterrobaid" value="#cmbKlasa1" />
				<parameter name="@klasaispod" value="#chkIspod1" />
				<parameter name="@robaid" value="#srcRoba" />
				<parameter name="@klrobaid" value="#cmbKlasa2" />
				<parameter name="@ispoddodklase" value="#chkIspod2" />
				<parameter name="@beznule" value="#chkNula" />
				<parameter name="@IndCarpo" value="1" />
			</data>
			<data command="spVpMpStanjeParametriDelete" name="dtBrisiParametar" />
	</datalist>
	</form>
</root>