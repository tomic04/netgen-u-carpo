<!-- MH Radila na Jupiter2017, Spin -->

<root>
	<form name="frmMaster" type="master" caption="Roba čišćenje" saveformsize="true" height="600" fixedsize="false" template="splitter vertical">
		<event type="init">
			<action type="datarun scalar" value="Global.~dtCheckPermission">
				<parameter name="Global.Smije"/>
			</action>
			<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
		</event>		
		<event type="load">
			<!-- <action type="control populate" value="#grdMaster"/> -->
			<!-- <action type="control populate" value="#grdAnalizaPravi"/> -->
			<!-- <action type="control populate" value="#grdAnalizaBrisanje"/> -->
			<action type="control value" value="#srcRoba">
				<parameter value="null"/>
			</action>
			<action type="control value" value="#chkUmir">
				<parameter value="True"/>
			</action>
			<action type="variable value" >
				<parameter name="global.Umir" value="#chkUmir"/>
			</action>
			<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
		</event>
		<layout name="panel1" minsize="300">
			<group cols="1" rows="2" bordervisible="false">
				<group row="1" col="1" cols="4" rows="1" bordervisible="false">
					<columnsdefinition>
                        <column size="20%" position="1"/>
                        <column size="20%" position="2"/>
                        <column size="10%" position="3"/>
						<column size="50%" position="4"/>
                    </columnsdefinition>
					<item  row="1" col="1" caption="Roba:" textposition="left" bordervisible="false">
						<textedit name="srcRoba" allownull="true" nulltext="Upišite dio naziva robe...">
							<event type="leave" >
								<action type="variable value" >
									<parameter name="global.uvjet" value="#srcRoba"/>
								</action>
								<action type="control populate" value="#cmbKlRoba"/>

								<action type="control populate" value="#grdMaster"/>
								<action type="control datasourceempty" value="#grdAnalizaPravi">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="control datasourceempty" value="#grdAnalizaBrisanje">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
							</event>
						</textedit>
					</item>
					<item row="1" col="2" caption="Klasifikacija:" textposition="left" bordervisible="false">
						<combotreeedit name="cmbKlRoba" valuefield="ID" displayfield="Naziv" parentfieldname="ParentID" dataname="~dtKlRoba" allownull="true" savevalue="session">
							<event type="valuechanged" >
								<action type="variable value" >
									<parameter name="global.KlRoba" value="#cmbKlRoba"/>
								</action>
								<action type="control populate" value="#grdMaster"/>
								<action type="control datasourceempty" value="#grdAnalizaPravi">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="control datasourceempty" value="#grdAnalizaBrisanje">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
							</event>
						</combotreeedit>
					</item>
					<item row="1" col="3" width="120">
						<checkedit name="chkUmir" caption=" Umirovljena " bordervisible="false">
							<event type="valuechanged" >
								<action type="variable value" >
									<parameter name="global.Umir" value="#chkUmir"/>
								</action>
								<!-- <action type="control populate" value="#cmbKlRoba"/> -->
								<action type="control populate" value="#grdMaster"/>
								<action type="control value" value="#txtPravaRoba">
									<parameter value="null"/>
								</action>
								<action type="control value" value="#txtRobaBrisanje">
									<parameter value="null"/>
								</action>
								<action type="control datasourceempty" value="#grdAnalizaPravi">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="control datasourceempty" value="#grdAnalizaBrisanje">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
							</event>
						</checkedit>
					</item>
<!-- 					<item row="1" col="4" width="120">
						<button name="btnPrikazi" caption="Prikaži" >
							<event type="click"> 
								<action type="control populate" value="#grdMaster"/>
							</event>
						</button>
					</item> -->
				</group>
				<group row="2" col="1" cols="1" rows="1" bordervisible="false">
					<item col="1" row="1">
						<grid name="grdMaster" dataname="~dtPuniMaster" key="robaid">
							<fields inherited="false">
							</fields>
							<styles>
								<style name="fontcolor" value="red" if="#grdMaster.@Status==Umirovljena" />
							</styles>
							<menu>
								<menuitem caption="Odabir prave robe" >
									<event type="click">
										<action type="validate"/>
										<action type="control value" value="#txtPravaRoba">
											<parameter value="#grdMaster.@naziv" />
										</action>
										<action type="variable value" >
											<parameter name="PravaRobaId" value="#grdMaster.@robaid" />
										</action>
										<action type="control populate" value="#grdAnalizaPravi" />
										<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
									</event>
								</menuitem>
								<menuitem caption="Odabir robe za brisanje" >
									<event type="click">
										<action type="validate"/>
										<action type="control value" value="#txtRobaBrisanje">
											<parameter value="#grdMaster.@naziv" />
										</action>
										<action type="variable value" >
											<parameter name="RobaBrisanjeId" value="#grdMaster.@robaid" />
										</action>
										<action type="control populate" value="#grdAnalizaBrisanje" />
										<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
									</event>
								</menuitem>
							</menu>
						</grid>
					</item>  	
				</group>          
			</group>          
		</layout>

		<layout name="panel2">
			<group cols="1" rows="3" >
				<group row="1" col="1" rows="1" cols="2" bordervisible="false">
					<!-- Prava roba -->
					<group col="1" row="1" cols="3" rows="1" bordervisible="false">
						<group row="1" col="1" bordervisible="false" cols="1" rows="1" >
							<item col="1" row="1" >
								<labeledit value="Prava roba" />
							</item>
						</group>
						<group row="1" col="2" rows="1" cols="1"  bordervisible="false" >
							<item col="1" row="1">
								<textedit name="txtPravaRoba"  readonly="true"/>
							</item>
						</group>
						<group row="1" col="3" cols="1" rows="1"  bordervisible="false" width="120">
							<item col="1" row="1" >
								<!-- <button name="btnAnalizaPravi" caption="ANALIZA" >
									<event type="click">
										<action type="control populate" value="#grdAnalizaPravi" />
										<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>	
									</event>
								</button> -->
							</item>
						</group>
					</group>

					<!-- Roba za brisanje -->
					<group col="2" row="1" cols="3" rows="1" bordervisible="false" >
						<group row="1" col="1" bordervisible="false" cols="1" rows="1">
							<item col="1" row="1" >
								<labeledit value="Roba za brisanje" textposition="center" />
							</item>
						</group>
						<group row="1" col="2" cols="1" rows="1" bordervisible="false">
							<item col="1" row="1">
								<textedit name="txtRobaBrisanje" readonly="true"  /> <!-- enabled="false" -->
							</item>
						</group>
						<group row="1" col="3" rows="1" cols="1" bordervisible="false" width="120">
							<item col="1" row="1" width="50">
								<!-- <button name="btnAnalizaBrisanje" caption="ANALIZA" >
									<event type="click">
										<action type="control populate" value="#grdAnalizaBrisanje" />
										<action type="footer text" value="Broj stavki na gridu za odabir robe: {#grdMaster.rowcount} - Broj stavki analize prave robe: {#grdAnalizaPravi.rowcount} - Broj stavki analize robe za brisanje: {#grdAnalizaBrisanje.rowcount}"/>
									</event>
								</button> -->
							</item> 
						</group>
					</group>
				</group>
				<group col="1" row="2" rows="1" cols="2" bordervisible="false">
					<item col="1" row="1">
						<grid name="grdAnalizaPravi" dataname="~dtAnalizaPravi" showgrouppanel="false" statusbar="true">
							<fields>
								<field name="Nazivtabele" caption="Tablica" />
								<field name="BrIda" caption="Broj stavki" />
							</fields>

						</grid>
					</item>
					<item col="2" row="1">
						<grid name="grdAnalizaBrisanje" dataname="~dtAnalizaBrisanje" showgrouppanel="false" statusbar="true">
							<fields>
								<field name="Nazivtabele" caption="Tablica" />
								<field name="BrIda" caption="Broj stavki" />
							</fields>
						</grid>
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="3" bordervisible="false" height ="40">
					<columnsdefinition>
						<column size="10%" position="1"/>
						<column size="70%" position="2"/>
						<column size="10%" position="3"/>
					</columnsdefinition>

					<item col="1" row="1" width="120" bordervisible="false">
						<button name="btnPrenesi" caption="PRENESI" >
							<event type="click">
								<action type="datarun nonquery" value="~dtPrenesi" />
								<action type="control populate" value="#grdAnalizaBrisanje" />
								<action type="control populate" value="#grdAnalizaPravi" />
								<action type="control populate" value="#grdMaster" />
								<action type="control datasourceempty" value="#grdAnalizaPravi">
									<parameter name="clearcolumns" value="true"/>
								</action>
								<action type="control datasourceempty" value="#grdAnalizaBrisanje">
									<parameter name="clearcolumns" value="true"/>
								</action>
							</event>
						</button>
					</item>
					<item col="3" row="1" width="120" bordervisible="false">
						<button name="btnIzlaz" caption="IZLAZ" type="form close"/>
					</item>
				</group>
			</group>
		</layout>

		<datalist>
			<data command="spRobaCiscenje_Query" name="dtPuniMaster">
				<parameter name="@action" value="1" />
				<parameter name="@Uvjet" value="global.$Uvjet" />
				<parameter name="@KlRoba" value="global.$KlRoba" />
				<parameter name="@Umir" value="null" if="global.$Umir==True"/>
				<parameter name="@Umir" value="0" if="global.$Umir==False"/>
			</data>
			<data command="spProd_CheckPermission" name="dtCheckPermission">
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@Objekt" value="RobaCiscenje" />
				<parameter name="@Funkcija" value="edit" />
			</data>
			<data command="spRobaCiscenje_Query" name="dtKlRoba">
				<parameter name="@Action" value="7" />
				<parameter name="@Uvjet" value="global.$uvjet" />
				<parameter name="@Umir" value="global.$Umir" />
			</data>
			<data command="spRobaCiscenje_Info" name="dtAnalizaPravi">
				<parameter name="@Robaid" value="$PravaRobaId"/>
			</data>
			<data command="spRobaCiscenje_Info" name="dtAnalizaBrisanje">
				<parameter name="@Robaid" value="$RobaBrisanjeId"/>
			</data>
			<data command="spRobaCiscenje_Provedi" name="dtPrenesi">
				<parameter name="@PraviRobaid" value="$PravaRobaiId"/>
				<parameter name="@BrisiRobaid" value="$RobaBrisanjeId"/>
				<parameter name="@operaterid" value="@@operateriid"/>
			</data>
		</datalist>
	</form>
</root>