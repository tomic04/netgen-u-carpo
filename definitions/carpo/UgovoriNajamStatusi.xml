<root>
	<form name="frmGlavna" type="master" caption="Statusi ugovora o najmu">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtNapuniGrid" multiselect="true">
				<fields>
				</fields>

				<event type="doubleclick">
					<action type="form open" value="frmIzmjena">
						<parameter name="UgovoriNajamStatusiID" value="#grdGlava.@UgovoriNajamStatusiID" />
					</action>
				</event>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnos">
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="UgovoriNajamStatusiID" value="#grdGlava.@UgovoriNajamStatusiID" />
						</action>
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />
						<action type="control foreachrow selected" value="#grdGlava">
							<action type="datarun nonquery" value="dtDelete" />
					    </action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
	<datalist>
		<data command="spUgovoriNajamStatusi_Query" name="dtNapuniGrid" />
		<data command="spUgovoriNajamStatusi_Delete" name="dtDelete">
			<parameter name="UgovoriNajamStatusiID" value="#grdGlava.@UgovoriNajamStatusiID" />
		</data>
	</datalist>

	</form>

	<form name="frmUnos" caption="Unesi">
		<layout>
			<group cols="1" rows="2" col="1" row="1">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" required="true" />
				</item>
				<item col="1" row="2" caption="Aktivno:">
					<checkedit name="chkAktivno" value="1" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUnos" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
				</button>
			</buttons>	
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamStatusi_Insert" name="dtUnos">
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>
		</datalist>
	</form>

	<form name="frmIzmjena" caption="Izmijeni">

		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>

		<layout>
			<group cols="1" rows="2" col="1" row="1">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtGet.@naziv" required="true" />
				</item>
				<item col="1" row="2" caption="Aktivno:">
					<checkedit name="chkAktivno" datavalue="~dtGet.@aktivno" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" >
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtIzmijeni" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spUgovoriNajamStatusi_EditQuery" name="dtGet">
				<parameter name="@UgovoriNajamStatusiID" value="$UgovoriNajamStatusiID" />
			</data>
			<data command="spUgovoriNajamStatusi_Update" name="dtIzmijeni">
				<parameter name="@UgovoriNajamStatusiID" value="$UgovoriNajamStatusiID" />
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>
		</datalist>
	</form>
</root>	