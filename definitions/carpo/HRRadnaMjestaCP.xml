		</data>
		<data command="spHRPartQuery" name="dtPartTabGridovi">
			<parameter name="@Action" value="data"/>
			<parameter name="@OperateriId" value="@@OperaterId"/>
			<parameter name="@datoteka" value="HRRadnaMjestaCP"/>
		</data>
		<data command="spHRPartQuery" name="dtPartButton">
			<parameter name="@Action" value="button"/>
