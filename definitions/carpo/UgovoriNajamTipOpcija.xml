<root>
	<form name="frmGlavna" caption="Tipovi opcija" type="master">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtPuniGrid" multiselect="true">
				<fields>
					<field name="tipOpcije" caption="Tip opcije" />
					<field name="VrijednostDev" caption="Vrijednost demontaže u stranoj valuti" />
					<field name="Naziv" caption="Valuta"/>
					<field name="VrijednostKN" caption="Vrijednost demontaže u KN" />
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnos" />
					</event>
				</button>


				<button name="btnIzmjeni" caption="IZMIJENI">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
							<parameter name="UgovoriNajamTipOpcijaID" value="#grdGlava.@UgovoriNajamTipOpcijaID" />
						</action>
					</event>
				</button>

				<button name="btnObrisi" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?" />
						<action type="control foreachrow selected" value="#grdGlava">
								<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>

			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipOpcija_Query" name="dtPuniGrid">
			</data>
			<data command="spUgovoriNajamTipOpcija_Delete" name="dtDelete">
				<parameter name="@UgovoriNajamTipOpcijaID" value="#grdGlava.@UgovoriNajamTipOpcijaID" />
			</data>
		</datalist>

	</form>


	<form name="frmUnos" caption="Unesi">
		<layout>
			<group cols="1" rows="4" col="1" row="1">
				<item col="1" row="1" caption="Tip opcije:">
					<textedit name="txtTipOpcije" required="true"/>
				</item>
				<item col="1" row="2" caption="Vrijednost demontaže u stranoj valuti:">
					<textedit name="txtVrijednostDEV" format="n2"/>
				</item>
				<item col="1" row="3" caption="Valuta:">
					<comboedit name="cmbValuta" dataname="~dtGetValute" valuefield="valuteid" displayfield="naziv"/>
				</item>
				<item col="1" row="4" caption="Vrijednost demontaže u KN:">
					<textedit name="txtVrijednostHRK" format="n2"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtSpremi" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipOpcija_getValute" name="dtGetValute">
			</data>
			<data command="spUgovoriNajamTipOpcija_Insert" name="dtSpremi">
				<parameter name="@tipOpcije" value="#txtTipOpcije" />
				<parameter name="@VrijednostDev" value="#txtVrijednostDEV" />
				<parameter name="@ValutaId" value="#cmbValuta" />
				<parameter name="@VrijednostHRK" value="#txtVrijednostHRK" />
			</data>
		</datalist>
	</form>

	<form name="frmIzmjeni" caption="Izmijeni">

		<event type="init">
				<action type="datarun reader" value="dtGet" />				
		</event>


		<layout>
			<group cols="1" rows="4" col="1" row="1">
				<item col="1" row="1" caption="Tip opcije:">
					<textedit name="txtTipOpcije" datavalue="~dtGet.@tipOpcije"  required="true"/>
				</item>
				<item col="1" row="2" caption="Vrijednost demontaže u stranoj valuti:">
					<textedit name="txtVrijednostDEV" datavalue="~dtGet.@VrijednostDev" format="n2"/>
				</item>
				<item col="1" row="3" caption="Valuta:">
					<comboedit name="cmbValuta" datavalue="~dtGet.@Valuteid" dataname="~dtGetValute" valuefield="valuteid" displayfield="naziv" />
				</item>
				<item col="1" row="4" caption="Vrijednost demontaže u KN:">
					<textedit name="txtVrijednostHRK" datavalue="~dtGet.@Vrijednostkn" format="n2" />
				</item>
			</group>
		</layout>

			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="Spremi">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="~dtIzmijeni" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" />
						</event>
					</button>
					<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipOpcija_Get" name="dtGet">
				<parameter name="@UgovoriNajamTipOpcijaID" value="$UgovoriNajamTipOpcijaID" />
			</data>
			<data command="spUgovoriNajamTipOpcija_getValute" name="dtGetValute">
			</data>
			<data command="spUgovoriNajamTipOpcija_Update" name="dtIzmijeni">
				<parameter name="@UgovoriNajamTipOpcijaID" value="$UgovoriNajamTipOpcijaID" />
				<parameter name="@TipOpcije" value="#txtTipOpcije" />
				<parameter name="@VrijednostDEV" value="#txtVrijednostDEV" />
				<parameter name="@ValutaID" value="#cmbValuta" />
				<parameter name="@VrijednostHRK" value="#txtVrijednostHRK" />
			</data>
		</datalist>
	</form>
</root>