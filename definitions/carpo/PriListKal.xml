<root version="1.0.20." loglevel="5"> 
    <form name="frmMaster" type="master" caption="Direktna primka - ulazna kalkulacija">
        <event type="init">
			<action type="variable value">
				<parameter name="Global.OperaterLockId" value="0" type="int" />
			</action>
			<action type="datarun reader" value="global.~dtPubVars"/>
			<action type="datarun scalar" value="global.~dtIndBezUsluga">
				<parameter name="global.$IndBezUsluga"/>
			</action>
			<action type="datarun scalar" value="~dtMarzaPubVar">
				<parameter name="global.$MarzaPubVar"/>
			</action>
			<action type="variable value">
				<parameter name="Global.pbvMinRokTrajanja" value="global.~dtPubVars.@MinRokTrajanja" type="int"/>
				<parameter name="Global.pbvKkvalObavezan" value="global.~dtPubVars.@KkvalObavezan" type="int"/>				
			</action>			
        </event>
		<event type="shown">
			<action type="control visible" value="#btnPromijeniStatus">
				<parameter value="false"/>
			</action>
		</event>
        <managerlayout>
            <lookup name="filter" savevalue="app">
				<comboitem value="VremenskaPodjela" searchfield="VpKeyId"/>
                <comboitem value="Partneri" searchfield="DobKeyId"/>
				<comboitem value="Skladišta" searchfield="SklKeyId"/>
				<!--searchfield su kolone iz CarpoSearcha koje vraćaju Id na drvetu za odabir iz pretrage-->
            </lookup>
            <tree name="tree" filtermode="smart" key="Id" searchfield="NabPriGlaId" parentfield="ParentId">
				<!-- <data command="VremenskaPodjela" type="integrated" if="#filter==VremenskaPodjela"/> -->
				<data command="dbo.spCarpoTreeVrijeme" if="#filter==VremenskaPodjela">
					<parameter name="@tablica" value="NabPriGla"/>
					<parameter name="@jucer" value="1"/>
					<parameter name="@danas" value="1"/>
					<parameter name="@minGodina" value="7"/>
				</data>	
                <data command="spNabPlkCarpoGlaFilterQuery" key="SkladisteId" elseif="#filter==Skladišta">
					<parameter name="@Action"  value="Skladista" />
					<parameter name="@OperateriId"  value="@@operateriid" />
				</data>						
                <data command="spNabPlkCarpoGlaFilterQuery" key="NabPriGlaId" else="">
					<parameter name="@Action"  value="Partneri" />
				</data>				
				<event type="focusedrowchanged">
					<!-- <action type="control populate async" value="#grdGlava" /> -->
					<action type="control populate" value="#grdGlava" />
				</event>
                <fields>
                    <field name="Name"/>
                </fields>
            </tree>
			<grid name="grdGlava" type="master" async="true" savelayout="true" multiselect="true" key="NabPriGlaId" Printorientation="" searchfield="NabPriGlaId">
				<event type="focusedrowchanged">
					<!-- <action type="message" value="#grdGlava.@NabPriGlaId"></action> -->
                    <action type="control populate" value="#grdDetail" />
					<action type="control disable" value="#btnObrisi" if="#grdGlava.@StatusSve==U robnom||#grdGlava.@StatusSve==Zaključen"/>
					<action type="control enable" value="#btnObrisi" else=""/>
					<action type="variable value">
						<parameter name="VrstaDokId" value="#grdGlava.@VrstaDokId"/>
					</action>
                </event>
				<event type="doubleclick">
					<action type="variable value" value="Global.$OperaterLockId">
						<parameter value="#grdGlava.@NabPriGlaId" />
					</action>
					<action type="form open" value="frmPriListKalEdit"  if="#grdGlava.rowcount&gt;0">
                        <parameter name="NabPriGlaId" value="#grdGlava.@NabPriGlaId" />
						<parameter name="Status" value="#grdGlava.@StatusSve" />
						<parameter name="VrstaDokId" value="#grdGlava.@VrstaDokId" />
                    </action>
                    <action type="control populate keepfocus" value="#grdGlava" />
                </event>
				<event type="keydown">
					<!--EDIT-->
					<action if="key==13">
						<action type="variable value" value="Global.$OperaterLockId">
							<parameter value="#grdGlava.@NabPriGlaId" />
						</action>
                        <action type="form open" value="frmPriListKalEdit"  if="#grdGlava.rowcount&gt;0">
                            <parameter name="NabPriGlaId" value="#grdGlava.@NabPriGlaId" />
							<parameter name="Status" value="#grdGlava.@StatusSve" />
							<parameter name="VrstaDokId" value="#grdGlava.@VrstaDokId" />
                        </action>
                        <action type="control populate keepfocus" value="#grdGlava" />
                    </action>
					<!--DELETE-->							
					<action if="key==46">
                        <action type="confirm" value="Želite li obrisati dokument broj '{#grdGlava.@Broj}'?" if="#grdGlava.rowcount&gt;0">
                            <action type="datarun nonquery" value="~dtDelete">
                                <action type="control populate" value="#grdGlava" />
                            </action>
                        </action>
					</action>
					<!--INSERT-->
					<action if="key==45">
						<action type="form open" value="frmPriListKalNova">	  
							<parameter name="NabPriGlaId" value="null"/>
							<parameter name="VrstaDokId" value="#btnUnesi.@VrstaDokId"/>
							<parameter name="vrstaDok" value="#btnUnesi.@Opis"/>
						</action>
						<action type="control populate" value="#grdGlava"/>					
					</action>
				</event>
                <data command="spNabPlkCarpoGlaQuery" timeout="300">
					<parameter name="@Action"  value="sviDokumenti" />
					<parameter name="@PartneriId"  if="#filter==Partneri" value="#tree.@ValueId" />	
					<parameter name="@SkladisteId"  if="#filter==Skladišta" value="#tree.@ValueId" />		
                    <parameter name="@DatumOd" value="#tree.@DatumOd" />
                    <parameter name="@DatumDo" value="#tree.@DatumDo" />
                </data>
				<fields inherited = "false">
					<field name="Broj" caption="Dokument" fixed="left" fontbold="true" />
					<field name="VrstaDokOpis" caption="Vrsta dokumenta"  />
					<field name="DatumDok" caption="Datum"  />
					<field name="Otpremnica" caption="Otpremnica"  />
					<field name="FakturniIznos" caption="Fak. iznos"  />
					<field name="ValutaOznaka" caption="Valuta"  />
					<field name="DevVrijednost" caption="Dev.Vrijednost"  />
					<field name="FakVrijednost" caption="Fak.Vrijednost"  />
					<field name="NVrijednost" caption="Nab.Vrijednost"  />
					<field name="Tecaj" caption="Tečaj" showtotalsum="false" showgroupsum="false" />
					<field name="Inicijali" caption="Operater"  />
					<field name="StatusSve" caption="Status"  />
					<field name="VrijemeZakljucka" caption="Vrijeme zaključka" format="dd.MM.yyyy HH:mm"/>
					<field name="SklOpis" caption="Skladište"  />
					<field name="RabatP" caption="Rabat%" showtotalsum="false" showgroupsum="false" />
					<field name="RabatUkupno" caption="Vrij.Rabata"  />
					<field name="PovratnaNaknada" caption="Povratna naknada"/>
					<field name="CarinaIznos" caption="Carina"  />
					<field name="CarinaPosto" caption="Carina %" showtotalsum="false" showgroupsum="false" />
					<field name="TrosakI" caption="Man. troškovi iznos"  />
					<field name="TrosakP" caption="Man. troškovi %'" showtotalsum="false" showgroupsum="false" />
					<field name="Dobavljac" caption="Dobavljač"  />
					<field name="Lokacija" caption="Lokacija"  />
					<field name="OsobaNaziv" caption="Odg.Osoba"  />
					<field name="UFA" caption="UFA"  />
					<field name="BrojRacuna" caption="Broj računa"  />
					<field name="Opis" caption="Opis"  />
					<field name="Memo" caption="Napomena"  />
					<field name="Prijevoznik" caption="Prijevoznik"/>
					<field name="Registracija" caption="Registracija"/>
					<field name="Temeljnica" />
					<field name="ProknjizenRobno" visible="false"/>
                </fields>
                <styles>
                    <style name="fontcolor" value="#CC0000" if="#grdGlava.@StatusSve==Nezaključen" />
                    <style name="fontcolor" value="#228B22" if="#grdGlava.@StatusSve==U robnom" />
                </styles>
				<menu>
					<menuitem caption="KOPIRAJ">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite kopirati dokument?">
								<!-- kopiraj dokument -->
								<action type="datarun scalar" value="global.~dtCopyDokAzur">
									<parameter name="NabPriGlaId" value="$NabPriGlaId"/>
									<!-- refresh grid -->
									<action type="control populate" value="#grdGlava"/>
									<action type="control focus" value="#grdGlava">
										<parameter value="$NabPriGlaId" />
									</action>
								</action>	
							</action>
						</event>					
					</menuitem>
					<menuitem name="menPovezaniDokumenti" caption="POVEZANI DOKUMENTI">
						<event type="click">
							<action type="form open" value="frmPovezaniDokumenti">
								<parameter name="GlaId" value="#grdGlava.@NabPriGlaId"/>
								<parameter name="Tablica" value="NabPriGla"/>
							</action>
						</event>
					</menuitem>						
				</menu>
            </grid>
			<grid name="grdDetail" showgrouppanel="false" showautofilterrow="true" savelayout="true" customsort="stringasint" multiselect="true">
				<data command="spNabPlkCarpoDetQuery">
                    <parameter name="@Action" value="stavkeDokumenta" />
                    <parameter name="@Id" value="#grdGlava.@NabPriGlaId" />
                </data>
				<partsql name="partgrdRobaFields" dataname="~dtPartCijenaFormat"/>
				<styles>
					<style name="fontcolor" value="#C70039" if="#grdDetail.@MinRokTrajanja==1"/>
				</styles>
            </grid>
        </managerlayout>
        <panelbuttons>
            <buttons>		
				<button name="btnUnesi" caption="UNESI"  dataname="global.~dtVrsteDok"  displayfield="Opis">
					<event type="click">
						<action type="form open" value="frmPriListKalNova">	  
							<parameter name="NabPriGlaId" value="null" />
							<parameter name="VrstaDokId" value="#btnUnesi.@VrstaDokId" />
							<parameter name="vrstaDok" value="#btnUnesi.@Opis" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit">
                    <menuitem control="#grdGlava"/>
                    <event type="click">
						<action type="variable value" value="Global.$OperaterLockId">
							<parameter value="#grdGlava.@NabPriGlaId" />
						</action>
                        <action type="form open" value="frmPriListKalEdit"  if="#grdGlava.rowcount&gt;0">
                            <parameter name="NabPriGlaId" value="#grdGlava.@NabPriGlaId" />
							<parameter name="Status" value="#grdGlava.@StatusSve"/>
							<parameter name="VrstaDokId" value="#grdGlava.@VrstaDokId"/>
							<parameter name="Izmjena" value="1"/>
                        </action>
                        <!-- <action type="control populate keepfocus" value="#grdGlava" /> -->
						<action type="control refreshrow" value="#grdGlava">
							<parameter value="~dtGlavaOne"/>
						</action>
						<action type="control populate" value="#grdDetail"/>						
                    </event>
                </button>
				 <button name="btnObrisi" caption="OBRIŠI" type="delete">
                    <event type="click">
                        <action type="confirm" value="Želite li obrisati dokument broj '{#grdGlava.@Broj}'?" if="#grdGlava.rowcount&gt;0">
                            <action type="datarun nonquery" value="~dtDelete">
                                <action type="control populate" value="#grdGlava"/>
                            </action>
                        </action>
                    </event>
                </button>
				<button name="btnPrint" caption="ISPIŠI DOKUMENT" dataname="global.~dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="datarun scalar" value="~dtPoveziNabPriGlaRobnoKalkGla">
							<parameter name="PoveziNabPriGlaRobnoKalkGla"/>
						</action>
						<action  if="#grdGlava.rowcount&gt;0">						
							<action type="control print" value="#grdGlava" if="#btnPrint.@Sifra=='80'&amp;&amp;$PoveziNabPriGlaRobnoKalkGla!=null">
								<action type="print template" value="#btnPrint.@Template">
									<parameter name="id" value="$PoveziNabPriGlaRobnoKalkGla"/>
								</action>							
							</action>	
							<action type="message" value="Ne postoje proknjiženi dokumenti, nije moguće ispisati kalkulaciju!" elseif="#btnPrint.@Sifra=='80'&amp;&amp;$PoveziNabPriGlaRobnoKalkGla==null"/>							
							<action type="control print" value="#grdGlava" elseif="#btnPrint.@Sifra=='06'">
								<action type="print template" value="#btnPrint.@Template">
									<parameter name="id" value="#grdGlava.@NabPriGlaId"/>
								</action>							
							</action>
						</action>
					</event>
				</button>
				<button name="btnZakljuci" caption="ZAKLJUČI PRIMKU" type="delete" function="">
                    <event type="click"> 
						<action type="confirm" value="Želite zaključiti odabrane primke?" if="#grdGlava.rowcount&gt;0">
							<action type="control foreachrow selected" value="#grdGlava">
								<!--provjeri operaterlock-->
								<action type="datarun scalar" value="global.~dtOperaterLock"/>
								<!-- prvo provjeri pubvars -->				
								<action type="datarun reader" value="global.~dtProvjeriPubVars"/>
								<!-- pozovi storu za provjeru knjizenja -->
								<action type="datarun reader" value="global.~dtProvjeriKnjizenje" if="~dtProvjeriPubVars.rowcount&gt;0"/>
								<!-- ZakljuciPrimkuStavka -->
								<action type="datarun reader" value="global.~dtNabKalkZakljuci"/>
								<action type="datarun reader" value="global.~dtNKUCjenikAzur"/>
								<action type="control refreshrow" value="#grdGlava">
									<parameter value="~dtGlavaOne"/>
								</action>
							</action>
							<!-- <action type="control populate" value="#grdGlava" /> -->
                        </action>
                    </event>
                </button>
				<button name="btnPromijeniStatus" caption="PROMIJENI STATUS" type="delete" function="" enabled="false">
                    <event type="click">
						<action type="form open" value="frmPromjenaStatusa" if="#grdGlava.@NabPriGlaId!=null">
							<parameter name="NabPriGlaId" value="#grdGlava.@NabPriGlaId" />
							<parameter name="Status" value="#grdGlava.@Status" />
						</action>                    
					</event>
                </button>
				<button name="btnPonisti" caption="PONIŠTI PRIMKU" type="delete" function="">
                    <event type="click">
						<action type="variable value" value="$vrstaakcije">
							<parameter value="0"/>
						</action>
						<action type="datarun reader" value="dtStatusCheck" if="#grdGlava.rowcount&gt;0"/>

						<action type="confirm" value="~dtStatusCheck.@text" if="#grdGlava.rowcount&gt;0&amp;&amp;~dtStatusCheck!=null&amp;&amp;~dtStatusCheck.rowcount&gt;0">
							<action type="control foreachrow selected" value="#grdGlava" if="#grdGlava.@Status==1&amp;&amp;#grdGlava.@ProknjizenRobno==0">
								<action type="datarun nonquery" value="dtPonistiPrimku"/>
								<action type="control refreshrow" value="#grdGlava">
									<parameter value="~dtGlavaOne"/>
								</action>								
							</action>
							<!-- <action type="control populate" value="#grdGlava" /> -->
						</action>                    
                    </event>
                </button>
				<button name="btnZakljuciKalk" caption="ZAKLJUČI KALKULACIJU" type="delete" function="">
                    <event type="click">
						<action type="variable value" value="$vrstaakcije">
							<parameter value="2"/>
						</action>
						<action type="datarun reader" value="dtStatusCheck" if="#grdGlava.rowcount&gt;0"/>
						<action type="confirm" value="~dtStatusCheck.@text" if="#grdGlava.rowcount&gt;0">
							<action type="control foreachrow selected" value="#grdGlava" if="#grdGlava.@ProknjizenRobno==0">								
								<action type="datarun nonquery" value="dtZakljuciKalkulaciju" if="#grdGlava.@Status==1||#grdGlava.@Status==2"/>
								<action type="control refreshrow" value="#grdGlava">
									<parameter value="~dtGlavaOne"/>
								</action>								
							</action>
							<!-- <action type="control populate" value="#grdGlava"/> -->
                        </action>
                    </event>
                </button>
				<button name="btnPonistiKalk" caption="PONIŠTI KALKULACIJU" type="delete" function="">
                    <event type="click">
						<action type="variable value" value="$vrstaakcije">
							<parameter value="1"/>
						</action>
						<action type="datarun reader" value="dtStatusCheck" if="#grdGlava.rowcount&gt;0"/>
						<action type="confirm" value="~dtStatusCheck.@text" if="#grdGlava.rowcount&gt;0">
							<action type="control foreachrow selected" value="#grdGlava" if="#grdGlava.@ProknjizenRobno==1">
								<action type="datarun nonquery" value="dtPonistiKlakulaciju"/>
								<action type="control refreshrow" value="#grdGlava">
									<parameter value="~dtGlavaOne"/>
								</action>								
							</action>
							<!-- <action type="control populate" value="#grdGlava" /> -->
                        </action>
                    </event>
                </button>
				<button name="btnSearch" caption="PRONAĐI">
					<dropdownitem caption="PO BROJU">
						<event type="click">
							<action type="search" value="~dtSearch"/>
						</event> 					
					</dropdownitem>
					<dropdownitem caption="PO OTPREMNICI">
						<event type="click">
							<action type="search" value="~dtSearchOtpremnica"/>	
						</event>
					</dropdownitem>	
				</button>
            </buttons>
        </panelbuttons>
        <datalist>
			<data command="spVrstaDokGetCarpo" name="dtVrstaDokGet"></data>
			<data command="spNabPlkCarpoGlaAzur" name="dtDelete">
                <parameter name="@Id" value="#grdGlava.@NabPriGlaId" />
                <parameter name="@Action" value="delete" />
            </data>
			<data command="spNabPlkCarpoPonistiZakljucakPrimke" name="dtPonistiPrimku"  timeout="200">
				<parameter name="@ID"  value="#grdGlava.@NabPriGlaId"/>
				<parameter name="@OperateriId"  value="@@operateriid"/>				
			</data>	
			<data command="spNabPlkCarpoPonistiZakljucakKalkulacije" name="dtPonistiKlakulaciju"  timeout="200">
				<parameter name="@NabPriGlaId"  value="#grdGlava.@NabPriGlaId" />			
			</data>			
			<data command="spNabPlkCarpoKalkKnjizenje" name="dtZakljuciKalkulaciju" >
				<parameter name="@NabPriGlaId"  value="#grdGlava.@NabPriGlaId" />			
				<parameter name="@OperaterId"  value="@@OperateriId" />			
			</data>
			<data command="spNabPlkCarpoDokumentStatusCheck" name="dtStatusCheck" >		
				<parameter name="@Idijevi"  value="#grdGlava.selectedids" />
				<parameter name="@vrstaakcije"  value="$vrstaakcije" />
			</data>
			<data name="dtPoveziNabPriGlaRobnoKalkGla" command="spNabPriGlaVezaRobnoKalkGla">
				<parameter name="@NabPriGlaId" value="#grdGlava.@NabPriGlaId"/>
			</data>
			<data name="dtMarzaPubVar" command="spPriListKalMarza">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtSearch" command="spCarpoSearch">
				<parameter name="@Table" value="NabPriGla"/>
				<parameter name="@Pojam" value="#btnSearch.searchtext"/>
			</data>		
			<data name="dtSearchOtpremnica" command="spCarpoSearch">
				<parameter name="@Table" value="NabPriGla"/>
				<parameter name="@Pojam" value="#btnSearch.searchtext"/>
				<parameter name="@Action" value="Otpremnica"/>
			</data>				
			<data name="dtGlavaOne" command="spNabPlkCarpoGlaQueryOne" timeout="300">
				<parameter name="@NabPriGlaId"  value="#grdGlava.@NabPriGlaId"/>
			</data>			
        </datalist>	
    </form>
	<form name="frmPriListKalNova" path="frmPriListKalNova.xml"/>
	<form name="frmPriListKalEdit" path="frmPriListKalEdit.xml"/>	
	<form name="frmStavkaPrijemnogLista" path="frmStavkaPrijemnogLista.xml"/>
	<form name="frmPromjenaStatusa" path="frmPromjenaStatusa.xml"/>
