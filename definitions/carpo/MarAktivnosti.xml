		<part name="prtObrisi">
		<event type="click">
		<action type="confirm" value="Jeste li sigurni da želite obrisati '{#tree.@Naziv}'?" if="#tree.@Id!=-1">
		<action type="datarun nonquery" value="~datOrgDelete" />
		<action type="control populate keepfocus" value="#tree" />
		</action>
		<action type="datarun nonquery" value="~datOrgAzur" />
		<action type="control defaultmode" value="#tree" />
		</event>
		</part>
		-->
		<!--
		<part name="prtFormAzur">
		<item caption="Naziv:" row="1" col="1">
		<textedit name="txtNaziv" required="true" datavalue="~datGet.@Naziv" fontbold="true" />
		</item>
		<item caption="Oznaka:" row="2" col="1">
		<textedit name="txtOznaka" datavalue="~datGet.@Oznaka" maxsize="10" />
		</item>
		</part>
		-->
	</parts>
</root>
