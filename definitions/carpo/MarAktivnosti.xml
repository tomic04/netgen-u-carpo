<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmMaster" type="master" caption="Klasifikacija marketinških aktivnosti">
		<managerlayout>
			<tree name="tree" keyfield="MarKlAktId" allowselfdrag="true" dataname="datOrgTree" showcolumns="true" autofiltercondition="contains" expandallonload="true" expandedlevel="2" savelayout="true">
				<fields>
					<field name="Naziv" />
					<field name="Oznaka" fixwidth="300" />
				</fields>
				<menu>
					<menuitem caption="UNESI">
						<event type="click">
							<action type="form open" value="frmAzur">
								<parameter name="MarKlAktId" value="#tree" />
								<parameter name="FormType" value="novi unos" />
							</action>
							<!-- <action type="control populate keepfocus" value="#tree" /> -->
						</event>
					</menuitem>
					<menuitem caption="IZMIJENI">
						<event type="click">
							<action type="form open" value="frmAzur" if="#tree.@Id!=-1">
								<parameter name="Id" value="1" />
								<parameter name="MarKlAktId" value="#tree.@MarKlAktId" />
								<parameter name="FormType" value="izmjena" />
							</action>
							<action type="control populate keepfocus" value="#tree" />
						</event>
					</menuitem>
					<menuitem caption="OBRIŠI">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati '{#tree.@Naziv}'?" if="#tree.@Id!=-1">
								<action type="datarun nonquery" value="~datOrgDelete" />
								<action type="control populate keepfocus" value="#tree" />
							</action>
							<action type="datarun nonquery" value="~datOrgAzur" />
							<action type="control defaultmode" value="#tree" />
						</event>
					</menuitem>
				</menu>
				<!-- <event type="doubleclick">
					<action type="form open" value="frmAzur" if="#tree.@Id!=-1">
						<parameter name="Id" value="1" />
						<parameter name="MarKlAktId" value="#tree.@MarKlAktId" />
						<parameter name="FormType" value="izmjena" />
					</action>
					<action type="control populate keepfocus" value="#tree" />
				</event> -->
			</tree>
		</managerlayout>
		<panelbuttons displaycontrolsprint="false">
			<buttons type="tree">
				<button name="btnDrag" caption="SPREMI PROMJENE" type="selfdrag">
					<event type="click">
						<action type="datarun nonquery" value="~datOrgAzur" />
						<action type="control defaultmode" value="#tree" />
					</event>
				</button>
				<button name="btnDrag" caption="ODUSTANI" type="selfdragcancel">
					<event type="click">
						<action type="confirm" value="Želite odustati od reorganizacije?">
							<action type="control populate" value="#tree" />
							<action type="control dragmode" value="#tree" />
						</action>
					</event>
				</button>
				<button name="btnUnesi" caption="UNESI" type="add" begingroup="true" color="light">
					<!--
					<part name="prtUnesi">
					</part>
					-->
					<event type="click">
						<action type="form open" value="frmAzur">
							<parameter name="MarKlAktId" value="#tree" />
							<parameter name="FormType" value="novi unos" />
						</action>
						<!-- <action type="control populate keepfocus" value="#tree" /> -->
					</event>
				</button>
				<button name="btnEdit" caption="IZMIJENI" type="edit">
					<event type="click">
						<action type="form open" value="frmAzur" if="#tree.@Id!=-1">
							<parameter name="Id" value="1" />
							<!-- pomoćna varijabla update/insert -->
							<parameter name="MarKlAktId" value="#tree.@MarKlAktId" />
							<parameter name="FormType" value="izmjena" />
						</action>
						<action type="control populate keepfocus" value="#tree" />
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI" type="delete">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati '{#tree.@Naziv}'?" if="#tree.@Id!=-1">
							<action type="datarun nonquery" value="~datOrgDelete" />
							<action type="control populate keepfocus" value="#tree" />
						</action>
						<action type="datarun nonquery" value="~datOrgAzur" />
						<action type="control defaultmode" value="#tree" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarKlAktQuery" name="datOrgTree">
				<parameter name="Action" value="0" />
			</data>
			<data command="spMarKlAktAzurTree" name="datOrgAzur">
				<parameter name="@Action" value="setTree" />
				<parameter name="@TableVar" value="#tree.datasource" />
			</data>
			<data command="spMarKlAktAzur" name="datOrgDelete">
				<parameter name="@Action" value="delete" />
				<parameter name="@MarKlAktId" value="#tree" />
			</data>
		</datalist>
	</form>
	<form name="frmAzur" caption="Klasifikacija marketinških aktivnosti - {$formType}" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~datGet" if="$Id!=null" />
		</event>
		<event type="shown">
			<action type="control focus" value="#txtNaziv" />
		</event>
		<layout textposition="top">
			<group cols="1" rows="2">
				<item caption="Naziv:" row="1" col="1">
					<textedit name="txtNaziv" required="true" datavalue="~datGet.@Naziv" fontbold="true" />
				</item>
				<item caption="Oznaka:" row="2" col="1">
					<textedit name="txtOznaka" datavalue="~datGet.@Oznaka" maxsize="10" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~datAzur">
							<parameter name="shemaid" />
							<!-- <action type="message" value="$shemaid"></action> -->
						</action>
						<action type="control populate keepfocus" value="parent.#tree" />
						<action type="control expand" value="parent.#tree">
							<parameter name="key" value="$shemaid">
							</parameter>
						</action>
						<!-- <action type="form close" if="$Id!=null||#chkFormClose==true" /> -->
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarKlAktAzur" name="datAzur">
				<parameter name="@Action" value="add" if="$Id==null" />
				<parameter name="@Action" value="edit" else="" />
				<parameter name="@MarKlAktId" value="$MarKlAktId" text="" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@InsertTip" value="in" />
			</data>
			<data command="spMarKlAktQuery" name="datGet">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$MarKlAktId" />
			</data>
		</datalist>
	</form>
	<parts>
		<!--
		<part name="prtUnesi">
		<event type="click">
		<action type="form open" value="frmAzur">
		<parameter name="MarKlAktId" value="#tree" />
