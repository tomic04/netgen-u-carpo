<?xml version="1.0" encoding="utf-8"?>
<!-- MULTIBLUEPROK_FORM - Proknjiženje na temeljnicu -->
<root version="1.2">
  <form name="frmProknjizi" type="custom" caption="Proknjiženje" width="290" height="200">
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1">
          <label name="lblPoruka" caption="Proknjiži UFU na temeljnicu?"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnDa" caption="DA">
          <event type="click">
            <action type="datarun nonquery" value="~dtKnjizi"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnNe" caption="NE" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtKnjizi" command="spFaktureDobKnjizenje" timeout="30">
        <parameter name="@id" value="$FaktureDobId"/>
      </data>
    </datalist>
  </form>
</root>
