<!--v 1.0.0. 19.08.2019. DH kreirano-->
<root loglevel="3" version="1.0.0.">
	<form name="frmBlokada" caption="Blokada" type="master" width="600" height="400" saveformsize="false" >
		<event type="init">
			<action type="datarun reader" value="~dtSelect"/>
		</event>
		<event type="load">
	
			<action type="control value" value="#datDatumBlokadePdvDo">
				<parameter value="~dtSelect.@DatumBlokadePdvDo"/>
			</action>
		</event>
		<event type="shown">
			<action type="datarun scalar" value="~dtSelect">
				<parameter name="ID"/>
			</action>
			<action type="control populate" value="#grdBlokade"/>
		</event>
		<layout>
			<group rows="3" cols="3" groupbordervisible="false" caption="Unesite novu blokadu:">
				<columnsdefinition>
					<column size="25%" position="1"/>
					<column size="25%" position="2"/>
					<column size="50%" position="3"/>
				</columnsdefinition>
				<rowsdefinition>
					<row size="10%" position="1"/>
					<row size="10%" position="2"/>
					<row size="80%" position="3"/>
				</rowsdefinition>
				<group col="1" row="1" cols="1" rows="1" colspan="3"  alignmode="local" > 

					<item col="1" row="1" caption="Datum Blokade Do:"  textposition="left" >
						<dateedit name="datDatumBlokadePdvDo"/>
					</item>
				</group>
				<item row="2" col="1" >
					<button name="btnSpremi" caption="Spremi">
						<event type="click">
							<action type="datarun scalar" value="~dtInsert">
								<parameter name="ID"/>
							</action>
							<action type="control populate" value="#grdBlokade"/>
							<action type="control focus" value="#grdBlokade">
								<parameter value="$ID" type="int"/>
							</action>
						</event>
					</button>
				</item>
				<item row="2" col="2">
					<button name="btnOdustani" type="cancel" caption="Odustani"/>
				</item>
				<item col="1" row="3" colspan="3" caption="Nedavne blokade">
					<grid name="grdBlokade" bestfitonrefresh="true"  dataname="~dtGrid" enabled="true" saveformsize="true" showautofilterrow="false" showgrouppanel="false" fieldsmartspaces="false"   >
						<event type="cellvaluechanged">
							<action type="datarun reader" value="~dtSelect">
								<parameter name="ID"/>
							</action>
						</event>
						<fields >
							
							<field name="DatumBlokadePdvDo" caption="Datum blokade otključavanja PDV" minwidth="90"/>
							<field name="Danas" caption="Datum unosa" minwidth="90"/>
							<field name="Operater"  />
						</fields>	
					<styles>
						<style name="bold" value="true" if="#grdBlokade.@KntBlokadaId==$ID" />
					</styles>
					</grid>
				</item>
			</group>
		</layout>
		<datalist>
			<data name="dtSelect" command="spCKntBlokadaPdv" >
				<parameter name="@Action" value="1"/>
			</data>
			<data name="dtInsert" command="spCKntBlokadaPdv">
				<parameter name="@Action" value="2"/>
				<parameter name="@DatumBlokadePdvDo" value="#datDatumBlokadePdvDo"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>
			<data name="dtGrid" command="spCKntBlokadaPdv">
				<parameter name="@Action" value="3"/>
			</data>
		</datalist>
	</form>
</root>