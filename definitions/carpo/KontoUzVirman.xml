01.03.2017 PJ init verzija
-->
<root version="1.0.0.0">
	<form name="frmMaster" type="master" caption="Konto uz virman">
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="KontoUzVirmanId" async="true">
				<fields >
					<field name="KontoUzVirmanId" visible="false"  />
					<field name="KntPlanAId" visible="false" />
					<field name="Konto" caption="Konto za prikaz" />

				</fields>
			</grid>	
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" type="add">
					<event type="click">
						<action type="form open" value="frmEdit" >					
							<parameter name="IndUnos" value="1" />
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni" type="edit">
					<event type="click">					
						<action type="form open" value="frmEdit">
							<parameter name="IndUnos" value="0"/>
							<parameter name="ID" value="#grdMaster.@KontoUzVirmanId" />
							<parameter name="KntPlanAId" value="#grdMaster.@KntPlanAId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>				
				<button name="btnObrisi" caption="Obriši" type="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati '{#grdMaster.@Konto}'?">
							<action type="datarun nonquery" value="Global.~dtDelete"/>
							<action type="control populate keepfocus" value="#grdMaster" />
						</action>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
	</form>
	
	<form name="frmEdit" caption="Ažuriranje" textposition="top" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="Global.~dtEditQuery" if="$IndUnos==0" />
		</event>
		<event type="shown">
			<action type="control value" value="#txtKonto" if="$IndUnos=0">
				<parameter value="parent.#grdMaster.@Konto" />
			</action>					
		</event>
<!--		<event type="close">
			<!{1}** <action type="message" value="parent.$NewId" /> **{1}>
			<action type="control populate" value="parent.#grdMaster" if="parent.$NewId!=0">
				<action type="control focus" value="parent.#grdMaster" if="parent.$NewId!=0">
					<parameter value="parent.$NewId" type="int"/>
				</action>
			</action>
		</event>-->		
		<layout>
			<group cols="1" rows="1">
				<item caption="Konto" col="1" row="1">
					<textedit name="txtKonto" fontsizedelta="1" fontbold="True" datavalue="~dtEditQuery.@Konto" required="true" >
					</textedit>		
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="variable value"  >
							<parameter name="Konto" value="#txtKonto"/>
						</action>
						<action type="datarun nonquery" value="Global.~dtInsert" if="$IndUnos==1"/>
						<action type="datarun nonquery" value="Global.~dtEditAzur" if="$IndUnos==0"/>	
						<action type="control value" value="#txtKonto">
							<parameter value=""/>
						</action>	
						<action type="control populate" value="parent.#grdMaster" />						
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>		
	</form>	
	
	<datalist>
		<data command="spKontoUzVirman" name="dtMaster">
			<parameter name="@Action" value="0" />
		</data>	
		<data command="spKontoUzVirman" name="dtEditQuery">
			<parameter name="@Action" value="1" />
			<parameter name="@id" value="$ID" />
		</data>	
		<data command="spKontoUzVirman" name="dtInsert">
			<parameter name="@Action" value="2" />
			<parameter name="@Konto" value="$Konto" />
		</data>	
		<data command="spKontoUzVirman" name="dtEditAzur">
			<parameter name="@Action" value="3" />
			<parameter name="@Konto" value="$Konto" />
			<parameter name="@id" value="$ID" />
		</data>	
		<data command="spKontoUzVirman" name="dtDelete">
			<parameter name="@Action" value="4" />
			<parameter name="@id" value="#grdMaster.@KontoUzVirmanId" />
		</data>
	</datalist>
</root>