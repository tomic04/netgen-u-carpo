        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanjeKoef"/>
			
			<action if="$indGreske==0">
				<action type="control populate keepfocus" value="parent.#grdKoef"/>
				<action type="form close"/>
			</action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
          <event type="click">
