<root version="1.0">
  <!--
  Komentari:
  20.09.2021. Jadranka Vučenović Vojvodić - kreirala granulu ver 1.0.
  -->
  
  <!--
  *******************************************************************************************
  POČETNA FORMA
  *******************************************************************************************
  -->
  <form name="frmPocetna" caption="Vrste invalidnosti" width="650" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1.0">
    <event type="init">
      <action type="datarun reader" value="~dtGrid" />
    </event>

    <event type="load">
      <action type="control populate" value="#grdGrid" >     </action>
	  <action type="control enable" value="#btnIzmjena,#btnBrisanje" if="#grdGrid.rowcount!=0"/>
	  <action type="control disable" value="#btnIzmjena,#btnBrisanje" else=""/>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdGrid" key="HRInvalidnostVrsteId" dataname="~dtGrid" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" >
		  <event type="doubleclick">
		   <action type="form open" value="frmUnos">
              <parameter name="caption" value="Izmjena {#grdGrid.@Naziv}"/>
              <parameter name="Id" value="#grdGrid.@ID"/>
			  <parameter name="Tip" value="izmjena"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
		  </event>
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="form open" value="frmUnos">
              <parameter name="caption" value="Unos"/>
              <parameter name="Id" value="0"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
          </event>
        </button>
        <button name="btnIzmjena" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmUnos">
              <parameter name="caption" value="Izmjena {#grdGrid.@Naziv}"/>
              <parameter name="Id" value="#grdGrid.@HRInvalidnostVrsteId"/>
			  <parameter name="Tip" value="izmjena"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
          </event>
        </button>
        <button name="btnBrisanje" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmBrisanje">
              <parameter name="caption" value="Brisanje odabranih zapisa}"/>
              <parameter name="Id" value="#grdGrid.@HRInvalidnostVrsteId"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
			<action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdGrid==null"/>
          </event>
        </button>
		<button name="btnKoeficijent" caption="Koeficijenti">
          <event type="click">
            <action type="form open" value="frmKoeficijent">
              <parameter name="caption" value="Koeficijenti"/>
              <parameter name="Id" value="#grdGrid.@HRInvalidnostVrsteId"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spHRInvalidnostVrste_CP" name="dtGrid">
        <parameter name="action" value="MASTER"></parameter>
      </data>
    </datalist>
  </form>
  
  <!--
  *******************************************************************************************
  FORMA ZA UNOS/IZMJENU
  *******************************************************************************************
  -->

  <form name="frmUnos" caption="$caption" width="400" height="200" >
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$Id!=0" /> 
    </event>
    <event type="load">
      <action type="control disable" value="#btnUnos,#btnOdustani" if="$Id==null"/>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false" >
        <item caption="Naziv:" col="1" row="1" textposition="top" highlight="false" >
          <textedit name="txtNaziv" datavalue="~dtget.@Naziv" allownull="false" required="true" maxlength="100" ></textedit>
        </item>
        <item caption="Oznaka" col="1" row="2" textposition="top" highlight="false" >
          <textedit name="txtOznaka" datavalue="~dtget.@Oznaka" allownull="false" required="true" maxlength="50"></textedit>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$Id==0">
              <action type="datarun reader" value="~dtUnos">
			  <action type="control populate" value="parent.#grdGrid">
			  <action type="control focus" value="parent.#grdGrid">
			  <parameter value="$noviID"/>
			  </action>
			  </action>
			  <action type="control enable" value="parent.#btnIzmjena,parent.#btnBrisanje"/>
			  </action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
            </action>
            <action if="$Id!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
              
              <!--<action type="form close"></action>-->
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spHRInvalidnostVrste_CP" name="dtGet">
        <parameter name="@action" value="dtGet"></parameter>
        <parameter name="@id" value="$Id"></parameter>
      </data>
      <data command="spHRInvalidnostVrste_CP" name="dtUnos">
        <parameter name="@action" value="UNOS"></parameter>
		<parameter name="@Id.output.int" variablename="noviID"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
      <data command="spHRInvalidnostVrste_CP" name="dtIzmjena">
        <parameter name="@action" value="IZMJENA"></parameter>
        <parameter name="@id" value="$Id"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
    </datalist>
  </form>
  
  <!--
  *******************************************************************************************
  FORMA ZA BRISANJE
  *******************************************************************************************
  -->
  <form name="frmBrisanje" caption ="Brisanje" width="400" height="150" fixedsize="true" saveformsize="false" >
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrane zapise?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"/>
			
			<action if="$indGreske==0">
				<action type="control populate keepfocus" value="parent.#grdGrid"/>
				<action type="form close"/>
			</action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
	 <datalist>
        <data command="spHRInvalidnostVrste_CP" name="dtBrisanje"> 
         <parameter name="@Action" value="BRISANJE_JEDAN"/> 
         <parameter name="@id" value="$Id"/> 
         <parameter name="@indGreske.output.int"></parameter> 
        </data> 
    </datalist>
  </form>
    <!--
  *******************************************************************************************
  FORMA ZA KOEFICIJENTE
  *******************************************************************************************
  -->
<form name="frmKoeficijent" caption ="$caption" width="500" height="400" fixedsize="true" saveformsize="false" >
    <event type="load">
	 <action type="datarun reader" value="~dtGridKoef" />
      <action type="control populate" value="#grdKoef" >     </action>
	  <action type="control enable" value="#btnIzmjena,#btnBrisanje" if="#grdKoef.rowcount!=0"/>
	  <action type="control disable" value="#btnIzmjena,#btnBrisanje" else=""/>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdKoef" key="HRInvalidnostVrsteCjenikId" dataname="~dtGridKoef" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" >
		  <event type="doubleclick">
		   <action type="form open" value="frmUnos">
              <parameter name="caption" value="Izmjena {#grdKoef.@Naziv}"/>
              <parameter name="Id" value="#grdKoef.@ID"/>
			  <parameter name="Tip" value="izmjena"/>
            </action>
            <action type="control populate keepfocus" value="#grdKoef"/>
		  </event>
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="form open" value="frmUnosKoef">
              <parameter name="caption" value="Unos"/>
			  <parameter name="HRInvalidnostVrsteId" value="$Id"/>
              <parameter name="Id" value="0"/>
            </action>
            <action type="control populate keepfocus" value="#grdKoef"/>
          </event>
        </button>
        <button name="btnIzmjena" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmUnosKoef">
              <parameter name="caption" value="Izmjena {#grdKoef.@Naziv}"/>
              <parameter name="Id" value="#grdKoef.@HRInvalidnostVrsteCjenikId"/>
			  <parameter name="Tip" value="izmjena"/>
            </action>
            <action type="control populate keepfocus" value="#grdKoef"/>
          </event>
        </button>
        <button name="btnBrisanje" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmBrisanjeKoef">
              <parameter name="caption" value="Brisanje odabranih zapisa}"/>
              <parameter name="Id" value="#grdKoef.@HRInvalidnostVrsteCjenikId"/>
            </action>
            <action type="control populate keepfocus" value="#grdKoef"/>
			<action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdKoef==null"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
 <datalist>
      <data command="spHRInvalidnostVrste_CP" name="dtGridKoef">
        <parameter name="@action" value="MASTERKOEF"></parameter>
		<parameter name="@id" value="parent.#grdGrid.@HRInvalidnostVrsteId" />
      </data>
    </datalist>
  </form>
  <!--
  *******************************************************************************************
  FORMA ZA UNOS/IZMJENU KOEFICIJENTA
  *******************************************************************************************
  -->

  <form name="frmUnosKoef" caption="$caption" width="320" height="200" >
    <event type="init">
      <action type="datarun reader" value="~dtGetKoef" if="$Id!=0" /> 
    </event>
    <event type="load">
      <action type="control disable" value="#btnUnos,#btnOdustani" if="$Id==null"/>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false" >
        <item caption="Datum:" col="1" row="1" textposition="top" highlight="false" >
          <dateedit name="dtDatum" datavalue="~dtGetKoef.@Datum" value="now" allownull="false" required="true"  ></dateedit>
        </item>
        <item caption="Koeficijent" col="1" row="2" textposition="top" highlight="false" >
          <textedit name="txtKoeficijent" datavalue="~dtGetKoef.@Koeficijent" allownull="false" required="true" format="n2" value="0"></textedit>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$Id==0">
              <action type="datarun reader" value="~dtUnos">
			  <action type="control focus" value="parent.#grdKoef">
			  <parameter value="$noviID"/>
			  </action>
			  <action type="control enable" value="parent.#btnIzmjena,parent.#btnBrisanje"/>
			  </action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
            </action>
            <action if="$Id!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
              
              <!--<action type="form close"></action>-->
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spHRInvalidnostVrste_CP" name="dtGetKoef">
        <parameter name="@action" value="dtGetKoef"></parameter>
        <parameter name="@id" value="$Id"></parameter>
      </data>
      <data command="spHRInvalidnostVrste_CP" name="dtUnos">
        <parameter name="@action" value="UNOSKOEF"></parameter>
		<parameter name="@Id.output.int" variablename="noviID"></parameter>
		<parameter name="@HRInvalidnostVrsteId" value="$HRInvalidnostVrsteId"></parameter>
        <parameter name="@datum" value="#dtDatum"></parameter>
        <parameter name="@koeficijent" value="#txtKoeficijent"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
      <data command="spHRInvalidnostVrste_CP" name="dtIzmjena">
        <parameter name="@action" value="IZMJENAKOEF"></parameter>
        <parameter name="@id" value="$Id"></parameter>
		<parameter name="@HRInvalidnostVrsteId" value="parent.#grdKoef.@HRInvalidnostVrsteId"></parameter>
       <parameter name="@datum" value="#dtDatum"></parameter>
        <parameter name="@koeficijent" value="#txtKoeficijent"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
    </datalist>
  </form>
