<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: UPDATEFORM (NetGen) → frmUpdate (Carpo)
-->
<root version="1.2">
  <form name="frmUpdate" caption="Izmjena dokumenta" type="dialog" width="760" height="540" fixedsize="false">
    <event type="init">
      <action type="variable value">
        <parameter name="$Id" value="$Id"/>
      </action>
    </event>

    <event type="shown">
      <action type="datarun reader" value="~dtLoad"/>
      <action type="control populate" value="#cmbVrstaPoste,#cmbValuta,#cmbOrgShema"/>

      <action type="control value" value="#cmbVrstaPoste">
        <parameter value="~dtLoad.@KUPVrstaPosteId"/>
      </action>
      <action type="control value" value="#txtUrudzbeni">
        <parameter value="~dtLoad.@UrudzbeniBroj"/>
      </action>
      <action type="control value" value="#txtVezaUrudzbeni">
        <parameter value="~dtLoad.@UrudzbeniBrojVeza"/>
      </action>
      <action type="control value" value="#srcPartner">
        <parameter value="~dtLoad.@PartneriId" text="~dtLoad.@Partner"/>
      </action>
      <action type="control value" value="#txtPosiljatelj">
        <parameter value="~dtLoad.@Posiljatelj"/>
      </action>
      <action type="control value" value="#txtBrojDok">
        <parameter value="~dtLoad.@Broj"/>
      </action>
      <action type="control value" value="#txtBrojUfe">
        <parameter value="~dtLoad.@BrojUfe"/>
      </action>
      <action type="control value" value="#txtRjesenje">
        <parameter value="~dtLoad.@Rjesenje"/>
      </action>
      <action type="control value" value="#txtOpis">
        <parameter value="~dtLoad.@Opis"/>
      </action>
      <action type="control value" value="#curIznos">
        <parameter value="~dtLoad.@Iznos"/>
      </action>
      <action type="control value" value="#cmbValuta">
        <parameter value="~dtLoad.@ValuteId"/>
      </action>
      <action type="control value" value="#cmbOrgShema">
        <parameter value="~dtLoad.@OrgShemaId"/>
      </action>
      <action type="control value" value="#datDatumPrijema">
        <parameter value="~dtLoad.@DatumPrijema" type="date"/>
      </action>
      <action type="control value" value="#datDatumValute">
        <parameter value="~dtLoad.@DatumValute" type="date"/>
      </action>
      <action type="control value" value="#datDatumDokumenta">
        <parameter value="~dtLoad.@DatumDokumenta" type="date"/>
      </action>
    </event>

    <layout>
      <group cols="2" rows="12" groupbordervisible="false">
        <item col="1" row="1" caption="Vrsta pošte:" textposition="left">
          <comboedit name="cmbVrstaPoste" dataname="~dtVrstaPoste" valuefield="kupvrstaposteid" displayfield="naziv" allownull="true" enabled="false"/>
        </item>
        <item col="2" row="1" caption="Urudžbeni broj:" textposition="left">
          <textedit name="txtUrudzbeni" enabled="false"/>
        </item>

        <item col="1" row="2" caption="Veza na ur. broj:" textposition="left">
          <textedit name="txtVezaUrudzbeni"/>
        </item>
        <item col="2" row="2" caption="Partner:" textposition="left">
          <searchedit name="srcPartner"
                      dataname="~dtPartneri"
                      fieldvalue="PartneriId"
                      fieldtext="NazivId"
                      savelayout="true"/>
        </item>

        <item col="1" row="3" caption="Pošiljatelj:" textposition="left">
          <textedit name="txtPosiljatelj"/>
        </item>
        <item col="2" row="3" caption="Broj dokumenta:" textposition="left">
          <textedit name="txtBrojDok"/>
        </item>

        <item col="1" row="4" caption="Broj UFE:" textposition="left">
          <textedit name="txtBrojUfe"/>
        </item>
        <item col="2" row="4" caption="Rješenje:" textposition="left">
          <textedit name="txtRjesenje"/>
        </item>

        <item col="1" row="5" caption="Opis:" textposition="left">
          <textedit name="txtOpis"/>
        </item>
        <item col="2" row="5" caption="Iznos:" textposition="left">
          <textedit name="curIznos" format="n4" value="0"/>
        </item>

        <item col="1" row="6" caption="Valuta:" textposition="left">
          <comboedit name="cmbValuta" dataname="~dtValute" valuefield="ValuteId" displayfield="Naziv" allownull="true"/>
        </item>
        <item col="2" row="6" caption="Org. shema:" textposition="left">
          <comboedit name="cmbOrgShema" dataname="~dtOrgShema" valuefield="OrgShemaId" displayfield="Naziv" allownull="true"/>
        </item>

        <item col="1" row="7" caption="Datum prijema:" textposition="left">
          <dateedit name="datDatumPrijema"/>
        </item>
        <item col="2" row="7" caption="Datum valute:" textposition="left">
          <dateedit name="datDatumValute"/>
        </item>

        <item col="1" row="8" caption="Datum dokumenta:" textposition="left">
          <dateedit name="datDatumDokumenta"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click" waittype="progress" waitcaption="Spremanje" waittext="Spremam...">
            <action type="datarun nonquery" value="~dtUpdate"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtLoad" command="spKUPPrometQueryN" timeout="300">
        <parameter name="@action" value="1"/>
        <parameter name="@ID" value="$Id"/>
        <parameter name="@OperateriId" value="@@operateriid"/>
      </data>

      <data name="dtVrstaPoste" type="text" timeout="300"
            command="select kupvrstaposteid, naziv from kupvrstaposte order by naziv"/>

      <data name="dtValute" type="text" timeout="300"
            command="select ValuteId, Naziv=(ltrim(oznaka)+space(2)+rtrim(naziv)), oznaka as oznakaid from Valute order by oznaka"/>

      <data name="dtOrgShema" type="text" timeout="300"
            command="select OrgShemaId, naziv=rtrim(naziv), sortkey as sortkeyid from orgshema order by naziv"/>

      <data name="dtPartneri" command="spTraziPartneri" timeout="300">
        <parameter name="@action" value="'Partneri'"/>
        <parameter name="@uvjet" value="#srcPartner.text"/>
      </data>

      <data name="dtUpdate" command="spKUPPrometAzurN" timeout="300">
        <parameter name="@Action" value="1"/>
        <parameter name="@ID" value="$Id"/>
        <parameter name="@OperateriId" value="@@operateriid"/>
        <parameter name="@KupVrstaPosteId" value="#cmbVrstaPoste"/>
        <parameter name="@UrudzbeniBroj" value="#txtUrudzbeni"/>
        <parameter name="@UrudzbeniBrojVeza" value="#txtVezaUrudzbeni"/>
        <parameter name="@PartneriId" value="#srcPartner"/>
        <parameter name="@Posiljatelj" value="#txtPosiljatelj"/>
        <parameter name="@Broj" value="#txtBrojDok"/>
        <parameter name="@BrojUfe" value="#txtBrojUfe"/>
        <parameter name="@Rjesenje" value="#txtRjesenje"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@Iznos" value="#curIznos"/>
        <parameter name="@ValuteId" value="#cmbValuta"/>
        <parameter name="@OrgShemaId" value="#cmbOrgShema"/>
        <parameter name="@DatumPrijema" value="#datDatumPrijema"/>
        <parameter name="@DatumValute" value="#datDatumValute"/>
        <parameter name="@DatumDokumenta" value="#datDatumDokumenta"/>
        <parameter name="@baza" value="'CARPO'"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

