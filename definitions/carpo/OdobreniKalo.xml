<root>
	<form name="frmGlavna" type="master" caption="Odabrani kalo">
		<managerlayout>
			<event type="onload">
				<action type="datarun nonquery" value="~dtPuniDrvo"/>
				<action type="control populate" value="#Tree" />
			</event>
		<tree name="tree" dataname="~dtPuniDrvo" autopopulate="true" caption="KLASA ROBE">
			 <event type="focusedrowchanged">
				<action type="control populate" value="#grdMaster"/>
 			</event>
 			<fields>
 				<field name="naziv"/>

 			</fields>
		</tree>
			<grid name="grdMaster" dataname="~dtPuniGrid" type="master">
				<fields inherited="true">
					<field name="kalo" editable="true" />
					<field name="kalov" caption="Kalo VP" editable="true" />
					<field name="kalom" caption="Kalo MP" editable="true" />
				</fields>
				<event type="cellvaluechanged">
					<action type="datarun nonquery" value="~dtAddKalo" />
				</event>
			</grid>
			</managerlayout>

		<datalist>
			<data command="spSklad_OdobreniKalo_Query" name="dtPuniGrid">
				<parameter name="@klmasterrobaid" value="#Tree.@klmasterrobaid" />
			</data>
			<data command="spSklad_OdobreniKalo_klMasterRoba" name="dtPuniDrvo" />
			<data command="spSklad_OdobreniKalo_AddKalo" name="dtAddKalo">
				<parameter name="@sifra" value="#grdMaster.@šifra" />
				<parameter name="@robaid" value="#grdMaster.@robaid" />
				<parameter name="@kalo" value="#grdMaster.@kalo" />
				<parameter name="@kalov" value="#grdMaster.@kalov" />
				<parameter name="@kalom" value="#grdMaster.@kalom" />
			</data>
		</datalist>
	</form>
</root>