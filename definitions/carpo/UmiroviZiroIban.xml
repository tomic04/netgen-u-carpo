<?xml version="1.0" encoding="utf-8"?>
<root version="1.0.0.0" loglevel="4">
	<!-- <action type="message" value="#grdGlava.@ParZiroId"></action> -->
	<form name="frmMaster" type="master" caption="Umirovljenje žiro računa/IBAN-a">
		<event type="init">
		</event>
		<event type="load">
		     <action type="control populate" value="#grdGlava"/>
		</event>
		<event type="shown">		
		</event>
		<managerlayout>
			<tree name="tree" filtermode="smart" key="SlovoId" parentfield="ParentId" searchfield="Slovo">	
                <data command="spPartneriUmiroviZiroIban" name="dtDrvo">
		             <parameter name="@Action" value="drvo"/>
	            </data>	
                <event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava" />
				</event>				
				<fields>
					<field name="Slovo" /> 
				</fields> 
			</tree>
			<grid name="grdGlava" type="master" async="true" savelayout="true"  multiselect="true" key="ParZiroId" autopopulate="true" searchfield="ParZiroId">
				<data command="spPartneriUmiroviZiroIban" >
					<parameter name="@action" value="grid" />
                    <parameter name="@node" value="#tree.@ValueId" />						
				</data>
				<fields inherited = "false">			
					<field name="Partner" caption="Partner" />
					<field name="BankaNaziv" caption="Banka"  />
					<field name="Ziro" caption="Žiro"  />
					<field name="iban" caption="IBAN"  />
					<field name="swift" caption="SWIFT"  />
				</fields>
				<styles>
					<style name="fontcolor" value="#228B22" if="#grdGlava.@Aktivan==1" />
					<style name="fontcolor" value="#CC0000" if="#grdGlava.@Aktivan==0" />
				</styles>				
				<event type="focusedrowchanged">
              				
				</event>

			</grid>
			
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUmirovi" caption="UMIROVI">
					<event type="click"> 
					    <action type="datarun scalar" value="~dtUmirovi" />
						<action type="control populate keepfocus" value="#grdGlava"/>	
					</event>

				</button>
				<button name="btnAktiviraj" caption="AKTIVIRAJ">
					<event type="click"> 
					    <action type="datarun scalar" value="~dtAktiviraj" />
                        <action type="control populate keepfocus" value="#grdGlava"/>	
					</event>
				</button>
				
				<button caption="IZLAZ" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>


			</buttons>
		</panelbuttons>

		<datalist>	

		       <data command="spPartneriUmiroviZiroIban" name="dtAktiviraj">
		             <parameter name="@action" value="aktiviraj"/>
					 <parameter name="@indAktivan" value="1" type="int"/>
                     <parameter name="@niz" value="#grdGlava.selectedids" type="string"/>					 
					 
	           </data>	
			   <data command="spPartneriUmiroviZiroIban" name="dtUmirovi">
		             <parameter name="@action" value="aktiviraj"/>
					 <parameter name="@indAktivan" value="0" type="int"/>
                     <parameter name="@niz" value="#grdGlava.selectedids" type="string"/>						 
	           </data>

		</datalist>

	</form>


</root>