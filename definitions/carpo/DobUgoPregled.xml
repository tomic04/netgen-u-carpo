<!-- ZM: Pregled ugovora s dobavljačima -->

<root>
	<form name="frmGlavna" type="master" caption="Pregled ugovora s dobavljačima">
	
		<event type="init">
			<action type="datarun reader" value="~dtUgovoriPregled" />
			<action type="control populate" value="#grdMaster" />
		</event>
		<managerlayout>
			<grid name="grdMaster" caption="Pregled ugovora s dobavljačima" type="master" dataname="~dtUgovoriPregled">				
				<fields>
					<field name="Sifra" caption="Šifra" />
					<field name="Partner" caption="Partner" />
					<field name="Broj" caption="Broj" />
					<field name="Odgoda" caption="Odgoda" />
					<field name="PorezniBroj" caption="Porezni broj" />
					<field name="Matbroj" caption="Matični broj" />
					<field name="HptBroj" caption="Poštanski broj" />
					<field name="Mjesto" caption="Mjesto" />
					<field name="Adresa" caption="Adresa" />
					<field name="IBAN" caption="IBAN" />
					<field name="Valjanost ugovora" caption="Valjanost ugovora" />
				</fields> 
				<styles>
					<style name="fontcolor" value="red" if="#grdMaster.@Valjanost ugovora=='Istekao'" />
					<style name="fontcolor" value="green" if="#grdMaster.@Valjanost ugovora=='Aktivan'" />
				</styles>
			</grid>

		</managerlayout>
	<datalist>
		<data command="spDobUgovoriPregled" name="dtUgovoriPregled" />
	</datalist>
	</form>
</root>