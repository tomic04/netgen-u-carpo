<root version="1.1">

  <form name="frmVrsteDokumenata" type="master" caption="Vrste dokumenata"  height="500" width="800" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtVrsteDokumenata" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdVrsteDokumenata" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="1" spacing="2,2,2,2">
        <item col="1" row="1" highlight="false">
          <grid name="grdVrsteDokumenata" type="master" autopopulate="true" dataname="dtVrsteDokumenata" key="ZNRVrsteDokumenataId" showautofilterrow="true" bestfitonrefresh="true"  >
            <fields inherited="true">
              <field name="Opis" fixwidth="500" rowautoheight="true"/>
            </fields>
          </grid>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnesi" caption="Unos" type="add" function="UnesiVD">
          <event type="click">
            <action type="form open" value="frmPromjenaVD">
              <parameter name="caption" value="Unos vrste dokumenta" />
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate " value="#grdVrsteDokumenata" >
                <action type="control focus" value="#grdVrsteDokumenata">
                  <parameter value="$Fokus"/>
                </action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmjena" type="edit" function="IzmijeniVD">
          <event type="click">
            <action type="form open" value="frmPromjenaVD">
              <parameter name="ZNRVrsteDokumenataId" value="#grdVrsteDokumenata.@ZNRVrsteDokumenataId" />
              <parameter name="caption" value="Izmjena vrste dokumenta" />
            </action>
            <action type="control populate keepfocus" value="#grdVrsteDokumenata" />
          </event>
        </button>
        <button name="btnBrisi" caption="Brisanje" type="delete" function="ObrisiVD">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označenu vrstu dokumenta?">
              <action type="datarun reader" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdVrsteDokumenata"></action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRVrsteDokumenata" name="dtVrsteDokumenata">
        <parameter name="@Action" value="Master_query"/>
      </data>
      <data command="spZNRVrsteDokumenata" name="dtDelete">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@ZNRVrsteDokumenataId" value="#grdVrsteDokumenata.@ZNRVrsteDokumenataId" />
      </data>
    </datalist>
  </form>

  <!--* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->

  <form name="frmPromjenaVD" caption="$caption" height="250"  width="500" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$ZNRVrsteDokumenataId!=null"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="3" groupbordervisible="false">
        <item caption="Naziv:" row="1" col="1" highlight="false">
          <textedit name="txtNaziv" datavalue="~dtGet.@Naziv"  required="true"/>
        </item>
        <item caption="Oznaka:" row="2" col="1" highlight="false">
          <textedit name="txtOznaka"  datavalue="~dtGet.@Oznaka"  />
        </item>
        <item caption="Opis:" row="3" col="1" highlight="false">
          <memoedit name="memOpis" datavalue="~dtGet.@Opis"  />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$ZNRVrsteDokumenataId!=null"/>
            <action type="datarun reader" value="~dtUnos" else="" >
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@Fokus" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRVrsteDokumenata" name="dtGet">
        <parameter name="@Action" value="Dohvati_izmjena" />
        <parameter name="@ZNRVrsteDokumenataId" value="$ZNRVrsteDokumenataId"/>
      </data>
      <data command="spZNRVrsteDokumenata" name="dtIzmjena">
        <parameter name="@Action" value="Izmjena_spremi" />
        <parameter name="@ZNRVrsteDokumenataId" value="$ZNRVrsteDokumenataId" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@Opis" value="#memOpis" />
      </data>
      <data command="spZNRVrsteDokumenata" name="dtUnos">
        <parameter name="@Action" value="Unos_spremi"/>
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@Opis" value="#memOpis" />
      </data>
    </datalist>
  </form>

</root>