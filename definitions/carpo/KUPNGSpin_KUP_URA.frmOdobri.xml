<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: ODOBRI (NetGen) → frmOdobri (Carpo) -->
<root version="1.2">
  <form name="frmOdobri" caption="Proslijeđivanje na odobrenje" type="dialog" width="640" height="520" fixedsize="false">
    <event type="shown">
      <action type="control populate" value="#grdOperateri"/>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <item col="1" row="1" caption="Likvidatori:" textposition="left">
          <label/>
        </item>
        <item col="1" row="2">
          <grid name="grdOperateri" dataname="~dtOperateri" bestfitonrefresh="true" showautofilterrow="true" multiselect="true" savelayout="true">
            <fields>
              <field name="Naziv" caption="Ime i prezime"/>
              <field name="OperateriId" visible="false"/>
            </fields>
          </grid>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnProslijedi" caption="PROSLIJEDI">
          <event type="click" waittype="progress" waitcaption="Obrada" waittext="Šaljem na odobrenje...">
            <action type="message" value="Odaberite barem jednog operatera." if="#grdOperateri.selectedrowscount==0"/>
            <action type="datarun nonquery" value="~dtOdobri" if="#grdOperateri.selectedrowscount>0"/>
            <action type="form close" if="#grdOperateri.selectedrowscount>0"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtOperateri" type="text" timeout="300"
            command="select operateriid as OperateriId, Naziv from ssoperateri order by naziv"/>

      <data name="dtOdobri" command="spKUPPrometAzurN" timeout="300">
        <parameter name="@action" value="13"/>
        <parameter name="@id" value="$Id"/>
        <parameter name="@str" value="#grdOperateri.selectedids"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

