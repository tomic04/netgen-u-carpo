<root version="1.2">

  <!--1.0 subforme fmrMobileDonos
                   frmNovaInvUnos
                   frmUnosKol
                   frmUnosRas-->
  <!--1.1 MZ - disable/enable panel buttona kod focusedrowchange u master gridu
             - disable/enable panel buttona kod focusedrowchange u master gridu i selectedtabchange u detalj gridu
             - disable/enable menuitema ovisno o statusu inventure-->
  <!--1.2 MZ - na ispis lista dodan odabir kriterija ispisa-->

  <!--***********************************GLAVNA FORMA ZA INVENTURU****************************************-->
  <form name="frmOSInventura" type="master" caption="Inventura imovine" >
    <event type="oninit">
      <!--<action type="datarun reader" value="~dtGet" />-->
      <action type="datarun scalar" value="~dtGetLastInvDate">
        <parameter name="TreeFocus"/>
      </action>
      <action type="datarun reader" value="~dtOSMobilna" />
    </event>
    <event type="onshown">
      <action type="control focus" value="#tree">
        <parameter value="$TreeFocus"/>
      </action>
    </event>
    <managerlayout>
      <!--filter drveta-->
      <lookup name="filter" >
        <comboitem value="Vremenska podjela"/>
      </lookup>

      <!--*****stablo*****-->
      <tree name="tree" key="id" filtermode="smart" expandfirst="true" dataname="dtTree">

        <event type="focusedrowchanged">
          <action type="control populate" value="#grdMaster" />
        </event>
        <fields>
          <field name="Name" />
        </fields>
      </tree>

      <!--Grid Glava-->
      <grid name="grdMaster" type="master" key="OSInventuraGlaId" async="true" dataname="dtMaster" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true">
        <fields inherited="true">
          <field name="DatumInventure" caption="Datum inventure" />
          <field name="DatumPopisa" caption="Datum popisa" />
          <field name="BrojPopisivaca" caption="Broj popisivača" />
        </fields>
        <!--desni klik za brisanje-->
        <menu>
          <menuitem caption="Obriši inventuru" sort="1" function="ObrisiInv" name="menObr">
            <event type="click">
              <action type="confirm" value="Da li ste sigurni da želite obrisati inventuru?" >
                <action type="datarun reader" value="~dtBrisiInv"  />
              </action>
              <action type="control populate" value="#grdMaster" />
            </event>
          </menuitem>
          <menuitem caption="Izmijeni datum inventure" sort="1"  function="IzmijeniDatumInv" name="menIzmj" >
            <event type="click">
              <action type="form open" value="frmIzmjenaDatuma">
                <parameter name="Caption" value="Izmjena datuma inventure"/>
                <parameter name="Tip" value="Izmjena datuma"/>
                <parameter name="OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId"/>
              </action>
              <action type="control populate" value="#grdMaster" />
            </event>
          </menuitem>
          <menuitem caption="Donos inventure" sort="1" function="MobileDonos" name="menDonos">
            <event type="click">
              <action type="form open" value="frmMobileDonos">
                <parameter name="Caption" value="Donos inventure"/>
                <parameter name="Tip" value="Donos"/>
                <parameter name="OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId"/>
              </action>
              <action type="control populate" value="#grdMaster" />
            </event>
          </menuitem>
        </menu>
        <event type="focusedrowchanged">
          <action type="control populate" value="#grdInvImovina"/>
          <action type="control populate" value="#grdNerasporedeno"/>
          <action type="control populate" value="#grdBezZaduzenja"/>
          <action type="menu enable" value="#menDonos" if="~dtOSMobilna.@Postavka==1&amp;&amp;#grdMaster.@Status=='Otvorena'"/>
          <action type="menu disable" value="#menDonos" else="" />
          <action type="menu disable" value="#menObr" if="#grdMaster.@Status=='Zaključena'"/>
          <action type="menu enable" value="#menObr" else="" />
          <action type="menu disable" value="#menIzmj" if="#grdMaster.@Status=='Zaključena'"/>
          <action type="menu enable" value="#menIzmj" else="" />
        </event>
      </grid>
      <!--Grid Detalj-->
      <tabs name="tabs">
        <event type="selectedtabchanged" >
          <action type="control disable" value="#btnUnosInv,#btnIspisi,#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak,#btnPonistiZakljucak"
                  if="#tabs.selectedtab!=Inventura" />
          <action type="control enable" value="#btnUnosInv,#btnIspisi,#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak,#btnPonistiZakljucak" if="#tabs.selectedtab==Inventura&amp;&amp;#grdMaster.@Status=='Otvorena'"/>
          <action type ="control enable" value="#btnUnosInv,#btnIspisi,#btnPonistiZakljucak" if="#tabs.selectedtab==Inventura&amp;&amp;#grdMaster.@Status=='Zaključena'"/>
        </event>
        <!--<event type="selectedtabchanged" >
          <action type="control enable" value="#btnUnosInv,#btnIspisi,#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak,#btnPonistiZakljucak" if="#tabs.selectedtab==Inventura"/>
          <action type="control disable" value="#btnUnosInv,#btnIspisi,#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak,#btnPonistiZakljucak" else="" />
        </event>-->
        <tab caption="Inventura" name="Inventura">
          <grid name="grdInvImovina" dataname="dtInvImovina" fieldsmartspaces="false" multiselect="true" key="OSInventuraDetId" bestfitonrefresh="true">
            <fields inherited="true">
              <field name="InvBroj" caption="Inv.broj" fixed="true" />
              <field name="Naziv" fixed="true"/>
            </fields>
            <menu>
              <menuitem caption="Obriši imovinu s inventure" sort="1" function="ObrisiImovinuInv" name="menObrDet">
                <event type="click">
                  <action type="confirm" value="Da li ste sigurni da želite obrisati imovinu s inventure?" >
                    <!--<action type="message" value="#grdInvImovina.selectedids" />-->
                    <action type="datarun reader" value="~dtBrisiImovinu"  waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..."/>
                  </action>
                  <action type="control populate" value="#grdMaster" />
                </event>
              </menuitem>
            </menu>
            <event type="focusedrowchanged">
              <action type="control disable" value="#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak" if="#grdMaster.@Status=='Zaključena'" />
              <action type="control enable" value="#btnUnosKol,#btnDonos,#btnUnosRas,#btnZakljucak" else="" />
              <action type="menu disable" value="#menObrDet" if="#grdMaster.@Status=='Zaključena'"/>
              <action type="menu enable" value="#menObrDet" else="" />
            </event>
            <styles>
              <style name="fontcolor" value="	#D1001C" if="#grdInvImovina.@formatid==red" />
              <style name="fontcolor" value="#00A877" elseif="#grdInvImovina.@formatid==green" />
              <style name="fontcolor" value="#000000" else="" />
            </styles>
          </grid>
        </tab>
        <tab caption="Neraspoređena imovina" name="Nerasporedeno">
          <grid name="grdNerasporedeno" dataname="dtNerasporedeno" fieldsmartspaces="false" bestfitonrefresh="true">
            <fields inherited="true">
              <field name="InvBroj" caption="Inv.broj" fixed="true" />
              <field name="Naziv" fixed="true"/>
            </fields>
          </grid>
        </tab>
        <tab caption="Imovina bez zaduženja" name="BezZaduzenja">
          <grid name="grdBezZaduzenja" dataname="dtBezZaduzenja" fieldsmartspaces="false" bestfitonrefresh="true">
            <fields inherited="true">
              <field name="InvBroj" caption="Inv.broj" fixed="true" />
              <field name="Naziv" fixed="true"/>
            </fields>
          </grid>
        </tab>
      </tabs>

    </managerlayout>

    <panelbuttons>
      <buttons>
        <button name="btnUnosInv" caption="Unos inventure" function="UnesiInv">
          <event type="click">
            <action type="form open" value="frmNovaInvUnos">
              <parameter name="Caption" value="Unos nove inventure"/>
              <parameter name="Tip" value="Unos novo"/>
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate" value="#tree">
                <action type="control focus" value="#tree">
                  <parameter value="$TreeFocus"/>
                </action>
              </action>
              <action type="control focus" value="#grdMaster">
                <parameter value="$MasterFocus"/>
              </action>
            </action>
          </event>
        </button>
        <button name="btnIspisi" caption="Ispis lista" function="ListeInv">
          <event type="click">
            <action type="form open" value="frmIspisLista">
              <parameter name="Caption" value="Ispis"/>
              <parameter name="Tip" value="Ispis lista"/>
              <parameter name="OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId"/>
            </action>
          </event>
        </button>
        <button name="btnUnosKol" caption="Unos količina" function="UnosKolicinaInv">
          <event type="click">
            <action type="form open" value="frmUnosKol">
              <parameter name="Caption" value="Unos popisanih količina"/>
              <parameter name="Tip" value="Unos količina"/>
              <parameter name="OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId"/>
            </action>
            <action type="control refreshvalue" value="#grdInvImovina" />
          </event>
        </button>
        <button name="btnDonos" caption="Donos knjižnog stanja" function="DonosInv">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite napraviti donos knjižnog stanja?" >
              <action type="datarun reader" value="~dtDonos"  waittype="progress" waitcaption="Pričekajte..." waittext="..donos u tijeku..."/>
            </action>
            <action type="control populate" value="#grdInvImovina" />
          </event>
        </button>
        <button name="btnUnosRas" caption="Unos rashoda" function="UnosRashodaInv">
          <event type="click">
            <action type="form open" value="frmUnosRas">
              <parameter name="Caption" value="Unos rashoda"/>
              <parameter name="Tip" value="Unos rashoda"/>
              <parameter name="OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId"/>
            </action>
            <action type="control populate" value="#grdInvImovina" />
          </event>
        </button>
        <button name="btnZakljucak" caption="Zaključak inventure" function="ZakljucakInv">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite zaključiti inventuru?" >
              <action type="datarun reader" value="~dtZakljucak"  waittype="progress" waitcaption="Pričekajte..." waittext="..zaključak u tijeku..."/>
            </action>
            <action type="control populate" value="#grdMaster" />
          </event>
        </button>
        <button name="btnPonistiZakljucak" caption="Poništavanje zaključka inventure" function="PonistiZakljucakInv">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite poništiti zaključak inventure?" >
              <action type="datarun reader" value="~dtPonistiZakljucak"  waittype="progress" waitcaption="Pričekajte..." waittext="..poništavanje zaključka u tijeku..."/>
            </action>
            <action type="control populate" value="#grdMaster" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="select top 1 left(convert(varchar,datumpopisa,112),6) from osinventuragla order by DatumPopisa desc" type="text" name="dtGetLastInvDate"/>
      <data command="spOSInventura_TreeCP" name="dtTree">
        <parameter name="@Action" value="Vremenska_tree" />
      </data>
      <data command="spOSInventura_HelpCP" name="dtOSMobilna">
        <parameter name="@Action" value="Mobilna" />
      </data>
      <data command="spOSInventura_QueryCP" name="dtMaster" >
        <parameter name="@Action" value="Master_query"  />
        <parameter name="@Godina" value="#tree.@Godina" />
        <parameter name="@Mjesec" value="#tree.@Mjesec" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
      <data command="spOSInventura_QueryCP" name="dtInvImovina" >
        <parameter name="@Action" value="Detalj_inventura"  />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
      </data>
      <data command="spOSInventura_QueryCP" name="dtNerasporedeno" >
        <parameter name="@Action" value="Detalj_nerasporedeno"  />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
      </data>
      <data command="spOSInventura_QueryCP" name="dtBezZaduzenja" >
        <parameter name="@Action" value="Detalj_BezZaduzenja"  />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
      </data>
      <data command="spOSInventura_AzurCP" name="dtBrisiInv">
        <parameter name="@Action" value="Brisanje_InvGla" />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
      </data>
      <data command="spOSInventura_AzurCP" name="dtBrisiImovinu">
        <parameter name="@Action" value="Brisanje_InvDet" />
        <parameter name="@SelectedIds" value="#grdInvImovina.SelectedIds" />
      </data>
      <data command="spOSInventura_AzurCP" name="dtDonos">
        <parameter name="@Action" value="Knjizno_donos" />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
        <parameter name="@OrgShemaId" value="#grdMaster.@OrgShemaId" />
        <parameter name="@SmjestajId" value="#grdMaster.@SmjestajId" />
        <parameter name="@HRKadroviId" value="#grdMaster.@HRKadroviId" />
        <parameter name="@IndIspodOrg" value="#grdMaster.@IndIspodOrgId" />
        <parameter name="@IndIspodSmj" value="#grdMaster.@IndIspodSmjId" />
        <parameter name="@DatumInventure" value="#grdMaster.@DatumInventure" />
        <parameter name="@DatumPopisa" value="#grdMaster.@DatumPopisa" />
      </data>
      <data command="spOSInventura_AzurCP" name="dtZakljucak">
        <parameter name="@Action" value="Inv_Zakljucak" />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
        <parameter name="@OperateriId" value="@@OperateriId" />
        <parameter name="@DatumInventure" value="#grdMaster.@DatumInventure" />
      </data>
      <data command="spOSInventura_AzurCP" name="dtPonistiZakljucak">
        <parameter name="@Action" value="Inv_ponisti_zakljucak" />
        <parameter name="@OSInventuraGlaId" value="#grdMaster.@OSInventuraGlaId" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
    </datalist>
  </form>

  <form name="frmNovaInvUnos" path="frmNovaInvUnos.xml"/>
  <form name="frmUnosKol" path="frmUnosKol.xml"/>
  <form name="frmUnosRas" path="frmUnosRas.xml"/>
  <form name="frmMobileDonos" path="frmMobileDonos.xml"/>
  <form name="frmAnalitika" path="frmMobileDonos.xml"/>
  <form name="frmPrezaduzenje" path="frmMobileDonos.xml"/>

  <!--**********************************KRAJ GLAVNE FORME ZA INVENTURU****************************************-->

  <!--*****************************FORMA ZA IZMJENU DATUMA INVENTURE***********************************-->

  <form name="frmIzmjenaDatuma" caption="$caption"  width="500" fixedsize="true">

    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>

    <layout textposition="left" >
      <group cols="1" rows="1" groupbordervisible="false" >
        <item caption="Datum inventure:" col="1" row="7" colspan="2">
          <dateedit name="datDatumInv" datavalue="~dtGet.@DatumInventure" />
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add"  >
          <event type="click">
            <action type="datarun reader" value="~dtSpremiDatum" />
            <action type="form close" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click"/>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSInventura_HelpCP" name="dtGet">
        <parameter name="@Action" value="Datum_izmjena"/>
        <parameter name="@OSInventuraGlaId" value="$OSInventuraGlaId"/>
      </data>
      <data command="spOSInventura_AzurCP" name="dtSpremiDatum" >
        <parameter name="@Action" value="Izmjena_datum"/>
        <parameter name="@OSInventuraGlaId" value="$OSInventuraGlaId"/>
        <parameter name="@DatumInventure" value="#datDatumInv"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>
  </form>

  <!--**************************KRAJ FORME ZA IZMJENU DATUMA INVENTURE***********************************-->

  <!--*****************************FORMA ZA ISPISE LISTA***********************************-->
  <form name="frmIspisLista" caption="$caption" width="350" fixedsize="false" >

    <layout textposition="left" >
      <group cols="1" rows="2" groupbordervisible="false" >
        <item  col="1" row="1" cols="1" rows="1" textposition="left" >
          <checkedit name="chkKolicine" caption="Ispiši količine"/>
        </item>
        <group cols="3" rows="1" col="1" row="2" caption="Kriterij ispisa" groupbordervisible="true" spacing="2,2,2,2" >
          <item  col="1" row="1"  textposition="right" >
            <checkedit name="chkSmjestaj" caption="Smještaj" />
          </item>
          <item col="2" row="1"  textposition="right" >
            <checkedit name="chkOrgShema"  caption="Org. jedinica" />
          </item>
          <item col="3" row="1"  textposition="right" >
            <checkedit name="chkDjelatnik" caption="Djelatnik" />
          </item>
        </group>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPopisna"  caption="Popisna lista" >
          <event type="click">
            <action type="print" value="repx:rptOSPopisnaListaCP">
              <parameter name="Action" value="Popisna lista" />
              <parameter name="OSInventuraGlaId" value="$OSInventuraGlaId" />
              <parameter name="IndKolicina" value="#chkKolicine" />
              <parameter name="IndSmjestaj" value="#chkSmjestaj" />
              <parameter name="IndOrgShema" value="#chkOrgShema" />
              <parameter name="IndDjelatnik" value="#chkDjelatnik" />
            </action>
          </event>
        </button>

        <button name="btnInventurna"  caption="Inventurna lista" >
          <event type="click">
            <action type="print" value="repx:rptOSInventurnaListaCP">
              <parameter name="Action" value="Inventurna lista" />
              <parameter name="OSInventuraGlaId" value="$OSInventuraGlaId" />
              <parameter name="IndKolicina" value="#chkKolicine" />
              <parameter name="IndSmjestaj" value="#chkSmjestaj" />
              <parameter name="IndOrgShema" value="#chkOrgShema" />
              <parameter name="IndDjelatnik" value="#chkDjelatnik" />
            </action>
          </event>
        </button>

        <button name="btnOdustani"  caption="Odustani" type="cancel" dock="right">
          <event type="click"/>
        </button>

      </buttons>
    </panelbuttons>


    <datalist>

    </datalist>
  </form>
  <!--*****************************KRAJ FORME ZA ISPISE LISTA***********************************-->

</root>
