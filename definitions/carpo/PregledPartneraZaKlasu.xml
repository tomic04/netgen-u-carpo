<root version="1.0.0.1">
	<form name="frmPregledPartneraPoKlasama" type="master" caption="Partneri za klasu" maximized="true" statusbar="true">
		<event type="init"> 
			<action type="datarun reader" value="~dtZaKlasu" />
		</event>
		<event type="load">	
			<action type="control populate" value="#grdStavke"/>
			<action type="variable value">
				<parameter name="BrRedova" value="#grdStavke.rowcount" type="int"/>
			</action>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >

			<group cols="1" rows="2" groupbordervisible="false">

				
				<group caption="Partneri" padding="0" groupbordervisible="true" cols="1" rows="1" col="1" row="2">
					<item row="1" col="1" highlight="False" >
						<grid name="grdStavke" multiselect="true" key="LnId" printcaptionalign="left" printcaption="Pregled partnera za klasu" showgrouppanel="true" showfooter="false" savelayout="true">												
							<data command="dbo.spPartneriPivarstvo">
								</data>
							<fields>	
								<field name="sifra" caption="Šifra" />
								<field name="Partner" caption="Partner" />
								<field name="Drzava" caption="Država" />
								<field name="Mjesto" caption="Mjesto" />
								<field name="Adresa" caption="Adresa" />
								<field name="HPTBroj" caption="HPTBroj" />
								<field name="Maticnibroj" caption="Matični broj" />
								<field name="OIB" caption="OIB" />
								
							</fields>
							
							<event type="focusedrowchanged" >
							     <action type="control value" value="#lblNivo">
								   <parameter value="Broj stavki u gridu: {#grdStavke.rowcount}.">
								   </parameter>
								 </action>
							</event>

						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<actionpanel>
			<items>
				<item>
					<labeledit name="lblNivo" width="250" fontbold="true"/> 
				</item>	
			</items>
		</actionpanel>
		<datalist>

			<data command="dbo.spPartneriPivarstvo" name="dtZaKlasu">
			</data>	

		</datalist>
	</form>
</root>