<?xml version="1.0" encoding="utf-8"?>
<!-- RUCNI_FORM_UNOS - Ručni unos (početna Carpo verzija) -->
<root version="1.2">
  <form name="frmRucniUnos" type="custom" caption="Ručni unos" width="800" height="600">
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1">
          <label name="lblInfo" caption="Forma za ručni unos - u izradi."/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="Zatvori">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
  </form>
</root>
