<root>
	<form name="frmMain" type="master" caption="Parametri kontrole">
		<managerlayout>
			<grid name="grdMaster" type="master" dataname="~dtMaster" key="KKvalParametriId">
				<fields inherited="true">
					<field name="KKvalParametriId" caption="ID" visible="true"/>
					<field name="Tip" visible="false"/>
					<field name="JMNaziv" caption="JM"/>
					<field name="TipNaziv" caption="Tip"/>
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodajIzmijeni"/>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmDodajIzmijeni">
							<parameter name="KKvalParametriId" value="#grdMaster.@KKvalParametriId"/>
						</action>
					</event>
				</button>
				<button name="btnObriši" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Želite li obrisati postojeći zapis?">
							<action type="datarun nonquery" value="~dtObriši"/>
							<action type="control populate" value="#grdMaster"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spKKvalParametriQuery">
				<parameter name="@action" value="0"/>
			</data>
			<data name="dtObriši" command="spKKvalParametriAzur">
				<parameter name="@action" value="2"/>
				<parameter name="@KKvalParametriId" value="#grdMaster.@KKvalParametriId"/>
			</data>
		</datalist>
	</form>
	<form name="frmDodajIzmijeni" caption="Parametar">
		<event type="init">
			<action type="datarun reader" value="~dtPopuni" if="$KKvalParametriId!=null"/>
		</event>
		<event type="onload">
            <action type="control value" value="rdoTekstualni" if="~dtPopuni.Tip==0">
                <parameter value="true"/>
            </action>
            <action type="control value" value="rdoBrojcani" if="~dtPopuni.Tip==1">
                <parameter value="true"/>
            </action>
            <action type="control value" value="rdoDaNe" if="~dtPopuni.Tip==2">
                <parameter value="true"/>
            </action>
        </event>
		<layout>
			<group rows="5" cols="1">
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtPopuni.@Naziv"/>
				</item>
				<item row="2" col="1" caption="Opis:">
					<textedit name="txtOpis" datavalue="~dtPopuni.@Opis"/>
				</item>
				<item row="3" col="1" caption="JM:">
					<comboedit name="cmbJM" displayfield="Naziv" valuefield="JmId" dataname="~dtJM" datavalue="~dtPopuni.@JMId"/>
				</item>
				<group caption="Tip parametra:" groupbordervisible="true" row="4" col="1" rows="1" cols="3">
					<item row="1" col="1">
						<radioedit name="rdoTekstualni" caption="tekstualni">
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item>
					<item row="1" col="2">
						<radioedit name="rdoBrojcani" caption="brojčani">
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item>
					<item row="1" col="3">
						<radioedit name="rdoDaNe" caption="da/ne">
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item> 
                </group>
				<item row="5" col="1" caption="Org.shema:">
					<comboedit name="cmbOrgShema" displayfield="Naziv" valuefield="OrgShemaId" dataname="~dtOrgShema" datavalue="~dtPopuni.@OrgShemaId"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action if="$KKvalParametriId==null">
							<action type="datarun nonquery" value="~dtDodaj">
								<parameter name="FocusId"/>
							</action>
							<action type="control populate" value="parent.#grdMaster">
								<action type="control focus" value="parent.#grdMaster">
									<parameter value="$FocusId" type="int"/>
								</action>
							</action>
							<action type="control value" value="##">
								<parameter value=""/>
							</action>
							<action type="control value" value="#rdoTekstualni">
								<parameter value="true"/>
							</action>
						</action>
						<action else="$KKvalParametriId!=null">
							<action type="datarun nonquery" value="~dtIzmjeni"/>
							<action type="control populate keepfocus" value="parent.#grdMaster"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDodaj" command="spKKvalParametriAzur">
				<parameter name="@action" value="0"/>
				<parameter name="@Naziv" value="#txtNaziv" />
                <parameter name="@Opis" value="#txtOpis" />
                <parameter name="@Tip" value="0" if="#rdoTekstualni==true" />
                <parameter name="@Tip" value="1" if="#rdoBrojcani==true" />
                <parameter name="@Tip" value="2" if="#rdoDaNe==true" />
                <parameter name="@JMId" value="#cmbJM" />
                <parameter name="@OrgShemaId" value="#cmbOrgShema" />
			</data>
			<data name="dtIzmjeni" command="spKKvalParametriAzur">
				<parameter name="@action" value="1"/>
				<parameter name="@Naziv" value="#txtNaziv" />
                <parameter name="@Opis" value="#txtOpis" />
                <parameter name="@Tip" value="0" if="#rdoTekstualni==true" />
                <parameter name="@Tip" value="1" if="#rdoBrojcani==true" />
                <parameter name="@Tip" value="2" if="#rdoDaNe==true" />
                <parameter name="@JMId" value="#cmbJM" />
                <parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@KKvalParametriId" value="$KKvalParametriId"/>
			</data>
			<data name="dtPopuni" command="spKKvalParametriQuery">
				<parameter name="@action" value="1"/>
				<parameter name="@KKvalParametriId" value="$KKvalParametriId"/>
			</data>
			<data name="dtJM" command="spJMQuery">
				<parameter name="@action" value="0"/>
				<parameter name="@id" value="null"/>
			</data>
			<data name="dtOrgShema" command="spOrgShemaQuery">
				<parameter name="@action" value="0"/>
				<parameter name="@id" value="null"/>
				<parameter name="@Naziv" value="null"/>
			</data>
		</datalist>
	</form>
</root>
