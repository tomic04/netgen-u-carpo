<root>
	<form name="frmMaster" type="master" caption="Valute">
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="ValuteId" savelayout="true" statusbar="true" bestfitonrefresh="true" multiselect="true">
				<event type="doubleclick">
					<action type="form open" value="frmValuteInsertEdit" if="#grdMaster.rowcount&gt;0">
						<parameter name="ValuteId" value="#grdMaster.@ValuteId" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>
				<fields inherited="false">
					<field caption="Naziv" name="Naziv" />
					<field caption="Oznaka" name="Oznaka" />
					<field caption="Šifra" name="Sifra" />
					<field caption="Mjera" name="Mjera" />
					<field caption="Tečajna lista" name="TecListaInd" />
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<menuitem control="#grdMaster" sort="1" />
					<event type="click">
						<action type="form open" value="frmValuteInsertEdit">
							<parameter name="ValuteId" value="null" />
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit">
					<menuitem control="#grdMaster" sort="2" />
					<event type="click">
						<action type="form open" value="frmValuteInsertEdit" if="#grdMaster.rowcount&gt;0">
							<parameter name="ValuteId" value="#grdMaster.@ValuteId" />
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati označenu valutu?">
							<action type="datarun nonquery" value="global.~dtDelete" />
							<action type="control populate" value="#grdMaster" />
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
	<form name="frmValuteInsertEdit" caption="Odjeli">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="shown">
			<action if="$ValuteId!=null">
				<action type="form caption" value="Izmjena odabrane valute" />
			</action>
			<action else="">
				<action type="form caption" value="Unos nove value" />
			</action>
		</event>
		<layout>
			<group rows="5" cols="1">
				<item row="1" col="1" caption="Naziv:" highlight="false">
					<textedit name="txtNazivValute" datavalue="~dtGet.@Naziv" required="true" />
				</item>
				<item row="2" col="1" caption="Oznaka:" highlight="false">
					<textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" required="true" />
				</item>
				<item row="3" col="1" caption="Šifra:" highlight="false">
					<textedit name="txtSifra" datavalue="~dtGet.@Sifra" required="true" />
				</item>
				<item row="4" col="1" caption="Mjera:" highlight="false">
					<textedit name="txtMjera" datavalue="~dtGet.@Mjera" required="true" value="100"/>
				</item>
				<item row="5" col="1" highlight="false">
					<checkedit name="txtTecajnaLista" caption="Prikaži u tečajnoj listi" datavalue="~dtGet.@TecListaInd" required="false" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtDataEdit" if="$ValuteId!=null">
							<parameter name="parent.$ValuteId" />
							<action type="control populate keepfocus" value="parent.#grdMaster" />
						</action>
						<action type="datarun scalar" value="~dtDataInsert" else="">
							<parameter name="parent.$ValuteId" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="parent.$ValuteId" type="int" />
							</action>
						</action>
						<action type="control refreshvalue" value="##" />
						<action type="form close" if="$ValuteId!=null" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCValuteQuery" name="dtGet">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$ValuteId" />
			</data>
			<data command="spCValuteAzur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Naziv" value="#txtNazivValute" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@Sifra" value="#txtSifra" />
				<parameter name="@Mjera" value="#txtMjera" />
				<parameter name="@TecListaInd" value="#txtTecajnaLista" />
			</data>
			<data command="spCValuteAzur" name="dtDataEdit">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$ValuteId" />
				<parameter name="@Naziv" value="#txtNazivValute" />
				<parameter name="@Sifra" value="#txtSifra" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@Mjera" value="#txtMjera" />
				<parameter name="@TecListaInd" value="#txtTecajnaLista" />
			</data>
		</datalist>
	</form>
	<datalist>
		<data command="spCValuteQuery" name="dtMaster">
			<parameter name="@action" value="0" />
		</data>
		<data command="spCValuteAzur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@ID" value="#grdMaster.@ValuteId" />
		</data>
	</datalist>
</root>
