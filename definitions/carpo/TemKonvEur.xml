<?xml version="1.0" encoding="utf-8"?>
<!-- 28.11.2022. v.1.0.1 SV kreirao -->
<root loglevel="5" version="1.0.1.">
	<form name="frmMaster" caption="Konverzija EUR" height="300" width="800">
		<event type="onload">
			<action type="control populate" value="#grdGlavni"/>
			<action type="control populate" value="#grdGlavni2"/>
		
		</event>
		<!-- <event type="show"> -->
			<!-- <action type="control focus" Value="#btnOdustani"/>  -->
		<!-- </event> -->
		
		<layout textposition="left" itemspadding="2"> 
			<group cols="1" rows="2">
				<columnsdefinition>
					<!-- <column size="50%" position="1" />  -->
					<!-- <column size="50%" position="2" />  -->
				</columnsdefinition>
				 <rowsdefinition>
					<row size="50%" position="1"/>
					<row size="30%" position="2"/>
				</rowsdefinition>
				  <!-- <item col="1" row="1" caption="Temeljnica Konverzije" />   -->
				  <!-- <item col="2" row="1" caption="Konvertiranje Virmana" />				  -->
					 
					<item col="1" row="1"  >
					<grid name="grdGlavni"   dataname="~dtMGrid"  showgrouppanel="false" showautofilterrow="false"    showfooter="false" bestfitonrefresh="true" readonly="true"   enabled="false" savelayout="false">
							 
					</grid>
					</item>
				
					<item col="1" row="2" >
					<grid name="grdGlavni2"  dataname="~dtMGrid2" showgrouppanel="false"  showautofilterrow="false"    showfooter="false" bestfitonrefresh="true" readonly="true" enabled="false" showgrupedcolumns="true" savelayout="false">
 
					</grid>
					</item>
				<!-- </group> -->
			</group>
		</layout>
		
		<panelbuttons>
			<buttons>
				 <button name="btnOdustani" caption="Odustani" dock="left">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
				<button name="btnSpremi1" caption="Temeljnica konverzije">
					<event type="click" >
						<action type="confirm" value="Knjižite temeljnicu Konverzije?" >
						 
							<action type="datarun reader" value="~dtTemKonverzije" waittype="progress" waitcaption="Obrada" waittext="Knjižite temeljnicu Konverzije..."  > 
								<!-- <action type="message" value="~dtTemKonverzije.@poruka" /> -->
							</action>
						</action>
					</event>
				</button>
				<button name="btnSpremi2" caption="Konverzija Virmana">
					<event type="click" >
						<action type="confirm" value="Jeste li sigurni da Konvertirate Virmane?">
							<action type="datarun reader" value="~dtKonvVirmane"  waittype="progress" waitcaption="Obrada" waittext="Konvertiranje Virmana...">
								<!-- <action type="message" value="~dtKonvVirmane.@poruka" /> -->
							</action>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="KonverzijaKontor" name="dtTemKonverzije" timeout="1000">
				
			</data>
			<data command="KonverzijaVirmani" name="dtKonvVirmane" timeout="1000">
				
			</data>
			<data command="spCKntKonverzijaQuery" name="dtMGrid" timeout="200">
				<parameter name="@Action" value="1"/> 
			</data> 
			<data command="spCKntKonverzijaQuery" name="dtMGrid2" timeout="200">
				<parameter name="@Action" value="2"/> 
			</data> 
					
		</datalist>
	</form>
</root>
