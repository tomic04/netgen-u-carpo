<root>

	<form name="frmGlavna" type="master">
		<managerlayout>
			<grid type="master" name="grdGlava" inherited="true" dataname="~dtGetGlava">
				<fields>

				</fields>
			</grid>
		</managerlayout>

			<panelbuttons>
					<buttons>
						<button name="btnUnesi" caption="Unesi">
							<event type="click">
								<action type="form open" value="frmUnos">
								</action>
							</event>
						</button>

						<button name="btnIzmjeni" caption="Izmijeni">
							<event type="click">
								<action type="form open" value="frmIzmjena">
									<parameter name="MobTerKom_RazlogPovrataId" value="#grdGlava.@MobTerKom_RazlogPovrataId" />
									<parameter name="opis" value="#grdGlava.@opis" />
									<parameter name="aktivno" value="#grdGlava.@aktivno" />
								</action>
							</event>
						</button>

						<button name="btnObrisi" caption="Obriši">
							<event type="click">
								<action type="confirm" value="Brisanje stavke {#grdGlava.@opis}. Nastaviti? ">
								<action type="datarun nonquery" value="~dtDelete" />
								</action>
								<action type="control populate" value="#grdGlava" />

							</event>
						</button>
					</buttons>
			</panelbuttons>

		<datalist>
			<data command="spMobTerkom_RazlogPovrata_Query" name="dtGetGlava">
				<parameter name="@action" value="0" />
			</data>
			<data command="spMobTerkom_RazlogPovrata_Delete" name="dtdelete">
				<parameter name="MobTerKom_RazlogPovrataId" value="#grdGlava.@MobTerKom_RazlogPovrataId" />
			</data>
		</datalist>
			
	</form>

	<form name="frmUnos" caption="Unos" width="50">
		<layout textposition="left" itemspadding="3">
	        <group cols="1" rows="2">
				<item caption="Opis:" col="1" row="1">
					<textedit name="txtOpis" value=""/>
				</item>
				<item caption="Aktivno:" col="1" row="2">
					<checkedit name="chkAktivno" value="0"/>
				</item>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremiUnos" caption="Spremi">
						<event type="click">
							<action type="datarun nonquery" value="~dtSpremi" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" value="frmUnos"/>
						</event>
					</button>
					<button name="btnSpremiOdustani" caption="Odustani" type="cancel">
					</button>
				</buttons>
			</panelbuttons>

		<datalist>	
			<data command="spMobTerkom_RazlogPovrata_Unos" name="dtSpremi">
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>
			
		</datalist>
	</form>	

	<form name="frmIzmjena" caption="Izmjena" width="50">
		<event type="init">
			<action type="datarun reader" value="dtGet" />
		</event>

		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="2">
				<item caption="Opis:" col="1" row="1">
					<textedit name="txtOpis" datavalue="~dtGet.@opis" />
				</item>
				<item caption="Aktivno:" col="1" row="2">
					<checkedit name="chkAktivno" datavalue="~dtGet.@aktivno"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnIzmjeni" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtIzmjeni" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnIzmjeniOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spMobTerkom_RazlogPovrata_Query" name="dtGet">
				<parameter name="@action" value="1" />
				<parameter name="@MobTerKom_RazlogPovrataId" value="$MobTerKom_RazlogPovrataId" />
			</data>
			<data command="spMobTerkom_RazlogPovrata_Edit" name="dtIzmjeni">
				<parameter name="@MobTerKom_RazlogPovrataId" value="$MobTerKom_RazlogPovrataId" />
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>
		</datalist>
	</form>
</root>