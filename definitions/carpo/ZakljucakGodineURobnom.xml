<root>
	<form type="master" caption="Robno - zaključak godine" width="300" height="300" saveformsize="false">
		<event type="shown">
			<action type="control caption" value="#btnUredu">
				<parameter value="POKRENI ZAKLJUČAK"/>	
			</action>
			<action type="variable value" >
				<parameter name="Ind" value="0"/>
			</action>
			<action type="control disable" value="#btnUredu2"/>
		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column size="200" position="1"/>
				</columnsdefinition>
				<item col="1" row="1" caption="Odgovorna osoba:" width="200">
					<comboedit name="cmbOdgOsoba" dataname="~dtOdgOsoba" displayfield="Naziv" valuefield="OsobeId" allownull="false"/>
				</item>
				<item col="1" row="2"/>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUredu" caption="POKRENI ZAKLJUČAK" >
					<event type="click" if="$Ind==0"> 
						<action type="confirm" value="Jeste li sigurni da želite pokrenuti zaključak godine?"/>
						<action type="variable value">
							<parameter name="Ind" value="1"/>
						</action>
						<action type="control disable" value="#btnUredu"/>
						<action type="control enable" value="#btnUredu2"/>
					</event>
				</button>
				<button name="btnUredu2" caption="ZAKLJUČI" >
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite zaključiti godinu?" />					
						<action type="datarun nonquery" value="~dtZakljuci"  waittype="progress" waitcaption="Obrada" waittext="zaključak u tijeku..."/>
						<action type="message" value="Zaključak uspješno završen!"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtOdgOsoba" command="spOsobeQueryCarpo">
				<parameter name="@Action" value="16"/>
			</data>
			<data name="dtZakljuci" command="spSktZakljuciGodinu">
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@OsobeId" value="#cmbOdgOsoba"/>
			</data>
		</datalist>	
	</form>
</root>