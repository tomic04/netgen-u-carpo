<?xml version="1.0" encoding="utf-8"?>
<!-- DODAJ_FORM - Unos stavke u Knjigu URA (početna Carpo verzija, treba dopuniti) -->
<root version="1.2">
  <form name="frmUnos" type="custom" caption="Unesi" width="800" height="600">
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1">
          <label name="lblInfo" caption="Forma za unos - u izradi. Kompletna konverzija DODAJ_FORM zahtijeva punu mapiranje kontrola (partner, PDV stope, devizni podaci, itd.)"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="Zatvori">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
  </form>
</root>
