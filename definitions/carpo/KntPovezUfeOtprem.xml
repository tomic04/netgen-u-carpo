			<!-- <buttons> -->
				<!-- <button name="btnOdustani" caption="OK" dock="right" type="cancel"> -->
				<!-- </button> -->
			<!-- </buttons> -->
		<!-- </panelbuttons> -->
	<!-- </form> -->
	
	<datalist>

		<data command="spCKntUfaOtpremaQuery" name="dtNazivFirme"> 
			<parameter name="@Action" value="14"/>  
		</data>	
		<data command="spCKntUfaOtpremaQuery" name="dtNazivPartnera"> 
			<parameter name="@Action" value="15"/>  
			<parameter name="@IDPar" value="Global.$PartneriId"/>  
		</data>	
	</datalist>
	
<form name="frmPovezi" path="frmPovezi.xml"></form> 

<!-- kod poziva forme iiz druge forme, obavezno staviti poziv i na početnu formu -->
<form name="frmPoveziOtpremnice" path="frmPoveziOtpremnice.xml"></form> 

<form name="frmPrikazExcel" path="frmPrikazExcel.xml"></form> 

