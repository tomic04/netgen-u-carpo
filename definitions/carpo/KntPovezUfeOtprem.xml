<root version="1.0.0.3">
	

	<form name="master" type="master" caption="Povezivanje UFA i Skl.Dokumenata">
	<method name="funExcelImport" dll="ExcelImportV2" class="ExcelImport.Start" method="FromModule" />
		<!--pozivanje parametar forme pri inicijalizaciji glavne forme-->
		<event type="init">	
				
				<action type="datarun scalar" value="Global.~dtNazivFirme">
					<parameter name="NazivFirme"/>
				</action>
			<action type="variable value">
				<parameter name="Global.$DatumOd" value="null"  />
				<parameter name="Global.$DatumDo" value="null"  />
				<!-- <parameter name="Global.$Datum" value="1"  /> -->
				<!-- <parameter name="Global.$VrstaDatuma" value="null"  /> -->
				<parameter name="Global.$Broj" value="null"  />
				<parameter name="Global.$PartneriId" value="null"  />
				<parameter name="Global.$PartneriNaziv" value="null" />
				<parameter name="global.$Close" value="false" type="bool"/>	
			</action>
		</event> 
		<event type="load">
			 <action type="form open" value="frmFilter"/>
			 <action type="variable value" value="global.$Close" if="dialogresult==cancel"> 
				 <parameter value="true" type="bool"/> 
			 </action> 
		</event>
		<event type="shown">
			 <action type="form close" if="global.$Close==true"/> 
		</event>
		<managerlayout>

<grid name="grdGrid" async="true" type="master" autopopulate="false" key="FaktureDobId" bestfitonrefresh="True"  multiselect="true" dataname="dtMaster" savelayout="true" > <!--printcaption="Pregled prometa za period od {Global.$DatumOd::dd.MM.yyyy.} do {Global.$DatumDo::dd.MM.yyyy}"-->


					<event type="focusedrowchanged">
							<action type="variable value" >
								<parameter name="Global.$FaktureDobId" value="#grdGrid.@FaktureDobId" type="int" if="#grdGrid.rowcount!=0"/>
	
							</action>	
							
					
					
							<action if="global.$FaktureDobId==null" type="control disable" value="#btnpovezi"  />
							<action if="global.$FaktureDobId!=null" type="control enable" value="#btnpovezi"  />

						
					</event>
					
					
					

				<print caption="Povezivanje UFE i Skl.Dokumenata" header="{$NazivFirme}\nPovezivanje UFE i skl.dokumenata za period od {Global.$DatumOd::dd.MM.yyyy.} do {Global.$DatumDo::dd.MM.yyyy}\nVrsta Datuma: {Global.$VrstaDatuma}\n"
					subheader="Broj dokumenta: {Global.$Broj}	Partner: {Global.$PartneriNaziv} Način plaćanja: {Global.$NacPlacNaziv} Dio konta: {Global.$DioKonta} Konto: {Global.$KontoOznaka} Vrsta prometa: {Global.$VrstaPromNaziv}
						Vrsta dok: {Global.$VrstaDokNaziv} Org shema: {Global.$OrgShemaNaziv} Vrste dimenzije: {Global.$DimVrsteNaziv} Dimenzije: {Global.$DimenzijeNaziv} Operater: {Global.$OperaterNaziv} Iznos: {Global.$Iznos}\n"
				     captionalign="center">
				</print>
</grid>
		</managerlayout>
		
		<panelbuttons displaycontrolsprint="true"> 
			<buttons> 
				<button name="btnParametri" caption="Parametri" >
					<event type="click">
						<action type="form open" value="frmFilter"/>
					</event>
				</button>
				
				<button name="btnPovezi" caption="Poveži">			
					<event type="click">
						<!-- <action type ="variable value" > -->
							<!-- <parameter name="FaktureDobId" value="null"/> -->
						<!-- </action> -->
					
						<action type ="Form open" value="frmPovezi"></action>
		
						<!-- popuni varijablu i fokusiraj se na spremljeni podatak, paziti na varijablu u parent formi tj odakle se poziva -->
						<action type="control populate" value="#grdGrid"> 
							<action type="control focus" value="#grdGrid">
								<parameter value="global.$Fakturedobid" ></parameter>
							</action> 
						</action>
						
					</event>
				</button>
				
				<button name="btnExcelImport" caption="Excel import">
					<event type="click">
								
						<action type="method run" value="funExcelImport">
							<parameter name="connection" value="@@connection" />
							<parameter name="operaterId" value="@@operaterid" />
						</action>
						
						<action type ="Form open" value="frmPrikazExcel"></action>
					</event>
				</button>

			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntUfaOtpremaQuery" name="dtMaster" timeout="400">

				<parameter name="@Action" value="1" /> 
				<parameter name="@DatumOd" value="Global.$DatumOd" /> 
				<parameter name="@DatumDo" value="Global.$DatumDo" />  
				<parameter name="@IDPAR" value="Global.$PartneriId"/> 
				<parameter name="@BrojDok" value="Global.$Broj"/> 

			</data>
		</datalist>
	</form>

	<form caption="Povezivanje UFE i skl.dokumenata" name="frmFilter" width="1400" height="350" > <!-- fixedsize="true"-->
		<event type="load">
			<action type="datarun scalar" value="Global.~dtNazivPartnera">	
				<parameter name="NazivPar" />
			</action>
<!--			<action type="message" value="{Global.$PartneriNaziv}"/>
			<action type="message" value="{$NazivPar}"/>-->
		</event>
		<event type="shown">
			<action type="variable value">
				<parameter name="Global.$PartneriNaziv" value="$NazivPar"   />
			</action>
			<action type="datarun scalar" value="~dtPrviDanMjeseca">
				<parameter name="StartOfYear" />				
			</action>	
			<action type="control value" value="#datDatumOd"> 
				<parameter value="$StartOfYear"	if="Global.$DatumOd==null" />
				<parameter value="Global.$DatumOd"	elseif="Global.$DatumOd!=null"/>
			</action> 		
			<action type="control value" value="#datDatumDo"> 
				<parameter value="now" if="Global.$DatumDo==null" />
				<parameter value="Global.$DatumDo" elseif="Global.$DatumDo!=null"/>
			</action> 	

			<action type="control value" value="#txtBrojDok">
				<parameter value="Global.$Broj" />
			</action>
			<action type="control value" value="#srcPartner">
				<parameter value="Global.$PartneriId" text="Global.$PartneriNaziv"/>
			</action>

		</event> 
			

		<layout textposition="top">
			<group rows="4" cols="1">
				<group rows="1" cols="2" col="1" row="1" colspan="2">
						<item col="1" row="1" caption="Datum od:" fontsizedelta="2"> 
							<dateedit name="datDatumOd" required="true">
								<!-- <event type="valuechanged"> -->
								<!-- <action type="variable value"> -->
								<!-- <parameter name="DatumOd" value="#datDatumOd" /> -->
								<!-- </action> -->
								<!-- </event> -->
							</dateedit>
						</item>
						<item col="2" row="1" caption="Datum do:" fontsizedelta="2">
							<dateedit name="datDatumDo" value="now" required="true">

							</dateedit>
						</item>
				</group>
				
					<item col="1" row="3"  caption="UFA ili Račun:" fontsizedelta="2" >
						<textedit name="txtBrojDok" >
						</textedit>
					</item>
					

					<item col="1" row="4" caption="Partner:" fontsizedelta="2" textvisible="false">
						<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" datavalue="Global.~dtNazivPartnera.@partneriid" datatext="Global.~dtNazivPartnera.@naziv" tabindex="0" >
							<event type="valuechanged">
								<action type="variable value">
									<parameter name="PartneriId" value="#srcPartner" />
								</action>
							</event>
						</searchedit>
					</item>
				
				
			</group>			
		</layout> 
		<datalist>
			<data type="text" name="dtPrviDanMjeseca" command="SELECT DATEADD(m, DATEDIFF(m, 0, GETDATE()), 0) as StartOfYear"/>
		</datalist>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Pokaži">
					<event type="click">
						<action type="variable value">
							<parameter name="Global.$DatumOd" value="#datDatumOd"  />
							<parameter name="Global.$DatumDo" value="#datDatumDo"  />
							<parameter name="Global.$Datum" value="#cmbDatum"  />
							<parameter name="Global.$Broj" value="#txtBrojDok"  />
							<parameter name="Global.$PartneriId" value="#srcPartner"  />

							<parameter name="Global.$PartneriNaziv" value="#srcPartner.@Naziv"/>

						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdGrid" />


					</event>
				</button>
				<button caption="Odustani" type="cancel" name="btnOdustani">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>	


	</form>
	
	<!-- <form name="frmInfoDisabled"  caption="Info" > -->

		<!-- <layout textposition="top" > -->
			<!-- <group cols="1" rows="1" > -->
				<!-- <group cols="1" rows="1" groupbordervisible="false"> -->
					<!-- <item col="1" row="1" caption="Ova funkcionalnost trenutno nije dostupna, molim kontaktirajte Spin!"> -->
					<!-- </item>					 -->
				<!-- </group> -->
			<!-- </group> -->
		<!-- </layout> -->
