<root>

<!-- Baza: PPTele2 -->

	<form type="master" name="frmGlavna" caption="Mjerna mjesta">

		<managerlayout>

			<grid type="master" name="grdMaster" dataname="~dtNapuniGrid" filter="true">
				<fields>
					<field name="brojmjernogmjesta" caption="Broj mjernog mjesta" />
					<field name="adresa" caption="Adresa mjernog mjesta" />
					<field name="Grad" caption="Grad" />
					<field name="brojbrojila" caption="Broj brojila" />
					<field name="NazivDimenzije" caption="Dimenzije" />
				</fields>
			</grid>

		</managerlayout>

	<panelbuttons>
		<buttons>
			<button name="btnUnesi" caption="UNESI">
				<event type="click">
					<action type="form open" value="frmUnos">
						<parameter name="id" value="#grdMaster.@id" />
					</action>
				</event>
			</button>

			<button name="btnIzmjeni" caption="IZMJENI">
				<event type="click">
					<action type="form open" value="frmIzmjena">
						<parameter name="id" value="#grdMaster.@id" />
						<parameter name="brojMjernogMjesta" value="#grdMaster.@brojmjernogmjesta" />
						<parameter name="adresa" value="#grdMaster.@adresa" />
						<parameter name="mjestaid" value="#grdMaster.@mjestaid" />
						<parameter name="BrojBrojila" value="#grdMaster.@brojBrojila" />
						<parameter name="NazivDimenzije" value="#grdMaster.@NazivDimenzije" />
					</action>
				</event>
			</button>

			<button name="btnObrisi" caption="OBRIŠI">
				<event type="click">
					<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />
					<action type="datarun nonquery" value="~dtDelete" />
					<action type="control populate" value="#grdMaster" />
				</event>
			</button>
		</buttons>
	</panelbuttons>
	


		<datalist>
			<data command="spNajamUgovoriMjernaMjesta_query" name="dtNapuniGrid">
				<parameter name="@action" value="0" />
			</data>
			<data command="spNajamUgovoriMjernaMjesta_delete" name="dtDelete">
				<parameter name="id" value="#grdMaster.@id" />
			</data>
		</datalist>
	</form>

	<form name="frmUnos" caption="Unesi">
		<layout>
			<group cols="1" rows="5">
				<item col="1" row="1" caption="Broj mjernog mjesta:">
					<textedit name="txtBroj" value="" />
 				</item>

 				<item col="1" row="2" caption="Adresa mjernog mjesta:">
 					<textedit name="txtAdresa" value="" />
 				</item>

 				<item col="1" row="3" caption="Grad:">
 					<comboedit name="cmbGrad" valuefield="mjestaid" dataname="~dtNapuniMjesta" displayfield="Nazivi"/>
 				</item>

 				<item col="1" row="4" caption="Broj brojila:">
 					<textedit name="txtBrojilo" value="" />
 				</item>

 				<item col="1" row="5" caption="SiteID:">
 					<comboedit name="cmbSiteID" valuefield="dimenzijeid" dataname="~dtNapuniDimenzije" displayfield="Naziv"/>
 				</item>
			</group>
		</layout>


			<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="Unesi">
						<event type="click">
							<action type="datarun scalar" value="~dtInsert" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" value="frmUnos" />
						</event>
					</button>

					<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
					</button>
				</buttons>
			</panelbuttons>



		<datalist>
			<data command="spNajamUgovoriMjernaMjesta_Mjesta_Query" name="dtNapuniMjesta" />
			<data command="spNajamUgovoriMjernaMjesta_Dimenzije_Query" name="dtNapuniDimenzije">
				<parameter name="@dimVrsteID" value="4" />
			</data>
			<data command="spNajamUgovoriMjernaMjesta_Insert" name="dtInsert">
				<parameter name="@brojMjernogMjesta" value="#txtBroj" />
				<parameter name="@adresaMjernogMjesta" value="#txtAdresa" />
				<parameter name="@grad" value="#cmbGrad" />
				<parameter name="@brojBrojila" value="#txtBrojilo" />
				<parameter name="@siteId" value="#cmbSiteID" />
			</data>
		</datalist>

	</form>


	<form name="frmIzmjena" caption="Izmjeni">

		<event type="init">
				<action type="datarun reader" value="dtGet" />
		</event>


		<layout>
			<group cols="1" rows="5">
				<item col="1" row="1" caption="Broj mjernog mjesta:">
					<textedit name="txtBroj" datavalue="~dtGet.@brojmjernogmjesta" />
 				</item>

 				<item col="1" row="2" caption="Adresa mjernog mjesta:">
 					<textedit name="txtAdresa" datavalue="~dtGet.@adresa" />
 				</item>

 				<item col="1" row="3" caption="Grad:">
 					<comboedit name="cmbGrad" dataname="~dtNapuniMjesta" valuefield="mjestaid" displayfield="Nazivi" datavalue="~dtGet.@mjestaid"/>
 				</item>

 				<item col="1" row="4" caption="Broj brojila:">
 					<textedit name="txtBrojilo" datavalue="~dtGet.@brojbrojila" />
 				</item>

 				<item col="1" row="5" caption="SiteID:">
 					<comboedit name="cmbSiteID" dataname="~dtNapuniDimenzije" valuefield="dimenzijeid" datavalue="~dtGet.@dimenzijeid" displayfield="Naziv"/>
 				</item>
			</group>
		</layout>

		<panelbuttons>

			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUpdate" />
						<action type="control populate" value="parent.#grdMaster" />
						<action type="form close" />
					</event>
				</button>

				<button name="btnCncl" caption="Odustani" type="cancel" dock="right"></button>
			</buttons>

		</panelbuttons>	

		<datalist>

			<data command="spNajamUgovoriMjernaMjesta_query" name="dtGet">
				<parameter name="@action" value="1" />
				<parameter name="@id" value="$id" />
			</data>
			<data command="spNajamUgovoriMjernaMjesta_Mjesta_Query" name="dtNapuniMjesta" />
			<data command="spNajamUgovoriMjernaMjesta_Dimenzije_Query" name="dtNapuniDimenzije">
				<parameter name="@dimVrsteID" value="4" />
			</data>

			<data command="spNajamUgovoriMjernaMjesta_update" name="dtUpdate">
				<parameter name="@id" value="parent.#grdMaster.@Id" />
				<parameter name="@brojmjernogmjesta" value="#txtBroj" />
				<parameter name="@adresa" value="#txtadresa" />
				<parameter name="@mjestaid" value="#cmbGrad" />
				<parameter name="@brojbrojila" value="#txtBrojilo" />
				<parameter name="@dimenzijeid" value="#cmbsiteid" />
			</data>

		</datalist>

	</form>
</root>