	<form name="frmUnosSkladiste" caption="{Global.$VrstaPromNaziv}" fixedsize="false" >
								<event type="init">
									<action type="datarun reader" value="~dtGetDataInsert" />
									<action type="datarun reader" value="~dtKonfig" />
								</event>

								<event type="load">
									<action if="~dtKonfig.@SkladisteId==0">
										<action type="control value" value="#cmbSkladiste" >
											<parameter value="~dtGetDataInsert.@SkladisteId"/>
										</action>
									</action>
									<action if="~dtKonfig.@SkladisteId==1">
										<action type="control value" value="#cmbSkladiste" >
											<parameter value="~dtGetDataInsert.@SkladisteId"/>
										</action>
									</action>
								</event>

								<event type="shown">
									<action type="control value" value="#datDatum" if="~dtKonfig.@Datum==1" >
										<parameter value="~dtGetDataInsert.@Datum"/>
									</action>
									<action if="~dtKonfig.@OrgShemaId==0">
										<action type="control value" value="#cmbOrgShema" >
											<parameter value="~dtGetDataInsert.@OrgShemaId"/>
										</action>
									</action>
									<action else="">
										<action type="datarun reader" value="~dtOrgShemaSkladiste"  />
										<action type="control value" value="#cmbOrgShema" if="~dtOrgShemaSkladiste.@orgshemaid!=null">
											<parameter value="~dtOrgShemaSkladiste.@orgshemaid"/>
										</action>
									</action>
									<action if="~dtKonfig.@OdgovornaOsobaId==0">
										<action type="control value" value="#cmbOsoba" >
											<parameter value="~dtGetDataInsert.@OsobeId"/>
										</action>
									</action>
									<action else="">
										<action type="datarun reader" value="~dtOdgovornaOsobaSkladiste"  />

										<action type="control value" value="#cmbOsoba" if="~dtOdgovornaOsobaSkladiste.@OsobeId!=null">
											<parameter value="~dtOdgovornaOsobaSkladiste.@OsobeId"/>
										</action>
									</action>
								</event>		

		<part name="partSkladUnosDok" path="prtSkladUnosDok.xml" />
	
	</form>
	<form name="frmIzmijeniSkladiste" caption="{~dtGetDataEdit.@VrstaDok}" fixedsize="true" width="1000" height="400">
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="init">		
			<action type="datarun reader" value="~dtGetDataEdit" />
			<action type="datarun reader" value="~dtDetaljSuma" />
		</event>
		
		<event type="load">
			<action type="datarun scalar" value="~dtGetEditPermission">
				<parameter name="Enabled"/>
			</action>
		
			<action type="control populate" value="#grdStavke" />
			<action type="control value" value="#txtBroj" >
				<parameter value="~dtGetDataEdit.@Broj"/>
			</action>
			<action type="control value" value="#datDatum1" >
				<parameter value="~dtGetDataEdit.@Datum"/>
			</action>
			<action type="control value" value="#cmbSkladiste" >
				<parameter value="~dtGetDataEdit.@SkladisteId"/>
			</action>
			<action type="control value" value="#cmbOsoba" >
				<parameter value="~dtGetDataEdit.@OsobeId"/>
			</action>
			<action type="control value" value="#cmbOrgShema" >
				<parameter value="~dtGetDataEdit.@OrgShemaId"/>
			</action>
			<action type="control value" value="#txtOpis" >
				<parameter value="~dtGetDataEdit.@OrgDok"/>
			</action>
			<action type="control value" value="#curKolicina" >
				<parameter value="~dtDetaljSuma.@Kolicina"/>
			</action>
			<action type="control value" value="#curVrijednost" >
				<parameter value="~dtDetaljSuma.@Vrijednost"/>
			</action>
			<action type="control value" value="#MemoGlava" >
				<parameter value="~dtGetDataEdit.@Memo"/>
			</action>
			<!-- <action type="datarun scalar" value="~dtStatusiProvjeraButton" > -->
				<!-- <parameter name="PromijeniVrati"/> -->
			<!-- </action> -->
		
		</event>
		
		<event type="shown">
		
			<action type="datarun scalar" value="~dtStatusiProvjeraButton1" >
				<parameter name="PromijeniVrati"/>
			</action>
		

		
			<action type="control disable" value="#datDatum1,#cmbSkladiste,#cmbOsoba,#cmbOrgShema,#txtOpis,#btnSpremi1,#btnDodaj2,#btnIzmijeni1,#btnObrisi,#btnZakljuci,#cmbNapomena,#btnDodaj,#btnZamijeni,#MemoGlava,#btnDimenzije" if="$Enabled==0" />
			<action type="control enable" value="#datDatum1,#cmbSkladiste,#cmbOsoba,#cmbOrgShema,#txtOpis,#btnSpremi1,#btnDodaj2,#btnIzmijeni1,#btnObrisi,#btnZakljuci,#cmbNapomena,#btnDodaj,#btnZamijeni,#MemoGlava,#btnDimenzije" if="$Enabled==1" />
			<action type="control disable" value="#btnZakljuci" if="$PromijeniVrati==-1"/>
			<action type="control enable" value="#btnZakljuci" else=""/>
			<!-- <action type="control enable" value="#btnIzmijeni1, #btnObrisi" if="#grdStavke.rowcount&gt;0&amp;&amp;$Status!=2"/> -->
			<!-- <action type="control disable" value="#btnIzmijeni1, #btnObrisi" else=""/> -->
			
		   <action type="control visible" value="#btnDonesi">
				<parameter value="false" />
		   </action>            

			
		</event>
		
		<part name="partSkladIzmjenaDok" path="prtSkladIzmjenaDok.xml" />
		
	</form>
	<form name="frmIzmijeniDeatlj" caption="{$Naslov} - stavka" fixedsize="true" width="400">
		<method name="fnDimenzijeDet" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="init">		
			<action type="datarun reader" value="~dtNasBod" />
			<action type="datarun reader" value="~dtPrometDod" />
		</event>
	
		<event type="load">
			<action type="variable value" value="$DecMjesta">
				<parameter  value="3" type="string"/>
			</action>
		   <action type="control attribute" value="#curKolicina1">
				<parameter name="format" value="n{$DecMjesta}"></parameter>
		   </action>
		   <action type="control attribute" value="#curKolicinaPak">
				<parameter name="format" value="n{$DecMjesta}"></parameter>
		   </action>
			<action type="variable value" value="$Bod">
				<parameter  value="~dtNasBod.@Iznos" type="decimal"/>
			</action>
			<action type="control visible" value="#srcKontigent">
				<parameter value="false"/>
			</action>
			<action type="variable value" value="$IndKontigent">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$PakJMId">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$IndDodKol">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$JMRobaId">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$PakFaktor">
				<parameter  value="0" type="decimal"/>
			</action>
			<action type="variable value" value="$PakFaktorFix">
				<parameter  value="0" type="int"/>
			</action>
			<action type="control value" value="#srcOsoba">
			  <parameter value="~dtPrometDod.@hrkadroviid" text="~dtPrometDod.@ImePrezime"/>
			</action>
			<action type="control value" value="#srcOrgShema" if="$IndSmjestaj==1">
			  <parameter value="~dtPrometDod.@orgshemaid" text="~dtPrometDod.@OrgShema"/>
			</action>
			<action type="variable value" value="$Raspolozivo">
				<parameter  value="0" type="decimal"/>
			</action>
			<action type="variable value" value="$SktPromDetId">
				<parameter  value="null" type="int"/>
			</action>
		</event>
		
		<part name="prtIzmijeniDeatlj" path="prtSkladPromet.xml" />
	
		
	</form>
	<form name="frmDetaljEdit" caption="{$Naslov} - stavka" fixedsize="true" width="400">
		<method name="fnDimenzijeDet" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="init">
			<action type="datarun reader" value="~dtDetaljEdit" />
			<action type="datarun reader" value="~dtNasBod" />
			<action type="datarun reader" value="~dtPrometDod" />
		</event>
	
		<event type="shown">
			<action type="control value" value="#srcRoba">
			  <parameter value="~dtDetaljEdit.@RobaId" text="~dtDetaljEdit.@NazivRobe"/>
			</action>
			
			<action type="variable value" value="$DecMjesta">
				<parameter  value="3" type="string"/>
			</action>
		   <action type="control attribute" value="#curKolicina1">
				<parameter name="format" value="n{$DecMjesta}"></parameter>
		   </action>
		   <action type="control attribute" value="#curKolicinaPak">
				<parameter name="format" value="n{$DecMjesta}"></parameter>
		   </action>
			<action type="variable value" value="$Bod">
				<parameter  value="~dtNasBod.@Iznos" type="decimal"/>
			</action>
			<action type="variable value" value="$PakJMId">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$JMRobaId">
				<parameter  value="0" type="int"/>
			</action>
			<action type="variable value" value="$PakFaktor">
				<parameter  value="0" type="decimal"/>
			</action>
			<action type="variable value" value="$PakFaktorFix">
				<parameter  value="0" type="int"/>
			</action>
			<action type="control value" value="#srcOrgShema">
			  <parameter value="~dtPrometDod.@orgshemaid" text="~dtPrometDod.@OrgShema"/>
			</action>
			<action type="variable value" value="$Raspolozivo">
				<parameter  value="0" type="decimal"/>
			</action>
			<action type="variable value" value="$SktPromDetId">
				<parameter  value="null" type="int"/>
			</action>
			
			<action type="control value" value="#srcRoba">
			  <parameter value="~dtDetaljEdit.@RobaId" text="~dtDetaljEdit.@NazivRobe"/>
			</action>
			
		   <action type="control attribute" value="#curKolicina1" if="~dtDetaljEdit.@decimals&gt;0&amp;&amp;~dtDetaljEdit.@decimals&lt;5">
				<parameter name="format" value="n{#srcRoba.@decimals}"></parameter>
		   </action>
		   <action type="control attribute" value="#curKolicina1" else="">
				<parameter name="format" value="n3"></parameter>
		   </action>
		   <action type="control attribute" value="#curKolicinaPak" if="~dtDetaljEdit.@jm2decimals&gt;0&amp;&amp;~dtDetaljEdit.@jm2decimals&lt;5">
				<parameter name="format" value="n{#srcRoba.@jm2decimals}"></parameter>
		   </action>
		   <action type="control attribute" value="#curKolicinaPak" else="">
				<parameter name="format" value="n3"></parameter>
		   </action>
							   
			<action type="control value" value="#curKolicina1">
			  <parameter value="~dtDetaljEdit.@KolicinaIzlaz" />
			</action>
			<action type="control value" value="#lblJM">
			  <parameter value="~dtDetaljEdit.@JMNaziv"/>
			</action>
			<action type="control value" value="#lblJMS" >
				<parameter value="~dtDetaljEdit.@JMNaziv"/>
			</action>
			<action type="control value" value="#lblJMZ" >
				<parameter value="~dtDetaljEdit.@JMNaziv"/>
			</action>
			<action type="control value" value="#lblJMN" >
				<parameter value="~dtDetaljEdit.@JMNaziv"/>
			</action>
			<action type="control visible" value="#lblKolicinaPak" if="~dtDetaljEdit.@jm2id!=null">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#lblKolicinaPak" else="">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#curKolicinaPak" if="~dtDetaljEdit.@jm2id!=null">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#curKolicinaPak" else="">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#lblJMPak" if="~dtDetaljEdit.@jm2id!=null">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#lblJMPak" else="">
				<parameter value="false"/>
			</action>
			<action type="control value" value="#curKolicinaPak">
			  <parameter value="~dtDetaljEdit.@PakKolicinaIzlaz"/>
			</action>
			<action type="control value" value="#lblJMPak">
			  <parameter value="~dtDetaljEdit.@JMNaziv2"/>
			</action>
			<action type="control value" value="#curCijena">
			  <parameter value="~dtDetaljEdit.@nabcijena"/>
			</action>
			<action type="variable value" value="$IndKontigent">
				<parameter  value="~dtDetaljEdit.@kkvalobavezan" type="int"/>
			</action>
			<action type="control visible" value="#srcKontigent" if="~dtDetaljEdit.@kkvalobavezan==1">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#srcKontigent" else="">
				<parameter value="false"/>
			</action>
			<action type="control value" value="#srcKontigent" if="~dtDetaljEdit.@kkvalobavezan==1">
			  <parameter value="~dtDetaljEdit.@kkvalglaid" text="~dtDetaljEdit.@Kontingent"/>
			</action>
			<action type="control value" value="#srcOsoba">
			  <parameter value="~dtDetaljEdit.@HRKadroviId" text="~dtDetaljEdit.@ImePrezime"/>
			</action>
			
			<action type="variable value" value="$PakJMId" if="~dtDetaljEdit.@jm2id!=null">
				<parameter  value="~dtDetaljEdit.@jm2id" type="int"/>
			</action>
			<action type="variable value" value="$PakFaktor" if="~dtDetaljEdit.@jm2id!=null">
				<parameter  value="~dtDetaljEdit.@PakFaktor" type="decimal"/>
			</action>
			<action type="variable value" value="$PakFaktorFix" if="~dtDetaljEdit.@jm2id!=null">
				<parameter  value="~dtDetaljEdit.@PakFaktorFix" type="int"/>
			</action>
			<action type="control value" value="#srcSmjestaj">
			  <parameter value="~dtDetaljEdit.@SmjestajId" text="~dtDetaljEdit.@Smjestaj"/>
			</action>
			<action type="control value" value="#srcOrgShema">
			  <parameter value="~dtDetaljEdit.@OrgShemaId" text="~dtDetaljEdit.@OrgShema"/>
			</action>
			<action type="datarun reader" value="~dtStanjeSkladistaEdit"  />
			<action type="control value" value="#curStvarno" >
				<parameter value="~dtStanjeSkladistaEdit.@stanje"/>
			</action>
			<action type="control value" value="#curRezervirano" >
				<parameter value="~dtStanjeSkladistaEdit.@rezervirano"/>
			</action>
			<action type="control value" value="#curRaspolozivo" >
				<parameter value="~dtStanjeSkladistaEdit.@raspolozivo"/>
			</action>
			<action type="control value" value="#txtMemo">
			  <parameter value="~dtDetaljEdit.@Napomena"/>
			</action>
			<action type="control disable" value="#srcRoba" />
		</event>
	
		<part name="prtDetaljEdit" path="prtSkladPromet.xml" />
		
	</form>	
	<form name="frmDatumStorno" caption="Datum storniranog dokumenta" fixedsize="false" width="350">
		<part name="partDatumStorno" path="prtSkladPromet.xml" />
	</form>
	<datalist>
		<part name="partGlobalneStore" path="prtSkladGlobalneStore.xml" />
		<data command="spSklad_VrstaProm" name="dtVrstaProm">
			<parameter name="@Sifra" value="125"/>
		</data>
	</datalist>
</root>