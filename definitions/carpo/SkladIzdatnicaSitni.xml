	<form name="frmPromjenaStatusa" caption="{$Naslov}">

		<event type="init">
			<action type="variable value">
				<parameter name="Naslov" value="$NaslovTekst"/>
			</action>
		</event>	
		<part name="prtPromjenaStatusa" path="prtSkladPromet.xml" />
		
	</form>
	<form name="frmPovijestStatusa" caption="POVIJEST STATUSA" width="450" height="600">
