<root>
    <form type="master" name="frmGranula">
        <managerlayout>
            <grid type="master" name="grdGlava" dataname="~dtDohvatiTablicu" multiselect="true">
            <fields>
                <field name="VrstaObilaskaID" hidden="true"/>
                <field name="Naziv" fixed="true" minwidth="50" />
                <field name="Tip" fixed="true" />
                <field name="Sortkey" fixed="true" />
                <field name="Aktivno" fixed="true" /> 
                </fields>
            </grid>   
        </managerlayout>

    <panelbuttons>
        <buttons>
            <button name="btnForma" caption="Unos" image="add">
                <event type="click">
                        <action type="form open" value="frmUnosForma" />
                </event>
            </button>
           <button name="btnEdit" caption="Izmjeni" image="edit">
                <event type="click">
                    <action type="form open" value="frmIzmjeniForma">
                        <parameter name="tkvrstaObilaskaId" value="#grdGlava.@VrstaObilaskaID" />
                    </action>
                </event>
           </button>         

            <button name="btnDelete" caption="Obriši" image="delete">
                <event type="click">
                    <action type="confirm" value="Želite li obrisati {#grdGlava.@Naziv}? ">
                        <action type="datarun nonquery" value="~dtObrisi">
				 				 <action type="control populate" value="#grdGlava" />
                    </action>
                    </action>
                </event>
            </button>
        </buttons>
    </panelbuttons>

    <datalist>
        <data command="spMobTerKom_VrstaObilaska" name="dtDohvatiTablicu"></data>
        <data command="spMobTerKom_VrstaObilaska_Delete" name="dtObrisi">
            <parameter name="@tkVrstaObilaskaID" value="#grdGlava.@VrstaObilaskaID" />
        </data>
    </datalist>
    </form>

    <form name="frmUnosForma" caption="Unos">
        <layout>
            <group cols="1" rows="4">
                    <item col="1" row="1" caption="Naziv:">
                        <textedit name="txtNaziv" />
                    </item>
                    <item col="1" row="2" caption="Tip:">
                        <textedit name="txtTip" format="n0" />
                    </item>
                    <item col="1" row="3" caption="Sortkey:">
                        <textedit name="txtSortkey" format="n0" />
                    </item>
                    <item col="1" row="4" caption="Aktivno">
                       <checkedit name="txtAktivno" /> 
                    </item>    
            </group>
        </layout>

        <panelbuttons>
            <buttons>
                <button name="btnUnos" caption="Spremi">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtUnesi" />
                        <action type="control populate" value="parent.#grdGlava" />
                        <action type="form close" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel">
                </button>
            </buttons>
        </panelbuttons>


    <datalist>
        <data command="spMobTerKom_VrstaObilaska_Unos" name="dtUnesi">
            <parameter name="@Naziv" value="#txtNaziv" />
            <parameter name="@Tip" value="#txtTip" />
            <parameter name="@Sortkey" value="#txtSortkey" />
            <parameter name="@Aktivno" value="#txtAktivno" />
        </data>

    </datalist>
     </form>
    

    <!-- EDIT FORMA -->
    <form name="frmIzmjeniForma" caption="Izmjeni">

    <event type="init">
    <action type="datarun reader" value="dtEditPrikaz" />
    </event>

    <event type="load">

    </event>

        <layout>
             <group cols="1" rows="4">
                    <item col="1" row="1" caption="Naziv:">
                        <textedit name="txtNaziv" datavalue="~dtEditPrikaz.@naziv"/>
                    </item>
                    <item col="1" row="2" caption="Tip:">
                        <textedit name="txtTip" format="n0" datavalue="~dtEditPrikaz.@tip"/>
                    </item>
                    <item col="1" row="3" caption="Sortkey">
                        <textedit name="txtSortkey" format="n0" datavalue="~dtEditPrikaz.@sortkey"/>
                    </item>
                    <item col="1" row="4" caption="Aktivno">
                       <checkedit name="txtAktivno" datavalue="~dtEditPrikaz.@aktivno"/> 
                    </item>    
            </group>
        </layout>

<panelbuttons>
                <buttons>
                    <button name="btnUnesi" caption="Spremi">
                        <event type="click">
                            <action type="validate"/>
                            <action type="datarun nonquery" value="~dtUpdate"/>
                            <action type="control populate" value="parent.#grdGlava" />
                            <action type="form close" />
                        </event>
                    </button>
                     <button name="btnOdustani" caption="Odustani" type="cancel">
                    </button>
                    
                </buttons>
</panelbuttons>

    <datalist>  
       <data command="spMobTerKom_VrstaObilaska_edit_prikaz" name="dtEditPrikaz">
            <parameter name="@tkVrstaObilaskaID" value="$tkVrstaObilaskaID" />
        </data>
        
         <data command="spMobTerKom_VrstaObilaska_update" name="dtUpdate">
            <parameter name="@tkVrstaObilaskaID" value="parent.#grdGlava.@VrstaObilaskaID" />
            <parameter name="@Naziv" value="#txtnaziv" />
            <parameter name="@Tip" value="#txtTip" />
            <parameter name="@Sortkey" value="#txtSortkey" />
            <parameter name="@Aktivno" value="#txtAktivno" />
        </data>
    </datalist>


    </form>
</root>

    <!-- EDIT FORMA
    
    što napraviti u ponedjeljak: još nedostaju prikaz podataka u formi za unos i unos podataka u bazu, kompletna provjera

    store: spMobTerKom_VrstaObilaska - prikaz u granuli
           spMobTerKom_VrstaObilaska_Delete - briše vrijednost iz granule
           spMobTerKom_VrstaObilaska_edit_prikaz - treba prikazati prikaz
           spMobTerKom_VrstaObilaska_Update - update podataka

    
    
     -->

    