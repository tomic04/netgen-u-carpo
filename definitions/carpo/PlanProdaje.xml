<root>
	<form name="frmMaster" type="master" caption="Plan prodaje">
		<event type="load">
			<action type="variable value" >
				<parameter name="tmpId" value="0" type="int"/>
			</action>			
		</event>
		<managerlayout>
			<lookup name="filter">
				<comboitem value="VremenskaPodjela" />
			</lookup>
			<tree name="tree">
				<data command="VremenskaPodjela" type="integrated" />

				<event type="focusedrowchanged">
					<action type="control populate" value="#grdMaster" />
				</event>
				<fields>
					<field name="Name" />
				</fields>
			</tree>
			<grid name="grdMaster" type="master" async="true" showautofilterrow="false" dataname="global.dtMaster" key="ProPlanProdajeGlaId">
				<event type="focusedrowchanged">
					<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnZakljuci" if="#grdMaster.rowcount!=0" >
						<action type="control disable" value="#btnObrisi, #btnIzmijeni, #btnZakljuci" if="#grdMaster.@StatusStr==Zaključen"  />
						<action type="control disable" value="#btnObrisi, #btnIzmijeni" elseif="#grdMaster.@StatusStr==0" />
						<action type="control enable" value="#btnObrisi, #btnIzmijeni, #btnZakljuci"  else="" />					
					</action>
					<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnZakljuci" else="" />
					<action type="control populate" value="#grdDetail" />
				</event>
				<!-- 				<event type="doubleclick">
					<action type="form open" value="frmPonudaEdit"  if="#grdMaster.rowcount&gt;0">
						<parameter name="ProPonGlaId" value="#grdMaster.@ProPonGlaId" />
						<parameter name="StatusPon" value="#grdMaster.@Status" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event> -->
				<menu>
					<menuitem caption="PONIŠTI ZAKLJUČAK" sort="4">
						<event type="click">
							<action type="confirm" value="Želite li poništiti zaključak?">
								<action type="control foreachrow selected" value="#grdMaster">
									<action type="datarun nonquery" value="global.~dtPonistiZakljucak">
									</action>
								</action>
								<action type="control populate" value="#grdMaster" />
							</action>
						</event>
					</menuitem>
				</menu>
				<fields inherited="true">
					<field name="broj" caption="Dokument" fixed="left" fontbold="true" />
					<field name="datumdok" caption="Datum" />
					<field name="datumod" caption="Od datuma" />
					<field name="datumdo" caption="Od datuma" />
					<field name="refdatumod" caption="Od datuma I" />
					<field name="refdatumdo" caption="Do datuma I" />
					<field name="ref2datumod" caption="Od datuma II" />
					<field name="ref2datumdo" caption="Od datuma II" />
					<field name="operaternaziv" caption="Operater" />
					<field name="StatusStr" caption="Status" />
					<field name="osoba" caption="Odg. osoba" />
					<field name="Klasa" caption="Klasifikacija" />
					<field name="Opis" caption="Opis" />
					<field name="Drzava" caption="Drzave" />
					<field name="Cjenik" caption="Cjenik" />
				</fields>
				<styles>
					<style name="fontcolor" value="red" if="#grdMaster.@StatusStr==Zaključen" />
				</styles>
			</grid>
			<grid name="grdDetail" dataname="global.dtDetail">
				<fields>
					<field name="Klasa" caption="Klasa" />
					<field name="Sifra" caption="Roba" />
					<field name="RobaNaziv" caption="Naziv" fontbold="True" />
					<field name="JMNaziv" caption="JM" />
					<field name="KolicinaObveza" caption="Obveza" />
					<field name="KolicinaOtprema" caption="Promet I" />
					<field name="KolicinaOtprema2" caption="Promet II" />
					<field name="koeficijent" caption="Obveza" />
					<field name="KolicinaPlan" caption="Plan" />
					<field name="Cijena" caption="Cijena" />
					<field name="NabCijena" caption="Nab. cijena" />
					<field name="pr" caption="P/R" />
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" dataname="global.dtVrstaDokGet" displayfield="Opis" >
					<menuitem control="#grdMaster" sort="1"/>
					<event type="click">
						<action type="form open" value="frmPPDokumentUnos" >
							<parameter name="VrstaDokId" value="#btnUnesi.@VrstaDokId" />
						</action>
						<action type="control populate" value="#grdMaster">
							<action type="control focus" value="#grdMaster">
								<!-- <action type="message" value="$tmpId" /> -->
								<parameter value="$tmpId" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit">
					<menuitem control="#grdMaster" sort="2"/>
					<event type="click">
						<action type="form open" value="frmPPDokumentEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="ProPlanProdajeGlaId" value="#grdMaster.@ProPlanProdajeGlaId" />
							<!-- <parameter name="StatusPon" value="#grdMaster.@Status" /> -->
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati plan prodaje broj '{#grdMaster.@Broj}'?">
							<action type="datarun nonquery" value="global.~dtDelete">
								<action type="control populate" value="#grdMaster" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnZakljuci" caption="ZAKLJUČI">
					<menuitem control="#grdMaster" sort="3"/>
					<event type="click">
						<action type="confirm" value="Želite li zaključiti odabrano?">
							<action type="control foreachrow selected" value="#grdMaster">
								<action type="datarun nonquery" value="global.~dtZakljuci">
								</action>
							</action>
							<action type="control populate" value="#grdMaster" />
						</action>
					</event>
				</button>
				<!--<button name="btnOtpremi" caption="OTPREMI">
					<event type="click">
						<action type="form open" value="frmOtpremi">
							<parameter name="ProPonGlaId" value="#grdMaster.@proponglaid" />
						</action>
					</event>
				</button> -->
				<!-- PRINT -->
				<!-- 				<button name="btnPrint" caption="ISPIŠI" dataname="dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="control print" value="#grdMaster">
							<action type="print template" value="#btnPrint1.@Template">
								<parameter name="id" value="#grdMaster.@ProPonGlaId" />
							</action>
						</action>
					</event>
				</button> -->

			</buttons>
		</panelbuttons>
	</form>

	<form name="frmPPDokumentUnos" path="frmPPDokumentUnos.xml" />
	<form name="frmPPDokumentEdit" path="frmPPDokumentEdit.xml" />
	<form name="frmRoba" path="frmRoba.xml"/>
	<form name="frmBilanca" path="frmBilanca.xml"/>
	<form name="frmSirovine" path="frmSirovine.xml"/>

	<datalist>
		<data command="spProPlanProdajeGlaQuery" name="dtMaster">
			<parameter name="@Action" value="master" />
			<parameter name="@DatumOd" value="#tree.@DatumOd" />
			<parameter name="@DatumDo" value="#tree.@DatumDo" />
		</data>
		<data command="spProPlanProdajeDetQuery" name="dtDetail">
			<parameter name="@Action" value="detail" />
			<parameter name="@ID" value="#grdMaster.@ProPlanProdajeGlaId" />
		</data>	
		<data command="spDrzaveQuery" name="dtDrzava">
			<parameter name="@Action" value="0" />
		</data>		
		<data command="spVrCjenikQuery" name="dtCjenik">
			<parameter name="@Action" value="0" />
			<parameter name="@ID" value="0" />
			<parameter name="@Opis" value="" />
		</data>	
		<data command="spOsobeQuery" name="dtOdgovornaOsoba">
			<parameter name="@Action" value="16" />
		</data>
		<data command="spKlMasterRobaQuery" name="dtKlasa">
			<parameter name="@Action" value="0" />
			<parameter name="@ID" value="0" />
			<parameter name="@klasifikacija" value="" />
			<parameter name="@sortkey" value="" />
			<parameter name="@robaid" value="0" />
		</data>
		<data command="spVrstaDokGet" name="dtVrstaDokGet">
			<parameter name="@Sifra" value="112" />
		</data>
		<data command="spProPlanProdajeGlaAzur" name="dtZakljuci">
			<parameter name="@Action" value="3" />
			<parameter name="@ID" value="#grdMaster.@ProPlanProdajeGlaId" />
		</data>
		<data command="spProPlanProdajeGlaAzur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@ID" value="#grdMaster.@ProPlanProdajeGlaId" />
		</data>
		<data command="spProPlanProdajeGlaAzur" name="dtPonistiZakljucak">
			<parameter name="@Action" value="4" />
			<parameter name="@ID" value="#grdMaster.@ProPlanProdajeGlaId" />
		</data>		
	</datalist>
</root>