				<parameter name="Global.FakturaUkopInd" value="~dtPubVars.@FakturaUkopInd" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.PokaziNC" value="~dtPubVars.@Ponude_PokaziNC" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.KrajniKupacSlobodanUnos" value="~dtPubVars.@Ponude_KrajniKupacSlobodanUnos" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.BrRajona" value="~dtPubVars.@BrRajona" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.RTFNapomena" value="~dtPubVars.@Ponude_RTFNapomena" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.VrstaPromId" value="~dtVrstaProm.@VrstaPromId" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.ChkKalk" value="false" type="string"/>
			</action>
			<action type="variable value">
				<parameter name="Global.tablicaGla" value="ProPonGla" type="string"/>
			</action>
			<action type="variable value">
				<parameter name="Global.tablicaDet" value="ProPonDet" type="string"/>
			</action>
