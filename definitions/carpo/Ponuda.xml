		<event type="shown">
			<action type="variable value">
				<parameter name="Objekt" value="Ponuda" type="string" />
			</action>
			<action type="variable value">
				<parameter name="Funkcija" value="Kalkulacija" type="string" />
			</action>
			<action type="datarun scalar" value="Global.dtCheckPermission">
				<parameter name="Global.Kalkulacija" value="Smije"/>
			</action>
		</event>		
		<event type="load">
			<!-- <action type="datarun reader" value="global.~dtUlazDatumi" /> -->
			<action type="datarun scalar" value="global.~dtDanas" >
				<parameter name="Tree_node" />
			</action>
			<!-- <action type="control focus" value="#tree" if="#filter==Filter"> -->
			<action type="control focus" value="#tree" >
				<parameter value="$Tree_node" type="string"/>
			</action>
			<partsql name="partDMSPostoji" dataname="Global.dtPartDMS" if="Global.$DMSPostoji==1" />
		</event>
		<managerlayout>
			<lookup name="filter">
				<comboitem value="Vremenska podjela" searchfield="DatumKeyId"/>
				<comboitem value="Operateri" searchfield="OperateriKeyId"/>
				<comboitem value="Statusi" searchfield="StatusiKeyId"/>
				<comboitem value="Partneri" searchfield="PartneriKeyId"/>
				<event type="valuechanged">
					<action type="variable value" value="global.filter">
						<parameter value="#filter" />
					</action>
				</event>
			</lookup>
			<tree name="tree" filtermode="smart">
				<data command="spCarpoTreeVrijeme" key="ProPonGlaId" if="#filter==Vremenska podjela">
					<parameter name="@jucer" value="1"/>
					<parameter name="@danas" value="1"/>
					<parameter name="@sutra" value="1"/>
					<parameter name="@tjedan" value="1"/>
					<parameter name="@tablica" value="ProPonGla"/>
					<parameter name="@minGodina" value="3"/>
					<parameter name="@sidro" value="1"/>
				</data>

				<data command="spProd_PonGla_DrvoFilter" key="ProPonGlaId" else="">
					<parameter name="@Action" value="Statusi" if="#filter==Statusi"/>
					<parameter name="@Action" value="Partneri" if="#filter==Partneri"/>
					<parameter name="@Action" value="Operateri" if="#filter==Operateri"/>
				</data>
				<event type="focusedrowchanged">
					<!-- ako je granula otvorena nekoliko dana uzimam trenutni jucer/danas/sutra i uspoređujem s onim na drvetu. ako se razlikuju okidam punjenje drveta, fokus na jučer/danas/sutra, punjenje gridova -->
					<action if="#tree.@Name==Jučer">
						<action type="datarun scalar" value="global.~dtJucer_lazy">
							<parameter name="jucer_lazy" />
						</action>
						<action if="#tree.@value!=$jucer_lazy">
							<action type="control populate" value="#tree" />
							<action type="control focus" value="#tree" >
								<parameter value="$jucer_lazy" type="string"/>
							</action>
						</action>
					</action>
					<action if="#tree.@Name==Danas">
						<action type="datarun scalar" value="global.~dtdanas_lazy">
							<parameter name="danas_lazy" />
						</action>
						<action if="#tree.@value!=$danas_lazy">
							<action type="control populate" value="#tree" />
							<action type="control focus" value="#tree" >
								<parameter value="$danas_lazy" type="string"/>
							</action>
						</action>
					</action>
					<action if="#tree.@Name==Sutra">
						<action type="datarun scalar" value="global.~dtSutra_lazy">
							<parameter name="sutra_lazy" />
						</action>
						<action if="#tree.@value!=$sutra_lazy">
							<action type="control populate" value="#tree" />
							<action type="control focus" value="#tree" >
								<parameter value="$sutra_lazy" type="string"/>
							</action>
						</action>
					</action>
					<!-- ako je granula otvorena nekoliko dana uzimam trenutni jucer/danas/sutra i uspoređujem s onim na drvetu. ako se razlikuju okidam punjenje drveta, fokus na jučer/danas/sutra, punjenje gridova -->
					<!--TEMP BUGFIX SUME NA GRUPAMA-->
					<action type="variable value">
						<parameter name="dummy" value="1" type="int"/>
					</action>
					<action type="control populate" value="#grdGlava"/>
					<action type="variable value">
						<parameter name="dummy" value="0" type="int"/>
					</action>
					<!--TEMP BUGFIX SUME NA GRUPAMA-->
					<action type="control populate" value="#grdGlava" />
				</event>
				<fields>
					<field name="Name" />
				</fields>
			</tree>
			<grid name="grdGlava" type="master" async="true" key="ProPonGlaId" searchfield="ProPonGlaId" savelayout="true" savevalue="app" multiselect="true">
				<menu>
					<!-- <menuitem name="menOtkljucaj" caption="OTKLJUČAJ" sort="1" function="OtkljucajPonudu"> -->
					<!-- <event type="click"> -->
					<!-- <action type="confirm" value="Želite li otključati dokument?"> -->
					<!-- <action type="datarun nonquery" value="~dtOtkljucaj"> -->
					<!-- <action type="control populate keepfocus" value="#grdGlava" /> -->
					<!-- </action> -->
					<!-- </action> -->
					<!-- </event>					 -->
					<!-- </menuitem> -->
					<menuitem name="menVratiStatus" caption="VRATI STATUS" sort="1" function="VratiStatus">
						<event type="click">
							<action type="variable value">
								<parameter name="VratiStatus" value="1" type="int" />
							</action>
							<action type="datarun scalar" value="Global.dtOperaterLock"/>
							<action type="datarun scalar" value="Global.dtStatusiProvjera"/>
							<action type="form open" value="frmPromijeniStatus"  if="#grdGlava.rowcount&gt;0">
								<parameter name="ProPonglaId" value="#grdGlava.@ProPonglaId" />
								<parameter name="StatusiId" value="#grdGlava.@StatusiId" />
								<parameter name="VratiStatus" value="$VratiStatus" />
								<parameter name="NaslovTekst" value="Vrati status" />
							</action>
							<action type="control populate keepfocus" value="#grdglava" />
						</event>
					</menuitem>
					<menuitem caption="POVIJEST STATUSA" sort="2">
						<event type="click">
							<action type="form open" value="frmPovijestStatusa" />
						</event>
					</menuitem>
					<menuitem caption="INFO DOKUMENTA" sort="3" function="InfoDok">
						<event type="click">
							<action type="form open" value="frmDokumentInfo">
								<parameter name="ProPonGlaId" value="#grdGlava.@ProPonGlaId" />
								<parameter name="Broj" value="#grdGlava.@broj" />
							</action>
						</event>
					</menuitem>
					<menuitem caption="REVIZIJA STAVAKA" sort="4" function="AuditStavaka">
						<event type="click">
							<action type="form open" value="frmAuditStavaka">
								<parameter name="ProPonGlaId" value="#grdGlava.@ProPonGlaId" />
								<parameter name="Broj" value="#grdGlava.@broj" />
							</action>
						</event>
					</menuitem>
					<menuitem caption="PARTNERI INFO" sort="5">
						<event type="click">
							<action type="method run" value="parInfo">
								<parameter name="server" value="@@server" />
								<parameter name="baza" value="@@database" />
								<parameter name="username" value="@@username" />
								<parameter name="password" value="" />
								<parameter name="operateriid" value="@@operateriid" />
								<parameter name="Parent" value="0" />
								<parameter name="pTop" value="0" />
								<parameter name="pLeft" value="0" />
								<parameter name="path" value="" />
								<parameter name="partneriid" value="#grdGlava.@partneriid"/>
							</action>
						</event>
					</menuitem>
				</menu>
				<event type="focusedrowchanged">
					<!-- <action type="menu disable" value="#menOtkljucaj" if="#grdGlava.rowcount==0||#grdGlava.@Status!=2"  /> -->
					<!-- <action type="menu enable" value="#menOtkljucaj" else=""  /> -->
					<action type="control enable" value="#btnIzmijeni, #btnPrint, #btnDodatno, #btnStatus" if="#grdGlava.rowcount!=0" />
					<action type="control disable" value="#btnIzmijeni, #btnPrint, #btnDodatno, #btnStatus" else="" />
					<action type="control disable" value="#btnObrisi" if="#grdGlava.rowcount==0||#grdGlava.@Status==2||#grdGlava.@Status==0||#grdGlava.@Smije==0"  />
					<action type="control enable" value="#btnObrisi"  else="" />
					<action type="control disable" value="#btnOtpremi, btnFakturiraj" if="#grdGlava.rowcount==0||#grdGlava.@Status!=2"  />
					<action type="control enable" value="#btnOtpremi, btnFakturiraj"  else="" />
					<action type="control populate" value="#grdDetail" />
					<!-- <action type="control populate" value="#grdDimenzije" /> -->
					<!-- <part name="partZalihaGridPopulate" path="prtPonudaLokalizacije.xml" /> -->
					<!-- <part name="partDMSGridPopulate" path="prtPonudaLokalizacije.xml" /> -->
					<partsql name="partDMSBtnPoveziEnable" dataname="Global.dtPartDMS" if="Global.$DMSPostoji==1" />
					<part name="partPokojnikGridPopulate" path="prtPonudaLokalizacije.xml" />
					<partsql name="partDMSPopulate" dataname="Global.dtPartDMS" if="Global.$DMSPostoji==1" />
					<action type="variable value" value="VrstaDokOpis">
						<parameter value="#grdGlava.@opis" />
					</action>
					<action type="variable value" value="BrojOpis">
						<parameter value="#grdGlava.@broj" />
					</action>
					<action type="variable value">
						<parameter name="ProPonGlaId" value="#grdGlava.@ProPonGlaId" type="int" />
					</action>
					<action type="variable value" value="Global.$DokId">
						<parameter value="#grdGlava.@ProPonGlaId" />
					</action>					
				</event>
				<event type="doubleclick">
					<action type="variable value">
						<parameter name="Funkcija" value="Edit" type="string" />
					</action>
					<action type="datarun scalar" value="Global.dtCheckPermission">
						<parameter name="Smije"/>
					</action>
					<action type="form open" value="frmPonudaEdit" if="#grdGlava.rowcount&gt;0&amp;&amp;$Smije==1">
						<parameter name="ProPonGlaId" value="#grdGlava.@ProPonGlaId" />
						<parameter name="StatusPon" value="#grdGlava.@Status" />
						<parameter name="Potvrda" value="#grdGlava.@Potvrda" />
						<parameter name="DokIznosSPDV" value="#grdGlava.@IznosKn" />
						<parameter name="DokIznosBezPDV" value="#grdGlava.@IznosOsnovica" />
						<parameter name="Izmjena" value="1" />
						<parameter name="VrstaDokOpis" value="$VrstaDokOpis" />
						<parameter name="BrojDok" value="$BrojOpis" />
					</action>
					<action type="control populate keepfocus" value="#grdGlava" />
				</event>
				<data command="spProd_PonGla_Grid" >
					<parameter name="@Action" value="Dummy" if="$dummy==1" />
					<parameter name="@OperaterId" if="global.$filter==Operateri" value="#tree.@ValueId" />
					<parameter name="@Status" if="global.$filter==Statusi" value="#tree.@ValueId" />
					<parameter name="@PartneriId" if="global.$filter==Partneri" value="#tree.@ValueId" />
					<parameter name="@DatumOd" value="#tree.@DatumOd" />
					<parameter name="@DatumDo" value="#tree.@DatumDo" />
				</data>
				<fields>
					<part name="partMasterGrid" path="prtPonudaLokalizacije.xml" />
				</fields>
				<styles>
					<!-- <action if="global.dtTarifaBojanje.@TarifaBOjanje==0"> -->
					<style name="fontcolor" value="green" if="#grdGlava.@Status==2" />
					<style name="fontcolor" value="black" if="#grdGlava.@Status==1&amp;&amp;#grdGlava.@IznosPlaceno==0" />
					<style name="fontcolor" value="red" if="#grdGlava.@Status==1&amp;&amp;#grdGlava.@IznosPlaceno&gt;0" />
					<style name="fontcolor" value="gray" if="#grdGlava.@Status==0" />
					<!-- </action> -->
					<!-- <action else=""> -->
					<!-- </action> -->
				</styles>
			</grid>
			<tabs name="tabs">
				<event type="selectedtabchanged">
					<action type="control populate" value="#grdZaliha" if="#tabs.selectedtab==tabZaliha"/>
					<action type="control populate" value="#grdDimenzije" if="#tabs.selectedtab==tabDimenzije"/>
				</event>
				<tab caption="Stavke">
					<grid name="grdDetail" showgrouppanel="false" showautofilterrow="true" savelayout="true" bestfitonrefresh="true" multiselect="true">
						<data command="spProd_PonDet_Grid" >
							<parameter name="@Id" value="#grdGlava.@ProPonGlaId" />
						</data>
						<part name="partPonudaDetaljGrid" path="prtPonudaLokalizacije.xml" />
						<styles>
							<style name="fontcolor" value="gray" if="#grdDetail.@IndOpcija==true" />
							<style name="fontcolor" value="red" elseif="#grdDetail.@IndRucnoZatvoreno==1" />
							<style name="fontcolor" value="blue" elseif="#grdDetail.@IndUsluga==1" />
							<style name="bold" value="true" if="#grdDetail.@IndBold==1" />
						</styles>
						<menu>
							<menuitem caption="ROBA INFO" sort="1" function="RobaInfo">
								<event type="click">
									<action type="method run" value="funRobaInfo">
										<parameter name="server" value="@@server" />
										<parameter name="baza" value="@@database" />
										<parameter name="username" value="" />
										<parameter name="password" value="" />
										<parameter name="OperateriId" value="@@operateriid" />
										<parameter name="path" value="" />
										<parameter name="robaid" value="#grdDetail.@RobaId" />
									</action>
								</event>
							</menuitem>
						</menu>
					</grid>
				</tab>
				<part name="partDimenzijeGrid" path="prtPonudaLokalizacije.xml" />
				<part name="partZalihaGrid" path="prtPonudaLokalizacije.xml" />
				<!-- <part name="partDMSGridTab" path="prtPonudaLokalizacije.xml" /> -->
				<partsql name="partDMSTab" dataname="Global.dtPartDMS" if="Global.$DMSPostoji==1" />
				<part name="partPokojnikGrid" path="prtPonudaLokalizacije.xml" />
			</tabs>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="&amp;UNESI" type="add" dataname="dtVrstaDokGet" displayfield="Opis" function="Insert">
					<event type="click">
						<action type="form open" value="frmPonudaNova">
							<parameter name="VrstaDokId" value="#btnUnesi.@VrstaDokId" />
							<parameter name="VrstaDok" value="#btnUnesi.@Opis" />
						</action>
						<action type="control enable" value="#btnIzmijeni, #btnPrint, #btnDodatno, #btnStatus" if="#grdGlava.rowcount!=0" />
						<action type="control disable" value="#btnIzmijeni, #btnPrint, #btnDodatno, #btnStatus" else="" />
						<action type="control disable" value="#btnObrisi" if="#grdGlava.rowcount==0||#grdGlava.@Status==2||#grdGlava.@Status==0||#grdGlava.@Smije==0"  />
						<action type="control enable" value="#btnObrisi"  else="" />
						<action type="control disable" value="#btnOtpremi, btnFakturiraj" if="#grdGlava.rowcount==0||#grdGlava.@Status!=2"  />
						<action type="control enable" value="#btnOtpremi, btnFakturiraj"  else="" />
						<partsql name="partDMSBtnPoveziEnable" dataname="Global.dtPartDMS" if="Global.$DMSPostoji==1" />
					</event>
				</button>
				<button name="btnIzmijeni" caption="&amp;IZMIJENI" type="edit" function="Edit">
					<event type="click">
						<action type="variable value" value="Global.$DokId">
							<parameter value="#grdGlava.@ProPonGlaId" />
						</action>
						<action type="form open" value="frmPonudaEdit"  if="#grdGlava.rowcount&gt;0">
							<parameter name="ProPonGlaId" value="#grdGlava.@ProPonGlaId" />
							<parameter name="StatusPon" value="#grdGlava.@Status" />
							<parameter name="Potvrda" value="#grdGlava.@Potvrda" />
							<parameter name="DokIznosSPDV" value="#grdGlava.@IznosKn" />
							<parameter name="DokIznosBezPDV" value="#grdGlava.@IznosOsnovica" />
							<parameter name="VrstaDokOpis" value="$VrstaDokOpis" />
							<parameter name="BrojDok" value="$BrojOpis" />
							<parameter name="Izmjena" value="1" />
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="&amp;OBRIŠI" type="delete" function="Delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati ponudu broj '{#grdGlava.@Broj}'?">
							<action type="datarun nonquery" value="~dtDelete">
								<action type="control populate" value="#grdGlava" />
