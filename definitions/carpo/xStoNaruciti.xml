<root>
	<form name="frmGlavna" caption="Što naručiti?" type="master">
		   <event type="init">
		   	<action type="datarun nonquery" value="~dtDel" />
		   </event>
		   <event type="load">
		   	<action type="variable value">
		   			<parameter name="operateriid" value="$operateriid" />
		   			<parameter name="datumod" value="$datumod" />
		   			<parameter name="datumdo" value="$datumdo" />
		   			<parameter name="klmasterrobaid" value="$klmasterrobaid" />
		   			<parameter name="klasaispod" value="$klasaispod" />
		   			<parameter name="partneriid" value="$partneriid" />
		   			<parameter name="skladisteid" value="$skladisteid" />
		   			<parameter name="indIzmjene" value="0" />
		   			<parameter name="buttonInd" value="0" />
		   	</action>
		   	<action type="control disable" value="#btnIzmijeni,#btnNaruci,#btnKreirazNabZah,#btnIspiši" if="#grdGlava.rowcount==0" />
		   	 <action type="form open" value="frmFilter"/>
		   	<!--  <action type="control populate" value="#grdglava"/> -->
		   </event>
			<managerlayout>
						<grid name="grdGlava" dataname="~dtPuniGlavu" type="master" key="nabstonarid" multiselect="true" bestfitonrefresh="true" >
						
							<event type="doubleclick">
								<action type="form open" value="frmIzmjena">
								<parameter name="NabStoNarID" value="#grdGlava.@NabStoNarID" />
								<parameter name="operateriid" value="$operateriid" />
		   						<parameter name="datumod" value="$datumod" />
		   						<parameter name="datumdo" value="$datumdo" />
		   						<parameter name="klmasterrobaid" value="$klmasterrobaid" />
		   						<parameter name="klasaispod" value="$klasaispod" />
		   						<parameter name="partneriid" value="$partneriid" />
		   						<parameter name="skladisteid" value="$skladisteid" />
		   						<parameter name="robaid" value="#grdGlava.@robaid" />
		   						<parameter name="formatid" value="#grdGlava.@formatid" />
						</action>
							</event>
								<fields inherited="true">
									<field name="naručiti" caption="Naručiti" editable="true" />
								</fields>
							<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtPromijeniKol">
										<parameter name="NabStoNarID" value="#grdGlava.@NabStoNarId" />
									</action>
							</event>
								<styles>
									<style name="fontcolor" value="red" if="#grdGlava.@formatid==B"/>
									<style name="fontcolor" value="blue" if="#grdGlava.@već naručeno&gt;0" />
								</styles>
						</grid>
			</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="FILTER">
					<event type="click">
						<action type="form open" value="frmFilter" />
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI">
					<event type="click">
						<action type="variable value" value="SelectedIDs">
								<parameter value="#grdGlava.selectedids" type="string"/>
						</action>
						<action type="form open" value="frmIzmjena">
						    <parameter name="NabStoNarID" value="$SelectedIds" type="string" />
							<!-- <parameter name="NabStoNarID" value="#grdGlava.@NabStoNarID" /> -->
								<parameter name="operateriid" value="$operateriid" />
		   						<parameter name="datumod" value="$datumod" />
		   						<parameter name="datumdo" value="$datumdo" />
		   						<parameter name="klmasterrobaid" value="$klmasterrobaid" />
		   						<parameter name="klasaispod" value="$klasaispod" />
		   						<parameter name="partneriid" value="$partneriid" />
		   						<parameter name="skladisteid" value="$skladisteid" />
		   						<parameter name="robaid" value="#grdGlava.@robaid" />
						</action>
					</event>
				</button>
				<button name="btnNaruci" caption="NARUČI">
					<event type="click">
					
						<action type="form open" value="frmNaruciti">

						</action>
					</event>
				</button>
				<button name="btnKreirazNabZah" caption="ZAHTJEV ZA NABAVU">
					<event type="click">
						<action type="form open" value="frmZahtjevNew">
						</action>
					</event>
				</button>
				<button name="btnIspiši" caption="ISPIŠI">
					<event type="click">
						 <action type="control printcontrol" value="#grdGlava"/>
					</event>
				</button>
			</buttons>
			
		</panelbuttons>
		<datalist>
			<data command="spNabStoNarMinMaxNG_CARPO" name="dtFilter">
				<parameter name="@action" value="1"/>
				<parameter name="@operateriid" value="$operateriid" />
				<parameter name="@datumod" value="$datumod" />
				<parameter name="@datumdo" value="$datumdo" />
				<parameter name="@klmasterrobaid" value="$klmasterrobaid" />
				<parameter name="@klasaispod" value="1" if="$klasaispod==True" />
				<parameter name="@klasaispod" value="0" if="$klasaispod==false" />
				<parameter name="@partneriid" value="$partneriid" />
				<!-- <parameter name="@skladisteid" value="$skladisteid" /> -->
				<parameter name="@skladisteid" value="$skladisteId" />
			</data>	
			<data command="spNab_StoNar_Delete" name="dtDel">
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spNab_StoNar_Query" name="dtPuniGlavu">
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spNab_StoNar_EditKolicina" name="dtPromijeniKol">
				<parameter name="@NabStoNarID" value="#grdGlava.@NabStoNarID" />
				<parameter name="@Kolicina" value="#grdGlava.@Naručiti" />
			</data>
		</datalist>
	</form>
	<form name="frmIzmjena" caption="Izmijeni">
		<event type="init">
			<action type="datarun reader" value="~dtGetKol" />
		</event>
		<event type="close">
			<action type="control populate" value="parent.#grdGlava" />
		</event>
		<layout textposition="left">
			<group cols="1" rows="1" col="1" row="1">
				<item col="1" row="1" caption="Naručiti:">
					<textedit name="txtKolicina" format="n2" allownull="false" datavalue="~dtGetKol.@naruciti"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtUpdate">	
						</action>
						<action type="control populate" value="parent.#grdGlava" />
						<action type="control focus" value="parent.#grdGlava">
							<parameter value="$NabStoNarId" name="nabStoNarId" type="int" />
						</action>	
						<action type="form close" />
						<action type="variable value">
							<parameter name="parent.indIzmjene" value="1" />
						</action>
					</event>
				</button>
				<button name="btnIzlaz" type="cancel" caption="Izlaz" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
 			<data command="spNab_NabStoNar_Update" name="dtUpdate">
 				<parameter name="@kolicina" value="#txtKolicina" />
 				<parameter name="@robaid" value="$robaid" />
 				<parameter name="@NabStoNarId" value="$NabStoNarId" />
 			</data>
 			<data command="spNab_StoNar_getKol" name="dtGetKol">
 				<parameter name="@NabStoNarID" value="$NabStoNarID" />
 			</data>
		</datalist>
	</form>
	<form name="frmFilter" caption="Uvjeti" width="280" height="150">
		<event type="close">
			<action type="variable value">
					<parameter name="parent.operateriid" value="@@operateriid" />
					<parameter name="parent.datumod" value="#cmbRazdoblje" />
					<parameter name="parent.datumdo" value="#cmbRazdoblje2" />
					<parameter name="parent.klmasterrobaid" value="#cmbKlasa" />
					<parameter name="parent.klasaispod" value="#chkIspod" />
					<parameter name="parent.partneriid" value="#srcPartner" />
					<parameter name="parent.skladisteid" value="#cmbSkladiste" />
			</action>
			<action type="control populate" value="parent.#grdGlava"/>
		</event>
		<event type="load">
			<action type="datarun reader" value="~dtSklad" />
			<action type="variable value">
				<parameter name="skladid" value="~dtSklad.@skladisteid" />
			</action>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="4" rows="4" col="4" row="2">
				<item col="1" row="1" caption="Skladište:" colspan="4">
					<comboedit name="cmbSkladiste" dataname="~dtSkladistaQuery" displayfield="Naziv" valuefield="skladisteid"/>
				</item>
				<item col="1" row="2" caption="Razdoblje:" colspan="2">
					<dateedit name="cmbRazdoblje" value="now"/>
				</item>
				<item col="3" row="2" colspan="2">
					<dateedit name="cmbRazdoblje2" value="now" />
				</item>
				<item col="1" row="3" caption="Klasa robe:" colspan="3">
					<comboedit name="cmbKlasa" dataname="~dtKlMasterRoba" displayfield="naziv" valuefield="klmasterrobaid" value="" />
				</item>
				<item col="4" row="3" >
					<checkedit name="chkIspod" value="false" caption="i ispod nje" />
				</item>
				<item col="1" row="4" caption="Dobavljač:" colspan="4">
					<searchedit name="srcPartner" dataname="~dtPartneri" fontsizedelta="1" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" function="srcPartner" />
				</item>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="PRIKAZ">
						<event type="click">
						<action type="datarun nonquery" value="~dtFilter" />
						<!-- <action type="control populate" value="parent.#grdGlava" /> -->
						<action type="control enable" value="parent.#btnIzmijeni, parent.#btnNaruci,parent.#btnKreirazNabZah,parent.#btnIspiši" />
							<action type="form close" />
						</event>
					</button>
					<button name="btnIzlaz" caption="IZLAZ" dock="right" type="cancel"/>
				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spNab_stoNaruciti_klMasterRoba" name="dtKlMasterRoba" />
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
			<data command="spNab_stoNaruciti_SkladisteQuery" name="dtSkladistaQuery" />

			<data command="spNabStoNarMinMaxNG_CARPO" name="dtFilter" timeout="2000">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@datumod" value="#cmbRazdoblje" />
				<parameter name="@datumdo" value="#cmbRazdoblje2" />
				<parameter name="@klmasterrobaid" value="#cmbKlasa" />
				<parameter name="@klasaispod" value="1" if="#chkIspod==True" />
				<parameter name="@klasaispod" value="0" if="#chkIspod==false" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@skladisteid" value="#cmbSkladiste" />
			</data>	
			<data command="spNab_stoNar_getSklad" name="dtSklad" />

		</datalist>	
	</form>
	<form name="frmFilter2" caption="Uvjeti" width="280" height="150">
		<layout textposition="left" itemspadding="3">
			<group cols="4" rows="4" col="4" row="2">
				<item col="1" row="1" caption="Skladište:" colspan="4">
					<comboedit name="cmbSkladiste" dataname="~dtSkladistaQuery" displayfield="Naziv" valuefield="skladisteid" />
				</item>
				<item col="1" row="2" caption="Razdoblje:" colspan="2">
					<dateedit name="cmbRazdoblje" value="now"/>
				</item>
				<item col="3" row="2" colspan="2">
					<dateedit name="cmbRazdoblje2" value="now" savevalue="app"/>
				</item>
				<item col="1" row="3" caption="Klasa robe:" colspan="3">
					<comboedit name="cmbKlasa" dataname="~dtKlMasterRoba" displayfield="naziv" valuefield="klmasterrobaid" value="" savevalue="app"/>
				</item>
				<item col="4" row="3" caption="i ispod nje:">
					<checkedit name="chkIspod" value="false" savevalue="app"/>
				</item>
				<item col="1" row="4" caption="Dobavljač" colspan="4">
					<searchedit name="srcPartner" dataname="~dtPartneri" fontsizedelta="1" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" function="srcPartner" savevalue="app"/>
				</item>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action type="datarun nonquery" value="~dtNoviFilter" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" />
						</event>
					</button>
					<button name="btnIzlaz" caption="IZLAZ" dock="right" type="cancel"/>

				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spNab_stoNaruciti_klMasterRoba" name="dtKlMasterRoba" />
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
			<data command="spNab_stoNaruciti_SkladisteQuery" name="dtSkladistaQuery" />

			<data command="spNabStoNarMinMaxNG_CARPO" name="dtFilter">
				<parameter name="@action" value="1" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@datumod" value="#cmbRazdoblje" />
				<parameter name="@datumdo" value="#cmbRazdoblje2" />
				<parameter name="@klmasterrobaid" value="#cmbKlasa" />
				<parameter name="@klasaispod" value="1" if="#chkIspod==True" />
				<parameter name="@klasaispod" value="0" if="#chkIspod==false" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@skladisteid" value="#cmbSkladiste" />
			</data>	
			<data command="spNab_NabStoNar_Filter" name="dtNoviFilter">
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@datumod" value="#cmbRazdoblje" />
				<parameter name="@datumdo" value="#cmbRazdoblje2" />
				<parameter name="@klmasterrobaid" value="#cmbKlasa" />
				<parameter name="@klasaispod" value="#chkIspod" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@skladisteid" value="#cmbSkladiste" />
			</data>
		</datalist>	
	</form>
	<form name="frmNaruciti" caption="Naručiti">
		<layout textpositon="right" itemspadding="2">
			<group cols="2" rows="10" col="1" row="1">
				<item col="1" row="1" caption="Datum dokumenta:" colspan="2">
					<dateedit name="datDok" value="now"  required="true"/>
				</item>	
				<item col="1" row="2" caption="Dobavljač:" colspan="2">
					<searchedit name="srcPartner" dataname="~dtPartneri" fontsizedelta="1" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" function="srcPartner" savevalue="app" required="true"/>
				</item>	
				<item col="1" row="3" caption="Opis:" colspan="2" >
					<textedit name="txtOpis" />
				</item>	
				<item col="1" row="4" caption="Način isporuke:" colspan="2">
					<comboedit name="cmbNacinIsporuke" value="" dataname="~dtNacinIsporuke" displayfield="Naziv" valuefield="ProNacinIsporukeID" />
				</item>
				<item col="1" row="5" caption="Datum isporuke:" colspan="2">
					<dateedit name="datIsporuke" value="now"  required="true"/>
				</item>
				<item col="1" row="6" caption="Org. shema:" colspan="2">
					<comboedit name="cmbOrgShema" value="1" dataname="~dtOrgShema" displayfield="Naziv" valuefield="OrgShemaID"   required="true"/>
				</item> 
				<item col="1" row="7" caption="Odgovorna osoba:" colspan="2">
					<comboedit name="cmbOdgOsoba" dataname="~dtOsobe" displayfield="Naziv" valuefield="Osobeid"   required="true"/>
				</item>	
				<item col="1" row="8" caption="Način plačanja:" colspan="2" >
					<comboedit name="cmbNacinPlacanja" value="" dataname="~dtNacinPlacanja" displayfield="Naziv" valuefield="KntNacinPlacId"  />
				</item>	
				<item col="1" row="9">
					<checkedit name="chkPotvrda" value="0" caption="Potvrda"/>
				</item>
				<item col="1" row="10" caption="Cjenik:" colspan="2">
					<comboedit name="cmbCjenik" value="" dataname="~dtCjenik" displayfield="Opis" valuefield="VrCjenikId" />
				</item>	

			</group>
		</layout>
				<panelbuttons>
					<buttons>
						<button name="btnSpremi" caption="NARUČI">
							<event type="click">
								<action type="validate" />

								<action type="datarun scalar" value="~dtNaruci">
									<parameter name="idnar" />
								</action>
								<action type="form close" />
								<action type="form open" value="frmNarudzba">
									<parameter name="nabnarglaid" value="$idnar" />
								</action>
							</event>
						</button>
						<button name="btnCancel" caption="IZLAZ" type="cancel" dock="right"/>
					</buttons>
			</panelbuttons>
	<datalist>
		<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
		</data>
		<data command="spNab_StoNarucitiNacIsporuke_Query" name="dtNacinIsporuke" />
		<data command="spNab_StoNaruciti_OrgShema" name="dtOrgShema" >
			<parameter name="@operateriid" value="@@operateriid" />
		</data>
		<data command="spNab_StoNaruciti_OdgovorneOsobeGet" name="dtOsobe" />
		<data command="spNab_StoNaruciti_NacinPlacanja" name="dtNacinPlacanja" />
		<data command="spNab_StoNaruciti_getCjenik" name="dtCjenik" />
		<data command="spNabStoNarMinMaxAzurNG" name="dtNaruci">
			<parameter name="@action" value="1" />
			<parameter name="@operateriid" value="@@operateriid" />
			<parameter name="@datumdok" value="#datDok" />
			<parameter name="@partneriid" value="#srcPartner" />
			<parameter name="@opis" value="#txtOpis" />
			<parameter name="@ProNacinIsporukeID" value="#cmbNacinIsporuke" />
			<parameter name="@datumisporuke" value="#datIsporuke" />
		    <parameter name="@OrgShemaID" value="#cmbOrgShema" />
		    <parameter name="@osobeid" value="#cmbOdgOsoba" />
		    <parameter name="@KntNacinPlacId" value="#cmbNacinPlacanja" />
		    <parameter name="@PotvrdaInd" value="1" if="#chkPotvrda==True" />
		    <parameter name="@potvrdaInd" value="0" if="#chkPotvrda==False" />
		    <parameter name="@Cjenikid" value="#cmbCjenik" />
		</data>
	</datalist>	
	</form>
	<form name="frmNarudzba" caption="Narudžbenica br: {$Broj} - {$Dobavljač}">
		<event type="oninit">
			<action type="datarun reader" value="~dtNarudzbeGrid" />
			<action type="variable value">
				<parameter name="Broj" value="~dtNarudzbeGrid.@BrojDokumentaId" />
				<parameter name="Dobavljač" value="~dtNarudzbeGrid.@DobavljacId" />
			</action>
		</event>
		<event type="onload">
			<action type="control populate" value="#grdNarudzbe" />	
		</event>
		<layout>
			<group cols="1" rows="1" col="1" row="1">
					<item row="1" col="1">
				<grid name="grdNarudzbe" dataname="~dtNarudzbeGrid">
					<fields inherited="true">
						<field name="DobavljacId" caption="Dobavljač" />
						<field name="Šifra1000" caption="Šifra" />
						<field name="Roba2000" caption="Roba" />
						<field name="Količina1000" caption="Količina" />
						<field name="JM0750" caption="JM" />
						<field name="Rabat" caption="Rabat" />
						<field name="Rabat2" caption="Rabat2" />
						<field name="Rabat3" caption="Rabat3" />
						<field name="Nabavna cijena1000" caption="Nabavna cijena" />
						<field name="Klasa robe1500" caption="Klasa robe" />
						<field name="Opis" caption="Opis" />
					</fields>
				</grid>
					</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" type="cancel" caption="IZLAZ" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_StoNaruciti_PrikazNarudzbe" name="dtNarudzbeGrid">
				<parameter name="@id" value="$NabNarGlaId" />
			</data>
		</datalist>
	</form>
	<form name="frmZahtjevNew" caption="Novi zahtjev">
		<event type="init">
			<action type="datarun reader" value="~dtOrgShema"/>
		</event>
		<event type="shown">
			<action type="control focus" value="#datDatum" />
		</event>
		<layout>
		<group col="1" row="1" cols="2" rows="6" bordervisible="false">
      			<item col="1" row="1"  caption="Broj:" highlight="false">
        <textedit name="txtBroj" datavalue="" fontbold="true" nulltext="&lt;novi dokument&gt;"/>
      </item>
      <item col="2" row="1" caption="Datum:" highlight="false">
        <dateedit name="datDatum" value="now" required="true" function="datum"></dateedit>
      </item>
      <item col="1" row="2" colspan="2"  caption="Organizacijska jedinica:" highlight="false">
        <comboedit name="cmbOrgShema" value="1" dataname="~dtOrgShema" displayfield="Naziv" valuefield="OrgShemaID"   required="true"/>
      </item>
      <item col="1" row="3" colspan="2"  caption="Odgovorna osoba:" highlight="false">
       <comboedit name="cmbOdgOsoba" dataname="~dtOsobe" displayfield="Naziv" valuefield="Osobeid"   required="true"/>
      </item>
      <item col="1" row="4" caption="Datum isporuke:" highlight="false" required="true" colspan="2">
        <dateedit name="datDatumIsporuke" value="now" required="true" function="datum"></dateedit>
      </item>
      <item col="1" row="5" caption="Dobavljač:" colspan="2">
			<searchedit name="srcPartner" dataname="~dtPartneri" fontsizedelta="1" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" function="srcPartner" savevalue="app"/>
		</item>	
      <item col="1" row="6" colspan="2"  caption="Opis:" highlight="false">
        <memoedit name="txtOpis" maxlength="20" datavalue="" ></memoedit>
      </item>
    </group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="&amp;UNESI" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtZahtjevUnos">
								<parameter name="idnabzah" />
						</action>
						<action type="form close" />
						<action type="form open" value="frmNoviKreiraniZahtjev">
								<parameter name="nabzahglaid" value="$idnabzah" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="&amp;IZLAZ" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			
			<data command="spNab_StoNaruciti_OrgShema" name="dtOrgShema" >
				<parameter name="@operateriid" value="@@operateriid" />
			</data>	
			<data command="spNab_StoNaruciti_OdgovorneOsobeGet" name="dtOsobe" />	
			<data command="spNabStoNarMinMaxAzurNG" name="dtZahtjevUnos">
				<parameter name="@action" value="3" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@datumdok" value="#datDatum" />
				<parameter name="@partneriid" value="#srcPartner" />
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@ProNacinIsporukeID" value="#cmbNacinIsporuke" />
				<parameter name="@datumisporuke" value="#datDatumIsporuke" />
			    <parameter name="@OrgShemaID" value="#cmbOrgShema" />
			    <parameter name="@osobeid" value="#cmbOdgOsoba" />
			    <parameter name="@KntNacinPlacId" value="null" />
			    <parameter name="@PotvrdaInd" value="1" if="#chkPotvrda==True" />
			    <parameter name="@potvrdaInd" value="0" if="#chkPotvrda==False" />
			    <parameter name="@Cjenikid" value="null" />
			    <parameter name="@ZVrstaDokId" value="" />
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
		</datalist>
	</form>
	<form name="frmNoviKreiraniZahtjev" caption="Zahtjev za nabavu br: {$Broj} - {$Dobavljač}">
		<event type="oninit">
			<action type="datarun reader" value="~dtNabZahGrid" />
			<action type="variable value">
				<parameter name="Broj" value="~dtNabZahGrid.@BrojDokumentaId" />
				<parameter name="Dobavljač" value="~dtNabZahGrid.@DobavljacId" />
			</action>
		</event>
		<event type="onload">
			<action type="control populate" value="#grdNabZah" />	
		</event>
		<layout>
			<group cols="1" rows="1" col="1" row="1">
					<item row="1" col="1">
				<grid name="grdNabZah" dataname="~dtNabZahGrid">
					<fields inherited="true">
						<field name="DobavljacId" caption="Dobavljač" />
						<field name="Šifra1000" caption="Šifra" />
						<field name="Roba2000" caption="Roba" />
						<field name="Količina1000" caption="Količina" />
						<field name="JM0750" caption="JM" />
						<field name="Klasa robe1500" caption="Klasa robe" />
						<field name="Opis" caption="Opis" />
					</fields>
				</grid>
					</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" type="cancel" caption="IZLAZ" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_StoNaruciti_PrikazZahtjeva" name="dtNabZahGrid">
				<parameter name="@id" value="$NabZahGlaId" />
			</data>
		</datalist>
	</form>
</root>