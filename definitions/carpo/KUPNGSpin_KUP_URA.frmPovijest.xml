<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: POVFORM (NetGen) → frmPovijest (Carpo) -->
<root version="1.2">
  <form name="frmPovijest" caption="Povijest" type="dialog" width="900" height="600" fixedsize="false" saveformsize="true">
    <event type="shown">
      <action type="datarun reader" value="~dtPovijest"/>
      <action type="control populate" value="#grdPovijest"/>
    </event>

    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1">
          <grid name="grdPovijest" dataname="~dtPovijest" bestfitonrefresh="true" showautofilterrow="true" savelayout="true">
            <fields inherited="true"/>
          </grid>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="ZATVORI" dock="right" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtPovijest" command="spKUPPrometQueryN" timeout="300">
        <parameter name="@action" value="2"/>
        <parameter name="@ID" value="$Id"/>
      </data>
    </datalist>
  </form>
</root>

