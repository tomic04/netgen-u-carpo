<?xml version="1.0" encoding="utf-8"?>
<root version="1.0.1." loglevel="3">
	<form type="master" name="frmGlavni" caption="Način plaćanja" maximized="true" saveformsize="false">
		<event type="load">
			<action type="control populate" value="#grdGlavni"/>
		</event>
		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
			<item col="1" row="1">
			<grid name="grdGlavni" type="master" dataname="~dtGlavni" key="KntNacinPlacId" >
				<event type="doubleclick">
					    <action type="form open" value="frmIzmijeni">
							<parameter name="KntNacinPlacId" value="#grdGlavni.@KntNacinPlacId"/>
							<!-- <parameter name="IndUnosa" value="0"/> -->
						</action>
						<action type="control populate keepfocus" value="#grdGlavni"/>
				</event>
				<fields>
					<field name="KntNacinPlacId" caption ="KntNacinPlacId" visible="false" />
					<field name="Naziv" caption="Naziv"/>
				</fields>
			</grid>
			</item>
			</group>
		</layout>
		<panelbuttons >
			<buttons>
				<button name="btnDodaj" caption="DODAJ">
					<event type="click">	
						<action  type="form open" value="frmUnos">
							<!-- <parameter name="IndUnosa" value="1"/> -->
						</action>	
						<action type="control populate" value="#grdGlavni"/>
						<action type="datarun scalar" value="~dtDodaj">
						</action>
						<action type="control focus" value="#grdGlavni">
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI">
					<event type="click">	
						<action  type="form open" value="frmIzmijeni">
							<parameter name="KntNacinPlacId" value="#grdGlavni.@KntNacinPlacId"/>
							<!-- <parameter name="IndUnosa" value="0"/> -->
						</action>
						<action type="control populate keepfocus" value="#grdGlavni"/>
						</event>
				</button>
				<button name="btnObriši" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati {#grdGlavni.@Opis}?">
							<action type="datarun nonquery" value="~dtObriši"/>
						</action>
						<action type="control populate keepfocus" value="#grdGlavni"/>
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdGlavni"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGlavni" command="spCKntNacinPlacQuery">
				<parameter name="@Action" value="0"/>
				<parameter name="@ID" value="@KntNacinPlacId"/>
			</data>
			<data name="dtObriši" command="spCKntNacinPlacAzur">
				<parameter name="@Action" value="2"/>
				<parameter name="@ID" value="#grdGlavni.@KntNacinPlacId"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
			</data>
			<data name="dtIzmjeni" command="spCKntNacinPlacAzur">
				<parameter name="@Action" value="1"/>
			    <parameter name="@ID" value="@KntNacinPlacId"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
			</data>	
		</datalist>
	</form>
	<form name="frmUnos" caption="Dodaj način plaćanja" width="500" >
		<event type="init">
			<action type="datarun reader" value="~dtget"/>
		</event>
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="1" caption="Naziv:" textposition="left" >
					<textedit name="txtNaziv" maxlength="25" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtAzur"/>
						<action type="form close"/>
					</event>		
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtAzur" command="spCKntNacinPlacAzur">
				<parameter name="@Action" value="0" />
				<parameter name="@ID" value="$KntNacinPlacId"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
			</data>
			<data name="dtGet" command="spCKntNacinPlacQuery">
				<parameter name="@Action" value="0"/>
				<parameter name="@ID" value="@KntNacinPlacId"/>
			</data>
		</datalist>
	</form>
	<form name="frmIzmijeni" caption="Izmijeni način plaćanja" width="500">
		<event type="init">
			<action type="datarun reader" value="~dtGet">
			</action>
		</event>
		<layout textposition="top">	
			<group rows="1" cols="1">
				<item col="1" row="1" caption="Naziv:" textposition="left" >
					<textedit name="txtNaziv" maxlength="25" datavalue="~dtGet.Naziv" />
				</item>
			</group>
		</layout>  
		<panelbuttons> 
			<buttons> 
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtAzur"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">
						<action type="variable value" value="global.$Close" > 
							<parameter value="true" type="bool"/> 
						</action> 
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons> 
		<datalist>
			<data name="dtAzur" command="spCKntNacinPlacAzur">
				<parameter name="@Id" value="$KntNacinPlacId"/>
				<parameter name="@Action" value="1"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
			</data>
			<data name="dtGet" command="spCKntNacinPlacQuery">
				<parameter name="@Action" value="1"/>
				<parameter name="@ID" value="$KntNacinPlacId"/>
			</data>
		</datalist>
	</form>
</root>