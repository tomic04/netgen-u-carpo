			<parameter name="@VrstaPromSifra" value="126"/>
		</data>
		<data command="spSklad_Part_Det_Donos" name="dtPartDetDonos">		
			<parameter name="@VrstaPromSifra" value="126"/>
			<parameter name="@OperateriId" value="@@OperateriId" />			
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>			
		</data>	
		<data command="spSklad_Part_Vaga_Donos" name="dtPartVagaDonos">		
			<parameter name="@VrstaPromSifra" value="73"/>
		</data>		
		<data command="spSklad_Pubvars_Defaults" name="dtPubvars">
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>
		</data>			
	</datalist>
