	<datalist>
		<part name="partGlobalneStore" path="prtSklad_GlobalneStore.xml" />
		<data command="spSklad_VrstaProm" name="dtVrstaProm">
			<parameter name="@Sifra" value="126"/>
		</data>
		<data command="spSklad_Part_DetailGrid" name="dtPartDetailGrid">
			<parameter name="@operateriid" value="@@operateriid"/>
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>
			<parameter name="@VrstaPromSifra" value="126"/>			
		</data>	
		<data command="spSklad_Part_Kontrole_Gla" name="dtPartGlaKontrole">		
			<parameter name="@VrstaPromSifra" value="126"/>
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>
		</data>
		<data command="spSklad_Part_Kontrole_Gla" name="dtPartGlaLayout">		
			<parameter name="@VrstaPromSifra" value="126"/>
			<parameter name="@ind" value="update"/>
			<parameter name="@operateriid" value="@@operateriid"/>
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>
		</data>	
		<data command="spSklad_Part_Kontrole_Det" name="dtPartDetLayout">		
			<parameter name="@VrstaPromSifra" value="126"/>
			<parameter name="@operateriid" value="@@operateriid"/>
			<parameter name="@ImeGranule" value="Sklad_PovratnicaSitni" type="string"/>			
