<root>
	<form name="frmGlavna" type="master" caption="Vrste troškova">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtNapuniGrid" multiselect="true" fixed="true">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjena">
						<parameter name="UgovoriNajamVrsteTroskovaId" value="#grdGlava.@UgovoriNajamVrsteTroskovaId" />
					</action>
				</event>
				<fields inherited="true">
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnesi" />
					</event>
				</button>

				<button name="btnIzmjeni" caption="IZMIJENI">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="UgovoriNajamVrsteTroskovaId" value="#grdGlava.@UgovoriNajamVrsteTroskovaId" />
						</action>
					</event>
				</button>

				<button name="btnObrisi" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />

						<action type="datarun nonquery" value="~dtDelete">
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
			</buttons>

		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamVrsteTroskova_Query" name="dtNapuniGrid" />
			<data command="spUgovoriNajamVrsteTroskova_delete" name="dtDelete">
				<parameter name="@UgovoriNajamVrsteTroskovaId" value="#grdGlava.@UgovoriNajamVrsteTroskovaId" />
			</data>
		</datalist>
	</form>

	<form name="frmUnesi" caption="Unesi"> 
		<layout>
			<group cols="1" rows="1" col="1" row="1">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtVrstaTroska" required="true"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtInsertVrstaTroska" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamVrsteTroskova_Insert" name="dtInsertVrstaTroska">
				<parameter name="@naziv" value="#txtVrstaTroska" />
			</data>
		</datalist>
	</form>

	<form name="frmIzmjena" caption="Izmijeni">

		<event type="init">
				<action type="datarun reader" value="dtGet" />
		</event>

			<layout>
				<group cols="1" rows="1">
					<item col="1" row="1" caption="Naziv:">
						<textedit name="txtNaziv" datavalue="~dtGet.@naziv" required="true"/>
					</item>
				</group>

			</layout>

			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="Spremi">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="~dtIzmjeni" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" value="frmUnos"/>
						</event>
					</button>
					<button name="btnOdustani" type="cancel" caption="Odustani" dock="right" />
				</buttons>
			</panelbuttons>

			<datalist>
				<data command="spUgovoriNajamVrsteTroskova_EditQuery" name="dtGet">
					<parameter name="@UgovoriNajamVrsteTroskovaId" value="$UgovoriNajamVrsteTroskovaId" />
				</data>

				<data command="spUgovoriNajamVrsteTroskova_edit" name="dtIzmjeni">
						<parameter name="@UgovoriNajamVrsteTroskovaId" value="$UgovoriNajamVrsteTroskovaId" />
						<parameter name="@Naziv" value="#txtNaziv" />
				</data>
			</datalist>	
	</form>
</root>