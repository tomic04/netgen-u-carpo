<root>
	<form name="frmPovezaniDokumenti" caption="Povezani dokumenti" width="895" height="760" fixedsize="true">
        <event type="onload">
			<action type="control value" value="#cusGrafko">
				<parameter name="GlaID" value="$GlaId" type="int"/>
				<parameter name="NazivTablice" value="$Tablica" type="string"/>
				<parameter name="OperateriId" value="@@OperateriId" type="int"/>
			</action>
       </event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" groupbordervisible="false"> -->
				<item row="1" col="1" textvisible="false" highlight="False">
					<customcontrol name="cusGrafko" dll="Carpo.Specific" class="Carpo.Specific.Grafko.Grafko" initonmaster="true"/> 				
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIspisiDok" caption="Is&amp;piši dokument" dataname="~dtPrint" displayfield="Opis">
					<event type="click">
						<action type="control print" value="parent.#grdMaster">
							<action type="print template" value="#btnIspisiDok.@Template">
								<parameter name="id" value="#cusGrafko.@SelectedId" />
							</action>
						</action>
					</event>
				</button>
				<button caption="Izlaz" name="btnOdustani" type="cancel" dock="left"/>
			</buttons>
		</panelbuttons>	
		<datalist>
			<data command="spKomercStanjeSklad_Ispis" name="dtPrint">
				<parameter name="@vrstadokid" value="#cusGrafko.@VrstaDokId" type="int"/>
				<parameter name="@dokid" value="#cusGrafko.@SelectedId" type="int"/>
			</data>				
		</datalist>		
	</form>
</root>