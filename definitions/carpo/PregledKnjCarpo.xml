     <!-- </event> -->
     <!--forme iz temeljnica-->
	<form name="frmTemEdit" path="Temeljnice.frmTemEdit.xml"/>
	<form name="frmTemStavka" path="Temeljnice.frmTemStavka.xml"/>
	<form name="frmTemStavkaEdit" path="Temeljnice.frmTemStavkaEdit.xml"/>
	<form name="frmTemIra" path="Temeljnice.frmTemIra.xml"/>
	<form name="frmTemUra" path="Temeljnice.frmTemUra.xml"/>
	<form name="frmTemKntOstalo" path="Temeljnice.frmTemKntOstalo.xml"/>
     <form name="master" type="master" caption="Pregled dnevnika knjiženja">
          <!--pozivanje parametar forme pri inicijalizaciji glavne forme-->
          <event type="init">

               <action type="datarun scalar" value="Global.~dtNazivFirme">
                    <parameter name="NazivFirme"/>
               </action>
               <action type="variable value">
                    <parameter name="Global.$DatumOd" value="null"  />
                    <parameter name="Global.$DatumDo" value="null"  />
                    <parameter name="Global.$Datum" value="1"  />
                    <parameter name="Global.$VrstaDatuma" value="null"  />
                    <parameter name="Global.$NacinPlac" value="null" type="int" />
                    <parameter name="Global.$Broj" value="null"  />
                    <parameter name="Global.$PartneriId" value="null"  />
                    <parameter name="Global.$DioKonta" value="null"  />
                    <parameter name="Global.$Konto" value="null"  />
                    <parameter name="Global.$VrstaPromId" value="null"   />
                    <parameter name="Global.$OrgShemaId" value="null"  />
                    <parameter name="Global.$DimVrsteId" value="null"  />
                    <parameter name="Global.$DimenzijeId" value="null"  />
                    <parameter name="Global.$VrstaDokId" value="null"  />
                    <parameter name="Global.$OperaterId" value="null"  />
                    <parameter name="Global.$Iznos" value="null"  />
                    <parameter name="Global.$PartneriNaziv" value="null" />
                    <parameter name="Global.$NacPlacNaziv" value="null" />
                    <parameter name="Global.$KontoOznaka" value="null" />
                    <parameter name="Global.$VrstaPromNaziv" value="null" />
                    <parameter name="Global.$OrgShemaNaziv" value="null" />
                    <parameter name="Global.$DimVrsteNaziv" value="null" />
                    <parameter name="Global.$DimenzijeNaziv" value="null" />
                    <parameter name="Global.$VrstaDokNaziv" value="null" />
                    <parameter name="Global.$OperaterNaziv" value="null" />
                    <parameter name="global.$Close" value="false" type="bool"/>
					<parameter name="global.$IndSume" value="0" type="int"/>						
               </action>
          </event>
          <event type="load">
          </event>
          <event type="shown">
				<action type="form open" value="frmFilter"/>
               <action type="variable value" value="global.$Close" if="dialogresult==cancel">
                    <parameter value="true" type="bool"/>
               </action>
               <action type="form close" if="global.$Close==true"/>
          </event>
          <managerlayout>

               <grid name="grdGrid" async="true" type="master" autopopulate="false" key="" bestfitonrefresh="True"  multiselect="true" dataname="dtMaster" savelayout="true" >
                    <!--printcaption="Pregled prometa za period od {Global.$DatumOd::dd.MM.yyyy.} do {Global.$DatumDo::dd.MM.yyyy}"-->
                    <fields inherited="true">
                         <!--<field name="Vrd" caption="Vrsta Dokumenta"/> -->
                         <field name="DatumUnosa"  caption="Datum unosa" formatstring="dd.MM.yyyy. HH:mm"/>
                         <field name="KntPrometId"  caption="KntPrometId" visible="true"/>
                         <field name="Konto" showtotalsum="false" showgroupsum="false"/>
                         <field name="Brojdok" showtotalsum="false" showgroupsum="false"/>
                    </fields>
                    <print caption="Pregled dnevnika knjiženja" header="{$NazivFirme}\nPregled prometa za period od {Global.$DatumOd::dd.MM.yyyy.} do {Global.$DatumDo::dd.MM.yyyy}\nVrsta Datuma: {Global.$VrstaDatuma}\n"
					subheader="Broj dokumenta: {Global.$Broj}	Partner: {Global.$PartneriNaziv} Način plaćanja: {Global.$NacPlacNaziv} Dio konta: {Global.$DioKonta} Konto: {Global.$KontoOznaka} Vrsta prometa: {Global.$VrstaPromNaziv}
						Vrsta dok: {Global.$VrstaDokNaziv} Org shema: {Global.$OrgShemaNaziv} Vrste dimenzije: {Global.$DimVrsteNaziv} Dimenzije: {Global.$DimenzijeNaziv} Operater: {Global.$OperaterNaziv} Iznos: {Global.$Iznos}\n"
				     captionalign="center">
                    </print>
               </grid>
          </managerlayout>

          <panelbuttons>
               <buttons>
                    <button name="btnParametri" caption="Parametri" >
                         <event type="click">
                              <action type="form open" value="frmFilter"/>
                         </event>
                    </button>
                    <button name="btnDokument" caption="&amp;DOKUMENT" begingroup="true">
					<event type="click">
                              <action type="message" value="Potrebno je označiti samo jednu stavku!" if="#grdGrid.selectedrowscount!=1"/>
						<action type="datarun reader" value="~dtStorno"  if="#grdGrid.selectedrowscount==1"/>
						<action type="form open" value="frmTemEdit" if="#grdGrid.selectedrowscount==1">
							<parameter name="KntTemId" value="#grdGrid.@KntTemId"/>
							<parameter name="KarticaKontaInd" value="1"/>
							<parameter name="Sifra" value="~dtStorno.@sifra"/>
                                   <!-- onemogucena izmjena temeljnice -->
                                   <parameter name="ZakljInd" value="1"/>
						</action>
                             
					</event>
				</button>
                    <button name="btnIspis" caption="ISPIS SUČELJA">
                         <event type="click">
                              <action type="control printcontrol" value="#grdGrid"/>
                         </event>
                    </button>
               </buttons>
          </panelbuttons>
          <datalist>
               <data command="spCKntPregledPrometa" name="dtMaster" timeout="400">
                    <!--				<parameter name="@Action" value="Global.$Datum" /> 
				<parameter name="@DatumOd" value="Global.$DatumOd" /> 
				<parameter name="@DatumDo" value="Global.$DatumDo" /> 
				<parameter name="@IDVRD" value="Global.$VrstaDokId" />  
				<parameter name="@IDOrg" value="Global.$OrgShemaId"/> 
				<parameter name="@IDPAR" value="Global.$PartneriId"/> 
				<parameter name="@IDOper" value="Global.$OperaterId"/> 
				<parameter name="@BrojDok" value="Global.$Broj"/> 
				<parameter name="@IDVRP" value="Global.$VrstaPromId"/> 
				<parameter name="@KntPlanAid" value="Global.$Konto"/> 
				<parameter name="@Konto" value="Global.$DioKonta"/> 
				<parameter name="@DimVrsteId" value="Global.$DimVrsteId"/> 
				<parameter name="@DimenzijeId" value="Global.$DimenzijeId"/>  
				<parameter name="@KntNacinPlacId" value="Global.$NacinPlac"/>  
				<parameter name="@Iznos" value="Global.$Iznos"/>  -->
					<parameter name="@Action" value="0" if="Global.$IndSume==1"/>
					<parameter name="@Action" value="Global.$Datum" else=""/> 
                    <parameter name="@DatumOd" value="Global.$DatumOd" />
                    <parameter name="@DatumDo" value="Global.$DatumDo" />
                    <parameter name="@IDVRD" value="Global.$VrstaDokId" />
                    <parameter name="@IDOrg" value="Global.$OrgShemaId"/>
                    <parameter name="@IDPAR" value="Global.$PartneriId"/>
                    <parameter name="@IDOper" value="Global.$OperaterId"/>
                    <parameter name="@BrojDok" value="Global.$Broj"/>
                    <parameter name="@IDVRP" value="Global.$VrstaPromId"/>
                    <parameter name="@KntPlanAid" value="Global.$Konto"/>
                    <parameter name="@Konto" value="Global.$DioKonta"/>
                    <parameter name="@DimVrsteId" value="Global.$DimVrsteId"/>
                    <parameter name="@DimenzijeId" value="Global.$DimenzijeId"/>
                    <parameter name="@KntNacinPlacId" value="Global.$NacinPlac"/>
                    <parameter name="@Iznos" value="Global.$Iznos"/>
					<parameter name="@BrojRacuna" value="Global.$BrojRacuna"/>
               </data>
               <data name="dtStorno" command="spCKntTemInfo">
				<parameter name="@Action" value="5"/>
				<parameter name="@KntTemId" value="#grdGrid.@KntTemId" type="int"/>
			</data>			
          </datalist>
     </form>

     <form caption="Pregled dnevnika knjiženja" name="frmFilter" width="1400" height="350" >
          <!-- fixedsize="true"-->
          <event type="load">
               <action type="datarun scalar" value="Global.~dtNazivPartnera">
                    <parameter name="NazivPar" />
               </action>
               <!--			<action type="message" value="{Global.$PartneriNaziv}"/>
			<action type="message" value="{$NazivPar}"/>-->
          </event>
          <event type="shown">
               <action type="variable value">
                    <parameter name="Global.$PartneriNaziv" value="$NazivPar"   />
               </action>
               <action type="datarun scalar" value="~dtPrviDanMjeseca">
                    <parameter name="StartOfYear" />
               </action>
               <action type="control value" value="#datDatumOd">
                    <parameter value="$StartOfYear"	if="Global.$DatumOd==null" />
                    <parameter value="Global.$DatumOd"	elseif="Global.$DatumOd!=null"/>
               </action>
               <action type="control value" value="#datDatumDo">
                    <parameter value="now" if="Global.$DatumDo==null" />
                    <parameter value="Global.$DatumDo" elseif="Global.$DatumDo!=null"/>
               </action>
               <action type="control value" value="#cmbDatum">
                    <parameter value="Global.$Datum" />
               </action>
               <action type="control value" value="#cmbNacinPlac">
                    <parameter value="Global.$NacinPlac" />
               </action>
               <action type="control value" value="#txtBrojDok">
                    <parameter value="Global.$Broj" />
               </action>
               <action type="control value" value="#srcPartner">
                    <parameter value="Global.$PartneriId" text="Global.$PartneriNaziv"/>
               </action>
               <action type="control value" value="#txtDioKonta">
                    <parameter value="Global.$DioKonta" />
               </action>
               <action type="control value" value="#cmbKonto">
                    <parameter value="Global.$Konto" />
               </action>
               <action type="control value" value="#cmbVrstaDok">
                    <parameter value="Global.$VrstaDokId" />
               </action>
               <action type="control value" value="#cmbVrstaProm">
                    <parameter value="Global.$VrstaPromId" />
               </action>
               <action type="control value" value="#cmbOrgShema">
                    <parameter value="Global.$OrgShemaId" />
               </action>
               <action type="control value" value="#cmbDimVrste">
                    <parameter value="Global.$DimVrsteId" />
               </action>
               <action type="control value" value="#cmbDimenzije">
                    <parameter value="Global.$DimenzijeId" />
               </action>

               <action type="control value" value="#cmbOperater">
                    <parameter value="Global.$OperaterId" />
               </action>
               <action type="control value" value="#txtIznos">
                    <parameter value="Global.$Iznos" />
               </action>
			     <action type="control value" value="#txtBrojRacuna">
                    <parameter value="Global.$BrojRacuna" />
               </action>
          </event>


          <layout textposition="top">
               <group rows="1" cols="1">
                    <group rows="4" cols="4" groupbordervisible="false">
                         <group rows="1" cols="3" col="1" row="1" colspan="2">
                              <item col="1" row="1" caption="Datum od:" fontsizedelta="2">
                                   <dateedit name="datDatumOd" required="true">
                                        <!-- <event type="valuechanged"> -->
                                        <!-- <action type="variable value"> -->
                                        <!-- <parameter name="DatumOd" value="#datDatumOd" /> -->
                                        <!-- </action> -->
                                        <!-- </event> -->
                                   </dateedit>
                              </item>
                              <item col="2" row="1" caption="Datum do:" fontsizedelta="2">
                                   <dateedit name="datDatumDo" value="now" required="true">
                                        <!-- <event type="valuechanged"> -->
                                        <!-- <action type="variable value"> -->
                                        <!-- <parameter name="DatumDo" value="#datDatumDo" /> -->
                                        <!-- </action> -->
                                        <!-- </event> -->
                                   </dateedit>
                              </item>
                              <item col="3" row="1"  caption=" " textvisible="false" fontsizedelta="2">
                                   <comboedit name="cmbDatum" dataname="Global.dtDatumCombo" displayfield="Naziv" valuefield="action" autopopulate="true" allownull="false">
                                   </comboedit>
                              </item>
                         </group>
                         <item col="3" row="1" colspan="2" caption="Način plaćanja"  fontsizedelta="2">
                              <comboedit name="cmbNacinPlac" dataname="Global.dtNacPlacCombo" displayfield="naziv" valuefield="kntnacinplacid" autopopulate="true" allownull="true">
                                   <event type="valuechanged">
                                        <action type="variable value">
                                             <parameter name="Global.$NacinPlac" value="#cmbNacinPlac"   />
                                        </action>
                                   </event>
                              </comboedit>
                         </item>
                         <item col="1" row="2"  caption="Broj dokumenta:" fontsizedelta="2" >
                              <textedit name="txtBrojDok" >
                              </textedit>
                         </item>
                         <item col="2" row="2" caption="Partner:" fontsizedelta="2" textvisible="false">
                              <searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" datavalue="Global.~dtNazivPartnera.@partneriid" datatext="Global.~dtNazivPartnera.@naziv" tabindex="0" >
                                   <event type="valuechanged">
                                        <action type="variable value">
                                             <parameter name="PartneriId" value="#srcPartner" />
                                        </action>
                                   </event>
                              </searchedit>
                         </item>
                         <item col="3" row="2"  caption="Dio konta:" fontsizedelta="2" >
                              <textedit name="txtDioKonta" >
                              </textedit>
                         </item>
                         <item col="4" row="2" caption="Konto:" fontsizedelta="2" textvisible="false">
                              <combomultiedit name="cmbKonto" valuefield="KntPlanAId" displayfield="Naziv" dataname="Global.~dtKontoCombo" fontsizedelta="2" allownull="true"/>
                              <!--					<searchedit  name="srcKonto" fieldtext="Naziv" fieldvalue="KntPlanAId" dataname="~dtTraziKonto" datavalue="~dtTraziKonto.@KntPlanAId" datatext="~dtTraziKonto.@Naziv" >
                        <event type="valuechanged">
							<action type="variable value">
								<parameter name="KntPlanAId" value="#srcKonto" />
							</action>
                        </event>
					</searchedit>-->
                         </item>
                         <item col="1" row="3"  caption="Vrsta Prometa:" fontsizedelta="2">
                              <combomultiedit name="cmbVrstaProm" dataname="Global.~dtVrstaPromCombo" displayfield="opis" valuefield="vrstapromid" autopopulate="true" allownull="true">
                                   <event type="leave">
                                        <action type="variable value">
                                             <parameter name="Global.$VrstaPromId" value="#cmbVrstaProm"   />
                                        </action>
                                        <action type="control populate" value="#cmbVrstaDok" />
                                   </event>
                              </combomultiedit>
                         </item>
                         <item col="2" row="3"  caption="Org. shema:" fontsizedelta="2">
                              <combomultiedit name="cmbOrgShema" dataname="Global.~dtOrgShemaCombo" displayfield="naziv" valuefield="orgshemaid" autopopulate="true" allownull="true">
                              </combomultiedit>
                         </item>
                         <item col="3" row="3"  caption="Vrste dimenzije:" fontsizedelta="2">
                              <comboedit name="cmbDimVrste" dataname="Global.~dtDimVrsteCombo" displayfield="naziv" valuefield="dimvrsteid" autopopulate="true" allownull="true">
                                   <event type="valuechanged">
                                        <!-- <action type="datarun reader" value="~dtDimenzijeCombo"/> -->
                                        <action type="control populate" value="#cmbDimenzije"/>
                                   </event>
                              </comboedit>
                         </item>
                         <item col="4" row="3"  caption="Dimenzije:" fontsizedelta="2">
                              <comboedit name="cmbDimenzije" dataname="Global.~dtDimenzijeCombo"  displayfield="oznaka" valuefield="dimenzijeid" autopopulate="true" allownull="true">
                              </comboedit>
                         </item>
                         <item col="1" row="4"  caption="Vrsta dok:" fontsizedelta="2" >
                              <combomultiedit name="cmbVrstaDok" dataname="Global.~dtVrstaDokCombo" displayfield="Opis" valuefield="VrstaDokId" allownull="true">
                                   <event type="valuechanged">
                                        <action type="variable value">
                                             <parameter name="Global.$VrstaDokId" value="#cmbVrstaDok"   />
                                        </action>
                                   </event>
                              </combomultiedit>
                         </item>
                         <item col="2" row="4"  caption="Operater:" fontsizedelta="2">
                              <comboedit name="cmbOperater" dataname="Global.~dtOperaterCombo" displayfield="naziv" valuefield="operateriid" autopopulate="true" allownull="true">
                              </comboedit>
                         </item>
                         <item col="3" row="4"  caption="Traži iznos:" fontsizedelta="2">
                              <textedit name="txtIznos" value="0" format="n2" >
                              </textedit>
                         </item>
						 <item col="4" row="4"  caption="Broj računa:" fontsizedelta="2">
                              <textedit name="txtBrojRacuna"  >
                              </textedit>
                         </item>
                    </group>
               </group>
          </layout>
          <datalist>
               <data type="text" name="dtPrviDanMjeseca" command="SELECT DATEADD(m, DATEDIFF(m, 0, GETDATE()), 0) as StartOfYear"/>
          </datalist>

          <panelbuttons>
               <buttons>
                    <button name="btnSpremi" caption="Pokaži">
                         <event type="click">
                              <!--<action type="validate"/>-->
                              <action type="variable value">
                                   <parameter name="Global.$DatumOd" value="#datDatumOd"  />
                                   <parameter name="Global.$DatumDo" value="#datDatumDo"  />
                                   <parameter name="Global.$Datum" value="#cmbDatum"  />
                                   <parameter name="Global.$NacinPlac" value="#cmbNacinPlac" type="int" />
                                   <parameter name="Global.$Broj" value="#txtBrojDok"  />
                                   <parameter name="Global.$PartneriId" value="#srcPartner"  />
                                   <parameter name="Global.$DioKonta" value="#txtDioKonta"  />
                                   <parameter name="Global.$Konto" value="#cmbKonto"  />
                                   <parameter name="Global.$VrstaPromId" value="#cmbVrstaProm"  />
                                   <parameter name="Global.$OrgShemaId" value="#cmbOrgShema" />
                                   <parameter name="Global.$DimVrsteId" value="#cmbDimVrste"  />
                                   <parameter name="Global.$DimenzijeId" value="#cmbDimenzije"  />
                                   <parameter name="Global.$VrstaDokId" value="#cmbVrstaDok"  />
                                   <parameter name="Global.$OperaterId" value="#cmbOperater"  />
                                   <parameter name="Global.$Iznos" value="#txtIznos"  />
                                   <parameter name="Global.$PartneriNaziv" value="#srcPartner.@Naziv"/>
                                   <parameter name="Global.$VrstaDatuma" value="#cmbDatum.@Naziv"/>
                                   <parameter name="Global.$NacPlacNaziv" value="#cmbNacinPlac.@Naziv" />
                                   <parameter name="Global.$KontoOznaka" value="#cmbKonto.@konto" />
                                   <parameter name="Global.$VrstaPromNaziv" value="#cmbVrstaProm.@opis" />
                                   <parameter name="Global.$OrgShemaNaziv" value="#cmbOrgShema.@naziv" />
                                   <parameter name="Global.$DimVrsteNaziv" value="#cmbDimVrste.@naziv" />
                                   <parameter name="Global.$DimenzijeNaziv" value="#cmbDimenzije.@oznaka" />
                                   <parameter name="Global.$VrstaDokNaziv" value="#cmbVrstaDok.@Opis" />
                                   <parameter name="Global.$OperaterNaziv" value="#cmbOperater.@Naziv" />
								   <parameter name="Global.$BrojRacuna" value="#txtBrojRacuna"  />
                              </action>
                              <action type="form close"/>
								<!--TEMP BUGFIX SUME NA GRUPAMA-->
								<action type="variable value">	
									<parameter name="Global.$IndSume" value="1" type="int"/>				
								</action>					
								<action type="control populate" value="parent.#grdGrid"/>
								<action type="variable value">	
									<parameter name="Global.$IndSume" value="0" type="int"/>				
								</action>			
								<!--TEMP BUGFIX SUME NA GRUPAMA-->							  
                              <action type="control populate" value="parent.#grdGrid" />
                              <!-- <parameter name="DatumOd" value="#datDatumOd"/> -->
                              <!-- <parameter name="DatumDo" value="#datDatumDo"/> -->
                              <!-- <parameter name="PartneriId" value="#srcPartneri"/> -->
                              <!-- <parameter name="IBAN" value="#cmbIBAN"/> -->
                              <!-- </action> -->

                         </event>
                    </button>
                    <button caption="Odustani" type="cancel" name="btnOdustani">
                         <event type="click">
                              <action type="variable value" value="global.$Close" >
                                   <parameter value="true" type="bool"/>
                              </action>
                              <action type="form close"/>
                         </event>
                    </button>
               </buttons>
          </panelbuttons>


     </form>

     <form name="frmInfoDisabled"  caption="Info" >

          <layout textposition="top" >
               <group cols="1" rows="1" >
                    <group cols="1" rows="1" groupbordervisible="false">
                         <item col="1" row="1" caption="Ova funkcionalnost trenutno nije dostupna, molim kontaktirajte Spin!">
                         </item>
                    </group>
               </group>
          </layout>
          <panelbuttons>
               <buttons>
                    <button name="btnOdustani" caption="OK" dock="right" type="cancel">
                    </button>
               </buttons>
          </panelbuttons>
     </form>

     <datalist>
          <data command="spCKntPregledPrometa" name="dtDatumCombo">
               <parameter name="@Action" value="5"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtNacPlacCombo">
               <parameter name="@Action" value="6"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtVrstaPromCombo">
               <parameter name="@Action" value="7"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtOrgShemaCombo">
               <parameter name="@Action" value="8"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtDimVrsteCombo">
               <parameter name="@Action" value="9"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtDimenzijeCombo">
               <parameter name="@Action" value="10"/>
               <parameter name="@DimVrsteId" value="#cmbDimVrste"/>
          </data>
          <data command="spCKntPregledPrometa" name="dtVrstaDokCombo">
               <parameter name="@Action" value="11"/>
               <parameter name="@IDVRP" value="Global.$VrstaPromId"/>
