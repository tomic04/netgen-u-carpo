<root version="1.1">
  
  <!--1.1. MZ - maxlength na oznaka-->
  
  <form name="frmMaster" type="master" caption="Amortizacijske grupe">

    <managerlayout>
      <tree name="tree"  allowselfdrag="true" dataname="dtOSGrupetree" showcolumns="true" showautofilterrow="false" expandallonload="true" bestfitonrefresh="true" expandedlevel="2">
        <fields>
          <field name="Naziv" />
		  <field name="Oznaka" />
		  <field name="Redovna" />
		  <field name="Ubrzana" />
		  <field name="Umanjena" />
		  <field name="Konto nabave" />
		  <field name="Konto pripreme" />
		  <field name="Konto ispravka" />
		  <field name="Konto troška" />
         </fields>
      </tree>

    </managerlayout>

    <panelbuttons displaycontrolsprint="false">


      <!--Za drag and drop spremanje/odustajanje-->
      <buttons type="tree">
        <button name="btnDrag" caption="Spremi promjene" type="selfdrag" function="SpremiPromjeneGrupe">
          <event type="click">
            <action type="datarun nonquery" value="~dtOsGrupeAzur" />
            <action type="control defaultmode" value="#tree" />
          </event>
        </button>

        <button name="btnDrag" caption="Odustani" type="selfdragcancel">
          <event type="click">
            <action type="confirm" value="Želite odustati od reorganizacije?">
              <action type="control populate" value="#tree" />
              <action type="control dragmode" value="#tree" />
            </action>
          </event>
        </button>
        <button name="btnUnesi" caption="Unos nove grupe" type="add" begingroup="true" function="UnesiGrupe">
          <event type="click">
            <action type="form open" value="frmGrupeUnos">
			  <parameter name="Caption" value="Unos nove amortizacijske grupe"/>
			  <parameter name="Tip" value="Unos novo"/>
			  <parameter name="OSGrupeId" type="int" value="0"/>
            </action>
			<action type="control populate keepfocus" value="#tree" />
          </event>
        </button>

        <button name="btnEdit" caption="Izmjena grupe" type="edit" function="IzmijeniGrupe">
          <event type="click">
            <action type="form open" value="frmGrupeUnos" if="#tree.@Id!=-1">
			  <parameter name="Caption" value="Izmjena amortizacijske grupe"/>
			  <parameter name="Tip" value="Izmjena"/>
			  <parameter name="OSGrupeId" value="#tree"/>
            </action>
            <action type="control populate keepfocus" value="#tree" />
          </event>
        </button>

        <button name="btnDelete" caption="Brisanje grupe" type="delete" function="ObrisiGrupe">
          <event type="click">
            <action type="confirm" value="Jeste li sigurni da želite obrisati grupu?" if="#tree.@ID!=-1">
              <action type="datarun nonquery" value="~dtOsGrupeDelete" />
            </action>
            <action type="control populate keepfocus" value="#tree" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSGrupeQueryCP" name="dtOSGrupetree">
        <parameter name="@Action" value="getTree" />
      </data>
      <data command="spOsGrupeTreeAzurCP" name="dtOsGrupeAzur">
        <parameter name="@Action" value="setTree" />
        <parameter name="@TableVar" value="#tree.datasource" />
      </data>
	  <data command="spOsGrupeAzurCP" name="dtOsGrupeDelete">
		<parameter name="@Action" value="brisanje" />
		<parameter name="@OsGrupeID" value="#tree"/>
		<parameter name="@Naziv" value="#txtNaziv" />
		<parameter name="@Oznaka" value="#txtOznaka" />
	  </data>
    </datalist>
  </form>

	<!--FORMA ZA UNOS/IZMJENU GRUPE-->

	<form name="frmGrupeUnos" path="frmGrupeUnos.xml"/>
</root>