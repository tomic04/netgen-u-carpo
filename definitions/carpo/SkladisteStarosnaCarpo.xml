<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="master" type="master" caption="Starosna Struktura Zaliha">
			<event type="init">
				<action type="variable value" >
					<parameter name="NoviId" value="0" type="int"/>
				</action> 
				<action type="variable value" >
					<parameter name="Act" value="1" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="SkladisteId" value="null" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="MasterRobaId" value="null" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="RobaDio" value="null" type="string"/>
				</action>
				<action type="variable value" >
					<parameter name="RobaId" value="null" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="RobaNaziv" value="null" type="string"/>
				</action>
				<action type="variable value" >
					<parameter name="MarkaId" value="null" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="Datum" value="now" type="datetime"/>
				</action> 
				<action type="variable value" >
					<parameter name="NeRobno" value="0" type="int"/>
				</action>
				<action type="variable value" >
					<parameter name="IspodKlasa" value="0" type="int"/>
				</action> 
				<action type="variable value" >
					<parameter name="RekapId" value="null" type="int"/>
				</action> 				
			</event>       
	
		<event type="shown">
			<action type="form open" value="frmFilter">
			</action>
				<action type="control populate" value="#grdGrid">
				</action>
		</event>
		<managerlayout>

			<grid name="grdGrid" dataname="dtGrid" key="" type="master" bestfitonrefresh="True" showgroupedcolumns="true" showfooter="true">

			<fields  inherited="true">
				<!-- <field name="!S0500" caption="S" groupindex="0"/> -->
				<field name="!S0500" caption="S" visible="false" /> 
				<field name="Skladište/Trgovina" caption="Skladište/Trgovina" visible="true" if="$Act==1"/>
				<field name="Šifra" caption="Šifra" visible="true" if="$Act==1"/>
				<field name="Roba" caption="Roba" visible="true" if="$Act==1"/>
				<field name="RUC%" caption="RUC%" visible="true" showtotalsum="false" />
				<field name="Zadnji Izlaz dana" caption="Zadnji Izlaz dana" visible="true" showtotalsum="false"/>
				<field name="loadgridsettings"  visible="false" />
			</fields>
			
				<styles>
					<style name="fontcolor" value="red" if="#grdGrid.@Formatid==R" />
					<style name="bold" value="true" if="#grdGrid.@Formatid==B" />

				</styles>
			

			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="PARAMETRI" >
				<event type="click">
					<action type="form open" value="frmFilter">
					</action>
						<action type="control populate" value="#grdGrid">
						</action>
					</event>
				</button>

				<button name="btnIzmijeni" caption="REKAPITULACIJA" width="120">
				<event type="click">
					<action type="form open" value="frmRekap">
					</action>
					<action type="control populate" value="#grdGrid">
					</action>
				</event>
				</button>

				<button name="btnIspis" caption="ISPIS" >
					<event type="click">
						<action type="control printcontrol" value="#grdGrid"/>
					</event>
				</button>
				
				<button name="btnKraj" caption="KRAJ" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
				<button name="btnHelp" caption="UPUTI ME" />
				
				
			</buttons>
		</panelbuttons>
		<datalist>
		<data command="spProd_SktStarosnaStruktura"  name="dtGrid" if="$Act==1" timeout="200">
			<parameter name="@Action" value="1" />
			<parameter name="@RobaId" value="$RobaId" />
			<parameter name="@skladisteid" value="$SkladisteId" />
			<parameter name="@Robno" value="$NeRobno" />
			<parameter name="@klmasterrobaid" value="$MasterRobaId" />
			<parameter name="@klasaispod" value="$IspodKlasa" />
			<parameter name="@Text1" value="$RobaDio" />
			<parameter name="@robnamarkaid" value="$MarkaId" />
			<parameter name="@DatumDo" value="$Datum" />
			
			
		</data>
		<data command="spProd_SktStarosnaStruktura"  name="dtGrid" if="$Act&gt;1" timeout="200">
			<parameter name="@Action" value="$Act" />
			<parameter name="@RobaId" value="$RobaId" />
			<parameter name="@skladisteid" value="$SkladisteId" />
			<parameter name="@Robno" value="$NeRobno" />
			<parameter name="@klmasterrobaid" value="$MasterRobaId" />
			<parameter name="@klasaispod" value="$IspodKlasa" />
			<parameter name="@Text1" value="$RobaDio" />
			<parameter name="@robnamarkaid" value="$MarkaId" />
			<parameter name="@DatumDo" value="$Datum" />
			
			
		</data>
		
		
		</datalist>
	</form>

	<form name="frmFilter" caption="Parametri" width="500" fixedsize="true">

		<event type="shown">
			<action type="control value" value="#cmbSkladiste" >
				<parameter value="55555"/>
			</action>
			<action type="control value" value="#cmbKlasa" >
				<parameter value="parent.$MasterRobaId"/>
			</action>
			<action type="control value" value="#txtRobaDio" >
				<parameter value="parent.$RobaDio"/>
			</action>
			<action type="control value" value="#srcRoba" >
				<parameter value="parent.$RobaId" text="parent.$RobaNaziv"/>
			</action>
			<action type="control value" value="#cmbMarka" >
				<parameter value="parent.$MarkaId"/>
			</action>
			<action type="control value" value="#datDatumDo" >
				<parameter value="parent.$Datum"/>
			</action>
			<action type="control value" value="#chkNeRobno" >
				<parameter value="parent.$NeRobno"/>
			</action>
			<action type="control value" value="#chkKlasaIspod" >
				<parameter value="parent.$IspodKlasa"/>
			</action>
		</event>
	
		<layout textposition="left">
			<group cols="3" rows="6" >
				<item caption="Skladište/Trgovina:" col="1" row="1">
				<comboedit name="cmbSkladiste"   valuefield="id" displayfield="naziv"  dataname="Global.dtGetSkladiste" allownull="false">

				</comboedit>
				</item>

				<item caption="Klasa robe:" col="1" row="2">
					<combotreeedit name="cmbKlasa" valuefield="Id" displayfield="Naziv" datavalue="" dataname="Global.dtGetKlasa"  />
				</item>	
				<item caption="Roba dio naziva:" col="1" row="3">
					<textedit name="txtRobaDio"    />
				</item>	
				<item caption="Roba:" col="1" row="4">
					<searchedit name="srcRoba" fontsizedelta="1" fontbold="True" fieldtext="Roba3000" fieldvalue="RobaId"   entermovenextcontrol="false" dataname="Global.dtSearchRoba" >
								
					</searchedit>
				</item>
				<item caption="Marka:" col="1" row="5">
					<comboedit name="cmbMarka" autopopulate="true"  valuefield="robnamarkaid" displayfield="naziv"  dataname="Global.dtGetMarka">

					</comboedit>
				</item>
				<item caption="Datum do:" col="1" row="6">
					<dateedit  name="datDatumDo"  value="now" >                                                                                          
					</dateedit>
				</item>
				<item caption="" col="2" row="1">
					<checkedit name="chkNeRobno"   />
				</item>
				<item caption="" col="2" row="2">
					<checkedit name="chkKlasaIspod"   />
				</item>	
				<item caption="" col="3" row="1">
					<labeledit name="lblRobno" value="nije u robnom"   />
				</item>	
				<item caption="" col="3" row="2">
					<labeledit name="lblKlasa" value="i ispod "   />
				</item>					
			</group>
		</layout>			
		<datalist>
		
		</datalist>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="POKAŽI">
					<event type="click">
						<action type="variable value" >
							<parameter name="parent.Act" value="1" />
						</action>
						<action type="variable value" >
							<parameter name="parent.SkladisteId" value="#cmbSkladiste" />
						</action>
						<action type="variable value" >
							<parameter name="parent.MasterRobaId" value="#cmbKlasa" />
						</action>
						<action type="variable value" >
							<parameter name="parent.RobaDio" value="#txtRobaDio" />
						</action>
						<action type="variable value" >
							<parameter name="parent.RobaId" value="#srcRoba" />
						</action>
						<action type="variable value" >
							<parameter name="parent.RobaNaziv" value="#srcRoba.text"/>
						</action>
						<action type="variable value" >
							<parameter name="parent.MarkaId" value="#cmbMarka" />
						</action>
						<action type="variable value" >
							<parameter name="parent.Datum" value="#datDatumDo" />
						</action> 
						<action type="variable value" >
							<parameter name="parent.NeRobno" value="#chkNeRobno"/>
						</action>
						<action type="variable value" >
							<parameter name="parent.IspodKlasa" value="#chkKlasaIspod"/>
						</action> 				
						<action type="form close"/>
						<!-- <action type="control populate" value="parent.#grdGrid"> -->
							<!-- <action type="control focus" value="parent.#grdGrid"> -->
							<!-- </action> -->
						<!-- </action> -->
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
	</form>
	
	<form name="frmRekap" caption="Rekapitulacija" width="500" fixedsize="true">
			<event type="shown">
			<action type="control value" value="#cmbRekap" >
				<parameter value="4"/>
			</action>
			
		</event>
		<layout textposition="left">
			<group cols="1" rows="1" >
					<item caption="Rekapitulacija po:" col="1" row="1">
						<comboedit name="cmbRekap" autopopulate="true"  valuefield="id" displayfield="naziv"  dataname="Global.dtGetRekap" allownull="false">

						</comboedit>
					</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="POKAŽI">
					<event type="click">
						<action type="variable value" >
							<parameter name="parent.Act" value="#cmbRekap" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
	</form>
	
	<datalist>

		<data command="spProd_SktStarosnaStruktura"  name="dtGetSkladiste" timeout="200">
			<parameter name="@Action" value="0" />
		</data>
		<data command="spCarpo_Combo"  name="dtGetKlasa">
			<parameter name="@Action" value="KlMasterRoba" />
		</data>
		<data command="spTraziRoba" name="dtSearchRoba" >
			<parameter name="@Action" value="Roba" />
			<parameter name="@uvjet" value="#srcRoba.text" />		
		</data>
		<data command="spNG_Combo" name="dtGetMarka">
			<parameter name="@Action" value="RobnaMarka" />
		</data>
		<data command="spProd_SktStarosnaStruktura"  name="dtGetRekap" timeout="200">
			<parameter name="@Action" value="3" />
		</data>
	</datalist>

</root>