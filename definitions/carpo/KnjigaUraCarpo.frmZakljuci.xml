<?xml version="1.0" encoding="utf-8"?>
<!-- ZAKLJUCI_FORM - Zaključak knjige URA -->
<root version="1.2">
  <form name="frmZakljuci" type="custom" caption="Zaključak" width="350" height="250">
    <event type="oninit">
      <action type="datarun reader" value="~dtProvjeri"/>
    </event>
    <layout>
      <group rows="2" cols="1">
        <item row="1" col="1" caption="Zaključak sa:">
          <dateedit name="datZakljucek"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZakljuci" caption="Zaključi">
          <event type="click">
            <action type="datarun nonquery" value="~dtZakljuci"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtProvjeri" command="spKntZakKnjUra" timeout="30">
        <parameter name="@action" value="provjeri_zak"/>
        <parameter name="@node" value="$Node"/>
      </data>
      <data name="dtZakljuci" command="spKntZakKnjUra" timeout="30">
        <parameter name="@action" value="zakljuci"/>
        <parameter name="@node" value="$Node"/>
        <parameter name="@datumforma" value="#datZakljucek"/>
        <parameter name="@operateriid" value="@@operateriid"/>
      </data>
    </datalist>
  </form>
</root>
