			</action>
			<action type="control value" value="#txtKategorija">
				<parameter value="~dtGetOsobu.@Kategorija"/>
			</action>
			<action type="control value" value="#txtBrojIsk">
				<parameter value="~dtGetOsobu.@ZSIskaznica"/>
			</action>
			<action type="control value" value="#txtTitula">
				<parameter value="~dtGetOsobu.@PreTitleNaziv"/>
			</action>
			<action type="control value" value="#txtZvanje">
				<parameter value="~dtGetOsobu.@PosTitleNaziv"/>
			</action>
			<action type="variable value">
				<parameter name="Loading" value="0" type="int" />
			</action>
