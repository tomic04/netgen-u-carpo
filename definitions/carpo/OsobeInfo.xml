		<event type="shown">
		<action type="variable value">
				<parameter name="global.OsobaId" value="#srcInfo" />
			</action>
			<action type="control disable" value="#btnEdit,#btnDelete,#tabs[1],#tabs[2],#tabs[3],#tabs[4]" if="global.$OsobaId==null"/>
