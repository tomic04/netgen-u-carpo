							<action type="control visible" value="#btnInsert" >
							<parameter value="false"/>
							</action>
							<action type="control enable" value="#btnEdit" if="~dtProveriPravo.@IzmijeniEnable==1"/>
							<action type="control disable" value="#btnEdit" elseif="~dtProveriPravo.@IzmijeniEnable==0"/>
							<action type="control visible" value="#btnEdit" if="~dtProveriPravo.@IzmijeniVisible==1">
							<parameter value="true"/>
							</action>
							<action type="control visible" value="#btnEdit" if="~dtProveriPravo.@IzmijeniVisible==0">
							<parameter value="false"/>
							</action>
							<action type="control visible" value="#btnDelete" >
							<parameter value="false"/>
							</action>
						</action>
				</event>
	
			</tabs>
