							<action type="control visible" value="#btnDelete" if="~dtProveriPravo.@ObrisiVisible==0">
							<parameter value="false"/>
							</action>
							
						</action>
							<action type="control disable" value="#btnEdit,#btnDelete" if="$SelectedTabIndex==1&amp;&amp;#grdFirme.rowcount==0"></action>
						<action elseif="$SelectedTabIndex==2">
						<action type="variable value">
							<parameter name="global.Tab" value="KlaseOsoba" type="string" />
						</action>
						<action type="datarun reader" value="~dtProveriPravo"/>
							<action type="control enable" value="#btnInsert" if="~dtProveriPravo.@UnesiEnable==1"/>
							<action type="control disable" value="#btnInsert" elseif="~dtProveriPravo.@UnesiEnable==0"/>
							<action type="control visible" value="#btnInsert" if="~dtProveriPravo.@UnesiVisible==1">
							<parameter value="true"/>
							</action>
							<action type="control visible" value="#btnInsert" if="~dtProveriPravo.@UnesiVisible==0">
							<parameter value="false"/>
							</action>
							<action type="control visible" value="#btnEdit">
							<parameter value="false"/>
							</action>
							<action type="control enable" value="#btnDelete" if="~dtProveriPravo.@ObrisiEnable==1"/>
							<action type="control disable" value="#btnDelete" elseif="~dtProveriPravo.@ObrisiEnable==0"/>
							<action type="control visible" value="#btnDelete" if="~dtProveriPravo.@ObrisiVisible==1">
							<parameter value="true"/>
							</action>
							<action type="control visible" value="#btnDelete" if="~dtProveriPravo.@ObrisiVisible==0">
							<parameter value="false"/>
							</action>
							<action type="control disable" value="#btnEdit,#btnDelete" if="$SelectedTabIndex==2&amp;&amp;#grdKlaseOsoba.rowcount==0"></action>
						</action>
						
						<action elseif="$SelectedTabIndex==3">
						<action type="variable value">
							<parameter name="global.Tab" value="Memo" type="string" />
