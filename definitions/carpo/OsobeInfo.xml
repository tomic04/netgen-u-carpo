								<parameter name="caption" value="Unos osnovnih podataka"/>
								<parameter name="OsobeId" value="0" />
								<parameter name="click" value="1"/>
								<parameter name="tip" value="0"/>
								<parameter name="tab" value="$SelectedTabIndex"/>
							</action>
								<action type="variable value">
