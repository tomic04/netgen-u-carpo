				<parameter name="Id" value="global.$OsobaId" type="int" />
			</action>
			<action type="datarun reader" value="~dtGetOsobu"/>
			<action type="control value" value="#srcInfo">
				<parameter value="~dtGetOsobu.@OsobeId" text="~dtGetOsobu.@Osoba"/>
			</action>
			<action type="control value" value="#txtIme">
				<parameter value="~dtGetOsobu.@Ime"/>
			</action>
			<action type="control value" value="#txtOIB">
				<parameter value="~dtGetOsobu.@OIB"/>
			</action>
			<action type="control value" value="#txtAdresa">
				<parameter value="~dtGetOsobu.@Adresa"/>
			</action>
			<action type="control value" value="#txtTelefon">
				<parameter value="~dtGetOsobu.@Private1"/>
			</action>
			<action type="control value" value="#txtEmail">
				<parameter value="~dtGetOsobu.@Email"/>
			</action>
			<action type="control value" value="#txtPrezime">
				<parameter value="~dtGetOsobu.@Prezime"/>
			</action>
			<action type="control value" value="#txtSifra">
				<parameter value="~dtGetOsobu.@Sifra"/>
			</action>
			<action type="control value" value="#txtMjesto">
				<parameter value="~dtGetOsobu.@MjestaNaziv"/>
			</action>
			<action type="control value" value="#txtMobile">
