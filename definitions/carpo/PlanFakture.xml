<root>
    <form type="master" caption="Plan fakturiranja" name="frmMain" maximized="true">
    <event type="load">
        <action type="control disable" value="#btnDodaj"/>
        <action type="control disable" value="#btnUredi"/>
        <action type="control populate" value="#trTree"/>
    </event>
        <layout>
        <group row="1" col="1" rows="2" cols="16" groupbordervisible="false">
            <item row="1" col="1" rowspan="2" colspan="3">
                <tree name="trTree" dataname="~dtTree" caption="Projekti" keyfield="ID">         
                <event type="focusedrowchanged">
                    <action type="control enable" value="#btnDodaj" if="#trTree.@ParentId!=null||#trTree.@IndManager==1||#trTree.@IndManager!=null"/>
                    <action type="control disable" value="#btnDodaj" if="#trTree.@ParentId==null||#trTree.@IndManager==0||#trTree.@IndManager==null"/>
                    <action type="control enable" value="#btnUredi" if="#trTree.@ParentId!=null||#trTree.@IndManager==1||#trTree.@IndManager!=null"/>
                    <action type="control disable" value="#btnUredi" if="#trTree.@ParentId==null||#trTree.@IndManager==0||#trTree.@IndManager==null"/>
                    <action type="control populate" value="#grdTop"/>
                    <action type="control populate" value="#grdBottom"/>
                </event>
                <fields>
                    <field name="Projekt"/>
                </fields>
                </tree>
            </item>
            <item row="1" col="4" colspan="12">
                <grid name="grdTop" key="PtPlanFaktureId" bestfitonrefresh="true" dataname="~dtGridTop" multiselect="false" showfooter="true" showmenutools="false" showmenuprintitem="false">
                    <fields>
                        <field name="Broj dokumenta" type="string" />
                        <field name="Status" type="string" />
                        <field name="Vrsta fakture" type="string" />
                        <field name="Opis" type="string" />
                        <field name="Iznos fakture (u valuti)" showtotalsum="true" type="decimal" />
                        <field name="Valuta" type="string" />
                        <field name="Planirani datum fakturiranja" type="date" />
                        <field name="Odgoda plaćanja" showtotalsum="false" type="int" />
                        <field name="Planirani datum plaćanja" type="date" />
                        <field name="Komentar" type="string" />
                        <field name="Broj izdane fakture" type="string" />
                        <field name="Iznos fakture (u kn)" showtotalsum="true" type="decimal" />
                    </fields>
                </grid>
            </item>
            <item row="2" col="4" colspan="12">
                <grid name="grdBottom" key="Id" bestfitonrefresh="true" dataname="~dtGridBottom" multiselect="false" showfooter="true" showmenutools="false" showmenuprintitem="false">
                    <fields>
                        <field name="Broj Dokumenta" type="string" />
                        <field name="Valuta" type="string" />
                        <field name="Partner" type="string" />
                        <field name="Datum Dokumenta" type="date" />
                        <field name="Datum Valute" type="date" />
                        <field name="Fakturirano" showtotalsum="true" type="decimal" />
                        <field name="Plaćeno" showtotalsum="true" type="decimal" />
                        <field name="Stanje" showtotalsum="true" type="decimal" />
                        <field name="Dospjelo" showtotalsum="true" type="decimal" />
                        <field name="Avansi Stanje" showtotalsum="true" type="decimal" />
                        <field name="Nedospjelo" showtotalsum="true" type="decimal" />
                        <field name="Fakturirano (DEV)" showtotalsum="true" type="decimal" />
                        <field name="Plaćeno (DEV)" showtotalsum="true" type="decimal" />
                        <field name="Stanje (DEV)" showtotalsum="true" type="decimal" />
                        <field name="Dospjelo (DEV)" showtotalsum="true" type="decimal" />
                        <field name="Avansi Stanje (DEV)" showtotalsum="true" type="decimal" />
                        <field name="Nedospjelo (DEV)" showtotalsum="true" type="decimal" />
                        <field name="DevDuguje" showtotalsum="true" type="decimal" />
                        <field name="DevPotrazuje" showtotalsum="true" type="decimal" />
                        <field name="BrojFakturaAvans" type="string" />                        
                    </fields>
                </grid>
            </item>
        </group>         
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodaj" caption="UNESI">
                    <event type="click">
						<action type="form open" value="frmUnos">
                            <parameter name="PtProjektId" value="#trTree.@ID" type="int"/>
                        </action>
                        <action type="control populate" value="#grdTop"/>
                        <action type="control populate" value="#grdBottom"/>
					</event>
                </button>
                <button name="btnUredi" caption="IZMIJENI">
                    <event type="click">
						<action type="form open" value="frmIzmjena">
                            <parameter name="PtProjektId" value="#trTree.@ID" type="int"/>
                            <parameter name="PtPlanFaktureId" value="#grdTop.@PtPlanFaktureId" type="int"/>
                            <parameter name="BrojDokumenta" value="#grdTop.@Broj dokumenta" type="string"/>
                            <parameter name="Status" value="#grdTop.@Status" type="string"/>
                            <parameter name="VrstaFakture" value="#grdTop.@Vrsta fakture" type="string"/>
                            <parameter name="Opis" value="#grdTop.@Opis" type="string"/>
                            <parameter name="IznosFakture" value="#grdTop.@Iznos fakture (u valuti)" type="decimal"/>
                            <parameter name="PlaniraniDatum" value="#grdTop.@Planirani datum fakturiranja" type="date"/>
                            <parameter name="OdgodaPlacanja" value="#grdTop.@Odgoda plaćanja" type="int"/>
                            <parameter name="Komentar" value="#grdTop.@Komentar" type="string"/>
                            <parameter name="BrojFakture" value="#grdTop.@Broj izdane fakture" type="string"/>
                        </action>
                        <action type="control populate" value="#grdTop"/>
                        <action type="control populate" value="#grdBottom"/>
					</event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data name="dtTree" command="spPtPlanFaktureTreeQuery">
                <parameter name="@OperaterId" value="@@operateriid"/>
            </data>
            <data name="dtGridTop" command="spPtPlanFaktureQuery">
                <parameter name="@Action" value="5" type="int"/>
                <parameter name="@PtProjektId" value="#trTree.@ID" type="int"/>
            </data>
            <data command="spPtPlanFakturePrometQuery" name="dtGridBottom">
                <parameter name="@PtProjektId" value="#trTree.@ID" type="int"/>
            </data>
        </datalist>
    </form>

    <form name="frmUnos" caption="Plan fakturiranja - Unos" width="500" saveformsize="false">
        <event type="load">
            <action type="control disable" value="#txtValuta"/>
            <action type="datarun reader" value="~dtValuta"/>
            <action type="datarun reader" value="~dtGen"/>
            <action type="variable value">
                <parameter name="Valuta" value="~dtValuta.@Valuta" type="string"/>
            </action>
            <action type="variable value">
                <parameter name="BrojDok" value="~dtGen.@BrojDok" type="string"/>
            </action>
            <action type="control value" value="#txtValuta" >
			    <parameter value="$Valuta"/>
		    </action>
            <action type="control value" value="#txtBroj" >
			    <parameter value="$BrojDok"/>
		    </action>
        </event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="10" col="1" row="1"> 				
				<item col="1" row="1" caption="Broj dokumenta:" colspan="3" required="true">
					<textedit name="txtBroj"/>
				</item>
				<item caption="Status:" col="1" row="2"  colspan="3">
					<comboedit name="cmbStatus" value="1" valuefield="PtPlanFaktureStatusId" dataname="~dtStatus" displayfield="Naziv" required="true"/>
				</item>
                <item caption="Vrsta fakture:" col="1" row="3"  colspan="3">
					<comboedit name="cmbVrstaDok" valuefield="PtPlanFaktureVrstaDokId" dataname="~dtVrstaDok" displayfield="Naziv" required="true"/>
				</item>
                <item col="1" row="4" caption="Opis:" colspan="3">
					<textedit name="txtOpis"/>
				</item>
                <item col="1" row="5" caption="Iznos fakture (u valuti):" colspan="3">
					<textedit name="txtIznos" required="true"/>
				</item>
                <item col="1" row="6" caption="Valuta:" colspan="3">
					<textedit name="txtValuta"/>
				</item>
                <item col="1" row="7" caption="Planirani datum fakturiranja:">
					<dateedit name="datDatumFakturiranja" required="true"/>
				</item>
                <item col="1" row="8" caption="Odgoda plaćanja:" colspan="3">
					<textedit name="txtOdgoda" required="true"/>
				</item>
                <item col="1" row="9" caption="Komentar:" colspan="3">
					<textedit name="txtKomentar"/>
				</item>
                <item caption="Broj izdane fakture:" col="1" row="10"  colspan="3">
					<comboedit name="cmbBrojFakture" valuefield="FaktureId" dataname="~dtBrojFakture" displayfield="BrojFakture"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="UNESI">
                        <event type="click" >
                            <action type="datarun reader" value="~dtCheck"/>
                            <action type="variable value">
                                <parameter name="Dupli" value="~dtCheck.@Broj" type="int"/>
                            </action>
                            <action type="datarun reader" value="~dtDecimal"/>
                            <action type="variable value">
                                <parameter name="Decimal" value="~dtDecimal.@Broj" type="int"/>
                            </action>
                            <action type="datarun reader" value="~dtDate"/>
                            <action type="variable value">
                                <parameter name="Dani" value="~dtDate.@DaniOdgode" type="int"/>
                            </action>
                            <action type="validate"/>
                            <action type="message" value="Za odabrani projekt postoji planirana faktura sa unesenim brojem dokumenta!\n                      Broj dokumenta mora biti jedinstveni podatak!" if="$Dupli!=0"/>
                            <action type="message" value="Neispravan unos iznosa planirane fakture!\n     Iznos mora biti brojčana vrijednost!" elseif="$Decimal!=1"/>
                            <action type="message" value="Neispravan unos odgode plaćanja planirane fakture!\n   Odgoda plaćanja mora biti brojčana vrijednost!" elseif="$Dani!=1"/>
                            <action type="message" value="Za odabrani status planirane fakture potrebno je odabrati broj izdane fakture!" elseif="#cmbStatus==2&amp;&amp;#cmbBrojFakture==null"/>
                            <action type="datarun nonquery" value="~dtUnos" else="" >
                                <action type="form close"/>
                            </action>
						</event>                           
					</button>
					<button name="btnOdustani" caption="ODUSTANI" dock="right" type="cancel"/>
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPtPlanFaktureAzur" name="dtUnos">
				<parameter name="@Action" value="0" type="int"/>                
                <parameter name="@ProjektId" value="$PtProjektId" type="int"/>
				<parameter name="@BrojFakture" value="#txtBroj" type="string"/>
                <parameter name="@StatusId" value="#cmbStatus" type="int"/>
                <parameter name="@VrstaDokId" value="#cmbVrstaDok" type="int"/>
                <parameter name="@Opis" value="#txtOpis" type="string"/>
                <parameter name="@Iznos" value="#txtIznos" type="decimal"/>
                <parameter name="@Datum" value="#datDatumFakturiranja" type="date"/>
                <parameter name="@OdgodaPlacanja" value="#txtOdgoda" type="int"/>
                <parameter name="@Komentar" value="#txtKomentar" type="string"/>
                <parameter name="@FaktureId" value="#cmbBrojFakture" type="int"/>
			</data>
            <data command="spPtPlanFaktureQuery" name="dtStatus">
				<parameter name="@Action" value="0" type="int"/>				
			</data>
            <data command="spPtPlanFaktureQuery" name="dtVrstaDok">
				<parameter name="@Action" value="1" type="int"/>				
			</data>
            <data command="spPtPlanFaktureQuery" name="dtBrojFakture">
				<parameter name="@Action" value="2" type="int"/>	
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtValuta">
				<parameter name="@Action" value="3" type="int"/>	
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtGen">
                <parameter name="@Action" value="4" type="int"/>	
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>
            </data>
            <data command="spPtPlanFaktureQuery" name="dtCheck">
                <parameter name="@Action" value="9" type="int"/>	
                <parameter name="@Broj" value="#txtBroj" type="string"/>
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>
                <parameter name="@PtPlanFaktureId" value="null" type="int"/>
                <parameter name="@InsertInd" value="1" type="int"/>
            </data>
            <data command="spPtPlanFaktureQuery" name="dtDecimal">
				<parameter name="@Action" value="10" type="int"/>	
                <parameter name="@Decimal" value="#txtIznos" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtDate">
                <parameter name="@Action" value="11" type="int"/>	
                <parameter name="@DaniOdgode" value="#txtOdgoda" type="string"/>
            </data>
		</datalist>
	</form> 

    <form name="frmIzmjena" caption="Plan fakturiranja - Izmjena" width="500" saveformsize="false">
        <event type="load">
            <action type="control disable" value="#txtValuta"/>
            <action type="datarun reader" value="~dtValuta"/> 
            <action type="datarun reader" value="~dtStatusCon"/> 
            <action type="datarun reader" value="~dtVrstaDokCon"/>  
            <action type="datarun reader" value="~dtBrojFaktureCon"/>         
            <action type="variable value">
                <parameter name="Valuta" value="~dtValuta.@Valuta" type="string"/>
            </action>
            <action type="variable value">
                <parameter name="StatusId" value="~dtStatusCon.@PtPlanFaktureStatusId" type="int"/>
            </action> 
            <action type="variable value">
                <parameter name="VrstaDokId" value="~dtVrstaDokCon.@PtPlanFaktureVrstaDokId" type="int"/>
            </action>
            <action type="variable value">
                <parameter name="FaktureId" value="~dtBrojFaktureCon.@FaktureId" type="int"/>
            </action>
            <action type="control value" value="#txtBroj">
			    <parameter value="$BrojDokumenta"/>
		    </action>
            <action type="control value" value="#cmbStatus">
			    <parameter value="$StatusId"/>
		    </action> 
            <action type="control value" value="#txtValuta">
			    <parameter value="$Valuta"/>
		    </action> 
            <action type="control value" value="#cmbVrstaDok">
			    <parameter value="$VrstaDokId"/>
		    </action>  
            <action type="control value" value="#txtOpis">
			    <parameter value="$Opis"/>
		    </action> 
            <action type="control value" value="#txtIznos">
			    <parameter value="$IznosFakture"/>
		    </action>   
            <action type="control value" value="#datDatumFakturiranja">
			    <parameter value="$PlaniraniDatum"/>
		    </action> 
            <action type="control value" value="#txtOdgoda">
			    <parameter value="$OdgodaPlacanja"/>
		    </action>
            <action type="control value" value="#txtKomentar">
			    <parameter value="$Komentar"/>
		    </action>
            <action type="control value" value="#cmbBrojFakture">
			    <parameter value="$FaktureId"/>
		    </action>
        </event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="10" col="1" row="1"> 				
				<item col="1" row="1" caption="Broj dokumenta:" colspan="3" required="true">
					<textedit name="txtBroj"/>
				</item>
				<item caption="Status:" col="1" row="2"  colspan="3">
					<comboedit name="cmbStatus" valuefield="PtPlanFaktureStatusId" dataname="~dtStatus" displayfield="Naziv" required="true"/>
				</item>
                <item caption="Vrsta fakture:" col="1" row="3"  colspan="3">
					<comboedit name="cmbVrstaDok" valuefield="PtPlanFaktureVrstaDokId" allownull="false" dataname="~dtVrstaDok" displayfield="Naziv" required="true"/>
				</item>
                <item col="1" row="4" caption="Opis:" colspan="3">
					<textedit name="txtOpis"/>
				</item>
                <item col="1" row="5" caption="Iznos fakture (u valuti):" colspan="3">
					<textedit name="txtIznos" required="true"/>
				</item>
                <item col="1" row="6" caption="Valuta:" colspan="3">
					<textedit name="txtValuta"/>
				</item>
                <item col="1" row="7" caption="Planirani datum fakturiranja:">
					<dateedit name="datDatumFakturiranja" required="true"/>
				</item>
                <item col="1" row="8" caption="Odgoda plaćanja:" colspan="3">
					<textedit name="txtOdgoda" required="true"/>
				</item>
                <item col="1" row="9" caption="Komentar:" colspan="3">
					<textedit name="txtKomentar"/>
				</item>
                <item caption="Broj izdane fakture:" col="1" row="10"  colspan="3">
					<comboedit name="cmbBrojFakture" valuefield="FaktureId" dataname="~dtBrojFakture" displayfield="BrojFakture"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="IZMJENI">
                         <event type="click" >
                            <action type="control value" value="#cmbVrstaDok" if="#cmbVrstaDok==null">
			                    <parameter value=""/>
		                    </action>
                            <action type="datarun reader" value="~dtCheck"/>
                            <action type="variable value">
                                <parameter name="Dupli" value="~dtCheck.@Broj" type="int"/>
                            </action>
                            <action type="datarun reader" value="~dtDecimal"/>
                            <action type="variable value">
                                <parameter name="Decimal" value="~dtDecimal.@Broj" type="int"/>
                            </action>
                            <action type="datarun reader" value="~dtDate"/>
                            <action type="variable value">
                                <parameter name="Dani" value="~dtDate.@DaniOdgode" type="int"/>
                            </action>
                            <action type="validate"/>
                            <action type="message" value="Za odabrani projekt postoji planirana faktura sa unesenim brojem dokumenta!\n                      Broj dokumenta mora biti jedinstveni podatak!" if="$Dupli!=0"/>
                            <action type="message" value="Neispravan unos iznosa planirane fakture!\n     Iznos mora biti brojčana vrijednost!" elseif="$Decimal!=1"/>
                            <action type="message" value="Neispravan unos odgode plaćanja planirane fakture!\n   Odgoda plaćanja mora biti brojčana vrijednost!" elseif="$Dani!=1"/>
                            <action type="message" value="Za odabrani status planirane fakture potrebno je odabrati broj izdane fakture!" elseif="#cmbStatus==2&amp;&amp;#cmbBrojFakture==null"/>
                            <action type="datarun nonquery" value="~dtIzmjena" else="" >
                                <action type="form close"/>
                            </action>
						</event>						                           
						</button>
					<button name="btnOdustani" caption="ODUSTANI" dock="right" type="cancel"/>
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPtPlanFaktureAzur" name="dtIzmjena">
				<parameter name="@Action" value="1" type="int"/>
                <parameter name="@PtPlanFaktureId" value="$PtPlanFaktureId" type="string"/>	
				<parameter name="@BrojFakture" value="#txtBroj" type="string"/>
                <parameter name="@StatusId" value="#cmbStatus" type="int"/>
                <parameter name="@VrstaDokId" value="#cmbVrstaDok" type="int"/>
                <parameter name="@Opis" value="#txtOpis" type="string"/>
                <parameter name="@Iznos" value="#txtIznos" type="decimal"/>
                <parameter name="@Datum" value="#datDatumFakturiranja" type="date"/>
                <parameter name="@OdgodaPlacanja" value="#txtOdgoda" type="int"/>
                <parameter name="@Komentar" value="#txtKomentar" type="string"/>
                <parameter name="@FaktureId" value="#cmbBrojFakture" type="int"/>
			</data>
            <data command="spPtPlanFaktureQuery" name="dtStatus">
				<parameter name="@Action" value="0" type="int"/>				
			</data>
            <data command="spPtPlanFaktureQuery" name="dtStatusCon">
				<parameter name="@Action" value="6" type="int"/>	
                <parameter name="@PtPlanFaktureId" value="$PtPlanFaktureId" type="string"/>			
			</data>
            <data command="spPtPlanFaktureQuery" name="dtVrstaDokCon">
				<parameter name="@Action" value="7" type="int"/>	
                <parameter name="@PtPlanFaktureId" value="$PtPlanFaktureId" type="string"/>			
			</data>
            <data command="spPtPlanFaktureQuery" name="dtVrstaDok">
				<parameter name="@Action" value="1" type="int"/>				
			</data>
            <data command="spPtPlanFaktureQuery" name="dtBrojFakture">
				<parameter name="@Action" value="2" type="int"/>	
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtBrojFaktureCon">
				<parameter name="@Action" value="8" type="int"/>	
                <parameter name="@PtPlanFaktureId" value="$PtPlanFaktureId" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtValuta">
				<parameter name="@Action" value="3" type="int"/>	
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtCheck">
                <parameter name="@Action" value="9" type="int"/>	
                <parameter name="@Broj" value="#txtBroj" type="string"/>
                <parameter name="@PtProjektId" value="$PtProjektId" type="int"/>
                <parameter name="@PtPlanFaktureId" value="$PtPlanFaktureId" type="int"/>
                <parameter name="@InsertInd" value="0" type="int"/>
            </data>
            <data command="spPtPlanFaktureQuery" name="dtDecimal">
				<parameter name="@Action" value="10" type="int"/>	
                <parameter name="@Decimal" value="#txtIznos" type="int"/>		
			</data>
            <data command="spPtPlanFaktureQuery" name="dtDate">
                <parameter name="@Action" value="11" type="int"/>	
                <parameter name="@DaniOdgode" value="#txtOdgoda" type="string"/>
            </data>
		</datalist>
	</form>
</root>