<root version="2">
  <!--
  ****************************************************************
  Granula za rad s obustavama
  ver 1.0.0.1: inicijalna verzija 
  ver 2: 10.3.2021. frmMaster:: poziva se place.frmVirmani forma (jedinstvena za virmane plaća)
  ****************************************************************
  -->
  <form name="frmMaster" type="master" caption="Obustave2">
    <event type="shown">
      <action type="form open" value="frmFilter"/>
    </event>
    
    <managerlayout>    

      <!--Grid Glava-->
      <grid  name="grdGla" key="OOPObustaveGlaId" type="master" async="true" dataname="dtMaster" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" allowfilter="true" showgrouppanel="true" showautofilterrow="true">
        <fields>
          <field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
          <field name="Partner" caption="Naziv partnera"/>
          <field name="Adresa" caption="Adresa"/>
          <field name="Mijesto" caption="Mjesto"/>
          <field name="DefVirman" caption="Žiroračun partnera"/>
          <field name="Naziv" caption="Obustava"/>
          <field name="Spec" caption="Spec"/>
          <field name="Opis" caption="Opis"/>
          <field name="VrstaObustave" caption="Vrsta"/>
          <field name="DatumAzur" caption="Datum ažuriranja"/>
          <field name="OperaterGla" caption="Operater"/>
        </fields>
        <menu>
          <menuitem caption="Unesi obustavu" name="UnesiObustavu" function="UnesiObustavu">
            <event type="click">
              <action type="form open" value="frmObustavaEdit">
                <parameter name="caption" value="Unos obustave" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
              </action>
              <action type="control populate keepfocus" value="#grdGla"></action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem caption="Izmijeni obustavu" name="IzmijeniObustavu" function="IzmijeniObustavu">
            <event type="click">
              <action type="form open" value="frmObustavaEdit">
                <parameter name="caption" value="Unos obustave" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
              </action>
              <action type="control populate keepfocus" value="#grdGla"></action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem caption="Obriši obustavu" name="BrisiObustavu" function="BrisiObustavu">
            <event type="click">
              <action type="form open" value="frmObustavaBrisi">
                <parameter name="caption" value="Brisanje obustave" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
              </action>
              <action type="control populate" value="#grdGla"></action>
            </event>
          </menuitem>
          <menuitem type="separator"/>
          <menuitem caption="Virmani" name="Virmani" function="Virmani">
            <!-- <event type="click">
              <action type="form open" value="frmVirmani">
                <parameter name="caption" value="Virmani" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
              </action>
              <action type="control populate" value="#grdGla"></action>
            </event> -->
			
			<event type="click">
            <action type="form open" value="frmVirmani">
              <parameter name="caption" value="Virmani za obustavu {#grdGla.@Naziv}"/>
              <!--<parameter name="PartneriId" value="#grdBanke.@PartneriId"/>-->
              <parameter name="OOPId" value="#grdGla.@OOPObustaveGlaId"/>
              <parameter name="OOPOznaka" value="OB"/>
            </action>
            <action type="control populate keepfocus" value="#grdGla"/>
          </event>
          </menuitem>
        </menu>


        <event type="focusedrowchanged">
          <action type="control populate" value="#grdDet"/>

          <!--<action type="menu disable" value="#mnuDodajKadrove1,#mnuDonosUcinka,#mnuKopirajKadrove2,#mnuKopirajKadrove3,#mnuKorekcija,#mnuOsvjeziPodatke,#mnuAzuriranjeDetalja,#mnuUnosDetaljaMulti,#mnuBrisanjeDetaljaMulti,#mnuDonosBolovanja,#mnuDonosUcinka,#mnuBrisanjePomEvid,#mnuDonosPomEvid,#mnuDonosAkontacije,#mnuBrisiKadrove" if="#tree.@status==1"></action>
          <action type="menu enable" value="#mnuDodajKadrove1,#mnuDonosUcinka,#mnuKopirajKadrove2,#mnuKopirajKadrove3,#mnuKorekcija,#mnuOsvjeziPodatke,#mnuAzuriranjeDetalja,#mnuUnosDetaljaMulti,#mnuBrisanjeDetaljaMulti,#mnuDonosBolovanja,#mnuDonosUcinka,#mnuBrisanjePomEvid,#mnuDonosPomEvid,#mnuDonosAkontacije,#mnuBrisiKadrove" else="#tree.@status==0"></action>-->
        </event>

      </grid>
      
      <!--detalj grid-->
      <grid name="grdDet" key="OOPObustaveDetId" async="true" dataname="dtDet" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" allowfilter="true" showgrouppanel="true" showautofilterrow="true">
        <fields>
          <field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
          <field name="Djelatnik" caption="Djelatnik"/>
          <field name="Aktivan" caption="Aktivan"/>
          <field name="Zaduzenje" caption="Zaduženje"/>
          <field name="Uplata" caption="Uplata"/>
          <field name="Saldo" caption="Saldo/Ostatak duga"/>
          <field name="PrviObrok" caption="Prvi obrok"/>
          <field name="OstaliObroci" caption="Ostali obroci"/>
          <field name="VrstaObroka" caption="V"/>
          <field name="Postotak" caption="Postotak"/>
          <field name="Valuta" caption="Valuta"/>
          <field name="MjescePoc" caption="Mjesec poč."/>
          <field name="MjesecZav" caption="Mjesec zav."/>
          <field name="Partija" caption="Partija"/>
          <field name="obracunna" caption="Obračun na..."/>
          <field name="Prioritet" caption="Prioritet"/>
          <field name="IndPrava" caption="IndPrava"/>
          <field name="Status" caption="Status"/>
          <field name="DatumAzur" caption="Datum ažuriranja"/>
          <field name="OperaterDet" caption="Operater"/>
        </fields>
        <event type="doubleclick">
          <action type="form open" value="frmObustaveDetEdit">
            <parameter name="caption" value="Izmjena obustave" type="string" />
            <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
            <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
          </action>
          <action type="control populate keepfocus" value="#grdDet"></action>
        </event>
        <menu>
          <menuitem name="mnuDodajDjelatnika" caption="Dodaj djelatnika" function="Dodaj djelatnika">
            <event type="click">
              <action type="form open" value="frmObustaveDetEdit">
                <parameter name="caption" value="Unos obustave:: {#grdGla.@Naziv}" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                <parameter name="OOPObustaveDetId" value="0" />
              </action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem name="mnuPromet" caption="Promet" function="Promet obustave">
            <event type="click">
              <action type="form open" value="frmObustavaPromet">
                <parameter name="caption" value="Promet obustave - {#grdDet.@Djelatnik} - {#grdGla.@Naziv}" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
              </action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem name="mnuIspraviDjelatnika" caption="Ispravak" function="Dodaj djelatnika">
              <event type="click">
                <action type="form open" value="frmObustaveDetEdit">
                  <parameter name="caption" value="Izmjena obustave::  {#grdGla.@Naziv} - {#grdDet.@Djelatnik}" type="string" />
                  <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                  <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
                  <parameter name="Obustava" value="#grdGla.@Naziv" type="string"/>
                </action>
                <action type="control populate" value="#grdDet"></action>
              </event>
          </menuitem><menuitem name="mnuMirovanje" caption="Mirovanje" function="Mirovanje obustave">
            <event type="click">
              <action type="form open" value="frmObustavaMirovanje">
                <parameter name="caption" value="Mirovanje obustave" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
              </action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem type="separator"/>
          <menuitem name="mnuBrisiDjelatnika" caption="Obriši djelatnika" function="Obriši djelatnika">
            <event type="click">
              <action type="form open" value="frmObustaveDetBrisi">
                <parameter name="caption" value="Brisanje obustave::  {#grdGla.@Naziv} - {#grdDet.@Djelatnik}" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
              </action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          <menuitem type="separator"/>
          <menuitem name="mnuKopirajDjelatnika" caption="Kopiraj" function="Kopiranje obustave">
            <event type="click">
              <action type="form open" value="frmObustavaKopiranje">
                <parameter name="caption" value="Kopiranje obustave::  {#grdGla.@Naziv} - {#grdDet.@Djelatnik}" type="string" />
                <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
                <parameter name="OOPObustaveDetId" value="#grdDet.@OOPObustaveDetId" />
              </action>
              <action type="control populate" value="#grdDet"></action>
            </event>
          </menuitem>
          
        </menu>
      </grid>
    </managerlayout>

    <!--gumbi-->

    <panelbuttons>
      <buttons>
        <button name="btnUnosObustave" caption="&amp;Unesi obustavu" function="UnesiObustavu">
          <event type="click">
            <action type="form open" value="frmObustavaEdit">
              <parameter name="caption" value="Nova obustava" type="string" />
              <parameter name="OOPObustaveGlaId" value="0" type="int"/>
            </action>
            <action type="control populate keepfocus" value="#grdGla"></action>
            <action type="control populate" value="#grdDet"></action>
          </event>
        </button>
        <button name="btnIzmjenaObustave" caption="&amp;Izmijeni obustavu" function="IzmijeniObustavu">
          <event type="click">
            <action type="form open" value="frmObustavaEdit">
              <parameter name="caption" value="Izmjena obustave" type="string" />
              <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId"  type="int"/>
            </action>
            <action type="control populate keepfocus" value="#grdGla"></action>
            <action type="control populate" value="#grdDet"></action>
          </event>
        </button>

        <button name="btnDodajDjelatnika" caption="&amp;Dodaj djelatnika" function="Dodaj djelatnika">
          <event type="click">
            <action type="form open" value="frmObustaveDetEdit">
              <parameter name="caption" value="Unos obustave" type="string" />
              <parameter name="OOPObustaveGlaId" value="#grdGla.@OOPObustaveGlaId" />
              <parameter name="OOPObustaveDetId" value="0" />
            </action>
            <action type="control populate" value="#grdDet"></action>
          </event>
        </button>

        <button name="btnValute" caption="&amp;Valute" function="Valute">
          <event type="click">
            <action type="form open" value="frmValute">
              <parameter name="caption" value="Valute" type="string" />
            </action>
          </event>
        </button>

        <button name="btnFilter" caption="&amp;Filter" function="Filter">
          <event type="click">
            <action type="form open" value="frmFilter">
              <parameter name="caption" value="Filter" type="string" />
            </action>
          </event>
        </button>


      </buttons>

    </panelbuttons>

    <!--datalist-->

    <datalist>

      <data command="spOOPObustaveQuery2" name="dtMaster">
        <parameter name="@oopobustaveglaid"  value="global.$fOOPObustaveGlaId" />
        <parameter name="@partneriid"  value="global.$fPartneriId" />
        <parameter name="@hrkadroviid"  value="global.$fHRKadroviId" />
        <parameter name="@status" value="0" if="global.$fOtvorene==true&amp;&amp;global.$fZatvorene==false" />
        <parameter name="@status" value="1" if="global.$fOtvorene==false&amp;&amp;global.$fZatvorene==true" />
        <parameter name="@status" value="2" if="global.$fOtvorene==true&amp;&amp;global.$fZatvorene==true" />
      </data>

      <data command="spOOPObustaveDetQuery2" name="dtDet">
        <parameter name="@oopobustaveglaid"  value="#grdGla.@oopobustaveglaid" />
        <parameter name="@hrkadroviid"  value="global.$fHRKadroviId" />
        <parameter name="@status" value="0" if="global.$fOtvorene==true&amp;&amp;global.$fZatvorene==false" />
        <parameter name="@status" value="1" if="global.$fOtvorene==false&amp;&amp;global.$fZatvorene==true" />
        <parameter name="@status" value="2" if="global.$fOtvorene==true&amp;&amp;global.$fZatvorene==true" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>

    </datalist>
  </form>
  <form name="frmObustavaBrisi" caption ="Brisanje obustave {parent.#grdGla.@Naziv}" saveformsize="false" width="500" height="125" fixedsize="true">
    <event type="load">
      <action type="datarun reader" value="~dtDetalji"/>
    </event>
    <event type="shown">
      <action if="~dtDetalji.@Broj==0">
        <action type="control value" value="#lblPitanje">
          <parameter value="Jeste li sigurni da želite obrisati odabranu obustavu?"/>
        </action>
        <action type="control enable" value="#btnBrisi"/>
      </action>
      <action if="~dtDetalji.@Broj!=0">
        <action type="control value" value="#lblPitanje">
          <parameter value="Nije moguće obrisati obustavu jer postoje detalji obustave!"/>
        </action>
        <action type="control disable" value="#btnBrisi"/>
      </action>
      
      
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtBrisanje"></action>
            <action type="form close"></action>
            <action type="control populate keepfocus" value="parent.#grdGla"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObustaveHelpCP" name="dtDetalji">
        <parameter name="@Action" value="broj_detalja_za_glavu" />
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId"/>
      </data>
      <data command="spOOPObustaveGlaAzur" name="dtBrisanje">
        <parameter name="@Action" value="2" />
        <parameter name="@ID" value="$OOPObustaveGlaId"/>
      </data>
    </datalist>
  </form>

  <form name="frmObustaveDetBrisi" caption="$caption" saveformsize="false" width="500" height="125" fixedsize="true">
    <event type="load">
      <action type="datarun reader" value="~dtDetalji"/>
    </event>
    <event type="shown">
      <action if="~dtDetalji.@Broj==0">
        <action type="control value" value="#lblPitanje">
          <parameter value="Jeste li sigurni da želite obrisati odabranu obustavu?"/>
        </action>
        <action type="control enable" value="#btnBrisi"/>
      </action>
      <action if="~dtDetalji.@Broj!=0">
        <action type="control value" value="#lblPitanje">
          <parameter value="Nije moguće obrisati obustavu jer postoje detalji obustave!"/>
        </action>
        <action type="control disable" value="#btnBrisi"/>
      </action>


    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtBrisanje"></action>
            <action type="form close"></action>
            <action type="control populate keepfocus" value="parent.#grdGla"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObustaveHelpCP" name="dtDetalji">
        <parameter name="@Action" value="broj_detalja_za_detalj" />
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId"/>
      </data>
      <data command="spOOPObustaveDetAzur2" name="dtBrisanje">
        <parameter name="@Action" value="2" />
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId"/>
      </data>
    </datalist>
  </form>

  <form name="frmFilter" width="520" closeformonescape="true" saveformsize="false" fixedsize="true" >
    
    <layout>
	<group cols="2" rows="1" bordervisible="false" alignmode="local"  >
	    <columnsdefinition>
          <column position="1" size="80%"/>
          <column position="2" size="20%"/>
        </columnsdefinition>
      <group col="1" row="1" cols="1" rows="5" bordervisible="false" alignmode="local" >
        <item caption="Partner" col="1" row="1" highlight="false" textposition="left">
          <searchedit name="srcPartner" dataname="dtPartneri" fieldtext="Naziv" fieldvalue="PartneriId" savevalue="session"/>
        </item>
        <item caption="Obustava" col="1" row="2" highlight="false" textposition="left">
          <searchedit name="srcObustava" dataname="dtObustave" fieldtext="Naziv" fieldvalue="OOPObustaveGlaId" savevalue="session" />
        </item>
        <item caption="Radnik" col="1" row="3" highlight="false" textposition="left">
          <searchedit name="srcRadnik" dataname="dtRadnik" fieldtext="DjelatnikNazivId" fieldvalue="HRKadroviId"  savevalue="session"/>
        </item>
        <item col="1" row="4" highlight="false">
          <checkedit name="chkOtvorene" value="true" caption="Otvorene" savevalue="session" />
        </item>
        <item col="1" row="5" highlight="false">
          <checkedit name="chkZatvorene" value="false" caption="Zatvorene"  savevalue="session"/>
        </item>
      </group>
	  
	   <group col="2" row="1" cols="1" rows="5" bordervisible="false"  >
	   <item col="2" row="1" highlight="false">
        </item>
		 <item col="2" row="2" highlight="false">
        </item>
        <item col="2" row="3" highlight="false">
          <checkedit caption="Svi" name="chkSvi" value="false"  tooltip="Uključi neaktivne djelatnike u pretragu" savevalue="session"/>
        </item>

      </group>
       </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        <button name="btnPokazi" caption="Pokaži">
          <event type="click">
            <action if="#chkOtvorene==false&amp;&amp;#chkZatvorene==false">
              <action  type="message" value="Niste odabrali jesu li obustave otvorene ili zatvorene"/>
            </action>
            <action else="">
              <action type="variable value" value="global.fPartneriId">
                <parameter value="#srcPartner"/>
              </action>
              <action type="variable value" value="global.fOOPObustaveGlaId">
                <parameter value="#srcObustava"/>
              </action>
              <action type="variable value" value="global.fHRKadroviId">
                <parameter value="#srcRadnik"/>
              </action>
              <action type="variable value" value="global.fOtvorene">
                <parameter value="#chkOtvorene"/>
              </action>
              <action type="variable value" value="global.fZatvorene">
                <parameter value="#chkZatvorene"/>
              </action>

              <action type="control populate" value="parent.#grdGla"/>
              <action type="form close"/>
            </action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOOPObustaveHelpCP" name="dtPartneri">
        <parameter name="@action"  value="trazi_partnera" />
        <parameter name="@tekst"  value="#srcPartner.text" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtRadnik">
        <parameter name="@action"  value="trazi_djelatnika" />
        <parameter name="@tekst"  value="#srcRadnik.text" />
        <parameter name="@svi"  value="#chkSvi" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtObustave">
        <parameter name="@action"  value="trazi_obustavu" />
        <parameter name="@tekst"  value="#srcObustava.text" />
      </data>
    </datalist>
  </form>

  <!--includane forme-->

  <!--desni klik za brisanje-->

  <form name="frmObustavaEdit" path="frmObustavaEdit.xml"/>
  <form name="frmValute" path="frmValute.xml"/>
  <form name="frmValutaEdit" path="frmValute.xml"/>
  <form name="frmValutaBrisi" path="frmValute.xml"/>
  <form name="frmObustaveDetEdit" path="frmObustaveDetEdit.xml"/>
  <form name="frmObustavaPromet" path="frmObustavaPromet.xml"/>
  <form name="frmObustavaPrometEdit" path="frmObustavaPromet.xml"/>
  <form name="frmObustavaPrometBrisi" path="frmObustavaPromet.xml"/>
   
  <form name="frmObustavaMirovanje" path="frmObustavaMirovanje.xml"/>
  <form name="frmObustavaMirovanjeEdit" path="frmObustavaMirovanje.xml"/>
  <form name="frmObustavaMirovanjeBrisi" path="frmObustavaMirovanje.xml"/>

