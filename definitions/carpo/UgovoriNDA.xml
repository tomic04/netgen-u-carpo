    <form name="frmFilter" caption="Filter" fixedsize="true">
        <layout textposition="top">
            <group cols="2" rows="1">
                <item caption="Datum od:" col="1" row="1">
                    <dateedit name="datDatumOd" required="true" value="now" />
                </item>
                <item caption="Datum od:" col="2" row="1">
                    <dateedit name="datDatumDo" required="true" value="now" />
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnSpremi" caption="Prihvati">
                    <event type="click">
                        <action type="validate"/>
                        <action type="variable value">
                            <parameter name="parent.tmpId" value="1"/>
                            <parameter name="parent.DatumOd" value="#datDatumOd"/>
                            <parameter name="parent.DatumDo" value="#datDatumDo"/>
                        </action>
                        <action type="form close"/>
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel">
                    <event type="click">
                        <action type="form close"/>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
    </form>
    <form name="frmPromjenaStatusa" path="frmPromjenaStatusa.xml"/>
    <form name="frmPovijestStatusa" path="frmPovijestStatusa.xml"/>
    <form name="frmUgovoriNDAEdit" path="frmUgovoriNDAEdit.xml"/>
    <datalist>
        <data command="spTraziPartneri" name="dtPartneri">
            <parameter name="@Action" value="Partneri" />
            <parameter name="@Uvjet" value="#srcPartner.text" />
            <parameter name="@broj_lokacija" value="1" />
        </data>
        <data command="spProd_PosUgovoriGla_UgovoriVrste" type="text" name="dtVrstaUgovora">
        </data>
        <data command="spProd_PosUgovoriGla_NDAmgQuery" name="dtMaster">
        </data>
        <data command="spProd_PosUgovoriGla_NDAQuery" name="dtGet">
            <parameter name="@Id" value="$PosUgovoriGlaId" />
        </data>
        <data command="spProd_PosUgovoriDet_Query" name="dtGetDet">
            <parameter name="@Id" value="$PosUgovoriGlaId" />
        </data>
        <data command="spProd_PosUgovoriDet_QueryGet" name="dtDetaljStavke">
            <parameter name="@Id" value="$PosUgovoriDetId" />
        </data>
        <data command="spProd_PosUgovoriGla_Insert" name="dtAdd">
