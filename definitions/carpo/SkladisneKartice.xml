<?xml version="1.0" encoding="utf-8"?>
<root version="1.3" loglevel="4">
  <form type="master" maximized="true" statusbar="true" name="frmMaster" caption="Skladišne kartice" template="splitter" width="1300">
    <event type="init">
		<action type="datarun reader" value="Global.dtDajDefaulte"/>
		<action type="variable value">
			<parameter name="Global.TraziRoba_CijeneVP" value="~dtDajDefaulte.@TraziRoba_CijeneVP" type="int" />
			<parameter name="Global.TraziRoba_CijeneNab" value="~dtDajDefaulte.@TraziRoba_CijeneNab" type="int" />
			<parameter name="Global.TraziRoba_CijeneMP" value="~dtDajDefaulte.@TraziRoba_CijeneMP" type="int" />
			<parameter name="Global.TraziRoba_Umirovljeni" value="~dtDajDefaulte.@TraziRoba_Umirovljeni" type="int" />
			<parameter name="Global.TraziRoba_Dodatno" value="~dtDajDefaulte.@TraziRoba_Dodatno" type="int" />
			<parameter name="Global.TraziRoba_Stanje" value="~dtDajDefaulte.@TraziRoba_Stanje" type="int" />
			<parameter name="Global.TraziRoba_NaStanju" value="~dtDajDefaulte.@TraziRoba_NaStanju" type="int" />
			<parameter name="Global.TraziPartneri_Ind" value="~dtDajDefaulte.@TraziPartneri_Ind" type="string" />
			<parameter name="Global.ComboSkladiste_View" value="~dtDajDefaulte.@ComboSkladiste_View" type="string" />
			<parameter name="Global.ComboOrgShema_Ind" value="~dtDajDefaulte.@ComboOrgShema_Ind" type="string" />	
			<parameter name="Global.IndSkladKartice" value="1" type="int" />
			<parameter name="Global.SkladisteOrder" value="~dtDajDefaulte.@SkladisteOrder" type="string" />				
		</action> 	  
		<action type="datarun reader" value="Global.dtKonfig"/>
		<action type="datarun reader" value="Global.dtDatumi"/>
		<action type="datarun reader" value="Global.dtPopisSkladista"/>
		<action type="variable value">
			<parameter name="Global.FilterModel" value="~dtKonfig.@FilterModel" type="int" />
			<parameter name="Global.KlasaTip" value="~dtKonfig.@KlasaTip" type="int" />
			<parameter name="Global.Kolicine" value="~dtKonfig.@Kolicine" type="int" />
			<parameter name="Global.SkladisteDodatno" value="~dtKonfig.@SkladisteDodatno" type="int" />
			<parameter name="Global.Prikazi_NC" value="~dtKonfig.@Prikazi_NC" type="int" />
			<parameter name="Global.Prikazi_PC" value="~dtKonfig.@Prikazi_PC" type="int" />
		</action> 
		<action type="variable value">
			<parameter name="KomStSkl_Period" value="~dtDatumi.@KomStSkl_Period" type="int" />
		</action>
		<action type="variable value">
			<parameter name="KomStSkl_OznaciPolja" value="~dtDatumi.@KomStSkl_OznaciPolja" type="int" />
		</action>
		<action type="variable value">
			<parameter name="Global.KomStSkl_Order" value="~dtDatumi.@KomStSkl_Order" type="int" />
		</action>
		<action type="variable value">
			<parameter name="Ind_Datumi" value="0" type="int" />
		</action>
		<action type="variable value">
			<parameter name="IndPokazi" value="0"/>
		</action>	
    </event>
    <event type="onload">
      <action type="control disable" value="#btnRazdoblje,#btnKartica,#btnRekapitulacija,#btnIspisiGrid,#cmbJM"/>
      <action type="control populate" value="#cmbCjenik"/>
      <action type="control populate" value="#cmbDodatnaKlasa"/>
      <action type="control populate" value="#cmbKlasa"/>
      <action type="control value" value="#chkDatumi" if="$KomStSkl_Period==1">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#chkDatumi" else="">
        <parameter value="false" />
      </action>
      <action type="control value" value="#chkDodKlasa,#chkDobavljac,#chkKlasa" if="$KomStSkl_OznaciPolja==1">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#chkDodKlasa,#chkDobavljac,#chkKlasa" else="">
        <parameter value="false" />
      </action>
      <action type="control enable" value="#datDatumOd,#datDatumDo" if="#chkDatumi==true"/>
      <action type="control disable" value="#datDatumOd,#datDatumDo" if="#chkDatumi==false"/>
      <action type="control enable" value="#cmbKlasa,#chkKlasaIspod,#srcPartner,#cmbDodatnaKlasa,#chkDodKlasaIspod,#lblDobavljac,#lblKlasa,#lblDodKlasa" if="$KomStSkl_OznaciPolja==1"/>
      <action type="control disable" value="#cmbKlasa,#chkKlasaIspod,#srcPartner,#cmbDodatnaKlasa,#chkDodKlasaIspod,#lblDobavljac,#lblKlasa,#lblDodKlasa" else=""/>
      <action type="control value" value="#datDatumOd">
        <parameter value="~dtDatumi.@DatumOd"/>
      </action>
      <action type="control value" value="#datDatumDo">
        <parameter value="~dtDatumi.@DatumDo"/>
      </action>
      <action type="control value" value="#txtDioNaziva">
        <parameter value=""/>
      </action>
      <action type="control value" value="#cmbSkladiste">
        <parameter value="~dtPopisSkladista.@Skladista"/>
      </action>
    </event>
    <event type="onshown">
      <action type="control disable" value="#cmbKolicina,#cmbBroj,#cmbZaliha" if="Global.$Kolicine==1"/>
    </event>	
	<partsql name="partFilter" dataname="~dtPartFilter"></partsql>
	<partsql name="partGrid" dataname="~dtPartGrid"></partsql>
	<partsql name="partPanelButtons" dataname="~dtPartPanelButtons"></partsql>
    <datalist>
      <data command="spDatumi" name="dtDajDatum">
        <parameter name="@action" value="$varDatAction" />
      </data>
    </datalist>
  </form>
  <!-- <form name="frmRekapitulacija" path="KomStanjeSkladista.frmRekapitulacija.xml"></form> -->
  <!-- <form name="frmKartica" path="frmKartica.xml"></form> -->
  <form name="frmKartica" caption="Kartica artikla: {parent.#grdStavke.@Sifra} - {parent.#grdStavke.@Naziv} (JM: {parent.#grdStavke.@JM}) {$varKontingent}" 
	fixedsize="false" width="950" height="570">
		<partsql name="partKartica" dataname="~dtPartKartica"></partsql>
  </form>   
  <form name="frmPrikazDok" path="KomStanjeSkladista.frmPrikazDok.xml"></form>
  <form name="frmParametri" path="KomStanjeSkladista.frmParametri.xml"></form>
  <datalist>
    <data command="spTraziRoba" name="dtRoba">
      <parameter name="@action" value="Roba"/>
      <parameter name="@Uvjet" value="#srcRoba.text"/>
      <parameter name="@PokaziVPCijene" value="Global.$TraziRoba_CijeneVP" if="Global.$Prikazi_PC==1"/>
	  <parameter name="@PokaziVPCijene" value="0" else=""/>
      <parameter name="@PokaziNabCijene" value="Global.$TraziRoba_CijeneNab" if="Global.$Prikazi_NC==1"/>
	  <parameter name="@PokaziNabCijene" value="0" else=""/>
      <parameter name="@Retired" value="Global.$TraziRoba_Umirovljeni"/>
      <parameter name="@Prikazi_Dodatno" value="Global.$TraziRoba_Dodatno"/>
      <parameter name="@PokaziStanje" value="Global.$TraziRoba_Stanje"/>
	  <parameter name="@SamoNaStanju" value="Global.$TraziRoba_NaStanju"/>
	  <parameter name="@NizSkladista" value="#cmbSkladiste"/>
    </data>
    <data command="spTraziPartneri" name="dtPartneri">
      <parameter name="@Action" value="Partneri"/>
      <parameter name="@Uvjet" value="#srcPartner.text"/>
	  <parameter name="@Ind" value="Global.$TraziPartneri_Ind"/>
    </data>
    <data command="spNG_Combo" name="dtJM">
      <parameter name="@Action" value="jm"/>
    </data>
    <data command="spNG_Combo" name="dtVrCjenik">
      <parameter name="@Action" value="VrCjenik"/>
      <parameter name="@Order" value="Opis"/>
    </data>
    <data command="spNG_Combo" name="dtDodKlasa">
      <parameter name="@Action" value="DodatnaKlasa"/>
    </data>
    <data command="spNG_Combo" name="dtKlMasterRoba">
      <parameter name="@Action" value="KlMasterRoba"/>
      <parameter name="@Ind" value="1" if="Global.$KlasaTip==2"/>
	  <!-- <parameter name="@ime_kontrole" value="ID" if="Global.$KlasaTip==2"/> -->
    </data>
    <data command="spNG_Combo" name="dtSkladiste">
      <parameter name="@Action" value="skladiste"/>
      <parameter name="@Ind" value="1"/>
      <parameter name="@Oznaka" value="Global.$ComboSkladiste_View"/>
	  <parameter name="@Order" value="Global.$SkladisteOrder"/>
    </data>
    <data command="spNG_Combo" name="dtPopisSkladista">
      <parameter name="@Action" value="PopisSkladista"/>
      <parameter name="@Oznaka" value="Global.$ComboSkladiste_View"/>
    </data>
    <data command="spNG_Combo" name="dtOrgShema">
      <parameter name="@Action" value="OrgShema"/>
      <parameter name="@Ind" value="Global.$ComboOrgShema_Ind"/>
    </data>
    <data command="spKomercStanjeSklad_ComboGrupaSkladista" name="dtGrupaSkladista">
    </data>
    <data command="spKomercStanjeSklad_ComboKolicine" name="dtKolicina">
      <parameter name="@Action" value="kolicina" type="string"/>
    </data>
    <data command="spKomercStanjeSklad_ComboKolicine" name="dtZaliha">
      <parameter name="@Action" value="zaliha" type="string"/>
    </data>
    <data command="spKomercStanjeSklad_ComboKolicine" name="dtBroj">
      <parameter name="@Action" value="broj" type="string"/>
    </data>
    <data command="spKomercStanjeSklad_ComboKolicine" name="dtDatumi">
      <parameter name="@Action" value="datumi" type="string"/>
      <parameter name="@Ind" value="$Ind_Datumi" type="int"/>
      <parameter name="@Check" value="0" type="int" if="#chkDatumi==false"/>
      <parameter name="@Check" value="1" type="int" else=""/>
    </data>
    <data command="spKomercStanjeSklad_Grid" name="dtGrid" timeout="360">
      <parameter name="@robaid" value="#srcRoba" type="int"/>
      <parameter name="@vrcjenikid" value="#cmbCjenik" type="int"/>
      <parameter name="@roba_naziv" value="#txtDioNaziva" type="string"/>
      <parameter name="@jm_ind" value="0" type="int" if="#rdoSamoOsnovna==true"/>
      <parameter name="@jm_ind" value="1" type="int" if="#rdoSveDefinirane==true"/>
      <parameter name="@jm_ind" value="2" type="int" if="#rdoSamoJedna==true"/>
      <parameter name="@jmid" value="#cmbJM" type="int" if="#rdoSamoJedna==true"/>
      <parameter name="@kolicina_nula" value="#cmbBroj" type="int" if="#chkKolBroj==true"/>
      <parameter name="@kolicina_max" value="#cmbKolicina" type="int" if="#chkKolKolicina==true"/>
      <parameter name="@zaliha_max" value="#cmbZaliha" type="int" if="#chkKolZaliha==true"/>
      <parameter name="@kontingenti_groupby" value="1" type="int" if="#chkKontingent==true"/>
      <parameter name="@partneriid" value="#srcPartner" type="int" if="#chkDobavljac==true"/>
      <parameter name="@datumod" value="#datDatumOd" if="#chkDatumi==true"/>
      <parameter name="@datumdo" value="#datDatumDo" if="#chkDatumi==true"/>
      <parameter name="@dodklase_ispod" value="1" type="int" if="#chkDodKlasaIspod==true"/>
      <parameter name="@klrobaid" value="#cmbDodatnaKlasa" type="int" if="#chkDodKlasa==true"/>
      <parameter name="@strskl" value="#cmbSkladiste" type="string"/>
      <parameter name="@ind_carpo" value="1" type="int"/>
      <parameter name="@klase_ispod" value="1" type="int" if="#chkKlasaIspod==true"/>
      <parameter name="@niz_klasa" value="#cmbKlasa" type="string" if="#chkKlasa==true"/>
      <parameter name="@operateriid" value="@@operateriid" type="int"/>
      <!-- <parameter name="@grupaskladista" value="#cmbGrupaSkladista.@Naziv" type="string" if="Global.$SkladisteDodatno==1"/> -->
	  <parameter name="@strOrg" value="#cmbOrgShema" type="string" if="Global.$SkladisteDodatno==1"/>
	  <parameter name="@IndSkladKartice" value="Global.$IndSkladKartice" type="int"/>
    </data>
    <data command="spKomercStanjeSklad_ProvjeriDatume" name="dtProvjeriDatume">
      <parameter name="@datumod" value="#datDatumOd"/>
      <parameter name="@datumdo" value="#datDatumDo"/>
    </data>
    <data command="spDajPopisSkladista" name="dtOznacenaSkladista">
      <parameter name="@niz" value="#cmbSkladiste" type="string"/>
    </data>
    <data command="spProd_CheckPermission" name="dtCheckPermission">
      <parameter name="@OperateriId" value="@@OperateriId" />
      <parameter name="@Objekt" value="SkladisneKartice" />
      <parameter name="@Funkcija" value="$Funkcija" />
    </data>
	<data command="spKomercStanjeSklad_PartFilter" name="dtPartFilter">		
		<parameter name="@Granula" value="SkladisneKartice"/>
		<parameter name="@OperateriId" value="@@OperateriId"/>
	</data>
	<data command="spKomercStanjeSklad_Konfig" name="dtKonfig">		
		<parameter name="@Granula" value="SkladisneKartice"/>
		<parameter name="@OperateriId" value="@@OperateriId"/>
	</data>	
	<data command="spKomercStanjeSklad_PartGumbi" name="dtPartPanelButtons">		
		<parameter name="@Granula" value="SkladisneKartice"/>
		<parameter name="@OperateriId" value="@@OperateriId"/>
		<parameter name="@Ind" value="Panel"/>
	</data>
	<data command="spKomercStanjeSklad_PartGrid" name="dtPartGrid">		
		<parameter name="@Granula" value="SkladisneKartice"/>
		<parameter name="@OperateriId" value="@@OperateriId"/>
	</data>	
	<data command="spKomercStanjeSklad_Defaults" name="dtDajDefaulte"/>
	<data command="spKomercStanjeSklad_PartKartica" name="dtPartKartica">		
		<parameter name="@Granula" value="SkladisneKartice"/>
		<parameter name="@OperateriId" value="@@OperateriId"/>
	</data>		
  </datalist>
</root>