<root>
	<form name="frmRezervacija" type="master" caption="Rezervacije" width="1200" height="500">
		<!--manager forma-->
<!-- 		<event type="load">
			<action type="control enable" value="#cmbSkladiste, #cmbKlasifikacija, #srcRoba, #datDatumIzvrsenja, #cmbOsoba"  />
			<action type="control disable" value="#cmbSkladiste, #cmbKlasifikacija, #srcRoba, #datDatumIzvrsenja, #cmbOsoba"  />	
		</event> -->
		<event type="shown">
			<action type="variable value" >
				<parameter name="IndEnb" value="0" type="int"/>
			</action>
			<action type="variable value" >
				<parameter name="NoviId" value="0" type="int"/>
			</action>   			
		</event>
		<layout>
			<group rows="1" cols="2" >
				<columnsdefinition>
					<column position="1" size="20%"/>
					<column position="2" size="80%"/>
				</columnsdefinition>
				<group rows="6" cols="1" col="1" row="1" groupbordervisible="true">
					<item caption="Skladište:"  row="1" col="1">
						<comboedit name="cmbSkladiste3" autopopulate="true"  valuefield="SkladisteId" displayfield="Opis" datavalue="Global.dtSkladiste.@SkladisteId" dataname="Global.dtSkladiste">

						</comboedit>
					</item>
					<item caption="Klasifikacija:" row="2" col="1" >
						<comboedit name="cmbKlasifikacija" autopopulate="true"  valuefield="KlMasterRobaId" displayfield="Naziv" datavalue="~dtdtKlasifikacija.@KlMasterRobaId" dataname="dtKlasifikacija">

						</comboedit>
					</item>
					<item caption="Roba:" col="1" row="3">
						<searchedit name="srcRoba" fontsizedelta="1" fontbold="True" fieldtext="Roba3000" fieldvalue="RobaId"  entermovenextcontrol="false" dataname="Global.dtSearchRoba" function="srcRoba">
							<action type="variable value" >
								<parameter name="RobaId" value="#srcRoba" type="int"/>
								<parameter name="NazivRobe" value="#srcRoba.@Naziv"/>
								<!--#srcRoba.@Naziv <parameter name="NazivRobe" value="#txtNaziv"/> -->
							</action>						
						</searchedit>
					</item> 
					<item caption="Datum preuzimanja do:" col="1" row="4">
						<dateedit  name="datDatumIzvrsenja"  value="now" >
							  <event type="valuechanged">

							  </event>                                                                                          
						</dateedit>
					</item>
					<item caption="Odgovorna osoba:" row="5" col="1">
						<comboedit name="cmbOsoba" autopopulate="true"  valuefield="OsobeId" displayfield="Osoba" datavalue="Global.dtOdgovornaOsoba.@OsobeId" dataname="Global.dtOdgovornaOsoba">

						</comboedit>
					</item>
					<group caption="" name=""  cols="1" rows="2" col="1" row="6"  groupbordervisible="false" height="200">
						<rowsdefinition>
							<row position="1" size="50"/>
							<!-- <row position="2" size="70%"/> -->
						</rowsdefinition> 
						<item  row="1" col="1" colspan="1" rowspan="1">
							<button name="btnPokazi" caption="POKAŽI" >
								<event type="click">
									<action type="control populate" value="#grdGrid">
										<action type="control focus" value="#grdGrid">
										</action>
									</action>
									<action type="variable value" value="$IndEnb">
										<parameter  value="1" type="int" if="$IndEnb==0"/>
										<parameter  value="0" type="int" else=""/>
									</action>
									
									<action type="control caption" value="#btnPokazi">
									  <parameter value="UVJETI" if="$IndEnb==1"/>
									  <parameter value="POKAŽI" else=""/>
									</action>

									<!-- <action type="control visible" value="#btnPokazi"> -->
										<!-- <parameter value="false" /> -->
									<!-- </action> -->
									<!-- <action type="control visible" value="#btnPokazi2"> -->
										<!-- <parameter value="true" /> -->
									<!-- </action> -->
									<action type="control disable" value="#cmbSkladiste3, #cmbKlasifikacija, #srcRoba, #datDatumIzvrsenja, #cmbOsoba" />
									
								</event>
							</button>
						</item>

					</group>
				</group>

				<item row="1" col="2" rowspan="6" highlight="False"  >		
					<grid name="grdGrid" multiselect="true" key="RezervacijeId" bestfitonrefresh="true"  showgrouppanel="true" showfooter="false" savelayout="true" dataname="Global.dtGrid">								
						<fields>	
							<field name="DatumRezervacije" caption="Datum Rezervacije" />
							<field name="DatumPreuzimanja" caption="Datum Preuzimanja" />
							<field name="Cilj" caption="Rezervacija za" />
							<field name="Skladiste" caption="Skladište" />
							<field name="RobaDefKey" caption="Šifra" />
							<field name="Roba" caption="Roba" />
							<field name="Klasa" caption="Klasa robe" />
							<field name="Kolicina" caption="Količina" />
							<field name="Osoba" caption="Odgovorna osoba" />
							<field name="OrgDok" caption="Broj rezervacije" />
							<field name="Dokument" caption="Org. Dokument" />
							<field name="Proizvod" caption="Proizvod" />
						</fields>
					</grid>
				</item>		


			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<event type="click">
						<action type="form open" value="frmRezervacijaAzur">
						</action>
						<action type="variable value">
							<parameter name="IndEnb" value="0" type="int"/>
						</action>
						<action type="control populate" value="#grdGrid">
							<action type="control focus" value="#grdGrid">
								<parameter value="$NoviId" />
							</action>
						</action>	
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit">
					<event type="click">
						<action type="variable value">
							<parameter name="IndEnb" value="0" type="int"/>
						</action>
						<action type="form open" value="frmRezervacijaAzurEdit" if="#grdGrid.@RezervacijeId>0">
							<parameter name="RezId" value="#grdGrid.@RezervacijeId" />
							<parameter name="IndPonuda" value="#grdGrid.@ProPonDetId" />
						
							<action type="control populate keepfocus" value="#grdGrid" />
							<!-- <action type="control populate" value="#grdGrid"> -->
								<!-- <action type="control focus" value="#grdGrid"> -->
									<!-- <parameter value="$NoviId" /> -->
								<!-- </action> -->
							<!-- </action> -->
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="variable value">
							<parameter name="IndEnb" value="0" type="int"/>
						</action>
						<action type="confirm" value="Želite li obrisati rezervacije?">
							<action type="control foreachrow selected" value="#grdGrid">
								<action type="datarun nonquery" value="global.~dtDelete" />
							</action>
						</action>
						<action type="control populate" value="#grdGrid" />
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS" >
					<event type="click">
						<action type="control printcontrol" value="#grdGrid"/>
					</event>
				</button>
				<button name="btnKraj" caption="KRAJ" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
				<button name="btnHelp" caption="UPUTI ME" >

				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNG_Combo" name="dtKlasifikacija">
				<parameter name="@Action" value="KlMasterRoba"/>
			</data>
		</datalist>
	</form>
	<datalist>
		<data command="spTraziRoba" name="dtSearchRoba" >
			<parameter name="@Action" value="Roba" />
			<parameter name="@uvjet" value="#srcRoba.text" />		
		</data>
		<data command="spTraziOsobe" name="dtOdgovornaOsoba">
			<parameter name="@Action" value="NaseOsobe" />
		</data>
		<data command="spProd_Rezervacije_Pregled" name="dtGrid" if="$IndEnb==0">
			<parameter name="@Action" value="0"/>
			<parameter name="@KlMasterRobaId" value="#cmbKlasifikacija"/>
			<parameter name="@RobaId" value="#srcRoba"/>
			<parameter name="@SkladisteId" value="#cmbSkladiste3"/>
			<parameter name="@DatumPreuzimanja" value="#datDatumIzvrsenja"/>
			<parameter name="@OsobeId" value="#cmbOsoba"/>
		</data>
		<data command="select '' as RezervacijeId"  type="text" name="dtGrid" else="" />
		<data command="spProd_Rezervacije_Pregled" name="dtGet">
			<parameter name="@Action" value="0"/>
			<parameter name="@RezervacijeId" value="$RezId"/>
			<parameter name="@KlMasterRobaId" value="#cmbKlasifikacija"/>
			<parameter name="@RobaId" value="#srcRoba"/>
			<parameter name="@SkladisteId" value="#cmbSkladiste3"/>
			<parameter name="@DatumPreuzimanja" value="#datDatumIzvrsenja"/>
			<parameter name="@OsobeId" value="#cmbOsoba"/>
		</data>
		<data command="spNG_Combo" name="dtSkladiste">
			<parameter name="@Action" value="Skladiste"/>
			<parameter name="@Ind" value="1"/>
		</data>
		<data command="spNG_Combo" name="dtTrgovina">
			<parameter name="@action" value="Trgovina"/>
		</data>	

		<data command="spProd_Rezervacije_Brisanje" name="dtDelete">
			<parameter name="@ID" value="#grdGrid.@RezervacijeId" type="int"/>
		</data>	
	</datalist>
	
	<form name="frmRezervacijaAzur" path="frmRezervacija.xml"/>
	<form name="frmRezervacijaAzurEdit" path="frmRezervacijaEdit.xml"/>
	
</root>