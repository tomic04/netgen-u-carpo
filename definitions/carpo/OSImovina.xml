<root version="1.0">

	<!--*****************************************IMOVINA****************************************-->

	<form name="frmMaster" type="master" caption="Imovina" >
		<method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
		<method name="funDmsOpen" dll="DmsManagerV1" class="DmsManagerV1.Start" method="OpenDocument" />
		<method name="funDmsSave" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocuments" />
		<method name="fnDimenzije" dll="Dimenzije" class="DimenzijeNet.DimenzijeCarpo" method="run" />
		<event type="init">
			<action type="datarun reader" value="~dtOSBrisanje" />
			<action type="datarun reader" value="~dtOSDMS" />
			<action type="datarun reader" value="~dtTudjaUlaganjaTab" />
			<action type="datarun reader" value="~dtDimenzijeGumb" />
			<action type="variable value">
				<parameter name="Click" value="" type="string"/>
			</action>
		</event>
		<event type="onshown">
			<action type="control visible" value="#btnPovezi" if="~dtOSDMS.@Postavka==0">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#btnDimenzije" if="~dtDimenzijeGumb.@Postavka==0">
				<parameter value="false"/>
			</action>
			<action if="#tabs.selectedtab==Financijski">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdFinancijski.@StatusId==2||#grdFinancijski.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Smjestajni">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSmjestaj.@StatusId==2||#grdSmjestaj.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Trosak">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdTrosak.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Obracunski">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdObracunski.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Statusi">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdStatusi.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Klase">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdKlase.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Dodatni">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdDodatni.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==Sastavnice">
				<action type="control disable" value="#btnPovezi" />
				<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSastavnice.rowcount==0" />
				<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
			</action>
			<action elseif="#tabs.selectedtab==DMS">
				<action type="control enable" value="#btnPovezi" />
				<action type="control disable" value="#btnUnos,#btnIzmjena,#btnBrisanje" />
				<action type="control enable" value="#btnUnos,#btnIzmjena,#btnBrisanje" else="" />
			</action>
		</event>

		<managerlayout>
			<!--filter drveta-->
			<lookup name="filter" >
				<comboitem value="Grupe"/>
				<comboitem value="Statusi" />
				<comboitem value="Vrste"/>
				<comboitem value="Klase"/>
				<comboitem value="Organizacijske jedinice"/>
				<comboitem value="Filter imovine"/>
				<event type="valuechanged">
					<action type="variable value">
						<parameter name="global.filter" value="#filter" />
					</action>
				</event>
			</lookup>

			<!--*****stablo*****-->
			<tree name="tree"  keyfield="OSImovinaId"  filtermode="smart" expandedlevel="2" dataname="dtTree">

				<event type="focusedrowchanged">
					<action type="control populate" value="#grdImovina" />
				</event>
				<fields>
					<field name="Naziv" />
				</fields>
			</tree>

			<!--Grid Glava-->
			<grid name="grdImovina" key="OSImovinaId" type="master" async="true" dataname="dtMaster" preventfocusgroup="false" fieldsmartspaces="false" multiselect="true" bestfitonrefresh="true" savelayout="true">
				<fields inherited="true">
					<field name="InvBroj" caption="Inv. broj"  fixed="true"/>
					<field name="Naziv" caption="Naziv" fixed="true"/>
					<field name="Opis" fixwidth="500" rowautoheight="true"/>
					<!--treba nam barem jedan IF na bilo koje polje da krenemo u reincijalizaciju polja kako bismo mogli pronaći OsImovinaSmjestajDetId-->
					<field name="DatumNabave" caption="Datum nabave"  />
					<field name="DatumAktiviranja" caption="Datum aktiviranja"  />
					<field name="DatumOtpisa" caption="Datum početka otpisa"  />
					<field name="Status" caption="Status"  />
					<field name="Grupa" caption="Grupa"  />
					<field name="Vrsta" caption="Vrsta"  />
					<field name="TipAmortizacije" caption="Tip amortizacije"  />
					<field name="RedovnaStopa" caption="Redovna stopa"  />
					<field name="UbrzanaStopa" caption="Ubrzana stopa"  />
					<field name="JednokratnaStopa" caption="Jednokratna stopa"  />
					<field name="UmanjenaStopa" caption="Umanjena stopa"  />
					<field name="MjestoTroska" caption="Mjesto troška"  />
					<field name="KontoNabave" caption="Konto nabave"  />
					<field name="KontoPripreme" caption="Konto pripreme"  />
					<field name="KontoIspravka" caption="Konto ispravka"  />
					<field name="KontoTroska" caption="Konto troška"  />
					<field name="ZaduzeniSmjestaj" caption="Zaduženi smještaj"  />
				</fields>
				<!--desni klik za brisanje-->
				<menu>
					<menuitem caption="Razduži imovinu" name="menRazdIm" sort="1">
						<event type="click">
							<action type="form open" value="frmIzmjSmj" >
								<parameter name="SelectedIds" value="#grdImovina.selectedids" />
								<parameter name="Tip" value="Razduzenje" />
								<parameter name="caption" value="Razduženje imovine" />
							</action>
							<action type="control populate" value="#grdImovina" />
						</event>
					</menuitem>
					<menuitem caption="Izmijeni smještaj" name="menIzmjSmj" sort="2">
						<event type="click">
							<action type="form open" value="frmIzmjSmj" >
								<parameter name="SelectedIds" value="#grdImovina.selectedids" />
								<parameter name="Tip" value="Prezaduzenje" />
								<parameter name="caption" value="Izmjena smještaja imovine" />
							</action>
							<action type="control populate" value="#grdImovina" />
						</event>
					</menuitem>
					<menuitem caption="Izmijeni status" name="menIzmjStat" sort="3">
						<event type="click">
							<action type="form open" value="frmIzmjStat" >
								<parameter name="SelectedIds" value="#grdImovina.selectedids" />
								<parameter name="Tip" value="Statusi" />
								<parameter name="caption" value="Izmjena statusa imovine" />
							</action>
							<action type="control populate" value="#grdImovina" />
						</event>
					</menuitem>
					<menuitem caption="Izmijeni mjesto troška" name="menIzmjTro" sort="4">
						<event type="click">
							<action type="form open" value="frmIzmjTro" >
								<parameter name="SelectedIds" value="#grdImovina.selectedids" />
								<parameter name="Tip" value="Mjesto troska" />
								<parameter name="caption" value="Izmjena mjesta troška imovine" />
							</action>
							<action type="control populate" value="#grdImovina" />
						</event>
					</menuitem>
					<menuitem caption="Izmijeni obračunske podatke" name="menIzmjObr" sort="5">
						<event type="click">
							<action type="form open" value="frmIzmjObr" >
								<parameter name="SelectedIds" value="#grdImovina.selectedids" />
								<parameter name="Tip" value="Obracunski podaci" />
								<parameter name="caption" value="Izmjena obračunskih podataka" />
							</action>
							<action type="control populate" value="#grdImovina" />
						</event>
					</menuitem>

					<!-- BRISANJE IMOVINE ONEMOGUĆENO NA ZAHTJEV KORISNIKA-->
					<menuitem caption="Obriši" name="menObrisi" sort="6" function="ObrisiOS">
						<event type="click">
							<action type="validate"/>
							<action type="datarun reader" value="~dtKontrolaBrisanje" />
							<action type="confirm" value="Da li ste sigurni da želite obrisati imovinu?" if="~dtKontrolaBrisanje.@Id==0">
								<action type="datarun reader" value="~dtDelImovina"  waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..."/>
								<action type="message" value="~dtDelImovina.@Poruka" />
							</action>
							<action type="message" value="~dtKontrolaBrisanje.@Poruka" if="#dtKontrolaBrisanje.@Id!=0"/>
							<action type="control populate" value="#grdImovina" if="~dtDelImovina.@IndGreska==0"/>
						</event>
					</menuitem>
					<!--<menuitem type="separator"/>-->
					<!--kartica os-->
					<menuitem caption="Kartica OS" sort="7">
						<event type="click">
							<action type="form open" value="frmOSKartica" >
								<parameter name="OSImovinaId" value="#grdImovina.@OSImovinaId" type="int" />
								<parameter name="NabavaRootId" value="0" type="int" />
								<parameter name="NazivImovina" value="{#grdImovina.@InvBroj} {#grdImovina.@Naziv}" />
							</action>
						</event>
					</menuitem>
          <menuitem type="separator"/>
          <menuitem caption="Kopiranje OS" sort="8">
            <event type="click">
              <action type="form open" value="frmKopiranje" >
                <parameter name="OSImovinaId" value="#grdImovina.@OSImovinaId" type="int" />
                <parameter name="Tip" value="Kopiranje OS" />
                <parameter name="Caption" value="Kopiranje podataka za {#grdImovina.@InvBroj} {#grdImovina.@Naziv}" />
              </action>
            </event>
          </menuitem>


				</menu>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdFinancijski"/>
					<action type="control populate" value="#grdSmjestaj"></action>
					<action type="control populate" value="#grdTrosak"></action>
					<action type="control populate" value="#grdObracunski"></action>
					<action type="control populate" value="#grdStatusi"></action>
					<action type="control populate" value="#grdKlase"></action>
					<action type="control populate" value="#grdOsnovni"></action>
					<action type="control populate" value="#grdDodatni"></action>
					<action type="control populate" value="#grdSastavnice"></action>
					<action type="control populate" value="#grddms"></action>
					<action type="control populate" value="#grdTudjaUlaganja"></action>

					<!--prvo enejblaj sve gumbe, a onda hendlaj ponašanje-->
					<action type="control enable" value="#btnUnos,#btnIzmjena,#btnBrisanje"/>
					<action if="#tabs.selectedtab==Financijski">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdFinancijski.@StatusId==2||#grdFinancijski.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Smjestajni">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSmjestaj.@StatusId==2||#grdSmjestaj.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Trosak">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdTrosak.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Obracunski">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdObracunski.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Statusi">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdStatusi.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Klase">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdKlase.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Dodatni">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdDodatni.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Sastavnice">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSastavnice.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==DMS">
						<action type="control enable" value="#btnPovezi" />
						<action type="control disable" value="#btnUnos,#btnIzmjena,#btnBrisanje" />
						<action type="control enable" value="#btnUnos,#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<!--dodao i ovo obzirom se osnovni podaci mogu SAMO mijenjati-->
					<action elseif="#tabs.selectedtab==Osnovni">
						<action type="control disable" value="#btnUnos,#btnBrisanje"/>
					</action>
					<action type="menu enable" value="#menObrisi" if="~dtOSBrisanje.@Postavka==0&amp;&amp;global.$filter!=Filter imovine"/>
					<action type="menu disable" value="#menObrisi" else="" />
					<action type="menu enable" value="#menIzmjSmj" if="global.$filter==Filter imovine"/>
					<action type="menu disable" value="#menIzmjSmj" else="" />
					<action type="menu enable" value="#menRazdIm" if="global.$filter==Filter imovine"/>
					<action type="menu disable" value="#menRazdIm" else="" />
					<action type="menu enable" value="#menIzmjStat" if="global.$filter==Filter imovine"/>
					<action type="menu disable" value="#menIzmjStat" else="" />
					<action type="menu enable" value="#menIzmjTro" if="global.$filter==Filter imovine"/>
					<action type="menu disable" value="#menIzmjTro" else="" />
					<action type="menu enable" value="#menIzmjObr" if="global.$filter==Filter imovine"/>
					<action type="menu disable" value="#menIzmjObr" else="" />
				</event>
			</grid>
			<!--TABOVI u detalju-->
			<tabs name="tabs">
				<event type="selectedtabchanged">
					<!--prvo enejblaj sve gumbe, a onda hendlaj ponašanje-->
					<action type="control enable" value="#btnUnos,#btnIzmjena,#btnBrisanje"/>
					<action type="control disable" value="#btnUnos" if="#tabs.selectedtab==Osnovni" />
					<action type="control enable" value="#btnUnos" else="" />
					<action type="control disable" value="#btnBrisanje" if="#tabs.selectedtab==Osnovni" />
					<action type="control enable" value="#btnBrisanje" else="" />
					<action if="#tabs.selectedtab==Financijski">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdFinancijski.@StatusId==2||#grdFinancijski.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Smjestajni">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSmjestaj.@StatusId==2||#grdSmjestaj.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Trosak">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdTrosak.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Obracunski">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdObracunski.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Statusi">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdStatusi.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Klase">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdKlase.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Dodatni">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdDodatni.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==Sastavnice">
						<action type="control disable" value="#btnPovezi" />
						<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdSastavnice.rowcount==0" />
						<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
					</action>
					<action elseif="#tabs.selectedtab==DMS">
						<action type="control enable" value="#btnPovezi" />
						<action type="control disable" value="#btnUnos,#btnIzmjena,#btnBrisanje" />
						<action type="control enable" value="#btnUnos,#btnIzmjena,#btnBrisanje" else="" />
					</action>
				</event>
				<tab caption="Promet financijski" name="Financijski">
					<grid name="grdFinancijski" dataname="dtFinancijski" fieldsmartspaces="false" bestfitonrefresh="true">
						<fields inherited="true">
							<field name="DatumPromjene" caption="Datum stavke"/>
						</fields>
						<menu>
							<menuitem caption="Otključaj dokument" name="menOtklj" sort="1" function="OtkljucajOSFin">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite otključati dokument?" >
										<!--<action type="message" value="#grdInvImovina.selectedids" />-->
										<action type="datarun reader" value="~dtOtkljucaj"  />
									</action>
									<action type="control populate" value="#grdFinancijski" />
								</event>
							</menuitem>
							<menuitem caption="Zaključi dokument" name="menZaklj" sort="2" function="ZakluciOSFin">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite zaključiti dokument?" >
										<!--<action type="message" value="#grdInvImovina.selectedids" />-->
										<action type="datarun reader" value="~dtZaključaj"  />
									</action>
									<action type="control populate" value="#grdFinancijski" />
								</event>
							</menuitem>
						</menu>
						<event type="focusedrowchanged" >
							<action type="control disable" value="#btnIzmjena,#btnBrisanje" if="#grdFinancijski.@StatusId==2" />
							<action type="control enable" value="#btnIzmjena,#btnBrisanje" else="" />
							<action type="menu enable" value="#menOtklj" if="#grdFinancijski.@StatusId==2"/>
							<action type="menu disable" value="#menOtklj" else="" />
							<action type="menu enable" value="#menZaklj" if="#grdFinancijski.@StatusId==1"/>
							<action type="menu disable" value="#menZaklj" else="" />
						</event>
						<styles>
							<style name="fontcolor" value="#000000" if="#grdFinancijski.@statusid==1" />
							<style name="fontcolor" value="#008000" if="#grdFinancijski.@statusid==2" />
						</styles>
					</grid>
				</tab>
				<tab caption="Promet smještaj" name="Smjestajni">
					<grid name="grdSmjestaj" dataname="dtSmjestaj" fieldsmartspaces="false" bestfitonrefresh="true">
						<fields inherited="true">
							<field name="DatumDok" caption="Datum dokumenta"/>
						</fields>
						<menu>
							<menuitem caption="Otključaj dokument" name="menOtkljS" sort="1" function="OtkljucajOSSmj">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite otključati dokument?" >
										<!--<action type="message" value="#grdInvImovina.selectedids" />-->
										<action type="datarun reader" value="~dtOtkljucajDok"  />
									</action>
									<action type="control populate" value="#grdSmjestaj" />
								</event>
							</menuitem>
							<menuitem caption="Zaključi dokument" name="menZakljS" sort="2" function="ZakljucajOSSmj">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite zaključiti dokument?" >
