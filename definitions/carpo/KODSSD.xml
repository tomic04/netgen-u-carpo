<root>
	<!--	********** GLAVNA FORMA *************	-->
	<form name="frmNaziv" type="master" caption="Statusi - stavke - doprinosi" maximized="true">
		<event type="load">
			<action type="control populate" value="#grdStatusi"/>
		</event>
		<layout>
			<group cols="3" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column size="25%" position="1"/>
					<column size="45%" position="2"/>
					<column size="30%" position="3"/>
				</columnsdefinition>
				<group col="1" row="1" rowspan="2" cols="1" rows="8" caption="Statusi obračuna doprinosa" spacing="2,1,2,2">
				<item col="1" row="1" rowspan="8" highlight="False" >
					<grid name="grdStatusi" showgrouppanel="False" showfooter="False">
						<data command="spOOPSSDHRDopStatusiQuery">
							<parameter name="@Action" value="grid_statusi" type="string"/>
						</data>
						<event type="focusedrowchanged">
							<action type="control populate" value="#grdStavke"/>
						</event>
						<fields inherited="true">
							<field name="Oznaka" fixed="left"/>
							<field name="Naziv" fixed="left"/>
						</fields>
						<menu>
							<menuitem caption="Novi status" name="NoviStatus" function="NoviStatus">
								<event type="click">
									<action type="form open" value="frmEditDopStatus">
										<parameter name="caption" value="Unos statusa doprinosa" type="string"/>
									</action>
									<action type="control populate keepfocus" value="#grdStatusi"/>
								</event>
							</menuitem>
							<menuitem caption="Izmjena statusa" name="EditStatus" function="EditStatus">
								<event type="click">
									<action type="form open" value="frmEditDopStatus">
										<parameter name="caption" value="Izmjena statusa doprinosa '{#grdStatusi.@Naziv}'" type="string"/>
										<parameter name="HRDopStatusiId" value="#grdStatusi.@hrdopstatusiid"/>
									</action>
									<action type="control populate keepfocus" value="#grdStatusi">
									</action>
								</event>
							</menuitem>
							<menuitem caption="Brisanje statusa" name="BrisiStatus" function="BrisiStatusa">
								<event type="click">
									<action type="confirm" value="Želite li obrisati status: '{#grdStatusi.@Naziv}'?">
										<action type="datarun reader" value="~dtObrisiStatus">
											<action type="message" value="~dtObrisiStatus.@poruka"/>
											<action type="control populate keepfocus" value="#grdStatusi">
											</action>
										</action>
									</action>
								</event>
							</menuitem>
							<menuitem type="separator"/>
							<menuitem caption="Kopiranje postavki" name="KopiranjeStatus" function="KopiranjeStatus">
								<event type="click">
									<action type="form open" value="frmPostavkeStatusi">
										<parameter name="caption" value="Kopiranje postavki statusa doprinosa '{#grdStatusi.@Naziv}'" type="string"/>
										<parameter name="HRDopStatusiId" value="#grdStatusi.@hrdopstatusiid"/>
									</action>
									<action type="control populate keepfocus" value="#grdStatusi">
									</action>
								</event>
							</menuitem>
							<menuitem type="separator"/>
							<menuitem caption="AUDIT statusa" name="Audit" function="Audit">
								<event type="click">
									<action type="form open" value="frmAudit">
										<parameter name="caption" value="Audit statusa" type="string"/>
										<parameter name="HRDopStatusiId" value="#grdStatusi.@hrdopstatusiid"/>
									</action>
								</event>
							</menuitem>
						</menu>
					</grid>
				</item>
				</group>
				<group col="2" row="1" rowspan="2" cols="1" rows="8" caption="Dohodovne stavke" spacing="1,1,2,2">
				<item col="2" row="1" rowspan="8" highlight="False" >
					<grid name="grdStavke" showgrouppanel="False" showfooter="False" autopopulate="false" fieldsmartspaces="false">
						<data command="spLnOOPSSDQuery">
							<parameter name="@Action" value="stavke_za_status_query" type="string"/>
							<parameter name="@hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
						</data>
						<event type="focusedrowchanged">
							<action type="control populate" value="#grdDoprinosiStavka"/>
							<action type="control populate" value="#grdDoprinosiRaspolozivi"/>
						</event>
						<fields inherited="true">
							<field name="Oznaka" fixed="left"/>
							<field name="Naziv" fixed="left"/>
							<field name="Bruto" fixed="left"/>
							<field name="Osiguranik" color="#000080"/>
							<field name="Primitak" caption="Primitak\nJOPPD"/>
							<field name="Beneficirani" caption="Beneficirani\nJOPPD"/>
							<field name="Neoporezivi_primitak" caption="Neoporezivi\nprimitak\nJOPPD"/>
							<field name="Nacin_isplate" caption="Način isplate\nJOPPD"/>
							<field name="Osiguranik_stavka" caption="Osiguranik\nJOPPD\nstavka"/>
							<field name="Primitak_stavka" caption="Primitak\nJOPPD\nstavka"/>
							<field name="Beneficirani_stavka" caption="Beneficirani\nJOPPD\nstavka"/>
							<field name="Neoporezivi_primitak_stavka" caption="Neoporezivi\nprimitak\nJOPPD\nstavka"/>
							<field name="Nacin_isplate_stavka" caption="Način isplate\nJOPPD\nstavka"/>
						</fields>
						<styles>
							<style name="fontcolor" value="blue" if="#grdStavke.fieldname==Osiguranik"/>
							<style name="fontcolor" value="blue" if="#grdStavke.fieldname==Primitak"/>
							<style name="fontcolor" value="blue" if="#grdStavke.fieldname==Beneficirani"/>
							<style name="fontcolor" value="blue" if="#grdStavke.fieldname==Neoporezivi_primitak"/>
							<style name="fontcolor" value="blue" if="#grdStavke.fieldname==Nacin_isplate"/>
							<style name="fontcolor" value="green" if="#grdStavke.fieldname==Osiguranik_stavka"/>
							<style name="fontcolor" value="green" if="#grdStavke.fieldname==Primitak_stavka"/>
							<style name="fontcolor" value="green" if="#grdStavke.fieldname==Beneficirani_stavka"/>
							<style name="fontcolor" value="green" if="#grdStavke.fieldname==Neoporezivi_primitak_stavka"/>
							<style name="fontcolor" value="green" if="#grdStavke.fieldname==Nacin_isplate_stavka"/>
						</styles>
						<menu>
							<menuitem caption="Nova stavka" name="NovaStavka" function="NovaStavka">
								<event type="click">
									<action type="form open" value="frmEditStavka">
										<parameter name="caption" value="Unos stavke" type="string"/>
										<parameter name="Tip" value="Unos" type="string"/>
										<parameter name="OOPStavkeId" value="null"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="Izmjena stavke" name="EditStavka" function="EditStavka">
								<event type="click">
									<action type="form open" value="frmEditStavka">
										<parameter name="caption" value="Izmjena stavke '{#grdStavke.@Naziv} ({#grdStavke.@Oznaka})'" type="string"/>
										<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId" type="int"/>
										<parameter name="Tip" value="Izmjena" type="string"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="Brisanje stavke" name="BrisiStavka" function="BrisiStavka">
								<event type="click">
									<action type="confirm" value="Želite li obrisati stavku: '{#grdStavke.@Naziv} ({#grdStavke.@Oznaka})'?">
										<action type="datarun reader" value="~dtObrisiStavku">
											<action type="message" value="~dtObrisiStavku.@poruka"/>
											<action type="control populate keepfocus" value="#grdStavke"/>
										</action>
									</action>
								</event>
							</menuitem>
							<menuitem type="separator"/>
							<menuitem caption="JOPPD postavke kombinacije" name="JOPPDStavka" function="BrisiStavka">
								<event type="click">
									<action type="form open" value="frmJOPPDStavka">
										<parameter name="caption" value="Izmjena JOPPD postavki za kombinaciju '{#grdStatusi.@Naziv} - {#grdStavke.@Naziv}'" type="string"/>
										<parameter name="LnOOPSSDGlaId" value="#grdStavke.@LnOOPSSDGlaId"/>
										<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId" type="int"/>
										<parameter name="OOPDoprinosiId" value="#grdDoprinosiRaspolozivi.@OOPDoprinosiId"/>
										<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
										<parameter name="Tip" value="Prijenos"/>
									</action>
								</event>
							</menuitem>
							<menuitem type="separator"/>
							<menuitem caption="Grupe stavaka" name="GrupeStavaka" function="GrupeStavaka">
								<event type="click">
									<action type="form open" value="frmGrupeStavaka">
										<parameter name="caption" value="Grupe stavaka" type="string"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="Grupiranje stavaka" name="GrupiranjeStavaka" function="GrupiranjeStavaka">
								<event type="click">
									<action type="form open" value="frmGrupiranjeStavaka">
										<parameter name="caption" value="Grupiranje stavaka" type="string"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="Označavanje stavaka" name="OznacavanjeStavaka" function="OznacavanjeStavaka">
								<event type="click">
									<action type="form open" value="frmOznacavanjeStavaka">
										<parameter name="caption" value="Označavanje stavaka" type="string"/>
									</action>
								</event>
							</menuitem>
							<menuitem type="separator"/>
							<menuitem caption="AUDIT stavaka" name="Audit1" function="Audit">
								<event type="click">
									<action type="form open" value="frmAudit">
										<parameter name="caption" value="Audit stavaka" type="string"/>
										<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="AUDIT kombinacija" name="Audit2" function="Audit">
								<event type="click">
									<action type="form open" value="frmAudit">
										<parameter name="caption" value="Audit kombinacija" type="string"/>
										<parameter name="LnOOPSSDGlaId" value="#grdStavke.@LnOOPSSDGlaId"/>
									</action>
								</event>
							</menuitem>
							<menuitem caption="Kopiranje postavki" name="PostavkeStavka" function="PostavkeStavka">
								<event type="click">
									<action type="form open" value="frmPostavkeStavka">
										<parameter name="caption" value="Kopiranje postavki za stavku '{#grdStavke.@Naziv} ({#grdStavke.@Oznaka})'" type="string"/>
										<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId" type="int"/>
										<parameter name="Tip" value="Kopiranje" type="string"/>
									</action>
								</event>
							</menuitem>
						</menu>
					</grid>
				</item>
				</group>
				<group col="3" row="1" cols="1" rows="4" caption="Doprinosi za odabranu stavku" spacing="1,2,1,2">
					<item col="1" row="1" highlight="False" rowspan="3">
						<grid name="grdDoprinosiStavka" showgrouppanel="False" showfooter="False" autopopulate="false" multiselect="true" key="lnOOPSSDDetId">
							<data command="spLnOOPSSDQuery">
								<parameter name="@Action" value="doprinosi_za_stavku_vezani_query" type="string"/>
								<parameter name="@LnOOPSSDGlaId" value="#grdStavke.@LnOOPSSDGlaId"/>
								<parameter name="@svi" value="#chkSvi"/>
							</data>
							<fields inherited="true">
								<field name="Datum" fixed="left"/>
								<field name="Naziv" fixed="left"/>
							</fields>
							<menu>
								<menuitem caption="Unos doprinosa" name="InsDop" function="InsDop">
									<event type="click">
										<action type="form open" value="frmInsDop">
											<parameter name="lnOOPSSDDetId" value="#grdDoprinosiStavka.@lnOOPSSDDetId"/>
											<parameter name="tip" value="unos" type="string"/>
											<parameter name="caption" value="Unos doprinosa za stavku '{#grdStavke.@Naziv} ({#grdStavke.@Oznaka})'" type="string"/>
											<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
											<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiStavka.@Naziv"/>
										</action>
									</event>
								</menuitem>
								<menuitem caption="Izmjena odabranog doprinosa" name="EditOdabDop" function="EditOdabDop">
									<event type="click">
										<action type="form open" value="frmIzmjenaDopJedan">
											<parameter name="caption" value="Izmjena doprinosa '{#grdDoprinosiStavka.@Naziv}'" type="string"/>
											<parameter name="lnOOPSSDDetId" value="#grdDoprinosiStavka.@lnOOPSSDDetId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiStavka.@Naziv"/>
											<parameter name="tip" value="izmjena odabranog"/>
										</action>
									</event>
								</menuitem>
								<menuitem caption="Izmjena vrijednosti" name="EditVr" function="EditVr">
									<event type="click">
										<action type="form open" value="frmIzmjenaVrijednosti">
											<parameter name="LnOOPSSDGlaId" value="#grdStavke.@LnOOPSSDGlaId"/>
											<parameter name="lnOOPSSDDetId" value="#grdDoprinosiStavka.@lnOOPSSDDetId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
											<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiStavka.@Naziv"/>
											<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId" type="int"/>
											<parameter name="caption" value="Izmjena vrijednosti doprinosa '{#grdDoprinosiStavka.@Naziv}'" type="string"/>
											<parameter name="tip" value="izmjena"/>
										</action>
									</event>
								</menuitem>
								<menuitem caption="Brisanje odabranih doprinosa" name="DelOdabDop" function="DelOdabDop">
									<event type="click">
										<action type="confirm" value="Da li ste sigurni da želite obrisati odabrane doprinose?">
											<!--<action type="message" value="#grdInvImovina.selectedids" />-->
											<action type="datarun reader" value="~dtDelOdabDop"/>
										</action>
										<action type="control populate" value="#grdStavke"/>
									</event>
								</menuitem>
								<menuitem caption="Brisanje doprinosa" name="DelDop" function="DelDop">
									<event type="click">
										<action type="form open" value="frmMultiDop">
											<parameter name="caption" value="Brisanje doprinosa" type="string"/>
											<parameter name="tip" value="brisanje"/>
										</action>
									</event>
								</menuitem>
								<menuitem type="separator"/>
								<menuitem caption="Analitika zapisa doprinosa" name="AnalDop" function="AnalDop">
									<event type="click">
										<action type="form open" value="frmAnalitikaDop">
											<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
											<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiStavka.@Naziv"/>
											<parameter name="caption" value="Analitika doprinosa '{#grdDoprinosiStavka.@Naziv}'" type="string"/>
											<parameter name="lnOOPSSDGlaId" value="#grdStavke.@lnOOPSSDGlaId"/>
										</action>
									</event>
								</menuitem>
								<menuitem type="separator"/>
								<menuitem caption="AUDIT doprinosa" name="Audit" function="Audit">
									<event type="click">
										<action type="form open" value="frmAudit">
											<parameter name="caption" value="Audit doprinosa" type="string"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
										</action>
									</event>
								</menuitem>
								<menuitem caption="Izmjena doprinosa" name="EditDop" function="EditDop">
									<event type="click">
										<action type="form open" value="frmMultiDop">
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiStavka.@OOPDoprinosiId"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiStavka.@Naziv"/>
											<parameter name="caption" value="Izmjena doprinosa '{#grdDoprinosiStavka.@Naziv}'" type="string"/>
											<parameter name="tip" value="izmjena"/>
										</action>
									</event>
								</menuitem>
								<menuitem type="separator"/>
								<menuitem caption="Kopiranje" name="CopyDop" function="CopyDop">
									<event type="click">
										<action type="form open" value="frmCopyDop">
											<parameter name="caption" value="Kopiranje doprinosa" type="string"/>
											<parameter name="tip" value="kopiranje"/>
										</action>
									</event>
								</menuitem>
							</menu>
						</grid>
					</item>
					<item col="1" row="4" highlight="false">
						<checkedit name="chkSvi" value="false" caption="Prikaži sve">
							<event type="valuechanged">
								<action type="control populate" value="#grdDoprinosiStavka"/>
							</event>
						</checkedit>
					</item>
				</group>
				<group col="3" row="2" cols="1" rows="4" caption="Neraspoređeni doprinosi za odabranu stavku" spacing="1,2,2,1">
					<rowsdefinition>
						<row size="10%" position="1"/>
						<row size="90%" position="2"/>
					</rowsdefinition>
					<item col="1" row="1" highlight="False"  rowspan="4" >
						<grid name="grdDoprinosiRaspolozivi" showgrouppanel="False" showfooter="False" autopopulate="false">
							<data command="spLnOOPSSDQuery">
								<parameter name="@Action" value="doprinosi_za_stavku_raspolozivi_query" type="string"/>
								<parameter name="@LnOOPSSDGlaId" value="#grdStavke.@LnOOPSSDGlaId"/>
							</data>
							<menu>
								<menuitem caption="Prenesi doprinos" name="InsDop" function="InsDop">
									<event type="click">
										<action type="form open" value="frmInsDop">
											<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiRaspolozivi.@OOPDoprinosiId"/>
											<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
											<parameter name="caption" value="Unos doprinosa {#grdDoprinosiRaspolozivi.@Naziv} za stavku '{#grdStavke.@Naziv} ({#grdStavke.@Oznaka})'" type="string"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiRaspolozivi.@Naziv"/>
											<parameter name="Tip" value="Prijenos"/>
										</action>
									</event>
								</menuitem>
								<menuitem type="separator"/>
								<menuitem caption="Analitika zapisa doprinosa" name="AnalDopNe" function="AnalDopNe">
									<event type="click">
										<action type="form open" value="frmAnalitikaDop">
											<parameter name="OOPStavkeId" value="#grdStavke.@OOPStavkeId"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiRaspolozivi.@OOPDoprinosiId"/>
											<parameter name="hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid"/>
											<parameter name="doprinosNaziv" value="#grdDoprinosiRaspolozivi.@Naziv"/>
											<parameter name="caption" value="Analitika doprinosa '{#grdDoprinosiRaspolozivi.@Naziv}'" type="string"/>
											<parameter name="lnOOPSSDGlaId" value="#grdStavke.@lnOOPSSDGlaId"/>
										</action>
									</event>
								</menuitem>
								<menuitem type="separator"/>
								<menuitem caption="AUDIT doprinosa" name="Audit" function="Audit">
									<event type="click">
										<action type="form open" value="frmAudit">
											<parameter name="caption" value="Audit doprinosa" type="string"/>
											<parameter name="OOPDoprinosiId" value="#grdDoprinosiRaspolozivi.@OOPDoprinosiId"/>
										</action>
									</event>
								</menuitem>
							</menu>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<datalist>
			<data command="spOOPSSD_Tree" name="dtTree">
				<parameter name="@Action" value="statusi" type="string"/>
			</data>
			<data command="spOOPSSDHRDopStatusiAzur" name="dtObrisiStatus">
				<parameter name="@Action" value="brisanje" type="string"/>
				<parameter name="@hrdopstatusiid" value="#grdStatusi.@hrdopstatusiid" type="int"/>
			</data>
			<data command="spOOPStavkeAzurCP" name="dtObrisiStavku">
				<parameter name="@Action" value="brisanje" type="string"/>
				<parameter name="@OOPStavkeId" value="#grdStavke.@OOPStavkeId" type="int"/>
			</data>
			<data command="spLnOOPSSDDetAzur" name="dtDelOdabDop">
				<parameter name="@Action" value="Brisanje_OdabDop"/>
				<parameter name="@SelectedIds" value="#grdDoprinosiStavka.SelectedIds"/>
			</data>
		</datalist>
	</form>
	<!--KRAJ POČETNE FORME - PODLOGE-->
	<form name="frmMultiDop" path="frmMultiDop.xml"/>
	<form name="frmIzmjenaDop" path="frmIzmjenaDop.xml"/>
