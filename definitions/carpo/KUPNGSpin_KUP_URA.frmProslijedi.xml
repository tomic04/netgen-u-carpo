<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: MULTISELECTPROFORM (NetGen) → frmProslijedi (Carpo)
Wizard korak 1: odabir operatera.
-->
<root version="1.2">
  <form name="frmProslijedi" caption="Proslijedi" type="dialog" width="520" height="220" fixedsize="true">
    <event type="shown">
      <action type="datarun scalar" value="~dtCheckOdobrenje">
        <parameter name="$KupStatusOdobrenjeId"/>
      </action>
      <action type="message" value="Dokument je poslan na odobrenje te se ne može proslijediti." if="$KupStatusOdobrenjeId==2"/>
      <action type="form close" if="$KupStatusOdobrenjeId==2"/>
      <action type="control populate" value="#cmbOperaterTo" if="$KupStatusOdobrenjeId!=2"/>
    </event>

    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1" caption="Operater:" textposition="left">
          <comboedit name="cmbOperaterTo"
                     dataname="~dtOperateri"
                     valuefield="OperateriId"
                     displayfield="Naziv"
                     required="true"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnDalje" caption="DALJE >>">
          <event type="click">
            <action type="validate"/>
            <action type="form open" value="frmProslijedi2">
              <parameter name="Id" value="$Id"/>
              <parameter name="OperaterTo" value="#cmbOperaterTo"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtCheckOdobrenje" type="text" command="select KupStatusOdobrenjeId from KUPPromet where KUPPrometId=@Id">
        <parameter name="@Id" value="$Id" type="int"/>
      </data>

      <data name="dtOperateri" type="text" timeout="300"
            command="select o.operateriid as OperateriId, o.naziv as Naziv
                    from ssoperateri o
                    where o.operateriid in (select distinct operateriid from kupstatusoperateri)
                    order by o.naziv"/>
    </datalist>
  </form>
</root>

