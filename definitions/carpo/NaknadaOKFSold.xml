
<!-- 07.06.2021. SV zamjenio #datum sa #datDo u knjiženju(dtProknjizi) -->
<!-- 07.05.2021. SV izbacio višak polja zbog zakonskih izmjena -->
<!-- 06.05.2021. SV zakomentirao columdefinition u panelima zbog nove verzije devexa -->
<!--program će raditi za jednu uplatu za Sokol, a kasnije ako bude bilo potrebe za druge nadograditi više akontacija-->
<root version="1.0.0." loglevel="3">
	<form name="frmGlavni" type="master" caption="Naknada za općekorisne funkcije šuma" width="700" height="" template="splitter" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtPrethodnaGodina"/>
			<action type="datarun reader" value="~dtNasId"/>			
		</event>
		<event type="load">
			<action type="variable value">
				<parameter name="IndUcitano" value="0"/>
			</action>
			<action type="variable value">
				<parameter name="PartneriId" value="~dtNasId.@VarSet"/>
			</action>
			<!-- <action type="control disable" value="#btnVirman"/> -->
		</event>
		<event type="shown">
			<action type="control value" value="#datDatum">
				<parameter value="now" type="date"/>
			</action>
			<action type="control value" value="#datOd">
				<parameter value="~dtPrethodnaGodina.@prvidan"/>
			</action>
			<action type="control value" value="#datDo">
				<parameter value="~dtPrethodnaGodina.@posljednjidan"/>
			</action>
			<action type="control value" value="#txtUkupni,#txtObracunato,#txtUplaceno,#txtUplata,#txtPovrat,#txtTromjesecna">
				<parameter value="0"/>
			</action>
			<!-- <action type="datarun reader" value="~dtBrojMjeseci"/> -->
			<!-- <action type="control value" value="#lblBrojMjeseci"> -->
				<!-- <parameter value="~dtBrojMjeseci.@brojmjeseci"/> -->
			<!-- </action> -->
			<action type="control value" value="#txtBrojRata">
				<parameter value="1"/>
			</action>
		</event>
		<layout name="panel1" >
			<group cols="1" rows="5" caption="OSNOVNO">
				<!-- <columnsdefinition> -->
					<!-- <column size="100" position="1"/> -->
				<!-- </columnsdefinition> -->
				<item col="1" row="1" caption="Datum:" textposition="left" fontsizedelta="1">
					<dateedit name="datDatum"/>
				</item>
				<!-- <item col="1" row="2" caption="Broj:" textposition="left" fontsizedelta="1"> -->
					<!-- <textedit name="txtBroj" allownull="false" type="numeric" format="n0"/> -->
				<!-- </item> -->
				<item col="1" row="2" caption="Obračun od:" textposition="left" fontsizedelta="1">
					<dateedit name="datOd" allownull="false">
						<!-- <event type="leave"> -->
							<!-- <action type="datarun reader" value="~dtBrojMjeseci"/> -->
							<!-- <action type="control value" value="#lblBrojMjeseci"> -->
								<!-- <parameter value="~dtBrojMjeseci.@brojmjeseci"/> -->
							<!-- </action> -->
						<!-- </event> -->
					</dateedit>
				</item>
				<item col="1" row="3" caption="Obračun do:" textposition="left" fontsizedelta="1">
					<dateedit name="datDo" allownull="false">
						<event type="leave">
							<!-- <action type="datarun reader" value="~dtBrojMjeseci"/> -->
							<!-- <action type="control value" value="#lblBrojMjeseci"> -->
								<!-- <parameter value="~dtBrojMjeseci.@brojmjeseci"/> -->
							<!-- </action> -->
							<!-- <action type="control focus" value="#btnUcitaj"/> -->
							<action type="control focus" value="#btnUcitaj"/>
						</event>					
					</dateedit>
				</item>
				<!-- <item col="1" row="5" caption="Broj mjeseci:" textposition="left" fontsizedelta="1"> -->
					<!-- <labeledit name="lblBrojMjeseci"/> -->
				<!-- </item>				 -->
				<item col="1" row="4" caption="Broj rata:" textposition="left" fontsizedelta="1">
					<textedit name="txtBrojRata" format="#,#" formattype="numeric" maxlength="1" enabled="false">
						<event type="valuechanged">
							<action type="control value" value="#txtBrojRata" if="#txtBrojRata==null">
								<parameter value="1"/>
							</action>
						</event>
					</textedit>
				</item>
				<item col="1" row="5"/>
			</group>
		</layout>
		<layout name="panel2" >
			<group cols="1" rows="1" caption="OBRAČUN">
				<!-- <columnsdefinition> -->
					<!-- <column size="400" position="1"/> -->
				<!-- </columnsdefinition> -->
				<group col="1" row="1" cols="1" rows="12" groupbordervisible="false">
					<item col="1" row="1" caption="01 Ukupni prihodi i primici" textposition="left" fontsizedelta="1">
						<textedit name="txtUkupni" format="n2" formattype="numeric" enabled="false" dock="right" allownull="false" textposition="right">
							<event type="valuechanged">
								<action type="control value" value="#txtUkupni" if="#txtUkupni==null">
									<parameter value="0"/>
								</action>
							</event>
						</textedit>
					</item>
					<item col="1" row="2" caption="02 Stopa" textposition="left" fontsizedelta="1" fontbold="true">
						<textedit name="txtStopa" value="0.0265%" enabled="false" textposition="right" fontbold="true"/>					
					</item>
					<item col="1" row="3" caption="03 Obračunati iznos (01x02)" textposition="left" fontsizedelta="1" fontbold="true">
						<textedit name="txtObracunato" format="n2" formattype="numeric" enabled="false" fontbold="true" allownull="false" textposition="right"/>					
					</item>
					<item col="1" row="4" caption="04 Uplaćeni iznos" textposition="left" fontsizedelta="1">
						<textedit name="txtUplaceno" format="n2" formattype="numeric" allownull="false" textposition="right">					
							<event type="valuechanged">
							<action type="control value" value="#txtUplaceno" if="#txtUplaceno==null">
								<parameter value="0"/>
							</action>
							<action type="datarun reader" value="~dtRazlika"/>
							<action type="control value" value="#txtUplata">
									<parameter value="~dtRazlika.@RazlikaUplata"/>
							</action>
							<action type="control value" value="#txtPovrat">
								<parameter value="~dtRazlika.@RazlikaPovrat"/>
							</action>
							<action type="control disable" value="#btnVirman" if="#txtPovrat>0"/>
							</event>
						</textedit>						
					</item>
					<item col="1" row="5" caption="05 Razlika za uplatu (03-04)" textposition="left" fontsizedelta="1">
						<textedit name="txtUplata" format="n2" formattype="numeric" enabled="false" allownull="false" textposition="right">
								<event type="valuechanged">
									<action type="datarun scalar"  value="~dtRazlika"/>
								</event> 
						</textedit>
					</item>
					<item col="1" row="6" caption="06 Razlika za povrat (04-03)" textposition="left" fontsizedelta="1">
						<textedit name="txtPovrat" format="n2" formattype="numeric" enabled="false" allownull="false" textposition="right">
								<event type="valuechanged">
									<action type="datarun scalar"  value="~dtRazlika"/>
									<action type="control enable" value="#btnVirman" if="#txtPovrat==0"/>
									<!-- <action type="control enable" value="#btnVirman" if="txtPovrat==0"/> -->
								</event> 
						</textedit>
					</item>
					<item col="1" row="7" caption="07 Tromjesečna akontacija za naredno razdoblje " textposition="left" fontsizedelta="1">
						<textedit name="txtTromjesecna" format="n2" formattype="numeric" enabled="false" allownull="false" textposition="right"/>					
					</item>
					<item col="1" row="12"/>					
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUcitaj" caption="UČITAJ"> <!--učita podatke 1-4 i ako ima uplaćeno i izračuna ostale-->
					<event type="click">
						<action type="message" value="Podaci su već učitani!" if="$IndUcitano==1"/>
						<action elseif="$IndUcitano==0">
							<action type="datarun reader" value="~dtPrihodUkupno"/>
							<action type="control value" value="#txtUkupni">
								<parameter value="~dtPrihodUkupno.@Iznos"/>
							</action>
							<action type="datarun reader" value="~dtUplaceno"/>
							<action type="control value" value="#txtUplaceno">
								<parameter value="~dtUplaceno.@Iznos"/>
							</action>						
							<action type="datarun reader" value="~dtObracun"/>
							<action type="control value" value="#txtObracunato">
								<parameter value="~dtObracun.@Obracun"/>
							</action>
							<!--♥ slučajno stvoreno, ostaje za uspomenu :) -->  
							<action type="control value" value="#txtUplata">
								<parameter value="~dtObracun.@RazlikaUplata"/>
							</action>
							<action type="control value" value="#txtPovrat">
								<parameter value="~dtObracun.@RazlikaPovrat"/>
							</action>
							<action type="control value" value="#txtTromjesecna">
								<parameter value="~dtObracun.@Tromjesecna"/>
							</action>
							<action type="variable value">
								<parameter name="IndUcitano" value="1"/>
							</action>
							<action type="datarun reader" value="~dtOperater"/>
							<!-- <action type="control enable" value="#btnVirman" /> -->
						</action>
					</event>
				</button>
				<button name="btnProknjizi" caption="PROKNJIŽI" dock="right">
					<event type="click">
						<action type="message" value="Najprije je potrebno učitati podatke!" if="$IndUcitano==0"/>
						<action elseif="$IndUcitano==1">
							<action type="messsage" if="#txtObracunato==null||#txtObracunato==0"/>
							<action else="">
								<action type="datarun nonquery" value="~dtProknjizi"/>
							</action>
						</action>
					</event>
				</button>
				<button name="btnVirman" caption="KREIRAJ VIRMAN" dock="right">
					<event type="click">
						<action type="message" value="Najprije je potrebno učitati podatke!" if="$IndUcitano==0"/>
						<action elseif="$IndUcitano==1">
							<action type="datarun nonquery" value="~dtVirman"/>
						</action>
						
					</event>
				</button>
				<button name="btnIspisi" caption="ISPIŠI OBRAZAC" dock="right">
					<event type="click">
						<action type="message" value="Najprije je potrebno učitati podatke!" if="$IndUcitano==0"/>
						<action elseif="$IndUcitano==1">
							<action type="datarun nonquery" value="~dtRepxPuni"/>
							<action type="print" value="repx:rptOKFS">
								<parameter name="PartneriId" value="$PartneriId"/>
								<parameter name="OperateriId" value="@@operateriid"/>
							</action>
						</action>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPrethodnaGodina" command="spCKntOKFSDatumi">
				<parameter name="@Action" value="1"/>
			</data>
			<!-- <data name="dtBrojMjeseci" command="spCKntOKFSDatumi"> -->
				<!-- <parameter name="@Action" value="2"/> -->
				<!-- <parameter name="@Od" value="#datOd"/> -->
				<!-- <parameter name="@Do" value="#datDo"/> -->
			<!-- </data> -->
			<data name="dtNasId" command="select VarSet from PubVars where VarIme='NasId'" type="text"/>
			
			
			<data name="dtPrihodUkupno" command="spCKntOKFSPopuni">
				<parameter name="@Action" value="2"/>
				<parameter name="@DatumOd" value="#datOd"/>
				<parameter name="@DatumDo" value="#datDo"/>
			</data>
			<data name="dtRazlika" command="spCKntOKFSPopuni">
				<parameter name="@Action" value="4"/> 
				<parameter name="@Obracunato" value="#txtObracunato"/> 
				<parameter name="@Uplata" value="#txtUplaceno"/> 
			</data>
			
			<data name="dtUplaceno" command="spCKntOKFSPopuni">
				<parameter name="@Action" value="1"/>			
				<parameter name="@DatumOd" value="#datOd"/>
				<parameter name="@DatumDo" value="#datDo"/>
				<parameter name="@Oznaka" value="8"/>
			</data>
			<data name="dtObracun" command="spCKntOKFSPopuni">
				<parameter name="@Action" value="3"/>
				<parameter name="@Ukupni" value="#txtUkupni"/>
				<parameter name="@Dugorocna" value="#txtDugorocna"/>
				<parameter name="@Otpisana" value="#txtOtpisana"/>
				<parameter name="@Dividende" value="#txtDividende"/>
				<parameter name="@Uplata" value="#txtUplata"/>
			</data>
			<data name="dtRepxPuni" command="spCKntOKFSRepx">
				<parameter name="@Action" value="2"/>
				<parameter name="@Polje1" value="#txtUkupni"/>
				<!-- <parameter name="@Polje2" value="#txtSTOPA"/> STOPA FIXNA  -->
				<parameter name="@Polje3" value="#txtObracunato"/>
				<parameter name="@Polje4" value="#txtUplaceno"/>
				<parameter name="@Polje5" value="#txtUplata"/>
				<parameter name="@Polje6" value="#txtPovrat"/> 
				<parameter name="@Polje7" value="#txtTromjesecna"/>
				<parameter name="@DatumOd" value="#datOd"/>
				<parameter name="@DatumDo" value="#datDo"/>
				<parameter name="@Datum" value="#datDatum"/>
			</data>
			<data name="dtProknjizi" command="spCKntOKFSKnjizenje">
				<parameter name="@Iznos" value="#txtObracunato"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@Datum" value="#datDo"/>
				<parameter name="@Uplaceno" value="#txtUplaceno"/>
			</data>
			<data name="dtVirman" command="spCKntOKFSVirman">
				<parameter name="@Action" value="1"/>
				<parameter name="@PartneriId" value="$PartneriId"/>
				<parameter name="@IznosObracunato" value="#txtObracunato"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@Uplaceno" value="#txtUplaceno"/>
			</data>
		</datalist>
	</form>
</root>