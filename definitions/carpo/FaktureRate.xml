<root version="1.0.0.2">
	<!-- SV. dodao novi gumb Izmijeni na glavnoj formi  -->
	<form name="frmFaktureRate" type="master" caption="Fakture Rate" width="900" height="400" statusbar="true">
		<event type="init"> 
			<action type="variable value" >
				<parameter name="NapuniGrid" value="0" />
			</action>
		</event>
		<event type="shown">
			<!-- zakomentirao dok generator rata ne bude valjan u potpunosti -->
			<!-- <action type="control enable" value="#btnRate" if="#grdStavke.rowcount!=0"/>   -->
			<!-- <action type="control disable" value="#btnRate" else=""/> -->
			<action type="control enable" value="#btnIzmjeniGla" if="#grdStavke.rowcount!=0"/>  
			<action type="control disable" value="#btnIzmjeniGla" else=""/>
		</event>
		<layout itemspadding="2" >
			<group cols="1" rows="3" groupbordervisible="false">
				<group cols="6" rows="3" col="1" row="1"  groupbordervisible="true">
					<columnsdefinition>
						<column size="400" position="1" />
						<column size="150" position="2" />
						<column size="150" position="3" />
						<column size="120" position="4" />
						<column size="100" position="5" />
						<column size="10" position="6" />
					</columnsdefinition>
					<item col="1" row="1"  textposition="left"   caption="Partner:" >						
						<searchedit  name="srcPartner"  fontsizedelta="1" fieldtext="Partner" fieldvalue="PartneriId" required="true" dataname="~dtGetPartneri" tabindex="2" savelayout="true" savevalue="app"/>
					</item>
					<item col="3" row="1"  textposition="left"   caption=" " />
					<item col="4" row="1"  textposition="left"   caption=" " />
					<item col="1" row="2"  textposition="left" caption="Broj(dio/cijeli):" >
						<textedit name="txtBroj"  required="true" fontcolor="green" savevalue="app" />
					</item>
					<item col="2" row="2" textposition="right" caption="Otvoreni" >
						<checkedit name="chkAktivan" savevalue="app" />
					</item>
					<item col="5" row="2" >
						<button caption="Izvrši" dock="right">
							<event type="click">
								<action type="control populate" value="#grdStavke"/>
								<!-- zakomentirao dok generator rata ne bude valjan u potpunosti -->
								<!-- <action type="control enable" value="#btnRate" if="#grdStavke.rowcount!=0"/> -->
								<!-- <action type="control disable" value="#btnRate" else=""/>  -->
								<action type="control enable" value="#btnIzmjeniGla" if="#grdStavke.rowcount!=0"/>
								<action type="control disable" value="#btnIzmjeniGla" else=""/> 
							</event>
						</button>	
					</item>
				</group>
				<item  cols="1" rows="1" col="1" row="2" highlight="false" >
					<grid name="grdStavke" dataname="~dtPrikaz" key="pronaplatarateId" multiselect="true"  headeralign="center" showgrouppanel="true" showfooter="false" savelayout="true">				
						<fields>	
							<field name="broj" caption="Broj fakture" />
							<field name="datumdok" caption="Datum fakture" />
							<field name="datumvalute" caption="**Valuta"	/>	
							<field name="vrijednost" caption="Vrijednost" />
							<field name="placeno" caption="Plaćeno" />
							<field name="ukupno" caption="Ukupno" />
							<field name="brojinstr" caption="**Instrument" />
							<field name="kntnacinplac" caption="**Način plaćanja" />
							<field name="nazivPartnera" caption="Partner" />
						</fields>	
						<event type="doubleclick">
							<!-- zakomentirao dok generator rata ne bude valjan u potpunosti -->
							<!-- <action type="control enable" value="#btnRate" if="#grdStavke.rowcount!=0"/> -->
							<!-- <action type="control disable" value="#btnRate" else=""/> -->
							<!-- <action type="form open" value="frmDokument"> -->
							<!-- <parameter name="BrojDok" value="#grdStavke.@Broj" /> -->
							<!-- <parameter name="DatumDok" value="#grdStavke.@DatumDok" type="date" /> -->
							<!-- <parameter name="FaktureID" value="#grdStavke.@faktureId" /> -->
							<!-- </action> -->
							<action type="form open" value="frmIzmjeniGla">
								<parameter name="tekst" value="izmjena" />
								<parameter name="ID" value="#grdStavke.@ProNaplataRateId" />
								<parameter name="FaktureID" value="#grdStavke.@faktureId" />
								<parameter name="datumDok" value="#grdStavke.@DatumDok" type="date" />
								<parameter name="datumValute" value="#grdStavke.@datumvalute" type="date" />
								<parameter name="Vrijednost" value="#grdStavke.@vrijednost" />
								<parameter name="kntNacinPlacId" value="#grdStavke.@kntnacinplacid"  />
								<parameter name="BrojFakture" value="#grdStavke.@broj"  />
								<parameter name="BrojInstr" value="#grdStavke.@brojinstr"  />
							</action>
						</event>
					</grid>
				</item>
			</group> 
		</layout >
		<panelbuttons>
			<buttons>
				<!-- zakomentirao dok generator rata ne bude valjan u potpunosti -->
				<!-- <button name="btnRate" caption="&amp;Rate" dock="left"> -->
				<!-- <event type="click"> -->
				<!-- <action type="form open" value="frmDokument"> -->
				<!-- <parameter name="BrojDok" value="#grdStavke.@Broj" /> -->
				<!-- <parameter name="DatumDok" value="#grdStavke.@DatumDok" type="date" /> -->
				<!-- <parameter name="FaktureID" value="#grdStavke.@faktureId" /> -->
				<!-- <parameter name="ProplauvjetiID" value="#grdStavke.@ProplauvjetiID" /> -->
				<!-- <parameter name="ProNOtpGlaId" value="#grdStavke.@ProNOtpGlaId" /> -->
				<!-- <parameter name="ProPonGlaId" value="#grdStavke.@ProPonGlaId" /> -->
				<!-- </action> -->
				<!-- </event> -->
				<!-- </button> -->
				<button name="btnIzmjeniGla" caption="&amp;Izmjeni" type="edit" dock="left">
					<event type="click">
						<action type="form open" value="frmIzmjeniGla">
							<parameter name="tekst" value="izmjena" />
							<parameter name="ID" value="#grdStavke.@ProNaplataRateId" />
							<parameter name="FaktureID" value="#grdStavke.@faktureId" />
							<parameter name="datumDok" value="#grdStavke.@DatumDok" type="date" />
							<parameter name="datumValute" value="#grdStavke.@datumvalute" type="date" />
							<parameter name="Vrijednost" value="#grdStavke.@vrijednost" />
							<parameter name="kntNacinPlacId" value="#grdStavke.@kntnacinplacid"  />
							<parameter name="BrojFakture" value="#grdStavke.@broj"  />
							<parameter name="BrojInstr" value="#grdStavke.@brojinstr"  />							
						</action>
						<action type="control populate keepfocus" value="#grdStavke"/>
					</event>
				</button>
				<button caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>	
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntTraziPartneri_FakRate" name="dtGetPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
			<data command="spCFakturerateQuery" name="dtPrikaz">
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@Broj" value="#txtBroj" /> 
				<parameter name="@Otvorene" value="#chkAktivan" />
			</data>
			<data command="select cast(cast(year(getdate()) as CHAR(4))+'0101' as DATE) as DatumOd,cast(getdate() as date) as DatumDo" type="text" name="dtSetDatum"/>
		</datalist>	
	</form>
	<form name="frmDokument" path="frmDokument.xml"/>
	<form name="frmDodaj" path="frmDodaj.xml"/>
	<form name="frmIzmjeni" path="frmIzmjeni.xml"/>
	<form name="frmIzmjeniGla" path="frmIzmjeniGla.xml"/>
	<form name="frmGeneriraj" path="frmGeneriraj.xml"/>
</root>