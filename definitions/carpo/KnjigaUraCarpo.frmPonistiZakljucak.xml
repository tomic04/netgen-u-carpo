<?xml version="1.0" encoding="utf-8"?>
<!-- PONISTI_ZAKLJUCAK_FORM - Poništavanje zaključka -->
<root version="1.2">
  <form name="frmPonistiZakljucak" type="custom" caption="Poništavanje zaključka" width="600" height="250">
    <event type="oninit">
      <action type="datarun reader" value="~dtTest"/>
    </event>
    <layout>
      <group rows="2" cols="1">
        <item row="1" col="1">
          <label name="lblPoruka" caption="Poništavate zaključak za datum {~dtTest.@maxdat}. Jeste li sigurni?"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnDa" caption="DA">
          <event type="click">
            <action type="datarun nonquery" value="~dtPonisti"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnNe" caption="NE" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtTest" command="spKntZakKnjUra" timeout="30">
        <parameter name="@action" value="ponisti_zakljucak_test"/>
        <parameter name="@node" value="$Node"/>
      </data>
      <data name="dtPonisti" command="spKntZakKnjUra" timeout="30">
        <parameter name="@action" value="ponisti_zakljucak"/>
        <parameter name="@node" value="$Node"/>
      </data>
    </datalist>
  </form>
</root>
