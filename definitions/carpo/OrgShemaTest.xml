<?xml version="1.0" encoding="utf-8"?>
<root>
  <form name="frmMaster" type="master" caption="Organizacijska shema">
    <managerlayout>
      <tree name="tree" keyfield="orgshemaid" allowselfdrag="true" dataname="datOrgTree" showcolumns="true" autofiltercondition="contains" expandallonload="true" expandedlevel="2">
        <fields>
          <field name="Naziv" />
          <field name="Oznaka" />
          <field name="Partner" />
          <field name="Iznos" type="String"/>
		  <field name="Umirovljeno"/>
		   <field name="Nadređena osoba"/>
        </fields>
        <menu>
          <menuitem caption="UNESI">
            <part name="prtUnesi">
            </part>
          </menuitem>
          <menuitem caption="IZMIJENI">
            <part name="prtIzmijeni">
            </part>
          </menuitem>
          <menuitem caption="OBRIŠI">
            <part name="prtObrisi">
            </part>
          </menuitem>
        </menu>
      </tree>
    </managerlayout>
    <panelbuttons displaycontrolsprint="false">
      <buttons type="tree">
        <button name="btnDrag" caption="SPREMI PROMJENE" type="selfdrag">
          <event type="click">
            <action type="datarun nonquery" value="~datOrgAzur" />
            <action type="control defaultmode" value="#tree" />
          </event>
        </button>
        <button name="btnDrag" caption="ODUSTANI" type="selfdragcancel">
          <event type="click">
            <action type="confirm" value="Želite odustati od reorganizacije?">
              <action type="control populate" value="#tree" />
              <action type="control dragmode" value="#tree" />
            </action>
          </event>
        </button>
        <button name="btnUnesi" caption="UNESI" type="add" begingroup="true" color="light">
          <part name="prtUnesi">
          </part>
        </button>
        <button name="btnEdit" caption="IZMIJENI" type="edit">
          <part name="prtIzmijeni">
          </part>
        </button>
        <button name="btnDelete" caption="OBRIŠI" type="delete">
          <part name="prtObrisi">
          </part>
        </button>
      </buttons>
      <!-- <buttons >
				<button name="btnDrag" caption="SPREMI PROMJENE" type="selfdrag" >
					<event type="click">
						<action type="datarun nonquery" value="~datOrgAzur" />
					</event>
				</button>
				<button name="btnUnesi" caption="UNESI" type="add" begingroup="true" color="light" >
					<part name="prtUnesi"></part>
				</button>
				<button name="btnEdit" caption="IZMIJENI" type="edit" >
					<part name="prtIzmijeni"></part>
				</button>
				<button name="btnDelete" caption="OBRIŠI" type="delete" >
					<part name="prtObrisi"></part>
				</button>
			</buttons> -->
    </panelbuttons>
    <datalist>
      <data command="spOrgShemaCarpoQuery" name="datOrgTree">
        <parameter name="Action" value="getTree" />
      </data>
      <data command="spOrgShemaCarpoTreeAzur" name="datOrgAzur">
        <parameter name="Action" value="setTree" />
        <parameter name="TableVar" value="#tree.datasource" />
      </data>
      <data command="spOrgShemaCarpoAzur" name="datOrgDelete">
        <parameter name="@Action" value="Delete" />
        <parameter name="@OrgShemaId" value="#tree" />
      </data>
    </datalist>
  </form>
  <form name="frmAzur" caption="Organizacijska shema - {$formType}" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~datGet" if="$Id!=null" />
    </event>
    <event type="shown">
      <action type="control focus" value="#txtNaziv" />
    </event>
    <layout textposition="top">
      <group cols="1" rows="2" if="$Id==null">
        <group row="1" col="1" cols="1" rows="1" caption="pozicioniranje u odnosu na selektiranu stavku" spacing="0,0,0,10">
          <group row="1" col="1" rows="1" cols="5" groupbordervisible="false">
            <item row="1" col="1" highlight="false">
              <radioedit name="rdo1" caption="Unutar" value="true" />
            </item>
            <item row="1" col="2" highlight="false">
              <radioedit name="rdo2" caption="Iza" enabled="false" />
            </item>
            <item row="1" col="3" highlight="false">
              <radioedit name="rdo3" caption="Ispred" enabled="false" />
            </item>
            <item row="1" col="4">
            </item>
            <item row="1" col="5" highlight="false">
              <checkedit name="chkFormClose" value="true" tooltip="Zatvori formu nakon spremanja" />
            </item>
          </group>
        </group>
        <group row="2" col="1" cols="1" rows="6" groupbordervisible="false">
          <part name="prtFormAzur">
          </part>
        </group>
      </group>
      <group cols="1" rows="6" else="">
        <part name="prtFormAzur">
        </part>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button caption="SPREMI" type="add" dock="right">
          <event type="click">
            <action type="validate" />
            <action type="datarun scalar" value="~datAzur" >
				<parameter name="shemaid"/>
			<!-- 	<action type="message" value="$shemaid"></action> -->
			</action>
            <action type="control populate keepfocus" value="parent.#tree"/>	
			<action type="control expand" value="parent.#tree">
				<parameter name="key" value="$shemaid"></parameter>
			</action>
            <action type="form close" if="$Id!=null||#chkFormClose==true" />
          </event>
        </button>
        <button caption="ODUSTANI" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOrgShemaCarpoAzur" name="datAzur">
        <parameter name="@Action" value="Add" if="$Id==null" />
        <parameter name="@Action" value="Edit" else="" />
        <parameter name="@OrgShemaId" value="$OrgShemaId" text="" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@PartneriId" value="#txtPartner" />
        <parameter name="@Iznos" value="#txtIznos" type="decimal" />
        <parameter name="@Opis" value="#txtOpis" />
        <parameter name="@InsertTip" value="in" if="#rdo1==true" />
        <parameter name="@InsertTip" value="down" elseif="#rdo2==true" />
        <parameter name="@InsertTip" value="up" else="" />
        <parameter name="@Umirovljeno" value="#chkUmirovljeno"/>
		<parameter name="@Nadosobaid" value="#cmbNadosoba"/>
      </data>
      <data command="spOrgShemaCarpoQuery" name="datGet">
        <parameter name="@Action" value="GetSingle" />
        <parameter name="@OrgShemaId" value="$OrgShemaId" />
      </data>
    </datalist>
  </form>
  <parts>
    <part name="prtUnesi">
      <event type="click">
        <action type="form open" value="frmAzur">
          <parameter name="OrgShemaId" value="#tree" />
          <parameter name="FormType" value="novi unos" />
        </action>
        <!-- <action type="control populate keepfocus" value="#tree" /> -->
      </event>
    </part>
    <part name="prtIzmijeni">
      <event type="click">
        <action type="form open" value="frmAzur" if="#tree.@Id!=-1">
          <parameter name="Id" value="1" />
          <!--pomoćna varijabla update/insert-->
          <parameter name="OrgShemaId" value="#tree" />
          <parameter name="FormType" value="izmjena" />
        </action>
        <action type="control populate keepfocus" value="#tree" />
      </event>
    </part>
    <part name="prtObrisi">
      <event type="click">
        <action type="confirm" value="Jeste li sigurni da želite obrisati org. shemu '{#tree.@Naziv}'?" if="#tree.@Id!=-1">
          <action type="datarun nonquery" value="~datOrgDelete" />
          <action type="control populate keepfocus" value="#tree" />
        </action>
      </event>
    </part>
    <part name="prtFormAzur">
      <item caption="Naziv:" row="1" col="1">
        <textedit name="txtNaziv" required="true" datavalue="~datGet.@Naziv" fontbold="true" />
      </item>
      <item caption="Oznaka:" row="2" col="1">
        <textedit name="txtOznaka" datavalue="~datGet.@Oznaka" maxsize="10" />
      </item>
      <item caption="Partner:" row="3" col="1">
        <searchedit type="partner" name="txtPartner" fieldtext="naziv" fieldvalue="PartneriId" datavalue="~datGet.@PartneriId" datatext="#datGet.@Partner">
        </searchedit>
      </item>
      <item caption="Iznos:" row="4" col="1">
        <textedit name="txtIznos" datavalue="~datGet.@Iznos" value="0" format="N2" />
      </item>
      <item caption="Opis:" row="5" col="1">
        <memoedit name="txtOpis" datavalue="~datGet.@Opis" entermovenextcontrol="true" />
      </item>
	   <item caption="" row="6" col="1">
        <checkedit caption="Umirovljeno" name="chkUmirovljeno" value="0" datavalue="~datGet.@Umirovljeno"/>
     
	</item>
	<item caption="Nadređena osoba:" row="7" col="1" >
	<comboedit name="cmbNadosoba" autopopulate="true" required="True" valuefield="Nadosobaid" displayfield="Naziv"  dataname="Global.dtGetNadosoba">

	</item>
    </part>
  </parts>
</root>