<root>
	<form name="frmPrimjer1" type="master" caption="Primjer grid">
		<event type="init">

		</event>
		<event type="load">
			<action type="control populate" value="#grdLinije1" />
			<action type="control populate" value="#grdLinije2" />
			<action type="control populate" value="#grdLinije3" />
			<action type="variable value">
				<parameter name="Ulaz_Ind" value="1" type="int" />
			</action>				
		</event>	
		<layout textposition="top" itemspConcating="3">
			<group cols="3" rows="12" backgroundcolor="">
				<columnsdefinition>
					<column size="33%" position="1" />
					<column size="33%" position="2" />
					<column size="33%" position="3" />
				</columnsdefinition>
				<item col="1" row="1" caption="Datum:"  textposition="left" fontsizedelta="13">
					<dateedit name="datDatum" value="now" fontsizedelta="13">
						<event type="valuechanged">
							<action type="control populate" value="#grdLinije1"/>
							<action type="control populate" value="#grdLinije2"/>
							<action type="control populate" value="#grdLinije3"/>
						</event>
					</dateedit>
				</item>
				<item row="3" col="1" rowspan="10" textvisible="False">
					<grid name="grdLinije1" showcolumnheaders="false" key="RajonId" fontsizedelta="16" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="False" savelayout="true" dataname="global.dtLijeviGridLinije" bestfitonrefresh="TRUE">
						<fields>
							<field name="Rajon" caption="Linija"/>
						</fields>
						<event type="focusedrowchanged" >
							<!-- <action type="message" value="1" />						 -->
							<action type="form open" value="frmDokumenti" if="#grdLinije1.@RajonId!=0">
									<parameter name="RajonId" value="#grdLinije1.@RajonId" />
							</action>
						</event>
					</grid>													
				</item>
				<item row="3" col="2" rowspan="10" textvisible="False">
					<grid name="grdLinije2" showcolumnheaders="false" key="RajonId" fontsizedelta="16" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="False" savelayout="true" dataname="global.dtSrednjiGridLinije" bestfitonrefresh="TRUE">
						<fields>
							<field name="Rajon" caption="Linija"/>
						</fields>
						<event type="focusedrowchanged" >

							<action type="form open" value="frmDokumenti" if="#grdLinije2.@RajonId!=0">
									<parameter name="RajonId" value="#grdLinije2.@RajonId" />
							</action>
						</event>								
					</grid>													
				</item>
				<item row="3" col="3" rowspan="10" textvisible="False">
					<grid name="grdLinije3" showcolumnheaders="false" key="RajonId" fontsizedelta="16" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="False" savelayout="true" dataname="global.dtDesniGridLinije" bestfitonrefresh="TRUE">
						<fields>
							<field name="Rajon" caption="Linija"/>
						</fields>
						<event type="focusedrowchanged" >

							<action type="form open" value="frmDokumenti" if="#grdLinije3.@RajonId!=0">
									<parameter name="RajonId" value="#grdLinije3.@RajonId" />
							</action>
						</event>
					</grid>
				</item>
			</group>

		</layout>
	</form>
	<!--<form name="frmKolicine" caption="Unos količina">
		<partsql name="partUnosKolicine" dataname="Global.dtPartUnosKolicine"></partsql>
	</form>-->
	<form name="frmDokumenti" caption="Dokumenti">
		<event type="init">
			<action type="variable value">
				<parameter name="Kolicina" value="0" type="int" />
			</action>			
		</event>
		<event type="load">
			<action type="control populate" value="#grdLokacije" />
		</event>
		<layout textposition="top" itemspConcating="3">
			<group cols="3" rows="2" backgroundcolor="">
				<columnsdefinition>
					<column size="30%" position="1" />
					<column size="37%" position="2" />
					<column size="33%" position="3" />
				</columnsdefinition>
				<rowsdefinition>
					<row size="90%" position="1" />
					<row size="10%" position="2" />
				</rowsdefinition>				
				<item col="1" row="1" rowspan="10" textvisible="False">
					<grid name="grdLokacije" showcolumnheaders="false" key="GlaId" fontsizedelta="12" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="False" savelayout="true" dataname="global.dtLokacije" bestfitonrefresh="TRUE">
						<event type="focusedrowchanged" >
							<action type="control populate" value="#grdGajbe" />
						</event>
					</grid>
				</item>
				<item col="2" row="1" rowspan="10" textvisible="False">
					<grid name="grdGajbe" showcolumnheaders="false" key="DetId" fontsizedelta="12" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="False" savelayout="true" dataname="global.dtGajbe" bestfitonrefresh="TRUE">
						<fields>
							<field name="Naziv" caption="Gajba"/>
							<field name="PraznaKolona" caption="Prazno"/>
							<field name="Kolicina" caption="Kolicina"/>
						</fields>
					</grid>
				</item>
				<item row="2" col="1" textvisible="False" colspan="3">
					<button name="btnDokumentiZatvori" caption="Povratak"  visible="true">
						<event type="click">
							<action type="form close"/>
						</event>
					</button>
				</item>
				<group col="3" row="1" cols="3" rows="5" >
					<columnsdefinition>
						<column size="33%" position="1" />
						<column size="33%" position="2" />
						<column size="33%" position="3" />
					</columnsdefinition>
					<rowsdefinition>
						<row size="20%" position="1" />
						<row size="20%" position="2" />
						<row size="20%" position="3" />
						<row size="20%" position="4" />
						<row size="20%" position="5" />
					</rowsdefinition>
					<item row="1" col="2" pConcating="0" colspan="3" highlight="false">
						<textedit name="curKolicina" value="0" format="n0" fontsizedelta="20" />
					</item>
					<item row="2" col="1" pConcating="0" highlight="false">
						<button name="btnJedan" caption="1" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="1" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>							
							</event>
						</button>	
					</item>
					<item row="2" col="2" pConcating="0" highlight="false">
						<button name="btnDva" caption="2" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="2" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="2" col="3" pConcating="0" highlight="false">
						<button name="btnTri" caption="3" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="3" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>		
					<item row="3" col="1" pConcating="0" highlight="false">
						<button name="btnCetiri" caption="4" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="4" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="3" col="2" pConcating="0" highlight="false">
						<button name="btnPet" caption="5" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="5" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="3" col="3" pConcating="0" highlight="false">
						<button name="btnSets" caption="6" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="6" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="4" col="1" pConcating="0" highlight="false">
						<button name="btnSedam" caption="7" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="7" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="4" col="2" pConcating="0" highlight="false">
						<button name="btnOsam" caption="8" visible="true" fontsizedelta="13">
							<!-- NKTN -->
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="8" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="4" col="3" pConcating="0" highlight="false">
						<button name="btnDevet" caption="9" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="9" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="5" col="1" pConcating="0" highlight="false">
						<button name="btnDelete" caption="&lt;&lt;" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="datarun reader" value="Global.dtKolicinaRemove"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaRemove.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>
					<item row="5" col="2" pConcating="0" highlight="false">
						<button name="btnNula" caption="0" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="variable value">
									<parameter name="KolicinaConcat" value="0" type="int" />
								</action>								
								<action type="datarun reader" value="Global.dtKolicinaConcat"/>
								<action type="control value" value="curKolicina">
									<parameter value="~dtKolicinaConcat.@Kolicina"/>
								</action>
							</event>
						</button>	
					</item>	
					<item row="5" col="3" pConcating="0" highlight="false">
						<button name="btnOK" caption="OK" visible="true" fontsizedelta="13">
							<event type="click">
								<action type="datarun nonquery" value="Global.~dtEditKolicina" />
								<action type="control populate keepfocus" value="#grdGajbe" />
								<action type="control value" value="curKolicina">
									<parameter value="0"/>
								</action>									
							</event>
						</button>	
					</item>						
				</group>
			</group>
		</layout>
		<datalist>
		</datalist>
	</form>

	<datalist>
		<data command="spOtpremaAmbalaza_Linije" name="dtLijeviGridLinije">
			<parameter name="@Datum" value="#datDatum"/>
			<parameter name="@Set" value="1"/>
		</data>
		<data command="spOtpremaAmbalaza_Linije" name="dtDesniGridLinije">
			<parameter name="@Datum" value="#datDatum"/>
			<parameter name="@Set" value="3"/>
		</data>
		<data command="spOtpremaAmbalaza_Linije" name="dtSrednjiGridLinije">
			<parameter name="@Datum" value="#datDatum"/>
			<parameter name="@Set" value="2"/>
		</data>
		<data command="spOtpremaAmbalaza_Dokumenti" name="dtLokacije">
			<parameter name="@Datum" value="parent.#datDatum"/>
			<parameter name="@RajonId" value="$RajonId"/>
		</data>
		<data command="spOtpremaAmbalaza_Gajbe" name="dtGajbe">
			<parameter name="@GlaId" value="#grdLokacije.@GlaId"/>
		</data>
		<data command="dbo.spOtpremaAmbalaza_KolicinaConcat" name="dtKolicinaConcat">
			<parameter name="@Action" value="Concat"/>
			<parameter name="@Kolicina" value="#curKolicina"/>
			<parameter name="@KolicinaConcat" value="$KolicinaConcat"/>
		</data>	
		<data command="dbo.spOtpremaAmbalaza_KolicinaConcat" name="dtKolicinaRemove">
			<parameter name="@Action" value="Remove"/>
			<parameter name="@Kolicina" value="#curKolicina"/>
		</data>		
		<data command="dbo.spOtpremaAmbalaza_Gajbe_Azur" name="dtEditKolicina">
			<parameter name="@Id" value="#grdGajbe.@DetId"/>
			<parameter name="@Kolicina" value="#curKolicina"/>
			<parameter name="@Ind" value="#grdGajbe.@Indikator"/>
		</data>			
	</datalist>	
</root>