<root>
	<form name="frmMaster" type="master" caption="Narudžbe kupaca">

    <event type="load">
        <action type="form open" value="frmFilter"/>
		<action type="control populate" value="#grdMaster" />
		
    </event>
		<managerlayout>
			<grid type="master" name="grdMaster" dataname="~dtPuniMaster"  key="ProNarudzbeGlaId">
				<menu>
					<menuitem name="vratistatus" caption="Vrati status" function="vratistatus">	
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite vratiti status?" />
							<action type="datarun nonquery" value="~dtPonistiZakljucak" /> 
							<action type="control populate keepfocus" value="#grdMaster" />
							<action type="control populate" value="#grdDetalj" />
							
						</event>
					</menuitem>
				</menu>
				<fields inherited="true">
					<field name="Otpremljeno" hidden="false" />
				</fields>

				<event type="focusedrowchanged" >
          			<action type="control populate" value="#grdDetalj" />
		  			<action type="control disable" value="#btnObrisi, #btnPromijeniStatus" if="#grdMaster.@Zakljuceno=='Zaključen'"/>
					<action type="control enable" value="#btnObrisi, #btnPromijeniStatus" else=""/>
					<action type="control disable" value="#btnOtpremi" if="#grdMaster.@Zakljuceno=='Nezaključen'||#grdMaster.@Otpremljeno==1"/>
				
					<action type="control enable" value="#btnOtpremi" elseif="#grdMaster.@Otpremljeno==0&amp;&amp;#grdMaster.@Zakljuceno=='Zaključen'"/>

	
					<action type="menu disable" value="#vratistatus"  if="#grdMaster.@Zakljuceno=='Nezaključen'||#grdMaster.@Otpremljeno==1" />
					<action type="menu enable" value="#vratistatus" else="#grdMaster.@Otpremljeno==0&amp;&amp;#grdMaster.@Zakljuceno=='Zaključen'" />
	
					

        		</event>

				<event type="doubleclick">
						<action type="form open" value="frmIzmjena">
							<parameter name="GlavaId" value="#grdMaster.@ProNarudzbeGlaId"/>
						</action>	
						
						<action type="control populate keepfocus" value="#grdMaster" /> 
				</event>
			
			</grid>

            <grid name="grdDetalj" dataname="~dtPuniDetalj">
				<fields>
					<field name="Roba" caption="Roba"/>
					<field name="Sifra" caption="Šifra" />
					<field name="Kolicina" caption="Količina" />
					<field name="JM" caption="JM" />
					<field name="Rajon" caption="Rajon" />
					<field name="Skladiste" caption="Skladište" />
					<field name="Kolicina2" caption="Količina 2" />
					<field name="JM2" caption="JM 2" />
					<field name="Napomena" caption="Napomena" />
					<field name="Cijena" caption="Cijena" />
					<field name="Rabat" caption="Rabat" />
					<field name="NacinIsporuke" caption="Način isporuke" />
					<field name="BrojNarudzbe" caption="Broj narudžbe" />
					<field name="Operater" caption="Operater" />
					<field name="Ruta" caption="Ruta" />
					<field name="OrgShema" caption="Org shema" />
					<field name="NalogZaOtpremu" caption="Nalog za otpremu" />
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" function="btnUnesi">
					<event type="click">
						<action type="form open" value="frmUnos"/>	
						
					</event>
				</button>

				<button name="btnIzmjeni" caption="Izmjeni" function="btnIzmjeni">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="GlavaId" value="#grdMaster.@ProNarudzbeGlaId"/>
							<parameter name="IndKopirano" value="0" />
						</action>	
						
						<action type="control populate keepfocus" value="#grdMaster" /> 
						<!-- <action type="control focus" value="#grdMaster">
                    		<parameter value="$GlavaId"/>
               			 </action> -->
			<!-- </action> -->

						<!-- <action type="message" value="$DatumOd" />
						<action type="message" value="$DatumDo" />
						<action type="message" value="$PartneriId" />
						<action type="message" value="$TrgovinaId" />
						<action type="message" value="$ParStruId" />
						<action type="message" value="$ProNarudzbeVrstaPrometaId" />  -->
					</event>
				</button>

				<button name="btnObrisi" caption="Obriši" function="btnObrisi">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati narudžbu?" />
						<action type="datarun nonquery" value="~dtObrisi" /> 
						<action type="control populate keepfocus" value="#grdMaster" />
					 	<action type="control populate" value="#grdDetalj" />
					</event>
				</button >

				<button name="btnFiltriraj" caption="Filter" function="btnFiltriraj">
					<event type="click">
						<action type="form open" value="frmFilter">
							<parameter name="GlavaId" value="#grdMaster.@ProNarudzbeGlaId"/>
						</action>	
						<action type="control populate" value="#grdMaster">
							
						</action>
					</event>
				</button >
				

				<button name="btnKopiraj" caption="Kopiraj" function="btnKopiraj">
					<event type="click">
						<action type="form open" value="frmKopiraj" />
						<action type="control populate" value="#grdMaster">
							<action type="control focus" value="#grdMaster">
								<parameter value="global.$GlavaIdKopirano"/>
							</action>	
						</action>	
					</event>
				</button >
				<button name="btnPromijeniStatus" caption="PromijeniStatus"  function="btnPromijeniStatus">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite promijeniti status?" />
						<action type="datarun nonquery" value="~dtPromijeniStatus" /> 
						<action type="control populate keepfocus" value="#grdMaster" />
					 	<action type="control populate" value="#grdDetalj" />
					</event>
				</button >

				<button name="btnOtpremi" caption="Otpremi" function="btnOtpremi">
					<event type="click">
						<action type="form open" value="frmOtpremi">
							<parameter name="GlavaId" value="#grdMaster.@ProNarudzbeGlaId"/>
						</action>	
						<action type="control populate keepfocus" value="#grdMaster" />
						<action type="control populate" value="#grdDetalj" />
							
						
					</event>
						
				</button >
			</buttons>
						
		</panelbuttons>

		<datalist>
				<data command="spProd_ProNarudzbeGla_Grid" name="dtPuniMaster">
					<parameter name="@DatumOd" value="global.$DatumOd"/>
        			<parameter name="@DatumDo" value="global.$DatumDo" />
        			<parameter name="@PartneriId" value="global.$PartneriId" />
					<parameter name="@TrgovinaId" value="global.$TrgovinaId" />
					<parameter name="@ParStruId" value="global.$ParStruId" />
					<parameter name="@ProNarudzbeVrstaPrometaId" value="global.$ProNarudzbeVrstaPrometaId" />
				</data>

				<data command="spProd_ProNarudzbeDet_Grid" name="dtPuniDetalj">
					<parameter name="@ProNarudzbeGlaId" value="#grdMaster.@ProNarudzbeGlaId" />
				</data>

				<data command="spSutrasnjiDatum" name="dtSutrasnjiDatum" />

				<data command="spProd_ProNarudzbeGla_Obrisi" name="dtObrisi">
					<parameter name="@ProNarudzbeGlaId" value="#grdMaster.@ProNarudzbeGlaId" />
				</data>
				<data command="spProd_ProNarudzbeGla_Zakljuci" name="dtPromijeniStatus">
					<parameter name="@ProNarudzbeGlaId" value="#grdMaster.@ProNarudzbeGlaId" />
					<parameter name="@operateriid" value="@@operateriid" />
				</data>
				<data command="spProd_ProNarudzbeGla_PonistiZakljucak" name="dtPonistiZakljucak">
					<parameter name="@ProNarudzbeGlaId" value="#grdMaster.@ProNarudzbeGlaId" />
				</data>
		
	</datalist>

</form>

<form name="frmLokacije" path="frmLokacije.xml" />
<form name="frmFilter" path="frmFilter.xml" />
<form name="frmUnos" path="frmUnos.xml" />
<form name="frmIzmjena" path="frmIzmjena.xml" />
<form name="frmKopiraj" path="frmKopiraj.xml" />
<form name="frmUnosStavke" path="frmUnosStavke.xml" /> 
<form name="frmOtpremi" path="frmOtpremi.xml" /> 



			<datalist>
				<data command="spTraziParstru" name="dtParstru">
					<parameter name="@action" value="Parstru"/>
					<parameter name="@Ind_Postotak" value="1"/>				
					<parameter name="@Uvjet" value="" if="$IndLokacija==1"/>
					<parameter name="@Uvjet" value="#srcParstru.text" else=""/>
					<parameter name="@PartneriId" value="$PartneriId"/>
				</data>

				<data command="spDajPartnera" name="dtDajPartnera">
      				<parameter name="@id" value="#srcParstru" />
     				 <parameter name="@partneriid" value="#srcPartner" />
   				 </data>
	
			</datalist>


</root>