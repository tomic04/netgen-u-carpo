<root>
	<form name="frmMaster" type="master" caption="Poslovni ugovori">
		<event type="init">
			<action type="variable value" >
				<!-- <parameter name="tmpId" value="0" type="int" /> -->
				<!-- <parameter name="DatumOd" value="0" type="date" /> -->
				<!-- <parameter name="DatumDo" value="0" type="date" /> -->
			</action>	
			<!--<action type="control populate" value="#grdMaster" />-->
			<action type="variable value">
				<parameter name="Boja" value="#ff00000" />
			</action>
			<action type="datarun reader" value="~dtStablo" />
		</event>
		<event type="shown">
			<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" if="#grdMaster.rowcount!=0" />
			<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" else="" />
			<!--<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" if="#grdMaster.@StatusiId!=50" />
			<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" else=""/>
			<action type="control disable" value="#btnStatus" if="#grdMaster.@StatusiId==53" />
			<action type="control enable" value="#btnStatus" else=""/>-->
		</event>
		<managerlayout>

			<!-- TREE -->
			<tree name="tree" key="id" filtermode="smart" expandallonload="true">
				<!-- expandedlevel="1" -->
				<data command="spProd_ProdUgovori_TreeVremenskaPodjela" name="dtStablo"/>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdMaster" />
				</event>
				<fields>
					<field name="caption" />
				</fields>
			</tree>
			
			<grid name="grdMaster" type="master" async="true" dataname="Global.dtMaster" key="PosUgovoriGlaID" autopopulate="false">
				<event type="focusedrowchanged">
					<!-- <action type="message" value="#grdMaster.rowcount" /> -->
					<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" if="#grdMaster.rowcount!=0" />
					<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" else="" />
					<!--<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" if="#grdMaster.@StatusiId!=50" />
					<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnLokacije" else=""/>					
					<action type="control disable" value="#btnStatus" if="#grdMaster.@StatusiId==53" />
					<action type="control enable" value="#btnStatus" else=""/>-->	
					<action type="menu disable" value="#menVratiStatus" if="#grdMaster.@StatusiId==1" />
					<action type="menu enable" value="#menVratiStatus" else=""/>	
					<action type="variable value" >
						<parameter name="PosUgovoriglaId" value="#grdMaster.@PosUgovoriglaId" />
					</action>					
				</event>
				<event type="doubleclick">
					<action type="form open" value="frmUgovor"  if="#grdMaster.rowcount&gt;0&amp;&amp;#grdMaster.@StatusiId==1">
						<parameter name="PosUgovoriglaId" value="#grdMaster.@PosUgovoriglaId" />
						<parameter name="Status" value="#grdMaster.@Status" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>
				<fields>
					<field name="VrstaUgovora" caption="Vrsta ugovora" />
					<field name="Partner" caption="Partner" fontbold="true" />
					<field name="Broj" caption="Broj" />
					<field name="DatumUgovora" caption="Datum ugovora" />
					<field name="UgovorVrijediDo" caption="Ugovor vrijedi do" />
					<field name="Zakljuceno" caption="Zaključeno" />
					<field name="Status" caption="Status" />
					<field name="MBS" caption="MBS" />
					<field name="OIB" caption="OIB" />
					<field name="Adresa" caption="Adresa" />
					<field name="HPTBroj" caption="Poštanski broj" />
					<field name="Mjesto" caption="Mjesto" />
					<field name="Telefon" caption="Telefon" />
					<field name="Fax" caption="Faks" />
					<field name="IBAN" caption="IBAN" />
					<field name="DatumSkladistenja" caption="Datum početka skladištenja" />
					<field name="NacinPlacanja" caption="Način plaćanja" />
					<field name="OvlastenaOsoba" caption="Ovlaštena osoba" />
					<field name="Kultura" caption="Kultura" />
					<field name="Cijena" caption="Cijena" />
					<field name="Kolicina" caption="Količina" />
				</fields>
				<!-- <styles> -->
				<!-- <style name="fontcolor" value="$Boja" type="string"/> -->
				<!-- </styles> -->
				<menu>
					<menuitem name="menVratiStatus" caption="Vrati status" function="dmsspremi">
						<event type="click">
							<action type="form open" value="frmPromjenaStatusa">
								<parameter name="PosUgovoriGlaID" value="#grdMaster.@PosUgovoriGlaID"/>
								<parameter name="NaslovTekst" value="VRAĆANJE STATUSA"/>
								<parameter name="Var" value="Vrati"/>
								<parameter name="ZakljucakInd" value="0" />
							</action>
							<action type="control populate keepfocus" value="#grdMaster"/>
						</event>
					</menuitem>
					<menuitem name="menPovijestStatusa" caption="Povijest statusa">
						<event type="click">
							<action type="form open" value="frmPovijestStatusa">
								<parameter name="PosUgovoriGlaID" value="#grdMaster.@PosUgovoriGlaID"/>
							</action>
						</event>
					</menuitem>
				</menu>				
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="&amp;UNESI" type="add" >
					<!-- <menuitem control="#grdMaster"/> -->
					<event type="click">
						<action type="form open" value="frmUgovor" >
							<parameter name="PosUgovoriglaId" value="null" />
						</action>						
						<!-- <action type="control populate" value="#grdMaster" /> -->
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit">
					<!-- <menuitem control="#grdMaster"/> -->
					<event type="click">
						<action type="variable value" >
							<parameter name="PosUgovoriglaId" value="#grdMaster.@PosUgovoriglaId" />
						</action>					
						<action type="form open" value="frmUgovor"  if="#grdMaster.rowcount&gt;0">
							<parameter name="PosUgovoriglaId" value="#grdMaster.@PosUgovoriglaId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati dokument?">
							<action type="datarun nonquery" value="Global.~dtDelete">
								<action type="control populate" value="#grdMaster" />
							</action>
						</action>
					</event>
				</button>			
				<button name="btnStatus" caption="PROMIJENI STATUS" type="">
					<event type="click">
						<action type="form open" value="frmPromjenaStatusa" >
							<parameter name="PosUgovoriGlaID" value="#grdMaster.@PosUgovoriGlaID"/>
							<parameter name="NaslovTekst" value="PROMJENA STATUSA"/>
							<parameter name="IzPodloge" value="1"/>
							<parameter name="ZakljucakInd" value="1" />
							<action type="control populate keepfocus" value="#grdMaster"/>
						</action>
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
				<button name="btnPrint" caption="IS&amp;PIŠI" dataname="global.~dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="control print" value="#grdMaster">
							<action type="print template" value="#btnPrint.@Template">
								<parameter name="id" value="#grdMaster.@PosUgovoriGlaId" />
							</action>
						</action>
					</event>
				</button>					
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmUgovor" caption="Poslovni ugovor" >
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" if="$PosUgovoriglaId!=null" />
		</event>	
		<event type="load">
		</event>
		<event type="shown">
			<action type="control focus" value="#srcPartner" if="$PosUgovoriglaId==null" />
			<action type="control disable" value="#txtOIB, #txtMBS, #txtAdresa,#txtMjesto,#txtHPTBroj,#txtTelefon,#txtFax,#txtIBAN,#txtNacinPlacanja" />
			<action type="control enable" value="#srcPartner,#cmbVrstaUgovora" if="$PosUgovoriglaId!=null" />			
			<action type="control disable" value="#txtBroj,#srcPartner,#cmbVrstaUgovora" if="$PosUgovoriglaId!=null" />
		</event>
		<event type="close" >
			<action type="control populate" value="parent.#grdMaster" if="parent.$PosUgovoriglaId!=0">
				<action type="control focus" value="parent.#grdMaster" if="parent.$PosUgovoriglaId!=0">
					<parameter value="parent.$PosUgovoriglaId" type="int"/>
				</action>
			</action>
		</event>		
		<layout textposition="top" itemspadding="2">
			<group cols="3" rows="14">
				<part name="posugoform" path="prtPosUgo.xml" />
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="Global.~dtEdit" if="$PosUgovoriglaId!=null"/>
						<action type="datarun scalar" value="Global.~dtAdd" else="">
							<parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" />
						</action>
						<!-- <action type="control populate" value="parent.#grdMaster" /> -->
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
	</form>	

	<form name="frmPromjenaStatusa" path="frmPromjenaStatusa.xml"/>
	<form name="frmPovijestStatusa" path="frmPovijestStatusa.xml"/>
	
	<datalist>

		
		
		<data command="spTraziPartneri" name="dtPartneri">
			<parameter name="@Action" value="Partneri" />
			<parameter name="@Uvjet" value="#srcPartner.text" />
			<parameter name="@broj_lokacija" value="1" />
		</data>	
		
		<data command="spNG_Combo" name="dtVrstaUgovora">
			<parameter name="@Action" value="VrstaDok" />
			<parameter name="@Id" value="160" />
		</data>	

		<data command="spProd_PosUgovoriGla_MG_Query" name="dtMaster">
			<parameter name="@Godina" value="#tree.@value" />
		</data>
		
		<data command="spProd_PosUgovoriGla_Query" name="dtGet">
			<parameter name="@ID" value="$PosUgovoriglaId" />
		</data>		
		<data command="spProd_PosUgovoriGla_Insert" name="dtAdd">
			<parameter name="@VrstadokId" value="#cmbVrstaUgovora"/>
			<parameter name="@PosUgovoriVrsteId" value="#cmbVrstaUgovora"/>
			<parameter name="@Broj" value="#txtBroj"/>
			<parameter name="@Aneks" value="#txtAneks"/>
			<parameter name="@DatumUgovora" value="#datDatumUgovora"/>
			<parameter name="@UgovorVrijediDo" value="#datDatumVrijediDo"/>
			<parameter name="@PartneriId" value="#srcPartner"/>
			<parameter name="@KreditniLimit" value="#txtKreditniLimit"/>
			<parameter name="@Odgoda" value="#txtOdgoda"/>
			<parameter name="@Rabat" value="#txtRabat"/>
			<parameter name="@OperateriId" value="@@operateriid"/>
			<parameter name="@NAzivUgovora" value="#txtNazivUgovora"/>
			<parameter name="@Kultura" value="#txtKultura"/>
			<parameter name="@KategorijaRizikaId" value="#cmbKategorijaRizika"/>
			<parameter name="@InstrumentOsiguranjaId" value="#cmbInstrumentOsiguranja"/>
			<parameter name="@OsobeId" value="#srcKomOsobe"/>
			<parameter name="@KultureId" value="#cmbKultura"/>
			<parameter name="@DatumSkladistenja" value="#datDatumSkladistenja"/>
			<parameter name="@Cijena" value="#txtCijena"/>
			<parameter name="@Kolicina" value="#txtKolicina"/>
					</data>
		<data command="spProd_PosUgovoriGla_Edit" name="dtEdit">
			<parameter name="@ID" value="$PosUgovoriglaId" />
			<parameter name="@PosUgovoriVrsteId" value="#cmbVrstaUgovora"/>
			<parameter name="@Aneks" value="#txtAneks"/>
			<parameter name="@DatumUgovora" value="#datDatumUgovora"/>
			<parameter name="@UgovorVrijediDo" value="#datDatumVrijediDo"/>
			<parameter name="@OvlastenaOsoba" value="#txtOvlastenaOsoba"/>
			<parameter name="@KreditniLimit" value="#txtKreditniLimit"/>
			<parameter name="@Odgoda" value="#txtOdgoda"/>
			<parameter name="@Rabat" value="#txtRabat"/>
			<parameter name="@NazivUgovora" value="#txtNazivUgovora"/>
			<parameter name="@Kultura" value="#txtKultura"/>
			<parameter name="@KategorijaRizikaId" value="#cmbKategorijaRizika"/>
			<parameter name="@InstrumentOsiguranjaId" value="#cmbInstrumentOsiguranja"/>
			<parameter name="@OperateriId" value="@@operateriid"/>
			<parameter name="@OsobeId" value="#srcKomOsobe"/>
			<parameter name="@KultureId" value="#cmbKultura"/>
			<parameter name="@DatumSkladistenja" value="#datDatumSkladistenja"/>
			<parameter name="@Cijena" value="#txtCijena"/>
			<parameter name="@Kolicina" value="#txtKolicina"/>
		</data>
		<data command="spProd_PosUgovoriGla_Partner_Query" name="dtGetPartner">
			<parameter name="@PartneriId" value="#srcPartner"/>
		</data>
		<data command="spProd_PosUgovoriGla_ParStru_Query" name="dtParStru">
			<parameter name="@Id" value="$PartneriId"/>
		</data>		
		<data command="spProd_PosUgovoriGla_Delete" name="dtDelete">
			<parameter name="@ID" value="#grdMaster.@PosUgovoriglaId"/>
		</data>

		<data command="spCarpoPrint" name="dtPrint">
			<parameter name="@Action" value="GetTemplates" />
			<parameter name="@Id" value="#grdMaster.@PosUgovoriglaId" type="int" />
			<parameter name="@Tablica" value="PosUgovoriGla" />
		</data>	

		<data command="spProd_PosUgovoriGla_getKultura" name="dtKultura">
		</data>

		<data command="spTraziOsobe" name="dtKomOdgovornaOsoba">
			<parameter name="@Action" value="NaseOsobe" />
			<parameter name="@uvjet" value="#srcKomOsobe.text" />
		</data>
		
	</datalist>

</root>