<root>
    <form type="master" name="frmMain" caption="Pregled po dimenzijama - Pregled dokumenata">
        <method name="funDmsOpen" dll="DmsManagerV1" class="DmsManagerV1.Start" method="OpenDocument" />
        <method name="funDmsSave" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocuments" />
        <event type="load">
            <action type="form open" value="frmPartneri" />
        </event>
        <managerlayout>

        <grid type="master" name="grdGlava" dataname="dtGlava" autopopulate="false">
            <event type="focusedrowchanged">
                <action type="datarun reader" value="dtDms" />
                <action type="control populate" value="#grdDetalj"/>
            </event>
        </grid>
        
        <!-- <tabs>
		    <tab caption="Dokumenti"> -->
                <grid name="grdDetalj" dataname="dtDms" keyfield="DokId" multiselect="true" showmenuprintitem = "false" showmenutools = "false" savelayout="true" caption="Pridruženi dokumenti">
                    <event type="doubleclick">
                        <action type="method run" value="funDmsOpen">
                            <parameter name="server" value="@@server"/>
                            <parameter name="database" value="@@database"/>
                            <parameter name="username" value=""/>
                            <parameter name="password" value=""/>
                            <parameter name="operaterid" value="@@operateriid"/>
                            <parameter name="dokId" value="#grdDetalj.@DokID"/>
                            <parameter name="name" value="#grdDetalj.@Naziv"/>
                        </action>
                    </event>
                    <menu>
                        <menuitem caption="Spremi na disk" >
                            <event type="click">
                                <action type="method run" value="funDmsSave">
                                    <parameter name="server" value="@@server" />
                                    <parameter name="database" value="@@database" />
                                    <parameter name="username" value="" />
                                    <parameter name="password" value="" />
                                    <parameter name="operaterid" value="@@operateriid" />
                                    <parameter name="dokIds" value="#grdDetalj.selectedids" />
                                </action>
                            </event>
                        </menuitem>
                    </menu>
                </grid>
            <!-- </tab>
            <tab caption="">
                <grid name="asdsd" />
            </tab>

        </tabs> -->

        </managerlayout>
        <panelbuttons>
            <buttons>
                <button name="btnFilter" caption="Prikaži sve">
                    <event type="click">
                        <action type="variable value">
                            <parameter name="global.PartneriId" value="null" />
                        </action>
                        <action type="control populate" value="#grdGlava" />
                    </event>
                </button>
                <button name="btnFilter" caption="Filter">
                    <event type="click">
                        <action type="form open" value="frmPartneri" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>

        <datalist>
            <data command="spManIzvAtrKnjDim" name="dtGlava">
                <parameter name="@partneriid" value="global.$PartneriId"/>
            </data>
			<data command="spNetGenDMSQuery" name="dtDms">
				<parameter name="@EntityName" value="KupSkener"/>
				<parameter name="@Id" value="#grdGlava.@KupPrometId"/>
			</data>
        </datalist>
    </form>

    <form name="frmPartneri" caption="Filter">
        <layout>
            <group cols="1" rows="2">
                <item row="1" col="1"  caption="Filter">
                    <searchedit name="srcCustom" fontsizedelta="1" fieldtext="Partner3000" fieldvalue="partneriid" dataname="dtSearch">
					</searchedit>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnOdustani" caption="Odustani" dock="right">
                    <event type="click">
                        <action type="control populate" value="parent.#grdGlava" />
                        <action type="formclose"/>
                    </event>
                </button>
                <button name="btnPretraga" caption="POTVRDI" dock="right" color="dark">
                    <event type="click">
                        <action type="variable value">
                            <parameter name="global.PartneriId" value="#srcCustom" />
                        </action>
                        <action type="control populate" value="parent.#grdGlava" />
                        <action type="formclose"/>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spTraziPartneri" name="dtSearch">
                <parameter name="@action" value="Partneri"/>
                <parameter name="@Uvjet" value="#srcCustom.text"/>
            </data>
        </datalist>
    </form>
</root>