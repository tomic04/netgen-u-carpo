<root version="8.0.0.1">
    <form type="master" caption="Ažuriranje terminala">
    <event type="oninit">
         <action type="variable value">
                <parameter name="IdToFocus" value="null"/>
         </action>
    </event>
    <event type="onshown">
        <action type="control disable" value="#btnIzmjena" if="#grdGlava.@Terminalid==null" />
        <action type="control disable" value="#btnBrisanje" if="#grdGlava.@Terminalid==null" />
    </event>
        <managerlayout>
            <grid type="master" name="grdGlava" dataname="~dtGlavaQuery" key="Terminalid" keyfield="Terminalid" bestfitonrefresh="true">
                <fields  inherited="true" >
                    <!--RuteIds sluzi samo za subformu-->
                    <field name="RuteIds" hidden="true"/>
					<field name="skladisteIds" hidden="true"/>
                    <field name="Sifra" caption="ŠIFRA" />
                    <field name="Ime" caption="IME" />
                    <field name="Lozinka" caption="LOZINKA" />
                    <field name="Registracija" caption="REGISTRACIJA" />
                    <field name="Operater" caption="OPERATER" />
                    <field name="Odgovorna osoba" caption="ODGOVORNA OSOBA" />
                    <field name="Skladište" caption="GLAVNO SKLADIŠTE" />
					<field name="DodSkladiste" caption="DODATNO SKLADIŠTE" />
                    <field name="Org jedinica" caption="ORG JEDINICA" />
                    <field name="Rute" caption="RUTE" />
                </fields>
                <event type="doubleclick">
                        <action type="form open" value="frmTerminalAzur_Lokacije">
                            <parameter name="TerminalId" value="#grdGlava.@TerminalId" />
                            <parameter name="RuteIds" value="#grdGlava.@RuteIds" />
							<parameter name="SkladisteIds" value="#grdGlava.@SkladisteIds" />
                        </action>
                    </event>
            </grid>
        </managerlayout>
        <panelbuttons>
            <buttons>
                <button name="btnUnos" caption="UNESI">
                    <event type="click">
                        <action type="form open" value="frmTerminalAzur_Unos_Izmjena" />
                       <action type="control populate" value="#grdGlava" if="dialogresult!=cancel">
                            <action type="control focus" value="#grdGlava">
                                <parameter value="$IdToFocus" type="int" />
                            </action>
                        </action>
                    </event>
                </button>
                <button name="btnIzmjena" caption="IZMIJENI">
                    <event type="click">
                        <action type="form open" value="frmTerminalAzur_Unos_Izmjena">
                            <parameter name="TerminalId" value="#grdGlava.@Terminalid" />
                        </action>
                        <action type="control populate" value="#grdGlava" />
                        <action type="control focus" value="#grdGlava">
                                <parameter value="$IdToFocus" type="int"/>
                        </action>
                    </event>
                </button>
                <button name="btnBrisanje" caption="OBRIŠI">
                    <event type="click">
                        <action type="confirm" value="Želite li obrisati terminal: {#grdGlava.@Ime}?">
                            <action type="datarun nonquery" value="~dtDelete"/>
                            <action type="control populate" value="#grdGlava" />
                        </action>
                    </event>
                </button>
                <button name="btnLokacije" caption="POVEŽI">
                    <event type="click">
                        <action type="form open" value="frmTerminalAzur_Lokacije">
                            <parameter name="TerminalId" value="#grdGlava.@TerminalId" />
                            <parameter name="RuteIds" value="#grdGlava.@RuteIds" />
							<parameter name="SkladisteIds" value="#grdGlava.@SkladisteIds" />
                        </action>
                    </event>
                </button>
                 <button name="btnPrint" caption="ISPIŠI">
					<event type="click">
						<action type="control printcontrol" value="#grdGlava" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spTerminalGlava_Query" name="dtGlavaQuery"/>
            <data command="spTerminalAzur_Delete" name="dtDelete">
                <parameter name="@terminalid" value="#grdGlava.@Terminalid" />
             </data>
        </datalist>
    </form>
    <form name="frmTerminalAzur_Unos_Izmjena" path="frmTerminalAzur_Unos_Izmjena.xml" />
    <form name="frmTerminalAzur_Lokacije" path="frmTerminalAzur_Lokacije.xml" />
</root>