<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: REGISTRATOR2 (NetGen) → frmRegistrator2 (Carpo) -->
<root version="1.2">
  <form name="frmRegistrator2" caption="Izmjena registratora" type="dialog" width="560" height="360" fixedsize="false">
    <event type="shown">
      <action type="datarun reader" value="~dtLoad"/>
      <action type="control value" value="#txtGodina">
        <parameter value="~dtLoad.@Godina"/>
      </action>
      <action type="control value" value="#txtTipPoste">
        <parameter value="~dtLoad.@TipPoste"/>
      </action>
      <action type="control value" value="#txtBrojUfe">
        <parameter value="~dtLoad.@BrojUfe"/>
      </action>
      <action type="control value" value="#memRegistrator">
        <parameter value="~dtLoad.@Registrator"/>
      </action>
    </event>

    <layout>
      <group cols="2" rows="4" groupbordervisible="false">
        <item col="1" row="1" caption="Godina:" textposition="left">
          <textedit name="txtGodina"/>
        </item>
        <item col="2" row="1" caption="Tip pošte:" textposition="left">
          <textedit name="txtTipPoste"/>
        </item>
        <item col="1" row="2" caption="Broj UFE:" textposition="left">
          <textedit name="txtBrojUfe"/>
        </item>
        <item col="1" row="3" colspan="2" caption="Registrator:" textposition="left">
          <memoedit name="memRegistrator"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click" waittype="progress" waitcaption="Spremanje" waittext="Spremam...">
            <action type="datarun nonquery" value="~dtSave"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtLoad" type="text" timeout="300"
            command="select godina as Godina,
                           tipposte as TipPoste,
                           UFAbroj as BrojUfe,
                           registrator as Registrator
                      from kuppromet
                     where kupprometid=@id">
        <parameter name="@id" value="$Id" type="int"/>
      </data>

      <data name="dtSave" command="spKUPPrometAzurN" timeout="300">
        <parameter name="@action" value="12"/>
        <parameter name="@id" value="$Id"/>
        <parameter name="@godina" value="#txtGodina"/>
        <parameter name="@tipposte" value="#txtTipPoste"/>
        <parameter name="@ufabroj" value="#txtBrojUfe"/>
        <parameter name="@registrator" value="#memRegistrator"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

