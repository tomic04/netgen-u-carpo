<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: POVRAT (NetGen) → frmPovrat (Carpo) -->
<root version="1.2">
  <form name="frmPovrat" caption="Povrat s odobravanja" type="dialog" width="760" height="520" fixedsize="false" saveformsize="true">
    <event type="shown">
      <action type="control populate" value="#grdPovrat"/>
    </event>

    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1">
          <grid name="grdPovrat" dataname="~dtPovrat" bestfitonrefresh="true" showautofilterrow="true" multiselect="true" savelayout="true">
            <fields inherited="true"/>
          </grid>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPrihvati" caption="PRIHVATI">
          <event type="click" waittype="progress" waitcaption="Obrada" waittext="Obrađujem...">
            <action type="message" value="Odaberite barem jedan red." if="#grdPovrat.selectedrowscount==0"/>
            <action type="datarun nonquery" value="~dtPovratAzur" if="#grdPovrat.selectedrowscount>0"/>
            <action type="form close" if="#grdPovrat.selectedrowscount>0"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtPovrat" command="spKUPPrometQueryN" timeout="300">
        <parameter name="@action" value="13"/>
        <parameter name="@id" value="$Id"/>
      </data>

      <data name="dtPovratAzur" command="spKUPPrometAzurN" timeout="300">
        <parameter name="@action" value="17"/>
        <parameter name="@id" value="$Id"/>
        <parameter name="@str" value="#grdPovrat.selectedids"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

