<root>
	<form name="frmMaster" type="master" caption="Ugovori s dobavljačima - Audit">
		<managerlayout>
			<tree name="tree" caption="Partneri" searchfield="" expandallonload="true" showautofilterrow="true">
				<data command="dbo.spDobUgoAudit_Stablo" />
				<fields>
					<field name="caption" />
				</fields>				
				<event type="focusedrowchanged"  >
					<action type="control populate" value="#grdGlava" />
				</event>
			</tree>
			<grid name="grdGlava" type="master" searchfield="" dataname="global.dtGlava" savelayout="true" > > 
				<!-- TODO - dodati menije -->
				<!-- TODO - focusedrowchange za enable i disable tipki -->
				<!-- TODO - doubleclick -->			
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdDetalj" />
				</event>
				<fields >
					<field name="PartnerSifra" caption="Šifra partnera" fontbold="true" />	
					<field name="PartnerNaziv" caption="Naziv partnera" fontbold="true" />
					<field name="Broj" caption="Broj ugovora" />
					<field name="Opis" caption="Opis" />
					<field name="OsobaNaziv" caption="Odg. osoba" />
					<field name="DatumUgovora" caption="Datum ugovora" />
					<field name="UgovorVrijediDo" caption="Vrijedi do" />
					<field name="Inicijali" caption="Operater" />
					<field name="Sjediste" caption="Sjedište" />
					<field name="OrgShema_Naziv" caption="Org. shema" />
					<field name="BrojPromjena" caption="Broj promjena" />
					<field name="OperaterIzmjene" caption="Operater izmjene" />
					<field name="Obrisan" caption="Obrisan" />
				</fields>
				<styles>
				</styles>				
			</grid>	
			<grid name="grdDetalj" type="detail" searchfield="" dataname="global.dtDetalj" > 
				<fields >
					<field name="Sifra" caption="Šifra" />
					<field name="Naziv" caption="Naziv" fontbold="true" />
					<field name="Rabat1" caption="Rabat 1" />
					<field name="Rabat2" caption="Rabat 2" />
					<field name="Rabat3" caption="Rabat 3" />
					<field name="FakCijena" caption="Fakturna cijena" />
					<field name="StRokIsporuke" caption="Standardni rok isporuke" />
					<!-- width? -->
					<field name="Kolicina" caption="Količina" />
					<field name="Odgoda" caption="Odgoda" />
					<field name="JMNaziv" caption="Jedinica mjere" />
					<field name="BrojPromjena" caption="Broj promjena" />
					<field name="OperaterIzmjene" caption="Operater izmjene" />
					<field name="Obrisan" caption="Obrisan" />
				</fields>
				<styles>
				</styles>				
			</grid>			
		</managerlayout>
		<actionpanel>
			<items>
				<item>
					<button name="cmdGlava" caption="POVIJEST ZAGLAVLJA" >
						<event type="click">
							<action type="form open" value="frmPromjeneGla" >
							</action>
						</event>
					</button>
				</item>
				<item>
					<button name="cmdDetalj" caption="POVIJEST STAVKE" >
						<event type="click">
							<action type="form open" value="frmPromjeneDet" >
							</action>
						</event>
					</button>
				</item>
				<item>
					<button name="cmdSve" caption="SVA POVIJEST" >
						<event type="click">
							<action type="form open" value="frmSvePromjene" >
							</action>
						</event>
					</button>
				</item>	
				<item>
					<checkedit name="chkSve" caption="Sve stavke">
						<event type="valuechanged">
							<action type="control populate" value="#grdDetalj" />
						</event>
					</checkedit>
				</item>				
			</items>
		</actionpanel>
	</form>

	<form name="frmPromjeneGla" caption="Promjene" height="500" width="1000">
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="1">
				<item col="1" row="1" highlight="False" >
					<grid name="grdPromjeneGla"  showgrouppanel="False" showfooter="false" autopopulate="true" dataname="global.dtPromjeneGla" >
						<fields >
							<field name="PartnerNaziv" caption="Naziv partnera" fontbold="true" />
							<field name="Broj" caption="Broj ugovora" />
							<field name="DatumUgovora" caption="Datum ugovora" />
							<field name="UgovorVrijediDo" caption="Vrijedi do" />
							<field name="Opis" caption="Opis" />
							<field name="OsobaNaziv" caption="Odg. osoba" />
							<field name="Inicijali" caption="Operater" />
							<field name="Sjediste" caption="Sjedište" />
							<field name="OrgShema_Naziv" caption="Org. shema" />
							<field name="OperaterIzmjene" caption="Operater izmjene" />
							<field name="Obrisan" caption="Obrisan" />
							<field name="Dogadjaj" caption="Događaj" />
							<field name="DatumIzmjene" caption="Datum izmjene" />
							<field name="VrijemeIzmjene" caption="Vrijeme izmjene" />							
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- 				<button caption="Spremi" type="add">
					<event type="click">
					</event>
				</button> -->
				<button caption="Odustani"  type="cancel">
					<action type="form close" />
				</button>
			</buttons>
		</panelbuttons>	
	</form>

	<form name="frmPromjeneDet" caption="Promjene" height="500" width="1000">
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="1">
				<item col="1" row="1" highlight="False" >
					<grid name="grdPromjeneDet" showgrouppanel="False" showfooter="false" autopopulate="true" dataname="global.dtPromjeneDet" >
						<fields >
							<field name="Sifra" caption="Šifra" />
							<field name="Naziv" caption="Naziv" fontbold="true" />
							<field name="Rabat1" caption="Rabat 1" />
							<field name="Rabat2" caption="Rabat 2" />
							<field name="Rabat3" caption="Rabat 3" />
							<field name="FakCijena" caption="Fakturna cijena" />
							<field name="StRokIsporuke" caption="Standardni rok isporuke" />
							<!-- width? -->
							<field name="Kolicina" caption="Količina" />
							<field name="Odgoda" caption="Odgoda" />
							<field name="JMNaziv" caption="Jedinica mjere" />
							<field name="OperaterIzmjene" caption="Operater izmjene" />
							<!-- <field name="Obrisan" caption="Obrisan" /> -->
							<field name="Dogadjaj" caption="Događaj" />
							<field name="DatumIzmjene" caption="Datum izmjene" />
							<field name="VrijemeIzmjene" caption="Vrijeme izmjene" />							
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- 				<button caption="Spremi" type="add">
					<event type="click">
					</event>
				</button> -->
				<button caption="Odustani"  type="cancel">
					<action type="form close" />
				</button>
			</buttons>
		</panelbuttons>	
	</form>

	<datalist>
		<data command="spDobUgoGlaAudit_Grid" name="dtGlava">
			<parameter name="@Id" value="#tree.@Id" />
		</data>		
		<data command="spDobUgoDetAudit_Grid" name="dtDetalj">
			<parameter name="@Id" value="#grdGlava.@DobUgovoriGlaId" />
			<parameter name="@Sve" value="#chkSve" />
		</data>			
		<data command="spDobUgoGlaAuditPromjene_Grid" name="dtPromjeneGla">
			<parameter name="@Id" value="parent.#grdGlava.@DobUgovoriGlaId" />
		</data>			
		<data command="spDobUgoDetAuditPromjene_Grid" name="dtPromjeneDet">
			<parameter name="@Id" value="parent.#grdDetalj.@DobUgovoriDetId" />
		</data>		
	</datalist>
</root>