<root>
	<!--
  Komentari:
  07.09.2021. Jadranka Vučenović Vojvodić - kreirala granulu ver 1.0.
  -->
	<form name="frmKalendar" type="master" caption="Kalendar" width="650" height="650" fixedsize="false">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="load">
			<action type="control populate" value="#grdKalendar" />
			<action type="control populate" value="#grdIstek" />
		</event>
		<layout>
			<group rows="2" cols="1" groupbordervisible="false">
				<rowsdefinition>
					<row position="1" size="40%"/>
					<row position="2" size="60%"/>
				</rowsdefinition>
				<group rows="2" cols="1" row="1" col="1" groupbordervisible="true" spacing="2,2,2,1" >
					<group rows="1" cols="4"  row="1" col="1" groupbordervisible="false">
						<columnsdefinition>
							<column position="1" size="25%"/>
							<column position="2" size="20%"/>
							<column position="3" size="30%"/>
							<column position="4" size="25%"/>
						</columnsdefinition>
						<item row="1" col="1" highlight="false">
							<button image="leftbegin" imagelocation="middlecenter" name="btnLjevo">
								<event type="click">
									<action type="datarun reader" value="~dtNazad">
										<action type="control value" value="#txtMjesec">
											<parameter value="~dtNazad.@mjesec" />
										</action>
										<action type="control value" value="#txtGodina">
											<parameter value="~dtNazad.@godina" />
										</action>
										<action type="control populate" value="#grdKalendar"/>
										<action type="control populate" value="#grdIstek" />
									</action>
								</event>
							</button>
						</item>
						<item row="1" col="2" highlight="false">
							<textedit name="txtMjesec" datavalue="~dtGet.@mjesec" allownull="false" format="[1-9][0-2]" formattype="regex">
								<event type="leave">
									<action type="datarun nonquery" value="~dtGrid">
										<action type="control populate" value="#grdKalendar"	/>
									</action>
									<action type="datarun nonquery" value="~dtIstek">
										<action type="control populate" value="#grdIstek"	/>
									</action>
								</event>
							</textedit>
						</item>
						<item row="1" col="3" highlight="false">
							<textedit name="txtGodina" datavalue="~dtGet.@godina" allownull="false" format="[1-9][0-9][0-9][0-9]" formattype="regex" >
								<event type="leave">
									<action type="datarun nonquery" value="~dtGrid">
										<action type="control populate" value="#grdKalendar"	/>
									</action>
									<action type="datarun nonquery" value="~dtIstek">
										<action type="control populate" value="#grdIstek"	/>
									</action>
								</event>
							</textedit>
						</item>
						<item row="1" col="4" highlight="false">
							<button image="rightend" imagelocation="middlecenter" name="btnDesno">
								<event type="click">
									<action type="datarun reader" value="~dtNapred">
										<action type="control value" value="#txtMjesec">
											<parameter value="~dtNapred.@mjesec" />
										</action>
										<action type="control value" value="#txtGodina">
											<parameter value="~dtNapred.@godina" />
										</action>
										<action type="control populate" value="#grdKalendar"/>
										<action type="control populate" value="#grdIstek" />									
									</action>
								</event>
							</button>
						</item>
					</group>
					<group rows="6" cols="3"  row="2" col="1" groupbordervisible="false">
						<item row="1" col="1" colspan="3" rowspan="6">
							<grid name="grdKalendar" showgrouppanel="false" dataname="~dtGrid" showautofilterrow="false" enabled="false" >
								<fields>
									<field name="Tjedan" caption="&lt;b&gt;Tjedan&lt;/b&gt;" maxwidth="100" fontbold="true" />
									<field name="Pon" caption="Ponedjeljak" maxwidth="70"/>
									<field name="Uto" caption="Utorak" maxwidth="70"/>
									<field name="Sri" caption="Srijeda" maxwidth="70"/>
									<field name="Čet" caption="Četvrtak" maxwidth="70"/>
									<field name="Pet" caption="Petak" maxwidth="70"/>
									<field name="Sub" caption="Subota" maxwidth="70"/>
									<field name="Ned" caption="Nedjelja" maxwidth="70"/>
								</fields>
								<styles>
									<!-- Bold -->
									<style name="bold" value="true" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubBoldId==1"/>
									<style name="bold" value="true" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedBoldId==1"/>
									<!-- Boja slova ako dan ne spada u izabrani mjesec-->
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubColorId=='grey'"/>
									<style name="fontcolor" value="#9ba2a2" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedColorId=='grey'"/>
									<!-- Boja slova ako je vikend-->
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubColorId=='yellow'"/>
									<style name="fontcolor" value="yellow" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedColorId=='yellow'"/>
									<!-- Boja slova ako ima neki event-->
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubColorId=='red'"/>
									<style name="fontcolor" value="red" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedColorId=='red'"/>
									<!-- Pozadina za kolonu Tjedan-->
									<style name="backgroundcolor" value="#e8e2e5" if="#grdKalendar.fieldname==Tjedan"/>
									<!-- Pozadina za kolone od Ponedeljka do Petka da se ne vidi default-ni označeni red-->
									<style name="backgroundcolor" value="#ffffff" if="#grdKalendar.fieldname==Pon"/>
									<style name="backgroundcolor" value="#ffffff" if="#grdKalendar.fieldname==Uto"/>
									<style name="backgroundcolor" value="#ffffff" if="#grdKalendar.fieldname==Sri"/>
									<style name="backgroundcolor" value="#ffffff" if="#grdKalendar.fieldname==Čet"/>
									<style name="backgroundcolor" value="#ffffff" if="#grdKalendar.fieldname==Pet"/>
									<!-- Pozadina je plava kad je vikend-->
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubBgColorId=='blue'"/>
									<style name="backgroundcolor" value="#b6c4de" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedBgColorId=='blue'"/>
									<!-- Pozadina je crvena kad je praznik-->
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubBgColorId=='red'"/>
									<style name="backgroundcolor" value="#dc4f4f" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedBgColorId=='red'"/>
									<!-- Pozadina je žuta kad je event-->
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubBgColorId=='yellow'"/>
									<style name="backgroundcolor" value="#f7f7be" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedBgColorId=='yellow'"/>
									<!-- Italic -->
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Pon&amp;&amp;#grdKalendar.@PonItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Uto&amp;&amp;#grdKalendar.@UtoItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Sri&amp;&amp;#grdKalendar.@SriItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Čet&amp;&amp;#grdKalendar.@CetItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Pet&amp;&amp;#grdKalendar.@PetItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Sub&amp;&amp;#grdKalendar.@SubItalicId==1"/>
									<style name="Italic" value="true" if="#grdKalendar.fieldname==Ned&amp;&amp;#grdKalendar.@NedItalicId==1"/>
								</styles>
							</grid>
						</item>
					</group>
				</group>
				<group rows="1" cols="1" row="2" col="1" groupbordervisible="true" spacing="2,2,1,2">
					<item  col="1" row="1"   highlight="false" >
						<grid name="grdIstek" showgrouppanel="false" dataname="~dtIstek" showautofilterrow="false"  >
							<fields>
								<field name="Ispis" caption="U ovom mjesecu ističe:"  fixwidth="600" rowautoheight="true" />								
							</fields>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<datalist>
			<data command="spZNRKalendar" name="dtGrid">
				<parameter name="@action" value="MASTER"/>
				<parameter name="@mjesec" value="#txtMjesec"/>
				<parameter name="@godina" value="#txtGodina"/>
			</data>
			<data command="spZNRKalendar" name="dtGet">
				<parameter name="@action" value="GODINAMJESEC"/>
			</data>
			<data command="spZNRKalendar" name="dtNapred">
				<parameter name="@action" value="NAPRED"/>
				<parameter name="@mjesec" value="#txtMjesec" />
				<parameter name="@godina" value="#txtGodina" />
			</data>
			<data command="spZNRKalendar" name="dtNazad">
				<parameter name="@action" value="NAZAD"/>
				<parameter name="@mjesec" value="#txtMjesec" />
				<parameter name="@godina" value="#txtGodina" />
			</data>
			<data command="spZNRKalendar" name="dtIstek">
				<parameter name="@action" value="Lista" />
				<parameter name="@mjesec" value="#txtMjesec"/>
				<parameter name="@godina" value="#txtGodina"/>
			</data>
		</datalist>
	</form>
</root>

















