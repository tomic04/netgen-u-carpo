<?xml version="1.0" encoding="utf-8"?>
<!--
Konverzija iz NetGen granule: definitions/netgen/KnjigaUra.xml
Knjiga ulaznih računa (URA)
-->
<root version="1.2">
  <form name="frmFilter" path="KnjigaUraCarpo.frmFilter.xml"/>
  <form name="frmUnos" path="KnjigaUraCarpo.frmUnos.xml"/>
  <form name="frmIzmjena" path="KnjigaUraCarpo.frmIzmjena.xml"/>
  <form name="frmObrisi" path="KnjigaUraCarpo.frmObrisi.xml"/>
  <form name="frmZakljuci" path="KnjigaUraCarpo.frmZakljuci.xml"/>
  <form name="frmPonistiZakljucak" path="KnjigaUraCarpo.frmPonistiZakljucak.xml"/>
  <form name="frmRucniUnos" path="KnjigaUraCarpo.frmRucniUnos.xml"/>
  <form name="frmRucniIzmjena" path="KnjigaUraCarpo.frmRucniIzmjena.xml"/>
  <form name="frmProknjizi" path="KnjigaUraCarpo.frmProknjizi.xml"/>
  <form name="frmPronadji" path="KnjigaUraCarpo.frmPronadji.xml"/>
  <form name="frmUrednikKnjiga" path="KnjigaUraCarpo.frmUrednikKnjiga.xml"/>

  <form name="KnjigaUraCarpo" type="master" caption="Knjiga ulaznih računa" template="splitter vertical" maximized="true" statusbar="true" displaycontrolsprint="true">
    <event type="init">
      <action type="variable value">
        <parameter name="global.$Close" value="false" type="bool"/>
        <parameter name="global.$Node" value="null"/>
        <parameter name="global.$Godina" value="null"/>
        <parameter name="global.$KntVrsteKnjigaUraId" value="null"/>
        <parameter name="global.$DatZak" value="null"/>
      </action>
    </event>

    <event type="shown">
      <action type="form open" value="frmFilter"/>
      <action type="form close" if="global.$Close==true"/>
      <action type="control populate" value="#tree" if="global.$Close!=true"/>
      <action type="control populate" value="#grdMaster" if="global.$Close!=true"/>
      <action type="footer text" value="Broj stavki: {#grdMaster.rowcount}" if="global.$Close!=true"/>
    </event>

    <managerlayout>
      <tree name="tree" key="Id" parentfield="ParentId" autopopulate="false">
        <!-- Napomena: provjeriti u bazi kolone SP spKnjigaUraTree (id, parentid, caption/Name/Naziv) -->
        <data command="spKnjigaUraTree" timeout="60"/>
        <fields>
          <field name="caption" caption=""/>
        </fields>
        <event type="focusedrowchanged">
          <action type="variable value">
            <parameter name="global.$Node" value="#tree.@Id"/>
          </action>
          <action type="control populate" value="#grdMaster" waittype="progress"/>
          <action type="footer text" value="Broj stavki: {#grdMaster.rowcount}"/>
        </event>
      </tree>

      <grid name="grdMaster" type="master" dataname="~dtMaster" key="KntKnjigaUraId" async="true" savelayout="true" bestfitonrefresh="true" showautofilterrow="true">
        <fields inherited="true">
          <field name="Ikona" caption=""/>
          <field name="RedniBroj" caption="Rbr."/>
          <field name="Broj" caption="Broj računa"/>
          <field name="BrojDok" caption="Ufa"/>
          <field name="DatumDok" caption="Nadnevak" format="dd.MM.yyyy"/>
          <field name="Naziv" caption="Naziv dobavljača"/>
          <field name="PorezniBroj" caption="OIB"/>
          <field name="Matbroj" caption="Mbr."/>
          <field name="IznosNeoporeziv" caption="Osnovica 0%" format="#,##0.00"/>
          <field name="Osnovica10" caption="Osnovica 10%" format="#,##0.00"/>
          <field name="Osnovica22" caption="Osnovica 22%" format="#,##0.00"/>
          <field name="Osnovica23" caption="Osnovica 23%" format="#,##0.00"/>
          <field name="IznosUkupno" caption="Iznos sa PDV" format="#,##0.00"/>
          <field name="Pretporez" caption="Pretporez ukupno" format="#,##0.00"/>
          <field name="PorezOdbiv10" caption="Porez odbiv 10%" format="#,##0.00"/>
          <field name="PorezNeodbiv10" caption="Porez neodbiv 10%" format="#,##0.00"/>
          <field name="IznosOdbitak" caption="Porez odbiv 22%" format="#,##0.00"/>
          <field name="IznosNeOdbitak" caption="Porez neodbiv 22%" format="#,##0.00"/>
          <field name="PorezOdbiv23" caption="Porez odbiv 23%" format="#,##0.00"/>
          <field name="PorezNeodbiv23" caption="Porez neodbiv 23%" format="#,##0.00"/>
          <field name="NePod" caption="Ne podliježe oporezivanju" format="#,##0.00"/>
          <field name="IznosPlaceni" caption="Plaćeno" format="#,##0.00"/>
          <field name="DatumValute" caption="Datum valute" format="dd.MM.yyyy"/>
          <field name="Napomena" caption="Napomena"/>
          <field name="OrgNaziv" caption="Org. Shema"/>
        </fields>
        <event type="doubleclick">
          <action type="form open" value="frmIzmjena" if="#grdMaster.rowcount!=0">
            <parameter name="Id" value="#grdMaster.@KntKnjigaUraId"/>
            <parameter name="FaktureDobId" value="#grdMaster.@FaktureDobId"/>
          </action>
          <action type="control populate" value="#grdMaster" if="#grdMaster.rowcount!=0"/>
        </event>
      </grid>
    </managerlayout>

    <panelbuttons>
      <buttons>
        <button name="btnPregled" caption="PREGLED">
          <event type="click">
            <action type="form open" value="frmFilter"/>
            <action type="form close" if="global.$Close==true"/>
            <action type="control populate" value="#tree" if="global.$Close!=true"/>
            <action type="control populate" value="#grdMaster" if="global.$Close!=true"/>
          </event>
        </button>
        <button name="btnUnesi" caption="UNESI">
          <event type="click">
            <action type="form open" value="frmUnos"/>
            <action type="control populate" value="#tree"/>
            <action type="control populate" value="#grdMaster"/>
            <action type="footer text" value="Broj stavki: {#grdMaster.rowcount}"/>
          </event>
        </button>
        <button name="btnIspravi" caption="ISPRAVI">
          <event type="click">
            <action type="message" value="Potrebno je označiti jednu stavku." if="#grdMaster.selectedrowscount!=1"/>
            <action type="form open" value="frmIzmjena" if="#grdMaster.selectedrowscount==1">
              <parameter name="Id" value="#grdMaster.@KntKnjigaUraId"/>
              <parameter name="FaktureDobId" value="#grdMaster.@FaktureDobId"/>
            </action>
            <action type="control populate" value="#grdMaster" if="#grdMaster.selectedrowscount==1"/>
            <action type="footer text" value="Broj stavki: {#grdMaster.rowcount}" if="#grdMaster.selectedrowscount==1"/>
          </event>
        </button>
        <button name="btnObrisi" caption="OBRIŠI">
          <event type="click">
            <action type="message" value="Potrebno je označiti jednu stavku." if="#grdMaster.selectedrowscount!=1"/>
            <action type="form open" value="frmObrisi" if="#grdMaster.selectedrowscount==1">
              <parameter name="Id" value="#grdMaster.@KntKnjigaUraId"/>
            </action>
            <action type="control populate" value="#grdMaster" if="#grdMaster.selectedrowscount==1"/>
            <action type="footer text" value="Broj stavki: {#grdMaster.rowcount}" if="#grdMaster.selectedrowscount==1"/>
          </event>
        </button>
        <button name="btnZakljuci" caption="ZAKLJUČI" begingroup="true">
          <event type="click">
            <action type="form open" value="frmZakljuci">
              <parameter name="Node" value="global.$Node"/>
            </action>
            <action type="control populate" value="#grdMaster"/>
          </event>
        </button>
        <button name="btnPonistiZakljucak" caption="PONIŠTI ZAKLJUČAK">
          <event type="click">
            <action type="form open" value="frmPonistiZakljucak">
              <parameter name="Node" value="global.$Node"/>
            </action>
            <action type="control populate" value="#grdMaster"/>
          </event>
        </button>
        <button name="btnRucniUnos" caption="UNOS RUČNI">
          <event type="click">
            <action type="form open" value="frmRucniUnos">
              <parameter name="Node" value="global.$Node"/>
            </action>
            <action type="control populate" value="#grdMaster"/>
          </event>
        </button>
        <button name="btnProknjizi" caption="PROKNJIŽI">
          <event type="click">
            <action type="message" value="Potrebno je označiti stavku za proknjiženje." if="#grdMaster.selectedrowscount!=1"/>
            <action type="form open" value="frmProknjizi" if="#grdMaster.selectedrowscount==1">
              <parameter name="Id" value="#grdMaster.@KntKnjigaUraId"/>
              <parameter name="FaktureDobId" value="#grdMaster.@FaktureDobId"/>
            </action>
            <action type="control populate" value="#grdMaster" if="#grdMaster.selectedrowscount==1"/>
          </event>
        </button>
        <button name="btnPronadji" caption="PRONAĐI">
          <event type="click">
            <action type="form open" value="frmPronadji"/>
            <action type="control populate" value="#grdMaster"/>
          </event>
        </button>
        <button name="btnUrednikKnjiga" caption="UREDNIK KNJIGA" begingroup="true">
          <event type="click">
            <action type="form open" value="frmUrednikKnjiga"/>
          </event>
        </button>
        <button name="btnIzlaz" caption="IZLAZ" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtMaster" command="spKntKnjigaUraQueryNG" timeout="60" if="global.$Node!=null">
        <parameter name="@action" value="7"/>
        <parameter name="@node" value="global.$Node"/>
      </data>
      <data name="dtMaster" command="spKntKnjigaUraQueryNG" timeout="60" else="">
        <parameter name="@action" value="7"/>
        <parameter name="@id" value="global.$KntVrsteKnjigaUraId"/>
        <parameter name="@Godina" value="global.$Godina"/>
        <parameter name="@DatZak" value="global.$DatZak"/>
      </data>
    </datalist>
  </form>
</root>
