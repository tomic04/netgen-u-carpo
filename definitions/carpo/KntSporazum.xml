<root loglevel="4" version="1.0"> 
	<form type="master" name="frmGlavni" caption="Sporazum" template="splitter" maximized="true">
		<event type="load">
			<action type="control value" value="#datDatumRate">
				<parameter value="now" type="date"/>
			</action>			
			<action type="control value" value="#datDatumKnj">
				<parameter value="now" type="date"/>
			</action>				
		</event> 
		<event type="shown"> 
			<action type="control disable" value="#btnPreknjizi"/>
			<action type="control focus" value="#srcPartner"/>
		</event>
		<layout name="panel1" type="collapsable" caption="Parametri" autotaborder="false" >
			<group cols="1" rows="9">
				<columnsdefinition>
					<column size="400" position="1"/>
				</columnsdefinition>
				<item col="1" row="1" caption="Partner:">
					<searchedit name="srcPartner" type="partner" fontsizedelta="1" fieldvalue="PartneriId" fieldtext="Naziv" tabindex="1" entermovenextcontrol="false" required="true">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>
							<action type="control focus" value="#cmbKonto"/>
						</event>
					</searchedit>
				</item>
				<item col="1" row="2" caption="Konto:">
					<comboedit name="cmbKonto" dataname="~dtKonto" fontsizedelta="1" valuefield="KntPlanAId" displayfield="Naziv" tabindex="2" required="true">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>	
							<action type="control populate" value="#cmbNoviKonto"/>
						</event>
					</comboedit>
				</item>
				<item col="1" row="3" caption="Novi konto:">
					<comboedit name="cmbNoviKonto" dataname="~dtKontoNovi" fontsizedelta="1" valuefield="KntPlanAId" displayfield="Naziv" tabindex="3" required="true">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>	
						</event>
					</comboedit>
				</item>
				<item col="1" row="4" caption="Broj ugovora:">
					<textedit name="txtUgovor" maxlength="100" tabindex="4" fontsizedelta="1" savevalue="app" required="true"/>
				</item>
				<item col="1" row="5" caption="Broj rata:">
					<textedit name="txtBrojRata" maxlength="100" tabindex="5" fontsizedelta="1" savevalue="app" format="n0" required="true"/>
				</item>
				<item col="1" row="6" caption="Datum prve rate:" required="true" allownull="false">
					<dateedit name="datDatumRate" tabindex="6" fontsizedelta="1" required="true">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>	
						</event>
					</dateedit>
				</item>	
				<item col="1" row="7" caption="Vrsta dokumenta:">
					<comboedit name="cmbVrstaDok" dataname="~dtVrstaDok" fontsizedelta="1" displayfield="Opis" valuefield="VrstaDokId" allownull="false" tabindex="7" required="true">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>	
						</event>
					</comboedit>
				</item>
				<item col="1" row="8" caption="Datum knjiženja:" required="true" allownull="false">
					<dateedit name="datDatumKnj" tabindex="8" required="true" fontsizedelta="1">
						<event type="valuechanged">
							<action type="control datasourceempty" value="#grdGlavni">
								<parameter name="clearcolumns" value="false"/>
							</action>							
						</event>
						<event type="leave">
							<action type="control focus" value="#btnPokazi"/>
						</event>
					</dateedit>
				</item>		
				<item col="1" row="9"/>
			</group>	
		</layout>
		<layout name="panel2">
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdGlavni" dataname="~dtGlavni" key="iddok" showcheckboxes="true" allowfilter="true">	
						<event type="selectionchanged">
							<action type="variable value" value="$SelectedIds">
								<parameter value="#grdGlavni.selectedids"/>
							</action>
							<action type="control enable" value="#btnPreknjizi" if="#grdGlavni.rowcount!=0&amp;&amp;$SelectedIds!=&amp;&amp;$SelectedIds!=null"/>
							<action type="control disable" value="#btnPreknjizi" else=""/>								
						</event>						
						<fields>
							<field name="Partner" caption="Partner"/>
							<field name="Datumdokumenta" caption="Datum dokumenta"/>
							<field name="Broj"/>
							<field name="Duguje"/>
							<field name="Potrazuje" caption="Potražuje"/>
							<field name="Saldo" caption="Saldo"/>
							<field name="StariKonto" caption="Stari konto"/>
							<field name="NoviKonto" caption="Novi Konto"/> 
							<field name="Vrstadokumenta" caption="Vrsta dokumenta"/>
							<field name="Orgshema" caption="Organizacijska shema"/>
							<field name="Sifra" caption="Šifra"/>
							<field name="DatumKnjizenja" caption="Datum knjiženja"/>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPokazi" caption="POKAŽI" tabindex="9">
					<event type="click">
						<action type="validate"/>
						<action type="control selectedrows" value="#grdGlavni">
						  <parameter value=""/>
						</action>						
						<action type="variable value" value="$SelectedIds">
							<parameter value=""/>
						</action>						
						<action type="variable value">
							<parameter name="Partner" value="#srcPartner"/>
						</action>
						<action type="variable value">
							<parameter name="Konto" value="#cmbKonto"/>
						</action>					
						<action type="variable value">
							<parameter name="NoviKonto" value="#cmbNoviKonto"/>
						</action>	
						<action type="variable value">
							<parameter name="VrstaDokId" value="#cmbVrstaDok"/>
						</action>						
						<action type="variable value">
							<parameter name="DatumKnj" value="#datDatumKnj"/>
						</action>
						<action type="variable value">
							<parameter name="DatumRate" value="#datDatumRate"/>
						</action>						
						<action type="control populate" value="#grdGlavni"/>
						<!-- <action type="panel collapse" value="panel1" if="#grdGlavni.rowcount!=0"/> -->
						<action type="control focus" value="#grdGlavni"/>
						<action type="control disable" value="#btnPreknjizi"/>		
					</event>
				</button>
				<button name="btnPreknjizi" caption="PREKNJIŽI">
					<event type="click" waittype="progress" waitcaption="Kreiranje sporazuma" waittext="Knjiženje stavaka..." sleep="2000">
						<action type="datarun nonquery" value="~dtPreknjizi"/>
						<action type="control populate" value="#grdGlavni"/>
						<action type="control disable" value="#btnPreknjizi"/>
						<action type="control selectedrows" value="#grdGlavni">
						  <parameter value=""/>
						</action>							
						<action type="variable value" value="$SelectedIds">
							<parameter value=""/>
						</action>	
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS   SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdGlavni"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- Punjenje master grida grdGlavni-->
			<data name="dtGlavni" command="spCKntSporazumGrid" timeout="200">
				<parameter name="@Action" value="1"/>
				<parameter name="@PartneriId" value="#srcpartner"/>
				<parameter name="@Datum" value="#datDatumRate"/>
				<parameter name="@KntPlanAIdNovi" value="#cmbNoviKonto"/> 
				<parameter name="@KntPlanAIdStari" value="#cmbKonto"/>
				<parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
			</data>
			<!-- Punjenje kontrole VrstaDok-->
			<data name="dtVrstaDok" command="spCKntSporazumKontrole">
				<parameter name="@Action" value="2"/>
			</data>
			<!-- Stari konto - vrsta konta kupac i nije DEV -->
			<data name="dtKonto" command="spCKntSporazumKontrole">
				<parameter name="@Action" value="3"/>				
			</data>
			<!-- Novi konto sva konta koja počinju sa 2 znamenke iste kao od izabranog osnovnog konta + vrsta konta nije null (nije običan konto) -->
			<data name="dtKontoNovi" command="spCKntSporazumKontrole">
				<parameter name="@Action" value="4"/>
				<parameter name="@KntPlanAId" value="#cmbKonto"/>		
			</data>
			<!-- preknjizenje konta i partnera -->
			<data name="dtPreknjizi" command="spCKntSporazum" timeout="200">
				<parameter name="@Action" value="5" type="int"/>
				<parameter name="@SelectedIds" value="$SelectedIds"/>
				<parameter name="@PartneriId" value="#srcPartner"/>
				<parameter name="@DatumRate" value="#datDatumRate"/>
				<parameter name="@DatumKnj" value="#datDatumKnj"/>
				<parameter name="@KntPlanAIdNovi" value="#cmbNoviKonto"/> 
				<parameter name="@KntPlanAIdStari" value="#cmbKonto"/>
				<parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@BrojUgovora" value="#txtUgovor"/>
				<parameter name="@BrojRata" value="#txtBrojRata"/>				
			</data>
		</datalist>
	</form>
</root>