<?xml version="1.0" encoding="utf-8"?>
<!--
11.12.2017 v1.0.0.0 PJ init verzija
-->
<root version="1.0.0.0" loglevel="3">
	<form name="frmMaster" type="master" caption="Import Cjenika">
		<managerlayout>
			<event type="shown">
<!--				<action type="variable value" >
					<parameter name="NewVirmaniVrsteId" value="0" type="int"/>
				</action>	-->				
			</event>
<!--			<lookup name="filter">
			    <comboitem value="VrsteVirmana" />
            </lookup>-->
			<tree name="tree" searchfield="valueid" valuefield="ValueId" > <!--allowdrop="true" allowdrag="true" allowdragmultiple="true"-->
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava" />
				</event>
				<data command="spImportCjenikaAgronomTree">
					<parameter name="@Action" value="1" />
				</data>
				<fields>
					<field name="Name" />
				</fields>
			</tree>
			<grid name="grdGlava" type="master" async="true" multiselect="true" key="userid" savelayout="true" searchfield="userid"> <!--allowdrag="true" -->
				<data command="spImportCjenikaAgronomQuery" >
					<parameter name="@Action"  value="0"  />
					<parameter name="@ValueId" value="#tree.@ValueId" />
				</data>
<!--				<fields>
					<field name="NalogodavacZiro" caption="Nalogodavac IBAN" width="3000"/>
				</fields>-->
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true" >
            <buttons>
				<button name="btnUvezi" caption="UVEZI">
					<event type="click">
						<action type="form open" value="frmUvoz" />
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
				<button name="btnOsvjezi" caption="OSVJEŽI CJENIK">
				</button>
				<button name="btnPrenesi" caption="PRENESI">
				</button>
				<button name="btnSearch" caption="PRONAĐI">
					<event type="click">
						<action type="search" value="~dtSearch" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSearch" command="spImportCjenikaSearch">
				<parameter name="@Pojam" value="#btnSearch.searchtext"/>
				<parameter name="@Action" value="1"/>
			</data>
		</datalist>
	</form>
	
	<form name="frmUvoz"  caption="Uvoz datoteke">
		<layout>
			<group cols="1" rows="3" groupbordervisible="false">
				<item col="1" row="1" textposition="left" caption="Putanja datoteke:">
					<browseedit name="brwPutanja" /> <!--type="folder"-->
				</item>
				<item col="1" row="2"  textposition="left" caption="RUC" >
					<textedit name="txtRUC"  value="0" format="n2" fontsizedelta="2"  />
				</item>
				<item col="1" row="3"  textposition="left" caption="Tečaj" >
					<textedit name="txtTecaj"  value="0" format="n2" fontsizedelta="2"  />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUvezi" caption="Uvezi">
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="Učitavanje datoteke..." >
						<action type="datarun nonquery" value="~dtUvezi"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtUvezi" command="spImportCjenikaAgronomBulkInsert">
				<parameter name="@Action" value="1"/>
				<parameter name="@Putanja" value="#brwPutanja"/>
				<parameter name="@RUC" value="#txtRUC"/>
				<parameter name="@Tecaj" value="#txtTecaj"/>
			</data>
		</datalist>
	</form>
</root>