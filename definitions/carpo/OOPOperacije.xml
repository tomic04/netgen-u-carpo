<root version="1.0">

  <!--1.0 subforme  -->

  <form name="frmOOPOperacije" type="master" caption="Operacije" saveformsize="true" >

    <managerlayout textposition="left">
      <grid name="grdOperacije" type="master" key="OOPOperacijeId" dataname="~dtOperacije" fieldsmartspaces="false" showautofilterrow="true" multiselect="true">
        <fields inherited="true">
          <field name="Sifra" caption="Šifra" />
        </fields>
      </grid>
    </managerlayout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unos" function="UnosOperacije">
          <event type="click">
            <action type="form open" value="frmUnosIzmjena">
              <parameter name="Tip" value="unos"/>
              <parameter name="caption" value="Unos nove operacije"/>
              <parameter name="OOPOperacijeId" value="null"/>
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate" value="#grdOperacije" />
              <action type="control focus" value="#grdOperacije">
                <parameter value="$MasterFocus" />
              </action>
            </action>
          </event>
        </button>
        <button name="btnIzmjena" caption="Izmjena" function="IzmjenaOperacije">
          <event type="click">
            <action type="form open" value="frmUnosIzmjena">
              <parameter name="Tip" value="izmjena"/>
              <parameter name="caption" value="Izmjena operacije"/>
              <parameter name="OOPOperacijeId" value="#grdOperacije.@OOPOperacijeId"/>
            </action>
            <action type="control populate keepfocus" value="#grdOperacije" />
          </event>
        </button>
        <button name="btnBrisanje" caption="Brisanje" function="BrisanjeOperacije">
          <event type="click">
            <action type="datarun reader" value="~dtBrisanje" />
            <action type="control populate" value="#grdOperacije" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPOperacijeQueryCP" name="dtOperacije">
        <parameter name="@Action" value="Master_Query" />
      </data>
      <data command="spOOPOperacijeAzurCP" name="dtBrisanje">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@OOPOperacijeId" value="#grdOperacije.@OOPOperacijeId"/>
      </data>
    </datalist>
  </form>

  <!--LAYOUT FORMA ZA UNOS/BRISANJE/IZMJENU STATUSA-->
  <form name="frmUnosIzmjena" caption="$caption" height="150"  width="700" saveformlayout="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$OOPOperacijeId!=null"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="8" groupbordervisible="true">
        <item caption="Klasa:" col="1" row="1" highlight="false" >
          <comboedit name="cmbKlasa"  valuefield="OOPKlaseOperacijaId" displayfield="Klasa" dataname="~dtKlasa" datavalue="~dtGet.@OOPKlaseOperacijaId"/>
        </item>
		<item caption="Tip:" col="1" row="2" highlight="false" >
          <comboedit name="cmbTip"  valuefield="OOPTipOperacijeId" displayfield="Tip" dataname="~dtTip" datavalue="~dtGet.@OOPTipOperacijeId" required="true"/>
        </item>
        <item caption="Naziv:" col="1" row="3" highlight="false" >
          <textedit name="txtNaziv" datavalue="~dtGet.@Naziv" required="true" />
        </item>
        <item caption="Grupa:" col="1" row="4" highlight="false" >
          <textedit name="txtGrupa" datavalue="~dtGet.@Grupa" required="true"/>
        </item>
        <item caption="Stavka:" col="1" row="5" highlight="false" >
          <comboedit name="cmbStavka"  valuefield="OOPStavekeId" displayfield="Stavka" dataname="~dtStavka" datavalue="~dtGet.@OOPStavekeId" required="true"/>
        </item>
        <item caption="Šifra:" col="1" row="6" highlight="false" >
          <textedit name="txtSifra" datavalue="~dtGet.@Sifra" required="true"/>
        </item>
        <item caption="Umirovljeno" col="1" row="7"  >
          <checkedit name="chkUmirovljeno" datavalue="~dtGet.@IndUmirovljeno"  />
        </item>
        <item caption="Opis:" col="1" row="8" highlight="false" >
          <textedit name="txtOpis" datavalue="~dtGet.@Opis"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <action type="datarun reader" value="~dtIzmjena" if="$OOPOperacijeId!=null"  />
            <action type="datarun reader" value="~dtUnos" else="" />
            <action type="variable value">
                <parameter name="parent.$MasterFocus" value="~dtUnos.@MasterFocus" type="int"/>
              </action>
            <action type="form close"></action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPOperacijeHelpCP" name="dtKlasa">
        <parameter name="@Action" value="cmbKlasa" />
      </data>
	  <data command="spOOPOperacijeHelpCP" name="dtTip">
        <parameter name="@Action" value="cmbTip" />
      </data>
      <data command="spOOPOperacijeHelpCP" name="dtStavka">
        <parameter name="@Action" value="cmbStavka" />
      </data>
      <data command="spOOPOperacijeHelpCP" name="dtGet">
        <parameter name="@Action" value="Dohvati_operaciju" />
        <parameter name="@OOPOperacijeId" value="$OOPOperacijeId" />
      </data>
      <data command="spOOPOperacijeHelpCP" name="dtGet">
        <parameter name="@Action" value="Dohvati_operaciju" />
        <parameter name="@OOPOperacijeId" value="$OOPOperacijeId" />
      </data>
      <data command="spOOPOperacijeAzurCP" name="dtUnos" >
        <parameter name="@Action" value="Unos" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Grupa" value="#txtGrupa" />
        <parameter name="@OOPTipOperacijeId" value="#cmbTip" />
        <parameter name="@OOPStavekeId" value="#cmbStavka" />
        <parameter name="@Sifra" value="#txtSifra" />
        <parameter name="@Umirovljeno" value="#chkUmirovljeno" />
        <parameter name="@OOPKlaseOperacijaId" value="#cmbKlasa" />
        <parameter name="@Opis" value="#txtOpis" />
      </data>
      <data command="spOOPOperacijeAzurCP" name="dtIzmjena" >
        <parameter name="@Action" value="Izmjena" />
        <parameter name="@OOPOperacijeId" value="$OOPOperacijeId" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Grupa" value="#txtGrupa" />
        <parameter name="@OOPTipOperacijeId" value="#cmbTip" />
        <parameter name="@OOPStavekeId" value="#cmbStavka" />
        <parameter name="@Sifra" value="#txtSifra" />
        <parameter name="@Umirovljeno" value="#chkUmirovljeno" />
        <parameter name="@OOPKlaseOperacijaId" value="#cmbKlasa" />
        <parameter name="@Opis" value="#txtOpis" />
      </data>
    </datalist>

  </form>



</root>