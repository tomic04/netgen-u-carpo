<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: NARUDZBE_FORM (NetGen) → frmNarudzbe (Carpo)
Skeleton: prikaz zaglavlja + stavki narudžbe za odabrani KUPPrometId.
-->
<root version="1.2">
  <form name="frmNarudzbe" caption="Narudžba" type="dialog" width="1100" height="760" fixedsize="false" saveformsize="true">
    <event type="shown">
      <action type="datarun reader" value="~dtHeader"/>
      <action type="control populate" value="#grdStavke"/>

      <action type="control value" value="#txtBroj">
        <parameter value="~dtHeader.@broj"/>
      </action>
      <action type="control value" value="#datDatum">
        <parameter value="~dtHeader.@datumdok" type="date"/>
      </action>
      <action type="control value" value="#txtOpis">
        <parameter value="~dtHeader.@opis"/>
      </action>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <group col="1" row="1" cols="6" rows="2" groupbordervisible="false" caption="Zaglavlje">
          <item col="1" row="1" caption="Broj:" textposition="left">
            <textedit name="txtBroj" enabled="false"/>
          </item>
          <item col="2" row="1" caption="Datum:" textposition="left">
            <dateedit name="datDatum" enabled="false"/>
          </item>
          <item col="1" row="2" colspan="6" caption="Opis:" textposition="left">
            <textedit name="txtOpis" enabled="false"/>
          </item>
        </group>

        <group col="1" row="2" cols="1" rows="1" groupbordervisible="false" caption="Stavke">
          <item col="1" row="1">
            <grid name="grdStavke" dataname="~dtStavke" bestfitonrefresh="true" showautofilterrow="true" savelayout="true">
              <fields inherited="true"/>
            </grid>
          </item>
        </group>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="ZATVORI" dock="right" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtHeader" command="dbo.spKUPNabNarGlaQuery" timeout="300">
        <!-- NetGen: dbo.spKUPNabNarGlaQuery @id=@@kupprometid -->
        <parameter name="@id" value="$Id"/>
      </data>
      <data name="dtStavke" command="dbo.spKUPNabNarDetQuery" timeout="300">
        <parameter name="@KUPrometId" value="$Id"/>
      </data>
    </datalist>
  </form>
</root>

