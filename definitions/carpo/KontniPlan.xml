<root version="1.0.1.8">
	<form name="frmMaster" type="master" caption="Kontni Plan">
	<method name="CarpoNew" dll="Carpo" class="Carpo.Gen.Start" method="Run"/>	
		<event type="init">
			<action type="variable value">
				<parameter name="Global.OperaterLockId" value="0" type="int" />
			</action>
			<action type="datarun reader" value="global.~dtPrviDan"/>	
			<action type="datarun reader" value="global.~dtAIGEdit"/>				
		</event>
		<event type="load">			
			<action type="variable value">
				<parameter name="global.$DatumOd" value="~dtPrviDan.@prvidan" type="date"/>
			</action>
			<action type="variable value">
				<parameter name="global.$DatumDo" value="now" type="date"/>
			</action>
			<action type="variable value">
				<parameter name="global.$AigAzur" value="~dtAIGEdit.@AigAzur" type="int"/>
			</action>
		</event>
		<managerlayout>
			<event type="shown">
				<action type="variable value" >
					<parameter name="NewKntPlanSid" value="0" type="int"/>
					<parameter name="CurrentKntPlanSid" value="0" type="int"/>
					<parameter name="NewKntPlanAid" value="0" type="int"/>
					<parameter name="CurrentKntPlanAid" value="0" type="int"/>
				</action>				
			</event>
			<tree name="tree"  expandedlevel="1" key="id" valuefield="KntPlanSId" >
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava" />
					<!--Ovaj dio kopirati svuda gdje je ctrl populate grdGlava -->
					<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
					<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />
				</event>
				<data command="spCkntTreeKontniPlan"  >										
				</data>
				<fields>
                    <field name="Name" />
                </fields>
				<menu>
					<menuitem caption="Unesi" function="UnosSintetike">
						<event type="click" >
							<action type="datarun scalar" value="Global.~dtGetNewIdSintetika">
								<parameter name="CurrentKntPlanSid" />
							</action>
							<action type="form open" value="frmAnalitika" if="#tree.@Nivo==3">
								<parameter name="IndUnosa" value="1" />	
								<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />
							</action>
							<action type="form open" value="frmSintetika" elseif="#tree.@Nivo!=3">
								<parameter name="IndUnosa" value="1" />	
							</action>
							<action type="control populate keepfocus" value="#tree"/>
							<action type="datarun scalar" value="Global.~dtGetNewIdSintetika">
								<parameter name="NewKntPlanSid" />
							</action>
							<action type="control focus" value="#tree" if="$CurrentKntPlanSid!=$NewKntPlanSid" >
								<parameter value="$NewKntPlanSid" type="int"/> 
							</action>
						</event>
					</menuitem>
					<menuitem caption="Izmjeni" function="IzmjenaSintetike">
						<event type="click" > 							
							<action type="form open" value="frmSintetika">
								<parameter name="IndUnosa" value="0" />	
								<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />	
							</action>	
							<action type="control populate keepfocus" value="#tree"/>							
						</event>
					</menuitem>
					<menuitem caption="Obriši" function="BrisanjeSintetike">
						<event type="click">
							<action type="variable value">
								<parameter name="Konto" value="#tree.@Naziv" />
								<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />
							</action>
							<action type="confirm" value="Želite li doista obrisati odabrani Sintetički konto '{$Konto}'?">							
								<action type="datarun nonquery" value="Global.~dtSintetikaDelete">
									<action type="control populate keepfocus" value="#tree" />
								</action>
							</action>
						</event>
					</menuitem>
				</menu>
			</tree>
			<grid name="grdGlava" type="master" async="true"  multiselect="true" savelayout="true"  autowidth="true" key="KntPlanAId">
				<event type="cellvaluechanged">
					<action type="datarun nonquery" value="~dtGrdEdit" if="#grdGlava.rowcount!=0" />
					<action type="control populate keepfocus" value="#grdGlava" />
					<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
					<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />
				</event>
				<event type="doubleclick">
					<action type="form open" value="frmAnalitika" >
						<parameter name="IndUnosa" value="0" />	
						<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />
						<parameter name="KntPlanAId" value="#grdGlava.@KntPlanAId" />
					</action>	
					<action type="control populate keepfocus" value="#grdGlava"/>	
					<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
					<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />		
				</event>
<!--				<event type="showingeditor">
					<action type="editor allow" value="true" if="#grdGlava.@OperateriId==@@OperateriId" />
				</event>-->
				<data command="spCKntPlanAQuery" >
					<parameter name="@Action"  value="2" />
					<parameter name="@Konto" value="#tree.@Konto" />
				</data>
				<fields>
                    <field name="Konto" caption="Analitički plan"/>
					<field name="Naziv" />
					<field name="VrstaKonta" caption="Vrsta računa"/>
					<field name="DevizniKonto" caption="Devizni"/>
					<field name="KontoPD" caption="PD"/>
					<field name="KontoSD" caption="SD"/>
					<field name="BA" editable="true"/>
					<field name="BP" editable="true"/>
					<field name="RDG" editable="true"/>
					<field name="AOP_GFI_16" caption="AOP_GFI_2016" editable="true"/>
					<field name="AOP_GFI_16dod" caption="AOP_GFI_2016_dod" editable="true"/>
					<field name="AOP_GFI_21" caption="AOP_GFI_2021" editable="true"/>
					<field name="AOP_GFI_21dod" caption="AOP_GFI_2021_dod" editable="true"/>
					<field name="AOP_GFI_24" caption="AOP_GFI_24" editable="true"/>
					<field name="AOP_GFI_24dod" caption="AOP_GFI_24_dod" editable="true"/>
					<field name="AOP" caption="AOP_GFI" editable="true"/>
					<field name="AOPdod" caption="AOP_GFI_dod" editable="true"/>
					<field name="AOP_tsi" caption="AOP_TSI" editable="true"/>
					<field name="Rbrb" caption="Redni broj bilješke" editable="true"/>
					<field name="PDobrazac" caption="PD obrazac" editable="true"/>
					<field name="KompOznaka" caption="Oznaka"/>
					<field name="Umirovljen"/>
					<field name="ObavVrstaDim" caption="Obavezna vrsta dimenzije"/>
					<field name="Pdvnetiranje" caption="PDV netiranje"/>
					<field name="Dimenzije"/>
					<field name="MasterKonto" caption="Master Konto"/>
					<field name="StatusMasterKonta" caption="StatusMasterKonta"/>
					<!-- <field name="KonsKonto" caption="AigKonto"/> -->
					<!--specifične kolone po firmama dodati u part-->
					<part name="prtKontniPlanGrid" path="prtKontniPlan.xml"/>
                </fields>
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true" >
			<buttons>
				<button name="btnUnesi" caption="UNESI" function="UnosAnalitike">
					<event type="click"> 
						<action type="datarun scalar" value="Global.~dtGetNewIdAnalitika">
							<parameter name="CurrentKntPlanAid" />
						</action>
						<action type="form open" value="frmAnalitika" >
							<parameter name="IndUnosa" value="1" />	
							<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />
						</action>
						<action type="control populate keepfocus" value="#grdGlava"/>
						<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
						<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />
						<action type="datarun scalar" value="Global.~dtGetNewIdAnalitika">
							<parameter name="NewKntPlanAid" />
						</action>
						<action type="control focus" value="#grdGlava" if="$CurrentKntPlanAid!=$NewKntPlanAid" >
							<parameter value="$NewKntPlanAid" type="int"/> 
						</action>
						<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
						<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" function="IzmjenaAnalitike">
					<event type="click">
						<action type="form open" value="frmAnalitika" >
							<parameter name="IndUnosa" value="0" />	
							<parameter name="KntPlanSId" value="#tree.@KntPlanSId" />
							<parameter name="KntPlanAId" value="#grdGlava.@KntPlanAId" />
						</action>	
						<action type="control populate keepfocus" value="#grdGlava"/>	
						<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
						<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />							
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" function="BrisanjeAnalitike">
					<event type="click"> 
						<action type="variable value">
							<parameter name="KntPlanAId" value="#grdGlava.@KntPlanAId" />								
						</action>
						<action type="confirm" value="Želite li doista obrisati odabrani konto?">							
							<action type="datarun nonquery" value="Global.~dtAnalitikaDelete">
								<action type="control populate keepfocus" value="#grdGlava" />
								<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmijeni, #btnObrisi"  />	
								<action type="control enable" value="#btnIzmijeni, #btnObrisi" elseif="#grdGlava.rowcount!=0" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnKarticaKonta" caption="Kartica konta" function="KarticaKonta">
<!--						<event type="click"> 
						<action type="form open" value="frmInfoDisabled"/>
					</event>-->
					<event type="click">
						<action type="method run" value="CarpoNew">
							<!--za testiranje-->
							<!-- <parameter name="moduleid" value="D:\puštanje paketa\KarticaKonta Carpo\KarticaKonta.xml"/> -->
							<parameter name="moduleid" value="KarticaKonta.xml"/>
							<parameter name="global.IndikatorGranulaPrevara" type="var" valuetype="int" value="1"/>
							<parameter name="global.DatumOd" type="var" valuetype="date" value="global.$DatumOd"/>
							<parameter name="global.DatumDo" type="var" valuetype="date" value="global.$DatumDo"/>		
							<parameter name="global.KntPlanAId" type="var" valuetype="int" value="#grdGlava.@KntPlanAId"/>
							<parameter name="global.Konto" type="var" valuetype="int" value="#grdGlava.@Konto"/> 
							<parameter name="global.KontoNaziv" type="var" value="#grdGlava.@Naziv"/>
<!--							<parameter name="global.PartneriId" type="var" valuetype="int" value="#grdGlava.@partneriId"/>
							<parameter name="global.PartneriNaziv" type="var" value="#grdGlava.@Naziv"/>	-->						
							<parameter name="global.AnalitikaPS" type="var" value="0" />
						</action>
						</event>
				</button>
				<button name="btnHelp" caption="Uputi me">
					<event type="click"> 
						<action type="form open" value="frmInfoDisabled"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGrdEdit" command="spCKntPlanAAzur">
				<parameter name="@Action" value="3"/>
				<parameter name="@Id" value="#grdGlava.@KntPlanAId"/>
				<parameter name="@Value" value="#grdGlava.focusedvalue" />
				<parameter name="@Kolona" value="#grdGlava.focusedfield"/>
				<parameter name="@Konto" value="null"/>
			</data>
		</datalist>
	</form>
	<form name="frmSintetika" caption="Sintetika">
		<event type="oninit">  				
		</event>
		<event type="onload">
			<action type="datarun reader" value="Global.~dtSintetikaQuery" if="$IndUnosa==0" >				
			</action>		
			<action type="control populate" value="#txtKonto"></action>	
		</event>
		<event type="onshown">	
			<action type="control value" value="#txtKonto">
				<parameter value="#dtSintetikaQuery.@Konto" if="$IndUnosa==0" />
				<parameter value="parent.#tree.@Konto" if="$IndUnosa==1" />				
			</action>
			<action type="control value" value="#txtNaziv">
				<parameter value="#dtSintetikaQuery.@Naziv"  />		
			</action>			
			<action if="$IndUnosa==0" type="control disable" value="#txtKonto"  />				
		</event>
		<layout textposition="left" itemspadding="2">
			<group cols="1" rows="1" >
				<group cols="1" rows="2" groupbordervisible="true">
					<item col="1" row="1" caption="Konto:" >
							<textedit name="txtKonto"  required="true"  >
							</textedit>
					</item>
					<item col="1" row="2" caption="Naziv:" >
							<textedit name="txtNaziv"   >
							</textedit>
					</item>
				</group>
			</group>
		</layout>
		<datalist>
			<data command="spCKntPlanSAzur" name="dtSintetikaAzur">
				<parameter name="@Action"  value="0" if="$IndUnosa==1"/>
				<parameter name="@Action"  value="1" if="$IndUnosa==0"/>
				<parameter name="@Konto"  value="#txtKonto" />
				<parameter name="@Naziv"  value="#txtNaziv" />
				<parameter name="@id"  value="$KntPlanSId" />
			</data>

		</datalist>
			<panelbuttons  >
				<buttons>
					<button name="btnSpremi" caption="Spremi">
						<event type="click"> 
							<action type="datarun nonquery" value="~dtSintetikaAzur" >																								
							</action>
							<action type="form close" />
						</event>
					</button>
					<button name="btnOdustani" caption="Odustani" type="cancel">
					</button>
					<button name="btnHelp" caption="Uputi me">
						<event type="click"> 
							<action type="form open" value="frmInfoDisabled"/>
						</event>
					</button>
				</buttons>
			</panelbuttons>			
	</form>
	<form name="frmAnalitika" caption="Analitika" height="400">
		<method name="fnDimenzije" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run"/>
		<event type="onload">
			<action type="datarun reader" value="Global.~dtAnalitikaQuery" if="$IndUnosa==0"/>	
			<action type="datarun reader" value="~dtDimVrstePopuni" if="$IndUnosa==0"/>	
			<action type="datarun reader" value="Global.~dtPrometInd" if="$IndUnosa==0" >				
			</action>
		 
			<action if="#dtPrometInd.@IndPromet==1" type="control disable" value="#chkDevizniKonto, #cmbKntVrstaId" />	
			<action if="#dtAnalitikaQuery.@devind==0" type="control disable" value="#txtKntNegTecRaz, #txtKntPozTecRaz" />		
			<action if="global.$AigAzur==0" type="control disable" value="#srcAigKonto" />	 
				<!-- <action type="control disable" value="#srcAigKonto" />	 -->
		</event>
		<event type="onshown">	
	
			<action type="control value" value="#txtKonto">
				<parameter value="#dtAnalitikaQuery.@Konto" if="$IndUnosa==0"  />		
				<parameter value="parent.#tree.@Konto" if="$IndUnosa==1"  />	
			</action>
			<action type="control value" value="#txtNaziv">
				<parameter value="#dtAnalitikaQuery.@Naziv"  />		
			</action>
			<action type="control value" value="#chkDevizniKonto">
				<parameter value="#dtAnalitikaQuery.@devind"  />		
			</action>
			<action type="control value" value="#cmbKntVrstaId">
				<parameter value="#dtAnalitikaQuery.@KntVrstaId"  />		
			</action>	
			<action type="control value" value="#txtKntNegTecRaz">
				<parameter value="#dtAnalitikaQuery.@KntNegTecRaz"  />		
			</action>
			<action type="control value" value="#txtKntPozTecRaz">
				<parameter value="#dtAnalitikaQuery.@KntPozTecRaz"  />		
			</action>		
			<action type="control value" value="#txtOznaka">
				<parameter value="#dtAnalitikaQuery.@KompOznaka"  />		
			</action>
			<action type="control value" value="#txtKontoPd">
				<parameter value="#dtAnalitikaQuery.@KontoPd"  />		
			</action>
			<action type="control value" value="#txtKontoSd">
				<parameter value="#dtAnalitikaQuery.@KontoSd"  />		
			</action>
			<action type="control value" value="#chkOrgShema">
				<parameter value="#dtAnalitikaQuery.@OrgShemaObavezna"  />		
			</action>
			<action type="control value" value="#txtBA">
				<parameter value="#dtAnalitikaQuery.@BA"  />		
			</action>
			<action type="control value" value="#txtBP">
				<parameter value="#dtAnalitikaQuery.@BP"  />		
			</action>
			<action type="control value" value="#txtRDG">
				<parameter value="#dtAnalitikaQuery.@RDG"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI">
				<parameter value="#dtAnalitikaQuery.@AOP"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI_dod">
				<parameter value="#dtAnalitikaQuery.@AOPdod"  />		
			</action>
			<action type="control value" value="#txtAOP_TSI">
				<parameter value="#dtAnalitikaQuery.@AOP_TSI"  />		
			</action>	
			<action type="control value" value="#txtRbRb">
				<parameter value="#dtAnalitikaQuery.@RBRB"  />		
			</action>	
			<action type="control value" value="#txtAOP_GFI_16">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_16"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI_16dod">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_16dod"  />		
			</action>
			<action type="control value" value="#chkAktivan" if="$IndUnosa==0">
				<parameter value="#dtAnalitikaQuery.@active"  />		
			</action>
			<action type="control value" value="#cmbVrstaDim" if="$IndUnosa==0">
				<parameter value="~dtDimVrstePopuni.@NizDim"/>		
			</action>	
			<action type="control value" value="#chkPdvNetiranje" >
				<parameter value="#dtAnalitikaQuery.@PDVnetiranje"  />		
			</action>	
			<action type="control value" value="#txtAOP_GFI_21">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_21"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI_21dod">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_21dod"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI_24">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_24"  />		
			</action>
			<action type="control value" value="#txtAOP_GFI_24dod">
				<parameter value="#dtAnalitikaQuery.@AOP_GFI_24dod"  />		
			</action>
			<action type="control value" value="#srcMasterKonto">
				<parameter text="~dtAnalitikaQuery.@MasterKonto" value="~dtAnalitikaQuery.@MasterKonto"  />		
			</action>
			<action type="control value" value="#txtStatusMasterKonta">
				<parameter value="#dtAnalitikaQuery.@StatusMasterKonta"  />		
			</action>
			<action type="control value" value="#srcAigKonto">
				<parameter text="~dtAnalitikaQuery.@AigKonto" value="~dtAnalitikaQuery.@AigKonto"  />		
			</action>
			<action type="control visible" value="#btnDimenzije" if="$IndUnosa!=0">
				<parameter value="false"/>
			</action>
		</event>
		<layout textposition="left" itemspadding="2">
			<group cols="1" rows="1" >				
					<tabs row="1" col="1" padding="2">
						<group caption="Ažuriranje" cols="2" rows="4" col="1" row="1">
							<item col="1" row="1" caption="Konto:" >
								<textedit name="txtKonto"  >
								</textedit>
							</item>
