<root>
	<form name="frmMaster" caption="Čišćenje Partnera" template="splitter vertical" splitterposition="300" maximized="true" width="650" height="650" fixedsize="false">
		<event type="load">
			<action type="control populate" value="#grdMaster" />
		</event>
		<layout name="panel1" minsize="300">
			<group cols="1" rows="1">
				<!-- <rowsdefinition> -->
				<!--
				<row size="50%" position="1"/>
				<row size="10%" position="2"/>
				<row size="40%" position="3"/>
				-->
				<!-- </rowsdefinition> -->
				<item col="1" row="1">
					<grid name="grdMaster" dataname="~dtPuniMaster" key="partneriid" savelayout="false">
						<fields inherited="false">
							<field name="sifra" caption="Šifra" fixwidth="100" />
							<field name="naziv" caption="Naziv" fixwidth="350" />
							<field name="matbroj" caption="Matični broj" fixwidth="120" />
							<field name="OIB" caption="O I B" fixwidth="120" />
							<field name="Adresa" caption="Adresa" fixwidth="250" />
							<field name="MjestaNaziv" caption="Mjesto" fixwidth="120" />
							<field name="Telefon" fixwidth="120" />
							<field name="Fax" fixwidth="120" />
							<field name="Email" fixwidth="150" />
						</fields>
						<menu>
							<menuitem caption="Odabir partnera kao pravog partnera">
								<event type="click">
									<action type="validate" />
									<action type="control value" value="#txtPraviPartner">
										<parameter value="#grdMaster.@naziv" />
									</action>
									<action type="variable value">
										<parameter name="PraviPartneriId" value="#grdMaster.@partneriid" />
									</action>
									<action type="control datasourceempty" value="#grdAnalizaPravi" />
								</event>
							</menuitem>
							<menuitem caption="Odabir partnera za brisanje">
								<event type="click">
									<action type="validate" />
									<action type="control value" value="#txtPartneriBrisanje">
										<parameter value="#grdMaster.@naziv" />
									</action>
									<action type="variable value">
										<parameter name="BrisanjePartneriId" value="#grdMaster.@partneriid" />
									</action>
									<action type="control datasourceempty" value="#grdAnalizaBrisanje" />
								</event>
							</menuitem>
						</menu>
					</grid>
				</item>
			</group>
		</layout>
		<layout name="panel2" minsize="300">
			<group cols="1" rows="3">
				<group row="3" col="1" rows="1" cols="4" bordervisible="false" height="40">
					<columnsdefinition>
						<column size="10%" position="1" />
						<column size="70%" position="2" />
						<column size="10%" position="3" />
						<column size="10%" position="4" />
					</columnsdefinition>
					<item col="1" row="1" width="120" bordervisible="false">
						<button name="btnPrenesi" caption="PRENESI">
							<event type="click">
								<action type="variable value">
									<parameter name="Error" value="0" />
								</action>
								<action type="confirm" value="Želite li obaviti prijenos?">
									<action type="validate" />
									<action type="datarun noquery" value="~dtPrenesi" />
									<action type="variable value">
										<parameter name="Error" value="1" />
									</action>
								</action>
								<action if="$Error==1" type="message" value="'Čišćenje partnera uspješno obavljeno!'" />
								
								<action type="control populate" value="#grdAnalizaBrisanje" />
								<action type="control populate" value="#grdAnalizaPravi" />
								<action type="control populate" value="#grdMaster" />
							</event>
						</button>
					</item>
					<!-- Uputi me -->
					<item col="3" row="1" width="120" bordervisible="false">
						<button name="btnUputiMe" caption="UPUTI ME" />
					</item>
					<item col="4" row="1" width="120" bordervisible="false">
						<button name="btnIzlaz" caption="IZLAZ">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
				<group row="1" col="1" rows="1" cols="2" bordervisible="false">
					<!--
					<columnsdefinition>
					<column size="45%" position="1"/>
					<column size="45%" position="2"/>
					<column size="10%" position="3"/>
					</columnsdefinition>
					-->
					<!-- Pravi partner -->
					<group col="1" row="1" cols="3" rows="1" bordervisible="false">
						<!--
						<columnsdefinition>
						<column size="10%" position="3" />
						<column size="15%" position="1" />
						<column size="75%" position="2" />
						</columnsdefinition>
						-->
						<group row="1" col="1" bordervisible="false" cols="1" rows="1">
							<item col="1" row="1">
								<labeledit value="Pravi partner" />
							</item>
						</group>
						<group row="1" col="2" rows="1" cols="1" bordervisible="false">
							<!--  -->
							<item col="1" row="1">
								<textedit name="txtPraviPartner" enabled="false" />
							</item>
						</group>
						<group row="1" col="3" cols="1" rows="1" bordervisible="false" width="120">
							<item col="1" row="1">
								<button name="btnAnalizaPravi" caption="ANALIZA">
									<event type="click">
										<action type="control populate" value="#grdAnalizaPravi" />
									</event>
								</button>
							</item>
						</group>
					</group>
					<!-- partner za brisanje -->
					<group col="2" row="1" cols="3" rows="1" bordervisible="false">
						<!--
						<columnsdefinition>
						<column size="15%" position="1" />
						<column size="10%" position="3" />
						<column size="70%" position="2" />
						</columnsdefinition>
						-->
						<group row="1" col="1" bordervisible="false" cols="1" rows="1">
							<item col="1" row="1">
								<labeledit value="Partner za brisanje" textposition="center" />
							</item>
						</group>
						<group row="1" col="2" cols="1" rows="1" bordervisible="false">
							<item col="1" row="1">
								<textedit name="txtPartneriBrisanje" enabled="false" />
							</item>
						</group>
						<group row="1" col="3" rows="1" cols="1" bordervisible="false" width="120">
							<item col="1" row="1" width="50">
								<button name="btnAnalizaBrisanje" caption="ANALIZA">
									<event type="click">
										<action type="control populate" value="#grdAnalizaBrisanje" />
									</event>
								</button>
							</item>
						</group>
					</group>
					<!-- Prenesi -->
					<!--
					<group col="3" row="1" cols="3" rows="1" bordervisible="false" width="120">
					<item col="3" row="1" width="50" >
					<button name="btnPrenesi" caption="PRENESI" >
					<event type="click">
					<action type="datarun nonquery" value="~dtPrenesi" />
					<action type="control populate" value="#grdAnalizaBrisanje" />
					<action type="control populate" value="#grdAnalizaPravi" />
					<action type="control populate" value="#grdMaster" />
					<action type="control datasourceempty" value="#grdAnalizaPravi">
					<parameter name="clearcolumns" value="true"/>
					</action>
					<action type="control datasourceempty" value="#grdAnalizaBrisanje">
					<parameter name="clearcolumns" value="true"/>
					</action>
					</event>
					</button>
					</item>
					</group>
					-->
					<!-- Uputi me -->
					<!--
					<item col="4" row="1">
					<button name="btnUputiMe" caption="UPUTI ME" />
					</item>
					-->
				</group>
				<group col="1" row="2" rows="1" cols="2" bordervisible="false">
					<item col="1" row="1">
						<grid name="grdAnalizaPravi" dataname="~dtAnalizaPravi" showgrouppanel="false" savelayout="true">
							<fields>
								<field name="Nazivtabele" caption="Tablica" fixwidth="250" />
								<field name="BrIda" caption="Broj stavki" fixwidth="100" />
							</fields>
						</grid>
					</item>
					<item col="2" row="1">
						<grid name="grdAnalizaBrisanje" dataname="~dtAnalizaBrisanje" showgrouppanel="false" savelayout="true">
							<fields>
								<field name="Nazivtabele" caption="Tablica" fixwidth="250" />
								<field name="BrIda" caption="Broj stavki" fixwidth="100" />
							</fields>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<datalist>
			<data command="spPartneriCiscenjeQuery" name="dtPuniMaster">
				<parameter name="@Action" value="0" />
			</data>
			<data command="spPartneriCiscenjeInfo" name="dtAnalizaPravi">
				<parameter name="@partneriid" value="$PraviPartneriId" />
			</data>
			<data command="spPartneriCiscenjeInfo" name="dtAnalizaBrisanje">
				<parameter name="@partneriid" value="$BrisanjePartneriId" />
			</data>
			<data command="spPartneriCiscenjeAzur" name="dtPrenesi" timeout="600000">
				<parameter name="@PraviPartnerId" value="$PraviPartneriId" />
				<parameter name="@BrisiPartnerid" value="$BrisanjePartneriId" />
				<parameter name="@OsobaMPid" value="0" />
			</data>
		</datalist>
	</form>
</root>
