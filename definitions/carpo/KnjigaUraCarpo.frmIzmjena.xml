<?xml version="1.0" encoding="utf-8"?>
<!-- IZMJENI_FORM - Izmjena stavke u Knjigi URA (početna Carpo verzija, treba dopuniti) -->
<root version="1.2">
  <form name="frmIzmjena" type="custom" caption="Izmijeni" width="800" height="600">
    <event type="oninit">
      <action type="datarun reader" value="~dtGet"/>
    </event>
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1">
          <label name="lblInfo" caption="Forma za izmjenu - u izradi. Kompletna konverzija IZMJENI_FORM zahtijeva punu mapiranje kontrola."/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="Zatvori">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtGet" command="spKntKnjigaUraQueryNG" timeout="30">
        <parameter name="@action" value="21"/>
        <parameter name="@id" value="$FaktureDobId"/>
      </data>
    </datalist>
  </form>
</root>
