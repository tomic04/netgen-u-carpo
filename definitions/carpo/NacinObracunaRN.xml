<root>
	<form type="master" name="frmMaster" caption="Način obračuna radnih naloga">
		<managerlayout>
			<grid type="master" name="grdMaster" dataname="~dtMaster" key="ServisNacinObrId" bestfitonrefresh="true" savelayout="true"/>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmUpsert">
							<parameter name="ServisNacinObrId" value="null"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni">
					<event type="click">
						<action type="form open" value="frmUpsert">
							<parameter name="ServisNacinObrId" value="#grdMaster.@ServisNacinObrId"/>
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati {#grdMaster.@Naziv}?"/>
						<action type="datarun nonquery" value="~dtObrisi"/>
						<action type="control populate" value="#grdMaster"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spServisNacinObracunaCarpo">
				<parameter name="@Action" value="MASTER"/>
			</data>
			<data name="dtObrisi" command="spServisNacinObracunaCarpo">
				<parameter name="@Action" value="DELETE"/>
				<parameter name="@ID" value="#grdMaster.@ServisNacinObrId"/>
			</data>
		</datalist>
	</form>
	<form name="frmUpsert" caption="Način obračuna radnog naloga">
		<event type="init">
			<action type="datarun reader" value="~dtLoad" if="$ServisNacinObrId!=null"/>
		</event>
		<layout>
			<group rows="3" cols="1" textposition="left">
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtLoad.@Naziv" required="true"/>
				</item>
				<item row="2" col="1" caption="Oznaka:">
					<textedit name="txtOznaka" datavalue="~dtLoad.@Oznaka" required="true"/>
				</item>
				<item row="3" col="1" caption="Ispis cijene:">
					<textedit name="txtIspisiCijenu" datavalue="~dtLoad.@IspisiCijenu" required="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action if="$ServisNacinObrId==null">
							<action type="validate"/>
							<action type="datarun scalar" value="~dtUpsert">
								<parameter name="NewId"/>
							</action>
							<action type="control populate" value="parent.#grdMaster"/>
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="$NewId"/>
							</action>
							<action type="control value" value="##">
								<parameter value=""/>
							</action>
							<action type="form close"/>
							<action type="form open" value="frmUpsert"/>

						</action>
						<action if="$ServisNacinObrId!=null">
							<action type="validate"/>
							<action type="datarun nonquery" value="~dtUpsert"/>
							<action type="control populate keepfocus" value="parent.#grdMaster"/>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtLoad" command="spServisNacinObracunaCarpo">
				<parameter name="@Action" value="MASTER"/>
				<parameter name="@ID" value="$ServisNacinObrId"/>
			</data>
			<data name="dtUpsert" command="spServisNacinObracunaCarpo">
				<parameter name="@Action" value="INSERT" if="$ServisNacinObrId==null"/>
				<parameter name="@Action" value="UPDATE" if="$ServisNacinObrId!=null"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@Oznaka" value="#txtOznaka"/>
				<parameter name="@IspisiCijenu" value="#txtIspisiCijenu"/>
				<parameter name="@ID" value="$ServisNacinObrId" if="$ServisNacinObrId!=null"/>
			</data>
		</datalist>
	</form>
</root>