<root>
	<form type="master" caption="Privremeni zaključak godine" saveformsize="false">
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column size="200" position="1"/>
				</columnsdefinition>
				<item caption="Odgovorna osoba:" col="1" row="1" textalignmode="left">
					<comboedit name="cmbOdgovornaOsoba" required="True" autopopulate="true" valuefield="OsobeId" datavalue="#dtGet.@OsobeId" displayfield="Osoba" 
					dataname="~dtOdgovornaOsoba" allownull="false"/>
				</item>
				<item caption="Skladište:" row="2" col="1" textalignmode="left">
				  <combomultiedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="~dtSkladiste" showmultiselecttext="true"/>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZakljuci" caption="ZAKLJUČI" function="Zakljuci">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite napraviti privremeni zaključak godine?" />					
						<action type="datarun nonquery" value="~dtZakljuci" waittype="progress" waitcaption="Obrada" waittext="zaključak u tijeku..."/>
						<action type="message" value="Zaključak je završen!"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziOsobe" name="dtOdgovornaOsoba">
				<parameter name="@Action" value="NaseOsobe" />
			</data>
			<data command="spNG_Combo" name="dtSkladiste">
				<parameter name="@Action" value="skladiste"/>
				<parameter name="@Ind" value="1"/>
				<parameter name="@Oznaka" value="viSkladistaPrava"/>
			</data>			
			<data command="spSklad_ZakljucakGodine_Privremeni" name="dtZakljuci">
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@OsobeId" value="#cmbOdgovornaOsoba"/>
				<parameter name="@NizSkladista" value="#cmbSkladiste" type="string"/>
			</data>
		</datalist>	
	</form>
</root>