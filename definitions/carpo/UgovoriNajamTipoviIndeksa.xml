<root>
	<form name="frmGlavna" type="master" caption="Tipovi indeksa">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="dtPuniGrid" multiselect="true">
				<fields>
					<field name="Naziv" value="Naziv" />
					<field name="Aktivno" value="Aktivno" />
				</fields>
					<event type="doubleclick">
						<action type="form open" value="frmIzmjena">
							<parameter name="UgovoriNajamTipoviIndeksaId" value="#grdGlava.@UgovoriNajamTipoviIndeksaId" />
						</action>
					</event>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnos" />
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="UgovoriNajamTipoviIndeksaId" value="#grdGlava.@UgovoriNajamTipoviIndeksaId" />
						</action>
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />
						<action type="control foreachrow selected" value="#grdGlava">
							<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
			</buttons>
		</panelbuttons>	

	<datalist>
		<data command="spUgovoriNajamTipoviIndeksa" name="dtPuniGrid" />
		<data command="spUgovoriNajamTipoviIndeksa_Delete" name="dtDelete">
			<parameter name="@UgovoriNajamTipoviIndeksaId" value="#grdGlava.@UgovoriNajamTipoviIndeksaId" />
		</data>
	</datalist>

	</form>

	<form name="frmUnos" caption="Unesi">
		<layout>
			<group cols="1" rows="2" col="1" row="1">
				<item col="1" row="1" caption="Naziv">
					<textedit name="txtNaziv" value="" required="true"/>
				</item>
				<item col="1" row="2" caption="Aktivno:">
					<checkedit name="chkAktivno" value="true" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="dtInsert" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnCancel" type="cancel" caption="Odustani" dock="right" />
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipoviIndeksa_Insert" name="dtInsert">
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@Aktivno" value="#chkAktivno" />
			</data>
		</datalist>
	</form>

	<form name="frmIzmjena" caption="Izmijeni">

		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>

		<layout>
			<group cols="1" rows="2" col="1" row="1">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtGet.@naziv" required="true" />
				</item>
				<item col="1" row="2" caption="Aktivno:">
					<checkedit name="chkAktivno" datavalue="~dtGet.@Aktivno" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUpdate" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="Odustani" dock="right" />
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamTipoviIndeksa_EditQuery" name="dtGet">
				<parameter name="@UgovoriNajamTipoviIndeksaId" value="$UgovoriNajamTipoviIndeksaId" />
			</data>
			<data command="spUgovoriNajamTipoviIndeksa_Update" name="dtUpdate">
				<parameter name="@UgovoriNajamTipoviIndeksaId" value="$UgovoriNajamTipoviIndeksaId" />
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>
		</datalist>
	</form>
</root>