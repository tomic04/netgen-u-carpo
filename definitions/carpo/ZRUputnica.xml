<root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <form name="frmMaster" type="master" caption="Uputnica">
    <event type="shown">
      <action type="control disable" value="#btnBrisanje,#btnIzmjena"/>
      <action type="control enable" value="#btnIzmjena,#btnBrisanje" if="#grdMaster.@ZRUputnicaId!=null" />
    </event>
    <managerlayout>
      <lookup name="filter">
        <comboitem value="Vremenska podjela" />
        <comboitem value="Aktivni djelatnici" />
        <comboitem value="Neaktivni djelatnici" />
      </lookup>
      <tree name="tree"  allowdrop="false" expandfirst="true">
        <event type="focusedrowchanged">
          <action type="control populate" value="#grdMaster" />
        </event>

        <data if="#filter==Vremenska podjela" command="spZRUputnica_Tree" key="sortkey">
          <parameter name="@Action" value="vremenska_podjela" />
        </data>
        <data if="#filter==Aktivni djelatnici" command="spZRUputnica_Tree" key="valueid">
          <parameter name="@Action" value="abc" />
        </data>
        <data if="#filter==Neaktivni djelatnici" command="spZRUputnica_Tree" key="valueid">
          <parameter name="@Action" value="neaktivni" />
        </data>
        <fields>
          <field name="Name" />
        </fields>
      </tree>
      <!--glava grid-->
      <grid name="grdMaster" autopopulate="true" type="master" async="true" bestfitonrefresh="true" key="ZRUputnicaId"  multiselect="true" showfooter="false" fieldsmartspaces="false">
        <event type="focusedrowchanged">
          <action type="control disable" value="#btnBrisanje,#btnIzmjena,#btnPrint"/>
          <action type="control enable" value="#btnIzmjena,#btnPrint,#btnBrisanje" if="#grdMaster.@ZRUputnicaId!=null" />
        </event>

        <data command="spZRUputnica_Query" name="master_vr" if="#filter==Vremenska podjela" >
          <parameter name="@Action" value="master"  />
          <parameter name="@godina" value="#tree.@godina" />
          <parameter name="@mjesec" value="#tree.@mjesec" />
        </data>

        <data command="spZRUputnica_Query" name="master_ak" if="#filter==Aktivni djelatnici" >
          <parameter name="@Action" value="master"  />
          <parameter name="@valueid" value="#tree.@valueid" />
        </data>

        <data command="spZRUputnica_Query" name="master_neak" if="#filter==Neaktivni djelatnici" >
          <parameter name="@Action" value="master"  />
          <parameter name="@valueid" value="#tree.@valueid" />
        </data>

      </grid>
    </managerlayout>

    <panelbuttons>
      <buttons>
        <!-- KONTROLA: BUTTON -->
        <button name="btnUnos" caption="Unos" type="add" displayfield="Opis" dataname="">
          <event type="click">
            <action type="variable value" value="$ZRUputnicaId" >
              <parameter value="#grdMaster.@ZRUputnicaId" type="int" />
            </action>
            <action type="form open" value="frmUnos" >
              <parameter name="ZRUputnicaId" value="null" type="int" />
            </action>
            <action type="control populate" value="#grdMaster" >
              <action type="control focus" value="#grdMaster" >
                <parameter value="$ZRUputnicaId" />
              </action>
            </action>
            <action type="control populate" value="#tree" />
          </event>
        </button>

        <button name="btnIzmjena" caption="Izmjena" type="add" displayfield="Opis" dataname="">
          <event type="click">
            <action type="form open" value="frmUnos" >
              <parameter name="ZRUputnicaId" value="#grdMaster.@ZRUputnicaId" type="int" />
            </action>
            <action type="control populate keepfocus" value="#grdMaster" />
            <action type="control populate" value="#tree" />
          </event>
        </button>


        <button name="btnBrisanje" caption="Brisanje" type="del" displayfield="Opis" dataname="">
          <event type="click">
            <action type="confirm" value="Želite li obrisati uputnicu {#grdMaster.@Naziv}?">
              <action type="datarun nonquery" value="~dtDelete">
                <action type="control populate" value="#grdMaster" >
                  <action type="control focus" value="#grdMaster" >
                  </action>
                </action>

              </action>
            </action>
            <action type="control populate" value="#tree" />
          </event>
        </button>

        <button name="btnPrint" caption="ISPIŠI" >
          <event type="click">
            <!-- <action type="message" value="#grdMaster.@HRKadroviLijecnickiId"/> -->
            <action type="control print" value="#grdMaster">
              <action type="print template" value="repx:rptZRUputnica_Ispis">
                <parameter name="action" value="1" />
                <parameter name="ZRUputnicaId" value="#grdMaster.@ZRUputnicaId" />
                <!-- <parameter name="id" value="1" /> -->
              </action>
            </action>
          </event>
        </button>

      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spZRUputnica_Azur" name="dtDelete">
        <parameter name="@Action" value="brisanje" type="string"/>
        <parameter name="@ZRUputnicaId" value="#grdMaster.@ZRUputnicaId" type="int"/>
      </data>

    </datalist>

  </form>


  <form name="frmUnos" caption="Uputnica" maxsize="false" width="600" fixedsize="false" saveformlayout="true">
    <!-- na inicijalizaciji forme okidaju se podaci potrebni da kontrole poprime vrijednosti za izmijenu (u slučaju da smo na formi za izmijenu - IF)-->
    <event type="init">
      <action type="variable value">
        <parameter name="HRKadroviId" value="0" type="int"/>
      </action>
      <action type="datarun reader" value="~dtGet" if="$ZRUputnicaId!=null"/>
      <action type="datarun reader" value="~dtInit" else=""/>

      <action type="variable value" value="$HRKadroviId">
        <parameter value="#dtGet.@HRKadroviId"/>
      </action>
      <!-- <action type="datarun reader" value="~dtInit"/> -->
    </event>

    <event type="load">

      <!--
      <action type="control populate" value="#cmbZRVrstaPregleda"  if="$ZRUputnicaId==null" />
			<action type="control refreshvalue" value="#cmbZRVrstaPregleda" if="$ZRUputnicaId==null"/>
      -->
      <action type="control value" value="#DatumDok" if="$ZRUputnicaId==null">
        <parameter value="~dtInit.@DatumDok"/>
      </action>
    </event>

    <layout textposition="left">
      <group cols="1" rows="3" groupbordervisible="false">

        <group cols="2" rows="11" col="1" row="1" spacing="2,2,2,1" >
          <item caption="Datum dokumenta:" col="1" row="1" >
            <dateedit name="DatumDok" required="true" readonly="false" type="date" nulltext="Datum dokumenta..." datavalue="#dtGet.@DatumDok">
              <event type="valuechanged" raiseonload="false">
                <action type="control populate" value="#cmbZRUvjerenja"/>
              </event>
            </dateedit>
          </item>

          <item caption="Djelatnik:" col="1" row="2" >
            <searchedit name="srcHRKadrovi" fieldtext="Djelatnik" fieldvalue="HRKadroviId" datavalue="#dtGet.@HRKadroviId" datatext="#dtGet.@Djelatnik" required="true" dataname="dtHRKadrovi">
              <event type="valuechanged" raiseonload="false">
                <action type="variable value" value="$HRKadroviId">
                  <parameter value="#srcHRKadrovi.@HRKadroviId"/>
                </action>
                <!--<action type="datarun reader" value="~dtLoad" if="$HRKadroviId!=null"/>-->
                <action type="datarun reader" value="~dtLoad" if="#srcHRKadrovi.@HRKadroviId!=null"/>
                <action type="control populate" value="#cmbZRUvjerenja"/>

                <action type="control value" value="#cmbHRRadnaMjesta">
                  <parameter value="~dtLoad.@HRRadnaMjestaId"/>
                </action>

                <action type="control value" value="#cmbZRPredlozak">
                  <parameter value="~dtLoad.@ZRPredlozakId"/>
                </action>

              </event>
            </searchedit>
          </item>

          <item caption="Radno mjesto:" col="1" row="3" >
            <comboedit name="cmbHRRadnaMjesta" autopopulate="true" readonly="true" required="false" valuefield="HRRadnaMjestaId" displayfield="Naziv" datavalue="~dtGet.@HRRadnaMjestaId" dataname="dtHRRadnaMjesta">
