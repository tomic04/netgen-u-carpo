<!-- RADIO na Jupiter2012 - SpinPT  i spin-sql - spin -->
<root  version="1.0.0.2">
	<form name="frmMaster" type="master" caption="Povezivanje HD i PT slučajeva">

		<event type="init">
			<action type="variable value">
				<parameter name="PartneriId" value="0" type="int"/>
				<parameter name="OperateriId" value="0" type="int"/>
			</action>
			<!-- 			<action type="form open" value="frmParametri"/>

			<action type="datarun reader" value="~dtPartneri"/> -->
		</event>	

		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="HDId" async="true">

				<event type="doubleclick">
					<action type="form open"  value="frmPovezivanje" if="#grdMaster.rowcount&gt;0">
						<parameter name="HDId" value="#grdMaster.@HDId" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>				

				<fields inherited="true">
					<field name="HD br." caption="HD br." fontbold="true" />
					<field name="Tekst" caption="Tekst" fontbold="true" />
				</fields>
				<!-- 				<styles>
					<style name="fontcolor" value="red" if="#grdMaster.@PrnRNDodatniId==null" />
				</styles> -->
			</grid>	
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button caption="Parametri" >
					<event type="click">
						<action type="form open" value="frmParametri" />					
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button caption="Novi PT" >
					<event type="click">
						<action type="form open" value="frmPTUnos">
							<parameter name="HDId" value="#grdMaster.@HDId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>				
				<button name="btnPovezi" caption="Povezivanje">
					<event type="click">
						<action type="form open" value="frmPovezivanje" >
							<parameter name="HDId" value="#grdMaster.@HDId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmParametri" caption="Parametri">
		<layout>
			<group cols="1" rows="2">
				<item caption="Partner:" col="1" row="1">
					<searchedit name="srcPartneri" type="partneri" fontsizedelta="1" fieldtext="Naziv" fieldvalue="PartneriId" >
					</searchedit>
				</item>
				<item caption="Operater:" col="1" row="2" >
					<comboedit name="cmbOperater" valuefield="OperateriId" displayfield="Naziv" datavalue="Global.dtcmbOperateri.@OperateriId" dataname="Global.dtcmbOperateri" required="true"/>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOK" caption="OK">
					<event type="click">
						<action type="variable value">
							<parameter name="parent.PartneriId" value="#srcPartneri" />
							<parameter name="parent.OperateriId" value="#cmbOperater" />
						</action>
						<action type="form close"/>
						<!-- <action type="control populate keepfocus" value="parent.#grdMaster" /> -->
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">

					</event>
				</button>
			</buttons>
		</panelbuttons>		
	</form>		

	<form name="frmPTUnos" caption="Unos PT slučaja" width="450">
		<!-- !!!PROVJERITI KOJA POLJA TREBAJU BITI DISEJBLANA!!! -->
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" />
		</event>	
<!-- 		<event type="shown">
			<action type="message" value="#datRok" />
		</event>	 -->
		<layout textposition="left">
			<group cols="1" rows="12" textposition="top">
				<item caption="Naslov" col="1" row="1">
					<textedit name="txtNaslov" fontsizedelta="1" fontbold="True" datavalue="~dtGet.@Naslov">
					</textedit>		
				</item>
				<item caption="Aplikacija/Granula" col="1" row="2">
					<textedit name="txtAplikacija" fontsizedelta="1" datavalue="~dtGet.@Aplikacija" readonly="true">
					</textedit>		
				</item>	
				<item col="1" row="3" caption="Projekt">
					<textedit name="cmbProjekt" fontsizedelta="1" datavalue="~dtGet.@Projekt" readonly="true">
					</textedit>
					<!-- <comboedit name="cmbProjekt" autopopulate="true" valuefield="PtProjektId" displayfield="Naziv" datavalue="~dtGet.@PtProjektId" dataname="Global.dtProjekti" >
					</comboedit> -->
				</item>
				<item caption="Partner" col="1" row="4">
					<textedit name="txtPartner" fontsizedelta="1" datavalue="~dtGet.@Partner" readonly="true">
					</textedit>		
				</item>
				<item caption="Vlasnik" col="1" row="5">
					<textedit name="txtVlasnik" fontsizedelta="1" datavalue="~dtGet.@Otvorio" readonly="true">
					</textedit>		
				</item>				
				<item caption="Izvršitelj" col="1" row="7">
					<comboedit name="cmbIzvrsitelj" autopopulate="true" valuefield="OsobeId" displayfield="Naziv" datavalue="~dtGet.@ZaId" dataname="Global.dtOsobe" fontbold="true">
					</comboedit>				
				</item>					
				<item caption="Kategorija" col="1" row="8">
					<textedit name="txtKategorija" fontsizedelta="1"  datavalue="~dtGet.@Kategorija" readonly="true">
					</textedit>		
				</item>					
				<item caption="Prioritet" col="1" row="9">
					<textedit name="txtPrioritet" fontsizedelta="1" datavalue="~dtGet.@Prioritet" readonly="true">
					</textedit>		
				</item>					
				<item caption="Rok završetka" col="1" row="10">
					<dateedit name="datRok" fontsizedelta="1" datavalue="~dtGet.@Rok" fontbold="true">
					<!-- <dateedit name="datDatumdok" value="now"  required="true"> -->
					</dateedit>		
				</item>		
				<item caption="Vrsta utroška" col="1" row="6">
					<textedit name="txtUtrosak" fontsizedelta="1" datavalue="~dtGet.@Utrosak" readonly="true">
					</textedit>		
				</item>					
				<item caption="Vrijeme obračuna" col="1" row="11">
					<textedit name="txtVrijemeObracuna" fontsizedelta="1" datavalue="~dtGet.@Kontinuirano" readonly="true">
					</textedit>		
				</item>					
				<item caption="Način obračuna" col="1" row="12">
					<textedit name="txtNacinObracuna" fontsizedelta="1" datavalue="~dtGet.@NacinObracuna" readonly="true">
					</textedit>		
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOK" caption="OK">
					<event type="click">
						<action type="datarun nonquery" value="Global.~dtAdd"/>
						<action type="form close"/>
						<!-- <action type="control populate keepfocus" value="parent.#grdMaster" /> -->
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel">
					<event type="click">

					</event>
				</button>
			</buttons>
		</panelbuttons>		
	</form>

	<form name="frmPovezivanje" caption="Povezivanje HD: {parent.#grdMaster.@HDId} {parent.#grdMaster.@Tekst}" width="1150" height="650">
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="1">
				<item col="1" row="1" highlight="False" >
					<grid name="grdPT"  key="PtZadatakGlaId" showgrouppanel="False" showfooter="false" autopopulate="true" dataname="global.dtPT">
						<fields inherited="true">
							<field name="PT br." caption="PT br." fontbold="true" />
							<field name="PT slučaj" caption="PT slučaj" fontbold="true" />
						</fields>				
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Poveži">
					<event type="click">
						<action type="datarun nonquery" value="Global.~dtPovezi"/>
						<!-- <action type="control populate" value="parent.#grdMaster" /> -->
						<action type="form close" />					
					</event>
				</button>
				<button caption="Odustani" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<datalist>
		<data command="spHDPTPovezivanjeQuery" name="dtMaster">
			<parameter name="@Action" value="hdgrid" />
			<parameter name="@PartneriId" value="$PartneriId" type="int"/>
			<parameter name="@OperateriId" value="$OperateriId" type="int"/>
		</data>	
		<data command="spHDPTPovezivanjeQuery" name="dtcmbOperateri">
			<parameter name="@action" value="operateri"/>
		</data>	
		<data command="spHDPTPovezivanjeQuery" name="dtPT">
			<parameter name="@action" value="ptgrid" type="string"/>
			<parameter name="@PartneriId" value="parent.#grdMaster.@KlijentId" type="int"/>
		</data>			
		<data command="spHDPTPovezivanjeAzur" name="dtPovezi">
			<parameter name="@Action" value="Povezivanje"/>
			<parameter name="@HdId" value="$HDId"/>
			<parameter name="@PtZadatakGlaId" value="#grdPT.@PtZadatakGlaId"/>
		</data>
		<data command="spHDPTPovezivanjeQuery" name="dtGet">
			<parameter name="@Action" value="PRForma" type="string"/>
			<parameter name="@Id" value="$HDId"/>
		</data>			
		<data command="spHDPTPovezivanjeQuery" name="dtProjekti">
			<parameter name="@Action" value="Projekti" type="string"/>
		</data>			
		<data command="spHDPTPovezivanjeQuery" name="dtOsobe">
			<parameter name="@Action" value="Osobe" type="string"/>
		</data>	
		<data command="spHDPTPovezivanjeAzur" name="dtAdd">
			<parameter name="@Action" value="NoviPT"/>
			<parameter name="@Naziv" value="#txtNaslov"/>
			<parameter name="@PtProjektId" value="98" type="int"/>
			<parameter name="@PartneriId" value="~dtGet.@KlijentId" type="int"/>
			<parameter name="@OtvorioId" value="~dtGet.@OtvorioId" type="int"/>
			<parameter name="@NositeljId" value="#cmbIzvrsitelj" type="int"/>
			<parameter name="@VlasnikId" value="~dtGet.@OtvorioId" type="int"/>
			<parameter name="@PtZadKategorijaId" value="~dtGet.@PtZadKategorijaId" type="int"/>
			<parameter name="@PtZadPrioritetId" value="~dtGet.@PtZadPrioritetId" type="int"/>
			<parameter name="@RokZavrsetka" value="#datRok"/>
			<parameter name="@ObrKontinuirano" value="~dtGet.ObrKontinuirano"/>
			<parameter name="@PtZadNacinObracunaId" value="~dtGet.@PtZadNacinObracunaId"/>
			<parameter name="@Pocetak" value="now" type="date"/>
			<parameter name="@StatusInd" value="1"/>
			<parameter name="@PtZadUradenoId" value="1" type="int"/>
			<parameter name="@HDId" value="$HDId" type="int"/>
			<parameter name="@Postotak" value="0" />
			<parameter name="@UgovorFiksno" value="0"/>
		</data>		
	</datalist>
</root>