<root>
	<form name="frmMaster" type="master" caption="Županije">
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="ZupanijeId" savelayout="true" statusbar="true" bestfitonrefresh="true" multiselect="true">
				<event type="doubleclick">
					<action type="form open" value="frmZupanijeInsertEdit" if="#grdMaster.rowcount&gt;0">
						<parameter name="ZupanijeId" value="#grdMaster.@ZupanijeId" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>
				<fields inherited="false">
					<field caption="Županija (Provincija)" name="Naziv" />
					<field caption="Pozivni broj" name="HPTPoziv" />
					<field caption="Oznaka" name="Oznaka" />
					<field caption="Država" name="DrzaveNaziv" />
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<menuitem control="#grdMaster" sort="1" />
					<event type="click">
						<action type="form open" value="frmZupanijeInsertEdit">
							<parameter name="ZupanijeId" value="null" />
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit">
					<menuitem control="#grdMaster" sort="2" />
					<event type="click">
						<action type="form open" value="frmZupanijeInsertEdit" if="#grdMaster.rowcount&gt;0">
							<parameter name="ZupanijeId" value="#grdMaster.@ZupanijeId" />
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati označenu županiju?">
							<action type="datarun nonquery" value="global.~dtDelete" />
							<action type="control populate" value="#grdMaster" />
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
	<form name="frmZupanijeInsertEdit" caption="Odjeli">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="shown">
			<action if="$ZupanijeId!=null">
				<action type="form caption" value="Izmjena odabrane županije" />
			</action>
			<action else="">
				<action type="form caption" value="Unos nove županije" />
			</action>
		</event>
		<layout>
			<group rows="5" cols="1">
				<item row="1" col="1" caption="Naziv:" highlight="false">
					<textedit name="txtNazivZupanije" datavalue="~dtGet.@Naziv" required="true" />
				</item>
				<item row="2" col="1" caption="Pozivni broj:" highlight="false">
					<textedit name="txtPozivniBroj" datavalue="~dtGet.@HPTPoziv" required="true" maxlength="3" />
				</item>
				<item row="3" col="1" caption="Oznaka:" highlight="false">
					<textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" required="false" maxlength="4" />
				</item>
				<item row="4" col="1" caption="Država:" highlight="false">
					<comboedit name="cmbDrzava" required="true" datavalue="#dtGet.@DrzaveId" displayfield="Naziv" valuefield="DrzaveId" dataname="global.dtDrzave" />
				</item>
				<item row="5" col="1" caption="Jezik:" highlight="false">
					<comboedit name="cmbJezik" required="true" datavalue="#dtGet.@JeziciId" displayfield="Naziv" valuefield="JeziciId" dataname="global.dtJezici" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtKontrola">
							<parameter name="Greska" />
						</action>
						<action type="datarun scalar" value="~dtDataEdit" if="$ZupanijeId!=null">
							<parameter name="parent.$ZupanijeId" />
							<action type="control populate keepfocus" value="parent.#grdMaster" />
							<action type="form close" if="$Greska!=1" />
						</action>
						<action type="datarun scalar" value="~dtDataInsert" if="$ZupanijeId==null">
							<parameter name="parent.$ZupanijeId" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="parent.$ZupanijeId" type="int" />
							</action>
						</action>
						<action type="control refreshvalue" value="txtNazivZupanije" if="$Greska!=1" />
						<action type="control refreshvalue" value="txtPozivniBroj" if="$Greska!=1" />
						<action type="control refreshvalue" value="txtOznaka" if="$Greska!=1" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCZupanijeQuery" name="dtGet">
				<parameter name="@Action" value="4" />
				<parameter name="@ID" value="$ZupanijeId" />
			</data>
			<data command="spCZupanijeAzur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Naziv" value="#txtNazivZupanije" />
				<parameter name="@HptPoziv" value="#txtPozivniBroj" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@DrzaveID" value="#cmbDrzava" />
				<parameter name="@JeziciID" value="#cmbJezik" />
			</data>
			<data command="spCZupanijeAzur" name="dtDataEdit">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$ZupanijeId" />
				<parameter name="@Naziv" value="#txtNazivZupanije" />
				<parameter name="@HptPoziv" value="#txtPozivniBroj" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@DrzaveID" value="#cmbDrzava" />
				<parameter name="@JeziciID" value="#cmbJezik" />
			</data>
			<data command="spCZupanijeAzur" name="dtKontrola">
				<parameter name="@Action" value="4" />
				<parameter name="@HptPoziv" value="#txtPozivniBroj" />
			</data>
		</datalist>
	</form>
	<datalist>
		<data command="spCZupanijeQuery" name="dtMaster">
			<parameter name="@action" value="0" />
		</data>
		<data command="spCZupanijeAzur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@ID" value="#grdMaster.@ZupanijeId" />
		</data>
		<data command="spCDrzaveQuery" name="dtDrzave">
			<parameter name="@Action" value="0" />
		</data>
		<data command="spCJeziciQuery" name="dtJezici">
			<parameter name="@Action" value="0" />
		</data>
	</datalist>
</root>
