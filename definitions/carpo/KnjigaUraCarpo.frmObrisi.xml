<?xml version="1.0" encoding="utf-8"?>
<!-- OBRISI_FORM - Brisanje stavke iz Knjige URA -->
<root version="1.2">
  <form name="frmObrisi" type="custom" caption="Brisanje" width="340">
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1" caption="">
          <label name="lblPoruka" caption="Želite li doista obrisati označeni slog?"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnDa" caption="DA">
          <event type="click">
            <action type="datarun nonquery" value="~dtDelete"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnNe" caption="NE" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtDelete" command="spKntKnjigaUraAzur2NG" timeout="30">
        <parameter name="@Action" value="2"/>
        <parameter name="@ID" value="$Id"/>
      </data>
    </datalist>
  </form>
</root>
