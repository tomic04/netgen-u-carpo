<root version="1.0">
  <!--
  Komentari:
  20.08.2021. Ivan Šperanda - kreirao granulu ver 1.0.
  -->
  
  <!--
  *******************************************************************************************
  POČETNA FORMA
  *******************************************************************************************
  -->
  <form name="frmPocetna" caption="Smjene" width="1200" height="650" fixedsize="false" saveformsize="false" showversion="true" version="1.0" >
    <event type="init">
      <action type="datarun reader" value="~dtGrid" />
    </event>

    <event type="load">
      <action type="control populate" value="#grdGrid" >     </action>
	  <action type="control enable" value="#btnIzmjena,#btnBrisanje" if="#grdGrid.rowcount!=0"/>
	  <action type="control disable" value="#btnIzmjena,#btnBrisanje" else=""/>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdGrid" key="Dne_SmjeneId" dataname="~dtGrid" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true" savelayout="true">
          </grid>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi" begingroup="true">
          <event type="click">
            <action type="form open" value="frmUnos">
              <parameter name="caption" value="Unos"/>
              <parameter name="Id" value="0"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
          </event>
        </button>
        <button name="btnIzmjena" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmUnos">
              <parameter name="caption" value="Izmjena {#grdGrid.@Naziv}"/>
              <parameter name="Id" value="#grdGrid.@Dne_SmjeneId"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
          </event>
        </button>
        <button name="btnBrisanje" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmBrisanje">
              <parameter name="caption" value="Brisanje odabranih zapisa}"/>
              <parameter name="selectedids" value="#grdGrid.selectedids"/>
            </action>
            <action type="control populate keepfocus" value="#grdGrid"/>
			<action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdGrid==null"/>
          </event>
        </button>
		<button name="btnGore" image="top" caption="top"  imagelocation="middlecenter" begingroup="true">
			<event type="click">
				<action type="datarun reader" value="~dtGore"/>
				<action type="control refreshvalue" value="#grdGrid"/>
			</event>
		</button>
		<button name="btnDolje" image="bottom" caption="bottom"  imagelocation="middlecenter">
			<event type="click">
				<action type="datarun reader" value="~dtDolje"/>
				<action type="control refreshvalue" value="#grdGrid"/>
			</event>
		</button>
		<button name="btnFormTable" caption="Formiraj tablicu za prikaz" begingroup="true">
			<event type="click">
				<action type="datarun reader" value="~dtFormTable"/>
				<action if="$indGreske==0">
					<action type="message" value="$poruka" />
				</action>
			</event>
		</button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spERVSmjeneQuery_CP" name="dtGrid">
        <parameter name="@action" value="master"></parameter>
      </data>
	  <data command="spERVSmjeneAzur_CP" name="dtFormTable">
		  <parameter name="@action" value="tbl_za_prikaz"></parameter>
		  <parameter name="@indGreske.output.int"></parameter>
		  <parameter name="@poruka.output.string"></parameter>
	  </data>
	  <data command="spERVSmjeneAzur_CP" name="dtGore">
		  <parameter name="@action" value="smjene_gore"></parameter>
		  <parameter name="@dne_smjeneid" value="#grdGrid.@Dne_SmjeneId"></parameter>
	  </data>
	  <data command="spERVSmjeneAzur_CP" name="dtDolje">
		  <parameter name="@action" value="smjene_dolje"></parameter>
		  <parameter name="@dne_smjeneid" value="#grdGrid.@Dne_SmjeneId"></parameter>
	  </data>
    </datalist>
  </form>
  
  <!--
  *******************************************************************************************
  FORMA ZA UNOS/IZMJENU
  *******************************************************************************************
  -->

  <form name="frmUnos" caption="$caption" width="400" height="300" >
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$Id!=0" />
    </event>
    <event type="load">
      <action type="control disable" value="#btnUnos,#btnOdustani" if="$Id==null"/>
    </event>

    <layout>
      <group cols="3" rows="10" groupbordervisible="false" >
		<item caption="Dohodovna stavka" col="1" row="1" colspan="2" textposition="top" highlight="false" >
			<comboedit name="cmbDOH" valuefield="OOPStavkeId" displayfield="Naziv" dataname="dtCmbDOH" datavalue="~dtget.@oopstavkeid"/>
		</item>
        <item caption="Oznaka" col="1" row="2" textposition="top" highlight="false" >
          <textedit name="txtOznaka" datavalue="~dtget.@Oznaka" allownull="false" required="true" tooltip="Jedinstvena oznaka unutar kataloga" maxlength="10"></textedit>
        </item>
        <item caption="Naziv" col="1" row="3" colspan="2" textposition="top" highlight="false" >
          <textedit name="txtNaziv" datavalue="~dtget.@Naziv" allownull="false" required="true" maxlength="50"></textedit>
        </item>
		<item  caption="Tip smjene" col="1" row="4" colspan="2" textposition="top" highlight="false" >
			<textedit name="txtRlistTip" datavalue="~dtget.@RlistTip" maxlength="50"></textedit>
        </item>
		<item  col="1" row="5" highlight="false" >
			<checkedit caption="Radna smjena" name="chkRadna" datavalue="~dtget.@indradna" ></checkedit>
		</item>
		<item  col="1" row="5" highlight="false" >
		  <checkedit caption="Umirovljeno" name="chkUmirovljeno" datavalue="~dtget.@Umirovljeno" ></checkedit>
		</item>
		<item  col="1" row="6" highlight="false" >
			<checkedit caption="Zajednička smjena" name="chkSvi" datavalue="~dtget.@indSvi" ></checkedit>
		</item>
		<item caption="Vrijeme od:" col="1" row="7" highlight="false" textposition="left">
			<textedit name="txtVrijemeOd" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="false" datavalue="~dtGet.@VrijemeOd" required="true">
			</textedit>
		</item>
		<item caption="Vrijeme do:" col="2" row="7" highlight="false" textposition="left" >
			<textedit name="txtVrijemeDo" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="false" datavalue="~dtGet.@VrijemeDo" required="true">
			</textedit>
		</item>
		<item caption="" col="3" row="7" highlight="false" textposition="left" >
		</item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$Id==0">
              <action type="datarun reader" value="~dtUnos">
			  <action type="control populate" value="parent.#grdGrid">
			  <action type="control focus" value="parent.#grdGrid">
			  <parameter value="~dtUnos.@noviID"/>
			  </action>
			  </action>
			  <action type="control enable" value="parent.#btnIzmjena,parent.#btnBrisanje"/>
			  </action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
            </action>
            <action if="$Id!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
			  <action if="$indGreske==0">
				<action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
			  </action>
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spERVSmjeneQuery_CP" name="dtGet">
        <parameter name="@action" value="getUpdate"></parameter>
        <parameter name="@dne_smjeneid" value="$id"></parameter>
      </data>
      <data command="spERVSmjeneAzur_CP" name="dtUnos">
        <parameter name="@action" value="UNOS"></parameter>
		<parameter name="@dne_smjeneid" value="$noviID"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
		<parameter name="@vrijemeod" value="#txtVrijemeOd"></parameter>
		<parameter name="@vrijemedo" value="#txtVrijemeDo"></parameter>
		<parameter name="@indradna" value="#chkRadna"></parameter>
		<parameter name="@rlistTip" value="#txtRlistTip"></parameter>  
		<parameter name="@indsvi" value="#chkSvi"></parameter>
		<parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
		<parameter name="@oopstavkeid" value="#cmbDOH"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
      <data command="spERVSmjeneAzur_CP" name="dtIzmjena">
        <parameter name="@action" value="IZMJENA"></parameter>
        <parameter name="@dne_smjeneid" value="$id"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
		<parameter name="@vrijemeod" value="#txtVrijemeOd"></parameter>
		<parameter name="@vrijemedo" value="#txtVrijemeDo"></parameter>
		<parameter name="@indradna" value="#chkRadna"></parameter>
		<parameter name="@rlistTip" value="#txtRlistTip"></parameter>
		<parameter name="@indsvi" value="#chkSvi"></parameter>
		<parameter name="@oopstavkeid" value="#cmbDOH"></parameter>
        <parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
		<parameter name="@operateriid" value="@@operateriid"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
	<data command="spERVSmjeneQuery_CP" name="dtCmbDOH">
		<parameter name="@action" value="cmbOOPStavke" />
	</data>
    </datalist>
  </form>

  <!--
  *******************************************************************************************
  FORMA ZA BRISANJE
  *******************************************************************************************
  -->
  <form name="frmBrisanje" caption ="Brisanje" width="400" height="150" fixedsize="true" saveformsize="false" >
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrane zapise?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"/>
			
			<action if="$indGreske==0">
				<action type="control populate keepfocus" value="parent.#grdGrid"/>
				<action type="form close"/>
			</action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spERVSmjeneAzur_CP" name="dtBrisanje">
        <parameter name="@Action" value="BRISANJE_VISE" type="string"/>
        <parameter name="@selectedids" value="$selectedids"/>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
    </datalist>
  </form>



</root>