	<form name="frmOperater" caption="Operater"  width="600" height="700">
		<layout >
			<group cols="2" rows="2">
				<columnsdefinition>
					<column position="1" size="80%"/>
					<column position="2" size="20%"/>
				</columnsdefinition>
				<item caption="Operater:" row="1" col="1">
					<searchedit name="srcOperater" required="True" fontsizedelta="1" fontbold="True" fieldtext="Naziv" fieldvalue="OperateriId"  dataname="dtOperateri3" >
						<event type="valuechanged">
							<action type="control populate" value="#grdStatusi" if="#srcOperater!=null"/>
							<action type="control populate" value="#grdPravaOsobe" if="#srcOperater!=null"/>
						</event>
					</searchedit>
				</item>
				<item row="1" col="2" >
				  <button name="btnIzvrsi5" caption="IZVRŠI" validate="true" >
					<event type="click">
						<action type="control populate" value="#grdStatusi" if="#srcOperater!=null"/>
						<action type="control populate" value="#grdPravaOsobe" if="#srcOperater!=null"/>
					</event>
				  </button>
				</item>
				<tabs row="2" col="1" padding="4" backgroundcolor="" colspan="2">
					<group caption="Statusi" name="tabOpStatusi" cols="1" rows="1" col="1" row="1">						
						<item row="1" col="1" colspan="2" >
							<grid name="grdStatusi" key="statusiid" dataname="dtStatusi" showgroupedcolumns="true" expandallonload="true"  >
								<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtStatusOperaterDodaj" if="#grdStatusi.focusedfield==Pravo_na_status&amp;&amp;#grdStatusi.focusedvalue==True" />
									<action type="datarun nonquery" value="~dtStatusOperaterObrisi" if="#grdStatusi.focusedfield==Pravo_na_status&amp;&amp;#grdStatusi.focusedvalue==False" />
									<action type="datarun nonquery" value="~dtStatusOperaterVracanjeNovi" if="#grdStatusi.focusedfield==Vraćanje_statusa&amp;&amp;#grdStatusi.@Pravo_na_status==False&amp;&amp;#grdStatusi.@Vraćanje_statusa==True" />
									<action type="datarun nonquery" value="~dtStatusOperaterVracanje" if="#grdStatusi.focusedfield==Vraćanje_statusa&amp;&amp;#grdStatusi.@Pravo_na_status==True" />
									<action type="control populate keepfocus" value="#grdStatusi" />
								</event>
								<fields inherited="true">
									<field name="Vrsta prometa" caption="Vrsta prometa"  groupindex="0" />
									<field name="Vrsta dokumenta" caption="Vrsta dokumenta"  groupindex="1" />
									<field name="Pravo_na_status" caption="Pravo na status"  editable="true" edittype="bit"/>
									<field name="Vraćanje_statusa" caption="Vraćanje statusa"  editable="true" edittype="bit"/>
								</fields>							
							</grid>		
						</item>						
					</group>
					<group caption="Vrste dokumenata" name="tabOpVrstaDok" cols="1" rows="1" col="1" row="1">
						<item row="1" col="1">
						<grid name="grdPravaOsobe" dataname="~dtPravaOsobe" showgroupedcolumns="true" expandallonload="true">
							<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtOsobePravaDodaj" if="#grdPravaOsobe.focusedfield==Aktivno&amp;&amp;#grdPravaOsobe.focusedvalue==True" />
									<action type="datarun nonquery" value="~dtOsobePravaObrisi" if="#grdPravaOsobe.focusedfield==Aktivno&amp;&amp;#grdPravaOsobe.focusedvalue==False" />
									<action type="control populate" value="parent.#grdOsobePrava" />
								</event>	
							<fields inherited="true">
								<field name="vrstadokid" visible="false" />
								<field name="VrstaPrometa" caption="Vrsta prometa" groupindex="1" />
								<field name="VrstaDokumenta" caption="Vrsta dokumenta" />
								<field name="Aktivno" caption="Prava na vrstu dokumenta" editable="true" edittype="bit" />
							</fields>
						</grid>
						</item>
					</group>
				</tabs>
				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnKraj2" caption="ZATVORI" dock="fill">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNG_Combo" name="dtOperateri3">
				<parameter name="@Action" value="Operateri"/>
				<parameter name="@Ind" value="1"/>
				<parameter name="@oznaka" value="#srcOperater.text"/>
			</data>
			<data command="spUTP_StatusiDokumenata_PostavkeOperateraQuery"   name="dtStatusi">
				<parameter name="@ID" value="#srcOperater"/>
			</data>
			<data command="spUTP_StatusiDokumenata_Operater_Azur"   name="dtStatusOperaterDodaj">
				<parameter name="@Action" value="0"/>
				<parameter name="@OperateriId" value="#srcOperater"/>
				<parameter name="@StatusiId" value="#grdStatusi.@statusiid"/>
			</data>
			<data command="spUTP_StatusiDokumenata_Operater_Azur"   name="dtStatusOperaterObrisi">
				<parameter name="@Action" value="1"/>
				<parameter name="@OperateriId" value="#srcOperater"/>
				<parameter name="@StatusiId" value="#grdStatusi.@statusiid"/>
			</data>
			<data command="spUTP_StatusiDokumenata_Operater_Azur"   name="dtStatusOperaterVracanjeNovi">
				<parameter name="@Action" value="4"/>
				<parameter name="@OperateriId" value="#srcOperater"/>
				<parameter name="@StatusiId" value="#grdStatusi.@statusiid"/>
				<parameter name="@vracanjestatusa" value="#grdStatusi.@Vraćanje_statusa"/>
			</data>
			<data command="spUTP_StatusiDokumenata_Operater_Azur"   name="dtStatusOperaterVracanje">
				<parameter name="@Action" value="5"/>
				<parameter name="@OperateriId" value="#srcOperater"/>
				<parameter name="@StatusiId" value="#grdStatusi.@statusiid"/>
				<parameter name="@vracanjestatusa" value="#grdStatusi.@Vraćanje_statusa"/>
			</data>	
			<data command="spUTP_StatusiDokumenata_PravaOperatera_Postavke"   name="dtPravaOsobe">
				<parameter name="@OperateriID" value="#srcOperater"/>
			</data>	
			<data command="spUTP_StatusiDokumenata_PravaOperateraAdd" name="dtOsobePravaDodaj">
				<parameter name="@operateriid" value="#srcOperater" />
				<parameter name="@vrstadokid" value="#grdPravaOsobe.@vrstadokid" />
			</data>
			<data command="spUTP_StatusiDokumenata_PravaOperateraDel" name="dtOsobePravaObrisi">
				<parameter name="@operateriid" value="#srcOperater" />
				<parameter name="@vrstadokid" value="#grdPravaOsobe.@vrstadokid" />
			</data>
		</datalist>
	</form>


	
	
