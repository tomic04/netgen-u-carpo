<root version="8.0.0.2">
	<form name="frmStatus" type="master" caption="Statusi" maximized="true">
	<event type="load">
		<action type="control populate" value="#trDrvo"/>
	</event>
	<event type="shown">
		<action type="variable value" >
			<parameter name="NoviId" value="0" type="int"/>
		</action>
		<action type="variable value" >
			<parameter name="IndGumb" value="0" type="int"/>
		</action>
		<action type="variable value" >
			<parameter name="IndKvacice" value="0" type="int"/>
		</action>     			
	</event>
	<layout>
		<group rows="2" cols="2" >
			<columnsdefinition>
				<column position="1" size="20%"/>
				<column position="2" size="80%"/>
			</columnsdefinition>
			<item row="1" col="1" rowspan="2">
				<tree name="trDrvo" dataname="dtTreeData">			
					<event type="focusedrowchanged">
						<action type="control disable" value="#btnUnesi, #btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" if="#trDrvo.@Parentid==0"/>
						<action type="control enable" value="#btnUnesi, #btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" else=""/>
						<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" if="#grdMaster.rowcount==0"/>
						<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" else=""/>
						<action type="control populate" value="#grdMaster" /> 
						<action type="control populate" value="#grdOsobePrava" if="#grdMaster.rowcount!=0" />
					</event>
					<fields>
						<field name="Name"/>
					</fields>
			   </tree>
			</item>				
			<group cols="2" rows="2" col="2" row="1" rowspan="2" backgroundcolor="" groupbordervisible="true">
				<tabs row="1" col="1" padding="4" backgroundcolor="" rowspan="2">
					<group caption="Prava na statuse" name="tabStatusi" cols="1" rows="2" col="1" row="1" groupbordervisible="true">
						<rowsdefinition>
							<row position="1" size="35%"/>
							<row position="2" size="65%"/>
						</rowsdefinition> 
						<item row="1" col="2"    >
							<grid name="grdMaster" key="statusiid" dataname="dtMasterData" >								
								<event type="focusedrowchanged">
									<action type="control populate" value="#grdOperaterIma" /> 
									<action type="control populate" value="#grdOperaterNema" />
									<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" if="#grdMaster.rowcount==0" />
									<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnKopiraj, #btnOperaterDodaj" else="" />
								</event>
								<event type="doubleclick">
									<action type="form open" value="frmStatusIzmjena" if="#grdMaster.rowcount&gt;0">
										<parameter name="StId" value="#grdMaster.@statusiid" />
										<parameter name="VrDokId" value="#trDrvo.@ValueId" />
									</action>
								</event>							
								<fields >	
									<field name="Redoslijed" caption="Redoslijed" />
									<field name="Status" caption="Status" />
									<field name="Obavezan" caption="Obavezan" />
									<field name="Dokument se može mijenjati" caption="Dokument se može mijenjati" />
									<field name="Dokument je zaključen" caption="Dokument je zaključen" />
									<field name="Slijedeći statusi" caption="Slijedeći statusi" />
									<field name="Aktivan" caption="Aktivan" />
									<field name="Boja" caption="Boja" />
								</fields>							
								<styles>
									<style name="fontcolor" value="#939393" if="#grdMaster.@Aktivan==NE" />								
									<style name="fontcolor" value="#ff0000" if="#grdMaster.cellvalue==Crvena" />
									<style name="fontcolor" value="#00000" if="#grdMaster.cellvalue==Crna" />
									<style name="fontcolor" value="#BF5F04" if="#grdMaster.cellvalue==Smeđa" />
									<style name="fontcolor" value="#1e02f7" if="#grdMaster.cellvalue==Plava" />
									<style name="fontcolor" value="#256200" if="#grdMaster.cellvalue==Zelena" />
									<style name="fontcolor" value="#F130F7" if="#grdMaster.cellvalue==Ljubičasta" />
								</styles>					
							</grid>		
						</item>
						<group caption="" name="" cols="2" rows="3" col="2" row="2" groupbordervisible="false" >
							<columnsdefinition>
								<column position="1" size="50%"/>
								<column position="2" size="50%"/>
							</columnsdefinition>
							<rowsdefinition>
								<row position="3" size="50"/>
							</rowsdefinition> 
							<item row="1" col="1">
								<labeledit name="Caption1" value="Operateri koji imaju pravo" />
							</item>
							<item row="2" col="1">
								<grid name="grdOperaterIma" keyfield="opid" dataname="dtImaData" multiselect="true" showgrouppanel="false">
									<event type="cellvaluechanged">
										<action type="datarun nonquery" value="~dtUpdateEmail" if="#grdOperaterIma.focusedfield==Email" />
										<action type="datarun nonquery" value="~dtStatusOperater" if="#grdOperaterIma.focusedfield==vracanjestatusa" />
										<action type="control populate keepfocus" value="#grdOperaterIma" />
									</event>							
									<fields inherited="true">
										<field name="Operater" caption="Operater"  />
										<field name="Email" caption="Email" editable="true" />
										<field name="vracanjestatusa" caption="Vraćanje statusa"  editable="true" edittype="bit"/>
									</fields>
								</grid>		
							</item>
								<group caption="" name="" cols="4" rows="1" col="1" row="3" groupbordervisible="false" >
									<columnsdefinition>
										<column position="1" size="25%"/>
										<column position="2" size="20%"/>
										<column position="3" size="45%"/>
										<column position="4" size="10%"/>
									</columnsdefinition>
									<item row="1" col="2">
										<button name="btnSve" caption="Postavi sve kvačice">
											<event type="click">
												<action type="control caption" value="#btnSve" if="$IndKvacice==0">
												  <parameter value="Makni sve kvačice"/>
												</action>
												<action type="control caption" value="#btnSve" else="">
												  <parameter value="Postavi sve kvačice"/>
												</action>
												<action type="datarun nonquery" value="~dtStatusOperater1" />
												<action type="control populate" value="#grdOperaterIma" />
												<action type="variable value" value="$IndKvacice">
													<parameter  value="1" type="int" if="$IndKvacice==0"/>
													<parameter  value="0" type="int" else=""/>
												</action>											
											</event>
										</button>
									</item>
									<item row="1" col="4">
										<button name="btnDesno" image="right" imagelocation="middlecenter">
											<event type="click">
												<action type="control foreachrow selected" value="grdOperaterIma">
													<action type="datarun nonquery" value="dtPrebaciIma" />
												</action>
												<action type="control populate" value="#grdOperaterIma">
												</action>
												<action type="control populate" value="#grdOperaterNema">
											</action>
											</event>
										</button>
									</item>
								</group>
							<item row="1" col="2">
								<labeledit name="Caption1" value="Operateri koji nemaju pravo" />
							</item>
							<item row="2" col="2">
								<grid name="grdOperaterNema" dataname="dtNemaData" multiselect="true" showgrouppanel="false">								
									<fields inherited="true">
										<field name="opid" visible="false"  />
									</fields>
								</grid>						
							</item>
							<group caption="" name="" cols="2" rows="1" col="2" row="3" groupbordervisible="false">
								<columnsdefinition>
									<column position="1" size="10%"/>
									<column position="2" size="90%"/>
								</columnsdefinition>
								<item row="1" col="1">
									<button name="btnLijevo"  heigh="50" image="left" imagelocation="middlecenter">
										<event type="click">
											<action type="control foreachrow selected" value="grdOperaterNema">
												<action type="datarun nonquery" value="dtPrebaciNema" />
											</action>
											<action type="control populate" value="#grdOperaterIma"/>
											<action type="control populate" value="#grdOperaterNema"/>
										</event>
									</button>
								</item>
							</group>
						</group>
					</group>
					<group caption="Prava na vrste dokumenta" name="tabVrstaDok" cols="1" rows="1" col="1" row="1">
						<item col="1" row="1">
							<grid name="grdOsobePrava" valuefield="OperateriID" displayfield="Naziv" datavalue="~dtGetOsobePrava.@OperateriId" dataname="~dtGetOsobePrava" multiselect="true">
								<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtOsobePravaDodaj" if="#grdOsobePrava.focusedfield==Aktivno&amp;&amp;#grdOsobePrava.focusedvalue==True"/>
									<action type="datarun nonquery" value="~dtOsobePravaObrisi" if="#grdOsobePrava.focusedfield==Aktivno&amp;&amp;#grdOsobePrava.focusedvalue==False"/>
								</event>
									<fields>
										<field name="Aktivno" edittype="bit" editable="true"/>
										<field name="Operateriid" caption="ID" visible="false" />
										<field name="Naziv" caption="Operater" />
										<field name="Grupa" caption="Grupa operatera" />
									</fields>
									<menu>
										<menuitem caption="DODIJELI PRAVA OPERATERIMA" name="UnesiOdabrane">
											<event type="click">
												<action type="variable value">
													<parameter name="ID" value="#grdOsobePrava.selectedids" />	
												</action>
												<action type="control foreachrow selected" value="#grdOsobePrava">
												<action type="datarun nonquery" value="~dtOsobePravaDodaj"/>
												</action>
												<action type="control populate" value="#grdOsobePrava" />
											</event>
										</menuitem>	
										<menuitem caption="UKLONI PRAVA OPERATERIMA" name="UnesiOdabrane">
											<event type="click">
												<action type="variable value">
													<parameter name="ID" value="#grdOsobePrava.selectedids" />	
												</action>
												<action type="control foreachrow selected" value="#grdOsobePrava">
												<action type="datarun nonquery" value="~dtOsobePravaObrisi"/>
												</action>
												<action type="control populate" value="#grdOsobePrava" />
											</event>
										</menuitem>	
									</menu>
							</grid>
						</item>
					</group>
				</tabs>
			</group>	
		</group>
	</layout>
	<panelbuttons>
		<buttons>
			<button name="btnUnesi" caption="UNESI" >
				<event type="click">
					<action type="form open" value="frmStatusUnos" if="#trDrvo.@ValueId!=0&amp;&amp;#trDrvo.@ValueId&lt;10000" >
						<parameter name="VrDokId" value="#trDrvo.@ValueId" />
					</action>
				</event>
			</button>
			<button name="btnIzmijeni" caption="IZMJENI" type="edit">
				<event type="click">
					<action type="form open" value="frmStatusIzmjena" if="#grdMaster.rowcount&gt;0">
						<parameter name="StId" value="#grdMaster.@statusiid" />
						<parameter name="VrDokId" value="#trDrvo.@ValueId" />
					</action>
				</event>
			</button>
			<button name="btnObrisi" caption="OBRIŠI" >
				<event type="click">
					<action type="confirm" value="Želite li obrisati status?">
						<action type="datarun nonquery" value="~dtDelete" >
							<action type="control populate" value="#grdMaster" />
						</action>
					</action>
				</event>
			</button>			
			<button name="btnKopiraj" caption="KOPIRAJ" >
				<event type="click">
					<action type="form open" value="frmKopiraj">
						<parameter name="Value2Id" value="#trDrvo.@value2id" />
						<parameter name="ValId" value="#trDrvo.@ValueId" />
					</action>
				</event>
			</button>
			<button name="btnOperaterDodaj" caption="POSTAVKE ZA OPERATERA" >
				<event type="click">
					<action type="form open" value="frmOperater">						
					</action>
				</event>
			</button>
			<!-- <button name="btnHelp" caption="UPUTI ME" > -->
			<!-- </button> -->
		</buttons>
	</panelbuttons>
    <datalist>
		<data command="spUTP_StatusiDokumenata_Tree"   name="dtTreeData">
		</data>
		<data command="spUTP_StatusiDokumenata_MasterGrid"   name="dtMasterData">
			<parameter name="@node" value="#trDrvo.@ValueId"/>
		</data>
		<data command="spUTP_StatusiDokumenata_DetaljGridLijevi"   name="dtImaData">
			<parameter name="@id" value="#grdMaster.@statusiid"/>
		</data>	
		<data command="spUTP_StatusiDokumenata_DetaljGridDesni"   name="dtNemaData">
			<parameter name="@id" value="#grdMaster.@statusiid"/>
		</data>
		<data command="spUTP_StatusiDokumenata_Operater_Dodaj"   name="dtPrebaciNema">
			<parameter name="@OperateriId" value="#grdOperaterNema.@opid"/>
			<parameter name="@StatusiId" value="#grdMaster.@statusiid"/>
		</data>	
		<data command="spUTP_StatusiDokumenata_Operater_Obrisi"   name="dtPrebaciIma">
			<parameter name="@OperateriId" value="#grdOperaterIma.@opid"/>
			<parameter name="@StatusiId" value="#grdMaster.@statusiid"/>
		</data>
		<data command="spUTP_StatusiDokumenata_Detalj_Email"   name="dtUpdateEmail">
			<parameter name="@ID" value="#grdOperaterIma.@opid"/>
			<parameter name="@Email" value="#grdOperaterIma.focusedvalue" type="string"/>
		</data>
		<data command="spUTP_StatusiDokumenata_Dokument_Brisanje"   name="dtDelete">
			<parameter name="@ID" value="#grdMaster.@statusiid"/>
		</data>
		<data command="spUTP_StatusiDokumenata_Operater_VratiStatus"   name="dtStatusOperater">
			<parameter name="@StatusiOperateriid" value="#grdOperaterIma.@statusioperateriid"/>
			<parameter name="@vracanjestatusa" value="#grdOperaterIma.@vracanjestatusa"/>
		</data>
		<data command="spUTP_StatusiDokumenata_Operater_VratiStatusMulti"   name="dtStatusOperater1">
			<parameter name="@statusiid" value="#grdMaster.@statusiid"/>
			<parameter name="@vracanjestatusa" value="1" if="$IndKvacice==0" />
			<parameter name="@vracanjestatusa" value="0" else="" />
		</data>	
		<data command="spUTP_StatusiDokumenata_PravaOperatera" name="dtGetOsobePrava">
			<parameter name="@vrstadokid" value="#trDrvo.@id" />
		</data>
		<data command="spUTP_StatusiDokumenata_PravaOperateraAdd" name="dtOsobePravaDodaj">
			<parameter name="@operateriid" value="#grdOsobePrava.@operateriid" />
			<parameter name="@vrstadokid" value="#trDrvo.@id" />
		</data>
			<data command="spUTP_StatusiDokumenata_PravaOperateraDel" name="dtOsobePravaObrisi">
			<parameter name="@operateriid" value="#grdOsobePrava.@operateriid" />
			<parameter name="@vrstadokid" value="#trDrvo.@id" />
		</data>
    </datalist>
	</form>
	<form name="frmStatusUnos" caption="Unos statusa" width="450" fixedsize="true">
		<event type="init">		
			<action type="datarun reader" value="~dtBrojac" />
		</event>
		<event type="load">
			<action type="control value" value="#txtRedoslijed" >
				<parameter value="~dtBrojac.@redoslijed"/>
			</action>
			<action type="control value" value="#chkAktivan" >
				<parameter value="1"/>
			</action>
		</event>
		<layout >
			<group rows="2" cols="1" >
				<!-- <columnsdefinition> -->
					<!-- <column position="1" size="120"/> -->
				<!-- </columnsdefinition> -->
				<group caption=" " groupbordervisible="false" cols="3" rows="1" col="1" row="1"  >
					<columnsdefinition>
						<column position="1" size="80"/>
						<column position="2" size="138"/>
						<column position="3" size="120"/>
					</columnsdefinition>
					<item caption="Redoslijed:" col="1" row="1" textposition="top" >
						<textedit name="txtRedoslijed" format="n0" required="true"  />
					</item>
					<item caption="Status:" col="2" row="1" textposition="top" >
						<textedit name="txtStatus" required="true"   />
					</item>
					<item caption="Boja:" col="3" row="1" >
						<comboedit name="cmbBoja"   valuefield="Id" displayfield="Boja"  dataname="dtBoje">

						</comboedit>
					</item>
				</group>
				<group caption=" " groupbordervisible="false" cols="3" rows="5" col="1" row="2"  >
					<columnsdefinition>
						<column position="1" size="220"/>
						<column position="2" size="1"/>
						<column position="3" size="20%"/>
					</columnsdefinition>
						<rowsdefinition>
							<row position="1" size="12"/>
						</rowsdefinition>
				    <item caption="Slijedeći status:" col="1" row="1" textposition="top" rowspan="5">
					   <grid name="grdKorak"  showgrouppanel="false" showautofilterrow="false" >
					
					    </grid>
				
				     </item>
					
						<item col="3" row="2" textposition="right">
							<checkedit name="chkObavezan" caption="Obavezan"   />
						</item>
						<item  col="3" row="3" textposition="right">
							<checkedit name="chkAktivan" caption="Aktivan"  />
						</item>
						<item  col="3" row="4" textposition="right">
							<checkedit name="chkMijenjati" caption="Dokument se može mijenjati"  />
						</item>
						<item  col="3" row="5" textposition="right">
							<checkedit name="chkZakljucen" caption="Dokument je zaključen" >
								<event type="checkedchanged">
									<!-- <action type="message" value="#chkZakljucen" /> -->
									<action type="datarun reader" value="~dtGet1" if="#chkZakljucen==true" />
									<action type="control value" value="#cmbBoja" if="#chkZakljucen==true" >
										<!-- <parameter value="#256200" type="string" /> -->
										<parameter value="~dtGet1.@ID"/>
									</action>
								</event>
							</checkedit>
						</item>
				</group>
				<!-- <group caption=" " groupbordervisible="false" cols="1" rows="5" col="1" row="3" colspan="5" rowspan="5" > -->

				<!-- </group> -->
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
				<!-- validate="true"> -->
					<event type="click">
					<action type="validate"/>
						<action type="datarun scalar" value="~dtAdd">
							<parameter name="parent.$Noviid" />
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster">
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="parent.$NoviId" />
							</action>
						</action>
					</event>
				</button>

				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spUTP_StatusiDokumenata_Redoslijed"   name="dtBrojac">
				<parameter name="@node" value="$VrDokId"/>
			</data>	
			<!-- <data command="spUTP_StatusiDokumenata_Master"   name="dtStatusi"> -->
				<!-- <parameter name="@Action" value="2"/> -->
				<!-- <parameter name="@id" value="0"/> -->
			<!-- </data> -->
			<data command="spUTP_StatusiDokumenata_Dokument_Unos" name="dtAdd">
				<parameter name="@vrstadokid" value="$VrDokId"/>	
				<parameter name="@korak" value="#txtStatus"/>
				<parameter name="@redoslijed" value="#txtRedoslijed"/>
				<parameter name="@smije" value="#chkMijenjati"/>
				<parameter name="@zakljuceno" value="#chkZakljucen"/>
				<parameter name="@str" value=""/>
				<parameter name="@aktivan" value="#chkAktivan"/>
				<parameter name="@obavezan" value="#chkObavezan"/>
				<parameter name="@boja" value="#cmbBoja"/>
			</data>
			<data command="spUTP_StatusiDokumenata_Boja"   name="dtBoje">
			</data>
			<data command="select '#256200' as ID "  type="text" name="dtGet1">
				
			</data>				
		</datalist>
	</form>
	<form name="frmStatusIzmjena" caption="Izmjena statusa" width="450" fixedsize="true">
		<event type="init">		
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="~dtStatusiSelected" />
		</event>
		<event type="load">
			<action type="control populate" value="#grdKorak"/>
			<action type="control value" value="#txtRedoslijed" >
				<parameter value="~dtGet.@redoslijed"/>
			</action>
			<action type="control value" value="#txtStatus" >
				<parameter value="~dtGet.@Korak"/>
			</action>
			<action type="control value" value="#chkObavezan" >
				<parameter value="~dtGet.@obavezan"/>
			</action>
			<action type="control value" value="#chkMijenjati" >
				<parameter value="~dtGet.@smije"/>
			</action>
			<action type="control value" value="#chkAktivan" >
				<parameter value="~dtGet.@aktivan"/>
			</action>
			<action type="control value" value="#chkZakljucen" >
				<parameter value="~dtGet.@zakljuceno"/>
			</action>
			<action type="control value" value="#cmbBoja" >
				<parameter value="~dtGet.@Boja"/>
			</action>
			<!-- <action type="control selectedrows" value="#grdKorak"> -->
				<!-- <parameter value="~dtStatusiSelected.@izabrani"/> -->
			<!-- </action> -->
			<action type="control selectedrows" value="#grdKorak">
				<parameter value="~dtStatusiSelected.@izabrani"/>
			</action>
		</event>
		
		<layout >
			<group rows="2" cols="1" >
				<!-- <columnsdefinition> -->
					<!-- <column position="1" size="120"/> -->
				<!-- </columnsdefinition> -->
				<group caption=" " groupbordervisible="false" cols="3" rows="1" col="1" row="1" >
					<columnsdefinition>
						<column position="1" size="80"/>
						<column position="2" size="138"/>
						<column position="3" size="120"/>
					</columnsdefinition>
					<item caption="Redoslijed:" col="1" row="1" textposition="top" >
						<textedit name="txtRedoslijed" format="n0" required="true"   />
					</item>
