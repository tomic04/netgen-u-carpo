<root version="1.2">
  
  <!-- verzija 1.1 MZ - dodana poruka nakon spremanja datuma blokade-->
  <!-- verzija 1.2 MZ - kontrola datuma na unosu razdoblja, ispis poruke i confirm na spremi-->
  
  <form name="frmBlokada" type="master" caption="Razdoblje izvan blokade" width="600" height="150" fixedsize="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtGetRazdoblje" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="2" >
      <group cols="2" rows="1" col="1" row="1" groupbordervisible="false">
        <item caption="Datum od:" col="1" row="1" highlight="false" >
          <dateedit name="datDatumOd" datavalue="~dtGet.@DatumOd"/>
        </item>
        <item caption="Datum do:" col="2" row="1" highlight="false" >
          <dateedit name="datDatumDo" datavalue="~dtGet.@DatumDo"/>
        </item>
      </group>
      <group col="1" row="2" cols="6" rows="1" groupbordervisible="false">
        <item col="1" row="1" highlight="false" colspan="2">
          <labeledit value="Razdoblje izvan blokade od:" />
        </item>
        <item col="3" row="1" highlight="false" colspan="2" >
          <labeledit  name="lblDatumOd" datavalue="~dtGetRazdoblje.@DatumOd" fontbold="true" />
        </item>
        <item col="5" row="1" highlight="false" >
          <labeledit  value="-" />
        </item>
        <item col="6" row="1" highlight="false" colspan="2" >
          <labeledit name="lblDatumDo" datavalue="~dtGetRazdoblje.@DatumDo" fontbold="true" />
        </item>
      </group>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add" function="SpremiBlokada">
          <event type="click">
            <action type="validate"/>
            <action type="datarun reader" value="~dtKontrola"/>
            <action type="confirm" value="Da li ste sigurni da želite spremiti razdoblje?" if="~dtKontrola.@Id==0">
              <action type="datarun reader" value="~dtSpremi" />
              <action type="control value" value="#lblDatumOd" >
                <parameter value="{#datDatumOd::dd.MM.yyyy}"  />
              </action>
              <action type="control value" value="#lblDatumDo" >
                <parameter value="{#datDatumDo::dd.MM.yyyy}"  />
              </action>
              <action type="message" value="~dtSpremi.@Poruka" />
            </action>
            <action type="message" value="~dtKontrola.@Poruka" else="~dtKontrola.@Id!=0"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Izlaz" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaBlokada_CP" name="dtGetRazdoblje">
        <parameter name="@Action" value="Datum_dtGetRazdoblje" />
        <!--<parameter name="@OperateriId" value="@@OperateriId" />-->
      </data>
      <data command="spOSImovinaBlokada_CP" name="dtGet">
        <parameter name="@Action" value="Datum_dtGet" />
        <!--<parameter name="@OperateriId" value="@@OperateriId" />-->
      </data>
      <data command="spOSImovinaBlokada_CP" name="dtSpremi">
        <parameter name="@Action" value="Datum_spremi" />
        <parameter name="@DatumOd" value="#datDatumOd" />
        <parameter name="@DatumDo" value="#datDatumDo" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
      <data command="spOSImovinaBlokada_CP" name="dtKontrola">
        <parameter name="@Action" value="Kontrola_razdoblje"/>
        <parameter name="@DatumOd" value="#datDatumOd"/>
        <parameter name="@DatumDo" value="#datDatumDo"/>
      </data>
    </datalist>
  </form>


</root>