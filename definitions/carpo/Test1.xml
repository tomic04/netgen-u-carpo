<?xml version="1.0" encoding="utf-8"?>
<root >
  <form  name="frmStarter" width="300" height="300">
    <layout>
      <group cols="1" rows="1">
        <item pos="1,1">
           <button caption="&amp;Start">
             <event type="click">
               <action type="form open" value="frmTestiram"/>
               <!--<action type="datarun nonquery" value="~dtJosip"/>-->
               <!--<action type="message" value="dtJosip"/>-->
             </event>
           </button>
        </item>
      </group>
    </layout>
    <datalist>
      <data command="spognjencarpotest" name="dtJosip">
        <parameter name="@action" value="josip"/>
      </data>
    </datalist>
  </form>
  <form name="frmTestiram"  type="master" caption="Testiranje kontrola" fixedsize="true" >
    <method name="ProizvoljnoIme" dll="Carpo" class="Carpo.Gen.Start" method="Run"  />
		<layout>
		  <group cols="1" rows="3" bordervisible="false">
          <item col="1" row="1">
            <grid name="grdGrid" autopopulate="true" key="faktureid" dataname="dtGrid" showcheckboxes="true" savelayout="true" allowfilter="true">
              <fields inherited="true">
                <field name="id" visible="true" fontbold="true"/>
              </fields>
            </grid>
            <!--<comboedit name="cmbCombo" dataname="dtCombo" displayfield="dva" valuefield="Jedan"/>-->
          </item>
		  <item col="1" row="2">
			  <textedit name="txt2" format="n2" />
		  </item>
      <item col="1" row="3">
			  <textedit name="txt3" format="n2"/>
		  </item>
		  </group>
		</layout>
    <actionpanel>
      <items>
        <item>
          <button name="btnStart" caption="START" dock="left" >
            <event type="click">
              <action type="control export" value="#grdMaster">
                <parameter name="doctype" value="pdf"/> <!-- xlsx, xls, pdf, html, rtf -->
              </action>
            </event>
          </button>
        </item>
      <item>
          <button caption="DVA" dock="left" >
            <event type="click">
              <action type="control export pdf" value="#grdMaster"/>
            </event>
            
            
            <!--<action type="control datasource filter" value="#grdGrid">
                <parameter name="DatumDok" type="==" value="20160126::yyyyMMdd"/>
                <parameter name="IznosFakture" type="greaterthan" value="0" condition="and"/>
              </action>
            <action type="message" value="#grdGrid.rowcount"/>-->

          </button>
        </item>
      </items>
    </actionpanel>
    <datalist>
      <data command="spOgnjenCarpoTest" name="dtError">
        <parameter name="@action" value="spraiseerror"/>
      </data>
      <data command="select 1 as Id, 'Jedan' as Naziv
            union all
            select 2 as Id, 'Dva' as Naziv
            union all
            select 3 as Id, NULL as Naziv
            " type="text" name="dtTest"/>
      <data command="spCarpo_Combo" name="dtOrgShema">
        <parameter name="@Action" value="orgshema" />
        <parameter name="@Ind" value="1" />
        <parameter name="@ime_kontrole" value="ID" />
      </data>
      <data command="spTraziPartneri" name="dtPartneri">
			<parameter name="@Action" value="Partneri" />
			<parameter name="@Uvjet" value="#srcPartner.text" />
			<parameter name="@broj_lokacija" value="1" />
		</data>
      <data command="spOgnjenCarpoTest" name="dtCombo">
		    <parameter name="@action" value="tri"/>
	    </data>
      <!--<data command="spOgnjenCarpoTest" name="dtGrid">
        <parameter name="@action" value="toprowindex_querry"/>
      </data>-->
      <data command="spOgnjenCarpoTest" name="dtDelete">
        <parameter name="@action" value="toprowindex_delete"/>
        <parameter name="@id" value="#grdGrid.@Id"/>
      </data>
      <data command="spOgnjenCarpoTest" name="dtReset">
        <parameter name="resetaj_tablicu" />
      </data>
      <data command="select top 100 * from fakture" type="text" name="dtGrid"/>
      <data command="spTraziRoba" name="dtRoba">
        <parameter name="@action" value="Roba"/>
        <parameter name="@Uvjet" value="#srcRoba.text"/>
        <parameter name="@PokaziVPCijene" value="1"/>
        <parameter name="@PokaziNabCijene" value="1"/>
        <parameter name="@Retired" value="0"/>
        <parameter name="@Prikazi_Dodatno" value="1"/>
        <parameter name="@PokaziStanje" value="1"/>
        <parameter name="@SkladisteId" value="$SkladisteId"/>
        <parameter name="@Datum" value="$DatumDok"/>
      </data>
	    <data command="spTraziRoba" name="dtRoba1">
		    <parameter name="@action" value="Roba"/>
		    <parameter name="@Uvjet" value="#srcRoba1.text"/>
		    <parameter name="@PokaziVPCijene" value="1"/>
		    <parameter name="@PokaziNabCijene" value="1"/>
		    <parameter name="@Retired" value="0"/>
		    <parameter name="@Prikazi_Dodatno" value="1"/>
		    <parameter name="@PokaziStanje" value="1"/>
		    <parameter name="@SkladisteId" value="$SkladisteId"/>
		    <parameter name="@Datum" value="$DatumDok"/>
	    </data>
	    <data command="spTraziRoba" name="dtRoba2">
		    <parameter name="@action" value="Roba"/>
		    <parameter name="@Uvjet" value="#srcRoba2.text"/>
		    <parameter name="@PokaziVPCijene" value="1"/>
		    <parameter name="@PokaziNabCijene" value="1"/>
		    <parameter name="@Retired" value="0"/>
		    <parameter name="@Prikazi_Dodatno" value="1"/>
		    <parameter name="@PokaziStanje" value="1"/>
		    <parameter name="@SkladisteId" value="$SkladisteId"/>
		    <parameter name="@Datum" value="$DatumDok"/>
	    </data>
    </datalist>
  </form>
<form name="frmDruga">
  <layout>
    <group cols="1" rows="1">
      <item pos="1,1">
        <button>
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </item>
    </group>
  </layout>
</form>
</root>