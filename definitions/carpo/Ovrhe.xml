<root version="1.0.0.">	
	<!-- Sv dodao  za Komunalac oznakaMM,RBROvrhe,SifraPartnera-->
	<form name="frmOvrhe" caption="Ovrhe" type="master" maximized="true">
		<event type="keydown">
			<action if="key==45">
				<action if="#grdGlava.rowcount>0&amp;&amp;#grdGlava.@KntOvrheGlaId!=null">								
						<action type="form open" value="frmDodajStavku">
							<parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
							<parameter name="PartneriId" value="#grdGlava.@PartneriId"/>
						</action>						
					</action>
				</action>
			</event>
			<managerlayout>
				<lookup name="filter">
					<comboitem value="Datum ovrha"/>
					<!-- <event type="valuechanged"> -->
					<!-- <action type="control populate" value="#trDrvo"/> -->
					<!-- </event>				 -->
				</lookup>		
				<tree name="trDrvo" filtermode="smart" dataname="~dtDrvo" expandedlevel="1" autopopulate="true">
					<!-- <data command="VremenskaPodjela" type="integrated"/> -->
					<event type="focusedrowchanged">
						<action type="control populate" value="#grdGlava"/>
					</event>
					<fields>
						<field name="Name" />
					</fields>					
				</tree>
				<grid name="grdGlava" type="master" key="KntOvrheGlaId" dataname="~dtGlava" savelayout="true" multiselect="true" bestfitonrefresh="true">
					<event type="focusedrowchanged">
						<action type="control populate" value="#grdDetalj"/>
					</event>
					<event type="keydown">
						<action if="key==46">
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane ovrhe?">
								<action type="control foreachrow selected" value="#grdGlava">
									<action type="datarun nonquery" value="~dtObrisiOvrhu" if="#grdGlava.@Temeljnica==null"/>
								</action>
								<action type="control populate keepfocus" value="#grdGlava"/>
							</action>
						</action>
					</event>	
					<event type="cellvaluechanged">
						<action type="datarun nonquery" value="~dtAzuriraj"/>
						<action type="control populate keepfocus" value="#grdGlava"/>
						<!--umjesto svega u novoj verziji moguće osvježiti samo jedan red, ako bude ovo presporo-->
						<!-- <action type="control refreshrow" value="#grdDet"> -->
						<!-- <parameter value="~dtRefreshRow"/> -->
						<!-- </action> -->
					</event>
					<event type="selectionchanged">
						<action type="variable value">
							<parameter name="SelectedIds" value="#grdGlava.selectedids.table"/>
						</action>							 							 
					</event>				
					<fields inherited="true">
						<field name="BrojDok" caption="Broj dokumenta" visible="true"/>
						<field name="Naslov" visible="true"/>
						<field name="JavniBiljeznik" caption="Javni bilježnik" visible="true"/>
						<field name="Partner" caption="Partner" visible="true"/>
						<field name="DatumDokumenta" caption="Datum dokumenta" visible="true"/>
						<field name="DatumValute" caption="Datum valute" visible="true"/>
						<field name="Iznos" caption="Iznos" visible="true"/>
						<field name="Zastupnik" visible="true"/>
						<field name="Operater"/>
						<field name="Poslano" editable="true" edittype="bit"/>
						<field name="Podmireno" editable="true" edittype="bit"/>
						<field name="Napomena" editable="true"/>
						<field name="UserName" visible="false"/>
						<field name="Komp" visible="false"/>
						<field name="Temeljnica"/>
						<field name="oznakaMM" caption="Oznaka Mj. Mjesta"/>
						<field name="RBROvrhe" caption="RBR. Ovrhe"/>
						<field name="SifraPartnera" caption="Šifra Partnera"/>

					</fields>
					<styles>
						<!-- <style name="backgroundcolor" value="green" if="#grdGlava.@Poslano==true&amp;&amp;#grdGlava.fieldname==Poslano"/> -->
						<!-- <style name="backgroundcolor" value="green" if="#grdGlava.@Podmireno==true&amp;&amp;#grdGlava.fieldname==Podmireno"/> -->
						<style name="fontcolor" value="green" if="#grdGlava.@Podmireno==true&amp;&amp;#grdGlava.@Poslano==true"/>
						<style name="fontcolor" value="blue" if="#grdGlava.@Temeljnica!=null"/>
						<style name="bold" value="true" if="#grdGlava.@Podmireno==true&amp;&amp;#grdGlava.@Poslano==true"/>
					</styles>
				</grid>
				<grid name="grdDetalj" key="KntOvrheDetId" dataname="~dtDetalj" savelayout="true" multiselect="true" bestfitonrefresh="true">
					<event type="keydown">
						<action if="key==46">
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane stavke ovrhe?" if="#grdDetalj.@Konto!=UKUPNO">
								<action type="control foreachrow selected" value="#grdDetalj">
									<action type="datarun nonquery" value="~dtObrisiStavku" if="#grdGlava.@Temeljnica==null"/>
								</action>
								<action type="control populate keepfocus" value="#grdDetalj"/>
							</action>
						</action>
					</event>
					<menu>
						<menuitem name="menObrisiStavku" caption="Obriši stavku (DEL)">
							<event type="click">
								<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" if="#grdDetalj.@Konto!=UKUPNO">
									<action type="control foreachrow selected" value="#grdDetalj">
										<action type="datarun nonquery" value="~dtObrisiStavku" if="#grdGlava.@Temeljnica==null"/>
									</action>
									<action type="control populate keepfocus" value="#grdDetalj"/>
								</action>
							</event>						
						</menuitem>
					</menu>	
					<menu>
						<menuitem name="menDodajStavku" caption="Dodaj stavku (INS)">
							<event type="click">
								<action type="form open" value="frmDodajStavku" if="#grdGlava.@Temeljnica==null">
									<parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
									<parameter name="PartneriId" value="#grdGlava.@PartneriId"/>
								</action>
							</event>
						</menuitem>
					</menu>	
					<fields inherited="true">
						<field name="Konto" caption="Konto" visible="true"/>				
						<field name="Broj" caption="Broj" visible="true"/>
						<field name="Duguje" caption="Duguje" visible="true"/>
						<field name="Potrazuje" caption="Potražuje" visible="true"/>
						<field name="Saldo" caption="Saldo" visible="true"/>
						<field name="DatumDokumenta" caption="Datum dokumenta" visible="true"/>
						<field name="DatumValute" caption="Datum valute"/>
						<field name="Dana"/>
						<field name="Tablica" visible="false"/>
						<field name="IdDok" visible="false"/>
					</fields>
					<styles>
						<style name="fontcolor" value="blue" if="#grdDetalj.@Konto==UKUPNO"/>
					</styles>
				</grid>	
			</managerlayout>	
			<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="UNESI">
						<event type="click">
							<action type="form open" value="frmUnesi"/>
							<action type="control populate" value="#grdGlava">
								<action type="control focus" value="#grdGlava">
									<parameter value="$NoviId" type="int"/>
								</action>
							</action>
						</event>
					</button>
					<button name="btnIzmijeni" caption="IZMIJENI">
						<event type="click">
							<action type="form open" value="frmUnesi">
								<parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
							</action>
							<action type="control populate keepfocus" value="#grdGlava"/>
						</event>
					</button>	
					<button name="btnObrisi" caption="OBRIŠI">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane ovrhe?">
								<action type="control foreachrow selected" value="#grdGlava">
									<action type="datarun nonquery" value="~dtObrisiOvrhu" if="#grdGlava.@Temeljnica==null"/>
								</action>
								<action type="control populate keepfocus" value="#grdGlava"/>
							</action>
						</event>
					</button>
					<button name="btnProknjizi" caption="PROKNJIŽI">
						<event type="click">
							<!-- <action if="#grdGlava.@KntOvrheGlaId!=null&amp;&amp;#grdGlava.@Temeljnica==null"> -->
								<!-- <action type="form open" value="frmProknjizi"> -->
									<!-- <parameter name="PartneriId" value="#grdGlava.@PartneriId"/>  -->
									<!-- <parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/> 						 -->
								<!-- </action> -->
								<!-- <action type="control populate keepfocus" value="#grdGlava"/> -->
							<!-- </action> -->
						</event>
					</button>					
					<button name="btnTuzba" caption="TUŽBA">
						<event type="click">
							<!-- <action type="datarun nonquery" value="~dtIdIzbor"/> -->
							<!-- <action type="control print" value="#grdGlava"> -->
							<action type="print" value="repx:rptTuzba">
								<parameter name="Id" value="#grdGlava.@PartneriId"/> 
								<parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/> 
								<!-- <parameter name="NizKonto" value="#cmbKonto" type="string"/> -->
								<!-- <parameter name="DatumDo" value="#datDatumDo"/> -->
								<!-- <parameter name="DatumOd" value="#datDatumOd"/> -->
								<!-- <parameter name="tuzba" value="#grdGlava.@Tuzba"/> -->
							</action>
							<!-- </action> -->
						</event>
					</button>
					<button name="btnOvrha" caption="OVRHA" dataname="~dtPrint" displayfield="Opis">
						<event type="click">
							<!-- <action type="datarun nonquery" value="~dtIdIzbor"/> -->
							<action type="control print" value="#grdGlava">
								<action type="print template" value="#btnOvrha.@Template">
									<parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/> 
								</action>
							</action> 
							
						</event>
					</button>	
					<!-- <button name="btnIspis" caption="Ispis"> -->
						<!-- <event type="click"> -->
                        <!-- <action type="print" value="repx:rptKntOvrhaVGV">  -->
                            <!-- <parameter name="KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId" /> -->
                        <!-- </action> -->
						<!-- </event> -->
					<!-- </button> -->
					
					<button name="btnJavniBilj" caption="JAVNI BILJEŽNICI" dock="right">
						<event type="click">
							<action type="form open" value="frmJavniBilj"/>
						</event>
					</button>
				</buttons>
			</panelbuttons>
			<datalist>
				<!-- <data name="dtFindNode" command="" > -->
				<!-- <parameter name="@Action" value=""/> -->
				<!-- <parameter name="@id"  value=""/> -->
				<!-- </data>	 -->
				<!-- <data name="dtDrvo" command="VremenskaPodjela" type="integrated"> -->
				<!-- <parameter name="@Action" value="0"/> -->
				<!-- </data> -->
				<data name="dtDrvo" command="spCarpoTreeVrijemeOvrhe" key="KntOvrheGlaID"> 
					<parameter name="@jucer" value="1"/>
					<parameter name="@danas" value="1"/>
					<parameter name="@sutra" value="1"/>
					<parameter name="@tjedan" value="1"/>
					<parameter name="@tablica" value="KntOvrheGla"/>
					<parameter name="@minGodina" value="10"/>
					<parameter name="@sidro" value="0"/>
					<parameter name="@poljeDatum" value="DatumDokumenta"/>
				</data>


				<data name="dtGlava" command="spCKntOvrheQuery">
					<parameter name="@Action" value="1"/>
					<parameter name="@DatumOd" value="#trDrvo.@DatumOd"/>
					<parameter name="@DatumDo" value="#trDrvo.@DatumDo"/>
				</data>	
				<data name="dtDetalj" command="spCKntOvrheQuery">
					<parameter name="@Action" value="2"/>
					<parameter name="@KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
				</data>	
				<data name="dtObrisiOvrhu" command="spCKntOvrheAzur">
					<parameter name="@Action" value="3"/>
					<parameter name="@KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
					<parameter name="@OperateriId" value="@@OperateriId"/>
				</data>			
				<data name="dtObrisiStavku" command="spCKntOvrheAzur">
					<parameter name="@Action" value="4"/>
					<parameter name="@KntOvrheDetId" value="#grdDetalj.@KntOvrheDetId"/>
					<parameter name="@OperateriId" value="@@OperateriId"/>
				</data>	
				<data name="dtAzuriraj" command="spCKntOvrheAzur">
					<parameter name="@Action" value="5"/>
					<parameter name="@KntOvrheGlaId" value="#grdGlava.@KntOvrheGlaId"/>
					<parameter name="@OperateriId" value="@@OperateriId"/>
					<parameter name="@Poslano" value="#grdGlava.@Poslano"/>
					<parameter name="@Podmireno" value="#grdGlava.@Podmireno"/>
					<parameter name="@Napomena" value="#grdGlava.@Napomena"/>
				</data>	
				<data name="dtPrint" command="spCKntOvrheQuery">
					<parameter name="@Action" value="6" />
				</data>	
			</datalist>		
		</form>
		<form name="frmUnesi">
			<event type="init">
				<action type="datarun reader" value="~dtDohvatiPodatke" if="$KntOvrheGlaId!=null"/>
			</event>
			<event type="shown">
				<action type="control disable" value="#srcPartner" if="$KntOvrheGlaId!=null"/>
				<action type="form caption" value="Unos ovrhe" if="$KntOvrheGlaId==null"/>
				<action type="form caption" value="Izmjena ovrhe" elseif="$KntOvrheGlaId!=null"/>			
				<action if="$KntOvrheGlaId==null">
					<action type="datarun reader" value="~dtBrojac"/>
					<action type="control value" value="#txtBrojDok">
						<parameter value="~dtBrojac.@BrojDok"/>
					</action>
				</action>
			</event>		
			<layout>
				<group cols="2" rows="10" groupbordervisible="false">
					<item col="1" row="1" colspan="2" caption="Partner:">
						<searchedit name="srcPartner" savevalue="app" fieldtext="Partner" fieldvalue="PartneriId" dataname="~dtGetPartneri" datavalue="~dtDohvatiPodatke.@PartneriId" datatext="~dtDohvatiPodatke.@Partner" savelayout="true"/>
					</item>
					<item col="1" row="2" caption="Datum dokumenta:">
						<dateedit name="datDatumDokumenta" savevalue="app" datavalue="~dtDohvatiPodatke.@DatumDokumenta"/>
					</item>
					<item col="1" row="3" caption="Datum valute:">
						<dateedit name="datDatumValute" savevalue="app" datavalue="~dtDohvatiPodatke.@DatumValute"/>
					</item>				
					<item col="1" row="4" colspan="2"  caption="Broj dokumenta:">
						<textedit name="txtBrojDok" maxlength="50" datavalue="~dtDohvatiPodatke.@BrojDok"/>
					</item>
					<item col="1" row="5" colspan="2" caption="Naslov:">
						<textedit name="txtNaslov" maxlength="100" savevalue="app" datavalue="~dtDohvatiPodatke.@Naslov"/>
					</item>		
					<item col="1" row="6" colspan="2" caption="Javni bilježnik:">
						<comboedit name="cmbJavniBilj" valuefield="NSJavniBiljezniciId" displayfield="Naziv" dataname="~dtJavniBilj" savevalue="app" datavalue="~dtDohvatiPodatke.@NSJavniBiljezniciId"/>
					</item>	
					<item col="1" row="7" colspan="2" caption="Zastupnik:">
						<textedit name="txtZastupnik" maxlength="150" datavalue="~dtDohvatiPodatke.@Zastupnik" savevalue="app"/>
					</item>	
						<item col="1" row="8" colspan="2" caption="Rbr. Ovrhe:">
						<textedit name="txtRBROvrhe" maxlength="10" datavalue="~dtDohvatiPodatke.@RbrOvrhe" />
					</item>	
					<item col="1" row="9" colspan="2" caption="Broj OJB:">
						<textedit name="txtBrojOJB" maxlength="150" datavalue="~dtDohvatiPodatke.@BrojOJB" />
					</item>	
					<item col="1" row="10" colspan="2" rowspan="3" textposition="top" caption="Napomena:">
						<memoedit name="memNapomena" maxlength="500" datavalue="~dtDohvatiPodatke.@Napomena"/>
					</item>					
				</group>
			</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action if="$KntOvrheGlaId!=null">
								<action type="datarun nonquery" value="~dtSpremiGla"/>
							</action>
							<action else="">
								<action type="datarun scalar" value="~dtSpremiGlaIDet">
									<parameter name="parent.$NoviId"/>
								</action>
							</action>
							<action type="form close"/>
						</event>
					</button>	
					<button name="btnOdustani" caption="ODUSTANI">
						<event type="click">
							<action type="form close"/>
						</event>
					</button>			
				</buttons>
			</panelbuttons>
			<datalist>
				<data name="dtGetPartneri" command="spCKntTemTraziPartneri">
					<parameter name="@Action" value="Partneri" />
					<parameter name="@Uvjet" value="#srcPartner.text" />
					<parameter name="@broj_lokacija" value="1" />
				</data>	
				<data name="dtDohvatiPodatke" command="spCKntOvrheQuery">
					<parameter name="@Action" value="3"/>
					<parameter name="@KntOvrheGlaId" value="$KntOvrheGlaId"/>
				</data>	
				<data name="dtJavniBilj" command="spCKntJavniBiljQuery">
					<parameter name="@Action" value="2"/>
				</data>	
				<data name="dtSpremiGla" command="spCKntOvrheAzur">
					<parameter name="@Action" value="6"/>
					<parameter name="@PartneriId" value="#srcPartner"/>
					<parameter name="@KntOvrheGlaId" value="$KntOvrheGlaId"/>
					<parameter name="@BrojDok" value="#txtBrojDok"/>
					<parameter name="@OperateriId" value="@@OperateriId"/>
					<parameter name="@Napomena" value="#memNapomena"/>
					<parameter name="@Zastupnik" value="#txtZastupnik"/>
					<parameter name="@Naslov" value="#txtNaslov"/>
					<parameter name="@NSJavniBiljezniciId" value="#cmbJavniBilj"/>
					<parameter name="@DatumDokumenta" value="#datDatumDokumenta"/>
					<parameter name="@DatumValute" value="#datDatumValute"/>
					<parameter name="@rbrOvrhe" value="#txtRBROvrhe"/>
					<parameter name="@brojOJB" value="#txtBrojOJB"/>
					<!-- <parameter name="@Poslano" value="#grdGlava.@Poslano"/> -->
					<!-- <parameter name="@Podmireno" value="#grdGlava.@Podmireno"/> -->
				</data>	
				<data name="dtSpremiGlaIDet" command="spCKntOvrheAzur">
					<parameter name="@Action" value="1"/>
					<parameter name="@PartneriId" value="#srcPartner"/>
					<parameter name="@BrojDok" value="#txtBrojDok"/>
					<parameter name="@OperateriId" value="@@OperateriId"/>
					<parameter name="@Napomena" value="#memNapomena"/>
					<parameter name="@Zastupnik" value="#txtZastupnik"/>
					<parameter name="@Naslov" value="#txtNaslov"/>
					<parameter name="@NSJavniBiljezniciId" value="#cmbJavniBilj"/>
					<parameter name="@DatumDokumenta" value="#datDatumDokumenta"/>
					<parameter name="@DatumValute" value="#datDatumValute"/>
					<parameter name="@rbrOvrhe" value="#txtRBROvrhe"/>
					<parameter name="@brojOJB" value="#txtBrojOJB"/>
					<!-- <parameter name="@Poslano" value="#grdGlava.@Poslano"/> -->
					<!-- <parameter name="@Podmireno" value="#grdGlava.@Podmireno"/> -->
				</data>	
				<data name="dtBrojac" command="spCKntOvrheBrojac">
					<parameter name="@Datum" value="#datDatumDokumenta"/>
				</data>			
			</datalist>
		</form>
		<form name="frmJavniBilj" caption="Javni bilježnici" saveformsize="true" width="600" height="500">
			<event type="init">

			</event>
			<event type="load">
				<action type="control populate" value="#grdJavniBilj"/>
			</event>
			<event type="shown">

			</event>		
			<layout>
				<group cols="1" rows="1" groupbordervisible="false">
					<item col="1" row="1">
						<grid name="grdJavniBilj" dataname="~dtJavniBilj" searchfield="NSJavniBiljezniciId" key="NSJavniBiljezniciId" bestfitonrefresh="true" autopopulate="false" multiselect="true" savelayout="true">
							<fields inherited="true">
								<field name="Naziv" visible="false"/>
							</fields>
						</grid>
					</item>				
				</group>
			</layout>
			<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="UNESI">
						<event type="click">
							<action type="form open" value="frmJavniBiljAzur"/>
							<action type="control populate" value="#grdJavniBilj">
								<action type="control focus" value="#grdJavniBilj">
									<parameter value="$NoviJavniBilj" type="int"/>
								</action>
							</action>					
						</event>
					</button>
					<button name="btnIzmijeni" caption="IZMIJENI">
						<event type="click">
							<action type="form open" value="frmJavniBiljAzur">
								<parameter name="NSJavniBiljezniciId" value="#grdJavniBilj.@NSJavniBiljezniciId"/>
							</action>
							<action type="control populate keepfocus" value="#grdJavniBilj"/>
						</event>
					</button>
					<button name="btnObrisi" caption="OBRIŠI">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane javne bilježnike?">
								<action type="control foreachrow selected" value="#grdJavniBilj">
									<action type="datarun nonquery" value="~dtObrisiJavniBilj"/>
								</action>
								<action type="control populate keepfocus" value="#grdJavniBilj"/>
							</action>
						</event>
					</button>				
				</buttons>
			</panelbuttons> 
			<datalist>
				<data name="dtJavniBilj" command="spCKntJavniBiljQuery">
					<parameter name="@Action" value="2"/>
				</data>			
				<data name="dtObrisiJavniBilj" command="spCKntJavniBiljAzur">
					<parameter name="@Action" value="3"/>
					<parameter name="@NSJavniBiljezniciId" value="#grdJavniBilj.@NSJavniBiljezniciId"/>
				</data>			
			</datalist>
		</form>
		<form name="frmJavniBiljAzur">
			<event type="init">
				<action type="datarun reader" value="~dtDohvatiPodatke" if="$NSJavniBiljezniciId!=null"/>
			</event>
			<event type="shown">
				<action type="form caption" value="Unos javnog bilježnika" if="$NSJavniBiljezniciId==null"/>
				<action type="form caption" value="Izmjena javnog bilježnika" elseif="$NSJavniBiljezniciId!=null"/>	
			</event>		
			<layout>
				<group cols="2" rows="4" groupbordervisible="false">
					<item col="1" row="1" colspan="2" caption="Ime:">
						<textedit name="txtIme" maxlength="50" datavalue="~dtDohvatiPodatke.@Ime" required="true"/>
					</item>	
					<item col="1" row="2" colspan="2" caption="Prezime:">
						<textedit name="txtPrezime" maxlength="50" datavalue="~dtDohvatiPodatke.@Prezime" required="true"/>
					</item>	
					<item col="1" row="3" colspan="2" caption="Adresa:">
						<textedit name="txtAdresa" maxlength="50" datavalue="~dtDohvatiPodatke.@Adresa" required="true"/>
					</item>	
					<item col="1" row="4" colspan="2" caption="Mjesto:">
						<textedit name="txtMjesto" maxlength="50" datavalue="~dtDohvatiPodatke.@Mjesto" required="true"/>
					</item>					
				</group>
			</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action type="validate"/>
							<action if="$NSJavniBiljezniciId!=null">
								<action type="datarun nonquery" value="~dtSpremiJavniBilj"/>
							</action>
							<action elseif="$NSJavniBiljezniciId==null">
								<action type="datarun scalar" value="~dtSpremiJavniBilj">
									<parameter name="parent.$NoviJavniBilj" type="int"/>
								</action>
							</action>
							<action type="form close"/>
						</event>
					</button>	
					<button name="btnOdustani" caption="ODUSTANI">
						<event type="click">
							<action type="form close"/>
						</event>
					</button>				
				</buttons>
			</panelbuttons>
			<datalist>
				<data name="dtSpremiJavniBilj" command="spCKntJavniBiljAzur">
					<parameter name="@Action" value="1" if="$NSJavniBiljezniciId==null"/>
					<parameter name="@Action" value="2" elseif="$NSJavniBiljezniciId!=null"/>
					<parameter name="@NSJavniBiljezniciId" value="$NSJavniBiljezniciId" if="$NSJavniBiljezniciId!=null"/>
					<parameter name="@Ime" value="#txtIme"/>
					<parameter name="@Prezime" value="#txtPrezime"/>
					<parameter name="@Adresa" value="#txtAdresa"/>
					<parameter name="@Mjesto" value="#txtMjesto"/>
				</data>
				<data name="dtDohvatiPodatke" command="spCKntJavniBiljQuery">
					<parameter name="@Action" value="3"/>
					<parameter name="@NSJavniBiljezniciId" value="$NSJavniBiljezniciId"/>
				</data>				
			</datalist>
		</form>	
		<form name="frmDodajStavku" caption="Unos stavke na ovrhu">
			<layout>
				<group cols="1" rows="7">
					<columnsdefinition>
						<column position="1" size="100"/>
					</columnsdefinition>
					<item col="1" row="1" caption="Konto:">
						<searchedit name="srcKonto" fieldtext="Konto" required="true" fontsizedelta="1" fieldvalue="KntPlanAId" dataname="~dtGetKonto" savelayout="true">

						</searchedit>
					</item>
					<item col="1" row="2" caption="Broj:">
						<textedit name="txtBroj" required="true" length="100"/>
					</item>
					<item col="1" row="3" caption="Duguje:">
						<textedit name="txtDuguje" value="0" format="n2" required="true"/>
					</item>
					<item col="1" row="4" caption="Potrazuje:">
						<textedit name="txtPotrazuje" value="0" format="n2" required="true"/>
					</item>
					<item col="1" row="5" caption="Datum dokumenta:">
						<dateedit name="datDatumDok" value="now" savevalue="app" required="true"/>
					</item>
					<item col="1" row="6" caption="Datum valute:">
						<dateedit name="datDatumVal" value="now" savevalue="app" required="true"/>
					</item>
					<item col="1" row="7" caption="Dana:">
						<textedit name="txtDana" format="n0" required="true"/>
					</item>				
				</group>
			</layout>
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action type="validate"/>
							<action type="datarun nonquery" value="~dtDetAzur"/>
							<action type="control populate keepfocus" value="parent.#grdGlava"/>
							<action type="control refreshvalue" value="##"/>
							<action type="control focus" value="#srcKonto"/>
						</event>
					</button>
					<button name="btnOdustani" caption="ODUSTANI" dock="right">
						<event type="click">
							<action type="form close"/>
						</event>
					</button>				
				</buttons>
			</panelbuttons>
			<datalist>
				<data name="dtGetKonto" command="spCKntTemPlanAQuery">
					<parameter name="@Action" value="22"/>
					<parameter name="@Konto" value="#srcKonto.text"/>
				</data>
				<data name="dtDetAzur" command="spCKntOvrheAzur">
					<parameter name="@Action" value="2"/>
					<parameter name="@KntOvrheGlaId" value="$KntOvrheGlaId"/>
					<parameter name="@KntPlanAId" value="#srcKonto"/>
					<parameter name="@PartneriId" value="$PartneriId"/>
					<parameter name="@Broj" value="#txtBroj"/>
					<parameter name="@Duguje" value="#txtDuguje"/>
					<parameter name="@Potrazuje" value="#txtPotrazuje"/>
					<parameter name="@Tablica" value="#srcKonto.@Tablica"/>
					<parameter name="@DatumDokumenta" value="#datDatumDok"/>
					<parameter name="@DatumValute" value="#datDatumVal"/>
					<parameter name="@Dana" value="#txtDana"/>
					<parameter name="@OperateriId" value="@@operateriid"/>
				</data>			
			</datalist>
		</form>
		<form name="frmProknjizi" caption="Podaci za knjiženje">
			<layout>
				<group cols="1" rows="1" groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="70"/>
					</columnsdefinition>
					<item col="1" row="1" caption="Datum:">
						<dateedit name="datDatum" value="now" savevalue="app" required="true"/>
					</item>			
				</group>
			</layout>
			<panelbuttons>
				<buttons>
					<button name="btnProknjizi" caption="PROKNJIŽI">
						<event type="click">
							<action type="validate"/>
							<action type="datarun nonquery" value="~dtProknjizi"/>
							<action type="form close"/>
						</event>
					</button>
					<button name="btnOdustani" caption="ODUSTANI" dock="right">
						<event type="click">
							<action type="form close"/>
						</event>
					</button>				
				</buttons>
			</panelbuttons>
			<datalist>	
				<data name="dtProknjizi" command="spCKntOvrheKnjizenje">
					<parameter name="@Action" value="1"/>
					<parameter name="@KntOvrheGlaId" value="$KntOvrheGlaId"/>
					<parameter name="@OperateriId" value="@@operateriid"/>
					<parameter name="@Datum" value="#datDatum"/>
				</data>
			</datalist>
		</form>
	</root>