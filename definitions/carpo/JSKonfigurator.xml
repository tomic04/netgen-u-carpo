<?xml version="1.0" encoding="utf-8"?>
<root version="8.0.0.0">
	<form name="frmGlavna" type="master" caption="Konfigurator">
		<method name="Poziv" dll="JSKonfiguratorCarpo" class="JSKonfiguratorCarpo.frmKonfig" method="Ulaz" />
		<method name="Poziv1" dll="JSKonfiguratorCarpo" class="JSKonfiguratorCarpo.frmKopija" method="Ulaz" />
		<event type="shown">
			<action type="variable value">
				<parameter name="NoviId" value="0" type="int" />
			</action>
		</event>
		<managerlayout>
			<lookup name="filter">
				<comboitem value="Vremenska podjela" />
				<comboitem value="Organizacijska jedinica" />
				<comboitem value="Partneri" />
				<comboitem value="Operateri" />
			</lookup>
			<tree name="tree" key="Id" dataname="global.dtTree" expandallonload="true">
				<fields>
					<field name="Name" />
				</fields>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava" />
				</event>
			</tree>
			<grid name="grdGlava" type="master" dataname="global.dtGlava" bestfitonrefresh="true" keyfield="proizvodiid" key="ProizvodiId">
				<event type="doubleclick">
					<action type="form open" value="frmIzmjeniProizvod">
						<parameter name="ProizvodiId" value="#grdGlava.@ProizvodiId" />
					</action>
					<action type="control populate keepfocus" value="#grdGlava" />
				</event>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="DODAJ">
					<event type="click">
						<action type="form open" value="frmDodajProizvod">
						</action>
						<action type="datarun scalar" value="dtDatumZaTree1">
							<parameter name="DatumZaTree1" value="$DatumZaTree1" />
						</action>
						<action type="control focus" value="#tree" if="$NoviId!=0">
							<parameter value="$DatumZaTree1" />
						</action>
						<action type="control populate " value="#grdGlava" if="$NoviId!=0">
							<action type="control focus" value="#grdGlava" if="$NoviId!=0">
								<parameter value="$NoviId" />
							</action>
						</action>
						<!-- <action type="control populate keepfocus" value="#grdGlava"/> -->
					</event>
				</button>
				<button name="btnIzmjeni" caption="IZMJENI">
					<event type="click">
						<action type="form open" value="frmIzmjeniProizvod">
							<parameter name="ProizvodiId" value="#grdGlava.@ProizvodiId" />
						</action>
						<action type="control populate keepfocus" value="#grdGlava" />
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati proizvod?">
							<action type="datarun nonquery" value="global.~dtDelete" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
				<button name="btnKonfig" caption="SASTAVNICA">
					<event type="click">
						<action type="method run" value="Poziv">
							<parameter name="server" value="@@server" />
							<parameter name="database" value="@@database" />
							<parameter name="username" value="@@uid" />
							<parameter name="password" value="@@pwd" />
							<parameter name="Operateriid" value="@@operateriid" />
							<parameter name="ProizvodiId" value="#grdGlava.@ProizvodiId" />
							<parameter name="RobaId" value="#grdGlava.@RobaId" />
							<parameter name="Proizvod" value="#grdGlava.@Proizvod" />
							<parameter name="Sastavnica" value="#grdGlava.@Sastavnica" />
						</action>
					</event>
				</button>
				<button name="btnKopija" caption="KOPIJA">
					<event type="click">
						<action type="method run" value="Poziv1">
							<parameter name="server" value="@@server" />
							<parameter name="database" value="@@database" />
							<parameter name="username" value="@@uid" />
							<parameter name="password" value="@@pwd" />
							<parameter name="Operateriid" value="@@operateriid" />
							<parameter name="ProizvodiId" value="#grdGlava.@ProizvodiId" />
							<parameter name="RobaId" value="#grdGlava.@RobaId" />
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
				<button name="btnPrint" caption="ISPIŠI">
					<dropdownitem caption="Detaljna specifikacija">
						<event type="click">
							<action type="print" value="repx:rptJSKonfiguratorIspisEur">
								<parameter name="id" value="#grdGlava.@ProizvodiId" />
							</action>
						</event>
					</dropdownitem>
					<dropdownitem caption="Ispis bez cijena">
						<event type="click">
							<action type="print" value="repx:rptJSKonfiguratorIspisBezCEur">
								<parameter name="id" value="#grdGlava.@ProizvodiId" />
							</action>
						</event>
					</dropdownitem>
					<dropdownitem caption="Ispis bez cijena za ugovor">
						<event type="click">
							<action type="print" value="repx:rptJSKonfiguratorIspisUgovorBezCEur">
								<parameter name="id" value="#grdGlava.@ProizvodiId" />
							</action>
						</event>
					</dropdownitem>
					<dropdownitem caption="Ispis za ugovor">
						<event type="click">
							<action type="print" value="repx:rptJSKonfiguratorIspisUgovorEur">
								<parameter name="id" value="#grdGlava.@ProizvodiId" />
							</action>
						</event>
					</dropdownitem>
					<!-- <event type="click"> -->
					<!-- <action type="control print" value="#grdGlava"> -->
					<!-- <action type="print template" value="#btnPrint.@Template"> -->
					<!-- <parameter name="id" value="1" /> -->
					<!-- </action> -->
					<!-- </action> -->
					<!-- </event> -->
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJS_Priozvod_Ispis" name="dtPrint">
			</data>
			<data command="SELECT LEFT(CONVERT(varchar, DatumDok,112),6) as DatumZaTree from Proizvodi where ProizvodiId=@ProizvodiId" type="text" name="dtDatumZaTree1">
				<parameter name="@ProizvodiId" value="$NoviId" type="int" />
			</data>
		</datalist>
	</form>
	<form name="frmDodajProizvod" caption="Proizvod" width="350">
		<layout>
			<group cols="1" rows="6">
				<item caption="Proizvod:" col="1" row="1">
					<comboedit required="True" name="cmbProizvod" allownull="false" valuefield="RobaId" displayfield="Naziv" dataname="dtProizvodi">
						<!-- <event type="valuechanged"> -->
						<!-- <action type="control populate" value="#cmbSastavnica" /> -->
						<!-- </event> -->
					</comboedit>
				</item>
				<!-- <item caption="Sastavnica:" col="1" row="2" > -->
				<!-- <comboedit name="cmbSastavnica" required="True"  valuefield="ProizvodiId" displayfield="Sastavnica"  dataname="dtSastavnica"> -->
				<!-- </comboedit> -->
				<!-- </item> -->
				<item caption="Oznaka:" col="1" row="2">
					<textedit name="txtOznaka" />
				</item>
				<item caption="Opis:" col="1" row="3">
					<textedit name="txtOpis" />
				</item>
				<item caption="Org. shema:" row="4" col="1">
					<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="dtOrgShema" />
				</item>
				<item caption="Kupac:" row="5" col="1">
					<searchedit name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" fontbold="true" dataname="dtSearchPartner">
					</searchedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI">
					<event type="click">
						<action type="datarun reader" value="~dtProizvodInsert">
							<!-- <action type="variable value" value="$SktPromDetId"> -->
							<!-- <parameter  value="~dtSktDetInsert.@ID" type="int"/> -->
							<!-- </action> -->
							<!-- <action type="message" value="~dtProizvodInsert.@ID" /> -->
							<action type="variable value" value="parent.$NoviId">
								<parameter value="~dtProizvodInsert.@ID" type="int" />
							</action>
						</action>
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJS_Proizvod_Combo" name="dtProizvodi">
			</data>
			<data command="spJS_Sastavnica_Combo" name="dtSastavnica">
				<parameter name="@ID" value="#cmbProizvod.@RobaId" />
			</data>
			<data command="spNG_Combo" name="dtOrgShema">
				<parameter name="@Action" value="orgshema" />
				<parameter name="@Ind" value="1" />
				<parameter name="@ime_kontrole" value="ID" />
			</data>
			<data command="spTraziPartneri" name="dtSearchPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />
			</data>
			<data command="spJS_Proizvod_Insert" name="dtProizvodInsert">
				<parameter name="@RobaId " value="#cmbProizvod" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@OrgShemaId " value="#cmbOrgShema" />
				<parameter name="@PartneriId " value="#srcPartner" />
				<parameter name="@OperateriId " value="@@operateriid" />
			</data>
		</datalist>
	</form>
	<form name="frmIzmjeniProizvod" caption="Proizvod" width="350">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="shown">
			<action type="control value" value="#cmbProizvod">
				<parameter value="~dtGet.@robaid" />
			</action>
			<action type="control value" value="#txtOznaka">
				<parameter value="~dtGet.@Oznaka" />
			</action>
			<action type="control value" value="#txtOpis">
				<parameter value="~dtGet.@Opis" />
			</action>
			<action type="control value" value="#cmbOrgShema">
				<parameter value="~dtGet.@OrgShemaId" />
			</action>
			<!-- <action type="message" value="~dtGet.@Kupac" /> -->
			<action type="control value" value="#srcPartner">
				<parameter value="~dtGet.@PartneriId" text="~dtGet.@Kupac" />
			</action>
		</event>
		<layout>
			<group cols="1" rows="6">
				<item caption="Proizvod:" col="1" row="1">
					<comboedit required="True" name="cmbProizvod" allownull="false" valuefield="RobaId" displayfield="Naziv" dataname="dtProizvodi">
					</comboedit>
				</item>
				<item caption="Oznaka:" col="1" row="2">
					<textedit name="txtOznaka" />
				</item>
				<item caption="Opis:" col="1" row="3">
					<textedit name="txtOpis" />
				</item>
				<item caption="Org. shema:" row="4" col="1">
					<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="dtOrgShema" />
				</item>
				<item caption="Kupac:" row="5" col="1">
					<searchedit name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" fontbold="true" dataname="dtSearchPartner">
					</searchedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI">
					<event type="click">
						<action type="datarun reader" value="~dtProizvodUpdate">
						</action>
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJS_Proizvod_Update" name="dtProizvodUpdate">
				<parameter name="@ID " value="$ProizvodiID" />
				<parameter name="@RobaId " value="#cmbProizvod" />
				<parameter name="@Oznaka" value="#txtOznaka" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@OrgShemaId " value="#cmbOrgShema" />
				<parameter name="@PartneriId " value="#srcPartner" />
				<parameter name="@OperateriId " value="@@operateriid" />
			</data>
			<data command="spJS_Proizvod_Combo" name="dtProizvodi">
			</data>
			<data command="spJS_Sastavnica_Combo" name="dtSastavnica">
				<parameter name="@ID" value="#cmbProizvod.@RobaId" />
			</data>
			<data command="spNG_Combo" name="dtOrgShema">
				<parameter name="@Action" value="orgshema" />
				<parameter name="@Ind" value="1" />
				<parameter name="@ime_kontrole" value="ID" />
			</data>
			<data command="spTraziPartneri" name="dtSearchPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />
			</data>
			<data command="spJS_Priozvod_EditQuery" name="dtGet">
				<parameter name="@ID" value="$ProizvodiID" type="int" />
			</data>
		</datalist>
	</form>
	<datalist>
		<data command="VremenskaPodjela" type="integrated" name="dtTree" if="#filter==Vremenska podjela" />
		<data command="spJS_Tree_Partneri" name="dtTree">
			<parameter name="@Action" value="partneri" if="#filter==Partneri" />
			<parameter name="@Action" value="orgshema" if="#filter==Organizacijska jedinica" />
			<parameter name="@Action" value="operateri" if="#filter==Operateri" />
		</data>
		<data command="spJS_MasterGrid_VremenskaPodjela" name="dtGlava" if="#filter==Vremenska podjela">
			<parameter name="@DateOd" value="#tree.@DatumOd" />
			<parameter name="@DateDo" value="#tree.@DatumDo" />
		</data>
		<data command="spJS_MasterGrid_OrgShema" name="dtGlava" if="#filter==Organizacijska jedinica">
			<parameter name="@ID" value="#tree.@ID" />
		</data>
		<data command="spJS_MasterGrid_Partneri" name="dtGlava" if="#filter==Partneri">
			<parameter name="@ID" value="#tree.@ID" />
		</data>
		<data command="spJS_MasterGrid_Operateri" name="dtGlava" if="#filter==Operateri">
			<parameter name="@ID" value="#tree.@ID" />
		</data>
		<data command="spJS_Proizvod_Delete" name="dtDelete">
			<parameter name="@ID" value="#grdGlava.@ProizvodiId" type="int" />
		</data>
	</datalist>
</root>
