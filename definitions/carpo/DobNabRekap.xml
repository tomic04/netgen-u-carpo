<root>
	<form name="frmMaster" type="master" caption="Izvještaj - Rekapitulacija obračuna dobavljača" >
		<event type="onload">
			<action type="form open" value="frmUnesi">
			</action>
		</event>
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtPrikazGrida" showfooter="true">
				<fields inherited="true">
					<field name="rabat" showtotalsum="false" />
					<field name="fakturna cijena" showtotalsum="false" />
					<field name="nabavna cijena" showtotalsum="false" />
					<field name="konačna nc" showtotalsum="false" />
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="UNESI">
					<event type="click">	
						<action type="form open" value="frmUnesi" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
	<datalist>	
				<data command="spDobNakObracun" name="dtPrikazGrida">
					<parameter name="@action" value="100" />
					<parameter name="@datumod" value="#datDatumOd" />
					<parameter name="@datumdo" value="#datDatumDo" />
					<parameter name="@partneriid" value="#srcPartneri" />
					<parameter name="@Robaid" value="#srcRoba" />
					<parameter name="@KlMasterRobaID" value="#cmbKlasaRob" />
					<parameter name="@KlRobaID" value="#cmbDodatnaKlasaRob" />
				</data>
	</datalist>
	</form>

	<form name="frmUnesi" caption="Unesi">
		<layout>
			<group cols="1" rows="6" col="1" row="1">
				<item col="1" row="1" caption="Datum od:">
					<dateedit name="datDatumOd" value="now" required="true"/>
				</item>
				<item col="1" row="2" caption="Datum do:">
					<dateedit name="datDatumDo" value="now" required="true"/>
				</item>
				<item col="1" row="3" caption="Partner:">
						<searchedit name="srcPartneri" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" dataname="~dtGetPartner" function="srcPartneri" />
	            </item>
	            <item col="1" row="4" caption="Klasa robe:">
	            	<comboedit name="cmbKlasaRob" valuefield="KlMasterRobaID" displayfield="Naziv" dataname="~dtKlasaRobe" />		
	            </item>

	            <item col="1" row="5" caption="Dodatna klasa robe:">
	            	<comboedit name="cmbDodatnaKlasaRob" valuefield="KlRobaID" displayfield="Naziv" dataname="~dtDodatnaKlasa" />
	            </item>

	            <item col="1" row="6" caption="Roba:">
	            	 <searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtPuniRobu" fontbold="true" />
	            </item>
			</group>
		</layout>
				<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="PRIKAŽI">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="~dtUnosParam">

							</action>
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close">
							</action>

						</event>
					</button>
				</buttons>
			</panelbuttons>

	<datalist>
				<data command="spTraziPartneri" name="dtGetPartner">
					<parameter name="@action" value="Partneri"></parameter>
					<parameter name="@uvjet" value="#srcPartneri.text"></parameter>
				</data>

				<data command="spTraziRoba" name="dtPuniRobu">
        			<parameter name="@action" value="Roba" />
        			<parameter name="@uvjet" value="#srcRoba.text" />
      			</data>

				<data command="spDobNakObracun" name="dtUnosParam">
					<parameter name="@action" value="100" />
					<parameter name="@datumod" value="#datDatumOd" />
					<parameter name="@datumdo" value="#datDatumDo" />
					<parameter name="@partneriid" value="#srcPartneri" />
					<parameter name="@robaid" value="#srcRoba" />
					<parameter name="@KlMasterRobaID" value="#cmbKlasaRob" />
					<parameter name="@KlRobaID" value="#cmbDodatnaKlasaRob" />
				</data>

				<data command="spDobNabRekap_KlRobaQuery" name="dtKlasaRobe">
				</data>

				<data command="spDobNabRekap_DodatnaKlRobaQuery" name="dtDodatnaKlasa">
				</data>

	</datalist>
	</form>
</root>