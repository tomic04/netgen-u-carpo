<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: DMSSave1 (NetGen) → frmDMSSave (Carpo)
NetGen: ASSEMBLYLOAD(DmsNetGen.clsDmsDirekt). Carpo: method run na vanjski DLL DmsNetGen.
-->
<root version="1.2">
  <form name="frmDMSSave" caption="Dodaj dokument DMS" type="dialog" width="520" height="220" fixedsize="true">
    <method name="fnDmsDirekt" dll="DmsNetGen" class="DmsNetGen.clsDmsDirekt" method="TotalGen" />
    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <item col="1" row="1" caption="Akcija:" textposition="left">
          <textedit name="txtAkcija" value="savedms" enabled="false"/>
        </item>
        <item col="1" row="2" caption="Tablica:" textposition="left">
          <textedit name="txtTablica" value="KupSkener" enabled="false"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnDodaj" caption="DODAJ">
          <event type="click">
            <action type="method run" value="fnDmsDirekt">
              <parameter name="cs" value="@@connection"/>
              <parameter name="id" value="$Id"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

  </form>
</root>

