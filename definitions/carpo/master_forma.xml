<?xml version="1.0" encoding="utf-8"?>
<root>

	<form name="frmMjesto" type="master" caption="Mjesto" width="320">
		
		<event type="oninit">
			<action type="datarun reader" value="~datGetSingle" if="$MjestaId!=null" />
		</event>
		<event type="onshown">
			<action type="control disable" value="#cmbZupanije" if="$MjestaId==null"/>
		</event>
		
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="1">
				<group cols="2" rows="4">
					<item caption="Naziv:" row="1" col="1" colspan="2">
						<textedit name="txtMjesto" required="True" datavalue="#dtGet.@Naziv" />
					</item>
					<item caption="Poštanski broj:" row="2" col="1">
						<textedit name="txtHptBroj" required="True" datavalue="#dtGet.@HptBroj" />
					</item>
					<item caption="Pozivni broj:" row="2" col="2">
						<textedit name="txtHptPoziv" required="True" datavalue="#dtGet.@HptPoziv" />
					</item>
					<item caption="Država:" row="3" col="1" colspan="2">
						<comboedit name="cmbDrzava" valuefield="DrzaveId" displayfield="Naziv" >
							<data command="spJDrzaveUrednik">
								<parameter name="@Action" value="Drzave"/>
							</data>
							<event type="valuechanged">
								<action type="control enable" value="#cmbZupanije" if="#cmbDrzava!=null" />
								<action type="control disable" value="#cmbZupanije" else="" />
								<action type="control populate" value="#cmbZupanije" />
							</event>
						</comboedit>
					</item>
					<item caption="Županija:" row="4" col="1" colspan="2">
						<comboedit name="cmbZupanije" valuefield="ZupanijeId" displayfield="Naziv" datavalue="#dtGet.@ZupanijeId" >
							<data command="spJDrzaveUrednik">
								<parameter name="@Action" value="Zupanije"/>
								<parameter name="@DrzaveId" value="#cmbDrzava"/>
							</data>
						</comboedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtEdit" if="$MjestaId!=null"/>
						<action type="datarun nonquery" value="~dtAdd" else=""/>
						<action type="form close" if="$MjestaId!=null" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>

	</form>
</root>