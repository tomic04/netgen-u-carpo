<?xml version="1.0" encoding="utf-8"?>
<!-- Granula sa jednim gridom - podaci iz procedure SPTomicTestCarpoBot -->
<!-- Prilagodite field name/caption u gridu prema rezultatima (kolonama) vaše procedure -->
<root loglevel="3" version="1.0.0">
	<form name="frmGlavni" caption="Tomic Test CarpoBot" type="master">
		<event type="shown">
			<action type="control populate" value="#grdPodaci"/>
		</event>
		<layout>
			<group rows="1" cols="1" groupbordervisible="false" caption="Podaci">
				<item col="1" row="1" colspan="1">
					<grid name="grdPodaci" dataname="~dtPodaci" bestfitonrefresh="true" showautofilterrow="true" showgrouppanel="false">
						<fields>
							<!-- Prilagodite name/caption prema kolonama koje vraća SPTomicTestCarpoBot -->
							<field name="Id" caption="Id" minwidth="80" visible="true"/>
							<field name="Naziv" caption="Naziv" minwidth="200"/>
							<field name="Opis" caption="Opis" minwidth="250"/>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOpcije" caption="&amp;OPCIJE">
					<event type="click">
						<action type="form open" value="frmOpcije"/>
					</event>
				</button>
				<button name="btnOsvjezi" caption="&amp;OSVJEŽI">
					<event type="click">
						<action type="control populate" value="#grdPodaci"/>
					</event>
				</button>
				<button name="btnTreci" caption="&amp;TREĆI">
					<event type="click">
						<!-- Dodaj željenu akciju -->
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPodaci" command="SPTomicTestCarpoBot"/>
		</datalist>
	</form>
	<form name="frmOpcije" caption="Opcije" type="dialog">
		<event type="load">
			<action type="control value" value="#rdoOpcija1">
				<parameter value="true"/>
			</action>
		</event>
		<layout>
			<group rows="3" cols="1" groupbordervisible="false" caption="Odaberi opciju">
				<item col="1" row="1">
					<radioedit name="rdoOpcija1" caption="Opcija 1"/>
				</item>
				<item col="1" row="2">
					<radioedit name="rdoOpcija2" caption="Opcija 2"/>
				</item>
				<item col="1" row="3">
					<radioedit name="rdoOpcija3" caption="Opcija 3"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" caption="Zatvori" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>
