<root>
	<form name="frmGlava" caption="CPV nomenklatura" type="master">
		<managerlayout>
			<grid name="grdMaster" dataname="~dtCpvGrid" type="master" key="cpvkodoviid">
				<event type="doubleclick">
					<action type="form open" value="frmIzmijeni">
						<parameter name="id" value="#grdMaster.@cpvKodoviId" />
					</action>
				</event>
				<fields>
					<field name="cpvKodoviid" caption="CpvKodoviId" visible="false" />
					<field name="code" caption="CODE" width="300" />
					<field name="opis" caption="Opis" />
				</fields>
			</grid>
		</managerlayout>
	<panelbuttons>
		<buttons>
			<button name="btnUnesi" caption="&amp;UNESI">
				<event type="click">
					<action type="form open" value="frmUnos">
					</action>
				</event>
			</button>
			<button name="btnIzmjena" caption="&amp;IZMIJENI">
				<event type="click">
					<action type="form open" value="frmIzmijeni">
						<parameter name="id" value="#grdMaster.@cpvKodoviId" />
					</action>
				</event>
			</button>
			<button name="btnObrisi" caption="&amp;OBRIŠI">
				<event type="click">
					<action type="confirm" value="Želite li zaista obrisati odabranu stavku?">
					<action type="datarun nonquery" value="~dtBrisi">
						<parameter name="id" value="#grdMaster.@cpvKodoviid" />
					</action>
					<action type="control populate" value="#grdMaster" />
					</action>
				</event>
			</button>
		</buttons>
	</panelbuttons>
	<datalist>
		<data command="spNab_CpvKod_Query" name="dtCpvGrid" />
		<data command="spNab_CpvKod_Delete" name="dtBrisi">
			<parameter name="id" value="#grdMaster.@cpvKodoviid" />
		</data>
	</datalist>
	</form>
	<form name="frmUnos" caption="Unesi">
		<event type="close">
			<action type="control focus" value="parent.#grdMaster">
				<parameter value="$Id" type="int"/>
			</action>
		</event>
		<layout>
			<group cols="7" rows="1" col="1" row="1">
				<item col="1" row="1" caption="CODE:" colspan="2" >
					<textedit name="txtCode" required="true"/>
				</item>
				<item col="3" row="1" caption="Opis:" colspan="5" >
					<textedit name="txtOpis" required="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action type="validate" />
							<!-- <action type="datarun nonquery" value="~dtInsert" /> -->
							<action type="datarun scalar" value="~dtinsert">
								<parameter name="id" value="~dtInsert.@id" />
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
           						 <parameter value="$id"  type="int" />
         					 </action>
							<action type="form close" />
						</event>
					</button>
					<button name="btnIzlaz" caption="IZLAZ" type="cancel" dock="right" /> 
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_CpvKod_Insert" name="dtInsert">
				<parameter name="@code" value="#txtCode" />
				<parameter name="@opis" value="#txtOpis" />
			</data>
		</datalist>
	</form>
	<form name="frmIzmijeni" caption="Izmijeni">
		<event type="init">
			<action type="datarun reader" value="~dtEdit" />
		</event>
		<event type="close">
			<action type="control focus" value="parent.#grdMaster">
				<parameter value="parent.$Id" type="int"/>
			</action>
		</event>
		<layout>
			<group cols="7" rows="1" col="1" row="1">
				<item col="1" row="1" caption="CODE:" colspan="2" >
					<textedit name="txtCode" datavalue="~dtEdit.@code" required="true"/>
				</item>
				<item col="3" row="1" caption="Opis:" colspan="5" >
					<textedit name="txtOpis" datavalue="~dtEdit.@opis" required="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnIzmijeni" caption="IZMIJENI">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="~dtAzur" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" />
						</event>
					</button>
					<button name="btnIzlaz" caption="IZLAZ" type="cancel" dock="right" /> 
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_CpvKod_EditQuery" name="dtEdit">
				<parameter name="@id" value="$id" />
			</data>
			<data command="spNab_CpvKod_Azur" name="dtAzur">
				<parameter name="@id" value="$id" />
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@code" value="#txtCode" />
			</data>
		</datalist>
	</form>
</root>