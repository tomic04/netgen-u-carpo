<root version="1.0">

  <form name="frmDjelatnici" type="master" caption="Djelatnici"  >
    <event type="init">
      <action type="datarun reader" value="~dtOsnovnaAzur" />
      <action type="datarun reader" value="~dtPosloviRizikAzur" />
      <action type="datarun reader" value="~dtStrucnaOsposobljavanjaAzur" />
    </event>
    <managerlayout>
      <lookup name="filter" >
        <comboitem value="Abeceda"/>
        <comboitem value="Organizacijske jedinice"/>
        <event type="valuechanged">
          <action type="variable value">
            <parameter name="global.filter" value="#filter" />
          </action>
        </event>
      </lookup>
      <tree name="tree"  keyfield="id"  filtermode="smart" expandedlevel="2" dataname="dtTree">
        <event type="focusedrowchanged">
          <action type="control populate" value="#grdDjelatnici" />
        </event>
        <fields>
          <field name="Naziv" />
        </fields>
      </tree>
      <grid name="grdDjelatnici" key="HRKadroviId" type="master" async="true" dataname="dtMaster" preventfocusgroup="false" fieldsmartspaces="false" multiselect="false" bestfitonrefresh="true">
        <fields inherited="true">
          <field name="MB" caption="Matični broj" fixed="true" />
          <field name="Ime" fixed="true" />
          <field name="Prezime" fixed="true" />
        </fields>
        <event type="doubleclick">
          <action type="variable value" value="global.Djelatnik">
            <parameter value="#grdDjelatnici.@Djelatnik" />
          </action>
          <action type="form open" value="frmDjelatniciAnalitika">
            <parameter name="HRKadroviId" value="#grdDjelatnici.@HRKadroviId"/>
          </action>
        </event>
      </grid>
    </managerlayout>
    <datalist>
      <data command="spZNRDjelatnici_Tree" name="dtTree">
        <parameter name="@Action" value="Abeceda" if="global.$filter==Abeceda"/>
        <parameter name="@Action" value="OrgShema" elseif="global.$filter==Organizacijske jedinice"/>
      </data>
      <data command="spZNRDjelatnici_Query" name="dtMaster">
        <parameter name="@Action" value="Master_query"/>
        <parameter name="@OrgShemaId" if="global.$filter==Organizacijske jedinice" value="#tree.@ID" />
        <parameter name="@Tekst" if="global.$filter==Abeceda" value="#tree.@ID" />
      </data>
      <data command="spZNRDjelatnici_PodaciAzur" name="dtOsnovnaAzur">
        <parameter name="@Action" value="Unesi_obvezno"/>
      </data>
      <data command="spZNRDjelatnici_PodaciAzur" name="dtPosloviRizikAzur">
        <parameter name="@Action" value="Unesi_PosloviRizik"/>
      </data>
      <data command="spZNRDjelatnici_PodaciAzur" name="dtStrucnaOsposobljavanjaAzur">
        <parameter name="@Action" value="Unesi_StrucnaOsposobljavanja"/>
      </data>
    </datalist>
  </form>
  <form name="frmDjelatniciAnalitika" path="frmDjelatniciAnalitika.xml"/>
  <form name="frmIzmjOsnovni" path="frmIzmjOsnovni.xml"/>
  <form name="frmIzmjPosloviRizik" path="frmIzmjPosloviRizik.xml"/>
  <form name="frmIzmjStrucnaOsposobljavanja" path="frmIzmjStrucnaOsposobljavanja.xml"/>
  <form name="frmDokumentiPregled" path="frmDokumentiPregled.xml"/>
  <form name="frmAnalitikaPregled" path="frmAnalitikaPregled.xml"/>
  <form name="frmDodajPosloviRizik" path="frmDodajPosloviRizik.xml"/>
  <form name="frmDodajStrucnaOsposobljavanja" path="frmDodajStrucnaOsposobljavanja.xml"/>
  <form name="frmKreirajUputnicu" path="frmKreirajUputnicu.xml"/>
  <form name="frmPregledUputnica" path="frmPregledUputnica.xml"/>
  <form name="frmKreirajLijecnicki" path="frmKreirajLijecnicki.xml"/>
  <form name="frmDodajDokument" path="frmDodajDokument.xml"/>
</root>

