<root>
    <form type="master" caption="Povrat podataka">
        <managerlayout>
            <tree name="trTree" dataname="~dtNapuniDrvo" caption="Pronađene tablice" key="GdprTabliceId" valueid="Naziv">
                <event type="focusedrowchanged">
                    <action type="control datasourceempty" value="#grdGlava"/>
                    <action type="control populate" value="#grdGlava" />
                </event>
                <fields>
		            <field name="Naziv" />
	            </fields>
            </tree>
            <grid name="grdGlava" type="master" caption="Zaboravljene osobe" dataname="~dtZaboravljeneOsobeQuery" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false" >
            </grid>
        </managerlayout>
        <panelbuttons>
            <buttons>
                <button name="btnVratiOsobu" caption="VRATI PODATAK" width="120">
					<menuitem control="#grdGlava"/>
                    <event type="click">
                        <action type="datarun nonquery" value="~dtVratiOsobu">
							<action type="control populate" value="#grdGlava" />
						</action>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spGdprZaboraviPodatke" name="dtNapuniDrvo">
                <parameter name="@Action" value="Pretraga" />
                <parameter name="@FilterCheck" value="1" />
            </data>
            <data command="spGdprZaboraviPodatke" name="dtVratiOsobu">
                <parameter name="@Action" value="VratiPodatke"/>
                <parameter name="@GdprTabliceId" value="#trTree.@GdprTabliceId"/>
                <parameter name="@OperaterId" value="@@operateriid" />
                <parameter name="@RefId" value="#grdGlava.@Id"/>
                <parameter name="@GdprZabPodaciId" value="#grdGlava.@GdprZabPodaciId"/>
                <parameter name="@Passphrase" value="Spin!"/>
            </data>
            <data command="spGdprZaboraviPodatke" name="dtZaboravljeneOsobeQuery">
                <parameter name="@Action" value="ZaboravljeneOsobeQuery" />
                <parameter name="@GdprTabliceId" value="#trTree.@GdprTabliceId"/>
                <parameter name="@Passphrase" value="Spin!"/>
            </data>
        </datalist>
    </form>
</root>