<?xml version="1.0" encoding="utf-8"?>
<root version="8.0.0.1">
	<form name="MarAktivnostiOsobe" type="master" caption="Marketing aktivnosti - Osobe">
		<method name="Validator" dll="Valisend" class="Valisend.ComProvider" method="ValidateMail" />
		<method name="Sender" dll="Valisend" class="Valisend.ComProvider" method="SendMail" />
		<event type="init">
		</event>
		<event type="onload">
		</event>
		<managerlayout>
			<lookup name="filter">
				<comboitem value="Vremenska podjela" />
				<comboitem value="Osobe" />
			</lookup>
			<tree name="tree" filtermode="smart" key="Id">
				<data command="spMarAktivnostiTree" name="dtTree" if="#filter==Vremenska podjela">
					<parameter name="@Action" value="VremenskaPodjela" />
				</data>
				<data command="spMarAktivnostiTree" name="dtTree" if="#filter==Osobe">
					<parameter name="@Action" value="Osobe" />
				</data>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdMaster" />
				</event>
				<fields>
					<field name="Caption" />
				</fields>
			</tree>
			<grid name="grdMaster" type="master" dataname="dtMaster" bestfitonrefresh="true" keyfield="MarAktivnostiId" savelayout="true" multiselect="true">
				<fields inherited="false">
					<field name="MarAktivnostiId" visible="false" />
					<field name="Naziv" fontbold="true" caption="Naziv" />
					<field name="Klasa" caption="Klasa aktivnosti" />
					<field name="Datum" caption="Datum" />
					<field name="Osoba" caption="Osoba" />
					<field name="Opis" caption="Opis" />
					<field name="Status" caption="Status" />
					<field name="TrosakFix" caption="TrosakFix" />
					<field name="TrosakVar" caption="TrosakVar" />
					<field name="OrgShNaziv" caption="Org. shema" />
				</fields>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdDetail" />
					<action type="variable value" value="global.MarAktivnostiId">
						<parameter value="#grdMaster.@MarAktivnostiId" type="int" />
					</action>
				</event>
				<event type="doubleclick">
					<action type="form open" value="frmIzmjena">
						<!-- <parameter name="MarAktivnostiId" value="#grdMaster.@MarAktivnostiId" /> -->
						<parameter name="caption" value="Izmjena" />
					</action>
					<action type="control populate keepfocus" value="#grdMaster" />
				</event>
			</grid>
			<tabs>
				<tab caption="Detalj">
					<grid name="grdDetail" dataname="dtDet" bestfitonrefresh="true" savelayout="true">
						<fields>
							<field name="Osoba" caption="Osoba" />
							<field name="Partner" caption="Partner" />
							<field name="Datum" caption="Datum" />
							<field name="Ocjena" caption="Ocjena" />
							<field name="statusNaziv" caption="Status" />
							<field name="Mobitel" caption="Mobitel (osobni)" />
							<field name="MobitelPosl" caption="Mobitel (poslovni)" />
							<field name="email" caption="E-mail (osobni)" />
							<field name="LNemail" caption="E-mail (poslovni)" />
							<field name="PSemail" caption="Tvrtkin e-mail" />
							<field name="Napomena" caption="Napomena" />
						</fields>
						<menu>
							<menuitem caption="Izmijeni">
								<event type="click">
									<action type="form open" value="frmOsobaIzmjena">
										<parameter name="tekst" value="#grdDetail.@Osoba" />
										<parameter name="LnOsoParId" value="#grdDetail.@LnOsoParId" />
										<parameter name="OsobeId" value="#grdDetail.@OsobeId" />
									</action>
									<action type="control populate keepfocus" value="#grdDetail" />
								</event>
							</menuitem>
							<menuitem caption="Pregled slanja iz ove aktivnosti">
								<event type="click">
									<action type="form open" value="frmPregledPoslanih">
										<parameter name="MarAktDetId" value="#grdDetail.@Maraktdetid" />
										<parameter name="Osoba" value="#grdDetail.@Osoba" />
										<parameter name="Partner" value="#grdDetail.@Partner" />
										<parameter name="Indikator" value="1" />
									</action>
								</event>
							</menuitem>
							<menuitem caption="Pregled slanja iz svih aktivnosti">
								<event type="click">
									<action type="form open" value="frmPregledPoslanih">
										<parameter name="OsobeId" value="#grdDetail.@OsobeId" />
										<parameter name="PartneriId" value="#grdDetail.@PartneriId" />
										<parameter name="Osoba" value="#grdDetail.@Osoba" />
										<parameter name="Partner" value="#grdDetail.@Partner" />
										<parameter name="Indikator" value="2" />
									</action>
								</event>
							</menuitem>
						</menu>
					</grid>
				</tab>
			</tabs>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="&amp;UNESI" function="Unos">
					<event type="click">
						<action type="variable value" value="global.MarAktivnostiId">
							<parameter value="null" type="int" />
						</action>
						<action type="form open" value="frmIzmjena">
							<parameter name="caption" value="Unos" />
						</action>
						<!-- <action type="control populate keepfocus" value="#grdMaster" /> -->
						<action type="control populate" value="#grdMaster">
							<action type="control focus" value="#grdMaster">
								<parameter value="global.$MarAkrivnostiId" type="int" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="&amp;IZMIJENI" function="Izmijeni">
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="caption" value="Izmjena" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI" type="delete">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati '{#grdMaster.@Naziv}'?">
							<action type="datarun nonquery" value="~dtDelete" />
							<action type="control populate keepfocus" value="#grdMaster" />
						</action>
					</event>
				</button>
				<button name="btnKopiraj" caption="&amp;KOPIRAJ" function="Kopiraj">
					<event type="click">
						<action type="datarun nonquery" value="~dtKopiraj" />
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button name="btnPosalji" caption="&amp;POŠALJI" function="Posalji">
					<event type="click">
						<action type="form open" value="frmPosalji">
							<parameter name="MarAktivnostiId" value="#grdMaster.@MarAktivnostiId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktivnostiQuery" name="dtMaster" if="#filter==Vremenska podjela">
				<parameter name="@Action" value="0" />
				<parameter name="@drvo" value="#tree.@value" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtMaster" if="#filter==Osobe">
				<parameter name="@Action" value="10" />
				<parameter name="@DatumOd" value="#tree.@DatumOd" />
				<parameter name="@DatumDo" value="#tree.@DatumDo" />
				<parameter name="@Id" value="#tree.@ValueId" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtDet">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="#grdMaster.@MarAktivnostiId" />
			</data>
			<data command="spMarAktAzur" name="dtDelete">
				<parameter name="@Action" value="3" />
				<parameter name="@Id" value="#grdMaster.@MarAktivnostiId" />
			</data>
			<data command="spMarAktAzur" name="dtKopiraj">
				<parameter name="@Action" value="4" />
				<parameter name="@Id" value="#grdMaster.@MarAktivnostiId" />
			</data>
		</datalist>
	</form>
	<!-- REFERENCE NA FORME -->
	<form name="frmIzmjena" path="frmIzmjena.xml" />
	<form name="frmOsobaUpsert" path="frmOsobaUpsert.xml" />
	<form name="frmOsobe" path="frmOsobe.xml" />
	<form name="frmPartner" path="frmPartner.xml" />
	<form name="frmOsobaIzmjena" path="frmOsobaIzmjena.xml" />
	<form name="frmEmail" path="frmEmail.xml" />
	<form name="frmPosalji" path="frmPosalji.xml" />
	<form name="frmMarKanal" path="frmMarKanal.xml" />
	<form name="frmOdabirEmail" path="frmOdabirEmail.xml" />
	<form name="frmPregledPoslanih" path="frmPregledPoslanih.xml" />
</root>
