<root>
	<form type="master" name="UgovoriNajamGla" caption="Ugovori o najmu">
		<method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
		<method name="funDmsOpen" dll="DmsManagerV1" class="DmsManagerV1.Start" method="OpenDocument" />
		<method name="funDmsSave" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocuments" />
		<event type="init">
			<action type="variable value" value="global.ZakljucakInd">
				<parameter value="1"/>
			</action>
		</event>
		<managerlayout>
			<grid type="master" key="UgovoriNajamGlaId" name="grdGla" dataname="~dtPuniGlavu" bestfitonrefresh="true" fieldsmartspaces="true">
				<fields inherited="true">
					<field name="UgovoriNajamTipTrajanja" hidden="true"/>
					<field name="Vrsta ugovora" caption="Vrsta ugovora" />
					<field name="Tip trajanja" caption="Tip trajanja" />
					<field name="BrojProduljenja" caption="Broj produljenja" captionalign="left"/>
					<field name="TrajanjeProduljenja" caption="Trajanje produljenja" captionalign="left"/>
					<field name="DatumPotpisivanjaUgovora" caption="Datum potpisivanja ugovora" />
					<field name="DatumPocetkaVazenjaUgovora" caption="Datum početka važenja ugovora"/>
					<field name="DatumPrestankaVazenjaUgovora" caption="Datum prestanka važenja ugovora" />
					<field name="UgovorProduljenDo" caption="Ugovor produljen do" />
					<field name="ProcijenjeniDatumPrestanka" caption="Procijenjeni datum prestanka" />
					<field name="OtkazniRokTele2" caption="Otkazni rok Tele2" captionalign="left"/>
					<field name="OtkazniRokPartner" caption="Otkazni rok partner" captionalign="left"/>
					<field name="ObavijesniPeriod" caption="Obavijesni period" />
					<field name="Broj Prethodnog ugovora" caption="Broj prethodnog ugovora" />
					<field name="Broj novog ugovora" caption="Broj novog ugovora" />
					<field name="Odgovorna osoba" caption="Odgovorna osoba" />
					<field name="Ugovor za struju" caption="Ugovor za struju" />
					<field name="AneksPrethodniUgovor" caption="Aneks - prethodni ugovor" />
					<field name="AneksSlijedeciUgovor" caption="Aneks - sljedeći ugovor" />
				</fields>
				<menu name="menGlava">
					<menuitem name="mitemVratiStatus" caption="Vrati status">
						<event type="click">
							<action type="form open" value="frmPromjenaStatusa">
								<parameter name="GlaId" value="#grdGla.@UgovoriNajamGlaId"/>
								<parameter name="VratiStatusInd" value="1"/>
							</action>
							<part name="ProvjeraMogucnostiIzmjeneStatusa" path="prtProvjeriIzmjenuStatusa.xml"/>
						</event>
					</menuitem>
				</menu>
				<event type="focusedrowchanged">
				    <action type="control populate" value="#grdDms"/>
					<action type="control enable" value="#btnAneks" if="#grdGla.@Status=='Aktiviran'&amp;&amp;#grdGla.@AneksSlijedeciUgovor==null"/>
					<action type="control disable" value="#btnAneks" else=""/>
					<action type="control disable" value="#btnIzmijeni" if="#grdGla.@UgovoriNajamGlaId==null"/>
					<action type="control enable" value="#btnIzmijeni" else=""/>
					<action type="variable value" value="global.GlaId">
						<parameter value="#grdGla.@UgovoriNajamGlaId"/>
					</action>
					<action type="control populate" value="#grdDet"/>
					<part name="ProvjeraMogucnostiIzmjeneStatusa" path="prtProvjeriIzmjenuStatusa.xml"/>
				</event>
				<event type="doubleclick">
					<action type="form open" value="frmIzmjenaGla">
						<parameter name="Smije" value="$Smije"/>
						<parameter name="Zakljuceno" value="#grdGla.@Zaključeno"/>
						<parameter name="GlaId" value="#grdGla.@UgovoriNajamGlaId"/>
					</action>
				</event>
			</grid>
			<tabs name="detTabs">
				<tab name="tabStavke" caption="Stavke">
					<grid name="grdDet" dataname="~dtPuniDet">
						<fields inherited="true">
							<field name="VrstaTroska" caption="Vrsta troška" />
							<field name="UtvrdjenaImovina" caption="Utvrđena imovina" />
							<field name="IFRS16" caption="IFRS16"/>
							<field name="IdStavke" caption="Id stavke" />
							<field name="Šifra Site-a" caption="Šifra site-a"/>
							<field name="Naziv Site-a" caption="Naziv site-a"/>
							<field name="Product/CarRegistration" caption="Product/car registration" />
							<field name="DatumPrimopredaje" caption="Datum primopredaje" />
							<field name="NazivOpcije" caption="Naziv opcije" />
							<field name="Šifra opcije" caption="Šifra opcije" />
							<field name="UgovoreniIznos" caption="Ugovoreni iznos"  captionalign="left"/>
							<field name="ValutaPlaćanja" caption="Vrsta plaćanja" />
							<field name="VrstaTečaja" caption="Vrsta tečaja" />
							<field name="DatumPocetkaPlacanja" caption="Datum početka plaćanja" />
							<field name="NacinPlacanja" caption="Način plaćanja" />
							<field name="PeriodPlacanja" caption="Period plaćanja" />
							<field name="DatumSlijedeceIndeksacije" caption="Datum sljedeće indeksacije" />
							<field name="VrijednostIndeksa" caption="Vrijednost indeksa"  captionalign="left"/>
							<field name="DatumZadnjeIndeksacije" caption="Datum zadnje indeksacije" />
							<field name="PlacanjeNalogom" caption="Plaćanje nalogom" />
							<field name="DatumDospijecaSlijedecegRacuna" caption="Datum dospijeća sljedećeg računa" />
							<field name="BrojMjernogMjesta" caption="Broj mjernog mjesta" />
							<field name="BrojBrojila" caption="Broj brojila" />
							<field name="Tip plaćanja" caption="Tip plaćanja" />
							<field name="NacinObracuna" caption="Način obračuna" />
							<field name="ProstorUNajmu" caption="Prostor u najmu"  captionalign="left"/>
							<field name="BrojŠasije" caption="Broj šasije" />
							<field name="SerijskiBrojUredaja" caption="Serijski broj uređaja" />
							<field name="IznosPenala" caption="Iznos penala"  captionalign="left"/>
							<field name="PlaceniNajamPrijePocetkaVazenjaUgovora" caption="Plaćeni najam prije početka važenja ugovora"  captionalign="left"/>
							<field name="InicijalniDirektniTroskovi" caption="Inicijalni direktni troškovi"  captionalign="left"/>
							<field name="OrganizacijskaJedinica" caption="Organizacijska jedinica" />
							<field name="ProcijenjeniDatumPrestankaVazenjaUgovora" caption="Procijenjeni datum prestanka važenja ugovora" />
						</fields>
						<menu>
							<menuitem name="mitemRaspored" caption="Prikaži raspored plaćanja" group="2">
								<event type="click">
									<action type="form open" value="frmRasporedPlacanjaPregled">
										<parameter name="UgovoriNajamDetId" value="#grdDet.@UgovoriNajamDetId"/>
										<parameter name="ValuteId" value="#grdDet.@ValuteId"/>
									</action>
								</event>
							</menuitem>
						</menu>
						<event type="focusedrowchanged">
							<action type="menu disable" value="#mitemRaspored" if="#grdDet.@PeriodPlacanja!='nepravilno'"/>
							<action type="menu enable" value="#mitemRaspored" else=""/>
						</event>
					</grid>
				</tab>
				<tab caption="DMS">
					<grid name="grdDms" keyfield="DokID" multiselect="true" dataname="dtDms" showmenuprintitem="false" showmenutools="false" savelayout="true">
						<menu>
							<menuitem caption="Pogledaj">
								<event type="click">
									<action type="method run" value="funDmsOpen" >
										<parameter name="server" value="@@server" />
										<parameter name="database" value="@@database" />
										<parameter name="username" value="" />
										<parameter name="password" value="" />
										<parameter name="operateriid" value="@@operateriid" />
										<parameter name="dokID" value="#grdDms.@DokID" />
										<parameter name="name" value="#grdDms.@naziv" />
									</action>
								</event>
							</menuitem>
							<menuitem caption="Spremi na disk">
								<event type="click">
									<action type="method run" value="funDmsSave">
										<parameter name="server" value="@@server" />
										<parameter name="database" value="@@database" />
										<parameter name="username" value="" />
										<parameter name="password" value="" />
										<parameter name="operaterid" value="@@operateriid" />
										<parameter name="dokIDs" value="#grdDms.selectedids" />
									</action>
								</event>
							</menuitem>
							<menuitem caption="Obriši" function="dmsObrisi">
								<event type="click">
									<action type="confirm" value="Želite li sigurno obrisati označeni(e) dokument(e)?">
										<action type="datarun nonquery" value="~dtDeleteDoc" />
										<action type="control populate" value="#grdDms" />
									</action>
								</event>
							</menuitem>
						</menu>
						<event type="doubleclick">
							<action type="method run" value="funDmsOpen" >
								<parameter name="server" value="@@server" />
								<parameter name="database" value="@@database" />
								<parameter name="username" value="" />
								<parameter name="password" value="" />
								<parameter name="operateriid" value="@@operateriid" />
								<parameter name="dokID" value="#grdDms.@DokID" />
								<parameter name="name" value="#grdDms.@naziv" />
							</action>
						</event>
						<fields inherited="true">
							<field name="Naziv" fontbold="true" />
							<field name="Size" caption="Size [KB]" />
						</fields>
					</grid>

				</tab>
			</tabs>
		</managerlayout>


		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Unesi">
					<event type="click">
						<action type="form open" value="frmUnosGla"/>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni">
					<event type="click">
						<action type="form open" value="frmIzmjenaGla">
							<parameter name="Smije" value="$Smije"/>
							<parameter name="Zakljuceno" value="#grdGla.@Zaključeno"/>
							<parameter name="GlaId" value="#grdGla.@UgovoriNajamGlaId"/>
						</action>
					</event> 
				</button>
				<button name="btnObrisi" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati ovu stavku?">
							<parameter name="captionYes" value="Obriši ugovor" />
							<parameter name="captionNo" value="Odustani" />
						</action>
						<action type="datarun nonquery" value="~dtObrisiUgovor"/>
						<action type="control populate" value="#grdGla"/>
					</event>
				</button>

				<button name="btnPromijeniStatus" caption="Promijeni status" begingroup="true">
					<event type="click">
						<action type="form open" value="frmPromjenaStatusa">
							<parameter name="GlaId" value="#grdGla.@UgovoriNajamGlaId"/>
						</action>
						<part name="ProvjeraMogucnostiIzmjeneStatusa" path="prtProvjeriIzmjenuStatusa.xml"/>
					</event>
				</button>
				<button name="btnAneks" caption="Aneks" begingroup="true" function="UgovoriNajamAneksPermissions">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite kreirati aneks?"/>
						<action type="datarun scalar" value="~dtAneks">
							<parameter name="aneksId"/>
						</action>
						<action type="control populate" value="#grdGla"/>
						<action type="control focus" value="#grdGla">
							<parameter value="$aneksId" type="int"/>
						</action>
					</event>
				</button>	
				<button name="btnPovezi" caption="&amp;Dodaj/poveži dokument" begingroup="true">
					<event type="click">
					     <action type="form open" value="frmDMSBarcode">
							<parameter name="GlaId" value="#grdGla.@UgovoriNajamGlaId"/>
						</action>
						<action type="control populate" value="#grdDms" />
					</event>

				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spUgovoriNajamGla_Delete" name="dtObrisiUgovor">
				<parameter name="@UgovoriNajamGlaId" value="#grdGla.@UgovoriNajamGlaId"/>
			</data>
			<data command="spugovorinajamgla_Select" name="dtPuniGlavu">
				<parameter name="@operaterid" value="@@operateriid"/>
			</data>
			<data command="spUgovoriNajamDet_Select"  name="dtPuniDet">
				<parameter name="@UgovoriNajamGlaId" value="#grdGla.@UgovoriNajamGlaId"/>
			</data>
			<data command="spUgovoriNajamGla_Aneks_Insert" name="dtAneks">
				<parameter name="@UgovoriNajamGlaId" value="#grdGla.@UgovoriNajamGlaId"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@Broj" value="#grdGla.@Broj"/>
			</data>
			<data command="spCarpoDMSQuery" name="dtDms">
				<parameter name="@EntityName" value="UgovoriNajamGla"/>
				<parameter name="@Id" value="#grdGla.@UgovoriNajamGlaId"/>
			</data>
			<data command="spCarpoDMSAzur" name="dtDeleteDoc">
				<parameter name="@Action" value="Delete"/>
				<parameter name="@EntityName" value="UgovoriNajamGla"/>
				<parameter name="@selectedids" value="#grdDms.selectedids"/>
			</data>

		</datalist>
	</form>


	<!--GLOBALNI DATALIST-->
	<datalist>
		<data command="spUgovoriNajamGla_Zakljuci" name="dtZakljuci">
			<parameter name="@id" value="$GlaId"/>
			<parameter name="@operateriid" value="@@operateriid"/>
			<parameter name="@statusiid" value="#cmbStatus"/>
			<parameter name="@napomena" value="#memNapomena" if="#memNapomena!=null&amp;&amp;#memNapomena!=''"/>
			<parameter name="@napomena" value="" else=""/>
			<parameter name="@PrethodniUgovorId" value="#srcBrojPrethodnogUgovora"/>
			<parameter name="@SljedeciUgovorId" value="#srcBrojNovogUgovora"/>
		</data>
		<data command="spUgovoriNajamGla_VratiStatus" name="dtVrati">
			<parameter name="@id" value="$GlaId"/>
			<parameter name="@operateriid" value="@@operateriid"/>
			<parameter name="@statusiid" value="#cmbStatus"/>
			<parameter name="@napomena" value="#memNapomena" if="#memNapomena!=null&amp;&amp;#memNapomena!=''"/>
			<parameter name="@napomena" value="" else=""/>
			<parameter name="@PrethodniUgovorId" value="null"/>
			<parameter name="@SljedeciUgovorId" value="null"/>
		</data>
		<data command="spUgovoriNajamGla_CheckStatusiNext" name="dtProvjeraViseDok">
			<parameter name="@UgovoriNajamGlaId" value="#grdGla.@UgovoriNajamGlaId"/>
			<parameter name="@operateriid" value="@@operateriid"/>
		</data>
		<data command="spStatusi_CARPO" name="dtProvjeraVratiStatus">
			<parameter name="@action" value="4" />
			<parameter name="@tablica" value="UgovoriNajamGla"/>
			<parameter name="@operateriid" value="@@OperateriId" />
			<parameter name="@id" value="#grdGla.@UgovoriNajamGlaId" type ="int" />
			<parameter name="@ShowErrorInfo" value="0" type ="int" />
		</data>
	</datalist>
	<form name="frmUnosGla" path="frmUnosGla.xml" />
	<form name="frmIzmjenaGla" path="frmIzmjenaGla.xml" />
	<form name="frmPromjenaStatusa" path="frmPromjenaStatusa.xml" />
	<form name="frmUnosIzmjenaDet" path="UgovoriNajam.frmUnosIzmjenaDet.xml" />
	<form name="frmUtvrdenaImovina" path="UgovoriNajam.frmUtvrdenaImovina.xml"/>
	<form name="frmRasporedPlacanja" path="UgovoriNajam.frmRasporedPlacanja.xml"/>
	<form name="frmRasporedPlacanjaStavkeUnos" path="UgovoriNajam.frmRasporedPlacanjaStavkeUnos.xml"/>
	<form name="frmRasporedPlacanjaPregled" path="frmRasporedPlacanjaPregled.xml" />
	<form name="frmDMSBarcode" path="UgovoriNajam.frmDMSBarcode.xml" />
</root>