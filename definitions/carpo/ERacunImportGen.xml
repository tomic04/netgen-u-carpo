<root version="1.0.2.1">
	<form type="master" name="ERacunImportGen" caption="E-račun import (gen)">
		<method name="ERacImportDll" dll="eRacunGenImport" class="eRacunGenImport.Start" method="CarpoStart" />
		<!-- <method name="Response" dll="MojERacun" class="MojERacun.Start" method="CarpoResponse" /> -->
		<method name="OpenInvoicePdf" dll="eRacunGen" class="eRacunGen.Start" method="CarpoInvoicePdf" />
		<event type="init">
			<action type="datarun scalar" value="~dtKupExist">
				<parameter name="KupExist"/>
			</action>
			<action type="datarun scalar" value="~dtUraExists">
				<parameter name="UraExists"/>
			</action>			
		</event>
		<event type="shown">
			<action type="control disable" value="#btnKup" if="$KupExist==0"/>
			<action type="control disable" value="#btnUra" if="$UraExists==0"/>			
		</event>
		<managerlayout>
			<lookup name="filter">
				<comboitem value="Svi ulazni dokumenti"/>
				<comboitem value="Operateri" searchfield="OperateriKeyId"/>
				<comboitem value="Statusi" searchfield="StatusiKeyId"/>
				<comboitem value="Partneri" searchfield="PartneriKeyId"/>
				<event type="valuechanged">
					<action type="control populate" value="#tree"/>
				</event>
			</lookup>
			<tree name="tree" dataname="dtTree" autopopulate="false">
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdMaster"/>
				</event>
				<fields>
					<field name="Name" />
				</fields>
			</tree>
			<grid name="grdMaster" key="UraXMLId" type="master" dataname="dtGridMaster" bestfitonrefresh="true" multiselect="true" savelayout="true">
				<event type="doubleclick">
					<!-- <action waittype="progress" waitcaption="Učitavanje" waittext="Dohvat privitka..." sleep="5000"/> -->
					<action type="method run" value="OpenInvoicePdf">
						<parameter name="cs" value="@@connection" />
						<parameter name="operateriId" value="@@operateriid"/>
						<parameter name="uraXmlId" value="#grdMaster.@uraXmlId"/>
					</action>
				</event>
				<event type="focusedrowchanged">
					<action type="control disable" value="#btnResponse,#btnPregled,#btnUra,#btnOtkljucaj,#btnObrisi,#btnAttachment" if="#grdMaster.@UraXMLId==null"/>
					<action type="control enable" value="#btnResponse,#btnPregled,#btnUra,#btnOtkljucaj,#btnObrisi,#btnAttachment" else=""/>
					<action type="control disable" value="#btnKup" if="#grdMaster.@UraXMLId==null||$KupExist==0"/>
					<action type="control enable" value="#btnKup" else=""/>
					<action type="control disable" value="#btnUra" if="#grdMaster.@UraXMLId==null||$UraExists==0"/>
					<action type="control enable" value="#btnUra" else=""/>					
				</event>
				<fields>
					<field name="DocumentType" caption="Tip e-Dokumenta"/>
					<field name="FiskBr" caption="Fiskalni broj" fontbold="true"/>
					<field name="Naziv" caption="Naziv partnera"/>
					<field name="DatSpremanja" caption="Dat. spremanja" formatstring="dd.MM.yyyy"/>
					<field name="DatumDok" caption="Dat. dokumenta" formatstring="dd.MM.yyyy"/>
					<field name="DatumVal" caption="Dat. dospjeća" formatstring="dd.MM.yyyy"/>
					<field name="UkupnoSaPDV" caption="Iznos računa"/>
					<field name="Osnovica25" caption="Osnovica 25%"/>
					<field name="Porez25" caption="Porez 25%"/>
					<field name="Osnovica13" caption="Osnovica 13%"/>
					<field name="Porez13" caption="Porez 13%"/>
					<field name="Osnovica5" caption="Osnovica 5%"/>
					<field name="Porez5" caption="Porez 5%"/>
					<field name="Osnovica20" caption="Osnovica 20%"/>
					<field name="Porez20" caption="Porez 20%"/>
					<field name="Osnovica10" caption="Osnovica 10%"/>
					<field name="Porez10" caption="Porez 10%"/>
					<field name="Neoporezivo"/>
					<field name="PovNaknada" caption="Povratna naknada"/>
					<field name="BrutoBezPDV" caption="Bruto bez PDV"/>
					<field name="NetoBezPDV" caption="Neto bez PDV"/>
					<field name="Popust"/>
					<field name="ZaPlatiti" caption="Za platiti"/>
					<field name="Model"/>
					<field name="ModelPNB" caption="PNB"/>
					<field name="IBAN" caption="IBAN"/>
					<field name="Valuta"/>
					<field name="Knjizeno" caption="Preneseno"/>
					<field name="UraKup" caption="KUP/URA"/>
					<field name="Odgovor" caption="Odgovor"/>
					<field name="BrojDok" caption="Broj dok."/>
					<field name="Operater"/>
					<field name="DatKreiranja" caption="Dat. kreiranja"/>
					<field name="brojPDVstavki" caption="PDV stavke"/>
					<field name="PrenesenoServisom" caption="Preneseno servisom"/>
					<field name="DocumentReferenceNumber" caption="Otpremnica" />
					<field name="DocumentReferenceDate" caption="Datum otpremnice"/>
					<field name="ContractReferenceNumber" caption="Ugovor" />
					<field name="ContractReferenceDate" caption="Datum ugovora"/>
					<field name="OriginatorReferenceNumber" caption="Ponuda" />
					<field name="OriginatorReferenceDate" caption="Datum ponude"/>	
					<field name="OrderReferenceNumber" caption="Narudžba" />
					<field name="OrderReferenceDate" caption="Datum narudžbe"/>	
					<field name="Napomena" caption="Napomena" />	
					<field name="FileName" caption="Naziv datoteke" />
					<field name="DeliveryPartyName" caption="Mjesto isporuke"/>
				</fields>
				<styles>
					<style name="fontcolor" value="gray" if="#grdMaster.@TipRN==7"/>
					<!-- odgovori -->
					<style name="fontcolor" value="orange" if="#grdMaster.@status==2"/> 
					<style name="fontcolor" value="green" elseif="#grdMaster.@status==1"/>
					<style name="fontcolor" value="red" if="#grdMaster.@partneriid==null||"/>
					<style name="bold" value="true" if="#grdMaster.@Odgovor!=null&amp;&amp;#grdMaster.@Odgovor!="/>
				</styles>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnImport" caption="&amp;UVEZI">
					<dropdownitem caption="Sa &amp;web servisa">
						<event type="click">
							<action type="method run" value="ERacImportDll">
								<parameter name="cs" value="@@connection" />
								<parameter name="operateriId" value="@@operateriid"/>
								<parameter name="parameter" value="web"/>
							</action>
							<action type="control populate" value="#grdMaster"/>
						</event>  
					</dropdownitem>
					<dropdownitem caption="Pretraži &amp;sistem">
						<event type="click">
							<action type="method run" value="ERacImportDll">
								<parameter name="cs" value="@@connection" />
								<parameter name="operateriId" value="@@operateriid"/>
								<parameter name="parameter" value="sys"/>
							</action>
							<action type="control populate" value="#grdMaster"/>
						</event>
					</dropdownitem>
				</button>
				<button name="btnPregled" caption="&amp;PREGLED" begingroup="true">
					<event type="click">
						<action type="form open" value="frmPregled">
							<parameter name="UraXMLId" value="#grdMaster.@UraXMLId" />
							<parameter name="EditDisabled" value="#grdMaster.@Knjizeno"/>
						</action>
						<action type="control populate keepfocus" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnAttachment" caption="PRI&amp;VITCI" >
					<event type="click">
						<action type="method run" value="ERacImportDll">
							<parameter name="cs" value="@@connection" />
							<parameter name="operateriId" value="@@operateriid"/>
							<parameter name="parameter" value="prew"/>
							<parameter name="id" value="#grdMaster.selectedids" type="string"/>
						</action>
					</event>
				</button>
				<button name="btnUra" caption="U&amp;RA" begingroup="true">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<action if="#grdMaster.@PartneriId!=null">					
							<action type="confirm" value="Želite li prenijeti označene račune u knjigu URA?">
								<action type="datarun nonquery" value="~dtKnjigaUra"/>
							</action>
							<action type="control populate keepfocus" value="#grdMaster"/>
						</action>
						<action type="message" value="Prije prijenosa u URU-u potrebno je odabrati partnera!" else=""/>						
					</event>
				</button>
				<button name="btnKup" caption="&amp;KUP">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<!-- <action type="confirm" value="Želite li prenijeti označene račune u KUP?"> -->
						<action if="#grdMaster.@PartneriId!=null">
							<action type="method run" value="ERacImportDll">
								<parameter name="cs" value="@@connection" />
								<parameter name="operateriId" value="@@operateriid"/>
								<parameter name="parameter" value="xkup"/>
								<parameter name="id" value="#grdMaster.selectedids"/>
							</action>
							<action type="control populate keepfocus" value="#grdMaster"/>
						</action>
						<action type="message" value="Prije prijenosa u KUP potrebno je odabrati partnera!" else=""/>
					</event>
				</button>
				<button name="btnOtkljucaj" caption="O&amp;TKLJUČAJ">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<action type="confirm" value="Želite promjeniti status odabrane stavke? (Napomena: Status se može promijeniti ukoliko je dokument obrisan u knjizi URA)">
							<action type="control foreachrow selected" value="#grdMaster">							
								<action type="datarun nonquery" value="~dtPromjenaStatusa"/>
							</action>
						</action>
						<action type="control populate keepfocus" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnObrisi" caption="O&amp;BRIŠI" function="Obrisi">
					<menuitem control="#grdMaster"/>
					<event type="click">
						<action type="confirm" value="Želite li obrisati označene stavke?">
							<action type="datarun nonquery" value="~dtObrisi" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</event>
				</button>
				<button name="btnResponse" caption="&amp;ODGOVORI" begingroup="true">
					<event type="click">
						<action if="#grdMaster.@PartneriId!=null">
							<action type="method run" value="ERacImportDll">
								<parameter name="cs" value="@@connection" />
								<parameter name="operateriId" value="@@operateriid"/>
								<parameter name="parameter" value="updateStatusa"/>
								<parameter name="id" value="#grdMaster.selectedids"/>
							</action>
							<action type="control populate keepfocus" value="#grdMaster"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spKntMojERacunCombo" name="dtKupExist">
				<parameter name="@action" value="122" type="int"/>
			</data>
			<data command="VremenskaPodjela" type="integrated" name="dtTree" if="#filter==Svi ulazni dokumenti"/>
			<data command="spEracuniDrvoFilter" name="dtTree" else="">
				<parameter name="@action" value="Statusi" if="#filter==Statusi"/> 
				<parameter name="@Action" value="Partneri" elseif="#filter==Partneri"/> 
				<parameter name="@action" value="Operateri" else="#filter==Operateri"/> 
			</data>
			<data command="spKntMojERacunCombo" name="dtGridMaster" if="#filter==Svi ulazni dokumenti">
				<parameter name="@Action" value="2"/>
				<parameter name="@node" value="{#tree.@DatumOd::yyyyMMdd}#{#tree.@DatumDo::yyyyMMdd}"/>
			</data>
			<data command="spGridPopulateFilter_Statusi" name="dtGridMaster" elseif="#filter==Statusi">
				<parameter name="@Status" value="#tree.@ValueId" />
				<parameter name="@DatumOd" value="#tree.@DatumOd" />
				<parameter name="@DatumDo" value="#tree.@DatumDo" />
			</data>
			<data command="spGridPopulateFilter_Partneri" name="dtGridMaster" elseif="#filter==Partneri">
				<parameter name="@Partner" value="#tree.@ValueId"/>
				<parameter name="@DatumOd" value="#tree.@DatumOd" />
				<parameter name="@DatumDo" value="#tree.@DatumDo" />
			</data>
			<data command="spGridPopulateFilter_Operateri" name="dtGridMaster" else="">
				<parameter name="@operateriid" value="#tree.@ValueId"/>
				<parameter name="@DatumOd" value="#tree.@DatumOd" />
				<parameter name="@DatumDo" value="#tree.@DatumDo" />
			</data>
			<data command="spKntMojERacunCombo" name="dtObrisi">
				<parameter name="@action" value="5"/>
				<parameter name="@selectedids" value="#grdMaster.selectedids" />
			</data>
			<data command="spKntMojERacunCombo" name="dtKnjigaUra">
				<parameter name="@action" value="4"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@selectedids" value="#grdMaster.selectedids"/>
			</data>
			<data command="spKntMojERacunCombo" name="dtPromjenaStatusa">
				<parameter name="@action" value="6"/>
				<parameter name="@id" value="#grdMaster.@UraXMLId"/>
			</data>
			<data command="spKntMojERacunCombo" name="dtUraExists">
				<parameter name="@action" value="125" type="int"/>
			</data>			
		</datalist>
	</form>
	<form name="frmPregled" path="frmPregled.xml"/>
</root>
