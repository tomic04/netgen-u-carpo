<!-- MH Radila na Jupiter2017, Spin -->

<root>
	<form name="frmMaster" type="master" caption="Carinska tarifa">
		<event type="init">
			<action type="datarun scalar" value="Global.~dtCheckPermission">
				<parameter name="Global.Smije"/>
			</action>
		</event>
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="CarinskaTarifaId" savelayout="true" statusbar="true">
				<event type="doubleclick">
					<action if="global.$Smije==1">
						<action type="form open" value="frmTarifaInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="CarTarifaId" value="#grdMaster.@CarinskaTarifaId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</action>
					<action else="">
						<action type="message" value="Nemate dopuštenje mijenjati tarife"/>
					</action>
				</event> 
				<fields inherited="true">
					<field name="PropisanaJM" caption="Propisana JM"/>
					<field name="stopa1" format="n2"/>
					<field name="stopa2" format="n2"/>
					<field name="stopa3" format="n2"/>
				</fields>
				<print  caption="Carinske tarife" captionalign="center"/>				
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true" >
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<menuitem control="#grdMaster" sort="1"/>
					<event type="click">
						<action type="form open" value="frmTarifaInsertEdit" >
							<parameter name="CarTarifaid" value="null" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$CarTarifaId" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit" >
					<menuitem control="#grdMaster" sort="2"/>
					<event type="click">
						<action type="form open" value="frmTarifaInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="CarTarifaId" value="#grdMaster.@CarinskaTarifaId" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$CarTarifaId" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati Carinsku tarifu?">
							<action type="datarun nonquery" value="global.~dtDelete">
								<action type="control populate" value="#grdMaster"/>
							</action>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmTarifaInsertEdit" path="frmTarifaInsertEdit.xml" />

	<datalist>
		<data command="spCarinskaTarifa_Query" name="dtMaster">
			<parameter name="@Action" value="0" />
		</data>
		<data command="spProd_CheckPermission" name="dtCheckPermission">
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@Objekt" value="CarinskaTarifa" />
			<parameter name="@Funkcija" value="edit" />
		</data>
		<data command="spCarinskaTarifa_Azur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@CarinskaTarifaId" value="#grdMaster.@CarinskaTarifaId" />
		</data>
	</datalist>
</root>