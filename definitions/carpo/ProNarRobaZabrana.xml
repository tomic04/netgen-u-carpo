<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="master" type="master" caption="Narudžbe Zabrana Artikala ">

		<managerlayout>
			      
			<grid name="grdGlava" multiselect="true" dataname="dtGlavaQuery" type="master" bestfitonrefresh="True" key="ProNarRobaZabranaId">
			
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" >
					<event type="click">
					 <action type="form open" value="frmUnos"/>
					 <action type="control populate" value="#grdGlava">
					 	<action type="control focus" value="#grdGlava">
							<parameter value="global.$ZadnjiId" />
						 </action>
					 </action>		 
					</event> 
				</button> 
				
				<button name="btnObrisi" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?" />
						<action type="datarun nonquery" value="~dtObrisi" />
						<action type="control populate" value="#grdGlava"/>           
					</event>
				</button>

			</buttons>		
		</panelbuttons>	

		<datalist>
		    <data command="spProNarRobaZabrana_Query" name="dtGlavaQuery" />

			<data command="spProNarRobaZabrana_Azur" name="dtObrisi">
			<parameter name="@Action"  value="2" />
			<parameter name="@ProNarRobaZabranaId"  value="#grdGlava.@ProNarRobaZabranaId" />
			</data>
		</datalist>
	
	</form>

	<form name="frmUnos" caption="Unos robe">

	<layout>
		<group cols="1" rows="1">
			<item col="1" row="1" caption="Roba:"  textposition="left">
				<searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtPuniRobu" fontbold="true" />
			</item>
		</group>
	</layout>

	<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtUnesi">
							<parameter name="zadnjiId" value="~dtUnesi.@ZadnjiUnos" />
						</action>
						<action type="variable value" value="global.ZadnjiId">
                            <parameter value="$zadnjiId" type="int"/>
                        </action>
						<action type="form close"/>
					</event>
				</button>

				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>
	
	<datalist>
		<data command="spTraziRoba" name="dtPuniRobu">
        	<parameter name="@action" value="Roba" />
        	<parameter name="@uvjet" value="#srcRoba.text" />
      	</data>

		  <data command="spProNarRobaZabrana_Azur" name="dtUnesi">
        	<parameter name="@Action" value="1" />
        	<parameter name="@RobaId" value="#srcRoba" />
      	</data>
	</datalist>
	
	</form>

</root>