<?xml version="1.0" encoding="utf-8"?>
<!--
KUPNGSpin_KUP_URA - subforma: OBRDMS_FORM (NetGen) → frmObrDms (Carpo)
U Carpo master-u "Obrada DMS" je modelirana kao grana TREE filtera (lookup #filter + dtMaster spKUPPrometQueryDrvo).
Ova subforma je placeholder (nije striktno potrebna).
-->
<root version="1.2">
  <form name="frmObrDms" caption="Obrada DMS" type="dialog" width="520" height="200" fixedsize="true">
    <event type="shown">
      <action type="message" value="Ova forma je placeholder. Obrada DMS je dostupna kroz TREE filter 'Obrada DMS' u master formi."/>
    </event>
    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1" caption="Obrada DMS" textposition="left">
          <label/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="ZATVORI" dock="right" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
  </form>
</root>

