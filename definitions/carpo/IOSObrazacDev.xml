<root version="1.0.0.6" loglevel="3">	
    <form name="frmIOSDev" type="master" caption="Devizni IOS Obrazac" statusbar="true" template="splitter" maximized="true">
		<!-- <event type="init"> -->
			<!-- <action type="datarun reader" value="~dtKontoInit"/> -->
			<!-- <action type="datarun reader" value="~dtPotpisInit"/> -->
		<!-- </event> -->
		<event type="shown">
			<action type="control value" value="#datDatumDo">
				<parameter value="now"/>
			</action>
		</event>
		<layout name="panel1" autotaborder="false" type="collapsable" itemspadding="1">
			<!--group cols="4" rows="4" bordervisible="false" -->
				<group cols="2" rows="11" groupbordervisible="false" >
					<item row="1" col="1" colspan="2" caption="Konto:">
						<combomultiedit name="cmbKonto" valuefield="KntPlanAId" displayfield="KNaziv" dataname="~dtKonto" savevalue="app" tabindex="0"/>
					</item>
						<item row="2" col="1" colspan="2" caption="Datum dokumenta do:">
						<dateedit name="datDatumDo" tabindex="1" value="getdate"/> 
					</item>
					<item row="3" col="1" colspan="2" caption="Partner:" >
						<searchedit  name="srcPartner" fieldtext="Partner" fieldvalue="PartneriId" dataname="dtGetPartneri" savevalue="app" tabindex="2" savelayout="true"/>
					</item>
					<item row="4" col="1" colspan="2" caption="Klasa:">
						<comboedit name="cmbKlasa" dataname="~dtKlase" valuefield="KlPartneriID" savevalue="app" displayfield="Naziv" tabindex="3"/>	
					</item>
					<item row="5" col="1" colspan="2" caption="Županije:">
						<comboedit name="cmbZupanije" dataname="~dtZupanije" valuefield="ZupanijeId" savevalue="app" displayfield="Naziv" tabindex="4">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtMjesta"/>
								<action type="control populate" value="#cmbMjesta"/>
							</event>
						</comboedit>
					</item>
					<item row="6" col="1" colspan="2" caption="Mjesta:">
						<comboedit name="cmbMjesta" dataname="~dtMjesta" datavalue="~dtMjesta.#cmbZupanije" savevalue="app" valuefield="MjestaId" displayfield="Naziv" tabindex="5" />
					</item>
					<item row="7" col="1" caption="Ukupni saldo >">
						 <textedit name="txtIznos" value="0" format="n2" tabindex="6" /> 
					</item>
					 <item row="7" col="2" >
						 <checkedit name="cksaldo" tabindex="7" savevalue="app" caption="Saldo 0"/> 
					</item>
					<item row="8" col="1" colspan="2" caption="Napomena:">
						<comboedit name="cmbNapomena" dataname="~dtNapomena" valuefield="PorukedocId" savevalue="app" displayfield="Poruka" tabindex="8"/>
					</item>
					<item row="9" col="1" colspan="2" caption="Valuta:">
						<comboedit name="cmbValuta" dataname="~dtValuta" valuefield="ValuteId" displayfield="Naziv" savevalue="app" tabindex="9"/>
					</item>
					<group rows="1" cols="2" row="10" col="1" rowspan="1" colspan="2" caption="Podaci na dokumentu">
						<item row="1" col="1" caption="Potpis:" colspan="2">
							<comboedit name="cmbOdgOsobe" dataname="~dtOdgOsobe" savevalue="app" valuefield="OsobeId" displayfield="Naziv" required="True" tabindex="10"/>
						</item>
					</group>
				</group>
			</layout>
		<layout name="panel2">
			<group  row="3" cols="4" rows="1" col="1" colspan="4" bordervisible="false">
				<columnsdefinition>
					<column size="27%" position="1" /> 
					<column size="7%" position="2" /> 
					<column size="36%" position="3" /> 
					<column size="30%" position="3" /> 
				</columnsdefinition>
				<item row="2" col="1" rowspan="2" colspan="2">
					<grid name="grdGlava" dataname="~dtMGrid" multiselect="true" key="gridPid" >
						<event type="focusedrowchanged"> 
							<action type="datarun reader" value="~dtDGrid"/>
							<action type="control populate" value="#grdDetalj" />
							<action type="footer text" value="Broj stavki na lijevom prikazu: {#grdGlava.rowcount} / Broj stavki na desnom prikazu: {#grdDetalj.rowcount}"/>
						</event>
						<event type="selectionchanged" >
							 <action type="variable value">
								<parameter name="SelectedIDs" value="#grdGlava.selectedids.table" />
							 </action>
							 							 
						</event>

						<fields inherited="true">
							<field name="partner" caption="Partner" minwidth="200"/> 
							<field name="ukupno" caption="Ukupno"/> 
						</fields>
					</grid>
				</item>
				<item row="2" col="3" rowspan="2" colspan="2">
					<grid name="grdDetalj" dataname="~dtDGrid" multiselect="true">
						<event type="focusedrowchanged">
							<action type="datarun scalar" value="~dtRacKontrola">
								<parameter name="VrstaKonta"/>
								<!-- <action type="control disable" value="btnRacun" if="$VrstaKonta!=Fakture"/> -->
								<!-- <action type="control enable" value="btnRacun" else=""/> -->
							</action>
						</event>
						<fields inherited="true">
							<field name="Konto" caption="Konto" minwidth="100"/>
							<field name="Broj" caption="Broj" minwidth="100"/>
							<field name="DatumDokumenta" caption="Datum dokumenta" minwidth="100"/>
							<field name="DatValute" caption="Datum valute" minwidth="100"/>
							<field name="Duguje" caption="Duguje" minwidth="100"/>
							<field name="Potrazuje" caption="Potrazuje" minwidth="100"/>
							<field name="Saldo" caption="Saldo" minwidth="100"/>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
        <panelbuttons>
            <buttons>
                <button name="btnIzvrsi" caption="Izvrši">
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="Učitavanje stavaka..." sleep="2000">
						<action type="datarun scalar" value="~dtMGrid">
							<parameter name="Id"/>
						</action>
						<action type="control populate" value="#grdGlava" />
					</event>
				</button>
				<!--
                <button name="btnRacun" caption="Račun" >
					<event type="click">
						<action type="form open" value="frmRacun">
							<parameter name="KId" value="#grdDetalj.@KId"/>
							<parameter name="Konto" value="#grdDetalj.@Konto"/>
						</action>
					</event>
				</button> 
				-->
				<button name="btnRacun" caption="&amp;Račun" >   
					<event type="click">
						<!--dodano pregledavanje iz DMS-a za dobavljače-->
						<action type="datarun reader" value="~dtPoveziKupFaktureDobSkener" if="#grdDetalj.@Tablica==FaktureDob"/>	
						<action type="form open" value="frmDMS" if="~dtPoveziKupFaktureDobSkener.@KupSkenerId!=null&amp;&amp;#grdDetalj.@Tablica==FaktureDob">
							<parameter name="KupSkenerId" value="~dtPoveziKupFaktureDobSkener.@KupSkenerId"/>
						</action>
						<!-- <action type="form open" value="frmDMS" if="~dtPoveziKupFaktureDobSkener.@KupPrometId!=null&amp;&amp;#grdDetalj.@Tablica==FaktureDob"> -->
							<!-- <parameter name="KupPrometId" value="~dtPoveziKupFaktureDobSkener.@KupPrometId"/> -->
						<!-- </action>					 -->
						<action type="form open" value="frmFakturaRacun" if="#grdDetalj.@Tablica==Fakture">
							<parameter name="FaktureId" value="#grdDetalj.@KId"/>
							<parameter name="StatusFak" value="2"/>
							<parameter name="PartneriId" value="#grdGlava.@gridPid"/>
						</action>
						<action type="form open" value="frmRacun" if="global.$Tablica==FaktureDob&amp;&amp;#grdGlavni.@slozi==2"/>
					</event>
				</button>
				<button name="btnPrint" caption="Ispiši dok." dataname="~dtPrint" displayfield="Opis" >
					<event type="click">
						<!--action type="variable value" >
							<parameter name="@nizId" value="#grdGrid.selectedids" />
						</action-->
						<action type="datarun nonquery" value="~dtIdIzbor">
							<!--parameter name="@nizId" value="#grdGrid.selectedids" /-->
						</action>
						<action type="control print" value="#grdGlava" singleprint="true" > 
							<action type="print template" value="#btnPrint.@Template">
								<!--parameter name="id" value="3971,2948,5885,4470" type="string"  /-->
								<parameter name="NizKonto" value="#cmbKonto" type="string"/>
								<parameter name="DatumDo" value="#datDatumDo" />
								<parameter name="potpis" value="#cmbOdgOsobe"/>
								<parameter name="NapomenaId" value="#cmbNapomena"/>
								<parameter name="DevValuteId" value="#cmbValuta"/>
							</action>
						</action>
					</event>
				</button>

                <button name="btnIzlaz" caption="Izlaz" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
                <button caption="Uputi me" type="add" dock="right"><!--dorada-->
				</button>
            </buttons>
        </panelbuttons>
        <datalist>
			<!--KONTROLE-->	
            <data command="spCKntPopuniKontrole" name="dtZupanije">
				<parameter name="@Action" value="zupanije"/>
				<parameter name="@ID" value="null"/>
			</data>
			<data command="spCKntPopuniKontrole" name="dtMjesta">
				<parameter name="@Action" value="mjesta"/>
				<parameter name="@ID" value="#cmbZupanije"/><!--još vidjeti ne radi-->
			</data>
			<data command="spCKntPopuniKontrole" name="dtKlase">
				<parameter name="@Action" value="klpartneri"/>
				<parameter name="@ID" value="null"/>
			</data>
			<data command="spCKntPopuniKontrole" name="dtNapomena">
				<parameter name="@Action" value="napomene"/>
				<parameter name="@ID" value="null"/>
			</data>
			<data command="spCKntPopuniKontrole" name="dtOdgOsobe">
				<parameter name="@Action" value="odgosobe"/>
				<parameter name="@ID" value="null"/>
			</data>
			<data command="spCKntPopuniKontrole" name="dtKonto">
				<parameter name="@Action" value="kontoDev"/>
				<parameter name="@ID" value="null"/>
			</data>
			<data command="spCKntPopuniKontrole" name="dtValuta">
				<parameter name="@Action" value="valute"/>
				<parameter name="@ID" value="null"/>
			</data>
			<!--Kontrole vrijednost pri učitavanju forme-->
			<!-- <data name="dtKontoInit" command="spCKntPopuniKontrole"> -->
				<!-- <parameter name="@Action" value="kontoInit"/> -->
				<!-- <parameter name="@ID" value="null"/> -->
			<!-- </data> -->
			<!-- <data name="dtPotpisInit" command="spCKntPopuniKontrole"> -->
				<!-- <parameter name="@Action" value="odgOsobeInit"/> -->
				<!-- <parameter name="@ID" value="null"/> -->
			<!-- </data> -->
			<!--Grid-->
			<data command="spCKntIOSObrazacDev" name="dtMGrid">
				<parameter name="@Action" value="2"/>
				<!--parameter name="@DatumOd" value="null"/-->
				<parameter name="@DatumDo" value="#datDatumDo"/>
				<parameter name="@IDPAR" value="#srcPartner"/>
				<parameter name="@IDOsoba" value="#cmbOdgOsobe"/>
				<!--parameter name="@IDOrg" value="null"/-->
				<!--parameter name="@Sortkey" value="konto"/-->
				<parameter name="@IDMjesto" value="#cmbMjesta"/>
				<parameter name="@IDZup" value="#cmbZupanije"/>
				<parameter name="@IZNOS" value="#txtIznos"/>
				<!--parameter name="@iznoss" value="konto"/-->
				<!--parameter name="@Konto" value="#cmbKonto"/-->
				<!--parameter name="@Tuzba" value="null"/-->
				<!--parameter name="@Imehost" value="konto"/-->
				<parameter name="@potpis" value="#cmbOdgOsobe"/>
				<!--parameter name="@username2" value="konto"/-->
				<parameter name="@IDKlasa" value="#cmbKlasa"/>
				<parameter name="@Saldo" value="#cksaldo"/>
				<parameter name="@nizKonto" value="#cmbKonto"/>
				<parameter name="@DevValuteId" value="#cmbValuta"/>
			</data>
			<data command="spCKntIOSObrazacDev" name="dtDGrid">
				<parameter name="@Action" value="22"/>
				<!--parameter name="@DatumOd" value="null"/-->
				<parameter name="@DatumDo" value="#datDatumDo"/>
				<parameter name="@IDPAR" value="#grdGlava.@gridPid"/>
				<parameter name="@IDOsoba" value="#cmbOdgOsobe"/>
				<!--parameter name="@IDOrg" value="null"/-->
				<!--parameter name="@Sortkey" value="konto"/-->
				<parameter name="@IDMjesto" value="#cmbMjesta"/>
				<parameter name="@IDZup" value="#cmbZupanije"/>
				<parameter name="@IZNOS" value="#txtIznos"/>
				<!--parameter name="@iznoss" value="konto"/-->
				<!--parameter name="@Konto" value="#cmbKonto"/-->
				<!--parameter name="@Tuzba" value="null"/-->
				<!--parameter name="@Imehost" value="konto"/-->
				<parameter name="@potpis" value="#cmbOdgOsobe"/>
				<!--parameter name="@username2" value="konto"/-->
				<parameter name="@IDKlasa" value="#cmbKlasa"/>
				<parameter name="@Saldo" value="#cksaldo"/>
				<parameter name="@nizKonto" value="#cmbKonto"/>	
				<parameter name="@DevValuteId" value="#cmbValuta"/>				
			</data>
			<!--Print-->
			<data command="spCKntIOSObrazacDev" name="dtPrint">
				<parameter name="@Action" value="16" />
			</data>	
			<data command="spCKntIOSObrazacRSDev" name="dtIdIzbor">
				<parameter name="@Action" value="23"/>
				<parameter name="@nizId" value="$SelectedIDs" />
			</data>
			<!--kontrola vrste konta za gumb Račun-->
			<data command="spCKntIOSObrazacDev" name="dtRacKontrola">
				<parameter name="@Action" value="12"/>
				<parameter name="@nizKonto" value="#grdDetalj.@Konto"/>			
			</data>
			<data name="dtPoveziKupFaktureDobSkener" command="spCKntDMS">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="#grdDetalj.@KId"/>
			</data>	
			<data command="spCKntTemTraziPartneri" name="dtGetPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>			
        </datalist>
    </form>
	<form name="frmRacun" path="frmRacun.xml"/>
	<form name="frmFakturaRacun" path="IOSObrazac.frmFakturaRacun.xml"/>
	<form name="frmDMS" path="KnjigaUra.frmDMS.xml"/>	
</root>