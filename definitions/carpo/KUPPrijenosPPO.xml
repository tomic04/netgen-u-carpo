<?xml version="1.0" encoding="utf-8"?>
<root version="1.0.0.1">
	<form name="frmMaster" type="master" caption="Kup prijenos">
		<event type="init">
			
		</event>
		<event type="load">
			<!-- <action type="control populate" value="#grdGlava"/> -->
		</event>
		<event type="shown">           

		</event>
		<managerlayout>
			<grid name="grdGlava" type="master" async="true" key="KUPPrometPrijenosId" multiselect="true"  keyfield="KUPPrometPrijenosId" wordwrap="true"> 										
				<data command="spCKUPPrijenosPPO" >
				   <parameter name="@action" value="Ucitaj"/>
				</data>
				<fields>
					<field name="VrstaPosteOznaka" caption="Vrsta pošte" />
					<field name="DatumPrijema" caption="Datum prijema" />
					<field name="OIB" caption="Partneri" />
					<field name="Broj" caption="Broj" />
					<field name="DatumValute" caption="Datum valute"  />
					<field name="Opis" caption="Opis" />
					<field name="Iznos" caption="Iznos"  />
					<field name="OznakaOrgShema" caption="Org. shema"  />
					<field name="OznakaValute" caption="Valuta"  />		
                    <field name="Posiljatelj" caption="Pošiljatelj"  />
					<field name="Rjesenje" caption="Rješenje"  />
					<field name="Scan" caption="Scan"  />
					<field name="DatumDokumenta" caption="Datum dokumenta"  />
					<field name="StatusOdobravanja" caption="Status odobravanja"  />			
				</fields>
				<styles>
					<!-- BOJANJE MG-->
					<style name="fontcolor" value="red" if="#grdGlava.@KupPrometId==null" />
					<style name="fontcolor" value="green" if="#grdGlava.@KupPrometId!=null" />
				</styles>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUcitaj" caption="&amp;Učitaj">
					<event type="click">
						<action type="control populate" value="#grdGlava"/>
					</event>
				</button>
				<button name="btnPrenesi" caption="&amp;Prenesi">
					<event type="click">
					    <action type="datarun reader" value="~dtPrenesi" />
						<action type="control populate" value="#grdGlava"/>
					</event>
				</button>
			</buttons>	
		</panelbuttons>

		<datalist>
			<data command="spCKUPPrijenosPPO" name="dtPrenesi">
				<parameter name="@Action" value="Prenesi" />
				<parameter name="@OperateriId" value="@@operateriid" type="int"/>
				
			</data>	
		</datalist>
	</form>

</root>