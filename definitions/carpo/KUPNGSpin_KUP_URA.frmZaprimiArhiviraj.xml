<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: MULTIBLUEZAKFORM (NetGen) → frmZaprimiArhiviraj (Carpo) -->
<root version="1.2">
  <form name="frmZaprimiArhiviraj" caption="Zaprimi i arhiviraj" type="dialog" width="460" height="200" fixedsize="true">
    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1" caption="Želite li zaprimiti i arhivirati dokument?" textposition="left">
          <label/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPotvrdi" caption="POTVRDI">
          <event type="click" waittype="progress" waitcaption="Obrada" waittext="Obrađujem...">
            <action type="datarun nonquery" value="~dtZaprimiArhiviraj"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtZaprimiArhiviraj" command="spKUPPrometAzurN" timeout="300">
        <!-- NetGen: spKUPPrometAzurN 10,@ID=@@id,@operateriid=@@operateriid,@kupstatusid=@@kupstatusid -->
        <parameter name="@action" value="10"/>
        <parameter name="@ID" value="$Id"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <!-- TODO: NetGen je slao @@kupstatusid; u Carpo konverziji ga trenutno mapiramo na global.$KupStatusId (iz filter forme). -->
        <parameter name="@kupstatusid" value="global.$KupStatusId"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

