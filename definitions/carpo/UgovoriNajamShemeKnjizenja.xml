<root>
	<form name="frmGlava" type="master" caption="Sheme knjiženja">

		<managerlayout>
			<grid name="grdGlava" type="master" multiselect="true" dataname="~dtNapuniGrid" fixed="true">
				<fields>
					<field name="Vrsta ugovora" caption="Vrsta ugovora" />
					<field name="Vrsta troškova" caption="Vrsta troškova" />
					<field name="Konto knjiženja" caption="Konto knjiženja" />
					<field name="Ključ knjiženja" caption="Ključ knjiženja" />
					<field name="Aktivno" caption="Aktivno" />
				</fields>
				<event type="doubleclick">
					<action type="form open" value="frmIzmijena">
						<parameter name="UgovoriNajamShemeKnjizenjaID" value="#grdGlava.@UgovoriNajamShemeKnjizenjaID" />
					</action>
				</event>
			</grid>		
		</managerlayout>

	<panelbuttons>
		
		<buttons>
			<button name="btnUnesi" caption="UNESI">
				<event type="click">
					<action type="form open" value="frmUnos" />
				</event>
			</button>
	

			<button name="btnIzmijeni" caption="IZMIJENI">
				<event type="click">
					<action type="form open" value="frmIzmijena">
						<parameter name="UgovoriNajamShemeKnjizenjaID" value="#grdGlava.@UgovoriNajamShemeKnjizenjaID" />
					</action>
				</event>
			</button>

			<button name="btnObriši" caption="OBRIŠI">
				<event type="click">
					<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?" />
					<action type="datarun nonquery" value="~dtDelete" />
					<action type="control populate" value="#grdGlava" />
				</event>
			</button>
		</buttons>

	</panelbuttons>

	<datalist>	
		<data command="spUgovoriNajamShemeKnjizenja_Query" name="dtNapuniGrid" />
		<data command="spUgovoriNajamShemeKnjizenja_Delete" name="dtDelete">
			<parameter name="UgovoriNajamShemeKnjizenjaID" value="#grdGlava.@UgovoriNajamShemeKnjizenjaID" />
		</data>
	</datalist>

	</form>

	<form name="frmUnos" caption="Unesi">

		<layout>
			<group cols="1" rows="5">
				<item col="1" row="1" caption="Vrsta ugovora:">
					<comboedit name="cmbVrstaUgo" dataname="~dtGetVrstaUgo" displayfield="Naziv" valuefield="UgovoriNajamVrsteId" required="true"/>
				</item>
				<item col="1" row="2" caption="Vrsta troškova:">
					<comboedit name="cmbVrstaTroska" dataname="~dtGetVrstaTros" displayfield="Naziv" valuefield="UgovoriNajamVrsteTroskovaID" required="true"/>
				</item>s
				<item col="1" row="3" caption="Konto knjiženja:">
					<searchedit name="srcKontoNaziv" fieldtext="naziv" fieldvalue="KntPlanAid" dataname="~dtGetKonto" function="srcKontoNaziv" required="true"/>
				</item>
				<item col="1" row="4" caption="Ključ knjiženja:">
					<comboedit name="cmbVrstaKljuca" dataname="~dtGetKljuc" displayfield="naziv" valuefield="KeyCostMasterId" required="true"/>
				</item>
				<item col="1" row="5" caption="Aktivno:">
					<checkedit name="cmbAktivno" value="1" />
				</item>
			</group>

		</layout>

		<panelbuttons>	
				<buttons>
					<button name="btnSpremi" caption="Spremi">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="dtInsertShema" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" />
						</event>
					</button>
					<button name="btnOdustani" caption="Odustani" dock="right" type="cancel" />
				</buttons>
	   </panelbuttons>



	<datalist>
		<data command="spUgovoriNajamShemeKnjizenja_VrstaUgo" name="dtGetVrstaUgo" />
		<data command="spUgovoriNajamShemeKnjizenja_VrstaTros" name="dtGetVrstaTros" />
		<data command="spUgovoriNajamShemeKnjizenja_spKljucMaster_query" name="dtGetKljuc">
			<parameter name="@action" value="0" />
		</data>
		<data command="spUgovoriNajamShemeKnjizenja_spKontoNaziv" name="dtGetKonto">
			<parameter name="@uvjet" value="#srcKontoNaziv.text" />
			<parameter name="@action" value="0" />
		</data>
		<data command="spUgovoriNajamShemeKnjizenja_Insert" name="dtInsertShema">
			<parameter name="@VrstaUgovora" value="#cmbVrstaUgo" />
			<parameter name="@VrstaTroskova" value="#cmbVrstaTroska" />
			<parameter name="@Konto" value="#srcKontoNaziv" />
			<parameter name="@KljucKnjizenja" value="#cmbVrstaKljuca" />
			<parameter name="@aktivno" value="#cmbAktivno" />
		</data>
	</datalist>

	</form>

	<form name="frmIzmijena" caption="Izmijeni">

		<event type="init">
			<action type="datarun reader" value="dtGet" />
		</event>

		<layout>
			<group cols="1" rows="5">
				<item col="1" row="1" caption="Vrsta ugovora:">
					<comboedit name="cmbVrstaUgo" datavalue="~dtGet.@UgovoriNajamVrsteID" dataname="~dtGetVrstaUgo" valuefield="UgovoriNajamVrsteID" displayfield="naziv" required="true" />
				</item>
				<item col="1" row="2" caption="Vrsta troškova:">
					<comboedit name="cmbVrstaTros" datavalue="~dtGet.@UgovoriNajamVrsteTroskovaID" dataname="~dtGetVrstaTros" valuefield="UgovoriNajamVrsteTroskovaID" displayfield="naziv" required="true"/>
				</item>
				<item col="1" row="3" caption="Konto knjiženja:">
					<searchedit name="srcKontoNaziv" fieldtext="naziv" fieldvalue="KntPlanAid" dataname="~dtGetKonto" function="srcKontoNaziv"
						datavalue="~dtGet.@KntPlanAid" datatext="~dtGet.@KontoKnjiženja" required="true"/> 
				</item>
				<item col="1" row="4" caption="Ključ knjiženja:">
					<comboedit name="cmbVrstaKljuca" datavalue="~dtGet.@KeyCostMasterId" dataname="~dtGetKljuc" valuefield="KeyCostMasterId" displayfield="naziv" required="true"/>
				</item>
				<item col="1" row="5" caption="Aktivno:">
					<checkedit name="chkAktivno" datavalue="~dtGet.@Aktivno" dataname="~dtGet" valuefield="aktivno" displayfield="Aktivno"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>

				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUpdateShema" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>

				<button name="btnObrisi" caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spUgovoriNajamShemeKnjizenja_EditQuery" name="dtGet">
				<parameter name="@UgovoriNajamShemeKnjizenjaID" value="$UgovoriNajamShemeKnjizenjaID" />
			</data>
			<data command="spUgovoriNajamShemeKnjizenja_VrstaUgo" name="dtGetVrstaUgo" />
			<data command="spUgovoriNajamShemeKnjizenja_VrstaTros" name="dtGetVrstaTros" />

			<data command="spUgovoriNajamShemeKnjizenja_spKontoNaziv" name="dtGetKonto">
				<parameter name="@uvjet" value="#srcKontoNaziv.text" />
				<parameter name="@action" value="0" />
		   </data>

			<data command="spUgovoriNajamShemeKnjizenja_spKljucMaster_query" name="dtGetKljuc">
				<parameter name="@action" value="0" />
			</data>

			<data command="spUgovoriNajamShemeKnjizenja_Update" name="dtUpdateShema">
				<parameter name="@UgovoriNajamShemeKnjizenjaID" value="$UgovoriNajamShemeKnjizenjaID" />
				<parameter name="@VrstaUgovora" value="#cmbVrstaUgo" />
				<parameter name="@VrstaTroskova" value="#cmbVrstaTros" />
				<parameter name="@Konto" value="#srcKontoNaziv" />
				<parameter name="@Kljuc" value="#cmbVrstaKljuca" />
				<parameter name="@aktivno" value="#chkAktivno" />
			</data>

		</datalist>

	</form>

</root>