<root version="1.0.0.1">
	<form name="frmPregledPartneraPoKlasama" type="master" caption="Partneri po klasama" maximized="true" statusbar="true">
		<event type="init"> 
			<action type="datarun reader" value="~dtPoKlasama" />
		</event>
		<event type="load">	
			<action type="control populate" value="#grdStavke"/>
			<action type="variable value">
				<parameter name="BrRedova" value="#grdStavke.rowcount" type="int"/>
			</action>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >

			<group cols="1" rows="2" groupbordervisible="false">

				<group cols="3" rows="1" col="1" row="1" groupbordervisible="true">
					<columnsdefinition>
						<column size="20%" position="1" />
						<column size="20%" position="2" />
						<column size="60%" position="3" />
					</columnsdefinition>

					<item col="1" row="1"  textposition="top" caption="Izvještaj:" >
						<comboedit name="cmbPoKlasama" autopopulate="true" valuefield="KLId" displayfield="Opis" datavalue="~dtPoKlasama.@KLId" dataname="dtPoKlasama">
							<event type="valuechanged">
								<action type="control populate" value="#grdStavke"/>
							</event>
						</comboedit>
					</item>
				</group>

				<group caption="Stavke" padding="0" groupbordervisible="true" cols="1" rows="1" col="1" row="2">
					<item row="1" col="1" highlight="False" >
						<grid name="grdStavke" multiselect="true" key="LnId" printcaptionalign="left" printcaption="Pregled partnera po klasama" showgrouppanel="true" showfooter="false" savelayout="true">												
							<data command="dbo.spC_PartnerBezKlase">
								<parameter name="@Action" value="2" if="#cmbPoKlasama==1"/>
								<parameter name="@Action" value="1" else=""/>
							</data>
							<fields>	
								<field name="sifra" caption="Šifra" />
								<field name="Partner" caption="Partner" />
								<field name="klasa" caption="Klasa"/>
								<field name="Sjediste" caption="Sjedište" />
								<field name="Adresa" caption="Adresa" />
								<field name="Maticnibroj" caption="Matični broj" />
								<field name="OIB" caption="OIB" />
								<field name="Telefon1" caption="Telefon1" />
								<field name="Telefon2" caption="Telefon2" />
								<field name="Fax" caption="Fax"/>
								<field name="WWW" caption="WWW"/>
								<field name="Email" caption="Email"/>
								<field name="Ziro" caption="Žiro"/>
								<field name="TekuciRN" caption="TekućiRN"/>
								<field name="MIBPG" caption="MIBPG"/>
							</fields>
							
							<event type="focusedrowchanged" >
							     <action type="control value" value="#lblNivo">
								   <parameter value="Broj stavki u gridu: {#grdStavke.rowcount}.">
								   </parameter>
								 </action>
							</event>

						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<actionpanel>
			<items>
				<item>
					<labeledit name="lblNivo" width="250" fontbold="true"/> 
				</item>	
			</items>
		</actionpanel>
		<datalist>

			<data command="spC_PartnerBezKlase" name="dtPoKlasama">
				<parameter name="@Action" value="3" />
			</data>	

		</datalist>
	</form>
</root>