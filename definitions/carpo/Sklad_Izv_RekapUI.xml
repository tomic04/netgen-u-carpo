<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
	<form name="frmMaster" type="master" caption="Rekapitulacija ulaza i izlaza">
		<event type="load">	
			<action type="form open" value="frmFilter" />
			<action type="control populate" value="#grdMaster" if="#tabs.selectedtab==Roba&amp;&amp;Global.$RefreshRoba==1"/>
			<action type="control populate" value="#grdAnalitika" if="#tabs.selectedtab==Analitika&amp;&amp;Global.$RefreshAnalitika==1"/>
			<action type="control populate" value="#grdRekapPartner" if="#tabs.selectedtab==Partner&amp;&amp;Global.$RefreshPartner==1"/>	
			<action type="variable value" if="#tabs.selectedtab==Analitika">
				<parameter name="Global.RefreshAnalitika" value="0" />
			</action>
			<action type="variable value" if="#tabs.selectedtab==Roba">
				<parameter name="Global.RefreshRoba" value="0" />
			</action>
			<action type="variable value" if="#tabs.selectedtab==Partner">
				<parameter name="Global.RefreshPartner" value="0" />
			</action>			
		</event>		
		<managerlayout>
            <tabs name="tabs" type="master">
				<event type="selectedtabchanged">
					<action type="control populate" value="#grdMaster" if="#tabs.selectedtab==Roba&amp;&amp;Global.$RefreshRoba==1"/>
					<action type="control populate" value="#grdAnalitika" if="#tabs.selectedtab==Analitika&amp;&amp;Global.$RefreshAnalitika==1"/>
					<action type="control populate" value="#grdRekapPartner" if="#tabs.selectedtab==Partner&amp;&amp;Global.$RefreshPartner==1"/>
					<action type="variable value" if="#tabs.selectedtab==Analitika">
						<parameter name="Global.RefreshAnalitika" value="0" />
					</action>
					<action type="variable value" if="#tabs.selectedtab==Roba">
						<parameter name="Global.RefreshRoba" value="0" />
					</action>
					<action type="variable value" if="#tabs.selectedtab==Partner">
						<parameter name="Global.RefreshPartner" value="0" />
					</action>
				</event>			
                <tab caption="Rekapitulacija po robi" name="Roba">
                    <grid name="grdMaster" autopopulate="false" type="master" dataname="Global.dtGrid" async="true" bestfitonrefresh="true" savelayout="true" multiselect="true">
						<!-- <event type="focusedrowchanged"> -->
							<!-- <action type="control disable" value="#btnKartica" if="#grdMaster.rowcount==0||#grdMaster.@robaid==" /> -->
							<!-- <action type="control enable" value="#btnKartica" else="" /> -->
						<!-- </event>						 -->
						<partsql name="partGrid" dataname="~dtPartGrid"></partsql>
						<event type="doubleclick">
							<partsql name="partBtnKartica" dataname="~dtPartBtnKartica"></partsql>
						</event>
						<print header="Promet artikla za razdoblje od {global.$DatumOd::dd.MM.yyyy.} do {global.$DatumDo::dd.MM.yyyy.}\n\n" subheader="" captionalign="" headeralign="center" subheaderalign="" headerscale=""/>												
					</grid>
                </tab>
                <tab caption="Analitika" name="Analitika">
                    <grid name="grdAnalitika" dataname="Global.dtGrid" async="true" bestfitonrefresh="true" savelayout="true" multiselect="true" layoutname="">
						<partsql name="partGrid" dataname="~dtPartGrid"></partsql>
						<event type="doubleclick">
							<partsql name="partBtnKartica" dataname="~dtPartBtnKartica"></partsql>
						</event>
						<print header="Promet artikla za razdoblje od {global.$DatumOd::dd.MM.yyyy.} do {global.$DatumDo::dd.MM.yyyy.}\n\n" subheader="" captionalign="" headeralign="center" subheaderalign="" headerscale=""/>												
                    </grid>
                </tab>
                <tab caption="Rekapitulacija po partneru" name="Partner">
                    <grid name="grdRekapPartner" dataname="Global.dtGrid" async="true" bestfitonrefresh="true" savelayout="true" multiselect="true">
						<partsql name="partGrid" dataname="~dtPartGrid"></partsql>
						<event type="doubleclick">
							<partsql name="partBtnKartica" dataname="~dtPartBtnKartica"></partsql>
						</event>		
						<print header="Promet artikla za razdoblje od {global.$DatumOd::dd.MM.yyyy.} do {global.$DatumDo::dd.MM.yyyy.}\n\n" subheader="" captionalign="" headeralign="center" subheaderalign="" headerscale=""/>												
                    </grid>
                </tab>			
            </tabs>
		</managerlayout>
		<panelbuttons>		
			<buttons>
				<button name="btnFilter" caption="Filter">
					<event type="click">
						<action type="form open" value="frmFilter" />
						<action type="control populate" value="#grdMaster" if="#tabs.selectedtab==Roba&amp;&amp;Global.$RefreshRoba==1"/>
						<action type="control populate" value="#grdAnalitika" if="#tabs.selectedtab==Analitika&amp;&amp;Global.$RefreshAnalitika==1"/>
						<action type="control populate" value="#grdRekapPartner" if="#tabs.selectedtab==Partner&amp;&amp;Global.$RefreshPartner==1"/>
						<action type="variable value" if="#tabs.selectedtab==Analitika">
							<parameter name="Global.RefreshAnalitika" value="0" />
						</action>
						<action type="variable value" if="#tabs.selectedtab==Roba">
							<parameter name="Global.RefreshRoba" value="0" />
						</action>
						<action type="variable value" if="#tabs.selectedtab==Partner">
							<parameter name="Global.RefreshPartner" value="0" />
						</action>
						<action type="control datasource empty" value="#grdMaster" if="#tabs.selectedtab==Partner&amp;&amp;Global.$RefreshRoba==1"/>
						<action type="control datasource empty" value="#grdMaster" if="#tabs.selectedtab==Analitika&amp;&amp;Global.$RefreshRoba==1"/>
						<action type="control datasource empty" value="#grdAnalitika" if="#tabs.selectedtab==Partner&amp;&amp;Global.$RefreshAnalitika==1"/>
						<action type="control datasource empty" value="#grdAnalitika" if="#tabs.selectedtab==Roba&amp;&amp;Global.$RefreshAnalitika==1"/>
						<action type="control datasource empty" value="#grdRekapPartner" if="#tabs.selectedtab==Analitika&amp;&amp;Global.$RefreshPartner==1"/>
						<action type="control datasource empty" value="#grdRekapPartner" if="#tabs.selectedtab==Roba&amp;&amp;Global.$RefreshPartner==1"/>						
					</event>
				</button>
				<button name="btnKartica" caption="Kartica" >
					<event type="click" >
						<partsql name="partBtnKartica" dataname="~dtPartBtnKartica"></partsql>
					</event>
				</button>
			</buttons>
		</panelbuttons>		
	</form>	
	<form name="frmFilter" caption="Filter" >	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="13" col="1" row="1">	
				<group col="1" row="1" cols="3" rows="1" groupbordervisible="false">
					<columnsdefinition>
						<column size="180" position="1" />
						<column size="180" position="2" />
						<column size="80" position="3" />
					</columnsdefinition>
					<rowsdefinition>
						<row size="30" position="1" />
					</rowsdefinition>
					<item caption="Datum od:" row="1" col="1" textalignmode="left" textposition="left">
						<dateedit name="datDatumOd" value="now" savevalue="app">
							<!-- <event type="leave"> -->
								<!-- <action type="datarun scalar" value="Global.dtProvjeriDatume"> -->
									<!-- <parameter name="GodinaRazlika"/> -->
								<!-- </action> -->
								<!-- <action type="control disable" value="#btnPokazi" if="$GodinaRazlika==1"/> -->
								<!-- <action type="control enable" value="#btnPokazi" else=""/> -->
							<!-- </event> -->
						</dateedit>
					</item>
					<item caption="Datum do:" row="1" col="2" textalignmode="left" textposition="left">
						<dateedit name="datDatumDo" value="now" savevalue="app">
							<!-- <event type="leave"> -->
								<!-- <action type="datarun scalar" value="Global.dtProvjeriDatume"> -->
									<!-- <parameter name="GodinaRazlika"/> -->
								<!-- </action> -->
								<!-- <action type="control disable" value="#btnPokazi" if="$GodinaRazlika==1"/> -->
								<!-- <action type="control enable" value="#btnPokazi" else=""/> -->
								<!-- <action type="message" value="Odabrani datumi moraju biti iz iste godine" if="$GodinaRazlika==1"/> -->
							<!-- </event> -->
						</dateedit>
					</item>
					<item caption="" row="1" col="3" textalignmode="left">
						<part name="prtBtnRazdoblje" path="prtBtnRazdoblje.xml"/>
					</item>
				</group>
				<item caption="Skladište:" row="2" col="1" textalignmode="left" textposition="left">
					<combomultiedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="Global.dtSkladiste" showmultiselecttext="true" savevalue="app"/>
				</item>
				<item caption="Vrsta dokumenta:" row="3" col="1" textalignmode="left" textposition="left">
					<combomultiedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" dataname="Global.dtVrstaDok" showmultiselecttext="true" savevalue="app"/>
				</item>					
				<item caption="Roba:" textvisible="" row="4" col="1" fontsizedelta="1" textalignmode="left" textposition="left">
					<searchedit netgenfields="true" savelayout="true" name="srcRoba" fontbold="false" dataname="Global.dtRoba" fieldtext="NazivId" fieldvalue="robaid" entermovenextcontrol="false" savevalue="app">
					</searchedit>
				</item>	
				<group col="1" row="5" cols="2" rows="1" groupbordervisible="false">
					<columnsdefinition>
						<column size="360" position="1" />
						<column size="70" position="2" />
					</columnsdefinition>
					<rowsdefinition>
						<row size="30" position="1" />
						<row size="30" position="2" />
					</rowsdefinition>				
					<item caption="Org. shema:" row="1" col="1" textalignmode="left" textposition="left">
						<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="Global.dtOrgShema" showmultiselecttext="true" savevalue="app"/>
					</item>			
					<item caption="" row="1" col="2" highlight="false">
						<checkedit caption="i ispod" name="chkOrgShemaIspod" savevalue="app"/>
					</item>
				</group>	
				<group col="1" row="6" cols="2" rows="2" groupbordervisible="false">
					<columnsdefinition>
						<column size="360" position="1" />
						<column size="70" position="2" />
					</columnsdefinition>
					<rowsdefinition>
						<row size="30" position="1" />
						<row size="30" position="2" />
					</rowsdefinition>
					<item caption="Klasa:" row="1" col="1" textalignmode="left" textposition="left">
						<combotreeedit name="cmbKlasa" valuefield="ID" displayfield="Naziv" dataname="Global.dtKlMasterRoba" savevalue="app"/>
					</item>
					<item caption="" row="1" col="2" highlight="false">
						<checkedit caption="i ispod" name="chkKlasaIspod" savevalue="app"/>
					</item>
					<item caption="Dodatna klasa:" row="2" col="1" colspan="2" textalignmode="left" textposition="left">
						<comboedit name="cmbDodatnaKlasa" valuefield="ID" displayfield="Naziv" dataname="Global.dtDodKlasa" savevalue="app"/>
					</item>
				</group>
				<item caption="Partner:" textvisible="" row="7" col="1" textalignmode="left" textposition="left">
					<searchedit netgenfields="true" name="srcPartner" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" savevalue="app"/>
				</item>
				<item caption="Cjenik:" row="8" col="1" textalignmode="left" textposition="left">
					<comboedit name="cmbCjenik" valuefield="VrCjenikId" displayfield="Opis" dataname="Global.dtVrCjenik" function="Cjenik" savevalue="app"/>
				</item>	
				<item caption="Trgovina:" row="9" col="1" textalignmode="left" textposition="left">
					<comboedit name="cmbTrgovina" valuefield="trgovinaid" displayfield="naziv" dataname="Global.dtTrgovina" savevalue="app"/>
				</item>
				<item caption="Radni nalog:" textvisible="" row="10" col="1" textalignmode="left" textposition="left">
					<searchedit netgenfields="true" name="srcRadniNalog" dataname="Global.dtRadniNalog" fieldtext="NazivId" fieldvalue="PrnRadniNalogId" savevalue="app"/>
				</item>	
				<item caption="Na skladište:" row="11" col="1" textalignmode="left" textposition="left">
					<comboedit name="cmbNaSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="Global.dtNaSkladiste" savevalue="app"/>
				</item>	
				<item caption="Dodatna JM:" row="12" col="1" textalignmode="left" textposition="left">
					<comboedit name="cmbDodatnaJM" valuefield="JmId" displayfield="Naziv" dataname="Global.dtDodatnaJM" savevalue="app"/>
				</item>
				<item caption="" row="13" col="1" textalignmode="left" textposition="left">
					<checkedit caption="Pokaži trenutno stanje" name="chkTrenutnoStanje" savevalue="app" function="TrenutnoStanje"/>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrihvati" caption="Prikaži">
					<event type="click">
						<action type="validate"/>
						<action type="variable value" >
							<parameter name="global.$DatumOd" value="#datDatumOd" type="date"/>
							<parameter name="global.$DatumDo" value="#datDatumDo" type="date"/>
							<parameter name="global.$NizSkladista" value="#cmbSkladiste"/>
							<parameter name="global.$NizVrstaDok" value="#cmbVrstaDok"/>							
							<parameter name="global.$RobaId" value="#srcRoba"/>	
							<parameter name="global.$DodatnaKlasa" value="#cmbDodatnaKlasa"/>	
							<parameter name="global.$PartneriId" value="#srcPartner"/>
							<parameter name="global.$VrCjenikId" value="#cmbCjenik"/>
							<parameter name="global.$TrgovinaId" value="#cmbTrgovina"/>
							<parameter name="global.$RadniNalog" value="#srcRadniNalog"/>
							<parameter name="global.$NaSkladisteId" value="#cmbNaSkladiste"/>
							<parameter name="global.$DodatnaJM" value="#cmbDodatnaJM"/>
							<parameter name="global.$TrenutnoStanje" value="#chkTrenutnoStanje"/>
							<parameter name="global.$OrgShemaSortkey" value="#cmbOrgShema.@sortkey"/>
							<parameter name="global.$KlasaSortkey" value="#cmbKlasa.@sortkey"/>
							<parameter name="global.$OrgShemaIspod" value="#chkOrgShemaIspod"/>
							<parameter name="global.$KlasaIspod" value="#chkKlasaIspod"/>
						</action>							
						<action type="variable value">
							<parameter name="Global.RefreshAnalitika" value="1" />
							<parameter name="Global.RefreshRoba" value="1" />
							<parameter name="Global.RefreshPartner" value="1" />
						</action>						
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>	
		<datalist>
		    <data command="spDatumi" name="dtDajDatum">
				<parameter name="@action" value="$varDatAction" />
			</data>	
		</datalist>		
	</form>
	<form name="frmPrikazDok" path="KomStanjeSkladista.frmPrikazDok.xml"></form>	
	<form name="frmKartica" caption="Kartica artikla: {$Sifra} - {$Naziv} (JM: {$JM})" 
	fixedsize="false" width="950" height="570">
		<partsql name="partKartica" dataname="~dtPartKartica"></partsql>
	</form>	
	<datalist>
		<data command="spKomercStanjeSklad_PartKartica" name="dtPartKartica">		
			<parameter name="@Granula" value="Sklad_Izv_RekapUI"/>
			<parameter name="@OperateriId" value="@@OperateriId"/>
		</data>	
		<data command="spSklad_Izv_RekapUI_PartGrid" name="dtPartGrid">		
			<parameter name="@Granula" value="Sklad_Izv_RekapUI"/>
			<parameter name="@OperateriId" value="@@OperateriId"/>
		</data>
		<data command="spSklad_Izv_RekapUI_PartBtnKartica" name="dtPartBtnKartica">		
			<parameter name="@Granula" value="Sklad_Izv_RekapUI"/>
			<parameter name="@OperateriId" value="@@OperateriId"/>
		</data>		
		<data command="spNG_Combo" name="dtVrCjenik">
			<parameter name="@Action" value="VrCjenik"/>
			<parameter name="@Order" value="IndMaster desc, Opis"/>
		</data>
		<data command="spNG_Combo" name="dtTrgovina">
			<parameter name="@Action" value="Trgovina"/>
		</data>	
		<data command="spTraziRadniNalogNET" name="dtRadniNalog">
			<parameter name="@Uvjet" value="#srcRadniNalog.text" />
		</data>	
		<data command="spNG_Combo" name="dtOrgShema">
			<parameter name="@Action" value="orgshema" />
			<parameter name="@Ind" value="1" />
			<parameter name="@ime_kontrole" value="ID" />
		</data>	
		<data command="spNG_Combo" name="dtKlMasterRoba">
		  <parameter name="@Action" value="KlMasterRoba"/>
		  <parameter name="@Ind" value="1"/>
		  <parameter name="@ime_kontrole" value="ID"/>
		</data>	
		<data command="spNG_Combo" name="dtDodKlasa">
		  <parameter name="@Action" value="DodatnaKlasa"/>
		  <parameter name="@Ind" value="1"/>
		  <parameter name="@ime_kontrole" value="ID"/>
		  <parameter name="@order" value="Naziv"/>
		</data>
		<data command="spTraziPartneri" name="dtPartneri">
		  <parameter name="@Action" value="Partneri"/>
		  <parameter name="@Uvjet" value="#srcPartner.text"/>
		</data>	
		<data command="spNG_Combo" name="dtSkladiste">
			<parameter name="@Action" value="skladiste"/>
			<parameter name="@Ind" value="1"/>
			<parameter name="@Oznaka" value="viSkladistaPravaIzvjestaji"/>
		</data>	
		<data command="spNG_Combo" name="dtNaSkladiste">
			<parameter name="@Action" value="skladiste" />
			<parameter name="@Ind" value="1" />
			<parameter name="@oznaka" value="viSkladistaPravaIzvjestaji"/>	
		</data>	
		<data command="spSklad_Izv_RekapUI_VrstaDok" name="dtVrstaDok">
			<parameter name="@operateriid" value="@@operateriid" />
			<parameter name="@granula" value="Sklad_Izv_RekapUI" />
		</data>
		<data command="spTraziRoba" name="dtRoba">
			<parameter name="@action" value="Roba"/>		
			<parameter name="@Uvjet" value="#srcRoba.text"/>
			<parameter name="@PokaziNabCijene" value="0"/>
			<parameter name="@Retired" value="0"/>
			<parameter name="@Prikazi_Dodatno" value="1"/>
			<parameter name="@PokaziStanje" value="0"/>
		</data>		
		<data command="spNG_Combo" name="dtDodatnaJM">
		  <parameter name="@Action" value="DodatnaJm"/>
		  <parameter name="@Ind" value="1"/>
		</data>
		<data command="spSktIzvPrometPeriod" name="dtGrid" timeout="60">
			<parameter name="@datumod" value="global.$DatumOd" />
			<parameter name="@datumdo" value="global.$DatumDo" />
			<parameter name="@robaid" value="global.$RobaId" />
			<parameter name="@partneriid" value="global.$PartneriId" />
			<parameter name="@PrnRadniNalogId" value="global.$RadniNalog" />
			<parameter name="@skladiste2id" value="global.$NaSkladisteId" />
			<parameter name="@trgovinaid" value="global.$TrgovinaId" />			
			<parameter name="@jmid" value="global.$DodatnaJM" />
			<parameter name="@VrCjenikId" value="global.$VrCjenikId" />
			<parameter name="@klklrobaid" value="global.$DodatnaKlasa" />
			<parameter name="@trenutno_stanje" value="1" if="global.$TrenutnoStanje==True" />
			<parameter name="@trenutno_stanje" value="0" else=""/>
			<parameter name="@klasa_ispod" value="1" if="global.$KlasaIspod==True" />
			<parameter name="@klasa_ispod" value="0" else=""/>
			<parameter name="@orgshema_ispod" value="1" if="global.$OrgShemaIspod==True" />
			<parameter name="@orgshema_ispod" value="0" else=""/>
			<parameter name="@sortkey" value="global.$KlasaSortkey" />	
			<parameter name="@orgshema" value="global.$OrgShemaSortkey" />			
			<parameter name="@ListaID" value="global.$NizVrstaDok" />			
			<parameter name="@strskl" value="global.$NizSkladista" />
			<parameter name="@sva_skladista" value="0" />
			<parameter name="@po_partnerima" value="1" if="#tabs.selectedtab==Partner"/>
			<parameter name="@po_partnerima" value="0" else=""/>
			<parameter name="@Analitika" value="1" if="#tabs.selectedtab==Analitika"/>
			<parameter name="@Analitika" value="0" if="#tabs.selectedtab==Roba"/>
			<parameter name="@IndCarpo" value="1"/>
			<parameter name="@OperateriId" value="@@operateriid"/>
		</data>	
	</datalist>	
</root>