<?xml version="1.0" encoding="utf-8"?>
<!-- Granula Sport Demo - podaci iz SportDemo.sql (CarpoBot_Countries, Sports, Leagues, Clubs, Players, Matches) -->
<root loglevel="3" version="1.0.0">
	<form name="frmSportDemo" type="master" caption="Sport Demo">
		<event type="shown">
			<!-- Kontrole unutar tabova nisu još registrirane na shown – punjenje u selectedtabchanged -->
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1" groupbordervisible="false">
				<tabs name="tabs" padding="4">
					<event type="selectedtabchanged">
						<action type="control populate" value="#grdSports" if="#tabs.selectedtab==tabSportovi"/>
						<action type="control populate" value="#cmbSport" if="#tabs.selectedtab==tabKlubovi"/>
						<action type="control populate" value="#grdClubs" if="#tabs.selectedtab==tabKlubovi"/>
						<action type="control populate" value="#cmbClub" if="#tabs.selectedtab==tabIgrači"/>
						<action type="control populate" value="#grdPlayers" if="#tabs.selectedtab==tabIgrači"/>
					</event>
					<tab name="tabSportovi" caption="Sportovi">
						<group cols="1" rows="1" groupbordervisible="false">
							<item col="1" row="1">
								<grid name="grdSports" dataname="~dtSports" bestfitonrefresh="true" showautofilterrow="true" showgrouppanel="false">
									<fields>
										<field name="SportId" caption="Id" minwidth="60" visible="true"/>
										<field name="SportName" caption="Sport" minwidth="150"/>
									</fields>
								</grid>
							</item>
						</group>
					</tab>
					<tab name="tabKlubovi" caption="Klubovi">
						<group cols="1" rows="3" groupbordervisible="false" caption="Klubovi po sportu">
							<item col="1" row="1" caption="Sport">
								<comboedit name="cmbSport" dataname="~dtSports" valuefield="SportId" displayfield="SportName"/>
							</item>
							<item col="1" row="2">
								<button name="btnPrikaziClubs" caption="Prikaži klubove">
									<event type="click">
										<action type="control populate" value="#grdClubs"/>
									</event>
								</button>
							</item>
							<item col="1" row="3">
								<grid name="grdClubs" dataname="~dtClubs" bestfitonrefresh="true" showautofilterrow="true" showgrouppanel="false">
									<fields>
										<field name="ClubId" caption="Id" minwidth="50" visible="true"/>
										<field name="ClubName" caption="Klub" minwidth="150"/>
										<field name="SportName" caption="Sport" minwidth="100"/>
										<field name="CountryName" caption="Država" minwidth="100"/>
										<field name="FoundedYear" caption="Osnovan" minwidth="80"/>
									</fields>
								</grid>
							</item>
						</group>
					</tab>
					<tab name="tabUtakmice" caption="Utakmice">
						<group cols="1" rows="4" groupbordervisible="false" caption="Utakmice po razdoblju">
							<item col="1" row="1" caption="Datum od">
								<dateedit name="datOd"/>
							</item>
							<item col="1" row="2" caption="Datum do">
								<dateedit name="datDo"/>
							</item>
							<item col="1" row="3">
								<button name="btnPrikaziMatches" caption="Prikaži utakmice">
									<event type="click">
										<action type="control populate" value="#grdMatches"/>
									</event>
								</button>
							</item>
							<item col="1" row="4">
								<grid name="grdMatches" dataname="~dtMatches" bestfitonrefresh="true" showautofilterrow="true" showgrouppanel="false">
									<fields>
										<field name="MatchId" caption="Id" minwidth="50" visible="true"/>
										<field name="MatchDate" caption="Datum" minwidth="90"/>
										<field name="LeagueName" caption="Liga" minwidth="120"/>
										<field name="HomeClub" caption="Domaćin" minwidth="120"/>
										<field name="AwayClub" caption="Gost" minwidth="120"/>
										<field name="HomeScore" caption="Golovi dom." minwidth="70"/>
										<field name="AwayScore" caption="Golovi gost." minwidth="70"/>
									</fields>
								</grid>
							</item>
						</group>
					</tab>
					<tab name="tabIgrači" caption="Igrači">
						<group cols="1" rows="3" groupbordervisible="false" caption="Igrači po klubu">
							<item col="1" row="1" caption="Klub">
								<comboedit name="cmbClub" dataname="~dtClubsAll" valuefield="ClubId" displayfield="ClubName"/>
							</item>
							<item col="1" row="2">
								<button name="btnPrikaziPlayers" caption="Prikaži igrače">
									<event type="click">
										<action type="control populate" value="#grdPlayers"/>
									</event>
								</button>
							</item>
							<item col="1" row="3">
								<grid name="grdPlayers" dataname="~dtPlayers" bestfitonrefresh="true" showautofilterrow="true" showgrouppanel="false">
									<fields>
										<field name="PlayerId" caption="Id" minwidth="50" visible="true"/>
										<field name="FirstName" caption="Ime" minwidth="100"/>
										<field name="LastName" caption="Prezime" minwidth="120"/>
										<field name="BirthDate" caption="Datum rođ." minwidth="90"/>
										<field name="Position" caption="Pozicija" minwidth="90"/>
										<field name="ShirtNumber" caption="Broj dresa" minwidth="80"/>
									</fields>
								</grid>
							</item>
						</group>
					</tab>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOsvjezi" caption="&amp;OSVJEŽI">
					<event type="click">
						<action type="control populate" value="#grdSports"/>
						<action type="control populate" value="#cmbSport"/>
						<action type="control populate" value="#cmbClub"/>
						<action type="control populate" value="#grdClubs"/>
						<action type="control populate" value="#grdMatches"/>
						<action type="control populate" value="#grdPlayers"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSports" command="spCarpoBot_Sports_GetAll"/>
			<data name="dtClubs" command="spCarpoBot_Clubs_BySport">
				<parameter name="@SportId" value="#cmbSport"/>
			</data>
			<data name="dtClubsAll" command="spCarpoBot_Clubs_GetAll"/>
			<data name="dtMatches" command="spCarpoBot_Matches_ByDate">
				<parameter name="@DateFrom" value="#datOd"/>
				<parameter name="@DateTo" value="#datDo"/>
			</data>
			<data name="dtPlayers" command="spCarpoBot_Players_ByClub">
				<parameter name="@ClubId" value="#cmbClub"/>
			</data>
		</datalist>
	</form>
</root>
