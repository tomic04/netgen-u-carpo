<root>
	<form name="frmMain" type="master" caption="Tip operacije">
		<managerlayout>
			<grid name="grdMaster" type="master" dataname="~dtMaster" key="OOPTipOperacijeId">
				<fields inherited="true"/>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="form open" value="frmDodajIzmijeni"/>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni">
					<event type="click">
						<action type="form open" value="frmDodajIzmijeni">
							<parameter name="OOPTipOperacijeId" value="#grdMaster.@OOPTipOperacijeId"/>
						</action>
					</event>
				</button>
				<button name="btnObriši" caption="Obriši">
					<event type="click">
						<action type="confirm" value="Želite li obrisati postojeći zapis?">
							<action type="datarun nonquery" value="~dtObrisi"/>
							<action type="control populate" value="#grdMaster"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spOOPTipOperacijeQuery">
				<parameter name="@action" value="0"/>
			</data>
			<data name="dtObrisi" command="spOOPTipOperacijeAzur">
				<parameter name="@action" value="2"/>
				<parameter name="@OOPTipOperacijeId" value="#grdMaster.@OOPTipOperacijeId"/>
			</data>
		</datalist>
	</form>
	<form name="frmDodajIzmijeni" caption="Parametar">
		<event type="init">
			<action type="datarun reader" value="~dtPopuni" if="$OOPTipOperacijeId!=null"/>
			<action type="datarun scalar" value="~dtmaxlengthNAZIV">
				<parameter name="maxlengthNAZIV" value="~dtmaxlengthNAZIV.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>
		</event>
		<layout>
			<group rows="5" cols="1">
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtPopuni.@Naziv" maxlength="$maxlengthNAZIV"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action if="$OOPTipOperacijeId==null">
							<action type="datarun nonquery" value="~dtDodaj">
								<parameter name="FocusId"/>
							</action>
							<action type="control populate" value="parent.#grdMaster">
								<action type="control focus" value="parent.#grdMaster">
									<parameter value="$FocusId" type="int"/>
								</action>
							</action>
							<action type="control value" value="##">
								<parameter value=""/>
							</action>
						</action>
						<action else="$OOPTipOperacijeId!=null">
							<action type="datarun nonquery" value="~dtIzmjeni"/>
							<action type="control populate keepfocus" value="parent.#grdMaster"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDodaj" command="spOOPTipOperacijeAzur">
				<parameter name="@action" value="0"/>
				<parameter name="@Naziv" value="#txtNaziv" />
			</data>
			<data name="dtIzmjeni" command="spOOPTipOperacijeAzur">
				<parameter name="@action" value="1"/>
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@OOPTipOperacijeId" value="$OOPTipOperacijeId"/>
			</data>
			<data name="dtPopuni" command="spOOPTipOperacijeQuery">
				<parameter name="@action" value="1"/>
				<parameter name="@OOPTipOperacijeId" value="$OOPTipOperacijeId"/>
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthNAZIV">
				<parameter name="@table_name" value="OOPTipOperacije" />
				<parameter name="@column_name" value="Naziv" />
			</data>
		</datalist>
	</form>
</root>
