<parts>
	<part name="partDodatnaJM">
		<event type="init">
			<action type="datarun reader" value="~dtLoadJM" if="$JMRobaId!=null" />
			<action type="datarun scalar" value="~dtmaxlengthBarkod">
				<parameter name="maxlengthBarkod" value="~dtmaxlengthBarkod.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
			<action type="datarun reader" value="~dtFiksniFaktor" />
		</event>
		<event type="shown">
			<action type="control disable" value="#chkFKFix" if="~dtFiksniFaktor.@FiksniFaktor!=1" />
			<action type="control enable" value="#chkFKFix" if="~dtFiksniFaktor.@FiksniFaktor==1" />
		</event>
		<layout itemspadding="1" textposition="left">
			<group rows="1" cols="2" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="50%" />
					<column position="2" size="50%" />
				</columnsdefinition>
				<group row="1" col="1" rows="8" cols="3" rowspan="2" groupbordervisible="false">
					<item row="1" col="1" caption="Jedinica mjere:" colspan="3" spacing="5,0,5,5">
						<comboedit name="cmbJM" dataname="~dtJM" valuefield="JMId" displayfield="Naziv" datavalue="~dtLoadJM.@JmId" datatext="~dtLoadJM.@JM" required="true" />
					</item>
					<item row="2" col="1" caption="Barkod:" colspan="3" spacing="5,0,5,5">
						<textedit name="txtJMBarkod" value=" " datavalue="~dtLoadJM.@JMBarcode" maxlength="$maxlengthBarkod" allownull="false" />
					</item>
					<item row="3" col="1" textposition="right" spacing="5,0,5,5">
						<checkedit name="chkFKFix" caption="Fiksni faktor konverzije" value="true" datavalue="~dtLoadJM.@FaktorFix" />
					</item>
					<item row="4" col="1" caption="Faktor konverzije:" colspan="3" spacing="5,0,5,5">
						<textedit name="txtFK" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@Faktor" allownull="false" tooltip="Faktor konverzije govori koliko osnovne jedinice mjere se nalazi u odabranoj dodatnoj jedinici mjere." />
					</item>
					<item row="5" col="1" caption="Vezana roba:" colspan="3" spacing="5,0,5,5">
						<searchedit name="srcVezanaRoba" dataname="~dtVezanaRoba" fieldvalue="RobaId" fieldtext="Roba" datavalue="~dtLoadJM.@VezanaRobaId" datatext="~dtLoadJM.@VezanaRoba" savelayout="true" />
					</item>
					<item row="6" col="1" caption="Ambalaža povratna:" colspan="3" spacing="5,0,5,5">
						<searchedit name="srcAmbPov" dataname="~dtAmbPov" fieldvalue="RobaId" fieldtext="Roba" datavalue="~dtLoadJM.@PovratRobaId" datatext="~dtLoadJM.@PovratRoba" savelayout="true" />
					</item>
					<item row="7" col="1" caption="Ambalaža nepovratna:" colspan="3" spacing="5,0,5,5">
						<searchedit name="srcAmbNepov" dataname="~dtAmbNePov" fieldvalue="RobaId" fieldtext="Roba" datavalue="~dtLoadJM.@NepovratRobaId" datatext="~dtLoadJM.@NepovratRoba" savelayout="true" />
					</item>
					<item row="8" col="1" textposition="right" spacing="5,0,5,5">
						<checkedit name="chkCijenaJM" caption="Cijena za JM" datavalue="~dtLoadJM.@CijenaInd" />
					</item>
					<item row="8" col="2" textposition="right" spacing="0,5,5,5">
						<checkedit name="chkManJM" caption="Manipulativna JM" datavalue="~dtLoadJM.@DefaultInd" tooltip="Samo jedna dodatna jedinica mjere može biti manipulativna. " />
					</item>
					<item row="8" col="3" textposition="right" spacing="25,0,5,5">
						<checkedit name="chkWMS" caption="WMS" datavalue="~dtLoadJM.@WMS" />
					</item>
				</group>
				<group caption="Gabariti" row="1" col="2" rows="5" cols="1" spacing="20,0,0,5">
					<item row="1" col="1" caption="Težina:" spacing="5,5,10,10">
						<textedit name="txtTezina" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@JMTezina" allownull="false" />
					</item>
					<item row="2" col="1" caption="Dužina:" spacing="5,5,10,10">
						<textedit name="txtDuzina" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@JMDuzina" allownull="false" />
					</item>
					<item row="3" col="1" caption="Širina:" spacing="5,5,10,10">
						<textedit name="txtSirina" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@JMSirina" allownull="false" />
					</item>
					<item row="4" col="1" caption="Visina:" spacing="5,5,10,10">
						<textedit name="txtVisina" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@JMVisina" allownull="false" />
					</item>
					<item row="5" col="1" caption="Volumen:" spacing="5,5,10,10">
						<textedit name="txtVolumen" value="0" format="n4" type="decimal" datavalue="~dtLoadJM.@JMVolumen" allownull="false" />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun reader" value="~dtJMRoba_Check" />
						<action type="datarun reader" value="~dtJMBarkod">
						</action>
						<action type="variable value">
							<parameter name="JMRoba_Check" value="~dtJMRoba_Check.@JMRobaCheck" />
						</action>
						<action type="variable value">
							<parameter name="AnyBarcode" value="~dtJMBarkod.@AnyBarcode" />
						</action>
						<action if="$JMRobaId!=null">
							<action if="$JMRoba_Check==1">
								<action type="message" value="Nije moguće unijeti odabranu JM! Odabrana JM je definirana kao osnovna JM!" />
							</action>
							<action if="$AnyBarcode==true&amp;&amp;$JMRoba_Check==0">
								<action type="datarun reader" value="~dtPopisBarkoda" />
								<action type="confirm" value="Barkod s tim brojem već postoji na robi:{~dtPopisBarkoda.@StringValue}! Jeste li sigurni da želite svejedno dodati?" />
								<action type="datarun nonquery" value="~dtUpsert" />
								<action type="control populate keepfocus" value="parent.#grdDodatneJm" />
								<action type="form close" />
							</action>
							<action if="$AnyBarcode==false&amp;&amp;$JMRoba_Check==0">
								<action type="datarun nonquery" value="~dtUpsert" />
								<action type="control populate keepfocus" value="parent.#grdDodatneJm" />
								<action type="form close" />
							</action>
						</action>
						<action if="$JMRobaId==null">
							<action if="$JMRoba_Check==1">
								<action type="message" value="Nije moguće unijeti odabranu JM! Odabrana JM je definirana kao osnovna JM!" />
							</action>
							<action if="$AnyBarcode==true&amp;&amp;$JMRoba_Check==0">
								<action type="datarun reader" value="~dtPopisBarkoda" />
								<action type="confirm" value="Barkod s tim brojem već postoji na robi:{~dtPopisBarkoda.@StringValue}! Jeste li sigurni da želite svejedno dodati?" />
								<action type="datarun scalar" value="~dtUpsert">
									<parameter name="parent.$JMRobaId" />
								</action>
								<action type="control populate" value="parent.#grdDodatneJm" />
								<action type="control focus" value="parent.#grdDodatneJm">
									<parameter value="parent.$JMRobaId" />
								</action>
								<action type="form close" />
							</action>
							<action if="$AnyBarcode==false&amp;&amp;$JMRoba_Check==0">
								<action type="datarun scalar" value="~dtUpsert">
									<parameter name="parent.$JMRobaId" />
								</action>
								<action type="control populate" value="parent.#grdDodatneJm" />
								<action type="control focus" value="parent.#grdDodatneJm">
									<parameter value="parent.$JMRobaId" />
								</action>
								<action type="form close" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnIzlaz" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziRoba" name="dtVezanaRoba">
				<parameter name="@action" value="RobaNET" />
				<parameter name="@uvjet" value="#srcVezanaRoba.text" />
			</data>
			<data command="spTraziRoba" name="dtAmbPov">
				<parameter name="@action" value="RobaNET" />
				<parameter name="@uvjet" value="#srcAmbPov.text" />
			</data>
			<data command="spTraziRoba" name="dtAmbNePov">
				<parameter name="@action" value="RobaNET" />
				<parameter name="@uvjet" value="#srcAmbNePov.text" />
			</data>
			<data command="spRobaCarpo_Combo" name="dtJM">
				<parameter name="@action" value="JM" />
			</data>
			<data command="spRobaCarpo_Query" name="dtLoadJM">
				<parameter name="@action" value="6" />
				<parameter name="@JmRobaId" value="$JmRobaId" />
			</data>
			<data command="spRobaCarpo_Azur" name="dtUpsert">
				<parameter name="@action" value="8" if="$JMRobaId==null" />
				<parameter name="@action" value="9" if="$JMRobaId!=null" />
				<parameter name="@Id" value="$RobaId" />
				<parameter name="@JmBarcode" value="#txtJMBarkod" />
				<parameter name="@JMRobaId" value="$JMRobaId" />
				<parameter name="@JMId" value="#cmbJM" />
				<parameter name="@Faktor" value="#txtFK" />
				<parameter name="@CijenaInd" value="#chkCijenaJM" />
				<parameter name="@DefaultInd" value="#chkManJM" />
				<parameter name="@Tezina" value="#txtTezina" />
				<parameter name="@Duzina" value="#txtDuzina" />
				<parameter name="@Sirina" value="#txtSirina" />
				<parameter name="@Visina" value="#txtVisina" />
				<parameter name="@Volumen" value="#txtVolumen" />
				<parameter name="@PovratRobaId" value="#srcAmbPov" />
				<parameter name="@NepovratRobaId" value="#srcAmbNePov" />
				<parameter name="@faktorfix" value="#chkFKFix" />
				<parameter name="@VezanaRobaId" value="#srcVezanaRoba" />
				<parameter name="@WMS" value="#chkWMS" />
			</data>
			<data command="spBarcodeCarpo_Query" name="dtJMBarkod">
				<parameter name="@action" value="6" />
				<parameter name="@Barcode" value="#txtJMBarkod" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@JmRobaId" value="$JMRobaId" />
			</data>
			<data command="spRobaCarpo_Check" name="dtPopisBarkoda">
				<parameter name="@action" value="RobaBarcode_Check" />
				<parameter name="@Barcode" value="#txtJMBarkod" />
				<parameter name="@RobaId" value="$RobaId" />
			</data>
			<data command="spRobaCarpo_Check" name="dtJMRoba_Check">
				<parameter name="@action" value="JMRoba_Check" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@JmId" value="#cmbJM" />
				<parameter name="@PovratRobaId" value="#srcAmbPov" />
				<parameter name="@NepovratRobaId" value="#srcAmbNePov" />
			</data>
			<data command="spRobaCarpo_Check" name="dtFiksniFaktor">
				<parameter name="@action" value="FixFaktorJM" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthBarkod">
				<parameter name="@table_name" value="JmRoba" />
				<parameter name="@column_name" value="JMBarcode" />
			</data>
		</datalist>
	</part>
	<part name="partDodatniBarkod">
		<event type="init">
			<action type="datarun reader" value="~dtLoadDBC" if="$DodatniBarKod!=null" />
			<action type="datarun scalar" value="~dtmaxlengthBarkod">
				<parameter name="maxlengthBarkod" value="~dtmaxlengthBarkod.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
		</event>
		<layout itemspadding="1">
			<group rows="1" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Barkod:">
					<textedit name="txtBarkod" datavalue="~dtLoadDBC.@Barcode" maxlength="$maxlengthBarkod" required="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun reader" value="~dtDodatniBarkod">
						</action>
						<action type="variable value">
							<parameter name="AnyBarcode" value="~dtDodantniBarkod.@AnyBarcode" />
						</action>
						<action if="$DodatniBarKod!=null">
							<action if="$AnyBarcode==true">
								<action type="datarun reader" value="~dtPopisBarkoda" />
								<action type="confirm" value="Barkod s tim brojem već postoji na robi:{~dtPopisBarkoda.@StringValue}! Jeste li sigurni da želite svejedno dodati?" />
								<action type="datarun nonquery" value="~dtUpsert" />
								<action type="control populate keepfocus" value="parent.#grdBarkod" />
								<action type="form close" />
							</action>
							<action if="$AnyBarcode!=true">
								<action type="datarun nonquery" value="~dtUpsert" />
								<action type="control populate keepfocus" value="parent.#grdBarkod" />
								<action type="form close" />
							</action>
						</action>
						<action if="$DodatniBarKod==null">
							<action if="$AnyBarcode==true">
								<action type="datarun reader" value="~dtPopisBarkoda" />
								<action type="confirm" value="Barkod s tim brojem već postoji na robi:{~dtPopisBarkoda.@StringValue}! Jeste li sigurni da želite svejedno dodati?" />
								<action type="datarun scalar" value="~dtUpsert">
									<parameter name="parent.$BarcodeId" />
								</action>
								<!--
								<action type="control populate" value="parent.#grdBarkod"/>
								<action type="control focus" value="parent.#grdBarkod">
								<parameter value="parent.$BarcodeId" type="int"/>
								</action>
								-->
								<action type="form close" />
							</action>
							<action if="$AnyBarcode!=true">
								<action type="datarun scalar" value="~dtUpsert">
									<parameter name="parent.$BarcodeId" />
								</action>
								<!--
								<action type="control populate" value="parent.#grdBarkod"/>
								<action type="control focus" value="parent.#grdBarkod">
								<parameter value="parent.$BarcodeId" type="int"/>
								</action>
								-->
								<action type="form close" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnIzlaz" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spBarcodeCarpo_Query" name="dtLoadDBC">
				<parameter name="@action" value="1" />
				<parameter name="@Id" value="$DodatniBarKod" />
				<parameter name="@RobaID" value="$RobaId" />
			</data>
			<data command="spBarcodeCarpo_Query" name="dtDodatniBarkod">
				<parameter name="@action" value="6" />
				<parameter name="@Barcode" value="#txtBarkod" />
				<parameter name="@RobaId" value="$RobaId" />
			</data>
			<data command="spBarCodeCarpo_Azur" name="dtUpsert">
				<parameter name="@Action" value="1" if="$DodatniBarkod!=null" />
				<parameter name="@Action" value="2" if="$DodatniBarkod==null" />
				<parameter name="@barcode" value="#txtBarkod" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@BarcodeId" value="$DodatniBarKod" />
			</data>
			<data command="spRobaCarpo_Check" name="dtPopisBarkoda">
				<parameter name="@action" value="RobaBarcode_Check" />
				<parameter name="@Barcode" value="#txtBarkod" />
				<parameter name="@RobaId" value="$RobaId" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthBarkod">
				<parameter name="@table_name" value="Barcode" />
				<parameter name="@column_name" value="Barcode" />
			</data>
		</datalist>
	</part>
	<part name="partAlterSifra">
		<event type="init">
			<action type="datarun reader" value="~dtLoadAS" if="$ParAsortimanId!=null" />
			<action type="datarun scalar" value="~dtmaxlengthSifra">
				<parameter name="maxlengthSifra" value="~dtmaxlengthSifra.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
			<action type="datarun scalar" value="~dtmaxlengthNaziv">
				<parameter name="maxlengthNaziv" value="~dtmaxlengthNaziv.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
		</event>
		<event type="load">
			<action type="control disable" value="#srcParAsortiman" if="$ParAsortimanId!=null" />
		</event>
		<layout textposition="left">
			<group rows="3" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Partner:">
					<searchedit name="srcParAsortiman" dataname="~dtAltPartner" fieldvalue="PartneriId" fieldtext="Partner" datavalue="~dtLoadAS.@PartneriId" datatext="~dtLoadAS.@Partner" required="true" savelayout="true" />
				</item>
				<item row="2" col="1" caption="Šifra:">
					<textedit name="txtSifra" datavalue="~dtLoadAS.@Šifra" maxlength="$maxlengthSifra" required="true" />
				</item>
				<item row="3" col="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtLoadAS.@Naziv" maxlength="$maxlengthNaziv" required="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action if="$ParAsortimanId!=null">
							<action type="datarun nonquery" value="~dtUpsert" />
							<action type="control populate keepfocus" value="parent.#grdAltSifra" />
							<action type="form close" />
						</action>
						<action if="$ParAsortimanId==null">
							<action type="datarun scalar" value="~dtUpsert">
								<parameter name="parent.$ParAsortimanId" />
							</action>
							<action type="control populate" value="parent.#grdAltSifra" />
							<action type="control focus" value="parent.#grdAltSifra">
								<parameter value="parent.$ParAsortimanId" />
							</action>
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnIzlaz" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziPartneri" name="dtAltPartner">
				<parameter name="@action" value="PartneriNET" />
				<parameter name="@uvjet" value="#srcParAsortiman.text" />
			</data>
			<data command="spRobaCarpo_Query" name="dtLoadAS">
				<parameter name="@action" value="8" />
				<parameter name="@ParAsortimanId" value="$ParAsortimanId" />
			</data>
			<data command="spRobaCarpo_Azur" name="dtUpsert">
				<parameter name="@action" value="5" if="$ParAsortimanId==null" />
				<parameter name="@action" value="6" if="$ParAsortimanId!=null" />
				<parameter name="@PartneriId" value="#srcParAsortiman" />
				<parameter name="@Id" value="parent.$RobaId" />
				<parameter name="@Sifra" value="#txtSifra" />
				<parameter name="@AlternativniNaziv" value="#txtNaziv" />
				<parameter name="@ParAsortimanId" value="$ParAsortimanId" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthSifra">
				<parameter name="@table_name" value="ParAsortiman" />
				<parameter name="@column_name" value="Sifra1" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthNaziv">
				<parameter name="@table_name" value="ParAsortiman" />
				<parameter name="@column_name" value="Naziv" />
			</data>
		</datalist>
	</part>
	<part name="partKlKlRobaUnos">
		<layout textposition="left">
			<group rows="2" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Klasifikacija:">
					<comboedit name="cmbKlasifikacija" dataname="~dtKlasifikacija" valuefield="KlKlRobaId" displayfield="Naziv" required="true">
						<event type="valuechanged" raiseonload="false">
							<action type="control populate" value="#cmbGrupa" />
						</event>
					</comboedit>
				</item>
				<item row="2" col="1" caption="Klasifikacijska grupa:">
					<combotreeedit name="cmbGrupa" dataname="~dtGrupa" valuefield="KlRobaId" displayfield="Naziv" required="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtUnos">
							<parameter name="parent.$LnRobaId" />
						</action>
						<action type="control populate" value="parent.#grdKlasifikacije" />
						<action type="control focus" value="parent.#grdKlasifikacije">
							<parameter value="parent.$LnRobaId" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnIzlaz" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spRobaKlKlCarpo_Query" name="dtKlasifikacija">
				<parameter name="@action" value="4" />
