	<parts>
	<!-- OSOBNI PODACI -->
	<part name="prtOsobniPodaci">
		<event type="init">
			<action  type="datarun reader" value="~dtGetOsobu" if="$OsobeId!=0"/>
			<action type="datarun reader" value="~dtBrisanjetmpSve" if="$click==0"></action>
			<action type="datarun reader" value="~dtSlikaPromjena" />
			<action  type="datarun reader" value="~dtGetFirmu"/>	
			
		</event>
		<event type="load">
			<action type="control disable" value="#tabOso[0],#tabOso[2],#tabOso[3]" if="$Izvor==PartnerInfo"/>
		</event>
		<event type="shown"> 
			<action type="control disable" value="#tabOso[4]" if="$Izvor==PartnerInfo"/>		
			<action if="$tip==0">
				<action type="control attribute" value="#picOsoba">
					<parameter name="dbimg" value="~dtSlikaPromjena.@Slika"/>
				</action>
			</action>
			<action if="$tip==1">
				<action type="control attribute" value="#picOsoba">
					<parameter name="dbimg" value="~dtSlikaPromjena.@Slika"/>
				</action>	
			</action>
			<action if="$tip=='Izmjena'">
				<action type="control attribute" value="#picOsoba">
					<parameter name="dbimg" value="~dtSlikaPromjena.@Slika"/>
				</action>	
				<action type="control value" value="#chkAktivan">
					<parameter value="true"/>
				</action>
			</action>			
			<action if="$click==0">
				<action type="control disable" value="#cmbLokacija" if="#srcPartner==null"/>
				<action type="control enable" value="#cmbLokacija" else=""/>
			</action>
			<action if="$Tip=='Izmjena'||$PartneriId!=null">
				<action type="control value" value="#srcPartner">
					<parameter text="~dtGetFirmu.@Naziv" value="~dtGetFirmu.@PartneriId" if="$PartneriId==null"/>
					<parameter text="$PartnerNaziv" value="$PartneriId" if="$PartneriId!=null"/>
				</action>	
				<action type="control disable" value="#srcPartner" if="#srcPartner!=null"/>	
				<action type="control enable" value="#srcPartner" else=""/>
			</action>			
		</event>
		<infocontrols>
			<tabs name="tabOso">
				<event type="tabchanged">
					<action type="control enable" value="#tabOso[0],#tabOso[2],#tabOso[3],#tabOso[4]" if="$SelectedTabIndex==1&amp;&amp;$Izvor==PartnerInfo"/>
				</event>
			</tabs>
		</infocontrols>		
		<layout caption="Osobni podaci"  itemspadding="0" selectedtabindex="0" function="tabOpcenito">
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Osobni podaci" cols="1" rows="1" col="1" row="1" spacing="0,0,0,4">
					<columnsdefinition>
						<column position="1" size="50%" />
						<column position="2" size="50%" />
					</columnsdefinition>
					<group col="1" row="1" rows="8" cols="4" bordervisible="false">
						<columnsdefinition>
							<column position="1" size="20%" />
							<column position="2" size="20%" />
							<column position="3" size="20%" />
							<column position="4" size="40%" />
						</columnsdefinition>
						<item row="1" col="1" caption="Ime:" colspan="3">
							<textedit name="txtIme" required="true" datavalue="~dtGetOsobu.@Ime" />
						</item>
						<item row="2" col="1" caption="Prezime:" colspan="3">
							<textedit name="txtPrezime" required="true" datavalue="~dtGetOsobu.@Prezime"/>
						</item>
						<item row="3" col="1" caption="Titula:" >
							<comboedit name="cmbTitula" valuefield="PreTitleId" displayfield="Naziv" dataname="dtTitula" datavalue="~dtGetOsobu.@PreTitleId"/>
						</item>
						<item row="3" col="2" caption="Zvanje:" colspan="2">
							<comboedit name="cmbZvanje" valuefield="PosTitleId" displayfield="Naziv" dataname="dtZvanje" datavalue="~dtGetOsobu.@PosTitleId"/>
						</item>
						<item row="4" col="1" caption="OIB:" colspan="2">
							<textedit name="txtOIB" datavalue="~dtGetOsobu.@OIB"/>
						</item>
						<item row="4" col="3" caption="Šifra:" >
							<textedit name="txtSifra" datavalue="~dtGetOsobu.@Sifra"/>
						</item>					
						<item row="5" col="1" caption="Mjesto stanovanja:" colspan="3">
							<comboedit name="cmbMjesto" required="true" allownull="false" autopopulate="true" valuefield="mjestaid" displayfield="NazivFull" dataname="dtMjesto" datavalue="~dtGetOsobu.@MjestaId"/>
						</item>
						<item row="6" col="1" caption="Adresa stanovanja:" colspan="3" >
							<textedit name="txtAdresa" datavalue="~dtGetOsobu.@Adresa"/>
						</item>
						<item row="7" col="1" caption="Osobni telefon:">
							<textedit name="txtTelefon" datavalue="~dtGetOsobu.@Private"/>
						</item>
						<item row="7" col="2" caption="Osobni mobitel:">
							<textedit name="txtMobitel" datavalue="~dtGetOsobu.@Mobile"/> 
						</item>
						<item row="8" col="1" caption="Osobni email:" colspan="3">
							<textedit name="txtEmail" datavalue="~dtGetOsobu.@Email"/>
						</item>
						
						<item row="1" col="4" colspan="2" rowspan="8" >
							<pictureedit name="picOsoba" displaynoimage="true" dbimg="" rightclick="true">
							</pictureedit>
						</item>						 
					</group>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action if="$click==1">
							<action if="$OsobeId==0">
								<action type="datarun reader" value="~dtUnos">
												
									<action type="variable value" >
											<parameter name="global.OsobaId" value="$PomID" />
										</action>	
										
									 
									</action>
									 <action if="$indGreske==0">
										 <action type="form close"></action> 
									  </action>
							
							</action>
							<action if="$OsobeId!=0">
								<action type="datarun reader" value="~dtIzmjena"></action>
									<action type="form close" />

							</action>
						</action>
						<action else="$click==0">	
							<action if="$OsobeId==0">
								<action type="datarun reader" value="~dtUnosOsobe">
										<!-- <action type="variable value" value="global.$OsobaId"> -->
											<!-- <parameter value="$noviID" /> -->
										<!-- </action>				 -->	
										<action type="variable value" >
											<parameter name="global.OsobaId" value="$noviID" />
										</action>
										<action type="control populate" value="parent.#srcInfo"/>
										<action type="datarun reader" value="~dtBrisanjetmpSve"></action>
									

								</action>	
									 <action if="$indGreske==0">
										 <action type="form close"></action> 
									  </action>
							</action>
							<action elseif="$OsobeId!=0">
								<action type="datarun reader" value="~dtIzmjenaOsobe">

										<action type="variable value" value="global.$OsobaId">
											<parameter value="$noviID" />
										</action>				
										<!-- <action type="control populate" value="parent.#srcInfo"/> -->
										<action type="datarun reader" value="~dtBrisanjetmpSve"></action>
										

								</action>
 <action if="$indGreske==0">
										 <action type="form close"></action> 
									  </action>								
							
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action if="$click==0">
							<action type="datarun reader" value="~dtBrisanjetmpSve"></action>
						</action>
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spOsobeQuery_CP" name="dtSlikaPromjena">
				<parameter name="@action" value="slikaOsobe"/>
				<parameter name="@ID" value="$OsobeId" if="$OsobeId==0"/>
				<parameter name="@ID" value="global.$OsobaId" else=""/>
			</data>
			<data command="spOsobeAzur_CP" name="dtBrisanjetmpSve">
				<parameter name="@action" value="brisanjeSveKlasetmp"></parameter>
				<parameter name="@operateriid" value="@@operateriid"></parameter>
			</data>
			<data command="spOsobeAzur_CP" name="dtBrisanjetmp">
				<parameter name="@action" value="brisanjeKlasetmp"></parameter>
				<parameter name="@KlOsobeId" value="#grdKlase.@KlOsobeId"></parameter>
				<parameter name="@operateriid" value="@@operateriid"></parameter>
			</data>
			<data command="spOsobeQuery_CP" name="dtKlaseGridtmp">
				<parameter name="@action" value="gridKlasetmp" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spOsobeHelp_CP" name="dtFunkcija">
				<parameter name="@action" value="comboFunkcija" />
			</data>
			<data command="spOsobeHelp_CP" name="dtOdjel">
				<parameter name="@action" value="comboOdjel" />
			</data>
			<data command="spOsobeHelp_CP" name="dtLokacija">
				<parameter name="@action" value="comboLokacija" />
				<parameter name="@ID" value="#srcPartner"/>
			</data>
			<data command="spOsobeHelp_CP" name="dtPartner">
				<parameter name="@action" value="trazilicaPartner" />
				<parameter name="@text" value="#srcPartner.text"/>
			</data>
			<data command="spOsobeHelp_CP" name="dtKlaseOsobe">
				<parameter name="@action" value="comboKlaseOsobe" />
				<parameter name="@OsobeId" value="$OsobeId" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="spPartneriManagerNET_Combo" name="dtMjesto">
				<parameter name="@action" value="Mjesto" />
			</data>
			<data command="spOsobeHelp_CP" name="dtTitula">
				<parameter name="@action" value="comboTitule" />
			</data>
			<data command="spOsobeHelp_CP" name="dtZvanje">
				<parameter name="@action" value="comboZvanje" />
			</data>
			<data command="spOsobeHelp_CP" name="dtKategorija">
				<parameter name="@action" value="comboKategorija" />
			</data>
			<data command="spOsobeQuery_CP" name="dtGetOsobu">
				<parameter name="@action" value="dohvatOsobe" />
				<parameter name="@ID" value="$OsobeId" />
			</data>
			<data command="spOsobeAzur_CP" name="dtUnos">
				<parameter name="@action" value="unosOsobe"></parameter>
				<parameter name="@Prezime" value="#txtPrezime"></parameter>
				<parameter name="@Ime" value="#txtIme"></parameter>
				<parameter name="@Sifra" value="" if="#txtSifra==null"></parameter>
				<parameter name="@Sifra" value="#txtSifra" else=""></parameter>
				<parameter name="@Email" value="" if="#txtEmail==null"></parameter>
				<parameter name="@Email" value="#txtEmail" else=""></parameter>
				<parameter name="@Mobile" value="" if="#txtMobitel==null"></parameter>
				<parameter name="@Mobile" value="#txtMobitel" else=""></parameter>
				<parameter name="@Private" value="" if="#txtTelefon==null"></parameter>
				<parameter name="@Private" value="#txtTelefon" else=""></parameter>
				<parameter name="@Adresa" value="" if="#txtAdresa==null"></parameter>
				<parameter name="@Adresa" value="#txtAdresa" else=""></parameter>				
				<parameter name="@MjestaId" value="#cmbMjesto"></parameter>
				<parameter name="@PreTitleId" value="#cmbTitula"></parameter>
				<parameter name="@PosTitleId" value="#cmbZvanje"></parameter>
				<parameter name="@OIB" value="" if="#txtOIB==null"></parameter>
				<parameter name="@OIB" value="#txtOIB" else=""></parameter>				
				<parameter name="@slika" value="#picOsoba" type="varbinary" if="#picOsoba!=null"/>
				<parameter name="@PomID.output.int" />
				<parameter name="@unosSve" value="0" />
				<parameter name="@indGreske.output.int"></parameter>
			</data>
			<data command="spOsobeAzur_CP" name="dtIzmjena">
				<parameter name="@action" value="IzmjenaOsobe"></parameter>
				<parameter name="@ID" value="$OsobeId"></parameter>
				<parameter name="@Prezime" value="#txtPrezime"></parameter>
				<parameter name="@Ime" value="#txtIme"></parameter>
				<parameter name="@Sifra" value="" if="#txtSifra==null"></parameter>
				<parameter name="@Sifra" value="#txtSifra" else=""></parameter>
				<parameter name="@Email" value="" if="#txtEmail==null"></parameter>
				<parameter name="@Email" value="#txtEmail" else=""></parameter>
				<parameter name="@Mobile" value="" if="#txtMobitel==null"></parameter>
				<parameter name="@Mobile" value="#txtMobitel" else=""></parameter>
				<parameter name="@Private" value="" if="#txtTelefon==null"></parameter>
				<parameter name="@Private" value="#txtTelefon" else=""></parameter>
				<parameter name="@Adresa" value="" if="#txtAdresa==null"></parameter>
				<parameter name="@Adresa" value="#txtAdresa" else=""></parameter>			
				<parameter name="@MjestaId" value="#cmbMjesto"></parameter>
				<parameter name="@PreTitleId" value="#cmbTitula"></parameter>
				<parameter name="@PosTitleId" value="#cmbZvanje"></parameter>
				<parameter name="@OIB" value="" if="#txtOIB==null"></parameter>
				<parameter name="@OIB" value="#txtOIB" else=""></parameter>	
				<parameter name="@slika" value="#picOsoba" type="varbinary" if="#picOsoba!=null"/>
			</data>
			<data command="spOsobeAzur_CP" name="dtUnosOsobe">
				<parameter name="@action" value="unosOsobe"></parameter>
				<parameter name="@Prezime" value="#txtPrezime"></parameter>
				<parameter name="@Ime" value="#txtIme"></parameter>
				<parameter name="@Sifra" value="" if="#txtSifra==null"></parameter>
				<parameter name="@Sifra" value="#txtSifra" else=""></parameter>
				<parameter name="@Email" value="" if="#txtEmail==null"></parameter>
				<parameter name="@Email" value="#txtEmail" else=""></parameter>
				<parameter name="@Mobile" value="" if="#txtMobitel==null"></parameter>
				<parameter name="@Mobile" value="#txtMobitel" else=""></parameter>
				<parameter name="@Private" value="" if="#txtTelefon==null"></parameter>
				<parameter name="@Private" value="#txtTelefon" else=""></parameter>
				<parameter name="@Adresa" value="" if="#txtAdresa==null"></parameter>
				<parameter name="@Adresa" value="#txtAdresa" else=""></parameter>		
				<parameter name="@MjestaId" value="#cmbMjesto"></parameter>
				<parameter name="@PreTitleId" value="#cmbTitula"></parameter>
				<parameter name="@PosTitleId" value="#cmbZvanje"></parameter>
				<parameter name="@OIB" value="" if="#txtOIB==null"></parameter>
				<parameter name="@OIB" value="#txtOIB" else=""></parameter>	
				<parameter name="@ParStruID" value="#cmbLokacija"></parameter>
				<parameter name="@TelefonPos" value="#txtTelefonPos"></parameter>
				<parameter name="@EmailPos" value="#txtEmailPos"></parameter>
				<parameter name="@Lokal" value="#txtLokal"></parameter>
				<parameter name="@KlFunkcijeId" value="#cmbFunkcija"></parameter>
				<parameter name="@OdjelId" value="#cmbOdjel"></parameter>
				<parameter name="@KeyContact" value="#chkKeyKontakt"></parameter>
				<parameter name="@Aktivan" value="#chkAktivan"></parameter>
				<parameter name="@Mobitel" value="#txtMobitelPos"></parameter>
				<parameter name="@PartneriId" value="#srcPartner"></parameter>
				<parameter name="@operateriid" value="@@operateriid"></parameter>
				<parameter name="@Memo" value="#memOpis" />
				<parameter name="@ZSIskaznica" value="#txtBrZastitne" />
				<parameter name="@OsobeKategorijeId" value="#cmbKategorija" />
				<parameter name="@slika" value="#picOsoba" type="varbinary" if="#picOsoba!=null"/>
				<parameter name="@noviID.output.int" />
				<parameter name="@unosSve" value="1" />
				<parameter name="@indGreske.output.int"></parameter>
			</data>
			<data command="spOsobeAzur_CP" name="dtIzmjenaOsobe">
				<parameter name="@action" value="izmjenaOsobe"></parameter>
				<parameter name="@Prezime" value="#txtPrezime"></parameter>
				<parameter name="@Ime" value="#txtIme"></parameter>
				<parameter name="@Sifra" value="" if="#txtSifra==null"></parameter>
				<parameter name="@Sifra" value="#txtSifra" else=""></parameter>
				<parameter name="@Email" value="" if="#txtEmail==null"></parameter>
				<parameter name="@Email" value="#txtEmail" else=""></parameter>
				<parameter name="@Mobile" value="" if="#txtMobitel==null"></parameter>
				<parameter name="@Mobile" value="#txtMobitel" else=""></parameter>
				<parameter name="@Private" value="" if="#txtTelefon==null"></parameter>
				<parameter name="@Private" value="#txtTelefon" else=""></parameter>
				<parameter name="@Adresa" value="" if="#txtAdresa==null"></parameter>
				<parameter name="@Adresa" value="#txtAdresa" else=""></parameter>	
				<parameter name="@MjestaId" value="#cmbMjesto"></parameter>
				<parameter name="@PreTitleId" value="#cmbTitula"></parameter>
				<parameter name="@PosTitleId" value="#cmbZvanje"></parameter>
				<parameter name="@OIB" value="" if="#txtOIB==null"></parameter>
				<parameter name="@OIB" value="#txtOIB" else=""></parameter>	
				<parameter name="@ParStruID" value="#cmbLokacija"></parameter>
				<parameter name="@TelefonPos" value="#txtTelefonPos"></parameter>
				<parameter name="@EmailPos" value="#txtEmailPos"></parameter>
				<parameter name="@Lokal" value="#txtLokal"></parameter>
				<parameter name="@KlFunkcijeId" value="#cmbFunkcija"></parameter>
				<parameter name="@OdjelId" value="#cmbOdjel"></parameter>
				<parameter name="@KeyContact" value="#chkKeyKontakt"></parameter>
				<parameter name="@Aktivan" value="#chkAktivan"></parameter>
				<parameter name="@Mobitel" value="#txtMobitelPos"></parameter>
				<parameter name="@PartneriId" value="#srcPartner"></parameter>
				<parameter name="@operateriid" value="@@operateriid"></parameter>
				<parameter name="@Memo" value="#memOpis" />
				<parameter name="@ZSIskaznica" value="#txtBrZastitne" />
				<parameter name="@OsobeKategorijeId" value="#cmbKategorija" />
				<parameter name="@slika" value="#picOsoba" type="varbinary" if="#picOsoba!=null"/>
				<parameter name="@noviID.output.int" />
				<parameter name="@unosSve" value="1" />
				<parameter name="@ID" value="$OsobeId"/>
				<parameter name="@LnOsoParId" value="$LnOsoParId"/>
				<parameter name="@indGreske.output.int"></parameter>
			</data>			
			<data command="spOsobeAzur_CP" name="dtUnostmp">
				<parameter name="@action" value="unosKlasetmp"></parameter>
				<parameter name="@OsobaId" value="$OsobeId"></parameter>
				<parameter name="@KlOsobeId" value="#cmbKlase"></parameter>
				<parameter name="@operateriid" value="@@operateriid"></parameter>
			</data>
			<data command="spOsobeQuery_CP" name="dtGetFirmu">
				<parameter name="@action" value="dohvatFirme" />
				<parameter name="@ID" value="$LnOsoParId" />
			</data>			
		</datalist>
	</part>
	<!-- POSLOVNI PODACI -->
	<part name="prtPoslovniPodaci">
		<event type="init">
			<action  type="datarun reader" value="~dtGetFirmu" if="$LnOsoParId!=0"/>
		</event>
		<event type="shown">
			<action type="control disable" value="#cmbLokacija" if="#srcPartner==null"/>
			<action type="control enable" value="#cmbLokacija" else=""/>
			<action if="$Tip=='Izmjena'||$PartneriId!=null">
				<action type="control value" value="#srcPartner">
					<parameter text="~dtGetFirmu.@Naziv" value="~dtGetFirmu.@PartneriId" if="$PartneriId==null"/>
					<parameter text="$PartnerNaziv" value="$PartneriId" if="$PartneriId!=null"/>
				</action>	
				<action type="control disable" value="#srcPartner" if="#srcPartner!=null"/>	
				<action type="control enable" value="#srcPartner" else=""/>
			</action>	
		<action if="$click==1">
			<action type="control disable" value="#btnSpremi" if="#srcPartner==null"/>	
		</action>			
		</event>
		<layout caption="Poslovni podaci" itemspadding="0" function="tabFirme">                                                                                                                       
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Poslovni podaci" cols="1" rows="1" col="1" row="1" spacing="0,0,0,4">
					<group col="1" row="1" rows="7" cols="3" bordervisible="false">
						<columnsdefinition>
							<column position="1" size="30%" />
							<column position="2" size="20%" />
							<column position="3" size="50%" />
						</columnsdefinition>
						<item row="1" col="1" caption="Partner:" colspan="3">
							<searchedit type="" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" dataname="dtPartner">
								<event type="valuechanged">
									<action if="#srcPartner!=null">
										<action type="control enable" value="#cmbLokacija,#btnSpremi"/>
										<action type="datarun reader" value="dtLokacija">
											<action type="control populate" value="#cmbLokacija" />
										</action>
									</action>
									<action else="">
										<action type="control populate" value="#cmbLokacija" />
										<action type="control disable" value="#cmbLokacija"/>
									</action>
								</event>
							</searchedit>
						</item>
						<item row="2" col="1" caption="Lokacija:" colspan="3">
							<comboedit name="cmbLokacija" allownull="false" valuefield="ParStruId" displayfield="Naziv" dataname="dtLokacija" datavalue="~dtGetFirmu.@ParStruId"/>
						</item>
						<item row="3" col="1" caption="Funkcija:" colspan="2">
							<comboedit name="cmbFunkcija" allownull="false" valuefield="KlFunkcijeID" displayfield="Naziv" dataname="dtFunkcija" datavalue="~dtGetFirmu.@KlFunkcijeID"/>
						</item>
						<item row="3" col="3" caption="Odjel:">
							<comboedit name="cmbOdjel" allownull="false" valuefield="OdjelId" displayfield="Naziv" dataname="dtOdjel" datavalue="~dtGetFirmu.@OdjelId"/>
						</item>
						<item row="4" col="1" caption="Poslovni telefon:">
							<textedit name="txtTelefonPos" datavalue="~dtGetFirmu.@Telefon"/>
						</item>
						<item row="4" col="2" caption="Lokal:">
							<textedit name="txtLokal" datavalue="~dtGetFirmu.@Lokal"/>
						</item>
						<item row="4" col="3" caption="Poslovni mobitel:">
							<textedit name="txtMobitelPos" datavalue="~dtGetFirmu.@Mobitel"/>
						</item>
						<item row="5" col="1" caption="Poslovni email:" colspan="3" >
							<textedit name="txtEmailPos" datavalue="~dtGetFirmu.@Email"/>
						</item>
						<item row="6" col="1" colspan="2">
							<checkedit caption="Aktivan" value="true" name="chkAktivan" datavalue="~dtGetFirmu.@Aktivan" />
						</item>
						<item row="6" col="3">
							<checkedit caption="Key kontakt" name="chkKeyKontakt" datavalue="~dtGetFirmu.@KeyContact" />
						</item>
					</group>				
				</group>
