<root version="1.0.0.1" loglevel="3">
	<form name="frmPartnerInfoBiljeske" statusbar="false" saveformsize="true">
		<event type="init">	
			<action type="datarun reader" value="~dtGetBiljeske"/>
		</event>
		<event type="load">
		
		</event>
		<event type="shown">		
			<action type="form caption" value="Unos nove bilješke" if="$ParKontaktId==null"/>
			<action type="form caption" value="Izmjena bilješke" elseif="$ParKontaktId!=null"/>
		</event>
		<event type="close">
		</event>
		<layout itemspadding="0">
			<group rows="6" cols="2" groupbordervisible="false">
				<item row="1" col="1" caption="Tko:">
					<comboedit name="cmbTko" datavalue="~dtGetBiljeske.@osobeid" autopopulate="true" valuefield="OsobeId" displayfield="osoba" dataname="dtTko"/> 
				</item>
				<item row="2" col="1" caption="S kim:">
					<comboedit name="cmbSKim" datavalue="~dtGetBiljeske.@osobeparid" autopopulate="true" valuefield="OsobeId" displayfield="osoba" dataname="dtSKim"/> 
				</item>	
				<item row="1" col="2" caption="Kada:">
					<dateedit name="datKada" required="true" allownull="false" value="now" datavalue="~dtGetBiljeske.@Kada"/>
				</item>			
				<item row="2" col="2" caption="Vrsta:">
					<comboedit name="cmbVrstaKontakta" datavalue="~dtGetBiljeske.@parkontaktvrstaid" autopopulate="true" valuefield="ParKontaktVrstaId" displayfield="naziv" dataname="dtVrstaKontakta"/> 
				</item>
				<item row="3" col="1" colspan="2" caption="Tema:">
					<textedit name="txtTema" datavalue="~dtGetBiljeske.@Tema"/>
				</item>	
				<item row="4" col="1" colspan="2" rowspan="2" caption="Sadržaj:">
					<memoedit name="memSadrzaj" datavalue="~dtGetBiljeske.@Bilješka"/>
				</item>	
				<item row="6" col="1"/>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtUnesiIzmijeniBiljeske">
							<parameter name="NoviParKontaktId"/>
						</action>
						<action if="$NoviParKontaktId!=null">
							<action type="control populate" value="parent.#grdBiljeske">
								<action type="control focus" value="parent.#grdBiljeske">
									<parameter value="$NoviParKontaktId" />
								</action>							
							</action>
							<action type="form close"/>
						</action>
					</event>
				</button>				
				<button name="btnZatvori" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>	
			<data name="dtTko" command="spCPartnerInfoCombo">
				<parameter name="@Action" value="OsobeKontakt"/>	
			</data>		
			<data name="dtSKim" command="spCPartnerInfoCombo">
				<parameter name="@Action" value="ParOsobeKontakt"/>	
				<parameter name="@PartneriId" value="$PartneriId"/>	
			</data>
			<data name="dtVrstaKontakta" command="spCPartnerInfoCombo">
				<parameter name="@Action" value="VrstaKontakta"/>	
			</data>					
			<data name="dtGetBiljeske" command="spCPartnerInfoQuery">
				<parameter name="@Action" value="9"/>
				<parameter name="@ParKontaktId" value="$ParKontaktId"/>				
			</data>					
			<data name="dtUnesiIzmijeniBiljeske" command="spCPartnerInfoParKontaktAzur">
				<parameter name="@Action" value="0" if="$ParKontaktId==null"/>
				<parameter name="@Action" value="1" if="$ParKontaktId!=null"/>
				<parameter name="@PartneriId" value="$PartneriId"/>	
				<parameter name="@Tema" value="#txtTema" if="#txtTema!=null"/>
				<parameter name="@Tema" value="" if="#txtTema==null"/>
				<parameter name="@Sadrzaj" value="#memSadrzaj" if="#memSadrzaj!=null"/>
				<parameter name="@Sadrzaj" value="" if="#memSadrzaj==null"/>
				<parameter name="@Datum" value="#datKada"/>	
				<parameter name="@ParKontaktId" value="$ParKontaktId"/>		
				<parameter name="OsobeId" value="#cmbTko"/>
				<parameter name="OsobeParId" value="#cmbSKim"/>
				<parameter name="OperateriId" value="@@operateriid"/>
				<parameter name="ParKontaktVrstaId" value="#cmbVrstaKontakta"/>
			</data>
		</datalist>
	</form>
</root>