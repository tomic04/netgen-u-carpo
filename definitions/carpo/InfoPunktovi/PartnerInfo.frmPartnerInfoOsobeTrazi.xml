<root version="1.0.0.1" loglevel="3">
	<form name="frmPartnerInfoOsobeTrazi" statusbar="false">
		<event type="init">	
			<part name="prtRefreshVariable" path="prtPartnerInfo.xml"/>
		</event>
		<event type="load">
		
		</event>
		<event type="shown">
			<action type="form caption" value="Pretraga nove osobe"/>
			<action type="control focus" value="#srcOsobe"/>
		</event>
		<event type="close">
		</event>
		<layout  itemspadding="0">
			<group rows="1" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Traži:">
					<searchedit name="srcOsobe" dataname="~dtOsobeTrazi" fieldtext="Prezime i ime" fieldvalue="Id" savelayout="true">
						<event type="valuechanged">
							<!--ne radi-->
							<!-- <action type="variable value" value="$BrojOsoba"> -->
								<!-- <parameter value="#srcOsobe.@BrojOsoba"/> -->
							<!-- </action> -->
							<!-- <action type="message" value="$brojosoba"/> -->
							<!-- <action type="form open" value="" if="$BrojOsoba==0"> -->
								<!-- <parameter name="Id" value="null"/> -->
							<!-- </action>	 -->
							
							<action if="#srcOsobe!=null">
								<action type="form open" value="frmInfoOsobniInsert">
									<parameter name="caption" value="Izmjena podataka"/>
									<parameter name="click" value="0"/>
									<parameter name="tip" value="Izmjena"/>
									<parameter name="OsobeId" value="#srcOsobe"/>
									<parameter name="PartneriId" value="$PartneriId"/>
									<parameter name="PartnerNaziv" value="$PartnerNaziv"/>
									<parameter name="LnOsoParId" value="0"/>
									<parameter name="Izvor" value="PartnerInfo"/>
								</action>	
								<action type="control populate" value="parent.#grdOsobe">
									<action type="control focus" value="parent.#grdOsobe">
										<parameter value="#srcOsobe"/>
									</action>							
								</action>						
								<action type="form close"/>								
							</action>
						</event>	
						<event type="keydown">
							<!--ni ovo ne radi-->
							<action type="control value" value="#srcOsobe" if="key!=9&amp;&amp;key!=13">
								<parameter value="null"/>
							</action>
							<!-- <action type="message" value="tu sam"/>  -->
						</event>
					</searchedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdaberi" caption="Odaberi">
					<event type="click">
						<action type="form open" value="frmInfoOsobniInsert">
							<parameter name="caption" value="Izmjena podataka"/>
							<parameter name="click" value="0"/>
							<parameter name="tip" value="Izmjena"/>
							<parameter name="OsobeId" value="#srcOsobe"/>
							<parameter name="PartneriId" value="$PartneriId"/>
							<parameter name="PartnerNaziv" value="$PartnerNaziv"/>
							<parameter name="LnOsoParId" value="0"/>
							<parameter name="Izvor" value="PartnerInfo"/>
						</action>	
						<action type="control populate" value="parent.#grdOsobe">
							<action type="control focus" value="parent.#grdOsobe">
								<parameter value="#srcOsobe"/>
							</action>							
						</action>						
						<action type="form close"/>						
					</event>
				</button>
				<button name="btnNovaOsoba" caption="Nova osoba">
					<event type="click">
						<action type="form open" value="frmInfoOsobniInsert">
							<parameter name="caption" value="Unos podataka"/>
							<parameter name="click" value="0"/>
							<parameter name="tip" value="0"/>
							<parameter name="OsobeId" value="0"/>
							<parameter name="PartneriId" value="$PartneriId"/>
							<parameter name="PartnerNaziv" value="$PartnerNaziv"/>	
							<parameter name="Izvor" value="PartnerInfo"/>							
						</action>	
						<action type="control populate" value="parent.#grdOsobe">
							<action type="control focus" value="parent.#grdOsobe">
								<parameter value=""/>
							</action>							
						</action>						
						<action type="form close"/>										
					</event>
				</button>				
				<button name="btnZatvori" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>			
			<!-- <data name="dtOsobeTrazi" command="spCPartnerInfoOsobe"> -->
				<!-- <parameter name="@Action" value="20"/>				 -->
				<!-- <parameter name="@text" value="#srcOsobe.text"/> -->
			<!-- </data> -->
			<data command="spOsobeHelp_CP" name="dtOsobeTrazi">
				<parameter name="@action" value="Osobe1"/>
				<parameter name="@text" value="#srcOsobe.text"/>
			</data>			
			<data name="" command="">
				<parameter name="" value=""/>
				<parameter name="" value=""/>
			</data>
			<data name="" command="">
				<parameter name="" value=""/>
				<parameter name="" value=""/>
			</data>
		</datalist>
	</form>
</root>