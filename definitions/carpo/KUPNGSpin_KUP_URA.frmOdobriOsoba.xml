<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: ODOBRIOSOBA (NetGen) → frmOdobriOsoba (Carpo) -->
<root version="1.2">
  <form name="frmOdobriOsoba" caption="Operateri" type="dialog" width="760" height="520" fixedsize="false" saveformsize="true">
    <event type="shown">
      <action type="control populate" value="#grdOsobe"/>
      <action type="control disable" value="#btnOrgShema"/>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <item col="1" row="1" caption="Operateri kojima je proslijeđen odabrani dokument:" textposition="left">
          <label/>
        </item>
        <item col="1" row="2">
          <grid name="grdOsobe" dataname="~dtOsobe" bestfitonrefresh="true" showautofilterrow="true" savelayout="true">
            <event type="focusedrowchanged">
              <!-- TODO: NetGen ima složeniju validaciju (zadnji log, faktureDob...). Ovdje je minimalni check. -->
              <action type="control enable" value="#btnOrgShema" if="#grdOsobe.@optoid==@@operateriid"/>
              <action type="control disable" value="#btnOrgShema" else=""/>
            </event>
            <fields inherited="true"/>
          </grid>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOrgShema" caption="IZMIJENI">
          <event type="click">
            <action type="form open" value="frmOrgShema">
              <parameter name="Id" value="$Id"/>
            </action>
          </event>
        </button>
        <button name="btnIzlaz" caption="IZLAZ" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtOsobe" command="spKUPPrometQueryN" timeout="300">
        <parameter name="@action" value="6"/>
        <parameter name="@id" value="$Id"/>
      </data>
    </datalist>
  </form>
</root>

