<?xml version="1.0" encoding="utf-8"?>
<!-- PRONADJI_FORM - Pronađi po UFA -->
<root version="1.2">
  <form name="frmPronadji" type="custom" caption="Pronađi" width="340" height="250">
    <layout>
      <group rows="2" cols="1">
        <item row="1" col="1" caption="UFA:">
          <searchedit name="srcUra" dataname="~dtUra" fieldvalue="KntKnjigaUraId" fieldtext="BrojRacuna" netgenfields="true"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnTrazi" caption="Traži">
          <event type="click">
            <action type="datarun reader" value="~dtSetNode"/>
            <action type="variable value">
              <parameter name="global.$Node" value="~dtSetNode.@node"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtUra" command="select k.KntKnjigaUraId, k.FaktureDobId, p.Naziv as Partner2500, k.DatumDok, k.Broj as BrojRacuna, k.BrojDok as UFA1200, f.IznosFakture as IznosFakture1800 from KntKnjigaUra k inner join Partneri p on k.PartneriId = p.PartneriId left outer join FaktureDob f on k.FaktureDobId = f.FaktureDobId where k.BrojDok like '%' + #srcUra.text + '%'" type="text"/>
      <data name="dtSetNode" command="spKntSetirajNod" type="reader" timeout="30">
        <parameter name="@id" value="#srcUra"/>
      </data>
    </datalist>
  </form>
</root>
