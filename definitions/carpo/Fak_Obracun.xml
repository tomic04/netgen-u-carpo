				<!-- <action type="form open" value="frmPrijevozniListUnos"/> -->
				<!-- <action type="control focus" value="#grdGlava"> -->
				<!-- <parameter value="global.$DokId" /> -->
				<!-- </action>						 -->
				<!-- </event> -->
				<!-- </button>			 -->
				<item>
					<button name="btnInsert" caption="NOVI OBRAČUN">
						<event type="click">
							<!-- <action type="variable value" value="global.$DokId"> -->
							<!-- <parameter value="19" /> -->
							<!-- </action>										 -->
							<action type="form open" value="frmNoviObracun">
							</action>
							<action type="control populate" value="#tree" if="global.$DokId!=null&amp;&amp;global.$DokId!=0"/>
							<action type="control focus" value="#tree" if="global.$DokId!=null&amp;&amp;global.$DokId!=0">
								<!-- <action type="message" value="global.$DokId" />								 -->
								<!-- <parameter value="19" type="string"/> -->
								<parameter value="global.$DokId" type="int"/>
							</action>	
							<action type="control populate" value="#grdGlava" />
							<!-- <action type="control focus" value="#grdGlava"> -->
							<!-- <parameter value="global.$DokId" type="string"/> -->
							<!-- </action>						 -->
						</event>
					</button>	
				</item>		
				<item>				
					<button name="btnIzmijeni" caption="IZMJENA OBRAČUNA">
						<event type="click">
							<action type="form open" value="frmIzmijeniObracun">
								<parameter name="KomercNakObracunGlaId" value="#tree.@value" />
							</action>
							<action type="control populate keepfocus" value="#tree" />
							<action type="control populate" value="#grdGlava" />
						</event>			
					</button>
				</item>				
				<item>
					<button name="btnObrisi" caption="BRISANJE OBRAČUNA">
						<event type="click">
							<action type="confirm" value="Želite li obrisati odabrani obračun? Kreirane fakture neće biti obrisane.">
								<action type="datarun nonquery" value="~dtDelete">
									<action type="control populate" value="#tree" />
								</action>
							</action>
						</event>				
					</button>
				</item>	
				<item row="1" col="1" highlight="false" >
					<radioedit name="rdo1" caption="Rekap" value="true" >
						<event type="checkedchanged">
							<action type="control value" value="#grdGlava">
								<parameter value=""/>
							</action>						
							<action type="control populate" value="#grdGlava" />
						</event>
					</radioedit>
				</item>
				<item row="1" col="2" highlight="false" >
					<radioedit name="rdo2" caption="Analitika">
						<event type="checkedchanged">
							<action type="control value" value="#grdGlava">
								<parameter value=""/>
							</action>												
							<action type="control populate" value="#grdGlava" />
						</event>
					</radioedit>
				</item>
				<item row="1" col="3" highlight="false" >
					<radioedit name="rdo3" caption="Po ugovoru" value="true" >
						<event type="checkedchanged">
							<action type="control value" value="#grdGlava">
								<parameter value=""/>
							</action>						
							<action type="control populate" value="#grdGlava" />
						</event>
					</radioedit>
				</item>
				<item>
					<button name="btnDonos" caption="DONOS">
						<event type="click">
							<action type="confirm" value="Želite li donijeti nove stavke koje zadovoljavaju parametre obračuna?">
								<action type="datarun nonquery" value="~dtDonos">
									<action type="control populate" value="#grdGlava" />
								</action>
							</action>
						</event>				
					</button>
				</item>		
				<item>
					<button name="btnObnovi" caption="OBNOVA">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obnoviti stavke obračuna?
															Obnova će obrisati sve stavke i ponovno ih donijeti.">
								<action type="datarun nonquery" value="~dtObnova">
									<action type="control populate" value="#grdGlava" />
								</action>
							</action>
						</event>				
					</button>
				</item>	
				<item>
					<button name="btnFakturiranje" caption="FAKTURIRANJE">
						<event type="click">
							<action type="datarun scalar" value="~dtProvjeraFakturiranja">
								<parameter name="Postoji"/>
							</action>
							<action if="$Postoji==1">
								<action type="confirm" value="Za neke stavke je već kreirano odobrenje, jeste li sigurni da želite nastaviti? 
															(Odobrenje će se kreirati samo za nefakturirane stavke)" >
									<action type="form open" value="frmFakturiranje"/>
								</action>
							</action>
							<action elseif="$Postoji==0">
								<action type="form open" value="frmFakturiranje"/>
							</action>
							<action type="control populate keepfocus" value="#grdGlava" />							
						</event>				
					</button>
				</item>				
			</items>				
		</actionpanel>
		<datalist>
			<data command="spKomercNakObracun" name="dtGlava">
				<parameter name="@Action" value="4" if="#rdo1==true"/>
				<parameter name="@Action" value="41" elseif="#rdo3==true"/>
				<parameter name="@Action" value="3" else=""/>
				<parameter name="@KomercNakObracunGlaId" value="#tree.@value" />
			</data>
			<data command="spKomercNakObracun" name="dtDelete">
				<parameter name="@Action" value="9"/>
				<parameter name="@KomercNakObracunGlaId" value="#tree.@value" />
			</data>		
			<data command="spKomercNakObracun" name="dtDonos" timeout="300">
				<parameter name="@Action" value="2"/>
				<parameter name="@KomercNakObracunGlaId" value="#tree.@value" />
			</data>	
			<data command="spKomercNakObracun" name="dtObnova" timeout="300">
				<parameter name="@Action" value="5"/>
				<parameter name="@KomercNakObracunGlaId" value="#tree.@value" />
			</data>	
			<data command="spKomercNakObracun" name="dtProvjeraFakturiranja">
				<parameter name="@Action" value="10"/>
				<parameter name="@KomercNakObracunGlaId" value="#tree.@value" />
			</data>	
			<data command="spKomercNakObracun" name="dtUkloni">
				<parameter name="@action" value="6" />
				<parameter name="@KomercNakObracunDetId" value="#grdGlava.@KomercNakObracunDetId" />
			</data>	
			<data command="spKomercNakObracun" name="dtVrati">
				<parameter name="@action" value="61" />
				<parameter name="@KomercNakObracunDetId" value="#grdGlava.@KomercNakObracunDetId" />
			</data>				
		</datalist>			
	</form>		

	<form name="frmNoviObracun" caption="Novi obračun" width="400" height="600"  operaterlocktable="" operaterlockkey="" operaterlockkeyvalue="" >
		<event type="init">

		</event>
		<event type="load">

		</event>		
		<event type="shown">

		</event>
		<event type="close">

		</event>		
		<layout textposition="top">
			<group padding="0" groupbordervisible="False" cols="1" rows="7">
				<item caption="Naziv" col="1" row="1" highlight="false">
					<textedit name="txtNaziv" datavalue="" fontbold="true" nulltext="&lt;novi obračun&gt;" required="true"/>
				</item>	
				<item caption="Datum od:" col="1" row="2" >
					<dateedit name="datDatumOd" value="now" datavalue="" required="true"/>
				</item>	
				<item caption="Datum do:" col="1" row="3" >
					<dateedit name="datDatumDo" value="now" datavalue="" required="true"/>
				</item>					
				<item caption="Partner:" col="1" row="4">
					<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" fontbold="true" datavalue="" datatext="">
					</searchedit>
				</item>	
				<item caption="Org. shema" textvisible="false" col="1" row="5" >
					<searchedit name="srcOrgShema" fontsizedelta="1" fieldtext="Naziv" fieldvalue="OrgShemaId" dataname="dtOrgShema"/>				
				</item>
				<item caption="vrsta dokumenta:" col="1"  row="6">
					<combomultiedit name="cmbVrstadok" valuefield="VrstaDokId" displayfield="Opis" dataname="dtVrstaDokGet" showmultiselecttext="true" required="true" savevalue="app"/>
				</item>	
				<item textvisible="true" col="1" row="7">
					<checkedit name="chkParStruGrupiranje" caption="Grupiraj po lokaciji" value ="0" />
				</item>					
			</group>
		</layout>				
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="dtObracunUnos">
							<parameter name="NewId" />
							<action type="variable value" value="global.$DokId">
								<parameter value="$NewId" type="int"/>
							</action>							
						</action>
						<!-- <action type="message" value="global.$DokId" />						 -->
						<action type="form close"/>
					</event>
				</button>			
				<button name="btnOdustani" caption="ZATVORI" type="cancel">

				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spNG_Combo" name="dtVrstaDokGet"> -->
			<!-- <parameter name="@Action" value="VrstaDok" /> -->
			<!-- <parameter name="@Oznaka" value="30" /> -->
			<!-- </data>		 -->
			<data type="text" command="declare @tabla table (VrstaDokId int, Opis varchar(50))
				insert into @tabla
					exec spNG_Combo @Action='VrstaDok', @Oznaka='30'
				insert into @tabla
					exec spNG_Combo @Action='VrstaDok', @Oznaka='96'
				select * from @tabla" 
				name="dtVrstaDokGet">
			</data>				
			<data command="spKomercNakObracun" name="dtObracunUnos" timeout="300">
				<parameter name="@Action" value="1" />
				<parameter name="@DatumOd" value="#datDatumOd" />
				<parameter name="@DatumDo" value="#datDatumDo" />
				<parameter name="@OrgShemaId" value="#srcOrgShema" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@strvrd" value="#cmbVrstadok" type="string"/>
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@ParStruGrupiranje" value="#chkParStruGrupiranje" />
			</data>	
			<data command="spTraziOrgShema" name="dtOrgShema">
				<parameter name="@uvjet" value="#srcOrgShema.text" />
			</data>			
		</datalist>		
	</form>

	<form name="frmIzmijeniObracun" caption="Izmjena obračuna" width="400" height="600" >
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun scalar" value="~dtDohvatiOznaceneId">
				<parameter name="selectedids"/>
			</action>
		</event>
		<event type="load">
			<action type="control value" value="#cmbVrstadok">
				<parameter value="$selectedids"/>
			</action>
		</event>		
		<event type="shown">

		</event>
		<event type="close">

		</event>		
		<layout textposition="top">
			<group padding="0" groupbordervisible="False" cols="1" rows="7">
				<item caption="Naziv" col="1" row="1" highlight="false">
					<textedit name="txtNaziv" datavalue="#dtGet.@Naziv" fontbold="true" required="true"/>
				</item>	
				<item caption="Datum od:" col="1" row="2" >
					<dateedit name="datDatumOd" value="now" datavalue="#dtGet.@DatumOd" required="true"/>
				</item>	
				<item caption="Datum do:" col="1" row="3" >
					<dateedit name="datDatumDo" value="now" datavalue="#dtGet.@DatumDo" required="true"/>
				</item>					
				<item caption="Partner:" col="1" row="4">
					<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" fontbold="true" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@PartnerNaziv" enabled="false">
					</searchedit>
				</item>	
				<item caption="Org. shema" textvisible="false" col="1" row="5" >
					<searchedit name="srcOrgShema" fieldtext="Naziv" fieldvalue="OrgShemaId" datavalue="#dtGet.@OrgShemaId" datatext="#dtGet.@OrgShema" dataname="dtOrgShema" enabled="false" />				
				</item>				
				<item caption="Vrsta dokumenta:" col="1"  row="6">
					<combomultiedit name="cmbVrstadok" valuefield="VrstaDokId" displayfield="Opis" dataname="dtVrstaDokGet" showmultiselecttext="true" required="true"  />
				</item>	
				<item textvisible="true" col="1" row="7">
					<checkedit name="chkParStruGrupiranje" caption="Grupiraj po lokaciji" value="0" datavalue="#dtGet.@ParStruGrupiranje" />
				</item>					
			</group>
		</layout>				
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="dtObracunEdit"/>
						<action type="form close"/>
					</event>
				</button>			
				<button name="btnOdustani" caption="ZATVORI" type="cancel">

				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spKomercNakObracun" name="dtGet">
				<parameter name="@Action" value="8" />
				<parameter name="@KomercNakObracunGlaId" value="$KomercNakObracunGlaId" />
			</data>		
			<!-- <data command="spNG_Combo" name="dtVrstaDokGet"> -->
			<!-- <parameter name="@Action" value="VrstaDok" /> -->
			<!-- <parameter name="@Oznaka" value="30" /> -->
			<!-- </data>		 -->
			<data type="text" command="declare @tabla table (VrstaDokId int, Opis varchar(50))
				insert into @tabla
					exec spNG_Combo @Action='VrstaDok', @Oznaka='30'
				insert into @tabla
					exec spNG_Combo @Action='VrstaDok', @Oznaka='96'
				select * from @tabla" 
				name="dtVrstaDokGet">
			</data>		
			<data command="spKomercNakObracun" name="dtObracunEdit" timeout="300">
				<parameter name="@Action" value="7" />
				<parameter name="@KomercNakObracunGlaId" value="$KomercNakObracunGlaId" />
				<parameter name="@DatumOd" value="#datDatumOd" />
				<parameter name="@DatumDo" value="#datDatumDo" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@OrgShemaId" value="#srcOrgShema" />
				<parameter name="@strvrd" value="#cmbVrstadok" type="string"/>
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@ParStruGrupiranje" value="#chkParStruGrupiranje" />
			</data>	
			<data command="select stuff((select ',' + rtrim(vrstadok)
                                        from KomercNakObracunGla
                                               where KomercNakObracunGlaId = @KomercNakObracunGlaId
                                               for xml path('')),1,1,'') SelectedIDs;" type="text" name="dtDohvatiOznaceneId">
				<parameter name="@KomercNakObracunGlaId" value="$KomercNakObracunGlaId" />											   
			</data>	
			<data command="spNG_Combo" name="dtOrgShema">
				<parameter name="@Action" value="orgshema" />
			</data>			
		</datalist>		
	</form>

	<form name="frmFakturiranje" caption="Fakturiranje" width="400" height="600"  operaterlocktable="" operaterlockkey="" operaterlockkeyvalue="" savevalue="app">
		<event type="init">

		</event>
		<event type="load">

		</event>		
		<event type="shown">

		</event>
		<event type="close">

		</event>		
		<layout textposition="top">
			<group padding="0" groupbordervisible="False" cols="1" rows="5">
				<item caption="Datum:" col="1" row="1" >
					<dateedit name="datDatumDok" value="now" datavalue="" required="true" savevalue="app"/>
				</item>	
				<item caption="Vrsta dokumenta:" col="1" row="2">
					<combomultiedit name="cmbVrstadok" valuefield="VrstaDokId" displayfield="Opis" dataname="dtVrstaDokGet" showmultiselecttext="true" required="true" savevalue="app"/>
				</item>					
				<item caption="Odgovorna osoba:" col="1" row="3" >
					<searchedit name="srcOsobe" fieldtext="Osoba" fieldvalue="OsobeId" dataname="dtsrcOsobe" required="true" savevalue="app"/>
				</item>				
				<item caption="Org. shema" textvisible="false" col="1" row="4" >
					<searchedit name="srcOrgShema" fontsizedelta="1" fieldtext="Naziv" fieldvalue="OrgShemaId" dataname="dtOrgShema" required="true" savevalue="app"/>				
				</item>
				<item caption="Rok plaćanja:" col="1" row="5" highlight="false">
					<textedit name="txtRok" datavalue="" fontbold="true" required="true" savevalue="app"/>
				</item>				
			</group>
		</layout>				
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<action type="validate"/>
						<action type="confirm" value="Želite li kreirati odobrenja?"/>							
						<action  waittype="progress" waitcaption="Fakturiranje" waittext="kreiranje..." sleep="4000"/>											
						<action type="datarun nonquery" value="dtFakturiranje"/>
						<action type="message" value="Uspješno kreirana odobrenja!" />
						<action type="form close"/>
					</event>
				</button>			
				<button name="btnOdustani" caption="ZATVORI" type="cancel">

				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNG_Combo" name="dtVrstaDokGet">
				<parameter name="@Action" value="VrstaDok" />
				<parameter name="@Oznaka" value="30" />
			</data>		
			<data command="spTraziOrgShema" name="dtOrgShema">
				<parameter name="@uvjet" value="#srcOrgShema.text" />
			</data>		
			<data command="spKomercNakObracunFaktura" name="dtFakturiranje">
