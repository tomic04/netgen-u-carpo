<root version="1.0.0.1">
	<form name="frmRobnoBrisanje" type="master" caption="Brisanje robnog prometa" fixedsize="true" statusbar="true">
		<event type="init"> 
			<action type="datarun reader" value="~dtRobnoDatum"/>
			<action type="variable value" >
				<parameter name="Global.$DatumRobno" value="~dtRobnoDatum.@Datum" type="date" />
			</action>
		</event>
		<event type="load">	
			<action type="control disable" value="#datDatumDo"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="true">
				<item col="1" row="1" textposition="top" caption="Datum:">
					<dateedit  name="datDatumDo"  datavalue="~dtRobnoDatum.@Datum">
					</dateedit>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnIzvrsi" caption="&amp;U REDU" dock="left">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati robno promet od datuma: {#datDatumDo}?">
							<action type="datarun nonquery" value="~dtRobnoBrisanje">
								<action type="form close"/>	
							</action>
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>						
				<button caption="UPUTI ME" type="HELP" dock="right" />
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spC_Robno_Brisanje" name="dtRobnoDatum">
				<parameter name="@action" value="0"/>
			</data>
			<data command="spC_Robno_Brisanje" name="dtRobnoBrisanje">
				<parameter name="@action" value="1"/>
				<parameter name="@datum" value="#datDatumDo" type="date"/>
			</data>
		</datalist>
	</form>
</root>