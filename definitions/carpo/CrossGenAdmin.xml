<root version="1.0.0.1">
	<!-- <form name="frmSplitterForm" type="master" caption="Test Jaca" template="splitter"> -->
	<form name="frmTestForm" type="master" caption="Test Jaca" >
		<event type="init">	
			<action type="datarun reader" value="~datCGIzvjestajiL" />			
		</event>
		<event type="load">
			<action type="control populate" value="#grdOperateriD"/>
			<action type="control populate" value="#treeIzvL"/>
		</event>
		<event type="shown">  
		</event>
		<layout>
			<group padding="0" groupbordervisible="False" cols="1" rows="1">
				<tabs name="tabs" row="1" col="1">
					<event type="selectedtabchanged">
						<action if="#tabs.selectedtab==tabIzv">
							<action type="control populate" value="#grdOperateriD"/>
							<action type="control populate" value="#treeIzvL"/>
						</action>
						<action elseif="#tabs.selectedtab==tabOp">
							<action type="control populate" value="#grdOperateriL"/>
							<action type="control populate" value="#treeIzvD"/>
						</action>
					</event>
					<group name="tabIzv" caption="Pregled po izvještajima" cols="2" rows="1">
						<columnsdefinition>
							<column size="50%" position="1" />
							<!-- <column size="10%" position="2" /> -->
							<column size="50%" position="2" />
						</columnsdefinition>
						<group caption="Izvještaji:" padding="0" groupbordervisible="true" cols="1" rows="1" col="1" row="1" >
							<item row="1" col="1" highlight="False" >

								<tree name="treeIzvL" keyfield="id" allowselfdrag="true" dataname="datCGMultiL" parentfield="ParentId" showcolumns="true" autofiltercondition="contains" expandallonload="true" expandedlevel="2">
									<event type="focusedrowchanged">
										<action type="control populate" value="#grdOperateriD"/>      
									</event>

									<fields>
										<field name="Naziv" caption="Naziv" fixwidth="200"/>
									</fields>
									
									<styles>								
										<style name="fontcolor" value="red" if="#treeIzvL.@Tip==0" />						
										<style name="fontcolor" value="green" if="#treeIzvL.@Tip==1"/>										
									</styles>
								</tree>
							</item>
						</group>

						<group caption="Operateri:" padding="0" groupbordervisible="true" cols="1" rows="1" col="2" row="1">
							<item row="1" col="1" highlight="False" >
								<grid name="grdOperateriD" multiselect="true" key="operateriid" showgrouppanel="false" showfooter="false" savelayout="false"  cleargridfilter="true" showcheckboxes="true">															
									<data command="spManCrossGen_PregledOperatera">
                                      <parameter name="@CrossGenLayoutId" value="#treeIzvL.@Id" />									
									</data>
									<fields inherited="true">
										<event type="showingeditor">
											<action type="editor allow" value="true"/>
										</event>
										<field name="Checked" caption=" " editable="true" edittype="bit" showtotalsum="false"/>
										<field name="operateriid" caption="operateriid" fixwidth="50" hidden="true"/>
										<field name="OperaterNaziv" caption="Operateri" fixwidth="300"/>
									</fields>

									<styles>								
										<style name="fontcolor" value="green" if="#grdOperateriD.@CGAdminId==0" />						
										<style name="bold" value="true" if="#grdOperateriD.@CGAdminId==1"/>										
									</styles>							
								</grid>
							</item>
						</group>
					</group>  


					<group name="tabOp" caption="Pregled po operaterima" cols="3" rows="1">
						<columnsdefinition>
							<column size="50%" position="1" />
							<column size="50%" position="2" />
						</columnsdefinition>

						<group caption="Operateri:" padding="0" groupbordervisible="true" cols="1" rows="1" col="1" row="1">
							<item row="1" col="1" highlight="False" >
								<grid name="grdOperateriL" multiselect="true" key="operateriid" showgrouppanel="false" showfooter="false" savelayout="false"  cleargridfilter="true" showcheckboxes="true">															
									<data command="spManCrossGen_PregledOperatera">							
									</data>
									<fields inherited="true">
										<event type="showingeditor">
											<action type="editor allow" value="true"/>
										</event>
										<!-- <field name="fieldsOp" editable="true" edittype="bit"/>                    							 -->
										<field name="operateriid" caption="operateriid" fixwidth="50" hidden="true"/>
										<field name="OperaterNaziv" caption="Operateri" fixwidth="300"/>
									</fields>

									<styles>								
										<style name="fontcolor" value="green" if="#grdOperateriL.@CGAdminId==0" />						
										<style name="bold" value="true" if="#grdOperateriL.@CGAdminId==1"/>										
									</styles>							
								</grid>
							</item>
						</group>
						<group caption="Izvještaji:" padding="0" groupbordervisible="true" cols="1" rows="1" col="2" row="1" >
							<item row="1" col="1" highlight="False" >

								<tree name="treeIzvD" keyfield="id" allowselfdrag="true" dataname="datCGMultiD" parentfield="ParentId" showcolumns="true" autofiltercondition="contains" expandallonload="true" expandedlevel="2">
									<fields>
										<field name="Naziv" caption="Naziv" fixwidth="200"/>
									</fields>
								</tree>
							</item>
						</group>

					</group>
				</tabs>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremiPrava" caption="&amp;SPREMI" type="add">
					<event type="click">

					</event>
				</button>
				<button name="btnZamijeni" caption="&amp;ZAMIJENI OPERATERA" type="add">
					<event type="click">

					</event>
				</button>
				<button name="btnOdustani" caption="&amp;ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spCrossGenIzvjestajiQuery" name="datCGMultiL">
				<parameter name="@Action" value="1" />
				<parameter name="@OperaterId" value="92" />
				<parameter name="@SelOperaterId" value="50" />
			</data>

			<data command="spCrossGenIzvjestajiQuery" name="datCGMultiD">
				<parameter name="@Action" value="1" />
				<parameter name="@OperaterId" value="92" />
				<parameter name="@SelOperaterId" value="50" />
			</data>

		</datalist>
	</form>

</root>


