<?xml version="1.0" encoding="utf-8"?>
<!-- KUPNGSpin_KUP_URA - subforma: ZAPFORM (NetGen) → frmZaprimi (Carpo) -->
<root version="1.2">
  <form name="frmZaprimi" caption="Zaprimi" type="dialog" width="420" height="180" fixedsize="true">
    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item col="1" row="1" caption="Želite li označiti dokument kao zaprimljen?" textposition="left">
          <label/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnZaprimi" caption="ZAPRIMI">
          <event type="click" waittype="progress" waitcaption="Obrada" waittext="Zapriman...">
            <action type="datarun nonquery" value="~dtZaprimi"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data name="dtZaprimi" command="spKUPPrometAzurN" timeout="300">
        <!-- NetGen: spKUPPrometAzurN 4,@ID=@@id,@OperateriId=@@operateriid -->
        <parameter name="@action" value="4"/>
        <parameter name="@ID" value="$Id"/>
        <parameter name="@OperateriId" value="@@operateriid"/>
        <parameter name="RaiseInfoMsg" value="true"/>
      </data>
    </datalist>
  </form>
</root>

