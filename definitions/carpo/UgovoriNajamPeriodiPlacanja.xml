<root>
	<form name="frmGlavna" type="master" caption="Periodi plaćanja">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="dtNapuniGrid" multiselect="true">
				<fields>
					<field name="naziv" caption="Naziv" />
					<field name="BrojMjeseci" caption="Broj mjeseci" />
				</fields>
			</grid>
		</managerlayout>

			<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="UNESI">
						<event type="click">
							<action type="form open" value="frmUnos" />
						</event>
					</button>

					<button name="btnIzmjeni" caption="IZMJENI">
						<event type="click">
							<action type="form open" value="frmIzmjena">
								<parameter name="UgovoriNajamPeriodiPlacanjaID" value="#grdGlava.@UgovoriNajamPeriodiPlacanjaID" />
								<parameter name="naziv" value="#grdGlava.@naziv" />
								<parameter name="BrojMjeseci" value="#grdGlava.@BrojMjeseci" />
							</action>
						</event>
					</button>

					<button name="btnObrisi" caption="OBRIŠI">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku?" />
							<action type="control foreachrow selected" value="#grdGlava">
								<action type="datarun nonquery" value="~dtDelete" />
							</action>
							<action type="control populate" value="#grdGlava" />
						</event>
					</button>
				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamPeriodiPlacanja_query" name="dtNapuniGrid" />
			<data command="spUgovoriNajamPeriodiPlacanja_delete" name="dtDelete">
				<parameter name="UgovoriNajamPeriodiPlacanjaID" value="#grdGlava.@UgovoriNajamPeriodiPlacanjaID" />
			</data>
		</datalist>

	</form>

	<form name="frmUnos" caption="Unesi">
		<layout>
			<group cols="1" rows="2" col="1" row="2">
				<item col="1" row="1" caption="Naziv">
					<textedit name="txtNaziv" value="" required="true" />
				</item>
				<item col="1" row="2" caption="Broj mjeseci:">
					<textedit name="txtBrojMjeseci" format="n0" value="" required="true" />
				</item>
			</group> 
		</layout>


			<panelbuttons>
				<buttons>
					<button name="btnUnesi" caption="Spremi">
						<event type="click">
							<action type="validate" />
							<action type="datarun nonquery" value="~dtInsert" />
							<action type="control populate" value="parent.#grdGlava" />
							<action type="form close" />
						</event>
					</button>

					<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>

				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamPeriodiPlacanja_insert" name="dtInsert">
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@brojMjeseci" value="#txtBrojMjeseci" />
			</data>
		</datalist>

	</form>

	<form name="frmIzmjena" caption="Izmjeni">

		<event type="init">
				<action type="datarun reader" value="dtGet" />
		</event>


			<layout>
				<group cols="1" rows="2" col="1" row="2">
					<item col="1" row="1" caption="Naziv:">
						<textedit name="txtNaziv" required="true" datavalue="~dtGet.@naziv"/>
					</item>

					<item col="1" row="2" caption="Broj mjeseci:" >
						<textedit name="txtBrojMjeseci" required="true" datavalue="~dtGet.@BrojMjeseci" format="n0" />
					</item>
				</group>
			</layout>


		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUpdate" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>

				<button name="btnCancel" type="cancel" caption="Odustani" dock="right" />

			</buttons>
		</panelbuttons>

	<datalist>
		<data command="spUgovoriNajamPeriodiPlacanja_EditQuery" name="dtGet">
			<parameter name="@UgovoriNajamPeriodiPlacanjaID" value="$UgovoriNajamPeriodiPlacanjaID" />
		</data>
		<data command="spUgovoriNajamPeriodiPlacanja_Update" name="dtUpdate">
			<parameter name="@UgovoriNajamPeriodiPlacanjaID" value="$UgovoriNajamPeriodiPlacanjaID" />
			<parameter name="@naziv" value="#txtNaziv" />
			<parameter name="@BrojMjeseci" value="#txtBrojMjeseci" />
		</data>
	</datalist>

	</form>
</root>