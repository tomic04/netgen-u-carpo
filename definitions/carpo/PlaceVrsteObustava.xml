<root>

  <!--
    8.9.2021. Marin - namjestio caption za checkedit za DevX20
  -->

	<form name="frmMain" caption="Vrste obustava" type="master">

		<event type="load">
			<action if="#trDrvo.@id==-1">
				<action type="control disable" value="#btnIzmjeni,#btnObrisi"></action>
			</action>
		</event>

		<managerlayout>

      <lookup name="cmbFilter">
        <comboitem value="Aktivne" />
        <comboitem value="Umirovljene" />

        <event type="valuechanged">
          <action type="variable value">
            <parameter name="global.filter" value="#cmbFilter" />
          </action>
          <action type="control populate" value="#trDrvo"></action>

        </event>
      </lookup>

			<tree name="trDrvo" expandallonload="true" dataname="dtTree" keyfield="OOPvrsteObustavaId" allowselfdrag="true" showcolumns="true" expandedlevel="2" autofiltercondition="contains">
				<fields>
					<field name="Naziv" />
				</fields>

				<event type="focusedrowchanged">
					<action if="#trDrvo.@id==-1">
						<action type="control disable" value="#btnIzmjeni,#btnObrisi"></action>
					</action>
					<action else="">
						<action type="control enable" value="#btnIzmjeni,#btnObrisi"></action>
					</action>
				</event>

			</tree>
		</managerlayout>

		<panelbuttons displaycontrolsprint="false">
            <buttons type="tree">


				<button name="btnDrag" caption="SPREMI PROMJENE" type="selfdrag">
				<event type="click">
					<action type="datarun nonquery" value="~dtOrgAzur" />
					<action type="control defaultmode" value="#trDrvo" />
				</event>
				</button>
				
				<button name="btnDrag" caption="ODUSTANI" type="selfdragcancel">
				<event type="click">
					<action type="confirm" value="Želite odustati od reorganizacije?">
					<action type="control populate" value="#trDrvo" />
					<action type="control dragmode" value="#trDrvo" />
					</action>
				</event>
				</button>



				<button name="btnUnos" caption="Dodaj" type="add" image="add">
                    <event type="click">
                        <action type="form open" value="frmUnos">
							<parameter name="caption" value="UNOS OBUSTAVE"></parameter>
							<parameter name="id" value="0" />
							<parameter name="FormType" value="Unesi"/>
						</action>
						<action type="control populate" value="#trDrvo" />
                    </event>
                </button>
				<button name="btnIzmjeni" caption="Izmjeni" type="edit" image="edit">
					<event type="click">
						<action type="form open" value="frmUnos">	
							<parameter name="caption" value="IZMJENA OBUSTAVE"></parameter>						
							<parameter name="id" value="#trDrvo.@OOPvrsteObustavaId" />
							<parameter name="FormType" value="Izmjeni" />
						</action>
						<action type="control populate keepfocus" value="#trDrvo"/>
					</event>
				</button>
				<button caption="Obriši" name="btnObrisi" type="delete" image="delete">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati vrstu obustave '{#trDrvo.@Naziv}'?">
							<action type="datarun nonquery" value="~dtDelete">
								<action type="control populate" value="#trDrvo" />
							</action>
						</action>
					</event>
				</button>

            </buttons>
        </panelbuttons>

		<datalist>
			<data name="dtTree" command="spPlaceVrsteObustava">
				<parameter name="@Action" value="tree"/>
				<parameter name="@filter" value="global.$filter"/>
			</data>

			<data command="spPlaceVrsteObustava" name="dtDelete">
				<parameter name="@Action" value="BRISANJE_JEDAN" />
				<parameter name="@id" value="#trDrvo.@OOPvrsteObustavaId"/>
			</data>

			<data command="spPlaceVrsteObustava" name="dtOrgAzur">
				<parameter name="@Action" value="setTree" />
				<parameter name="@TableVar" value="#trDrvo.datasource" />
			</data>

		</datalist>
	</form>

	<!--
  *******************************************************************************************
  FORMA ZA UNOS/IZMJENU
  *******************************************************************************************
  -->

  <form name="frmUnos" caption="$caption" width="400" height="300">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$Id!=0" />
    </event>

    <layout>
      <group cols="1" rows="3" groupbordervisible="false">
        <item caption="Oznaka" col="1" row="1" textposition="top" highlight="false">
          <textedit name="txtOznaka" datavalue="~dtget.@Oznaka" allownull="false" required="true" tooltip="Jedinstvena oznaka unutar kataloga" maxlength="10"></textedit>
        </item>
        <item caption="Naziv" col="1" row="2" textposition="top" highlight="false">
          <textedit name="txtNaziv" datavalue="~dtget.@Naziv" allownull="false" required="true" maxlength="50"></textedit>
        </item>
        <item col="1" row="3" highlight="false">
          <checkedit name="chkUmirovljeno" caption="Umirovljeno" datavalue="~dtget.@Umirovljeno"></checkedit>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Spremi">
          <event type="click">
            <action type="validate" />
            <action if="$Id==0">
              <action type="datarun reader" value="~dtUnos">
              </action>
              <action if="$indGreske==0">
                <action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
              </action>
            </action>
            <action if="$Id!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
              <action if="$indGreske==0">
                <action type="message" value="Uspješno spremljeno!" />
                <action type="form close" />
              </action>

              <!--<action type="form close"></action>-->
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceVrsteObustava" name="dtGet">
        <parameter name="@action" value="dtGet"></parameter>
        <parameter name="@id" value="$Id"></parameter>
      </data>
      <data command="spPlaceVrsteObustava" name="dtUnos">
        <parameter name="@action" value="insert"></parameter>
        <parameter name="@Id.output.int" variablename="noviID"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
        <parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
		<parameter name="@Sortkey" value="parent.#trDrvo.@Sortkey"/>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
      <data command="spPlaceVrsteObustava" name="dtIzmjena">
        <parameter name="@action" value="update"></parameter>
        <parameter name="@id" value="$Id"></parameter>
        <parameter name="@oznaka" value="#txtOznaka"></parameter>
        <parameter name="@naziv" value="#txtNaziv"></parameter>
        <parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
		<parameter name="@Sortkey" value="parent.#trDrvo.@Sortkey"/>
        <parameter name="@indGreske.output.int"></parameter>
      </data>
    </datalist>
  </form>


</root>