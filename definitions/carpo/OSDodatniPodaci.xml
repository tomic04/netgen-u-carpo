<root version="1.1">
  
  <!--1.1. MZ - maxlength na oznaka i tip-->
  
  <form name="frmDodatni" type="master" caption="Dodatni podaci" width="200" height="250">

    <managerlayout textposition="left">
      <grid name="grdDodatni" type="master" dataname="dtDodatni" showautofilterrow="false">

      </grid>
    </managerlayout>
    
    <panelbuttons>
      <buttons>
        <!--GUMB UNESI-->
        <button name="btnUnesi" caption="Unos novog podatka" type="add" function="UnesiDodatni">
          <event type="click">
            <action type="form open" value="frmPromjena">
            </action>
          </event>
        </button>
        <!--GUMB IZMIJENI-->
        <button name="btnIzmijeni" caption="Izmjena podatka" type="edit" function="IzmijeniDodatni">
          <event type="click">
            <action type="form open" value="frmPromjena">
              <!--ovdje salje id doprinosa sa grida ukoliko je kliknut gumb izmijeni-->
              <parameter name="OSDodPodaciId" value="#grdDodatni.@OSDodPodaciId" />
            </action>
            <action type="control populate keepfocus" value="#grdDodatni" />
          </event>
        </button>
        <!--GUMB OBRIŠI-->
        <button name="btnBrisi" caption="Brisanje podatka" type="delete" function="ObrisiDodatni">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označeni zapis?">
              <action type="datarun nonquery" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdDodatni"></action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    
    <datalist>
      <data command="spOSDodPodaciQueryCP" name="dtDodatni">
        <parameter name="@Action" value="Master" type="string"/>
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtDelete">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@OSDodPodaciId" value="#grdDodatni.@OSDodPodaciId" />
      </data>
    </datalist>
  </form>


  <!--LAYOUT FORMA ZA UNOS/BRISANJE/IZMJENU STATUSA-->
  <form name="frmPromjena" caption="Dodatni podaci" height="435"  width="400" >
    <event type="init">
      <!--ovaj init služi da pokupi podatke s grida ukoliko je nešto odabrano i kliknut će se na gumb izmijeni-->
      <!--dtget.naziv kupi popunjene podatke sa master grida-->
      <action type="datarun reader" value="~dtGet" if="$OSDodPodaciId!=null"/>
    </event>

    <layout textposition="left" >
      <group cols="1" rows="9"   groupbordervisible="false">
        <item caption="Opis:" row="1" col="1" highlight="false">
          <textedit name="txtOpis" datavalue="~dtGet.@Opis"  />
        </item>
        <item caption="Oznaka:" row="2" col="1" highlight="false">
          <textedit name="txtOznaka"  datavalue="~dtGet.@Oznaka" maxlength="10"/>
        </item>
        <item caption="Tip:" row="3" col="1" highlight="false">
          <comboedit name="cmbTip"  datavalue="~dtGet.@Tip" dataname="~dtTip" valuefield="valid" displayfield="tekst" allownull="false" maxlength="1"/>
        </item>
        <item  row="4" col="1">
          <checkedit caption="Umirovljeno" name="chkUmirovljeno" datavalue="~dtGet.@Umirovljen" />
        </item>
      </group >
    </layout>
    
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <!-- Okini storu -->
            <!--ukoliko je id null onda ide action add, ukoliko nije onda edit-->
            <action type="datarun nonquery" value="~dtEdit" if="$OSDodPodaciId!=null"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            <!-- Osvježi grid na parent formi -->
            <action type="form close"></action>
            <action type="control populate" value="parent.#grdDodatni"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" />
      </buttons>
    </panelbuttons>

    <datalist>
      <!--punjenje comba vrsta-->
      <data command="spOSDodPodaciQueryCP" name="dtGet">
        <parameter name="@Action" value="Dodatno_edit" />
        <parameter name="@OSDodPodaciId" value="$OSDodPodaciId"/>       
      </data>
      <data command="spOSDodPodaciQueryCP" name="dtTip">
        <parameter name="@Action" value="Combo_tip" />
      </data>
      <!--action koji se poziva ukoliko je unos u pitanju- onda se combo postavlja na prvi id iz tablice-->
      <data command="spOSDodPodaciAzurCP" name="dtEdit">
        <parameter name="@Action" value="Izmjena" />
        <parameter name="@OSDodPodaciId" value="$OSDodPodaciId" />
        <parameter name="@Opis" value="#txtOpis" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@Tip" value="#cmbTip" />
        <parameter name="@Umirovljen" value="#chkUmirovljeno"/>
      </data>
      <!--okidanje store i unos novih podataka u bazu-->
      <data command="spOSDodPodaciAzurCP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@Opis" value="#txtOpis" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@Tip" value="#cmbTip" />
        <parameter name="@Umirovljen" value="#chkUmirovljeno"/>
      </data>
    </datalist>

  </form>

</root>