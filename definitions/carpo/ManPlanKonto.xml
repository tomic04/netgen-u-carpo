<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
	<form name="frmMaster" type="master" caption="Plan po analitičkim kontima"> 
		<event type="init">
	    <action type="control populate" value="#grdGlava" />
		</event>
    <event type="load">
				<action type="variable value" >
					<parameter name="NoviManPlanKontoGlaId" value="0" type="int"/>
				</action>
      
        <action type="variable value" >
					   <parameter name="PubVarDimenzije" value="0" type="int"/>
				 </action>

      <action type="variable value" >
        <parameter name="Poruka" value="" type="string"/>
      </action>
    
    </event> 
    <event type="shown">
         <action type="control disable" value="#btnIzmijeni,#btnObrisi,#btnPlan" if="#grdGlava.rowcount==0"/>
					<action type="control enable" value="#btnIzmijeni,#btnObrisi,#btnPlan"  else="" />				
    </event> 
	  <managerlayout>
			<grid name="grdGlava" type="master" key="ManPlanKontoGlaId" autopopulate="false" showgroupsum="false" dataname="~dtPopuniGrid" savelayout="true" bestfitonrefresh="true" multiselect="true" showgrouppanel="false">
				<fields>
					<field name="Naziv" caption="Naziv" fixwidth="200" />
					<field name="Godina" caption="Godina" fixwidth="100"/>
					<field name="Verzija" caption="Verzija" fixwidth="100"/>
					<field name="GodinaRef" caption="Referentna godina" fixwidth="100"/>
          <field name="RefNaziv" caption="Referentni plan" fixwidth="200" align="right"/>
				</fields>
				<event type="focusedrowchanged">
					<action type="control disable" value="#btnIzmijeni,#btnObrisi" if="#grdGlava.rowcount==0"/>
					<action type="control enable" value="#btnIzmijeni,#btnObrisi"  else="" />					
				</event>			
			</grid>
		</managerlayout>
		<panelbuttons>		
			<buttons>
				<button name="btnUnesi" caption="&amp;Unesi" type="add">
					<event type="click">						
						<action type="form open" value="frmManPlanKontoUnos" >
							<parameter name="ManPlanKontoGlaId" value="null" />
							<parameter name="Ind_Unos" value="1" />
							<parameter name="Tekst" value="unos" type="string"/>
						</action>
            
						<action type="control disable" value="#btnIzmijeni,#btnObrisi" if="#grdGlava.rowcount==0"/>
						<action type="control enable" value="#btnIzmijeni,#btnObrisi"  else="" />						
					</event>
				</button>
        
				<button name="btnIzmijeni" caption="&amp;Izmijeni" type="edit">										
					<event type="click">
						<action type="form open" value="frmManPlanKontoUnos">
							<parameter name="ManPlanKontoGlaId" value="#grdGlava.@ManPlanKontoGlaId" />
							<parameter name="Ind_Unos" value="0" />
							<parameter name="Tekst" value="izmjena" type="string" />												
						</action>							
					</event>
				</button>
        
				<button name="btnObrisi" caption="&amp;Obriši" type="delete">
					<event type="click">
            
            <action type="datarun scalar" value="~dtRefProvjera">
              <parameter name="$Poruka"/>
            </action>
            
            <action type="confirm" value="$Poruka">
							<action type="datarun nonquery" value="dtDelete">
								<action type="control populate" value="#grdGlava" />
							</action>
						</action>

            <action type="control populate" value="#grdGlava"/>
              
						<action type="control disable" value="#btnIzmijeni,#btnObrisi" if="#grdGlava.rowcount==0"/>
						<action type="control enable" value="#btnIzmijeni,#btnObrisi"  else="" />					
            
					</event>
				</button>

        <button name="btnTest" caption="" visible="false"> 
        </button>
        <button name="btnTest1" caption="" visible="false">
        </button>
        <button name="btnTest2" caption="" visible="false">
        </button>
        <button name="btnTest3" caption="" visible="false">
        </button>
        <button name="btnTest4" caption="" visible="false">
        </button>
        <button name="btnTest5" caption="" visible="false">
        </button>
        <button name="btnTest6" caption="" visible="false">
        </button>
        
        <button name="btnPlan" caption="&amp;Plan">
          <event type="click">
            <action type="form open" value="frmManPlanKontoDetaljUnos">
              <parameter name="ManPlanKontoGlaId" value="#grdGlava.@ManPlanKontoGlaId"/>
              <parameter name="Tekst" value="Plan troškova za godinu {#grdGlava.@Godina}. , referentna godina {#grdGlava.@GodinaRef}." type="string" />
              <parameter name="Godina" value="#grdGlava.@Godina"/>
              <parameter name="GodinaRef" value="#grdGlava.@GodinaRef"/>
              <parameter name="PubVarDimenzije" value="0" />
            </action>
          </event>
        </button>
        
			</buttons>
		</panelbuttons> 
  
    <datalist>	
      
      <data command="spManPlanKontoGlaQuery" name="dtPopuniGrid"/>

      <data command="spManPlanKontoGlaAzur" name="dtRefProvjera">
        <parameter name="@action" value="refprovjera"/>
        <parameter name="@id" value="#grdGlava.@ManPlanKontoGlaId" />
      </data>

      <data command="spManPlanKontoGlaAzur" name="dtDelete">
        <parameter name="@action" value="brisanje"/>
        <parameter name="@id" value="#grdGlava.@ManPlanKontoGlaId" />
      </data>
      
	</datalist>	
    
	</form>
  
  <form name="frmManPlanKontoUnos" path="frmManPlanKontoUnos.xml"/>
  <form name="frmManPlanKontoDetaljUnos" path="frmManPlanKontoDetaljUnos.xml"/>
  <form name="frmManPlanKontoMjeseci" path="frmManPlanKontoMjeseci.xml"/>
  <form name="frmManPlanPrikazPoMjesecima" path="frmManPlanPrikazPoMjesecima.xml"/>
  <form name="frmManPlanPrikazPoDimenzijama" path="frmManPlanPrikazPoDimenzijama.xml"/>
  


  <datalist>	
    <data command="spManPlanKontoGlaQuery" name="dtPopuniGrid"/>
    
    <data command="spManPlanKontoGlaGet" name="dtGet">
      <parameter name="@id" value="$ManPlanKontoGlaId" />
    </data>
    

	</datalist>	
  </root>