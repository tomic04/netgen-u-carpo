<root>
  <form name="frmMaster" type="master" caption="Kartica smještaja Imovine">
    
    <!--<event type="init">
      <action type="variable value">
        <parameter name="Click" value="" type="string"/>
      </action>
    </event>-->

    <!--<event type="onload">
      <action type="control disable" value="#btnIzmjena,#btnBrisanje,#btnZakljucak,#btnPonisti, #btnIspis " if="#grdSmjestaj.@OSImovinaSmjestajGlaId==null" />
      <action type="control enable" value="#btnIzmjena,#btnBrisanje,#btnZakljucak,#btnPonisti, #btnIspis " else="" />
    </event>-->

    <managerlayout>
      <!--filter drveta-->
      <lookup name="filter" >
        <comboitem value="Smjestaj" caption="Smještaj"/>
        <comboitem value="Organizacijske jedinice" />
        <comboitem value="Osobe"/>
        
        <event type="valuechanged">
          <action type="variable value">
            <parameter name="global.filter" value="#filter" />
          </action>
        </event>
      </lookup>

      <!--*****stablo*****-->
      <tree name="tree"  keyfield="OSImovinaId"  filtermode="smart" expandedlevel="2" dataname="dtTree" >
        <event type="focusedrowchanged">
          <action type="control populate" value="#grdMaster" />
        </event>
        <data if="#filter==Smjestaj" command="spOSImovinaKarticaTree_CP">
          <parameter name="@Action" value="Filter_smjestaj" />
        </data>
        <data if="#filter==Organizacijske jedinice" command="spOSImovinaKarticaTree_CP">
          <parameter name="@Action" value="Filter_orgshema" />
        </data>
        <data if="#filter==Osobe" command="spOSImovinaKarticaTree_CP">
          <parameter name="@Action" value="Filter_osoba" />
        </data>
        <fields>
          <field name="Naziv" />
        </fields>
      </tree>

      <!--Master grid--> 
      <grid name="grdMaster" key="OSImovinaId" type="master" async="true" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" >
        <event type="focusedrowchanged">
          <action type="control populate" value="#grdDetalj" />
        </event>
        <fields inherited="true">
        </fields>
          <data command="spOSImovinaKarticaQuery_CP" if="#filter==Smjestaj">
            <parameter name="@Action" value="Master_smjestaj"  />
            <parameter name="@SmjestajId" value="#tree.@ID" />
          </data>
          <data command="spOSImovinaKarticaQuery_CP" if="#filter==Organizacijske jedinice" >
            <parameter name="@Action" value="Master_orgshema" />
            <parameter name="@OrgShemaId" value="#tree.@ID" />
          </data>
          <data command="spOSImovinaKarticaQuery_CP" if="#filter==Osobe">
            <parameter name="@Action" value="Master_osoba"/>
            <parameter name="@HRKadroviId" value="#tree.@ID" />
          </data>
      </grid>
      <!--Detalj grid-->
      <grid name="grdDetalj"  type="detalj" async="True" bestfitonrefresh="true" key="OSImovinaSmjestajDetId" fieldsmartspaces="false" >
        <data command="spOSImovinaKarticaQuery_CP">
          <parameter name="@Action" value="Detalj_query"/>
          <parameter name="@OSImovinaId" value="#grdMaster.@OSImovinaId"/>
        </data>
        <fields inherited="true"  >
        </fields>
      </grid>
    </managerlayout>
    
    <datalist>
      <!--data koji puni drvo-->
      <data command="spOSImovinaKarticaTree_CP" dataname="dtTree">
        <parameter name="@Action" value="Filter_smjestaj" if="global.$filter==Smjestaj"/>
        <parameter name="@Action" value="Filter_orgshema" if="global.$filter==Organizacijske jedinice"/>
        <parameter name="@Action" value="Filter_osoba" if="global.$filter==Osobe"/>
      </data>
    </datalist>
  </form>
  
</root>


