<root>
	<form name="frmMaster" type="master" caption="Načini isporuke">
		<managerlayout>
			<grid type="Master" name="grdMaster" dataname="~dtPuniMaster" key="ProNacinIsporukeId">
				<fields>

				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnos" />
					</event>
				</button>


				<button name="btnIzmjeni" caption="IZMJENI">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
								<parameter name="ProNacinIsporukeId" value="#grdMaster.@ProNacinIsporukeId" />
								<parameter name="Naziv" value="#grdMaster.@Naziv" />
								<parameter name="Oznaka" value="#grdMaster.@oznaka" />
						</action>
					</event>
				</button>

				<button name="btnDelete" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati?">
						<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
			</buttons>	

		</panelbuttons>

	<datalist>
		<data command="spProd_NacinIsporuke_Grid" name="dtPuniMaster" />
    
		<data command="spProd_NacinIsporuke_Obrisi" name="dtDelete">
			<parameter name="ProNacinIsporukeId" value="#grdMaster.@ProNacinIsporukeId" />
		</data>
	</datalist>


	</form>

<form name="frmUnos" caption="Unos">
  
		<layout>
			<group cols="1" rows="2">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" value="" required="true"/>
				</item>
					<item col="1" row="2" caption="Oznaka:">
						<textedit name="txtOznaka" value=""/>
					</item>
			</group>
		</layout>

	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">
				<event type="click">
					<action type="validate" />
					<action type="datarun scalar" value="~dtSpremi">
             <parameter name="id" />
            </action>
              <action type="control populate" value="parent.#grdMaster" >
              <action type="control focus" value="parent.#grdMaster">
                <parameter value="$id" name="id" type="int"/>
            </action>
          </action>
          <action type="control value" value="##">
            <parameter value=""/>
          </action>
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">

			</button>
		</buttons>
	</panelbuttons>


	<datalist>
		<data command="spProd_NacinIsporuke_Unesi" name="dtSpremi">
			<parameter name="@naziv" value="#txtNaziv" />
			<parameter name="@oznaka" value="#txtOznaka" />
      <parameter name="@OperateriId" value="@@OperateriId" />     
		</data>

	</datalist>	

	</form>

<form name="frmIzmjeni" caption="Izmijeni">

	<event type="init">
			<action type="datarun reader" value="dtGet" />
	</event>

		<layout>
			<group cols="1" rows="2">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtGet.@naziv"/>
				</item>
				<item col="1" row="2" caption="Oznaka:">
					<textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" />
				</item>
			</group>
		</layout>

  
	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">
				<event type="click">
					<action type="validate" />
					<action type="datarun nonquery" value="~dtIzmjeni" />
					<action type="control populate" value="parent.#grdMaster" />
					<action type="form close" value="frmUnos"/>
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
		</buttons>
	</panelbuttons>

	<datalist>
		
		<data command="spProd_NacinIsporuke_Query" name="dtGet">
			<parameter name="@ProNacinIsporukeId" value="$ProNacinIsporukeId" />
		</data>

		<data command="spProd_NacinIsporuke_Izmjeni" name="dtIzmjeni">
				<parameter name="@ProNacinIsporukeId" value="$ProNacinIsporukeId" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@oznaka" value="#txtOznaka" />
        <parameter name="@OperateriId" value="@@OperateriId" />
    </data>

	</datalist>

</form>


</root>