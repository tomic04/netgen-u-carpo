<root version="1.1">
  
    <!--1.1. MZ saveformlayout dodan, maxlength na oznaka-->
  <form name="frmTemplate" type="master" caption="Dodatni podaci - predlošci" width="800" height="800" saveformlayout="false">

    <event type="oninit">
      <action type="datarun reader" value="~dtDodatniPodaciTemplate" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdDodatniPodaciTemplate" />
      <action type="control populate" value="#grdDodatniPodaci" />
    </event>

    <layout textposition="left">
      <group cols="2" rows="1" groupbordervisible="false">


        <group col="1" row="1" cols="4" rows="3" spacing="2,1,2,2" alignmode="local" caption="Unos predloška"  >
          <rowsdefinition>
            <row position="1" size="35"/>
            <row position="2" size="35"/>
            <row position="3" size="30"/>
          </rowsdefinition>
          <item caption="Naziv:"  row="1" col="1" colspan="3"  >
            <textedit name="txtNaziv" textposition="left" required="true" />
          </item>
          <item caption="Oznaka:"  row="1" col="4" >
            <textedit name="txtOznaka" textposition="left"/>
          </item>
          <item caption="Opis:"  row="2" col="1" colspan="3" >
            <textedit name="txtOpis" textposition="left" />
          </item>
          <item row="2" col="4">
            <button name="btnOSDodPodaciTemplateSpremi"  caption="Dodaj" function="DodajPredlozak">
              <event type="click">
                <action type="validate"/>
                <action type="datarun reader" value="~dtOSDodPodaciTemplateSpremi" />
                <action type="control populate keepfocus" value="#grdDodatniPodaciTemplate"/>
                <action type="control populate" value="#grdDodatniPodaci"/>
                <action type="control refreshvalue" value="##"/>
              </event>
            </button>
          </item>
          <item col="1" row="3" caption="Predložak" textposition="top" fontbold="true" colspan="4">
            <grid name="grdDodatniPodaciTemplate" key="OSDodPodaciTemplateId" dataname="~dtDodatniPodaciTemplate" fieldsmartspaces="false" showautofilterrow="false" bestfitonrefresh="true">
              <menu>
                <menuitem caption="Obriši predložak" sort="1" function="ObrisiPredlozak">
                  <event type="click">
                    <action type="datarun reader" value="~dtObrisiTemplate"/>
                    <action type="control refreshvalue" value="#grdDodatniPodaciTemplate"/>
                    <action type="control refreshvalue" value="#grdDodatniPodaci"/>
                  </event>
                </menuitem>
                <menuitem caption="Izmijeni predložak" sort="2" function="IzmijeniPredlozak">
                  <event type="click">
                    <action type="form open" value="frmIzmjena">
                      <parameter name="TemplateId" value="#grdDodatniPodaciTemplate.@OSDodPodaciTemplateId" />
                    </action>
                    <action type="control refreshvalue" value="#grdDodatniPodaciTemplate"/>
                  </event>
                </menuitem>
              </menu>
              <event type="focusedrowchanged">
                <action type="control populate" value="#grdDodatniPodaci"/>
              </event>
            </grid>
          </item>
        </group>

        <group col="2" row="1" cols="4" rows="3" spacing="1,2,2,2" caption="Unos dodatnog podatka" >
          <rowsdefinition>
            <row position="1" size="35"/>
            <row position="2" size="35"/>
            <row position="3" size="30"/>
          </rowsdefinition>
          <item caption="Dodatni podatak:" col="1" row="1"  colspan="3">
            <comboedit name="cmbDodPodaci" valuefield="OSDodPodaciId" displayfield="Opis" dataname="~dtOSDodPodaci" allownull="false" />
          </item>
          <item row="1" col="4">
            <button name="btnOSDodPodaciTemplateDetSpremi"  caption="Dodaj" function="DodajDodatniPredlozak">
              <event type="click">
                <action type="datarun reader" value="~dtOSDodPodaciTemplateDetSpremi" />
                <action type="control populate keepfocus" value="#grdDodatniPodaciTemplate"/>
                <action type="control populate" value="#grdDodatniPodaci"/>
                <action type="control refreshvalue" value="#cmbDodPodaci"/>
                <action type="control focus" value="#cmbDodPodaci"/>
              </event>
            </button>
          </item>
          <item col="1" row="3" caption="Dodatni podaci" textposition="top" fontbold="true"  colspan="4">
            <grid name="grdDodatniPodaci" dataname="~dtDodatniPodaci" fieldsmartspaces="false" showautofilterrow="false" bestfitonrefresh="true">
              <menu>
                <menuitem caption="Obriši dodatni podatak" sort="1" function="ObrisiDodatniPredlozak">
                  <event type="click">
                    <action type="datarun reader" value="~dtObrisiDodPodatak"  />
                    <action type="control refreshvalue" value="#grdDodatniPodaci"/>
                  </event>
                </menuitem>
              </menu>
            </grid>
          </item>
        </group>
      </group>
    </layout>

    <datalist>
      <data command="spOSDodPodaciQueryCP" name="dtDodatniPodaciTemplate">
        <parameter name="@Action" value="Master_template" />
      </data>
      <data command="spOSDodPodaciQueryCP" name="dtDodatniPodaci">
        <parameter name="@Action" value="Detalj_template" />
        <parameter name="@OSDodPodaciTemplateId" value="#grdDodatniPodaciTemplate.@OSDodPodaciTemplateId" />
      </data>
      <data command="spOSDodPodaciQueryCP" name="dtOSDodPodaci">
        <parameter name="@Action" value="Combo_DodPodaci" />
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtObrisiTemplate">
        <parameter name="@Action" value="Brisi_template" />
        <parameter name="@OSDodPodaciTemplateId" value="#grdDodatniPodaciTemplate.@OSDodPodaciTemplateId" />
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtObrisiDodPodatak">
        <parameter name="@Action" value="Brisi_DodPodatak" />
        <parameter name="@OSDodPodaciTemplateDetId" value="#grdDodatniPodaci.@OSDodPodaciTemplateDetId" />
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtOSDodPodaciTemplateSpremi">
        <parameter name="@Action" value="Dodaj_template" />
        <parameter name="@NazivT" value="#txtNaziv" />
        <parameter name="@OznakaT" value="#txtOznaka" />
        <parameter name="@OpisT" value="#txtOpis" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtOSDodPodaciTemplateDetSpremi">
        <parameter name="@Action" value="Dodaj_podatak" />
        <parameter name="@OSDodPodaciTemplateId" value="#grdDodatniPodaciTemplate.@OSDodPodaciTemplateId" />
        <parameter name="@OSDodPodaciId" value="#cmbDodPodaci" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
    </datalist>
  </form>

  <!-- ****************************  IZMJENA PREDLOŠKA  ************************** -->
  <form name="frmIzmjena" caption="Izmjena predloška" width="400" height="150">
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="3" groupbordervisible="false">
        <item caption="Naziv:"  row="1" col="1" colspan="3"  >
          <textedit name="txtNaziv" datavalue="~dtGet.@Naziv" textposition="left" required="true" />
        </item>
        <item caption="Oznaka:"  row="2" col="1" >
          <textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" textposition="left" maxlength="10"/>
        </item>
        <item caption="Opis:"  row="3" col="1" colspan="3" >
          <textedit name="txtOpis" datavalue="~dtGet.@Opis" textposition="left" />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button caption="Spremi" type="add" dock="left">
          <event type="click">
            <action type="datarun reader" value="~dtIzmjena" />
            <action type="form close"/>
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSDodPodaciQueryCP" name="dtGet">
        <parameter name="@Action" value="Template_get" />
        <parameter name="@OSDodPodaciTemplateId" value="$TemplateId" />
      </data>
      <data command="spOSDodPodaciAzurCP" name="dtIzmjena">
        <parameter name="@Action" value="Template_izmjena" />
        <parameter name="@OSDodPodaciTemplateId" value="$TemplateId" />
        <parameter name="@NazivT" value="#txtNaziv" />
        <parameter name="@OznakaT" value="#txtOznaka" />
        <parameter name="@OpisT" value="#txtOpis" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
    </datalist>
  </form>


</root>