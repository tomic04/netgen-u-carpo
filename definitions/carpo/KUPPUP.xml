<root version="1.0.0.1">
	<form name="izvjestajPUP" type="master" caption="Izvještaj o promjenama uvjeta plaćanja" width="800" height="600" statusbar="false">
		<event type="init"> 
		</event>
		<event type="load">	
			<action type="control populate" value="#gridPUP"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="gridPUP" multiselect="true" key="KupPrometId" showgrouppanel="true" showfooter="false" savelayout="true">												
							<data command="spKupPregledPUP">
							</data>							
								<fields>	
								<field name="KupPrometId" caption="KupPrometId" fixwidth="50" hidden="true"/>
								<field name="Operater" caption="Operater izmjene" fixwidth="150"/>
								<field name="Vrijeme" caption="Vrijeme izmjene" fixwidth="100"/>
								<field name="Vrstadok" caption="Vrsta dokumenta" fixwidth="120" />
								<field name="Partner" caption="Partner" fixwidth="100"/>
								<field name="Urudzbenibr" caption="Urudžbeni broj" fixwidth="120"/>
								<field name="Brojnar" caption="Broj narudžbenice" fixwidth="100"/>
								<field name="PUP" caption="PUP" fixwidth="50"/>
								<field name="Status" caption="Status odobrenja" fixwidth="100"/>
								<field name="Dananar" caption="Dana s narudžbenice" type="decimal" format="n0" fixwidth="100" />
								<field name="Danafak" caption="Dana s fakture" type="decimal" format="n0" fixwidth="100" />
								<field name="Akcija" caption="Akcija" fixwidth="100"/>
														
							</fields>		
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="IZLAZ" type="cancel" dock="left">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>	

			</buttons>
		</panelbuttons>

	</form>
</root>