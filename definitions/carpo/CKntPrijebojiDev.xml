<?xml version="1.0" encoding="utf-8"?>
<!--

19.09.2018. PJ init, od carpo kunskih i dev NG prijeboja
-->
<root version="1.0.0.0" loglevel="3">

<form name="frmPromet" path="frmPromet.xml"/>
<form name="frmPrijeboj" path="frmPrijeboj.xml"/>
<form name="frmFakturaRacun" path="IOSObrazac.frmFakturaRacun.xml"/>

	<form name="frmMaster" type="master" caption="Devizni Prijeboji">
	<event type="shown">
		<action type="datarun scalar" value="Global.~dtFindNode">
			<parameter name="findnode" value="findnode" />
		</action>
		<action type="control focus" value="#tree" >
			<parameter value="$findnode"  /> 
		</action>
	</event>		
		<managerlayout>
			<event type="shown">
				<action type="variable value" >
					<parameter name="NewKntKompMasterId" value="0" type="int"/>
					<parameter name="CurrentKntKompMasterId" value="0" type="int"/>
				</action>			
			</event>
			<lookup name="filter">
				<comboitem value="DatumKompenzacija" />
			    <comboitem value="StatusiKompenzacija" />
            </lookup>
			<tree name="tree" allowdrop="true" allowdrag="true" allowdragmultiple="true"  expandedlevel="1" key="id">
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdGlava" />
					<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi"  />	<!-- , #btnRacun -->
					<action type="control enable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi"  elseif="#grdGlava.rowcount!=0" />		 <!-- , #btnRacun -->		
				</event>
				<data command="spCKntPrijebojiDevTree"  elseif="#filter==DatumKompenzacija"  >
					<parameter name="@Action" value="1" />
				</data>
				<data command="spCKntPrijebojiDevTree" if="#filter==StatusiKompenzacija" >
					<parameter name="@Action" value="0" />
				</data>
				<fields>
					<field name="caption" />
				</fields>
			</tree>
			<grid name="grdGlava" type="master" async="true"  multiselect="true"  savelayout="true" bestfitonrefresh="true" key="KntKompMasterId" > 
				<event type="doubleclick">					
						<action type="variable value">
							<parameter name="IndUnosa" value="0" type="int" />
						</action>						
						<action type="form open" value="frmPrijeboj"/>
						<action type="control populate keepfocus" value="#grdGlava"/>
				</event>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdDetalj" />
				</event>
				<data command="spCKntKompMasterQueryDev" >
					<parameter name="@Zak"  value="#tree.@value" if="#filter==StatusiKompenzacija" />
					<parameter name="@node"  value="#tree.@value" if="#filter==DatumKompenzacija" />				
				</data>
				<fields>
					<field name="Broj" />
					<field name="Datum" />
					<field name="VrstaDokumenta" />
					<field name="Partner" caption="Naziv Partnera"/>
					<field name="DuznikIznos" caption="Dužnik Iznos"/>
					<field name="DuznikDev" caption="Dužnik Iznos DEV"/>
					<field name="VjerovnikIznos" caption="Vjerovnik Iznos"/>
					<field name="VjerovnikDev" caption="Vjerovnik Iznos DEV"/>
					<field name="Saldo" />
					<field name="Valuta" />
					<field name="DatumVal" caption="Datum Valute"/>					
					<field name="Status" />
					<!--<field name="Proknjizena" caption="Proknjiženo"/>-->
					<field name="TemOpis" caption="Temeljnica"/>
					<field name="TemBrojDok" caption="Broj temeljnice"/>
					<field name="Napomena" />
					<field name="Operater" />
					<field name="OperaterAkt" />
				</fields>
				<styles>
					<style name="fontcolor" value="#0000ff" if="#grdGlava.@Zakljucena==1&amp;&amp;#grdGlava.@TemBrojDok!=''" />
                    <style name="fontcolor" value="#008000" if="#grdGlava.@Zakljucena==1&amp;&amp;#grdGlava.@TemOpis==Neproknjiženo"  />				
                </styles>
				<menu>
					<menuitem name="mn1" caption="Poništi zaključak"  function="PonistiZakljucak">
						<event type="click">
							<action type="datarun nonquery" value="Global.~dtPonistizakljucak" />
							<action type="control populate keepfocus" value="#grdGlava" />
						</event>
					</menuitem>
				</menu>
			</grid>
			<grid name="grdDetalj" type="detail" async="true"   savelayout="true" bestfitonrefresh="true" > 
				<data command="spCKntKompMasterQueryDev" >
					<parameter name="@Action"  value="10"  />
					<parameter name="@Id"  value="#grdGlava.@KntKompMasterId"  />				
				</data>
				<event type="focusedrowchanged">
								<action type="control disable" value="#btnRacun" if="#grdDetalj.@FaktureId==null"/>
								<action type="control enable" value="#btnRacun" else=""/>
					
				</event>
				<fields>
					<field name="KontoD" caption="Konto" />
					<field name="BrojD"  caption="Račun"/>
					<field name="DatumDokD" caption="Datum"/>
					<field name="DatumValuteD" caption="Datum Valute"/>
					<field name="IznosD" caption="Iznos"/>
					<field name="DevIznD" caption="Iznos DEV"/>
					<field name="ValutaD" caption="Valuta"/>
					<field name="DatumValute2D" caption="Datum Valute2"/>
					<field name="OrgShemaDuznik" caption="Org.Shema"/>
					<field name="Razmak" caption=" - " />
					<field name="KontoV" caption="Konto" />
					<field name="BrojV"  caption="Račun"/>
					<field name="DatumDokV" caption="Datum"/>
					<field name="DatumValuteV" caption="Datum Valute"/>
					<field name="IznosV" caption="Iznos"/>
					<field name="DevIznV" caption="Iznos DEV"/>
					<field name="ValutaV" caption="Valuta"/>
					<field name="OrgShemaVjerovnik" caption="Org.Shema"/>
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons> 
			<buttons>
				<button name="btnUnesi" caption="Dodaj" function="unos" >
					<event type="click">
						<action type="variable value">
								<parameter name="IndUnosa" value="1" type="int"/>
						</action>
						<action type="datarun scalar" value="Global.~dtGetId">
							<parameter name="CurrentKntKompMasterId" value="KntKompMasterId" />
						</action>
						<action type="variable value">
							<parameter name="KntKompMasterId" value="" type="int" />
						</action>
						<action type="form open" value="frmPrijeboj"/>
						<action type="control populate keepfocus" value="#grdGlava"/>
						<action type="datarun scalar" value="Global.~dtGetId">
							<parameter name="NewKntKompMasterId" value="KntKompMasterId" />
						</action>
						<action type="datarun scalar" value="Global.~dtFindNode">
							<parameter name="findnode" value="findnode" />
						</action>
						<action type="control focus" value="#tree" if="$CurrentKntKompMasterId!=$NewKntKompMasterId" >
							<parameter value="$findnode" /> 
						</action>
						<action type="control focus" value="#grdGlava" if="$CurrentKntKompMasterId!=$NewKntKompMasterId" >
							<parameter value="$NewKntKompMasterId" type="int"/> 
						</action>
						<action type="control enable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi, #btnRacun"  if="#grdGlava.rowcount!=0" />
						<action elseif="#grdGlava.rowcount==0" type="control disable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi, #btnRacun"  />
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni" function="izmjena">
					<event type="click">
						<action type="variable value">
							<parameter name="IndUnosa" value="0" type="int" />
							<parameter name="KntKompMasterId" value="#grdGlava.@KntKompMasterId" type="int" />
							<parameter name="NewKntKompMasterId" value="#grdGlava.@KntKompMasterId" type="int" />
						</action>						
						<action type="form open" value="frmPrijeboj"/>
						<action type="control populate keepfocus" value="#grdGlava"/>
						<action type="datarun scalar" value="Global.~dtFindNode">
							<parameter name="findnode" value="findnode" />
						</action>
						<action type="control focus" value="#tree"  >
							<parameter value="$findnode" /> 
						</action>
						<action type="control focus" value="#grdGlava" >
							<parameter value="$KntKompMasterId" type="int" /> 
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="Obriši" function="brisanje">
					<event type="click">
						<action type="variable value">
							<parameter name="Broj" value="#grdGlava.@Broj" />
						</action>	
						<action type="confirm" value="Želite li doista obrisati prijeboj br. {$Broj}">												
							<action type="datarun nonquery" value="Global.~dtObrisi">
								<action type="control populate keepfocus" value="#grdGlava" />
								<action if="#grdGlava.rowcount==0" type="control disable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi, #btnRacun"  />	
								<action type="control enable" value="#btnIzmjeni, #btnObrisi, #btnZakljuci, #btnProknjizi, #btnIspisi, #btnRacun"  elseif="#grdGlava.rowcount!=0" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnZakljuci" caption="Zaključi" function="zakljucak">
					<event type="click">
						<action type="datarun nonquery" value="Global.~dtZakljucak" />
						<action type="control populate keepfocus" value="#grdGlava" />
					</event>
				</button>
				<button name="btnProknjizi" caption="Proknjiži" function="proknjizi">
					<event type="click">
						<action type="form open" value="frmProknjizi"/>
						<action type="control populate keepfocus" value="#grdGlava" />
					</event>
				</button>
				<button name="btnIspisi" caption="Ispiši" dataname="Global.~dtPrint" displayfield="Opis"  >
					<event type="click">
						<action type="control print" value="#grdGlava">
							<action type="print template" value="#btnIspisi.@Template">
								<parameter name="id" value="#grdGlava.@KntKompMasterId" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnRacun" caption="&amp;Račun" >   
					<event type="click">
						<action type="form open" value="frmFakturaRacun" >
							<parameter name="FaktureId" value="#grdDetalj.@FaktureId"/>
							<parameter name="StatusFak" value="2"/>
							<!--<parameter name="PartneriId" value="#grdGlava.@gridPid"/>-->
						</action>
						<!-- TODO skonraj ovo da diže formu i za fakturedobavljača
						<action type="form open" value="frmRacun" if="global.$Tablica==FaktureDob&amp;&amp;#grdGlavni.@slozi==2"/>
						-->
					</event>
				</button>
			</buttons>
		</panelbuttons> 
	</form>
	
	<form caption="Proknjiži" name="frmProknjizi" fixedsize="true"> 
		<event type="shown">
		<!--TODO setaj varijable po potrebi-->	
		</event> 
		<layout textposition="top">
			<group rows="1" cols="1">
				<item col="1" row="1" colspan="2" caption="Datum knjiženja:">
					<dateedit name="datDatumKnjizenja" value="now" required="true"/>
				</item>
			</group> 
		</layout> 
		<panelbuttons>
			<buttons>
				<button name="btnProknjizi" caption="Proknjiži">
					<event type="click">
						<action type="datarun nonquery" value="Global.~dtProknjizi" />
						<action type="form close"/>
					</event>
				</button>
				<button caption="Odustani" type="cancel" name="btnOdustani">
					<!-- <event type="click"> -->
						<!-- <action type="form close"/> -->
					<!-- </event> -->
				</button>
			</buttons>
		</panelbuttons>
	</form>
	
	<datalist>
		<data command="spCKntKompQueryDev" name="dtPocetni">
			<parameter name="@Action"  value="0" />
			<parameter name="@OperateriId"  value="@@operateriid" />
		</data>
		<!--TODO ? Šta ovaj radi, provjeri jel se poziova iz druge forme
		<data command="spCKntKompMasterAzur" name="dtZakljuci">
				<parameter name="@Action"  value="111" if="parent.$IndUnosa==1"/>
				<parameter name="@Action"  value="122" if="parent.$IndUnosa!=1" />
				<parameter name="@id"  value="parent.#grdGlava.@KntKompMasterId" />
				<parameter name="@Datum"  value="#datDatum" />
				<parameter name="@Napomena"  value="#txtNapomena" />
				<parameter name="@DuznikId"  value="#srcPartner" />
				<parameter name="@DatumVal"  value="#datDatumValute" />
				<parameter name="@OperateriId"  value="@@operateriid" />
				<parameter name="@SelectedDuznik"  value="#grdDuznik.selectedids.table"  />
				<parameter name="@SelectedVjerovnik"  value="#grdVjerovnik.selectedids.table" />				
		</data>
		-->
		<data command="spCKntKompQueryDev" name="dtOcistiTablice">
			<parameter name="@Action"  value="1" />
			<parameter name="@OperateriId"  value="@@operateriid" />
		</data>
		<data command="spCKntKompQueryDev" name="dtFindNode">
			<parameter name="@Action"  value="14" />
			<parameter name="@id"  value="$NewKntKompMasterId" />
		</data>
		<data command="spCKntKompQueryDev" name="dtGetId">
			<parameter name="@Action"  value="15" />
		</data>
		<data command="spCKntKompMasterAzurDev" name="dtObrisi">
			<parameter name="@Action"  value="222" />
			<parameter name="@id"  value="#grdGlava.@KntKompMasterId" />
		</data>
		<data command="spCKntKompMasterAzurDev" name="dtZakljucak">
			<parameter name="@Action"  value="10" />
			<parameter name="@id"  value="#grdGlava.@KntKompMasterId" />
			<parameter name="@OperateriId"  value="@@operateriid" />
			<parameter name="@Zakljucena"  value="1" />				
		</data>
		<data command="spCKntKompProknjiziDev" name="dtProknjizi">
			<parameter name="@Action"  value="0" />
			<parameter name="@KntKompMasterId"  value="parent.#grdGlava.@KntKompMasterId" />
			<parameter name="@OperateriId"  value="@@operateriid" />	
			<parameter name="@DatumKnjizenja"  value="#datDatumKnjizenja" />			
		</data>
		<data command="spCKntKompProknjiziDev" name="dtPonistizakljucak">
			<parameter name="@Action"  value="1" />
			<parameter name="@KntKompMasterId"  value="#grdGlava.@KntKompMasterId" />
			<parameter name="@OperateriId"  value="@@operateriid" />			
		</data>
		<data command="spCarpoPrint" name="dtPrint">
			<parameter name="@Action" value="GetTemplates" />
			<parameter name="@Id" value="#grdGlava.@KntKompMasterId" type="int" />
			<parameter name="@Tablica" value="KntKompMaster" />
		</data>	
	</datalist>
</root>