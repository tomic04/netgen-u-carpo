<root>
	<form name="frmKopirajVise" caption="Kopiranje" fixedsize="false">
		<layout textposition="top" itemspadding="1">
			<group cols="1" rows="2" groupbordervisible="false">
				<item  col="1" row="1" caption="Datum:" >
					<dateedit name="datDatum" value="now" required="true"/>
				</item>
				<item col="1" row="2" caption="Opis:" >
					<memoedit name="txtOpis1"  datavalue="#dtGet.@Opis1"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="PRIHVATI" dock="right">
					<event type="click">
						<action type="confirm" value="Želite li kopirati označene fakture?">
							<action type="control foreachrow selected" value="parent.#grdGlava">
								<action type="datarun nonquery" value="global.~dtKopirajVise" />
							</action>
							<action type="control populate" value="parent.#grdGlava" />
						</action>
						<action type="form close"/>
					</event>
				</button>

				<button caption="ODUSTANI" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>