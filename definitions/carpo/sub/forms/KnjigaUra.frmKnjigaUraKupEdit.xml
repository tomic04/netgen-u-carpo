<root>
	<form name="frmKnjigaUraKupEdit" caption="Izmjena dokumenta" fixedsize="false" template="splitter">
		<method name="Dokument" dll="KUPPreglednikDMS" class="KUPPreglednikDMS.DocumentDialog" method="TotalGen" />
		<event type="init">
			<action type="variable value" value="$LoadInd">
				<parameter value="1" />
			</action>
			<action type="datarun reader" value="~dtCheckPermission" />
			<action type="variable value">
				<parameter name="SmijeKUP" value="~dtCheckPermission.@SmijeKUP" />
				<parameter name="SmijeURA" value="~dtCheckPermission.@SmijeURA" />
			</action>
		</event>
		<event type="load">
			<action type="variable value" value="$KupPrometId">
				<parameter value="$Id"/>
			</action>
			<action type="variable value" value="$DokumentId">
				<parameter value="null" />
			</action>
			<action type="datarun reader" value="~dtCheckIfPravoNaIzmjenuUKupu" />
			<action type="datarun reader" value="~dtCheckIfSmijeURA" />
			<action type="datarun reader" value="~dtCheckIfPoslanNaOdobravanje" />
			<action type="datarun reader" value="~dtCheckIfRacunovodstvo" />
			<action type="datarun reader" value="~dtStatus" />
			<action if="~dtCheckIfPravoNaIzmjenuUKupu.@Otvori==0">
				<action type="message" value="~dtCheckIfPravoNaIzmjenuUKupu.@Poruka" />
				<action type="form close" />
			</action>
			<!-- <action if="~dtOdobravanjeOtvori.@Otvori==0"> -->
			<!-- <part name="prtTabKupDisableAll" path="prtKnjigaUraTabKup.xml"/> -->
			<!-- </action> -->
			<!-- PozivIzUre slati kada se bude zvalo iz KnjigeUra -->
			<!-- <action type="variable value"> -->
			<!-- <parameter name="PozivIzUre" value="0"/> -->
			<!-- </action> -->
			<!-- ovdje staviti sve kup specifičnosti za edit -->
			<part name="prtTabKupLoad" path="prtKnjigaUraTabKup.xml" />
			<action type="tab focus" value="tabURA" />
			<action type="tab focus" value="tabPovijest" />
			<!-- permission spremi i proknjiži -->
			<partsql name="partUraKupSpremiProknjizi" dataname="~dtPartUraKupSpremiProknjizi" />
			<!-- ako je poslano na odobravanje ili spremljeno u uru, onemogući izmjenu u kup-u -->
			<action if="~dtCheckIfPoslanNaOdobravanje.@Poslano==1||~dtStatus.@Status==KUFIRANO||~dtStatus.@Status==PROKNJIŽENO">
				<part name="prtTabKupDisableAll" path="prtKnjigaUraTabKup.xml" />
			</action>
			<!-- ako operater nema pravo na korak za knjiženje ili je poslano na odobravanje ili je ura proknjižena na temeljnicu, onemogući tab ura -->
			<action if="~dtCheckIfSmijeURA.@SmijeURA==0||~dtCheckIfPoslanNaOdobravanje.@Poslano==1||~dtStatus.@Status==PROKNJIŽENO">
				<part name="prtTabUraDisableAll" path="prtKnjigaUraTabUra.xml" />
			</action>
			<!-- a ako je poslan na odobravanje računovodstvo ga smije mijenjati prije odobravanja -->
			<action if="~dtCheckIfPoslanNaOdobravanje.@Poslano==1&amp;&amp;~dtCheckIfRacunovodstvo.@Smije==1">
				<part name="prtTabUraEnableAll" path="prtKnjigaUraTabUra.xml" />
				<action type="control disable" value="#btnProknjizi" />
			</action>
			<!-- ako je proknjiženo bez obzira na prethodno, onemogući, doublecheck -->
			<action type="control disable" value="#btnProknjizi" if="~dtGetPodaciEdit.@IndGlk==1" />
		</event>
		<event type="shown">
			<!-- <action type="datarun reader" value="~dtCheckIfEdit"/> -->
			<!-- <action type="variable value" value="$EditForm"> -->
			<!-- <parameter value="~dtCheckIfEdit.@IndIzmjena"/> -->
			<!-- </action> -->
			<!-- <action type="variable value" value="$DokId" if="$EditForm==0"> -->
			<!-- <parameter value="$Id" type="string"/> -->
			<!-- </action> -->
			<!-- <action type="datarun reader" value="~dtCheckIfSmije"/> -->
			<!-- <action if="~dtCheckIfSmije.@Otvori==0"> -->
			<!-- <action type="message" value="~dtCheckIfSmije.@Poruka"/> -->
			<!-- <action type="form close"/> -->
			<!-- </action> -->
			<action if="~dtCheckIfPravoNaIzmjenuUKupu.@Otvori!=0">
				<action type="datarun reader" value="~dtGetFaktureDobId" />
				<action type="variable value" value="$FaktureDobId">
					<parameter value="~dtGetFaktureDobId.@FaktureDobId" type="int" />
				</action>
				<action type="variable value" value="$KntKnjigaUraId">
					<parameter value="~dtGetFaktureDobId.@KntKnjigaUraId" type="int" />
				</action>
				<action type="variable value" value="$SpremiProknjizi">
					<parameter value="0" type="int" />
				</action>
				<action type="datarun reader" value="~dtUraDatDVO" />
				<action type="datarun reader" value="~dtPrivitci" />
				<action type="datarun reader" value="~dtGetKup" />
				<action type="control populate" value="#grdPrivitci" />
				<action type="control populate" value="#grdPovijest" />
				<action type="control populate" value="#grdPovijestUra" />
				<action type="form caption" value="Izmjena dokumenta || {~dtGetKup.@Broj} || {~dtGetKup.@UrudzbeniBroj} || {~dtGetKup.@BrojUFE} || **** STATUS: {~dtStatus.@Status} ****" />
				<action type="control focus" value="#txtVezaNaUrudzbeni" />
				<action type="datarun reader" value="~dtGetPodaciEdit" />
				<action type="control refreshvalue" value="##" />
				<!-- ponudi podatke iz eračuna ili kupa -->
				<action if="~dtStatus.@Status!=KUFIRANO&amp;&amp;~dtStatus.@Status!=PROKNJIŽENO">
					<part name="prtdtKupPopuni" path="prtKnjigaUraKupPopuni.xml" />
				</action>
				<action else="">
					<part name="prtUraEditPopuni" path="prtKnjigaUraKupPopuni.xml" />
				</action>
			</action>
			<action type="variable value" value="$LoadInd">
				<parameter value="0" />
			</action>
		</event>
		<event type="close">
			<action type="datarun nonquery" value="~dtSelecteIdRemove" />
		</event>
		<layout name="panel1" type="collapsable" textposition="top" minsize="900">
			<group padding="0" groupbordervisible="false" cols="1" rows="2">
				<columnsdefinition>
					<column size="880" position="1" />
				</columnsdefinition>
				<tabs row="1" col="1" padding="4">
					<!-- KUP -->
					<part name="prtTabKup" path="prtKnjigaUraTabKup.xml" />
					<!-- URA -->
					<part name="prtTabUra" path="prtKnjigaUraTabUra.xml" />
				</tabs>
				<tabs col="1" row="2">
					<part name="prtTabPrivitci" path="prtKnjigaUraTabPrivitci.xml" />
					<!-- <group col="1" row="2" cols="2" rows="2" groupbordervisible="true" caption="PRIVITCI"> -->
					<!-- <columnsdefinition> -->
					<!-- <column position="1" size="800"/> -->
					<!-- <column position="2" size="80"/> -->
					<!-- </columnsdefinition> -->
					<!-- <rowsdefinition> -->
					<!-- <row position="1" size="40"/> -->
					<!-- </rowsdefinition> -->
					<!-- <item col="1" row="1" rowspan="2"> -->
					<!-- <grid caption="Popis privitaka" autopopulate="false" name="grdPrivitci" dataname="~dtPrivitci" showgrouppanel="false" showautofilterrow="false" key="DokumentId" bestfitonrefresh="true" savelayout="true"> -->
					<!-- <event type="focusedrowchanged"> -->
					<!-- <action type="control attribute" value="#picPrivitak"> -->
					<!-- <parameter name="dbpdf" value="#grdPrivitci.@DokBLOB"/> -->
					<!-- </action> -->
					<!-- </event> -->
					<!-- <fields inherited="true"> -->
					<!-- <field name="DokBLOB" visible="false"/> -->
					<!-- </fields> -->
					<!-- </grid> -->
					<!-- </item> -->
					<!-- <item col="2" row="1"> -->
					<!-- <button name="btnDodajPrivitak" image="add" enabled="false"> -->
					<!-- </button> -->
					<!-- </item> -->
					<!-- </group> -->
					<group col="1" row="1" cols="1" rows="1" caption="HODOGRAM" name="tabPovijest">
						<!-- <group col="1" row="1" cols="1" rows="1" groupbordervisible="true" caption="  "> -->
						<item col="1" row="1">
							<grid autopopulate="false" name="grdPovijest" caption="Povijest obrade dokumenta" dataname="~dtPovijest" showgrouppanel="false" showautofilterrow="false" key="" bestfitonrefresh="true" savelayout="true">
								<fields inherited="true">
									<field name="Datum" format="dd.MM.yyy HH:mm" />
								</fields>
							</grid>
						</item>
						<!-- </group> -->
					</group>
					<group col="1" row="1" cols="1" rows="1" caption="POVIJEST URA" name="tabPovijestUra">
						<item col="1" row="1">
							<grid autopopulate="false" name="grdPovijestUra" caption="Pregled računa partnera" dataname="~dtPovijestUra" showgrouppanel="false" showautofilterrow="false" key="" bestfitonrefresh="true" savelayout="true" fieldsmartspaces="false">
								<fields inherited="true" />
							</grid>
						</item>
					</group>
				</tabs>
			</group>
		</layout>
		<layout name="panel2">
			<group groupbordervisible="false" cols="1" rows="1">
				<columnsdefinition>
					<column position="1" size="420" />
				</columnsdefinition>
				<item col="1" row="1">
					<documentviewer name="picPrivitak" dataname="~rwPrivitak" columnname="Naziv" columndata="Podaci" columnrepixid="RepixID" columnrepixname="RepixName" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnProslijedi" caption="ODOBRAVANJE PROSLIJEDI" tooltip="Proslijedi dokument na odobravanje">
					<event type="click">
						<action if="$KupPrometId!=null">
							<action type="datarun reader" value="~dtOdobravanjeOtvori" />
							<action type="message" value="{~dtOdobravanjeOtvori.@Poruka}" if="~dtOdobravanjeOtvori.@Otvori==0" />
							<action type="form open" value="frmOdobravanje" else="~dtOdobravanjeOtvori.@Otvori==1">
								<parameter name="KupPrometId" value="$KupPrometId" />
							</action>
							<action type="control populate" value="#grdPovijest" />
							<action type="control populate" value="#grdPovijestUra" />
							<action type="datarun reader" value="~dtStatus" />
							<action type="datarun reader" value="~dtGetKup" />
							<action type="form caption" value="Izmjena dokumenta || {~dtGetKup.@Broj} || {~dtGetKup.@UrudzbeniBroj} || {~dtGetKup.@BrojUFE} || **** STATUS: {~dtStatus.@Status} ****" />
							<action type="form close" />
						</action>
						<action type="message" value="Prije odobravanja potrebno je urudžbirati dokument!" else="" />
					</event>
				</button>
				<button name="btnOdobri" caption="ODOBRI" tooltip="Odobri dokument">
					<event type="click">
						<action type="transaction">
							<action type="datarun reader" value="~dtCheckIfSmijeOdobriti" />
						</action>
						<action if="transaction==success">
							<action type="form open" value="frmOdobri">
								<parameter name="KupPrometId" value="$KupPrometId" />
							</action>
							<action type="control populate" value="#grdPovijest" />
							<action type="control populate" value="#grdPovijestUra" />
							<action type="datarun reader" value="~dtStatus" />
							<action type="datarun reader" value="~dtGetKup" />
							<action type="form caption" value="Izmjena dokumenta || {~dtGetKup.@Broj} || {~dtGetKup.@UrudzbeniBroj} || {~dtGetKup.@BrojUFE} || **** STATUS: {~dtStatus.@Status} ****" />
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ZATVORI" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
				<button name="btnPrekiniProces" caption="ZATVORI SVE" dock="right">
					<event type="click">
						<action type="datarun nonquery" value="~dtPrekiniProces" />
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntVrsteKnjigaUraQuery" name="dtVrstaKnjige">
				<parameter name="@action" value="0" type="int" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtPopuniCombo">
				<parameter name="@action" value="osobe" />
			</data>
			<data command="spCKntTemOrgShemaQuery" name="dtGetOrgShema">
				<parameter name="@Action" value="0" />
			</data>
			<data command="spCKntTemTraziPartneri" name="dtGetPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtGetUgovori">
				<parameter name="@Action" value="ugovori" />
				<parameter name="@PartneriId" value="#srcPartner" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtGetPDVID">
				<parameter name="@Action" value="PDVID" />
				<parameter name="@PartneriId" value="#srcPartner" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtGetValute">
				<parameter name="@Action" value="valute" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtGetPDV37">
				<parameter name="@Action" value="pdv37" />
			</data>
			<data command="spCKntKnjigaUraEdit" name="dtGetShemaKnj">
				<parameter name="@Action" value="shemaknj" />
			</data>
			<!-- ako pozivamo iz Knjige Ura, onda okidaj sljedeći broj ure, ako iz Temeljnica, prepiši broj temeljnice -->
			<data name="dtGetMaxUra" command="spCKntKnjigaUraSljedeciBrojDok" if="$TemInd!=1">
				<parameter name="@KntVrsteKnjigauraId" value="$KntVrsteKnjigaUraId" />
				<parameter name="@DatumDok" value="#datKnjizenja" type="date" />
			</data>
			<data name="dtGetMaxUra" type="text" command="select @BrojDok as brojdok" elseif="$TemInd==1">
				<parameter name="@BrojDok" value="global.$BrojDok" type="string" />
			</data>
			<!--  -->
			<data command="spCKntKnjigaUraPopuniKontrole" name="dtGetPodaci">
				<parameter name="@action" value="init" />
				<parameter name="@KntVrsteKnjigaUraId" value="#cmbVrstaKnjige" />
			</data>
			<data command="select year(@nadnevak) as god" type="text" name="dtNadnevakGodina">
				<parameter name="@nadnevak" value="#datNadnevak" type="date" />
			</data>
			<data command="select case when exists (select * from pubvars where varime = 'URADatDvoDatVal' and varset = '1') then 1 else 0 end as IndDatDVO " type="text" name="dtUraDatDVO">
			</data>
			<data command="select DATEADD(D,@dana,@datum) as datvalute" type="text" name="dtDatValute">
				<parameter name="@datum" value="#datNadnevak" type="date" if="$IndDatDvoDatVal==0" />
				<parameter name="@datum" value="#datDVO" type="date" if="$IndDatDvoDatVal==1" />
				<parameter name="@dana" value="#txtDana" type="int" />
			</data>
			<data command="select (DATEDIFF(D,@valuta,@datum))*-1 as dana" type="text" name="dtDana">
				<parameter name="@datum" value="#datNadnevak" type="date" if="$IndDatDvoDatVal==0" />
				<parameter name="@datum" value="#datDVO" type="date" if="$IndDatDvoDatVal==1" />
				<parameter name="@valuta" value="#DatValuta" type="date" />
			</data>
			<data command="select (DATEDIFF(D,@valuta,@datum))*-1 as dana" type="text" name="dtDanaUgovor">
				<parameter name="@datum" value="#datNadnevak" type="date" if="$IndDatDvoDatVal==0" />
				<parameter name="@datum" value="#datDVO" type="date" if="$IndDatDvoDatVal==1" />
				<parameter name="@valuta" value="#DatValuta" type="date" />
			</data>
			<!-- AA postavila spCKntKnjigaUraZiroDataGet jer se spCKntVirmaniZiroDataGet koristi u virmanima i zamijenjena je -->
			<data command="spCKntKnjigaUraZiroDataGet" name="dtGetParZiro">
				<parameter name="@Action" value="0" />
				<parameter name="@PartneriId" value="#srcPartner" />
			</data>
			<data command="spCKntKnjigaUraPopuniKontrole" name="dtGetPodaciZaPartnera">
				<parameter name="@action" value="podacizapartnera" />
				<parameter name="@PartneriID" value="#srcPartner" />
			</data>
			<data command="spCkntVirmaniDodajIBAN" name="dtDodajIBAN">
				<parameter name="@action" value="0" type="int" />
				<parameter name="@Ziro" value="#cmbIBAN.text" />
				<parameter name="@PartneriID" value="#srcPartner" type="int" />
				<parameter name="@BankeId" value="0" type="int" />
			</data>
			<data command="spCKntPartnerIzEU" name="dtEuPartner">
				<parameter name="@action" value="1" type="int" />
				<parameter name="@PartneriID" value="#srcPartner" type="int" />
			</data>
			<data command="spCKntPartnerIzEU" name="dtEuPartnerParStru">
				<parameter name="@action" value="2" type="int" />
				<parameter name="@ParStruId" value="#cmbPDVID" type="int" />
			</data>
			<data command="select case when exists (select * from pubvars where varime = 'KnjigaUraDatValUgo' and varset = '1') then 1 else 0 end as IndUgovor" type="text" name="dtIndUgovor">
			</data>
			<data command="spCKntKnjigaUraDatValUgo" name="dtDatValUgo">
				<parameter name="@DatumDok" value="#datDVO" type="date" if="$IndDatDvoDatVal==1" />
				<parameter name="@DatumDok" value="#datNadnevak" type="date" else="" />
				<parameter name="@PartneriID" value="#srcPartner" type="int" />
			</data>
			<data command="select dbo.fnTecaj(@datum,@valute) as tecaj" type="text" name="dtTecaj">
				<parameter name="@datum" value="#datDVO" type="date" />
				<parameter name="@valute" value="#cmbDevValuta" type="int" />
			</data>
			<data command="spCKntKnjigaUraPostimajKontrole" name="dtIznosFakture">
				<parameter name="@action" value="$action" />
				<parameter name="@EuSlucaj" value="$EuSlucaj" type="int" />
				<parameter name="@iznosspdv" value="#curIznossPdv" type="decimal" />
				<parameter name="@osnovica25" value="#curOsnovica25" type="decimal" />
				<parameter name="@osnovica13" value="#curOsnovica13" type="decimal" />
				<parameter name="@osnovica10" value="#curOsnovica10" type="decimal" />
				<parameter name="@osnovica5" value="#curOsnovica5" type="decimal" />
			</data>
			<data command="spCKntKnjigaUraPostimajKontrole" name="dtPostimajKontrole">
				<parameter name="@action" value="$action" />
				<parameter name="@datdvo" value="#datDVO" type="date" />
				<parameter name="@deviznos" value="#curDevIznos" type="decimal" />
				<parameter name="@valutaid" value="#cmbDevValuta" type="int" />
				<parameter name="@iznosspdv" value="#curIznossPdv" type="decimal" />
				<parameter name="@pdv37id" value="#cmbPDV37" type="int" />
				<parameter name="@neoporezivo" value="#curNeoporezivo" type="decimal" />
				<parameter name="@nepod" value="#curNePod" type="decimal" />
				<parameter name="@osnovica25" value="#curOsnovica25" type="decimal" />
				<parameter name="@odbiv25" value="#cur25odbiv" type="decimal" />
				<parameter name="@neodbiv25" value="#cur25neodbiv" type="decimal" />
				<parameter name="@osnovica13" value="#curOsnovica13" type="decimal" />
				<parameter name="@odbiv13" value="#cur13odbiv" type="decimal" />
				<parameter name="@neodbiv13" value="#cur13neodbiv" type="decimal" />
				<parameter name="@osnovica5" value="#curOsnovica5" type="decimal" />
				<parameter name="@odbiv5" value="#cur5odbiv" type="decimal" />
				<parameter name="@neodbiv5" value="#cur5neodbiv" type="decimal" />
				<parameter name="@osnovica23" value="#curOsnovica23" type="decimal" />
				<parameter name="@odbiv23" value="#cur23odbiv" type="decimal" />
				<parameter name="@neodbiv23" value="#cur23neodbiv" type="decimal" />
				<parameter name="@osnovica22" value="#curOsnovica22" type="decimal" />
				<parameter name="@odbiv22" value="#cur22odbiv" type="decimal" />
				<parameter name="@neodbiv22" value="#cur22neodbiv" type="decimal" />
				<parameter name="@osnovica10" value="#curOsnovica10" type="decimal" />
				<parameter name="@odbiv10" value="#cur10odbiv" type="decimal" />
				<parameter name="@neodbiv10" value="#cur10neodbiv" type="decimal" />
				<parameter name="@iznosbezpdv" value="#curIznosBezPdv" type="decimal" />
				<parameter name="@pdvukupno" value="#curPdvUkupno" type="decimal" />
				<parameter name="@EuSlucaj" value="$EuSlucaj" type="int" />
				<parameter name="@tecaj" value="#curTecaj" type="decimal" />
				<parameter name="@KntVrsteKnjigaUraId" value="#cmbVrstaKnjige" type="int" />
