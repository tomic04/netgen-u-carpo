<root>
	<form name="frmOsobaIzmjena" caption="Izmjena :: {$tekst}">
		<event type="oninit">
			<action type="datarun reader" value="~dtPodaci" />
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="4" cols="1">
				<item col="1" row="1" caption="Mobitel (osobni):" colspan="2">
					<textedit name="txtMobitel" datavalue="~dtPodaci.@Mobitel">
					</textedit>
				</item>
                <item col="1" row="2" caption="Mobitel (poslovni):" colspan="2">
					<textedit name="txtMobitelPoslovni" datavalue="~dtPodaci.@MobitelPoslovni">
					</textedit>
				</item>
				<item col="1" row="3" caption="E-mail (osobni):" colspan="2">
					<textedit name="txtMailPrivatni" datavalue="~dtPodaci.@MailPrivatni">
					</textedit>
				</item>
				<item col="1" row="4" caption="E-mail (poslovni):">
					<textedit name="txtMailPoslovni" datavalue="~dtPodaci.@MailPoslovni">
					</textedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="datarun nonquery" value="~dtIzmjena" />
						<!-- <action type="control populate keepfocus" value="parent.#grdDetail" /> -->
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktivnostiDetAzur" name="dtIzmjena">
				<parameter name="@Action" value="5" />
				<parameter name="@Mobitel" value="#txtMobitel" />
                <parameter name="@MobitelPosl" value="#txtMobitelPoslovni" />
                <parameter name="@Email" value="#txtMailPrivatni" />
                <parameter name="@EmailPosl" value="#txtMailPoslovni" />
                <parameter name="@OsobeId" value="$OsobeId" />
                <parameter name="@LnOsoParId" value="$LnOsoParId" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtPodaci">
				<parameter name="@Action" value="OsobaIzmjena" />
				<parameter name="@Id" value="$LnOsoParId" />
			</data>
		</datalist>
	</form>
</root>
