<root>

  <form name="frmDodajStrucnaOsposobljavanja" caption ="$caption"  width="900" height="600" fixedsize="true" saveformsize="false" >
    <event type="init">
      <action type="datarun reader" value="~dtGridGore" />
      <action type="datarun reader" value="~dtGridDolje" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdGore" />
      <action type="control populate" value="#grdDolje"/>

    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <!--1. red-->
        <group cols="1" rows="1" col="1" row="1" caption="Postojeća stručna osposobljavanja" groupbordervisible="true" spacing="2,2,2,1" >
          <!--grid gore-->
          <item caption="" col="1" row="1"  textposition="left">
            <grid name="grdGore" key="ZNRStrucnaOsposobljavanjaId" dataname="~dtGridGore" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" >
              <fields>
                <field name="Naziv" caption="Stručna osposobljavanja" />
              </fields>
              <styles>
                <style name="fontcolor" value="#FF0000" if="#grdGore.@Indikator==1" />
              </styles>
            </grid>
          </item>
        </group>
        <!--2. red-->
        <group cols="2" rows="2" col="1" row="2" caption="Preostala stručna osposobljavanja" groupbordervisible="true" spacing="2,2,1,2" >
          <columnsdefinition>
            <column position="1" size="85%"></column>
            <column position="2" size="15%"></column>
          </columnsdefinition>
          <rowsdefinition>
            <row position="1" size="150" />
            <row position="2" size="60" />
          </rowsdefinition>
          <!--grid gore-->
          <item caption="" col="1" row="1" rowspan="2" textposition="left">
            <grid name="grdDolje" key="ZNRStrucnaOsposobljavanjaId" dataname="~dtGridDolje" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true" showcheckboxes="true">
              <fields >
                <field name="Naziv" caption="Stručna osposobljavanja" />
              </fields>
            </grid>
          </item>
          <item row="2" col="2" >
            <button image="top" caption="Dodaj" imagelocation="topcenter">
              <event type="click">
                <action type="datarun nonquery" value="~dtprebaciGore"/>
                <action type="control refreshvalue" value="##"/>
              </event>
            </button>
          </item>
        </group>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="datarun reader" value="~dtSpremi" />
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right">
          <event type="click">
            <action type="datarun nonquery" value="~dtBrisiTemp" />
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spZNRDjelatnici_Query" name="dtGridGore" >
        <parameter name="@Action" value="StrucnaOsposobljavanja_pridruzena" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spZNRDjelatnici_Query" name="dtGridDolje" >
        <parameter name="@Action" value="StrucnaOsposobljavanja_nova" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtprebaciGore">
        <parameter name="@Action" value="StrucnaOsposobljavanja_prebaci_gore" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@SelectedIds" value="#grdDolje.SelectedIds"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtBrisiTemp" >
        <parameter name="@Action" value="StrucnaOsposobljavanja_brisi_temp" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtSpremi" >
        <parameter name="@Action" value="StrucnaOsposobljavanja_dodaj" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>
  </form>
</root>