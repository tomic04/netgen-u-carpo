<root>
	 <form name="frmSklStavka" path="frmSklStavka.xml"/> 
	<!--<form name="frmSklStavka" caption="Skladišni dokumenti" fixedsize="false" width="600">		
		<part name="partDetInit" path="prtSklad_Detalj.xml"/>
		<part name="partDetLoad" path="prtSklad_Detalj.xml"/>
		<part name="partDetShown" path="prtSklad_Detalj.xml"/>
		<part name="partDetClose" path="prtSklad_Detalj.xml"/>
		<partsql name="partDetLayout" dataname="~dtPartDetLayout"></partsql>
		<part name="partDetButtons" path="prtSklad_Detalj.xml"/>
		<part name="partDetDataList" path="prtSklad_Detalj.xml"/>		
	</form>-->
	
	<form name="frmSklDokIzmijeni" caption="Dodaj skladišni dokument" width="1200" height="750" fixedsize="true" saveformsize="false">
			<method name="fnRobaInfo" dll="RobaInfoNet" class="RobaInfo.frmMain" method="Open"/>
		<event type="oninit">
			<action type="datarun reader" value="~dtGet"/>
			<action type="variable value">
				<parameter name="Global.VrstaDokId" value="~dtGet.@VrstaDokId" type="string"/>
			</action>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdDetalj"/>
			<action type="control value" value="txtRN">
				<parameter value="global.$Broj" type="string"/>
			</action>
			<action type="control value" value="txtBrojDok">
				<parameter value="global.$BrojSklDok" type="string"/>
			</action>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="2" rows="1">
						<columnsdefinition>
							<column position="1" size="40%"/>
							<column position="2" size="60%"/>
						</columnsdefinition>
				<tabs row="1" col="1" padding="4">
					<group caption="Osnovno" name="tabOsnovno" rows="8" cols="1" row="1" col="1" entermovenextcontrol="true">
						<item caption="Broj:" row="1" col="1">
							<textedit name="txtBrojDok" datavalue="~dtGet.@BrojDok" readonly="true"/>
						</item>
						<item caption="Vrsta dokumenta:" row="2" col="1">
							<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" datavalue="~dtGet.@VrstaDokId" dataname="dtVrstaDok" required="true" allownull="false"/>
							<event>
								<action type="variable value">
									<parameter name="Global.VrstaDokId" value="#cmbVrstaDok.@VrstaDokId" type="string"/>
								</action>
							</event>
						</item>
						<item caption="Datum:" row="3" col="1">
							<dateedit name="datDatumdok" datavalue="~dtGet.@DatumDok" required="true"/>
						</item>
						<item caption="Skladište:" row="4" col="1">
							<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="Global.~dtSkladiste" datavalue="~dtget.@SkladisteId" datatext="~dtget.@Skladiste" required="true">
							</comboedit>
						</item>
						<item caption="OrgShema:" row="5" col="1">
							<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" required="true" tabindex="12" datavalue="~dtGet.@RealOrgShemaId" savevalue="app"/>
						</item>
						<item caption="Odgovorna osoba:" row="6" col="1">
							<searchedit name="srcOdgovornaOsoba" dataname="global.~dtOdgovornaOsoba" fieldvalue="OsobeId" fieldtext="Naziv" required="true" tabindex="4" datavalue="~dtGet.@OdgovornaOsobaId" datatext="~dtGet.@OdgovornaOsoba" savevalue="app"/>
						</item>
						<item caption="Radni nalog:" row="7" col="1">
							<textedit name="txtRN" readonly="true">			
							</textedit>
						</item>
						<item caption="Opis:" row="8" col="1">
							<textedit name="txtOpis" datavalue="~dtGet.@Opis"/>
						</item>
					</group>
				</tabs>
				<group padding="0" groupbordervisible="true" cols="1" rows="3" col="2" row="1">
							<rowsdefinition>
								<row position="1" size="80%"/>
								<row position="2" size="10%"/>
								<row position="3" size="10%"/>
							</rowsdefinition>
					<group cols="1" rows="1" col="1" row="1">
						<item row="1" col="1">
							<grid name="grdDetalj" dataname="~dtDetalj" key="SktPrometDetId" showgrouppanel="false" showautofilterrow="true" showfooter="true" savelayout="true" bestfitonrefresh="true" multiselect="true">
								<fields inherited="true">
								</fields>
							</grid>
						</item>
					</group>
					<group padding="0" groupbordervisible="false" cols="6" rows="1" col="1" row="2">
						<columnsdefinition>
							<column position="1" size="90"/>
							<column position="2" size="120"/>
							<column position="3" size="50"/>
							<column position="4" size="105"/>
							<column position="5" size="120"/>
						</columnsdefinition>
						<item caption="" row="1" col="1">
							<labeledit value="Ukupna količina:"/>
						</item>
						<item caption="" row="1" col="2">
							<textedit name="txtKolicina" value="0" format="n2" readonly="true"/>
						</item>
						<item caption="" row="1" col="4">
							<labeledit value="Ukupna vrijednost:"/>
						</item>
						<item caption="" row="1" col="5">
							<textedit name="txtVrijednost" value="0" format="n2" readonly="true"/>
						</item>
					</group>
					<group padding="0" groupbordervisible="False" cols="7" rows="1" col="1" row="3">
						<columnsdefinition>
							<column position="1" size="14%"/>
							<column position="2" size="14%"/>
							<column position="3" size="14%"/>
							<column position="4" size="14%"/>
							<column position="5" size="14%"/>
							<column position="6" size="14%"/>
							<column position="7" size="16%"/>
						</columnsdefinition>
						<item row="1" col="1" textvisible="False">
							<button name="btnAddDetalj" caption="&amp;UNESI" image="add" type="add" funtion="Unos">
								<!-- ' + case when @VrstaPromSifra in ('126', '42', 'IMU', '68') then ' visible="false"' else '' end + ' -->
								<event type="click">
									<action type="validate"/>
									<action type="datarun nonquery" value="~dtSktGlaEdit"/>
									<action type="form open" value="frmSklStavka">
										<parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
										<parameter name="Action" value="0" type="int"/>
										<parameter name="SkladisteId" value="#cmbSkladiste" type="int"/>
										<parameter name="DatumDok" value="#datDatumDok"/>
										<parameter name="Status" value="$Status"/>
										<parameter name="Smije" value="$Smije"/>
										<parameter name="Planski" value="#cmbSkladiste.@Planski" type="int"/>
									</action>
									<action type="control disable" value="#btnEditDetalj, #btnDelDetalj" if="$Status!=1||#grdDetalj.rowcount==0||$Smije!=1"/>
									<action type="control enable" value="#btnEditDetalj, #btnDelDetalj" else=""/>
									 <action type="control disable" value="#btnRobaInfo" if="#grdDetalj.rowcount==0"/> 
									 <action type="control enable" value="#btnRobaInfo" else=""/>
									<action type="datarun reader" value="~dtDetaljUkupno"/>
									<action type="control value" value="txtKolicina">
										<parameter value="~dtDetaljUkupno.@Kolicina"/>
									</action>
									<action type="control value" value="txtVrijednost">
										<parameter value="~dtDetaljUkupno.@Vrijednost"/>
									</action>
									<action type="footer text" value="Broj stavaka: {#grdDetalj.rowcount}"/>
								</event>
							</button>
						</item>
						<item row="1" col="2" textvisible="False">
							<button name="btnEditDetalj" caption="&amp;IZMIJENI" type="edit" image="edit" funtion="Izmjena">
								<event type="click">
									<action type="validate"/>
									<action type="variable value">
										<parameter name="SktPrometDetId" value="#grdDetalj.@SktPrometDetId"/>
									</action>
									<action type="datarun nonquery" value="~dtSktGlaEdit"/>
									<action type="form open" value="frmSkladStavka">
										<parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
										<parameter name="Action" value="1" type="int"/>
										<parameter name="SkladisteId" value="#cmbSkladiste" type="int"/>
										<parameter name="DatumDok" value="#datDatumDok"/>
										<parameter name="SktPrometDetId" value="$SktPrometDetId"/>
										<parameter name="Status" value="$Status"/>
										<parameter name="Smije" value="$Smije"/>
										<parameter name="Planski" value="#cmbSkladiste.@Planski" type="int"/>
										<parameter name="Skladiste2Id" value="#cmbSkladisteUlaza" type="int"/>
									</action>
									<action type="control populate keepfocus" value="#grdDetalj"/>
									<action type="control populate" value="#grdDimenzije" if="global.$IndDimenzije==1"/>
									<action type="datarun reader" value="~dtDetaljUkupno"/>
									<action type="control value" value="txtKolicina">
										<parameter value="~dtDetaljUkupno.@Kolicina"/>
									</action>
									<action type="control value" value="txtVrijednost">
										<parameter value="~dtDetaljUkupno.@Vrijednost"/>
									</action>
									<action type="footer text" value="Broj stavaka: {#grdDetalj.rowcount}"/>
								</event>
							</button>
						</item>
						<item row="1" col="3" textvisible="False">
							<button name="btnDelDetalj" caption="&amp;OBRIŠI" image="delete" funtion="Brisanje">
								<!-- ' + case when @VrstaPromSifra in ('42', 'IMU') then ' visible="false"' else '' end + ' -->
								<event type="click">
									<action type="validate"/>
									<action type="datarun nonquery" value="~dtSktGlaEdit"/>
									<action type="confirm" value="Jeste li sigurni da želite obrisati označene stavke s dokumenta?">
										
											<action type="control foreachrow selected" value="#grdDetalj">
												<action type="datarun nonquery" value="~dtDetDelete"/>
											</action>
									
									</action>
									<action type="control populate" value="#grdDetalj"/>
									<action type="control disable" value="#btnEditDetalj, #btnDelDetalj" if="$Status!=1||#grdDetalj.rowcount==0||$Smije!=1"/>
									<action type="control enable" value="#btnEditDetalj, #btnDelDetalj" else=""/>
									<action type="control disable" value="#btnRobaInfo" if="#grdDetalj.rowcount==0"/>
									<action type="control enable" value="#btnRobaInfo" else=""/>
									<action type="datarun reader" value="~dtDetaljUkupno"/>
									<action type="control value" value="txtKolicina">
										<parameter value="~dtDetaljUkupno.@Kolicina"/>
									</action>
									<action type="control value" value="txtVrijednost">
										<parameter value="~dtDetaljUkupno.@Vrijednost"/>
									</action>
									<action type="footer text" value="Broj stavaka: {#grdDetalj.rowcount}"/>
								</event>
							</button>
						</item>
						<item row="1" col="3" textvisible="False">
							<button name="btnRobaInfo" caption="RobaInfo">
								<event type="click">
									<action if="global.$IndNetRoba==1">
										<action type="method run" value="fnRobaInfo">
											<parameter name="server" value="@@server"/>
											<parameter name="baza" value="@@database"/>
											<parameter name="username" value=""/>
											<parameter name="password" value=""/>
											<parameter name="OperateriId" value="@@operateriid"/>
											<parameter name="path" value=""/>
											<parameter name="robaid" value="#grdDetail.@RobaId"/>
										</action>
									</action>
									<action else="">
										<action type="message" value="'Artikli se uređuju u granuli RobaInfo.'"/>
									</action>
								</event>
							</button>
						</item>
					</group>
				</group>
			</group>
	</layout>
	<panelbuttons>
		<buttons>
			<button name="btnSpremiSklDok" caption="Spremi" type="add" dock="left" function="SpremiSklDok">
				<event type="click">
					<action type="validate"/>
					<action if="1==1">
						<!-- if ako treba neka provjera -->
						<action type="datarun scalar" value="~dtSktGlaInsert">
							<parameter name="global.brojskldok" value="~dtSktGlaInsert.@Broj"/>
							<parameter name="global.brojskldok" value="~dtSktGlaInsert.@Broj"/>
						</action>
						<action type="control populate" value="parent.#grdDetail, parent.#grdskladiste"/>
						<action if="global.$brojdok==NULL">
							<action type="message" value="Nije kreiran skladišni dokument"/>
						</action>
						<action if="global.$brojdok!=NULL">
							<action type="message" value="Kreiran je skl. dok"/>
							<action type="message" value="!"/>
						</action>
						
					</action>
					<action type="message" value="ako treba neka provjera" else=""/>
				</event>
			</button>
			<button caption="ODUSTANI" type="cancel" dock="right"/>
		</buttons>
	</panelbuttons>
	<datalist>
		<data name="dtGet" command="spServisRNDetQueryCarpo">
			<parameter name="@Action" value="SkladisniGla"/>
			<parameter name="@ID" value="glboal.$sktprometglaid"/>
		</data>
		<data command="spServisUnosCarpo" name="dtVrstaDok">
			<parameter name="@action" value="ServisRNVrstaDok"/>
			<parameter name="@id" value="Global.$RNvrstadokid"/>
		</data>
		<!--             <data command="spServisRNFakturiranjeCarpo" name="dtFakturiraj">
                <parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId" />
                <parameter name="@ServisRNBroj" value="#txtBroj" />
                <parameter name="@DatumDok" value="#datDatumDok" />
				<parameter name="@DatumIsporuke" value="#datDatumIsporuke" />
                <parameter name="@PartneriId" value="#srcPartner" />
                <parameter name="@ParStruId" value="#srcParstru" />
                <parameter name="@OsobeParId" value="#srcKontakt" />
				<parameter name="@FaktureId" value="null" />
				<parameter name="@Broj" value="null" />
            </data> -->
		<data command="spSklad_Gla_Unos" name="dtSktGlaInsert">
			<parameter name="@ID" value="null"/>
			<parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
			<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
			<parameter name="@DatumDok" value="#datDatumDok"/>
			<parameter name="@OperateriId" value="@@operateriid"/>
			<parameter name="@SkladisteId" value="#cmbSkladiste"/>
			<!-- <parameter name="@OrgDok" value="#txtOpis" /> -->
			<parameter name="@Memo" value="#txtOpis"/>
			<parameter name="@OperaterLock" value="@@operateriid"/>
			<parameter name="@OsobeId" value="#srcOdgovornaOsoba"/>
			<!-- 				<parameter name="@HrKadroviId" value="#srcOsoba" if="Global.$VisibleGlaOsoba==True"/>
				<parameter name="@VozacId" value="#srcVozac" if="Global.$VisibleGlaVozac==True"/>
				<parameter name="@PartneriId" value="#srcPartner" if="Global.$VisibleGlaPartner==True"/>
				<parameter name="@ParStruId" value="#srcParStru" if="Global.$VisibleGlaParStru==True"/>
				<parameter name="@OsobeParId" value="#cmbKontakt" />
				<parameter name="@Skladiste2Id" value="#cmbSkladisteUlaza" /> -->
			<parameter name="@RnNaloziId" value="global.$ServisRNGlaId"/>
		</data>

		<data command="spNG_Combo" name="dtVrstaDokFak">
			<parameter name="@Action" value="VrstaDok"/>
			<parameter name="@Oznaka" value="30"/>
		</data>
		<data command="spTraziOsobe" name="dtKontakt">
			<parameter name="@Action" value="Osobe"/>
			<parameter name="@PartneriId" value="#srcPartner"/>
		</data>
		<data command="spSklad_Gla_Query" name="dtGet">
			<parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
		</data>
		<data command="spSklad_Gla_Izmjena" name="dtSktGlaEdit">
			<parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
			<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
			<parameter name="@DatumDok" value="#datDatumDok"/>
			<parameter name="@SkladisteId" value="#cmbSkladiste"/>
			<parameter name="@OrgDok" value="#txtOpis"/>
			<parameter name="@OsobeId" value="#cmbOsoba"/>
			<parameter name="@Memo" value="#MemoGlava"/>
			<parameter name="@OperateriId" value="@@operateriid"/>
			<parameter name="@HrKadroviId" value="#srcOsoba" if="Global.$VisibleGlaOsoba==True"/>
			<parameter name="@VozacId" value="#srcVozac" if="Global.$VisibleGlaVozac==True"/>
			<parameter name="@PartneriId" value="#srcPartner" if="Global.$VisibleGlaPartner==True"/>
			<parameter name="@ParStruId" value="#srcParStru" if="Global.$VisibleGlaParStru==True"/>
			<parameter name="@OsobeParId" value="#cmbKontakt" if="Global.$VisibleGlaKontakt==True"/>
			<parameter name="@Skladiste2Id" value="#cmbSkladisteUlaza" if="Global.$VisibleSkladisteUlaza==True"/>
			<parameter name="@RnNaloziId" value="#srcRadniNalog" if="Global.$VisibleRadniNalog==True"/>
		</data>
		<data command="spSklad_DetailGrid" name="dtDetalj">
			<parameter name="@SktPrometGlaId" value="global.@sktprometglaid"/>
		</data>
		<data command="spSklad_Det_Ukupno" name="dtDetaljUkupno">
			<parameter name="@SktPrometGlaId" value="global.@sktprometglaid"/>
		</data>
		<data command="spSklad_Det_Brisanje" name="dtDetDelete">
			<parameter name="@SktPrometDetId" value="#grdDetalj.@SktPrometDetId"/>
			<parameter name="@SktPrometGlaId" value="global.@sktprometglaid"/>
			<parameter name="@VrstaPromSifra" value="global.$VrstaPromSifra" type="string"/>
		</data>
		</datalist>
	</form>

</root>