				<parameter name="@tablica" value="Fakture"/>				
				<parameter name="@operateriid" value="@@OperateriId" />
				<parameter name="@id" value="$FaktureId" type ="int" />
				<parameter name="@ShowErrorInfo" value="0" type ="int" />
