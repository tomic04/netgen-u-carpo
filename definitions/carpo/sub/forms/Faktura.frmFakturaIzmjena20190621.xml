		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<action type="tab focus" value="tabOsnovno"/>
						<action type="validate"/>
						<action type="datarun nonquery" value="global.~dtGlavaEdit"/>
						<!-- 					 	<action type="control populate" value="parent.#grdGlava" >
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$ProPonGlaId" />
							</action>
						</action> -->
						<action type="form close"/>
					</event>
				</button>			
				<button name="btnZakljuci" caption="STATUS" >
					<event type="click">
						<!-- <action type="confirm" value="Želite li zaključiti dokument?"> -->
						<!-- <action type="validate"/> TODO: provjeriti treba li ostati ovo spremanje kod zakljucka-->
						<!-- <action type="datarun nonquery" value="global.~dtGlavaEdit"/> -->
						<action type="datarun reader" value="~dtDevDiff" if="#cmbValuta!=null" />
						<action if="#dtDevDiff.@devdiff==1">
							<action type="confirm" value="Nova vrijednost tečaja je: {#dtDevDiff.@VrBodaDev}. Želite li promijeniti?">
								<action type="datarun scalar" value="~dtDevUpdate" />
								<action type="control value" value="#bteVrBoda">
									<parameter value="#dtDevDiff.@VrBodaDev" />
								</action>
							</action>
						</action>
						<action type="variable value" value="Global.$ZakljucakInd">
							<parameter value="1" />
						</action>
						<action type="datarun nonquery" value="global.~dtGlavaEdit"/>						
						<action type="form open" value="frmPromijeniStatus">
							<parameter name="FaktureId" value="$FaktureId"/>
							<parameter name="NaslovTekst" value="PROMJENA STATUSA"/>
							<!-- <parameter name="Var" value="Promijeni"/> -->
						</action>
						<action type="datarun scalar" value="~dtStatusiProvjeraButton" >
							<parameter name="PromijeniVrati"/>
						</action>							

						<action type="form close" if="dialogresult!=cancel"/>
					</event>
				</button>
				<button name="btnPovezi" caption="POVEŽI" >
					<event type="click">
						<action type="datarun nonquery" value="global.~dtGlavaEdit"/>
						<action type="form open" value="frmPredujmovi">
							<parameter name="FaktureId" value="$FaktureId" />
							<parameter name="Valuta" value="#cmbValuta.@Oznaka" />
							<parameter name="ValutaId" value="#cmbValuta" />
							<parameter name="Tecaj" value="#bteVrBoda" />
						</action>
					</event>
				</button>
				<button name="btnDimenzije" caption="DIMENZIJE">
					<event type="click">
						<!-- <action type="message" value="{@@server} {@@database} {$FaktureId} {@@operateriid}" /> -->
						<action type="datarun nonquery" value="global.~dtGlavaEdit"/>
						<action type="method run" value="fnDimenzijeGla">
							<parameter name="server" value="@@server" />
							<parameter name="database" value="@@database" />
							<parameter name="username" value="" />
							<parameter name="password" value="" />
							<parameter name="OperateriId" value="@@operateriid" />
							<parameter name="Parent" value="0" />
							<parameter name="pTop" value="0" />
							<parameter name="pLeft" value="0" />
							<parameter name="path" value="" />
							<parameter name="tip" value="FaktureId" />
							<parameter name="id" value="$FaktureId" />
							<parameter name="glaid" value="0" />
						</action>
					</event>
				</button>
				<button name="btnPrint" caption="ISPIŠI" dataname="global.~dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="datarun nonquery" value="global.~dtGlavaEdit"/>
						<action type="control print" value="parent.#grdGlava">
							<action type="print template" value="#btnPrint.@Template">
								<parameter name="id" value="$FaktureId" />
							</action>
						</action>
					</event>
				</button>				
				<button name="btnOdustani" caption="ZATVORI" type="cancel">
					<!-- 					<event type="click">
						<action type="control populate" value="parent.#grdGlava" >
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$ProPonGlaId" />
							</action>
						</action>
					</event> -->
				</button>
				<button name="btnUgovor" caption="UGOVOR" dock="right">
					<event type="click">
						<action type="message" value="U razvoju" />
					</event>
				</button>	
				<button name="btnUputi" caption="UPUTI ME" dock="right">
					<event type="click">
						<action type="message" value="U razvoju" />
					</event>
				</button>				
