<root>
	<form path="Kamate.frmDonos.xml" name="frmDonos"/>		
	<form path="Kamate.frmPodaci.xml" name="frmPodaci"/>		
	<form path="Kamate.frmObracun.xml" name="frmObracun"/>		
	<form name="frmMultiDonos" caption="Donos stavaka za više partnera" width="700" height="150">
		<event type="shown">
			<action type="datarun reader" value="~dtPrviDan"/>
			<action type="control value" value="#datod">
				<parameter value="~dtPrviDan.@Datum1"/>
			</action>
			<action type="control value" value="#datdo">
				<parameter value="now" type="date"/>
			</action>
			<action type="control value" value="#datDatum">
				<parameter value="now" type="date"/>
			</action>
		</event>
		<layout>
			<group cols="2" rows="3">
				<item col="1" row="1" caption="Datum dokumenta:">
					<dateedit name="datDatum" required="true"/>
				</item>
				<item col="2" row="1" caption="Vrsta kamate:">
					<comboedit name="cmbKamata" dataname="~dtKamate" valuefield="kteVrsteStopaID" displayfield="Opis" required="true"/>
				</item>
				<item col="1" row="2" caption="Razdoblje od:">
					<dateedit name="datOd"  required="true"/>
				</item>
				<item col="2" row="2" caption="do:">
					<dateedit name="datDo"  required="true"/>
				</item>
				<item col="1" row="3" caption="Minimalni iznos:">
					<textedit name="txtMinIznos" format="n2" value="0"/>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="STAVKE"  image="rightend" imagelocation="middleright">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDonosPriprema">
							<parameter name="ID"/>
						</action>
						<action type="variable value">
							<parameter name="Datum" value="#datDatum"/>
						</action>
						<action type="form close"/>
						<action type="form open" value="frmDonos">
							<parameter name="tmpGlava" value="$ID"/>
							<parameter name="Datum" value="$Datum"/>
						</action>
					</event>
				</button>
				<button name="btnCancel" type="cancel" caption="ODUSTANI"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPrviDan" command="select  datename(year, getdate()) + '0101' as Datum1" type="text" /> 
			<data name="dtDonosPriprema" command="spCKteGlavaAzur">
				<parameter name="@Action" value="3"/>
				<parameter name="@DatumDok" value="#datDatum"/>
				<parameter name="@kteVrsteStopaId" value="#cmbKamata"/>
				<parameter name="@DatOd" value="#datOd"/>
				<parameter name="@DatDo" value="#datDo"/>
				<parameter name="@MinIznos" value="#txtMinIznos"/>
			</data>
			<data name="dtKamate" command="spCKntKtePopuniKontrole">
				<parameter name="@Action" value="vrste"/>
			</data>
		</datalist>
	</form>
</root>