
<root version="1.0">

  <form name="frmUnosRas" caption="$caption"  width="1600" height ="600" saveformlayout="true">
    <event type="init">
      <action type="datarun reader" value="~dtUnosRas" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdUnosRas" />
    </event>
      <layout >
        <group cols="1" rows="1" spacing="2,2,2,2">
          <item col="1" row="1" >
            <grid name="grdUnosRas" key="SitInventuraDetId" keyfield="SitInventuraDetId" dataname="dtUnosRas" showautofilterrow="true" fieldsmartspaces="false" multiselect="true" bestfitonrefresh="true">
              <event type="cellvaluechanged">
                <action type="datarun nonquery" value="~dtUpdateKolRas" />
                <action type="control populate keepfocus" value="#grdUnosRas" />
              </event>
              <fields inherited="true">
                <field name="Naziv" fixed="true"/>
                <field name="Sifra" caption="Šifra" fixed="true" />
                <field name="KolicinaRashod" caption="Količina za rashod" editable="true" format="n2"/>
                <field name="KolicinaKnjizna" caption="Količina knjižna" format="n2"/>
                <field name="KolicinaManjak" caption="Količina manjak" format="n2"/>
                <field name="Org" caption="Organizacijska jedinica" />
                <field name="smj" caption="Smještaj" />
              </fields>
            </grid>
          </item>
        </group>
      </layout>
    
      <panelbuttons>
        <buttons>
          <button name="btnMR"  caption="Manjak -> Rashod" type="add"  >
            <event type="click">
              <action type="datarun reader" value="~dtUnosManjakRashod" />
              <action type="control populate" value="#grdUnosRas" />
              <!--<action type="form close" />-->
            </event>
          </button>
          <button caption="Odustani" type="cancel" dock="right">
            <event type="click"/>
          </button>
        </buttons>
      </panelbuttons>

      <datalist>
        <data command="spSitInventura_QueryCP" name="dtUnosRas">
          <parameter name="@Action" value="Grid_Rashod"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
        </data>
        <data command="spSitInventura_AzurCP" name="dtUpdateKolRas">
          <parameter name="@Action" value="Update_rashod"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
          <parameter name="@SitInventuraDetId" value="#grdUnosRas.@SitInventuraDetId" />
          <parameter name="@KolicinaRashod" value="#grdUnosRas.@KolicinaRashod" />
        </data>
        <data command="spSitInventura_AzurCP" name="dtUnosManjakRashod">
          <parameter name="@Action" value="UnosManjak_Rashod"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
        </data>
      </datalist>
    </form>


	
</root>