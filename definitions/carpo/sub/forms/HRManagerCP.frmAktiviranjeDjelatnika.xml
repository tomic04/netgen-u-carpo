<root>
	<!--
  Komentari:
  01.10.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmAktiviranjeDjelatnika" caption="$Caption" width="400" height="260" fixedsize="true">
		<event type="shown">
			</event>
		<layout>
			<group cols="3" rows="4" groupbordervisible="true">
				<item row="1" col="1" caption="Djelatnik:" highlight="false" colspan="3">
					<searchedit name="srcDjelatnik" dataname="~dtNeaktivni" fieldtext="Radnik" fieldvalue="HRKadroviId"  required="true" />
						</item>
				<item row="2" col="1" caption="Matični broj:" highlight="false" colspan="2">
					<textedit name="txtMaticniBroj" datavalue="" required="true"/>
				</item>
				<item row="2" col="3" highlight="false" >
					<button name="btnMaticniBroj" caption="Matični broj" >
						<event type="click">
							<action type="datarun reader" value="dtMaticniBroj">

									<action type="control value" value="#txtMaticniBroj" >
										<parameter value="~dtMaticniBroj.@i_dentbroj" />
									</action>
								</action>
						</event>
					</button>
				</item>
				<item row="3" col="1" caption="Datum dolaska:" highlight="false" colspan="2">
					<dateedit name="dtDatumDolaska" value="now" datavalue="" required="true">
					</dateedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnAktiviraj" caption="Aktiviraj" dock="left">
					<event type="click">
					<action type="validate"/>
							<action type="datarun reader" value="~dtAktiviraj">
								<action type="control populate" value="parent.#grdMaster">
									<action type="control focus" value="parent.#grdMaster">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
						<action if="$indGreske==0">
							<action type="message" value="Djelatnik je uspješno aktiviran!"/>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRHelp" name="dtMaticniBroj">
				<parameter name="@action" value="novi_maticni_broj" />
			</data>
				<data command="spHRHelp" name="dtNeaktivni">
				<parameter name="@action" value="hrkadrovi_neaktivni"/>
				<parameter name="@tekst" value="#srcDjelatnik.text" />
			</data>
			<data command="spHRManagerMaster_Aktiviranje_CP" name="dtAktiviraj">
				<parameter name="@action" value="aktiviranje"/>
				<parameter name="@id.output.int" variablename="noviID"/>
				<parameter name="@hrkadroviid" value="#srcDjelatnik"/>
				<parameter name="@maticnibroj" value="#txtMaticniBroj"/>
				<parameter name="@datumdolaska" value="#dtDatumDolaska"/>
				<parameter name="@identbroj" value="#txtMaticniBroj"/>
				<parameter name="@indGreske.output.int"/>
			</data>

		</datalist>
	</form>
</root>