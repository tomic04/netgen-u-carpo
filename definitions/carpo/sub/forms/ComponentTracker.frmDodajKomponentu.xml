<root>
	<form name="frmDodajKomponentu" caption="Dodaj komponentu">
    <event type="close">
        <action type="control populate" value="parent.#grdSifrarnikKomponenti" />
    </event>
    <layout>
        <group cols="1" rows="2">
            <item row="1" col="1" caption="Naziv komponente">
                <textedit name="txtComponentName" />
            </item>
            <item row="2" col="1" caption="Opis">
                <textedit name="txtComponentDescription" />
            </item>
        </group>
    </layout>
    <panelbuttons>
        <buttons>
            <button name="btnDodajKomponentu2" caption="Spremi">
                <event type="click">
                    <action type="variable value" value="$lastComponentId">
                        <parameter value="null"/>
                    </action>
                    <action type="datarun scalar" value="~dtDodajKomponentu">
                        <parameter name="lastComponentId"/>
                    </action>
                    <action type="control populate" value="parent.#grdSifrarnikKomponenti">
                        <action type="control focus" value="parent.#grdSifrarnikKomponenti">
                            <parameter name="id" value="$lastComponentId" type="int"/>
                        </action>
                    </action>
                    <action type="formclose" />
                </event>
            </button>
            <button name="btnOdustani" caption="Odustani">
                <event type="click">
                    <action type="formclose" />
                </event>
            </button>
        </buttons>
    </panelbuttons>
    <datalist>
        <data command="spComponentTrackerAzur" name="dtDodajKomponentu">
            <parameter name="@Action" value="addComponent" />
            <parameter name="@ComponentName" value="#txtComponentName" />
            <parameter name="@ComponentDescription" value="#txtComponentDescription" />
        </data>
    </datalist>
    </form>
</root>