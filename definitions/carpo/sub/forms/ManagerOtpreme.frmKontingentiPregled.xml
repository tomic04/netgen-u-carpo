<root>
	<form name="frmKontingentiPregled" caption="Pregled izabranih kontingenata" fixedsize="false" width="800" height="300">
		<event type="onload">
			<action type="variable value">
				<parameter name="sva_skladista" value="0" />
			</action>
			<action type="variable value">
				<parameter name="minus_stavke" value="0" />
			</action>
			<action type="datarun nonquery" value="dtKontingent" />
			<action type="control populate" value="#grdKontingenti" />
		</event>
		<layout textposition="top" itemspadding="3">
			<group cols="2" rows="1" groupbordervisible="False">
				<item row="1" col="1" colspan="2">
					<grid name="grdKontingenti" async="true" dataname="dtKontingent" multiselect="true" key="kkvalglaid" showgrouppanel="False">
						<fields>
							<field name="DatumDok" caption="Datum" />
							<field name="Broj" caption="Broj" />
							<!--	<field name="kolicinaulaz" caption="Ulaz" formatstring="n3"/>
							<field name="kolicina" caption="Izlaz" formatstring="n3"/>
							<field name="Skladiste" caption="Skladište" />-->
							<field name="raspolozivo" caption="Raspoloživo" formatstring="n3"/>
							<field name="roktrajanja" caption="Rok trajanja" />
							<field name="jmnaziv" caption="Pakiranje" />
							<field name="Opis" caption="Napomena" />
							<field name="proizvodjac" caption="Proizvođač" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="OBRIŠI" type="delete" dock="left">
					<event type="click">
						<action type="confirm" value="Želite li obrisati označeno?">
							<action type="control foreachrow selected" value="#grdKontingenti" >
								<action type="datarun nonquery" value="~dtKontingentDelete"/>
							</action>
						</action>
						<action type="control value" value="parent.#txtKontingent">
							<parameter value="%"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spProd_NotpDet_KKvalLink" name="dtKKvalLink"> -->
			<!-- <parameter name="@Gla_Id" value="$ProNotpGlaId" /> -->
			<!-- <parameter name="@Det_Id" value="$ProNotpDetId" /> -->
			<!-- <parameter name="@OperateriId" value="@@OperateriId" /> -->
			<!-- <parameter name="@Tip" value="ProNotpDetId" type="string"/> -->
			<!-- <parameter name="@KKval_Raspolozivo" value="$Raspolozivo" /> -->
			<!-- <parameter name="@kkvalglaid" value="$kkvalglaid" /> -->
			<!-- <parameter name="@Stavka_kolicina" value="$Kolicina" /> -->
			<!-- </data> -->
			<data command="spProd_NOtp_IzabraniKontinenti" name="dtKontingent">
				<parameter name="@DetId" value="$ProNotpDetId" />
			</data>
			<data command="spProd_NOtp_KontingentiBrisanje" name="dtKontingentDelete">
				<parameter name="@DetId" value="$ProNotpDetId" />
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@Tablica" value="ProNotpDetId" type="string"/>
			</data>
		</datalist>
	</form>
</root>