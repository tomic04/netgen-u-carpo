<root>
<form name="frmOtpremi" caption="Otpremi">

    
		
	<layout caption="Otpremi">
		<group cols="1" rows="1">
			<item row="1" col="1" caption="Skladište" textposition="left">
	            	 <comboedit name="cmbSkladiste" valuefield="SkladisteId" dataname="~dtPuniSkladiste" displayfield="Opis"/>
                </item>
		</group>

	</layout>

	<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Otpremi">
					 <event type="click">
					 	<action type="datarun nonquery" value="~dtOtpremi" />
                        <action type="form close"/>
							
                    </event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>

	<datalist>

        <data command="spNG_Combo" name="dtPuniSkladiste">
            <parameter name="@Action" value="skladiste" />
            <parameter name="@Ind" value="1" />
        </data>

          <data command="spProd_ProNarudzbeGla_Otpremi" name="dtOtpremi">
            <parameter name="@ProNarudzbeGlaId" value="$GlavaId" />
            <parameter name="@Skladisteid" value="#cmbSkladiste.@SkladisteId" />
            <parameter name="@operateriid" value="@@operateriid" />
        </data>
	</datalist>
</form>
</root>