<root>
    <form name="frmKupCarobnjak" caption="Ugovor s kupcem" width="1000" height="570" operaterlocktable="KupUgovoriGla" operaterlockkey="KupUgovoriGlaId" operaterlockkeyvalue="global.$OperaterLockId"> 
        <event type="oninit">
            <action type="datarun reader" value="~dtGet" />
            <action type="datarun reader" value="~dtPubVars" />
            <action type="datarun reader" value="~ObrisiDet" />
            <action type="datarun scalar" value="~dtInsertDet" />
        </event>
          <event type="onshown">
 
         </event>
        <event type="onload">
            <action type="variable value" value="FilterInd">
                <parameter value="parent.$FilterInd" />
            </action>
            <action type="control populate" value="#grdPartneri" />
   
            <action type="control visible" value="#btnParstru" else="">
                <parameter value="false" />
            </action>
             <action type="control disable" value="#btnDodatno" />
            <action type="control disable" value="#btnSadrzaj" />
            <action type="control disable" value="#cmbKlasa" />
            <action type="control populate" value="#grdDetalj"/>
            <action type="control disable" value="#datVrijedido" if="#datVrijedido==null" />
            <action type="control value" value="#datVrijedido">
              <parameter value="now" />
            </action>
            <action type="variable value" if="#grdDetalj.rowcount!=0">
                <parameter name="IndStavki" value="1" />
            </action>
            <action type="variable value" else="">
                <parameter name="IndStavki" value="0" />
            </action>
            <action type="control value" value="#rdoPartneri">
                <parameter value="true" />
            </action>
      
        </event>
        <event type="onshown">
            <action type="control disable" value="btnObrisi" if="#grdPartneri.rowcount==0" />
            <action type="control disable" value="btnSpremi" if="#grdPartneri.rowcount==0" />
            <action type="control disable" value="btnDodaj" if="#grdPartneri.rowcount==0" />
            <action type="control focus" value="#cmbVrsta"/>
            <action type="control disable" value="#btnEditDetalj" if="$IndStavki==0" />
            <action type="control disable" value="#btnDelDetalj" if="$IndStavki==0" />
        </event>
        <event type="close">
            <action type="variable value" value="Global.$OperaterLockId">
                <parameter value="0" />
            </action>
            <action type="datarun nonquery" value="~dtBrisanjeSvih">
                <action type="control populate" value="#grdPartneri" />
            </action>
        </event>        
        <layout textposition="left" itemspadding="3">
        <group cols="1" rows="1">
            <group padding="0" groupbordervisible="False" cols="2" rows="1">
                <columnsdefinition>
                    <column size="390" position="1" />
                    <column size="8" position="2" />
                </columnsdefinition>
                <!--PRVI-->
                    <tabs row="1" col="1" padding="4">
            
                        <group caption="Osnovno" name="tabOsnovno" cols="1" rows="7" col="1" row="1" >
                            <rowsdefinition>
                                <row position="8" size="35" />
                            </rowsdefinition>
                            <part name="carobnjakatributi" path="prtManagerCarobnjak.xml"/>                      
                        </group>
                        <group caption="Kupci" name="tabKupci" cols="1" rows="1" col="1" row="1" >
                            <part name="partTabKupci" path="prtManagerCarobnjak.xml"/>       
                        </group>
                    </tabs>
                <!--Drugi-->
                <group padding="0" groupbordervisible="False" cols="1" rows="2" col="3" row="1">
                    <rowsdefinition>
                        <row size="54" position="2" />
                    </rowsdefinition>
                    <item row="1" col="1"  >
                        <grid name="grdDetalj" dataname="~detGrid" bestfitonrefresh="true" multiselect="true">
                            <fields inherited="true">
                                <field name="sifra" caption="Šifra" />
                                <field name="pronacinnaplateopis" caption="Način naplate" />
                                <field name="hostname" caption="Hostname" visible="false" />
                                <field name="pronacinisporukenaziv" caption="Način isporuke" />
                                <field name="Cassa1" visible="false" format="n4" />
                                <field name="Cassa2" visible="false" />
                                <field name="Cassa3" visible="false" />
                                <field name="Cassa4" visible="false" />
                                <field name="Cassa5" visible="false" />
                                <field name="DatumUgovora" visible="false" />
                                <field name="ugovorvrijedido" visible="false" />
                                <field name="broj" visible="false" />
                                <field name="opis" visible="false" />
                                <field name="povratucesce" visible="false" />
                                <field name="Naziv" fontbold="true"/>
                                <field name="Šifra" fontbold="true"/>
                                <field name="Rabat 1"   format="n4"/>
                                <field name="Rabat 2"  format="n4"/>
                                <field name="Rabat 3"  format="n4"/>
                                <field name="Rabat 4"  format="n4"/>
                                <field name="Rabat 5"  format="n4"/>
                               <field name="Kolicina" caption="Količina" format="n4" />
                                <field name="cijena" format="n4" />
                                <field name="cassa" format="n4" />
                            </fields>
                            <styles>
                                <style name="fontcolor" value="blue" if="#grdDetalj.@KlMasterRobaID==null" />
                                <style name="fontcolor" value="black" else="" />
                            </styles>
                        </grid>
                    </item>
                    <group padding="0" groupbordervisible="true" cols="4" rows="1" col="1" row="2">
                        <item row="1" col="1" textvisible="False">
                            <button name="btnAddDetalj" caption="Dodaj" image="add" type="add">
                                <event type="click">
                                    <action type="form open" value="frmKupDodajDetaljeCarobnjak" >
                                        <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                                    </action>
                                </event>
                            </button>
                        </item>
                        <item row="1" col="2" textvisible="False">
                            <button name="btnEditDetalj" caption="Izmjeni" image="edit">
                                <event type="click">
                                    <action type="form open" value="frmKupIzmjeniDetaljeCarobnjak">
                                        <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                                        <parameter name="KupUgovoriDetId" value="#grdDetalj.@KupUgovoriDetId" />
                                         <parameter name="KupUgovoriDetTempId" value="#grdDetalj.@KupUgovoriDetTempId" />
                                    </action>
                                </event>
                            </button>
                        </item>
                        <item row="1" col="3" textvisible="False">
                            <button caption="Obriši" name="btnDelDetalj" image="delete">
                                <event type="click">
                                  <action type="confirm" value="Želite li zaista obrisati odabrane stavke?">
                                    <action type="control foreachrow selected" value="#grdDetalj">
                                        <action type="datarun nonquery" value="~dtDeleteDetalj" />
                                    </action>
                                    </action>
                                    <action type="control populate" value="#grdDetalj"/>
                                    <action type="control disable" value="#btnEditDetalj" if="#grdDetalj.rowcount==0" />
                                    <action type="control disable" value="#btnDelDetalj" if="#grdDetalj.rowcount==0" />
                                    <action type="control disable" value="#btnStavke" if="#grdDetalj.rowcount==0" />
                                </event>
                            </button>
                        </item>
                        <item row="1" col="4" textvisible="False"> 
                            <button name="btnStavke" caption="Izmjena više stavaka">
                                <event type="click">
                                    <action type="form open" value="frmKupStavkeCarobnjak">
                                        <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                                        <parameter name="@KupUgovoriDetTempId" value="#grdDetalj.@KupUgovoriDetTempId" />
                                    </action>
                                </event>
                            </button>
                        </item>
                        </group>
                </group>
            </group>
        </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodatno" caption="Dodatni uvjeti" dock="right">
                    <event type="click">
                        <action type="form open" value="frmKupDodatniUvjetiCarobnjak" >
                            <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                        </action>
                    </event>
                </button>           
                <button name="btnSadrzaj" caption="Sadržaj" dock="right" >
                </button>
                <button name="btnSpremi" caption="Spremi" >
                    <event type="click">
                        <action if="#grdPartneri.rowcount==0">
                            <action type="message" value="Potrebno odabrati kupca"  />
                        </action>
                        <action else="">
                            <action type="datarun nonquery" value="~dtCarobnjakUnos" />
                            <action type="datarun nonquery" value="~ObrisiDet" />
                            <action type="form close"/>
                        </action>
                    </event>
                </button>
                <button name="btnPrint" caption="Ispiši" dataname="~dtPrint" displayfield="Opis" >
                    <event type="click">
                        <action type="control printcontrol" value="#grdDetalj"/>
                    </event>
                </button>
                <button name="btnZatvori" caption="Zatvori" >
                    <event type="click">
                        <action type="form close">
                         </action>
                    </event>
                </button>               
                            
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_KupUgovori_Izmjena" name="dtZahtjevIzmjena">
                <parameter name="@Broj" value="#txtBroj" />
                <parameter name="@KupUgovoriVrsteId" value="#cmbVrsta" />
                <parameter name="@DatumUgovora" value="#datDatum" />
                <parameter name="@UgovorVrijediDo" value="#datVrijedido" />
                <parameter name="@OrgShemaId" value="#cmbOrgShema" />
                <parameter name="@OsobeId" value="#srcOsobe" />
                <parameter name="@PartneriId" value="#srcPartner" />
                <parameter name="@Opis" value="#txtOpis" />
                <parameter name="@ParStruId" value="#srcParstru" />
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data> 
            <data command="spProd_spKupUgovoriDetTempAzur" name="dtDeleteDetalj">
                <parameter name="@Action" value="2" />
                <parameter name="@KupUgovoriDetTempId" value="#grdDetalj.@KupUgovoriDetTempId" />
            </data>
            
            <data command="spProd_spKupUgovoriDetTempAzur" name="obrisiDet">
                <parameter name="@action" value="4" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>

            <data command="spProd_KupUgoIzmjena_PuniFormu" name="dtGet">
                 <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
            <data command="spTraziPartneri" name="dtPartneri">
                <parameter name="@Action" value="Partneri" />
                <parameter name="@Uvjet" value="#srcPartner.text" />
                <parameter name="@broj_lokacija" value="1" />
            </data>
            <data command="spPubVarsQuery" name="dtPubVars">
                <parameter name="@Action" value="2" />
                <parameter name="@VarIme" value="KupUgovoriParsTru" />
                <parameter name="@Id" value="null" />
            </data>
            <data command="spCarpoPrint" name="dtPrint">
                <parameter name="@Action" value="GetTemplates" />
                <parameter name="@Id" value="$KupUgovoriGlaId" type="int" />
                <parameter name="@Tablica" value="KupUgovoriGla" />
            </data> 
            <data command="spTraziPartneri" name="dtTraziPartneri">
                <parameter name="@Action" value="Partneri1" />
                <parameter name="@uvjet" value="#srcPartneri.text" />
            </data> 
            <data command="spKlPartneriQueryCarpo" name="dtKlPartneri">
                <parameter name="@action" value="0" />
            </data> 

            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtInsertPartner">
                <parameter name="@action" value="1" />
                <parameter name="@PartneriId" value="#srcPartneri" />
                <parameter name="@operateriid" value="@@operateriid" />
            </data> 
            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtInsertSviPartneri">
                <parameter name="@action" value="1" />
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@SviPartneri" value="1" />
            </data> 
            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtInsertKlPartneri">
                <parameter name="@action" value="1" />
                <parameter name="@PartneriId" value="null" />
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@partnernaziv" value="" />
                <parameter name="@ParZiroId" value="null" />
                <parameter name="@parstruid" value="null" />
                <parameter name="@SviPartneri" value="0" />
                <parameter name="@KlPartneriId" value="#cmbKlasa" />
            </data> 
            
            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtPuniGrid">
                <parameter name="@action" value="0" />
                <parameter name="@operateriid" value="@@operateriid" />
            </data> 
            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtObrisiPartnera">
                <parameter name="@Action" value="3" />
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@KupUgovoriGlaTempId" value="#grdPartneri.@KupUgovoriGlaTempId" />
            </data>
    
            <data command="spProd_KupUgoCarobnjak_Kupci" name="dtBrisanjeSvih">
                <parameter name="@Action" value="2" />
                <parameter name="@operateriid" value="@@operateriid" />
            </data> 
            <data command="spProd_KupUgoCarobnjak_Unos" name="dtCarobnjakUnos">
                <parameter name="@action" value="0" />
                <parameter name="@Broj" value="#txtBroj" />
                <parameter name="@Opis" value="#txtOpis" />
                <parameter name="@OsobeId" value="#srcOsobe" />
                <parameter name="@DatumUgovora" value="#datDatum" />
                <parameter name="@UgovorVrijediDo" value="#datVrijedido" />
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@OrgShemaId" value="#cmbOrgShema" />
                <parameter name="@KupUgovoriVrsteId" value="#cmbVrsta" />
                <parameter name="@status" value="0" type="int" if="$Status=='Nezaključen'" />
                <parameter name="@status" value="1" type="int" else="" />
                <parameter name="@dinFak" value="#cmbDinFak" />
            </data> 
            
            <data command="spProd_spKupUgovoriDetTempAzur" name="dtInsertDet">
                <parameter name="@action" value="5" if="@KupUgovoriGlaID!==0"/>
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
            <data command="spProd_spKupUgovoriDetTempAzur" name="detGrid">
                <parameter name="@action" value="6" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
         </datalist>
    </form> 
</root>