<root>
	<form name="frmPar" caption="Filter prikaza">
		<layout>
			<group rows="1" cols="2" >
				<item row="1" col="1" caption="Robna marka:">
					<textedit name="txtRobnaMarka"/>
				</item>
				<item row="1" col="2" caption="Partner:">
					<searchedit  name="srcPartneri"  fieldtext="Partner3000" fieldvalue="Partneriid" entermovenextcontrol="false" dataname="~dtPartneri" allownull="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrikazi" caption="Prikaži">
					<event type="click"> 
						<action type="variable value">
							<parameter name="global.RobnaMarka" value="#txtRobnaMarka" />
							<parameter name="global.Partneriid" value="#srcPartneri" type="int"/>
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartneri.text" />
			</data>
		</datalist>
	</form>
</root>