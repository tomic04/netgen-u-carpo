<root>
  <form name="frmRasporedPlacanjaStavkeUnos" caption="Unos" height="300" width="300" saveformsize="false">
    <layout>
      <group rows="6" cols="2">
        <item row="1" col="1" caption="Razdoblje od">
          <dateedit name="datRazdobljeOd" required="true"/>
        </item>
        <item row="1" col="2" caption="Razdoblje do">
          <dateedit name="datRazdobljeDo"  required="true"/>
        </item>

        <group row="2" col="1" rows="1" cols="3" colspan="2" bordervisible="false">
          <columnsdefinition>
            <column position="1" size="33%"/>
            <column position="2" size="33%"/>
            <column position="3" size="33%"/>
          </columnsdefinition>
          <item row="1" col="1">
            <radioedit name="rbopcijaDatum1" caption="Zadnji u mjesecu" value="1"/>  
          </item>
          <item row="1" col="2">
            <radioedit name="rbopcijaDatum2" caption="Vremenski period"/>
          </item>
          <item row="1" col="3">
            <radioedit name="rbopcijaDatum3" caption="Jednokratno">
              <event type="checkedchanged">
                <action if="#rbopcijaDatum3==true">
                  <action type="control disable" value="#datRazdobljeDo"/>
                  <action type="control disable" value="#cmbPeriodPlacanja"/>
                </action>
                <action else="">
                  <action type="control enable" value="#datRazdobljeDo"/>
                  <action type="control enable" value="#cmbPeriodPlacanja"/>
                </action>
              </event>
            </radioedit>
          </item>
        </group>
        <item row="3" col="1" caption="Period plaćanja"  colspan="2">
          <comboedit name="cmbPeriodPlacanja" dataname="dtGetPeriodiPlacanja" displayfield="naziv" valuefield="UgovoriNajamPeriodiPlacanjaID" required="true"/>
        </item>
        <item row="4" col="1" caption="Iznos plaćanja"  colspan="2">
          <textedit name="txtIznosPlacanja" type="decimal" format="n2" value="0,00" required="true"/>
        </item>
        <item row="5" col="1" caption="Uključene usluge"  colspan="2">
          <textedit name="txtUkljuceneUsluge" type="decimal" format="n2" value="0,00" required="true"/>
        </item>
        <item row="6" col="1" caption="Razlog"  colspan="2">
          <memoedit name="memRazlog" maxlength="100"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action type="datarun nonquery" value="~dtInsertRasporedPlacanja_Jednokratno" if="#rbopcijaDatum3==true"/>
            <action type="datarun nonquery" value="~dtInsertRasporedPlacanja_Visekratno" else=""/>
            <action type="control populate keepfocus" value="parent.#grdRaspored"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtGetPeriodiPlacanja" command="spUgovoriNajamDet_GetPeriodPlacanja">
        <parameter name="@dimenzijeid" value="0"/>
        <parameter name="@rasporedPlacanjaInd" value="1"/>
      </data>
      <data name="dtInsertRasporedPlacanja_Visekratno" command="spUgovoriNajamDet_RasporedPlacanjaUnos_Visekratno">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
        <parameter name="@ValuteId" value="$ValuteId"/>
        <parameter name="@IznosPlacanja" value="#txtIznosPlacanja"/>
        <parameter name="@UkljuceneUslugeUiznosNajma" value="#txtUkljuceneUsluge"/>
        <parameter name="@RazlogNepravilnogPlacanja" value="#memRazlog"/>
        <parameter name="@RazdobljeOd" value="#datRazdobljeOd"/>
        <parameter name="@RazdobljeDo" value="#datRazdobljeDo"/>
        <parameter name="@OpcijaDatum" value="1" if="#rbopcijaDatum1==true"/>
        <parameter name="@OpcijaDatum" value="2" else=""/>
        <parameter name="@PeriodPlacanja" value="#cmbPeriodPlacanja.text"/>
      </data>
      <data name="dtInsertRasporedPlacanja_Jednokratno" command="spUgovoriNajamDet_RasporedPlacanjaUnos_Jednokratno">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
        <parameter name="@ValuteId" value="$ValuteId"/>
        <parameter name="@IznosPlacanja" value="#txtIznosPlacanja"/>
        <parameter name="@UkljuceneUslugeUiznosNajma" value="#txtUkljuceneUsluge"/>
        <parameter name="@RazlogNepravilnogPlacanja" value="#memRazlog"/>
        <parameter name="@RazdobljeOd" value="#datRazdobljeOd"/>
        <parameter name="@RazdobljeDo" value="#datRazdobljeDo"/>
      </data>
    </datalist>
  </form>
</root>