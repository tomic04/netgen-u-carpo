<root> 
	<form name="frmKnjigaUraKupInsert" caption="Unos dokumenta" fixedsize="false" template="splitter" saveformsize="true"> 
		<event type="init">
			<action type="datarun reader" value="~dtUraDatDVO"/>
			<action type="datarun reader" value="~dtIbanPubVar"/>
			<action type="datarun reader" value="~dtIndUgovor"/>
			<!-- PozivIzUre slati kada se bude zvalo iz KnjigeUra -->
			<!-- <action type="variable value"> -->
				<!-- <parameter name="PozivIzUre" value="0"/> -->
			<!-- </action>	 -->	
			<action type="datarun reader" value="~dtCheckPermission"/>
			<action type="variable value">
				<parameter name="SmijeKUP" value="~dtCheckPermission.@SmijeKUP"/>
				<parameter name="SmijeURA" value="~dtCheckPermission.@SmijeURA"/>
			</action>		
			<action type="datarun reader" value="~dtCheckAutoClose"/>
			<action type="variable value">
				<parameter name="AutoClose" value="~dtCheckAutoClose.@AutoClose"/>
			</action>				
		</event>
		<event type="load">	
			<!--TEST unos-->
			<!-- <action type="variable value" value="$Id"> -->
			<!-- <parameter value="BC27633D-4127-4A1E-B49F-FAC2ABED0714"/> -->
			<!-- </action> -->
			<action type="variable value">
				<parameter name="IndDatDvoDatVal" value="~dtUraDatDVO.@IndDatDVO" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="IbanPubVar" value="~dtIbanPubVar.@DodajIban"/>
			</action>
			<action type="variable value">
				<parameter name="IznosFakture" value="0" type="decimal"/>
			</action>		
			<action type="variable value">
				<parameter name="IndUgovor" value="~dtIndUgovor.@IndUgovor" type="int"/>
			</action>
			<part name="prtTabUraDisableAll" path="prtKnjigaUraTabUra.xml"/>			
		</event>
		<event type="shown">
			<!-- <action type="datarun reader" value="~dtCheckIfEdit"/> -->
			<!-- <action type="variable value" value="$EditForm"> -->
			<!-- <parameter value="~dtCheckIfEdit.@IndIzmjena"/> -->
			<!-- </action>		 -->
			<!-- <action type="variable value" value="$DokId" if="$EditForm==0"> -->
			<!-- <parameter value="$Id" type="string"/> -->
			<!-- </action> -->
			<action type="variable value" value="$DokumentId">
				<parameter value="$Id"/>
			</action>	
			<action type="variable value" value="$KupPrometId">
				<parameter value="null"/>
			</action>				
			<action type="control populate" value="#grdPrivitci"/>
			<!-- <action type="datarun reader" value="~dtPrivitci"/> -->
			<!--spremanje ure onemogućeno dok se ne spremi u kup-->
			<action type="control disable" value="#btnSpremi,#btnProknjizi,#cheTem"/>
			<action type="control focus" value="#cmbVrstaPoste"/>
			<!--TEST-->
			<!-- <action type="variable value" value="$KupPrometId"> -->
			<!-- <parameter value="7083"/> -->
			<!-- </action> -->
			<!--Popuni iznos i valutu iz dms.RacunAI ako je proslijeđen DokumentId-->
			<action if="$DokumentId!=null">
				<action type="datarun reader" value="~dtRacunAI"/>
				<!-- Popunjavamo iznos na KUP i URA tabu -->
				<action type="control value" value="#txtIznosKup" if="~dtRacunAI.@UkupniIznos!=null">
					<parameter value="~dtRacunAI.@UkupniIznos"/>
				</action>
				<action type="control value" value="#curIznossPdv" if="~dtRacunAI.@UkupniIznos!=null">
					<parameter value="~dtRacunAI.@UkupniIznos"/>
				</action>
				<!-- Prvo popunimo combo boxeve za valutu, zatim postavimo vrijednost -->
				<action type="control populate" value="#cmbValutaKup"/>
				<action type="control populate" value="#cmbDevValuta"/>
				<!-- Popunjavamo valutu na KUP i URA tabu -->
				<action type="control value" value="#cmbValutaKup" if="~dtRacunAI.@ValutaId!=null">
					<parameter value="~dtRacunAI.@ValutaId"/>
				</action>
				<action type="control value" value="#cmbDevValuta" if="~dtRacunAI.@ValutaId!=null">
					<parameter value="~dtRacunAI.@ValutaId"/>
				</action>
				<!-- Popunjavamo partnera na KUP i URA tabu -->
				<action type="control populate" value="#srcPartnerKup"/>
				<action type="control populate" value="#srcPartner"/>
				<!-- Postavimo vrijednost partnera na KUP tabu -->
				<action type="control value" value="#srcPartnerKup" if="~dtRacunAI.@PartneriId!=null">
					<parameter value="~dtRacunAI.@PartneriId" text="~dtRacunAI.@NazivPartnera"/>
				</action>
				<!-- Postavimo vrijednost partnera na URA tabu -->
				<action type="control value" value="#srcPartner" if="~dtRacunAI.@PartneriId!=null">
					<parameter value="~dtRacunAI.@PartneriId" text="~dtRacunAI.@NazivPartnera"/>
				</action>
			</action>
		</event>	
		<event type="close">
			<action type="datarun nonquery" value="~dtSelecteIdRemove"/>
		</event>
		<layout name="panel1" type="collapsable" textposition="top" minsize="900">
			<group padding="0" groupbordervisible="false" cols="1" rows="2">
				<columnsdefinition>
					<!-- <column size="880" position="1"/> -->
				</columnsdefinition>			
				<tabs row="1" col="1" padding="4">	
					<!-- KUP -->
					<part name="prtTabKup" path="prtKnjigaUraTabKup.xml"/>
					<!--URA-->
					<part name="prtTabUra" path="prtKnjigaUraTabUra.xml"/>				
				</tabs>
				<part name="prtTabPrivitci" path="prtKnjigaUraTabPrivitci.xml"/>
			</group>
		</layout> 
		<layout name="panel2">
			<group  groupbordervisible="false" cols="1" rows="1">
				<columnsdefinition>
					<column position="1" size="420"/>					
				</columnsdefinition>
				<item col="1" row="1">
					<pdfviewer name="picPrivitak" dbpdf="~dtPrivitci.@DokBLOB"/>
				</item>			
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnProslijedi" caption="ODOBRAVANJE PROSLIJEDI">
					<event type="click">
						<action if="$KupPrometId!=null">
							<action type="datarun reader" value="~dtOdobravanjeOtvori"/>
							<action type="message" value="{~dtOdobravanjeOtvori.@Poruka}" if="~dtOdobravanjeOtvori.@Otvori==0"/>
							<action type="form open" value="frmOdobravanje" else="~dtOdobravanjeOtvori.@Otvori==1">
								<parameter name="KupPrometId" value="$KupPrometId"/>
							</action>
							<action type="datarun reader" value="~dtStatus"/>
							<action type="datarun reader" value="~dtGetKup"/>
							<action type="form caption" value="Izmjena dokumenta || {~dtGetKup.@Broj} || {~dtGetKup.@UrudzbeniBroj} || {~dtGetKup.@BrojUFE} || **** STATUS: {~dtStatus.@Status} ****"/>									
							<action type="form close"/>
						</action>
						<action type="message" value="Prije odobravanja potrebno je urudžbirati dokument!" else=""/>
					</event>
				</button>
				<button name="btnOdustani" caption="ZATVORI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
				<button name="btnPrekiniProces" caption="ZATVORI SVE" dock="right">
					<event type="click">
						<action type="datarun nonquery" value="~dtPrekiniProces"/>
						<action type="form close"/>
					</event>
				</button>					
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntVrsteKnjigaUraQuery" name="dtVrstaKnjige">
				<parameter name="@action" value="0" type="int"/>
			</data>
