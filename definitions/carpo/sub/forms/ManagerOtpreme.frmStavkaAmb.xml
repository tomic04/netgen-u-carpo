<root>
    <form name="frmStavkaAmb" caption="Ambalaža" width="350" height="200" fixedsize="false">
        <event type="oninit">
			<action type="datarun reader" value="~dtAmbalazaQuery" if ="$Action_Amb==1"/>
        </event>
        <event type="onload">
        </event>			
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
				<group rows="3" cols="1" row="1" col="1" entermovenextcontrol="true">
					<item caption="Ambalaža:" row="1" col="1">
						<comboedit name="cmbAmbalaza" valuefield="RobaId" displayfield="Naziv" datavalue="#dtAmbalazaQuery.@RobaId" dataname="~dtAmbalazaRoba" required="true"/>
					</item>				
					<item caption="Količina:" row="2" col="1">
						<textedit name="txtAmbKolicina" datavalue="#dtAmbalazaQuery.@Kolicina" type="int" format="n0" required="true"/>
					</item>
					<item caption="Bruto težina:" row="3" col="1">
						<textedit name="txtAmbBrutoTezina" datavalue="#dtAmbalazaQuery.@Tezina" type="decimal" format="n2" required="true"/>
					</item>							
				</group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun reader" value="~dtAmbalazaUnos" if="$Action_Amb==0"/>
						<action type="datarun reader" value="~dtAmbalazaIzmjena" if="$Action_Amb==1"/>
						<action type="control populate keepfocus" value="parent.#grdAmbalaza" />
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_NotpDet_Ambalaza" name="dtAmbalazaQuery">
				<parameter name="@Action" value="7" />
                <parameter name="@ProNotpDetId" value="$ProNotpDetId" />
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@ProNotpDetAmbId" value="$ProNotpDetAmbId" />
				<parameter name="@OperateriId" value="@@OperateriId" />
            </data>
            <data command="spProd_NotpDet_Ambalaza" name="dtAmbalazaUnos">
				<parameter name="@Action" value="2" />
				<parameter name="@ProNotpDetId" value="$ProNotpDetId" />
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@RobaId" value="#cmbAmbalaza" />
				<parameter name="@Tezina" value="#txtAmbBrutoTezina" />
				<parameter name="@Kolicina" value="#txtAmbKolicina" />				
            </data>
            <data command="spProd_NotpDet_Ambalaza" name="dtAmbalazaIzmjena">
				<parameter name="@Action" value="3" />
				<parameter name="@ProNotpDetAmbId" value="$ProNotpDetAmbId" />
				<parameter name="@ProNotpDetId" value="$ProNotpDetId" />
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@OperateriId" value="@@OperateriId" />				
				<parameter name="@RobaId" value="#cmbAmbalaza" />
				<parameter name="@Tezina" value="#txtAmbBrutoTezina" />
				<parameter name="@Kolicina" value="#txtAmbKolicina" />
            </data>
            <data command="spProd_NotpDet_Ambalaza" name="dtAmbalazaRoba">
				<parameter name="@Action" value="0" />
            </data>	
        </datalist>
    </form>
</root>