<root>
    <form name="frmPovratDokumentacije" caption="Povrat dokumentacije" fixedsize="false">	
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
				<group rows="3" cols="1" row="1" col="1" entermovenextcontrol="true">
                    <item caption="" row="1" col="1" >
                        <labeledit name="lblPovDok" datavalue="" prefix="" value="Odabrali ste dokumente s različitim statusima povrata dokumentacije.\nMolim odabrati željenu akciju:" sufix="" multiline="true" fontsizedelta=""/>
                    </item>                    
					<item row="2" col="1" caption="">
                        <radioedit name="rdoPovDok_Da" caption="Na svim dokumentima postavi DA." value="true" />
                    </item>
                    <item row="3" col="1" caption="">
                        <radioedit name="rdoPovDok_Ne" caption="Na svim dokumentima postavi NE." value="false" />
                    </item>						
				</group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="PROMIJENI" type="add" dock="left">
                    <event type="click">
						<action type="variable value" if="#rdoPovDok_Da==true">
							<parameter name="PovratDok" value="1" />
						</action>
						<action type="variable value" if="#rdoPovDok_Ne==true">
							<parameter name="PovratDok" value="0" />
						</action>
						<action type="datarun nonquery" value="Global.dtPovratDokumentacije"/>						
						<action type="form close"/>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
    </form>
</root>