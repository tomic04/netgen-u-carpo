<!--
  8.9.2021. MG - doradio izgled za DevX 20 
  (namjestio oznaku JOPPD po ulasku u formu)
-->

<root>
  
    <form name="frmObrasci" caption ="$caption" width="650" height="200"  fixedsize="true" saveformsize="false" showversion="true" version="1">
      <event type="init">
        <action type="datarun reader" value="~dtDefault" />
        <action type="datarun reader" value="~dtGet" />
  
        <action type="variable value">
          <parameter name="OznakaJOPPD" value="~dtDefault.@oznakaJOPPD" type="string"/>
        </action>
  
      </event>
  
      <event type="load">

        <!-- sad je 0; na kliku na SPREMI, ako su odabrani formiranje obje vrste dokumenta, bit će 1 ako je $indGreske za bilo koji od 2 dokumenta 1-->
        <!-- da znam kada raditi refresh/zatvoriti formu i dr.-->
        <action type="variable value" value="greske">
          <parameter value="0"/>
        </action>
  
        <action type="control disable" value="#chkVirmani" if="~dtDefault.@visVirmani==0"/>
        <action type="control enable" value="#chkVirmani" else=""/>
  
        <action type="control disable" value="#chkJOPPD" if="~dtDefault.@visJOPPD==0"/>
        <action type="control enable" value="#chkJOPPD" else=""/>
  
        <action type="control disable" value="#datDatumJOPPD,#cmbOpcijeJOPPD"></action>
        <action type="control visible" value="#lblNapomena">
          <parameter value="false"/>
        </action>
  
        <action type="control populate" value="#cmbOpcijeJOPPD"/>
        <action type="control value" value="#lblNapomena">
          <parameter value="#cmbOpcijeJOPPD.@napomena"/>
        </action>
  
      </event>
  
      <event type="shown">
        <action type="control attribute" value="#chkJOPPD,#chkVirmani">
          <parameter name="fontcolor" value="black"/>
        </action>
        <action type="control value" value="#lblOznakaJOPPD">
          <parameter value="$OznakaJOPPD"/>
        </action>
      </event>
  
      <layout>
  
        <!--omotač-->
        <group cols="1" rows="2" groupbordervisible="true"  caption="Opcije obračuna">
  
          <group col="1" row="1" cols="4" rows="5"  groupbordervisible="true"  spacing="2,1,2,2" alignmode="local">
  
            <columnsdefinition>
              <column position="1" size="40%"></column>
              <column position="2" size="10%"></column>
              <column position="3" size="10%"></column>
              <column position="4" size="40%"></column>
            </columnsdefinition>
  
            <item col="1" row="1" textposition="right"   fontsizedelta="1" highlight="False">
              <checkedit name="chkJOPPD" checked="false" caption="Kreiranje JOPPD obrasca" fontsizedelta="3"  >
                <event type="checkedchanged">
                  <action type="control enable" value="#datDatumJOPPD, #cmbOpcijeJOPPD" if="#chkJOPPD==true"></action>
                  <action type="control disable" value="#datDatumJOPPD, #cmbOpcijeJOPPD" else=""></action>
                  <action type="control visible" value="#lblNapomena" if="#chkJOPPD==true">
                    <parameter value="true"/>
                  </action>
                  <action type="control visible" value="#lblNapomena" else="">
                    <parameter value="false"/>
                  </action>
  
                </event>
              </checkedit>
            </item>
  
            <item caption="" col="2" row="1" >
              <labeledit name="lblBrojJOPPD"   fontsizedelta="2" fontbold="true"  textposition="right" datavalue="~dtDefault.@BrojacJOPPD"/>
            </item>
            <item caption="" col="3" row="1"  >
              <labeledit name="lblOperaterJOPPD"   fontsizedelta="3" fontbold="false" textposition="right" datavalue="~dtDefault.@OperaterJOPPD"/>
            </item>
            <item caption="" col="4" row="1"  >
              <labeledit name="lblDatumJOPPD"   fontsizedelta="3" fontbold="false" textposition="right" datavalue="~dtDefault.@LogDatumJOPPD"/>
            </item>
  
  
  
            <item caption="" col="1" row="2" colspan="4" >
              <labeledit name="lblNapomena"   fontsizedelta="2" fontbold="true"  textposition="left" value="Napomena....." fontcolor="blue" datavalue="~dtOpcijeJOPPD.@napomena" multiline="true"/>
            </item>
  
            <item  col="1" row="3" colspan="2" textposition="left"  highlight="False">
              <dateedit name="datDatumJOPPD" datavalue="~dtDefault.@DatumJOPPD" caption="Datum JOPPD:">
               
                <event type="valuechanged">
                  <action type="datarun reader" value="~dtDajJOPPDOznaku"/>
                  <action type="control value" value="#lblOznakaJOPPD">
                    <parameter value="~dtDajJOPPDOznaku.@oznaka"/>
                  </action>
                  <action type="variable value" value="$OznakaJOPPD">
                    <parameter value="~dtDajJOPPDOznaku.@oznaka"/>
                  </action>
                  <action type="control populate" value="#cmbOpcijeJOPPD"/>
                  <action type="control value" value="#lblNapomena">
                    <parameter value="#cmbOpcijeJOPPD.@napomena"/>
                  </action>
                </event>
              </dateedit>
            </item>
  
            <item caption="" col="3" row="3" >
              <labeledit name="lblOznakaJOPPD"   fontsizedelta="2"   textposition="right"/>
            </item>
  
  
            <item caption="Opcija spremanja:" col="1" row="4" colspan="4"  highlight="False" textposition="left" >
              <comboedit name="cmbOpcijeJOPPD" autopopulate="false" allownull="false" displayfield="opcijaTxt" valuefield="IndOpcija" dataname="~dtOpcijeJOPPD" required="true" />
            </item>
  
  
          </group>
  
          <group col="1" row="2" cols="4" rows="1"  groupbordervisible="true"  spacing="2,1,2,2">
  
            <columnsdefinition>
              <column position="1" size="40%"></column>
              <column position="2" size="10%"></column>
              <column position="3" size="10%"></column>
              <column position="4" size="40%"></column>
            </columnsdefinition>
  
            <item col="1" row="1" textposition="right"   fontsizedelta="1" highlight="false">
              <checkedit name="chkVirmani"  caption="Kreiranje virmana" fontsizedelta="3"  />
            </item>
  
            <item caption="" col="2" row="1"  >
              <labeledit name="lblBrojVirmani"   fontsizedelta="2" fontbold="true" textposition="right" datavalue="~dtDefault.@BrojacVirmana"/>
            </item>
  
            <item caption="" col="3" row="1"  >
              <labeledit name="lblOperaterVirmani"   fontsizedelta="3" fontbold="false" textposition="right" datavalue="~dtDefault.@OperaterVirmani"/>
            </item>
            <item caption="" col="4" row="1"  >
              <labeledit name="lblDatumVirmani"   fontsizedelta="3" fontbold="false" textposition="right" datavalue="~dtDefault.@LogDatumVirmani"/>
            </item>
  
          </group>
  
  
        </group>
        <!--kraj omotača-->
  
      </layout>
  
      <panelbuttons>
        <buttons>
          <button name="btnFormiraj" caption="FORMIRAJ" >
            <event type="click">
              <!-- Provjeri required fields -->
              <action type="validate" />
  
              <action type="control attribute" value="#chkJOPPD,#chkVirmani">
                <parameter name="fontcolor" value="black"/>
              </action>

  
              <!--kreiranje joppd-->
              <action if="#chkJOPPD==true">
                <action type="datarun reader" value="~dtObracunJOPPD" waittype="progress" waitcaption="Pričekajte..." waittext="..kreiranje JOPPD obrasca u tijeku...">
                  <action if="$indGreske==1" type="variable value" value="$greske">
                    <parameter value="1"/>
                  </action>
                </action>
              </action>
  
              <!--kreiranje virmana-->
              <action if="#chkVirmani==true">
                <action type="datarun reader" value="~dtObracunVirmana" waittype="progress" waitcaption="Pričekajte..." waittext="..kreiranje virmana u tijeku..." >
                  <action if="$indGreske==1" type="variable value" value="$greske">
                    <parameter value="1"/>
                  </action>
                </action>              
              </action>

              <!-- ako nije bilo greške na ijednoj od odabranih opcija-->
              <action if="$greske==0">

                <!-- poruka iz store; generička je (Odabrani obrasci uspješno formirani!), dolazi iz spDDObracun-->
                <action type="message" value="$poruka"></action>

                <!-- ako je formiranje uspješno, a odabrane su obje opcije, zatvori formu nakon poruke-->
                <action if="#chkJOPPD==true&amp;&amp;#chkVirmani==true" type="form close"></action>

                <!-- okini datarunove za vrijednosti kontrola, refreshvalue svih kontrola osim onih za koje nije potrebno (npr.za oznaku/datum joppd)-->
                <action type="datarun reader" value="~dtDefault"></action>
                <action type="datarun reader" value="~dtOpcijeJOPPD"></action>
                <action type="control refreshvalue" value="##,!#lblOznakaJOPPD,!#datDatumJOPPD"></action>
                <action type="control populate" value="#cmbOpcijeJOPPD"></action>
              </action>
  
            </event>
          </button>
          <button name="btnOdustani" caption="ODUSTANI" >
            <event type="click">
              <action type="form close" />
            </event>
          </button>
        </buttons>
      </panelbuttons>
  
      <datalist>
  
        <data command="spDD_Help_CP" name="dtDajJOPPDOznaku">
          <parameter name="@Action" value="postavi_joppd_oznaku" type="string"/>
          <parameter name="@operateriid" value="@@operateriid"/>
          <parameter name="@datum" value="#datDatumJOPPD"/>
        </data>
        <data command="spDD_Help_CP" name="dtDefault">
            <parameter name="@Action" value="default_obracun" type="string"/>
            <parameter name="@operateriid" value="@@operateriid"/>
            <parameter name="@oopisobradeid" value="global.$oopisobradeid"/>
          </data>
          <data command="spDD_Help_CP" name="dtOpcijeJOPPD">
            <parameter name="@Action" value="kontrola_opcije_joppd" type="string"/>
            <parameter name="@oznakajoppd" value="$OznakaJOPPD"/>
            <parameter name="@oopisobradeid" value="global.$oopisobradeid"/>
          </data>
        <data command="spDDObracun" name="dtObracunVirmana" timeout="~dtDefault.@TimeOutVirmani">
          <parameter name="@Action" value="virmani" type="string"/>
          <parameter name="@operateriid" value="@@operateriid"/>
          <parameter name="@oopisobradeid" value="global.$oopisobradeid"/>

          <parameter name="@indGreske.output.int" />
          <parameter name="@poruka.output.string" />
        </data>
        <data command="spDDObracun" name="dtObracunJOPPD" timeout="~dtDefault.@TimeOutJOPPD">
          <parameter name="@Action" value="joppd" type="string"/>
          <parameter name="@operateriid" value="@@operateriid"/>
          <parameter name="@oopisobradeid" value="global.$oopisobradeid"/>
          <parameter name="@joppdDatum"  value="#datDatumJOPPD"/>
          <parameter name="@joppdOznaka" value="$OznakaJOPPD"/>
          <parameter name="@opcijaJOPPD" value="#cmbOpcijeJOPPD"/>
          <parameter name="@kodjoppdaid" value="#cmbOpcijeJOPPD.@KODJoppdAId"/>

          <parameter name="@indGreske.output.int" />
          <parameter name="@poruka.output.string" />
        </data>
      </datalist>
    </form>
  
  
    <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
  </root>