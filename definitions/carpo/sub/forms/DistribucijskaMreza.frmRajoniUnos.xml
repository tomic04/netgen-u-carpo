<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmRajoniUnos" caption="Unos" width="400" height="200">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<layout>
			<group cols="1" rows="2">
				<item col="1" row="1" caption="Šifra" >
					<textedit name="txtSifra" >
					</textedit> 
				</item>
				<item col="1" row="2" caption="Naziv" >
					<textedit name="txtNaziv" >
					</textedit> 
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" >
					<event type="click">
						<action type="datarun nonquery" value="~dtRajoniInsert" />
						<action type="control populate" value="parent.#tree" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" >
				</button>				
			</buttons>
		</panelbuttons>
        <datalist>
            <data command="spRajoniInsert" name="dtRajoniInsert">
                <parameter name="@Sifra" value="#txtSifra" />
				<parameter name="@Opis" value="#txtNaziv" />
            </data>
			<data command="spRajoniQuery" name="dtGet">
				<parameter name="Action" value="4"/>
				<!-- <parameter name="Id" value="$Id"/> -->
			</data>			
		</datalist>		
	</form>
</root>	