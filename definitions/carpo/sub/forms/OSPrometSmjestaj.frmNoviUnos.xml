<root version="1.0">

	<form name="frmNoviUnos" caption="$Caption" fixedsize="false" width="1100" height="600" saveformlayout="true">

		<event type="oninit">
			<action type="datarun reader" value="~dtVrstaDok" />
			<action type="datarun reader" value="~dtOdgovornaOsoba" />
			<action type="datarun reader" value="~dtGet" if="$OSImovinaSmjestajGlaId!=null" />
		</event>
    <event type="onload">
      <action type="control disable" value="#cmbVrstaDok" if="$OSImovinaSmjestajGlaId!=null" />
      <action type="control populate" value="#grdStavke" if="$OSImovinaSmjestajGlaId!=null" />
    </event>

    <layout textposition="left" itemspadding="3">		      
			<group cols="1" rows="2" groupbordervisible="false">
        <!--grupa zaglavlja-->
				<group cols="3" rows="2" col="1" row="1" spacing="2,2,2,1">
					<columnsdefinition>
						<column  position="2" size="50%" />
					</columnsdefinition> 
					<item caption="Vrsta dokumenta:" row="1" col="1">
						<comboedit name="cmbVrstaDok"  required="true" valuefield="VrstaDokId" displayfield="Opis" datavalue="~dtGet.@VrstaDokId" dataname="~dtVrstaDok" />
					</item>
					<item caption="Datum dokumenta:" row="2" col="1">
						<dateedit name="datDatumDok"  datavalue="~dtGet.@DatumDok" value="now" required="true" />
					</item>
					<item caption="Broj dokumenta:" row="1" col="2">
						<textedit name="txtBroj" datavalue="~dtGet.@BrojDok"  enabled="false" fontbold="true" nulltext=""/>
					</item>
					<item caption="Odgovorna osoba:" row="2" col="2">
						<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" datavalue="~dtGet.@OsobeId" dataname="~dtOdgovornaOsoba" required="true"/>
					</item>

					<group cols="1" rows="1" row="2" col="3" groupbordervisible="false">
						<columnsdefinition>
							<column  position="1" size="80" />
						</columnsdefinition> 
						<rowsdefinition>
							<row size="40" position="1" />
						</rowsdefinition>

						<item caption="" row="1" col="1" >
							<button name="btnSpremi"  caption="Spremi" type="add"  >
								<event type="click">                  
									<action type="validate"/>
                    <action type="datarun reader" value="~dtKontrolaBlokade"/>
                    <action type="message" value="~dtKontrolaBlokade.@Poruka" if="~dtKontrolaBlokade.@IndGreska==1"/>
									  <action type="datarun reader" value="~dtSmjestajGlaIns" if="~dtKontrolaBlokade.@IndGreska==0"/>
									  <action type="control value" value="#txtBroj" if="~dtKontrolaBlokade.@IndGreska==0" >
										  <parameter value="~dtSmjestajGlaIns.@BrojDok" />
									  </action>
									  <action type="variable value" if="~dtKontrolaBlokade.@IndGreska==0" >
										  <parameter name="OSImovinaSmjestajGlaId" value="~dtSmjestajGlaIns.@OSImovinaSmjestajGlaId" type="int" />
									  </action>
                    <action type="control enable" value="#btnIns,#btnZakljuciDok" if="$OSImovinaSmjestajGlaId!=0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0" />
                    <action type="control enable" value="#btnEdit" if="#grdStavke.rowcount!=0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0" />
                    <action type="control enable" value="#btnDel" if="#grdStavke.rowcount!=0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0" />
                    <action type="control disable" value="#cmbVrstaDok" if="$OSImovinaSmjestajGlaId!=0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0" />
                    <action if="#grdStavke.rowcount==0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0" type="form open" value="frmNoviUnos_Det" >
										  <parameter name="OSImovinaSmjestajGlaId" value="~dtSmjestajGlaIns.@OSImovinaSmjestajGlaId" type="int" /> 
										  <parameter name="OSImovinaSmjestajDetId" value="0" type="int" /> 
										  <parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" /> 
                      <parameter name="DatumPromjene" value="#datDatumDok" type="date" /> 
									  </action>
                  <action type="control populate" value="#grdStavke" if="~dtKontrolaBlokade.@IndGreska==0"/>                  
								</event>
                
							</button>
						</item>
					</group>
				</group >
        
        <!--grupa detalja-->
				<group cols="1" rows="2" col="1" row="2" spacing="2,2,1,2">
          <!--grupa grid stavke -->
					<group cols="1" rows="1" col="1" row="1" groupbordervisible="false">
						<item caption="" row="1" col="1">
							<grid name="grdStavke" dataname="dtStavke" key="OSImovinaSmjestajDetId" keyfield="OSImovinaSmjestajDetId" type="master" multiselect="true" bestfitonrefresh="True" fieldsmartspaces="false">
								<event type="focusedrowchanged">
									<action type="control enable" value="#btnEdit" if="#grdStavke.rowcount!=0" />
									<action type="control disable" value="#btnEdit" else="" />
									<action type="control enable" value="#btnDel" if="#grdStavke.rowcount!=0" />
									<action type="control disable" value="#btnDel" else="" />
								</event>
								<fields>
								</fields>
							</grid>
						</item>
					</group>
          <!--grupa gumba unos/izmjena/brisanje-->
					<group cols="6" rows="1" col="1" row="2" groupbordervisible="false">
						<columnsdefinition>
							<column  position="1" size="80" />
							<column  position="2" size="80" />
							<column  position="3" size="80" />
						</columnsdefinition> 
						<rowsdefinition>
							<row size="40" position="1" />
						</rowsdefinition>
						<item caption="" row="1" col="1">
							<button name="btnIns"  caption="Unos" type="add"  >
								<event type="click">
									<action type="form open" value="frmNoviUnos_Det" >
										<parameter name="OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" type="int" /> 
										<parameter name="OSImovinaSmjestajDetId" value="0" type="int" /> 
										<parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" /> 
                    <parameter name="DatumPromjene" value="#datDatumDok" type="date" /> 
									</action>
									<action type="control populate" value="#grdStavke" >
										<action type="control focus" value="#grdStavke" >
											<parameter value="$OSImovinaSmjestajDetId" />
										</action> 
									</action>									
								</event>
							</button>
						</item>
						<item caption="" row="1" col="2">
							<button name="btnEdit"  caption="Izmjena" type="edit" function="IzmjenaSmjestaj" >
								<event type="click">
									<action type="form open" value="frmNoviUnos_Det" >
										<parameter name="OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" type="int" /> 
										<parameter name="OSImovinaSmjestajDetId" value="#grdStavke.@OSImovinaSmjestajDetId" type="int" /> 
										<parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" /> 
									</action>
									<action type="control populate keepfocus" value="#grdStavke" />                  
								</event>
							</button>
						</item>
						<item caption="" row="1" col="3">
							<button name="btnDel" caption="Brisanje" type="del" function="BrisanjeSmjestaj" >
								<event type="click">
									<action type="confirm" value="Želite li obrisati označene stavke?">
										<action type="datarun reader" value="~dtDelStavke">
											<action type="control populate" value="#grdStavke" >
												<action type="control focus" value="#grdStavke" >
													<parameter value="0"  />
												</action>
											</action>
										</action>
									</action>
								</event>
							</button>
						</item>
					</group>
				</group >
			</group >
		</layout>
	
		<panelbuttons>
			<buttons>
				<button name="btnZakljuciDok" caption="Zaključi dokument" type="add" dock="right">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtZakljuciDok">
						</action>
            <action type="form close"/>
					</event>
				</button> 
				<button caption="IZLAZ" type="cancel" dock="right" >
					<event type="click" >
            <action type="form close"/>
          </event>
				</button>
			</buttons>
		</panelbuttons>

    
		<datalist>
      <data command="spOSImovinaPrometSmjHelp_CP" name="dtKontrolaBlokade">
        <parameter name="@Action" value="Kontrola_blokade"/>
        <parameter name="@DatumDok" value="#datDatumDok"/>
      </data>
			<data command="spOSImovinaPrometSmjHelp_CP" name="dtVrstaDok">
				<parameter name="@Action" value="VrstaDok_combo" />
			</data>
      <data command="spOSImovinaPrometSmjHelp_CP" name="dtOdgovornaOsoba">
        <parameter name="@Action" value="Osobe_combo" />
      </data>
      <data command="spOSImovinaPrometSmjHelp_CP" name="dtGet">
        <parameter name="@Action" value="Izmjena_Gla" />
        <parameter name="@OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" />
      </data>
      <data command="spOSImovinaPrometSmjQuery_CP" name="dtStavke">
				<parameter name="@Action" value="Detalj_query" />
				<parameter name="@OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" />
			</data>
      <data command="spOSImovinaPrometSmjAzur_CP" name="dtZakljuciDok">
        <parameter name="@Action" value="ZakljucajDok" />
        <parameter name="@OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" />
      </data>-->
     <data command="spOSImovinaPrometSmjAzur_CP" name="dtSmjestajGlaIns">
				<parameter name="@Action" value="SmjestajGla_unos" />
				<parameter name="@OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" />
				<parameter name="@VrstaDokId" value="#cmbVrstaDok" />
				<parameter name="@DatumDok" value="#datDatumDok" />
				<parameter name="@OsobeId" value="#cmbOsobe" />
				<parameter name="@OperateriId" value="@@OperateriId" />
			</data>
      <data command="spOSImovinaPrometSmjAzur_CP" name="dtDelStavke">
        <parameter name="@Action" value="SmjestajDet_brisanje" />
        <parameter name="@SelectedIds" value="#grdStavke.SelectedIds" />
        <parameter name="@OSImovinaSmjestajGlaId" value="$OSImovinaSmjestajGlaId" />
      </data>

		</datalist>


		
	</form>



</root>