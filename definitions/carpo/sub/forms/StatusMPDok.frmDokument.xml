<root version="1.0.0.1">
	<form name="frmDokument" type="master" caption="Dokument broj naloga: '{$BrojDok}', od datuma: '{$DatumDok}'" width="800" height="600" statusbar="true">
		<event type="init"> 
			
		</event>
		<event type="load">	
			<action type="control populate" value="#grdDokument"/>
		</event>
		<event type="shown">	
		<action type="control populate" value="#grdDokument"/>
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdDokument" printcaptionalign="center" printcaption="Detalji maloprodajnog dokumenata ID {parent.#grdStavke.@MaloprodajaGlaId}, broj naloga: '{$BrojDok}', od datuma: '{$DatumDok}"  
						header=" \n " headeralign="center" multiselect="false" key="Broj" showgrouppanel="true" showfooter="false" showautofilterrow = "false" savelayout="false">												
							<data command="spCRobnoStatusMPDokStavke">
								<parameter name="@action" value="1"/>
								<parameter name="@maloprodajaGlaId" value="parent.#grdStavke.@MaloprodajaGlaId"/>
							</data>
							<fields>	
								<field name="broj" caption="Broj "/>	
								<field name="datumdok" caption="Datum Dokumenta" />
								<field name="PartnerNaziv" caption="Partner Naziv" />
								<field name="Naziv" caption="Naziv Robe" />
								<field name="KolicinaUlaz" caption="Kolicina ulaz" />
								<field name="MpVrijednost" caption="MP Vrijednost" />
								<field name="PDVVrijednost" caption="PDVVrijednost" />
							</fields>
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<panelbuttons>
		
			<buttons>
				<button name="btnIspis" caption="Ispiši"  dock="right" >
				<event type="click">
					<action type="control printcontrol" value="#grdDokument"/>
				</event>
			</button>
				<button caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>
				
			</buttons>
		</panelbuttons>
		<datalist>
		 <print  caption="Devizna kartica konta za razdoblje: {global.$DatumOd::dd.MM.yyyy} - {global.$DatumDo::dd.MM.yyyy}" 
			captionalign="center" header="{#cmbKonto.@KNaziv} \n {#srcPartner.@NazivId}" headeralign="center"/>

		</datalist>
	</form>
</root>