<root>
	<form name="frmPovezi" caption="Poveži fakture" fixedsize="false">
		<event type="close">

		</event>		
		<layout textposition="top" itemspadding="1">
			<group cols="1" rows="5" groupbordervisible="false">
				<item col="1" row="1" caption="Vrsta povezivanja:" >
					<comboedit name="cmbVrstaPovezivanja" valuefield="LNFaktureVrsteId" displayfield="Opis" dataname="Global.dtVrstaPovezivanja" />
				</item>	
				<item col="1" row="2" caption="Račun:" >
					<searchedit name="srcRacun" fieldtext="Naziv" fieldvalue="PartneriId"  fontbold="true" required="true" dataname="global.dtRacunSearch">
						<event type="leave">
						</event>
					</searchedit>	
				</item>				
				<item col="1" row="3" highlight="false">
					<grid name="grdFakture" bestfitonrefresh="true" dataname="dtGrid" autopopulate="true" savelayout="true" multiselect="true">
						<fields inherited="true">

						</fields>
					</grid>
				</item>

			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="PRIHVATI" dock="right">
					<event type="click">
						<action type="datarun nonquery" value="global.~dtKopiraj"/>
						<action type="form close"/>				
					</event>
				</button>
				<button caption="ODUSTANI" dock="right" type="cancel">
					<event type="click">
						<!-- <action type="form close"></action>	 -->
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>