<root>
	<form name="frmRobaTrazilica" caption="Tražilica robe" width="1120" height="590" saveformsize="true">
		<event type="init">
			<action type="variable value">
				<parameter name="Close" value="null" type="int" />
			</action>
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="1" cols="1">
				<item col="1" row="1">
					<grid name="grdRoba" key="RobaId" savelayout="true" dataname="dtRoba" bestfitonrefresh="true" autopopulate="true">
						<event type="keydown" value="13">
							<action type="variable value" value="global.$NovaRobaId">
								<parameter value="#grdRoba.@RobaId" />
							</action>
							<!-- isprazni polje za pretragu -->
							<action type="control value" value="parent.#srcRobaNova" if="global.$Tip==Spajanje">
								<parameter value="" />
							</action>
							<action type="datarun reader" value="~dtGetRoba" if="global.$Tip!=Spajanje" />
							<action type="control value" value="parent.#srcRoba" if="global.$Tip!=Spajanje">
								<parameter value="~dtGetRoba.@RobaId" text="~dtGetRoba.@Roba" />
							</action>
							<action type="formclose" />
						</event>
						<event type="doubleclick">
							<action type="variable value" value="global.$NovaRobaId">
								<parameter value="#grdRoba.@RobaId" />
							</action>
							<!-- isprazni polje za pretragu -->
							<action type="control value" value="parent.#srcRobaNova" if="global.$Tip==Spajanje">
								<parameter value="" />
							</action>
							<action type="datarun reader" value="~dtGetRoba" if="global.$Tip!=Spajanje" />
							<action type="control value" value="parent.#srcRoba" if="global.$Tip!=Spajanje">
								<parameter value="~dtGetRoba.@RobaId" text="~dtGetRoba.@Roba" />
							</action>
							<action type="formclose" />
						</event>
						<fields>
							<field name="Roba" caption="Roba" />
							<field name="Sifra" caption="Šifra" />
							<field name="Klasifikacija" />
							<field name="sortkey" caption="SortKey" />
							<field name="JM" />
							<field name="Status" />
							<field name="Kod" />
							<field name="Oznaka" />
							<field name="Porez" />
							<field name="Cijena" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPotvrdi" caption="ODABERI ROBU" dock="left">
					<event type="click">
						<action type="variable value" value="global.$NovaRobaId">
							<parameter value="#grdRoba.@RobaId" />
						</action>
						<!-- isprazni polje za pretragu -->
						<action type="control value" value="parent.#srcRobaNova" if="global.$Tip==Spajanje">
							<parameter value="" />
						</action>
						<!-- dodavanje odabrane robe na formu za unos/izmjenu objekta -->
						<action type="datarun reader" value="~dtGetRoba" if="global.$Tip!=Spajanje" />
						<action type="control value" value="parent.#srcRoba" if="global.$Tip!=Spajanje">
							<parameter value="~dtGetRoba.@RobaId" text="~dtGetRoba.@Roba" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnDodaj" caption="DODAJ NOVU ROBU" dock="left" begingroup="true">
					<event type="click">
						<action type="form open" value="frmRobaDodaj">
							<!-- ako unosimo novi objekt prepisujemo uneseni naziv novog objekta na naziv nove robe -->
							<parameter name="Objekt" value="$Objekt" if="global.$Tip==Unos" />
						</action>
						<!-- $Close je 1 ako se dodala nova roba, 0 ako se išlo na odustani -->
						<!-- dodavanje nove robe na grid na formi za spajanje js objekata s robom -->
						<action type="variable value" value="global.$NovaRobaId" if="$Close==1&amp;&amp;global.$Tip==Spajanje">
							<parameter value="global.$NovaRobaId" />
						</action>
						<!-- isprazni polje za pretragu -->
						<action type="control value" value="parent.#srcRobaNova" if="global.$Tip==Spajanje">
							<parameter value="" />
						</action>
						<!-- dodavanje nove robe na formu za unos/izmjenu objekta -->
						<action type="datarun reader" value="~dtGetRoba" if="$Close==1&amp;&amp;global.$Tip!=Spajanje" />
						<action type="control value" value="parent.#srcRoba" if="$Close==1&amp;&amp;global.$Tip!=Spajanje">
							<parameter value="~dtGetRoba.@RobaId" text="~dtGetRoba.@Roba" />
						</action>
						<action type="form close" if="$Close==1" />
					</event>
					<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right">
						<event type="click">
						</event>
					</button>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJSObjektiQuery" name="dtRoba">
				<parameter name="@action" value="13" />
				<parameter name="@Naziv" value="$Naziv" />
			</data>
			<data command="spJSObjektiQuery" name="dtGetRoba">
				<parameter name="@action" value="7" />
				<parameter name="@RobaId" value="global.$NovaRobaId" />
			</data>
		</datalist>
	</form>
</root>
