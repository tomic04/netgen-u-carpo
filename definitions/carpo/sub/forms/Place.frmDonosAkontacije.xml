<root>
  <!--FORMA ZA DONOS ISPLAĆENE AKONTACIJE-->

  <form name="frmDonosAkontacije" caption ="$caption" width="550" height="130" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Želite dodati isplaćenu akontaciju za tekući mjesec?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="False">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="DA">
          <event type="click">
            <!-- Okini storu -->
            <action type="datarun nonquery" value="~dtPrijenos"  waittype="progress" waitcaption="Pričekajte..." waittext="..donos u tijeku u tijeku..."/>
            <action type="message" value="Prijenos napravljen"/>
            <action type="form close" />
            
          </event>
        </button>
        <button name="btnOdustani" caption="NE" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObracun_IsplacenaAkontacija" name="dtPrijenos">
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA DONOS ISPLAĆENE AKONTACIJE-->
</root>