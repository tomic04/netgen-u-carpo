<root>
	<form name="frmOsobaUpsert" caption="$Caption">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" if="$MarAktDetId!=null" />
		</event>
		<event type="shown">
			<action type="control disable" value="#srcPartner" if="#srcOsoba!=null" />
			<action type="control enable" value="#srcPartner" else="" />
		</event>
		<layout>
			<group rows="4" cols="2">
				<item col="1" row="1" caption="Osoba:" colspan="2">
					<searchedit name="srcOsoba" fieldtext="Osoba" fieldvalue="lnosoparid" dataname="~dtOsobe" datavalue="~dtGet.@LnOsoParId" datatext="~dtGet.@Osoba" required="true">
						<event type="valuechanged">
							<action type="datarun reader" value="dtGetPartner">
								<action type="control value" value="#srcPartner">
									<parameter text="~dtGetPartner.@Partner" value="~dtGetPartner.@PartneriId" />
								</action>
							</action>
							<action type="control disable" value="#srcPartner" if="#srcOsoba!=null" />
							<action type="control enable" value="#srcPartner" else="" />
						</event>
					</searchedit>
				</item>
				<item col="1" row="2" caption="Partner:" colspan="2">
					<searchedit name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" dataname="dtSearchPartner" function="srcPartner" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@Partner">
						<event type="keydown">
							<action type="control refreshvalue" value="#srcOsoba" />
						</event>
					</searchedit>
				</item>
				<item col="1" row="3" caption="Datum:">
					<dateedit name="datDatum" value="now" datavalue="~dtGet.@Datum">
					</dateedit>
				</item>
				<item col="2" row="3" caption="Ocjena:">
					<textedit name="txtOcjena" datavalue="~dtGet.@OCjena">
					</textedit>
				</item>
				<item col="1" row="4" caption="Napomena:" colspan="2">
					<textedit name="txtNapomena" maxlength="50" datavalue="~dtGet.@Napomena">
					</textedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate" />
						<action if="$MarAktDetId!=null">
							<action type="datarun nonquery" value="~dtIzmjena" />
							<action type="control populate keepfocus" value="parent.#grdStavke" />
						</action>
						<action else="">
							<action type="datarun scalar" value="~dtUnos">
								<parameter name="NoviMarAktDetId" />
							</action>
							<action type="control populate" value="parent.#grdStavke" />
							<action type="control focus" value="parent.#grdStavke">
								<parameter value="$NoviMarAktDetId" type="int" />
							</action>
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziPartneri" name="dtSearchPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtGet">
				<parameter name="@action" value="3" />
				<parameter name="@Id" value="$MarAktDetId" />
			</data>
			<!--
			<data command="select 0 as StatusId, 'Uvršten, nije poslan materijal' as Status
			union all select 1 as StatusId, 'Poslan najmanje jednim kanalom' as Status
			union all select 2 as StatusId, 'Sudjelovao' as Status
			union all select 3 as StatusId, 'Odbio sudjelovati' as Status
			" type="text" name="dtStatus">
			</data>
			-->
			<data command="spMarAktivnostiCombo" name="dtOsobe">
				<parameter name="@Action" value="Osobe" />
				<parameter name="@Uvjet" value="#srcOsoba.text" />
				<parameter name="@PartneriId" value="#srcPartner" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtGetPartner">
				<parameter name="@action" value="1" />
				<parameter name="@Id" value="#srcOsoba" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtUnos">
				<parameter name="@action" value="4" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@LnOsoParId" value="#srcOsoba" />
				<parameter name="@OsobeId" value="" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Ocjena" value="#txtOcjena" />
				<parameter name="@Status" value="#cmbStatus" />
				<parameter name="@Napomena" value="#txtNapomena" />
				<parameter name="@IDovi" value="" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtIzmjena">
				<parameter name="@action" value="3" />
				<parameter name="@Id" value="$MarAktDetId" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@LnOsoParId" value="#srcOsoba" />
				<parameter name="@OsobeId" value="" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Ocjena" value="#txtOcjena" />
				<parameter name="@Status" value="#cmbStatus" />
				<parameter name="@Napomena" value="#txtNapomena" />
				<parameter name="@IDovi" value="" />
			</data>
		</datalist>
	</form>
</root>
