<!-- radio na Jupiter2019 Spin2 -->
<root>
	<form name="frmNijeUCjeniku" caption="Roba koja se ne nalazi u odabranom cjeniku" width="700" height="400">
		<event type="load">
			<action type="datarun reader" value="dtNijeUCjeniku"/>
			<action type="control populate" value="#grdNijeUCjeniku"/>
		</event>
		<layout>
			<group cols="1" rows="1">
				<item row="3" col="1" colspan="2">
					<grid name="grdNijeUCjeniku" dataname="~dtNijeUCjeniku" bestfitonrefresh="true" multiselect="true">
						<fields>
							<field name="Sifra" caption="Šifra"/>
							<field name="Roba" caption="Roba"/>
							<field name="JM" caption="JM"/>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi cijenu">
					<event type="click">
						<action type="form open" value="frmUnesi">
							<parameter name="RobaId" value="#grdNijeUCjeniku.@RobaId" />
							<parameter name="RobaNaziv" value="#grdNijeUCjeniku.@Roba" />
							<parameter name="TipForme" value="0" />
						</action>
						<action type="form close"/>
						<action type="control populate keepfocus" value="#grdGlava" />
					</event>
				</button>
				<button name="btnZatvori" caption="Zatvori">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Cjenik_NijeUCjeniku" name="dtNijeUCjeniku">
				<parameter name="@KlMasterRobaId" value="parent.#tree.@value" />
				<parameter name="@VrCjenikId" value="global.$VrCjenikId" />
				<parameter name="@Ind" value="global.$vrstaCijene" />
			</data>
		</datalist>
	</form>
</root>