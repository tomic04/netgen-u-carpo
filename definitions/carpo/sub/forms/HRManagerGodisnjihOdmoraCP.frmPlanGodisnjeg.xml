<root version="1.0">
  <!--
  *******************************************************************************************
  FORMA ZA PRIKAZ UNESENIH PLANOVA GODIŠNJEG ODMORA
  *******************************************************************************************
  -->
  <form name="frmPlanGodisnjeg" caption="$caption" width="600" height="400" >
	  <event type="shown">
			<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
				  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
			<action type="variable value" value="global.$RefreshajMaster">
				<parameter value="0" type="int"/>
			</action>
		</event>
    <layout>
	<group  rows="1" cols="1">
	<item row="1" col="1">
		<grid  name="grdMasterPlan" key="HRGodisnjiPlanId" type="master" async="true" dataname="~dtMaster" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" savelayout="true" netgenfields="true"  showgrouppanel="false" autopopulate="true">
			<fields inherited="true">				
				<field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
			</fields>
		</grid>
	</item>
      <!--kraj omotača-->
	</group>
    </layout>

    <panelbuttons>
      <buttons>
		<button name="btnUnos" caption="Unos">
			<event type="click">
				<action type="form open" value="frmUnosPlanaGodisnjeg">
					<parameter name="caption" value="Unos plana"/>
					<parameter name="HRGodisnjiPlanId" value="0"/>
					<parameter name="HRGodisnjiId" value="$HRGodisnjiId"/>
				</action>
				<action type="control populate keepfocus" value="#grdMasterPlan"/>
			</event>
		</button>
		<button name="btnIzmjena" caption="Izmjena">
			<event type="click">
				<action type="form open" value="frmIzmjenaPlana">
					<parameter name="caption" value="Izmjena plana"/>
					<parameter name="HRGodisnjiPlanId" value="#grdMasterPlan.@HRGodisnjiPlanId"/>
					<parameter name="HRGodisnjiId" value="$HRGodisnjiId"/>
				</action>
				<action type="control populate keepfocus" value="#grdMasterPlan"/>
			</event>
		</button>
		<button name="btnBrisanje" caption="Brisanje">
			<event type="click">
				<action type="form open" value="frmBrisanjePlana">
					<parameter name="caption" value="Brisanje plana"/>
					<parameter name="HRGodisnjiPlanId" value="#grdMasterPlan.@HRGodisnjiPlanId"/>
					<parameter name="HRGodisnjiId" value="$HRGodisnjiId"/>
				</action>
				<action type="control populate keepfocus" value="#grdMasterPlan"/>
			</event>
		</button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
    <data command="spHRGodisnjiAllCP" name="dtMaster">
	<parameter name="@Action" value="dtGetPrometPlan"></parameter>
	<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"></parameter>		
    <parameter name="@indGreske.output.int"></parameter>
	<parameter name="@poruka.output.string"></parameter>
    </data>	
    </datalist>
  </form>

<!--
  *******************************************************************************************
  FORMA ZA UNOS PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
 -->
	<form name="frmUnosPlanaGodisnjeg" caption="$caption" width="350" height="350" >
		
		<event type="shown">
			<action type="control value" value="#dateDatumDo">
				<parameter value="now" />
			</action>
		</event>
		
		<layout>
			<group cols="1" rows="5" groupbordervisible="false" >
				<item col="1" row="1" caption="Datum početka" textposition="top" highlight="false" required="true">
					<dateedit name="dateDatumOd" value="now" required="true"/>
				</item>
				<item caption="Broj dana" col="1" row="2" textposition="top" highlight="false" >
					<textedit name="txtDani" tooltip="Broj dana" maxlength="2" nullvalue="0" required="true">
						<event type="leave">
							<action type="datarun reader" value="~dtGetZavPov" />
							<action type="control value" value="#dateDatumDo">
								<parameter value="~dtGetZavPov.@datzad"></parameter>
							</action>
						</event>
					</textedit>
				</item>
				<item col="1" row="3" caption="Datum završetka" textposition="top" highlight="false" >
					<dateedit name="dateDatumDo" datavalue="~dtGetZavPov.@datzad" required="true"/>
				</item>
				<item col="1" row="4" caption="Napomena" highlight="false" >
					<memoedit name="memNapomena" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun reader" value="~dtUnos">
							<parameter value="~dtUnos.@HRGodisnjiId"/>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!" />
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
								ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
						<action type="control populate" value="parent.#grdMasterPlan" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRGodisnjiAllCP" name="dtGetZavPov">
				<parameter name="@action" value="DatumZav_DatumPov"></parameter>
				<parameter name="@datumod" value="#dateDatumOd"></parameter>
				<parameter name="@brd" value="#txtDani"></parameter>
			</data>
			<data command="spHRGodisnjiAllCP" name="dtUnos">
				<parameter name="@action" value="UnosPlanaGodisnjeg"></parameter>
				<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"></parameter>
				<parameter name="@DatumOd" value="#dateDatumOd"></parameter>
				<parameter name="@datezad" value="#dateDatumDo"></parameter>
				<parameter name="@brojdana" value="#txtDani"></parameter>
				<parameter name="@Napomena" value="#memNapomena"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>
		</datalist>
	</form>
	<!--
  *******************************************************************************************
  FORMA ZA IZMJENU PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
 -->
	<form name="frmIzmjenaPlana" caption="$caption" width="350" height="350" >

		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>

		<layout>
			<group cols="1" rows="5" groupbordervisible="false" >
				<item col="1" row="1" caption="Datum početka" textposition="top" highlight="false">
					<dateedit name="dateDatumOd" datavalue="~dtGet.@DatumOd" />
				</item>
				<item caption="Broj dana" col="1" row="2" textposition="top" highlight="false" >
					<textedit name="txtDani" tooltip="Broj dana" maxlength="2" datavalue="~dtGet.@BrojDana">
						<event type="leave">
							<action type="datarun reader" value="~dtGetZavPov" />
							<action type="control value" value="#dateDatumDo">
								<parameter value="~dtGetZavPov.@datzad"></parameter>
							</action>
						</event>
					</textedit>
				</item>
				<item col="1" row="3" caption="Datum završetka" textposition="top" highlight="false">
					<dateedit name="dateDatumDo" datavalue="~dtGet.@datzad"/>
				</item>
				<item col="1" row="4" caption="Napomena" highlight="false" >
					<memoedit name="memNapomena" datavalue="~dtGet.@Napomena"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun reader" value="~dtIzmjena">
							<parameter value="~dtUnos.@HRGodisnjiId"/>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!" />
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
								ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
						<action type="control populate" value="parent.#grdMasterPlan" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRGodisnjiAllCP" name="dtGetZavPov">
				<parameter name="@action" value="DatumZav_DatumPov"></parameter>
				<parameter name="@datumod" value="#dateDatumOd"></parameter>
				<parameter name="@brd" value="#txtDani"></parameter>
			</data>

			<data command="spHRGodisnjiAllCP" name="dtGet">
				<parameter name="@action" value="dtGetPlanIzmjena"></parameter>
				<parameter name="@HRGodisnjiPlanId" value="$HRGodisnjiPlanId"></parameter>
				<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>
			
			<data command="spHRGodisnjiAllCP" name="dtIzmjena">
				<parameter name="@action" value="IzmjenaPlanaGO"></parameter>
				<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"></parameter>
				<parameter name="@HRGodisnjiPlanId" value="$HRGodisnjiPlanId"></parameter>
				<parameter name="@DatumOd" value="#dateDatumOd"></parameter>
				<parameter name="@datezad" value="#dateDatumDo"></parameter>
				<parameter name="@brojdana" value="#txtDani"></parameter>
				<parameter name="@Napomena" value="#memNapomena"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>
		</datalist>
	</form>

	<!--
  *******************************************************************************************
  FORMA ZA BRISANJE PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
 -->
	<form name="frmBrisanjePlana" caption ="Brisanje plana godišnjeg odmora" width="500" height="150" fixedsize="true" saveformsize="false" >
		<event type="shown">
			<action type ="control value" value="#lblPitanje">
				<parameter value="Jeste li sigurni da želite obrisati plan GO?"/>
			</action>
		</event>
		<layout>

			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="true" >
				<item col="1" row="1"  highlight="false">
					<labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
				</item>

			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnBrisi" caption="OBRIŠI" type="del">
					<event type="click">
						<!-- Okini storu -->

						<action type="datarun reader" value="~dtBrisanje"/>

						<action if="$indGreske==0">
							<action type="control populate keepfocus" value="parent.#grdMasterPlan"/>
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
								ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spHRGodisnjiAllCP" name="dtBrisanje">
				<parameter name="@Action" value="BrisanjePlanGO" type="string"/>
				<parameter name="@HRGodisnjiPlanId" value="$HRGodisnjiPlanId"></parameter>
				<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"/>
				<!--<parameter name="@selectedids" value="$selectedids"/>-->
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>
	<!--
  *******************************************************************************************
  FORMA ZA ISPIS LISTE PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
 -->
	<form name="frmListaPlanGO" caption="$caption" width="350" height="350" >
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<event type="shown">
			<action type="control value" value="#txtGodina">
				<parameter value="$godina" />
			</action>
		</event>

		<layout>
			<group cols="1" rows="5" groupbordervisible="false" >
				<item col="1" row="1" caption="Godina" textposition="top" highlight="false">
					<textedit name="txtGodina"></textedit>
				</item>
				<item caption="Org. jedinica" col="1" row="2" textposition="top" highlight="false" >
					<searchedit name="srcOrgJedinica" dataname="~dtOrgJedinica" fieldvalue="orgshemaid" fieldtext="Naziv"></searchedit>
				</item>
				<item col="1" row="3" caption="Datum od" textposition="top" highlight="false">
					<dateedit name="dateDatumOd" datavalue="~dtGet.@DatumPrvi"/>
				</item>
				<item col="1" row="4" caption="Datum do" highlight="false" >
					<dateedit name="dateDatumDo" datavalue="~dtGet.@datumZadnji"/>
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnIspis" caption="Ispis">
					<event type="click">
							<action type="print" value="repx:rptHRGodisnjiListaPlaniranihGO_Mont">
								<parameter name="orgshemaid" value="#srcOrgJedinica"></parameter>
								<parameter name="godina" value="#txtGodina"></parameter>
								<parameter name="datumod" value="#dateDatumOd"></parameter>
								<parameter name="datumdo" value="#dateDatumDo"></parameter>
							</action>
						<action if="$indGreske==0">
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
								ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRGodisnjiAnalitikaCP" name="dtGet">
				<parameter name="@action" value="dtGetDatumPrviZadnji"/>
				<parameter name="@godina" value="$Godina"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spHRGodisnjiAnalitikaCP" name="dtOrgJedinica">
				<parameter name="@action" value="srcOrgJedinica" />
				<parameter name="@tekst" value="#srcOrgJedinica.text" />
			</data>
		</datalist>
	</form>
</root>