<?xml version="1.0" encoding="utf-8"?>
<root>
  <form name="frmPartner" caption="Partner :: {$Naslov}" width="575" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtPartner" if="$PartneriId!=null" />
    </event>
    <event type="load">
      <action type="control value" value="chkDodatni" if="$PartneriId!=null&amp;&amp;~dtPartner.@Naziv2!=">
        <parameter value="true"/>
      </action>
    </event>
    <layout textposition="left">
      <group cols="2" rows="8" groupbordervisible="false" >
        <item caption="Naziv:" col="1" row="1" colspan="2" fontbold="true" highlight="false" spacing="5,3,3,3">
          <textedit name="txtNaziv" datavalue="~dtPartner.@Naziv" required="true" fontbold="true"/>
        </item>
        <group cols="2" rows="1" col="1" row="2" colspan="2" groupbordervisible="false">
          <item caption="Dodatni naziv:" col="1" row="1" highlight="false" spacing="5,3,3,3">
            <textedit name="txtDodatni" datavalue="~dtPartner.@Naziv2" enabled="false"/>
          </item>
          <item col="2" row="1" highlight="false">
            <checkedit name="chkDodatni" caption=" ">
              <event type="valuechanged">
                <action type="control enable" value="#txtDodatni" if="#chkDodatni==true"/>
                <action type="control disable" value="#txtDodatni" else=""/>
              </event>
            </checkedit>
          </item>
          <columnsdefinition>
            <column position="1" size="auto"/>
            <column position="2" size="27"/>
          </columnsdefinition>
        </group>
        <item caption="Šifra:" row="3" col="1" highlight="false" spacing="5,3,3,3">
          <textedit name="txtSifra" datavalue="~dtPartner.@Sifra" >
          </textedit>
        </item>
        <item caption="Djelatnost:" row="3" col="2" highlight="false">
          <combotreeedit name="cteDjelatnost" valuefield="Id" displayfield="Naziv" parentfieldname="ParentId" datavalue="~dtPartner.@DjelatnostiId" dataname="dtDjelatnostiGet" />
        </item>

        <item caption="Matični broj:" row="4" col="1" highlight="false" spacing="5,3,3,3">
          <textedit name="txtMaticni" datavalue="~dtPartner.@MatBroj" >
          </textedit>
        </item>
        <item caption="OIB:" row="4" col="2" highlight="false">
          <textedit name="txtOIB" datavalue="~dtPartner.@PorezniBroj" required="true">
          </textedit>
        </item>
        <item caption="Trošarinski broj:" row="5" col="1" highlight="false" spacing="5,3,3,3">
          <textedit name="txtTrosarinski" datavalue="~dtPartner.@TrosarinskiBroj" >
          </textedit>
        </item>
        <item caption="IBK broj:" row="5" col="2" highlight="false" >
          <textedit name="txtIBK" datavalue="~dtPartner.@IBK" maxlength="13">
          </textedit>
        </item>
        <item caption="MIBPG broj:" row="6" col="1" highlight="false" spacing="5,3,3,3" >
          <textedit name="txtMIBPGbroj" datavalue="~dtPartner.@MIPIGBroj" maxlength="7">
          </textedit>
        </item>
        <item caption="MIBPG status:" row="6" col="2" highlight="false" >
          <comboedit name="cmbMIBPGstatus" valuefield="Value" displayfield="Naziv" datavalue="~dtPartner.MIPIGStatus" dataname="dtMIPIGget"/>
        </item>
        <group  cols="3" rows="3" col="1" row="7" colspan="2" spacing="3,3,12,3" alignmode="local">
          <item caption="Adresa:" col="1" row="1" colspan="2" textposition="left" highlight="false">
            <textedit name="txtAdresa" datavalue="~dtPartner.@Adresa" />
          </item>
          <item caption="Mjesto:" col="3" row="1" textposition="left" highlight="false">
            <comboedit name="cmbMjesto" valuefield="MjestaId" displayfield="Naziv" datavalue="~dtPartner.@MjestaId" dataname="dtMjesta" required="true"/>
          </item>
          <item caption="Telefon1:" col="1" row="2" textposition="left" highlight="false">
            <textedit name="txtTelefonP" datavalue="~dtPartner.@Telefon1"/>
          </item>
          <item caption="Telefon2:" col="2" row="2" textposition="left" highlight="false">
            <textedit name="txtTel" datavalue="~dtPartner.@Telefon2"/>
          </item>
          <item caption="Fax:" col="3" row="2" textposition="left" highlight="false">
            <textedit name="txtFax" datavalue="~dtPartner.@Fax"/>
          </item>
          <item caption="Email:" col="1" row="3" textposition="left" highlight="false">
            <textedit name="txtEmail" datavalue="~dtPartner.@Email"/>
          </item>
          <item caption="WWW:" col="2" row="3" textposition="left" highlight="false">
            <textedit name="txtWWW" datavalue="~dtPartner.@WWW" />
          </item>
          <item col="3" row="3"/>
        </group>
        <group cols="1" rows="1" caption="Memo:" col="1" row="8" colspan="2" spacing="3,3,3,3">
          <item col="1" row="1"  textposition="top" highlight="false" >
            <memoedit name="txtMemo" datavalue="~dtPartner.@Memo" />
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button caption="SPREMI" type="add" dock="right">
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$PartneriId!=null"/>
            <action type="datarun nonquery" value="~dtAdd" else=""/>
            <action type="datarun nonquery" value="~dtMemo"/>
            <action type="form close" />
          </event>
        </button>
        <button caption="ODUSTANI" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spPartneriQuery_Carpo" name="dtPartner">
        <parameter name="@Action" value="1"/>
        <parameter name="@ID" value="$PartneriId"/>
        <parameter name="@IDPartneri" value="0"/>
        <parameter name="@DownUnder" value="0"/>
        <parameter name="@SortKey" value=""/>
        <parameter name="@Naziv" value=""/>
        <parameter name="@Sifra" value=""/>
      </data>
      <data command="spDjelatnostiGet_Carpo" name="dtDjelatnostiGet"/>
      <data command="spMjestaQuery_Carpo" name="dtMjesta">
        <parameter name="@Action" value="0"/>
        <parameter name="@ID" value="0"/>
        <parameter name="@Naziv" value=""/>
        <parameter name="@HPTBroj" value=""/>
      </data>
      <data command="SELECT 'Član' as Naziv, 'Č' as Value UNION ALL SELECT 'Nositelj' as Naziv, 'N' as Value" type="text" name="dtMIPIGget"/>
      <data command="spPartneriAzur_Carpo" name="dtAdd">
        <!--<parameter name="@Source" value="Carpo"/>-->
        <parameter name="@Action" value="0"/>
        <parameter name="@Id" value="0"/>
        <parameter name="@Id" value="0"/>
        <parameter name="@Sifra" value="#txtSifra"/>
        <parameter name="@DjelatnostiId" value="#cteDjelatnost"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Naziv2" value="#txtDodatni"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@MatBroj" value="#txtMaticni"/>
        <parameter name="@PorezniBroj" value="#txtOIB"/>
        <parameter name="@TrosarinskiBroj" value="#txtTrosarinski"/>
        <parameter name="@IBK" value="#txtIBK"/>
        <parameter name="@MIPIGBroj" value="#txtMIBPGbroj"/>
        <parameter name="@MIPIGStatus" value="#cmbMIBPGstatus"/>
        <parameter name="@Telefon1" value="#txtTelefonP"/>
        <parameter name="@Telefon2" value="#txtTel"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@Email" value="#txtEmail"/>
        <parameter name="@Www" value="#txtWWW"/>
      </data>
      <data command="spPartneriAzur_Carpo" name="dtEdit">
        <!--<parameter name="@Source" value="Carpo"/>-->
        <parameter name="@Action" value="1"/>
        <parameter name="@Id" value="0"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@Sifra" value="#txtSifra"/>
        <parameter name="@DjelatnostiId" value="#cteDjelatnost"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Naziv2" value="#txtDodatni"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@MatBroj" value="#txtMaticni"/>
        <parameter name="@PorezniBroj" value="#txtOIB"/>
        <parameter name="@TrosarinskiBroj" value="#txtTrosarinski"/>
        <parameter name="@IBK" value="#txtIBK"/>
        <parameter name="@MIPIGBroj" value="#txtMIBPGbroj"/>
        <parameter name="@MIPIGStatus" value="#cmbMIBPGstatus"/>
        <parameter name="@Telefon1" value="#txtTelefonP"/>
        <parameter name="@Telefon2" value="#txtTel"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@Email" value="#txtEmail"/>
        <parameter name="@Www" value="#txtWWW"/>
      </data>
      <data command="spPartneriAzur_Carpo" name="dtMemo">
        <parameter name="@Action" value="20"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@Memo" value="#txtMemo"/>
      </data>
    </datalist>
  </form>
</root>
