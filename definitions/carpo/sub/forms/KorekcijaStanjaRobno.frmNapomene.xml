<root>
	<form name="frmNapomene" caption="Napomene za korekciju vrijednosti br. '{$BrojKorekcije}'" width="500" height="200">
		<event type="shown">
			<action type="datarun reader" value="~dtMemo"/>
			<action type="control value" value="#txtMemo">
				<parameter value="~dtMemo.@Memo"/>
			</action>			
		</event>
		<layout>
			<group cols="3" rows="3" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="50%"/>
					<column position="2" size="25%"/>
					<column position="3" size="25%"/>
				</columnsdefinition>		
				<item col="1" row="1">
					<comboedit name="cmbPoruka" dataname="~dtPoruka" valuefield="PorukeId" displayfield="Poruka"/>
				</item>
				<item col="2" row="1">
					<button name="btnZamjeni" caption="Zamjeni" >
						<event type="click">
							<action type="variable value">
								<parameter name="Indikator" value="1"/>
							</action>
							<action type="datarun reader" value="~dtDodaj"/>
							<action type="control value" value="#txtMemo">
								<parameter value="~dtDodaj.@tekst"/>
							</action>
						</event>
					</button>
				</item>
				<item col="3" row="1">
					<button name="btnDodaj" caption="Dodaj" >
						<event type="click">
							<action type="variable value">
								<parameter name="Indikator" value="0"/>
							</action>
							<action type="datarun reader" value="~dtDodaj"/>
							<action type="control value" value="#txtMemo">
								<parameter value="~dtDodaj.@tekst"/>
							</action>
						</event>
					</button>
				</item>
				<item col="1" row="2" rowspan="2" colspan="3">
					<memoedit name="txtMemo"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOk" caption="U redu">
					<event type="click">
						<action type="variable value">
							<parameter name="Memo" value="#txtMemo"/>
						</action>
						<!-- <action type="datarun nonquery" value="~dtSpremi"/> -->
						<action type="form close"/>
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel"/>
				<button name="btnUputiMe" caption="Uputi me">
					<event type="click">
						<action type="message" value="Ova funkcionalnost trenutno nije dostupna, molimo kontaktirajte Spin!"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPoruka" command="spCPorukeQuery">
				<parameter name="@VrstaDokid" value="$VrstaDokId"/>
			</data>
			<data command="select @par1 + char(13) + char(10) + @par2 as tekst" type="text" name="dtDodaj" if="$Indikator==0"> 
				<parameter name="@par1" value="#txtMemo"/>
				<parameter name="@par2" value="#cmbPoruka.@Poruka"/>
			</data>
			<data command="select @par2 as tekst" type="text" name="dtDodaj" if="$Indikator==1">
				<parameter name="@par2" value="#cmbPoruka.@Poruka"/>
			</data>
			<!-- <data name="dtSpremi" command="spCRobnoPrometKorekcija_NapomenaAzur"> -->
				<!-- <parameter name="@SktPrometGlaId" value="parent.$SktPrometGlaId"/> -->
				<!-- <parameter name="@Memo" value="#txtMemo"/> -->
			<!-- </data> -->
			<data name="dtMemo" command="spCRobnoPrometKorekcija_NapomenaQuery">
				<parameter name="@SktPrometGlaId" value="parent.$SktPrometGlaId"/>
			</data>
		</datalist>
	</form>
</root>


	