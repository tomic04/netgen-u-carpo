<root>
	<form name="frmSlUnos">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="shown">
			<action type="form caption" value="Unos stavki za obračun kamata" if="$kntKteDetaljId==null"/>
			<action type="form caption" value="Izmjena stavaka za obračun kamata" else=""/>
			<action type="control value" value="#txtBrFak">
				<parameter value="~dtGet.@BrojFak"/>
			</action>
			<action type="control value" value="#txtOpis">
				<parameter value="~dtGet.@Opis"/>
			</action>
			<action type="control value" value="#datDatum" if="$kntKteDetaljId==null">
				<parameter value="now"/>
			</action>
			<action type="control value" value="#datDatum" else="">
				<parameter value="~dtGet.@Datum"/>
			</action>
			<action type="control value" value="#txtDuguje"  if="$kntKteDetaljId!=null">
				<parameter value="~dtGet.@Duguje"/>
			</action>
			<action type="control value" value="#txtPotrazuje" if="$kntKteDetaljId!=null">
				<parameter value="~dtGet.@Potrazuje"/>
			</action>
			<action type="control value" value="#cmbValuta" if="$kntKteDetaljId!=null">
				<parameter value="~dtGet.@ValuteId"/>
			</action>			
		</event>
		<layout>
			<group cols="1" rows="7">
				<item col="1" row="2" caption="Broj fakture:">
					<textedit name="txtBrFak" />
				</item>
				<item col="1" row="3" caption="Opis:">
					<textedit name="txtOpis"/>
				</item>
				<item col="1" row="4" caption="Datum:">
					<dateedit name="datDatum"/>
				</item>
				<item col="1" row="5" caption="Valuta:">
					<comboedit name="cmbValuta" dataname="~dtValuta" valuefield="ValuteId" displayfield="Naziv"/>
				</item>				
				<item col="1" row="6" caption="Duguje:">
					<textedit name="txtDuguje" value="0" format="n2"/>
				</item>
				<item col="1" row="7" caption="Potražuje:">
					<textedit name="txtPotrazuje" value="0" format="n2"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="UNOS">
					<event type="click">
						<action type="datarun nonquery" value="~dtUnosStavke">
							<parameter name="@ID"/>
						</action>
						<action type="control value" value="#txtBrFak,#txtOpis,#cmbValuta" if="$kntKteDetaljId==null">
							<parameter value="null"/>
						</action>
						<action type="control value" value="#txtDuguje,#txtPotrazuje" if="$kntKteDetaljId==null">
							<parameter value="0"/>
						</action>
						<action type="control populate" value="parent.#grdStavkeDetalj"/>
						<action type="control focus" value="#txtBrFak"  if="$kntKteDetaljId==null"/>
						<action type="form close"  if="$kntKteDetaljId!=null"/>
						
					</event>
				</button>
				<button name="btnCancel" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGet" command="spCKteDetaljQuery">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$kntKteDetaljId"/>
			</data>
			<data name="dtUnosStavke" command="spCKteDetaljAzur" if="$kntKteDetaljId==null">
				<parameter name="@Action" value="0"/>
				<parameter name="@kntKteGlavaId" value="$kntKteGlavaId"/>
				<parameter name="@BrojFak" value="#txtBrFak"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@Datum" value="#datDatum"/>
				<parameter name="@Duguje" value="#txtDuguje"/>
				<parameter name="@Potrazuje" value="#txtPotrazuje"/>
				<parameter name="@ValuteId" value="#cmbValuta"/>
			</data>
			<data name="dtUnosStavke" command="spCKteDetaljAzur" if="$kntKteDetaljId!=null">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$kntKteDetaljId"/>
				<parameter name="@kntKteGlavaId" value="$kntKteGlavaId"/>
				<parameter name="@BrojFak" value="#txtBrFak"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@Datum" value="#datDatum"/>
				<parameter name="@Duguje" value="#txtDuguje"/>
				<parameter name="@Potrazuje" value="#txtPotrazuje"/>
				<parameter name="@ValuteId" value="#cmbValuta"/>
			</data>
			<data name="dtValuta" command="spCKntKtePopuniKontrole">
				<parameter name="@Action" value="valuta"/>
			</data>			
		</datalist>
	</form>
</root>