<root>
	<form name="frmAddComponentPartner" caption="Puštanje kod partnera">
        <event type="load">
            <action type="control value" value="#cmbCustomer">
                <parameter value="parent.#trTree.@id"/>
            </action>
            <action type="datarun reader" value="~dtNapuniLogin" />
            <action type="control value" value="#txtLogin">
                <parameter value="~dtNapuniLogin.@Login"/>
            </action>
            <action type="datarun reader" value="~dtNapuniDatum" />
            <action type="control value" value="#datInstallDate">
                <parameter value="~dtNapuniDatum.@Date"/>
            </action>          
        </event>
        <layout>
            <group cols="1" rows="6">
                <item row="1" col="1" caption="Partner">
                    <comboedit name="cmbCustomer" dataname="~dtNapuniComboPartneri" valuefield="id" displayfield="Naziv"/>
                </item>
                <item row="2" col="1" caption="Komponenta">
                    <comboedit name="cmbKomponenta" dataname="~dtNapuniComboKomponente" valuefield="id" displayfield="Naziv">
                        <event type="valuechanged">
                            <action type="control populate" value="#cmbVerzija"/>
                        </event>
                    </comboedit>
                </item>
                <item row="3" col="1" caption="Version">
                    <comboedit name="cmbVerzija" dataname="~dtNapuniComboVerzije" valuefield="id" displayfield="VersionNo"/>
                </item>
                <item row="4" col="1" caption="Login">
                    <textedit name="txtLogin" enabled="false"/>
                </item>
                <item row="5" col="1" caption="Datum instalacije">
                    <dateedit name="datInstallDate" />
                </item>
                <item row="6" col="1" caption="Memo">
                    <memoedit name="memoMemo"  />
                </item>
           </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnOdustani" caption="Odustani" dock="right" tabstop="false">
                    <event type="click">
                        <action type="formclose"/>
                    </event>
                </button>

                <button name="btnPotvrdi" caption="POTVRDI" dock="right" color="dark">
                        <event type="click">
                            <action type="datarun nonquery" value="~dtAddComponentPartneri" />
                            <action type="control populate" value="parent.#grdGlava" />
                            <action type="control enable" value="parent.#btnObrisi"/>
                            <action type="control enable" value="parent.#btnDownload"/>
                            <action type="formclose"/>
                        </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtNapuniComboPartneri">
                <parameter name="@Action" value="getPartneri" />
            </data>
            <data command="spComponentTracker" name="dtNapuniLogin">
                <parameter name="@Action" value="getLogin" />
            </data>
            <data command="spComponentTracker" name="dtNapuniComboKomponente">
                <parameter name="@Action" value="getComponents" />
            </data>
            <data command="spComponentTracker" name="dtNapuniComboVerzije">
                <parameter name="@Action" value="getVersions" />
                <parameter name="@ComponentId" value="#cmbKomponenta" />
            </data>
            <data command="spComponentTrackerAzur" name="dtAddComponentPartneri">
                <parameter name="@Action" value="addComponentPartneri" />
                <parameter name="@InstallDate" value="#datInstallDate" />
                <parameter name="@OperateriId" value="#cmbOperater" />
                <parameter name="@CustomerId" value="#cmbCustomer" />
                <parameter name="@VersionId" value="#cmbVerzija" />
                <parameter name="@Memo" value="#memoMemo" />
            </data>
            <data command="select getdate() as Date" name="dtNapuniDatum" type="text" />
        </datalist>
    </form>
</root>