<root>
	<form name="frmSirovine" caption="Sirovine" width="770" height="450">
		<!-- 		<event type="init">
			<action type="variable value" >
				<action type="datarun scalar" value="Global.~dtPogon">
					<parameter name="OrgShemaIDPogon" value="$VrstaDokId" />
				</action>	
			</action>				
		</event> -->
		<event type="init">
			<action type="variable value" >
				<parameter name="tmpId" value="1" type="int" />
			</action>		
			<action type="datarun nonquery" value="~dtMakeSirovine" />
		</event>	
		<event type="load">
			<action type="control populate" value="#grdSirovine" />
			<action type="control disable" value="#btnDown,#btnUp"/>
		</event>
		<event type="shown">
			<action type="datarun scalar" value="~dtNivoMax">
				<parameter name="NivoMax" value="$NivoMax" />
			</action>		
			<action type="control disable" value="#btnUp" if="#lblNivo==$NivoMax" />
			<action type="control enable" value="#btnUp" else=""/>			
		</event>		
		<layout textposition="left">
			<group cols="2" rows="2">
				<!-- 				<item col="1" row="1" caption="Nivo" >
					<labeledit name="lblNivo" value="1" />
				</item> -->
				<item col="1" row="2" colspan="2">
					<grid name="grdSirovine" dataname="dtGetSirovine" showgrouppanel="true" multiselect="true" savelayout="true">
						<fields>
							<!--<field name="nadklasa" caption="Nadklasa" />-->
							<field name="klasifikacija" caption="Klasifikacija" />
							<!-- <field name="userid" caption="Šifra" /> -->
							<field name="robakod" caption="Kod" />
							<!--<field name="KratkiNaziv" caption="Kratki naziv" />-->
							<field name="naziv" caption="Naziv" fontbold="true"/>
							<field name="jm" caption="JM" />
							<field name="kolicina" caption="Količina" />
							<field name="kolicinaskl" caption="Na skladištima" />
							<field name="razlika" caption="Razlika"/>
							<field name="klasasirovine" caption="Klasa sirovine" />
							<field name="kolicinasklsast" caption="Na skladištu sirovine" />
							<field name="sklsast" caption="Skladište sirovine" />
							<field name="raspolozivo" caption="Raspoloživo" />
							<field name="naruceno" caption="Naručeno" />
							<field name="rezervirano" caption="Rezervirano" />
							<field name="KolicinaMin" caption="Min. zalihe" />
						</fields>
						<styles>
 							<style name="fontcolor" value="green" if="#grdSirovine.@proizvodiid&gt;0"/>
							<style name="backgroundcolor" value="#FF9393" if="#grdSirovine.fieldname==kolicina&amp;&amp;#grdSirovine.@razlika&lt;0"/>
						</styles>						
					</grid>
				</item>
			</group>
		</layout>
		<actionpanel>
			<items>
				<item>
					<button caption="Gotovo" type="Cancel" >
					</button>
				</item>
				<item>
					<button caption="Listaj" type="" >
						<event type="click">
						<action type="control printcontrol" value="#grdSirovine">
						</action>
					</event>
					</button>
				</item>
				<!--
					<item>
						<button caption="Naruči!" type="" >
						</button>
					</item>
				-->
				<item>
					<button name="btnDown" caption="" type="" image="left">
						<event type="click">
							<action type="datarun scalar" value="~dtNivoDown">
								<parameter name="NivoDown" value="$NivoDown" />
							</action>
							<action type="control value" value="#lblNivo">
								<parameter value="$NivoDown"/>
							</action>
							<action type="variable value" >
								<parameter name="tmpId" value="$NivoDown" type="int" />
							</action>						
							<action type="control populate" value="#grdSirovine" />
							<action type="control disable" value="btnDown" if="#lblNivo==1||#lblNivo==0" />
						</event>
					</button>
				</item>
				<item>
					<labeledit name="lblNivo" value="1" width="50" fontbold="true"/>
				</item>	
				<item>				
					<button name="btnUp" caption="" type="" image="right">
						<event type="click">
							<action type="datarun scalar" value="~dtNivoUp">
								<parameter name="NivoUp" value="$NivoUp" />
							</action>	
							<action type="control value" value="#lblNivo">
								<parameter value="$NivoUp"/>
							</action>
							<action type="variable value" >
								<parameter name="tmpId" value="$NivoUp" type="int" />
							</action>						
							<action type="control populate" value="#grdSirovine" />
							<action type="control disable" value="btnUp" if="#lblNivo==$NivoMax" />
							<action type="control enable" value="#btnDown"/>
						</event>
					</button>
				</item>
				<item>

					<button caption="Proizvodi" type="" >
						<event type="click">
							<action type="form open" value="frmProizvod" if="#grdSirovine.selectedrowscount==1" >
								<parameter name="robaid" value="#grdSirovine.@robaid" />
							</action>
							<action type="message" value="Ovaj pregled je moguć samo za pojedinačne bilance!" else="" />
						</event>						
					</button>	
				</item>
			</items>
		</actionpanel>		
		<datalist> 
			<data command="spPrnPlaniranje" name="dtMakeSirovine"/>
			<data command="spPrnPlaniranjeQuery" name="dtGetSirovine">
				<parameter name="@nivo" value="$tmpId"/>
			</data>
			<!-- 			<data command="spPrnPlaniranjeQuery" name="dtSirovine">
				<parameter name="@nivo" value="#lblNivo"/>
				<parameter name="@OrgShemaId" value="$OrgShemaIDPogon"/>
			</data> -->
			<data command="select max(nivo) as NivoMax from viPrnPlanTemp" type="text" name="dtNivoMax">
			</data>
			<!-- 			<data command="select 4 as NivoMax" type="text" name="dtNivoMax">
			</data> -->
			<data command="select @NivoUp + 1 as NivoUp" type="text" name="dtNivoUp">
				<parameter name="@NivoUp" value="#lblNivo" type="int"/>
			</data>
			<data command="select @NivoDown - 1 as NivoDown" type="text" name="dtNivoDown">
				<parameter name="@NivoDown" value="#lblNivo" type="int"/>
			</data>			
		</datalist>
	</form>
</root>