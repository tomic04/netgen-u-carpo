<root>
	<form name="frmPoveziSlokacijama" caption="Poveži ugovor s lokacijama" width="550" height="400" saveformsize="false"> 
    <event type="load">
        <action type="control disable" value="#cmbLokacija" />
        <action type="control value" value="#rdoKlasa">
            <parameter value="true" />
        </action>
          <action type="datarun nonquery" value="~dtBrisiSveKlasePar" />
        <action type="control focus" value="#cmbKlasa" />
        <action type="control populate" value="#grdLokacije" />
      <action type="datarun nonquery" value="Global.dtBrisiSveTempLokacije" />      
    </event>
    <event type="shown">
        <action type="control focus" value="#cmbKlasa" />
    </event>
    <event type="close">
        <action type="datarun nonquery" value="~dtBrisiSveKlasePar" />
    </event>
    <event type="onload">
          <action type="datarun nonquery" value="Global.dtBrisiSveKlasePar" />
          <action type="datarun nonquery" value="~dtBrisiSveKlasePar" />
    </event>
    <event type="leave">
        <action tyoe="datarun nonquery" value="~dtBrisiSveKlasePar" />
    </event>
		<layout textposition="left">
            <group rows="2" cols="1">
                <rowsdefinition>
                    <row position="1" size="35%"></row>
                    <row position="2" size="65%"></row>
                </rowsdefinition>
                <group cols="2" rows="1" row="1" col="1" bordervisible="false">
                    <columnsdefinition>
					    <column position="1" size="50%"></column>
                        <column position="2" size="100%"></column>
				    </columnsdefinition>
                    <group row="1" col="1" rows="3" cols="2"  bordervisible="false" colspan="2"> 
                        <item row="1" col="1">
                            <radioedit name="rdoKlasa" caption="Klasa partnera:">
                               <event type="checkedchanged">
                                    <action type="control enable" value="#cmbKlasa" if="#rdoKlasa==true" >
                                        <action type="control focus" value="#cmbKlasa">
                                              <parameter name="LnKupUgovoriGlaParStruId" value="#grdLokacije.@LnKupUgovoriGlaParStruId" />
                                        </action>
                                         <action type="control populate" value="#grdLokacije" />
                                    </action>
                                     
                                    <action type="control disable" value="#cmbLokacija" if="#rdoKlasa==true" />
                                    <action type="control value" value="#cmbLokacija" if="#rdoKlasa==true">
                                        <parameter value="null" />
                                    </action>
                                </event>
                            </radioedit>
                        </item>
                        <item row="2" col="1">
                            <radioedit name="rdoLokacija" caption="Lokacija: ">
                                <event type="checkedchanged">
                                    <action type="control enable" value="#cmbLokacija" if="#rdoLokacija==true" >
                                        <action type="control focus" value="#cmbLokacija">
                                            <parameter name="LnKupUgovoriGlaParStruId" value="#grdLokacije.@LnKupUgovoriGlaParStruId" />
                                        </action>
                                        <action type="control populate" value="#grdLokacije" />
                                    </action>
                                
                                    <action type="control disable" value="#cmbKlasa" if="#rdoLokacija==true" />
                                    <action type="control value" value="#cmbKlasa" if="#rdoLokacija==true">
                                        <parameter value="null" />
                                    </action>
                                </event>
                            </radioedit>
                        </item>
                        <group row="3" col="2" rows="1" cols="3"  bordervisible="false">
                        <columnsdefinition>
                            <column position="1" size="50%"></column>
				        </columnsdefinition>
                            <item row="1" col="2">
                                <button name="btnDodaj" caption="Dodaj">
                                    <event type="click">
                                       <action type="datarun nonquery" value="~dtBrisiSveKlasePar" />
                                        <action type="datarun nonquery" value="~dtDodatneLokacije">
                                            <parameter name="@parstruid" value="#cmbLokacija" />
                                        </action>
                                        <action type="control populate" value="#grdLokacije" key="LnKupUgovoriGlaParStruId"/>
                                        <action type="control populate" value="#cmbLokacija">
                                            <parameter value="null" />
                                        </action>
                                    </event>
                                </button>
                            </item>
                            <item row="1" col="3"> 
                                <button name="btnObrisi" caption="Obriši"> 
                                    <event type="click">
                                        <action type="confirm" value="Obrisati odabrane lokacije?" />
                                        <action type="control foreachrow selected" value="#grdLokacije">
                                            <action type="datarun nonquery" value="~dtObrisiLokaciju"/>
                                        </action>
                                        <action type="control populate" value="#grdLokacije" />
                                    </event>
                                </button>
                            </item>
                        </group>
                        <item row="1" col="2">
                            <comboedit name="cmbKlasa" valuefield="KlPartneriID" displayfield="Naziv" dataname="~dtKlPartneri" />
                        </item>
                        <item row="2" col="2">
                            <comboedit name="cmbLokacija" displayfield="NazivId" valuefield="parstruid" dataname="~dtParStruLokacije" />
                        </item>
                    </group>
                </group>
                <item row="2" col="1">
                    <grid name="grdLokacije" dataname="~grdLok" bestfitonrefresh="true" showcheckboxes="true" multiselect="true" >
                            <fields inherited="true">
                                <field name="Naziv" caption="Naziv lokacije"/>
                                <field name="Sifra" caption="Šifra" />
                                <field name="Adresa" caption="Adresa" />
                                <field name="Mjesto" caption="Mjesto" />
                            </fields>
                    </grid>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="Spremi">
                    <event type="click">
                        <action type="form close"/>
                    </event>
                </button>
                 <button caption="Odustani" type="cancel" />
            </buttons>
        </panelbuttons>
        <datalist>        
            <data command="spProd_KupUgoLokacije" name="grdLok">
                <parameter name="@action" value="8"/> 
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                 <parameter name="@KLPartneriId" value="#cmbKlasa"/>
                 <parameter name="@Parstruid" value="#cmbLokacija" />
            </data>        
            <data command="spKlPartneriQueryCarpo" name="dtKlPartneri">
                <parameter name="@action" value="0" />
            </data>
            <data command="spTraziParstru" name="dtParStruLokacije">
                <parameter name="@action" value="Parstru" />
                <parameter name="@uvjet" value="" />
                <parameter name="@partneriid" value="parent.#srcPartner" />
            </data>
           <data command="spProd_KupUgoLokacije" name="dtObrisiLokaciju">
                  <parameter name="@action" value="10" if="#rdoKlasa==false"/>
                  <parameter name="@parstruid" value="#grdLokacije.@parstruid" />
                  <parameter name="@LnKupUgovoriGlaParStruId" value="#grdLokacije.@LnKupUgovoriGlaParStruId" /> 
                  <parameter name="@action" value="10" if="#rdoKlasa==true"/>
           </data>
           <data command="SpProd_KupUgoLokacije" name="dtInsertKlasa">
                  <parameter name="@action" value="2" />
                  <parameter name="@KLPartneriId" value="#cmbKlasa" />
                  <parameter name="@ParStruId" value="#grdLokacije.@ParstruID" />
                  <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
            <data command="SpProd_KupUgoLokacije" name="dtObrisiKlasu">
                <parameter name="@action" value="10" />
                <parameter name="@LnKupUgovoriGlaParStruId" value="#grdLokacije.@LnKupUgovoriGlaParStruId" /> 
            </data>
            <data command="spProd_KupUgoLokacije" name="dtBrisiSveKlasePar">
                <parameter name="@action" value="11" />
            </data>
            <data command="spProd_KupUgoLokacije" name="dtDodatneLokacije">
                <parameter name="@action" value="2" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                 <parameter name="@parstruid" value="#cmbLokacija" />
                <parameter name="@klpartneriid" value="#cmbKlasa"/>
              <parameter name="@PartneriId" value="parent.#srcPartner" />
            </data>
        </datalist>
	</form> 
</root>
