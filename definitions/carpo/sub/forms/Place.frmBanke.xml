<root>
  <!--
  ****************************************************************
  Forma za prikaz banaka i broja definiranih naloga
  ver 1: inicijalna verzija sa formama za virmane unutra
  ver 2: samo frmBanke, zove vanjsku datoteku Place.frmVirmani.xml na kojoj su forme za virmane
  ver 3: 10.3.2021. kod poziva Place.frmVirmani.xml šaljem PrimateljId i PrimateljText ako se želi popunjavati Primatelj kod unosa novog naloga (banke da, doprinosi ne itd...)
  ****************************************************************
  -->

  <form name="frmBanke" caption="Banke" width="700" height="500" fixedsize="true" saveformsize="false" showversion="true" version="3" >
    <event type="init">
      <action type="datarun reader" value="~dtGridBanke" />
    </event>

    <event type="load">
      <action type="control populate" value="#grdBanke" >     </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdBanke" key="PartneriId" dataname="~dtGridBanke" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false">
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPopis" caption="Popis naloga">
          <event type="click">
            <action type="form open" value="frmVirmani">
              <parameter name="caption" value="Virmani za banku {#grdBanke.@Naziv}"/>
              <!--<parameter name="PartneriId" value="#grdBanke.@PartneriId"/>-->
              <parameter name="OOPId" value="#grdBanke.@PartneriId"/>
              <parameter name="Banka" value="#grdBanke.@Naziv"/>
              <parameter name="OOPOznaka" value="BA"/>			  
			  <!-- kod naloga za banke želim da se popuni primatelj s ID-om banke za koju je nalog -->
			  <!-- ovu opciju ne želim koristiti na nalozima doprinosa jer OOPId = OOPDoprinosiId pa nema smisla -->
			  <!-- ovu opciju ne želim koristiti na nalozima poreza jer OOPId = OOPMjestaPorezId pa nema smisla -->
			  <!-- ovu opciju ne želim koristiti na nalozima obustava jer OOPId = OOPObustaveGlaId pa nema smisla -->
              <parameter name="PrimateljId" value="#grdBanke.@PartneriId"/> 
              <parameter name="PrimateljText" value="#grdBanke.@Naziv"/>
            </action>
            <action type="control populate keepfocus" value="#grdBanke"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceBankeQuery" name="dtGridBanke">
      </data>
    </datalist>
  </form>

  <!--includane forme-->


  <form name="frmVirmani" path="Place.frmVirmani.xml"/>
  <form name="frmVirmanEdit" path="Place.frmVirmani.xml"/>
  <form name="frmVirmanBrisi" path="Place.frmVirmani.xml"/>

</root>