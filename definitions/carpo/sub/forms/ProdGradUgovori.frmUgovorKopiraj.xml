<root>
	<form name="frmUgovorKopiraj" caption="{$Ind} ugovora {parent.#grdGlava.@Broj}" width="" height="" fixedsize="false">
		<event type="oninit">
		</event>
		<event type="onshown">
			<action type="control value" value="#srcPartner">
				<parameter value="$PartneriId" text="$PartnerNaziv" />
			</action>
			<action type="control value" value="#cmbOrgShema">
				<parameter value="$OrgShemaId"></parameter>
			</action>	
			<action type="control value" value="#datDatumDok">
				<parameter value="$DatumDok"></parameter>
			</action>
			<action type="control disable" value="#srcPartner,#cmbOrgShema" if="$Ind==Aneks"/>
		</event>
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" backgroundcolor="">
				<group cols="1" rows="3" col="1" row="1" backgroundcolor="" groupbordervisible="False">
					<group cols="3" rows="1" col="1" row="1" backgroundcolor="" groupbordervisible="False">
						<columnsdefinition>
							<column size="300" position="1" />
							<column size="50" position="2" />
							<column size="100" position="2" />
						</columnsdefinition> 						
						<item caption="Broj:" row="1" col="1" fontbold="true" >
							<textedit name="txtBroj" datavalue="" required="true" fontbold="true" nulltext=""/>
						</item>
						<item caption="Aneks:" row="1" col="2" fontbold="" >
							<textedit name="txtAneks" datavalue="" value="" format="n0" fontbold="" nulltext=""/>
						</item>
						<item caption="Datum ugovora:" row="1" col="3" fontbold="" >
							<dateedit name="datDatumDok" datavalue="" value="now" fontbold="" nulltext=""/>
						</item>				
					</group>
					<item caption="Broj predmeta:" row="2" col="1" fontbold="" >
						<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" datavalue="" dataname="Global.dtOrgShema" required="true"/>
					</item>
					<item caption="Naručitelj:" row="3" col="1" fontbold=""> 
						<searchedit netgenfields="true" name="srcPartner" required="true" fontbold="" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="" datatext=""/>					
					</item>						
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="PRIHVATI" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="Global.dtKopiraj">
							<parameter name="ProdGradUgovoriGlaId" />
						</action>
						<action type="variable value" value="Global.$DokId">
							<parameter value="$ProdGradUgovoriGlaId" />
						</action>
						<action type="form close"/>
						<action type="form open" value="frmUgovorIzmjena">
							<parameter name="ProdGradUgovoriGlaId" value="$ProdGradUgovoriGlaId"/>
						</action>
					</event>
				</button>			
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>	
		</datalist>
	</form>
</root>