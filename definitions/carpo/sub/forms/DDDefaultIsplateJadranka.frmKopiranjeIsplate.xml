<root>
	<form name="frmKopiranjeIsplate" caption="Vrsta isplate :: {~dtGet.@Naziv} " width="100" height="300" saveformlayout="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet">
			</action>
		</event>
		<event type="load">
			<action type="control value" value="#cmbVrsteIsplate">
				<parameter text="~dtGet.@Naziv" value="~dtGet.@oopisstavkeid" />
			</action>
		</event>
		<layout>
			<group rows="5" cols="1" groupbordervisible="false">
				<item row="1" col="1" caption="Vrsta isplate: " textposition="left">
					<comboedit name="cmbVrsteIsplate" valuefield="oopisstavkeid" displayfield="Naziv" dataname="~dtGetIsplatu"/>
				</item>
				<item row="2" col="1" caption="Naziv nove isplate: " textposition="left">
					<textedit name="txtNaziv" required="true"/>
				</item>
				<item row="3" col="1" caption="Formule" textposition="left">
					<checkedit name="chekFormule"/>
				</item>
				<item row="4" col="1" caption="Koeficijenti" textposition="left">
					<checkedit name="chekKoeficijenti"/>
				</item>
				<item row="5" col="1" caption="Virmani" textposition="left">
					<checkedit name="chekVirmani"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun reader" value="~dtKopiraj">
							<action type="control populate" value="parent.#grdDrugiDohodak" >
								<action type="control focus" value="parent.#grdDrugiDohodak">
									<parameter value="~dtKopiraj.@novaVI" type="int" />
								</action>
							</action>
							<action if="#chekFormule==false&amp;&amp;#chekKoeficijenti==false&amp;&amp;#chekVirmani==false">
                            <action type="message" value="Vrsta isplate je uspješno kopirana!" />
                            </action>
							<action elseif="#chekFormule==true&amp;&amp;#chekKoeficijenti==false&amp;&amp;#chekVirmani==false">
                            <action type="message" value="Vrsta isplate i formule su uspješno kopirane!" />
                            </action>
							<action elseif="#chekFormule==false&amp;&amp;#chekKoeficijenti==false&amp;&amp;#chekVirmani==true">
                            <action type="message" value="Vrsta isplate i virmani su uspješno kopirane!" />
                            </action>
							<action elseif="#chekFormule==true&amp;&amp;#chekKoeficijenti==true&amp;&amp;#chekVirmani==false">
                            <action type="message" value="Vrsta isplate,formule i koeficijent su uspješno kopirani!" />
                            </action>
							<action elseif="#chekFormule==true&amp;&amp;#chekKoeficijenti==true&amp;&amp;#chekVirmani==true">
                            <action type="message" value="Uspješno ste kopirali sve za vrstu isplate {parent.#grdDrugiDohodak.@Naziv}!" />
                            </action>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGet">
				<parameter name="@action" value="dtGrid" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGetIsplatu">
				<parameter name="@action" value="cmbIsplata" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtKopiraj">
				<parameter name="@action" value="KopiranjeV" />
				<parameter name="@oopisstavkeid" value="#cmbVrsteIsplate" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@chekFormule" value="#chekFormule" />
				<parameter name="@chekKoeficijenti" value="#chekKoeficijenti" />
				<parameter name="@chekVirmani" value="#chekVirmani" />
			</data>
		</datalist>
	</form>
</root>