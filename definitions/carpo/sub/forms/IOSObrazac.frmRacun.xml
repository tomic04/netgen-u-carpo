<root>
	<form name="frmRacun" caption="IRA" width="500" height="500" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtFakDetalj"/>
			<action type="datarun reader" value="~dtFakStavke"/>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdStavkeDetalj"/>
		</event>
		<layout itemspadding="1">
			<group rows="6" cols="3">
				<item caption="Broj:" row="1" col="1">
					<textedit name="txtBroj" datavalue="~dtFakDetalj.@Broj"/>
				</item>
				<item caption="Datum dokumenta:" row="1" col="2">
					<dateedit name="datDatDok" datavalue="~dtFakDetalj.@DatumDok"/>
				</item>
				<item caption="Valuta:" row="1" col="3">
					<dateedit name="datValuta" datavalue="~dtFakDetalj.@DatumValute"/>
				</item>
				<item caption="Iznos fakture:" row="2" col="1">
					<textedit name="txtIznFak" datavalue="~dtFakDetalj.@IznosFakture" format="n2"/>
				</item>
				<item caption="Iznos poreza:" row="2" col="2">
					<textedit name="txtIznPDV" datavalue="~dtFakDetalj.@IznosPoreza" format="n2"/>
				</item>
				<item caption="Plaćeni iznos:" row="2" col="3">
					<textedit name="txtIznPl" datavalue="~dtFakDetalj.@IznosPlaceni" format="n2"/>
				</item>
				<item caption="Partner:" row="3" col="1" colspan="2">
					<textedit name="txtPartner" datavalue="~dtFakDetalj.@Partner"/>
				</item>
				<item caption="Adresa:" row="3" col="3">
					<textedit name="txtAdresa" datavalue="~dtFakDetalj.@Adresa"/>
				</item>
				<item caption="Ugovor:" row="4" col="1">
					<textedit name="txtUgovor" datavalue="~dtFakDetalj.@OpisUgovora" value="txtUgovor"/>
				</item>
				<item caption="Osoba:" row="5" col="1" colspan="2">
					<textedit name="txtOsoba" datavalue="~dtFakDetalj.@Operater"/>
				</item>
				<item caption="Org. shema:" row="5" col="3">
					<textedit name="txtOrgShema" datavalue="~dtFakDetalj.@OrgShema"/>
				</item>
				<item row="6" col="1" colspan="3">
					<grid name="grdStavkeDetalj" dataname="~dtFakStavke">
						<fields inherited="true">
							<field name="sifra" caption="Šifra" />
							<field name="robanaziv" caption="Naziv robe" />
							<field name="JMNaziv" caption="JM" />
							<field name="kolicina" caption="Količina" />
							<field name="cijena" caption="Cijena" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<datalist>
			<data command="spCKntIOSObrazac" name="dtFakDetalj">
				<parameter name="@Action" value="10"/>
				<parameter name="@NizKonto" value="$Konto"/>
				<parameter name="@KId" value="$Kid"/>
			</data>
			<data command="spCKntIOSObrazac" name="dtFakStavke">
				<parameter name="@Action" value="11"/>
				<parameter name="@KId" value="$Kid"/>
			</data>
		</datalist>
		<panelbuttons>
			<buttons>
				<button name="btnExit" caption="Izlaz">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>