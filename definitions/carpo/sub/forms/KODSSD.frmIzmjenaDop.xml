<root>

  <!--FORMA ZA izmjenu DOPRINOSA-->
  <form name="frmIzmjenaDop" caption ="$caption" minwidth="800" >

    
    <event type="load">
      <action type="control value" value="#txtDoprinos">
        <parameter value="$doprinosNaziv"></parameter>
      </action>

    </event>

    <layout>
      <group cols="1" rows="7"  spacing="2,2,2,2">

        <item caption="Doprinos:" col="1" row="1" highlight="False" textposition="left">
          <textedit name="txtDoprinos"   readonly="true"/>
        </item>

        <item caption="Datum:" col="1" row="2" highlight="False" textposition="left">
          <dateedit name="datDatumOd" value="now"  required="true" textposition="left"/>
        </item>
        <item caption="Stopa:" col="1" row="3"  highlight="False" textposition="left">
          <textedit name="txtStopa" required="true" nulltext="0,00" format="n2" textposition="left"/>
        </item>
        <item caption="Min. osnovica:" col="1" row="4" highlight="False" textposition="left">
          <textedit name="txtMinOsnovica" required="false" nulltext="0,00" format="n2" textposition="left"/>
        </item>
        <item caption="Max. osnovica:" col="1" row="5" highlight="False" textposition="left">
          <textedit name="txtMaxOsnovica" required="false" nulltext="0,00" format="n2" textposition="left"/>
        </item>
        <item caption="God. osnovica:" col="1" row="6"  highlight="False" textposition="left">
          <textedit name="txtGodOsnovica" required="false" nulltext="0,00" format="n2" textposition="left"/>
        </item>
        <item caption="Koeficijent:" col="1" row="7" highlight="False" textposition="left">
          <textedit name="txtKoeficijent" required="false" nulltext="0,00" format="n2" textposition="left"/>
        </item>

      

      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <action type="datarun reader" value="~dtSpremi"/>

            <action type="message" value="~dtSpremi.@poruka"/>

            <!-- Osvježi grid na parent formi -->
            <action type="control populate" value="parent.#grdDoprinosi"/>

            <action type="form close" />

          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
      </buttons>
    </panelbuttons>

    <datalist>


      <data command="spLnOOPSSDDetAzur" name="dtSpremi">
        <parameter name="@Action" value="izmjena" type="string"/>
        <parameter name="@lnOOPSSDDetId" value="parent.#grdDoprinosi.@LnOOPSSDDetId" type="int"/>
        <parameter name="@lnOOPSSDGlaId" value="parent.#grdDoprinosi.@LnOOPSSDGlaId" type="int"/>
        <parameter name="@OperateriId" value="@@OperateriId" />
        <parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
        <parameter name="@table" value="parent.#grdDoprinosi.selectedids.table"/>
        <parameter name="@datumod" value="#datDatumOd" type="date"/>
        <parameter name="@stopa" value="#txtStopa" type="decimal"/>
        <parameter name="@MinOsnovica" value="#txtMinOsnovica" type="decimal"/>
        <parameter name="@MaxOsnovica" value="#txtMaxOsnovica" type="decimal"/>
        <parameter name="@GodOsnovica" value="#txtGodOsnovica" type="decimal"/>
        <parameter name="@Koeficijent" value="#txtKoeficijent" type="decimal"/>

        <!--<parameter name="@KODOsiguraniciId" value="#srcKODOsiguranici" type="int"/>
        <parameter name="@KODPrimiciId" value="#srcKODPrimici" type="int"/>
        <parameter name="@KODNeoporeziviPrimiciId" value="#srcKODNeoporeziviPrimici" type="int"/>
        <parameter name="@KODNaciniIsplateId" value="#srcKODNaciniIsplate" type="int"/>
        <parameter name="@KODBeneficiraniId" value="#srcKODBeneficirani" type="int"/>-->
      </data>


      <data command="spLnOOPSSDHelp" name="dtSrcKODOsiguranici">
        <parameter name="@action" value="trazilica_kodosiguranici"/>
        <parameter name="@Tekst" value="#srckodosiguranici.text"/>
      </data>
      <data command="spLnOOPSSDHelp" name="dtSrcKODPrimici">
        <parameter name="@action" value="trazilica_kodprimici"/>
        <parameter name="@Tekst" value="#srckodprimici.text"/>
      </data>
      <data command="spLnOOPSSDHelp" name="dtSrcKODNeoporeziviPrimici">
        <parameter name="@action" value="trazilica_kodneoporeziviprimici"/>
        <parameter name="@Tekst" value="#srckodneoporeziviprimici.text"/>
      </data>
      <data command="spLnOOPSSDHelp" name="dtSrcKODBeneficirani">
        <parameter name="@action" value="trazilica_kodbeneficirani"/>
        <parameter name="@Tekst" value="#srckodbeneficirani.text"/>
      </data>
      <data command="spLnOOPSSDHelp" name="dtSrcKODNaciniIsplate">
        <parameter name="@action" value="trazilica_kodnaciniisplate"/>
        <parameter name="@Tekst" value="#srckodnaciniisplate.text"/>
      </data>
    </datalist>
  </form>

  <!--kraj FORMA ZA izmjenu DOPRINOSA-->
</root>