<root version="1.0">

  <!--******************************************FILTER - IZMJENA STATUSA****************************************-->
  <form name="frmIzmjStat" caption="$caption" fixedsize="false" width="1000" height="500" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtIzmjena" />
      <action type="datarun reader" value="~dtIzmjStat" />
    </event>
    <event type="close">
      <action type="datarun reader" value="~dtBrisanje" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="2" groupbordervisible="false">
        <group rows="1" cols="4" col="1" row="1" spacing="2,2,2,1">
          <columnsdefinition>
            <column pos="1" size="33%"></column>
            <column pos="2" size="33%"></column>
            <column pos="3" size="100"></column>
            <column pos="4" size="34%"></column>
          </columnsdefinition>
          <item caption="Status:" col="1" row="1"  >
            <comboedit name="cmbStatus" valuefield="OSStatusiId" displayfield="Naziv" dataname="~dtStatusi" allownull="false" />
          </item>
          <item caption="Datum:" col="2" row="1" >
            <dateedit name="datDatum" value="now" />
          </item>
          <item caption="" col="3" row="1" >
            <button name="btnSpremi"  caption="Spremi" >
              <event type="click">
                <action type="datarun reader" value="~dtKontrolaBlokade" >
                  <action type="message" value="~dtKontrolaBlokade.@Poruka" if="~dtKontrolaBlokade.@IndGreska==1" />
                  <action type="control focus" value="#datDatum"/>
                </action>
                <action type="datarun nonquery" value="~dtIzmjStatusa" if="~dtKontrolaBlokade.@IndGreska==0" >
                  <action type="control populate" value="#grdIzmjStat" />
                  <action type="control refreshvalue" value="#cmbStatus,#datDatum"/>
                  <action type="control focus" value="#cmbStatus"/>
                </action>
              </event>
            </button>
          </item>
          <item caption="" col="4" row="1"  />
        </group>

        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,2" >
          <item col="1" row="1">
            <grid caption="" name="grdIzmjStat" dataname="dtIzmjStat" fieldsmartspaces="false" autopopulate="true" key="OSImovinaFilterId" keyfield="OSImovinaFilterId" multiselect="true" showcheckboxes="true" bestfitonrefresh="true">
              <fields inherited="true">
                <field name="Status2" caption="Novi status"/>
                <field name="DatumDok" caption="Datum od"/>
                <field name="DatumDok2" caption="Datum od novog statusa"/>
              </fields>
            </grid>
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnIzmjena"  caption="Izmijeni status" >
          <event type="click">
            <action type="datarun nonquery" value="~dtIzmjenaSpremi" />
            <action type="form close" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>

      <data command="spOSImovinaStatusi_CP" name="dtStatusi">
        <parameter name="@Action" value="Statusi_combo"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtKontrolaBlokade">
        <parameter name="@Action" value="Kontrola_blokade"/>
        <parameter name="@Datum" value="#datDatum" />
      </data>
      <data command="spOSFilter_AzurCP" name="dtBrisanje">
        <parameter name="@action" value="Izlaz_Brisanje"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjena">
        <parameter name="@action" value="StatusiIzmjena_Spremi"/>
        <parameter name="@SelectedIds" value="$SelectedIds"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_HelpCP" name="dtIzmjStat">
        <parameter name="@action" value="Grid_StatusiIzmjena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjStatusa">
        <parameter name="@action" value="StatusiIzmjena_Podaci"/>
        <parameter name="@SelectedIds" value="#grdIzmjStat.SelectedIds"/>
        <parameter name="@OSStatusiId" value="#cmbStatus"/>
        <parameter name="@DatumDok" value="#datDatum"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjenaSpremi">
        <parameter name="@Action" value="Statusi_filter"/>
        <parameter name="@SelectedIds" value="#grdIzmjStat.SelectedIds"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ FILTER - IZMJENA STATUSA**************************************************-->

</root>

