<root>
<!--devex 20 radioedit mora imati caption, a ne roditelj item-->
	<form name="frmOdobri" caption="Odobravanje" width="400" height="400" fixedsize="true">
		<event type="shown">
			<action type="control caption" value="#btnSpremi">
				<parameter value="ODOBRI"/>
			</action>		
		</event>
		<layout>
			<group cols="2" rows="3" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="50%"/>
					<column position="2" size="50%"/>
				</columnsdefinition>
				<rowsdefinition>
				<!-- <row position="1" size="40"/> -->
				<!-- <row position="2" size="40"/> -->
					<!-- <row position="3" size="400"/> -->
					<!-- <row position="4" size="40"/> -->
				</rowsdefinition>
				<item col="1" row="1" caption="" fontsizedelta="1">
					<labeledit name="lblPitanje" value="Želite li odobriti odabrani dokument?" fontbold="true"/>
				</item>
				<group col="1" row="2" cols="4" rows="1" colspan="2" alignmode="local">
					<columnsdefinition>
						<column position="1" size="25%"/>
						<column position="2" size="25%"/>
						<column position="3" size="25%"/>
						<column position="4" size="25%"/>					
					</columnsdefinition>					
					<item col="1" row="1" textposition="left" fontsizedelta="1">
						<radioedit name="rdoDA" caption="DA" value="true" groupindex="1">
							<event type="valuechanged">
								<action type="control caption" value="#btnSpremi" if="#rdoDA==true">
									<parameter value="ODOBRENO"/>
								</action>
								<action type="control caption" value="#btnSpremi" if="#rdoDA==false">
									<parameter value="NIJE ODOBRENO"/>
								</action>								
							</event>
						</radioedit>
					</item>
					<item col="2" row="1"/>
					<item col="3" row="1" textposition="right" fontsizedelta="1">
						<radioedit name="rdoNE" caption="NE" groupindex="1">
							<event type="valuechanged">
								<action type="control caption" value="#btnSpremi" if="#rdoNE==true">
									<parameter value="NIJE ODOBRENO"/>
								</action>
								<action type="control caption" value="#btnSpremi" if="#rdoNE==false">
									<parameter value="ODOBRENO"/>
								</action>									
							</event>					
						</radioedit>				
					</item>
					<item col="2" row="1"/>
				</group>
				<item col="1" row="3" colspan="2" caption="Napomena:" textposition="top" fontsizedelta="1">
					<memoedit name="memNapomena"/>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi">
					<event type="click">
						<action type="transaction">
							<action type="datarun nonquery" value="~dtKontrolePrijeNeOdobri" if="#rdoNE==true"/>
							<action type="datarun nonquery" value="~dtOdobri1"/>
							<action type="datarun nonquery" value="~dtOdobri2"/>
						</action>
						<action if="transaction==success">
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtOdobri1" command="spCKntKnjigaUraKupOdobri">
				<parameter name="@Action" value="14"/>
				<parameter name="@KupPrometId" value="$KupPrometId"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@odobrenjeid" value="3" if="#rdoDA==true"/>
				<parameter name="@odobrenjeid" value="4" if="#rdoNE==true"/>
				<parameter name="@RazlogOdbijanja" value="#memNapomena"/>
			</data>
			<data name="dtOdobri2" command="spCKntKnjigaUraKupOdobri">
				<parameter name="@Action" value="141" if="#rdoNE==true"/>
				<parameter name="@Action" value="142" if="#rdoDA==true"/>
				<parameter name="@KupPrometId" value="$KupPrometId"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@odobrenjeid" value="3" if="#rdoDA==true"/>
				<parameter name="@odobrenjeid" value="4" if="#rdoNE==true"/>				
				<!-- <parameter name="@OpisRobe" value=""/> -->
				<!-- <parameter name="@MjestoTroska" value=""/>				 -->
			</data>		
			<data name="dtKontrolePrijeNeOdobri" command="spCKntKnjigaUraKupKontrole">
				<parameter name="@Action" value="10"/>
				<parameter name="@KupPrometId" value="$KupPrometId"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>				
		</datalist>
	</form>
</root>