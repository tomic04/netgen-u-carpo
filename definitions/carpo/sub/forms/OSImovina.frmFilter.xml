<root version="1.0">

  <!--******************************************PARAMETRI FILTERA****************************************-->
  <form name="frmFilter" caption="$Caption" fixedsize="false" width="950" height="550" saveformlayout="true" >

    <event type="oninit">
      <action type="datarun reader" value="~dtFilterPrikaz" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdFilter" />
      <action type="control populate" value="#grdFilterDetaljSve" />
    </event>


    <layout textposition="left" >

      <group cols="1" rows="2" groupbordervisible="false">
        <!--spacing="2,2,2,2"-->

        <group col="1" row="1" cols="3" rows="1" groupbordervisible="false">
          <columnsdefinition>
            <column  position="1" size="46%" />
            <column  position="2" size="54%" />
          </columnsdefinition>
          <item col="1" row="1" cols="1" rows="1" />
          <group col="2" row="1" cols="4" rows="1" colspan="2" spacing="2,2,2,1">
            <item caption="Traži:" col="1" row="1" colspan="3" highlight="false">
              <searchedit name="srcTrazi" fieldvalue="PodatakId" fieldtext="Naziv" dataname="dtFilterPretraga"/>
            </item>
            <item col="4" row="1">
              <button name="btnFilterSpremi"  caption="Dodaj u filter" >
                <event type="click">
                  <action type="validate" />
                  <action type="datarun nonquery" value="dtFilterSpremi" />
                  <action type="control populate" value="#grdFilterDetalj"/>
                  <action type="control populate keepfocus" value="#grdFilter"/>
                  <action type="control populate" value="#grdFilterDetaljSve"/>
                  <action type="control refreshvalue" value="#srcTrazi"/>
                  <action type="control focus" value="#srcTrazi"/>
                </event>
              </button>
            </item>
          </group>
        </group>

        <group col="1" row="2" cols="3" rows="1" groupbordervisible="false">
          <group col="1" row="1" cols="1" rows="10" spacing="2,1,1,2">
            <item caption="" col="1" row="1" rowspan="9">
              <grid name="grdFilter" key="OSFilterDefId" dataname="dtFilterPrikaz" bestfitonrefresh="True" fieldsmartspaces="false" >
                <menu>
                  <menuitem caption="Očisti" sort="1">
                    <event type="click">
                      <action type="datarun reader" value="~dtFilterOcistiDef"  />
                      <action type="control refreshvalue" value="#grdFilterDetalj"/>
                      <action type="control refreshvalue" value="#grdFilter"/>
                      <action type="control refreshvalue" value="#grdFilterDetaljSve"/>
                    </event>
                  </menuitem>
                </menu>
                <event type="focusedrowchanged">
                  <action type="control populate" value="#grdFilterDetalj"/>
                </event>
              </grid>
            </item>

            <item caption="" col="1" row="10" >
              <button name="btnFilterOcisti"  caption="Očisti filtere" type="delete">
                <event type="click">
                  <action type="datarun nonquery" value="dtFilterOcisti" />
                  <action type="control refreshvalue" value="#grdFilterDetalj"/>
                  <action type="control refreshvalue" value="#grdFilter"/>
                  <action type="control refreshvalue" value="#grdFilterDetaljSve"/>
                  <action type="control refreshvalue" value="#srcTrazi"/>
                  <action type="control focus" value="#srcTrazi"/>
                </event>
              </button>
            </item>

          </group>
          <group col="2" row="1" cols="1" rows="2" colspan="2" spacing="1,2,1,2">
            <item caption="Uvjeti za odabrani filter" col="1" row="1" textposition="top">
              <grid name="grdFilterDetalj" dataname="dtFilterDetalj" bestfitonrefresh="True" fieldsmartspaces="false">
                <menu>
                  <menuitem caption="Obriši" sort="1">
                    <event type="click">
                      <!--<action type="validate"/>-->
                      <action type="datarun reader" value="~dtFilterOcistiDefDet"  />
                      <action type="control refreshvalue" value="#grdFilterDetalj"/>
                      <action type="control refreshvalue" value="#grdFilter"/>
                      <action type="control refreshvalue" value="#grdFilterDetaljSve"/>
                    </event>
                  </menuitem>
                </menu>
              </grid>
            </item>
            <item caption="Postavke filtera" col="1" row="2"  textposition="top">
              <grid name="grdFilterDetaljSve" dataname="dtFilterDetaljSve" bestfitonrefresh="True" fieldsmartspaces="false">
              </grid>
            </item>
          </group>
        </group>

      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <!--<button name="btnPrikazi"  caption="Prikaži" type="add" >
          <event type="click">                 
              <action type="control focus" value="parent.#tree">
                <parameter value="" />
              </action>
              <action type="control focus" value="parent.#grdImovina">
                <parameter value="$OSImovinaId" type="int"/>
              </action>
            <action type="form close" />
          </event>
        </button>-->
        <button caption="Izlaz" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSFilter_CP" name="dtFilterPrikaz">
        <parameter name="@Action" value="Grid_def"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterDetalj">
        <parameter name="@Action" value="Grid_defDetalj"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@OSFilterDefId" value="#grdFilter.@OSFilterDefId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterDetaljSve">
        <parameter name="@Action" value="Grid_defDetaljSve"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterPretraga">
        <parameter name="@Action" value="Filter_trazi"/>
        <parameter name="@OSFilterDefId" value="#grdFilter.@OSFilterDefId"/>
        <parameter name="@Tekst" value="#srcTrazi.text"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterSpremi">
        <parameter name="@Action" value="Filter_spremi"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@OSFilterDefId" value="#grdFilter.@OSFilterDefId"/>
        <parameter name="@PodatakId" value="#srcTrazi"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterOcisti">
        <parameter name="@Action" value="Filter_ocisti"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterOcistiDef">
        <parameter name="@Action" value="Filter_ocisti_def"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@OSFilterDefId" value="#grdFilter.@OSFilterDefId"/>
      </data>
      <data command="spOSFilter_CP" name="dtFilterOcistiDefDet">
        <parameter name="@Action" value="Filter_ocisti_def_det"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@OSFilterOPId" value="#grdFilterDetalj.@OSFilterOPId"/>
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ PARAMETRI FILTERA**************************************************-->

</root>

