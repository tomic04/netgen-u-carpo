<root>
	<form name="frmUgovoriNDADodatno" caption="Stavka - izmjena" width="500">
		<event type="init">
			<!-- <action type="datarun reader" value="Global.~dtGet" if="$PosUgovoriglaId!=null" /> -->
			<action type="variable value" />
			<action type="datarun reader" value="Global.~dtGet" if="$Izmjena==0">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<action type="datarun reader" value="Global.~dtGetDet" if="$Izmjena==1">
				<parameter value="@PosUgovoriDetId" />
			</action>
			<!-- <action type="datarun reader" value="Global.~dtGet" if="$PosUgovoriDetId!=null" /> -->
			<action type="datarun reader" value="Global.~dtDetaljStavke" if="$Izmjena==1">
				<parameter value="@PosUgovoriDetId" />
			</action>
		</event>
		<event type="shown">
			<action type="variable value" if="$Izmjena==1" />
		</event>
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="1" bordervisible="false">
				<part name="posugoformDodatno" path="prtUgovoriDodatnoNDA.xml" />
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtEditDetalj" if="$Izmjena==1"/>
						<action type="datarun scalar" value="~dtInsertDetalj" else="$Izmjena==0">
							<!-- <parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" /> -->
							<parameter name="NewDetiId" value="$NewDetiId" />
						</action>
						<!-- <action type="datarun scalar" value="~dtInsertDetalj" />-->
						<action type="control populate" value="parent.#grdRoba" />
						<action type="datarun nonquery" value="~dtUpdateDetLN" if="$Izmjena==0"/>
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="left" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_PosUgovoriDet_Insert" name="dtInsertDetalj">
				<parameter name="@PosUgovoriGlaId" value="$PosUgovoriGlaId" />
				<parameter name="@AvansUplaceniGodisnji" value="#txtAvansGodisnji" />
			</data>
			<data command="spProd_PosUgovoriDet_Edit" name="dtEditDetalj">
				<parameter name="@id" value="$PosUgovoriDetId" />
				<parameter name="@PosUgovoriGlaId" value="$PosUgovoriGlaId" />
				<parameter name="@AvansUplaceniGodisnji" value="#txtAvansGodisnji" />
			</data>
			<!-- <data command="spProd_PosUgovori_RobaUpdateDetLn" name="dtUpdateDetLN">
				<parameter name="@PosUgovoriDetId" value="$NewDetiId" />
			</data> -->
		</datalist>
	</form>
</root>