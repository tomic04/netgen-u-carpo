<root>
	<form name="frmStorniraj" caption="Storniranje" fixedsize="false">
		<event type="close">
			<!-- TODO: problem kod fokusa nakon izmijeni/spremi -->
			<action type="control populate" value="parent.#grdGlava" >
				<action type="control focus" value="parent.#grdGlava">
					<parameter value="$FaktureId" />
				</action>
			</action>			
		</event>		
		<layout textposition="top" itemspadding="1">
			<group cols="1" rows="1" groupbordervisible="false">
				<item caption="Datum:" col="1" row="1" >
					<dateedit name="datDatum" value="now" required="true">
					</dateedit>
				</item>	
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="PRIHVATI" dock="right">
					<event type="click">
						<action type="control foreachrow selected" value="parent.#grdGlava" >
							<action type="datarun nonquery" value="global.~dtStorniraj"/>
						</action>					
						<action type="form close"/>				
					</event>
				</button>
				<button caption="ODUSTANI" dock="right" type="cancel">
					<event type="click">
						<!-- <action type="form close"></action>	 -->
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>