<root version="8.0.0.2">
	<form name="frmPosalji" caption="Kandidati za slanje" savelayout="true" width="770" height="500" statusbar="true">
		<method name="Send" dll="Valisend" class="Valisend.ComProvider" method="Send" />
		<event type="load">
			<action type="control enable" value="#btnPosalji" if="$ValidiraniIDs!=null" />
			<action type="control disable" value="#btnPosalji" else="" />
		</event>
		<event type="shown">
			<!-- <action type="datarun reader" value="~dtOsobeSlanje" /> -->
			<action type="control populate" value="#grdOsobeSlanje" />
			<action type="footer text" value="Broj slogova: {#grdOsobeSlanje.rowcount}  Broj označenih slogova: {#grdOsobeSlanje.selectedrowscount}" />
			<action type="datarun reader" value="~dtCheckSve" />
			<action type="control selectedrows" value="#grdOsobeSlanje">
				<parameter value="~dtCheckSve.@idniz" />
			</action>
			<action type="control enable" value="#btnValidiraj" if="global.$SelectedIDs!=null" />
			<action type="control disable" value="#btnValidiraj" else="" />
		</event>
		<layout>
			<group cols="1" rows="1" backgroundcolor="" groupbordervisible="false">
				<item col="1" row="1" highlight="false">
					<grid name="grdOsobeSlanje" key="MarAktDetId" dataname="dtOsobeSlanje" bestfitonrefresh="true" showcheckboxes="true" savelayout="true">
						<fields>
							<field name="Validan" caption="Validan" />
							<field name="Osoba" caption="Osoba" />
							<field name="Partner" caption="Partner" />
							<field name="Datum" caption="Datum" />
							<field name="Ocjena" caption="Ocjena" />
							<field name="statusNaziv" caption="Status" />
							<field name="MobitelPosl" caption="Mobitel (poslovni)" />
							<field name="Mobitel" caption="Mobitel (osobni)" />
							<field name="LNemail" caption="E-mail (poslovni)" />
							<field name="email" caption="E-mail (osobni)" />
							<field name="PSemail" caption="Tvrtkin e-mail" />
							<field name="Napomena" caption="Napomena" />
							<field name="ParStruAdresa" caption="Adresa partnera" />
							<field name="ParStruMjestaNaziv" caption="Mjesto partnera" />
						</fields>
						<menu>
							<menuitem caption="Izmijeni">
								<event type="click">
									<action type="form open" value="frmOsobaIzmjena">
										<parameter name="tekst" value="#grdOsobeSlanje.@Osoba" />
										<parameter name="LnOsoParId" value="#grdOsobeSlanje.@LnOsoParId" />
										<parameter name="OsobeId" value="#grdOsobeSlanje.@OsobeId" />
									</action>
									<action type="control populate keepfocus" value="#grdOsobeSlanje" />
									<action type="control disable" value="#btnPosalji" />
								</event>
							</menuitem>
							<menuitem caption="Pregled slanja iz ove aktivnosti">
								<event type="click">
									<action type="form open" value="frmPregledPoslanih">
										<parameter name="MarAktDetId" value="#grdOsobeSlanje.@Maraktdetid" />
										<parameter name="Osoba" value="#grdOsobeSlanje.@Osoba" />
										<parameter name="Partner" value="#grdOsobeSlanje.@Partner" />
										<parameter name="Indikator" value="1" />
									</action>
								</event>
							</menuitem>
							<menuitem caption="Pregled slanja iz svih aktivnosti">
								<event type="click">
									<action type="form open" value="frmPregledPoslanih">
										<parameter name="OsobeId" value="#grdOsobeSlanje.@OsobeId" />
										<parameter name="PartneriId" value="#grdOsobeSlanje.@PartneriId" />
										<parameter name="Osoba" value="#grdOsobeSlanje.@Osoba" />
										<parameter name="Partner" value="#grdOsobeSlanje.@Partner" />
										<parameter name="Indikator" value="2" />
									</action>
								</event>
							</menuitem>
						</menu>
						<event type="selectionchanged">
							<action type="variable value">
								<parameter name="global.SelectedIDs" value="#grdOsobeSlanje.selectedids" />
							</action>
							<action type="footer text" value="Broj slogova: {#grdOsobeSlanje.rowcount}  Broj označenih slogova: {#grdOsobeSlanje.selectedrowscount}" />
							<action type="control disable" value="#btnPosalji" />
							<action type="control enable" value="#btnValidiraj" if="global.$SelectedIDs!=null" />
							<action type="control disable" value="#btnValidiraj" else="" />
						</event>
						<!--
						<styles>
						<style name="fontcolor" value="green" if="#grdOsobeSlanje.@Validan=='Da'" />
						</styles>
						-->
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnValidiraj" caption="VALIDIRAJ" dock="left">
					<event type="click">
						<action type="variable value">
							<parameter name="ValidiraniIDs" value="global.$SelectedIDs" />
						</action>
						<action type="form open" value="frmMarKanal">
						</action>
						<action if="global.$MarKanalKod=='EM'||global.$MarKanalKod=='OLC'||global.$MarKanalKod=='COR'||global.$MarKanalKod=='XLS'||global.$MarKanalKod=='MSW'">
							<action type="datarun reader" value="~dtCheckValidate" if="global.$Close!=1" />
							<action type="control selectedrows" value="#grdOsobeSlanje" if="global.$Close!=1">
								<parameter value="~dtCheckValidate.@idniz" />
							</action>
							<action type="control populate" value="#grdOsobeSlanje" if="global.$Close!=1" />
							<action type="control enable" value="#btnPosalji" if="global.$IDs!=-1" />
							<action type="control disable" value="#btnPosalji" else="" />
							<action type="control enable" value="#btnValidiraj" if="global.$SelectedIDs!=null" />
							<action type="control disable" value="#btnValidiraj" else="" />
						</action>
						<!--
						<action if="global.$MarKanalKod=='MSW'||global.$MarKanalKod=='OLC'||global.$MarKanalKod=='COR'||global.$MarKanalKod=='XLS'">
						<action type="control enable" value="#btnPosalji" />
						</action>
						-->
					</event>
				</button>
				<button name="btnPosalji" caption="POŠALJI" dock="left">
					<event type="click">
						<action if="global.$MarKanalKod=='EM'">
							<action type="form open" value="frmOdabirEmail">
							</action>
						</action>
						<action if="global.$MarKanalKod=='MSW'||global.$MarKanalKod=='OLC'||global.$MarKanalKod=='COR'||global.$MarKanalKod=='XLS'">
							<action type="datarun nonquery" value="~dtUnosStatusa3" />
							<action type="method run" value="Send" waittype="progress" waitcaption="" waittext="Slanje u tijeku...">
								<parameter name="server" value="@@server" />
								<parameter name="datebase" value="@@database" />
								<parameter name="IDs" value="global.$SendId" />
								<parameter name="operatorID" value="@@operateriid" />
								<parameter name="code" value="global.$MarKanalKod" />
							</action>
						</action>
						<action type="control disable" value="#btnPosalji" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="variable value">
							<parameter name="global.$SelectedIDs" value="null" />
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktivnostiQuery" name="dtOsobeSlanje" if="$ValidiraniIDs!=null">
				<parameter name="@Action" value="6" />
				<parameter name="@Id" value="global.$MarAktivnostiId" />
				<parameter name="@Ids" value="global.$IDs" />
				<parameter name="@ValidiraniIds" value="$ValidiraniIds" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtOsobeSlanje" else="">
				<parameter name="@Action" value="5" />
				<parameter name="@Id" value="global.$MarAktivnostiId" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtCheckValidate">
				<parameter name="@Action" value="8" />
				<parameter name="@Ids" value="global.$IDs" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtCheckSve">
				<parameter name="@Action" value="7" />
				<parameter name="@Id" value="$MarAktivnostiId" />
			</data>
			<data command="spMarAktSendAzur" name="dtUnosStatusa3">
				<parameter name="@Action" value="5" />
				<parameter name="@IDs" value="global.$IDs" />
				<parameter name="@MarKanalKod" value="global.$MarKanalKod" />
				<parameter name="@SendId" value="global.$SendId" />
			</data>
			<!--
			<data command="spMarAktSendAzur" name="dtUnosStatusa">
			<parameter name="@Action" value="5" />
			<parameter name="@IDs" value="global.$IDs" />
			<parameter name="@MarKanalKod" value="global.$MarKanalKod" />
			<parameter name="@SendId" value="global.$SendId" />
			</data>
			-->
		</datalist>
		<form name="frmMarKanal" path="frmMarKanal.xml" />
		<form name="frmOsobaIzmjena" path="frmOsobaIzmjena.xml" />
		<form name="frmOdabirEmail" path="frmOdabirEmail.xml" />
		<form name="frmPregledPoslanih" path="frmPregledPoslanih.xml" />
	</form>
</root>
