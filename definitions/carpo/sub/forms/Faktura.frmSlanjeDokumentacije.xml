<root>
    <form name="frmSlanjeDokumentacije" caption="Slanje dokumentacije" fixedsize="false">	
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
				<group rows="3" cols="1" row="1" col="1" entermovenextcontrol="true">
                    <item caption="" row="1" col="1" >
                        <labeledit name="lblSlanjeDok" datavalue="" prefix="" value="Odabrali ste dokumente s različitim statusima slanja dokumentacije.\nMolim odabrati željenu akciju:" sufix="" multiline="true" fontsizedelta=""/>
                    </item>                    
					<item row="2" col="1" caption="">
                        <radioedit name="rdoSlanjeDok_Da" caption="Na svim dokumentima postavi DA." value="true" />
                    </item>
                    <item row="3" col="1" caption="">
                        <radioedit name="rdoSlanjeDok_Ne" caption="Na svim dokumentima postavi NE." value="false" />
                    </item>						
				</group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="PROMIJENI" type="add" dock="left">
                    <event type="click">
						<action type="variable value" if="#rdoSlanjeDok_Da==true">
							<parameter name="PoslanaDok" value="1" />
						</action>
						<action type="variable value" else="#rdoSlanjeDok_Ne==true">
							<parameter name="PoslanaDok" value="0" />
						</action>
						<action type="datarun nonquery" value="dtSlanjeDokumentacije"/>						
						<action type="form close"/>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
		<datalist>
			<data command="spProd_Fakture_PoslanaDokumentacija" name="dtSlanjeDokumentacije">
				<parameter name="@Idijevi" value="$Oznaceni" />
				<parameter name="@PoslanaDok" value="$PoslanaDok" />
			</data>

		</datalist>
    </form>


</root>