<root version="1.0.0.2">
	<form name="frmTemGlavaEdit" caption="Izmjena zaglavlja temeljnice" fixedsize="true">
		<event type="init"> 
			<action type="datarun reader" value="~dtGetGlava" />
		</event>
		<event type="shown">
			<action type="control focus" value="#txtBrojTem"/>		
			<action type="control refreshvalue" value="#txtBrojTem"/>
			<action type="control refreshvalue" value="#datTemDatum"/>				
		</event>
		<layout itemspadding="2">
			<group cols="2" rows="3" groupbordervisible="true">
				<columnsdefinition>
					<column size="60%" position="1" />
					<column size="40%" position="2" />	
				</columnsdefinition>
				<item col="1" row="1" caption="Broj:" colspan="2">
					<textedit name="txtBrojTem" required="true" datavalue="~dtGetGlava.@BrojDok"/>
				</item>
				<item col="1" row="2" caption="Datum:" >
					<dateedit  name="datTemDatum" required="true" value="" datavalue="~dtGetGlava.@DatumKnjizenja" minvalue="Global.$BlokadaOd" maxvalue="Global.$BlokadaDo">
						<!-- <event type="leave" raiseonload="false">
							<action type="control value" value="#datTemDatum" if="#datTemDatum&lt;Global.$BlokadaOd||#datTemDatum&gt;Global.$BlokadaDo">
								<parameter value="now"/>
							</action>
						</event> -->
					</dateedit>
				</item>
				<item col="1" row="3" colspan="2">
					<checkedit name="cheStavkeDatum" caption="Promijeni datum na stavkama"/>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="&amp;Spremi" dock="left">
					<event type="click">
                              <action type="validate"/>
						<action type="datarun scalar" value="~dtSaveGlava">
							<parameter name="parent.$Noviid" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntTemQuery" name="dtGetGlava">
				<parameter name="@action" value="1" />
				<parameter name="@Id" value="Global.$KntTemId" />
			</data>	
			<data command="spCKntTemIzmjeniZaglavlje" name="dtSaveGlava">
				<parameter name="@ID" value="Global.$KntTemId" />
				<parameter name="@BrojDok" value="#txtBrojTem" />
				<parameter name="@DatumKnjizenja" value="#datTemDatum" />
				<parameter name="@BlokadaOd" value="global.$BlokadaOd" />
				<parameter name="@BlokadaDo" value="global.$BlokadaOd" />
				<parameter name="@VrstaDokId" value="$VrstaDokId" />
				<parameter name="@StavkeDatum" value="1" if="#cheStavkeDatum==true"/>
			</data>	
		</datalist>
	</form>
</root>