<root>

  
  <form name="frmOSImovinaOP" caption="$Caption" fixedsize="false" width="450" >
    
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSImovinaOPId!=0"/>
    </event>
    <event type="onload">
      <action type="control disable" value="#datDatum" if="$OSImovinaOPId!=0" />
    </event>
    <event type="onshown">
      <action type="variable value">
        <parameter name="VarPromjenaGrupe" value="0" type="int"/>
      </action>
    </event>
    <layout textposition="left" >

      <group cols="1" rows="3" groupbordervisible="false">
        <group row="1" col="1" cols="1" rows="3" spacing="2,2,2,1">
          <item caption="Datum:" row="1" col="1" highlight="false">
            <dateedit name="datDatum"  value="now" datavalue="~dtGet.@Datum"   />
          </item>
          <!--cmb za grupu - pri izmjeni grupe pune se ostali podaci koji vrijede za grupu-->
          <item caption="Grupa:" row="2" col="1">
            <comboedit name="cmbGrupa" valuefield="OSGrupeId" displayfield="NazivGrupe" datavalue="~dtGet.@OSGrupeId" dataname="~dtGrupa" allownull="false">
              <!--na promjenu grupe puni formu-->
              <event type="valuechanged">
                <action type="datarun reader" value="~dtPodaciZaGrupu"  />
                <action type="control value" value="#txtRedovna"  >
                  <parameter value="~dtPodaciZaGrupu.@Redovna" />
                </action>
                <action type="control value" value="#txtUbrzana"  >
                  <parameter value="~dtPodaciZaGrupu.@Ubrzana" />
                </action>
                <action type="control value" value="#txtJednokratna"  >
                  <parameter value="~dtPodaciZaGrupu.@Jednokratna" />
                </action>
                <action type="control value" value="#txtUmanjena"  >
                  <parameter value="~dtPodaciZaGrupu.@Umanjena" />
                </action>
                <action type="control value" value="#srcNabava"  >
                  <parameter value="~dtPodaciZaGrupu.@KntNabaveId" text="~dtPodaciZaGrupu.@KontoN"/>
                </action>
                <action type="control value" value="#srcPriprema"  >
                  <parameter value="~dtPodaciZaGrupu.@KntPripremeId" text="~dtPodaciZaGrupu.@KontoP"/>
                </action>
                <action type="control value" value="#srcIspravak"  >
                  <parameter value="~dtPodaciZaGrupu.@KntIspravkaId" text="~dtPodaciZaGrupu.@KontoI"/>
                </action>
                <action type="control value" value="#srcTrosak"  >
                  <parameter value="~dtPodaciZaGrupu.@KntTroskaId" text="~dtPodaciZaGrupu.@KontoT"/>
                </action>
                <action type="variable value">
                  <parameter name="VarPromjenaGrupe" value="1" type="int"/>
                </action>
              </event>
            </comboedit>
          </item>
          <item caption="Tip stope:" row="3" col="1">
            <comboedit name="cmbStopaTip"  valuefield="StopaTip" displayfield="Naziv" datavalue="~dtGet.@StopaTip" dataname="~dtStopaTip" allownull="false"/>
          </item>
        </group>

        <!--stope amortizacije-->
        <group row="2" col="1" rows="4" cols="1" caption="Stope amortizacije"  spacing="2,2,1,1">
          <item caption="Redovna:"  row="1" col="1" >
            <textedit name="txtRedovna" datavalue="~dtGet.@Redovna" format="n2" nulltext="0,00" textposition="left"/>
          </item>
          <item caption="Ubrzana:"  row="2" col="1" >
            <textedit name="txtUbrzana" datavalue="~dtGet.@Ubrzana" format="n2" nulltext="0,00" textposition="left"/>
          </item>
          <item caption="Jednokratna:"  row="3" col="1" >
            <textedit name="txtJednokratna" datavalue="~dtGet.@Jednokratna" format="n2" nulltext="0,00" textposition="left"/>
          </item>
          <item caption="Umanjena:"  row="4" col="1" >
            <textedit name="txtUmanjena" datavalue="~dtGet.@Umanjena" format="n2" nulltext="0,00" textposition="left"/>
          </item>
        </group>

        <!--tražilice konta-->
        <group row="3" col="1" cols="1" rows="4" caption="Konta"  spacing="2,2,1,2">
          <item caption="Nabava:" col="1" row="1" >
            <searchedit name="srcNabava" fieldvalue="KntNabaveId" fieldtext="KontoN" dataname="dtNabava" datavalue="~dtGet.@KntNabaveId" datatext="~dtGet.@KontoN"/>
          </item>
          <item caption="Priprema:" col="1" row="2" >
            <searchedit name="srcPriprema" fieldvalue="KntPripremeId" fieldtext="KontoP" dataname="dtPriprema" datavalue="~dtGet.@KntPripremeId" datatext="~dtGet.@KontoP"/>
          </item>
          <item caption="Ispravak:" col="1" row="3" >
            <searchedit name="srcIspravak" fieldvalue="KntIspravkaId" fieldtext="KontoI" dataname="dtIspravak" datavalue="~dtGet.@KntIspravkaId" datatext="~dtGet.@KontoI"/>
          </item>
          <item caption="Trošak:" col="1" row="4" >
            <searchedit name="srcTrosak" fieldvalue="KntTroskaId" fieldtext="KontoT" dataname="dtTrosak" datavalue="~dtGet.@KntTroskaId" datatext="~dtGet.@KontoT"/>
          </item>
        </group>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" function="SpremiOP">
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSImovinaOPId!=0"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            

            <!-- MIJENJANJE GRUPE -->
            <action type="control refreshvalue" value="parent.#grdImovina" if="$VarPromjenaGrupe==1&amp;&amp;global.$filter==Filter imovine"/>
            <action type="control populate" value="parent.#tree" elseif="$VarPromjenaGrupe==1">
              <action type="control focus" value="parent.#tree">
                <parameter value="#cmbGrupa" type="int"/>
              </action>
              <!--sam je obavio osvježavanje mastera (i svih ostalih) -->
              <action type="control focus" value="parent.#grdImovina">
                <parameter value="$OSImovinaId" type="int"/>
              </action>  
            </action>
            <!-- MIJENJANJE SAMO STAVKE -->
            <action type="form close" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaOP_HelpCP" name="dtNabava">
        <parameter name="@Action" value="Konto_nabave"/>
        <parameter name="@Tekst" value="#srcNabava.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtPriprema">
        <parameter name="@Action" value="Konto_pripreme"/>
        <parameter name="@Tekst" value="#srcPriprema.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtIspravak">
        <parameter name="@Action" value="Konto_ispravka"/>
        <parameter name="@Tekst" value="#srcIspravak.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtTrosak">
        <parameter name="@Action" value="Konto_troska"/>
        <parameter name="@Tekst" value="#srcTrosak.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtStopaTip">
        <parameter name="@Action" value="Tip_stope"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtGrupa">
        <parameter name="@Action" value="Amortizacijska_grupa"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtGet">
        <parameter name="@Action" value="Popuni_izmjena"/>
        <parameter name="@OSImovinaOPId" value="$OSImovinaOPId"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtPodaciZaGrupu">
        <parameter name="@Action" value="Podaci_grupa"/>
        <parameter name="@OSGrupeId" value="#cmbGrupa.@OSGrupeId"/>
      </data>      
      <data command="spOSImovinaOP_AzurCP" name="dtEdit">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@OSImovinaOPId" value="$OSImovinaOPId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@Datum" value="#datDatum"/>
        <parameter name="@OSGrupeId" value="#cmbGrupa" />
        <parameter name="@StopaTip" value="#cmbStopaTip"/>
        <parameter name="@StopaRedovna" value="#txtRedovna" type="decimal"/>
        <parameter name="@StopaUbrzana" value="#txtUbrzana" type="decimal"/>
        <parameter name="@StopaJednokratna" value="#txtJednokratna" type="decimal"/>
        <parameter name="@KntNabaveId" value="#srcNabava"/>
        <parameter name="@KntPripremeId" value="#srcPriprema"/>
        <parameter name="@KntIspravkaId" value="#srcIspravak"/>
        <parameter name="@KntTroskaId" value="#srcTrosak"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@StopaUmanjena" value="#txtUmanjena" type="decimal"/>
      </data>
      <data command="spOSImovinaOP_AzurCP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@Datum" value="#datDatum"/>
        <parameter name="@OSGrupeId" value="#cmbGrupa" />
        <parameter name="@StopaTip" value="#cmbStopaTip"/>
        <parameter name="@StopaRedovna" value="#txtRedovna" type="decimal"/>
        <parameter name="@StopaUbrzana" value="#txtUbrzana" type="decimal"/>
        <parameter name="@StopaJednokratna" value="#txtJednokratna" type="decimal"/>
        <parameter name="@KntNabaveId" value="#srcNabava"/>
        <parameter name="@KntPripremeId" value="#srcPriprema"/>
        <parameter name="@KntIspravkaId" value="#srcIspravak"/>
        <parameter name="@KntTroskaId" value="#srcTrosak"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@StopaUmanjena" value="#txtUmanjena" type="decimal"/>
      </data>
    </datalist>
  </form>
  
</root>