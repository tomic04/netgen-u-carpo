<root>
<!--23.11.2022. AA omogućena izmjena Broja računa HD 75998-->
<form name="frmPregled" caption="Ulazni račun">
  <event type="init">
    <action type="datarun reader" value="~dtGet" />
  </event>
  <event type="shown">
    <action type="control value" value="#txtPovNaknada" if="#txtPovNaknada==null">
      <parameter value="0" />
    </action>
    <action type="control disable" value="#cmbVrstaKnjige,#srcPartner,#txtRacun" if="$EditDisabled==DA"/>
    <action type="control enable" value="#cmbVrstaKnjige,#srcPartner,#txtRacun" else=""/>
  </event>
  <layout>
    <group rows="3" cols="1" groupbordervisible="false">
      <group rows="3" cols="3" row="1" col="1" spacing="0,0,0,10">
        <item row="1" col="1" colspan="3" caption="Vrsta knjige:">
          <comboedit name="cmbVrstaKnjige" dataname="~dtComboVrstaKnjige" datavalue="~dtGet.@KntVrsteKnjigaUraId" valuefield="KntVrsteKnjigaUraId" displayfield="NazivKnjige"/>
        </item>
        <item row="2" col="1" caption="Model:">
          <textedit name="txtModel" datavalue="~dtGet.@Model" enabled="false"/>
        </item>
        <item row="2" col="2" colspan="2" caption="PNB:">
          <textedit name="txtPNB" datavalue="~dtGet.@ModelPNB" enabled="false"/>
        </item>
        <item row="3" col="1" caption="Datum dok.:">
          <dateedit name="dateDatDok" datavalue="~dtGet.@DatumDok" enabled="false"/>
        </item>
        <item row="3" col="2" caption="Datum DVO:">
          <dateedit name="dateDatDVO" datavalue="~dtGet.@DatumDVO" enabled="false"/>
        </item>
        <item row="3" col="3" caption="Valuta:">
          <dateedit name="dateDatValute" datavalue="~dtGet.@DatumVal" enabled="false"/>
        </item>
      </group>
      <group rows="1" cols="2" row="2" col="1" spacing="0,0,0,10">
        <columnsdefinition>
          <column size="70%" position="1" />
          <column size="30%" position="2" />
        </columnsdefinition>
        <item row="1" col="1" caption="Partner:">
          <searchedit name="srcPartner" datavalue="~dtGet.@SearchPartneriid" datatext="~dtGet.@Naziv" displaytext="Naziv" fieldtext="Naziv" fieldvalue="partneriid" dataname="~dtSearchPartneri"/>
        </item>
        <item row="1" col="2" caption="OIB:">
          <textedit name="txtOIB" datavalue="~dtGet.@SuplierOIB" enabled="false"/>
        </item>
        </group>
      <group rows="6" cols="3" row="3" col="1">
        <item row="1" col="1" colspan="2" caption="Račun:">
          <textedit name="txtRacun" datavalue="~dtGet.@FiskBr"/>
        </item>
        <item row="2" col="1" caption="Iznos računa(S PDV):" >
          <textedit  name="txtUkupnoSaPDV" datavalue="~dtGet.@UkupnoSaPDV" enabled="false" format="n2" textposition="left"/>
        </item>
        <item row="2" col="2" caption="Valuta:">
          <textedit  name="txtValuta" datavalue="~dtGet.@Valuta"  enabled="false"/>
        </item>
        <item row="3" col="1" caption="Osnovica 25%:">
          <textedit  name="txtOsnovica25" datavalue="~dtGet.@Osnovica25" enabled="false"/>
        </item>
        <item row="3" col="2" caption="Porez 25%:">
          <textedit  name="txtPorez25" datavalue="~dtGet.@Porez25" enabled="false"/>
        </item>
        <item row="4" col="1" caption="Osnovica 13%:">
          <textedit  name="txtOsnovica13" datavalue="~dtGet.@Osnovica13" enabled="false"/>
        </item>
        <item row="4" col="2" caption="Porez 13%:">
          <textedit  name="txtPorez13" datavalue="~dtGet.@Porez13" enabled="false"/>
        </item>
        <item row="5" col="1" caption="Osnovica 5%:">
          <textedit  name="txtOsnovica5" datavalue="~dtGet.@Osnovica5" enabled="false"/>
        </item>
        <item row="5" col="2" caption="Porez 5%:">
          <textedit  name="txtPorez5" datavalue="~dtGet.@Porez5" enabled="false"/>
        </item>
        <item row="6" col="1" caption="Neoporezivo:">
          <textedit  name="txtNeoporezivo" datavalue="~dtGet.@Neoporezivo" enabled="false"/>
        </item>
        <item row="6" col="2" caption="Pov. naknada:">
          <textedit  name="txtPovNaknada" datavalue="~dtGet.@PovNaknada" enabled="false"/>
        </item>
        <item row="6" col="3" caption="Pretporez ukupno:">
          <textedit name="txtPretporez" datavalue="~dtGet.@UkIznosPoreza" enabled="false"/>
        </item>
      </group>
    </group>
  </layout>
  <panelbuttons>
    <buttons>
      <button name="btnPrihvati" caption="Prihvati">
        <event type="click">
          <action type="datarun nonquery" value="~dtAzur" if="$EditDisabled!=DA"/>
          <action type="form close"/>
        </event>
      </button>
      <button name="btnOdustani" caption="Odustani" type="cancel"/>
    </buttons>
  </panelbuttons>
  <datalist>
    <data command="spKntMojERacunCombo" name="dtGet">
      <parameter name="@action" value="3"/>
      <parameter name="@id" value="$UraXMLId"/>
    </data>
    <data command="spKntMojERacunPregledUra" name="dtComboVrstaKnjige">
      <parameter name="@action" value="vrsteknjigaura"/>
    </data>
    <data command="spKntMojERacunPregledUra" name="dtSearchPartneri">
      <parameter name="@action" value="partneri"/>
      <parameter name="@uvjet" value="#srcPartner.text"/>
    </data>
    <data command="spKntMojERacunPregledUra" name="dtAzur">
      <parameter name="@action" value="azur"/>
      <parameter name="@UraXmlId" value="$UraXMLId"/>
      <parameter name="@KntVrsteKnjigaUraId" value="#cmbVrstaKnjige"/>
      <parameter name="@Partneriid" value="#srcPartner"/>
	  <parameter name="@Broj" value="#txtRacun"/>
    </data>
  </datalist>
</form>
</root>