<root>
	<form name="frmRazdoblje" caption="Odaberite razdoblje">
		<event type="load">
			<action type="datarun reader" value="~dtPrviDan" if="$IndDrugaGranula==1"/>	
			<action type="control value" value="#datRazOd" if="$IndDrugaGranula==1">
				<parameter value="~dtPrviDan.@prvidan" type="date"/>
			</action>
			<action type="control value" value="#datRazDo" if="$IndDrugaGranula==1">
				<parameter value="now" type="date"/>
			</action>
			<action type="control value" value="#datRazOd" if="$IndDrugaGranula==0">
				<parameter value="global.$DatumOd"/>
			</action>
			<action type="control value" value="#datRazDo" if="$IndDrugaGranula==0">
				<parameter value="global.$DatumDo"/>
			</action>			
		</event>
		<layout>
			<group cols="3" rows="1">
				<columnsdefinition>
					<column size="100" position="1"/>
					<column size="130" position="2"/>
					<column size="130" position="3"/>
				</columnsdefinition>
				<item col="1" row="1">
					<button name="btnRazdIzbor" caption="Razdoblje">
						<dropdownitem caption="Ovaj tjedan">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="1"/>
								</action>							
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>
							</event>
						</dropdownitem>
						<dropdownitem caption="Ovaj mjesec">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="2"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>							
							</event>						
						</dropdownitem>
						<dropdownitem caption="Ovaj kvartal">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="3"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>								
							</event>						
						</dropdownitem>
						<dropdownitem caption="Ovo polugodište">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="4"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>								
							</event>						
						</dropdownitem>
						<dropdownitem caption="Ova godina">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="5"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>		
							</event>								
						</dropdownitem>
						<dropdownitem caption="Prošli tjedan">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="6"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>								
							</event>						
						</dropdownitem>
						<dropdownitem caption="Prošli mjesec">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="7"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>						
							</event>						
						</dropdownitem>
						<dropdownitem caption="Prošli kvartal">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="8"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>								
							</event>						
						</dropdownitem>
						<dropdownitem caption="Prošlo polugodište">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="9"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>								
							</event>						
						</dropdownitem>
						<dropdownitem caption="Prošla godina">
							<event type="click">
								<action type="variable value">
									<parameter name="Datum" value="10"/>
								</action>
								<action type="datarun reader" value="~dtTjedan"/>
								<action type="control value" value="#datRazOd">
									<parameter value="~dtTjedan.@prvidan"/>
								</action>
								<action type="control value" value="#datRazDo">
									<parameter value="~dtTjedan.@zadnjidan"/>
								</action>															
							</event>						
						</dropdownitem>						
					</button>
				</item>
				<item col="2" row="1" caption="Od:" textposition="left">
					<dateedit name="datRazOd"/>
				</item>
				<item col="3" row="1" caption="Do:" textposition="left">
					<dateedit name="datRazDo"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons> 
				<button name="btnUredu" caption="U redu">
					<event type="click">
						<action type="variable value">
							<parameter name="global.$DatumOd" value="#datRazOd"/>
							<parameter name="global.$DatumDo" value="#datRazDo"/>
						</action>
						<action type="datarun nonquery" value="~dtDelete"/>
						<action type="control populate" value="parent.#grdGlavni"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="Odustani"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDelete" command="spCKntKarticaKonta">
				<parameter name="@Action" value="6"/>
			</data>
			<data name="dtTjedan" command="spCKntKarticaKonta">
				<parameter name="@Action" value="12" if="$Datum==1"/>
				<parameter name="@Action" value="14" if="$Datum==2"/>
				<parameter name="@Action" value="15" if="$Datum==3"/>
				<parameter name="@Action" value="16" if="$Datum==4"/>
				<parameter name="@Action" value="13" if="$Datum==5"/>
				<parameter name="@Action" value="17" if="$Datum==6"/>
				<parameter name="@Action" value="18" if="$Datum==7"/>
				<parameter name="@Action" value="19" if="$Datum==8"/>
				<parameter name="@Action" value="20" if="$Datum==9"/>
				<parameter name="@Action" value="21" if="$Datum==10"/>
			</data>
			<data type="text" name="dtPrviDan" command="select dateadd(yy,datediff(yy,0,getdate()),0) as prvidan"/>
		</datalist>
	</form>
</root>