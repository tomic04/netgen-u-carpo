					<!--primi ID-->
					<!--zatvori-->
					<!--proslijedi child formi id i startaj formu-->
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="spremanje dokumenta..." sleep="2000">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDataInsert" if="$NabPriGlaId==null">
							<parameter name="NabPriGlaId" value="$NabPriGlaId"/>
						</action>
						<action type="control populate" value="parent.#grdGlava">
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$NabPriGlaId" />
							</action>
						</action>

						<!-- zaključaj insertani dokument na trenutnog operatera						 -->
						<action type="variable value" value="Global.$OperaterLockId">
							<parameter value="$NabPriGlaId" />
						</action>
						<action type="form close"/>
						
                        <!-- nakon inserta otvori editFormu sa dodatnim gridom i tabovima -->					
						<action type="form open" value="frmPriListKalEdit">
							<parameter name="NabPriGlaId" value="$NabPriGlaId"/>
							<parameter name="VrstaDokId" value="$VrstaDokId"/>
							<parameter name="UFADatumDok" value="$UFADatumDok"/>
						</action>
                    </event>
								
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
