<root version="1.0.0.1">
	<form name="frmURA" type="master" caption="Dokument: '{$BrojDok}', od datuma: '{$DatumDok}',URA br.: '{$URA}'" width="800" height="600" statusbar="false">
		<event type="init"> 
		</event>
		<event type="load">	
			<action type="control populate" value="#grdTemStavke"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdTemStavke" multiselect="true" key="KntTemId" showgrouppanel="true" showfooter="false" savelayout="true">												
							<data command="spC_Robno_StatusUlDok">
								<parameter name="@action" value="stavke_temeljnice"/>
								<parameter name="@KntTemId" value="$KntTemId" type="int"/>
							</data>							
								<fields>	
								<field name="KntPrometId" caption="KntPrometId" fixwidth="50" hidden="true"/>
								<field name="Konto" caption="Konto" fixwidth="50"/>
								<field name="Naziv" caption="Naziv" fixwidth="150"/>
								<field name="Opis" caption="Opis" fixwidth="100" />
								<field name="duguje" caption="Duguje" showsum="true" fixwidth="100"/>
								<field name="potrazuje" caption="Potražuje" showsum="true" fixwidth="100"/>
								<field name="Broj" caption="Račun" fixwidth="100"/>
								<field name="DatumDokumenta" caption="DatumDok" fixwidth="100"/>
								<field name="Ufa" caption="Ufa" fixwidth="40"/>
								<field name="OrgShemaNaziv" caption="Org. shema" />
								<field name="NacinPlac" caption="Način pl." />
								<field name="devdug" caption="DevDug" fixwidth="100"/>
								<field name="devpot" caption="DevPot" fixwidth="100"/>
								<field name="Valuta" caption="Valuta"/>
								<field name="Dimenzija" caption="Dimenzija" fixwidth="40"/>
								<field name="Inicijali" caption="Operater" fixwidth="40"/>
								<field name="DatumUnosa" caption="Datum unosa" fixwidth="100"/>						
							</fields>		
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="IZLAZ" type="cancel" dock="left">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>	

			</buttons>
		</panelbuttons>

	</form>
</root>