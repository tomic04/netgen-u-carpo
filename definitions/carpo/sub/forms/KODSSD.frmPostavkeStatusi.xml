<root>

  <form name="frmPostavkeStatusi" caption ="$caption" width="400"  height="250" fixedsize="false" saveformsize="false">

    <layout>
      <group cols="1" rows="3" groupbordervisible="false">
        <item caption="Kopiraj sa statusa:" col="1" row="1" highlight="false" colspan="4" >
          <comboedit name="cmbStatusi" dataname="~dtStavka" required="true" displayfield="naziv" valuefield="HRDopStatusiId"/>
        </item>
        <item col="1" row="2"  highlight="False" >
          <checkedit caption="JOPPD kombinacije" name="chkJOPPDkombinacije" />
        </item>
        <item col="1" row="3"  highlight="False">
          <checkedit name="chkDoprinose" caption="Doprinose"/>
        </item>
        
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnKopiraj" caption="Kopiraj">
          <event type="click">
            <action type="validate"/>
            <action type="datarun reader" value="~dtKopiraj"/>
            <action type="message" value="~dtKopiraj.@Poruka" />
            <action type="control populate" value="parent.#grdStatusi"/>
          </event>
          <action type="form close" />
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOOPSSDHRDopStatusiQuery" name="dtStavka">
        <parameter name="@action" value="cmb_izvorni_statusi"/>
        <parameter name="@hrdopstatusiid" value="$HRDopStatusiId"/>
      </data>
      <data command="spOOPSSDHRDopStatusiAzur" name="dtKopiraj">
        <parameter name="@action" value="Kopiranje_postavke"/>
        <parameter name="@hrdopstatusiid" value="$HRDopStatusiId"/>
        <parameter name="@hrdopstatusi2id" value="#cmbStatusi"/>
        <parameter name="@chkDoprinosi" value="#chkDoprinose"/>
        <parameter name="@chkJOPPDKombinacije" value="#chkJOPPDkombinacije"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>

  </form>
</root>