<root>
	<form name="frmKupUnos" caption="Unos dokumenta" width="370" height="530">
		<event type="init">
			<action type="datarun reader" value="~dtPubVars" />
		</event>
		<event type="onload">
			<action type="variable value" value="FilterInd">
                <parameter value="parent.$FilterInd" />
            </action>
            <action type="control disable" value="#srcParstru" if="~dtPubVars.@VarSet==0">
            </action>
            <action type="control visible" value="#btnParstru" if="~dtPubVars.@Varset==0">
            	<parameter value="false" />
            </action>
			<action type="control visible" value="#srcParStru" if="~dtPubvars.@VarSet==1">  
            </action>
			<action type="control visible" value="#btnParstru" if="~dtPubvars.@Varset==1">
                <parameter value="false" />
            </action>
            <action type="control disable" value="#btnParstru" if="~dtPubVars.@Varset==2">

            </action>
            <action type="control visible" value="#srcParstru" if="~dtPubVars.@Varset==2">
            	<parameter value="false" />
            </action>

			<action type="control value" value="#cmbVrsta">
				<parameter value="2" />
			</action>
		</event>
		<event type="onshown">
			<action type="control focus" value="#srcOsobe" />
			<action type="control disable" value="#datVrijedido" />
		</event>
	
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<group cols="1" rows="10" col="1" row="1" backgroundcolor="#f5f5f5" groupbordervisible="False">
					<rowsdefinition>
						<row position="8" size="35" />
					</rowsdefinition>
					<part name="manageratributi" path="prtManager.xml" />
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="Unesi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtZahtjevUnos">
							<parameter name="KupUgovoriGlaId"  />
						</action>
						<action type="variable value" value="Global.$OperaterLockId">
							<parameter value="$KupUgovoriGlaId" />
						</action>
						<action type="control populate" value="parent.#tree"/>-->
						<action type="control focus" value="parent.#tree">
							<parameter value="#srcPartner"/>
						</action>
						<action type="form close"/>
						<action type="form open" value="frmKupIzmjena" >
							<parameter value="$KupUgovoriGlaId" name="KupUgovoriGlaId" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_KupUgoUnos_Unos" name="dtZahtjevUnos">
				<parameter name="@Broj" value="#txtBroj" />
				<parameter name="@KupUgovoriVrsteId" value="#cmbVrsta" />
				<parameter name="@DatumUgovora" value="#datDatum" />
				<parameter name="@UgovorVrijediDo" value="#datVrijedido" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@OsobeId" value="#srcOsobe" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@ParStruId" value="#srcParstru" />
				<parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@dinamikaFak" value="#cmbDinFak" />
			</data>	
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
				<data command="spProd_KupUgovori_PuniVrstu" name="dtGetVrsta" />
			</data>
			<data command="spPubVarsQuery" name="dtPubVars">
				<parameter name="@Action" value="2" />
				<parameter name="@VarIme" value="KupUgovoriParsTru" />
				<parameter name="@Id" value="null" />
			</data>
		</datalist>
	</form>
</root>



