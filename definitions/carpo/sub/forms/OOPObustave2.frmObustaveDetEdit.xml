<root>
  <form name="frmObustaveDetEdit"  caption="$caption" width="670" height="600" saveformsize="false" fixedsize="true"  >

    <event type="init">
      <action type="datarun reader" value="~dtPodaciObustava"/>
      <action type="datarun reader" value="~dtGet" if="$OOPObustaveDetId!=0"/>
    </event>

    <event type="load">
      <action type="control value" value="#rdoOtvorena,#rdoIznos">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#rdoZatvorena,#rdoPostotak">
        <parameter value="false"/>
      </action>


      <action if="$OOPObustaveDetId!=0">
        <action type="control value" value="#rdoZatvorena">
          <parameter value="~dtGet.@rdoZatvorena"/>
        </action>
        <action type="control value" value="#rdoOtvorena">
          <parameter value="~dtGet.@rdoOtvorena"/>
        </action>
        <action type="control value" value="#rdoIznos">
          <parameter value="~dtGet.@rdoIznos"/>
        </action>
        <action type="control value" value="#rdoPostotak">
          <parameter value="~dtGet.@rdoPostotak"/>
        </action>
      </action>
      
      <!--izmjena-->
      <action if="$OOPObustaveDetId!=0">
        <action type="control disable" value="#srcRadnik,#chkSvi,#txtZaduzenje,#txtUplata,#cmbValuta"/>
        <action type="control enable" value="#rdoOtvorena,#rdoZatvorena"/>
      </action>

      <!--unos-->
      <action if="$OOPObustaveDetId==0">
        <action type="control enable" value="#srcRadnik,#chkSvi,#txtZaduzenje,#txtUplata,#cmbValuta"/>
        <action type="control disable" value="#rdoOtvorena,#rdoZatvorena,#btnPromet"/>
      </action>

      <!--<action type="control disable" value="#srcRadnik,#chkSvi,#txtZaduzenje,#txtUplata,#cmbValuta" if="$OOPObustaveDetId!=0"/>
      <action type="control enable" value="#srcRadnik,#chkSvi,#txtZaduzenje,#txtUplata,#cmbValuta" elseif="$OOPObustaveDetId==0"/>-->
    </event>
    
    <event type="shown">


      <action if="#rdoIznos==true">
        <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
          <parameter value="true"/>
        </action>
        <action type="control visible" value="#txtPostotak,#cmbOsnovica">
          <parameter value="false"/>
        </action>
      </action>
      <action if="#rdoPostotak==true">
        <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
          <parameter value="false"/>
        </action>
        <action type="control visible" value="#txtPostotak,#cmbOsnovica">
          <parameter value="true"/>
        </action>
      </action>

      
    </event>

    <layout>
      <group rows="11" cols="4" groupbordervisible="false" spacing="2" textposition="top">
        <columnsdefinition>
          <column position="1" size="25%" />
          <column position="2" size="25%" />
          <column position="3" size="25%" />
          <column position="4" size="25%" />
        </columnsdefinition>
        <item caption="Obustava:" col="1" row="1" colspan="4" textposition="top" highlight="false">
          <textedit name="txtObustava" datavalue="~dtPodaciObustava.@Obustava" enabled="false" />
        </item>
        <item caption="Radnik" col="1" row="2" colspan="3" highlight="false" textposition="left">
          <searchedit name="srcRadnik" dataname="dtRadnik" fieldtext="DjelatnikNazivId" fieldvalue="HRKadroviId"  required="true" datatext="~dtGet.@DjelatnikNazivId" datavalue="~dtGet.@HRKadroviId"/>
        </item>
        <item col="4" row="2" highlight="false">
          <checkedit caption="Svi" name="chkSvi" value="false"  tooltip="Uključi neaktivne djelatnike u pretragu"/>
        </item>
        <item caption="Obračun na:" col="1"  row="3" colspan="2" textposition="top"  highlight="false" >
          <comboedit name="cmbVrstaObrade"  valuefield="OOPObradeVrsteId" displayfield="Naziv" dataname="~dtOOPObradeVrste" required="false" allownull="true" datavalue="~dtGet.@OOPObradeVrsteId" >
          </comboedit>
        </item>
        <item caption="Partija:" col="3" row="3" colspan="2" textposition="top" highlight="false">
          <textedit name="txtPartija" datavalue="~dtGet.@Partija" allownull="false" value=" "/>
        </item>
        <item caption="Zaduženje:" col="1" row="4" colspan="2" textposition="top" highlight="false">
          <textedit name="txtZaduzenje" datavalue="~dtGet.@Zaduzenje" format="n2" allownull="false" value="0">
            <event type="leave">
              <action type="control value" value="#txtZaduzenje" if="#txtZaduzenje==null">
                <parameter value="0"/>
              </action>
              <action type="datarun reader" value="~dtSaldo">
              </action>
              <action type="control value" value="#txtSaldo">
                <parameter value="~dtSaldo.@rezultat"/>
              </action>
            </event>
          </textedit>
        </item>

        <item caption="Valuta:" col="3" row="4" colspan="2" textposition="top" highlight="false">
          <comboedit name="cmbValuta"  valuefield="OOPValuteId" displayfield="NazivText" dataname="~dtOOPValute" required="true" allownull="false" datavalue="~dtGet.@OOPValuteId" >
          </comboedit>
        </item>
        <item caption="Uplata:" col="1" row="5" colspan="2" textposition="top" highlight="false">
          <textedit name="txtUplata" datavalue="~dtGet.@Uplata" format="n2" allownull="false" value="0">
            <event type="leave">
              <action type="control value" value="#txtUplata" if="#txtUplata==null">
                <parameter value="0"/>
              </action>
              <action type="datarun reader" value="~dtSaldo">
              </action>
              <action type="control value" value="#txtSaldo">
                <parameter value="~dtSaldo.@rezultat"/>
              </action>
            </event>
          </textedit>
        </item>
        <item caption="Ostatak duga/Saldo:" col="3" row="5" colspan="2" textposition="top" highlight="false">
          <textedit name="txtSaldo" datavalue="~dtGet.@Saldo" format="n2" enabled="false" allownull="false" value="0"/>
        </item>
        <item caption="Vrsta obroka:" col="1" row="6"  textposition="top" highlight="false">
          <radioedit  caption="Iznos" name="rdoIznos" groupindex="1" datavalue="~dtGet.@rdoIznos" value="true" >
            <event type="valuechanged">
              <action if="#rdoIznos==true">
                <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
                  <parameter value="true"/>
                </action>
                <action type="control visible" value="#txtPostotak,#cmbOsnovica">
                  <parameter value="false"/>
                </action>
              </action>
              <action if="#rdoIznos==false">
                <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
                  <parameter value="false"/>
                </action>
                <action type="control visible" value="#txtPostotak,#cmbOsnovica">
                  <parameter value="true"/>
                </action>
              </action>
            </event>
          </radioedit>
        </item>
        <item caption=" " col="2" row="6"  textposition="top" highlight="false">
          <radioedit  caption="Postotak" name="rdoPostotak" groupindex="1" datavalue="~dtGet.@rdoPostotak"  value="false">
            <event type="valuechanged">
              <action if="#rdoPostotak==false">
                <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
                  <parameter value="true"/>
                </action>
                <action type="control visible" value="#txtPostotak,#cmbOsnovica">
                  <parameter value="false"/>
                </action>
              </action>
              <action if="#rdoPostotak==true">
                <action type="control visible" value="#txtPrviObrok,#txtOstaliObroci,#txtKorekcija">
                  <parameter value="false"/>
                </action>
                <action type="control visible" value="#txtPostotak,#cmbOsnovica">
                  <parameter value="true"/>
                </action>
              </action>
            </event>
          </radioedit>
        </item>
        <group col="1" row="7" cols="4" rows="1" colspan="4" groupbordervisible="true" >
          <item caption="Prvi obrok:" col="1" row="1" colspan="1" textposition="top" highlight="false">
            <textedit name="txtPrviObrok" datavalue="~dtGet.@PrviObrok" format="n2"  allownull="false" value="0"/>
          </item>
          <item caption="Ostali obroci:" col="2" row="1" colspan="1" textposition="top" highlight="false">
            <textedit name="txtOstaliObroci" datavalue="~dtGet.@OstaliObroci" format="n2" allownull="false" value="0"/>
          </item>
          <item caption="Korekcija zad. obroka (%):" col="3" row="1" colspan="1" textposition="top" highlight="false">
            <textedit name="txtKorekcija" datavalue="~dtGet.@KorekcijaObroka" format="n2" allownull="false" value="0"/>
          </item>
          <item caption="" col="4" row="1" colspan="1" textposition="top" highlight="false">
            <button name="btnKalkulator" caption="Kalkulator">
              <event type="click">
                <!--<action type="message" value="kalkulator!!!!"/>-->
                <action type="form open" value="frmKalkulator">
                  <parameter name="caption"  value="Kalkulator obroka" type="string" />
                  <parameter name="OOPObustaveDetId" value="$OOPObustaveDetId"  type="int"/>
                  <parameter name="saldo" value="#txtSaldo"  type="decimal"/>
                  <!--prosljeđujem da zna koja verzija obustava (1 ili 2) šalje, za potrebe povrata informacije (prvi obrok/ostai obroci)-->
                  <parameter name="tip" value="2"  type="integer"/>
                </action>
              </event>
            </button>
          </item>


          <item caption="Iznos postotka:" col="1" row="1" colspan="1" textposition="top" highlight="false">
            <textedit name="txtPostotak" datavalue="~dtGet.@Postotak" format="n2"  allownull="false" value="0"/>
          </item>
          <item caption="Osnovica:" col="2" row="1" colspan="2" textposition="top" highlight="false">
            <comboedit name="cmbOsnovica"  valuefield="OOPOsnoviceId" displayfield="NazivText" dataname="~dtOOPOsnovice" required="false" allownull="false" datavalue="~dtGet.@OOPOsnoviceId" >
            </comboedit>
          </item>
          
        </group>

        <item caption="Početak obračuna:" col="1" row="8" colspan="1" textposition="top" highlight="false">
          <dateedit name="txtMjesecPoc" datavalue="~dtGet.@MjesecPoc" value="now" format="mmyyyy" allownull="false" required="true"/>
        </item>
        <item caption="Kraj obračuna:" col="2" row="8" colspan="1" textposition="top" highlight="false">
          <dateedit name="txtMjesecZav" datavalue="~dtGet.@MjesecZav" value="now" format="mmyyyy" checked="false" allownull="true"/>
        </item>
        <item caption="Prioritet:" col="3" row="8" colspan="1" textposition="top" highlight="false">
          <textedit name="txtPrioritet" datavalue="~dtGet.@Prioritet" format="n0" value="0" required="true"/>
        </item>
        <item caption="Status:" col="1" row="9"  colspan="1" textposition="top" highlight="false">
          <radioedit  caption="Otvorena" name="rdoOtvorena" groupindex="2" datavalue="~dtGet.@rdoOtvorena">
          </radioedit>
        </item>
        <item caption=" " col="2" row="9"  colspan="1" textposition="top" highlight="false">
          <radioedit  caption="Zatvorena" name="rdoZatvorena" groupindex="2" datavalue="~dtGet.@rdoZatvorena">
          </radioedit>
        </item>
        
      </group>
    </layout>

    <!--gumbi-->

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <!--<action type="message" value="TEST!!:{$OOPObustaveDetId}"/>-->
            <!--izmjena-->
            <action if="$OOPObustaveDetId!=0">
              <!--<action type="message" value="IZMJENA!!!!"/>-->
              <action type="datarun reader" value="~dtEdit"/>
              <action type="form close"/>
              <action type="control populate" value="parent.#grdDet"/>
            </action>

            <!--<action type="message" value="$OOPObustaveDetId"/>-->
            <!--unos-->
            <action if="$OOPObustaveDetId==0">
              <!--<action type="message" value="UNOS!!!!"/>-->
              <action type="datarun reader" value="~dtUnos"/>
              <action type="form close"/>
              <action type="control populate" value="parent.#grdDet"/>
            </action>
          </event>
        </button>

        <button name="btnOdustani" caption="Odustani" type="cancel"/>
        
        <button name="btnPromet" caption="Promet">
          <event type="click">
            <action type="form open" value="frmObustavaPromet">
              <parameter name="caption"  value="Promet obustave - {parent.#grdDet.@Djelatnik} - {$Obustava}" type="string" />
              <parameter name="OOPObustaveDetId" value="$OOPObustaveDetId"  type="int"/>
            </action>
            <action type="datarun reader" value="~dtGet" if="$OOPObustaveDetId!=0"/>
            <action type="control refreshvalue" value="#txtZaduzenje,#txtUplata" />
            <action type="control populate keepfocus" value="parent.#grdDet"></action>
          </event>
        </button>
      </buttons>

    </panelbuttons>

    <!--datalist-->

    <datalist>


      <data command="spOOPObustaveHelpCP" name="dtSaldo">
        <parameter name="@action" value="izracunaj_saldo" type="string"/>
        <parameter name="@zaduzenje" value="#txtZaduzenje" type="decimal"/>
        <parameter name="@uplata" value="#txtUplata" type="decimal"/>
      </data>

      <data command="spOOPObustaveHelpCP" name="dtPodaciObustava">
        <parameter name="@action" value="daj_obustavu" type="string"/>
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId" type="int"/>
      </data>
      <data command="spOOPObustaveHelpCP" name="dtRadnik">
        <parameter name="@action"  value="trazi_djelatnika" />
        <parameter name="@svi"  value="#chkSvi" />
        <parameter name="@tekst"  value="#srcRadnik.text" />
      </data>

      <data command="spOOPObustaveHelpCP" name="dtOOPObradeVrste">
        <parameter name="@action"  value="cmb_OOPObradeVrste" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtOOPValute">
        <parameter name="@action"  value="cmb_OOPValute" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtOOPOsnovice">
        <parameter name="@action"  value="cmb_OOPOsnovice" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtGet">
        <parameter name="@action" value="dtGet_detalj2" type="string"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
      </data>

      <data command="spOOPObustaveDetAzur2" name="dtUnos">
        <parameter name="@action" value="0" type="int"/>
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId" type="int"/>
        <parameter name="@hrkadroviid" value="#srcRadnik" />
        <parameter name="@OOPValuteId" value="#cmbValuta"/>
        <parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade"/>
        <parameter name="@Partija" value="#txtPartija"/>
        <parameter name="@Zaduzenje" value="#txtZaduzenje" type="decimal"/>
        <parameter name="@VrstaObroka" value="I" if="#rdoIznos==true"/>
        <parameter name="@VrstaObroka" value="P" if="#rdoPostotak==true"/>        
        <parameter name="@PrviObrok" value="#txtPrviObrok" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@PrviObrok" value="0" type="decimal" if="#rdoPostotak==true"/>        
        <parameter name="@OstaliObroci" value="#txtOstaliObroci" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@OstaliObroci" value="0" type="decimal" if="#rdoPostotak==true"/>        
        <parameter name="@KorekcijaObroka" value="#txtKorekcija" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@KorekcijaObroka" value="0" type="decimal" if="#rdoPostotak==true"/>        
        <parameter name="@MjescePoc" value="#txtMjesecPoc" type="date"/>
        <parameter name="@MjesecZav" value="#txtMjesecZav" type="date"/>        
        <parameter name="@Postotak" value="#txtPostotak" type="decimal" if="#rdoPostotak==true"/>
        <parameter name="@Postotak" value="0" type="decimal" if="#rdoIznos==true"/>        
        <parameter name="@OOPOsnoviceId" value="#cmbOsnovica" if="#rdoPostotak==true"/>
        <parameter name="@OOPOsnoviceId" value="null" if="#rdoIznos==true"/>        
        <parameter name="@Prioritet" value="#txtPrioritet" type="int"/>
        <parameter name="@Uplata" value="#txtUplata" type="decimal"/>
        <parameter name="@Operater" value="@@OperateriId"/>
        <parameter name="@Status" value="0" if="#rdoOtvorena==true" type="int"/>
        <parameter name="@Status" value="1" if="#rdoZatvorena==true" type="int"/>

      </data>

      <data command="spOOPObustaveDetAzur2" name="dtEdit">
        <parameter name="@action" value="1" type="int"/>
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId" type="int"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>

        <parameter name="@hrkadroviid" value="#srcRadnik" />
        <parameter name="@OOPValuteId" value="#cmbValuta"/>
        <parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade"/>
        <parameter name="@Partija" value="#txtPartija"/>
        <parameter name="@Zaduzenje" value="#txtZaduzenje" type="decimal"/>
        <parameter name="@VrstaObroka" value="I" if="#rdoIznos==true"/>
        <parameter name="@VrstaObroka" value="P" if="#rdoPostotak==true"/>
        <parameter name="@PrviObrok" value="#txtPrviObrok" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@PrviObrok" value="0" type="decimal" if="#rdoPostotak==true"/>
        <parameter name="@OstaliObroci" value="#txtOstaliObroci" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@OstaliObroci" value="0" type="decimal" if="#rdoPostotak==true"/>
        <parameter name="@KorekcijaObroka" value="#txtKorekcija" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@KorekcijaObroka" value="0" type="decimal" if="#rdoPostotak==true"/>
        <parameter name="@MjescePoc" value="#txtMjesecPoc" type="date"/>
        <parameter name="@MjesecZav" value="#txtMjesecZav" type="date"/>
        <parameter name="@Postotak" value="#txtPostotak" type="decimal" if="#rdoPostotak==true"/>
        <parameter name="@Postotak" value="0" type="decimal" if="#rdoIznos==true"/>
        <parameter name="@OOPOsnoviceId" value="#cmbOsnovica" if="#rdoPostotak==true"/>
        <parameter name="@OOPOsnoviceId" value="null" if="#rdoIznos==true"/>
        <parameter name="@Prioritet" value="#txtPrioritet" type="int"/>
        <parameter name="@Uplata" value="#txtUplata" type="decimal"/>
        <parameter name="@Operater" value="@@OperateriId"/>
        <parameter name="@Status" value="0" if="#rdoOtvorena==true" type="int"/>
        <parameter name="@Status" value="1" if="#rdoZatvorena==true" type="int"/>
      </data>

    </datalist>


  </form>
</root>
