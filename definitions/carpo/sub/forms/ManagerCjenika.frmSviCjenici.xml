<!-- radio na Jupiter2019 Spin2 -->
<root>
	<form name="frmSviCjenici" caption="Prikaz cijene na svim cjenicima" width="800" height="400">
		<event type="init">
		</event>
		<event type="load">

		</event>
		<event type="shown">
			<action type="control value" value="srcRoba">
				<parameter value="$RobaId" text="$RobaNaziv"/>
			</action>
		</event>
		<layout>
			<group cols="2" rows="3">
				
				<item caption="Roba:" row="1" col="1" fontbold="" textalignmode="left"  textposition="left">
					<searchedit netgenfields="true" required="true" name="srcRoba" fontsizedelta="1"
								fontbold="True" dataname="dtRoba" fieldtext="NazivId" fieldvalue="robaid"
								entermovenextcontrol="false" datavalue="~dtDetquery.@RobaId" datatext="~dtDetquery.@RobaNaziv" >
						<event type="valuechanged">

						</event>
					</searchedit>
				</item>
				<item caption="Datum:" row="2" col="1" textalignmode="left" textposition="left">
					<dateedit name="datDatumOd" value="now"/>
				</item>
				<group row="1" col="2" cols="3" rows="1" >
					<columnsdefinition>
						<column size="200" position="1" />
						<column size="100" position="2" />
						<column size="100" position="3" />
					</columnsdefinition>
					<item row="1" col="1" textvisible="False">
						<button name="btnPokazi" caption="Pokaži">
							<event type="click">
								<action type="datarun reader" value="dtGetCijene"/>
								<action type="control populate" value="#grdSviCjenici" />
							</event>
						</button>
					</item>
				</group>
				<item row="3" col="1" colspan="2">
					<grid name="grdSviCjenici" dataname="~dtGetCijene" bestfitonrefresh="true" multiselect="true">
						<fields>
							<field name="Cjenik" caption="Cjenik" />
							<field name="VPCNetto" caption="VP Netto cijena" />
							<field name="VPCBrutto" caption="VP Brutto cijena" />
							<field name="NabavnaCijena" caption="Nabavna cijena" />
							<field name="FakturnaCijena" caption="Fakturna cijena" />
							<field name="MPCijenaKn" caption="MP cijena" />
							
						</fields>
						
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" caption="Zatvori">
					<event type="click">
						<action type="form close">
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>

			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba"/>
				<parameter name="@Uvjet" value="#srcRoba.text"/>
				<parameter name="@PokaziVPCijene" value="0"/>
				<parameter name="@PokaziNabCijene" value="0"/>
				<parameter name="@Retired" value="0"/>
				<parameter name="@Prikazi_Dodatno" value="0"/>
				<parameter name="@PokaziStanje" value="0"/>
				<parameter name="@SkladisteId" value=""/>
			</data>
			
			<data command="spNG_Combo" name="dtGetSkladiste">
				<parameter name="@Action" value="skladiste" />
				<parameter name="@Ind" value="1" />
			</data>
			
			<data command="spProd_Cjenik_SviCjenici" name="dtGetCijene">
				<parameter name="@RobaId" value="#srcRoba" />
				<parameter name="@Datum" value="#datDatumOd" />
			</data>

		</datalist>

	</form>
</root>