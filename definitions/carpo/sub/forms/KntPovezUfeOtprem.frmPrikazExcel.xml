<root version="1.0.0.1">
<!-- u layout formi ne mora biti type master -->
<!-- pozivanje frome iz drugog xmla paziti na ime forme -->
	<form name="frmPrikazExcel" caption="Excel import" statusbar="false">



	<!-- <event type="shown"> -->
			 <!-- <action type="control populate" value="#grdPrikazExcel"/>  -->
		<!-- </event>				 -->

	<layout textposition="left">
			<group cols="1" rows="1" > 
				
				 				
								
				<!-- </group> -->
			
				
				
				<item col="1" row="1">
					<grid name="grdPrikazExcel" autopopulate="true" fontsizedelta="3" showtotalsum="True" dataname="~dtGetDataExcelPrijenos" type="master" async="true"  multiselect="true" savelayout="true"  bestfitonrefresh="true" wordwrap="true" > 
						
									
						<fields>
							<field name="UFA" caption="UFA"  fixwidth="120"  showtotalsum="false"/>
							<field name="BrojRacuna" caption="Broj računa" fixwidth="120" showtotalsum="false"/>
							<field name="DatumKnjizenja" caption="Datum Knjiženja" showtotalsum="false"/>
							<field name="DatumRacuna" caption="Datum računa" showtotalsum="false"/>
							<field name="Partner" caption="Partner UFA" fixwidth="120" showtotalsum="false"/>
							<field name="IznosBezPdv" caption="Iznos bez PDV" showsum="false" fixwidth="200"/>
							
							<field name="SklDokVrsta" caption="Vrsta dokumenta" showsum="true" fixwidth="80"/> 
							<field name="BrojSklDok" caption="Broj skladišnog dokumenta" showtotalsum="false"/>
							<field name="PovezaniIznos" caption="Povezani iznos SKL" showsum="true" fixwidth="200"/>
							<field name="Greska" caption="Greška"  fixwidth="200"/>

						</fields>
						
						<styles>
						<style name="fontcolor" value="red" if="#grdPrikazExcel.@Greska=='Greška u excelu'" />
						

					</styles>
				
					</grid>
				</item>						
	
		
			</group>
			
		</layout>
	
	<panelbuttons>
		<buttons>
			<button name="btnPrenesi" caption="Prenesi podatke" >			
				<event type="click">
					<action type="datarun nonquery" value="~dtPrenesiExcel"> </action>					
					<action type="form close" value="frmPrikazExcel"> </action>
					<action type="message" value="Prijenos napravljen"/>					
				</event>
				
			</button>

			<button  name="btnOdustani" caption="Odustani" type="cancel">
					<!-- <action type="control populate" value="#grdStavke"> -->
						<!-- <action type="control focus" value="#grdStavke"> -->
							<!-- <parameter value="$Fakturedobid" /> -->
						<!-- </action> -->
					<!-- </action> -->

			</button>
		</buttons>
	</panelbuttons>
	<!-- dohvat podataka -->
	<datalist>

		<data name="dtGetDataExcelPrijenos" command="spCKntUfaOtpremaExcelQuery">
			 <parameter name="@action" value="1"></parameter> 
			 <!-- <parameter name="@Fakturedobid" value="global.$Fakturedobid"></parameter>  -->

		</data>
	
		<data name="dtPrenesiExcel" command="spCKntUfaOtpremaExcelAzur">
			 <parameter name="@action" value="1"></parameter> 
			 <!-- <parameter name="@Fakturedobid" value="global.$FaktureDobId"></parameter>  -->

		</data>

		
	</datalist>
	

	
	</form>
	<!-- kod poziva forme iiz druge forme, obavezno staviti poziv i na početnu formu -->
	<!-- <form name="frmPrikazExcelOtpremnice" path="frmPrikazExcelOtpremnice.xml"></form>  -->
</root>