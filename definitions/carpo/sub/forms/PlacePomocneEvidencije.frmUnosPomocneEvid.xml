<root>
	<form name="frmUnosPomocneEvid" caption="$caption" width="800" height="600" saveformlayout="true" statusbar="true" >
		<event type="init">
			<action type="datarun reader" value="~dtGetOsobu" if="$OOPUnosId!=0" /> 
			<action type="datarun reader" value="~dtGridBrisanjeP" /> 
		</event>
		<event type="shown">
			<action type="variable value">
				<parameter name="StavkaId" value="0" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="StavkaId" value="#cmbStavke" type="int"/>
			</action>
			<action type="datarun reader" value="~dtKontrole" >
				<action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" >
					<action type="control refreshvalue" value="#txtSati"/>
				</action>
				<action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" >
					<action type="control refreshvalue" value="#txtBodovi"/>
				</action>
				<action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" >
					<action type="control refreshvalue" value="#txtPostotak"/>
				</action>
				<action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" >
					<action type="control refreshvalue" value="#txtIznos"/>
				</action>
				<action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" >
					<action type="control refreshvalue" value="#srcOrgShema"/>
				</action>
				<action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" >

					<action type="control refreshvalue" value="#srcMtr"/>
				</action>
				<action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" >
					<action type="control refreshvalue" value="#srcRelacije"/>
				</action>
				<action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" >
					<action type="control refreshvalue" value="#srcRadnaMjesta"/>
				</action>
				<action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
				<action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
				<action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
				<action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
				<action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" >
					<action type="control populate" value="#srcOrgShema">
						<action type="datarun reader" value="~dtGets">
							<action type="control value" value="#srcOrgShema">
								<parameter value="~dtGets.@OrgShemaId" text="~dtGets.@OrgShema" />
							</action>
						</action>
					</action>
				</action>
				<action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" >
					<action type="control populate" value="#srcMtr">
						<action type="datarun reader" value="~dtGets">
							<action type="control value" value="#srcMtr">
								<parameter value="~dtGets.@ID" text="~dtGets.@MjestoTroska" />
							</action>
						</action>
					</action>
				</action>
				<action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" >
					<action type="control populate" value="#srcRelacije">
						<action type="datarun reader" value="~dtGets">
							<action type="control value" value="#srcRelacije">
								<parameter value="~dtGets.@OOPRelacijeId" text="~dtGets.@Relacije" />
							</action>
						</action>
					</action>
				</action>
				<action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" >
					<action type="control populate" value="#srcRadnaMjesta">
						<action type="datarun reader" value="~dtGets">
							<action type="control value" value="#srcRadnaMjesta">
								<parameter value="~dtGets.@HRRadnaMjestaId" text="~dtGets.@RadnoMjesto" />
							</action>
						</action>
					</action>
				</action>
			</action>
			<action if="$tip==unos" >
				<action type="control disable" value="#dtDatumDo" >
					<action type="control value" value="#dtDatumDo" >
						<parameter value="now" />
					</action>
				</action>
			</action>
			<action elseif="$Tip==izmjena">
			<action type="control disable" value="#srcOsoba,#btnOsoba"/>
				<action type="control value" value="#srcOsoba">
					<parameter text="~dtGetOsobu.@Osoba" value="~dtGetOsobu.@HrKadroviId" />
				</action>
				<action type="control value" value="#cmbStavke">
					<parameter value="~dtGetOsobu.@OOPStavekeId" text="~dtGetOsobu.@Stavke" />
				</action>
				<!-- <action type="control value" value="#srcOrgShema"> -->
				<!-- <parameter value="~dtGetOsobu.@OrgId" text="~dtGetOsobu.@OrgShema" /> -->
				<!-- </action> -->
				<!-- <action type="control value" value="#srcMtr"> -->
				<!-- <parameter value="~dtGetOsobu.@Org1Id" text="~dtGetOsobu.@MjestoTroska" /> -->
				<!-- </action> -->
				<!-- <action type="control value" value="#srcRelacije"> -->
				<!-- <parameter value="~dtGetOsobu.@OOPRelacijeId" text="~dtGetOsobu.@Relacije" /> -->
				<!-- </action> -->
				<!-- <action type="control value" value="#srcRadnaMjesta"> -->
				<!-- <parameter value="~dtGetOsobu.@HRRadnaMjestaId" text="~dtGetOsobu.@RadnoMjesto" /> -->
				<!-- </action> -->
				<action type="control value" value="#dtDatumDo">
					<parameter value="~dtGetOsobu.@DatumDo" />
				</action>
				<action type="control disable" value="#dtDatumDo" if="~dtGetOsobu.@DatumDo==null"></action>
				<action if="~dtGetOsobu.@DatumDo==null">
					<action type="control value" value="#dtDatumDo" >
						<parameter value="now" />
					</action>
				</action>
			</action>
		</event>
		<layout>
			<group rows="2" cols="5" groupbordervisible="false">
			<columnsdefinition>
			<column size="20%" position="1"/>
			<column size="20%" position="2"/>
			<column size="20%" position="3"/>
			<column size="20%" position="4"/>
			<column size="20%" position="5"/>
			</columnsdefinition>
				<group rows="2" cols="5"  row="1" col="1" colspan="3" spacing="2,2,1,2">
