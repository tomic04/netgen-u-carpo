												<action type="datarun reader" value="~dtGets">
													<action type="control value" value="#srcOrgShema">
														<parameter value="~dtGets.@OrgShemaId" text="~dtGets.@OrgShema" />
													</action>
												</action>
											</action>
										</action>
										<action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" >
											<action type="control populate" value="#srcMtr">
												<action type="datarun reader" value="~dtGets">
													<action type="control value" value="#srcMtr">
														<parameter value="~dtGets.@ID" text="~dtGets.@MjestoTroska" />
													</action>
												</action>
											</action>
