													<action type="control value" value="#srcRelacije">
														<parameter value="~dtGets.@OOPRelacijeId" text="~dtGets.@Relacije" />
													</action>
												</action>
											</action>
										</action>
										<action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" >
											<action type="control populate" value="#srcRadnaMjesta">
												<action type="datarun reader" value="~dtGets">
													<action type="control value" value="#srcRadnaMjesta">
														<parameter value="~dtGets.@HRRadnaMjestaId" text="~dtGets.@RadnoMjesto" />
													</action>
												</action>
											</action>
										</action>
									</action>
								</action>
							</event>
						</searchedit>
					</item>
					<item row="1" col="5" colspan="5" highlight="false">
						<button name="btnOsoba" caption="Dodaj" >
							<event type="click">
								<action type="datarun nonquery" value="~dtPrebaci">
									<action type="control populate" value="#grdOsobe"	/>
									<action type="control refreshvalue" value="#srcOsoba">
									</action>
									 <action type="footer text" value="Broj odabranih djelatnika: {#grdOsobe.rowcount}"/>
								</action>									
							</event>
						</button>
					</item>
					<item caption="Datum od:" col="1"  row="2"  highlight="false" textposition="left" colspan="2">
						<dateedit name="dtDatumOd"  value="now" datavalue="~dtGetOsobu.@DatumOd" />
