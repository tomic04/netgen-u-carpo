						<item caption="" col="2"  row="1" >
						</item>
						<item caption="Org. jedinica:" col="3" row="1" colspan="3" highlight="false">
							<searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" />
						</item>
						<item caption="Mjesto troška:" col="3" row="2"  colspan="3" highlight="false">
							<searchedit name="srcMtr"  fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtMtr" />
						</item>
						<item caption="Relacija:" col="3" row="3"  colspan="3" highlight="false">
							<searchedit name="srcRelacije" fieldvalue="OOPRelacijeId" fieldtext="Naziv" dataname="~dtRelacije" />
						</item>
						<item caption="Radno mjesto:" col="3" row="4"  colspan="3" highlight="false">
							<searchedit name="srcRadnaMjesta"  fieldvalue="HRRadnaMjestaId" fieldtext="Naziv" dataname="~dtRadnaMjesta" />
						</item>
					</group>
					<group col="1" row="3" cols="5" rows="1" colspan="4" groupbordervisible="true">
						<item caption="Opis:" col="1" row="1" colspan="5" highlight="false">
							<memoedit name="memOpis" textposition="left" datavalue="~dtGetOsobu.@Opis" />
						</item>
					</group>

				</group>
				<group col="4" row="1" colspan="2" rowspan="2" cols="1" rows="10" spacing="1,1,1,1" caption="Odabrani djelatnici">
					<item row="1" col="1" rowspan="10" highlight="false" >
						<grid name="grdOsobe" key="HRKadroviId" dataname="~dtGridOsoba" showgrouppanel="false"  >
							<event type="doubleclick">
								<action type="datarun nonquery" value="~dtGridBrisanje"/>
								<action type="control populate" value="#grdOsobe"	/>
                               
							</event>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$OOPUnosId==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdMaster">
									<action type="control focus" value="parent.#grdMaster">
										<parameter value="$noviID"/>
									</action>
								</action>
								<action type="control enable" value="parent.#btnIzmijeni"/>
							</action>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!"/>
							<action type="form close" />
						</action>
						<action if="$indGreske==1">
						  		<action type="control populate" value="#grdOsobe"/>
						</action>
						<action if="$OOPUnosId!=0">
							<action type="datarun reader" value="~dtIzmijena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlace_help" name="dtStavke">
				<parameter name="@Action" value="cmb_stavke"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="getOsobu">
				<parameter name="@action" value="src_Osobe" />
				<parameter name="@filter" value="#srcOsoba.text" />
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtKontrole">
				<parameter name="@Action" value="daj_pozicije_za_unos_stavke" />
				<parameter name="@OOPStavekeId" value="$StavkaId"/>
				<parameter name="@HRKadroviId" value="#srcOsoba.@HRKadroviId" if="parent.#grdMaster.rowcount==0"/>
				<parameter name="@HRKadroviId" value="$HRKadroviId" else=""/>
			</data>
			<data command="spPlace_help" name="dtOrgShema">
				<parameter name="@Action" value="src_orgshema" />
				<parameter name="@Tekst" value="#srcOrgShema.text"/>
			</data>
			<data command="spPlace_help" name="dtMtr">
				<parameter name="@Action" value="src_orgshema" />
				<parameter name="@Tekst" value="#srcMtr.text"/>
			</data>
			<data command="spPlace_help" name="dtRelacije">
				<parameter name="@Action" value="src_relacije" />
				<parameter name="@Tekst" value="#srcRelacije.text"/>
			</data>
			<data command="spPlace_help" name="dtRadnaMjesta">
				<parameter name="@Action" value="src_radnamjesta" />
				<parameter name="@Tekst" value="#srcRadnaMjesta.text"/>
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtGets">
				<parameter name="@Action" value="dtGet" />
				<parameter name="@HrKadroviId" value="$HRKadroviId" />
			</data>
			<!-- <data command="spPlacePomocneEvidencije_CP" name="getZadnjiDan"> -->
			<!-- <parameter name="@action" value="ZadnjiDan" /> -->
			<!-- </data> -->
			<data command="spPlacePomocneEvidencije_CP" name="dtGetOsobu">
				<parameter name="@action" value="get_osobu" />
				<parameter name="@OOPUnosId" value="$OOPUnosId" type="int"/>
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtPrebaci">
				<parameter name="@Action" value="dodaj_osobe" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@hrkadroviid" value="#srcOsoba.@hrkadroviid"/>
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtGridOsoba">
				<parameter name="@action" value="grid_osobe" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@hrkadroviid" value="#srcOsoba.@hrkadroviid"/>  
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtGridBrisanje">
				<parameter name="@action" value="brisanje_grid" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@hrkadroviid" value="#grdOsobe.@hrkadroviid"/>  
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtGridBrisanjeP">
				<parameter name="@action" value="brisanje_pri_pokretanju" />
				<parameter name="@operateriid" value="@@operateriid"/> 
			</data>

			<data command="spPlacePomocneEvidencije_CP" name="dtUnos">
				<parameter name="@Action" value="unos_osobe" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@OOPUnosId.output.int" variablename="noviID"></parameter>
				<parameter name="@OOPKlaseUnosaId" value="parent.#tree.@ids"/>
				<parameter name="@HRKadroviId" value="#srcOsoba" />
				<parameter name="@OOPStavekeId" value="#cmbStavke"/>
				<parameter name="@Sati" value="#txtSati"/>
				<parameter name="@Bodovi" value="#txtBodovi"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@Iznos" value="#txtIznos"/>
				<parameter name="@OrgShemaId" value="#srcOrgShema"/>
				<parameter name="@MtrId" value="#srcMtr"/>
				<parameter name="@RelacijaId" value="#srcRelacije"/>
				<parameter name="@HRRadnaMjestaId" value="#srcRadnaMjesta"/>
				<parameter name="@Opis" value="#memOpis"/>
				<parameter name="@datumod" value="#dtDatumOd"/>
				<parameter name="@datumdo" value="#dtDatumDo"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPlacePomocneEvidencije_CP" name="dtIzmijena">
				<parameter name="@Action" value="izmjeni_osobu" />
				<parameter name="@OOPUnosId" value="$OOPUnosId"></parameter>
				
				<parameter name="@HRKadroviId" value="parent.#grdMaster.@HRKadroviId"/>
				<parameter name="@OOPStavekeId" value="#cmbStavke"/>
				<parameter name="@Sati" value="#txtSati"/>
				<parameter name="@Bodovi" value="#txtBodovi"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@Iznos" value="#txtIznos"/>
				<parameter name="@OrgShemaId" value="#srcOrgShema"/>
				<parameter name="@MtrId" value="#srcMtr"/>
				<parameter name="@RelacijaId" value="#srcRelacije"/>
				<parameter name="@HRRadnaMjestaId" value="#srcRadnaMjesta"/>
				<parameter name="@datumod" value="#dtDatumOd"/>
				<parameter name="@datumdo" value="#dtDatumDo"/>
				<parameter name="@Opis" value="#memOpis"/>
				<parameter name="@indGreske.output.int"/>
			</data>

		</datalist>
	</form>

	<!-- ******************************************************************************************* -->
	<!-- FORMA ZA BRISANJE -->
	<!-- ******************************************************************************************* -->

	<form name="frmBrisanje" caption ="Brisanje" width="400" height="150" fixedsize="true" saveformsize="false" >
		<event type="shown">
			<action type ="control value" value="#lblPitanje">
				<parameter value="Jeste li sigurni da želite obrisati djelatnika/djelatnike?"/>
			</action>
		</event>
		<layout>
			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="true" >
				<item col="1" row="1"  highlight="false">
					<labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
				</item>
			</group>
			<!--kraj omotača-->
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnBrisi" caption="OBRIŠI" type="del">
					<event type="click">
						<!-- Okini storu -->
						<action type="datarun reader" value="~dtBrisanje"/>
						<action if="$indGreske==0">
							<action type="control populate keepfocus" value="parent.#grdMaster"/>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPlacePomocneEvidencije_CP" name="dtBrisanje">
				<parameter name="@Action" value="brisanje_osobe" type="string"/>
				<parameter name="@selectedids" value="$selectedids"/> 
				<parameter name="@indGreske.output.int"></parameter>
			</data>

		</datalist>
	</form>
</root>