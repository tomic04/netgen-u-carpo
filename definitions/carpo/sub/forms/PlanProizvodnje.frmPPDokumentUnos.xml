<root>
	<form name="frmPPDokumentUnos" caption="Unos dokumenta" width="420" fixedsize="true">
		<event type="load">
			<action type="variable value" >
				<action type="datarun scalar" value="Global.~dtVrstaDokGet">
					<parameter name="VrstaDokId" value="$VrstaDokId" />
				</action>	
			</action>	
		</event>
		<event type="shown">
			<action type="control focus" value="#datDatumdok"/>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="6" col="1" row="1" backgroundcolor="#f5f5f5" alignmode="local">
				<part name="planProizvodnjeAtributi" path="prtPlanProizvodnje.xml" />
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="KREIRAJ" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDataInsert">
							<parameter name="ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId" />
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster" />
						<action type="form open" value="frmPPDokumentEdit">
							<parameter name="ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId"/>
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>		
		<datalist>
			<data command="spProPlanProizvodnjeGlaAzur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Status" value="1" />
				<parameter name="@VrstaDokId" value="$VrstaDokId" />
				<parameter name="@DatumDok" value="#datDatumdok" />
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@OrgShemaId" value="#cteOrgShema" />
				<parameter name="@OsobeId" value="#cmbOsobe" />
				<parameter name="@DatumOd" value="#datDatumOd" />
				<parameter name="@DatumDo" value="#datDatumDo" />
				<parameter name="@RefDatumOd" value="#datRefDatumOd" />
				<parameter name="@RefDatumDo" value="#datRefDatumDo" />
			</data>
		</datalist>		
	</form>
</root>