<root>
    <form name="frmRekapitulacija" caption="Rekapitulacija artikla {parent.#grdStavke.@Sifra} - {parent.#grdStavke.@Naziv} (JM: {parent.#grdStavke.@JM})" fixedsize="false" width="900" height="570">
		<event type="onload">
			<action type="control populate" value="#grdRekapitulacija"></action>
		</event>	
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
				<item row="1" col="1">
					<grid name="grdRekapitulacija" async="true" dataname="dtGrid" multiselect="true" key="ind">
						<part name="partKarticaGrid" path="prtKomStanjeSkladista.xml" />
						<print caption="Rekapitulacija artikla: {parent.#grdStavke.@Sifra} - {parent.#grdStavke.@Naziv} (JM: {parent.#grdStavke.@JM}) {$varKontingent}" header="Od {parent.#datDatumOd::dd.MM.yyyy.} do {parent.#datDatumDo::dd.MM.yyyy.}\nSkladište: {parent.#grdStavke.@Skladiste}" subheader="" captionalign="" headeralign="" subheaderalign=""/>							
					</grid>
				</item>
            </group>
        </layout>
        <panelbuttons displaycontrolsprint="true">
            <buttons>
                <button caption="Ispiši rekapitulaciju" dock="right">
                    <event type="click">
						<action type="control printcontrol" value="#grdRekapitulacija"/>						
                    </event>
                </button>
                <button caption="Zatvori" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spSktKomercKarticaQueryNG" name="dtGrid">
                <parameter name="@Action" value="1" />
                <parameter name="@SkladisteId" value="$SkladisteId" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@DatumOd" value="$DatumOd" />
				<parameter name="@DatumDo" value="$DatumDo" />
				<parameter name="@KKvalGlaId" value="$KKvalGlaId" />
				<parameter name="@kontigent" value="$Kontingent" />
				<parameter name="@faktor" value="$Faktor" />
            </data>
        </datalist>
    </form>
</root>