<root>
	<form name="frmKnjigaUra_Insert" caption="Izmjena dokumenta" fixedsize="true" > 
		<event type="init">
		</event>
		<event type="load">		
		</event>

		<event type="shown">

		</event>

		<event type="close">

		</event>	

		<layout textposition="top" >
			<group cols="2" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column size="50%" position="1" />
					<column size="50%" position="2" />

				</columnsdefinition>
				<group  name="" cols="1" rows="3" col="1" row="1" groupbordervisible="false">
					<group caption="Opći podaci" col="1" row="1" cols="1" rows="5" spacing="2,2,2,2">
						<group caption="" col="1" row="1" cols="4" rows="1"  groupbordervisible="false">
							<columnsdefinition>
								<column position="1" size="200" />
								<column position="2" size="30" />
								<column position="3" size="30" />
								<column position="4" size="100" />
							</columnsdefinition>
							<item col="1" row="1" caption="Vrsta knjige:" padding="0">
								<comboedit name="cbVrstaKnjige" autopopulate="true" valuefield="KntVrsteKnjigaUraId" displayfield="NazivKnjige" datavalue="~dtVrstaKnjige.@KntVrsteKnjigaUraId" dataname="dtVrstaKnjige">
								</comboedit>
							</item>
							<group  name="" col="2" row="1" cols="2" rows="1"  groupbordervisible="false" alignmode="local">
								<item col="1" row="1" caption="R1"  padding="0" highlight="false"> 
									<radioedit name="rbR1" value="1" />
								</item>
								<item col="2" row="1" caption="R2"  padding="0" highlight="false"> 
									<radioedit name="rbR2" value="0" />
								</item>
							</group>
							<item col="4" row="1" caption="Redni broj:"  padding="0" > 
								<textedit name="txtRedniBroj" readonly="true" />
							</item>
						</group>
						<group caption="" col="1" row="2" cols="6" rows="1" colspan="6" groupbordervisible="false">
							<item col="1" row="2" caption="Račun:" colspan="4" padding="0" > 
								<textedit name="txtRacun"  />
							</item>
							<item col="5" row="2" caption="URA" colspan="2" padding="0"  > 
								<textedit name="txtURA" datavalue="~dtGetMaxUra.@brojdok"/>
							</item>
						</group>
						<group caption="" col="1" row="3" cols="6" rows="1" colspan="6" groupbordervisible="false">
							<item col="1" row="1" caption="Dat.dok.:" colspan="2" padding="0"  >
								<dateedit  name="datNadnevak"  value="" datavalue="~dtGetPodaci.@Nadnevak" minvalue="Global.$BlokadaOd" maxvalue="Global.$BlokadaDo">
								</dateedit>

							</item>
							<item col="3" row="1" caption="God.:" colspan="1" padding="0"  > 
								<textedit name="txtGodina"  datavalue="~dtGetPodaci.@Godina"/>
							</item>
							<item col="4" row="1" caption="Dat.DVO:" colspan="2" padding="0" >
								<dateedit  name="datDVO"  value="" datavalue="~dtGetPodaci.@DatDVO" >
								</dateedit>
							</item>
							<item col="6" row="1" caption="Dana" colspan="1" padding="0" > 
								<textedit name="txtDana" datavalue="~dtGetPodaci.@Dana">
								</textedit>
							</item>
						</group>
						<group caption="" col="1" row="4" cols="3" rows="1" colspan="6" groupbordervisible="false">
							<columnsdefinition>
								<column position="1" size="100" />
								<column position="2" size="100" />
								<column position="3" size="100" />
							</columnsdefinition>
							<item col="1" row="1" caption="Valuta:"  padding="0"  >
								<dateedit  name="datValuta"  value="" datavalue="~dtGetPodaci.@DatumValute" >
								</dateedit>
							</item>

							<item col="2" row="1" caption="Dat.knjiženja:"  padding="0"  >
								<dateedit  name="datKnjizenja"  value="" datavalue="~dtGetPodaci.@DatumKnjizenja" >
								</dateedit>
							</item>
						</group>
						<group caption="" col="1" row="5" cols="6" rows="1" colspan="6" groupbordervisible="false">
							<item col="1" row="5" caption="Osoba:" colspan="3" padding="0" >
								<comboedit name="cbOsobe" autopopulate="true" valuefield="OsobeId" displayfield="Naziv" datavalue="~dtPopuniCombo.@OsobeId" dataname="dtPopuniCombo">
								</comboedit>
							</item>

							<item col="4" row="5" caption="Org.shema:" colspan="3" padding="0" >
								<comboedit name="cmbOrgShema" autopopulate="true" valuefield="OrgShemaId" displayfield="Naziv" datavalue="~dtGetPodaci.@OrgShemaId" dataname="dtGetOrgShema">
								</comboedit>
							</item>
						</group>
					</group>

					<group caption="Partner" name="partner" cols="2" rows="3" col="1" row="2" colspan="6" spacing="2,2,2,2" >
						<item col="1" row="1" colspan="2" caption="Partner:" padding="0" >
							<searchedit  name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" dataname="dtGetPartneri"  required="true">
							</searchedit>
						</item>
						<item col="1" row="2" caption="Ugovor:" colspan="1" padding="0" >
							<comboedit name="cbUgovori" autopopulate="true" valuefield="DobUgovoriId" displayfield="Naziv" datavalue="~dtGetUgovori.@DobUgovoriId" dataname="dtGetUgovori">
							</comboedit>
						</item>
						<item col="2" row="2" caption="OIB:" colspan="1" padding="0" >
							<textedit name="txtOIB" readonly="true"/>
						</item>
						<item col="1" row="3" caption="Mjesto:" colspan="1" padding="0" >
							<textedit name="txtMjesto" readonly="true"/>
						</item>
						<item col="2" row="3" caption="PDVID:" colspan="1" padding="0" >
							<comboedit name="cbPDVID" autopopulate="true" valuefield="ParStruId" displayfield="Naziv"  dataname="dtGetPDVID" allownull="false">
							
							</comboedit>
						</item>
					</group>

					<group caption="Podaci za platni promet" name="platni" cols="3" rows="1" col="1" row="3" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="50" />
							<column position="2" size="170" />
							<column position="3" size="100" />
						</columnsdefinition>

						<item col="1" row="1" caption="Model:"  padding="0" > 
							<textedit name="txtModel"  />
						</item>
						<item col="2" row="1" caption="Poziv na broj:"  padding="0">
							<textedit name="txtPozivNaBroj" datavalue="~dtGetPodaci.@PozivNaBroj"/>
						</item>
						<item col="3" row="1" caption="IBAN:"  padding="0"  >
							<comboedit name="cbZiro" autopopulate="true" valuefield="ParZiroId" displayfield="ZIRO"  dataname="dtGetParZiro" allownull="false">	 
							
							</comboedit>
						</item>
					</group>
				</group>

				<group  name="" cols="1" rows="1" col="2" row="1" groupbordervisible="false">
					<group caption="Iznosi" col="1" alignmode="local" row="1" cols="5" rows="12" spacing="2,2,2,2" backgroundcolor="#d2d2e0">
						<columnsdefinition>
							<column size="40" position="1" />
							<column size="30%" position="2" />
							<column size="30%" position="3" />
							<column size="30%" position="4" />	
							<column size="5%" position="5" />								
						</columnsdefinition>

						<!--  prvi red -->
						<item col="2" row="1" caption="Devizna iznos:"  padding="2" >
							<textedit name="curDevIznos" value="0" format="n2" type="decimal"/>
						</item>

						<item col="3" row="1" caption="Valuta:"  padding="2" >
							<comboedit name="cbDevValuta" autopopulate="true" valuefield="ValuteId" displayfield="Naziv" datavalue="~dtGetPodaci.@ValuteId" dataname="dtGetValute">							</comboedit>
						</item>

						<item col="4" row="1" caption="Tečaj:" padding="2"  >
							<textedit name="curTecaj" value="0" format="n6" type="decimal" readonly="true"/>
						</item> 

						<!--  drugi red -->

						<item col="2" row="2" caption="Iznos računa (s PDV):" padding="2"  >
							<textedit name="curIznossPdv" value="0" format="n2" type="decimal"> 
							
							</textedit>
						</item>

						<item col="3" row="2" caption="PDV 30/70/0:" padding="2" >
							<comboedit name="cbPDV37" autopopulate="true" valuefield="pdv37id" displayfield="oznaka" datavalue="~dtGetPodaci.@pdv37id" dataname="dtGetPDV37">
							
							</comboedit>
						</item>

						<item col="4" row="2" caption="Osnovica 0%:" padding="2">
							<textedit name="curNeoporezivo" value="0" format="n2" type="decimal" >
							</textedit>
						</item> 

						<!--  treći red -->
						<item col="4" row="3" caption="Ne podliježe:" colspan="1"  padding="2">
							<textedit name="curNePod" value="0" format="n2" type="decimal">
						
							</textedit>
						</item>


						<!--  četvrti red -->

						<item col="1" row="4" caption=" " colspan="1" textposition="top" padding="2">
							<labeledit value="25%"/> 
						</item>

						<item col="2" row="4" caption="OSNOVICA" colspan="1" padding="2"> 
							<textedit name="curOsnovica25" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="3" row="4" caption="ODBIV" colspan="1" padding="2" >
							<textedit name="cur25Odbiv" value="0" format="n2" type="decimal">
							
							</textedit> 
						</item>

						<item col="4" row="4" caption="NEODBIV" colspan="1" padding="2" > 
							<textedit name="cur25Neodbiv" value="0" format="n2" type="decimal">
							
							</textedit>
						</item> 

						<!-- peti red -->

						<item col="1" row="5" caption="" colspan="1" textposition="left" padding="2">
							<labeledit value="13%"/> 
						</item>
						<item col="2" row="5" caption="" colspan="1" padding="2" > 
							<textedit name="CurOsnovica13" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="3" row="5" caption="" colspan="1" padding="2" >
							<textedit name="cur13Odbiv" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="4" row="5" caption="" colspan="1" padding="2" > 
							<textedit name="cur13Neodbiv" value="0" format="n2" type="decimal">
						
							</textedit>
						</item>


						<!-- šesti red -->

						<item col="1" row="6" caption="" colspan="1" textposition="left" padding="2">
							<labeledit value="5%"/> 
						</item>
						<item col="2" row="6" caption="" colspan="1" padding="2"> 
							<textedit name="CurOsnovica5" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="3" row="6" caption="" colspan="1" padding="2" >
							<textedit name="cur5Odbiv" value="0" format="n2" type="decimal">
										
							</textedit> 
						</item>

						<item col="4" row="6" caption="" colspan="1" padding="2" > 
							<textedit name="cur5Neodbiv" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>


						<!-- osmi red -->

						<item col="1" row="8" caption="" colspan="1" textposition="left" padding="2">
							<labeledit value="10%"/> 
						</item>
						<item col="2" row="8" caption="" colspan="1" padding="2" > 
							<textedit name="CurOsnovica10" value="0" format="n2" type="decimal">
							
							</textedit> 
						</item>

						<item col="3" row="8" caption="" colspan="1" padding="2" >
							<textedit name="cur10Odbiv" value="0" format="n2" type="decimal">
								
							</textedit> 
						</item>

						<item col="4" row="8" caption="" colspan="1" padding="2" > 
							<textedit name="cur10Neodbiv" value="0" format="n2" type="decimal"/>
						</item> 


						<!-- deveti red -->

						<item col="1" row="9" caption="" colspan="1" textposition="left" padding="2">
							<labeledit value="23%"/> 
						</item>
						<item col="2" row="9" caption="" colspan="1" padding="2" > 
							<textedit name="CurOsnovica23" value="0" format="n2" type="decimal">
							</textedit>
						</item>

						<item col="3" row="9" caption="" colspan="1" padding="2" >
							<textedit name="cur23Odbiv" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="4" row="9" caption="" colspan="1" padding="2" > 
							<textedit name="cur23Neodbiv" value="0" format="n2" type="decimal"/>
						</item> 


						<!-- deseti red -->

						<item col="1" row="10" caption="" colspan="1" textposition="left" padding="2">
							<labeledit value="22%"/> 
						</item>
						<item col="2" row="10" caption="" colspan="1" padding="2" > 
							<textedit name="CurOsnovica22" value="0" format="n2" type="decimal">
							
							</textedit>
						</item>

						<item col="3" row="10" caption="" colspan="1" padding="2">
							<textedit name="cur22Odbiv" value="0" format="n2" type="decimal">
								
							</textedit> 
						</item>

						<item col="4" row="10" caption="" colspan="1" padding="2" > 
							<textedit name="cur22Neodbiv" value="0" format="n2" type="decimal">
							
							</textedit>
						</item> 

						<!-- 11 red -->

						<item col="2" row="11" caption="Iznos bez PDV:" colspan="1" padding="2" > 
							<textedit name="curIznosBezPdv" value="0" format="n2" type="decimal" readonly="true">
							
							</textedit> 
						</item>

						<item col="3" row="11" caption="Prolazne stavke:" colspan="1" padding="2" >
							<textedit name="curProlazneStavke" value="0" format="n2" type="decimal">
												
							</textedit>
						</item>

						<item col="4" row="11" caption="Pretporez ukupno:" colspan="1"  padding="2" > 
							<textedit name="curPdvUkupno" value="0" format="n2" type="decimal" readonly="true"/>
						</item>

						<!-- 12 red -->

						<item col="1" row="12" caption="Vrsta računa:" colspan="2"  padding="1">
							<comboedit name="cbShemaKnj" autopopulate="true" valuefield="KntMasterShemaKnjId" displayfield="Naziv" datavalue="~dtGetPodaci.@ValuteId" dataname="dtGetShemaKnj">

							</comboedit>
						</item>

						<item col="3" row="12" caption="Napomena:" colspan="3" padding="1" >
							<textedit name="txtNapomena" datavalue="~dtGetPodaci.@Napomena">
							</textedit>
						</item>
					</group>

				</group>

				<group caption="Podaci s carinske deklaracije" name="carina" cols="5" rows="1" col="1" row="2" colspan="2" spacing="2,2,2,2">

					<item col="1" row="1" caption="Broj JCD:" colspan="2" >
						<textedit name="txtBrojUCD" datavalue="~dtGetPodaci.@BrojUCD"/>
					</item>
					<item col="3" row="1" caption="Datum JCD:" colspan="1">
						<dateedit  name="datUCD"  value="" datavalue="~dtGetPodaci.@DatumUCD">
						</dateedit>
					</item>
					<item col="4" row="1" caption="Broj zaključka:" colspan="2">
						<textedit name="txtBrojZak" datavalue="~dtGetPartneri.@BrojZak"/>
					</item>
				</group>


			</group>
		</layout>  

		<actionpanel>
			<items>
				<item>
					<button name="btnSpremi" caption="SPREMI">
					</button>		
				</item>
				<item>
					<button name="btnOdustani" caption="ODUSTANI">
					</button>
				</item>	
				<item>
					<button name="btnRate" caption="RATE">
					</button>	
				</item>					
				<item>
					<checkedit name="chktem" caption="Temeljnica" value="0" dock="right"/>
				</item>
				<item>
					<button name="btnProknjizi" caption="SPREMI I PROKNJIŽI" dock="right">
					</button>
				</item>
			</items>
		</actionpanel>

		<datalist>

		</datalist>
	</form>
</root>