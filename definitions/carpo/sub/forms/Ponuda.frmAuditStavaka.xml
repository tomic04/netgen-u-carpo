<root>
	<form name="frmAuditStavaka" caption="Revizija stavaka - dokument {$Broj}" width="880" height="400" >
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" >
				<item col="1" row="1" highlight="False" >
					<grid name="grdStavke" async="true" dataname="global.dtAuditStavaka" autopopulate="true" key="Log_ProPonDetId">
						<fields>
							<field name="Grupa" caption="Stavka" />
							<field name="Šifra" caption="Šifra" />
							<field name="Roba" caption="Roba" />
							<field name="Akcija" caption="Akcija" />
							<field name="StaraVrijednost" caption="Stara vrijednost" />
							<field name="NovaVrijednost" caption="Nova vrijednost" />							
							<field name="OperaterIzmjene" caption="Operater" />							
							<field name="VrijemeIzmjene" caption="Vrijeme" formatstring="dd.MM.yyyy. HH:mm:ss"/>							
							<field name="Revizija" caption="Revizija" />		
						</fields>
 				 			<styles>
								<style name="fontcolor" value="gray" if="#grdStavke.@IndObrisan==1" />
							</styles>
					</grid>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>		
	</form>
</root>