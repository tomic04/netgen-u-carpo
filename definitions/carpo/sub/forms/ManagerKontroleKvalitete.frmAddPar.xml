<root>
	<form name="frmAddPar" caption="Dodaj parametar">
		<event type="init">
			<action type="datarun reader" value="~dtpar"/>
			<action type="datarun reader" value="~dtBrUz"/>
		</event>
		<layout>
			<group rows="1" cols="2">
				<columnsdefinition>
					<column size="80%" position="1"/>
					<column size="20%" position="2"/>
				</columnsdefinition>
				<item row="1" col="1" caption="Parametar:">
					<comboedit name="cmbPar" displayfield="Naziv" valuefield="KKvalParametriId" key="KKvalLnParametarRobaid" required="true" dataname="~dtPar" >
						<event type="valuechanged" raiseonload="false">
							<action type="variable value" value="$ParRobaid">
								<parameter value="#cmbpar.@KKvalLnParametarRobaid"/>
							</action>
							<action type="datarun reader" value="~dtpar"/>
						</event>
					</comboedit>
				</item>	
				<item row="1" col="2" caption="Za uzorak:" >
					<comboedit name="cmbUzorak" displayfield="brojuzorka" valuefield="brojuzorka" required="true" dataname="~dtBrUz"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Spremi">
					<event type="click">
						<action type="validate"/>
							<action type="datarun scalar" value="~dtAddPar">
								<parameter name="FocusId"/>
							</action>
							<action type="control populate" value="parent.#grdkkvalDet">
								<action type="control focus" value="parent.#grdkkvalDet">
									<parameter value="$FocusId" type="int"/>
								</action>
							</action>
							<action type="form close"/>
					</event>
				</button>
				<button caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPar" command="spCarpoKKvalParAzur">
				<parameter name="@Action" value="listParPoRobi"/>
				<parameter name="@robaid" value="$robaid"/>
			</data>
			<data name="dtBrUz" command="spCarpoKKvalParAzur">
				<parameter name="@Action" value="brojuzoraka"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
			</data>
			 
			<data name="dtAddPar" command="spCarpoKKvalParAzur">
				<parameter name="@Action" value="addPar"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
				<parameter name="@KKvalLnParametarRobaId" value="$ParRobaid"/>
				<parameter name="@uzorak" value="#cmbUzorak"/>
			</data>
		</datalist>
	</form>
</root>