<root version="1.0">
  <!--
  *******************************************************************************************
  FORMA ZA IZRAČUN ODOBRENIH DANA GO
  *******************************************************************************************
  -->
  <form name="frmIzracunGO" caption="$caption" width="320" height="256" >

	  <event type="load">
		  <action type ="control value" value="#txtGodina">
				<parameter value="{parent.#grdMaster.@Godina}"/>
			</action>
	  </event>
	  
    <layout>
      <group cols="3" rows="5" groupbordervisible="false" >
        <item caption="Godina" col="1" row="1" textposition="top" highlight="false" >
          <textedit name="txtGodina" required="true" tooltip="Godina za koju se izračunava GO" maxlength="4" format="n0"></textedit>
        </item>
		<item col="1" row="2"  caption="Datum za dodatne kriterije:" textposition="top" highlight="false">
			<dateedit name="dateDatumDod" value="now"/>
		</item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnIzracun" caption="Izračunaj" tooltip="1+1=3">
          <event type="click">
			  <action type="datarun reader" value="~dtUpdateDatum" ></action>
              <action type="datarun reader" value="~dtIzracunDana" if="$indGreske==0" waittype="progress" waittext="Izračun odobrenih dana..."></action>
			  <action if="$indGreske==0">
				<action type="message" value="Izračunan je godišnji odmor za {#txtGodina}. godinu!" />
                <action type="form close" />
			  </action>
			  <action type="control populate" value="parent.#grdMaster" />
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
    <data command="spHRGodisnjiAllCP" name="dtIzracunDana">
	<parameter name="@Action" value="IzracunajDane"></parameter>
    <parameter name="@Godina" value="#txtGodina"></parameter>
	<parameter name="@PonoviIzracun" value="1"></parameter>		
    <parameter name="@indGreske.output.int"></parameter>
	<parameter name="@poruka.output.string"></parameter>
    </data>

	<data command="spHRGodisnjiAllCP" name="dtUpdateDatum">
		<parameter name="@Action" value="DatumDodatni"></parameter>
		<parameter name="@DatumDod" value="#dateDatumDod"></parameter>
		<parameter name="@indGreske.output.int"></parameter>
	    <parameter name="@poruka.output.string"></parameter>
	</data>
    </datalist>
  </form>
<!--
  *******************************************************************************************
  FORMA ZA DONOS NOVIH KADROVA U GO
  *******************************************************************************************
 -->
	<form name="frmDonosKad" caption="$caption" width="320" height="256" >

		<event type="load">
			<action type ="control value" value="#txtGodina">
				<parameter value="{parent.#grdMaster.@Godina}"/>
			</action>
		</event>

		<layout>
			<group cols="3" rows="5" groupbordervisible="false" >
				<item caption="Godina" col="1" row="1" textposition="top" highlight="false" >
					<textedit name="txtGodina" required="true" tooltip="Godina za koju se izračunava GO" maxlength="4" format="n0"></textedit>
				</item>
				<item col="1" row="2"  caption="Datum za dodatne kriterije:" textposition="top" highlight="false">
					<dateedit name="dateDatumDod" value="now"/>
				</item>
			</group>
			<!--kraj omotača-->
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnDonos" caption="Donesi kadrove">
					<event type="click">
						<action type="datarun reader" value="~dtUpdateDatum" ></action>
						<action type="datarun reader" value="~dtIzracunDana" if="$indGreske==0" waittype="progress" waittext="Donos kadrova..."></action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno doneseni kadrovi za {#txtGodina}. godinu!" />
							<action type="form close" />
						</action>
						<action type="control populate" value="parent.#grdMaster" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRGodisnjiAllCP" name="dtIzracunDana">
				<parameter name="@Action" value="IzracunajDane"></parameter>
				<parameter name="@Godina" value="#txtGodina"></parameter>
				<parameter name="@PonoviIzracun" value="0"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>

			<data command="spHRGodisnjiAllCP" name="dtUpdateDatum">
				<parameter name="@Action" value="DatumDodatni"></parameter>
				<parameter name="@DatumDod" value="#dateDatumDod"></parameter>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>
		</datalist>
	</form>
</root>