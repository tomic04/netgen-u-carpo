<root version="1.0">
  <form name="frmKreirajLijecnicki" caption="$caption" width="500" height="250" >
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$tip==izmjena"/>
    </event>
    <event type="onload">
      <action type="control disable" value="#cmbUputnice" if="$tip==izmjena" />
    </event>
    <event type="onshown">
      <!--<action type="message" value="test" if="$tip==izmjena" />-->
    </event>
    <layout>
      <group cols="1" rows="3" groupbordervisible="true" spacing="2,2,2,2">
        <item  col="1" row="1" caption="Datum liječničkog pregleda:"  highlight="false" textposition="left">
          <dateedit name="datDatumPregleda" value="now" datavalue="~dtGet.@DatumPregleda">
            <event type="valuechanged">
              <action type="datarun reader" value="~dtIstekIzracun"  />
              <action type="control value" value="#datDatumIsteka"  >
                <parameter value="~dtIstekIzracun.@DatumIsteka" />
              </action>
            </event>
          </dateedit>
        </item>
        <item  col="1" row="2" caption="Broj uputnice:"  highlight="false" textposition="left">
          <comboedit name="cmbUputnice" valuefield="ZNRUputniceId" displayfield="Naziv" datavalue="~dtGet.@ZNRUputniceId" dataname="~dtUputnice" required="true" />
        </item>
        <item  col="1" row="3" caption="Datum isteka:"   highlight="false" textposition="left">
          <dateedit name="datDatumIsteka" value="now" datavalue="~dtGet.@DatumIsteka"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$tip==izmjena" />
            <action type="datarun reader" value="~dtUnos" else="">
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@NoviId" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRDjelatnici_Help" name="dtUputnice">
        <parameter name="@Action" value="Uputnice_cmb"  />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Query" name="dtGet">
        <parameter name="@Action" value="Lijecnicki_get" />
        <parameter name="@ZNRDjelatniciLijecnickiId" value="$ZNRDjelatniciLijecnickiId"/>
      </data>
      <data command="spZNRDjelatnici_Help" name="dtIstekIzracun">
        <parameter name="@Action" value="DatumIsteka_izracun" />
        <parameter name="@DatumPregleda" value="#datDatumPregleda"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtUnos">
        <parameter name="@Action" value="Lijecnicki_unos" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@DatumPregleda" value="#datDatumPregleda"/>
        <parameter name="@ZNRUputniceId" value="#cmbUputnice"/>
        <parameter name="@DatumIsteka" value="#datDatumIsteka"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtIzmjena">
        <parameter name="@Action" value="Lijecnicki_izmjena" />
        <parameter name="@ZNRDjelatniciLijecnickiId" value="$ZNRDjelatniciLijecnickiId"/>
        <parameter name="@DatumPregleda" value="#datDatumPregleda"/>
        <parameter name="@DatumIsteka" value="#datDatumIsteka"/>
      </data>
    </datalist>
  </form>
</root>
