<root>
	<form name="frmFakturiraj" caption="Fakturiranje" width="350" height="300" fixedsize="true">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet"/>
			<action type="variable value">
				<parameter name="Global.VrstaPromSifra" value="30" type="string"/>
			</action>
		</event>
		<event type="onshown">
			<action type="control value" value="#datDatumIsporuke">
				<parameter value="~dtget.@DAtumIsporuke"/>
			</action>
		</event>
		<event type="onclose">
			<action type="variable value">
				<parameter name="Global.VrstaPromSifra" value="09" type="string"/>
			</action>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<tabs row="1" col="1" padding="4">
					<group caption="Osnovno" name="tabOsnovno" rows="6" cols="1" row="1" col="1" entermovenextcontrol="true">
						<item caption="Vrsta dokumenta:" row="1" col="1">
							<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" datavalue="~dtGet.@VrstaDokId" dataname="dtVrstaDokFak" required="true" allownull="false"/>
						</item>
						<item caption="Datum fakture:" row="2" col="1">
							<dateedit name="datDatumdok" datavalue="~dtGet.@DatumDok" required="true"/>
						</item>
						<item caption="Datum isporuke:" row="3" col="1">
							<dateedit name="datDatumIsporuke" value="~dtGet.@DatumDok" required="true"/>
						</item>
						<item caption="Partner:" row="4" col="1">
							<searchedit netgenfields="true" name="srcPartner" required="true" fontbold="true" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartnerNaziv">
								<event type="valuechanged">
									<action type="datarun reader" value="global.~dtPop"/>
									<action type="control value" value="#srcLokacija">
										<parameter value="global.~dtPop.@ParStruId" text="global.~dtPop.@Naziv"/>
									</action>
									<action type="variable value">
										<parameter name="PartneriId" value="#srcPartner"/>
									</action>
									<action type="variable value">
										<parameter name="IndPromijenjeno" value="1"/>
									</action>
									<action type="control enable" value="#srcKontakt" if="#srcPartner!=null&amp;&amp;$IndLoad==0">
										<action type="control populate" value="#srcKontakt"/>
									</action>
									<action type="control disable" value="#srcKontakt" if="#srcPartner==null">
										<action type="control datasource empty" value="#srcKontakt"/>
									</action>
									<action type="variable value">
										<parameter name="IndLoad" value="0"/>
									</action>
								</event>
			<!-- 					<event type="leave">
									<action type="datarun reader" value="Global.dtDajPartnera" if="#srcPartner!=null"/>
									<action type="control value" value="#srcLokacija" if="#srcPartner!=null&amp;&amp;#srcPartner.@BrojLokacija_Id==1">
										<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
									</action>
									<action type="form open" value="frmLokacije" if="#srcPartner.@BrojLokacija_Id!=null&amp;&amp;#srcPartner.@BrojLokacija_Id&gt;1&amp;&amp;$IndPromijenjeno==1">
										<parameter name="PartneriId" value="#srcPartner"/>
										<parameter name="IndLokacija" value="1"/>
										<parameter name="ParStruId" value="#srcLokacija"/>
									</action>
									<action type="control refreshvalue" value="#srcLokacija" if="#srcPartner==null"/>
									<action type="variable value">
										<parameter name="IndLokacija" value="0"/>
									</action>
									<action type="variable value">
										<parameter name="IndPromijenjeno" value="0"/>
									</action>
								</event> -->
							</searchedit>
						</item>
						<item caption="Lokacija:" row="5" col="1">
							<searchedit netgenfields="true" name="srcLokacija" required="true" dataname="Global.dtLokacija" fieldtext="Naziv" fieldvalue="ParStruId" datavalue="~dtGet.@ParStruId" datatext="~dtGet.@ParStruNaziv" autopopulate="false">
<!-- 								<event type="leave">
									<action type="datarun reader" value="Global.~dtDajPartnera" if="#srcLokacija!=null"/>
									<action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcLokacija!=null">
										<parameter value="Global.~dtDajPartnera.@partneriid" text="Global.~dtDajPartnera.@Naziv"/>
									</action>
								</event> -->
							</searchedit>
						</item>
						<item caption="Kontakt:" row="6" col="1">
							<searchedit name="srcKontakt" dataname="global.~dtPartnerOsoba" fieldtext="Naziv" fieldvalue="OsobeId" datavalue="~dtGet.@PartneriOsobeId" datatext="~dtGet.@PartnerOsoba"/>
						</item>
					</group>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnFaktururaj" caption="FAKTURIRAJ" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="1==1">
							<!-- if ako treba neka provjera -->
							<action type="confirm" value="Želite li kreirati fakturu?">
								<action type="datarun scalar" value="~dtFakturiraj">
									<parameter name="global.$FaktureId" value="~dtFakturiraj.@faktureid"/>
									<parameter name="global.BrojFak" value="~dtFakturiraj.@Broj"/>
								</action>
								<action type="control populate" value="parent.#grdDetail"/>
								<action if="global.$FaktureId==NULL">
									<action type="message" value="Faktura nije kreirana"/>
								</action>
								<action if="global.$FaktureId!=NULL">
									<action type="message" value="Kreirana je faktura"/>
									<action type="datarun scalar" value="~dtServisFak">
										<parameter name="global.$MjestoPlacanjaFak" value="~dtServisFak.@MjestoPlacanja"/>
									</action>
									<!-- dtServisFak -->
									<!-- <action type="message" value="!"/>								 -->
								</action>
								<action type="control enable" value="parent.#btnFakturiraj" if="global.$FaktureId==null"/>
								<action type="control disable" value="parent.#btnFakturiraj" if="global.$FaktureId!=null"/>
								<action type="form close"/>
							</action>
						</action>
						<action type="message" value="ako treba neka provjera" else=""/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_ServisRNGla_Fakturiraj" name="dtGet">
				<parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId"/>
			</data>
			<!--             <data command="spServisRNFakturiranjeCarpo" name="dtFakturiraj">
                <parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId" />
                <parameter name="@ServisRNBroj" value="#txtBroj" />
                <parameter name="@DatumDok" value="#datDatumDok" />
				<parameter name="@DatumIsporuke" value="#datDatumIsporuke" />
                <parameter name="@PartneriId" value="#srcPartner" />
                <parameter name="@ParStruId" value="#srcLokacija" />
                <parameter name="@OsobeParId" value="#srcKontakt" />
				<parameter name="@FaktureId" value="null" />
				<parameter name="@Broj" value="null" />
            </data> -->
			<data command="spFaktureAzurCarpo" name="dtFakturiraj">
				<parameter name="@Action" value="0"/>
				<parameter name="@ID" value="global.$ServisRNGlaId"/>
				<parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
				<parameter name="@Prefix" value=" "/>
				<parameter name="@PartneriId" value="#srcPartner"/>
				<parameter name="@DatumIsporuke" value="#datDatumIsporuke"/>
				<parameter name="@DatumDok" value="#datDatumdok"/>
				<!-- <parameter name="@DatumValute" value="parent.#grdDetail." /> -->
				<parameter name="@IznosFakture" value="0"/>
				<parameter name="@IznosPlaceni" value="0"/>
				<parameter name="@IznosPoreza" value="0"/>
				<parameter name="@BrojKnjige" value="0"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@DatumKnjizenja" value="null"/>
				<parameter name="@Sufix" value=" "/>
				<parameter name="@KupUgovoriId" value="0"/>
				<parameter name="@OrgShemaId" value="parent.#cmbOrgShema"/>
				<parameter name="@OsobeId" value="parent.#srcOdgovornaOsoba"/>
				<parameter name="@Broj" value=" "/>
				<parameter name="@BrojDok" value=" "/>
				<parameter name="@Status" value="1"/>
				<parameter name="@Storno" value="0"/>
				<parameter name="@ProNacinNaplateId" value="null"/>
				<parameter name="@ProNacinIsporukeId" value="null"/>
				<parameter name="@BrojNarudzbe" value=" "/>
				<parameter name="@Fak" value=" "/>
				<parameter name="@IndGlk" value="0"/>
				<parameter name="@VrBoda" value="null"/>
				<parameter name="@BodoviId" value="null"/>
				<parameter name="@VrVezano" value="0"/>
				<parameter name="@RUC" value="0"/>
				<parameter name="@Memo" value="null"/>
				<parameter name="@OsobeParId" value="#srcKontakt"/>
				<parameter name="@Cassa" value="0"/>
				<parameter name="@ProPlaUvjetiId" value="null"/>
				<parameter name="@DevIznos" value="0"/>
				<parameter name="@DevValuteId" value="null"/>
				<parameter name="@DevUplata" value="0"/>
				<parameter name="@PosaoId" value="0"/>
				<parameter name="@VrstaPromId" value="0"/>
				<parameter name="@ParStruId" value="#srcLokacija"/>
				<parameter name="@ProPonGlaId" value="global.$ServisRNGlaId"/>
				<parameter name="@ProNOtpGlaId" value="0"/>
				<parameter name="@PrepisiUvjete" value="0"/>
				<parameter name="@Opis1" value=" "/>
				<parameter name="@DatumIzdavanja" value="#datDatumIsporuke"/>
				<parameter name="@IznosSdr" value="0"/>
				<parameter name="@ValutaSdr" value=" "/>
				<parameter name="@TecajSdr" value="0"/>
				<parameter name="@StatusiId" value="0"/>
				<parameter name="@StatusNapomena" value=" "/>
			</data>
			<data command="spServisRNFakturiranjeCarpo" name="dtServisFak">
				<parameter name="@ServisRNGlaid" value="global.$ServisRNGlaId"/>
				<!-- 	<parameter name="@ServisRNBroj"  value="parent.#txtBroj" /> -->
				<parameter name="@Faktureid" value="global.$FaktureId"/>
				<parameter name="@Model" value="global.$Model"/>
				<parameter name="@KlasaUslugeId" value="parent.$KlasaUslugeId"/>
			</data>
			<data command="spNG_Combo" name="dtVrstaDokFak">
				<parameter name="@Action" value="VrstaDok"/>
				<parameter name="@Oznaka" value="30"/>
			</data>
			<data command="spTraziOsobe" name="dtKontakt">
				<parameter name="@Action" value="Osobe"/>
				<parameter name="@PartneriId" value="#srcPartner"/>
			</data>
		</datalist>
	</form>
	<form name="frmFakturaIzmjena:frmFakturaIzmjena" path="Faktura.frmFakturaIzmjena.xml"/>
</root>