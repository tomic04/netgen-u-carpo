<root version="1.0">
	<form name="frmPrikljucniPregled" type="master" caption="$caption" fixedsize="false" width="800" height="400" >
		<event type="init">
			<action type="datarun reader" value="~dtPrikljucniRucno" if="$tip==pregled PS" />
			<action type="datarun reader" value="~dtPrikljucni" else=""/>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdPrikljucni" />
		</event>
		<layout textposition="left" >
			<group cols="1" rows="1" groupbordervisible="false" if="$tip==pregled PS">
				<item col="1" row="1" >
					<grid name="grdPrikljucni" autopopulate="true" dataname="dtPrikljucniRucno" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false"  >
						<fields inherited="true">
							<field name="InvBroj" caption="Inventurni broj" editable="true"  />
							<field name="Naziv" caption="Naziv" editable="true"  />
							<field name="Marka" caption="Marka" editable="true"  />
							<field name="ModelTip" caption="Model/Tip" editable="true"  />
							<field name="Napomena" caption="Napomena" editable="true"  />
							<field name="SerBroj" caption="Serijski broj" editable="true"  />
							<field name="DatumNabave" caption="Datum nabave" editable="true" type="date" />
						</fields>
						<event type="cellvaluechanged">
							<action type="datarun nonquery" value="~dtUpdateRucno" />
							<action type="control populate keepfocus" value="#grdPrikljucni" />
						</event>
						<menu>
							<menuitem caption="Obriši" function="menObrisi" sort="1">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite obrisati označeni priključni stroj? ">
										<action type="datarun nonquery"   value="~dtDeletePrikljucniRucno"/>
										<action type="control populate" value="#grdPrikljucni"/>
									</action>
								</event>
							</menuitem>
						</menu>
					</grid>
				</item>
			</group>
			<group cols="1" rows="1" groupbordervisible="false" else="">
				<item col="1" row="1" else="">
					<grid name="grdPrikljucni" autopopulate="true" dataname="dtPrikljucni" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false"  enabled="false">
						<fields inherited="true">
							<field name="InvBroj" caption="Inventurni broj" />
							<field name="Naziv" caption="Naziv" />
							<field name="Marka" caption="Marka" />
							<field name="ModelTip" caption="Model/Tip" />
							<field name="Napomena" caption="Napomena" />
							<field name="SerBroj" caption="Serijski broj" />
							<field name="DatumNabave" caption="Datum nabave"/>
						</fields>						
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spZNRStrojevi_Query" name="dtPrikljucni">
				<parameter name="@Action" value="Prikljucni_pregled"/>
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtPrikljucniRucno" >
				<parameter name="@Action" value="PrikljucniRucno_pregled"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtPrikljucniRucno" >
				<parameter name="@Action" value="PrikljucniRucno_pregled"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtUpdateRucno" >
				<parameter name="@Action" value="Update_EditabilnoRucno"/>
				<parameter name="@ZNRStrojeviRucnoId" value="#grdPrikljucni.@ZNRStrojeviRucnoId"/>
				<parameter name="@InvBroj" value="#grdPrikljucni.@InvBroj"/>
				<parameter name="@Naziv" value="#grdPrikljucni.@Naziv"/>
				<parameter name="@Marka" value="#grdPrikljucni.@Marka"/>
				<parameter name="@ModelTip" value="#grdPrikljucni.@ModelTip"/>
				<parameter name="@Napomena" value="#grdPrikljucni.@Napomena"/>
				<parameter name="@SerBroj" value="#grdPrikljucni.@SerBroj"/>
				<parameter name="@DatumNabave" value="#grdPrikljucni.@DatumNabave"/>				
			</data>
			<data command="spZNRStrojevi_Azur" name="dtDeletePrikljucniRucno" >
				<parameter name="@Action" value="Brisanje_PrikljucniRucno"/>
				<parameter name="@ZNRStrojeviRucnoId" value="#grdPrikljucni.@ZNRStrojeviRucnoId"/>
				<parameter name="@ZNRStrojeviId" value="#grdPrikljucni.@ZNRStrojeviId"/>
			</data>
		</datalist>
	</form>
</root>
