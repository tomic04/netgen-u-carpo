<root>
  <!-- ovo je kad iz forme unosa idemo na Dodaj -->
  <form name="frmStavkeDetalj" caption="Stavke prijema" width="300" height="250">
    <event type="shown">
      <action type="datarun reader" value="~dtGetDetalj"/>
      <action type="control value" value="#srcRoba">
        <parameter value="~dtGetDetalj.@RobaId" text="~dtGetDetalj.@Naziv"/>
      </action>
      <action type="control value" value="#txtVrUl" if="$SktPrometDetId!=null">
        <parameter value="~dtGetDetalj.@VrijednostUlaz"/>
      </action>
      <action type="control value" value="#txtVrIz" if="$SktPrometDetId!=null">
        <parameter value="~dtGetDetalj.@VrijednostIzlaz"/>
      </action>
    </event>
    <layout>
      <group cols="1" rows="3" groupbordervisible="false">
        <item col="1" row="1" caption="Roba">
          <searchedit name="srcRoba" dataname="dtTraziRobu" fieldvalue="RobaId" fieldtext="NazivId"/>
        </item>
        <item col="1" row="2" caption="Vrijednost ulaz">
          <textedit name="txtVrUl" format="n4" value="0"/>
        </item>
        <item col="1" row="3" caption="Vrijednost izlaz">
          <textedit name="txtVrIz" format="n4" value="0"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnOK" caption="U redu">
          <event type="click">
            <action type="datarun nonquery" value="~dtUnosDet">
              <parameter name="@ID"/>
            </action>
            <action type="control value" value="#srcRoba" if="$SktPrometDetId==null">
              <parameter value="null"/>
            </action>
            <action type="control value" value="#txtVrIz,#txtVrUl" if="$SktPrometDetId==null">
              <parameter value="0"/>
            </action>
            <action type="control populate" value="parent.#grdRobaPromet"/>
            <action type="control focus" value="#srcRoba"  if="$SktPrometDetId==null"/>
            <action type="form close"  if="$SktPrometDetId!=null"/>
          </event>
        </button>
        <button name="btnCancel" caption="Odustani" type="cancel"/>
        <button name="btnUputiMe" caption="Uputi me">
          <event type="click">
            <action type="message" value="Ova funkcionalnost trenutno nije dostupna, molimo kontaktirajte Spin!"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtTraziRobu" command="spTraziRoba">
        <parameter name="@Action" value="Roba"/>
        <parameter name="@Uvjet" value="#srcRoba.text"/>
      </data>
      <data name="dtGetDetalj" command="spCRobnoPrometKorekcija_DetJedan">
        <parameter name="@SktPrometDetId" value="$SktPrometDetId"/>
      </data>
      <data name="dtUnosDet" command="spCRobnoPrometKorekcija">
        <parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
        <parameter name="@Action" value="0" if="$SktPrometDetId==null"/>
        <parameter name="@Action" value="1" if="$SktPrometDetId!=null"/>
        <parameter name="@RobaId" value="#srcRoba"/>
        <parameter name="@VrijednostUlaz" value="#txtVrUl"/>
        <parameter name="@VrijednostIzlaz" value="#txtVrIz"/>
        <parameter name="@SktPrometDetId" value="$SktPrometDetId"/>
      </data>
    </datalist>
  </form>


</root>