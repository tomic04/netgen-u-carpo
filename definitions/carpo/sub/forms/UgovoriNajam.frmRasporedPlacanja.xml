<root>
  <form name="frmRasporedPlacanja" caption="Raspored plaćanja" height="500" width="850">
    <event type="init">
      <action type="datarun reader" value="~dtGetIznosUkupno"/>
    </event>
    <event type="load">
      <action type="control populate" value="#grdRaspored"/>
      <action type="control value" value="#lblIznosPlacanjaUkupno">
        <parameter value="~dtGetIznosUkupno.@IznosPlacanjaUkupno"/>
      </action>
    </event>
    <layout>
      <group rows="2" cols="2">
        <columnsdefinition>
          <column position="1" size="90%"/>
          <column position="2" size="10%"/>
        </columnsdefinition>
        <item row="1" col="1">
          <grid name="grdRaspored" bestfitonrefresh="true" dataname="~dtGetRasporedPlacanja" multiselect="true" showcheckboxes="true">
            <fields inherited="true">
              <field name="RedniBroj" caption="Redni broj"/>
              <field name="ValutaNaziv" caption="Valuta"/>
              <field name="DatumDospijeca" caption="Datum dospijeća" editable="true" edittype="date"/>
              <field name="IznosPlacanja" caption="Iznos plaćanja" editable="true"/>
              <field name="UkljuceneUslugeUiznosNajma" caption="Uključene usluge u iznos najma" editable="true"/>
              <field name="RazlogNepravilnogPlacanja" caption="Razlog nepravilnog plaćanja" editable="true"/>
            </fields>

            <event type="cellvaluechanged">
              <action type="datarun nonquery" value="~dtUpdateRasporedPlacanjaPolje"/>
              <action type="control populate keepfocus" value="#grdRaspored"/>
              <action type="datarun reader" value="~dtGetIznosUkupno"/>
              <action type="control value" value="#lblIznosPlacanjaUkupno">
                <parameter value="~dtGetIznosUkupno.@IznosPlacanjaUkupno"/>
              </action>
            </event>
          </grid>
        </item>
        <item row="2" col="1" caption="Ukupni iznos plaćanja" fontbold="true">
          <labeledit name="lblIznosPlacanjaUkupno" format="n2"/>
        </item>
        <group row="1" col="2" rows="3" cols="1" bordervisible="false">
          <rowsdefinition>
            <row position="1" size="60"/>
            <row position="2" size="60"/>
            <row position="3" size="100%"/>
          </rowsdefinition>
          <group row="1" col="1" rows="2" cols="1" bordervisible="false">
            <rowsdefinition>
              <row position="1" size="60"/>
              <row position="2" size="60"/>
            </rowsdefinition>
            <item row="1" col="1">
              <button name="btnDodaj" caption="Dodaj">
                <event type="click">
                  <action type="form open" value="frmRasporedPlacanjaStavkeUnos">
                    <parameter name="UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
                    <parameter name="ValuteId" value="$ValuteId"/>
                  </action>
                  <action type="datarun reader" value="~dtGetIznosUkupno"/>
                  <action type="control value" value="#lblIznosPlacanjaUkupno">
                    <parameter value="~dtGetIznosUkupno.@IznosPlacanjaUkupno"/>
                  </action>
                </event>
              </button>
            </item>
            <item row="2" col="1">
              <button name="btnObrisi" caption="Obriši">
                <event type="click">
                  <action type="confirm" value="Potvrdite brisanje"/>
                  <action type="control foreachrow selected" value="#grdRaspored">
                    <action type="datarun nonquery" value="~dtObrisiUnos"/>
                  </action>
                  <action type="control populate" value="#grdRaspored"/>
                  <action type="datarun reader" value="~dtGetIznosUkupno"/>
                  <action type="control value" value="#lblIznosPlacanjaUkupno">
                    <parameter value="~dtGetIznosUkupno.@IznosPlacanjaUkupno"/>
                  </action>
                </event>
              </button>
            </item>
          </group>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="Zatvori" type="cancel" dock="right"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtGetRasporedPlacanja" command="spUgovoriNajamDet_GetRasporedPlacanja">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
      </data>
      <data name="dtGetIznosUkupno" command="spUgovoriNajamDet_RasporedPlacanja_UkupniIznos">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
      </data>
      <data name="dtObrisiUnos" command="spUgovoriNajamDet_RasporedPlacanjaUnos_Delete">
        <parameter name="@UgovoriNajamRasporedPlacanjaId" value="#grdRaspored.@UgovoriNajamRasporedPlacanjaId"/>
      </data>
      <data name="dtUpdateRasporedPlacanjaPolje" command="spUgovoriNajamDet_RasporedPlacanja_UpdatePolje">
        <parameter name="@UgovoriNajamRasporedPlacanjaId" value="#grdRaspored.@UgovoriNajamRasporedPlacanjaId"/>
        <parameter name="@DatumDospijeca" value="#grdRaspored.@DatumDospijeca"/>
        <parameter name="@IznosPlacanja" value="#grdRaspored.@IznosPlacanja"/>
        <parameter name="@UkljuceneUslugeUiznosNajma" value="#grdRaspored.@UkljuceneUslugeUiznosNajma"/>
        <parameter name="@RazlogNepravilnogPlacanja" value="#grdRaspored.@RazlogNepravilnogPlacanja"/>
      </data>
    </datalist>
  </form>
</root>