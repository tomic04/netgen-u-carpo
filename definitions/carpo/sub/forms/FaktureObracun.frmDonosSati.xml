<root>
    <form name="frmDonosSati" caption="Donos sati iz PT obračuna" width="" height="" fixedsize="">
		<event type="onclose">
			<action type="control populate" value="parent.#grdGlava" /> 			
		</event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="2" groupbordervisible="true">
                <group rows="1" cols="1" row="1" col="1" entermovenextcontrol="true" groupbordervisible="False">                    
					<item caption="PT obračun:" row="1" col="1">
						<comboedit name="cmbObracun" valuefield="PtObracunId" displayfield="Obracun" dataname="~dtObracun" enabled=""/>
                    </item>                  				
                </group>
                <group rows="1" cols="1" row="2" col="1" entermovenextcontrol="true" groupbordervisible="False">                    
					<item caption="Partner:" row="1" col="1">
						<searchedit netgenfields="true" savelayout="true" name="srcPartner" required="" fontbold="true" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="PartneriId" datavalue="" datatext="">						
						</searchedit>
                    </item>                  				
                </group>				
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="DONESI" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtDonesi"/>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spFaktureObracun_UnosSati" name="dtDonesi">
                <parameter name="@FaktureObracunId" value="$FaktureObracunId" />
				<parameter name="@BugsUtrObracunId" value="#cmbObracun"/>				
				<parameter name="@operateriid" value="@@OperateriId"/>
				<parameter name="@partneriid" value="#srcPartner"/>
            </data>
            <data command="spFaktureObracun_ObracunIzbor" name="dtObracun">
                <parameter name="@FaktureObracunId" value="$FaktureObracunId" />
            </data>				
        </datalist>
    </form>
</root>