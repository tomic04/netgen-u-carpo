<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmObracun" caption ="$caption" width="650" height="400"  fixedsize="true" saveformsize="false" showversion="true" version="2">
    <event type="init">
      <action type="datarun reader" value="~dtDefault" />
      <action type="datarun reader" value="~dtGet" />

      <action type="variable value">
        <parameter name="OznakaJOPPD" value="~dtDefault.@oznakaJOPPD" type="string"/>
      </action>


    </event>

    <event type="load">

      <action type="control disable" value="#chkStavke" if="~dtDefault.@visStavke==0"/>
      <action type="control enable" value="#chkStavke" else=""/>


      <action type="control disable" value="#chkObustave" if="~dtDefault.@visObustave==0"/>
      <action type="control enable" value="#chkObustave" else=""/>


      <action type="control disable" value="#chkVirmani" if="~dtDefault.@visVirmani==0"/>
      <action type="control enable" value="#chkVirmani" else=""/>


      <action type="control disable" value="#chkJOPPD" if="~dtDefault.@visJOPPD==0"/>
      <action type="control enable" value="#chkJOPPD" else=""/>


      <action type="control value" value="#lblBrojStavke">
        <parameter value="~dtDefault.@BrojacObracuna"/>
      </action>
      <action type="control value" value="#lblBrojObustave">
        <parameter value="~dtDefault.@BrojacObustava"/>
      </action>
      <action type="control value" value="#lblBrojVirmani">
        <parameter value="~dtDefault.@BrojacVirmana"/>
      </action>
      <action type="control value" value="#lblBrojJOPPD">
        <parameter value="~dtDefault.@BrojacJOPPD"/>
      </action>
      <action type="control value" value="#lblOznakaJOPPD">
        <parameter value="~dtDefault.@OznakaJOPPD"/>
      </action>

      <action type="control disable" value="#datDatumJOPPD,#cmbOpcijeJOPPD"></action>
      <action type="control visible" value="#lblNapomena">
        <parameter value="false"/>
      </action>

      <action type="control populate" value="#cmbOpcijeJOPPD"/>
      <action type="control value" value="#lblNapomena">
        <parameter value="#cmbOpcijeJOPPD.@napomena"/>
      </action>


      <action type="control value" value="#lblOperaterStavke">
        <parameter value="~dtDefault.@OperaterStavke"/>
      </action>
      <action type="control value" value="#lblDatumStavke">
        <parameter value="~dtDefault.@LogDatumStavke"/>
      </action>

      <action type="control value" value="#lblOperaterObustave">
        <parameter value="~dtDefault.@OperaterObustave"/>
      </action>
      <action type="control value" value="#lblDatumObustave">
        <parameter value="~dtDefault.@LogDatumObustave"/>
      </action>

      <action type="control value" value="#lblOperaterVirmani">
        <parameter value="~dtDefault.@OperaterVirmani"/>
      </action>
      <action type="control value" value="#lblDatumVirmani">
        <parameter value="~dtDefault.@LogDatumVirmani"/>
      </action>

      <action type="control value" value="#lblOperaterJOPPD">
        <parameter value="~dtDefault.@OperaterJOPPD"/>
      </action>
      <action type="control value" value="#lblDatumJOPPD">
        <parameter value="~dtDefault.@LogDatumJOPPD"/>
      </action>

    </event>

    <event type="shown">
      <action type="control attribute" value="#chkStavke,#chkObustave,#chkJOPPD,#chkVirmani">
        <parameter name="fontcolor" value="black"/>
      </action>
    </event>

    <layout>

      <!--omotač-->
      <group cols="1" rows="4" groupbordervisible="true"  caption="Opcije obračuna">

        <!--<columnsdefinition>
          <column position="1" size="85%"></column>
          <column position="2" size="15%"></column>
        </columnsdefinition>-->

        <!--<rowsdefinition>
          <row position="1" size="10%"></row>
          <row position="2" size="10%"></row>
          <row position="3" size="10%"></row>
          <row position="4" size="10%"></row>
          <row position="5" size="10%"></row>
          <row position="6" size="10%"></row>
          <row position="7" size="10%"></row>
          <row position="8" size="10%"></row>
          <row position="9" size="10%"></row>
          <row position="10" size="10%"></row>
        </rowsdefinition>-->

        <group col="1" row="1" cols="4" rows="1"  groupbordervisible="true"   spacing="2,1,2,2">

          <columnsdefinition>
            <column position="1" size="40%"></column>
            <column position="2" size="10%"></column>
            <column position="3" size="10%"></column>
            <column position="4" size="40%"></column>
          </columnsdefinition>

          <item col="1" row="1" textposition="right"  highlight="False">
            <checkedit name="chkStavke" caption="Obračun stavki do neta" fontsizedelta="3"  />
          </item>
          <item caption="" col="2" row="1"  >
            <labeledit name="lblBrojStavke"   fontsizedelta="3" fontbold="true" textposition="right"/>
          </item>
          <item caption="" col="3" row="1"  >
            <labeledit name="lblOperaterStavke"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>
          <item caption="" col="4" row="1"  >
            <labeledit name="lblDatumStavke"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>



        </group>
        <group col="1" row="2" cols="4" rows="1"  groupbordervisible="true"   spacing="2,1,2,2">

          <columnsdefinition>
            <column position="1" size="40%"></column>
            <column position="2" size="10%"></column>
            <column position="3" size="10%"></column>
            <column position="4" size="40%"></column>
          </columnsdefinition>

          <item col="1" row="1" textposition="right"   fontsizedelta="1" highlight="False">
            <checkedit name="chkObustave" caption="Obračun obustava" fontsizedelta="3"  />
          </item>

          <item caption="" col="2" row="1"  >
            <labeledit name="lblBrojObustave"   fontsizedelta="4" fontbold="true" textposition="right"/>
          </item>
          <item caption="" col="3" row="1"  >
            <labeledit name="lblOperaterObustave"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>
          <item caption="" col="4" row="1"  >
            <labeledit name="lblDatumObustave"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>


        </group>

        <group col="1" row="3" cols="4" rows="5"  groupbordervisible="true"  spacing="2,1,2,2" alignmode="local">

          <columnsdefinition>
            <column position="1" size="40%"></column>
            <column position="2" size="10%"></column>
            <column position="3" size="10%"></column>
            <column position="4" size="40%"></column>
          </columnsdefinition>

          <item col="1" row="1" textposition="right"   fontsizedelta="1" highlight="False">
            <checkedit name="chkJOPPD" checked="false" caption="Kreiranje JOPPD obrasca" fontsizedelta="3"  >
              <event type="checkedchanged">
                <action type="control enable" value="#datDatumJOPPD, #cmbOpcijeJOPPD" if="#chkJOPPD==true"></action>
                <action type="control disable" value="#datDatumJOPPD, #cmbOpcijeJOPPD" else=""></action>
                <action type="control visible" value="#lblNapomena" if="#chkJOPPD==true">
                  <parameter value="true"/>
                </action>
                <action type="control visible" value="#lblNapomena" else="">
                  <parameter value="false"/>
                </action>

              </event>
            </checkedit>
          </item>

          <item caption="" col="2" row="1" >
            <labeledit name="lblBrojJOPPD"   fontsizedelta="2" fontbold="true"  textposition="right"/>
          </item>
          <item caption="" col="3" row="1"  >
            <labeledit name="lblOperaterJOPPD"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>
          <item caption="" col="4" row="1"  >
            <labeledit name="lblDatumJOPPD"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>



          <item caption="" col="1" row="2" colspan="4" >
            <labeledit name="lblNapomena"   fontsizedelta="2" fontbold="true"  textposition="left" value="Napomena....." fontcolor="blue" datavalue="~dtOpcijeJOPPD.@napomena" multiline="true"/>
          </item>

          <item  col="1" row="3" colspan="2" textposition="left"  highlight="False">
            <dateedit name="datDatumJOPPD" datavalue="~dtDefault.@DatumJOPPD" caption="Datum JOPPD:">
              <!--<event type="valuechanged">
                <action type="datarun reader" value="~dtDajJOPPDOznaku"/>
                <action type="control value" value="#lblOznakaJOPPD">
                  <parameter value="~dtDajJOPPDOznaku.@oznaka"/>
                </action>
              </event>-->
              <event type="valuechanged">
                <action type="datarun reader" value="~dtDajJOPPDOznaku"/>
                <action type="control value" value="#lblOznakaJOPPD">
                  <parameter value="~dtDajJOPPDOznaku.@oznaka"/>
                </action>
                <action type="variable value" value="$OznakaJOPPD">
                  <parameter value="~dtDajJOPPDOznaku.@oznaka"/>
                </action>
                <action type="control populate" value="#cmbOpcijeJOPPD"/>
                <action type="control value" value="#lblNapomena">
                  <parameter value="#cmbOpcijeJOPPD.@napomena"/>
                </action>
              </event>
            </dateedit>
          </item>

          <item caption="" col="3" row="3" >
            <labeledit name="lblOznakaJOPPD"   fontsizedelta="2"   textposition="right"/>
          </item>


          <!--<item caption="Vrsta izvješća:" col="1" row="4" colspan="2" textposition="left"  highlight="False">
            <comboedit name="cmbVrsta" autopopulate="false" allownull="false" displayfield="Opis" valuefield="KODVrsteIzvjescaId" dataname="~dtVrstaIzvjesca"/>
          </item>-->

          <item caption="Opcija spremanja:" col="1" row="4" colspan="4"  highlight="False" textposition="left" >
            <comboedit name="cmbOpcijeJOPPD" autopopulate="false" allownull="false" displayfield="opcijaTxt" valuefield="IndOpcija" dataname="~dtOpcijeJOPPD" required="true" />
          </item>


        </group>

        <group col="1" row="4" cols="4" rows="1"  groupbordervisible="true"  spacing="2,1,2,2">

          <columnsdefinition>
            <column position="1" size="40%"></column>
            <column position="2" size="10%"></column>
            <column position="3" size="10%"></column>
            <column position="4" size="40%"></column>
          </columnsdefinition>

          <!--<item  col="1" row="1" textposition="right"   fontsizedelta="1" highlight="False">
            <checkedit name="chkVirmani" fontcolor="black" caption=""/>
          </item>-->

          <!--<item caption="" col="2" row="1"  >
            <textedit name="lblCapVirmani" value="Kreiranje virmana"  fontsizedelta="2" fontcolor="black" enabled="false" readonly="true"  />
          </item>-->

          <item col="1" row="1" textposition="right"   fontsizedelta="1" highlight="false">
            <checkedit name="chkVirmani"  caption="Kreiranje virmana" fontsizedelta="3"  />
          </item>

          <item caption="" col="2" row="1"  >
            <labeledit name="lblBrojVirmani"   fontsizedelta="2" fontbold="true" textposition="right"/>
          </item>

          <item caption="" col="3" row="1"  >
            <labeledit name="lblOperaterVirmani"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>
          <item caption="" col="4" row="1"  >
            <labeledit name="lblDatumVirmani"   fontsizedelta="3" fontbold="false" textposition="right"/>
          </item>

        </group>




      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnObracunaj" caption="OBRAČUNAJ" >
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />

            <action type="control attribute" value="#chkStavke,#chkObustave,#chkJOPPD,#chkVirmani">
              <parameter name="fontcolor" value="black"/>
            </action>




            <!--napravi varijablu u koju spremaš indikator greške-->
            <action type="variable value">
              <parameter name="greskaObracun" value="0" type="int"/>
            </action>


            <action if="#chkStavke==false&amp;&amp;#chkObustave==false&amp;&amp;#chkVirmani==false&amp;&amp;#chkJOPPD==false">
              <action type="message" value="Potrebno je odabrati jednu od opcija obračuna" />
            </action>

            <action if="#chkStavke==true||#chkObustave==true||#chkVirmani==true||#chkJOPPD==true" stop="true">
            </action>



            <!-- Okini storu -->
            <!--obračun stavki-->

            <action if="#chkStavke==true">
              <action type="datarun reader" value="~dtObracunStavki" waittype="progress" waitcaption="Pričekajte..." waittext="..obračun stavki u tijeku..." >
                <action type="variable value" value="$greskaObracun" >
                  <parameter value="~dtObracunStavki.@Id"/>
                </action>
              </action>
              <action  if="$greskaObracun==1">
                <action type="control attribute" value="#chkStavke">
                  <parameter name="fontcolor" value="red"/>
                </action>
                <action type="message" value="~dtObracunStavki.@Poruka"/>
              </action>

              <action if="$greskaObracun==0">
                <action type="control attribute" value="#chkStavke">
                  <parameter name="fontcolor" value="green"/>
                </action>
                <action type="control value" value="#lblBrojStavke">
                  <parameter value="~dtObracunStavki.@BrojacObracuna"/>
                </action>
                <action type="datarun reader" value="~dtDefault" />
                <action type="control value" value="#lblDatumStavke">
                  <parameter value="~dtDefault.@LogDatumStavke"/>
                </action>
                <action type="control value" value="#lblOperaterStavke">
                  <parameter value="~dtDefault.@OperaterStavke"/>
                </action>

              </action>

            </action>

            <!--obračun obustava-->
            <action if="#chkObustave==true&amp;&amp;$greskaObracun==0">
              <action type="datarun reader" value="~dtObracunObustava" waittype="progress" waitcaption="Pričekajte..." waittext="..obračun obustava u tijeku...">
                <action type="variable value" value="$greskaObracun" >
                  <parameter value="~dtObracunObustava.@Id"/>
                </action>
              </action>

              <action  if="$greskaObracun==1">
                <action type="control attribute" value="#chkObustave">
                  <parameter name="fontcolor" value="red"/>
                </action>
                <action type="message" value="~dtObracunObustava.@Poruka"/>
              </action>
              <action if="$greskaObracun==0">
                <action type="control attribute" value="#chkObustave">
                  <parameter name="fontcolor" value="green"/>
                </action>
                <action type="control value" value="#lblBrojObustave">
                  <parameter value="~dtObracunObustava.@BrojacObustava"/>
                </action>
                <action type="datarun reader" value="~dtDefault" />
                <action type="control value" value="#lblDatumObustave">
                  <parameter value="~dtDefault.@logDatumObustave"/>
                </action>
                <action type="control value" value="#lblOperaterObustave">
                  <parameter value="~dtDefault.@OperaterObustave"/>
                </action>
              </action>
            </action>

            <!--kreiranje joppd-->
            <action if="#chkJOPPD==true&amp;&amp;$greskaObracun==0">
              <action type="datarun reader" value="~dtObracunJOPPD" waittype="progress" waitcaption="Pričekajte..." waittext="..kreiranje JOPPD obrasca u tijeku...">
                <action type="variable value" value="$greskaObracun" >
                  <parameter value="~dtObracunJOPPD.@Id"/>
                </action>
              </action>

              <action  if="$greskaObracun==1">
                <action type="control attribute" value="#chkJOPPD">
                  <parameter name="fontcolor" value="red"/>
                </action>
                <action type="message" value="~dtObracunJOPPD.@Poruka"/>
              </action>

              <!--<action type="message" value="~dtObracunJOPPD.@Poruka" if="$greskaObracun==1"/>-->
              <action if="$greskaObracun==0">
                <!--<action type="control value" value="#lblBrojJOPPD" if="$greskaObracun==0">-->
                <!--<action type="message" value="greška je nula"/>-->
                <action type="control attribute" value="#chkJOPPD">
                  <parameter name="fontcolor" value="green"/>
                </action>
                <action type="control value" value="#lblBrojJOPPD">
                  <parameter value="~dtObracunJOPPD.@BrojacJOPPD"/>
                </action>
                <!--<action type="control populate" value="#cmbOpcijeJOPPD"/>-->
                <action type="control populate" value="#cmbOpcijeJOPPD"/>
                <action type="control value" value="#lblNapomena">
                  <parameter value="#cmbOpcijeJOPPD.@napomena"/>
                </action>
                <action type="datarun reader" value="~dtDefault" />
                <action type="control value" value="#lblDatumJOPPD">
                  <parameter value="~dtDefault.@logDatumJOPPD"/>
                </action>
                <action type="control value" value="#lblOperaterJOPPD">
                  <parameter value="~dtDefault.@OperaterJOPPD"/>
                </action>

              </action>
            </action>

            <!--kreiranje virmana-->
            <action if="#chkVirmani==true&amp;&amp;$greskaObracun==0">
              <action type="datarun reader" value="~dtObracunVirmana" waittype="progress" waitcaption="Pričekajte..." waittext="..kreiranje virmana u tijeku..." >
                <action type="variable value" value="$greskaObracun" >
                  <parameter value="~dtObracunVirmana.@Id"/>
                </action>
              </action>



              <action  if="$greskaObracun==1">
                <action type="control attribute" value="#chkVirmani">
                  <parameter name="fontcolor" value="red"/>
                </action>
                <action type="message" value="~dtObracunVirmana.@Poruka"/>
              </action>

              <action if="$greskaObracun==0">
                <action type="control attribute" value="#chkVirmani">
                  <parameter name="fontcolor" value="green"/>
                </action>
                <action type="control value" value="#lblBrojVirmani">
                  <parameter value="~dtObracunVirmana.@BrojacVirmana"/>
                </action>
                <action type="datarun reader" value="~dtDefault" />
                <action type="control value" value="#lblDatumVirmani">
                  <parameter value="~dtDefault.@logDatumVirmani"/>
                </action>
                <action type="control value" value="#lblOperaterVirmani">
                  <parameter value="~dtDefault.@OperaterVirmani"/>
                </action>
              </action>
            </action>




            <action type="message" value="Obračun je završen" if="$greskaObracun==0"/>



          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlace_help" name="dtDajJOPPDOznaku">
        <parameter name="@Action" value="postavi_joppd_oznaku" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@datum" value="#datDatumJOPPD"/>
      </data>
      <data command="spPlaceObracun" name="dtObracunStavki" timeout="~dtDefault.@TimeOutStavke">
        <parameter name="@Action" value="obr_stavke" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
      <data command="spPlaceObracun" name="dtObracunObustava" timeout="~dtDefault.@TimeOutObustave">
        <parameter name="@Action" value="obr_obustave" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
      <data command="spPlaceObracun" name="dtObracunVirmana" timeout="~dtDefault.@TimeOutVirmani">
        <parameter name="@Action" value="obr_virmani" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
      <data command="spPlaceObracun" name="dtObracunJOPPD" timeout="~dtDefault.@TimeOutJOPPD">
        <parameter name="@Action" value="obr_joppd" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
        <parameter name="@joppdDatum"  value="#datDatumJOPPD"/>
        <parameter name="@joppdOznaka" value="$OznakaJOPPD"/>
        <parameter name="@kodjoppdaid" value="#cmbOpcijeJOPPD.@kodjoppdaid"/>
        <parameter name="@opcijaJOPPD" value="#cmbOpcijeJOPPD"/>
      </data>
      <data command="spPlace_help" name="dtDefault">
        <parameter name="@Action" value="default_obracun" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
      <data command="spPlace_help" name="dtOpcijeJOPPD">
        <parameter name="@Action" value="kontrola_opcije_joppd" type="string"/>
        <parameter name="@oznakajoppd" value="$OznakaJOPPD"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>