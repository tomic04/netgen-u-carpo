<root>
	<form name="frmRobnaMarkaInsertEdit" caption="Robna Marka" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<event type="shown">
		</event>
		<layout textposition="left">
			<group rows="3" cols="1" bordervisible="false">
				<item row="1" col="1" colspan="1" caption="Opis robne marke:">
					<textedit name="txtOpis" datavalue="~dtGet.@Opis"/>
				</item>
				<item row="2" col="1" colspan="2" caption="Šifra">
					<textedit name="txtSifra" datavalue="~dtGet.@Sifra"/>
				</item>
				<item row="3" col="1" colspan="3" caption="Partner:">
					<searchedit name="srcPartneri" fieldtext="Partner3000" fieldvalue="partneriid" datavalue="~dtGet.@partneriid" datatext="~dtGet.@Partner3000" dataname="~dtPartneri" required="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate"/>
							<action type="datarun scalar" value="~dtDataEdit" if="$RobnaMarkaid!=null">
								<parameter name="parent.$RobnaMarkaid"/>
							</action>	
							<action type="datarun scalar" value="~dtDataInsert" else="">
								<parameter name="parent.$RobnaMarkaid"/>
								<action type="control populate" value="parent.#grdMaster"/>
								<action type="control focus" value="parent.#grdMaster">
									<parameter value="parent.$RobnaMarkaid" type="int"/>
								</action>
							</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spRobnaMarka_Query" name="dtGet">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$RobnaMarkaid" />
			</data>	
			<data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartneri.text" />
			</data>
			
			<data command="spRobnaMarka_Azur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@Sifra" value="#txtSifra"/>
				<parameter name="@PartneriId" value="#srcPartneri"/>
			</data>
			<data command="spRobnaMarka_Azur" name="dtDataEdit">
				<parameter name="@Action" value="1" />
				<parameter name="@RobnaMarkaId" value="$RobnaMarkaid" />
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@Sifra" value="#txtSifra"/>
				<parameter name="@PartneriId" value="#srcPartneri"/>
			</data>
		</datalist>
	</form>
</root>