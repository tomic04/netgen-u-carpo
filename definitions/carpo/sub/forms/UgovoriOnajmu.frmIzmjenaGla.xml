<root>
  <form name="frmIzmjenaGla" type="master" height="600" width="800">
    <event type="shown">
      <action type="control disable" value="#txtBrojUgovora, #datUgovorProduljenDo"/>
      <action type="control visible" value="#txtTrajanjeProduljenja, #srcBrojNovogUgovora, #srcBrojPrethodnogUgovora, #datDatumPrestanka, #txtBrojProduljenja, #chkZasebanUgovor,
              #srcTrazilicaUgovora, #txtObavijesniPeriod, #datDatumPrimopredaje">
        <parameter value="false"/>
      </action>
    </event>
    <layout>
      <group rows="1" cols="2">
        <group rows="24" cols="1" row="1" col="1">
          <part name="UnosIzmjenaSloga" path="prtUgovoriOnajmu.xml"/>
        </group>
        <item row="1" col="2">
          <grid name="grdDetStavke"/>
        </item>
      </group>  
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="#srcTrazilicaUgovora==null">
              <action type="message" value="Nije odabran ugovor"/>
            </action>
            <action type="datarun scalar" value="~dtGetNovaOznaka">
              <parameter name="noviBrojDokumenta"/>
            </action>
            <action type="datarun nonquery" value="~dtInsert"/>
            <action type="control populate" value="parent.#grdGla"/>
            <action type="form close"/>
          </event>
        </button>
        <!--<button name="1"/>
        <button name="1"/>-->
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spUgovoriNajamGla_Insert" name="dtInsert">
        <parameter name="@UgovoriNajamVrsteId" value="#cmbVrstaUgovora"/>
        <parameter name="@UgovoriNajamTipTrajanja" value="#cmbTipTrajanja"/>
        <parameter name="@BrojProduljenja" value="#txtBrojProduljenja"/>
        <parameter name="@TrajanjeProduljenja" value="#txtTrajanjeProduljenja"/>
        <parameter name="@Broj" value="$noviBrojDokumenta"/>
        <parameter name="@DatumPotpisivanjaUgovora" value="#datDatumPotpisivanja"/>
        <parameter name="@DatumPocetkaVazenjaUgovora" value="#datDatumPocetka"/>
        <parameter name="@DatumPrestankaVazenjaUgovora" value="#datDatumPrestanka"/>
        <parameter name="@UgovorProduljenDo" value="#datUgovorProduljenDo"/>
        <parameter name="@ProcijenjeniDatumPrestanka" value="#datProcDatumPrestanka"/>
        <parameter name="@OtkazniRokTele2" value="#txtOtkazniRokTele2"/>
        <parameter name="@OtkazniRokPartner" value="#txtOtkazniRokPartner"/>
        <parameter name="@ObavijesniPeriod" value="#txtObavijesniPeriod"/>
        <parameter name="@DatumPrimopredaje" value="#datDatumPrimopredaje"/>
        <parameter name="@UgovorNajamStatusiId" value="#cmbStatus"/>
        <parameter name="@SljedeciUgovorId" value="#srcBrojNovogUgovora"/>
        <parameter name="@PrethodniUgovorId" value="#srcBrojPrethodnogUgovora"/>
        <parameter name="@OrgshemaId" value="#srcOrgShema"/>
        <parameter name="@StrujaUgovorInd" value="#chkZasebanUgovor"/>
        <parameter name="@StrujaUgovorId" value="#srcTrazilicaUgovora"/>
        <parameter name="@oznaka" value="#cmbVrstaUgovora.@Oznaka"/>
      </data>
       <data command="spUgovoriNajamGla_TrazilicaUgovoraPoStatusu" name="dtSearchUgovoriPoStatusu">
        <parameter name="@status" value="#cmbStatus.text"/>
        <parameter name="@UgovoriNajamVrsteId" value="#cmbVrstaUgovora"/>
        <parameter name="@UgovorNajamStatusiId" value="#cmbStatus"/>
      </data>
      <data command="spUgovoriNajamGla_TrazilicaUgovoraPoVrsti" name="dtSearchUgovoriPoVrsti"/>
      <data command="spUgovoriNajamGla_GetUgovori" name="dtGetUgovori">
        <parameter name="@ugovoriNajamVrsteId" value="#cmbVrstaUgovora"/>
        <parameter name="@status" value="#cmbStatus"/>
      </data>
      <data command="spUgovoriNajamGla_RacunajOznakuUgovora" name="dtGetNovaOznaka">
        <parameter name="@oznaka" value="#cmbVrstaUgovora.@Oznaka"/>
      </data>
      <data command="spUgovoriNajamGla_TipRazdobljaTrajanjaUgovora" name="dtGetTipRazdobljaTrajanjaUgovora"/>
      <data command="spUgovoriNajamGla_GetStatusi" name="dtGetStatusi"/>
      <data command="spUgovoriNajamGla_GetUgovoriVrste" name="dtGetVrsta" />
      <data command="spTraziPartneri" name="dtPartneri">
        <parameter name="@Action" value="Partneri" />
        <parameter name="@Uvjet" value="#srcPartner.text" />
        <parameter name="@broj_lokacija" value="1" />
      </data>
      <data command="spTraziOsobe" name="dtOdgovornaOsoba">
        <parameter name="@Action" value="NaseOsobe" />
        <parameter name="@uvjet" value="#srcOsobe.text" />
      </data>
      <data command="spUgovoriNajamGla_spNG_Combo" name="dtGetOrgShema">
        <parameter name="@action" value="orgshema" />
        <parameter name="@ind" value="0" />
      </data>
    </datalist>
  </form>
</root>