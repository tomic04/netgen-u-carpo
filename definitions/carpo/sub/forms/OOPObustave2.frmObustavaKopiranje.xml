<root>


	<form name="frmObustavaKopiranje" caption="$caption" width="400" height="140" fixedsize="true" saveformsize="false">

		<layout>
			<group cols="2" rows="1" groupbordervisible="false" alignmode="local">
				<group cols="1" rows="1" col="1" row="1" groupbordervisible="false" alignmode="local">
					<item caption="Radnik" col="1" row="1" highlight="false" textposition="left">
						<searchedit name="srcRadnik" dataname="dtRadnik" fieldtext="DjelatnikNazivId" fieldvalue="HRKadroviId"  savevalue="session" required="true"/>
					</item>
				</group>

				<group cols="1" rows="1" col="2" row="1" groupbordervisible="false" >
					<item col="2" row="1" highlight="false">
						<checkedit caption="Svi" name="chkSvi" value="false"  tooltip="Uključi neaktivne djelatnike u pretragu" savevalue="session"/>
					</item>
				</group>
			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Kopiraj">
					<event type="click">
						<action type="validate"/>
						<action if="$OOPObustaveMirovanjeId!=0">
							<action type="datarun nonquery" value="~dtKopiraj"></action>
							<action type="form close"></action>
						</action>
					</event>
				</button>

				<button name="btnOdustani" caption="ODUSTANI" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spOOPObustaveDetAzur2" name="dtKopiraj">
				<parameter name="@action" value="5" type="int"/>
				<parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
				<parameter name="@hrkadroviid" value="#srcRadnik" type="int"/>
			</data>

			<data command="spOOPObustaveHelpCP" name="dtRadnik">
				<parameter name="@action"  value="trazi_djelatnika" />
				<parameter name="@tekst"  value="#srcRadnik.text" />
				<parameter name="@svi"  value="#chkSvi" />
			</data>
		</datalist>
	</form>


</root>