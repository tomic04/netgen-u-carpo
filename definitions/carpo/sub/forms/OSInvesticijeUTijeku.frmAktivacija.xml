<root version="1.1">
  
  <!--1.1. MZ saveformlayout-->

  <form name="frmAktivacija" caption="$Caption" fixedsize="false" width="1200" saveformlayout="true">

    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>
    <event type="onload">
      <action type="control disable" value="#txtInvBroj,#txtNabVr,#cmbStatus" />
      <action type="datarun reader" value="~dtDatumPoc"  />
      <action type="control value" value="#datDatumPoc"  >
        <parameter value="~dtDatumPoc.@DatumOtp" />
      </action>
    </event>

    <layout textposition="left" >
      <group cols="3" rows="2" groupbordervisible="false" >
        <columnsdefinition>
          <column size="35%" position="1" />
          <column size="35%" position="2" />
          <column size="30%" position="3" />
        </columnsdefinition>        
        <group cols="2" rows="7" col="1" row="1" caption="Osnovni podaci" spacing="2,2,2,1" colspan="2">
          <item caption="Inventurni broj:" col="1"  row="1" >
            <textedit name="txtInvBroj" required="true" datavalue="~dtGet.@InvBroj"/>
          </item>
          <item caption="Naziv:"  col="1" row="2" >
            <textedit name="txtNaziv" required="true" datavalue="~dtGet.@NazivInv"/>
          </item>
          <item caption="Dobavljač:" col="1" row="3" >
            <searchedit name="srcPartneri" fieldvalue="PartneriId" fieldtext="NazivP" dataname="~dtPartneri" />
          </item>
          <item caption="Vrsta:" col="1" row="4" >
            <comboedit name="cmbVrsta"  valuefield="OSVrsteId" displayfield="NazivV" dataname="~dtVrste"  datavalue="~dtGet.@OSVrsteId"/>
          </item>
          <item caption="Serijski broj:" col="1" row="5" highlight="false" >
            <textedit name="txtSerBroj" />
          </item>
          <item caption="Garažni broj:" col="1" row="6" highlight="false">
            <textedit name="txtGarBroj" />
          </item>
          <item caption="Opis:" col="1" row="7" highlight="false" >
            <textedit name="txtOpis" datavalue="~dtGet.@Opis"/>
          </item>
          <item caption="Status:" col="2" row="1" highlight="false" >
            <comboedit name="cmbStatus"  valuefield="OSStatusiId" displayfield="Naziv" dataname="~dtStatusi" allownull="false" />
            <!--datavalue="~dtGet.@OSStatusiId"-->
          </item>
          <item caption="JM:" col="2" row="2" highlight="false" >
            <comboedit name="cmbJM"  valuefield="JMId" displayfield="NazivJM" datavalue="~dtGet.@JMId" dataname="~dtJM"/>
          </item>
          <item caption="Mjesto troška:" col="2" row="3" highlight="false" >
            <searchedit name="srcOrgShema"  fieldvalue="OrgShemaId" fieldtext="NazivO" dataname="~dtOrgShema" datavalue="~dtGet.@OrgShemaId" datatext="~dtGet.@NazivO" required="true"/>
          </item>
          <item caption="Barcode:" col="2" row="4" highlight="false" >
            <textedit name="txtBarCode" />
          </item>
          <item caption="Broj šasije:" col="2" row="5" highlight="false">
            <textedit name="txtBrojSas" />
          </item>
        </group>  
        <group cols="1" rows="2" col="3" row="1" groupbordervisible="false" >
          <group cols="1" rows="2" col="1" row="1" caption="Datum aktivacije" spacing="1,2,2,1">
            <item caption="Datum aktivacije:" col="1" row="1" highlight="false" >
              <dateedit name="datDatumAkt" value="now" allownull="true">
                <event type="valuechanged">
                  <action type="datarun reader" value="~dtDatumPoc"  />
                  <action type="control value" value="#datDatumPoc"  >
                    <parameter value="~dtDatumPoc.@DatumOtp" />
                  </action>
                </event>
              </dateedit>
            </item>
            <item caption="Datum početka otpisa:" col="1" row="2" highlight="false" >
              <dateedit name="datDatumPoc" allownull="true"/>
            </item>
          </group>
          <group cols="1" rows="3" col="3" row="2" caption="Zaduženja" spacing="1,2,1,1">
            <item caption="Osoba:" col="1" row="1" highlight="false" colspan="2">
              <searchedit name="srcOsoba" fieldvalue="HRKadroviId" fieldtext="Naziv" dataname="~dtOsoba" />
            </item>
            <item caption="Lokacija:" col="1" row="2" highlight="false" colspan="2">
              <searchedit name="srcLokacija" fieldvalue="SmjestajId" fieldtext="NazivS" dataname="~dtLokacija" />
            </item>
            <item caption="Org.jedinica:" col="1" row="3" highlight="false" colspan="2">
              <searchedit name="srcOrgShemaZad"  fieldvalue="OrgShemaId" fieldtext="NazivO" dataname="~dtOrgShemaZad" datavalue="~dtGet.@OrgShemaId" datatext="~dtGet.@NazivO"/>
            </item>
          </group>
        </group>
        <group cols="2" rows="1" col="1" row="2" caption="Obračunski podaci" spacing="2,2,1,2" colspan="2">
          <group cols="1" rows="3" col="1" row="1" groupbordervisible="false">
            <item caption="Am. grupa:" col="1" row="1" highlight="false" >
              <comboedit name="cmbAmGrupa"  valuefield="OSGrupeId" displayfield="NazivA" dataname="~dtAmGrupa" allownull="false" datavalue="~dtGet.@OSGrupeId" >
                <!--na promjenu grupe puni formu-->
                <event type="valuechanged">
                  <action type="datarun reader" value="~dtPodaciZaGrupu"  />
                  <action type="control value" value="#txtRedovna"  >
                    <parameter value="~dtPodaciZaGrupu.@Redovna" />
                  </action>
                  <action type="control value" value="#txtUbrzana"  >
                    <parameter value="~dtPodaciZaGrupu.@Ubrzana" />
                  </action>
                  <action type="control value" value="#txtJednokratna"  >
                    <parameter value="~dtPodaciZaGrupu.@Jednokratna" />
                  </action>
                  <action type="control value" value="#txtUmanjena"  >
                    <parameter value="~dtPodaciZaGrupu.@Umanjena" />
                  </action>
                  <action type="control value" value="#srcNabava"  >
                    <parameter value="~dtPodaciZaGrupu.@KntNabaveId" text="~dtPodaciZaGrupu.@KontoN"/>
                  </action>
                  <action type="control value" value="#srcPriprema"  >
                    <parameter value="~dtPodaciZaGrupu.@KntPripremeId" text="~dtPodaciZaGrupu.@KontoP"/>
                  </action>
                  <action type="control value" value="#srcIspravak"  >
                    <parameter value="~dtPodaciZaGrupu.@KntIspravkaId" text="~dtPodaciZaGrupu.@KontoI"/>
                  </action>
                  <action type="control value" value="#srcTrosak"  >
                    <parameter value="~dtPodaciZaGrupu.@KntTroskaId" text="~dtPodaciZaGrupu.@KontoT"/>
                  </action>
                </event>
              </comboedit>
            </item>
            <item caption="Tip stope:" col="1" row="2" highlight="false" >
              <comboedit name="cmbStopaTip"  valuefield="StopaTip" displayfield="Naziv" dataname="~dtStopaTip" allownull="false"/>
            </item>
            <!--stope amortizacije-->
            <group cols="2" rows="2" col="1" row="3" groupbordervisible="false">
              <item caption="Redovna:"  col="1" row="1" >
                <textedit name="txtRedovna" format="n2" datavalue="~dtGet.@StopaRed" />
              </item>
              <item caption="Ubrzana:"  col="1" row="2" >
                <textedit name="txtUbrzana" format="n2" datavalue="~dtGet.@StopaUbr"/>
              </item>
              <item caption="Umanjena:"  col="2" row="1" >
                <textedit name="txtUmanjena" format="n2" datavalue="~dtGet.@StopaUm"/>
              </item>
              <item caption="Jednokratna:"  col="2" row="2" >
                <textedit name="txtJednokratna" format="n2" datavalue="~dtGet.@StopaJed"/>
              </item>
            </group>
          </group>
          <!--konta-->
          <group cols="1" rows="4" col="2" row="1" groupbordervisible="false" >
            <item caption="Konto nabave:" col="1" row="1" >
              <searchedit name="srcNabava" fieldvalue="KntNabaveId" fieldtext="KontoN" dataname="dtNabava" datavalue="~dtGet.@KntNabaveId" datatext="~dtGet.@KontoN"/>
            </item>
            <item caption="Konto pripreme:" col="1" row="2" >
              <searchedit name="srcPriprema" fieldvalue="KntPripremeId" fieldtext="KontoP" dataname="dtPriprema" datavalue="~dtGet.@KntPripremeId" datatext="~dtGet.@KontoP"/>
            </item>
            <item caption="Konto ispravka:" col="1" row="3"  >
              <searchedit name="srcIspravak" fieldvalue="KntIspravkaId" fieldtext="KontoI" dataname="dtIspravak" datavalue="~dtGet.@KntIspravkaId" datatext="~dtGet.@KontoI"/>
            </item>
            <item caption="Konto troška:" col="1" row="4"  >
              <searchedit name="srcTrosak" fieldvalue="KntTroskaId" fieldtext="KontoT" dataname="dtTrosak" datavalue="~dtGet.@KntTroskaId" datatext="~dtGet.@KontoT"/>
            </item>
          </group>
        </group>
        <group cols="1" rows="4" col="3" row="2" spacing="1,2,1,2">
          <item caption="Nabavna vrijednost:"  col="1" row="1" >
            <textedit name="txtNabVr" format="n2" datavalue="~dtGet.@NabavaDug" textposition="left"/>
          </item>
          <item caption="Vrsta dokumenta:" col="1" row="2" highlight="false" >
            <comboedit name="cmbVrstaDok"  valuefield="VrstaDokOSId" displayfield="NazivDokOS" dataname="~dtVrstaDokOS" allownull="false"/>
          </item>
          <item caption="Odgovorna osoba:" col="1" row="3" highlight="false" >
            <searchedit name="srcOdgOsoba" fieldvalue="OsobeId" fieldtext="Naziv" dataname="~dtOdgOsoba" />
          </item>
          <group cols="2" rows="1" col="1" row="4" groupbordervisible="false">
            <item col="1" row="1" highlight="false">
              <radioedit name="rdo1" caption="Ukupan promet" value="true" />
            </item>
            <item col="2" row="1" highlight="false">
              <radioedit name="rdo2" caption="Analitika prometa" />
            </item>
          </group>
        </group>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnAktiviraj"  caption="Aktiviraj" type="add" >
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtAktiviraj" >
              <action type="message" value="~dtAktiviraj.@Poruka" />
            </action>
            <action type="form close" if="~dtAktiviraj.@IndGreske==0"/>
          </event>
        </button>
        <button caption="Izlaz" type="cancel" dock="right">
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaIT_HelpCP" name="dtDatumPoc">
        <parameter name="@Action" value="Datum_otpisa"/>
        <parameter name="@DatumAkt" value="#datDatumAkt.@DatumAkt"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtAmGrupa">
        <parameter name="@Action" value="AmGrupe_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtNabava">
        <parameter name="@Action" value="Konto_nabave"/>
        <parameter name="@Tekst" value="#srcNabava.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtPriprema">
        <parameter name="@Action" value="Konto_pripreme"/>
        <parameter name="@Tekst" value="#srcPriprema.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtIspravak">
        <parameter name="@Action" value="Konto_ispravka"/>
        <parameter name="@Tekst" value="#srcIspravak.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtTrosak">
        <parameter name="@Action" value="Konto_troska"/>
        <parameter name="@Tekst" value="#srcTrosak.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtStopaTip">
        <parameter name="@Action" value="StopaTip_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtOdgOsoba">
        <parameter name="@Action" value="OdgOsoba_src"/>
        <parameter name="@Tekst" value="#srcOdgOsoba.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtVrstaDokOS">
        <parameter name="@Action" value="VrstaDokOS_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtPartneri">
        <parameter name="@Action" value="Dobavljac_src"/>
        <parameter name="@Tekst" value="#srcPartneri.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtVrste">
        <parameter name="@Action" value="Vrste_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtOsoba">
        <parameter name="@Action" value="Osoba_src"/>
        <parameter name="@Tekst" value="#srcOsoba.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtLokacija">
        <parameter name="@Action" value="Lokacija_src"/>
        <parameter name="@Tekst" value="#srcLokacija.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtOrgShema">
        <parameter name="@Action" value="OrgShema_src"/>
        <parameter name="@Tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtOrgShemaZad">
        <parameter name="@Action" value="OrgShema_src"/>
        <parameter name="@Tekst" value="#srcOrgShemaZad.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtStatusi">
        <parameter name="@Action" value="Status_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtJM">
        <parameter name="@Action" value="JM_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtPodaciZaGrupu">
        <parameter name="@Action" value="Podaci_grupa"/>
        <parameter name="@OSGrupeId" value="#cmbAmGrupa.@OSGrupeId"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtGet">
        <parameter name="@Action" value="Podaci_aktivacija"/>
        <parameter name="@OSImovinaITId" value="$OSImovinaITId"/>
      </data>
      <data command="spOSImovinaIT_AktivacijaCP" name="dtAktiviraj">
        <parameter name="@Action" value="Aktivacija"/>
        <parameter name="@OSImovinaITId" value="$OSImovinaITId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@TipAktivacije" value="Sintetika" if="#rdo1==true"/>
        <parameter name="@TipAktivacije" value="Analitika" else=""/>
        <parameter name="@OrgShemaTId" value="#srcOrgShema"/>
        <parameter name="@DatumAktiviranja" value="#datDatumAkt"/>        
        <parameter name="@OSGrupeId" value="#cmbAmGrupa"/>
        <parameter name="@KntNabaveId" value="#srcNabava"/>
        <parameter name="@KntPripremeId" value="#srcPriprema"/>
        <parameter name="@KntIspravkaId" value="#srcIspravak"/>
        <parameter name="@KntTroskaId" value="#srcTrosak"/>
        <parameter name="@StopaTip" value="#cmbStopaTip"/>
        <parameter name="@Redovna" value="#txtRedovna"/>
        <parameter name="@Ubrzana" value="#txtUbrzana"/>
        <parameter name="@Jednokratna" value="#txtJednokratna"/>
        <parameter name="@Umanjena" value="#txtUmanjena"/>
        <parameter name="@VrstaDokOSId" value="#cmbVrstaDok"/>
        <parameter name="@OsobeId" value="#srcOdgOsoba"/>
        <parameter name="@NabavaDug" value="#txtNabVr"/>
        <parameter name="@PartneriId" value="#srcPartneri"/>
        <parameter name="@OrgShemaId" value="#srcOrgShema"/>
        <parameter name="@HRKadroviId" value="#srcOsoba"/>
        <parameter name="@SmjestajId" value="#srcLokacija"/>
        <parameter name="@OrgShemaZId" value="#srcOrgShemaZad"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@OSVrsteId" value="#cmbVrsta"/>
        <parameter name="@SerBroj" value="#txtSerBroj"/>
        <parameter name="@GarazniBroj" value="#txtGarBroj"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@JmId" value="#cmbJM"/>
        <parameter name="@BarCode" value="#txtBarCode"/>
        <parameter name="@BrojSasije" value="#txtBrojSas"/>
        <parameter name="@DatumOtpisa" value="#datDatumPoc"/>        
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>      
    </datalist>
  </form>

</root>
