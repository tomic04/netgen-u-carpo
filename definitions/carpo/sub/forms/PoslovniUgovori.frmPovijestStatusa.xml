<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmPovijestStatusa" caption="POVIJEST STATUSA" width="450" height="600">
		<layout>
			<group cols="1" rows="1" bordervisible="false">
				<item col="1" row="1">
					<grid name="grdPovijest" autopopulate="true" bestfitonrefresh="true" dataname="dtPovijestStatusa">
						<fields>
							<field name="Datum" caption="Datum" formatstring="dd.MM.yyyy. HH:mm"/>
							<field name="Operater" caption="Operater" />
							<field name="Korak" caption="Korak" />
							<field name="Napomena" caption="Napomena" />
						</fields>		  
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" type="cancel" caption="&amp;ODUSTANI"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spNab_ZahGla_PovijestStatusa" name="dtPovijestStatusa"> -->
			<!-- <parameter name="@ID" value="$NabZahGlaId"/> -->
			<!-- </data> -->
			<data command="spStatusi_CARPO" name="dtPovijestStatusa">
				<parameter name="@action" value="0" />
				<parameter name="@id" value="$PosUgovoriGlaId" type ="int" />
				<parameter name="@tablica" value="PosUgovoriGla"/>
			</data>	  
		</datalist>
	</form>
</root>
