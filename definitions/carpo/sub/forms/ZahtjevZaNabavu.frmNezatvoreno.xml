<?xml version="1.0" encoding="utf-8"?>
<root>
  <form name="frmNezatvoreno" caption="Pregled neobrađenih zahtjeva za nabavu" width="999" height="600">
    <layout>
      <group cols="1" rows="1" bordervisible="false">
        <item col="1" row="1" highlight="false">
          <grid name="grdNezatvoreno" bestfitonrefresh="true" dataname="dtGrid" autopopulate="true" savelayout="true">
            <fields inherited="true">
              <field name="UserId" caption="Šifra" visible="true"/>
              <field name="RobaNaziv" caption="Naziv Robe"/>
              <field name="RobaJM" caption="JM"/>
              <field name="Kolicina" caption="Zahtjevano"/>
              <field name="Naruceno" caption="Naručeno"/>
              <field name="Dobavljac" caption="Dobavljač"/>
              <field name="Inicijali" caption="Operater"/>
              <field name="ImePrezime" caption="Odg. Osoba"/>
              <field name="OrgJedNaziv" caption="Org. Jedinica"/>
              <field name="DatumDok" caption="Datum"/>
              <field name="Broj" caption="Zahtjev Za Nabavu"/>
              <field name="ZOpis" caption="Opis"/>
              <field name="IzvorStr" caption="Izvor"/>
              <field name="NDatumIsporuke" caption="Datum Isporuke"/>
              <field name="OdgOsoba" caption="Komercijalist Za Robu"/>
              <field name="MoguciRok" caption="Mogući Rok Isporuke"/>
              <field name="Status" visible="false"/>
              <field name="Opis" visible="false"/>
              <field name="Izvor" visible="false"/>
              <field name="UserKod" visible="false"/>
              <field name="RobaKod" visible="false"/>
              <field name="BarCode" visible="false"/>
              <field name="Razlika" visible="false"/>
              <field name="StatusStr" visible="false"/>
            </fields>
          </grid>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUkloni" caption="&amp;Ručno zatvori" function="Ukloni">
          <event type="click">
            <action type="confirm" value="Jeste li sigurni da želite ručno zatvoriti označeni zahtjev?">
              <action type="datarun nonquery" value="~dtUkloni"/>
			  <action type="control populate keepfocus" value="#grdNezatvoreno"/>
            </action>
          </event>
        </button>
        <button name="btnZatvori" caption="&amp;Izlaz" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spNab_ZahGla_GetNeobradjeni" name="dtGrid"/>
      <data command="spNab_ZahGla_LnZahNarAzur" name="dtUkloni">
        <parameter name="@nabzahdetid" value="#grdNezatvoreno.@NabZahDetId"/>
        <parameter name="@kolicina" value="#grdNezatvoreno.@Kolicina"/>
      </data>
    </datalist>
  </form>
</root>
