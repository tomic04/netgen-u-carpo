<root>
    <form name="frmNoviObracun" caption="Kreiranje obračuna" width="" height="" fixedsize="">
		<event type="load">
			<action type="variable value" >
				<parameter name="varDatAction" value="0" type="int"/>
			</action>                                           
		</event>        
		<event type="onshown">
			<action type="control value" value="#datDatumOd,#datDatumDo,#datDatumFakture">
				<parameter value="now" />
			</action>	
			<action type="datarun reader" value="~dtNaziv"/>
			<action type="control value" value="#txtNaziv">
				<parameter value="~dtNaziv.@Naziv" />
			</action>			
        </event>
		<event type="onclose">
			<action type="control populate" value="parent.#tree" /> 
			<action type="control focus" value="parent.#tree">
				<parameter value="$FaktureObracunId" type="int"/>
			</action>			
		</event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="true">
                <group rows="3" cols="1" row="1" col="1" entermovenextcontrol="true" groupbordervisible="False">                    
					<group rows="2" cols="2" row="1" col="1" entermovenextcontrol="true" groupbordervisible="False">
			            <columnsdefinition>
							<column size="200" position="1" />
							<column size="200" position="2" />
						</columnsdefinition>
						<item caption="Datum od:" row="1" col="1">
							<dateedit name="datDatumOd" datavalue="now" required="true">
							</dateedit>
						</item> 					
						<item caption="Datum do:" row="1" col="2">
							<dateedit name="datDatumDo" datavalue="now" required="true">
                        </dateedit>
						</item>
					    <item caption="Datum fakture:" row="2" col="1">
							<dateedit name="datDatumFakture" datavalue="now" required="true">
								<event type="leave" raiseonload="false" >
									<action type="datarun reader" value="~dtNaziv"/>
									<action type="control value" value="#txtNaziv">
										<parameter value="~dtNaziv.@Naziv" />
									</action>									
								</event>
							</dateedit>
						</item>
						<item caption="" row="2" col="2">
							<part name="prtBtnRazdoblje" path="prtBtnRazdoblje.xml"/>
						</item> 						
					</group>
 					<item caption="Naziv obračuna:" row="2" col="1">
                        <textedit name="txtNaziv" datavalue="" required="true">
                        </textedit>
                    </item> 
 					<item caption="Vrsta ugovora:" row="3" col="1">
                        <combomultiedit name="cmbUgovor" valuefield="KupUgovoriVrsteId" displayfield="Naziv" dataname="Global.dtVrsteUgovora" enabled=""/>
                    </item>					
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="KREIRAJ" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun scalar" value="~dtObracun">
							<parameter name="FaktureObracunId" />
						</action>
						<!-- <action type="control populate keepfocus" value="parent.#grdGlava" /> -->
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
			<data command="spDatumi" name="dtDajDatum">	
				<parameter name="@action" value="$varDatAction" />	
			</data>			
			<data command="select rtrim(MjesecNaziv) + ' ' + cast(Godina as varchar(4)) as Naziv from Kalendar where Datum = @datumfakture" type="text" name="dtNaziv">
				<parameter name="@datumfakture" value="#datDatumFakture"/>
			</data>
            <data command="spFaktureObracun_Unos" name="dtObracun">
                <parameter name="@naziv" value="#txtNaziv" />
                <parameter name="@datumod" value="#datDatumOd" />
                <parameter name="@datumdo" value="#datDatumDo" />
                <parameter name="@datumfakture" value="#datDatumFakture" />
                <parameter name="@operateriid" value="@@operateriid" />
				<parameter name="@kupugovorivrste" value="#cmbUgovor" type="string"/>
            </data>
        </datalist>
    </form>
</root>