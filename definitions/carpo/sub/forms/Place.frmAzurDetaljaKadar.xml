<root>
  <!--FORMA ZA AŽURIRANJE DETALJA PLAĆE ZA KADRA-->
  <!--v3: dodano polje Napomena-->
  <!--v2: popuni polja Bodovi, radno mjesto, orgshema, relacija ovisno o ooppubvars 'OOPPopuniUnosStavke'-->
  <form name="frmAzurDetaljaKadar" caption ="$caption"  width="800" height="650" fixedsize="true" saveformsize="false" showversion="true" version="3">
    <event type="init">
      <action type="datarun reader" value="~dtNapuniTemp" />
      <action type="datarun reader" value="~dtDetalj" />
      <action type="variable value">
        <parameter name="Gumb" value="Unos" type="string"/>
      </action>
      <action type="variable value">
        <parameter name="StavkaId" value="0" type="int"/>
      </action>
    </event>
    <event type="onload">
      <action type="variable value">
        <parameter name="StavkaId" value="#cmbStavke" type="int"/>
      </action>
      <action type="variable value">
        <parameter name="StavkaIzmjena" value="null" type="int"/>
      </action>

      <action type="control populate" value="#grdDetalj" />
      <action type="datarun reader" value="~dtKontrole" />
      <action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" />
      <action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" />
      <action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" />
      <action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" />
      <action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" />
      <action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" />
      <action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" />
      <action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" />
      <action type="control disable" value="#txtOd" if="~dtKontrole.@vOd==0" />
      <action type="control disable" value="#txtDo" if="~dtKontrole.@vDo==0" />
      <action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
      <action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
      <action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
      <action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
      <action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" />
      <action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" />
      <action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" />
      <action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" />
      <action type="control enable" value="#txtOd" if="~dtKontrole.@vOd==1" />
      <action type="control enable" value="#txtDo" if="~dtKontrole.@vDo==1" />


    </event>
    <event type="shown">
      <action type="control focus" value="#cmbStavke">
        <action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdDetalj.rowcount==0"/>

      </action>
      <action type="if" if="$OOPObradeDetId!=null">
        <!--<action type="message" value="Došao s detalj grida!!"/>-->
        <action type="control focus" value="#grdDetalj">
          <parameter value="$OOPObradeDetId"/>
        </action>
        <action type="variable value">
          <parameter name="Gumb" value="Izmjena" type="string"/>
        </action>
        <action type="control disable" value="#cmbStavke" />
        <action type="datarun reader" value="~dtGet" />
        <action type="control value" value="#cmbStavke"  >
          <parameter value="~dtGet.@OOPStavkeId" />
        </action>
        <action type="control value" value="#txtSati"  >
          <parameter value="~dtGet.@Sati" />
        </action>
        <action type="control value" value="#txtBodovi"  >
          <parameter value="~dtGet.@Bodovi" />
        </action>
        <action type="control value" value="#txtPostotak"  >
          <parameter value="~dtGet.@Postotak" />
        </action>
        <action type="control value" value="#txtIznos"  >
          <parameter value="~dtGet.@Iznos" />
        </action>
        <action type="control value" value="#srcOrgShema"  >
          <parameter value="~dtGet.@OrgShemaId" text="~dtGet.@NazivO" />
        </action>
        <action type="control value" value="#srcMtr"  >
          <parameter value="~dtGet.@MtrId" text="~dtGet.@NazivMtr" />
        </action>
        <action type="control value" value="#srcRelacije"  >
          <parameter value="~dtGet.@OOPRelacijeId" text="~dtGet.@NazivR" />
        </action>
        <action type="control value" value="#srcRadnaMjesta"  >
          <parameter value="~dtGet.@HRRadnaMjestaId" text="~dtGet.@NazivRM" />
        </action>
        <action type="control value" value="#txtOd"  >
          <parameter value="~dtGet.@DanOd" />
        </action>
        <action type="control value" value="#txtDo"  >
          <parameter value="~dtGet.@DanDo" />
        </action>
        <action type="control value" value="#txtNapomena"  >
          <parameter value="~dtGet.@Napomena" />
        </action>
      </action>
      <action if="$OOPObradeDetId==null">


        <action type="control value" value="#srcOrgShema"  >
          <parameter value="~dtKontrole.@OrgShemaId" text="~dtKontrole.@OrgShemaNaziv" />
        </action>
        <action type="control value" value="#txtBodovi" >
          <parameter value="~dtKontrole.@Bodovi"/>
        </action>
        <action type="control value" value="#srcRadnaMjesta"  >
          <parameter value="~dtKontrole.@HRRadnaMjestaId" text="~dtKontrole.@HRRadnaMjestaNaziv" />
        </action>
        <action type="control value" value="#srcRelacije" >
          <parameter value="~dtKontrole.@OOPRelacijeId" text="~dtKontrole.@OOPRelacijeNaziv" />
        </action>
      </action>

    </event>
    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <group col="1" row="1" cols="6" rows="8" rowspan="4" spacing="2,2,2,1">
          <item col="1" row="1"  colspan="5"  rowspan="8"  >
            <grid name="grdDetalj" key="OOPObradeDetId" async="true" dataname="dtDetalj" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showtotalsum="true" showfooter="true">
              <fields inherited="true">
                <field name="DanOd" caption="Dan od" />
                <field name="DanDo" caption="Dan do" />
                <field name="nazivstavke" caption="Naziv stavke" fixed="true"  />
                <field name="orgjedinica" caption="Organizacijska jedinica" />
                <field name="mjestotroska" caption="Mjesto troška" />
                <field name="radnomjesto" caption="Radno mjesto" />
                <field name="napomena" caption="Napomena" />
              </fields>
            </grid>
          </item>


          <item caption="" col="6" row="1" rowspan="2">
            <button name="btnUnos"  caption="Unesi">
              <event type="click">
                <action type="variable value">
                  <parameter name="Gumb" value="Unos" type="string"/>
                </action>
                <action type="control enable" value="#cmbStavke" />
                <action type="control refreshvalue" value="#cmbStavke" />
                <action type="variable value">
                  <parameter name="StavkaId" value="#cmbStavke" type="int"/>
                </action>
                <action type="variable value">
                  <parameter name="StavkaIzmjena" value="null" type="int"/>
                </action>
                <action type="datarun reader" value="~dtKontrole" />
                <action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" />
                <action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" />
                <action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" />
                <action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" />
                <action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" />
                <action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" />
                <action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" />
                <action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" />
                <action type="control disable" value="#txtOd" if="~dtKontrole.@vOd==0" />
                <action type="control disable" value="#txtDo" if="~dtKontrole.@vDo==0" />
                <action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
                <action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
                <action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
                <action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
                <action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" />
                <action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" />
                <action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" />
                <action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" />
                <action type="control enable" value="#txtOd" if="~dtKontrole.@vOd==1" />
                <action type="control enable" value="#txtDo" if="~dtKontrole.@vDo==1" />
                <action type="control refreshvalue" value="##"/>
                <action type="control focus" value="#cmbStavke"/>



                <action type="control value" value="#srcOrgShema"  >
                  <parameter value="~dtKontrole.@OrgShemaId" text="~dtKontrole.@OrgShemaNaziv" />
                </action>
                <action type="control value" value="#txtBodovi" >
                  <parameter value="~dtKontrole.@Bodovi"/>
                </action>
                <action type="control value" value="#srcRadnaMjesta"  >
                  <parameter value="~dtKontrole.@HRRadnaMjestaId" text="~dtKontrole.@HRRadnaMjestaNaziv" />
                </action>
                <action type="control value" value="#srcRelacije" >
                  <parameter value="~dtKontrole.@OOPRelacijeId" text="~dtKontrole.@OOPRelacijeNaziv" />
                </action>
              </event>
            </button>
          </item>



          <item caption="" col="6" row="4" rowspan="2" >
            <button name="btnIzmjena"  caption="Izmijeni">
              <event type="click">
                <action type="variable value">
                  <parameter name="Gumb" value="Izmjena" type="string"/>
                </action>
                <action type="variable value">
                  <parameter name="StavkaIzmjena" value="~dtGet.@OOPStavkeId" type="int"/>
                </action>
                <action type="control disable" value="#cmbStavke" />
                <action type="datarun reader" value="~dtGet" />
                <action type="control value" value="#cmbStavke"  >
                  <parameter value="~dtGet.@OOPStavkeId" />
                </action>
                <action type="control value" value="#txtSati"  >
                  <parameter value="~dtGet.@Sati" />
                </action>
                <action type="control value" value="#txtBodovi"  >
                  <parameter value="~dtGet.@Bodovi" />
                </action>
                <action type="control value" value="#txtPostotak"  >
                  <parameter value="~dtGet.@Postotak" />
                </action>
                <action type="control value" value="#txtIznos"  >
                  <parameter value="~dtGet.@Iznos" />
                </action>
                <action type="control value" value="#srcOrgShema"  >
                  <parameter value="~dtGet.@OrgShemaId" text="~dtGet.@NazivO" />
                </action>
                <action type="control value" value="#srcMtr"  >
                  <parameter value="~dtGet.@MtrId" text="~dtGet.@NazivMtr" />
                </action>
                <action type="control value" value="#srcRelacije"  >
                  <parameter value="~dtGet.@OOPRelacijeId" text="~dtGet.@NazivR" />
                </action>
                <action type="control value" value="#srcRadnaMjesta"  >
                  <parameter value="~dtGet.@HRRadnaMjestaId" text="~dtGet.@NazivRM" />
                </action>
                <action type="control value" value="#txtOd"  >
                  <parameter value="~dtGet.@DanOd" />
                </action>
                <action type="control value" value="#txtDo"  >
                  <parameter value="~dtGet.@DanDo" />
                </action>
                <action type="control value" value="#txtNapomena"  >
                  <parameter value="~dtGet.@Napomena" />
                </action>
              </event>

            </button>
          </item>
          <item caption="" col="6" row="7" rowspan="2">
            <button name="btnBrisanje"  caption="Obriši" >
              <event type="click">
                <action type="variable value">
                  <parameter name="Greska" value="0" type="int"/>
                </action>
                <action type="datarun reader" value="~dtBrisi">
                  <action type="message" value="~dtBrisi.@Poruka"  if="~dtBrisi.@Id!=0"/>
                  <action type="variable value">
                    <parameter name="Greska" value="~dtBrisi.@Id"/>
                  </action>
                </action>
                <action type="control populate" value="#grdDetalj" if="$Greska==0"/>

                <action type="control enable" value="#btnBrisanje,#btnIzmjena" if="#grdDetalj.rowcount&gt;0"/>
                <action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdDetalj.rowcount==0"/>
              </event>
            </button>
          </item>
        </group>

        <!--<group col="1" row="5" cols="1" rows="2" spacing="2,2,1,2">-->
        <group col="1" row="5" cols="1" rows="2" spacing="2,2,1,2">
          <group col="1" row="1" cols="5" rows="1" groupbordervisible="true">
            <item caption="" col="1"  row="1" >
            </item>
            <item caption="Stavka:" col="1"  row="2" textposition="left" fontbold="true" colspan="2" highlight="false">
              <comboedit name="cmbStavke"  valuefield="OOPStavekeId" displayfield="Naziv" dataname="~dtStavke" allownull="false" >
                <event type="valuechanged">
                  <action type="variable value">
                    <parameter name="StavkaId" value="#cmbStavke" type="int"/>
                  </action>
                  <action type="datarun reader" value="~dtKontrole" />
                  <action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" />
                  <action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" />
                  <action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" />
                  <action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" />
                  <action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" />
                  <action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" />
                  <action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" />
                  <action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" />
                  <action type="control disable" value="#txtOd" if="~dtKontrole.@vOd==0" />
                  <action type="control disable" value="#txtDo" if="~dtKontrole.@vDo==0" />
                  <action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
                  <action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
                  <action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
                  <action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
                  <action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" />
                  <action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" />
                  <action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" />
                  <action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" />
                  <action type="control enable" value="#txtOd" if="~dtKontrole.@vOd==1" />
                  <action type="control enable" value="#txtDo" if="~dtKontrole.@vDo==1" />


                  <action type="control value" value="#srcOrgShema"  >
                    <parameter value="~dtKontrole.@OrgShemaId" text="~dtKontrole.@OrgShemaNaziv" />
                  </action>
                  <action type="control value" value="#txtBodovi" >
                    <parameter value="~dtKontrole.@Bodovi"/>
                  </action>
                  <action type="control value" value="#srcRadnaMjesta"  >
                    <parameter value="~dtKontrole.@HRRadnaMjestaId" text="~dtKontrole.@HRRadnaMjestaNaziv" />
                  </action>
                  <action type="control value" value="#srcRelacije" >
                    <parameter value="~dtKontrole.@OOPRelacijeId" text="~dtKontrole.@OOPRelacijeNaziv" />
                  </action>

                </event>
              </comboedit>
            </item>
            <item caption="" col="5"  row="1" >
            </item>
          </group>
		  
          <group col="1" row="2" cols="4" rows="8" groupbordervisible="false">
            <item caption="Sati:" col="1" row="2" textposition="left">
              <textedit name="txtSati" format="n2" textposition="left" value="0"/>
            </item>
            <item caption="Bodovi:" col="1" row="3" textposition="left">
              <textedit name="txtBodovi" format="n2" textposition="left" value="0" />
            </item>
            <item caption="Postotak:" col="1" row="4" textposition="left">
              <textedit name="txtPostotak" format="n2" textposition="left" value="0"/>
            </item>
            <item caption="Iznos:" col="1" row="5" textposition="left">
              <textedit name="txtIznos"  format="n2" textposition="left" value="0"/>
            </item>
            <item caption="Org. jedinica:" col="3" row="2" textposition="left" colspan="2">
              <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" />
            </item>
            <item caption="Mjesto troška:" col="3" row="3" textposition="left" colspan="2">
              <searchedit name="srcMtr"  fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtMtr" />
            </item>
            <item caption="Relacija:" col="3" row="4" textposition="left" colspan="2">
              <searchedit name="srcRelacije" fieldvalue="OOPRelacijeId" fieldtext="Naziv" dataname="~dtRelacije" />
            </item>
            <item caption="Radno mjesto:" col="3" row="5" textposition="left" colspan="2">
              <searchedit name="srcRadnaMjesta"  fieldvalue="HRRadnaMjestaId" fieldtext="Naziv" dataname="~dtRadnaMjesta" />
            </item>
            <group col="3" row="6" cols="5" rows="1" groupbordervisible="false">
              <item caption="" col="1" row="1" >
                <labeledit name="lblRazdoblje" value="Razdoblje:    " />
              </item>
              <item caption="" col="2" row="1" textposition="left">
                <textedit name="txtOd"  format="n0" textposition="left" value="0" maxlength="2"/>
              </item>
              <item caption="" col="3" row="1" >
                <labeledit name="lblCrta" value="   -   " />
              </item>
              <item caption="" col="4" row="1" textposition="left">
                <textedit name="txtDo"  format="n0" textposition="left" value="0" maxlength="2"/>
              </item>
              <item caption="" col="5" row="1">
              </item>
            </group>
            <group col="1" row="7" cols="1" rows="1" colspan="4" groupbordervisible="false">
              <item caption="Napomena:" col="1" row="1" textposition="left">
                <textedit name="txtNapomena" textposition="left" value=""/>
              </item>
            </group>

          </group>

        </group>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>

      <buttons>
        <button name="btnSpremi" caption="SPREMI" >
          <event type="click">
            <action type="variable value">
              <parameter name="Greska" value="0" type="int"/>
            </action>
            <action type="datarun reader" value="~dtUnos" if="$Gumb==Unos">
              <action type="message" value="~dtUnos.@Poruka"  if="~dtUnos.@Id!=0"/>
              <action type="variable value">
                <parameter name="Greska" value="~dtUnos.@Id"/>
              </action>
              <action type="control focus" value="#cmbStavke"/>
              <action type="control refreshvalue" value="#txtSati,#txtBodovi,#txtPostotak,#txtIznos,#srcOrgShema,#srcMtr,#srcRelacije,#srcRadnaMjesta,#txtOd,#txtDo"/>
		  
			  
            </action>
            <action type="datarun reader" value="~dtIzmjena" elseif="$Gumb==Izmjena">
              <action type="message" value="~dtIzmjena.@Poruka"  if="~dtIzmjena.@Id!=0"/>
              <action type="variable value">
                <parameter name="Greska" value="~dtIzmjena.@Id"/>
              </action>
            </action>
            <action type="control refreshvalue" value="#grdDetalj" if="$Greska==0" />
            <action type="control enable" value="#btnBrisanje,#btnIzmjena" if="#grdDetalj.rowcount&gt;0"/>
            <action type="control disable" value="#btnBrisanje,#btnIzmjena" if="#grdDetalj.rowcount==0"/>
            <!--<action type="control enable" value="#cmbStavke"  if="$Gumb==Unos"/>
            <action type="control disable" value="#cmbStavke"  else=""/>
            <action type="control disable" value="#cmbStavke"  />-->

            <!--<action type="control refreshvalue" value="##"  if="$Greska==0&amp;&amp;$Gumb==Unos"/>-->
          </event>
        </button>
        <button name="btnOdustani" caption="IZLAZ" dock="right" >
          <event type="click">
            <action type="form close" />
            <action type="control populate" value="parent.#grdObradeDet">
            </action>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceDetQuery" name="dtDetalj">
        <parameter name="@Action" value="grid_detaljAzuriranje" />
        <parameter name="@OOPObradeGlaId" value="$OOPObradeGlaId"/>
      </data>
      <data command="spPlace_help" name="dtStavke">
        <parameter name="@Action" value="cmb_stavke"/>
        <parameter name="@oopstavkeid" value="$StavkaIzmjena"/>
        <parameter name="@operateriid" value="@@operateriid"/>
      </data>
      <data command="spPlace_help" name="dtOrgShema">
        <parameter name="@Action" value="src_orgshema" />
        <parameter name="@Tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spPlace_help" name="dtMtr">
        <parameter name="@Action" value="src_orgshema" />
        <parameter name="@Tekst" value="#srcMtr.text"/>
      </data>
      <data command="spPlace_help" name="dtRelacije">
        <parameter name="@Action" value="src_relacije" />
        <parameter name="@Tekst" value="#srcRelacije.text"/>
      </data>
      <data command="spPlace_help" name="dtRadnaMjesta">
        <parameter name="@Action" value="src_radnamjesta" />
        <parameter name="@Tekst" value="#srcRadnaMjesta.text"/>
      </data>
      <data command="spPlaceDetQuery" name="dtGet">
        <parameter name="@Action" value="dtGet_izmjena" />
        <parameter name="@OOPObradeDetId" value="#grdDetalj.@OOPObradeDetId"/>
      </data>
      <data command="spPlace_help" name="dtKontrole">
        <parameter name="@Action" value="daj_pozicije_za_unos_stavke" />
        <!--<parameter name="@OOPStavkeId" value="#grdDetalj.@OOPStavkeId"/>-->
        <parameter name="@OOPStavkeId" value="$StavkaId"/>
