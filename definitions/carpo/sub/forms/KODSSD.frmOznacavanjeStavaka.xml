<root>
	<form name="frmOznacavanjeStavaka" type="master" caption="$caption"  width="500" height="500">
		<event type="load">
			<action type="control populate" value="#grdStavke"/>
		</event>
		<layout textposition="left">
			<group cols="1" rows="7" groupbordervisible="false" >
				<rowsdefinition>
					<row size="30%" position="1" />
					<row size="5%" position="2" />
					<row size="5%" position="3" />
					<row size="5%" position="4" />
					<row size="5%" position="5" />
					<row size="5%" position="6" />
				</rowsdefinition>

				<item col="1" row="1" highlight="false">
					<grid height="350" name="grdStavke" key="OOPStavkeId" dataname="dtGrid" showautofilterrow="false" multiselect="true" keyfield="OOPStavkeId">
					</grid>
				</item>
				<group cols="3" rows="1" col="1" row="2"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="20%"></column>
						<column position="3" size="30%"></column>
					</columnsdefinition>
					<item col="1" row="1" caption="Stavka bolovanja (1,2,3):"  highlight="false">
						<textedit name="txtIndBolovanje" format="n0" textalign="right"/>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnSpremiIndBolovanje"  caption="Postavi" type="add" >
							<event type="click">
								<action type="datarun reader" value="~dtSpremiIndBolovanje" />
								<action type="control populate" value="#grdStavke" />
								<action type="control refreshvalue" value="#txtIndBolovanje"/>
								<action type="control focus" value="#txtIndBolovanje"/>
							</event>
						</button>
					</item>
					<item col="3" row="1" ></item>
				</group>
				<group cols="3" rows="1" col="1" row="3"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="20%"></column>
						<column position="3" size="30%"></column>
					</columnsdefinition>
					<item col="1" row="1" caption="Tip doznake (P, D, O, H, N):" highlight="false">
						<textedit name="txtDoznakeTip" textalign="right"/>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnSpremiDoznakeTip"  caption="Postavi" type="add" >
							<event type="click">
								<action type="datarun reader" value="~dtSpremiDoznakeTip" />
								<action type="control populate" value="#grdStavke" />
								<action type="control refreshvalue" value="#txtDoznakeTip"/>
								<action type="control focus" value="#txtDoznakeTip"/>
							</event>
						</button>
					</item>
					<item col="3" row="1"  ></item>
				</group>
				<group cols="3" rows="1" col="1" row="4"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="20%"></column>
						<column position="3" size="30%"></column>
					</columnsdefinition>
					<item col="1" row="1" caption="Stavke preraspodjele:" highlight="false">
						<textedit name="txtIndPreraspodjele" format="n0" textalign="right"/>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnSpremiIndPreraspodjele"  caption="Postavi" type="add" >
							<event type="click">
								<action type="datarun reader" value="~dtSpremiIndPreraspodjele" />
								<action type="control populate" value="#grdStavke" />
								<action type="control refreshvalue" value="#txtIndPreraspodjele"/>
								<action type="control focus" value="#txtIndPreraspodjele"/>
							</event>
						</button>
					</item>
					<item col="3" row="1" ></item>
				</group>
				<group cols="3" rows="1" col="1" row="5"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="20%"></column>
						<column position="3" size="30%"></column>
					</columnsdefinition>
					<item col="1" row="1" caption="Procedura:" highlight="false">
						<textedit name="txtProcedura" textalign="right"/>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnSpremiProcedura"  caption="Postavi" type="add" >
							<event type="click">
								<action type="datarun reader" value="~dtSpremiProcedura" />
								<action type="control populate" value="#grdStavke" />
								<action type="control refreshvalue" value="#txtProcedura"/>
								<action type="control focus" value="#txtProcedura"/>
							</event>
						</button>
					</item>
					<item col="3" row="1"></item>
				</group>
				<group cols="3" rows="1" col="1" row="6"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="20%"></column>
						<column position="3" size="30%"></column>
					</columnsdefinition>
					<item col="1" row="1" caption="Pozicija IO:" highlight="false" >
						<textedit name="txtPozicijaIO"  textalign="right"/>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnSpremiPozicijaIO"  caption="Postavi" type="add" >
							<event type="click">
								<action type="datarun reader" value="~dtSpremiPozicijaIO" />
								<action type="control populate" value="#grdStavke" />
								<action type="control refreshvalue" value="#txtPozicijaIO"/>
								<action type="control focus" value="#txtPozicijaIO"/>
							</event>
						</button>
					</item>
					<item col="3" row="1"></item>
				</group>


			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<!--GUMB IZLAZ-->
				<button name="btnIzlaz" caption="Izlaz" type="cancel" dock="right">

				</button>


			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spOOPStavkeQueryCP" name="dtGrid">
				<parameter name="@Action" value="grid_oznacavanje" />
			</data>

			<data command="spOOPStavkeAzurCP" name="dtSpremiIndBolovanje">
				<parameter name="@Action" value="multiunos_indbolovanje" />
				<parameter name="@selectedids" value="#grdStavke.selectedids" />
				<parameter name="@indbolovanje" value="#txtIndBolovanje" type="int" />
			</data>

			<data command="spOOPStavkeAzurCP" name="dtSpremiDoznakeTip">
				<parameter name="@Action" value="multiunos_doznaketip" />
				<parameter name="@selectedids" value="#grdStavke.selectedids" />
				<parameter name="@doznaketip" value="#txtDoznakeTip" />
			</data>

			<data command="spOOPStavkeAzurCP" name="dtSpremiIndPreraspodjele">
				<parameter name="@Action" value="multiunos_indpreraspodjele" />
				<parameter name="@selectedids" value="#grdStavke.selectedids" />
				<parameter name="@indpreraspodjele" value="#txtIndPreraspodjele" type="int" />
			</data>

			<data command="spOOPStavkeAzurCP" name="dtSpremiProcedura">
				<parameter name="@Action" value="multiunos_procedura" />
				<parameter name="@selectedids" value="#grdStavke.selectedids" />
				<parameter name="@procedura" value="#txtProcedura" />
			</data>

			<data command="spOOPStavkeAzurCP" name="dtSpremiPozicijaIO">
				<parameter name="@Action" value="multiunos_pozicija" />
				<parameter name="@selectedids" value="#grdStavke.selectedids" />
				<parameter name="@pozicijaio" value="#txtPozicijaIO" />
			</data>

		</datalist>
	</form>

</root>