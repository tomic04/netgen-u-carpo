<root>
<form name="frmLokacije" caption="Odabir lokacije" fixedsize="false" width="800" height="570">
	<event type="onshown">
		<action type="control focus" value="#grdLokacije"/>	
	</event>
        <layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid netgenfields="true" name="grdLokacije" autopopulate="true" dataname="~dtParstru" multiselect="true" key="ParstruId" >
                            <fields>
                                <field name="Lokacija3000" caption="Lokacija" />
                                <field name="Šifra lokacije" caption="Šifra" />
                                <field name="Adresa" caption="Adresa" />
                                <field name="Mjesto" caption="Mjesto"/>
                                <field name="Partner" caption="Partner" />
                            </fields>
							<event type="keydown" value="13">
								<action type="form close"></action>				
								<action type="control value" value="parent.#srcParstru">
									<parameter value="#grdLokacije.@parstruid" text="#grdLokacije.@Lokacija3000"/>
								</action>							
							</event>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="ODABERI" dock="right">
					<event type="click">
						<action type="datarun nonquery" value="~dtRuteLNParStruInsert"/>
						<action type="form close"/>
						<action type="control populate keepfocus"  value="#grdGlava"/>
					</event>
                </button>
                <button caption="ODUSTANI" dock="right">
					<event type="click">
                        <action type="form close"></action>	
						<action type="datarun reader" value="Global.dtProvjeriPartnera"/>
						<action type="control value" value="parent.#srcParstru" if="~dtProvjeriPartnera.@Ind_Provjera==0">
							<parameter value="null"/>
						</action>					
					</event>
				</button>
            </buttons>
        </panelbuttons>
		<datalist>
			<data command="spTraziParstru" name="dtParstru">
				<parameter name="@action" value="Parstru"/>
				<parameter name="@Ind_Postotak" value="1"/>				
				<parameter name="@Uvjet" value="" if="$IndLokacija==1"/>
				<parameter name="@Uvjet" value="$naziv" else=""/>
				<parameter name="@PartneriId" value="$PartneriId"/>
			</data>
			<data command="spRuteLNParStruInsert" name="dtRuteLNParStruInsert">
				<parameter name="@RuteId" value="$Id"/>				
				<parameter name="@ParStruId" value="#grdLokacije.selectedids"/>
				<parameter name="parentid" value="$parentid"/>
			</data>			
		</datalist>		
    </form>
</root>