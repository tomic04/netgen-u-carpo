<root>
    <form name="frmUrednikKupUgovori" caption="Prijenos na ugovore s kupcima" width="300" height="160" fixedsize="true">
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group rows="3" cols="3" row="1" col="1" colspan="2" groupbordervisible="false">
                    <columnsdefinition>
                        <column position="1" size="50%"></column>
                        <column position="3" size="50%"></column>
                    </columnsdefinition>
                    <item row="1" col="2">
                        <labeledit value="Na ugovorima s kupcima:" />
                    </item>
                    <item row="2" col="2">
                        <radioedit name="rdoZadnji" row="1" col="2" caption="Dodaj na zadnji ugovor" value="true" > </radioedit>
                    </item>
                    <item row="3" col="2">
                        <radioedit name="rdoNovi" row="1" col="2" caption="Otvori novi ugovor"> </radioedit>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="right">
                    <event type="click">
                        <action type="control foreachrow selected" value="parent.#grdRoba">
                            <action type="datarun nonquery" value="~dtKupUgovori" />
                        </action>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_PonDet_KupUgovoriDet" name="dtKupUgovori">
                <parameter name="@ProPonDetId" value="parent.#grdRoba.@ProPonDetId"/>
                <parameter name="@force_new" value="0" if="#rdoZadnji==true"/>
				<parameter name="@force_new" value="1" elseif="#rdoNovi==true"/>
            </data>
        </datalist>
    </form>
</root>