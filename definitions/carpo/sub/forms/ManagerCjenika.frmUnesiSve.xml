<!-- radio na Jupiter2019 Spin2 -->
<root>
	<form name="frmUnesiSve" caption="Unos svih cijena" width="380" height="250">
		<event type="init">
			<action type="datarun reader" value="dtSutrasnjiDatum"/>
		</event>

		<event type="load">
		</event>
		
		<event type="shown">
			<action type="control value" value="srcRoba">
				<parameter value="$RobaId" text="$RobaNaziv"/>
			</action>
			<action type="control value" value="#datDatumOd">
				<parameter value="~dtSutrasnjiDatum.@SutrasnjiDatum"/>
			</action>

			<action type="control visible" value="#datVPDatumDo">
				<parameter value="false" />
			</action>

			<action type="control visible" value="#datMPDatumDo">
				<parameter value="false" />
			</action>
			
		</event>

		<layout>
			<group rows="8" cols="1">
				

				
				<group col="1" row="1" cols="1" rows="2"  groupbordervisible="true">
					<!-- prva grupa -->
					<item caption="Roba:" row="1" col="1" fontbold="" textalignmode="left"  textposition="left">
						<searchedit netgenfields="true" required="true" name="srcRoba" fontsizedelta="1"
									fontbold="True" dataname="dtRoba" fieldtext="NazivId" fieldvalue="robaid"
									entermovenextcontrol="false" datavalue="~dtDetquery.@RobaId" datatext="~dtDetquery.@RobaNaziv" >
							
							<event type="valuechanged">

								<action type="datarun reader" value="dtgetCijenaSve"/>
								<action type="datarun reader" value="dtgetPorez" />

								<action type="control value" value="curCijenaNabavnaVazeca">
									<parameter value="~dtgetCijenaSve.@nabavna_cijena" />
								</action>

								<action type="control value" value="curCijenaFakturnaVazeca">
									<parameter value="~dtgetCijenaSve.@fakturna_cijena" />
								</action>

								<action type="control value" value="curCijenaNabavna">
									<parameter value="~dtgetCijenaSve.@nabavna_cijena" />
								</action>

								<action type="control value" value="curCijenaFakturna">
									<parameter value="~dtgetCijenaSve.@fakturna_cijena" />
								</action>

								<action type="control value" value="curCijenaVPNetoVazeca">
									<parameter value="~dtgetCijenaSve.@neto_vazeca" />
								</action>

								<action type="control value" value="curCijenaVPBrutoVazeca">
									<parameter value="~dtgetCijenaSve.@bruto_vazeca" />
								</action>

								<action type="control value" value="curCijenaVPNeto">
									<parameter value="~dtgetCijenaSve.@neto_vazeca" />
								</action>

								<action type="control value" value="curCijenaVPBruto">
									<parameter value="~dtgetCijenaSve.@bruto_vazeca" />
								</action>

								
								<action type="control value" value="curVPMarzaVazeca">
									<parameter value="~dtgetCijenaSve.@VpMarza" />
								</action>

								<action type="control value" value="curMPMarzaVazeca">
									<parameter value="~dtgetCijenaSve.@MpMarza" />
								</action>

								
								<action type="control value" value="curCijenaMPVazeca">
									<parameter value="~dtgetCijenaSve.@mpc_vazeca" />
								</action>

								<action type="control value" value="curCijenaMP">
									<parameter value="~dtgetCijenaSve.@mpc_vazeca" />
								</action>

								<action type="control value" value="cmbCjenik">
									<parameter value="global.$VrCjenikId" />
								</action>

								<action type="variable value">
									<parameter name="PorezIznos" value="~dtgetPorez.@PorezIznos" />
								</action>
							</event>
						</searchedit>
					</item>

						<item caption="Datum od:" row="2" col="1" textalignmode="left" textposition="left">
							<dateedit name="datDatumOd" value="now">

								<event type="valuechanged">

									<action type="datarun reader" value="dtgetCijenaSve"/>

									<action type="control value" value="curCijenaNabavnaVazeca">
										<parameter value="~dtgetCijenaSve.@nabavna_cijena" />
									</action>

									<action type="control value" value="curCijenaFakturnaVazeca">
										<parameter value="~dtgetCijenaSve.@fakturna_cijena" />
									</action>

									<action type="control value" value="curCijenaNabavna">
										<parameter value="~dtgetCijenaSve.@nabavna_cijena" />
									</action>

									<action type="control value" value="curCijenaFakturna">
										<parameter value="~dtgetCijenaSve.@fakturna_cijena" />
									</action>

									<action type="control value" value="curCijenaVPNetoVazeca">
										<parameter value="~dtgetCijenaSve.@neto_vazeca" />
									</action>

									<action type="control value" value="curCijenaVPBrutoVazeca">
										<parameter value="~dtgetCijenaSve.@bruto_vazeca" />
									</action>

									<action type="control value" value="curCijenaVPNeto">
										<parameter value="~dtgetCijenaSve.@neto_vazeca" />
									</action>

									<action type="control value" value="curCijenaVPBruto">
										<parameter value="~dtgetCijenaSve.@bruto_vazeca" />
									</action>

									<action type="control value" value="curCijenaMPVazeca">
										<parameter value="~dtgetCijenaSve.@mpc_vazeca" />
									</action>

									<action type="control value" value="curCijenaMP">
										<parameter value="~dtgetCijenaSve.@mpc_vazeca" />
									</action>

									<action type="control value" value="curVPMarzaVazeca">
										<parameter value="~dtgetCijenaSve.@VPMarza" />
									</action>

									<action type="control value" value="curVPMarza">
										<parameter value="~dtgetCijenaSve.@VPMarza" />
									</action>

									<action type="control value" value="curMPMarzaVazeca">
										<parameter value="~dtgetCijenaSve.@MPMarza" />
									</action>

									<action type="control value" value="curMPMarza">
										<parameter value="~dtgetCijenaSve.@MPMarza" />
									</action>

								</event>
							</dateedit>
						</item>
						<!--<item row="1" col="2">
							--><!--  caption="Akcija" --><!--
							<checkedit caption="Akcija" name="chkAkcija">
								<event type="checkedchanged">
									<action type="control visible" value="#datDatumDo" if="#chkAkcija==false">
										<parameter value="false" />
									</action>
									<action type="control visible" value="#datDatumDo" else="">
										<parameter value="true" />
									</action>
								</event>
							</checkedit>
						</item>-->
						<!--<item caption="Datum do:" col="1" row="2" textalignmode="left" textposition="left" visible="false">
							<dateedit name="datDatumDo" value="now" savevalue="app" />
						</item>-->


				</group>

				<group col="1" row="2" rows="1" cols="3" groupbordervisible="True">
					<columnsdefinition>
						<column size="150" position="1" />
						<column size="50%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>
					<item col="2" row="1" padding="0" caption="Važeća cijena">
						<labeledit caption="Važeća cijena" />
					</item>
					<item  col="3" row="1" padding="0" caption="Nova cijena">
						<labeledit caption="Nova cijena"/>
					</item>
				</group>
				
				<group row="3" col="1" rows="2" cols="3" groupbordervisible="True" caption="Nabavna cijena">
					<columnsdefinition>
						<column size="100" position="1" />
						<column size="50%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>
					
					<item col="1" row="1" padding="0">
						<labeledit name="lblCijenaTip1" value="Nabavna cijena"/>
					</item>
					<item col="2" row="1" caption="">
						<textedit name="curCijenaNabavnaVazeca" type="decimal" value="0" format="n2" enabled="false"/>
					</item>
					<item col="3" row="1" caption="">
						<textedit name="curCijenaNabavna" type="decimal" value="0" format="n2">
							<event type="leave">

									<action type="datarun reader" value="dtPreracunNabavna" />

									<action type="control value" value="curCijenaVPNeto">
										<parameter value="~dtPreracunNabavna.@VPNeto" />
									</action>
									<action type="control value" value="curCijenaVPBruto">
										<parameter value="~dtPreracunNabavna.@VPBruto" />
									</action>
								<action type="control value" value="curCijenaMP">
									<parameter value="~dtPreracunNabavna.@MPCijena" />
								</action>


							</event>
						</textedit>
					</item>
					<item col="1" row="2" padding="0">
						<labeledit name="lblCijenaTip2" value="Fakturna cijena"/>
					</item>
					<item col="2" row="2" caption="">
						<textedit name="curCijenaFakturnaVazeca" type="decimal" value="0" format="n2"  enabled="false"/>
					</item>
					<item col="3" row="2" caption="">
						<textedit name="curCijenaFakturna" type="decimal" value="0" format="n2">
							<!--<event type="leave">

								<action if="global.$vrstaCijene==PC">
									<action type="datarun reader" value="dtcalcVPCijenaB" />
									<action type="control value" value="curCijenaTip1Nova">
										<parameter value="~dtcalcVPCijenaB.@nettoCijena" />
									</action>
									<action type="control value" value="curOsnovnaNova">
										<parameter value="~dtcalcVPCijenaB.@OsnovnaCijena" />
									</action>
								</action>


							</event>-->
						</textedit>
					</item>

				</group>
				
				<group col="1" row="4" rows="1" cols="3" groupbordervisible="True">
					<columnsdefinition>
						<column size="100" position="1" />
						<column size="50%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>
					
					<item col="1" row="1" padding="0">
						<labeledit name="lblVPMarza" value="VP marža"/>
					</item>
					<item col="2" row="1" caption="">
						<textedit name="curVPMarzaVazeca" type="decimal" value="0" format="n2" enabled="false"/>
					</item>
					<item col="3" row="1" caption="">
						<textedit name="curVPMarza" type="decimal" value="0" format="n2">
							<event type="leave">

								<action type="datarun reader" value="dtPreracunNabavna" />

								<action type="control value" value="curCijenaVPNeto">
									<parameter value="~dtPreracunNabavna.@VPNeto" />
								</action>
								<action type="control value" value="curCijenaVPBruto">
									<parameter value="~dtPreracunNabavna.@VPBruto" />
								</action>
								<action type="control value" value="curCijenaMP">
									<parameter value="~dtPreracunNabavna.@MPCijena" />
								</action>
							</event>
						</textedit>
					</item>
				</group>

				<group row="5" col="1" rows="3" cols="3" groupbordervisible="True" caption="Prodajna cijena">
					<columnsdefinition>
						<column size="100" position="1" />
						<column size="50%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>

					<item col="1" row="1" padding="0">
						<labeledit name="lblVPNettoCijena" value="VP Neto cijena"/>
					</item>
					<item col="2" row="1" caption="">
						<textedit name="curCijenaVPNetoVazeca" type="decimal" value="0" format="n2" enabled="false"/>
					</item>
					<item col="3" row="1" caption="">
						<textedit name="curCijenaVPNeto" type="decimal" value="0" format="n2">
							<event type="leave">

								<action type="datarun reader" value="dtPreracunVPNeto" />
								
								<action type="control value" value="curVPMarza">
									<parameter value="~dtPreracunVPNeto.@VPMarza" />
								</action>
								<action type="control value" value="curCijenaVPBruto">
									<parameter value="~dtPreracunVPNeto.@VPBruto" />
								</action>
								<action type="control value" value="curCijenaMP">
									<parameter value="~dtPreracunVPNeto.@MPCijena" />
								</action>
							</event>
						</textedit>
					</item>
					<item col="1" row="2" padding="0">
						<labeledit name="lblVPBruttoCijena" value="VP Bruto cijena"/>
					</item>
					<item col="2" row="2" caption="">
						<textedit name="curCijenaVPBrutoVazeca" type="decimal" value="0" format="n2"  enabled="false"/>
					</item>
					<item col="3" row="2" caption="">
						<textedit name="curCijenaVPBruto" type="decimal" value="0" format="n2">
							<event type="leave">

								<action type="datarun reader" value="dtPreracunVPbruto" />

								<action type="control value" value="curVPMarza">
									<parameter value="~dtPreracunVPBruto.@VPMarza" />
								</action>
								<action type="control value" value="curCijenaVPNeto">
									<parameter value="~dtPreracunVPBruto.@VPNeto" />
								</action>
								<action type="control value" value="curCijenaMP">
									<parameter value="~dtPreracunVPBruto.@MPCijena" />
								</action>
							</event>
						</textedit>
					</item>
					
					<item caption="Datum do:" col="2" row="3" textalignmode="left" textposition="left" colspan="2" visible="false">
						<dateedit name="datVPDatumDo" value="now" savevalue="app" />
					</item>

					<item row="3" col="1">
						<!--  caption="Akcija" -->
						<checkedit caption="Akcija" name="chkVPAkcija">
							<event type="checkedchanged">
								<action type="control visible" value="#datVPDatumDo" if="#chkVPAkcija==false">
									<parameter value="false" />
								</action>
								<action type="control visible" value="#datVPDatumDo" else="">
									<parameter value="true" />
								</action>
							</event>
						</checkedit>
					</item>


				</group>

				<group col="1" row="6" rows="1" cols="3" groupbordervisible="True">
					<columnsdefinition>
						<column size="100" position="1" />
						<column size="50%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>

					<item col="1" row="1" padding="0">
						<labeledit name="lblMPMarza" value="MP marža"/>
					</item>
					<item col="2" row="1" caption="">
						<textedit name="curMPMarzaVazeca" type="decimal" value="0" format="n2" enabled="false"/>
					</item>
					<item col="3" row="1" caption="">
						<textedit name="curMPMarza" type="decimal" value="0" format="n2">

							<event type="leave">

								<action type="datarun reader" value="dtPreracunMPMarza" />

								<action type="control value" value="curCijenaMP">
									<parameter value="~dtPreracunMPMarza.@MPCijena" />
								</action>
							</event>
							
						</textedit>
					</item>


				</group>

				<group row="7" col="1" rows="2" cols="3" groupbordervisible="True" caption="Maloprodajna cijena">

					<item col="1" row="1" padding="0">
						<labeledit name="lblMPCijena" value="Maloprodajna cijena"/>
					</item>
					<item col="2" row="1" caption="">
						<textedit name="curCijenaMPVazeca" type="decimal" value="0" format="n2" enabled="false"/>
					</item>
					<item col="3" row="1" caption="">
						<textedit name="curCijenaMP" type="decimal" value="0" format="n2">
							<!--<event type="leave">
								<action if="global.$vrstaCijene==PC">
									<action type="datarun reader" value="dtcalcVPCijenaN" />

									<action type="control value" value="curCijenaTip2Nova">
										<parameter value="~dtcalcVPCijenaN.@BruttoCijena" />
									</action>
									<action type="control value" value="curOsnovnaNova">
										<parameter value="~dtcalcVPCijenaN.@OsnovnaCijena" />
									</action>
								</action>

							</event>-->
						</textedit>
					</item>

					<item caption="Datum do:" col="2" row="2" textalignmode="left" textposition="left" colspan="2" visible="false">
						<dateedit name="datMPDatumDo" value="now" savevalue="app" />
					</item>

					<item row="2" col="1">
						<!--  caption="Akcija" -->
						<checkedit caption="Akcija" name="chkMPAkcija">
							<event type="checkedchanged">
								<action type="control visible" value="#datMPDatumDo" if="#chkMPAkcija==false">
									<parameter value="false" />
								</action>
								<action type="control visible" value="#datMPDatumDo" else="">
									<parameter value="true" />
								</action>
							</event>
						</checkedit>
					</item>

				</group>
				
				<group col="1" row="8" rows="2" cols="1" groupbordervisible="True">
					<item col="1" row="1" caption="Cjenik:" textvisible="True">
						<comboedit name="cmbCjenik" required="true" valuefield="VrCjenikId" displayfield="Opis" dataname="global.~dtVrCjenik" />
					</item>
					<item row="2" col="1">
						<checkedit caption="Publiciraj u Web shop" name="chkPubliciraj">
							<event type="checkedchanged">
							</event>
						</checkedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="&amp;SPREMI" type="add" dock="left">
					<event type="click">

						<action type="datarun nonquery" value="~dtSpremiPC"/>
						<action type="datarun nonquery" value="~dtSpremiNC"/>
						<action type="datarun nonquery" value="~dtSpremiMPC"/>

						<action type="control value" value="#srcRoba">
							<parameter value="null"  />
						</action>

						<action type="control value" value="#curVPMarza">
							<parameter value="0"  />
						</action>

						<action type="control value" value="#curVPMarzaVazeca">
							<parameter value="0"  />
						</action>

						<action type="control value" value="#curMPMarza">
							<parameter value="0"  />
						</action>

						<action type="control value" value="#curMPMarzaVazeca">
							<parameter value="0"  />
						</action>
						
						<action type="control focus" value="#srcRoba" />
					</event>
				</button>
				<button name="btnOdustani" caption="&amp;Odustani" type="cancel" dock="right">

					<action type="form close" />
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba"/>
				<parameter name="@Uvjet" value="#srcRoba.text"/>
				<parameter name="@PokaziVPCijene" value="0"/>
				<parameter name="@PokaziNabCijene" value="0"/>
				<parameter name="@Retired" value="0"/>
				<parameter name="@Prikazi_Dodatno" value="0"/>
				<parameter name="@PokaziStanje" value="0"/>
				<parameter name="@SkladisteId" value=""/>
			</data>
			<data command="spProd_Cjenik_getPorez" name="dtgetPorez">
				<parameter name="@RobaId" value="#srcRoba"/>
				<parameter name="@Datum" value="#datDatumOd"/>
			</data>
			<data command="spProd_Cjenik_MultiUnos_GetCijene" name="dtgetCijenaSve">
				<parameter name="@RobaId" value="#srcRoba"/>
				<parameter name="@VrCjenikId" value="global.$VrCjenikId"/>
				<parameter name="@Datum" value="#datDatumOd"/>
			</data>
			<data command="spProd_Cjenik_MultiUnos_Preracun" name="dtPreracunNabavna">
				<parameter name="@NabavnaCijena" value="#curCijenaNabavna"/>
				<parameter name="@VPMarza" value="#curVPMarza"/>
				<parameter name="@Porez" value="$PorezIznos" type="decimal"/>
				<parameter name="@Polje" value="NabavnaCijena"/>
			</data>
			<data command="spProd_Cjenik_MultiUnos_Preracun" name="dtPreracunVPNeto">
				<parameter name="@NabavnaCijena" value="#curCijenaNabavna"/>
				<parameter name="@VPMarza" value="#curVPMarza"/>
				<parameter name="@Porez" value="$PorezIznos" type="decimal"/>
				<parameter name="@Polje" value="NetoCijena"/>
				<parameter name="@Kunski" value="global.$IndKunski"/>
				<parameter name="@VPNeto" value="#curCijenaVPNeto"/>
			</data>
			<data command="spProd_Cjenik_MultiUnos_Preracun" name="dtPreracunVPBruto">
				<parameter name="@NabavnaCijena" value="#curCijenaNabavna"/>
				<parameter name="@VPMarza" value="#curVPMarza"/>
				<parameter name="@Porez" value="$PorezIznos" type="decimal"/>
				<parameter name="@Polje" value="BrutoCijena"/>
				<parameter name="@Kunski" value="global.$IndKunski"/>
				<parameter name="@VPNeto" value="#curCijenaVPNeto"/>
				<parameter name="@VPBruto" value="#curCijenaVPBruto"/>
			</data>

			<data command="spProd_Cjenik_MultiUnos_Preracun" name="dtPreracunMPMarza">
				<parameter name="@MPMarza" value="#curMPMarza"/>
				<parameter name="@Porez" value="$PorezIznos" type="decimal"/>
				<parameter name="@VPNeto" value="#curCijenaVPNeto"/>
				<parameter name="@Polje" value="MPMarza"/>
			</data>

			
			<data command="spProd_Cjenik_ProdCijena_Unos" name="dtSpremiPC">
				<parameter name="@RobaId" value="#srcRoba"/>
				<parameter name="@str" value="#cmbCjenik"/>
				<parameter name="@ind" value="PC"/>
				<parameter name="@DatumOd" value="#datDatumOd"/>
				<parameter name="@DatumDo" value="#datVPDatumDo"/>
				<parameter name="@Akcija" value="#chkVPAkcija"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@cijena" value="#curCijenaVPNeto"/>
				<parameter name="@porez" value="$PorezIznos"/>
			</data>
			<data command="spProd_Cjenik_NabCijena_Unos" name="dtSpremiNC">
				<parameter name="@RobaId" value="#srcRoba"/>
				<parameter name="@str" value="#cmbCjenik"/>
				<parameter name="@ind" value="NC"/>
				<parameter name="@DatumOd" value="#datDatumOd"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@cijena" value="#curCijenaNabavna"/>
				<parameter name="@fakturnacijena" value="#curCijenaFakturna"/>
			</data>
