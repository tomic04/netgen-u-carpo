
<root>

  <form name="frmOSDodVrijednost" caption="Izmjena vrijednosti dodatnih podataka"  width="500" height ="600">
    <event type="init">
      <action type="datarun reader" value="~dtUnosVrijednost" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdUnosVrijednost" />
    </event>
      <layout >
        <group cols="1" rows="1" spacing="2,2,2,2">
          <item col="1" row="1" >
            <grid name="grdUnosVrijednost" key="OSImovinaDodPodaciId" keyfield="OSImovinaDodPodaciId" dataname="dtUnosVrijednost" showautofilterrow="true" fieldsmartspaces="false" multiselect="true">
              <event type="cellvaluechanged">
                <action type="datarun nonquery" value="~dtUpdateVrijednost" />
                <action type="control populate keepfocus" value="#grdUnosVrijednost" />
              </event>
              <fields inherited="true">
                <field name="Vrijednost" editable="true" />
              </fields>
            </grid>
          </item>
        </group>
      </layout>
    
      <panelbuttons>
        <buttons>
          <button caption="Zatvori" type="cancel" dock="right">
            <event type="click"/>
          </button>
        </buttons>
      </panelbuttons>

      <datalist>
        <data command="spOSImovinaDodatni_CP" name="dtUnosVrijednost">
          <parameter name="@Action" value="Grid_UnosVrijednost"/>
          <parameter name="@OSImovinaId" value="$OSImovinaId" />
        </data>
        <data command="spOSImovinaDodatni_CP" name="dtUpdateVrijednost">
          <parameter name="@Action" value="Update_vrijednost"/>
          <parameter name="@OSImovinaDodPodaciId" value="#grdUnosVrijednost.@OSImovinaDodPodaciId" />        
          <parameter name="@Vrijednost" value="#grdUnosVrijednost.@Vrijednost" />
        </data>
      </datalist>
    </form>


	
</root>