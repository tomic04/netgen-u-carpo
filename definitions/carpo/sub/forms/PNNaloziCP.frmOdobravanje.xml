<root>
	<!--
  *******************************************************************************************
  FORMA ZA ODOBRAVANJA/ODBIJANJA NALOGA
  *******************************************************************************************
  -->
	<form name="frmOdobri" caption="$caption" width="500" height="300">
		<event type="load">
			<action type="datarun reader" value="~dtProvjeraOdobravanje"/>
			<action type="form close" if="$indGreske!=0">				
			</action>
		</event>
		<layout>
			<group cols="5" rows="1" groupbordervisible="false">
				<item row="1" col="1" caption="" highlight="false" textposition="top" colspan="5">
					<labeledit name="lblUpit" value="Jeste sigurni da želite odobriti odabrane naloge?" fontsizedelta="2" bold="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Odobri">
					<event type="click">
						<action type="datarun reader" value="~dtOdobri">
							<action if="$indGreske==0">
								<action type="form close"/>
							</action>
							<action if="$indGreske==1">
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPNPromjenaStatusa" name="dtProvjeraOdobravanje">
				<parameter name="@action" value="provjera_vise_odobravanje"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@ids2" value="$ids2"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNPromjenaStatusa" name="dtOdobri">
				<parameter name="@action" value="odobri_niz"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@ids2" value="$ids2"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
	<form name="frmOdbij" caption="$caption" width="500" height="500">
		<event type="load">
			<action type="datarun reader" value="~dtProvjeraOdobravanje"/>
			<action type="form close" if="$indGreske!=0">				
			</action>
		</event>
		<layout>
			<group cols="5" rows="3" groupbordervisible="false">
				<item row="1" col="1" caption="" highlight="false" textposition="top" colspan="5">
					<labeledit name="lblUpit" value="Jeste sigurni da želite odbiti odabrane naloge?" fontsizedelta="2" bold="true"/>
				</item>
				<item row="2" caption="Napomena" col="1" highlight="false" textposition="top" colspan="5" rowspan="2">
					<memoedit name="txtNapomena" value="" required="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Odbij">
					<event type="click">
						<action type="validate"/>
						<action type="datarun reader" value="~dtOdbij">
							<action if="$indGreske==0">
								<action type="form close"/>
							</action>
							<action if="$indGreske==1">
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPNPromjenaStatusa" name="dtProvjeraOdobravanje">
				<parameter name="@action" value="provjera_vise_odobravanje"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@ids2" value="$ids2"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNPromjenaStatusa" name="dtOdbij">
				<parameter name="@action" value="odbij_niz"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@ids2" value="$ids2"/>
				<parameter name="@napomena" value="#txtNapomena"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
	<form name="frmPonisti" caption="$caption" width="500" height="300">
		<layout>
			<group cols="5" rows="1" groupbordervisible="false">
				<item row="1" col="1" caption="" highlight="false" textposition="top" colspan="5">
					<labeledit name="lblUpit" value="Jeste sigurni da želite poništiti odobrenje za odabrane naloge?" fontsizedelta="2" bold="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Poništi">
					<event type="click">
						<action type="datarun reader" value="~dtPonisti">
							<action if="$indGreske==0">
								<action type="form close"/>
							</action>
							<action if="$indGreske==1">
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPNPromjenaStatusa" name="dtPonisti">
				<parameter name="@action" value="ponisti_niz"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
</root>