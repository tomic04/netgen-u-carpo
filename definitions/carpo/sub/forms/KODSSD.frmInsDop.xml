<root>


	<!--FORMA ZA UNOS DOPRINOSA-->

	<form name="frmInsDop" caption ="$caption"  minwidth="800">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$lnOOPSSDDetId!=null"/>
			<action type="datarun reader" value="~dtPrebroj"/>
			<action type="variable value">
				<parameter name="rdo1broj" value="~dtPrebroj.@rdo1broj"/>
				<parameter name="rdo2broj" value="~dtPrebroj.@rdo2broj"/>
				<parameter name="rdo3broj" value="~dtPrebroj.@rdo3broj"/>
				<parameter name="rdo4broj" value="~dtPrebroj.@rdo4broj"/>
			</action>
		</event>

		<event type="load">
			<action type="control value" value="#txtDoprinos">
				<parameter value="$doprinosNaziv"></parameter>
			</action>
		</event>

		<event type="shown">
			<action type="control caption" value="#rdoOpcija1">
				<!--<parameter value="Spremi izmjene samo za ovu kombinaciju ({$rdo1broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za ovu stavku u ovom statusu ({$rdo1broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija2">
				<!--<parameter value="Spremi izmjene za sve kombinacije ove stavke ({$rdo2broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za ovu stavku u svim statusima ({$rdo2broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija3">
				<!--<parameter value="Spremi izmjene za sve kombinacije ovog statusa ({$rdo3broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za sve stavke u ovom statusu ({$rdo3broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija4">
				<!--<parameter value="Spremi izmjene za sve kombinacije ({$rdo4broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za sve stavke u svim statusima ({$rdo4broj})"/>
			</action>
		</event>

		<layout>
			<group cols="1" rows="8"  spacing="2,2,2,2">

				<item caption="Doprinos:" col="1" row="1" highlight="False" textposition="left">
					<textedit name="txtDoprinos"   readonly="true"/>
				</item>

				<item caption="Datum:" col="1" row="2" highlight="False" textposition="left">
					<dateedit name="datDatumOd" value="now" datavalue="~dtGet.@datumod" required="true"/>
				</item>
				<item caption="Stopa:" col="1" row="3"  highlight="False" textposition="left">
					<textedit name="txtStopa" required="true" format="n2" nulltext="0,00" datavalue="~dtGet.@Stopa" textposition="left" />
				</item>
				<item caption="Min. osnovica:" col="1" row="4" highlight="False" textposition="left">
					<textedit name="txtMinOsnovica" required="false" format="n2" nulltext="0,00" datavalue="~dtGet.@MinOsnovica" textposition="left" />
				</item>
				<item caption="Max. osnovica:" col="1" row="5" highlight="False" textposition="left">
					<textedit name="txtMaxOsnovica" required="false" format="n2" nulltext="0,00" datavalue="~dtGet.@MaxOsnovica" textposition="left" />
				</item>
				<item caption="God. osnovica:" col="1" row="6"  highlight="False" textposition="left">
					<textedit name="txtGodOsnovica" required="false" format="n2" nulltext="0,00" datavalue="~dtGet.@GodOsnovica" textposition="left" />
				</item>
				<item caption="Koeficijent:" col="1" row="7" highlight="False" textposition="left">
					<textedit name="txtKoeficijent" required="true" format="n2" value="1"  datavalue="~dtGet.@Koeficijent" textposition="left" />
				</item>

				<group cols="1" rows="5" col="1" row="8" entermovenextcontrol="true" groupbordervisible="false">
					<rowsdefinition>
						<row position ="1" size="20"/>
					</rowsdefinition>
					<item row="1" col="1" caption="Opcija spremanja:" highlight="False">
					</item>
					<item row="2" col="1" highlight="False">
						<radioedit name="rdoOpcija1" caption="" value="true" >
							<!--<radioedit name="rdoOpcija1" caption="Spremi izmjene samo za ovu kombinaciju" value="true" >-->
						</radioedit>
					</item>
					<item row="3" col="1" highlight="False">
						<radioedit name="rdoOpcija2" caption="" >
							<!--<radioedit name="rdoOpcija2" caption="Spremi izmjene za sve kombinacije ove stavke" >-->
						</radioedit>
					</item>
					<item row="4" col="1" highlight="False">
						<radioedit name="rdoOpcija3" caption="" >
							<!--<radioedit name="rdoOpcija3" caption="Spremi izmjene za sve kombinacije ovog statusa" >-->
						</radioedit>
					</item>
					<item row="5" col="1" highlight="False">
						<radioedit name="rdoOpcija4" caption="" >
							<!--<radioedit name="rdoOpcija4" caption="Spremi izmjene za sve kombinacije" >-->
						</radioedit>
					</item>
				</group>

			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- Provjeri required fields -->
						<action type="validate" />
						<!-- Okini storu -->
						<!--<action type="datarun reader" value="~dtKontrolaUnos"/>-->
						<!-- ako kontrola javi grešku, ispiši ju, u protivnom okini insert -->
						<!--<action type="message" value="~dtKontrolaUnos.@poruka" if="~dtKontrolaUnos.@poruka!=null"/>-->

						<action type="datarun reader" value="~dtSpremi"  waittype="progress" waitcaption="Pričekajte..." waittext="..spremanje u tijeku..." />
						<action type="message" value="~dtSpremi.@poruka"/>

						<!-- Osvježi grid na parent formi -->
						<action type="control populate" value="parent.#grdDoprinosiStavka"/>
						<action type="control populate" value="parent.#grdDoprinosiRaspolozivi"/>

						<action type="form close" />

					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spLnOOPSSDQuery" name="dtGet">
				<parameter name="@Action" value="podaci_LnOOPSSDDetId" type="string"/>
				<parameter name="@lnOOPSSDDetId" value="$lnOOPSSDDetId" type="int"/>
			</data>
			<data command="spLnOOPSSDQuery" name="dtPrebroj">
				<parameter name="@Action" value="Brojanje" type="string"/>
				<parameter name="@oopstavkeid" value="$oopstavkeid" type="int"/>
				<parameter name="@hrdopstatusiid" value="$hrdopstatusiid" type="int"/>
				<parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
				<parameter name="@Tip" value="$Tip" />
			</data>

			<!--<data command="spLnOOPSSDDetAzur" name="dtKontrolaUnos">
        <parameter name="@Action" value="kontrola_unos" type="string"/>
        <parameter name="@OperateriId" value="@@OperateriId" />
        <parameter name="@hrdopstatusiid" value="$hrdopstatusiid" type="int"/>
        <parameter name="@oopstavkeid" value="$oopstavkeid" type="int"/>
        <parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
        <parameter name="@datumod" value="#datDatumOd" type="date"/>
        <parameter name="@indDoprinosZaStavku" value="1" type="int" if="#rdoOpcija1==true"/>
        <parameter name="@indDoprinosZaStavkuSvihStatusa" value="1" type="int" if="#rdoOpcija2==true"/>
        <parameter name="@indDoprinosSveStavkeStatusa" value="1" type="int" if="#rdoOpcija3==true"/>
        <parameter name="@indDoprinosZaSveStavkeSvihStatusa" value="1" type="int" if="#rdoOpcija4==true"/>
      </data>-->


			<data command="spLnOOPSSDDetAzur" name="dtSpremi">
				<parameter name="@Action" value="unos" type="string"/>
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@lnOOPSSDDetId" value="$lnOOPSSDDetId" type="int"/>
				<parameter name="@lnOOPSSDGlaId" value="parent.#grdStavke.@lnOOPSSDGlaId" type="int"/>
				<parameter name="@hrdopstatusiid" value="$hrdopstatusiid" type="int"/>
				<parameter name="@oopstavkeid" value="$oopstavkeid" type="int"/>
				<parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
				<parameter name="@datumod" value="#datDatumOd" type="date"/>
				<parameter name="@stopa" value="#txtStopa" type="decimal"/>
				<parameter name="@MinOsnovica" value="#txtMinOsnovica" type="decimal"/>
				<parameter name="@MaxOsnovica" value="#txtMaxOsnovica" type="decimal"/>
				<parameter name="@GodOsnovica" value="#txtGodOsnovica" type="decimal"/>
				<parameter name="@Koeficijent" value="#txtKoeficijent" type="decimal"/>
				<parameter name="@indDoprinosZaStavku" value="1" type="int" if="#rdoOpcija1==true"/>
				<parameter name="@indDoprinosZaStavkuSvihStatusa" value="1" type="int" if="#rdoOpcija2==true"/>
				<parameter name="@indDoprinosSveStavkeStatusa" value="1" type="int" if="#rdoOpcija3==true"/>
				<parameter name="@indDoprinosZaSveStavkeSvihStatusa" value="1" type="int" if="#rdoOpcija4==true"/>
			</data>


			<data command="spLnOOPSSDHelp" name="dtSrcKODOsiguranici">
				<parameter name="@action" value="trazilica_kodosiguranici"/>
				<parameter name="@Tekst" value="#srckodosiguranici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODPrimici">
				<parameter name="@action" value="trazilica_kodprimici"/>
				<parameter name="@Tekst" value="#srckodprimici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODNeoporeziviPrimici">
				<parameter name="@action" value="trazilica_kodneoporeziviprimici"/>
				<parameter name="@Tekst" value="#srckodneoporeziviprimici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODBeneficirani">
				<parameter name="@action" value="trazilica_kodbeneficirani"/>
				<parameter name="@Tekst" value="#srckodbeneficirani.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODNaciniIsplate">
				<parameter name="@action" value="trazilica_kodnaciniisplate"/>
				<parameter name="@Tekst" value="#srckodnaciniisplate.text"/>
			</data>
		</datalist>
	</form>


	<!--kraj FORMA ZA UNOS DOPRINOSA-->
</root>