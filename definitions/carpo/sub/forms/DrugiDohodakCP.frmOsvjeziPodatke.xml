<root>


  <form name="frmOsvjeziPodatke" caption="$caption" width="500" height="200" fixedsize="true" saveformsize="false" showversion="true" version="1">

	<event type="shown">
     
      <action type="control value" value="#rdoOdabrani">
        <parameter value="true"></parameter>
      </action>
      <action type="control value" value="#rdoSvi">
        <parameter value="false"></parameter>
      </action>
      
    </event>

    <layout>

      <!--omotač-->
      <group cols="1" rows="3" groupbordervisible="false">
        <item col="1" row="1" highlight="False">
          <radioedit caption="samo odabranima" name="rdoOdabrani" fontsizedelta="2" />
        </item>
        <item col="1" row="2" highlight="False">
          <radioedit caption="svima na obradi" name="rdoSvi" fontsizedelta="2" />
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOsvjezi" caption="OSVJEŽI">
          <event type="click">
            <action type="datarun reader" value="~dtOsvjeziPodatke">
              <action if="$indGreske==0">
                <action type="message" value="Osvježavanje podataka za sve partnere je završeno!" if="#rdoSvi==true"></action>
                <action type="message" value="Osvježavanje podataka za odabrane partnere je završeno!" if="#rdoOdabrani==true"></action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spDDObradeDjelatniciAzur_CP" name="dtOsvjeziPodatke">
        <parameter name="@action" value="6" type="string"/>
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@oopisobradeid" value="parent.#grdDD.@OOPIsobradeid" />
        <parameter name="@selectedids" value="parent.#grdDD.selectedids" if="#rdoSvi==false" />
        <parameter name="@poruka.output.string"/>
        <parameter name="@indGreske.output.int"/>
      </data>

    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>