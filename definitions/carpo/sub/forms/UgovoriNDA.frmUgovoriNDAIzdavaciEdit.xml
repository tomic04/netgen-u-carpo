<root>
	<form name="frmUgovoriNDAIzdavaciEdit" caption="Izmjena dokumenta" width="1200" height="570" operaterlocktable="PosUgovorigla" operaterlockkey="PosUgovoriglaId" operaterlockkeyvalue="global.$OperaterLockId">
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" if="$PosUgovoriglaId!=null" />
			<action type="datarun reader" value="Global.~dtGet">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<action type="datarun reader" value="Global.~dtDetaljStavke" if="$PosUgovoriDetId!=null" />
			<action type="datarun reader" value="Global.~dtDetaljStavke">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<!-- <action type="datarun reader" value="Global.~dtGetDet" if="$PosUgovoriDetId!=null" />
			<action type="datarun reader" value="Global.~dtGetDet">
				<parameter value="@PosUgovoriDetId" />
			</action> -->
			<action type="variable value" if="$Izmjena==1" />
			<!-- <action type="variable value">
				<parameter name="Global.OperaterLockId" value="0" type="int" />
			</action> -->
		</event>
		<event type="load">
			<action type="variable value">
				<parameter name="OsobaTrazilica" value="~dtGet.@OsobaTrazilica" />
			</action>
			<!-- <action type="variable value">
				<parameter name="PosUgovoriDetIdww" value="~dtGetDet.@PosUgovoriDetId" />
			</action> -->
			<action type="variable value">
				<parameter name="Izmjena" value="0" />
			</action>

			<action type="control populate" value="#grdRoba" />
			<!-- <action type="control refreshvalue" value="#grdRoba" /> -->

			<action type="control disable" value="#datDatumVrijediDo" if="#datDatumVrijediDo==null">
			</action>
			<action type="control value" value="#datDatumVrijediDo">
				<!--  <parameter value="now" /> -->
				<parameter value="global.~dtGet.@ugovorvrijedido" if="global.~dtGet.@provdatum==1"/>
				<parameter value="now" else=""/>
			</action>


			<action type="datarun reader" value="~dtUkupanIznos"/>
			<action type="control value" value="txtUkupno">
				<parameter value="~dtUkupanIznos.@UkupnoUplaceno" />
			</action>

		</event>



		<event type="shown">
			<action type="control focus" value="#srcPartner" if="$PosUgovoriglaId==null" />
			<action type="control disable" value="#txtOIB, #txtMBS, #txtAdresa,#txtMjesto,#txtHPTBroj,#txtTelefon,#txtFax,#txtIBAN,#txtNacinPlacanja" />
			<action type="control enable" value="#txtKreditniLimit,#txtOdgoda,#txtRabat,#txtAneks,#srcPartner, #txtZaduznica" if="$PosUgovoriglaId!=null" />
			<action type="control disable" value="#txtBroj,#srcPartner" if="$PosUgovoriglaId!=null" />
			<action type="control enable" value="#srcOvlastenaOsobaTrazilica" if="$OsobaTrazilica==1" />
			<action type="control enable" value="#srcOvlastenaOsobaTrazilica" elseif="$OsobaTrazilica==null" />
			<action type="control disable" value="#srcOvlastenaOsobaTrazilica" else="" />
			<action type="control enable" value="#txtOvlastenaOsoba" if="$OsobaTrazilica==0" />
			<action type="control enable" value="#txtOvlastenaOsoba" elseif="$OsobaTrazilica==null" />
			<action type="control disable" value="#txtOvlastenaOsoba" else="" />
			<action type="control disable" value="#btnPoveziRoba" if="#txtNaslov==null" />
			<action type="control enable" value="#btnPoveziRoba" else="" />
			<action type="control disable" value="#btnObrisi" if="#grdRoba.rowcount==0"/>
			<action type="control enable" value="#btnObrisi" else="" />
		</event>
		<layout itemspadding="1">
			<group cols="1" rows="1">
				<group padding="0" groupbordervisible="False" cols="3" rows="1">
					<columnsdefinition>
						<column size="660" position="1" />
						<column size="8" position="2" />
					</columnsdefinition>
					<item row="1" col="3" />
					<group padding="0" groupbordervisible="False" cols="1" rows="1" col="3" row="2">
						<rowsdefinition>
							<row size="1" position="3" />
							<row size="54" position="4" />
						</rowsdefinition>
						<group padding="4" groupbordervisible="False" cols="1" rows="1" col="1" row="1">
							<tabs col="1" row="1">
								<group cols="2" rows="3" caption="Uplaćeni iznosi">
									<group padding="4" groupbordervisible="false" cols="3" rows="1" col="1" row="1">
										<columnsdefinition>
											<column size="80%" position="1" />
											<column size="100" position="2" />
											<column size="75" position="3" />
										</columnsdefinition>
									</group>
									<group padding="4" groupbordervisible="false" cols="3" rows="2" col="1" row="1">
										<columnsdefinition>
											<column size="100%" position="1" />
											<column size="50%" position="2" />
											<column size="75" position="3" />
										</columnsdefinition>
										<item caption="Uplaćeni godišnji iznosi:" col="1" row="1">
											<textedit name="txtAvansUplaceniGodisnji" datavalue="#dtDetaljStavke.@AvansUplaceniGodisnji" format="n2" function="AvansUplaceniGodisnji" />
										</item>
										<item caption="Godina uplate:" col="2" row="1">
											<textedit name="txtAvansGodina" datavalue="#dtDetaljStavke.@AvansGodina" format="[12][0-9]{3}" formattype="regex" function="AvansGodina" />
										</item>
									</group>
									<group groupbordervisible="False" cols="3" rows="4" col="1" row="2">
										<columnsdefinition>
											<column size="100%" position="1" />
											<column size="75" position="3" />
										</columnsdefinition>
										<rowsdefinition>
											<row size="50" position="1" />
											<row size="50" position="2" />
											<row size="50" position="3" />
										</rowsdefinition>
										<item row="1" col="1" highlight="False" colspan="2" rowspan="4">
											<grid name="grdRoba" type="master" multiselect="true" key="PosUgovoriDetId" showgrouppanel="False" showfooter="true" savelayout="False" previewfield="Roba">
												<event type="focusedrowchanged">
													<action type="variable value">
														<parameter name="PosUgovoriDetId" value="#grdRoba.@PosUgovoriDetId" />
													</action>
												</event>




												<!-- <event type="doubleclick">
													<action type="datarun nonquery" value="~dtSpremi"/>
													<action type="form open" value="frmPosUgovoriDodatno" if="#grdRoba.rowcount&gt;0">
														<parameter name="PosUgovoriGlaId" value="$PosUgovoriGlaId" />
														<parameter name="PosUgovoriDetId" value="$PosUgovoriDetId" />
														<parameter name="Izmjena" value="1" />
													</action>
													<action type="control populate keepfocus" value="#grdRoba" />
												</event> -->
												<event type="keydown" value="46">
													<action type="confirm" value="Želite li obrisati označeno?">
														<action type="control foreachrow selected" value="#grdRoba">
															<action type="datarun nonquery" value="~dtDetDelete" />
														</action>
														<action type="control populate" value="#grdRoba" />
														<action type="control disable" value="#btnObrisi" if="#grdRoba.rowcount==0"/>
														<action type="control enable" value="#btnObrisi" else="" />
													</action>

													<action type="datarun reader" value="~dtUkupanIznos"/>
													<action type="control value" value="txtUkupno">
														<parameter value="~dtUkupanIznos.@UkupnoUplaceno" />
													</action>



												</event>
												<data command="spProd_PosUgovoriDet_Query">
													<parameter name="@Id" value="$PosUgovoriglaId" />
												</data>
												<fields inherited="false">
													<field name="Godina" caption="Godina" />
													<field name="Avansuplacenigodisnji" caption="Uplaćeni godišnji iznosi" />
												</fields>
												<groupsummary>
													<summary type="count" visible="false"/>
													<summary type="sum" fieldname="Avansuplacenigodisnji"/>
												</groupsummary>
											</grid>
										</item>
										<item caption="" col="3" row="1">
											<button image="add" caption="Dodaj" name="btnDodaj" type="add">
												<event type="click">
													<action type="datarun nonquery" value="~dtSpremi"/>
													<action type="validate"/>
													<action type="datarun scalar" value="~dtInsertDetalj" if="$Izmjena==0">
														<!-- <parameter name="NewDetiId" value="$NewDetiId" /> -->
														<parameter name="PosUgovoriDetIdNew" />
													</action>
													<action type="control  populate" value="#grdRoba"/>
													<!-- <action type="datarun nonquery" value="~dtUpdateDetLN" if="$Izmjena==0"/> -->
													<action type="control  focus" value="#grdRoba">
														<parameter value="$PosUgovoriDetIdNew" type="int"/>
													</action>
													<action type="control refreshvalue" value="#txtAvansUplaceniGodisnji,#txtAvansGodina" />
													<action type="control focus" value="#txtAvansUplaceniGodisnji" />
													<action type="control disable" value="#btnObrisi" if="#grdRoba.rowcount==0"/>
													<action type="control enable" value="#btnObrisi" else="" />

													<action type="datarun reader" value="~dtUkupanIznos"/>
													<action type="control value" value="txtUkupno">
														<parameter value="~dtUkupanIznos.@UkupnoUplaceno" />
													</action>
												</event>
											</button>
										</item>


										<action type="datarun scalar" value="~dtInsertDetalj" if="$Izmjena==0">
											<!-- <parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" /> -->
											<parameter name="NewDetiId" value="$NewDetiId" />
										</action>
										<!-- <item caption="" col="3" row="2">
											<button image="edit" caption="Izmijeni" name="btnIzmijeni">
												<event type="click">
													<action type="datarun nonquery" value="~dtSpremi"/>
													<action type="validate"/>
													<action type="form open" value="frmPosUgovoriDodatno">
														<parameter name="PosUgovoriGlaId" value="$PosUgovoriGlaId" />
														<parameter name="PosUgovoriDetId" value="$PosUgovoriDetId" type="int" />
														<parameter name="Izmjena" value="1" />
													</action>
													<action type="control populate keepfocus" value="#grdRoba" />
												</event>
											</button>
										</item> -->
										<item caption="" col="3" row="2">
											<button image="delete" caption="Obriši" name="btnObrisi">
												<event type="click">
													<action type="validate"/>
													<action type="datarun nonquery" value="~dtSpremi"/>
													<action type="confirm" value="Želite li obrisati označeno?">
														<action type="control foreachrow selected" value="#grdRoba">
															<action type="datarun nonquery" value="~dtDeleteDetalj"/>
														</action>
														<action type="control populate" value="#grdRoba" />
														<action type="control disable" value="#btnObrisi" if="#grdRoba.rowcount==0"/>
														<action type="control enable" value="#btnObrisi" else="" />



														<action type="datarun reader" value="~dtUkupanIznos"/>
														<action type="control value" value="txtUkupno">
															<parameter value="~dtUkupanIznos.@UkupnoUplaceno" />
														</action>
													</action>
												</event>
											</button>
										</item>
									</group>
									<group padding="0" groupbordervisible="false" cols="6" rows="1" col="1" row="3">
										<item row="1" col="1" textalignmode="auto">
											<labeledit name="lblUkupno" value="Ukupan uplaćen iznos (avans + godišnje uplate):"/>
										</item>
										<item caption="" row="1" col="2" textalignmode="auto">
											<textedit name="txtUkupno" value="~dtUkupanIznos.@UkupnoUplaceno" format="n2" readonly="true"/>
										</item>
										<!-- <item caption="" row="1" col="3" textalignmode="auto">
											<labeledit name="lblIznosSPDV" value="Iznos s PDV-om:"/>
										</item>
										<item caption="" row="1" col="4" textalignmode="auto">
											<textedit name="txtIznosSPDV" value="~dtIznos.@IznosKn" format="n2" enabled="false"/>
										</item> -->
									</group>
								</group>
							</tabs>
						</group>
					</group>
					<tabs row="1" col="1" padding="4">
						<group caption="Osnovno NDA" name="tabOsnovno" cols="3" rows="15">
							<part name="UgovoriNDAform" path="prtUgovoriNDA.xml" />
						</group>
					</tabs>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="Global.~dtEdit" if="$PosUgovoriglaId!=null"/>
						<action type="datarun scalar" value="Global.~dtAdd" else="">
							<parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" />
						</action>
						<!-- <action type="control populate" value="parent.#grdMaster" /> -->
						<action type="form close" />
					</event>
				</button>
				<!-- <button name="btnPrint" caption="ISPIŠI" dataname="~dtPrint" displayfield="Opis">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtSpremi" />
						<action type="control print" value="parent.#grdGlava">
							<action type="print template" value="#btnPrint.@Template">
								<parameter name="id" value="$PosUgovoriGlaId" />
							</action>
						</action>
					</event>
				</button> -->
				<button name="btnOdustani" caption="ZATVORI" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_PosUgovoriGla_Edit" name="dtSpremi">
				<parameter name="@ID" value="$PosUgovoriglaId" />
				<parameter name="@PosUgovoriVrsteId" value="#cmbVrstaUgovora"/>
				<parameter name="@Aneks" value="#txtAneks"/>
				<parameter name="@DatumUgovora" value="#datDatumUgovora"/>
				<parameter name="@UgovorVrijediDo" value="#datDatumVrijediDo"/>
				<parameter name="@OvlastenaOsoba" value="#txtOvlastenaOsoba"/>
				<parameter name="@KreditniLimit" value="#txtKreditniLimit"/>
				<parameter name="@Odgoda" value="#txtOdgoda"/>
				<parameter name="@Rabat" value="#txtRabat"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@Zaduznica" value="#txtZaduznica"/>
				<parameter name="@OvlastenaOsobaId" value="#srcOvlastenaOsobaTrazilica"/>
				<parameter name="@AutorskoPravo" value="#txtAutorsko"/>
				<parameter name="@ValuteId" value="#cmbValuta"/>
				<parameter name="@AvansUplaceni" value="#txtAvansUplaceni"/>
				<!-- <parameter name="@AvansUplaceniGodisnji" value="#txtZaduznica"/> -->
				<parameter name="@Naslov" value="#txtNaslov"/>
				<!-- <parameter name="@RobaId" value="#txtNaslov"/> -->
			</data>
			<data command="spProd_PosUgovoriDet_Delete" name="dtDeleteDetalj">
				<parameter name="@PosUgovoriDetId" value="#grdRoba.@PosUgovoriDetId" />
				<parameter name="@PosUgovoriGlaId" value="#grdRoba.@PosUgovoriGlaId" />
				<!-- <parameter name="@robaId" value="#grdRobaPovezi.@robaId" /> -->
			</data>
			<data command="spProd_PosUgovoriDet_Insert" name="dtInsertDetalj">
				<parameter name="@PosUgovoriGlaId" value="$PosUgovoriGlaId" />
				<parameter name="@AvansUplaceniGodisnji" value="#txtAvansUplaceniGodisnji" />
				<parameter name="@AvansGodina" value="#txtAvansGodina" />
			</data>
			<!-- <data command="spProd_PosUgovori_RobaUpdateDetLn" name="dtUpdateDetLN">
				<parameter name="@PosUgovoriDetId" value="$NewDetiId" />
			</data> -->
			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba" />
				<parameter name="@Uvjet" value="#srcRoba.text" />
				<parameter name="@PokaziVPCijene" value="1" />
				<parameter name="@PokaziNabCijene" value="1" />
				<parameter name="@Retired" value="0" />
				<parameter name="@Prikazi_Dodatno" value="1" />
				<parameter name="@PokaziStanje" value="1" />
			</data>

			<data command="spProd_PosUgovori_UkupnoUplaceno" name="dtUkupanIznos">
				<parameter name="@id" value="$PosUgovoriGlaId" />
			</data>

		</datalist>
	</form>
</root>