<root>
	<form name="frmPromijeniStatus" caption="{$Naslov}" width="250" height="350" >
		<event type="init">
			<action type="variable value">
				<parameter name="Naslov" value="$NaslovTekst"/>
			</action>
		</event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="2" >
				<item col="1" row="1" caption="Jeste li sigurni da želite promijeniti status?">
					<!-- TODO: ne radi na edit -->
					<comboedit name="cmbStatusi" valuefield="StatusiId" displayfield="Korak" dataname="Global.dtStatusi" allownull="false"/> 
				</item>			
				<item caption="Napomena:" col="1" row="2">
					<memoedit name="txtNapomena" entermovenextcontrol="true" />
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<!-- <action type="message" value="parent.#grdGlava.@FaktureId" /> -->
						<action if="parent.$FakInsert!=0&amp;&amp;$ZakljucakIzForme==0">
							<action type="control foreachrow selected" value="parent.#grdGlava" >
								<action type="datarun nonquery" value="global.~dtStatusiAzur" if="global.$ZakljucakInd==1"/>
							</action>
						</action>
						<action else="">
							<action type="datarun nonquery" value="global.~dtStatusiAzurIzForme" if="global.$ZakljucakInd==1"/>
						</action>
						<action type="datarun nonquery" value="global.~dtStatusiAzurVrati" if="global.$ZakljucakInd!=1"/>
						<!--<action type="control populate" value="parent.#grdGlava" >
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$ProPonGlaId" />
							</action>
						</action> -->
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>		
	</form>
</root>