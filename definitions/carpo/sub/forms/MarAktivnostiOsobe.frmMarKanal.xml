<root version="8.0.0.2">
	<form name="frmMarKanal" caption="Odabir kanala" savelayout="true" width="300" height="200" statusbar="true">
		<method name="Validator" dll="Valisend" class="Valisend.ComProvider" method="Validate" />
		<event type="shown">
			<action type="datarun reader" value="~dtGetSendId" />
			<action type="variable value">
				<parameter name="global.SendId" value="~dtGetSendId.@SendId" />
			</action>
			<action type="datarun reader" value="~dtMarKanalKod" />
			<action type="variable value">
				<parameter name="global.MarKanalKod" value="~dtMarKanalKod.@Kod" />
			</action>
		</event>
		<layout>
			<group cols="1" rows="1" backgroundcolor="" groupbordervisible="true">
				<item col="1" row="1" caption="Marketing kanal:" highlight="false">
					<comboedit name="cmbMarKanal" valuefield="MarkanalId" dataname="~dtMarKanal" displayfield="Naziv" required="true" value="1">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtMarKanalKod" />
							<action type="variable value">
								<parameter name="global.MarKanalKod" value="~dtMarKanalKod.@Kod" />
							</action>
						</event>
					</comboedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnValidiraj" caption="ODABERI" dock="left">
					<event type="click">
						<action if="global.$MarKanalKod=='EM'||global.$MarKanalKod=='MSW'||global.$MarKanalKod=='COR'||global.$MarKanalKod=='XLS'||global.$MarKanalKod=='OLC'">
							<action type="method run" value="Validator">
								<parameter name="server" value="@@server" />
								<parameter name="datebase" value="@@database" />
								<parameter name="IDs" value="global.$SelectedIDs" />
								<parameter name="code" value="global.$MarKanalKod" />
							</action>
							<action type="variable value">
								<parameter name="global.IDs" value="##Validator.@ValidIDs" />
							</action>
							<!--
							<action type="variable value">
							<parameter name="global.Attach" value="##Validator.@AttachmentNames" />
							</action>
							-->
							<action type="datarun nonquery" value="~dtUnos">
							</action>
							<action type="datarun nonquery" value="~dtUnosValidacije">
							</action>
							<action type="variable value">
								<parameter name="global.Close" value="0" />
							</action>
							<!--
							<action type="datarun reader" value="~dtMarAktSendId" />
							<action type="variable value">
							<parameter name="global.MarAktSendId" value="~dtMarAktSendId.@idniz" />
							</action>
							-->
							<action type="form close" />
						</action>
						<action else="">
							<action type="datarun nonquery" value="~dtUnos">
							</action>
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="variable value">
							<parameter name="global.Close" value="1" />
						</action>
						<action type="variable value">
							<parameter name="global.IDs" value="-1" />
						</action>
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarKanalQuery" name="dtMarKanal">
				<parameter name="@Action" value="3" />
				<parameter name="@Id" value="null" />
			</data>
			<data command="spMarKanalQuery" name="dtMarKanalKod">
				<parameter name="@Action" value="4" />
				<parameter name="@Id" value="#cmbMarKanal" />
			</data>
			<data command="spMarAktSendAzur" name="dtUnos">
				<parameter name="@Action" value="0" />
				<parameter name="@IDs" value="global.$SelectedIDs" />
				<parameter name="@MarKanalId" value="#cmbMarKanal" />
				<parameter name="@OperateriId" value="@@operateriid" />
				<parameter name="@SendId" value="global.$SendId" />
			</data>
			<data command="spMarAktSendAzur" name="dtUnosValidacije">
				<parameter name="@Action" value="3" />
				<parameter name="@IDs" value="global.$IDs" />
				<parameter name="@MarKanalId" value="#cmbMarKanal" />
				<parameter name="@SendId" value="global.$SendId" />
			</data>
			<!--
			<data command="spMarAktSendAzur" name="dtMarAktSendId">
			<parameter name="@Action" value="4" />
			<parameter name="@IDs" value="global.$IDs" />
			<parameter name="@MarKanalId" value="#cmbMarKanal" />
			<parameter name="@SendId" value="global.SendId" />
			</data>
			-->
			<data command="spMarAktEmailQuery" name="dtGetSendId">
				<parameter name="@Action" value="3" />
			</data>
		</datalist>
	</form>
</root>
