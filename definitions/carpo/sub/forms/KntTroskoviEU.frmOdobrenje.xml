<root version="1.0.0.1">
<!-- u layout formi ne mora biti type master -->
<!-- pozivanje frome iz drugog xmla paziti na ime forme -->
	<form name="frmOdobrenje" caption="Odobrenje troškova" statusbar="false">

		<event type="init">
			<action type="datarun reader"  value="~dtGetDataOdobrenje" />
			<!-- <action type="message"  value="~dtGetDataOdobrenje.@partneriid"/> -->
										
			
		</event>
	
		<event type="load">
			<!-- <action type="datarun reader"  value="~dtGetDataOdobrenje" /> -->
			
					<!-- <action type="variable value"> -->
							<!-- <parameter name="~dtGetDataOdobrenje.@KntPlanOtplateKrOdobrenjeaId" value="#KntPlanOtplateKrOdobrenjeaId" type="int"/> -->
					<!-- </action> -->
					<!-- <action type="message"  value="~dtGetDataOdobrenje.@partneriid"/> -->
					<action type="control value"  value="#txtKonto" >
							<parameter value="~dtGetDataOdobrenje.@Konto" readonly="true"></parameter>
					</action> 	
					
					<action type="control value"  value="#txtDimenzije" >
							<parameter value="~dtGetDataOdobrenje.@Dimenzija" readonly="true"></parameter>
					</action> 

					<action type="control value"  value="#curPrijavljenIznos" >
							<parameter value="~dtGetDataOdobrenje.@PrijavljenIznos" readonly="true"></parameter>
					</action> 	

					<action type="control value"  value="#txtBespovratnoPosto">
							<parameter value="100"></parameter>
					</action> 	
					<action type="control value"  value="#curBespovratniIznos">
							<parameter value="~dtGetDataOdobrenje.@PrijavljenIznos"></parameter>
					</action> 
					
					<action type="control value"  value="#txtUcescePosto">
							<parameter value="0"></parameter>
					</action> 	
					<action type="control value"  value="#curUcesceIznos">
							<parameter value="0"></parameter>
					</action> 
					
					<action type="control value"  value="#txtNeprihvatljivoPosto">
							<parameter value="0"></parameter>
					</action> 	
					<action type="control value"  value="#curNeprihvatljivTrosak">
							<parameter value="0"></parameter>
					</action> 
					
					<action type="control value"  value="#txtIzuzetiPosto">
							<parameter value="0"></parameter>
					</action> 	
					<action type="control value"  value="#curIzuzetiTrosak">
							<parameter value="0"></parameter>
					</action> 
					
					<action type="control value" value="#datDatumOdobrenja">
						<parameter value="~dtGetDataOdobrenje.@DatumOdobrenja" />
					</action>

					<action type="control value"  value="#txtDokumentOdobrenja" >
							<parameter value="~dtGetDataOdobrenje.@DokumentOdobrenja" ></parameter>
					</action> 
					
					<!-- <action type="control value"  value="#curukupno"> -->
							<!-- <parameter value="0"></parameter> -->
					<!-- </action>  -->
					
					
 <!-- <action type="message"  value="~dtGetDataOdobrenje.@Konto"/>					  -->
			
		</event>
		
		<!-- <event type="shown"> -->
							<!-- <action type="control value"  value="#srcPartner"> -->
							<!-- <parameter value="~dtGetDataOdobrenje.@PartneriId" text="~dtGetDataOdobrenje.@Partner" ></parameter> -->
					<!-- </action>  -->
				<!-- </event> -->

	
	<layout textposition="left">
			<group cols="1" rows="5" > 
			<!-- <group cols="1" rows="13" >  -->
				
				<group col="1" row="1" rows="1" cols="2">
				
						
				
					<item col="1" row="1" caption="Konto:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtKonto" valuefield="Konto" displayfield="Naziv" dataname="~dtGetDataOdobrenje.@Konto" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
					
					<item col="2" row="1"  caption="Prijavljen iznos:" fontsizedelta="2" readonly="true">
						<textedit name="curPrijavljenIznos" value="0" format="n2" readonly="true"  textposition="right">
						</textedit>
					</item>
				</group>
				
					
					<item col="1" row="2" caption="Dimenzije:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtDimenzije" valuefield="Dimenzija" displayfield="Naziv" dataname="~dtGetDataOdobrenje.@Dimenzija" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
				
				
				<group col="1" row="3"  cols="2" rows="5" >
					
						
					
					<item col="1" row="1"  caption="Bespovratna sredstva %:" fontsizedelta="2" >
					<textedit name="txtBespovratnoPosto" value="0" format="n2"  textposition="right">
								<event type="leave">	
										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetBespovratno" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curBespovratniIznos">
											<parameter  value="~dtGetBespovratno.@curBespovratniIznos" />
										</action>
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#txtUkupnoPosto">
											<parameter  value="~dtGetUkupno.@UkupnoPosto" />
										</action>
<!-- <action type="message"  value="~dtGetUkupno.@UkupnoPosto"/>										 -->
																				
								</event>
								
							</textedit>
							
					</item>
					
					
					<item col="2" row="1"  caption="Bespovratna sredstva iznos:" fontsizedelta="2" >
							<textedit name="curBespovratniIznos" value="0" format="n2" textposition="right" >
								<event type="leave">	
										
										<!-- <action type="datarun reader" value="#curUkupnoIznos"> -->
											<!-- <parameter  value="~dtGetUkupno.@curUkupnoIznos" /> -->
										<!-- </action> -->
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#curUkupnoIznos">
											<parameter  value="~dtGetUkupno.@UkupnoIznos" />
										</action>
																				
								</event>
							</textedit>
						
					</item>	
					
					
					<item col="1" row="2"  caption="Učešće %:" fontsizedelta="2" >
					<textedit name="txtUcescePosto" value="0" format="n2"  textposition="right">
								<event type="leave">	
										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetUcesce" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curUcesceIznos">
											<parameter  value="~dtGetUcesce.@curUcesceIznos" />
										</action>	
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#txtUkupnoPosto">
											<parameter  value="~dtGetUkupno.@UkupnoPosto" />
										</action>
								</event>
							</textedit>
							
					</item>
					
					<item col="2" row="2"  caption="Učešće iznos:" fontsizedelta="2" >
							<textedit name="curUcesceIznos" value="0" format="n2" textposition="right" >
								<event type="leave">	
										
										<!-- <action type="datarun reader" value="#curUkupnoIznos"> -->
											<!-- <parameter  value="~dtGetUkupno.@curUkupnoIznos" /> -->
										<!-- </action> -->
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#curUkupnoIznos">
											<parameter  value="~dtGetUkupno.@UkupnoIznos" />
										</action>
																				
								</event>		
							</textedit>
						
					</item>	
					
					
					<item col="1" row="3"  caption="Neprihvatljiv trošak %:" fontsizedelta="2" >
					<textedit name="txtNeprihvatljivoPosto" value="0" format="n2"  textposition="right">
								<event type="leave">	
										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetNeprihvatljivo" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curNeprihvatljivTrosak">
											<parameter  value="~dtGetNeprihvatljivo.@curNeprihvatljivTrosak" />
										</action>
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#txtUkupnoPosto">
											<parameter  value="~dtGetUkupno.@UkupnoPosto" />
										</action>
								</event>
							</textedit>
							
					</item>
					
					<item col="2" row="3"  caption="Neprihvatljiv iznos:" fontsizedelta="2" >
							<textedit name="curNeprihvatljivTrosak" value="0" format="n2" textposition="right" >
								<event type="leave">	
										
										<!-- <action type="datarun reader" value="#curUkupnoIznos"> -->
											<!-- <parameter  value="~dtGetUkupno.@curUkupnoIznos" /> -->
										<!-- </action> -->
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#curUkupnoIznos">
											<parameter  value="~dtGetUkupno.@UkupnoIznos" />
										</action>
																				
								</event>		
							</textedit>
						
					</item>	
					
					
					<item col="1" row="4"  caption="Izuzeti trošak %:" fontsizedelta="2" >
					<textedit name="txtIzuzetiPosto" value="0" format="n2"  textposition="right">
								<event type="leave">	
										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetIzuzeto" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curIzuzetiTrosak">
											<parameter  value="~dtGetIzuzeto.@curIzuzetiTrosak" />
										</action>
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#txtUkupnoPosto">
											<parameter  value="~dtGetUkupno.@UkupnoPosto" />
										</action>
								</event>
							</textedit>
							
					</item>
					
					<item col="2" row="4"  caption="Izuzeti trošak iznos:" fontsizedelta="2" >
							<textedit name="curIzuzetiTrosak" value="0" format="n2" textposition="right" >
								<event type="leave">	
										
										<!-- <action type="datarun reader" value="#curUkupnoIznos"> -->
											<!-- <parameter  value="~dtGetUkupno.@curUkupnoIznos" /> -->
										<!-- </action> -->
										<action type="datarun reader" value="~dtGetUkupno"/>	
										<action type="control value" value="#curUkupnoIznos">
											<parameter  value="~dtGetUkupno.@UkupnoIznos" />
										</action>
																				
								</event>		
							</textedit>
						
					</item>	
					
					
					
					<item col="1" row="5"  caption="UKUPNO %:" fontsizedelta="2" >
					<textedit name="txtUkupnoPosto" value="0" format="n2"  readonly="true" textposition="right">
								<event type="leave">	
										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetUkupno" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curUkupno">
											<parameter  value="~dtGetIzuzeto.@curUkupno" />
										</action>										
								</event>
							</textedit>
							
					</item>
					
					<item col="2" row="5"  caption="UKUPNO iznos:" fontsizedelta="2" >
							<textedit name="curUkupnoIznos" value="0" format="n2" readonly="true" textposition="right" >
		
							</textedit>
						
					</item>	
					
									
				</group>	
					<!-- <item col="4" row="1"  caption="" fontsizedelta="2" > -->
							
					<!-- </item>	 -->

					<item col="1" row="4" caption="Datum Odobrenja:" fontsizedelta="1" >
						<dateedit  name="datDatumOdobrenja" fontsizedelta="1"   value="now" textposition="right">
						</dateedit>
					</item>	

					<item col="2" row="5" caption="Dokument Odobrenja:" fontsizedelta="1" >
						<textedit  name="txtDokumentOdobrenja" fontsizedelta="1"  value="" textposition="left">
						</textedit>
					</item>	
								
		
			</group>
			
		</layout>
	
	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">			
				<event type="click">
					<action type ="datarun scalar" value="~datSpremiOdobrenje">
						<parameter name="parent.$KntPrometId" ></parameter>
					</action>
					<!-- zatvaranje forme -->
					<action type="form close" value="frmOdobrenje"> </action>	
										
					
				</event>
				
				
			</button>

				<button  name="btnOdustani" caption="Odustani" type="cancel">
				<!-- <event type="click"> -->
						<!-- <action type ="control value" value="global.@KntPrometId"> -->
									<!-- <parameter name="parent.$KntPrometId" ></parameter> -->
						<!-- </action> -->
				<!-- </event> -->
					
			</button>
		</buttons>
	</panelbuttons>
	<!-- dohvat podataka -->
	<datalist>

		<data name="dtGetDataOdobrenje" command="spCKntTroskoviEUQuery">
			 <parameter name="@action" value="17"></parameter> 
			 <parameter name="@KntPrometId" value="global.$KntPrometId"></parameter> 

		</data>
		
		<data name="datSpremiOdobrenje" command="spCKntTroskoviEUAzur">
			 <parameter name="@action" value="Odobrenje"></parameter> 
			 <parameter name="@KntPrometId" value="global.$KntPrometId"></parameter> 
			 <parameter name="@BespovratniIznos" value="#curBespovratniIznos"></parameter>
			 <parameter name="@UcesceIznos" value="#curUcesceIznos"></parameter>			 
			 <parameter name="@NeprihvatljivTrosak" value="#curNeprihvatljivTrosak"></parameter>			 
			 <parameter name="@DatumOdobrenja" value="#datDatumOdobrenja"></parameter> 
			 <parameter name="@DokumentOdobrenja" value="#txtDokumentOdobrenja"></parameter> 
			 <parameter name="@PrijavljenIznos" value="#curPrijavljenIznos"></parameter>			 
			 <parameter name="@IzuzetiTrosak" value="#curIzuzetiTrosak"></parameter>			 
			 
		</data>

		
	
		<data command="spCKntTroskoviEUOdobrenjeIzracun" name="dtGetBespovratno">
				<parameter name="@Action" value="BespovratnoPosto" />
				<parameter name="@BespovratnoPosto" value="#txtBespovratnoPosto" />
				<parameter name="@PrijavljenIznos" value="#curPrijavljenIznos" />
		
		</data>
		
		<data command="spCKntTroskoviEUOdobrenjeIzracun" name="dtGetUcesce">
				<parameter name="@Action" value="UcescePosto" />
				<parameter name="@UcescePosto" value="#txtUcescePosto" />
				<parameter name="@PrijavljenIznos" value="#curPrijavljenIznos" />		
		</data>
		
		<data command="spCKntTroskoviEUOdobrenjeIzracun" name="dtGetNeprihvatljivo">
				<parameter name="@Action" value="NeprihvatljivoPosto" />
				<parameter name="@NeprihvatljivoPosto" value="#txtNeprihvatljivoPosto" />
				<parameter name="@PrijavljenIznos" value="#curPrijavljenIznos" />		
		</data>
		
		<data command="spCKntTroskoviEUOdobrenjeIzracun" name="dtGetIzuzeto">
				<parameter name="@Action" value="IzuzetiPosto" />
				<parameter name="@IzuzetiPosto" value="#txtIzuzetiPosto" />
				<parameter name="@PrijavljenIznos" value="#curPrijavljenIznos" />		
		</data>
		
		<data command="spCKntTroskoviEUOdobrenjeIzracun" name="dtGetUkupno">
				<parameter name="@Action" value="Ukupno" />
				<parameter name="@BespovratnoPosto" value="#txtBespovratnoPosto" />
				<parameter name="@UcescePosto" value="#txtUcescePosto" />
				<parameter name="@NeprihvatljivoPosto" value="#txtNeprihvatljivoPosto" />
				<parameter name="@IzuzetiPosto" value="#txtIzuzetiPosto" />

				<parameter name="@BespovratniIznos" value="#curBespovratniIznos"></parameter>
				<parameter name="@UcesceIznos" value="#curUcesceIznos"></parameter>			 
				<parameter name="@NeprihvatljivTrosak" value="#curNeprihvatljivTrosak"></parameter>			 
				<parameter name="@PrijavljenIznos" value="#curPrijavljenIznos"></parameter>			 
				<parameter name="@IzuzetiTrosak" value="#curIzuzetiTrosak"></parameter>
					
		</data>
		
		
				<!-- <data command="spCKntTroskoviEUIzracun" name="dtGetPostotakOdobrenje"> -->
				<!-- <parameter name="@Action" value="IznosUnos" /> -->
				<!-- <parameter name="@PrijavljenIznos" value="#curPrijavljenIznos" /> -->
				<!-- <parameter name="@IznosOdobrenjePromjena" value="#curOdobrenjeIznos" />			 -->
				
		<!-- </data> -->
		
		
	</datalist>
	</form>
</root>