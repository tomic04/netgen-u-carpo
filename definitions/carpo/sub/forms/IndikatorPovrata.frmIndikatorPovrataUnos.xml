<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmIndikatorPovrataUnos" caption="Unos" width="400" height="300">		
		<layout>
		
				
				<group cols="3" rows="5" row="1" col="1">
					<item col="1" row="2" caption="Roba:" colspan="3">
						<searchedit name="txtRoba" fontsizedelta="0" fontbold="True" fieldtext="NazivId" fieldvalue="RobaId"  
						dataname="~dtRoba" netgenfields="true">
						</searchedit>
					</item>
					<item col="1" row="1" caption="Partner:" colspan="3">
						<searchedit name="partner" fieldtext="NazivId" fieldvalue="partneriid"  fontbold="true" required="true" 
						dataname="~dtPartneri" netgenfields="true">
						</searchedit>	
					</item>
				
                    <item row="3" col="1">
                        <radioedit name="rdoZabrana" caption="Zabrana" value="true">
                            <event type="checkchanged">	
                            </event>
                        </radioedit>
                     </item>

                     <item row="3" col="2" colspan="2" caption="Org.shema:">
                     	 <comboedit name="cmbZabLok" dataname="~dtViPogoni" valuefield="OrgShemaID" displayfield="Naziv" >
                     
                     	 </comboedit>
                    </item>
                    
                    <item row="4" col="1">
                        <radioedit name="rdoCjelobrojni" caption="Cjelobrojni" value="false" >
                            <event type="checkedchanged">
                    			<action type="control value" value="cmbZabLok">
                            		<parameter value="null" type="int" if="#rdoZabrana==false"/>
                            	</action>        	
                            	<action type="control disable" value="#cmbZabLok" if="#rdoZabrana==false" />
								<action type="control enable" value="#cmbZabLok" else="" />	

                            </event>
                        </radioedit>
                    </item>				
                    <item row="5" col="1">
                        <radioedit name="rdoPosebni" caption="Posebni" value="false" >
                            <event type="checkedchanged">
                            	<action type="control disable" value="#cmbZabLok" if="#rdoZabrana==false" />
								<action type="control enable" value="#cmbZabLok" else="" />	
								<action type="control value" value="cmbZabLok">
                            		<parameter value="null" type="int" if="#rdoZabrana==false"/>
                            	</action>
                            </event>
                        </radioedit>
                    </item>						
				</group> 
		</layout>
		<panelbuttons>
			<buttons>
				<button name="Spremi" caption="Spremi" type="add" dock="left">
					<event type="click">
						<action type="datarun nonquery" value="~dtProPovratIndInsert">
							<parameter name="orgshema" value="#orgshema" />
						</action>
						<action type="form close"/>

					</event>
				</button>
				<button name="Odustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>		
			</buttons>
		</panelbuttons>
		<datalist>
 			<data command="spProPovratIndInsert" name="dtProPovratIndInsert">
				<parameter name="@partner" value="#partner"></parameter>
				<parameter name="@roba" value="#txtRoba"></parameter>
				<parameter name="@zabrana" value="#rdoZabrana"></parameter>
				<parameter name="@cjelobrojni" value="#rdoCjelobrojni"></parameter>
				<parameter name="@posebni" value="#rdoPosebni"></parameter>
				<parameter name="@orgshema" value="#cmbZabLok" if="#rdoZabrana==true"></parameter>
				<parameter name="@orgshema" value="null" if="#rdoZabrana==false"></parameter>
			</data>
			<data command="spTraziRoba" name="dtRoba">
			  <parameter name="@action" value="Roba"/>
			  <parameter name="@Uvjet" value="#txtRoba.text"/>
			  <parameter name="@PokaziVPCijene" value="0"/>
			  <parameter name="@PokaziNabCijene" value="0"/>
			  <parameter name="@Retired" value="0"/>
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				  <parameter name="@Action" value="Partneri" />
				  <parameter name="@Uvjet" value="#partner.text" />
			</data>
			<data command="select orgshemaid, naziv, sortkey, oznaka from viPogoni" name="dtViPogoni" type="text" />
		</datalist>
	</form>
</root>


<!-- Z.M. 13.03.2018. trebam izmjeniti storu u ViPogoni za punjenje padajućeg izbornika kod zabrane 
	 Vratiti na viPogoni pogled na kratice
	 
	 Z.M. 14.03.2018.

	 popis stora:

	spProPovratIndQuery - stora za čitanje podataka (edited)
	spProPovratIndInsert - stora za insert podataka (edited)
	spProPovratIndDelete - stora za brisanje podataka (netaknuto)
	spProPovratIndUpdate - za edit podataka (nova)
	spTraziRoba - postoji (netaknuto)
	spTraziPartneri - postoji(Netaknuto)


	viPogoni - prepravljeno za potrebe testiranja vratiti na inicijalno

- povezao orgshemaid u propovratiid sa orgshemaid u tablici orgshema

	 -->