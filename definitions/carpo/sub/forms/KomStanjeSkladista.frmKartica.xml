<root>
    <form name="frmKartica" caption="Kartica artikla: {parent.#grdStavke.@Sifra} - {parent.#grdStavke.@Naziv} (JM: {parent.#grdStavke.@JM}) {$varKontingent}" fixedsize="false" width="950" height="570">
		<event type="oninit">
			<action type="variable value">
				<parameter name="Order" value="global.$KomStSkl_Order" type="int" />
			</action>				
		</event>
		<event type="onload">	
			<action type="control populate" value="#grdKartica"></action>
			<action type="control value" value="#chkRedoslijed">
				<parameter value="$Order"/>
			</action>			
		</event>	
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="false">
				<group cols="1" rows="2" groupbordervisible="false">
						<rowsdefinition>
							<row size="44" position="2" />
						</rowsdefinition>					
					<item row="1" col="1">
						<grid name="grdKartica" async="true" dataname="dtGrid" multiselect="true" key="ind">
							<part name="partKarticaGrid" path="prtKomStanjeSkladista.xml" />
							<event type="focusedrowchanged">							
								<action type="control enable" value="#btnPrikaziDok" if="#grdKartica.@PrintDokId!=0" />
								<action type="control disable" value="#btnPrikaziDok" else="" />
								<action type="control enable" value="#btnIspisiDok" if="#grdKartica.@PrintDokId!=0&amp;&amp;#grdKartica.@Ind_Template!=0" />
								<action type="control disable" value="#btnIspisiDok" else="" />								
							</event>
							<print caption="Kartica artikla: {parent.#grdStavke.@Sifra} - {parent.#grdStavke.@Naziv} (JM: {parent.#grdStavke.@JM}) {$varKontingent}" header="Od {parent.#datDatumOd::dd.MM.yyyy.} do {parent.#datDatumDo::dd.MM.yyyy.}\nSkladište: {parent.#grdStavke.@Skladiste}" subheader="" captionalign="" headeralign="" subheaderalign=""/>							
						</grid>
					</item>
					<group cols="5" rows="1" row="2" col="1" groupbordervisible="false">
				        <columnsdefinition>
							<column size="100" position="1" />
							<column size="100" position="2" />
							<column size="100" position="3" />
							<column size="100" position="4" />
							<column size="100" position="5" />
						</columnsdefinition>
						<item row="1" col="2" textvisible="False">
							<button name="btnIspisiKarticu" caption="Ispiši karticu">
								<event type="click">
									 <action type="control printcontrol" value="#grdKartica"/>	
								</event>
							</button>
						</item>	
						<item row="1" col="3" textvisible="False">
							<button name="btnIspisiDok" caption="Is&amp;piši dokument" dataname="~dtPrint" displayfield="Opis">
								<event type="click">
									<action type="control print" value="#grdKartica">
										<action type="print template" value="#btnIspisiDok.@Template">
											<parameter name="id" value="#grdKartica.@printdokid" />
										</action>
									</action>
								</event>
							</button>
						</item>						
						<item row="1" col="4" textvisible="False">
							<button name="btnPrikaziDok" caption="Prikaži dokument">
								<event type="click">
									<action type="form open" value="frmPrikazDok">
										<!-- <parameter name="DatumOd" value="#datDatumOd" /> -->
									</action>								
								</event>
							</button>
						</item>	
						<item row="1" col="5" caption="" textvisible="False" highlight="false">
							<checkedit caption="Kartica po redoslijedu unosa" name="chkRedoslijed" >
								<event type="checkedchanged">
									<action type="variable value" if="#chkRedoslijed==False">
										<parameter name="Order" value="0" type="int" />
									</action>	
									<action type="variable value" if="#chkRedoslijed==True">
										<parameter name="Order" value="1" type="int" />
									</action>									
									<action type="control populate" value="#grdKartica"></action>									
								</event>								
							</checkedit>
						</item>							
						<item row="1" col="1" textvisible="False">
							<button caption="Zatvori" type="cancel" dock="right" />
						</item>							
					</group>
				 </group>
            </group>
        </layout>
        <datalist>
            <data command="spSktKomercKarticaQueryNG" name="dtGrid">
                <parameter name="@Action" value="0" />
                <parameter name="@SkladisteId" value="$SkladisteId" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@DatumOd" value="$DatumOd" />
				<parameter name="@DatumDo" value="$DatumDo" />
				<parameter name="@KKvalGlaId" value="$KKvalGlaId" />
				<parameter name="@kontigent" value="$Kontingent" />
				<parameter name="@faktor" value="$Faktor" />
				<parameter name="@order" value="$Order" />
            </data>
			<data command="spKomercStanjeSklad_Ispis" name="dtPrint">
				<parameter name="@vrstadokid" value="#grdKartica.@vrstadokid" type="int"/>
				<parameter name="@dokid" value="#grdKartica.@printdokid" type="int"/>
			</data>				
        </datalist>
    </form>
</root>