<root>
	<form name="frmPregledPoslanih" caption="Pregled poslanih poruka za: {$Osoba}; {$Partner} ">
		<event type="oninit">
			<action type="datarun reader" value="~dtGrid" />
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="1" cols="1">
				<item col="1" row="1" caption="">
					<grid name="grdPregledPoslanih" key="OsobeId" dataname="dtGrid" bestfitonrefresh="true" autopopulate="true" groupsummarystyle="inline">
						<fields inherited="true">
							<field name="DatumSlanja" caption="Datum Slanja" format="dd.MM.yyyy HH:mm" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPregled" caption="Pregled poruke" dock="left">
					<event type="click">
						<action type="form open" value="frmEmail">
							<parameter name="MarAktEmailId" value="#grdPregledPoslanih.@MarAktEmailId" />
							<parameter name="Indikator" value="1" />
							<parameter name="Caption" value="E-mail poruka" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktEmailQuery" name="dtGrid" if="$Indikator==1">
				<parameter name="@action" value="6" />
				<parameter name="@MarAktDetId" value="$MarAktDetId" />
			</data>
			<data command="spMarAktEmailQuery" name="dtGrid" if="$Indikator==2">
				<parameter name="@action" value="8" />
				<parameter name="@OsobeId" value="$OsobeId" />
				<parameter name="@PartneriId" value="$PartneriId" />
			</data>
		</datalist>
		<form name="frmEmail" path="frmEmail.xml" />
	</form>
</root>
