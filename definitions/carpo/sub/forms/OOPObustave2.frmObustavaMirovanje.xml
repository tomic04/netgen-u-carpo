<root>

  <form name="frmObustavaMirovanje" caption="$caption" width="400" height="400" fixedsize="true" saveformsize="false" >
    <event type="load">
      <action type="control populate" value="#grdMirovanje" >     </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdMirovanje" key="OOPObustaveMirovanjeId" dataname="~dtGridMirovanje" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false">
            
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="form open" value="frmObustavaMirovanjeEdit">
              <parameter name="OOPObustaveMirovanjeId" value="0"/>
              <parameter name="OOPObustaveDetId" value="$OOPObustaveDetId"/>
              <parameter name="caption" value="Unos mirovanja"/>
            </action>
            <action type="control populate keepfocus" value="#grdMirovanje"/>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmObustavaMirovanjeEdit">
              <parameter name="OOPObustaveMirovanjeId" value="#grdMirovanje.@OOPObustaveMirovanjeId"/>
              <parameter name="caption" value="Izmjena mirovanja"/>
            </action>
            <action type="control populate keepfocus" value="#grdMirovanje"/>
          </event>
        </button>
        <button name="btnBrisi" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmObustavaMirovanjeBrisi">
              <parameter name="OOPObustaveMirovanjeId" value="#grdMirovanje.@OOPObustaveMirovanjeId"/>
              <parameter name="caption" value="Brisanje valute"/>
            </action>
            <action type="control populate" value="#grdMirovanje"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObustaveMirovanjeQueryCP" name="dtGridMirovanje">
        <parameter name="@action" value="grid" type="string"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
      </data>
    </datalist>
  </form>

  <form name="frmObustavaMirovanjeEdit" caption="$caption" width="400" height="350" fixedsize="true" saveformsize="false">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$OOPObustaveMirovanjeId!=0" />
    </event>


    <layout>
      <group cols="2" rows="2" groupbordervisible="false" alignmode="local">


        <item col="1" row="1"  textposition="top" caption="Mjesec početka:" highlight="false" >
          <dateedit name="datMjesecPoc"  datavalue="~dtGet.@MjesecPoc" required="true" value="now"></dateedit>
        </item>
        <item col="2" row="1"  textposition="top" caption="Mjesec završetka:" highlight="false" >
          <dateedit name="datMjesecZav"  datavalue="~dtGet.@MjesecZav" required="true" value="now"></dateedit>
        </item>
        <item col="1" row="2" colspan="2"  textposition="top" caption="Napomena:" highlight="false" >
          <memoedit datavalue="~dtGet.@Napomena" name="txtNapomena" multiline="true" value=" ">
            <event type="leave">
              <action type="control value" value="#txtNapomena" if="#txtNapomena==null">
                <parameter value=" "/>
              </action>
            </event>
          </memoedit>
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$OOPObustaveMirovanjeId==0">
              <action type="datarun reader" value="~dtUnos"></action>
              <action type="form close"></action>
            </action>
            <action if="$OOPObustaveMirovanjeId!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
              <action type="form close"></action>
            </action>
          </event>
        </button>

        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObustaveMirovanjeQueryCP" name="dtGet">
        <parameter name="@action" value="dtGet" type="string"/>
        <parameter name="@OOPObustaveMirovanjeId" value="$OOPObustaveMirovanjeId" type="int"/>
      </data>

      <data command="spOOPObustaveMirovanjeAzurCP" name="dtUnos">
        <parameter name="@action" value="unos" type="string"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
        <parameter name="@MjesecPoc" value="#datMjesecPoc" type="date"/>
        <parameter name="@MjesecZav" value="#datMjesecZav" type="date"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
      </data>

      <data command="spOOPObustaveMirovanjeAzurCP" name="dtIzmjena">
        <parameter name="@action" value="izmjena" type="string"/>
        <parameter name="@OOPObustaveMirovanjeId" value="$OOPObustaveMirovanjeId" type="int"/>
        <parameter name="@MjesecPoc" value="#datMjesecPoc" type="date"/>
        <parameter name="@MjesecZav" value="#datMjesecZav" type="date"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
      </data>

    </datalist>
  </form>

  <form name="frmObustavaMirovanjeBrisi" caption ="Brisanje" saveformsize="false" width="400" height="125" fixedsize="true">
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrani zapis?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"></action>
            <action type="form close"></action>
            <action type="control populate keepfocus" value="parent.#grdMirovanje"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spOOPObustaveMirovanjeAzurCP" name="dtBrisanje">
        <parameter name="@Action" value="brisanje" />
        <parameter name="@OOPObustaveMirovanjeId" value="$OOPObustaveMirovanjeId"/>
      </data>
    </datalist>
  </form>



</root>