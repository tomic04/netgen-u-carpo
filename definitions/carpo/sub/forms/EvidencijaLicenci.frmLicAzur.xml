<root>
	<form name="frmLicAzur" caption="Ažuriranje novih licenci">
		<event type="init">
			<action type="variable value" value="global.$FormOpen">
				<parameter value="1"/>
			</action>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdLicAzur, #grdLicAzurDet"/>
		</event>
		<event type="close">
			<action type="control populate" value="parent.#grdMaster"/>
			<action type="variable value">
				<parameter name="global.FormOpen" value="0" type="int"/>
			</action>
		</event>
		<layout>
			<group rows="2" cols="1">
				<item row="1" col="1">
					<grid name="grdLicAzur" dataname="~dtMaster" caption="Ne evidentirane licence {global.$Od::dd.MM.yyyy.} - {global.$Do::dd.MM.yyyy.}" showcheckboxes="true" multiselect="true" key="suppKorisnikId" bestfitonrefresh="true">
						<fields>
							<field name="Partner" caption="Support nositelj"/>
							<field name="Partner" caption="Support korisnik"/>
							<field name="VrijednostLic" caption="Vrijednost licence"/>
							<field name="Datum"/>
							<field name="BrojJSCALs" caption="Broj JS CALs"/>
							<field name="VrstaOstCALs" caption="Vrsta Ost CALs"/>
							<field name="BrojOstCALs" caption="Broj Ost CALs"/>
							<field name="KolicinaAlt" caption="Nova količina"/>
							<field name="NovaVrstaCALs" caption="Nova vrsta CALs"/>
							<field name="Opis" editable="true"/>
							<field name="VrijednostKlijenta" caption="Vrijednost klijenta"/>
							<field name="NovaVrijednostKlijenta" caption="Nova vrijednost klijenta"/>
							<field name="Primijeni" editable="true" caption="Povećaj vrijednost klijenta" edittype="bool"/>
						</fields>
						<event type="showingeditor">
							<action type="editor allow" value="true" if="#grdLicAzur.focusedfield==Opis"/>
							<action type="editor allow" value="true" if="#grdLicAzur.focusedfield==Primijeni&amp;&amp;#grdLicAzur.@VrijednostKlijenta!=#grdLicAzur.@NovaVrijednostKlijenta"/>
						</event>
						<styles>
							<style name="fontcolor" value="green" if="#grdLicAzur.@VrijednostKlijenta!=#grdLicAzur.@NovaVrijednostKlijenta"/>
						</styles>
						<event type="doubleclick">
							<action type="form open" value="frmIzmijeni">
								<parameter name="SuppKorisnikId" value="#grdLicAzur.@SuppKorisnikId"/>
								<parameter name="Opis" value="#grdLicAzur.@Opis"/>
								<parameter name="Primijeni" value="#grdLicAzur.@Primijeni"/>
							</action>
						</event>
					</grid>
				</item>
				<item row="2" col="1">
					<grid name="grdLicAzurDet" dataname="~dtDetail" caption="Evidentirane licence {global.$Od::dd.MM.yyyy.} - {global.$Do::dd.MM.yyyy.}" showcheckboxes="true" multiselect="true" key="FakDetaljId" bestfitonrefresh="true">
						<fields>
							<field name="Partner" caption="Support nositelj"/>
							<field name="SuppKorisnik" caption="Support korisnik"/>
							<field name="VrijednostLic" caption="Vrijednost licence"/>
							<field name="Rabat" caption="Popust"/>
							<field name="Datum"/>
							<field name="BrojJSCALs" caption="Broj JS CALs"/>
							<field name="VrstaOstCALs" caption="Vrsta Ost CALs"/>
							<field name="BrojOstCALs" caption="Broj Ost CALs"/>
							<field name="KolicinaAlt" caption="Nova količina"/>
							<field name="NovaVrstaCALs" caption="Nova vrsta CALs"/>
							<field name="Opis"/>
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="Dodaj">
					<event type="click">
						<action type="control foreachrow selected" value="grdLicAzur">
							<action type="datarun nonquery" value="~dtDodaj"/>
						</action>
						<action type="control populate" value="#grdLicAzurDet, #grdLicAzur"/>
					</event>
				</button>
				<button name="btnUkloni" caption="Ukloni">
					<event type="click">
						<action type="control foreachrow selected" value="grdLicAzurDet">
							<action type="datarun nonquery" value="~dtUkloni"/>
						</action>
						<action type="control populate" value="#grdLicAzur, #grdLicAzurDet"/>
					</event>
				</button>
				<button name="btnZatvori" caption="Zatvori">
					<event type="click">
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="variable value">
							<parameter name="global.FormOpen" value="0" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni" dock="right">
					<event type="click">
						<action type="form open" value="frmIzmijeni">
							<parameter name="SuppKorisnikId" value="#grdLicAzur.@SuppKorisnikId"/>
							<parameter name="Opis" value="#grdLicAzur.@Opis"/>
							<parameter name="Primijeni" value="#grdLicAzur.@Primijeni"/>
						</action>
					</event>
				</button>
				<button name="btnFilter" caption="Filter" dock="right">
					<event type="click">
						<action type="form open" value="frmFilter"/>
						<action type="control populate" value="#grdLicAzurDet, #grdLicAzur"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtMaster" command="spSuppIzracunLicCarpo">
				<parameter name="@DatumOd" value="global.$Od"/>
				<parameter name="@DatumDo" value="global.$Do"/>
				<parameter name="@SuppKorisnikId" value="global.$Korisnik"/>
				<parameter name="@Tip" value="1"/>
			</data>
			<data name="dtDetail" command="spSuppIzracunLicCarpo">
				<parameter name="@DatumOd" value="global.$Od"/>
				<parameter name="@DatumDo" value="global.$Do"/>
				<parameter name="@SuppKorisnikId" value="global.$Korisnik"/>
				<parameter name="@Tip" value="2"/>
			</data>
			<data name="dtDodaj" command="spSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@SuppKorisnikId" value="#grdLicAzur.@SuppKorisnikId"/>
				<parameter name="@Opis" value="#grdLicAzur.@Opis"/>
				<parameter name="@BrojJSCALs" value="#grdLicAzur.@BrojJSCALs"/>
				<parameter name="@BrojOstCALs" value="#grdLicAzur.@BrojOstCALs"/>
				<parameter name="@VrstaOstCALs" value="#grdLicAzur.@VrstaOstCALs"/>
				<parameter name="@VrijednostLic" value="#grdLicAzur.@VrijednostLic"/>
				<parameter name="@Popust" value="#grdLicAzur.@Rabat"/>
				<parameter name="@OstaliCALs" value="#grdLicAzur.@OstaliCALs"/>
				<parameter name="@FakDetaljId" value="#grdLicAzur.@FakDetaljId"/>
				<parameter name="@FakDatumDok" value="#grdLicAzur.@Datum"/>
				<parameter name="@changedVrKlijenta" value="#grdLicAzur.@Primijeni"/>
				<parameter name="@Kolicina" value="#grdLicAzur.@KolicinaAlt"/>
				<parameter name="@suppLicVrstaId" value="#grdLicAzur.@suppLicVrstaId"/>
				<parameter name="@OperaterId" value="@@operateriid"/>
			</data>
			<data name="dtUkloni" command="spSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@FakDetaljId" value="#grdLicAzurDet.@FakDetaljId"/>
			</data>
		</datalist>
	</form>
</root>