<root>
	<form name="frmUgovorAzur" caption="Ugovori Supporta">
		<event type="init">
			<action type="variable value">
				<parameter name="global.Datum" value="null" type="datetime"/>
				<parameter name="global.Init" value="null" type="int"/>
			</action>
			<action type="form open" value="frmFilter"/>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdUgovorAzur"/>
		</event>
		<event type="close">
			<action type="control populate" value="parent.#grdMaster, parent.#grdDetail"/>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<grid name="grdUgovorAzur" dataname="~dtMaster" caption="Ugovori Supporta" showcheckboxes="true" multiselect="true" key="suppKorisnikId" bestfitonrefresh="true">
						<fields>
							<field name="Naziv" caption="Support nositelj"/>
							<field name="VrstaUgovoraTxt" caption="Vrsta ugovora"/>
							<field name="IznosUkupneLicence" caption="Iznos licence"/>
							<field name="RabatCAL" caption="Rabat CAL"/>
							<field name="SuppRabatCAL" caption=" "/>
							<field name="RabatLoy" caption="Rabat Loy"/>
							<field name="SuppRabatLoy" caption=" "/>
							<field name="IznosSupportaLic" caption="Iznos Supp LIC"/>
							<field name="SuppIznosSupportaLic" caption=" "/>
							<field name="IznosSupportaRazvoj" caption="Iznos Supp RAZVOJ"/>
							<field name="SuppIznosSupportaRazvoj" caption=" "/>
							<field name="IznosSupportaMp" caption="Iznos Supp MP"/>
							<field name="SuppIznosMp" caption=" "/>
							<field name="IznosSupportaDb" caption="Iznos Supp DB"/>
							<field name="SuppIznosDb" caption=" "/>
							<field name="IznosSupporta" caption="Iznos Supp Σ"/>
							<field name="SuppIznosSupporta" caption=" "/>
							<field name="IznosITsupport" caption="Iznos Supp IT"/>
							<field name="SuppIznosITsupport" caption=" "/>
							<field name="ModelSupporta"/>
							<field name="IznosProsSupporta" caption="Iznos Pros Supp" editable="true"/>
							<field name="RabatDodatni" caption="Dodatni rabat" editable="true"/>
							<field name="RabatRef" caption="Referentni rabat" editable="true"/>
							<field name="RabatAdmin" caption="Admin rabat" editable="true"/>
							<field name="IznosSuppKriticne" caption="Iznos kritične funkcionalnosti" editable="true"/>
							<field name="Opis" editable="true" minwidth="300"/>
						</fields>
						<styles>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==RabatCAL&amp;&amp;#grdUgovorAzur.@RabatCAL!=#grdUgovorAzur.@SuppRabatCAL"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==RabatLoy&amp;&amp;#grdUgovorAzur.@RabatLoy!=#grdUgovorAzur.@SuppRabatLoy"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosSupportaLic&amp;&amp;#grdUgovorAzur.@IznosSupportaLic!=#grdUgovorAzur.@SuppIznosSupportaLic"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosSupportaRazvoj&amp;&amp;#grdUgovorAzur.@IznosSupportaRazvoj!=#grdUgovorAzur.@SuppIznosSupportaRazvoj"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosSupportaMp&amp;&amp;#grdUgovorAzur.@IznosSupportaMp!=#grdUgovorAzur.@SuppIznosMp"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosSupportaDb&amp;&amp;#grdUgovorAzur.@IznosSupportaDb!=#grdUgovorAzur.@SuppIznosDb"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosSupporta&amp;&amp;#grdUgovorAzur.@IznosSupporta!=#grdUgovorAzur.@SuppIznosSupporta"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==IznosITsupport&amp;&amp;#grdUgovorAzur.@IznosITsupport!=#grdUgovorAzur.@SuppIznosITsupport"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==RabatCAL&amp;&amp;#grdUgovorAzur.@RabatCAL!=#grdUgovorAzur.@SuppRabatCAL"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==RabatLoy&amp;&amp;#grdUgovorAzur.@RabatLoy!=#grdUgovorAzur.@SuppRabatLoy"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosSupportaLic&amp;&amp;#grdUgovorAzur.@IznosSupportaLic!=#grdUgovorAzur.@SuppIznosSupportaLic"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosSupportaRazvoj&amp;&amp;#grdUgovorAzur.@IznosSupportaRazvoj!=#grdUgovorAzur.@SuppIznosSupportaRazvoj"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosSupportaMp&amp;&amp;#grdUgovorAzur.@IznosSupportaMp!=#grdUgovorAzur.@SuppIznosMp"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosSupportaDb&amp;&amp;#grdUgovorAzur.@IznosSupportaDb!=#grdUgovorAzur.@SuppIznosDb"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosSupporta&amp;&amp;#grdUgovorAzur.@IznosSupporta!=#grdUgovorAzur.@SuppIznosSupporta"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==IznosITsupport&amp;&amp;#grdUgovorAzur.@IznosITsupport!=#grdUgovorAzur.@SuppIznosITsupport"/>
						</styles>
						<event type="doubleclick">
							<action type="form open" value="frmIzmijeni">
								<parameter name="SuppModelProsId" value="#grdUgovorAzur.@SuppModelProsId"/>
								<parameter name="IznosProsSupporta" value="#grdUgovorAzur.@IznosProsSupporta"/>
								<parameter name="RabatDodatni" value="#grdUgovorAzur.@RabatDodatni"/>
								<parameter name="RabatRef" value="#grdUgovorAzur.@RabatRef"/>
								<parameter name="RabatAdmin" value="#grdUgovorAzur.@IznosProsSupporta"/>
								<parameter name="IznosSuppKriticne" value="#grdUgovorAzur.@IznosSuppKriticne"/>
							</action>
						</event>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="control foreachrow selected" value="grdUgovorAzur">
							<action type="datarun nonquery" value="~dtSpremi"/>
						</action>
						<action type="control populate" value="#grdUgovorAzur"/>
					</event>
				</button>
				<button name="btnZavrši" caption="Završi">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
				<button name="btnIzmijeni" caption="Izmijeni" dock="right">
					<event type="click">
						<action type="form open" value="frmIzmijeniA">
							<parameter name="SuppModelProsId" value="#grdUgovorAzur.@SuppModelProsId"/>
							<parameter name="IznosProsSupporta" value="#grdUgovorAzur.@IznosProsSupporta"/>
							<parameter name="RabatDodatni" value="#grdUgovorAzur.@RabatDodatni"/>
							<parameter name="RabatRef" value="#grdUgovorAzur.@RabatRef"/>
							<parameter name="RabatAdmin" value="#grdUgovorAzur.@RabatAdmin"/>
							<parameter name="IznosSuppKriticne" value="#grdUgovorAzur.@IznosSuppKriticne"/>
						</action>
					</event>
				</button>
				<button name="btnFilter" caption="Filter" dock="right">
					<event type="click">
						<action type="form open" value="frmFilter"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSpremi" command="spSuppIzracunAzurCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@SuppKorisnikId" value="#grdUgovorAzur.@SuppKorisnikId"/>
				<parameter name="@Datum" value="global.$Datum"/>
				<parameter name="@Osnovica" value="#grdUgovorAzur.@IznosUkupneLicence"/>
				<parameter name="@IznosProsSupp" value="#grdUgovorAzur.@IznosProsSupporta"/>
				<parameter name="@SuppModelProsId" value="#grdUgovorAzur.@SuppModelProsId"/>
				<parameter name="@RabatAdmin" value="#grdUgovorAzur.@RabatAdmin"/>
				<parameter name="@RabatDodatni" value="#grdUgovorAzur.@RabatDodatni"/>
				<parameter name="@RabatRef" value="#grdUgovorAzur.@RabatRef"/>
				<parameter name="@IznosSuppKriticne" value="#grdUgovorAzur.@IznosSuppKriticne"/>
				<parameter name="@Opis" value="#grdUgovorAzur.@Opis"/>
				<!-- <parameter name="@Popust" value=" -->
				<parameter name="@RabatCAL" value="#grdUgovorAzur.@RabatCAL"/>
				<parameter name="@RabatLoy" value="#grdUgovorAzur.@RabatLoy"/>
				<parameter name="@IznosSupportaLic" value="#grdUgovorAzur.@IznosSupportaLic"/>
				<parameter name="@IznosSupportaRazvoj" value="#grdUgovorAzur.@IznosSupportaRazvoj"/>
				<parameter name="@IznosSupportaMp" value="#grdUgovorAzur.@IznosSupportaMp"/>
				<parameter name="@IznosSupportaDb" value="#grdUgovorAzur.@IznosSupportaDb"/>
				<parameter name="@IznosITsupport" value="#grdUgovorAzur.@IznosITsupport"/>
				<parameter name="@IznosSupporta" value="#grdUgovorAzur.@IznosSupporta"/>
			</data>
			<data name="dtMaster" command="spSuppIzracunUgovoriSupportaCarpo">
				<parameter name="@Datum" value="global.$Datum"/>
			</data>
		</datalist>
	</form>
</root>