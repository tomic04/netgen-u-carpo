<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmKorekcija" caption ="$caption"  width="370" height="500"  fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtDefault" />
      <action type="datarun reader" value="~dtProvjeraSpremanje" />
    </event>
    <event type="load">
      <action type="control value" value="#lblDatumStavke">
        <parameter value="~dtDefault.@LogDatumStavke"/>
      </action>
      <action type="control value" value="#lblDatumVirmani">
        <parameter value="~dtDefault.@LogDatumVirmani"/>
      </action>
      <action type="control value" value="#lblDatumJOPPD">
        <parameter value="~dtDefault.@LogDatumJOPPD"/>
      </action>

      <action type="control disable" value="#btnSpremiIzmjene" if="~dtProvjeraSpremanje.@SpremiIzmjene==0"></action>
      <action type="control enable" value="#btnSpremiIzmjene" elseif="~dtProvjeraSpremanje.@SpremiIzmjene==1"></action>

    </event>

    <layout>

      <!--omotač-->
      <group cols="1" rows="2" groupbordervisible="false" padding="2,2,2,2" >
        <group col="1" row="1" cols="2" rows="3" groupbordervisible="true" padding="2,2,2,2" caption="Postavke korektivne obrade" >
          <rowsdefinition>
            <row position ="1" size="40"/>
            <row position ="2" size="25"/>
            <row position ="3" size="35"/>
          </rowsdefinition>
          <item caption="Izvorna obrada:" col="1" row="1" highlight="false" textposition="top" colspan="2"  padding="2,2,2,2" >
            <comboedit name="cmbObrade" allownull="true" displayfield="Naziv" valuefield="OOPObrade1Id" dataname="~dtObrade" datavalue="~dtGet.@OOPOBrade1Id" />
          </item>
          <item col="1" row="2" highlight="false" colspan="1" padding="2,2,2,2" >
            <checkedit name="chkindKopirajObrPod" caption="Kopiraj obračunske podatke"/>
          </item>
          <item col="1" row="3" highlight="false"  colspan="2" >
            <button name="btnSpremiPostavke" caption="SPREMI POSTAVKE">
              <event type="click">
                <!-- Okini storu -->
                <action type="validate"/>
                <action type="datarun reader" value="~dtSpremiPostavke"/>
                <action type="variable value">
                  <parameter name="parent.$drvoFokusId" value="$oopobradeid"/>
                  <parameter name="parent.$filterFokus" value="otvorene"/>
                </action>
                <action type="message" value="~dtSpremiPostavke.@Poruka"></action>
                <action type="form close" if="~dtSpremiPostavke.@Id==0" />
              </event>
            </button>
          </item>
        </group>

        <group col="1" row="2" cols="2" rows="14" groupbordervisible="true" padding="2,2,2,2" caption="Trajno spremanje izmjena">
          <!--<rowsdefinition>
            <row position ="1" size="10"/>
            <row position ="2" size="10"/>
            <row position ="3" size="10"/>
            <row position ="4" size="10"/>
            <row position ="5" size="10"/>
            <row position ="6" size="10"/>
            <row position ="7" size="10"/>
            <row position ="8" size="10"/>
            <row position ="9" size="10"/>
            <row position ="10" size="10"/>
          </rowsdefinition>-->
          <item col="1" row="1" highlight="false" colspan="2" rowspan="6" >
            <labeledit name="lblNapomena" value="Prihvaćanjem ove opcije trajno se spremaju novonastali obračunati\npodaci na zapise s izvorne obrade te se briše korektivna obrada.\nPotrebno je osigurati da je napravljen obračun,\nkreiran JOPPD obrazac i kreirani virmani s razlikama za uplatu."></labeledit>
          </item>
          <item col="1" row="7" highlight="false" colspan="2" caption="Obračun stavki:" textposition="left">
            <labeledit name="lblDatumStavke" value=""></labeledit>
          </item>
          <item col="1" row="8" highlight="false" colspan="2" caption="Obračun JOPPD:" textposition="left">
            <labeledit name="lblDatumJOPPD" value=""></labeledit>
          </item>
          <item col="1" row="9" highlight="false" colspan="2" caption="Obračun virmana:" textposition="left">
            <labeledit name="lblDatumVirmani" value=""></labeledit>
          </item>
          <item col="1" row="12" highlight="false"  colspan="2" rowspan="3" >
            <button name="btnSpremiIzmjene" caption="SPREMI IZMJENE"  tooltip="Gumb je onemogućen u slučaju da ne postoji veza na korektivnu obradu, da ne postoji kreiran JOPPD obrazac ili je pogrešan redosljed obračuna.">
              <event type="click">
                <!-- Okini storu -->
                <action type="validate"/>
                <action type="datarun reader" value="~dtSpremiIzmjene"/>
                <action type="variable value">
                  <parameter name="parent.$drvoFokusId" value="$oopobradeid"/>
                  <parameter name="parent.$filterFokus" value="otvorene"/>
                </action>
                <action type="message" value="~dtSpremiIzmjene.@Poruka"></action>
                <action type="form close" if="~dtSpremiIzmjene.@Id==0" />
              </event>
            </button>
          </item>
        </group>

      </group>
      <!--kraj omotača-->

    </layout>

    

    <datalist>
      <data command="spPlaceKorekcijaAll" name="dtObrade">
        <parameter name="@Action" value="combo_obrade" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
      <data command="spPlaceKorekcijaAll" name="dtGet">
        <parameter name="@Action" value="dtGet" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
      <data command="spPlaceKorekcijaAll" name="dtSpremiPostavke">
        <parameter name="@Action" value="spremi_postavke" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@oopobrade1id" value="#cmbObrade"/>
        <parameter name="@indKopirajObrPod" value="#chkindKopirajObrPod"/>
      </data>
      <data command="spPlace_help" name="dtDefault">
        <parameter name="@Action" value="default_obracun" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="global.$OOPObradeId"/>
      </data>
      <data command="spPlaceKorekcijaAll" name="dtProvjeraSpremanje">
        <parameter name="@Action" value="provjera_SpremanjeIzmjena" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@datStavke" value="~dtDefault.@LogDatumStavke" type="datetime"/>
        <parameter name="@datJOPPD" value="~dtDefault.@LogDatumJOPPD" type="datetime"/>
        <parameter name="@datVirmani" value="~dtDefault.@LogDatumVirmani" type="datetime"/>
      </data>
    <data command="spPlaceKorekcijaAzur" name="dtSpremiIzmjene">
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
    </datalist>
  </form>


</root>