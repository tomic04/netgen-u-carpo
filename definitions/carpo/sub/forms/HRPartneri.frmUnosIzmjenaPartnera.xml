<root>
	<!--
  Komentari:
  08.09.2021. Marin Glavaš - zamijenio captione za check kontrole (DevX 20) - button za unos ulice ne izgleda lijepo
  02.04.2021. Marin Glavaš - dodao button za unos nove ulice uz kontrolu za izbor ulice, formu za unos
  09.03.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.fixedsize="true"
  -->
	<form name="frmUnosIzmjenaPartnera" caption="$caption" width="400" height="200" saveformlayout="true" >
		<event type="init">
			<action type="datarun reader" value="~dtGetPartnera" if="$HRPartneriId!=0" />
		</event>

		<event type="shown">
			<!-- AKO JE IZMIJENA, POPUNI KONTROLE-->
			<action if="$Tip=='Izmjena'">
				<action type="control value" value="#dtDatum">
					<parameter value="~dtGetPartnera.@DatumRodenja" />
				</action>
				<action type="control value" value="#txtSpol">
					<parameter value="~dtGetPartnera.@Spol" />
				</action>
				<action type="control value" value="#dtDatumOdlaska">
					<parameter value="~dtGetPartnera.@DatumOdlaska" />
				</action>
				<action type="control value" value="#dtClanII">
					<parameter value="~dtGetPartnera.@Clan2Stupadatum" />
				</action>
				<action type="control value" value="#cmbDrzavljanstvo">
					<parameter text="~dtGetPartnera.@Drzavljanstvo" value="~dtGetPartnera.@HRDrzavljanstvoId" />
				</action>
				<action type="control value" value="#srcMjestoPrebivanja">
					<parameter text="~dtGetPartnera.@MjestoPrebivanja" value="~dtGetPartnera.@mjestaid" />
				</action>
				<action type="control value" value="#cmbUlica">
					<parameter text="~dtGetPartnera.@Ulice" value="~dtGetPartnera.@UliceId" />
				</action>
				<action type="control value" value="#srcOrgJedinica">
					<parameter text="~dtGetPartnera.@OrgJedinica" value="~dtGetPartnera.@OrgShemaId" />
				</action>
				<action type="control value" value="#srcPoreznaOpcina">
					<parameter text="~dtGetPartnera.@Općina" value="~dtGetPartnera.@OOPMjestaPorezId" />
				</action>
				<action type="control value" value="#cmbVrstaRacuna">
					<parameter text="~dtGetPartnera.@VrsteRacuna" value="~dtGetPartnera.@OOPVrsteRacunaId" />
				</action>
				<action type="control value" value="#cmbVrstaRacuna2">
					<parameter text="~dtGetPartnera.@VrsteZRacuna" value="~dtGetPartnera.@OOPVrsteRacuna2Id" />
				</action>
				<action type="control value" value="#cmbBankaORacuna">
					<parameter text="~dtGetPartnera.@BankaORacuna" value="~dtGetPartnera.@PartnerObicnogR" />
				</action>
				<action type="control value" value="#cmbBankaZRacuna">
					<parameter text="~dtGetPartnera.@BankaZRacuna" value="~dtGetPartnera.@PartnerZasticenogR" />
				</action>
				<action type="control disable" value="#dtDatumOdlaska" if="~dtGetPartnera.@DatumOdlaska==null"></action>
				<action type="control disable" value="#dtClanII" if="~dtGetPartnera.@Clan2Stupadatum==null"></action>
				<action if="~dtGetPartnera.@DatumOdlaska==null">
					<action type="control value" value="#dtDatumOdlaska" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetPartnera.@Clan2Stupadatum==null">
					<action type="control value" value="#dtClanII" >
						<parameter value="now" />
					</action>
				</action>
			</action>
			<!-- AKO JE UNOS, PRIKAZ ZADNJEG DANA U MJESECU NA DATUMU ODLASKA-->
			<action elseif="$tip==unos" >
				<action type="datarun reader" value="~getZadnjiDan"  />
				<action type="control value" value="#dtDatumOdlaska"  >
					<parameter value="~getZadnjiDan.@ZadnjiDan" />
				</action>
				<!-- AKO JE UNOS, DISABLE DATUM ODLASKA I ČLAN II ALI OSTANE AKTIVAN CHECKBOX-->
				<action type="control disable" value="#dtDatumOdlaska,#dtClanII" ></action>
			</action>
		</event>
		<layout autotaborder="false">
			<group rows="2" cols="2" groupbordervisible="false">
				<group rows="8" cols="3"  row="1" col="1" caption="Opći podaci" spacing="2,2,1,2">
					<item row="1" col="1" caption="Ime:" highlight="false" colspan="3">
						<textedit name="txtIme" allownull="false" required="true" datavalue="~dtGetPartnera.@Ime" tabindex="1"/>
					</item>
					<item row="2" col="1" caption="Prezime:" highlight="false" colspan="3">
						<textedit name="txtPrezime" allownull="false" required="true" datavalue="~dtGetPartnera.@Prezime" tabindex="2"/>
					</item>
					<item row="3" col="1" caption="OIB:" highlight="false" >
						<textedit name="txtoib" datavalue="~dtGetPartnera.@OIB" maxlength="11" tabindex="3" />
					</item>
					<item row="3" col="2" highlight="false" caption="JMBG:">
						<textedit name="txtJMBG" datavalue="~dtGetPartnera.@JMBG" maxlength="13" tabindex="4"/>
					</item>
					<item  row="4" col="1" caption="Datum rođenja:" highlight="false" >
						<dateedit name="dtDatum" value="now" tabindex="5"/>
					</item>
					<item row="4" col="2" caption="Spol:" highlight="false">
						<textedit name="txtSpol" format="[M]|[Ž]|[Z]" formattype="regex" tooltip="Možete upisati samo 'M' ili 'Ž' (Z)" tabindex="6"/>
					</item>
					<item row="5" col="1" caption="Državljanstvo:" highlight="false" colspan="3">
						<comboedit name="cmbDrzavljanstvo" valuefield="HRDrzavljanstvoId" displayfield="Naziv" dataname="~dtDrzavljanstvo" tabindex="7"/>
					</item>
					<item row="6" col="1" caption="Mjesto prebivanja:" colspan="3" highlight="false">
						<searchedit name="srcMjestoPrebivanja" dataname="~dtMjestoPrebivanja" fieldtext="Naziv" fieldvalue="mjestaid" tabindex="8" >
							<!-- AKO JE UNESENO MJESTO PREBIVANJA U TRAŽILICU, DA NAPUNI COMBO SA ULICAMA IZABRANOG MJESTA PREBIVANJA-->
							<event type="valuechanged">
								<action if="#srcMjestoPrebivanja!=null">
									<action type="datarun reader" value="dtUlice">
										<action type="control populate" value="#cmbUlica" />
									</action>
								</action>
								<action else="">
									<action type="control populate" value="#cmbUlica" />
								</action>
							</event>
						</searchedit>
					</item>
					<item row="7" col="1" caption="Ulica:" highlight="false" colspan="2">
						<comboedit name="cmbUlica" valuefield="Uliceid" displayfield="Naziv" dataname="~dtUlice" tabindex="9"/>
					</item>
					<!-- <item row="7" col="3" caption=" " highlight="false">
						<button name="btnUnosUlice" image="add">
							<event type="click">
								<action type="form open" value="frmUnosUlice"></action>
							</event>
						</button>
					</item> -->
					<item row="8" col="1" caption="Kućni broj:" highlight="false">
						<textedit name="txtKucniBroj"  datavalue="~dtGetPartnera.@KucniBroj" maxlength="4" tabindex="10"/>
					</item>
					<item row="8" col="2" highlight="false" caption="Kućni broj dodatak:">
						<textedit name="txtKB" datavalue="~dtGetPartnera.@KucniBrojDodatak" maxlength="2" tabindex="11"/>
					</item>
				</group>
				<group rows="3" cols="3"  row="2" col="1" spacing="2,2,1,2">
					<item  row="1" col="1" caption="Datum dolaska:" highlight="false" >
						<dateedit name="dtDatumDolaska" required="true"  value="now"  datavalue="~dtGetPartnera.@DatumDolaska" tabindex="12"/>
					</item>
					<item  row="2" col="1" caption="Datum odlaska:" highlight="false" >
						<dateedit name="dtDatumOdlaska"  allownull="true" tabindex="13">
						</dateedit>			
					</item>
					<item row="3" col="1" caption="Org. jedinica:" colspan="3" highlight="false">
						<searchedit name="srcOrgJedinica" dataname="~dtOrgJedinica" fieldtext="Naziv" fieldvalue="OrgShemaId" tabindex="14" />
					</item>
				</group>
				<group col="2" row="1" cols="1" rows="2" groupbordervisible="false">
					<group col="2" row="1" cols="3" rows="5" caption="Obračunski podaci" spacing="2,2,2,1">
						<item  row="1" col="1" caption="Član II stupa od:" highlight="false" >
							<dateedit name="dtClanII"  allownull="true" value="now" tabindex="15">
							</dateedit>
						</item>
						<item row="2" col="1" caption="Porezna općina:" colspan="3" highlight="false">
							<searchedit name="srcPoreznaOpcina" dataname="~dtPoreznaOpcina" fieldtext="Naziv" fieldvalue="OOPMjestaPorezId"  required="true" tabindex="16"/>
						</item>
						<item row="3" col="1" caption="Porezna olakšica:" highlight="false">
							<textedit name="txtPoreznaOlaksica" format="n2" value="0" allownull="false" datavalue="~dtGetPartnera.@Olaksica" tabindex="17"/>
						</item>
						<item row="3" col="2" caption="Postotak invalidnosti:" highlight="false">
							<textedit name="txtPostotakI" format="n2" value="0" allownull="false" datavalue="~dtGetPartnera.@PostotakInvalidnosti" tabindex="18"/>
						</item>
						<item row="4" col="1"  highlight="false">
							<checkedit name="chckPrirezInd" caption="Ne plaća prirez" datavalue="~dtGetPartnera.@PrirezInd" tabindex="19"/>
						</item>
						<item row="5" col="1"  highlight="false">
							<checkedit name="chckUmirovljenik" caption="Umirovljenik" datavalue="~dtGetPartnera.@Umirovljenik" tabindex="20"/>
						</item>
						<item row="4" col="2"  highlight="false">
							<checkedit name="chckObveznikPDV" caption="Obveznik PDV-a"  datavalue="~dtGetPartnera.@ObveznikPDV" tabindex="21"/>
						</item>
					</group>
					<group col="2" row="2" cols="3" rows="3" spacing="1,2,2,2">
						<item row="1" col="1" caption="Vrsta računa:" highlight="false" colspan="3">
							<comboedit name="cmbVrstaRacuna" valuefield="OOPVrsteRacunaId" displayfield="Naziv" dataname="~dtVrsteRacuna" tabindex="22">
								<event type="valuechanged">
									<!-- Ako je Gotovina u vrsti računa (uzima id 3 tablice jer je na njemu se nalazi gotovina) onda disable račune, a ako nije onda enabl-a -->
									<action if="#cmbVrstaRacuna==3">								
										<action type="control disable" value="#cmbBankaORacuna,#txtOsnovniRacun" ></action>
										<action type="control value" value="#txtOsnovniRacun" >
										</action>	
										<action type="control value" value="#cmbBankaORacuna" >
										</action>										
									</action>
									<action else="">
										<action type="control enable" value="#cmbBankaORacuna,#txtOsnovniRacun" ></action>
										<action type="control value" value="#txtOsnovniRacun" >
											<parameter value="~dtGetPartnera.@ZiroRacun" />
										</action>
										<action type="control value" value="#cmbBankaORacuna" >
											<parameter value="~dtGetPartnera.@PartnerObicnogR" />
										</action>
									</action>
								</event>
							</comboedit>
						</item>
						<item row="2" col="1" caption="Banka osnovnog računa:" highlight="false" colspan="3">
							<comboedit name="cmbBankaORacuna" valuefield="PartneriId" displayfield="Naziv" dataname="~dtBankaRacuna" tabindex="23"/>
						</item>
						<item row="3" col="1" caption="Osnovni račun:" highlight="false" colspan="3">
							<textedit name="txtOsnovniRacun" datavalue="~dtGetPartnera.@ZiroRacun" tabindex="24"/>
						</item>
					</group>
				</group>
				<group row="2" col="2"  rows="3" cols="3" spacing="2,2,2,1">
					<item row="1" col="1" caption="Vrsta zaštićenog računa:" highlight="false" colspan="3">
						<comboedit name="cmbVrstaRacuna2" valuefield="OOPVrsteRacunaId" displayfield="Naziv" dataname="~dtVrsteRacuna" tabindex="25">
							<event type="valuechanged">
								<!-- Ako je Gotovina u vrsti računa (uzima id 3 tablice jer je na njemu se nalazi gotovina) onda disable račune, a ako nije onda enabl-a -->
								<action if="#cmbVrstaRacuna2==3">
									<action type="control disable" value="#cmbBankaZRacuna,#txtZasticeniRacun" ></action>
									<action type="control value" value="#cmbBankaZRacuna" >
										</action>	
										<action type="control value" value="#txtZasticeniRacun" >
										</action>	
								</action>
								<action else="">
									<action type="control enable" value="#cmbBankaZRacuna,#txtZasticeniRacun" ></action>
									<action type="control value" value="#cmbBankaZRacuna" >
											<parameter value="~dtGetPartnera.@PartnerZasticenogR" />
										</action>
										<action type="control value" value="#txtZasticeniRacun" >
											<parameter value="~dtGetPartnera.@RacunZasticeni" />
										</action>
								</action>
							</event>
						</comboedit>
					</item>
					<item row="2" col="1" caption="Banka zaštićenog računa:" highlight="false" colspan="3">
						<comboedit name="cmbBankaZRacuna" valuefield="PartneriId" displayfield="Naziv" dataname="~dtBankaRacuna" tabindex="26"/>
					</item>
					<item row="3" col="1" caption="Zaštićeni račun:" highlight="false" colspan="3">
						<textedit name="txtZasticeniRacun" datavalue="~dtGetPartnera.@RacunZasticeni" tabindex="27"/>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<!-- AKO JE UNOS-->
						<action if="$HRPartneriId==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdGrid">
									<action type="control focus" value="parent.#grdGrid">
										<parameter value="$noviID"/>
									</action>
								</action>
								<action type="control enable" value="parent.#btnIzmjeni"/>
							</action>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!"/>
							<action type="form close" />
						</action>
						<!-- AKO OIB NIJE ISPRAVAN FOKUSIRA SE NA POLJE ZA OIB PRILIKOM UNOSA-->
						<action if="$indGreske==1">
							<action type="control focus" value="#txtOIB" >
								<parameter value="~dtUnos.@OIB"/>
							</action>
						</action>
						<!-- AKO JE IZMIJENA-->
						<action if="$HRPartneriId!=0">
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<action type="form close"/>
							</action>
							<!-- AKO OIB NIJE ISPRAVAN FOKUSIRA SE NA POLJE ZA OIB PRILIKOM IZMJENE-->
							<action if="$indGreske==1">
								<action type="control focus" value="#txtOIB" >
									<parameter value="~dtIzmjena.@OIB" />
								</action>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRPartneri_Query_CP" name="dtDrzavljanstvo">
				<parameter name="@action" value="getDrzavljanstvo" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtMjestoPrebivanja">
				<parameter name="@action" value="getMjestoPrebivanja" />
				<parameter name="@tekst" value="#srcMjestoPrebivanja.text" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtUlice">
				<parameter name="@action" value="getUlica" />
				<parameter name="@mjestaid" value="#srcMjestoPrebivanja"/>
			</data>
			<data command="spHRPartneri_Query_CP" name="dtOrgJedinica">
				<parameter name="@action" value="getOrgJedinicu" />
				<parameter name="@tekst" value="#srcOrgJedinica.text" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtPoreznaOpcina">
				<parameter name="@action" value="getPoreznaOpcina" />
				<parameter name="@tekst" value="#srcPoreznaOpcina.text" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtVrsteRacuna">
				<parameter name="@action" value="getVrsteRacuna" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtBankaRacuna">
				<parameter name="@action" value="getBankaRacuna" />
			</data>
			<data command="spHRPartneri_Query_CP" name="dtGetPartnera">
				<parameter name="@action" value="getPartnera" />
				<parameter name="@HRPartneriId" value="$HRPartneriId" type="int"/>
			</data>
			<data command="spHRPartneri_Query_CP" name="getZadnjiDan">
				<parameter name="@action" value="ZadnjiDan" />
			</data>
			<data  command="spHRPartneri_Azur_CP" name="dtUnos">
				<parameter name="@action" value="unos"/>
				<parameter name="@HRPartneriId.output.int" variablename="noviID"></parameter>
				<parameter name="@Ime" value="#txtIme"/>
				<parameter name="@Prezime" value="#txtPrezime"/>
				<parameter name="@OIB" value="#txtoib"/>
				<parameter name="@JMBG" value="#txtJMBG"/>
				<parameter name="@Spol" value="#txtSpol"/>
				<parameter name="@DatumRodenja" value="#dtDatum"/>
				<parameter name="@KucniBroj" value="#txtKucniBroj"/>
				<parameter name="@KucniBrojDodatak" value="#txtKB"/>
				<parameter name="@DatumDolaska" value="#dtDatumDolaska"/>
				<parameter name="@DatumOdlaska" value="#dtDatumOdlaska"/>
				<parameter name="@Clan2StupaDatum" value="#dtClanII"/>
				<parameter name="@Olaksica" value="#txtPoreznaOlaksica"/>
				<parameter name="@PostotakInvalidnosti" value="#txtPostotakI"/>
				<parameter name="@HRDrzavljanstvoId" value="#cmbDrzavljanstvo"/>
				<parameter name="@MjestoPrebivanjaId" value="#srcMjestoPrebivanja"/>
				<parameter name="@uliceid" value="#cmbUlica"/>
				<parameter name="@orgshemaid" value="#srcOrgJedinica"/>
				<parameter name="@PoreznaOpcinaId" value="#srcPoreznaOpcina"/>
				<parameter name="@PrirezInd" value="#chckPrirezInd"/>
				<parameter name="@Umirovljenik" value="#chckUmirovljenik"/>
				<parameter name="@ObveznikPDV" value="#chckObveznikPDV"/>
				<parameter name="@OOPVrsteRacunaId" value="#cmbVrstaRacuna"/>
				<parameter name="@OOPVrsteRacuna2Id" value="#cmbVrstaRacuna2"/>
				<parameter name="@BankaId" value="#cmbBankaORacuna"/>
				<parameter name="@ZiroRacun" value="#txtOsnovniRacun"/>
				<parameter name="@BankaZasticeniId" value="#cmbBankaZRacuna"/>
				<parameter name="@RacunZasticeni" value="#txtZasticeniRacun"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data  command="spHRPartneri_Azur_CP" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@HRPartneriId" value="$HRPartneriId"/>
				<parameter name="@Ime" value="#txtIme"/>
				<parameter name="@Prezime" value="#txtPrezime"/>
				<parameter name="@OIB" value="#txtoib"/>
				<parameter name="@JMBG" value="#txtJMBG"/>
				<parameter name="@Spol" value="#txtSpol"/>
				<parameter name="@DatumRodenja" value="#dtDatum"/>
				<parameter name="@KucniBroj" value="#txtKucniBroj"/>
				<parameter name="@KucniBrojDodatak" value="#txtKB"/>
				<parameter name="@DatumDolaska" value="#dtDatumDolaska"/>
				<parameter name="@DatumOdlaska" value="#dtDatumOdlaska"/>
				<parameter name="@Clan2StupaDatum" value="#dtClanII"/>
				<parameter name="@Olaksica" value="#txtPoreznaOlaksica"/>
				<parameter name="@PostotakInvalidnosti" value="#txtPostotakI"/>
				<parameter name="@HRDrzavljanstvoId" value="#cmbDrzavljanstvo"/>
				<parameter name="@MjestoPrebivanjaId" value="#srcMjestoPrebivanja"/>
				<parameter name="@uliceid" value="#cmbUlica"/>
				<parameter name="@orgshemaid" value="#srcOrgJedinica"/>
				<parameter name="@PoreznaOpcinaId" value="#srcPoreznaOpcina"/>
				<parameter name="@PrirezInd" value="#chckPrirezInd"/>
				<parameter name="@Umirovljenik" value="#chckUmirovljenik"/>
				<parameter name="@ObveznikPDV" value="#chckObveznikPDV"/>
				<parameter name="@OOPVrsteRacunaId" value="#cmbVrstaRacuna"/>
				<parameter name="@OOPVrsteRacuna2Id" value="#cmbVrstaRacuna2"/>
				<parameter name="@BankaId" value="#cmbBankaORacuna"/>
				<parameter name="@ZiroRacun" value="#txtOsnovniRacun"/>
				<parameter name="@BankaZasticeniId" value="#cmbBankaZRacuna"/>
				<parameter name="@RacunZasticeni" value="#txtZasticeniRacun"/>
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>
	<!--
  *******************************************************************************************
  FORMA ZA BRISANJE
  *******************************************************************************************
  -->
	<form name="frmBrisanje" caption ="Brisanje" width="400" height="150" fixedsize="true" saveformsize="false" >
		<event type="shown">
			<action type ="control value" value="#lblPitanje">
				<parameter value="Jeste li sigurni da želite obrisati '{parent.#grdGrid.@Ime} {parent.#grdGrid.@Prezime}'?"/>
			</action>
		</event>
		<layout>
			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="true" >
				<item col="1" row="1"  highlight="false">
					<labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
				</item>
			</group>
