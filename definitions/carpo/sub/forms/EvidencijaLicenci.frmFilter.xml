<root>
	<form name="frmFilter" caption="Filter">
		<event type="init">
			<action type="datarun reader" value="~dtOd" if="global.$Init==0"/>
			<action type="datarun reader" value="~dtDo" if="global.$Init==0"/>
			<action type="variable value" value="global.$Init">
				<parameter value="1"/>
			</action>
		</event>
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" caption="Od:">
					<dateedit name="datOd" datavalue="~dtOd.@Od" required="true" allownull="false" savevalue="session"/>
				</item>
				<item row="2" col="1" caption="Do:">
					<dateedit name="datDo" datavalue="~dtDo.@Do" required="true" allownull="false" savevalue="session"/>
				</item>
				<item row="3" col="1" caption="Korisnik:">
					<comboedit name="cmbKorisnik" dataname="~dtKorisnik" valuefield="suppKorisnikId" displayfield="Naziv" savevalue="session"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPotvrdi" caption="Potvrdi">
					<event type="click">
						<action type="validate"/>
						<action type="variable value">
							<parameter name="global.$Od" value="#datOd" type="date"/>
							<parameter name="global.$Do" value="#datDo" type="date"/>
							<parameter name="global.$Korisnik" value="#cmbKorisnik" type="int"/>
						</action>
						<action type="form close"/>
						<action type="form open" value="frmLicAzur" if="global.$FormOpen==0"/>
						<action type="control populate" value="parent.#grdLicAzur, parent.#grdLicAzurDet" if="global.$FormOpen==1"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtOd" command="SELECT DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0) AS Od" type="text"/>
			<data name="dtDo" command="SELECT DATEADD(MONTH, DATEDIFF(MONTH, -1, GETDATE())-1, -1) AS Do" type="text"/>
			<data name="dtKorisnik" command="spBugsSuppQueryCarpo">
				<parameter name="@Action" value="KORISNICI"/>
			</data>
		</datalist>
	</form>
</root>