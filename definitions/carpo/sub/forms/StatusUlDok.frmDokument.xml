<root version="1.0.0.1">
	<form name="frmDokument" type="master" caption="Dokument: '{$BrojDok}', od datuma: '{$DatumDok}',UFA br.: '{$Ufa}'" width="800" height="600" statusbar="false">
		<event type="init"> 
			<action type="datarun reader" value="~dtRobaDefKey" />
			<!-- <action type="variable value" >
				<parameter name="RobaDefKey" value="~dtRobaDefKey.@VarSet" />
			</action> -->
		</event>
		<event type="load">	
			<action type="control populate" value="#grdDokument"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdDokument" multiselect="true" key="SkladisteId" showgrouppanel="true" showfooter="false" savelayout="true">												
							<data command="spC_Robno_StatusUlDok">
								<parameter name="@action" value="stavke"/>
								<parameter name="@SktPrometGlaId" value="$SktPrometGlaId" type="int"/>
							</data>
							<fields>	
								<field name="UserId" caption="Roba" if="~dtRobaDefKey.@VarSet==UserId"/>
								<field name="RobaKod" caption="Roba" else=""/>
								<field name="klasanaziv" caption="Klasa" />
								<field name="robanaziv" caption="Roba" />
								<field name="JMnaziv" caption="JM" />
								<field name="KolicinaUlaz" caption="Količina ulaz" showsum="true"/>
								<field name="NabCijena" caption="Nabavna cijena" showsum="true"/>
								<field name="Ukupno" caption="Ukupno" showsum="true" />
								
							</fields>
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="IZLAZ" type="cancel" dock="left">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>	

			</buttons>
		</panelbuttons>
		<datalist>

			<data command="select VarSet from pubvars where VarIme='RobaDefKey'" type="text" name="dtRobaDefKey"/>

		</datalist>
	</form>
</root>