<root version="1.0.0.1" loglevel="3">
	<form name="frmPartnerInfoStanje" statusbar="false" saveformsize="true">
		<event type="init">	
			
		</event>
		<event type="load">
			<action type="control value" value="#rdoOtvoreniRacuni">
				<parameter value="true"/>
			</action>
			<action type="control value" value="#rdoSviRacuni">
				<parameter value="false"/>
			</action>		
			<action type="variable value">
				<parameter name="SviRacuni" value="0"/>
			</action>	
			<action type="control populate" value="#grdRacuniGla"/>			
		</event>
		<event type="shown">
			<action type="form caption" value="Konto: {$KontoNaziv} || otvoreni računi"/>
		</event>
		<event type="close">
		</event>
		<layout  itemspadding="0">
			<group rows="3" cols="3" groupbordervisible="false">
				<rowsdefinition>
					<row position="1" size="30"/>
					<row position="2" size="65%"/>
					<row position="3" size="40%"/>
				</rowsdefinition>				
				<item row="1" col="1" highlight="false">
					<radioedit name="rdoSviRacuni" caption="Svi računi">
						<event type="valuechanged">
							<action type="variable value" if="#rdoSviRacuni==true">
								<parameter name="SviRacuni" value="1"/>
							</action>
							<action type="control populate" value="#grdRacuniGla"/>
							<action type="form caption" value="Konto: {$KontoNaziv} || otvoreni računi" if="#rdoOtvoreniRacuni==true"/>
							<action type="form caption" value="Konto: {$KontoNaziv} || svi računi" elseif="#rdoSviRacuni==true"/>
						</event>
					</radioedit>
				</item>
				<item row="1" col="2" highlight="false">
					<radioedit name="rdoOtvoreniRacuni" caption="Otvoreni računi">
						<event type="valuechanged">
							<action type="variable value" if="#rdoOtvoreniRacuni==true">
								<parameter name="SviRacuni" value="0"/>
							</action>						
							<action type="control populate" value="#grdRacuniGla"/>
							<action type="form caption" value="Konto: {$KontoNaziv} || otvoreni računi" if="#rdoOtvoreniRacuni==true"/>
							<action type="form caption" value="Konto: {$KontoNaziv} || svi računi" elseif="#rdoSviRacuni==true"/>							
						</event>			
					</radioedit>
				</item>
				<item row="2" col="1" colspan="3">
					<grid name="grdRacuniGla" dataname="~dtRacuniGla" autopopulate="false" savelayout="true" fieldsmartspaces="false">
						<event type="focusedrowchanged">
							<action type="control populate" value="#grdRacuniDet"/>
						</event>
					</grid>
				</item>		
				<item row="3" col="1" colspan="3">
					<grid name="grdRacuniDet" dataname="~dtRacuniDet" showgrouppanel="false" autopopulate="false" savelayout="true" fieldsmartspaces="false" caption="Pregled knjiženja za račun {#grdRacuniGla.@Broj}">
					
					</grid>
				</item>						
			</group>
		</layout>
		<panelbuttons>
			<buttons>			
				<button name="btnZatvori" caption="Zatvori" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>			
			<data name="dtRacuniGla" command="spCPartnerInfoQuery">
				<parameter name="@Action" value="25" if="$SviRacuni==0"/>	
				<parameter name="@Action" value="251" if="$SviRacuni==1"/>				
				<parameter name="@PartneriId" value="$PartneriId"/>
				<parameter name="@Tablica" value="$Tablica"/>
				<parameter name="@KntPlanAId" value="$KntPlanAId"/>			
			</data>
			<data name="dtRacuniDet" command="spCPartnerInfoQuery">
				<parameter name="@Action" value="26"/>				
				<parameter name="@PartneriId" value="$PartneriId"/>
				<parameter name="@Tablica" value="$Tablica"/>
				<parameter name="@KntPlanAId" value="$KntPlanAId"/>	
				<parameter name="@FaktureId" value="#grdRacuniGla.@FaktureId"/>						
			</data>			
			<data name="" command="">
				<parameter name="" value=""/>
				<parameter name="" value=""/>
			</data>
			<data name="" command="">
				<parameter name="" value=""/>
				<parameter name="" value=""/>
			</data>
		</datalist>
	</form>
</root>