<root>

  <form name="frmPostavkeStavka" caption ="$caption" width="650"  height="250" fixedsize="false" saveformsize="false">

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="Kopiraj sa stavke:" col="1" row="1" highlight="false" colspan="4" >
          <searchedit name="srcStavka" fieldvalue="OOPStavekeId" fieldtext="Naziv" dataname="~dtStavka" required="true"/>
        </item>
        <item col="1" row="2"  highlight="False" textposition="left">
          <checkedit caption="Zavisne stavke" name="chkZavisne" />
        </item>
        <item col="1" row="3"  highlight="False" textposition="left">
          <checkedit caption="Odnosne stavke" name="chkOdnosne" />
        </item>
        <item col="1" row="4"  highlight="False" textposition="left">
          <checkedit caption="Dodatne stavke" name="chkDodatne"  />
        </item>
        <item col="1" row="5"  highlight="False" textposition="left">
          <checkedit caption="Doprinose" name="chkDoprinosi" />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnKopiraj" caption="Kopiraj">
          <event type="click">
            <action type="datarun reader" value="~dtKopiraj"/>
            <action type="message" value="~dtKopiraj.@Poruka" />
            <action type="control populate" value="parent.#grdStatusi"/>
          </event>
          <action type="form close" />
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOOPStavkeQueryCP" name="dtStavka">
        <parameter name="@action" value="Stavka_src"/>
        <parameter name="@Tekst" value="#srcStavka.text"/>
      </data>
      <data command="spOOPStavkeAzurCP" name="dtKopiraj">
        <parameter name="@action" value="Kopiranje_postavke"/>
        <parameter name="@OOPStavkeId" value="$OOPStavkeId"/>
        <parameter name="@OOPStavke2Id" value="#srcStavka.@OOPStavekeId"/>
        <parameter name="@chkZavisne" value="#chkZavisne"/>
        <parameter name="@chkOdnosne" value="#chkOdnosne"/>
        <parameter name="@chkDodatne" value="#chkDodatne"/>
        <parameter name="@chkDoprinosi" value="#chkDoprinosi"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>

  </form>
</root>