<root>
	<form name="frmJMInsertEdit" caption="JM">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
			<action type="datarun scalar" value="~dtmaxlength">
				<parameter name="maxlength" value="~dtmaxlength.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>	
		</event>
		<layout>
			<group rows="2" cols="1" >
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNazivJM" datavalue="~dtGet.@Naziv" required="true" maxlength="$maxlength"/>
				</item>
				<item row="2" col="1" caption="Decimal:">
					<textedit name="txtDEC" datavalue="~dtGet.@Decimals" required="true" format="[0-9]" formattype="regex"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate"/>
							<action type="datarun scalar" value="~dtDataEdit" if="$JMid!=null">
								<parameter name="parent.$JMid"/>
								<!-- <action type="control populate keepfocus" value="parent.#grdMaster"/> -->
							</action>	
							<action type="datarun scalar" value="~dtDataInsert" else="">
								<parameter name="parent.$JMid"/>
								<action type="control populate" value="parent.#grdMaster"/>
								<action type="control focus" value="parent.#grdMaster">
									<parameter value="parent.$jmid" type="int"/>
								</action>
							</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlength">
				<parameter name="@table_name" value="JM" />
				<parameter name="@column_name" value="Naziv" />
			</data>	
			<data command="spJM_Query" name="dtGet">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$JMid" />
			</data>	
			<data command="spJM_Azur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Naziv" value="#txtNazivJM"/>
				<parameter name="@Decimals" value="#txtDEC"/>
			</data>
			<data command="spJM_Azur" name="dtDataEdit">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$JMid" />
				<parameter name="@Naziv" value="#txtNazivJM" />
				<parameter name="@Decimals" value="#txtDEC" />
			</data>
		</datalist>
	</form>
</root>