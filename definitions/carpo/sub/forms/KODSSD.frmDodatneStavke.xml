<root>
  <form name="frmDodatneStavke" type="master" caption="$Naziv"  width="800" height="500">
    <event type="load">
      <action type="control populate" value="#grdDodatneStavke"/>
    </event>
    <layout textposition="left">
      <group cols="1" rows="2" groupbordervisible="false">
        
        <group cols="5" rows="1" col="1" row="1" spacing="2,2,2,1">
          <item col="1" row="1" caption="Stavka:" colspan="3">
            <searchedit name="srcStavke" fieldvalue="OOPStavkeId" fieldtext="Naziv" dataname="~dtsrcStavke" />
          </item>
          <item col="4" row="1" caption="Koeficijent:" >
            <textedit name="txtKoeficijent" value="1" required="true" format="n2" textalign="right"/>
          </item>
          <item col="5" row="1" >
            <button name="btnSpremi"  caption="Spremi" type="add" >
              <event type="click">
                <action type="datarun reader" value="~dtSpremiStavku" />
                <action type="control populate" value="#grdDodatneStavke" />
                <action type="control refreshvalue" value="#srcStavke"/>
                <action type="control refreshvalue" value="#txtKoeficijent"/>
                <action type="control focus" value="#srcStavke"/>
              </event>
            </button>
          </item>
        </group>
        
        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,2">
          <item col="1" row="1">
            <grid name="grdDodatneStavke" key="OOPStavkeDetId" dataname="dtDodatneStavke" showautofilterrow="false" multiselect="true" keyfield="OOPStavkeDetId">
              <event type="cellvaluechanged">
                <action type="datarun nonquery" value="~dtUpdate" />
                <action type="control populate keepfocus" value="#grdDodatneStavke" />
              </event>
              <fields inherited="true">
                <field name="Koeficijent" editable="true" fontbold="true" />
              </fields>
            </grid>
          </item>
        </group>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        
        <!--GUMB OBRIŠI-->
        <button name="btnBrisi" caption="Obriši" type="delete">
          <event type="click">
            <!--<action type="message" value="#grdOdnosneStavke.selectedids" />-->
            <action type="confirm" value="Da li ste sigurni da želite obrisati označene stavke?">
              <action type="datarun nonquery" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdDodatneStavke"></action>
          </event>
        </button>
        <!--GUMB UNESI-->
        <button name="btnIzlaz" caption="Izlaz" type="cancel" dock="right">

        </button>


      </buttons>
    </panelbuttons>
    
    <datalist>
      <data command="spOOPStavkeDetQueryCP" name="dtsrcStavke">
        <parameter name="@Action" value="Dodatne_trazi" />
        <parameter name="@OOPStavkeId" value="$OOPStavkeId" />
        <parameter name="@Tekst" value="#srcStavke.Text" />
      </data>
      <data command="spOOPStavkeDetQueryCP" name="dtDodatneStavke">
        <parameter name="@Action" value="Grid_dodatne" />
        <parameter name="@OOPStavkeId" value="$OOPStavkeId" />
      </data>
      <data command="spOOPStavkeDetAzurCP" name="dtSpremiStavku">
        <parameter name="@Action" value="Unos_dodatne" />
        <parameter name="@OOPStavkeId" value="$OOPStavkeId" />
        <parameter name="@OOPStavke2Id" value="#srcStavke" />
        <parameter name="@Koeficijent" value="#txtKoeficijent" type="decimal"/>
      </data>
      <data command="spOOPStavkeDetAzurCP" name="dtDelete">
        <parameter name="@Action" value="Brisanje_odnosne" />
        <parameter name="@SelectedIds" value="#grdDodatneStavke.selectedids" />
      </data>
      <data command="spOOPStavkeDetAzurCP" name="dtUpdate">
        <parameter name="@Action" value="Izmjena_odnosne"/>
        <parameter name="@OOPStavkeDetId" value="#grdDodatneStavke.@OOPStavkeDetId"/>
        <parameter name="@Value" value="#grdDodatneStavke.focusedvalue" type="decimal"/>
        <parameter name="@Kolona" value="#grdDodatneStavke.focusedfield"/>
      </data>
    </datalist>
  </form>

</root>