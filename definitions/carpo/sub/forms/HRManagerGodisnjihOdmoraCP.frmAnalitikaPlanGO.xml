<root version="1.0">
	<!--
  *******************************************************************************************
  FORMA ZA ANALITIKU PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
  -->
	<form name="frmAnalitikaPlanGO" caption="$caption" width="670" height="470">
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<layout>
			<group rows="3" cols="6" caption="Analitika plana GO za razdoblje">
				<item row="1" col="1" caption="Datum od" textposition="top" highlight="false">
					<dateedit name="dateDatumOd" datavalue="~dtGet.@DatumPrvi"/>
				</item>
				<item row="1" col="2" caption="Datum do" textposition="top" highlight="false">
					<dateedit name="dateDatumDo" datavalue="~dtGet.@datumZadnji"/>
				</item>
				<item row="1" col="3">
					<button name="btnPokazi" caption="Pokaži">
						<event type="click">
							<action type="datarun reader" value="~dtAnalitikaGO">
								<action type="control populate" value="#grdMasterAnalitika"/>
							</action>
						</event>
					</button>
				</item>
				<item row="1" col="4" colspan="3"/>
				<item row="2" col="1" colspan="6" rowspan="2">
					<grid name="grdMasterAnalitika" key="HRKadroviId" type="master" async="true" dataname="~dtMasterAnalitika" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" multiselect="true" savelayout="true" netgenfields="true" showgrouppanel="false">
						<fields inherited="true">
							<field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
						</fields>
					</grid>
				</item>
				<!--kraj omotača-->
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRGodisnjiAnalitikaCP" name="dtMasterAnalitika">
				<parameter name="@Action" value="dtGetAnalitikaPlanGO"/>
				<!--<parameter name="@HRKadroviId" value="parent.#grdMaster.@hrkadroviid"></parameter>-->
				<parameter name="@DatumOd" value="#dateDatumOd"/>
				<parameter name="@datumDo" value="#dateDatumDo"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spHRGodisnjiAnalitikaCP" name="dtGet">
				<parameter name="@action" value="dtGetDatumPrviZadnji"/>
				<parameter name="@godina" value="$Godina"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
</root>