	15.11.2018 PJ allownull=false na vrstadok
-->
<root>
	<form name="frmSklDonos" caption="Korekcija prometa" height="250" width="700">
		<event type="shown">
			<action type="datarun reader" value="~dtDatum"/>
			<action type="control value" value="#datDatum">
				<parameter value="~dtDatum.@Datum"/>
			</action>
		</event>
		<layout>
			<group cols="2" rows="3">
				<item col="1" row="1" caption="Skladište:">
					<combomultiedit name="cmbSkladiste" dataname="~dtSkladiste" valuefield="SkladisteId" displayfield="OznakaOpis"/>
				</item>
				<item col="1" row="2" caption="Odgovorna osoba:">
					<comboedit name="cmbOdgOsoba" dataname="~dtOsoba" valuefield="OsobeId" displayfield="Naziv"/>
				</item>
				<item col="1" row="3" caption="Vrsta dok:">
					<comboedit name="cmbVrstaDok" dataname="~dtVrstaDok" valuefield="VrstaDokId" displayfield="Opis" allownull="false"/>
				</item>
				<item col="2" row="1" caption="Org. Shema:">
					<comboedit name="cmbOrgShema" dataname="~dtOrgShema"  valuefield="OrgShemaId" displayfield="Naziv"/>
				</item>
				<item col="2" row="2" caption="Opis:">
					<textedit name="txtOpis"/>
				</item>
				<item col="2" row="3" caption="Datum:">
					<dateedit name="datDatum"/>
				</item>			
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="Stavke" image="rightend" imagelocation="middleright">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDonosPriprema">
							<parameter name="ID"/>
						</action>
						<action type="form open" value="frmDonos">
							<parameter name="ID" value="$ID"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDatum" command="spCRobnoKorekcijaGlaQuery_Jedan">
				<parameter name="@Action" value="1"/>
			</data>
			<data name="dtSkladiste" command="spSkladisteQueryCarpo">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtOsoba" command="spCKntPopuniKontrole">
				<parameter name="@Action" value="odgosobe"/>
				<parameter name="@Id" value="null"/>
			</data>
			<data name="dtOrgShema" command="spOrgShemaQueryCarpo">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtVrstaDok" command="spVrstaDokQueryCarpo">
				<parameter name="@Action" value="10"/>
				<parameter name="@ID" value="parent.$VrstaPrometa"/>
			</data>
			<data name="dtDonosPriprema" command="spCRobnoPrometKorekcija_DonosPripremaGla">
				<parameter name="@Skladista" value="#cmbSkladiste"/>
				<parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@OsobeId" value="#cmbOdgOsoba"/>
				<parameter name="@OrgDok" value="#txtOpis"/>
				<parameter name="@DatumDok" value="#datDatum"/>
			</data>
			
		</datalist>
	</form>
</root>