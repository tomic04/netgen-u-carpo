 <root>
 <form name="frmPromjenaStatusaIzmjena" caption="{$Naslov}">
    <event type="init">
      <action type="variable value">
        <parameter name="Naslov" value="$NaslovTekst"/>
      </action>
    </event>
    <event type="close">
      <action type="control disable" value="parent.#btnDodatno" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'" />
      <action type="control disable" value="parent.#btnSadrzaj" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'" />
      <action type="control disable" value="parent.#btnStavke" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'" />
      <action type="control disable" value="parent.#btnEditDetalj" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.#btnDelDetalj" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.#btnAddDetalj" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#cmbVrsta" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#txtBroj" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#datDatum" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#datVrijedido" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#cmbOrgShema" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#srcOsobe"  if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#srcPartner" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#btnParstru"  if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#srcParstru" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#cmbDinFak" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#cmbDinFak" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.prtManager.#txtOpis" if="parent.#grddetalj.@Korak=='Odobren'||parent.#grddetalj.@Korak=='Zaključen'"/>
      <action type="control disable" value="parent.#btnPromjeniStatus"  if="parent.#grddetalj.@Korak=='Zaključen'||parent.#grddetalj.@Korak=='Zaključen'" />
    </event>
    <layout>
      <group cols="1" rows="2">
        <item col="1" row="1" highlight="false" caption="Jeste li sigurni da želite promijeniti status?">
          <comboedit name="cmbStatus" displayfield="Korak" valuefield="StatusiId" dataname="dtStatus" allownull="false"/>
        </item>
        <item col="1" row="2" highlight="false" caption="Napomena:">
          <memoedit name="txtNapomena"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnPromijeni" caption="&amp;PROMIJENI">
          <event type="click">
              <action type="datarun nonquery" value="~dtZakljuci" if="$ZakljucakInd==1&amp;&amp;$IzPodloge==1"/>
            <action type="datarun nonquery" value="~dtZakljuci" elseif="$IzPodloge==0"/>
            <action type="control populate" value="parent.#grdDetalj" />
            <action type="form close" />
          </event>
        </button>
        <button name="btnOdustani" caption="&amp;ODUSTANI" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spStatusi_CARPO" name="dtStatus">
        <parameter name="@action" value="1" if="$ZakljucakInd==1"/>
        <parameter name="@action" value="2" else=""/>
        <parameter name="@tablica" value="KupUgovoriGla"/>        
        <parameter name="@operateriid" value="@@OperateriId" />
        <parameter name="@id" value="$KupUgovoriGlaId" type ="int" />
      </data> 
      <data command="spProd_kupUgovori_Zakljuci" name="dtZakljuci">
        <parameter name="@id" value="$KupUgovoriGlaID"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@statusiid" value="#cmbStatus"/>
        <parameter name="@napomena" value="#txtNapomena"/>
      </data>
      <data command="spProd_kupUgovori_Zakljuci" name="dtVrati">
        <parameter name="@id" value="$KupUgovoriGlaID"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@statusiid" value="#cmbStatus"/>
        <parameter name="@napomena" value="#txtNapomena"/>
      </data>

    </datalist>
  </form>
</root>