<root>
  <form name="frmUnosIzmjenaDet" type="master">
    
    <event type="shown">
      <action type="control disable" value=""/>
    </event>
    
    <layout>
      <group rows="24" cols="1">
        <item row="1" col="1" caption="Tip stavke">
          <comboedit name="cmbTipStavke"/>
        </item>
        <item row="2" col="1" caption="Utvrđena imovina">
          <checkedit name="chkUtvrdenaImovina" />
        </item>
        <item row="3" col="1" caption="Utvrđena imovina - razlog">
          <textedit name="txtUtvrdenaImovinaRazlog"/>
        </item>
        <item row="4" col="1" caption="IFRS16">
          <checkedit name="chkIFRS16"/>
        </item>
        <item row="5" col="1" caption="ID stavke">
          <textedit name="txtIdStavke"/>
        </item>
        <item row="6" col="1" caption="Opis">
          <memoedit name="memOpis"/>
        </item>
        <item row="7" col="1" caption="Partner za plaćanje">
          <searchedit name="srcPartner" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartnerNaziv" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtPartneri" />
        </item>
        <item row="8" col="1" caption="Site ID i naziv site-a">
          <comboedit name="cmbSiteIdNaziv" />
        </item>
        <item row="9" col="1" caption="Opcija i naziv opcije">
          <comboedit name="cmbOpcijaInaziv"/>
        </item>
        <item row="10" col="1" caption="Ugovoreni iznos">
          <textedit name="txtUgovoreniIznos" format="n2"/>
        </item>
        <item row="11" col="1" caption="Valuta">
          <comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="#dtGet.@DevValuteId" dataname="~dtValuta" />
        </item>
        <item row="12" col="1" caption="Datum početka plaćanja">
          <dateedit name="datDatumPocetkaPlavanja" />
        </item>
        <item row="13" col="1" caption="Način plaćanja">
          <radioedit name="rbNacinPlacanjaUnaprijed" caption="Unaprijed"/>
        </item>
        <item row="14" col="1" caption="">
          <radioedit name="rbNacinPlacanjaRate" caption="Na rate"/>
        </item>
        <item row="15" col="1" caption="Period plaćanja">
         <comboedit name="cmbPeriodPlacanja" />
        </item>
        <item row="16" col="1" caption="Index">
         <comboedit name="cmbIndex" />
        </item>
        <!--<item row="17" col="1" caption="Odgovorna osoba">
          <searchedit name="srcOsobe" fieldtext="Osoba" fieldvalue="OsobeId" dataname="~dtOdgovornaOsoba" datavalue="~dtGet.@OsobeId" datatext="~dtGet.@OsobaNaziv"/>
        </item>
        <item row="18" col="1" caption="Org shema">
          <comboedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv" dataname="~dtGetOrgShema" datavalue="~dtGet.@OrgShemaId" />
        </item>
        <item row="19" col="1" caption="Zaseban ugovor za struju">
          <checkedit name="chkZasebanUgovor" />
        </item>
        <item row="20" col="1" caption="UVJETNA KONTROLA">
          <textedit name="txtZasebanUgovor"/>
        </item>
        <item row="21" col="1" caption="Ugovor produljen do">
          <dateedit name="dateUgovorProduljenDo"/>
        </item>
        <item row="22" col="1" caption="Prethodni ugovor">
          <textedit name="txtPrethodniUgovor"/>
        </item>
         <item row="23" col="1" caption="Zamjenski ugovor">
          <textedit name="txtZamjenskiUgovor"/>
        </item>
         <item row="24" col="1" caption="Broj ugovora za struju">
          <textedit name="txtBrojUgovoraZaStruju"/>
        </item>-->
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="1"/>
        <button name="1"/>
        <button name="1"/>  
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spNG_Combo" name="dtValuta">
        <parameter name="@Action" value="valute" />
        <parameter name="@Ind" value="1" />
        <parameter name="@Oznaka" value="OznakaNaziv" />
      </data>
      <data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
    </datalist>
  </form>
</root>