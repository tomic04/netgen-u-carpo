<root>

  <!--******************************************UNOS / IZMJENA Klase****************************************-->
  <form name="frmOSImovinaKlasa" caption="$Caption" fixedsize="false" width="450" >
    
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSImovinaKlaseId!=0"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="1"  spacing="2,2,2,2">
        <item caption="Klasa:" row="1" col="1" highlight="false">
          <comboedit name="cmbKlase" valuefield="OSKlaseId" displayfield="Naziv" datavalue="~dtGet.@OSKlaseId" dataname="~dtKlase" allownull="false"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" >
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSImovinaKlaseId!=0"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdKlase"/>
            <action type="control refreshvalue" value="parent.#grdImovina"/>
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaKlase_CP" name="dtKlase">
        <parameter name="@Action" value="Klase_combo"/>
      </data>
      <data command="spOSImovinaKlase_CP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSKlaseId" value="#cmbKlase"/>
      </data>
      <data command="spOSImovinaKlase_CP" name="dtEdit">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@OSImovinaKlaseId" value="$OSImovinaKlaseId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSKlaseId" value="#cmbKlase"/>
      </data>
      <data command="spOSImovinaKlase_CP" name="dtGet">
        <parameter name="@Action" value="Popuni_klasa"/>
        <parameter name="@OSImovinaKlaseId" value="$OSImovinaKlaseId"/>
      </data>
   
     
    </datalist>
  </form>
  <!--*******************************************KRAJ UNOS / IZMJENA Klase**************************************************-->
</root>