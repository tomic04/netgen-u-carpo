<root>
    <form name="frmPrikazDok" caption="Prikaz dokumenta" fixedsize="false" width="500" height="570">
		<event type="onload">	
			<action type="control populate" value="#grdStavkeDok"></action>		
			<action type="datarun reader" value="dtPolja"/>
            <action type="control value" value="#txtBrojDok">
                <parameter value="~dtPolja.@Broj"  />
            </action>
            <action type="control value" value="#txtPartner">
                <parameter value="~dtPolja.@Partner"  />
            </action>	
            <action type="control value" value="#datDatumDok">
                <parameter value="~dtPolja.@DatumDok"  />
            </action>
            <action type="control value" value="#cmbSkladiste">
                <parameter value="~dtPolja.@SkladisteId"  />
            </action>			
		</event>	
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols ="1" rows="2" groupbordervisible="False">
					<group cols ="2" rows="2" col="1" row="1" groupbordervisible="False">
						<columnsdefinition>
							<column size="40%" position="1" />
							<column size="60%" position="2" />
						</columnsdefinition>
						<item caption="Broj dokumenta:" row="1" col="1" >
							<textedit name="txtBrojDok" enabled="false"/>
						</item>
						<item caption="Partner:" row="1" col="2" textvisible="True">
							<textedit name="txtPartner" enabled="false"/>
						</item>
						<item caption="Datum dokumenta:" row="2" col="1" >
							<dateedit name="datDatumDok" enabled="false"/>
						</item>
						<item caption="Skladište:" row="2" col="2" textvisible="True">
							<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" datavalue="#dtPolja.@skladisteid" dataname="Global.dtSkladiste" enabled="false"/>
						</item>						
					</group>
                    <item row="2" col="1" colspan="2">
                        <grid name="grdStavkeDok" async="true" dataname="dtGrid" multiselect="true">
                            <fields>
                                <field name="Sifra" caption="Šifra" />
                                <field name="Roba" caption="Naziv" />
								<field name="JM" caption="JM" />
                                <field name="Količina ulaz" caption="Količina ulaz" formatstring="n3"/>
								<field name="Količina izlaz" caption="Količina izlaz" formatstring="n3"/>
                            </fields>					  
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="Zatvori" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spDokumentPrikaz" name="dtGrid">
                <parameter name="@action" value="1" />
                <parameter name="@id" value="parent.#grdKartica.@DokumentId" />
				<parameter name="@tablica" value="parent.#grdKartica.@Tablica" />
            </data>
            <data command="spDokumentPrikaz" name="dtPolja">
                <parameter name="@action" value="0" />
                <parameter name="@id" value="parent.#grdKartica.@DokumentId" />
				<parameter name="@tablica" value="parent.#grdKartica.@Tablica" />
            </data>	
        </datalist>
    </form>
</root>