<root>
	<!--
  Komentari:
  01.10.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmUnos" caption="$caption" width="650" height="200" fixedsize="true" >
		<layout>
				<group rows="2" cols="4" spacing="2,2,2,2" >

					<item row="1" col="1" caption="Ime:" highlight="false" >
						<textedit name="txtIme" required="true"/>
					</item>
					<item row="1" col="2" caption="Ime roditelja:" highlight="false" >
						<textedit name="txtImeR"  />
					</item>
					<item row="1" col="3" caption="Matični broj:" highlight="false" >
						<textedit name="txtMaticniBroj" allownull="false" required="true" datavalue="" />
					</item>
					<item row="1" col="4" highlight="false" >
						<button name="btnMaticniBroj" caption="Novi matični broj"  > 
							<event type="click">     
								<action type="datarun reader" value="dtMaticniBroj">

									<action type="control value" value="#txtMaticniBroj" >
										<parameter value="~dtMaticniBroj.@maticnibroj" />
									</action>
<action type="control value" value="#txtIdentBroj" >
										<parameter value="~dtMaticniBroj.@i_dentbroj" />
									</action>
								</action>						 
							</event>  
						</button>
					</item>
					<item row="2" col="1" highlight="false" caption="Prezime:" colspan="2">
						<textedit name="txtPrezime" required="true"  />
					</item>
					<item  row="2" col="3" caption="Datum dolaska:" highlight="false" >
						<dateedit name="dtDatumDolaska" required="true"  value="now"   />
					</item>
					<item row="2" col="4" caption="Ident. broj:" highlight="false" >
						<textedit name="txtIdentBroj" />
					</item>
				</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$hrkadroviid==0">
							<action type="datarun reader" value="~dtUnosDjelatnika">
								<action type="control populate" value="parent.#grdMaster">
									<action type="control focus" value="parent.#grdMaster">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
							<!-- <action type="control enable" value="parent.#btnUnos,parent.#btnIzmjena"/> -->
						</action>
						<action if="$indGreske==0">
						<action type="variable value" value="global.$HRKadroviId">
							<parameter value="$noviID" type="int"/>
						</action>
						<action type="control refreshvalue" value="##" />
						
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>	
							<action type="form open" value="frmGrupaPodataka"> 
							<parameter name="Tip" value="Izmjeni"/>
							<parameter name="HRKadroviId" value="$noviID"/>
							<parameter name="caption" value="Izmjena"/>  						
						</action>
</action>						
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
		<data command="spHRHelp" name="dtMaticniBroj">
				<parameter name="@action" value="novi_maticni_broj" />
			</data>
			<data command="spHRManagerMasterAzurCP" name="dtUnosDjelatnika">
				<parameter name="@action" value="unos_kadra"/>
				<parameter name="@hrkadroviid.output.int" variablename="noviID"/>
				<parameter name="@ime" value="#txtIme"/>
				<parameter name="@prezime" value="#txtPrezime"/>
				<parameter name="@maticnibroj" value="#txtMaticniBroj"/>
				<parameter name="@imeroditelja" value="#txtImeR"/>
				<parameter name="@datumdolaska" value="#dtDatumDolaska"/>
				<parameter name="@IdentBroj" value="#txtIdentBroj"/>
				<parameter name="@indGreske.output.int"/>				
			</data>
		</datalist>
	</form>

</root>