									<event type="valuechanged">
										<action type="datarun reader" value="~dtDajIznos">
											<action type="control value" value="#txtIznos">
												<parameter value="~dtDajIznos.@Iznos"/>
											</action>
										</action>
									</event>
								</textedit>
							</item>
							<item row="4" col="1" caption="Iznos u valuti:" highlight="false" textposition="top" colspan="1">
								<textedit name="txtIznosVal" format="n2" value="0" datavalue="~dtGet.@IznosVal">
