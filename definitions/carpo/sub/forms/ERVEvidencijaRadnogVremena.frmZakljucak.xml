<root>
	<!--FORMA ZA UNOS -->
	<!--
  Komentari:
  11.08.2021. Jadranka Vučenović Vojvodić - kreirala formu ver 1.0.
  -->
	<form name="frmZakljucak" caption ="$Caption" width="650" height="500" saveformsize="false" fixedsize="true" showversion="true" version="1" >
		<event type="load">
			<action type="control populate" value="#grdZakljucak" ></action>
			<action type="control value" value="#txtGodina" >
				<parameter value="$godina" />
			</action>
			<action type="control value" value="#cmbMjesec" >
				<parameter value="$mjesec" />
			</action>
		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<!--1. red-->
				<group cols="4" rows="8" col="1" row="1" spacing="2,2,2,1">
					<item caption="" col="1" row="1" highlight="false">
						<radioedit name="rdoAktivni" caption="Aktivni zaključci" value="true">
							<event type="checkedchanged">
								<action type="control populate" value="#grdZakljucak"/>
							</event>
						</radioedit>
					</item>
					<item caption="" col="2" row="1" highlight="false">
						<radioedit name="rdoPovijest" caption="Povijest" >
							<event type="checkedchanged">
								<action type="control populate" value="#grdZakljucak"/>
							</event>
						</radioedit>
					</item>
					<item caption="" col="1" row="2" rowspan="7" colspan="4" highlight="false">
						<grid name="grdZakljucak" key="dneev_zakid" dataname="~dtAktivni" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" savelayout="true" multiselect="true">
							<fields inherited="true">
							</fields>
						</grid>
					</item>
				</group>
				<group cols="5" rows="1" col="1" row="2" spacing="2,2,1,2" caption="Unos zaključka mjeseca:">
					<columnsdefinition>
						<column position="1" size="15%"/>
						<column position="2" size="15%"/>
						<column position="3" size="20%"/>
						<column position="4" size="25%"/>
						<column position="5" size="25%"/>
					</columnsdefinition>
					<item row="1" col="1" caption="Godina:" highlight="false" textposition="top">
						<textedit name="txtGodina" maxlength="4" required="true"/>
					</item>
					<item caption="Mjesec:" col="2" row="1" highlight="false" >
						<comboedit name="cmbMjesec" valuefield="mjesec" displayfield="naziv" dataname="~dtMjesec" required="true" allownull="false"/>
					</item>
					<item caption="Datum:" col="3" row="1" textposition="top" highlight="false">
						<dateedit name="dateDatumOd" value="now" datavalue=""/>
					</item>
					<item row="1" col="4" highlight="false" >
						<button name="btnSpremi" caption="Spremi">
							<event type="click">
								<action type="validate"/>	
							    <action type="datarun reader" value="~dtAddZakljucak">
									<action type="control populate" value="#grdZakljucak">
										<action type="control focus" value="#grdZakljucak">
											<parameter value="$noviID"/>
										</action>
									</action>
								</action>
								<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!" />
							</action>
							</event>
						</button>
					</item>
					<item row="1" col="5" highlight="false">
						<button name="btnOdustani" caption="Odustani">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
			</group>
		</layout>
		<datalist>
			<data command="spERV_Zakljucak" name="dtAktivni">
				<parameter name="@action" value="zakljucak_aktivni" if="#rdoAktivni==true"></parameter>
				<parameter name="@action" value="zakljucak_povijest" else=""></parameter>
			</data>
			<data command="spERV_Zakljucak" name="dtMjesec">
				<parameter name="@action" value="cmbMjesec" />
			</data>
			<data command="spERV_Zakljucak" name="dtAddZakljucak">
				<parameter name="@action" value="unos_zakljucak" />
				<parameter name="@dneev_zakid.output.int" variablename="$noviID" />
				<parameter name="@godina" value="#txtGodina"/>
				<parameter name="@mjesec" value="#cmbMjesec"/>
				<parameter name="@datumzak" value="#dateDatumOd"/>
				<parameter name="@operateriid" value="$OperateriId"/>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>
</root>