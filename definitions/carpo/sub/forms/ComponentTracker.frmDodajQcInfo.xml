<root>
	<form name="frmDodajQcInfo" caption="Unos">
        <event type="load">
            <action type="datarun reader" value="~dtGetLogin"/>
            <action type="datarun reader" value="~dtDanasnjiDatum"/>
            <action type="control value" value="#txtOperater">
                <parameter value="~dtGetLogin.@Login" />
            </action>
            <action type="control value" value="#dateDateReviewed">
                <parameter value="~dtDanasnjiDatum.@Date" />
            </action>
        </event>
        <layout>
            <group cols="1" rows="3">
                <item row="1" col="1" caption="Zapažanje">
                    <memoedit name="memoZapazanje" />
                </item>
                <item row="2" col="1" caption="Operater">
                    <textedit name="txtOperater" enabled="false"/>
                </item>
                <item row="3" col="1" caption="Datum pregleda">
                    <dateedit name="dateDateReviewed"/>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnSpremi" caption="Spremi">
                    <event type="click">
                        <action type="variable value" value="$versionTestId">
                            <parameter value="null"/>
                        </action>
                        <action type="datarun scalar" value="~dtDodajQc">
                            <parameter name="versionTestId"/>
                        </action>
                        <action type="control populate" value="parent.#grdQC">
                            <action type="control focus" value="parent.#grdQC">
                                <parameter name="VersionTestId" value="$versionTestId" type="int"/>
                            </action>
                        </action>
                        <action type="formclose" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani">
                    <event type="click">
                        <action type="formclose" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTrackerAzur" name="dtDodajQc">
                <parameter name="@Action" value="addQc" />
                <parameter name="@VersionId" value="global.$versionId"/>
                <parameter name="@Memo" value="#memoZapazanje" />
                <parameter name="@datPublishDate" value="#dateDateReviewed" />
            </data>
            <data command="spComponentTracker" name="dtGetLogin">
                <parameter name="@Action" value="getLogin" />
            </data>
            <data command="select GETDATE() as Date" name="dtDanasnjiDatum" type="text"/>
        </datalist>
    </form>
</root>