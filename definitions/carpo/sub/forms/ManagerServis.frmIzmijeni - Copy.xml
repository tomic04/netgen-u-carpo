					<action type="control enable" value="#btnVratiStatus" if="parent.#grdMaster.@StatusiId!=global.$MinStatus||parent.#grdMaster.@Z!=1"/>
					<action type="control enable" value="#btnVratiStatus" if="parent.#grdMaster.@countdet==0&amp;&amp;parent.#grdMaster.@StatusiId==14"/>	
					<action type="control disable" value="#btnVratiStatus" if="parent.#grdMaster.@StatusiId==global.$MinStatus||parent.#grdMaster.@Z==1"/>
					<action type="control disable" value="#btnVratiStatus" if="parent.#grdMaster.@StatusiId==14&amp;&amp;parent.#grdMaster.@countdet==1"/> 					
