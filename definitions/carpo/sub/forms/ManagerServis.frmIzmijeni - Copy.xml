			 <action type="control enable" value="#cmbModel" elseif="global.$countdet37==0"/> -->
			<action type="control disable" value="##" if="parent.#grdMaster.@Zakljuceno==1||parent.#grdMaster.@Smije==0"/>
			<action type="control enable" value="#grdDetail"/>
