<root>

  <!--******************************************UNOS / IZMJENA DODATNIH PODATAKA****************************************-->
  <form name="frmOSImovinaDodatni" caption="$Caption" fixedsize="false" width="450" >
    
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSImovinaDodPodaciId!=0"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="2" spacing="2,2,2,2" >
        <item caption="Opis:" row="1" col="1" highlight="false">
          <comboedit name="cmbDodatni" valuefield="OSDodPodaciId" displayfield="Opis" datavalue="~dtGet.@OSDodPodaciId" dataname="~dtDodatni" allownull="false"/>
        </item>
        <item caption="Vrijednost:"  row="2" col="1" >
          <memoedit name="txtVrijednost" datavalue="~dtGet.@Vrijednost" textposition="left"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" >
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSImovinaDodPodaciId!=0"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdDodatni"/>
          </event>
        </button>
        <button caption="Izlaz" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaDodatni_CP" name="dtDodatni">
        <parameter name="@Action" value="Dodatni_combo"/>
      </data>
      <data command="spOSImovinaDodatni_CP" name="dtGet">
        <parameter name="@Action" value="Dodatni_popuni"/>
        <parameter name="@OSImovinaDodPodaciId" value="$OSImovinaDodPodaciId"/>
      </data>
      <data command="spOSImovinaDodatni_CP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSDodPodaciId" value="#cmbDodatni"/>
        <parameter name="@Vrijednost" value="#txtVrijednost"/>
      </data>
      <data command="spOSImovinaDodatni_CP" name="dtEdit">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@OSImovinaDodPodaciId" value="$OSImovinaDodPodaciId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSDodPodaciId" value="#cmbDodatni"/>
        <parameter name="@Vrijednost" value="#txtVrijednost"/>
      </data>
        
    </datalist>
  </form>
  <!--*******************************************KRAJ UNOS / IZMJENA DODATNIH PODATAKA**************************************************-->
</root>