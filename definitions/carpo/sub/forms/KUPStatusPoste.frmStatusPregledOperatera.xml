<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmStatusPregledOperatera" type="master" caption="Operateri :: {$Tekst}" statusbar="false">
    <event type="init">
    </event>
    <event type="shown">
        
    </event>

    <layout textposition="left" itemspadding="3">
      <group cols="4" rows="1" col="1" row="1">
          <item caption="Operater:" row="1" col="1" colspan="3">
            <comboedit name="cmbOperater" valuefield="OperateriId" displayfield="Naziv" datavalue="#dtGet.@OperateriId" dataname="dtOperateri" required="True"/>
          </item>
          <item caption="Admin" row="1" col="4" textalignmode="" textposition="right" highlight="false" >
            <checkedit name="chkAdmin" value="0"/>
          </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="datarun scalar" value="~dtInsert">
              <parameter name="parent.$NoviOperateriId" />
            </action>
            <action type="form close"/>
            
            <action type="control populate" value="parent.#grdTabOperateri">
              <action type="control focus" value="parent.#grdTabOperateri">
                <parameter value="parent.$NoviOperateriId" />
              </action>
            </action>

          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spCKUPStatusOperateri" name="dtOperateri">
        <parameter name="@ID" value="$KUPStatusId"/>
      </data>

      <data command="spCKUPStatusPosteAzur" name="dtInsert">
        <parameter name="@action" value="unosoperater"/>
        <parameter name="@KUPStatusId" value="$KUPStatusId" type="int"/>
        <parameter name="@OperateriId" value="#cmbOperater" type="int"/>
        <parameter name="@Admin" value="#chkAdmin"/>
      </data>

    </datalist>
  </form>
</root>
