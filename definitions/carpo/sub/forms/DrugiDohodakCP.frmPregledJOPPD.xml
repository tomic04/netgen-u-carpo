<root>
  <!--FORMA ZA UNOS/IZMJENU OBRADE-->

  <form name="frmPregledJOPPD" caption="$caption" width="800" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtGridGore"></action>
      <action type="datarun reader" value="~dtGridDolje"></action>
    </event>

    <event type="load">
      <action type="control populate" value="#grdGore"></action>
      <action type="control populate" value="#grdDolje"></action>

    </event>

    <layout>
      <group cols="1" rows="10" groupbordervisible="false">

        <item caption="Pregled A strane" col="1" row="1" rowspan="2" textposition="top">
          <grid name="grdGore" key="KODJOPPDAId" dataname="~dtGridGore" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
            <fields inherited="true"></fields>
          </grid>
        </item>
        <item caption="Pregled B strane" col="1" row="3" rowspan="7" textposition="top">
          <grid name="grdDolje" dataname="~dtGridDolje" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="true" showgroupsum="true" showfooter="true">
            <fields inherited="true">
              <field name="Rbr. (1)" showtotalsum="false" />

            </fields>
          </grid>
        </item>
        <item col="1" row="10" textposition="right" highlight="False">
          <checkedit name="chkSamoOdabrani" caption="prikaži samo odabrane">
            <event type="checkedchanged">
              <action type="control populate" value="#grdDolje"></action>
            </event>
          </checkedit>
        </item>
      </group>


      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spDDPregledJOPPD_CP" name="dtGridGore">
        <parameter name="@Action" value="glave" type="string" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@oopisobradeid" value="global.$OOPisObradeId" />
      </data>

      <data command="spDDPregledJOPPD_CP" name="dtGridDolje">
        <parameter name="@Action" value="detalji" type="string" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@kodjoppdaid" value="#grdGore.@KODJOPPDAId" />
        <parameter name="@selectedids" value="$selectedids" type="string" />
        <parameter name="@indSamoOdabrani" value="1" if="#chkSamoOdabrani==true" />
        <parameter name="@indSamoOdabrani" value="0" elseif="#chkSamoOdabrani==false" />
      </data>

    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>