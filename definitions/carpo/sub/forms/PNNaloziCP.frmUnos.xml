	<form name="frmUnosKadar" caption="$caption" width="700" height="750" fixedsize="false">
		<event type="init">
			<action type="datarun reader" value="~dtGetPutniNalog" if="$PNNaloziId!=0"/>
			<action type="datarun reader" value="~dtGetIspis"/>			
		</event>
		<event type="shown">
		
		
			<action type="control value" value="#srcDjelatnik">
				<parameter text="~dtGetPutniNalog.@caphrkadroviid" value="~dtGetPutniNalog.@hrkadroviid"/>
			</action>
			<action type="control value" value="#cmbStatusi">
				<parameter text="~dtGetPutniNalog.@pnstatusiid" value="~dtGetPutniNalog.@pnstatusiid"/>
			</action>
			
			<action type="control disable" value="#txtBrojNaloga" if="global.$PravoIzmjeneBroja==0">
			</action>
			<action type="control value" value="#srcMjesta">
				<parameter text="~dtGetPutniNalog.@capmjestaid" value="~dtGetPutniNalog.@Mjestaid"/>
			</action>
			<action type="control value" value="#srcPartner">
				<parameter text="~dtGetPutniNalog.@cappartneriid" value="~dtGetPutniNalog.@partneriid"/>
			</action>
			<action type="control visible" value="#cmbVrstaNaloga,#cmbBanka,#cmbTecaj,#cmbNacinIsplate,#cmbDimenzija">
				<parameter value="false"/>
			</action>	
			<action if="$PNNaloziId==0">
				<action type="control visible" value="#cmbStatusi,#btnStatus,#btnIspisNaloga,#btnIspisObracuna">
					<parameter value="false"/>
				</action>	
				<action type="control value" value="#txtBrojDana">
					<parameter value="1"/>
				</action>
				<!-- ako je unos i osoba ima pravo unijeti samo za 1 osobu, onda joj odmah popuni tražilicu!! -->
				<action if="global.$PravaKadrovaOperater==1">
					<action type="datarun reader" value="~dtGetPrviKadar"/>
					<action type="control value" value="#srcDjelatnik">
						<parameter value="~dtGetPrviKadar.@hrkadroviid" text="~dtGetPrviKadar.@radnik"/>
					</action>
				</action>
			</action>
			
		</event>
