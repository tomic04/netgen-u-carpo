<root version="1.0.0.1">
<!-- u layout formi ne mora biti type master -->
<!-- pozivanje frome iz drugog xmla paziti na ime forme -->
	<form name="frmPoveziOtpremnice" caption="Tražilica skl.dokumenata" statusbar="false">

		<event type="init">
			<action type="datarun reader"  value="~dtGetDataPoveziSklDok" />
			<!-- <action type="message"  value="~dtGetDataPoveziSklDok.@partneriid"/> -->
										
			
		</event>
	
		
		
		<event type="shown">
							<action type="control value"  value="#srcBrojSklDok">
							<parameter value="~dtGetDataPoveziSklDok.@SktPrometGlaId" text="~dtGetDataPoveziSklDok.@SktPrometGlaId" ></parameter>
					</action> 
				</event>

	
	<layout textposition="left">
			<group cols="1" rows="4" > 
				
	
				
					<!-- <item col="1" row="1" caption="Broj skladišnog dokumenta:" fontsizedelta="2" textvisible="false" > -->
						<!-- <textedit  name="txtBrojSklDok" valuefield="BrojSklDok" displayfield="Naziv" dataname="~dtGetDataPoveziSklDok.@BrojSklDok" fontsizedelta="2" textposition="right" allownull="true"/> -->
						<!-- <event type="click"> -->
						<!-- <action type="search" value="~dtSearch"> -->
						<!-- </action> -->
					<!-- </event>  -->
					<!-- </item> -->
					
				<item row="1" col="1"  caption="Broj skladišnog dokumenta:" fontsizedelta="1">
					<searchedit  name="srcBrojSklDok"  fontsizedelta="1" fieldtext="BrojDokumenta"  required="true" fieldvalue="SktPrometGlaId" dataname="~dtGetBrojSklDok"  textposition="right" tabindex="1">
						<event type="valuechanged">
							<action type="variable value">
								<parameter name="SktPrometGlaId" value="#srcBrojSklDok"/>
							</action>
														
						</event>
						<event type="leave">	
										<!--Čitam podatak-->
										<!-- <action type="datarun reader"  value="~dtGetBrojSklDok" ></action>  -->
										<!-- Punim kontrolu  -->
										<action type="control value" value="#txtPartner">
											<parameter  value="#srcBrojSklDok.@Partner" />
										</action>	
										<action type="control value" value="#datDatumDok">
											<parameter  value="#srcBrojSklDok.@DatumDokumenta" />
										</action>
										<action type="control value" value="#curIznos">
											<parameter  value="parent.#curIznos" />
										</action>
										<!-- <action type="control focus" value="#datDatumDok"> -->
											<!-- <parameter value="#srcBrojSklDok.@DatumDokumenta" /> -->
										<!-- </action>										 -->
								</event>
						
					</searchedit>
				</item>
					
					<item col="1" row="2" caption="Partner:" fontsizedelta="2" textvisible="false" readonly="true">
						<textedit  name="txtPartner" valuefield="Partner" displayfield="Naziv" dataname="~dtGetBrojSklDok.@Partner" fontsizedelta="2" textposition="right"  allownull="true"/>

					</item>	
					<item col="1" row="3" caption="Datum:" fontsizedelta="2" textvisible="false" readonly="true">
						<textedit  name="datDatumDok" valuefield="DatumDokumenta" displayfield="Datum" dataname="~dtGetBrojSklDok.@DatumDokumenta" fontsizedelta="2" textposition="right"  allownull="true"/>

					</item>						
					

					
					<item col="1" row="4"  caption="Iznos:" fontsizedelta="2" >
						<textedit name="curIznos" value="0" format="n2"   textposition="right" tabindex="2">
						</textedit>
					</item>
									



		
			</group>
			
		</layout>
	
	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">			
				<event type="click">
				<!-- NASTAVAK -->
					<action type ="datarun scalar" value="~dtSpremiPoveznicu">
						<parameter name="$SktPrometGlaid" ></parameter>
					</action>
					<action type="control populate" value="parent.#grdPovezanaOtprema"/>
					<action type="control focus" value="parent.#grdPovezanaOtprema">
						<parameter value="$lnUfaOtpremniceId"/>
					</action>
					
					<!-- zatvaranje forme -->
					<action type="form close" value="frmPoveziOtpremnice"> </action>	
					<action type="form open" value="frmPoveziOtpremnice"/>
					<!-- popuni varijablu i fokusiraj se na spremljeni podatak, paziti na varijablu u parent formi tj odakle se poziva -->
			
					
				</event>
				
				
			</button>

				<button  name="btnOdustani" caption="Odustani" type="cancel">
					<!-- <action type="control populate" value="#grdStavke"> -->
						<!-- <action type="control focus" value="#grdStavke"> -->
							<!-- <parameter value="$Fakturedobid" /> -->
						<!-- </action> -->
					<!-- </action> -->

			</button>
		</buttons>
	</panelbuttons>
	<!-- dohvat podataka -->

			<datalist>

		
			<data name="dtGetBrojSklDok" command="spCKntUfaOtpremaQuery">
				 <parameter name="@action" value="4"></parameter> 
				 <parameter name="@BrojSklDok" value="#srcBrojSklDok.text"></parameter> 

			</data>	
<!-- NASTAVAK -->
			<data name="dtSpremiPoveznicu" command="spCKntUfaOtpremaAzur">
				 <parameter name="@action" value="1"></parameter> 
				 <parameter name="@SktPrometGlaid" value="$SktPrometGlaId"></parameter> 
				 <parameter name="@Fakturedobid" value="global.$FaktureDobId"></parameter> 
				 <parameter name="@Iznos" value="#curIznos"></parameter> 

			</data>
		
		
		</datalist>
	

	</form>
	

</root>