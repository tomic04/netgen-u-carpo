<root>
  <form name="frmAzur" caption="Korekcija prometa" height="300" width="700">
    <event type="shown">
      <action type="control disable" value="#txtBroj"/>
      <action type="datarun reader" value="~dtDatum"/>
      <action type="control value" value="#datDatum">
        <parameter value="~dtDatum.@Datum"/>
      </action>
    </event>
    <layout>
      <part name="prtUnosMaster" path="prtKorekcijaStanjaRobno.xml"/>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnStavke" caption="Stavke" image="rightend" imagelocation="middleright">
          <event type="click">
            <action type="validate"/>
            <action type="datarun scalar" value="~dtUnosMaster">
              <parameter name="SktPrometGlaId"/>
              <parameter name="Broj"/>
            </action>
            <action type="form close"/>
            <action type="form open" value="frmStavke">
              <parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
              <parameter name="Filter" value="$Filter"/>
            </action>
          </event>
        </button>
        <button name="btnCancel" caption="Odustani" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtIniSkladiste" command="spCRobnoKorekcijaGlaQuery_Jedan">
        <parameter name="@Action" value="2"/>
        <parameter name="@Id" value="#cmbSkladiste"/>
      </data>
      <data name="dtDatum" command="spCRobnoKorekcijaGlaQuery_Jedan">
        <parameter name="@Action" value="1"/>
      </data>
      <data name="dtSkladiste" command="spSkladisteQueryCarpo">
        <parameter name="@Action" value="0"/>
      </data>
      <data name="dtOsoba" command="spCKntPopuniKontrole">
        <parameter name="@Action" value="odgosobe"/>
        <parameter name="@Id" value="null"/>
      </data>
      <data name="dtOrgShema" command="spOrgShemaQueryCarpo">
        <parameter name="@Action" value="0"/>
      </data>
      <data name="dtVrstaDok" command="spVrstaDokQueryCarpo">
        <parameter name="@Action" value="10"/>
        <parameter name="@ID" value="parent.$VrstaPrometa"/>
      </data>
      <data name="dtUnosMaster" command="spSklad_SktPrometGla_Insert">
        <parameter name="@VrstaDokId" value="#cmbVrstaDok"/>
        <parameter name="@OrgShemaId" value="#cmbOrgShema"/>
        <parameter name="@DatumDok" value="#datDatum"/>
        <parameter name="@OperateriId" value="@@operateriid"/>
        <parameter name="@SkladisteId" value="#cmbSkladiste"/>
        <parameter name="@OsobeId" value="#cmbOdgOsoba"/>
        <parameter name="@OrgDok" value="#txtOpis"/>
      </data>
    </datalist>
  </form>
</root>