<root>
	<!--FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->

	<form name="frmBrisanjeDetaljaMulti" caption ="$caption" width="850" height="650"  fixedsize="true" saveformsize="false" showversion="true" version="1" statusbar="true">
		<!--<event type="init">
      <action type="datarun reader" value="~dtNapuniTemp" />
      <action type="variable value">
        <parameter name="StavkaId" value="0" type="int"/>
      </action>
    </event>-->
		<event type="shown">
			<action type="datarun reader" value="~dtNapuniTemp" />
			<action type="datarun reader" value="~dtStavke" />
			<action type="control populate" value="#grdOstali" />
			<action type="control populate" value="#grdOdabrani" />
			<action type="control populate" value="#grdStavke" />
			<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount} | Broj stavaka: {#grdStavke.rowcount}"/>
		</event>

		<layout>
			<group cols="3" rows="6" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="45%"></column>
					<column position="2" size="10%"></column>
					<column position="3" size="45%"></column>
				</columnsdefinition>
				<group col="1" row="1" cols="1" rows="8" rowspan="3" spacing="2,1,2,1" caption="Djelatnici na obradi">
					<item col="1" row="1" rowspan="8">
						<grid name="grdOstali" key="OOPObradeGlaId" dataname="dtOstali" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

						</grid>
					</item>
				</group>

				<group col="2" row="1" cols="1" rows="8" rowspan="3" spacing="1,1,2,1">
					<rowsdefinition>
						<row position ="3" size="30"/>
						<row position ="4" size="30"/>
						<row position ="5" size="30"/>
					</rowsdefinition>
					<item col="1" row="4" rowspan="1">
						<button image="right" caption="" imagelocation="bottomcenter" name="btnPrebaciDesno">
							<!--na klik prebaci selectedids iz grdgore i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciDesno"/>
								<action type="control populate" value="#grdOstali"/>
								<action type="control populate" value="#grdOdabrani"/>
								<action type="control populate" value="#grdStavke"/>
								<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount} | Broj stavaka: {#grdStavke.rowcount}"/>
							</event>
						</button>
					</item>
					<item col="1" row="5" rowspan="1">
						<button image="left" caption="" imagelocation="bottomcenter" name="btnPrebaciLijevo">
							<!--na klik prebaci selectedids iz grdgore i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciLijevo"/>
								<action type="control populate" value="#grdOstali"/>
								<action type="control populate" value="#grdOdabrani"/>
								<action type="control populate" value="#grdStavke"/>
								<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount} | Broj stavaka: {#grdStavke.rowcount}"/>
							</event>
						</button>
					</item>
				</group>

				<group col="3" row="1" cols="1" rows="8" rowspan="3" spacing="1,2,2,1" caption="Odabrani djelatnici">
					<item col="1" row="1" rowspan="8" >
						<grid name="grdOdabrani" key="OOPObradeGlaId" dataname="dtOdabrani" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

						</grid>
					</item>
				</group>

				<group col="1" row="4" cols="1" rows="1" spacing="2,2,1,2" rowspan="3" colspan="3" caption="Stavke:" >
					<group col="1" row="1" cols="1" rows="1" groupbordervisible="false">
						<item col="1"  row="1" >
							<grid name="grdStavke" key="OOPObradeDetId"  dataname="dtStavke" bestfitonrefresh="true" fieldsmartspaces="true" multiselect="true" showautofilterrow="true" showgrouppanel="false" showcheckboxes="true">

							</grid>
						</item>
					</group>


				</group>
			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>

			<buttons>
				<button name="btnSpremi" caption="OBRIŠI" >
					<event type="click">
						<action type="variable value">
							<parameter name="Greska" value="0" type="int"/>
						</action>
						<action type="datarun reader" value="~dtBrisi"  waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku...">

						</action>
						<action type="message" value="~dtBrisi.@Poruka"/>
						<action type="variable value">
							<parameter name="Greska" value="~dtBrisi.@Id"/>
						</action>

						<action type="control populate" value="#grdOstali,#grdOdabrani,#grdStavke"  if="$Greska==0"/>
						<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount} | Broj stavaka: {#grdStavke.rowcount}"  if="$Greska==0"/>
					</event>

				</button>
				<button name="btnOdustani" caption="IZLAZ" dock="right" >
					<event type="click">
						<action type="form close" />
						<!--<action type="control populate keepfocus" value="parent.#grdPlace">
              <parameter value="global.$OOPOBradeGlaId"/>
            </action>-->
						<action type="control populate" value="parent.#grdObradeDet">
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtStavke">
				<parameter name="@Action" value="brisanje_stavki_multi_grid_stavke"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtNapuniTemp">
				<parameter name="@Action" value="brisanje_stavki_multi_popuni_temp_init" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="parent.#grdPlace.selectedids.table"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtOstali">
				<parameter name="@Action" value="brisanje_stavki_multi_grid_ostali" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtOdabrani">
				<parameter name="@Action" value="brisanje_stavki_multi_grid_odabrani" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceDetAzur" name="dtBrisi">
				<parameter name="@Action" value="detalj_brisanje" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdStavke.selectedids.table"/>
			</data>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtPrebaciLijevo">
				<parameter name="@Action" value="brisanje_stavki_multi_prebaci_lijevo" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdodabrani.selectedids.table"/>
			</data>
			<data command="spPlaceBrisanjeStavkiMulti" name="dtPrebaciDesno">
				<parameter name="@Action" value="brisanje_stavki_multi_prebaci_desno" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdostali.selectedids.table"/>
			</data>
		</datalist>
	</form>


	<!--kraj FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->
</root>