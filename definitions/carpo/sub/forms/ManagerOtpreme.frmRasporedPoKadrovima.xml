<root>
	<form name="frmRasporedPoKadrovima" caption="Raspored po kadrovima" width="700" height="400" >
		
		<event type="load">
			<action type="datarun reader" value="dtRasporedPoKadrovimaUkupno" />
		</event>
		<event type="shown">
			
			<action type="control value" value="txtUkupnaKolicina">
				<parameter value="~dtRasporedPoKadrovimaUkupno.@UkupnaKolicina" />
			</action>
			<action type="control value" value="txtZatvorenaKolicina">
				<parameter value="~dtRasporedPoKadrovimaUkupno.@ZatvorenaKolicina" />
			</action>
			
		</event>
		
		<layout textposition="top" itemspadding="3">
			<group cols="2" rows="2" >
				
				<item caption="Ukupna količina" row="1" col="1" textalignmode="auto">
					<textedit name="txtUkupnaKolicina" value="~dtRasporedPoKadrovimaUkupno.@UkupnaKolicina" format="n2" enabled="false"/>
				</item>
				
				<item caption="Zatvorena količina" row="1" col="2" textalignmode="auto">
					<textedit name="txtZatvorenaKolicina" value="~dtRasporedPoKadrovimaUkupno.@ZatvorenaKolicina" format="n2" enabled="false"/>
				</item>
				
				<item col="1" row="2" highlight="False" colspan="2">
					<grid name="grdRasporedPoKadrovima" dataname="~dtRasporedPoKadrovima" autopopulate="true" >								
						<fields>
							<field name="Prezime" caption="Prezime" />
							<field name="Ime" caption="Ime" />
							<field name="OIB" caption="OIB" />
							<field name="MaticniBroj" caption="Matični broj" />
							<field name="Cijena" caption="Cijena" />
							<field name="Kolicina" caption="Količina" editable="true"/>
						</fields>
						<event type="cellvaluechanged">
							<action type="datarun nonquery" value="~dtUpdate" />
							<action type="datarun reader" value="~dtRasporedPoKadrovimaUkupno" />
							
							<action type="control value" value="txtZatvorenaKolicina">
								<parameter value="~dtRasporedPoKadrovimaUkupno.@ZatvorenaKolicina" />
							</action>

							<action type="control populate keepfocus" value="#grdRasporedPoKadrovima" />
						</event>
					</grid>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Zatvori" type="cancel"/>
			</buttons>
		</panelbuttons>
		
		<datalist>
			<data command="spProd_NotpDet_HrKadrovi_Query" name="dtRasporedPoKadrovima">
				<parameter name="@PartneriId" value="parent.#srcPartner" />
				<parameter name="@ProNotpDetId" value="parent.#grdRoba.@pronotpdetid" />
			</data>

			<data command="spProd_NotpDet_HrKadrovi_QueryUkupno" name="dtRasporedPoKadrovimaUkupno">
				<parameter name="@ProNotpDetId" value="parent.#grdRoba.@pronotpdetid" />
			</data>
			
			<data command="spProd_NotpDet_HrKadrovi_Azur" name="dtUpdate">
				<parameter name="@LnNotpDet_HrKadroviId" value="#grdRasporedPoKadrovima.@LnNOtpDet_HrKadroviId" />
				<parameter name="@ProNotpDetId" value="parent.#grdRoba.@pronotpdetid" />
				<parameter name="@HrKadroviId" value="#grdRasporedPoKadrovima.@HrKadroviId" />
				<parameter name="@Kolicina" value="#grdRasporedPoKadrovima.@Kolicina" />
			</data>
			
		</datalist>
	</form>

</root>