<root>
	<!--FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->
	<form name="frmBrisanjeMulti" caption="$caption" width="850" height="650" fixedsize="false" saveformsize="true" showversion="true" version="1" statusbar="true">
		<event type="shown">
			<action type="datarun reader" value="~dtStavke"/>
			<action type="control populate" value="#grdZapisi"/>
			<action type="footer text" value="Broj zapisa: {#grdZapisi.rowcount}"/>
			<action type="variable value" value="brojBrisanja">
				<parameter value="0"/>
			</action>
			<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
			<action type="variable value" value="global.$RefreshajMaster">
				<parameter value="0" type="int"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdZapisi" caption="Zapisi evidencije rada" key="DneEv_MPId" dataname="dtStavke" bestfitonrefresh="true" fieldsmartspaces="true" multiselect="true" showautofilterrow="true" showgrouppanel="false" showcheckboxes="true" allowfilter="true" savelayout="true">
						<fields inherited="true">
							<field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
						</fields>
					</grid>
				</item>
			</group>
			<!--kraj omotača-->
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="OBRIŠI">
					<event type="click">
						<action type="variable value">
							<parameter name="Greska" value="0" type="int"/>
						</action>
						<action type="datarun reader" value="~dtBrisi" waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku...">
						</action>
						<action if="$indGreske==0">
							<action type="control populate keepfocus" value="#grdZapisi"/>
							<action type="footer text" value="Broj zapisa: {#grdZapisi.rowcount}"/>
							<action type="variable value" value="brojBrisanja">
								<parameter value="1"/>
							</action>
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="IZLAZ" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
						<!-- ako je bilo već brisanja dok je forma dignuta onda refreshaj master grid -->
						<!-- <action if="$brojBrisanja&gt;0">
							<action type="control populate" value="parent.#grdERV">
							</action>
						</action>-->
					</event> 
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spERVBrisanjeMulti" name="dtStavke">
				<parameter name="@Action" value="brisanje_grid_zapisi"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spERVBrisanjeMulti" name="dtBrisi">
				<parameter name="@Action" value="brisanje"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdZapisi.selectedids.table"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
	<!--kraj FORMA ZA brisanje-->
</root>