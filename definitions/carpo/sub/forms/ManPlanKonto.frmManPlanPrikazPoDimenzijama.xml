<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmManPlanPrikazPoDimenzijama" type="master" caption="Prikaz planiranih iznosa po dimenzijama i mjesecima" statusbar="false">
    <event type="init">
      <action type="datarun reader" value="~dtDimenzijeQuery"/>
      
    </event>   
    <event type="load">
      <action type="control populate" value="grdDimenzijeMjeseci"/>
    </event>   
    <event type="shown">        
    </event>   
    
    <layout textposition="left" itemspadding="3">
      <group cols="1" rows="1" col="1" row="1">
        <item caption="" col="1" row="1">
          <grid name="grdDimenzijeMjeseci" multiselect="false" dataname="dtDimenzijeQuery" key="KntPlanAId" type="master" bestfitonrefresh="True" showfooter="true">

            <fields>
              <field name="Konto" caption="Konto"/>
              <field name="Naziv Konta" caption="Konto Naziv"/>
              <field name="Vrsta Dimenzije" caption="Vrsta Dimenzije"/>
              <field name="Dimenzija" caption="Dimenzija"/>
              <field name="1" caption="1" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="2" caption="2" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="3" caption="3" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="4" caption="4" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="5" caption="5" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="6" caption="6" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="7" caption="7" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="8" caption="8" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="9" caption="9" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="10" caption="10" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="11" caption="11" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <field name="12" caption="12" showtotalsum="true" showgroupsum="true" fixwidth="70"/>
              <!--<field name="kolicina" caption="Količina" fixwidth="70" formatstring="#,####0.000" showtotalsum="true" showgroupsum="true"/>-->
            </fields>
            
          </grid>
        </item>

      </group>
    </layout>
    
    <panelbuttons>  
      <buttons>
				<button name="btnOdustani" caption="Gotovo" type="cancel" dock="right"/>
			</buttons>      
    </panelbuttons>
    <datalist>
       <data command="spManPlanKontoPoDimenzijamaQuery" name="dtDimenzijeQuery">
         <parameter name="@ManPlanKontoGlaId" value="$ManPlanKontoGlaId" />
         <parameter name="@OrgShemaID" value="$OrgShemaId"/>  
         <parameter name="@KntPlanAId" value="$NizKntPlanAId" type="string"/>
       </data>

    </datalist>
  </form>
</root>
