<root>
	<form name="frmSifrarnikKomponenti" caption="Šifrarnik komponenti">
        <event type="load">
            <action type="control populate" value="#grdSifrarnikKomponenti" />
        </event>
        <event type="close">
            <action type="control populate" value="parent.#trTree" if="global.$filter==Komponente"/>
        </event>
        <layout>
            <group cols="1" rows="1">
                <item row="1" col="1" height="396" width="380">
                    <grid name="grdSifrarnikKomponenti" key="id" dataname="~dtGetSifrarnikKomponenti" multiselect="false" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false">
                        <fields inherited="true">
                            <field name="Pretplata" visible="false"/>
                        </fields>
                    </grid>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodajKomponentu" caption="Dodaj">
                    <event type="click">
                        <action type="form open" value="frmDodajKomponentu" />
                    </event>
                </button>
                <button name="btnObrisiKomponentu" caption="Obriši">
                    <event type="click">
                        <action type="confirm" value="Želite li sigurno obrisati ovu stavku?">
                            <action type="datarun nonquery" value="~dtDeleteComponent" />
                            <action type="control populate" value="#grdSifrarnikKomponenti" />
                        </action>
                    </event>
                </button>
                <button name="btnCancel" caption="Odustani" dock="right">
                    <event type="click">
                        <action type="formclose" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtGetSifrarnikKomponenti">
                <parameter name="@Action" value="getComponents" />
            </data>
            <data command="spComponentTrackerAzur" name="dtDeleteComponent">
                <parameter name="@Action" value="deleteComponent" />
                <parameter name="@ComponentId" value="#grdSifrarnikKomponenti.@id" />
            </data>
        </datalist>
    </form>

</root>