<root version="1.0.0.2">
	<form name="frmIzmjeniGla" type="master" caption="Izmijeni ratu '{$BrojFakture}'" width="400" height="200" statusbar="true">
		<event type="init">		
			<action type="datarun reader" value="~dtGetDataEdit"/> <!--if="$ID!=null"-->
		</event>
		<event type="load">
			<action type="control value" value="#txtVrijednost" >
				<parameter value="$Vrijednost"/>
			</action>
			<action type="control value" value="#datValute" >
				<parameter value="$datumValute"/>
			</action>
			<action type="control value" value="#cmbNacinPlac" >
				<parameter value="$kntNacinPlacId"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="5">
				<item  col="1" row="1" textposition="left" caption="Vrijednost:"  >
					<textedit name="txtVrijednost" datatext="$Vrijednost" readonly="true" format="n2" />
				</item>
				<item col="1" row="3" textposition="left" caption="Datum Valute:" >
					<dateedit  name="datValute" value="" datavalue="~dtSetDatum.@DatumOd" datatext="~dtGetDataEdit.@datumValute" type="date"/>
				</item>
				<item col="1" row="4" textposition="left" caption="Instr. Plaćanja">
					<comboedit name="cmbNacinPlac" autopopulate="true" valuefield="kntNacinPlacId" datatext="~dtGetDataEdit.@kntNacinPlacId" displayfield="Naziv"  dataname="dtNacinPlac"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<action type="datarun nonquery" value="~dtIzmjeni"/>		
						<action type="form close"/>
					</event>															
				</button>
				<button caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtIzmjeni" command="spCFaktureRateAzur">	
				<parameter name="@Action" value="1" />  
				<parameter name="@ID" value="$ID"/> 
				<parameter name="@DatumValute" value="#datValute"/>
				<parameter name="@KntNacinPlacId" value="#cmbNacinPlac" /> 
				<parameter name="@BrojInstr" value="$BrojInstr" /> 
			</data>
			<data command="spCProNaplataRateQuery" name="dtNacinPlac">
				<parameter name="@Action" value="6" />
			</data>	
			<data command="select cast(cast(year(getdate()) as CHAR(4))+'0101' as DATE) as DatumOd,cast(getdate() as date) as DatumDo" type="text" name="dtSetDatum"/>
		</datalist>
	</form>
	<!-- <form name="frmDokument" path="frmDokument.xml"/> -->
</root>