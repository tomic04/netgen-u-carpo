<root version="1.0">
  <!--
  *******************************************************************************************
  FORMA ZA ODABIR GODINE ZA UNOS PLANA GODIŠNJEG ODMORA
  *******************************************************************************************
  -->
  <form name="frmIzracunZaOdabrane" caption="$caption" width="480" height="400" >
	  <event type="load">
		  <action type ="control value" value="#txtGodina">
			  <parameter value="{parent.#grdMaster.@Godina}"/>
		  </action>
		  <action type="control disable" value="#txtGodina" />
	  </event>	  
	  <event type="shown">
			<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida	
				  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
			<action type="variable value" value="global.$RefreshajMaster">
				<parameter value="0" type="int"/>
			</action>
		</event>
    <layout>
	<group  rows="3" cols="4" caption="Izračun odobrenih dana za djelatnike:">
	<item row="1" col="1" colspan="2" rowspan="3">
		<grid  name="grdMasterIzracun" key="HRKadroviId" type="master" async="true" dataname="~dtMaster" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="false" multiselect="true" savelayout="true" netgenfields="true"  showgrouppanel="false" autopopulate="true">
			<fields inherited="true">				
				<field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
			</fields>
		</grid>
	</item>
	<item row="1" col="3"  caption="Godina:" textposition="top" highlight="false">
		<textedit name="txtGodina" tooltip="Godina za koju se izračunava GO" format="n0"/>
	</item>
	<item row="2" col="3"  caption="Datum za dodatne kriterije:" textposition="top" highlight="false">
		<dateedit name="dateDatumDod" value="now"/>
	</item>
      <!--kraj omotača-->
	</group>
    </layout>

    <panelbuttons>
      <buttons>
		<button name="btnIzracunaj" caption="Izračunaj">
			<event type="click">
				<!-- <action type="message" value="$odabraniHRKadroviId"/> -->
				<action type="datarun reader" value="~dtUpdateDatum" ></action>
				<action type="datarun reader" value="~dtIzracun"></action>
				<action if="$indGreske==0">
					<action type="message" value="Uspješno izračunato!" />
					<action type="form close" />
				</action>
				<action type="control populate" value="parent.#grdMaster" />
			</event>
		</button>
        <button name="btnOdustani" caption="Odustani" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
    <data command="spHRGodisnjiAllCP" name="dtMaster">
	<parameter name="@Action" value="dtGetOdabraneDjelatnike"></parameter>
	<parameter name="@operateriid" value="@@operateriid"></parameter>
	<parameter name="@odabraniKadrovi" value="$odabraniHRKadroviId" type="string"/> 
    <parameter name="@indGreske.output.int"></parameter>
	<parameter name="@poruka.output.string"></parameter>
    </data>
	<data command="spHRGodisnjiAllCP" name="dtIzracun">
		<parameter name="@Action" value="IzracunZaOdabraneKadrove"></parameter>
		<parameter name="@Godina" value="#txtGodina"/> 
		<parameter name="@odabraniKadrovi" value="$odabraniHRKadroviId" type="string"/> 
		<parameter name="@indGreske.output.int"></parameter>
		<parameter name="@poruka.output.string"></parameter>
	</data>
	<data command="spHRGodisnjiAllCP" name="dtUpdateDatum">
		<parameter name="@Action" value="DatumDodatni"></parameter>
		<parameter name="@DatumDod" value="#dateDatumDod"></parameter>
		<parameter name="@indGreske.output.int"></parameter>
		<parameter name="@poruka.output.string"></parameter>
	</data>
	</datalist>
  </form>
</root>