<root>
	<form name="frmKupFilter" caption="Prikaži" fixedsize="true"> 
    <event type="shown">
        <action type="control value" value="#cmbFilter">
            <parameter value="0" if="parent.$FilterInd==0" />
            <parameter value="1" if="parent.$FilterInd==1" />
            <parameter value="2" if="parent.$FilterInd==2" />
        </action>
    </event>
		<layout >
           <group rows="1" cols="1">
                <item row="1" col="1">
                    <comboedit name="cmbFilter" dataname="~dtPuniFilter" displayfield="Opis" valuefield="FilterID" />
                </item>
           </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="Prihvati">
                    <event type="click">
                        <action type="form close" />
                        <action type="datarun nonquery" value="~dtSetFilter" />
                        <action type="variable value" value="parent.$FilterInd">
                            <parameter value="#cmbFilter" />
                        </action>
                    </event>
                </button>
                 <button caption="Odustani" type="cancel" />
            </buttons>
        </panelbuttons>
        <datalist>
             <data name="dtPuniFilter" type="text"  
             command="select 2 as FilterID, 'Prikaži sve' as Opis union all select 0, 'Prikaži samo neaktivne' union all select 1, 'Prikaži samo aktivne'" />
             <data command="spProd_KupUgoFilter_SetFilter" name="dtSetFilter">
                <parameter name="@operateriid" value="@@operateriid" />
                <parameter name="@filterid" value="#cmbFilter" />
             </data>
        </datalist>
	</form> 
</root>
