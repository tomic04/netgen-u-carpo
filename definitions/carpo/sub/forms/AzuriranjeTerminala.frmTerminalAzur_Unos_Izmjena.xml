<root>
	<form name="frmTerminalAzur_Unos_Izmjena" width="300" height="450"> 
        <event type="oninit">
            <action type="datarun reader" value="~dtGet"  if="$TerminalId!=null"/>
            <action type="variable value">
                <parameter name="IdToFocus" value="null"/>
            </action>
        </event>
        <event type="onshown">
            <action type="form caption" value="Unos novog terminala" if="$TerminalId==null" />
             <action type="form caption" value="Izmjena terminala" else="" />
        </event>
        <part name="UnosIzmjenaSloga" path="prtAzuriranjeTerminala.xml"/>
        <panelbuttons>
            <buttons>
                <button name="btnSpremi" caption="Spremi">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtIzmjena" if="$TerminalId!=null"/>
                        <action type="datarun scalar" value="~dtUnos" else="">
                             <parameter name="Terminalid" />
                        </action>
                        <action type="variable value">
                            <parameter name="parent.$IdToFocus" value="$TerminalId" type="int"/>
                        </action>
                        <action type="form close"/>
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spNG_Combo" name="dtOrgShema">
                <parameter name="@action" value="orgshema" />
            </data>
            <data command="spTraziOsobe" name="dtOdgovornaOsoba">
			    <parameter name="@Action" value="NaseOsobe" />
		    </data>
            <data command="spNG_Combo" name="dtSkladiste">
                <parameter name="@action" value="Skladiste" />
                <parameter name="@ind" value="1" />
            </data>
            <data command="spNG_Combo" name="dtOperateri">
                <parameter name="@action" value="Operateri" />
            </data>
            <data command="spTerminalAzur_Insert" name="dtUnos">
                <parameter name="@Sifra" value="#txtSifra" />
                <parameter name="@Ime" value="#txtIme" />
                <parameter name="@Lozinka" value="#txtLozinka" />
                <parameter name="@Registracija" value="#txtRegistracija" />
                <parameter name="@operateriid" value="#cmbOperater" />
                <parameter name="@osobeid" value="#cmbOsobe" />
                <parameter name="@skladisteid" value="#cmbSkladiste" />
                <parameter name="@orgshemaid" value="#cmbOrgShema" />
            </data>
            <data command="spTerminalAzur_Update" name="dtIzmjena">
                <parameter name="@Sifra" value="#txtSifra" />
                <parameter name="@Ime" value="#txtIme" />
                <parameter name="@Lozinka" value="#txtLozinka" />
                <parameter name="@Registracija" value="#txtRegistracija" />
                <parameter name="@operateriid" value="#cmbOperater" />
                <parameter name="@osobeid" value="#cmbOsobe" />
                <parameter name="@skladisteid" value="#cmbSkladiste" />
                <parameter name="@orgshemaid" value="#cmbOrgShema" />
                <parameter name="@terminalid" value="$TerminalId" />
            </data>
             <data command="spTerminalAzur_PuniEditFormu" name="dtGet">
                <parameter name="@Terminalid" value="$TerminalId" />
            </data>
        </datalist>
    </form>
</root>