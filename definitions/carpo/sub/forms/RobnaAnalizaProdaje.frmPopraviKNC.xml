<root version="1.0.0.1">
	<form name="frmPopraviKNC" type="master" caption="KOMERCIJALNA NABAVNA CIJENA" statusbar="false">
		<!-- width="800" height="600" -->
		<event type="init"> 
			<action type="datarun reader" value="~dtBod" />
			<action type="datarun reader" value="~dtFakture" />
			<action type="datarun reader" value="~dtFakturaBod" />
			<action type="datarun reader" value="~dtOtpremnica" />
			<action type="datarun reader" value="~dtOtpremnicaBod" />
			<action type="datarun reader" value="~dtPonude" />
			<action type="datarun reader" value="~dtPonudaBod" />
		</event>
		<event type="load">	
			<action type="control value" value="#curFakturaNova">
				<parameter value="$NabRobnoCijena"/>
			</action>	
		</event>
		<event type="shown">

			<action type="control value" value="#curFakturaStara" if="~dtFakture.@brojredova==null">
				<parameter value="0,00" />
			</action>

			<action type="control value" value="#curOtpremnicaStara" if="~dtOtpremnica.@brojredova==null">
				<parameter value="N/A"/>
			</action>
			<action type="control value" value="#curOtpremnicaStara" else="">
				<parameter value="~dtOtpremnicaBod.@StaraOtp"/>
			</action>

			<action type="control value" value="#curPonudaStara" if="~dtPonude.@brojredova==null">
				<parameter value="N/A"/>
			</action>
			<action type="control value" value="#curPonudaStara" else="">
				<parameter value="~dtPonudaBod.@StaraPon"/>
			</action>

			<action type="control value" value="#curOtpremnicaNova" if="#curOtpremnicaStara!=N/A">
				<parameter value="$NabRobnoCijena"/>
			</action>

			<action type="control value" value="#curPonudaNova" if="#curPonudaStara!=N/A">
				<parameter value="$NabRobnoCijena"/>
			</action>

			<action type="control value" value="#chkOtpremnica" if="#curOtpremnicaStara!=N/A">
				<parameter value="1"/>
			</action>

			<action type="control value" value="#chkPonuda" if="#curPonudaStara!=N/A">
				<parameter value="1"/>
			</action>

			<action type="control disable" value="#curOtpremnicaNova,#chkOtpremnica" if="#curOtpremnicaStara==N/A"/>	
			<action type="control enable" value="#curOtpremnicaNova,#chkOtpremnica" if="#curOtpremnicaStara!=N/A"/>	

			<action type="control disable" value="#curPonudaNova,#chkPonuda" if="#curPonudaStara==N/A"/>
			<action type="control enable" value="#curPonudaNova,#chkPonuda" if="#curPonudaStara!=N/A"/>		

			<action type="control focus" value="#curFakturaNova"/>			
		</event>

		<layout itemspadding="2" >
			<group cols="5" rows="4" groupbordervisible="true">
				<columnsdefinition>
					<column size="150" position="1" />
					<column size="150" position="2" />
					<column size="150" position="3" />
					<column size="150" position="4" />
					<column size="30" position="5" />
				</columnsdefinition>
				<item caption="" row="1" col="3"  >
					<labeledit value="POSTOJEĆA:" datavalue="" textposition="left" fontbold="true" />						
				</item>
				<item caption="" row="1" col="4"  >
					<labeledit value="NOVA:" datavalue="" textposition="left" fontbold="true" fontcolor="#228B22"/>						
				</item>

				<item caption="" row="2" col="1" colspan="2" >
					<labeledit value="FAKTURA" datavalue="~dtBod.@Broj"  textposition="left" fontbold="true" fontcolor="blue"/>						
				</item>
				<item caption="" row="2" col="3"  >
					<textedit name="curFakturaStara" required="false" value="0" datavalue="~dtFakturaBod.@StaraFak" readonly="true" textposition="right"/>
				</item>
				<item caption="" row="2" col="4"  >
					<textedit name="curFakturaNova" required="false" value="0" format="n2" type="decimal" datavalue="" readonly="false"/>
				</item>
				<item caption="" row="2" col="5" highlight="false" >
					<checkedit caption="" name="chkFaktura" enabled="true"  value="true"/>
				</item>	


				<item caption="" row="3" col="1" colspan="2" >
					<labeledit value="Otpremnica" datavalue="~dtOtpremnica.@Broj" textposition="left" fontbold="true" fontcolor="blue"/>						
				</item>
				<item caption="" row="3" col="3"  >
					<textedit name="curOtpremnicaStara" required="false" value="0"  datavalue="~dtOtpremnicaBod.@StaraOtp" readonly="true" textposition="right"/>
				</item>
				<item caption="" row="3" col="4"  >
					<textedit name="curOtpremnicaNova" required="false" value="0" format="n2" type="decimal" datavalue="" readonly="false"/>
				</item>
				<item caption="" row="3" col="5" highlight="false" >
					<checkedit caption="" name="chkOtpremnica" enabled="true"  value="false"/>
				</item>	


				<item caption="" row="4" col="1" colspan="2" >
					<labeledit value="Ponuda" textposition="left" fontbold="true" fontcolor="blue"/>						
				</item>
				<item caption="" row="4" col="3"  >
					<textedit name="curPonudaStara" required="false" value="0"  datavalue="~dtPonudaBod.@StaraPon" readonly="true" textposition="right"/>
				</item>
				<item caption="" row="4" col="4"  >
					<textedit name="curPonudaNova" required="false" value="0" format="n2" type="decimal" datavalue="" readonly="false"/>
				</item>
				<item caption="" row="4" col="5" highlight="false" >
					<checkedit caption="" name="chkPonuda" enabled="true"  value="false"/>
				</item>	

			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI"  dock="left" function="POP:KOM:NC">
					<event type="click">

						<action type="datarun reader" value="~dtPon1" if="$ProNOTpDetId!=0"/>

						<action type="datarun reader" value="~dtBod1" if="$FakDetaljId!=0"/>
						<action type="datarun reader" value="~dtBodOtp" if="$ProNOTpDetId!=0"/>
						<action type="datarun reader" value="~dtBodPon" if="$propondetid!=0"/>

						<action type="datarun reader" value="~dtNabCijenaFak" if="$FakDetaljId!=0"/>
						<action type="datarun reader" value="~dtNabCijenaOtp" if="$ProNOTpDetId!=0"/>
						<action type="datarun reader" value="~dtNabCijenaPon" if="$propondetid!=0"/>

						<action type="variable value" if ="$ProNOTpDetId==0">
							<parameter name="ProPonDetId" value="0"/>
						</action>
						<action type="variable value" else ="">
							<parameter name="ProPonDetId" value="~dtPon1.@propondetid"/>
						</action>

						<action type="variable value" if ="$FaktureId==0">
							<parameter name="Bod" value="1"/>
						</action>
						<action type="variable value" else ="">
							<parameter name="Bod" value="~dtBod1.@vrboda"/>
						</action>

						<action type="variable value" if ="$ProNOTpDetId==0">
							<parameter name="BodOtp" value="1"/>
						</action>
						<action type="variable value" else ="">
							<parameter name="BodOtp" value="~dtBodOtp.@vrboda"/>
						</action>

						<action type="variable value" if ="$ProPonDetId==0">
							<parameter name="BodPon" value="1"/>
						</action>
						<action type="variable value" else="">
							<parameter name="BodPon" value="~dtBodPon.@vrboda"/>
						</action>

						<action type="message" value="Vrijednost boda je 0.Ne mogu kompletirati operaciju!" if="#Bod==0||#BodOtp==0||#BodPon==0"/>

						<action if="#chkFaktura==true&amp;&amp;$FakDetaljId!=0">
							<action type="datarun nonquery" value="~dtUpdateFakture"/>
						</action>

						<action if="#chkOtpremnica==true&amp;&amp;$ProNOTpDetId!=0">					
							<action type="datarun nonquery" value="~dtUpdateOtpremnice"/>							
						</action>

						<action if="#chkPonuda==true&amp;&amp;$ProPonDetId!=0">
							<action type="datarun nonquery" value="~dtUpdatePonude"/>							
						</action>

						<action type="control focus" value="parent.#grdStavke">
							<parameter value="Global.$RNId" />
						</action>
						<action type="form close"/>	

					</event>
				</button>	
				<button caption="IZLAZ" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>	

			</buttons>
		</panelbuttons>

		<datalist>
			<data command="select isnull(vrboda,0) as vrboda,'Faktura br.: ' + broj as broj from fakture where faktureid=@FaktureId" type="text" name="dtBod">
				<parameter name="@FaktureId" value="$FaktureId" type="int"/>
			</data>

			<data command="select isnull(nabcijena,0) as nabcijena,@@rowcount as brojredova from fakdetalj where fakdetaljid=@FakDetaljId" type="text" name="dtFakture">
				<parameter name="@FakDetaljId" value="$FakDetaljId" type="int"/>
			</data>

			<data command="select cast(@VrBoda*@NabCijena as decimal(19,2)) as StaraFak" type="text" name="dtFakturaBod">
				<parameter name="@VrBoda" value="0" type="decimal" if ="~dtBod.@vrboda==null"/>
				<parameter name="@VrBoda" value="~dtBod.@vrboda" type="decimal" else =""/>
				<parameter name="@NabCijena" value="0" type="decimal" if ="~dtFakture.@nabcijena==null"/>
				<parameter name="@NabCijena" value="~dtFakture.@nabcijena" type="decimal" else=""/>
			</data>

			<data command="select isnull(pd.nabcijena,0) as nabcijena,'Otpremnica br.:'+pg.broj as broj,isnull(pg.vrboda,0) as vrboda,@@rowcount as brojredova from pronotpdet pd inner join pronotpgla pg on pd.pronotpglaid=pg.pronotpglaid where pronotpdetid=@ProNOTpDetId" type="text" name="dtOtpremnica">
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int"/>
			</data>

			<data command="select cast(@VrBoda*@NabCijena as decimal(19,2)) as StaraOtp" type="text" name="dtOtpremnicaBod">
				<parameter name="@VrBoda" value="0" type="decimal" if ="~dtOtpremnica.@vrboda==null"/>
				<parameter name="@VrBoda" value="~dtOtpremnica.@vrboda" type="decimal" else =""/>
				<parameter name="@NabCijena" value="0" type="decimal" if ="~dtOtpremnica.@nabcijena==null"/>
				<parameter name="@NabCijena" value="~dtOtpremnica.@nabcijena" type="decimal" else=""/>
			</data>

			<data command=" select l.propondetid,isnull(p.nabcijena,0) as nabcijena,'Ponuda br.: '+pg.broj as broj,isnull(pg.vrboda,0) as vrboda,@@rowcount as brojredova from LnProPonNalog l inner join propondet p on l.propondetid=p.propondetid 
                            inner join propongla pg on p.proponglaid=pg.proponglaid 
                            where pronotpdetid= @ProNOTpDetId" type="text" name="dtPonude">
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int"/>
			</data>

			<data command="select cast(@VrBoda*@NabCijena as decimal(19,2)) as StaraPon" type="text" name="dtPonudaBod">				
				<parameter name="@VrBoda" value="0" type="decimal" if ="~dtPonude.@vrboda==null"/>
				<parameter name="@VrBoda" value="~dtPonude.@vrboda" type="decimal" else =""/>
				<parameter name="@NabCijena" value="0" type="decimal" if ="~dtPonude.@nabcijena==null"/>
				<parameter name="@NabCijena" value="~dtPonude.@nabcijena" type="decimal" else=""/>
			</data>

			<data command="select propondetid from LnProPonNalog where pronotpdetid=@ProNOTpDetId" type="text" name="dtPon1">
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int" />
			</data>

			<data command="select vrboda,@@rowcount as brojredova from fakture where faktureid=@FaktureId" type="text" name="dtBod1">
				<parameter name="@FaktureId" value="$FaktureId" type="int"/>
			</data>

			<data command="select pg.vrboda,@@rowcount as brojredova from pronotpdet pd inner join pronotpgla pg on pd.pronotpglaid=pg.pronotpglaid where pronotpdetid=@ProNOTpDetId" type="text" name="dtBodOtp">
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int"/>
			</data>

			<data command="select pg.vrboda,@@rowcount as brojredova from LnProPonNalog l inner join propondet p on l.propondetid=p.propondetid
                           inner join propongla pg on p.proponglaid=pg.proponglaid 
                           where pronotpdetid=@ProNOTpDetId" type="text" name="dtBodPon">
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int"/>
			</data>

			<data command="select cast(@NabCijena/@VrBoda as decimal(19,2)) as nabcijenafak" type="text" name="dtNabCijenaFak">
				<parameter name="@VrBoda" value="~dtBod1.@vrboda" type="decimal" />
				<parameter name="@NabCijena" value="#curFakturaNova" type="decimal"/>
			</data>

			<data command="select cast(@NabCijena/@VrBoda as decimal(19,2)) as nabcijenaotp" type="text" name="dtNabCijenaOtp">
				<parameter name="@VrBoda" value="~dtBodOtp.@vrboda" type="decimal" />
				<parameter name="@NabCijena" value="#curOtpremnicaNova" type="decimal"/>
			</data>

			<data command="select cast(@NabCijena/@VrBoda as decimal(19,2)) as nabcijenapon" type="text" name="dtNabCijenaPon">
				<parameter name="@VrBoda" value="~dtBodPon.@vrboda" type="decimal" />
				<parameter name="@NabCijena" value="#curPonudaNova" type="decimal"/>
			</data>


			<data command="spKomNabCijenaUpdate" name="dtUpdateFakture">
				<parameter name="@Action" value="0" type="int" />
				<parameter name="@FakDetaljId" value="$FakDetaljId" type="int" />
				<parameter name="@ProNOTpDetId" value="0" type="int"/>
				<parameter name="@propondetid" value="0" type="int"/>
				<parameter name="@nabcijenafak" value="~dtNabCijenaFak.@nabcijenafak" type="decimal"/>
				<parameter name="@nabcijenaotp" value="0" type="decimal" />
				<parameter name="@nabcijenapon" value="0" type="decimal" />
			</data>	

			<data command="spKomNabCijenaUpdate" name="dtUpdateOtpremnice">
				<parameter name="@Action" value="1" type="int" />
				<parameter name="@FakDetaljId" value="0" type="int" />
				<parameter name="@ProNOTpDetId" value="$ProNOTpDetId" type="int"/>
				<parameter name="@propondetid" value="0" type="int"/>
				<parameter name="@nabcijenafak" value="0" type="decimal"/>
				<parameter name="@nabcijenaotp" value="~dtNabCijenaOtp.@nabcijenaotp" type="decimal" />
				<parameter name="@nabcijenapon" value="0" type="decimal" />
			</data>	

			<data command="spKomNabCijenaUpdate" name="dtUpdatePonude">
				<parameter name="@Action" value="2" type="int" />
				<parameter name="@FakDetaljId" value="0" type="int" />
				<parameter name="@ProNOTpDetId" value="0" type="int"/>
				<parameter name="@propondetid" value="$ProPonDetId" type="int"/>
				<parameter name="@nabcijenafak" value="0" type="decimal"/>
				<parameter name="@nabcijenaotp" value="0" type="decimal" />
				<parameter name="@nabcijenapon" value="~dtNabCijenaPon.@nabcijenapon" type="decimal" />
			</data>				


		</datalist>
	</form>
</root>