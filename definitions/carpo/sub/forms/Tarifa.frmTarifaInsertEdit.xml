<root>
	<form name="frmTarifaInsertEdit" caption="Tarifa" fixedsize="false" height="700" width="650">
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun scalar" value="~dtmaxlengthT">
				<parameter name="maxlengthT" value="~dtmaxlength.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
			<action type="datarun scalar" value="~dtmaxlengthN">
				<parameter name="maxlengthN" value="~dtmaxlength.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
			<action type="datarun scalar" value="~dtmaxlengthOznaka">
				<parameter name="maxlengthOznaka" value="~dtmaxlength.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
			<action type="datarun reader" value="~dtHROznaka_Check" />
			<action type="variable value">
				<parameter name="HROznakaObavezna" value="~dtHROznaka_Check.@HROznakaObavezna" />
			</action>
		</event>
		<event type="shown">
			<action type="control disable" value="#btnDodaj,#btnIzmjena,#btnObrisi" if="$TarifaId==null" />
			<action type="control value" value="#datDatum" if="$Tarifaid==null">
				<parameter value="now" />
			</action>
			<action type="control value" value="#datDatum" if="$Tarifaid!=null">
				<parameter value="~dtGet.@Datum" />
			</action>
			<action type="control value" value="#txtStopa1" if="$Tarifaid==null">
				<parameter value="0,00" />
			</action>
			<action type="control value" value="#txtStopa1" else="">
				<parameter value="~dtGet.@stopa1" />
			</action>
			<action type="control value" value="#txtStopa2" if="$Tarifaid==null">
				<parameter value="0,00" />
			</action>
			<action type="control value" value="#txtStopa2" else="">
				<parameter value="~dtGet.@stopa2" />
			</action>
			<action type="control value" value="#txtStopa3" if="$Tarifaid==null">
				<parameter value="0,00" />
			</action>
			<action type="control value" value="#txtStopa3" else="">
				<parameter value="~dtGet.@stopa3" />
			</action>
			<action type="control attribute" value="#txteRacOznaka" if="$HROznakaObavezna==1">
				<parameter name="required" value="true" />
			</action>
		</event>
		<layout textposition="left">
			<group rows="3" cols="1" bordervisible="false">
				<group row="1" col="1" rows="4" cols="3" bordervisible="false">
					<columnsdefinition>
						<column size="30%" position="1" />
						<column size="20%" position="2" />
						<column size="50%" position="3" />
					</columnsdefinition>
					<item row="1" col="1" colspan="2" caption="Tarifa:">
						<textedit name="txtTarifa" datavalue="~dtGet.@Tarifa" required="true" maxlength="$maxlengthT" />
					</item>
					<item col="3" row="1" textposition="left">
						<checkedit caption="Aktivna" name="chkAktivan" datavalue="~dtGet.@Aktivan" />
					</item>
					<item row="2" col="1" colspan="2" caption="Naziv:">
						<textedit name="txtNaziv" datavalue="~dtGet.@Naziv" required="true" maxlength="$maxlengthN" />
					</item>
					<item row="2" col="3" caption="Boja:">
						<comboedit name="cmbBoja" valuefield="Id" displayfield="Boja" dataname="dtBoje" datavalue="~dtGet.@Boja">
						</comboedit>
					</item>
					<item row="3" col="1" colspan="2" caption="HR Oznaka:">
						<textedit name="txteRacOznaka" datavalue="~dtGet.@ERacOznaka" required="false" maxlength="$maxlengthOznaka" />
					</item>
					<item row="4" col="1" colspan="3" caption="Konto:">
						<searchedit name="srcKonto" fieldtext="KontoNaziv" fieldvalue="KntplanAid" datavalue="~dtGet.@KntplanAid" datatext="~dtGet.@KontoNaziv" dataname="~dtKonto" />
					</item>
				</group>
				<group row="2" col="1" rows="4" cols="2" caption="Porezi">
					<columnsdefinition>
						<column size="50%" position="1" />
						<column size="50%" position="2" />
					</columnsdefinition>
					<item row="1" col="1" colspan="2" caption="Datum:">
						<dateedit name="datDatum" datavalue="~dtGet.@Datum" />
					</item>
					<item row="2" col="1" caption="Stopa1:">
						<textedit name="txtStopa1" datavalue="~dtGet.@Stopa1" format="n2" required="true" />
					</item>
					<item row="3" col="1" caption="Stopa2:">
						<textedit name="txtStopa2" datavalue="~dtGet.@Stopa2" format="n2" />
					</item>
					<item row="4" col="1" caption="Stopa3:">
						<textedit name="txtStopa3" datavalue="~dtGet.@Stopa3" format="n2" />
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="2">
					<columnsdefinition>
						<column position="1" size="45%" />
						<column position="2" size="100" />
					</columnsdefinition>
					<item row="1" col="1" rowspan="3">
						<grid name="grdOpis" caption="Opisi HR oznake kategorije PDV-a" key="LnTarifaERacOpisId" dataname="~dtDetail" autopopulate="true" bestfitonrefresh="true" savelayout="true" showgrouppanel="false" showautofilterrow="true">
							<fields inherited="true" />
						</grid>
					</item>
					<group row="1" col="2" rows="4" cols="1" groupbordervisible="false">
						<rowsdefinition>
							<row position="1" size="50" />
							<row position="2" size="50" />
							<row position="3" size="50" />
							<row position="4" size="40%" />
						</rowsdefinition>
						<item row="1" col="1" spacing="5,5,10,5">
							<button name="btnDodaj" image="add" imagelocation="middlecenter" function="DodajOpis"> 
								<event type="click">
									<action type="form open" value="frmTarifaERacOpis">
										<parameter name="LnTarifaERacOpisId" value="null" />
										<parameter name="TarifaId" value="$TarifaId" />
										<parameter name="FormType" value="Unos" />
										<parameter name="HROznaka" value="#txteRacOznaka" />
									</action>
									<action type="control populate" value="#grdOpis" />
									<action type="control focus" value="#grdOpis">
										<parameter value="$LnTarifaERacOpisId" type="int" />
									</action>
									<action type="control populate" value="parent.#grdMaster" />
								</event>
							</button>
						</item>
						<item row="2" col="1" spacing="5,5,10,5">
							<button name="btnIzmjena" image="edit" imagelocation="middlecenter" function="IzmijeniOpis">
								<event type="click">
									<action if="#grdOpis.@LnTarifaERacOpisId!=null">
										<action type="form open" value="frmTarifaERacOpis">
											<parameter name="Id" value="#grdOpis.@LnTarifaERacOpisId" />
											<parameter name="TarifaId" value="$TarifaId" />
											<parameter name="FormType" value="Izmjena" />
											<parameter name="HROznaka" value="#txteRacOznaka" />
										</action>
										<action type="control populate" value="parent.#grdMaster" />
									</action>
									<action elseif="#grdOpis.@LnTarifaERacOpisId==null">
										<action type="message" value="'Odaberite opis kojoj želite izmjeniti.'" />
									</action>
								</event>
							</button>
						</item>
						<item row="3" col="1" spacing="5,5,10,5">
							<button name="btnObrisi" image="delete" imagelocation="middlecenter" function="ObrisiOpis">
								<event type="click">
									<action if="#grdOpis.@LnTarifaERacOpisId!=null">
										<action type="confirm" value="Jeste li sigurni da želite obrisati označeni opis  HR oznake?">
											<action type="datarun nonquery" value="global.~dtERacOpisDelete" />
											<action type="control populate" value="#grdOpis" />
											<action type="control populate" value="parent.#grdMaster" />
										</action>
									</action>
									<action elseif="#grdOpis.@LnTarifaERacOpisId==null">
										<action type="message" value="'Odaberite opis kojoj želite obrisati.'" />
									</action>
								</event>
							</button>
						</item>
					</group>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate" />
						<action if="$Tarifaid!=null">
							<action type="datarun nonquery" value="~dtDataEdit">
								<!-- <parameter name="$Tarifaid" /> -->
							</action>
							<action type="control enable" value="#btnDodaj,#btnIzmjena,#btnObrisi " if="$TarifaId!=null" />
							<action type="variable value" value="parent.$TarifaId">
								<parameter value="$TarifaId" type="int" />
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="parent.$Tarifaid" type="int" />
							</action>
							<action type="form close" />
						</action>
						<action else="">
							<action type="datarun scalar" value="~dtDataInsert">
								<parameter name="$Tarifaid" />
							</action>
							<action type="control enable" value="#btnDodaj,#btnIzmjena,#btnObrisi " if="$TarifaId!=null" />
							<action type="variable value" value="parent.$TarifaId">
								<parameter value="$TarifaId" type="int" />
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="parent.$Tarifaid" type="int" />
							</action>
						</action>
						<!--
						<action type="control enable" value="#btnDodaj,#btnIzmjena,#btnObrisi " if="$TarifaId!=null" />
						<action type="variable value" value="parent.$TarifaId">
						<parameter value="$TarifaId" type="int" />
						</action>
						<action type="control populate" value="parent.#grdMaster" />
						<action type="control focus" value="parent.#grdMaster">
						<parameter value="parent.$Tarifaid" type="int" />
						</action>
						-->
						<!-- <action type="form close" /> -->
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthT">
				<parameter name="@table_name" value="Tarifa" />
				<parameter name="@column_name" value="Tarifa" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthN">
				<parameter name="@table_name" value="Tarifa" />
				<parameter name="@column_name" value="Naziv" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOznaka">
				<parameter name="@table_name" value="Tarifa" />
				<parameter name="@column_name" value="eRacOznaka" />
			</data>
			<data command="spTarifa_Query" name="dtGet">
				<parameter name="@Action" value="5" />
				<parameter name="@ID" value="$Tarifaid" />
			</data>
			<data command="spTarife_Boja" name="dtBoje">
			</data>
			<data command="spTarifa_Query" name="dtKonto">
				<parameter name="@Action" value="6" />
				<parameter name="@uvjet" value="#srcKonto.text" />
			</data>
			<data command="spTarifa_Azur" name="dtDataInsert">
				<parameter name="@Action" value="0" />
				<parameter name="@Tarifa" value="#txtTarifa" />
				<parameter name="@Aktivan" value="#chkAktivan" />
				<parameter name="@Boja" value="#cmbBoja" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@KntPlanAid" value="#srcKonto" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Stopa1" value="#txtStopa1" type="decimal" />
				<parameter name="@Stopa2" value="#txtStopa2" type="decimal" />
				<parameter name="@Stopa3" value="#txtStopa3" type="decimal" />
				<parameter name="@ERacOznaka" value="#txteRacOznaka" />
				<!-- <parameter name="@ERacOpis" value="#txteRacOpis" /> -->
			</data>
			<data command="spTarifa_Azur" name="dtDataEdit">
				<parameter name="@Action" value="1" />
				<parameter name="@Tarifaid" value="$Tarifaid" />
				<parameter name="@Tarifa" value="#txtTarifa" />
				<parameter name="@Aktivan" value="#chkAktivan" />
				<parameter name="@Boja" value="#cmbBoja" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@KntPlanAid" value="#srcKonto" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Stopa1" value="#txtStopa1" type="decimal" />
				<parameter name="@Stopa2" value="#txtStopa2" type="decimal" />
				<parameter name="@Stopa3" value="#txtStopa3" type="decimal" />
				<parameter name="@ERacOznaka" value="#txteRacOznaka" />
				<!-- <parameter name="@ERacOpis" value="#txteRacOpis" /> -->
			</data>
			<data command="spTarifa_Query" name="dtDetail">
				<parameter name="@Action" value="7" />
				<parameter name="@TarifaId" value="$TarifaId" />
			</data>
			<data command="spTarifa_Query" name="dtHROznaka_Check">
				<parameter name="@Action" value="9" />
			</data>
		</datalist>
	</form>
	<form name="frmTarifaERacOpis" caption="{$formType} opisa HR oznake {$HROznaka}" width="485">
		<event type="init">
			<action type="datarun reader" value="~dtGetOpis" if="$Id!=null" />
			<action type="datarun scalar" value="~dtmaxlengthOpis">
				<parameter name="maxlengthOpis" value="~dtmaxlength.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
		</event>
		<layout>
			<group row="1" col="1" rows="2" cols="1">
				<item caption="Opis HR Oznake:" row="1" col="1">
					<memoedit name="txtERacOpis" required="true" datavalue="~dtGetOpis.@ERacOpis" fontbold="true" maxlength="$maxlengthOpis" />
				</item>
				<item caption="" row="2" col="1">
					<checkedit name="chkDefault" caption="Defaultni opis" textposition="right" datavalue="~dtGetOpis.@DefaultInd" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Spremi" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtERacOpisAzur">
							<!-- <parameter name="Id" /> -->
						</action>
						<action type="control populate" value="parent.#grdOpis" />
						<action type="form close" />
					</event>
				</button>
				<button caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTarifa_Azur" name="dtERacOpisAzur">
				<parameter name="@action" value="3" />
				<parameter name="@LnTarifaEracOpisId" value="$Id" />
				<parameter name="@TarifaId" value="$TarifaId" />
				<parameter name="@EracOpis" value="#txtERacOpis" />
				<parameter name="@DefaultInd" value="#chkDefault" />
			</data>
			<data command="spTarifa_Query" name="dtGetOpis">
				<parameter name="@Action" value="8" />
				<parameter name="@Id" value="$Id" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOpis">
				<parameter name="@table_name" value="LnTarifaERacOpis" />
				<parameter name="@column_name" value="eRacOpis" />
			</data>
		</datalist>
	</form>
</root>
