<root>
	<form name="frmDMSBarcode" caption="Dodaj/poveži skenirani dokument" fixedsize="false">
		<method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
		<method name="funDmsSaveByPath" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocumentsByPath" />
		<event type="init"> 
		</event>
		<event type="load">	

		</event>
		<event type="shown">
			<action type="control focus" value="#btnDodaj"/>
            <action type="control disable" value="#btnPovezi"/>			
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="1" groupbordervisible="true">
				<item col="1" row="1" caption="Broj:">
					<textedit name="txtBarcode" value="">					   
					   <event type="valuechanged">
							<action type="control enable" if="#txtBarcode!=" value="#btnPovezi"/>
							<action type="control disable" else="" value="#btnPovezi"/>
						</event>

						<event type="leave">
							<action type="datarun reader" value="~dtPutanjaBarcode" />
							<action type="variable value" >
								<parameter name="Putanja" value="~dtPutanjaBarcode.@Putanja" type="string" />
							</action>
						</event>
					</textedit>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPovezi" caption="&amp;POVEŽI" dock="left">
					<event type="click">
						<!-- <action type="message" value="$GlaId"/> -->
						<action type="method run" value="funDmsSaveByPath">
						<parameter name="server" value="@@server" />
						<parameter name="database" value="@@database"/>
						<parameter name="username" value="" />
						<parameter name="password" value="" />
						<parameter name="operaterId" value="@@operateriid" />
						<parameter name="paths" value="$Putanja" />
						<parameter name="entityName" value="UgovoriNajamGla" />
						<parameter name="entityId" value="$GlaId" />
						</action> 
						
						<action type="control populate" value="parent.#grdDms" />
						
					</event>
				</button>

				<button name="btnDodaj" caption="&amp;Dodaj dokument" dock="left">
					<event type="click">
						<action type="method run" value="funDmsAdd">
							<parameter name="server" value="@@server" />
							<parameter name="database" value="@@database"/>
							<parameter name="username" value="" />
							<parameter name="password" value="" />
							<parameter name="operaterid" value="@@operateriid" />
							<parameter name="EntityName" value="UgovoriNajamGla" />
							<parameter name="entityID" value="$GlaId" />
							<parameter name="tipInserta" value="windows" />
						</action> 
						
						<action type="control populate" value="parent.#grdDms" />
						
					</event>
				</button>

				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spUgovoriNajam_DMS" name="dtPutanjaBarcode">
				<parameter name="@Barcode" value="#txtBarcode" />
			</data>		
		</datalist>
	</form>
</root>