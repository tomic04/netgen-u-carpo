<root>
  <!--FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->

  <form name="frmKopirajKadroveSObrade" caption ="$caption" saveformsize="true" width="1000" height="650" statusbar="true">
    <event type="shown">
      <action type="control populate" value="#grdObrade" />
      <action type="control populate" value="#grdKadrovi" />
      <action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika odabrane obrade: {#grdKadrovi.rowcount}"/>
    </event>

    <layout>
      <group cols="1" rows="6" groupbordervisible="false">
        <group col="1" row="1" cols="15" rows="8" rowspan="3" spacing="2,2,2,1">
          <item col="1" row="1"  colspan="7"  rowspan="8" caption="Obrade plaće">
            <grid name="grdObrade" key="OOPObradeId" dataname="dtObrade" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">
              <event type="focusedrowchanged">
                <action type="control populate" value="#grdKadrovi"></action>
                <action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika odabrane obrade: {#grdKadrovi.rowcount}"/>
              </event>
            </grid>
          </item>

          <item col="9" row="1"  colspan="7"  rowspan="8" caption="Djelatnici s odabrane obrade">
            <grid name="grdKadrovi" key="HRKadroviId" dataname="dtKadrovi" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

            </grid>
          </item>
        </group>

        <group col="1" row="4" cols="10" rows="4" spacing="2,2,1,2" rowspan="3">
          <item col="1" row="1" caption="Kopiraj djelatnike s odabrane obrade"  highlight="false" textposition="right">
            <checkedit name="chkKopirajDjelatnike" checked="true" tooltip="Kopiraj djelatnike s odabrane obrade na postojeću obradu. Zanemaruju se djelatnici koji već postoje na ovoj obradi."></checkedit>
          </item>
          <item col="1" row="2" caption="Obriši djelatnike s postojeće obrade"  highlight="false" textposition="right">
            <checkedit name="chkObrisipostojeceDjelatnike" checked="false" tooltip="Obriši djelatnike s postojeće obrade."></checkedit>
          </item>
          <item col="1" row="3" caption="Kopiraj stavke s odabrane obrade"  highlight="false" textposition="right">
            <checkedit name="chkKopirajStavke" checked="false" tooltip="Kopiraj stavke s odabrane obrade djelatnicima na postojećoj obradi."></checkedit>
          </item>
          <item col="1" row="4" caption="Obriši stavke s postojeće obrade"  highlight="false" textposition="right">
            <checkedit name="chkObrisiPostojeceStavke" checked="false" tooltip="Obriši stavke s postojeće obrade"></checkedit>
          </item>

        </group>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>

      <buttons>
        <button name="btnSpremi" caption="KOPIRAJ" >
          <event type="click">
            <action type="datarun reader" value="~dtKopiraj" waittype="progress" waitcaption="Pričekajte..." waittext="..kopiranje / brisanje u tijeku...">
            </action>
            <action type="message" value="~dtKopiraj.@Poruka"/>
          </event>

        </button>
        <button name="btnOdustani" caption="IZLAZ" dock="right" >
          <event type="click">
            <action type="form close" />
            <action type="control populate" value="parent.#grdObradeDet">
            </action>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceKopirajKadroveSObrade" name="dtObrade">
        <parameter name="@Action" value="grid_obrade"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobrade2id" value="global.$oopobradeid"/>
      </data>
      <data command="spPlaceKopirajKadroveSObrade" name="dtKadrovi">
        <parameter name="@Action" value="grid_kadrovi_za_obradu"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="#grdObrade.@OOPObradeId"/>
      </data>


      <data command="spPlaceKopirajKadroveSObrade" name="dtKopiraj">
        <parameter name="@Action" value="kopiraj" />
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@chkKopirajDjelatnike" value="#chkKopirajDjelatnike"/>
        <parameter name="@chkObrisiPostojeceDjelatnike" value="#chkObrisiPostojeceDjelatnike"/>
        <parameter name="@chkKopirajStavke" value="#chkKopirajStavke"/>
        <parameter name="@chkObrisiPostojeceStavke" value="#chkObrisiPostojeceStavke"/>
        <parameter name="@oopobradeid" value="#grdObrade.@OOPObradeId"/>
        <parameter name="@oopobrade2id" value="global.$oopobradeid"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->
</root>