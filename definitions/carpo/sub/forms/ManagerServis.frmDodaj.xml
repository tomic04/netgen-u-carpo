<root>
	<form name="frmDodaj" caption="Dodaj" width="650" height="780" fixedsize="true" saveformsize="true">
		<method name="fnPartneriInfo" dll="PartnerInfo" class="PartnerInfo.frmPartnerInfoMain" method="Open" />
		<method name="Poziv" dll="OsobeInfo" class="OsobeInfo.frmMain" method="Ulaz" />
		<event type="init">
			<action type="datarun scalar" value="~dtmaxlengthOpis">
				<parameter name="maxlengthOpis" value="~dtmaxlengthOpis.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
		</event>
		<event type="load">
			<action type="control disable" value="#srcOsoba" />
			<action type="control visible" value="#srcUsluga" if="#cmbModel.@model==U">
				<parameter value="true" />
			</action>
			<action type="control visible" value="#srcUsluga" if="#cmbModel.@model!=U">
				<parameter value="false" />
			</action>
			<action type="control attribute" value="#srcUsluga" if="#cmbModel.@model!=U">
				<parameter name="required" value="false" />
			</action>
			<action type="control attribute" value="#srcUsluga" if="#cmbModel.@model==U">
				<parameter name="required" value="true" />
			</action>
			<action type="control value" value="#rdoPartner">
				<parameter value="true" />
			</action>
			<action type="variable value" value="Global.$Broj">
				<parameter value="null" />
			</action>
			<action type="variable value" value="Global.$NoviRN">
				<!-- nulliranje ako postoji od prije -->
				<parameter value="null" />
			</action>
		</event>
		<event type="shown">
			<!--
			<action type="control disable" value="#btnTemeljniPodaciStroja">
			</action>
			-->
			<action type="datarun reader" value="global.~dtParametriModela" />
			<action type="variable value">
				<parameter name="KlMasterRobaId" value="global.~dtParametriModela.@KlMasterRobaId" />
				<parameter name="InterniInd" value="global.~dtParametriModela.@InterniInd" />
				<parameter name="Model" value="global.~dtParametriModela.@Model" />
				<parameter name="OsobeMP" value="global.~dtParametriModela.@OsobeMP" />
				<parameter name="OrgShemaReal" value="global.~dtParametriModela.@OrgShemaReal" />
				<parameter name="TrosOrgShemaId" value="global.~dtParametriModela.@TrosOrgShemaId" />
				<parameter name="RealOrgShemaId" value="global.~dtParametriModela.@RealOrgShemaId" />
				<parameter name="KlasaUslugeId" value="global.~dtParametriModela.@KlasaUslugeId" />
				<parameter name="global.$InterniIndOLD" value="global.~dtParametriModela.@InterniInd" />
				<parameter name="PartneriInd" value="global.~dtParametriModela.@PartneriInd" />
			</action>
			<action type="datarun reader" value="~dtProvjeriTrosPrava" />
			<action type="variable value">
				<parameter name="TrosOperaterId" value="~dtProvjeriTrosPrava.@OperaterId" />
			</action>
			<action type="datarun reader" value="~dtProvjeriRealPrava" />
			<action type="variable value">
				<parameter name="RealOperaterId" value="~dtProvjeriRealPrava.@OperaterId" />
			</action>
			<action if="$InterniInd==true">
				<action type="control value" value="#srcPartner">
					<parameter value="global.$NasId" text="global.$NasNaziv" />
				</action>
			</action>
			<action if="$InterniInd==false&amp;&amp;global.$InterniIndOLD==true">
				<action type="control value" value="#srcPartner">
					<parameter value="global.~dtVoziloInfo.@PartneriId" text="global.~dtVoziloInfo.@PartneriNaziv" />
				</action>
			</action>
			<action if="$TrosOperaterId==@@OperateriId">
				<action type="control value" value="#cmbOrgShema">
					<parameter value="$TrosOrgShemaId" />
				</action>
			</action>
			<action else="">
				<action type="control value" value="#cmbOrgShema">
					<parameter value="null" />
				</action>
			</action>
			<action if="$OrgShemaReal==true">
				<action type="control visible" value="#cmbOrgShemaReal">
					<parameter value="true" />
				</action>
				<action type="control attribute" value="#cmbOrgShemaReal">
					<parameter name="required" value="true" />
				</action>
				<action if="$RealOperaterId==@@OperateriId">
					<action type="control value" value="#cmbOrgShemaReal">
						<parameter value="$RealOrgShemaId" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#cmbOrgShemaReal">
						<parameter value="null" />
					</action>
				</action>
			</action>
			<action else="">
				<action type="control visible" value="#cmbOrgShemaReal">
					<parameter value="false" />
				</action>
				<action type="control attribute" value="#cmbOrgShemaReal">
					<parameter name="required" value="false" />
				</action>
				<action type="control value" value="#cmbOrgShemaReal">
					<parameter value="$TrosOrgShemaId" />
				</action>
			</action>
		</event>
		<layout>
			<group rows="11" cols="3">
				<rowsdefinition>
					<row position="11" size="100" />
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="47%" />
					<column position="2" size="6%" />
					<column position="3" size="47%" />
				</columnsdefinition>
				<part name="prtServisOsnovno" path="prtServisOsnovno.xml" />
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI" tabindex="0">
					<event type="click">
						<action type="validate">
							<action type="datarun reader" value="~dtVrstaDok" />
							<action type="variable value" value="VrstaDokId">
								<parameter value="~dtVrstaDok.@VrstaDokId" />
							</action>
							<action type="datarun scalar" value="~dtUnesi">
								<parameter name="NoviRN" />
							</action>
							<action type="variable value" value="Global.$NoviRN">
								<parameter value="$NoviRN" />
							</action>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="global.$NoviRN" />
							</action>
							<action type="form close" />
							<!--
							<action type="variable value">
							<parameter name="global.$NoviRN" value="$NoviRN"/>
							<parameter name="global.$brojRN" value="parent.#grdMaster.@broj"/>
							<parameter name="global.$statusRN" value="parent.#grdMaster.@status"/>
							</action>
							-->
							<action type="form open" value="frmIzmijeni">
								<parameter name="Edit" value="1" />
								<parameter name="IzDodaj" value="1" />
								<parameter name="NoviRn" value="$NoviRn" />
								<action type="variable value">
									<!-- <parameter name="global.$NoviRN" value="$NoviRN"/> -->
									<parameter name="global.$brojRNCaption" value="parent.#grdMaster.@broj" />
									<parameter name="global.$statusRNCaption" value="parent.#grdMaster.@status" />
									<parameter name="global.$ServisRNGLAID" value="global.$NoviRN" />
								</action>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOsobe" caption="OsobeInfo">
					<event type="click">
						<!--
						<action type="method run" value="fnOsobeInfo">
						<parameter name="server" value="@@server" />
						<parameter name="database" value="@@database" />
						<parameter name="username" value="@@uid" />
						<parameter name="password" value="@@pwd" />
						<parameter name="Operateriid" value="@@operateriid" />
						<parameter name="OsobeId" value="#srcOsoba.@OsobeId" />
						</action>
						-->
						<action if="global.$IndNetOsobe==1">
							<action type="method run" value="Poziv">
								<!-- if="#srcOsoba!=null" -->
								<parameter name="server" value="@@server" />
								<parameter name="database" value="@@database" />
								<parameter name="username" value="@@uid" />
								<parameter name="password" value="@@pwd" />
								<parameter name="Operateriid" value="@@operateriid" />
								<parameter name="path" value="" />
								<parameter name="OsobeId" value="#srcOsoba.@osobeid" />
							</action>
						</action>
						<action else="">
							<action type="message" value="'Osobe se uređuju u granuli OsobeInfo.'" />
						</action>
					</event>
				</button>
				<button name="btnPartneri" caption="PartneriInfo" tabindex="17">
					<event type="click">
						<!-- <action if="global.$IndCarpoPartneri==1"> -->
						<action type="method run" value="fnPartneriInfo">
							<parameter name="server" value="@@server" />
							<parameter name="baza" value="@@database" />
							<parameter name="username" value="@@username" />
							<parameter name="password" value="" />
							<parameter name="operateriid" value="@@operateriid" />
							<parameter name="Parent" value="0" />
							<parameter name="pTop" value="0" />
							<parameter name="pLeft" value="0" />
							<parameter name="path" value="" />
							<parameter name="partneriid" value="#srcPartner.@PartneriId" />
						</action>
						<!--
						<action else="">
						<action type="message" value="'Partneri se uređuju u granuli PartneriInfo.'" />
						</action>
						</action>
						-->
					</event>
				</button>
				<button name="btnTemeljniPodaciStroja" caption="Unesi stroj" function="TemeljniPodaciStroja">
					<event type="click">
						<action if="#srcStroj!=null">
							<action type="form open" value="frmManagerStrojeva">
								<parameter name="VoziloId" value="#srcStroj" />
								<parameter name="caption" value="Izmijeni stroj" type="text" />
							</action>
						</action>
						<action if="#srcStroj==null">
							<action type="form open" value="frmManagerStrojeva">
								<parameter name="VoziloId" value="#srcStroj" />
								<parameter name="caption" value="Unesi novi stroj" type="text" />
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" tabindex="18">
					<event type="click">
						<action type="form close" />
						<action type="control populate" value="parent.#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtProvjeriTrosPrava" command="spServisRNFilterCarpo">
				<parameter name="@Action" value="ProvjeriOrgShema" />
				<parameter name="@Operater" value="@@OperateriId" />
				<parameter name="@OrgShemaId" value="$TrosOrgShemaId" />
			</data>
			<data name="dtProvjeriRealPrava" command="spServisRNFilterCarpo">
				<parameter name="@Action" value="ProvjeriOrgShema" />
				<parameter name="@Operater" value="@@OperateriId" />
				<parameter name="@OrgShemaId" value="$RealOrgShemaId" />
			</data>
			<data name="dtVrstaDok" command="spServisRNFilterCarpo">
				<parameter name="@Action" value="VrstaDokId" />
			</data>
			<data name="dtUnesi" command="spServisRNGlaAzurCarpo">
				<parameter name="@Action" value="0" />
				<parameter name="@OperateriId" value="@@operateriid" />
				<parameter name="@VrstaDokId" value="$VrstaDokId" />
				<parameter name="@DatumDok" value="#dateDatum" />
				<parameter name="@ServisVrsteRNId" value="#cmbVrstaRN" />
				<parameter name="@ServisNacinObrId" value="#cmbNacinObracuna" />
				<parameter name="@ServisId" value="#cmbModel" />
				<parameter name="@RealOrgShemaId" value="#cmbOrgShemaReal" />
				<parameter name="@TrosOrgShemaId" value="#cmbOrgShema" />
				<parameter name="@OdgovornaOsobaId" value="#srcOdgovornaOsoba" />
				<parameter name="@HRKadroviID" value="#srcIzvrsitelj" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@ParStruId" value="#srcLokacija" />
				<parameter name="@PartneriOsobeId" value="#srcKontakt" />
				<parameter name="@OsobeId" value="#srcOsoba" />
				<parameter name="@VoziloId" value="#srcStroj" />
				<parameter name="@RobaOpis" value="#memOpis" />
				<parameter name="@StatusiId" value="global.$MinStatus" />
				<parameter name="@PredZavrsetakDatum" value="#dateDatumZavrsetka" />
				<parameter name="@ProponGlaId" value="#srcPonuda" />
				<parameter name="@UslugaId" value="#srcUsluga" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOpis">
				<parameter name="@table_name" value="ServisDijagnoza" />
				<parameter name="@column_name" value="RobaOpis" />
			</data>
		</datalist>
		<form name="frmIzmijeni" path="frmIzmijeni.xml" />
		<form name="frmManagerStrojeva" path="frmManagerStrojeva.xml" />
	</form>
</root>
