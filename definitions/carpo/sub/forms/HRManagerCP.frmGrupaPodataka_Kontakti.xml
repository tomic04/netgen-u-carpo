<root>
	<!--
  Komentari:
  4.11.2025. MP - PERMISSION -> FUNCTION NAME
  09.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmKontakti" caption="Kontakt za {parent.#txtPrezime} {parent.#txtIme}" width="850" height="350" >
		<event type="load">
			<action type="control populate" value="#grdKontakti"/>		
			<action type="control disable" value="#btnIzmjenaKontakta,btnBrisanjeKontakt" if="#grdKontakti.rowcount==0"/>

		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<group cols="1" rows="1" groupbordervisible="true" col="1" row="1" spacing="2,2,2,1">
					<item row="1" col="1" highlight="false">
						<grid name="grdKontakti" key="HRKadroviKontaktiId" dataname="~dtKontakti" multiselect="true" savelayout="true" fieldsmartspaces="false" showgrouppanel="false" bestfitonrefresh="true">
							<fields inherited="true">
							</fields>
							<event type="doubleclick">
								<action type="form open" value="frmUnosIzmjenaKontakti" function="IZMJENA_KONTAKTI">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviKontaktiId" value="#grdKontakti.@HRKadroviKontaktiId" />	
									<parameter name="Caption" value="Izmjena kontakta za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdKontakti"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>
						</grid>
					</item>
				</group>
				<group cols="8" rows="1" groupbordervisible="true" col="1" row="2" spacing="2,2,1,2">
					<item row="1" col="1" highlight="false" height="40">
						<button name="btnUnos" caption="Unos" function="UNOS_KONTAKTI"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaKontakti"> 
									<parameter name="Caption" value="Unos kontakta za {parent.#txtPrezime} {parent.#txtIme}"/>		
									<parameter name="HRKadroviKontaktiId" value="0"/>   
									<parameter name="HRKadroviId" value="$HRKadroviId" />	

								</action>  
								<action type="control populate keepfocus" value="#grdKontakti"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>  
						</button>
					</item>
					<item row="1" col="2" highlight="false" height="40" >
						<button name="btnIzmjenaKontakta" caption="Izmjena" function="IZMJENA_KONTAKTI"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaKontakti">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviKontaktiId" value="#grdKontakti.@HRKadroviKontaktiId" />	
									<parameter name="Caption" value="Izmjena kontakta za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdKontakti"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>  
						</button>
					</item>
					<item row="1" col="3" highlight="false" height="40">
						<button name="btnBrisanjeKontakt" caption="Brisanje" function="BRISANJE_KONTAKTI"> 
							<event type="click">   
								<action type="confirm" value="Jeste li sigurni da želite obrisati izabrani zapis?">
									<action type="datarun nonquery" value="~dtBrisanjeKontakti">

									</action>
								</action>
								<action type="control populate" value="#grdKontakti,parent.#grdPodaci"></action>    
								<action type="control disable" value="#btnIzmjenaKontakta,btnBrisanjeKontakt" if="#grdKontakti.rowcount==0"/>
							</event>  
						</button>
					</item>

					<item row="1" col="4" colspan="4" highlight="false" height="40"/>
					<item row="1" col="8" highlight="false" height="40">
						<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
			</group>

		</layout>
		<datalist>
			<data command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtKontakti">
				<parameter name="@action" value="grid_Kontakt" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtBrisanjeKontakti">
				<parameter name="@action" value="brisanje"/>
				<parameter name="@HRKadroviKontaktiId" value="#grdKontakti.@HRKadroviKontaktiId"/>
			</data>
		</datalist>
	</form>

	<!-- FORMA ZA UNOS,IZMJENU-->
	<form name="frmUnosIzmjenaKontakti" caption="$Caption" width="380" height="200" fixedsize="true">
			<event type="init">
<action type="datarun reader" value="~dtKontakti" if="$HRKadroviKontaktiId!=0" />
		</event>
		<event type="shown">

		</event>
		<layout>
		<group cols="2" rows="3" groupbordervisible="true">
             <item row="1" col="1" caption="Naziv kontakta:" highlight="false" colspan="2">
				<comboedit name="cmbNazivKontakta" required="true" valuefield="HRKontaktiId" displayfield="Naziv" dataname="~dtGetKontakti" datavalue="~dtKontakti.@HRKontaktiId"/>
			</item>
			<item row="2" col="1" caption="Opis:" highlight="false" rowspan="2" colspan="2">
				<memoedit name="memOpis" required="true"  datavalue="~dtKontakti.@opis">
						</memoedit>
			</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$HRKadroviKontaktiId==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdKontakti">
									<action type="control focus" value="parent.#grdKontakti">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
							<action type="control enable" value="parent.#btnIzmjenaKontakta,parent.#btnBrisanjeKontakt"/>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!"/>
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
						<action if="$HRKadroviKontaktiId!=0">
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtKontakti">
				<parameter name="@action" value="getKontakti" />
				<parameter name="@HRKadroviKontaktiId" value="$HRKadroviKontaktiId" type="int"/>
			</data>
		<data command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtGetKontakti">
				<parameter name="@action" value="hrkontakti" />
				<parameter name="@hrkadroviid" value="$hrkadroviid" type="int"/>
				<parameter name="@HRKadroviKontaktiId" value="$HRKadroviKontaktiId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtUnos">
				<parameter name="@action" value="unos"/>
				<parameter name="@HRKadroviKontaktiId.output.int" variablename="noviID"></parameter>
				<parameter name="@hrkadroviid"  value="$HRKadroviId" />
				<parameter name="@HRKontaktiId"  value="#cmbNazivKontakta" />
				<parameter name="@Opis"  value="#memOpis" />
				<parameter name="@indGreske.output.int"/>				
			</data>
			<data  command="spHRManagerMaster_Podaci_Kontakti_CP" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@HRKadroviKontaktiId" value="$HRKadroviKontaktiId"/>
				<parameter name="@hrkadroviid"  value="$HRKadroviId" />
				<parameter name="@HRKontaktiId"  value="#cmbNazivKontakta" />
				<parameter name="@Opis"  value="#memOpis" />
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>
</root>