<root>
  <form name="frmIzmjPosloviRizik" caption="Izmjena datuma za: {parent.#grdPosloviRizik.@Naziv}" width="500" height="400" >
    <method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
    <event type="init">
      <action type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtZNRDMS" />
    </event>
    <event type="shown">
      <action type="control visible" value="#btnPrilozi" if="~dtZNRDMS.@Postavka==0">
        <parameter value="false"/>
      </action>
      <action type="control disable" value="#btnPrilozi" />
    </event>
    <layout>
      <group cols="8" rows="3" groupbordervisible="true" spacing="2,2,2,2">
        <rowsdefinition>
          <row position="1" size="30" />
          <row position="2" size="30" />
          <row position="3" size="40" />
        </rowsdefinition>
        <item  col="1" row="1" caption="Datum osposobljavanja:" highlight="false" textposition="left" colspan="5">
          <dateedit name="datDatumOsposobljavanja" datavalue="~dtGet.@DatumOsposobljavanja" allownull="true"/>
        </item>
        <item  col="1" row="2" caption="Datum isteka:" highlight="false" textposition="left" colspan="5">
          <dateedit name="datDatumIsteka" datavalue="~dtGet.@DatumIsteka" allownull="true"/>
        </item>
        <item  col="8" row="3" caption="" highlight="false" >
          <button name="btnPrilozi" caption="Priloži dokument" >
            <event type="click">
              <action type="method run" value="funDmsAdd">
                <parameter name="server" value="@@server" />
                <parameter name="database" value="@@database" />
                <parameter name="username" value="" />
                <parameter name="password" value="" />
                <parameter name="operaterid" value="@@operateriid"/>
                <parameter name="entityName" value="ZNRDjelatniciPosloviRizikPromet" />
                <parameter name="entityId" value="$NoviId" />
              </action>
            </event>
          </button>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add" >
          <event type="click">
            <action type="validate"/>
            <action type="datarun reader" value="~dtSpremi"  />
            <action type="variable value">
              <parameter name="$NoviId" value="~dtSpremi.@NoviId" type="int"/>
            </action>
            <action type="control enable" value="#btnPrilozi" />
            <action type="control disable" value="#btnSpremi" />
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRDjelatnici_Help" name="dtZNRDMS">
        <parameter name="@Action" value="DMS_dohvati"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtSpremi">
        <parameter name="@Action" value="PosloviRizik_izmjena"/>
        <parameter name="@DatumOsposobljavanja" value="#datDatumOsposobljavanja"/>
        <parameter name="@DatumIsteka" value="#datDatumIsteka"/>
        <parameter name="@ZNRDjelatniciPosloviRizikPrometId" value="$ZNRDjelatniciPosloviRizikPrometId"/>
      </data>
      <data command="spZNRDjelatnici_Query" name="dtGet">
        <parameter name="@Action" value="PosloviRizik_datumi"/>
        <parameter name="@ZNRDjelatniciPosloviRizikPrometId" value="$ZNRDjelatniciPosloviRizikPrometId"/>
      </data>
    </datalist>
  </form>
</root>