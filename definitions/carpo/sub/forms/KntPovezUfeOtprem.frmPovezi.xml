<root version="1.0.0.1">
<!-- u layout formi ne mora biti type master -->
<!-- pozivanje frome iz drugog xmla paziti na ime forme -->
	<form name="frmPovezi" caption="Povezivanje UFE i skl.dokumenata" statusbar="false">



					
		<event type="init">
			<action type="datarun reader"  value="~dtGetDataPovezi" />
			<!-- <action type="message"  value="~dtGetDataPovezi.@partneriid"/> -->
						
			
		</event>
	
		<event type="load">
		
							<action type="variable value" >
								<parameter name="lnUfaOtpremniceId" value="#grdPovezanaOtprema.@lnUfaOtpremniceId" type="int" if="#grdPovezanaOtprema.rowcount!=0"/>
	
							</action>	
							
					
		
			<!-- <action type="datarun reader"  value="~dtGetDataPovezi" /> -->
			
					<!-- <action type="variable value"> -->
							<!-- <parameter name="~dtGetDataPovezi.@KntPlanOtplateKrPoveziaId" value="#KntPlanOtplateKrPoveziaId" type="int"/> -->
					<!-- </action> -->
					<!-- <action type="message"  value="~dtGetDataPovezi.@partneriid"/> -->
					<action type="control value"  value="#txtBrojUFA" >
							<parameter value="~dtGetDataPovezi.@BrojUFA" readonly="true"></parameter>
					</action> 	
					<action type="control value"  value="#txtBrojRn" >
							<parameter value="~dtGetDataPovezi.@BrojRn" readonly="true"></parameter>
					</action> 					
					
					<action type="control value"  value="#txtPartner" >
							<parameter value="~dtGetDataPovezi.@Partner" readonly="true"></parameter>
					</action> 

					<action type="control value"  value="#curIznos" >
							<parameter value="~dtGetDataPovezi.@Iznos" readonly="true"></parameter>
					</action> 

					<!-- <action type="control value"  value="#LnUfaOtpremniceId" > -->
							<!-- <parameter value="~dtPovezana.@LnUfaOtpremniceId" readonly="true"></parameter> -->
					<!-- </action> -->


					<action type="control populate"  value="#grdPovezanaOtprema" />
					

 <!-- <action type="message"  value="~dtGetDataPovezi.@Fakturedobid"/>					  -->
			
		</event>
		

					
		
		<!-- <event type="shown"> -->
							<!-- <action type="control value"  value="#srcPartner"> -->
							<!-- <parameter value="~dtGetDataPovezi.@PartneriId" text="~dtGetDataPovezi.@Partner" ></parameter> -->
					<!-- </action>  -->
				<!-- </event> -->

	
	<layout textposition="left">
			<group cols="1" rows="3" > 
				
				 <group col="1" row="1" rows="1" cols="3"> 
				
						
				
					<item col="1" row="1" caption="Broj računa:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtBrojRn" valuefield="BrojRn" displayfield="Naziv" dataname="~dtGetDataPovezi.@BrojRn" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
					<item col="2" row="1" caption="BrojUFA:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtBrojUFA" valuefield="BrojUFA" displayfield="Naziv" dataname="~dtGetDataPovezi.@BrojUFA" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
					<item col="3" row="1"  caption="Iznos:" fontsizedelta="2" readonly="true">
						<textedit name="curIznos" value="0" format="n2" readonly="true"  textposition="right">
						</textedit>
					</item>
				</group>					

				 <group col="1" row="2" rows="1" cols="1"> 	
					<item col="1" row="1" caption="Partner:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtPartner" valuefield="Partner" displayfield="Naziv" dataname="~dtGetDataPovezi.@Partner" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
				</group>

						
								
				<!-- </group> -->
			
				
				 <group col="1" row="3"  cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdPovezanaOtprema" fontsizedelta="3" showtotalsum="True" dataname="~dtPovezana" type="master" async="true"  multiselect="true" savelayout="true"  bestfitonrefresh="true" wordwrap="true" > 
						
									
						<fields>
							<field name="VrstaDokumenta" caption="Vrsta Dokumenta"  fixwidth="120"  showtotalsum="false"/>
							<field name="Broj" caption="Broj" fixwidth="120" showtotalsum="false"/>
							<field name="DatumDokumenta" caption="Datum Dokumenta" showtotalsum="false"/>
							<field name="Partner" caption="Partner" showsum="false" fixwidth="200"/>
							<field name="PovezanIznos" caption="PovezanIznos" showsum="true" fixwidth="80"/> 
							<field name="NacinPovezivanja" caption="Način Povezivanja"  fixwidth="80"/> 
							<field name="Sistemuser" caption="Povezao"  fixwidth="80"/> 
							<field name="DatumPovezivanja" caption="Datum Povezivanja"  fixwidth="80"/> 

						</fields>
				
					</grid>
				</item>	
			
				</group>					
	
		
			</group>
			
		</layout>
	
	<panelbuttons>
		<buttons>
			<button name="btnPoveziOtp" caption="Poveži skl.dokumente">			
				<event type="click">
					
					<action type="form open" value="frmPoveziOtpremnice"> </action>	
					
				</event>
				
			</button>
			<button name="btnPonisti" caption="Poništi poveznicu">			
				<event type="click">
					<!-- <action type="variable value"> -->
								<!-- <parameter name="KntPlanOtplateKreditaId" value="#grdGrid.@KntPlanOtplateKreditaId" />								 -->
							<!-- </action> -->
							
							<action type="confirm" value="Želite li doista poništiti odabranu stavku?">							
								<action type="datarun nonquery" value="~dtPonisti">
									<action type="control populate keepfocus" value="#grdPovezanaOtprema" />
									 									 
								</action>
							</action>	
						<!-- <action type="message" value="global.$KntPrometId"/>							 -->
				</event>
			</button>

			<button  name="btnOdustani" caption="Odustani" type="cancel">
					<!-- <action type="control populate" value="#grdStavke"> -->
						<!-- <action type="control focus" value="#grdStavke"> -->
							<!-- <parameter value="$Fakturedobid" /> -->
						<!-- </action> -->
					<!-- </action> -->

			</button>
		</buttons>
	</panelbuttons>
	<!-- dohvat podataka -->
	<datalist>

		<data name="dtGetDataPovezi" command="spCKntUfaOtpremaQuery">
			 <parameter name="@action" value="2"></parameter> 
			 <parameter name="@Fakturedobid" value="global.$Fakturedobid"></parameter> 

		</data>
	
		<data name="dtPovezana" command="spCKntUfaOtpremaQuery">
			 <parameter name="@action" value="3"></parameter> 
			 <parameter name="@Fakturedobid" value="global.$FaktureDobId"></parameter> 

		</data>
		<data name="dtPonisti" command="spCKntUfaOtpremaAzur"> 
			 <parameter name="@action" value="2"></parameter> 
			 <parameter name="@LnUfaOtpremniceId" value="#grdPovezanaOtprema.@lnUfaOtpremniceId"></parameter> 
		</data>	
		
	</datalist>
	

	
	</form>
	<!-- kod poziva forme iiz druge forme, obavezno staviti poziv i na početnu formu -->
	<form name="frmPoveziOtpremnice" path="frmPoveziOtpremnice.xml"></form> 
</root>