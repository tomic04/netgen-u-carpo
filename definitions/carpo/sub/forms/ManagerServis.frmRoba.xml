				<parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId"/>
				<parameter name="@ServisId" value="parent.#cmbModel"/>
				<parameter name="@ID" value="$ServisRnDetId" if="$Edit==1"/>
				<parameter name="@Indikator" value="M"/>
				<parameter name="@RobaId" value="#srcRoba" if="$Edit==0"/>
				<parameter name="@Kolicina" value="#txtKolicinaKom"/>
				<parameter name="@JmId" value="#srcRoba.@JmId" if="$Edit==0"/>
				<parameter name="@OrgNettoCijenaKn" value="#bteNabavna"/>
