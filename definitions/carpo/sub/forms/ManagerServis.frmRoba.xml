				<parameter name="@CijenaPDV" value="#cusCalc.@CijenaPDV"/>
				<parameter name="@IznosBezPDV" value="#cusCalc.@IznosBezPDV"/>
				<parameter name="@IznosPDV" value="#cusCalc.@IznosPDV"/>
				<parameter name="@OrgRabatP" value="$OrgRabatP"/>
				<parameter name="@RabatP" value="#cusCalc.@RabatPosto"/>
				<parameter name="@Cassa" value="#cusCalc.@CassaPosto"/>
				<parameter name="@PorezP" value="#cusCalc.@PorezPosto"/>
				<parameter name="@Rabat1" value="#cusCalc.@RabatVrijednost1" if="$Edit==0"/>
				<parameter name="@Rabat2" value="#cusCalc.@RabatVrijednost2" if="$Edit==0"/>
				<parameter name="@Rabat3" value="#cusCalc.@RabatVrijednost3" if="$Edit==0"/>
				<parameter name="@Rabat4" value="#cusCalc.@RabatVrijednost4" if="$Edit==0"/>
				<parameter name="@Rabat5" value="#cusCalc.@RabatVrijednost5" if="$Edit==0"/>
				<parameter name="@Datum" value="#dateDatum"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@RealOrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@TrosOrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@RokIsporuke" value="#txtRokIsporuke"/>
				<parameter name="@RokPlacanja" value="#txtRokPlacanja"/>
				<parameter name="@HRKadroviId" value="parent.#srcIzvrsitelj"/>
				<parameter name="@ServisNacinObrId" value="#cmbNacinObracuna"/>
				<parameter name="@Opis" value="#memNapomena"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste"/>
				<parameter name="@ValuteId" value="$ValuteId"/>
				<parameter name="@TarifaId" value="$TarifaId"/>
			</data>
		</datalist>
	</form>
