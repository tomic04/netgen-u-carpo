		<datalist>
			<data name="dtRobaCijena" command="spServisRN_Kalk">
				<parameter name="@DatumDok" value="parent.#dateDatum"/>
				<parameter name="@PartneriId" value="parent.#srcPartner"/>
				<parameter name="@ParStruId" value="parent.#srcLokacija"/>
