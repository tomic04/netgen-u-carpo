			<data type="text" name="dtJMRoba" command="SELECT jmr.jmid, jm.naziv AS NazivDodatneJM, Faktor = CONVERT(DECIMAL(18,4), jmr.Faktor), jmr.FaktorFix FROM JMRoba jmr INNER JOIN jm ON jmr.JMId = jm.JmId WHERE jmr.robaid = @RobaId AND jmr.DefaultInd = 1">
				<parameter name="@RobaId" value="$RobaId"/>
