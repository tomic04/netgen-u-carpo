<?xml version="1.0" encoding="utf-8"?>
<root>
  <form name="frmLokacije" caption="Lokacija" width="600" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGetLokacija" if="$ParStruId!=null" />
      <action type="variable value">
        <parameter name="ParStruDodId" value="0" />
      </action>
      <action type="variable value">
        <parameter name="Pomocna" value="1" />
      </action>
    </event>
    <event type="load">
      <action type="control value" value="#chkSjediste" if="~dtGetLokacija.@HqInd==*">
        <parameter value="true"/>
      </action>
      <action type="control disable" value="#chkSjediste" if="~dtGetLokacija.@HqInd==*"/>
      <action type="control enable" value="#btnObilazak" if="$ParStruId!=null"/>
    </event>
    <event type="shown">
      <action type="control focus" value="#txtNaziv"/>
    </event>
    <layout itemspadding="3" textposition="left">
      <group cols="2" rows="7" >
        <rowsdefinition>
          <row position="2" size="5"/>
          <row position="4" size="1"/>
          <row position="5" size="40"/>
          <row position="6" size="5"/>
        </rowsdefinition>
        <group cols="3" rows="9" col="1" row="1" colspan="2" groupbordervisible="false" alignmode="local">
          <rowsdefinition>
            <row position="2" size="5"/>
            <row position="4" size="5"/>
            <row position="8" size="5"/>
          </rowsdefinition>
          <group cols="3" rows="1" col="1" row="1" colspan="3" groupbordervisible="false" >
            <columnsdefinition>
              <column position="1" size="100"/>
              <column position="2" size="100%"/>
              <column position="4" size="130"/>
            </columnsdefinition>
            <item  col="1" row="1" highlight="false" spacing="0,3,3,3">
              <checkedit name="chkSjediste" caption="Sjedište" value="false"/>
            </item>
            <item col="2" row="1"/>
            <group cols="1" rows="1" col="4" row="1" groupbordervisible="false" alignmode="local">
              <item caption="Šifra lokacije:" col="1" row="1" highlight="false" >
                <textedit name="txtSifraLokacije" datavalue="~dtGetLokacija.@SifraLokacije"/>
              </item>
            </group>
          </group>
          <item caption="Naziv:" col="1" row="3" colspan="3" fontbold="true" >
            <textedit name="txtNaziv" datavalue="~dtGetLokacija.@Naziv" required="true" fontbold="true"/>
          </item>
          <item caption="Adresa:" col="1" row="5" colspan="2" highlight="false" textposition="left" >
            <textedit name="txtAdresa" datavalue="~dtGetLokacija.@Adresa" />
          </item>
          <group cols="1" rows="3" col="3" row="5" rowspan="3" groupbordervisible="false" alignmode="local">
            <item caption="Mjesto:" col="1" row="1" highlight="false" textposition="left" >
              <comboedit name="cmbMjesto" valuefield="MjestaId" displayfield="Naziv" dataname="dtMjesta" datatext="~dtGetLokacija.@MjestaNaziv" datavalue="~dtGetLokacija.@MjestaId" />
            </item>
            <item caption="Fax:" col="1" row="2" highlight="false" textposition="left" >
              <textedit name="txtFax" datavalue="~dtGetLokacija.@Fax"/>
            </item>
            <item col="1" row="3"/>
          </group>

          <item caption="Telefon1:            " col="1" row="6" highlight="false" textposition="left" >
            <textedit name="txtTelefon1" datavalue="~dtGetLokacija.@Telefon1"/>
          </item>
          <group cols="1" rows="2" col="2" row="6" rowspan="2" groupbordervisible="false" alignmode="local">
            <item caption="Telefon2:" col="1" row="1" highlight="false" textposition="left" >
              <textedit name="txtTelefon2" datavalue="~dtGetLokacija.@Telefon2"/>
            </item>
            <item caption="WWW:" col="1" row="2" highlight="false" textposition="left" >
              <textedit name="txtWWW" datavalue="~dtGetLokacija.@WWW" />
            </item>  
          </group>
          
          
          <item caption="Email:" col="1" row="7" highlight="false" textposition="left" >
            <textedit name="txtEmail" datavalue="~dtGetLokacija.@Email"/>
          </item>
          
          <item col="3" row="7"/>
          <group cols="1" rows="1" col="1" row="9" colspan="3" groupbordervisible="false" alignmode="local">
            
          </group>
        </group>
        <group cols="2" rows="7" col="1" row="3" colspan="2" groupbordervisible="false" alignmode="local">
          <rowsdefinition>
            <row position="2" size="5"/>
          </rowsdefinition>
          <item caption="Adresa za poštu:" col="1" row="1" colspan="2" highlight="false" textposition="left">
            <memoedit name="txtAdresaPosta" ></memoedit>
          </item>
          <item caption="PDV ID:" col="1" row="3" textposition="left" highlight="false" >
            <textedit name="txtPDVID" datavalue="~dtGetLokacija.@PorezniBr" />
          </item>
          <item caption="GLN broj:" col="1" row="4" textposition="left" highlight="false" >
            <textedit name="txtGLN" datavalue="~dtGetLokacija.@GLN" format="\d{13}" formattype="regex" textposition="left" />                                                              <!-- provjeriti kako se treba isformatirati -->
          </item>
          <item caption="Trošarinski broj:" col="1" row="5" textposition="left" highlight="false">
            <textedit name="txtTrosarinski" datavalue="~dtGetLokacija.@TrosBrojSk" />
          </item>
          <item caption="JIBG broj:" col="1" row="6" textposition="left" highlight="false" >
            <textedit name="txtJIBGbroj" datavalue="~dtGetLokacija.@JIBG"/>
          </item>
          <item caption="IKG broj:" col="1" row="7" textposition="left" highlight="false">
            <textedit name="txtIKGbroj" datavalue="~dtGetLokacija.@IKG"/>
          </item>
          <item caption="Plaćanje na žiro:" col="2" row="3" textposition="left" highlight="false" >
            <comboedit name="cmbZiroRacuni" valuefield="ParZiroId" displayfield="Naziv" dataname="dtZiroRacuni" datavalue="~dtGetLokacija.@parziroid"/>
          </item>
          <item caption="Komercijalist:" col="2" row="4" textposition="left" highlight="false" >
            <comboedit name="cmbKomercijalist" valuefield="OsobeId" displayfield="Naziv" dataname="dtKomercijalist" datavalue="~dtGetLokacija.@Osobeid"/>
          </item>
          <item caption="Napomena:" col="2" row="5" textposition="left" highlight="false" >
            <textedit name="txtNapomena" datavalue="~dtGetLokacija.@Napomena"/>
          </item>
          <item caption="Skladište:" col="2" row="6" textposition="left" highlight="false" >
            <comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="opis" dataname="dtSkladiste" datavalue="~dtGetLokacija.@skladisteid"/>
          </item>
          <item caption="Tip:" col="2" row="7" textposition="left" highlight="false" >
            <comboedit name="cmbTip" valuefield="ParAsortimanTipSifra" displayfield="Naziv" dataname="dtTip" datavalue="~dtGetLokacija.@ParAsortimanTipSifra"/>
          </item>
        </group>
        <group cols="2" rows="1" col="1" row="5" colspan="2" groupbordervisible="false" >
          <columnsdefinition>
            <column position="2" size="95"/>
          </columnsdefinition>
          <item col="1" row="1"/>
          <item col="2" row="1" >
            <button name="btnObilazak" caption="OBILAZAK" enabled="false">
              <event type="click">
                <action type="form open" value="frmObilazak">
                  <parameter name="ParStruId" value="$ParStruId"/>
                </action>
              </event>
            </button>
          </item>
        </group>
        <group caption="Dostava" cols="2" rows="3" col="1" row="7" colspan="2" spacing="-1,4,-1,-1">
          <item caption="Lokacija dostave:" col="1" row="1" colspan="2" textposition="left" highlight="false">
            <comboedit name="cmbLokacijaDostave" valuefield="ParStruId" displayfield="Naziv" datavalue="~dtGetLokacija.@ParStruDodId" dataname="dtLokacijeDostava"/>
          </item>
          <item caption="Skraćeni naziv:" col="1" row="2" textposition="left" highlight="false">
            <textedit name="txtNazivSkraceni" datavalue="~dtGetLokacija.@NazivSkraceni" />
          </item>
          <item caption="Kategorija isporuke:" col="2" row="2" textposition="left" highlight="false">
            <comboedit name="cmbKategorijaIsporuke" valuefield="ParStruKategorijaId" displayfield="Naziv" dataname="dtKategorijaIsporuke" datavalue="~dtGetLokacija.@ParStruKategorijaId"/>
          </item>
          <item caption="GPS latitude:" col="1" row="3" textposition="left" highlight="false">
            <textedit name="txtGPSlat" format="n6" value="0" datavalue="~dtGetLokacija.@GPSLatitude"/>
          </item>
          <item caption="GPS longitude:" col="2" row="3" textposition="left" highlight="false">
            <textedit name="txtGPSlon" format="n6" value="0" datavalue="~dtGetLokacija.@GPSLongitude" />
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI" dock="left">
          <event type="click">
            <action type="variable value" if="#chkSjediste==true">
              <parameter name="Sjediste" value="1" type="int"></parameter>
            </action>
            <action type="variable value" else="">
              <parameter name="Sjediste" value="0" type="int"></parameter>
            </action>
            <action type="validate"/>
            <action type="datarun nonquery" value="~dtLokacijeEdit" if="$ParStruId!=null" />
            <action type="datarun nonquery" value="~dtLokacijeAdd" else="" />
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spPartneriQuery" name="dtGetLokacija">
        <parameter name="@Action" value="222"/>
        <parameter name="@ID" value="$ParStruId"/>
        <parameter name="@IDPartneri" value="0"/>
        <parameter name="@DownUnder" value="0"/>
        <parameter name="@SortKey" value=""/>
        <parameter name="@Naziv" value=""/>
        <parameter name="@Sifra" value=""/>
      </data>
      <data command="spMjestaQuery" name="dtMjesta">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
        <parameter name="@Naziv" value=" " />
        <parameter name="@HPTBroj" value=" " />
      </data>
      <data command="spCrKatalog" name="dtZiroRacuni">
        <parameter name="@Action" value="ziro"/>
        <parameter name="@PartneriId" value="118"/>
      </data>
      <data command="spOsobeQuery" name="dtKomercijalist">
        <parameter name="@Action" value="16"/>
      </data>
      <data command="spParAsortimanTipQuery" name="dtTip"/>
      <data command="spSkladisteQuery" name="dtSkladiste">
        <parameter name="@Action" value="0"/>
      </data>
      <data command="spParStruKategorijaQuery" name="dtKategorijaIsporuke">
        <parameter name="@Action" value="0"/>
      </data>

      <data command="spPartneriAzur" name="dtLokacijeEdit">
        <!-- polja koje stora nužno mora primiti -->
        <parameter name="@Action" value="11"/>
        <parameter name="@ID" value="0"/>
        <parameter name="@Veza" value="0"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@Telefon1" value="#txtTelefon1"/>
        <parameter name="@Telefon2" value="#txtTelefon2"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@Www" value="#txtWWW"/>                                                  <!-- u ovom djelu treba postaviti NULLVALUE kad bude realiziran -->
        <parameter name="@Email" value="#txtEmail"/>
        <parameter name="@MatBroj" value="~dtGetLokacija.@MatBroj"/>
        <parameter name="@DjelatnostiId" value="~dtGetLokacija.@DjelatnostiId"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@HqInd" value="$Sjediste"/>
        <parameter name="@ParStruId" value="~dtGetLokacija.@ParStruId"/>
        <parameter name="@Memo" value=""/>
        <parameter name="@Udaljenost" value="0"/>
        <parameter name="@Sifra" value=""/>
        <parameter name="@SifraLokacije" value="#txtSifraLokacije"/>
        <parameter name="@PorezniBroj" value="~dtGetLokacija.@PorezniBroj"/>
        <!-- polja koje stora nužno NE mora primiti -->
        <parameter name="@Osobeid" value="#cmbKomercijalist"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@ParAsortimanTipSifra" value="#cmbTip" />
        <parameter name="@ParZiroId" value="#cmbZiroRacuni"/>
        <parameter name="@Naziv2" value="~dtGetLokacija.@Naziv2"/>
        <parameter name="@SkladisteId" value="#cmbSkladiste"/>
        <parameter name="@GLN" value="#txtGLN"/>
        <parameter name="@ProNacinNaplateId" value="~dtGetLokacija.@ProNacinNaplateId"/>
        <parameter name="@JIBG" value="#txtJIBGbroj"/>
        <parameter name="@IKG" value="#txtIKGbroj"/>
        <parameter name="@TrosBrojSk" value="#txtTrosarinski"/>
        <parameter name="@PorezniBr" value="#txtPDVID"/>
        <parameter name="@ParStruDodId" value="#cmbLokacijaDostave"/>
        <parameter name="@ParStruKategorijaId" value="#cmbKategorijaIsporuke"/>
        <parameter name="@NazivSkraceni" value="#txtNazivSkraceni"/>
        <parameter name="@GPSLatitude" value="#txtGPSlat"/>
        <parameter name="@GPSLongitude" value="#txtGPSlon"/>
        <parameter name="@AdresaPosta" value="#txtAdresaPosta"/>
      </data>
      <data command="spPartneriAzur" name="dtLokacijeAdd">
        <!-- polja koje stora nužno mora primiti -->
        <parameter name="@Action" value="10"/>
        <parameter name="@ID" value="0"/>
        <parameter name="@Veza" value="0"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@Telefon1" value="#txtTelefon1"/>
        <parameter name="@Telefon2" value="#txtTelefon2"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@Www" value="#txtWWW"/>
        <parameter name="@Email" value="#txtEmail"/>
        <parameter name="@MatBroj" value=""/>
        <parameter name="@DjelatnostiId" value="$DjelatnostiId"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@HqInd" value="$Sjediste"/> 
        <parameter name="@ParStruId" value="0"/>
        <parameter name="@Memo" value=""/>
        <parameter name="@Udaljenost" value="0"/>
        <parameter name="@Sifra" value=""/>
        <parameter name="@SifraLokacije" value="#txtSifraLokacije"/>
        <parameter name="@PorezniBroj" value=""/>
        <!-- polja koje stora nužno NE mora primiti -->
        <parameter name="@Osobeid" value="#cmbKomercijalist"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@ParAsortimanTipSifra" value="#cmbTip" />
        <parameter name="@ParZiroId" value="#cmbZiroRacuni"/>
        <parameter name="@SkladisteId" value="#cmbSkladiste"/>
        <parameter name="@GLN" value="#txtGLN"/>
        <parameter name="@JIBG" value="#txtJIBGbroj"/>
        <parameter name="@IKG" value="#txtIKGbroj"/>
        <parameter name="@TrosBrojSk" value="#txtTrosarinski"/>
        <parameter name="@PorezniBr" value="#txtPDVID"/>
        <parameter name="@ParStruDodId" value="#cmbLokacijaDostave"/>
        <parameter name="@ParStruKategorijaId" value="#cmbKategorijaIsporuke"/>
        <parameter name="@NazivSkraceni" value="#txtNazivSkraceni"/>
        <parameter name="@GPSLatitude" value="#txtGPSlat"/>
        <parameter name="@GPSLongitude" value="#txtGPSlon"/>
        <parameter name="@AdresaPosta" value="#txtAdresaPosta"/>
      </data>
      <data command="spPartneriQuery" name="dtLokacijeDostava">
        <parameter name="@Action" value="2"/>
        <parameter name="@ID" value="$PartneriId"/>
        <parameter name="@IDPartneri" value="0"/>
        <parameter name="@DownUnder" value="0"/>
        <parameter name="@SortKey" value=""/>
        <parameter name="@Naziv" value=""/>
        <parameter name="@Sifra" value=""/>
      </data>
    </datalist>
  </form>

  <form name="frmObilazak" caption="Obilazak">
    <event type="init">
      <action type="datarun reader" value="~dtRajon"/>
    </event>
    <event type="load">
      <!--<action type="message" value="~dtRajon.rowcount"/>-->
      <action type="variable value" if="~dtRajon.rowcount!=0">
        <parameter name="varUnosIzmjena" value="Izmjena" />
      </action>
      <action type="variable value" else="">
        <parameter name="varUnosIzmjena" value="Unos"/>
      </action>
    </event>
    <layout>
      <group cols="1" rows="3">
        <item caption="Rajon:" col="1" row="1" highlight="false">
          <searchedit name="srcRajon" required="true" fontsizedelta="1" fieldtext="Naziv" fieldvalue="rajonid" datavalue="~dtRajon.@rajonid" datatext="~dtRajon.@opis" dataname="dtRajonProvjera"/>                                       <!-- Vidjeti kad se sve završi šta je sa % -->
        </item>
        <item caption="Datum obilaska:" col="1" row="2" highlight="false">
          <dateedit name="datDatumObilaska" required="true" datavalue="~dtRajon.@obilazakdatum"/>
        </item>
        <item caption="Frekvencija obilaska:" col="1" row="3" highlight="false">
          <textedit name="txtFrekvencijaObilaska" required="true" datavalue="~dtRajon.@obilazakfrekvencija"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <action type="validate"/>
            <action type="datarun nonquery" value="~dtRajonAdd" if="$varUnosIzmjena==Unos"/>
            <action type="datarun nonquery" value="~dtRajonEdit" elseif="$varUnosIzmjena==Izmjena"/>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnObrisi" caption="OBRIŠI">
          <event type="click">
            <action type="confirm" value="Želite li doista obrisati obilazak?">
              <action type="datarun nonquery" value="~dtRajonDelete"/>
              <action type="form close"/>
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spParStruObilazakQuery_Carpo" name="dtRajon">                                                                                                     <!-- obavezno provjerit ovu storu prije samog kraja, nešto je sumnjiva :) -->
        <parameter name="@Action" value="0"/>
        <parameter name="@ID" value="$ParStruId"/>
      </data>
      <data command="spParStruObilazakQuery_Carpo" name="dtRajonProvjera">
        <parameter name="@Action" value="1"/>
        <parameter name="@Naziv" value="#srcRajon.text"/>
      </data>
      <data command="spParStruObilazakAzur_Carpo" name="dtRajonAdd">
        <parameter name="@Action" value="0"/>
        <parameter name="@ID" value="0"/>
        <parameter name="@ParStruRajonId" value="0"/>
        <parameter name="@ParStruId" value="$ParStruId"/>
        <parameter name="@RajonId" value="#srcRajon"/>
        <parameter name="@ObilazakDatum" value="#datDatumObilaska"/>
        <parameter name="@ObilazakFrekvencija" value="#txtFrekvencijaObilaska"/>
      </data>
      <data command="spParStruObilazakAzur_Carpo" name="dtRajonEdit">                                               <!-- kretenski napravljena stora (@ID i @ParStruRajonId), nisam ja ... -->
        <parameter name="@Action" value="1"/>
        <parameter name="@ID" value="~dtRajon.@parstrurajonid"/>
        <parameter name="@ParStruRajonId" value="0"/>
        <parameter name="@ParStruId" value="~dtRajon.@parstruid"/>
        <parameter name="@RajonId" value="#srcRajon"/>
        <parameter name="@ObilazakDatum" value="#datDatumObilaska"/>
        <parameter name="@ObilazakFrekvencija" value="#txtFrekvencijaObilaska"/>
      </data>
      <data command="spParStruObilazakAzur_Carpo" name="dtRajonDelete">
        <parameter name="@Action" value="2"/>
        <parameter name="@ID" value="0"/>
        <parameter name="@ParStruRajonId" value="~dtRajon.@parstrurajonid"/>
        <parameter name="@ParStruId" value="0"/>
      </data>
    </datalist>
  </form>
</root>
