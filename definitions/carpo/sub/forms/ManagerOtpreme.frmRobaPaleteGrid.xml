<root>
    <form name="frmRobaPaleteGrid" caption="Palete" fixedsize="false" width="800" height="570">
		<event type="onload">
			<action type="datarun nonquery" value="~dtDetPalete" />
			<action type="control populate" value="#grdPalete" />
			<!--<action type="control disable" value="#btnEditAmb, #btnDeleteAmb" if="#grdPalete.rowcount==0"/>-->
			<!--<action type="control enable" value="#btnEditAmb, #btnDeleteAmb" else="" />-->				
		</event>
		<event type="onshown">
			<event type="shown">
				<action type="control focus" value="#grdPalete"/>
			</event>
		</event>
		<layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols ="1" rows="1" groupbordervisible="False">
                    <item row="1" col="1" colspan="2">
                        <grid name="grdPalete" async="true" dataname="dtDetPalete" key="ProNotpDet_PaleteId" showgrouppanel="False" multiselect="true">
                            <fields>					
                                <field name="Sifra" caption="Šifra" />
                                <field name="Paleta" caption="Vrsta palete" />
                                <field name="Kolicina" caption="Količina" formatstring="n2" editable="true"/>
                            </fields>
							<event type="cellvaluechanged">
								<action type="datarun nonquery" value="~dtUpdate" />
								<action type="control populate keepfocus" value="#grdPalete" />
							</event>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="IZLAZ" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_NotpDet_getPalete" name="dtDetPalete">
				<parameter name="@Action" value="1" />
				<parameter name="@ProNotpDetId" value="parent.$ProNotpDetId" type="int" />
				<parameter name="@RobaId" value="parent.#srcRoba" />
				<parameter name="@ProNotpGlaId" value="parent.$ProNotpGlaId" />

            </data>
            <data command="spProd_NotpDet_Palete_Unos" name="dtUpdate">
				<parameter name="@ProNotpDetId" value="parent.$ProNotpDetId" type="int"/>	
				<parameter name="@ProNotpGlaId" value="parent.$ProNotpGlaId" />
				<parameter name="@RobaId" value="#grdPalete.@RobaPaletaId" />
				<parameter name="@Kolicina" value="#grdPalete.@Kolicina" />
				<parameter name="@ProNotpDet_PaleteId" value="#grdPalete.@ProNotpDet_PaleteId" />
				<parameter name="@OperateriId" value="@@OperateriId" />					
            </data>			
        </datalist>
    </form>
</root>