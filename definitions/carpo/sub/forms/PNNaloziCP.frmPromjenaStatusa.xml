<root version="1.0">
	<!--
  *******************************************************************************************
  FORMA ZA PROMJENU STATUSA
  *******************************************************************************************
  -->
	<form name="frmPromjenaStatusa" caption="$caption" width="500" height="150" fixedsize="true" saveformsize="false">
		
		
		<layout>
			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="false">
				<item row="1" col="1" caption="Status:" textposition="top" highlight="false">
					<comboedit name="cmbStatusi" valuefield="pnstatusiid" displayfield="Naziv" dataname="~dtStatusi" datavalue="~dtGetPutniNalog.@pnstatusiid" allownull="false" function="PromjenaStatusa"/>
				</item>
			</group>
			<!--kraj omotača-->
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPromjena" caption="Promijeni status" width="150">
					<event type="click">
						<action type="datarun reader" value="~dtPromjenaStatusa"/>
						<action if="$indGreske==0">
							<!-- <action type="message" value="Uspješno spremljeno!"/> -->
							<action type="message" value="$poruka"/>
							<action type="control populate" value="parent.#tree"/>
							<!-- postavi fokus na mastergridu -->
							<action type="control focus" value="parent.#grdMaster">
								<parameter value="global.$pnnaloziid" type="int"/>
							</action>
							
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPNPromjenaStatusa" name="dtPromjenaStatusa">
				<parameter name="@action" value="promjena_status_niz"/>
				<parameter name="@ids" value="$ids"/>
				<parameter name="@pnstatusiid" value="#cmbStatusi"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<!-- obzirom se mora multiselect naloga, jedan od njih je u global.$PNNaloziId pa ga mogu proslijediti da dobijem mogući status za postavljanje -->
			<data command="spPNPromjenaStatusa" name="dtStatusi">
				<parameter name="@action" value="statusi"/>
				<parameter name="@pnnaloziid" value="global.$PNNaloziId"/>
			</data>
		</datalist>
	</form>
</root>