<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmPotvrdiUvjeteDonos" caption="" width="250" height="200" >
		<event type="init">
			<action type="datarun reader" value="~dtInfo"/>
		</event>	
		<layout textposition="left">
			<group cols="1" rows="1" bordervisible="false">
				<item  row="1" col="1" >
					<labeledit name="lblPitanje" value="Prihvaćate li uvjete s izvornog dokumenta?" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDa" caption="Da">
					<action type="variable value" >
						<parameter name="parent.PrepisiUvjete" value="1" />
					</action>				
				</button>
			</buttons>
			<buttons>
				<button name="btnNe" caption="Ne">
					<action type="variable value" >
						<parameter name="parent.PrepisiUvjete" value="0" />
					</action>				
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>
