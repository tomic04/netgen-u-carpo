<root>
	<!--FORMA ZA UNOS -->
	<!--
  Komentari:
  v3: 24.9.2021. MP - za cmb_smjene šaljem orgshemaid, mjesec, godina, operatera, selectedids, te se cmb_smjene puni na promjenu orgsheme 
  v2: 10.9.2021. MP - dodao disejblanje čvorova orgsheme na koja operater nema pravi i provjeru istih na spremanju (obzirom se strelicom može odabrati zabranjena orgshema)
  9.9.2021. Marin - namjestio captione za checkedite, širinu grida u odnosu na kontrole
  10.08.2021. Jadranka Vučenović Vojvodić - kreirala formu ver 1.0.
  -->
	<form name="frmUnos" caption="$Caption" width="800" height="500" saveformsize="false" fixedsize="true" showversion="true" version="3">
		<event type="init">
			<action type="datarun reader" value="~dtSetRazdobljeUnos"/>
			<action type="datarun reader" value="~dtGet" if="$dneev_mpid!=0"/>
			
			
		</event>
		
		<event type="shown">
			<!-- zatvori formu ako nemaš ljude -->
			<action if="$selectedids==null">
				<action type="form close"/>
			</action>
			
			<action if="$dneev_mpid==0">
				<action type="control value" value="#txtRazdobljeOd">
					<parameter value="$setDan"/>
				</action>
				<action type="control value" value="#txtRazdobljeDo">
					<parameter value="$setDan"/>
				</action>
				<action type="control value" value="#chckSubote">
					<parameter value="$setSubote"/>
				</action>
				<action type="control value" value="#chckNedjelje">
					<parameter value="$setNedjelje"/>
				</action>
				<action type="datarun reader" value="~dtVrijeme"/>
				<action type="control value" value="#txtVrijemeOd">
					<parameter value="~dtVrijeme.@VrijemeOd"/>
				</action>
				<action type="control value" value="#txtVrijemeDo">
					<parameter value="~dtVrijeme.@VrijemeDo"/>
				</action>
				<action type="control value" value="#txtRazdobljeOd">
					<parameter value="~dtSetRazdobljeUnos.@DanOd"/>
				</action>
				<action type="control value" value="#txtRazdobljeDo">
					<parameter value="~dtSetRazdobljeUnos.@DanDo"/>
				</action>
				
			</action>
			

		</event>
		<layout>
			<group rows="1" cols="1" groupbordervisible="False">
				<group row="1" col="1" spacing="2,2,2,2" rows="9" cols="4">
					<rowsdefinition>
						<row size="35" position="9"/>
					</rowsdefinition>
					<!--MARIN 9.9. bez ovog, kontrole se preklope preko grida-->
					<columnsdefinition>
						<column position="1" size="13%"/>
						<column position="2" size="11%"/>
						<column position="3" size="11%"/>
						<column position="4" size="11%"/>
					</columnsdefinition>
					
					<item row="1" col="1" rowspan="9" colspan="2" caption="" textvisible="False">
						<grid name="grdDjelatnici" autopopulate="true" dataname="~dtPrikazDjelatnika" key="HRKadroviId" keyfield="HRKadroviId" multiselect="True" preventfocusgroup="False" bestfitonrefresh="True" showgrouppanel="False" fieldsmartspaces="False" layoutname="" savelayout="true">
							<fields inherited="True">
								<field name="CarpoRowNumberColumn" caption="Rbr" fixed="true"/>
							</fields>
						</grid>
					</item>
					<item row="1" col="3" colspan="2" caption="Organizacijska jedinica" textposition="left" highlight="False">
						<combotreeedit name="cmbOrgJedinica" required="false" tooltip="Orgshema lista" allownull="True" valuefield="Id" displayfield="Naziv" parentfieldname="parent" dataname="~dtOrgJedinica" datavalue="~dtGet.@Orgshemaid" >
						</combotreeedit>
					</item>
					<item row="2" col="3" colspan="2" caption="Dimenzija:" textposition="left" highlight="False">
						<searchedit name="srcDimenzija" dataname="~dtDimenzije" fieldtext="Dimenzija" fieldvalue="DimenzijeId" datavalue="~dtGet.@DimenzijeId"  datatext="~dtGet.@Dimenzija" />
					</item>
					<item row="3" col="3" caption="Razdoblje:" textposition="left" highlight="False">
						<textedit name="txtRazdobljeOd" maxlength="2" datavalue="~dtGet.@DanOd" />
					</item>
					<item row="3" col="4" caption=" " textposition="right" highlight="False">
						<textedit name="txtRazdobljeDo" maxlength="2" datavalue="~dtGet.@DanOd" />
					</item>
					<item row="4" col="3" colspan="2" caption="Smjena:" textposition="left" highlight="False">
						<comboedit name="cmbSmjena" valuefield="Dne_SmjeneId" displayfield="Naziv" dataname="~dtSmjene" required="true" allownull="false" datavalue="~dtGet.@Dne_SmjeneId">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtVrijeme"/>
								<action type="control value" value="#txtVrijemeOd">
									<parameter value="~dtVrijeme.@VrijemeOd"/>
								</action>
								<action type="control value" value="#txtVrijemeDo">
									<parameter value="~dtVrijeme.@VrijemeDo"/>
								</action>
							</event>
						</comboedit>
					</item>
					<item row="5" col="3" caption="Vrijeme od-do:" textposition="left" highlight="False">
						<textedit name="txtVrijemeOd" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="False" datavalue="~dtGet.@SatOd"/>
					</item>
					<item row="5" col="4" caption=" " textposition="right" highlight="False">
						<textedit name="txtVrijemeDo" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="False" datavalue="~dtGet.@SatDo"/>
					</item>
					<!--MARIN 9.9.2021.-->
					<group row="6" col="3" rows="1" cols="2" groupbordervisible="false">
						<item row="1" col="1" padding="4,39,6,0">
							<labeledit value="Uključi subote:"/>
						</item>
						<item row="1" col="2" highlight="False">
							<checkedit name="chckSubote" datavalue="~dtGet.@chckSubote"/>
						</item>
					</group>
					<group row="7" col="3" rows="1" cols="2" groupbordervisible="false">
						<item row="1" col="1" padding="4,34,6,0">
							<labeledit value="Uključi nedjelje:"/>
						</item>
						<item row="1" col="2" highlight="False">
							<checkedit name="chckNedjelje" datavalue="~dtGet.@chckNedjelje"/>
						</item>
					</group>
					<item row="8" col="3" textvisible="False" highlight="False"/>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrihvati" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						
						<!-- traži pravo na odabranu orgshemu -->
						<action type="datarun reader" value="~dtPravoNaOrg"/>
						<!-- u varijablu spremi vrijednost orgshemaopid						 -->
						<action type="variable value" value="nastavak">
							<parameter value="~dtPravoNaOrg.@Pravo"/>
						</action>
						<!-- ako nemaš pravo javi porukom -->
						<action if="$nastavak==0">
							<action type="message" value="Nemate pravo na odabranu org jedinicu"/>
						</action>
						<!-- stopiraj daljnje izvršavanje ako uvjet nije zadovoljen...obrnuta logika!! -->
						<action if="$nastavak!=0"  stop="true">
						</action>
						
						<action if="$dneev_mpid==0">
							<action type="datarun reader" value="~dtSpremi"/>
							<!-- <action type="message" value="$indGreske" /> -->
							<!-- <action type="message" value="$poruka" /> -->
						</action>
						<action if="$dneev_mpid!=0">
							<action type="datarun reader" value="~dtIzmijeni"/>
							<!-- <action type="message" value="$indGreske" /> -->
							<!-- <action type="message" value="$poruka" /> -->
						</action>
						<!-- <action type="message" value="$indGreske" /> -->
						<!-- <action type="message" value="$poruka" /> -->
						<action if="$indGreske==0">
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<!-- <event type="click">
						<action type="form close"/>
					</event> -->
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spERVHelp" name="dtPravoNaOrg">
				<parameter name="@Action" value="daj_pravo_na_org"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@id" value="#cmbOrgJedinica"/>
			</data>
			<!--data koji puni Master grid grida-->
			<data command="spERVMasterQuery" name="dtRefreshRow">
				<parameter name="@Action" value="Master"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@godina" value="#tree.@godina"/>
				<parameter name="@mjesec" value="#tree.@mjesec"/>
				<parameter name="@hrkadroviid" value="parent.#grdERV.@hrkadroviid"/>
			</data>
			<data command="spERVHelp" name="dtOrgJedinica">
				<parameter name="@action" value="cmb_orgshema"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spERVHelp" name="dtDimenzije">
				<parameter name="@action" value="src_dimenzije"/>
				<parameter name="@tekst" value="#srcDimenzija.text"/>
			</data>
			<data command="spERVHelp" name="dtSmjene">
				<parameter name="@action" value="cmb_smjene"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@orgshemaid" value="#cmbOrgJedinica"/>
				<parameter name="@selectedids" value="$selectedids"/>
			</data>
			<data command="spERVHelp" name="dtVrijeme">
				<parameter name="@action" value="getVrijeme"/>
				<parameter name="@Dne_SmjeneId" value="#cmbSmjena"/>
			</data>
			<data command="spERVHelp" name="dtPrikazDjelatnika">
				<parameter name="@action" value="unos_vise"/>
				<parameter name="@selectedids" value="$selectedids"/>
			</data>
			<data command="spERVHelp" name="dtSetRazdobljeUnos">
				<parameter name="@action" value="setRazdobljeUnos"/>
				<parameter name="@dneev_mpid" value="$dneev_mpid"/>
			</data>
			<data command="spERVHelp" name="dtGet">
				<parameter name="@action" value="podatak_dneev_mp"/>
				<parameter name="@dneev_mpid" value="$dneev_mpid"/>
			</data>
			<data command="spERVAzur" name="dtSpremi">
				<parameter name="@action" value="unos_niz"/>
				<parameter name="@dneev_mpid" value="0" type="int"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@nizid" value="$selectedids"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@danod" value="#txtRazdobljeOd" type="int"/>
				<parameter name="@dando" value="#txtRazdobljeDo" type="int"/>
				<parameter name="@satod" value="#txtVrijemeOd"/>
				<parameter name="@satdo" value="#txtVrijemeDo"/>
				<parameter name="@orgshemaid" value="#cmbOrgJedinica"/>
				<parameter name="@dne_smjeneid" value="#cmbSmjena"/>
				<parameter name="@dimenzijeid" value="#srcDimenzija"/>
				<parameter name="@chsubota" value="#chckSubote"/>
				<parameter name="@chnedjelja" value="#chckNedjelje"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spERVAzur" name="dtIzmijeni">
				<parameter name="@action" value="unos_niz"/>
				<parameter name="@dneev_mpid" value="$dneev_mpid" type="int"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@nizid" value="$selectedids"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@danod" value="#txtRazdobljeOd" type="int"/>
				<parameter name="@dando" value="#txtRazdobljeDo" type="int"/>
				<parameter name="@satod" value="#txtVrijemeOd"/>
				<parameter name="@satdo" value="#txtVrijemeDo"/>
				<parameter name="@dne_smjeneid" value="#cmbSmjena"/>
				<parameter name="@dimenzijeid" value="#srcDimenzija"/>
				<parameter name="@chsubota" value="#chckSubote"/>
				<parameter name="@chnedjelja" value="#chckNedjelje"/>
				<parameter name="@indGreske.output.int"></parameter>
				<parameter name="@poruka.output.string"></parameter>
			</data>
		</datalist>
	</form>
</root>