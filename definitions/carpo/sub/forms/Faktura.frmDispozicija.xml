<?xml version="1.0" encoding="utf-8"?>
<root>
	<form type="master" name="frmDispozicija" caption="Dispozicija za izvoz">
		<event type="init">
			<action type="datarun reader" value="global.~dtGetDispozicija" />
		</event>
		<event type="shown">
			<action type="control value" value="#srcpartner" >
				<parameter value="$PartneriId" text="$Kupac"/>
			</action>
			<action type="variable value" >
				<parameter name="OldBroj" value="#txtBroj" />
				<parameter name="SearchInd" value="0" type="int"/>
			</action>			
		</event> 
		<layout textposition="left">
			<group rows="3" cols="1">
				<group row="1" col="1" rows="1" cols="3">
					<item row="1" col="1" caption="Broj:" textposition="top">
						<textedit name="txtBroj" value="" datavalue="#dtGetDispozicija.@NewBroj" required="true">
							<event type="leave">
								<action type="confirm" value="Želite li ispisati dispoziciju broj: '{#txtBroj}' ?"  if="$OldBroj!=#txtBroj">
									<action type="datarun reader" value="~dtDispProvjeraPrint" />
									<action type="variable value" >
										<parameter name="DispIspisInd" value="~dtDispProvjeraPrint.@DispozicijaGlaId" />
									</action>									
									<action if="$DispIspisInd==0">
										<action type="message" value="Broj dispozicije '{#txtBroj}' nije ispravan!" />
									</action>
									<action else="">
										<!-- tu ide poziv ispisa -->
									</action>
								</action>
							</event>						
						</textedit>
					</item>
					<item row="1" col="2" caption="Broj Dok:" textposition="top">
						<textedit name="txtBrojDok" value="" enabled="false" datavalue="#dtGetDispozicija.@NewBrojDok" required="true" />
					</item>
					<item row="1" col="3" caption="Broj Zaduženja:" textposition="top">
						<textedit name="txtBrojZakljucka" value="" datavalue="#dtGetDispozicija.@BrojZakljucka" />
					</item>
				</group>
				<!-- <group row="2" col="1" rows="1" cols="2"> -->
				<!-- <item row="1" col="1" caption="Datum:" > -->
				<!-- <dateedit  name="txtDatum" value="" /> -->
				<!-- </item> -->
				<!-- <item row="1" col="2" caption="Vrsta Dok:" > -->
				<!-- <comboedit name="txtVrstaDok" value="" dataname="dtVrstaDok" displayfield="Opis"/> -->
				<!-- </item> -->
				<!-- </group> -->
				<group row="2" col="1" rows="18" cols="1" >
					<item row="1" col="1" caption="Datum:" >
						<dateedit  name="txtDatum" value="now">
						</dateedit> 
					</item>
					<item row="2" col="1" caption="Vrsta Dok:" >
						<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" dataname="dtVrstaDok" allownull="false" />
					</item>				
					<item row="3" col="1" caption="Partner:" >
						<searchedit netgenfields="true" name="srcPartner" dataname="global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" required="true" />
					</item>
					<item row="4" col="1" caption="Primatelj:" >
						<searchedit netgenfields="true" name="srcPrimatelj" dataname="dtPrimatelj" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGetDispozicija.@PartneriidPrimatelj" datatext="#dtGetDispozicija.@PartneriPrimateljNaziv" required="true" />
					</item>
					<item row="5" col="1" caption="Špediter:"  >
						<searchedit netgenfields="true" name="srcSpediter" dataname="dtSpediter" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGetDispozicija.@PartneriidSpediter" datatext="#dtGetDispozicija.@PartneriSpediterNaziv" required="true" />
					</item>
					<!-- <item row="6" col="1" caption="Paritet:" > -->
						<!-- <textedit name="txtParitet" value="" datavalue="#dtGetDispozicija.@Paritet" required="true" /> -->
					<!-- </item> -->
					<item row="6" col="1" caption="Paritet:" >
						<searchedit netgenfields="true" name="srcParitet" dataname="dtParitet" fieldtext="Naziv" fieldvalue="ProNacinIsporukeId" datavalue="#dtGetDispozicija.@ProNacinIsporukeId" datatext="#dtGetDispozicija.@Paritet" required="true" />
					</item>					
					<item row="7" col="1" caption="Mjesto carinjenja:" >
						<textedit name="txtCarina" value="" datavalue="#dtGetDispozicija.@MjestoCarinjenja" required="true" />
					</item>
					<item row="8" col="1" caption="Granični prijelaz:" >
						<textedit name="txtPrijelaz" value="" datavalue="#dtGetDispozicija.@GranicniPrijelaz" required="true" />
					</item>
					<item row="9" col="1" caption="Vrsta transporta:" >
						<textedit name="txtTransport" value="" datavalue="#dtGetDispozicija.@VrstaTransporta" required="true" />
					</item>
					<item row="10" col="1" caption="Reg. oznaka vozila:" >
						<textedit name="txtRegistracija" value="" datavalue="#dtGetDispozicija.@RegOznakaVozila" required="true" />
					</item>
					<item row="11" col="1" caption="Broj plombi:"  >
						<textedit name="txtPlombe" value="" datavalue="#dtGetDispozicija.@BrojPlombi"/>
					</item>
					<item row="12" col="1" caption="Vozač:" >
						<textedit name="txtVozac" value="" datavalue="#dtGetDispozicija.@Vozac"/>
					</item>
					<item row="13" col="1" caption="Zemlja naplate:" >
						<comboedit name="cmbZemljaNaplate" valuefield="drzaveid" displayfield="Naziv" dataname="dtZemljaNaplate" datavalue="#dtGetDispozicija.@ZemljaNaplate"/>
					</item>
					<item row="14" col="1" caption="Zemlja namjene:" >
						<comboedit name="cmbZemljaNamjene" valuefield="drzaveid" displayfield="Naziv" dataname="dtZemljaNamjene" datavalue="#dtGetDispozicija.@zemljaNamjene"/>
					</item>
					<item row="15" col="1" caption="Vrsta carinskog postupka:" >
						<textedit name="txtPostupak" value="" datavalue="#dtGetDispozicija.@VrstaCarinskogPostupka"/>
					</item>
					<item row="16" col="1" caption="Otpremnik:" >
						<textedit name="txtOtpremnik" value="" datavalue="#dtGetDispozicija.@Otpremnik"/>
					</item>
					<item row="17" col="1" caption="Dodatne upute:" >
						<memoedit  name="txtUpute" value="" datavalue="#dtGetDispozicija.@DodatneUpute"/>
					</item>
					<item row="18" col="1" caption="Upute za popunjavanje Eura:" >
						<memoedit  name="txtUputeEuro" value="" datavalue="#dtGetDispozicija.@UputeZaEuro"/>
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="1" caption="Pronađi dispoziciju">
					<item row="1" col="1" caption="Pojam:" textposition="left">
						<searchedit name="srcSearch" value="" dataname="dtSearch">
							<event type="valuechanged" raiseonload="false">
								<action type="variable value" >
									<parameter name="DispozicijaGlaId" value="#srcSearch" type="int"/>
									<parameter name="SearchInd" value="1" type="int"/>
								</action>
								<action type="datarun reader" value="global.~dtGetDispozicija" />
								<action type="control value" value="#txtBroj">
									<parameter value="~dtGetDispozicija.@NewBroj"/>
								</action>
								<action type="control value" value="#txtBrojDok">
									<parameter value="~dtGetDispozicija.@NewBrojDok"/>
								</action>
								<action type="control value" value="#txtBrojZakljucka">
									<parameter value="~dtGetDispozicija.@BrojZakljucka"/>
								</action>	
								<action type="control value" value="#txtDatum">
									<parameter value="~dtGetDispozicija.@DatumDok"/>
								</action>	
								<action type="control value" value="#cmbVrstaDok">
									<parameter value="~dtGetDispozicija.@VrstaDokId"/>
								</action>	
								<action type="control value" value="#srcPartner">
									<parameter value="~dtGetDispozicija.@partneriid" text="~dtGetDispozicija.@PartneriNaziv"/>
								</action>	
								<action type="control value" value="#srcPrimatelj">
									<parameter value="~dtGetDispozicija.@PartneriidPrimatelj" text="~dtGetDispozicija.@PartneriPrimateljNaziv"/>
								</action>	
								<action type="control value" value="#srcSpediter">
									<parameter value="~dtGetDispozicija.@PartneriidSpediter" text="~dtGetDispozicija.@PartneriSpediterNaziv"/>
								</action>	
								<!-- <action type="control value" value="#txtParitet"> -->
									<!-- <parameter value="~dtGetDispozicija.@Paritet"/> -->
								<!-- </action>	 -->
								<action type="control value" value="#srcParitet">
									<parameter value="~dtGetDispozicija.@ProNacinIsporukeId" text="~dtGetDispozicija.@Paritet"/>
								</action>									
								<action type="control value" value="#txtCarina">
									<parameter value="~dtGetDispozicija.@MjestoCarinjenja"/>
								</action>
								<action type="control value" value="#txtPrijelaz">
									<parameter value="~dtGetDispozicija.@GranicniPrijelaz"/>
								</action>
								<action type="control value" value="#txtTransport">
									<parameter value="~dtGetDispozicija.@VrstaTransporta"/>
								</action>
								<action type="control value" value="#txtRegistracija">
									<parameter value="~dtGetDispozicija.@RegOznakaVozila"/>
								</action>
								<action type="control value" value="#txtPlombe">
									<parameter value="~dtGetDispozicija.@BrojPlombi"/>
								</action>
								<action type="control value" value="#txtVozac">
									<parameter value="~dtGetDispozicija.@Vozac"/>
								</action>
								<action type="control value" value="#cmbZemljaNaplate">
									<parameter value="~dtGetDispozicija.@ZemljaNaplate"/>
								</action>
								<action type="control value" value="#cmbZemljaNamjene">
									<parameter value="~dtGetDispozicija.@ZemljaNaplate"/>
								</action>
								<action type="control value" value="#txtPostupak">
									<parameter value="~dtGetDispozicija.@VrstaCarinskogPostupka"/>
								</action>
								<action type="control value" value="#txtOtpremnik">
									<parameter value="~dtGetDispozicija.@Otpremnik"/>
								</action>
								<action type="control value" value="#txtUpute">
									<parameter value="~dtGetDispozicija.@DodatneUpute"/>
								</action>
								<action type="control value" value="#txtUputeEuro">
									<parameter value="~dtGetDispozicija.@UputeZaEuro"/>
								</action>							
							</event>								
						</searchedit>
					</item>
				</group>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrint" caption="IS&amp;PIŠI" dataname="~dtPrint" displayfield="Opis">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDispGlavaInsert" if="$SearchInd==0">
							<parameter name="DispozicijaGlaId" />
						</action>		
						<action type="datarun scalar" value="~dtDispDetaljInsert" if="$SearchInd==0"/>				
						<action type="print" value="#btnPrint.@Template">
							<parameter name="id" value="$DispozicijaGlaId" />
						</action>
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="left">
				</button>
			</buttons>  
		</panelbuttons>
		<datalist>
			<data command="spCarpoSearch" name="dtSearch">
				<parameter name="@Table" value="DispozicijaGla" />
				<parameter name="@Pojam" value="#srcSearch.text"/>
			</data>
			<data command="spNG_Combo" name="dtZemljaNaplate">
				<parameter name="@Action" value="Drzave" />
			</data>
			<data command="spNG_Combo" name="dtZemljaNamjene">
				<parameter name="@Action" value="Drzave" />
			</data>
			<data command="select d.* , d.Opis as naziv from vrstadok d inner join vrstaprom p on d.vrstapromid= p.vrstapromid and p.sifra = '999'" type="text" name="dtVrstaDok" >
				<!-- <parameter name="@VrstaDokId" value="#grdGlava.@VrstaDokId"/> -->
			</data>		
			<data command="select count(DispozicijaGlaid) as DispozicijaGlaid from dispozicijaGla where Broj=@Broj" type="text" name="dtDispProvjeraPrint" >
				<parameter name="@Broj" value="#txtBroj"/>
			</data>	
			<data command="spCarpoPrint" name="dtPrint">
				<parameter name="@Action" value="Dispozicija" />
			</data>				
			<data command="spProd_DispozicijaGlava_Unos" name="dtDispGlavaInsert">
				<parameter name="@Broj" value="#txtBroj" />
				<parameter name="@BrojDok" value="#txtBrojDok" />
				<parameter name="@DatumDok" value="#txtDatum" />
				<parameter name="@VrstaDokId" value="#cmbVrstaDok" />
				<parameter name="@Paritet" value="#srcParitet.text" />
				<!-- <parameter name="@ProNacinIsporukeId" value="#srcParitet" /> -->
				<parameter name="@MjestoCarinjenja" value="#txtCarina" />
				<parameter name="@GranicniPrijelaz" value="#txtPrijelaz" />
				<parameter name="@VrstaTransporta" value="#txtTransport" />
				<parameter name="@RegOznakaVozila" value="#txtRegistracija" />
				<parameter name="@BrojPlombi" value="#txtPlombe" />
				<parameter name="@Vozac" value="#txtVozac" />
				<parameter name="@ZemljaNaplate" value="#cmbZemljaNaplate" />
				<parameter name="@ZemljaNamjene" value="#cmbZemljaNamjene" />
				<parameter name="@VrstaCarinskogPostupka" value="#txtPostupak" />
				<parameter name="@Otpremnik" value="#txtOtpremnik" />
				<parameter name="@DodatneUpute" value="#txtUpute" />
				<parameter name="@Partneriid" value="#srcPartner" />
				<parameter name="@PartneriidPrimatelj" value="#srcPrimatelj" />
				<parameter name="@PartneriidSpediter" value="#srcSpediter" />
				<parameter name="@BrojZakljucka" value="#txtBrojZakljucka" />
				<parameter name="@UputeZaEuro" value="#txtUputeEuro" />
			</data>		
			<data command="spProd_DispozicijaDetalj_Unos" name="dtDispDetaljInsert">
				<parameter name="@DispozicijaGlaId" value="$DispozicijaGlaId" />
				<parameter name="@table" value="parent.#grdGlava.selectedids.table"/>
			</data>		
			<data command="spTraziPartneri" name="dtPrimatelj">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPrimatelj.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>		
			<data command="spTraziPartneri" name="dtSpediter">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcSpediter.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>				
			<data command="spProd_NacinIsporukeQuery" name="dtParitet">
				<parameter name="@Uvjet" value="#srcParitet.text" />
			</data>				
		</datalist>
	</form>
</root>