<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmTrasnportniNaloziPromjenaStatusa" caption="Status" width="250" height="150">		
		<layout >
				<group cols="1" rows="1">
					<item col="1" row="1">
						<comboedit name="cmbStatusi" valuefield="statusiId" displayfield="Korak"  dataname="dtStatusQuery" />   
					</item>
				</group> 
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="datarun nonquery" value="~dtStatusEdit" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons> 
		<datalist>
            <data command="spTransportniNaloziStatusQuery" name="dtStatusQuery">
			</data>
			<data command="spTransportniNaloziStatusUpdate" name="dtStatusEdit">
				<parameter name="@Id" value="$multi"/>
				<parameter name="@statusId" value="#cmbStatusi"/>
			</data>
		</datalist>
	</form>
</root>