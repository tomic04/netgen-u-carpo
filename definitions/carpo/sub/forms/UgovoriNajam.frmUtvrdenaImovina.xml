<root>
  <form name="frmUtvrdenaImovina" caption="Utvrđena imovina">
    <event type="shown">
      <action type="control value" value="#rbDa" if="parent.$UtvrdenaImovina==true">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#rbNe" elseif="parent.$UtvrdenaImovina==false">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#memRazlog">
        <parameter value="parent.$Razlog"/>
      </action>
    </event>
    <layout>
      <group rows="2" cols="2">
        <columnsdefinition>
          <column position="1" size="50%"/>
          <column position="2" size="50%"/>
        </columnsdefinition>
        <item row="1" col="1">
          <radioedit name="rbDa" caption="Da"/>
        </item>
        <item row="1" col="2">
          <radioedit name="rbNe" caption="Ne"/>
        </item>
        <item row="2" col="1" colspan="2" caption="Razlog">
          <memoedit name="memRazlog"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="variable value" value="parent.$UtvrdenaImovina" if="#rbDa==true">
              <parameter value="true"/>
            </action>
            <action type="variable value" value="parent.$UtvrdenaImovina" elseif="#rbNe==true">
              <parameter value="false"/>
            </action>
            <action type="variable value" value="parent.$UtvrdenaImovina" else="">
              <parameter value=""/>
            </action>
            <action type="variable value" value="parent.$Razlog">
              <parameter value="#memRazlog"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
  </form>
</root>