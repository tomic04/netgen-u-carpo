<root>
	<form name="frmRasporedPoKadrovimaMulti" caption="Raspored više stavaka za istu osobu" width="400" height="100" >
		
		<!--<event type="load">
			<action type="datarun reader" value="dtRasporedPoKadrovimaUkupno" />
		</event>-->
		
		<!--<event type="shown">
			
			<action type="control value" value="txtUkupnaKolicina">
				<parameter value="~dtRasporedPoKadrovimaUkupno.@UkupnaKolicina" />
			</action>
			<action type="control value" value="txtZatvorenaKolicina">
				<parameter value="~dtRasporedPoKadrovimaUkupno.@ZatvorenaKolicina" />
			</action>
			
		</event>-->
		
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" >
				<item caption="Osoba:" row="1" col="1" textposition="left" highlight="False">
					<searchedit name="srcKadar" fontbold="True" datavalue="#dtGetKadrovi.@HrKadroviId" dataname="dtGetKadrovi" datatext="#dtGetKadrovi.@Naziv" fieldtext="Naziv" fieldvalue="HrKadroviid" netgenfields="True" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" >
					<event type="click">
						<action type="control foreachrow selected" value="parent.#grdRoba">
							<action type="datarun nonquery" value="~dtKadroviAzur"/>
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Zatvori" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		
		<datalist>
			<data command="spProd_NotpDet_HrKadrovi_UnosMulti" name="dtKadroviAzur">
				<parameter name="@ProNotpDetId" value="parent.#grdRoba.@ProNotpDetId" />
				<parameter name="@HrKadroviId" value="#srcKadar" />
			</data>

			<data command="spProd_NotpDet_HrKadrovi_Trazi" name="dtGetKadrovi">
				<parameter name="@ProNotpGlaId" value="parent.$ProNotpGlaId" />
				<parameter name="@Uvjet" value="#srcKadar.text" />
			</data>
						
		</datalist>
	</form>

</root>