<root>


  <form name="frmOsvjeziPodatke1" caption ="$caption"  width="500" height="200" fixedsize="true" saveformsize="false" showversion="true" version="1" >

    <layout>

      <!--omotač-->
      <group cols="1" rows="3" groupbordervisible="false" >
        <item col="1" row="1"  highlight="False">
          <radioedit caption="samo odabranima" name="rdoOdabrani" fontsizedelta="2" value="true"  />
        </item>
        <item col="1" row="2"  highlight="False">
          <radioedit caption="svima na obradi" name="rdoSvi"  fontsizedelta="2"/>
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOsvjezi" caption="OSVJEŽI" >
          <event type="click">
            <action type="datarun nonquery" value="~dtOsvjeziPodatke"></action>
            <action type="message" value="Osvježavanje podataka za sve djelatnike je završeno!" if="#rdoSvi==true"></action>
            <action type="message" value="Osvježavanje podataka za odabrane djelatnike je završeno!" if="#rdoOdabrani==true"></action>
            

          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceOsvjeziPodatke" name="dtOsvjeziPodatke">
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@indsvi" value="1" if="#rdoSvi==true"/>
        <parameter name="@table" value="parent.#grdPlace.selectedids.table"/>
        
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>