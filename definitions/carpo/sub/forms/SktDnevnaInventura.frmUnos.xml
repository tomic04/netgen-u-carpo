<root>
	<form name="frmUnos" caption="Unos">
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" if="$SktDnevnaInventGlaId!=null" />
			<action type="datarun reader" value="Global.~dtPopisSkladista">
				<parameter value="~dtPopisSkladista.@Skladista"/>
			</action>
		</event>
		<event type="load">
		</event>
		<event type="shown">
			<action type="control enable" value="#txtOvlastenaOsoba" if="@==0" />
		</event>
		<event type="onclose">
			<action type="control populate" value="parent.#grdMaster">
				<action type="control focus" value="parent.#grdMaster">
					<parameter value="$SktDnevnaInventGlaId" />
				</action>
			</action>
		</event>
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="4" groupbordervisible="false">
				<group row="1" col="1" rows="1" cols="1" groupbordervisible="false">
					<item caption="Skladište:" row="1" col="1" textalignmode="left">
						<combomultiedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="Global.~dtSkladiste" required="true" savevalue="app" />
					</item>
				</group>
				<group row="2" col="1" rows="3" cols="1">
					<item caption="Skladište zaliha:" row="1" col="1" textalignmode="left">
						<combomultiedit name="cmbSkladisteZaliha" valuefield="SkladisteId" displayfield="Opis" dataname="Global.~dtSkladiste" required="true" savevalue="app" />
					</item>
					<item caption="Grupa skladišta:" row="2" col="1">
						<comboedit name="cmbGrupaSkladista" valuefield="GrupaId" displayfield="Naziv" dataname="Global.~dtGrupaSkladista" savevalue="app" />
					</item>
					<item caption="Organizacijska shema skladišta:" row="3" col="1">
						<comboedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv" dataname="Global.~dtOrgShema" savevalue="app" />
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="2" groupbordervisible="false">
					<columnsdefinition>
						<column size="268" position="1" />
						<column size="70" position="2" />
					</columnsdefinition>
					<item caption="Klasa" row="1" col="1" textalignmode="left">
						<combomultiedit name="cmbKlasa" valuefield="KlMasterRobaId" displayfield="Naziv" dataname="Global.~dtKlMasterRoba" savevalue="app" />
					</item>
					<item caption=" " row="1" col="2" highlight="false">
						<checkedit caption="i ispod" name="chkKlasaIspod" savevalue="app"/>
					</item>
				</group>
				<group row="4" col="1" rows="1" cols="1" groupbordervisible="false">
					<item caption="Datum:" row="1" col="1">
						<dateedit name="datDatum" value="now" displayfield="Datum" dataname="Global.~dtGrupaSkladista"/>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">					
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="kreiranje inventure...">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtAdd">
							<parameter name="SktDnevnaInventGlaId" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spSktDnevnaInventGlaInsert" name="dtAdd">
				<parameter name="@SkladisteId" value="#cmbSkladiste" type="string"/>
				<parameter name="@Skladiste2Id" value="#cmbSkladisteZaliha" type="string" />
				<parameter name="@GrupaId" value="#cmbGrupaSkladista"/>
				<parameter name="@MsklGrupa" value="#cmbGrupaSkladista.@Naziv" type='string'/>
				<parameter name="@Datum" value="#datDatum"/>
				<parameter name="@Status" value="0"/>
				<parameter name="@OperaterKreiranjaId" value="@@operateriid"/>
				<parameter name="@OperaterZakljuckaId" value="null"/>
				<parameter name="@klase_ispod" value="1" type="int"/>
				<parameter name="@klMasterRobaId" value="#cmbKlasa" type="string"/>
				<parameter name="@orgshemaid" value="#cmbOrgShema" type="int"/>
			</data>
		</datalist>
	</form>
</root>