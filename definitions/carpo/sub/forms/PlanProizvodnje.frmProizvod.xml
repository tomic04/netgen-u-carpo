<root>
	<form name="frmProizvod" caption="Proizvod" width="830" height="450">
		<event type="load">
			<action type="control populate" value="#grdProizvod" />
		</event>
		<layout textposition="left">
			<group cols="1" rows="1">
				<item col="1" row="2" colspan="2">
					<grid name="grdProizvod" dataname="dtProizvod" showgrouppanel="true" multiselect="true" savelayout="true">
						<fields inherited="true">

						</fields>
						<styles>
							<!--<style name="fontcolor" value="red" if="#grdBilanca.@Kolicina==1"/> -->
						</styles>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Gotovo" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPrnPlaniranjeProizvodi" name="dtProizvod">
				<parameter name="@RobaId" value="$RobaId" />
			</data>
		</datalist>
	</form>
</root>