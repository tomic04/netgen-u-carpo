<root>
	<form name="frmUgovorUnos" caption="Unos ugovora" width="" height="" fixedsize="false">
		<event type="oninit">		
		</event>
		<event type="onshown">
			
		</event>
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" backgroundcolor="">
				<group cols="1" rows="10" col="1" row="1" backgroundcolor="" groupbordervisible="False">
					<part name="partPolja" path="prtGradUgovori.xml" />								
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="UNESI" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDataInsert">
							<parameter name="ProdGradUgovoriGlaId" />
						</action>
						<action type="variable value" value="Global.$DokId">
							<parameter value="$ProdGradUgovoriGlaId" />
						</action>
						<action type="form close"/>
						<action type="form open" value="frmUgovorIzmjena">
							<parameter name="ProdGradUgovoriGlaId" value="$ProdGradUgovoriGlaId"/>
						</action>
					</event>
				</button>			
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_GradUgovori_Unos" name="dtDataInsert">
				<parameter name="@id" value="null" />
				<parameter name="@Broj" value="#txtBroj" />
				<parameter name="@Aneks" value="#txtAneks" />
				<parameter name="@DatumDok" value="#datDatumDok" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@NazivProjekta" value="#txtNazivProjekta" />
				<parameter name="@RokIzrade" value="#datRokIzrade" />
				<parameter name="@Dani" value="#txtDani" />
				<parameter name="@PartnerKomisionarId" value="#srcKomisionar" />
				<parameter name="@GradProjektiVrsteId" value="#cmbVrstaProjekta" />
				<parameter name="@MjestaId" value="#cmbMjesta" />
				<parameter name="@VrijednostUsluga" value="#txtVrijUsluga" />
				<parameter name="@VrijednostRadovaIzvodjaca" value="#txtVrijRadova" />
				<parameter name="@PostotakNadzora" value="#txtPostotak" />
				<parameter name="@Napomena" value="#txtNapomena" />		
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@VrstaNaruciteljaId" value="#cmbVrstaNarucitelja" />
			</data>		
		</datalist>
	</form>
</root>