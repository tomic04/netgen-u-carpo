<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmBrisanjeObrade" caption ="$caption" width="400" height="130" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati obradu {$Oznaka} ?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="False">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"  waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..."/>
            <action type="message" value="~dtBrisanje.@Poruka"></action>
            <action type="form close" if="~dtBrisanje.@Id==0" />
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceObradeAzur" name="dtBrisanje"  timeout="600">
        <parameter name="@Action" value="brisanje" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>