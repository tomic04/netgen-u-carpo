    <layout>
      <group cols="1" rows="1" caption="Analitika">

        <item col="1" row="1" highlight="False">
          <grid name="grdAnalitika" showgrouppanel="true" showfooter="False" autopopulate="true" bestfitonrefresh="true" key="LnOOPssddetid" fieldsmartspaces="false">
            <data command="spLnOOPSSDQuery">
              <parameter name="@Action" value="doprinos_analitika" type="string"/>
              <parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
              <parameter name="@LnOOPSSDGlaId" value="$LnOOPSSDGlaId" type="int"/>
