<root>
	<!--
  Komentari:
  4.11.2025. MP - PERMISSION -> FUNCTION NAME
  08.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmRadnaKnjizica" caption="Radna knjižica za {parent.#txtPrezime} {parent.#txtIme}" width="910" height="610" >
		<event type="init">
			<action  type="datarun reader" value="~dtGetRadnaKnjizica" if="$HRKadroviId!=0"/>
		</event>
		<event type="load">
			<action type="control populate" value="#grdZvanja"/>
			<action type="control disable" value="#btnIzmjenaZvanja,btnBrisanjeZvanja" if="#grdZvanja.rowcount==0"/>
			<action type="control populate" value="#grdZaposlenja"/>		
			<action type="control disable" value="#btnIzmjenaZ,btnBrisanjeZ" if="#grdZaposlenja.rowcount==0"/>
			
		</event>
		<event type="shown">
			<action if="$Tip=='Izmjena'">
			 <action type="control disable" value="#dtDatumIzdanja" if="~dtGetRadnaKnjizica.@DatumIzdanjaRK==null"></action> 
			 <action type="control disable" value="#dtDatumObracuna" if="~dtGetRadnaKnjizica.@DatumStaza==null"></action> 
			 <action type="control disable" value="#dtPocetakRada" if="~dtGetRadnaKnjizica.@DatOdredeno==null"></action>	
			<action if="~dtGetRadnaKnjizica.@DatumIzdanjaRK==null">
					<action type="control value" value="#dtDatumIzdanja" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetRadnaKnjizica.@DatumStaza==null">
					<action type="control value" value="#dtDatumObracuna" >
						<parameter value="now" />
					</action>
				</action>
			<action if="~dtGetRadnaKnjizica.@DatOdredeno==null">
					<action type="control value" value="#dtPocetakRada" >
						<parameter value="now" />
					</action>
				</action>
			</action> 
			</event>
		<layout>
			<group cols="2" rows="3" groupbordervisible="false">
				<rowsdefinition>
					<row  position="1" size="80" /> 
					<row  position="2" size="160" />  
					<row  position="3" size="160" /> 
				</rowsdefinition>
				<group col="1" row="1" cols="2" rows="4" groupbordervisible="true" caption="Radna knjižica" rowspan="2" spacing="2,1,2,1" >
					<item row="1" col="1" caption="Broj radne knjižice:" highlight="false" >
						<textedit name="txtBrojRK" datavalue="~dtGetRadnaKnjizica.@BrojRK"/>
					</item>
					<item row="2" col="1" caption="Datum izdanja:" highlight="false" >
					<dateedit name="dtDatumIzdanja" allownull="true" value="now" datavalue="~dtGetRadnaKnjizica.@DatumIzdanjaRK">
					</dateedit>
					</item>
					<item row="2" col="2" caption="Izdao:" highlight="false" >
						<textedit name="txtIzdao" datavalue="~dtGetRadnaKnjizica.@IzdaoRK"/>
					</item>
					<item row="3" col="1"  highlight="false" padding="18">
					<checkedit name="chckPoreznaKartica" caption="Porezna kartica kod nas" datavalue="~dtGetClanaObitelji.@IndRK" />
					</item>
					<item row="3" col="2" caption="Osobni broj:" highlight="false" >
						<textedit name="txtOsobniBroj" datavalue="~dtGetRadnaKnjizica.@OsobniBroj"/>
					</item>
					<item row="4" col="1" caption="Broj osigurane osobe:" highlight="false" >
						<textedit name="txtBrojOsiguraneOsobe" datavalue="~dtGetRadnaKnjizica.@BrojOsiguranja"/>
					</item>
					<item row="4" col="2" caption="MB osigurane osobe:" highlight="false" >
						<textedit name="txtMBOsiguraneOsobe" datavalue="~dtGetRadnaKnjizica.@MBOO"/>
					</item>
				</group>
				<group col="2" row="1" cols="3" rows="1" caption="Prethodni staž"  groupbordervisible="true" spacing="1,2,2,1">
					<item row="1" col="1" caption="Ukupan:" highlight="false" >
					<textedit name="txtUkupno" required="true" datavalue="~dtGetRadnaKnjizica.@StazPrije" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="000000"/>
					</item>
					<item row="1" col="2" caption="Od toga kod nas:" highlight="false" >
					<textedit name="txtKodNas" required="true" datavalue="~dtGetRadnaKnjizica.@StazUFirmi" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="0"/>
					</item>
					<item row="1" col="3" caption="Od toga za jubilarnu:" highlight="false" >
					<textedit name="txtZaJub" required="true" datavalue="~dtGetRadnaKnjizica.@StazZaJubilarnu" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="0"/>
					</item>				
				</group>
				<group col="2" row="2" cols="3" rows="3" caption="Staž"  groupbordervisible="true" spacing="1,2,1,1">
					<item row="1" col="1" caption="Priznaje se za minuli rad:" highlight="false" >
					<textedit name="txtZaMinuliRad" required="true" datavalue="~dtGetRadnaKnjizica.@StazZaMinuliRad" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="0"/>
					</item>
					<item row="1" col="2" caption="Obračun minulog rada počinje od:" highlight="false" >
					<dateedit name="dtDatumObracuna" allownull="true" value="now" datavalue="~dtGetRadnaKnjizica.@DatumStaza">
					</dateedit>
					</item>		
					<item row="1" col="3" caption="Početak rada na određeno:" highlight="false" >
					<dateedit name="dtPocetakRada" allownull="true" value="now" datavalue="~dtGetRadnaKnjizica.@DatOdredeno">
					</dateedit>
					</item>	
					<item row="2" col="1" caption="Datum zaposlenja:" highlight="false" >
					<dateedit name="dtDatumZaposlenja" value="now" readonly="true" datavalue="~dtGetRadnaKnjizica.@DatumDolaska">
					</dateedit>
					</item>		
					<item row="2" col="2" caption="Neprekinuti staž u firmi:" highlight="false" >
					<textedit name="txtStazDanas" readonly="true" datavalue="~dtGetRadnaKnjizica.@NeprekinutiStaz" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="000000"/>
					</item>
					<item row="2" col="3" caption="Ukupan staž na današnji dan:" highlight="false" >
					<textedit name="txtStazDanas" readonly="true" datavalue="~dtGetRadnaKnjizica.@UkupanStaz" format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="000000"/>
					</item>
										
				</group>

				<tabs col="1" row="3" colspan="2">
					<group col="1" row="3" cols="4" rows="7" caption="Zvanja" groupbordervisible="true" >
						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
							<grid  name="grdZvanja" key="hrkadroviskoleid" dataname="~dtZvanja" multiselect="true" savelayout="true" fieldsmartspaces="false" showgrouppanel="false" bestfitonrefresh="true">
								<fields inherited="true">
								</fields>					
							</grid>							
						</item>
						<item row="7" col="1" highlight="false" height="40">
							<button name="btnUnos" caption="Unos" function="UNOS_ZVANJA"> 
								<event type="click">   
									<action type="form open" value="frmZvanje">  
										<parameter name="Caption" value="Unos zvanja za {parent.#txtPrezime} {parent.#txtIme}"/> 	
										<parameter name="hrkadroviskoleid" value="0" />	
										<parameter name="HRKadroviId" value="$HRKadroviId" />										
									</action>      
									<action type="control populate keepfocus" value="#grdZvanja"/>
									<action type="control populate" value="parent.#grdPodaci"/>	
								</event>  
							</button>
						</item>
						<item row="7" col="2" highlight="false" height="40" >
							<button name="btnIzmjenaZvanja" caption="Izmjena" function="IZMJENA_ZVANJA"> 
								<event type="click">   
									<action type="form open" value="frmZvanje"> 
										<parameter name="Tip" value="Izmjena"/>
										<parameter name="HRKadroviId" value="$HRKadroviId" />
										<parameter name="hrkadroviskoleid" value="#grdZvanja.@hrkadroviskoleid" />
										<parameter name="Caption" value="Izmjena zvanja za {parent.#txtPrezime} {parent.#txtIme}"/>									
									</action>  
									<action type="control populate keepfocus" value="#grdZvanja"/>	
									<action type="control populate" value="parent.#grdPodaci"/>	
								</event>  
							</button>
						</item>
						<item row="7" col="3" highlight="false" height="40">
							<button name="btnBrisanjeZvanja" caption="Brisanje" function="BRISANJE_ZVANJA"> 
								<event type="click">   
									<action type="confirm" value="Jeste li sigurni da želite obrisati izabrani zapis?">
										<action type="datarun nonquery" value="dtBrisanjeZvanje">

										</action>
									</action>
									<action type="control populate" value="#grdZvanja,parent.#grdPodaci"></action>    
									<action type="control disable" value="#btnBrisanjeZvanja,btnIzmjenaZvanja" if="#grdZvanja.rowcount==0"/>   
								</event>  
							</button>
						</item>
					</group>
					
					
					
					<group col="1" row="3" cols="4" rows="7" caption="Zaposlenja" groupbordervisible="true" >
						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
						<grid name="grdZaposlenja" key="hrkadrovizaposlenjaid" dataname="~dtZaposlenje" multiselect="true" savelayout="true" fieldsmartspaces="false" showgrouppanel="false" bestfitonrefresh="true">
							<fields inherited="true">
							</fields>
							<event type="doubleclick">
								<action type="form open" value="frmUnosIzmjenaZaposlenja" function="IZMJENA_ZAPOSLENJA">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="hrkadrovizaposlenjaid" value="#grdZaposlenja.@hrkadrovizaposlenjaid" />	
									<parameter name="Caption" value="Izmjena zaposlenja za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdZaposlenja"/>	
							    <action type="control populate" value="parent.#grdPodaci"/>									
							</event>
						</grid>
					</item>
					<item row="7" col="1" highlight="false" height="40">
						<button name="btnUnos" caption="Unos" function="UNOS_ZAPOSLENJA"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaZaposlenja"> 
									<parameter name="Caption" value="Unos zaposlenja za {parent.#txtPrezime} {parent.#txtIme}"/>		
									<parameter name="hrkadrovizaposlenjaid" value="0"/>   
									<parameter name="HRKadroviId" value="$HRKadroviId" />	

								</action>  
								<action type="control populate keepfocus" value="#grdZaposlenja"/>
							<action type="control populate" value="parent.#grdPodaci"/>								
							</event>  
						</button>
					</item>
					<item row="7" col="2" highlight="false" height="40" >
						<button name="btnIzmjenaZ" caption="Izmjena" function="IZMJENA_ZAPOSLENJA"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaZaposlenja">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="hrkadrovizaposlenjaid" value="#grdZaposlenja.@hrkadrovizaposlenjaid" />	
									<parameter name="Caption" value="Izmjena zaposlenja za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdZaposlenja"/>	
								<action type="control populate" value="parent.#grdPodaci"/>								
							</event>  
						</button>
					</item>
					<item row="7" col="3" highlight="false" height="40">
						<button name="btnBrisanjeZ" caption="Brisanje" function="BRISANJE_ZAPOSLENJA"> 
							<event type="click">   
								<action type="confirm" value="Jeste li sigurni da želite obrisati izabrani zapis?">
									<action type="datarun nonquery" value="~dtBrisanjeZaposlenja">

									</action>
								</action>
								<action type="control populate" value="#grdZaposlenja,parent.#grdPodaci"></action>    
								<action type="control disable" value="#btnIzmjenaZ,btnBrisanjeZ" if="#grdZaposlenja.rowcount==0"/>
							</event>  
						</button>
					</item>
					</group>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left" function="SPREMI_RK">
					<event type="click">
					<action type="validate"/>
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
															<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="control populate" value="parent.#grdPodaci"/>	
								<action type="form close"/>
							</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRManagerMaster_Podaci_RadnaKnjizica_CP" name="dtGetRadnaKnjizica">
				<parameter name="@action" value="getRadnaKnjizica" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_RadnaKnjizica_CP" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@hrkadroviid" value="$HRKadroviId"/>
				<parameter name="@brojrk" value="#txtBrojRK"/>
				<parameter name="@datumizdanjark" value="#dtDatumIzdanja"/>
				<parameter name="@izdaork" value="#txtIzdao"/>
				<parameter name="@osobnibroj" value="#txtOsobniBroj"/>
				<parameter name="@brojosiguranja" value="#txtBrojOsiguraneOsobe"/>
				<parameter name="@mboo" value="#txtMBOsiguraneOsobe"/>
				<parameter name="@stazprije" value="#txtUkupno"/>
				<parameter name="@stazufirmi" value="#txtKodNas"/>
				<parameter name="@stazzaminulirad" value="#txtZaMinuliRad"/>
				<parameter name="@stazzajubilarnu" value="#txtZaJub"/>
				<parameter name="@datumstaza" value="#dtDatumObracuna"/>
				<parameter name="@datodredeno" value="#dtPocetakRada"/>
				<parameter name="@indrk" value="#chckPoreznaKartica"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_RadnaKnjizica_CP" name="dtZvanja">
				<parameter name="@action" value="grid_zvanja" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_RadnaKnjizica_CP" name="dtBrisanjeZvanje">
				<parameter name="@action" value="brisanjeZvanja"/>
				<parameter name="@HRKadroviSkoleId" value="#grdZvanja.@HRKadroviSkoleId"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Zaposlenja_CP" name="dtZaposlenje">
				<parameter name="@action" value="grid_zaposlenja" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Zaposlenja_CP" name="dtBrisanjeZaposlenja">
				<parameter name="@action" value="brisanje"/>
				<parameter name="@HRKadroviZaposlenjaId" value="#grdZaposlenja.@HRKadroviZaposlenjaId"/>
			</data>
		</datalist>
	</form>
	
		<!-- FORMA ZA UNOS,IZMJENU ZVANJA-->
	<form name="frmZvanje" caption="$Caption" width="600" height="330" fixedsize="true">
			<event type="init">
<action type="datarun reader" value="~dtGetZvanje" if="$HRKadroviSkoleId!=0" />
		</event>
		<event type="shown">
	<action if="$Tip=='Izmjena'">
			 <action type="control disable" value="#dtDatum" if="~dtGetZvanje.@Datum==null"></action> 
	
			<action if="~dtGetZvanje.@Datum==null">
					<action type="control value" value="#dtDatum" >
						<parameter value="now" />
					</action>
				</action>
				</action>
		</event>
		<layout>
		<group cols="4" rows="7" groupbordervisible="true">
		<columnsdefinition>
					<column  position="1" size="25%" /> 
					<column  position="2" size="25%" />
					<column  position="3" size="25%" /> 
					<column  position="4" size="25%" />					
				</columnsdefinition>
				<item row="1" col="1" caption="Datum:" highlight="false" >
					<dateedit name="dtDatum" allownull="true" value="now" datavalue="~dtGetZvanje.@Datum">
					</dateedit>
					</item>
             <item row="2" col="1" caption="Škola:" highlight="false" colspan="2">
				<comboedit name="cmbSkola" required="true" valuefield="HRSkoleId" displayfield="Naziv" dataname="~dtSkole" datavalue="~dtGetZvanje.@HRSkoleId"/>
			</item>
			<item row="2" col="3" caption="Smjer:" highlight="false" colspan="2">
					<textedit name="txtSmjer" datavalue="~dtGetZvanje.@Smjer"/>
			</item>
			<item row="3" col="1" caption="Dokument:" highlight="false"  colspan="2">
					<textedit name="txtDokument" datavalue="~dtGetZvanje.@Dokument"/>
			</item>
			<item row="3" col="3" caption="Izdao:" highlight="false" colspan="2">
					<textedit name="txtIzdao" datavalue="~dtGetZvanje.@Izdao"/>
			</item>
			 <item row="4" col="1" caption="Zvanje:" highlight="false" colspan="2">
				<comboedit name="cmbZvanje" required="true" valuefield="HRZvanjaId" displayfield="Naziv" dataname="~dtZvanje" datavalue="~dtGetZvanje.@HRZvanjaId"/>
			</item>
			 <item row="4" col="3" caption="Sprema:" highlight="false" >
				<comboedit name="cmbSprema" required="true" valuefield="hrspremeid" displayfield="Naziv" dataname="~dtSpreme" datavalue="~dtGetZvanje.@hrspremeid"/>
			</item>
			<item row="4" col="4" caption="Staž:" highlight="false" >
				<textedit name="txtStaz" datavalue="~dtGetZvanje.@Staz" tooltip="Staž ostvaren sa ovim zvanjem." format="\d{2}(0[0-9]|1[0-1])(0[0-9]|[12][0-9]|3[00])" formattype="regex" value="000000"/>
			</item>	
			<item row="5" col="1" caption="Napomena:" highlight="false" colspan="4" rowspan="2">
				<memoedit name="memNapomena" datavalue="~dtGetZvanje.@napomena"/>
			</item>			
			<item row="7" col="1"  highlight="false" padding="18">
				<checkedit name="chckStrucniIspit" caption="Stručni ispit" datavalue="~dtGetZvanje.@StrucniIspit" />
			</item>
			<item row="7" col="2"  highlight="false" padding="18">
				<checkedit name="chckDrzavniIspit" caption="Državni ispit" datavalue="~dtGetZvanje.@DrzavniIspit" />
			</item>
			<item row="7" col="3"  highlight="false" padding="18">
				<checkedit name="chckPravosudniIspit" caption="Pravosudni ispit" datavalue="~dtGetZvanje.@PravosudniIspit" />
			</item>
			<item row="7" col="4"  highlight="false" padding="18">
				<checkedit name="chckOsnovnoZvanje" caption="Osnovno zvanje" datavalue="~dtGetZvanje.@OsnovnoZvanje" />
			</item>
		</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$HRKadroviSkoleId==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdZvanja">
									<action type="control focus" value="parent.#grdZvanja">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
							<action type="control enable" value="parent.#btnBrisanjeZvanja,parent.#btnIzmjenaZvanja"/>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!"/>
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
						<action if="$HRKadroviSkoleId!=0">
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
