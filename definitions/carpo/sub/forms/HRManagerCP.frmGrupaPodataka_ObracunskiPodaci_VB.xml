<root>
	<!--
  Komentari:
  4.11.2025. MP - PERMISSION -> FUNCTION NAME
  09.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmObracunskiPodaci_VB" caption="Obračunski podaci za {parent.#txtPrezime} {parent.#txtIme}" width="460" height="690" >
		<event type="init">
			<action  type="datarun reader" value="~dtGetObracunskePodatke" if="$HRKadroviId!=0"/>
		</event>
		<event type="shown">
			<!-- AKO JE IZMIJENA, POPUNI KONTROLE-->
			<action if="$Tip=='Izmjena'">
				<action type="control disable" value="#dtClanOMF" if="~dtGetObracunskePodatke.@Clan2StupaDatum==null"></action>

				<action if="~dtGetObracunskePodatke.@Clan2StupaDatum==null">
					<action type="control value" value="#dtClanOMF" >
						<parameter value="now" />
					</action>
				</action>
 <action type="control value" value="#srcPoreznaOpcina">
                    <parameter value="~dtGetObracunskePodatke.@PoreznaOpcinaId" text="~dtGetObracunskePodatke.@PoreznaOpcina" />
                </action>
			</action>
		</event>
		<layout>
			<group cols="2" rows="1" caption="Obračunski podaci" groupbordervisible="true">
				<group cols="6" rows="5" groupbordervisible="true" col="1" row="1" spacing="2,1,2,2">
					<columnsdefinition>
						<column  position="1" size="100" /> 
						<column  position="2" size="100" />  
						<column  position="3" size="50" /> 
						<column  position="4" size="55" />  
						<column  position="5" size="55" /> 
						<column  position="6" size="50" /> 
					</columnsdefinition>
					<rowsdefinition>
						<row  position="3" size="55" /> 
					</rowsdefinition>
					<item row="1" col="1" highlight="false" caption="Status obračuna prema RS obrascu:" colspan="2">
						<comboedit name="cmbStatusObracuna" valuefield="HRRSStatusiId" displayfield="Naziv" dataname="~dtHRRSStatusi" datavalue="~dtGetObracunskePodatke.@HRRSStatusiId"/>
					</item>
					<item row="1" col="3" caption="OO" highlight="false">
						<textedit name="txtOO" datavalue="~dtGetObracunskePodatke.@OOOznaka" readonly="true"/>
					</item>
					<item row="1" col="4" caption="I" highlight="false" >
						<textedit name="txtI" datavalue="~dtGetObracunskePodatke.@IOznaka" readonly="true"/>
					</item>
					<item row="1" col="5" caption="B" highlight="false" >
						<textedit name="txtB" datavalue="~dtGetObracunskePodatke.@BOznaka" readonly="true"/>
					</item>
					<item row="1" col="6" caption="Z" highlight="false" >
						<textedit name="txtZ" datavalue="~dtGetObracunskePodatke.@ZOznaka" readonly="true"/>
					</item>
					<item row="2" col="1" caption="Član OMF-a (II mirovinski stup od datuma):" highlight="false" colspan="2">
						<dateedit name="dtClanOMF" value="now" allownull="true" datavalue="~dtGetObracunskePodatke.@Clan2StupaDatum">
						</dateedit>
					</item>
					<item row="2" col="3" highlight="false" padding="18" colspan="4">
						<checkedit name="chckClanOMFa" caption="Član OMF-a (II mirovinski stup)" datavalue="~dtGetObracunskePodatke.@Clan2Stupa" />
					</item>

					<item row="3" col="1" highlight="false" caption="Porezna općina:" colspan="5">
						<searchedit name="srcPoreznaOpcina" dataname="~dtPoreznaOpcina" fieldvalue="id" fieldtext="Naziv">
						</searchedit>
					</item>
					<item row="3" col="6" highlight="false"  padding="10">
						<button name="btnUnos" image="add" imagelocation="middlecenter"> 
							<event type="click">   
								<action type="form open" value="frmUnosPorezne"> 
									<parameter name="Caption" value="Stavke za obračun za {parent.#grdMaster.@Prezime} {parent.#grdMaster.@Ime}"/>		  
									<parameter name="HRKadroviId" value="$HRKadroviId" />	
								</action> 								
							</event>  
						</button>
					</item>
					<item row="4" col="1" caption="Porezna olakšica:" highlight="false" >
						<textedit name="txtPoreznaOlaksica" datavalue="~dtGetObracunskePodatke.@Olaksica" format="n2" value="0"/>
					</item>
					<item row="4" col="2" caption="Postotak invalidnosti:" highlight="false" colspan="2">
						<textedit name="txtPostotakInv" datavalue="~dtGetObracunskePodatke.@PostotakInvalidnosti" format="n2" value="0"/>
					</item>
					<item row="5" col="1" caption="Osnovica:" highlight="false" >
						<textedit name="txtOsnovica" datavalue="~dtGetObracunskePodatke.@Osnovica" format="n4" value="0"/>
					</item>
					<item row="5" col="2" caption="Vrsta osnovice:" highlight="false" colspan="2">
						<textedit name="txtVrstaOsnovice" datavalue="~dtGetObracunskePodatke.@VrstaOsnovice"/>
					</item>


				</group>
				<group cols="2" rows="5" groupbordervisible="true" col="2" row="1" spacing="1,2,2,2">
					<rowsdefinition>
						<row  position="1" size="55" /> 
					</rowsdefinition>
					<item row="1" col="1" highlight="false" caption="Vrsta redovnog računa:" >
						<comboedit name="cmbVrstaRRacuna" valuefield="OOPVrsteRacunaId" displayfield="Naziv" dataname="~dtVrsteRRacuna" datavalue="~dtGetObracunskePodatke.@OOPVrsteRacunaId">
							<event type="valuechanged">
								<!-- Ako je Gotovina u vrsti računa (uzima id 3 tablice jer je na njemu se nalazi gotovina) onda disable račune, a ako nije onda enabl-a -->
								<action if="#cmbVrstaRRacuna==3">								
									<action type="control disable" value="#txtBrojRRacuna,#cmbBankaRRacuna" ></action>
									<action type="control value" value="#txtBrojRRacuna" >
									</action>	
									<action type="control value" value="#cmbBankaRRacuna" >
									</action>										
								</action>
								<action else="">
									<action type="control enable" value="#cmbBankaRRacuna,#txtBrojRRacuna" ></action>
									<action type="control value" value="#txtBrojRRacuna" >
										<parameter value="~dtGetObracunskePodatke.@ZiroRacun" />
									</action>
									<action type="control value" value="#cmbBankaRRacuna" >
										<parameter value="~dtGetObracunskePodatke.@BankaId" />
									</action>
								</action>
							</event>
						</comboedit>
					</item>
					<item row="1" col="2" highlight="false" padding="10">
						<button name="btnUnos" caption="Stavke za obračun" > 
							<event type="click">   
								<action type="form open" value="frmStavkeZaObracun"> 
									<parameter name="Caption" value="Stavke za obračun za {parent.#grdMaster.@Prezime} {parent.#grdMaster.@Ime}"/>		  
									<parameter name="HRKadroviId" value="$HRKadroviId" />	
								</action> 								
							</event>  
						</button>
					</item>

					<item row="2" col="1" caption="Broj redovnog računa:" highlight="false" colspan="2">
						<textedit name="txtBrojRRacuna" datavalue="~dtGetObracunskePodatke.@ZiroRacun"/>
					</item>
					<item row="3" col="1" highlight="false" caption="Banka redovnog računa:" colspan="2">
						<comboedit name="cmbBankaRRacuna" valuefield="bankaid" displayfield="Naziv" dataname="~dtBanka" datavalue="~dtGetObracunskePodatke.@BankaId"/>
					</item>
					<item row="4" col="1" highlight="false" caption="Relacija:" colspan="2">
						<comboedit name="cmbRelacija" valuefield="OOPRelacijeId" displayfield="Naziv" dataname="~dtRelacije" datavalue="~dtGetObracunskePodatke.@OOPRelacijeId"/>
					</item>
					<item row="5" col="1" caption="Parametri:" highlight="false"  colspan="2">
						<memoedit name="memParametri"  datavalue="~dtGetObracunskePodatke.@Parametri">
						</memoedit>
					</item>


				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left" function="SPREMI_OBRACUNSKE">
					<event type="click">
						<action type="validate"/>
						<action if="$hrkadroviid!=0">
							<action type="datarun reader" value="~dtIzmjenaObracunskihPod"/>
							<action if="$indGreske==0">
								<action type="control populate" value="parent.#grdPodaci"/>	
								<action type="message" value="Uspješno spremljeno!"/>

								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRHelp" name="dtPoreznaOpcina">
				<parameter name="@action" value="porezna_opcina"/>
				<parameter name="@tekst" value="#srcPoreznaOpcina.text"/>
			</data>
			<data command="spHRHelp" name="dtRelacije">
				<parameter name="@action" value="relacije"/>
			</data>
			<data command="spHRHelp" name="dtVrsteZRacuna">
				<parameter name="@action" value="vrste_racunaZ"/>
			</data>
			<data command="spHRHelp" name="dtBanka">
				<parameter name="@action" value="banka"/>
			</data>
			<data command="spHRHelp" name="dtVrsteRRacuna">
				<parameter name="@action" value="vrste_racuna"/>
			</data>
			<data command="spHRHelp" name="dtHRRSStatusi">
				<parameter name="@action" value="HRRSStatusi"/>
			</data>
			<data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="dtGetObracunskePodatke">
				<parameter name="@action" value="getObracunskePodatke" />
				<parameter name="@HRKadroviId" value="$HRKadroviId" type="int"/>
			</data>
			<data  command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="dtIzmjenaObracunskihPod">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@hrkadroviid"  value="$HRKadroviId" />
				<parameter name="@HRRSStatusiId"  value="#cmbStatusObracuna" />
				<parameter name="@Clan2StupaDatum"  value="#dtClanOMF" />
				<parameter name="@Clan2Stupa"  value="#chckClanOMFa" />
				<parameter name="@PoreznaOpcinaId"  value="#srcPoreznaOpcina" />
				<parameter name="@Osnovica"  value="#txtOsnovica" />
				<parameter name="@VrstaOsnovice"  value="#txtVrstaOsnovice" />
				<parameter name="@Olaksica"  value="#txtPoreznaOlaksica" />
				<parameter name="@PostotakInvalidnosti"  value="#txtPostotakInv" />
				<parameter name="@OOPVrsteRacunaId"  value="#cmbVrstaRRacuna" />
				<parameter name="@ZiroRacun"  value="#txtBrojRRacuna" />
				<parameter name="@BankaId"  value="#cmbBankaRRacuna" />
				<parameter name="@OOPVrsteRacuna2id"  value="#cmbVrstaZRacuna" />
				<parameter name="@Ziro2Racun"  value="#txtBrojZRacuna" />
				<parameter name="@Banka2Id"  value="#cmbBankaZRacuna" />
				<parameter name="@Parametri"  value="#memParametri" />
				<parameter name="@OOPRelacijeId"  value="#cmbRelacija" />
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>

	<form name="frmStavkeZaObracun" caption="Stavke za obračun" width="480" height="390">
		<event type="init">
			<action  type="datarun reader" value="~getDjelatnik" if="$HRKadroviId!=0"/>
		</event>
		<event type="load">
			<action type="control populate" value="#grdStavke"/>
		</event>
		<layout>
			<group cols="2" rows="7" groupbordervisible="true">
				<item row="1" col="1" caption="Djelatnik:" highlight="false" colspan="2">
					<textedit name="txtDjelatnik" datavalue="~getDjelatnik.@Djelatnik" readonly="true"/>
				</item>
				<item row="2" col="1" caption="Vrsta isprave:" highlight="false" colspan="2" rowspan="6">
					<grid name="grdStavke" key="HRKadroviId" dataname="~getStavke" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false">
						<fields inherited="true">
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
			<button name="btnUnos" caption="Unos">
					<event type="click">
						<action type="form open" value="frmUnosStavke">
							<parameter name="OperateriId" value="@@OperateriId"/>
							<parameter name="HRKadroviId" value="$hrkadroviid"/>
						</action>
					</event>
				</button>
				<button name="btnBrisanje" caption="Brisanje"> 
						<event type="click">   
							<action type="confirm" value="Jeste li sigurni da želite obrisati odabranu stavku {#grdStavke.@Stavka}?">
								<action type="datarun nonquery" value="~dtBrisanje">

								</action>
							</action>
							<action type="control populate keepfocus" value="#grdStavke"/>
						</event>  
					</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="getStavke">
				<parameter name="@action" value="getStavke" />
				<parameter name="@HRKadroviId" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="getDjelatnik">
				<parameter name="@action" value="getDjelatnik" />
				<parameter name="@HRKadroviId" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="dtBrisanje">
				<parameter name="@action" value="brisanje_stavke"/>
				<parameter name="@OOPUnosId" value="#grdStavke.@OOPUnosId"/>
			</data>
		</datalist>
	</form>
	
		<!--
  *******************************************************************************************
  FORMA ZA UNOS POREZNE
  *******************************************************************************************
  -->

	<form name="frmUnosPorezne" caption="Unos porezne općine" fixedsize="true"  saveformlayout="false" width="200" height="100">



		 <layout>
			 <group cols="2" rows="4">
				 <item row="1" col="1" caption="Općina / mjesto: " highlight="false" colspan="2">
					 <searchedit name="srcOpcina" dataname="~dtMjesta" fieldtext="Naziv" fieldvalue="mjestaid" required="true" >
					 </searchedit>
				 </item>
				 <item row="2" col="1" caption="Oznaka porezne uprave: " highlight="false" >
					 <textedit name="txtOznaka" required="true"></textedit>
				 </item>
				 <item row="3" col="1" caption="Oznaka općine: " highlight="false">
					 <textedit name="txtOznakaOpcine" required="true"></textedit>
				 </item>
				 <item row="4" col="1" caption="Prirez %: " highlight="false" >
					 <textedit name="txtPrirez" format="n2" value="0" required="true"></textedit>
				 </item>
			 </group>
		 </layout>

		 <panelbuttons>
			 <buttons>
		
				 <button name="btnSpremi" caption="SPREMI">
				
					 <event type="click">
						 <action type="validate"/>
				
						 <action type="datarun reader" value="~dtUnos">
				
							 <action if="$indGreske==0">
								 <action type="control populate" value="parent.#srcPoreznaOpcina">
								 </action>

								 <action type="control value" value="parent.#srcPoreznaOpcina">
									 <parameter value="$noviId" />
								 </action>

								 <action type="form close"></action>
							 </action>
				
						 </action>
					 </event>
				
				 </button>

				 <button name="btnOdustani" caption="ODUSTANI" dock="right">
					 <event type="click">
						 <action type="form close"/>
					 </event>
				 </button>
		
			 </buttons>
		 </panelbuttons>

		 <datalist>
		 <data command="spHRHelp" name="dtMjesta">
				<parameter name="@action" value="mjestasrc"/>
				<parameter name="@tekst" value="#srcOpcina.text"/>
			</data>
			 <data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="dtUnos">
				<parameter name="@action" value="unosporezne"/>
				<parameter name="@OOPMjestaPorezId.output.int" variablename="noviID"/>
				<parameter name="@MjestaId" value="#srcOpcina"/>
				<parameter name="@PoreznaUprava" value="#txtOznaka"/>
				<parameter name="@PoreznaOpcina" value="#txtOznakaOpcine"/>
				<parameter name="@Postotak" value="#txtPrirez"/>
				<parameter name="@indGreske.output.int"/>				
			</data>
		 </datalist>
	</form>
	
			<!--
  *******************************************************************************************
  FORMA ZA UNOS DOHODOVNIH STAVKI
  *******************************************************************************************
  -->

	<form name="frmUnosStavke" caption="Unos dohodovnih stavki" fixedsize="true"  saveformlayout="false" width="200" height="100">



		 <layout>
			 <group cols="2" rows="4">
				 <item row="1" col="1" caption="Dohodovne stavke:" highlight="false" colspan="2">
					 <comboedit name="cmbStavke"  valuefield="OOPStavekeId" displayfield="naziv"  dataname="~dtStavke" required="true"/>
				 </item>
				 <item row="2" col="1" caption="Sati:" highlight="false" >
					 <textedit name="txtSati" format="n2" value="0" required="true"></textedit>
				 </item>
				 <item row="3" col="1" caption="Iznos:" highlight="false">
					 <textedit name="txtIznos" format="n2" value="0" required="true"></textedit>
				 </item>
			 </group>
		 </layout>

		 <panelbuttons>
			 <buttons>
		
				 <button name="btnSpremi" caption="SPREMI">
				
					 <event type="click">
						 <action type="validate"/>
				
						 <action type="datarun reader" value="~dtUnos">
				
							 <action if="$indGreske==0">
								 <action type="control populate" value="parent.#grdStavke">
								 </action>

								 <action type="form close"></action>
							 </action>
				
						 </action>
					 </event>
				
				 </button>

				 <button name="btnOdustani" caption="ODUSTANI" dock="right">
					 <event type="click">
						 <action type="form close"/>
					 </event>
				 </button>
		
			 </buttons>
		 </panelbuttons>

		 <datalist>
		 <data command="spHRHelp" name="dtStavke">
				<parameter name="@action" value="stavke"/>
			</data>
			 <data command="spHRManagerMaster_Podaci_ObracunskiPodaci_CP_VB" name="dtUnos">
				<parameter name="@action" value="unos_stavke"/>
				<parameter name="@OOPUnosId.output.int" variablename="noviID"/>
				<parameter name="@hrkadroviid" value="$HRKadroviId"/>
				<parameter name="@OOPStavkeId" value="#cmbStavke"/>
				<parameter name="@Sati" value="#txtSati"/>
				<parameter name="@Iznos" value="#txtIznos"/>
				<parameter name="@indGreske.output.int"/>				
			</data>
			
		 </datalist>
	</form>
</root>