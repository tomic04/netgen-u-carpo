<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmEvidencijaVozilaUnos" caption="Unos" width="400" height="300">
		<layout>
			<group cols="1" rows="3">
				<item caption="Prijevoznik:" row="1" col="1" fontbold="true">
					<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" required="true" fontbold="true">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtOdgovornaOsoba"/>
							<action type="control populate" value="#cmbOsobe" />
						</event>
					</searchedit>
				</item>
				<item caption="Registracija:" row="2" col="1">
					<textedit name="txtRegistracija" required="true">
					</textedit>
				</item>
				<item caption="Vozač:" row="3" col="1">
					<comboedit name="cmbOsobe" enabled="true" valuefield="OsobeId" displayfield="Naziv" datavalue="#dtGet.@OsobeId" dataname="dtOdgovornaOsoba" required="true">
					</comboedit>
				</item>
			</group>
		</layout>
		
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtEvidencijaVozilaInsert">
						</action>
						<action type="form close"/>
						<action type="form open" value="frmPonudaEdit">
							<parameter name="ProPonKomGlaId" value="$ProPonKomGlaId"/>
						</action>
						
					</event>
				</button>
                <button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTrazipartneri" name="dtPartneri">
				<parameter name="@Action" value="1" />
				<parameter name="@Uvijet" value="Naziv" />
			</data>
		<data command="spOsobeQuery" name="dtOdgovornaOsoba">
            <parameter name="@Action" value="2" />
			<parameter name="@Id" value="#srcPartner" />
        </data>
		<data command="spEvidencijaVozilaInsert" name="dtEvidencijaVozilaInsert">
            <parameter name="@partneriid" value="#srcPartner" />
			<parameter name="@registracija" value="#txtRegistracija" />
			<parameter name="@Vozacid" value="#cmbOsobe" />
        </data>
		</datalist>
	</form>
</root>