<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmStatusPredlosciILinije" type="master" caption="Predlošci i linije odobravanja :: {$Tekst}" statusbar="false">
    <event type="init">
      <action type="datarun reader" value="Global.dtGetPredlosci" if="$Ind_Unos==0"/>
      <action type="datarun reader" value="Global.dtGetLinije" if="$Ind_Unos==3"/>
    </event>
    
    <event type="load">
      <action type="datarun reader" value="Global.dtGetPredlosci" if="$Ind_Unos==0||$Ind_Unos==2"/>
      <action type="datarun reader" value="Global.dtGetLinije" if="$Ind_Unos==3"/>
    </event>
    
    <event type="shown">
      <action type="control value" value="#txtPredlozak" if="$Ind_Unos==0||$Ind_Unos==2">
        <parameter value="~dtGetPredlosci.@Predlozak"/>
      </action>
      <action type="control value" value="#txtLinija" if="$Ind_Unos==0">
        <parameter value="~dtGetPredlosci.@Linija" />
      </action>
      <action type="control value" value="#txtRedOdobravanjaLinija" if="$Ind_Unos==0">
        <parameter value="~dtGetPredlosci.@RedOdobravanjaLinija" />
      </action>
      
      <action type="control value" value="#cmbPredlozak" if="$Ind_Unos==2">
        <parameter value="~dtGetPredlosci.@KUPOdobriPredlozakId" />
      </action>

      


      <action type="control value" value="#txtPredlozak" if="$Ind_Unos==3">
        <parameter value="~dtGetLinije.@Predlozak"/>
      </action>
      <action type="control value" value="#txtLinija" if="$Ind_Unos==3">
        <parameter value="~dtGetLinije.@Linija" />
      </action>
      <action type="control value" value="#txtRedOdobravanjaLinija" if="$Ind_Unos==3">
        <parameter value="~dtGetLinije.@RedOdobravanjaLinija" />
      </action>
      
      
      <!--unesi predložak-->
      <action type="control disable" value="#cmbPredlozak,#txtLinija,#txtRedOdobravanjaLinija,#btnSpremi" if="$Ind_Unos==1"/>
      <action type="control enable" value="#txtPredlozak,#btnSpremiPredlozak"  else="" />

      <!--izmijeni  predložak-->
      <action type="control disable" value="#cmbPredlozak,#txtLinija,#txtRedOdobravanjaLinija,#btnSpremi" if="$Ind_Unos==0"/>     
      <action type="control enable" value="#txtPredlozak,#btnSpremiPredlozak"  if="$Ind_Unos==0" />

      <!--unesi  liniju-->
      <action type="control disable" value="#txtPredlozak,#btnSpremiPredlozak,#cmbPredlozak" if="$Ind_Unos==2"/>     
      <action type="control enable" value="#txtLinija,#txtRedOdobravanjaLinija,#btnSpremi" if="$Ind_Unos==2" />

      <!--izmijeni  liniju-->
      <action type="control disable" value="#txtPredlozak,#btnSpremiPredlozak,#cmbPredlozak" if="$Ind_Unos==3"/>
      <action type="control enable" value="#txtLinija,#txtRedOdobravanjaLinija,#btnSpremi" if="$Ind_Unos==3" />
      
    </event>

    <layout textposition="left" itemspadding="3">
      <group cols="3" rows="6" col="1" row="1">
        
        <group cols="2" rows="1" col="1" row="1" colspan="3" groupbordervisible="true">
           <columnsdefinition>
               <column size="80%" position="1" />
               <column size="20%" position="2" />
            </columnsdefinition>
          <item caption="Predložak:" row="1" col="1" >
            <textedit name="txtPredlozak"  value="" datavalue="~dtGet.@Predlozak" readonly="false"/>
          </item>
          <item caption="" row="1" col="2" >
            <button name="btnSpremiPredlozak" caption="SPREMI">
              <event type="click">              
                  <action type="datarun scalar" value="~dtSpremiPredlozak">
                    <parameter name="parent.$NoviKUPOdobriPredlozakId"/>
                  </action>
                  <action type="form close"/>
                  <action type="control populate" value="parent.#grdPredlosciLinije"/>
                  <action type="control focus" value="parent.#grdPredlosciLinije">
                    <parameter value="parent.$NoviKUPOdobriPredlozakId" />
                  </action>
              </event>
            </button>
          </item>
        </group>
        
        <item caption="Predložak:" row="3" col="1" colspan="3">
          <!--<comboedit name="cmbPredlozak" valuefield="KUPOdobriPredlozakId" displayfield="Predlozak" datavalue="#dtGetPredlosciLinije.@KUPOdobriPredlozakId" dataname="dtPredlozak" />-->
          <comboedit name="cmbPredlozak" valuefield="KUPOdobriPredlozakId" displayfield="Predlozak" datavalue="~dtGetPredlosci.@KUPOdobriPredlozakId" dataname="dtPredlozak" />
        </item>
        
        <item caption="Linija:" row="4" col="1"  colspan="3">
          <textedit name="txtLinija"  value="" type="int" datavalue="~dtGet.@Linija" readonly="false"/>
        </item>
        <item caption="Red odobravanja:" row="5" col="1"  colspan="1">
          <textedit name="txtRedOdobravanjaLinija"  value="" type="int" datavalue="~dtGet.@RedOdobravanjaLinija" readonly="false"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">            
              <!--<action if="$Ind_Unos==0">              
                <action type="datarun nonquery" value="dtLinije"/>                           
              </action>-->              
              <action if="$Ind_Unos==2">
               <action type="datarun scalar" value="dtLinije">
                <parameter name="parent.$NoviKUPOdobriLinijaId"/>
              </action>    
              <action type="control value" value="#txtLinija">
                <parameter value=" "/>
              </action>
              <action type="control value" value="#txtRedOdobravanjaLinija">
                <parameter value=" "/>
              </action>
              <action type="control focus" value="#txtLinija"/>
              </action>
             <action elseif="$Ind_Unos==3">
              <action type="datarun scalar" value="dtLinije"/>
               <action type="form close"/>
               <action type="control populate" value="parent.#grdPredlosciLinije"/>
               <action type="control focus" value="parent.#grdPredlosciLinije">
                 <parameter value="parent.$KUPOdobriLinijaId" />
               </action>
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani">
         <event type="click">
           <action if="$Ind_Unos==1">
              <action type="form close"/>              
              <action type="control populate" value="parent.#grdPredlosciLinije"/>             
              <action type="control focus" value="parent.#grdPredlosciLinije">
                <parameter value="parent.$NoviKUPOdobriPredlozakId" />
              </action>
              </action> 
           <action elseif="$Ind_Unos==0">
               <action type="form close"/>              
              <action type="control populate" value="parent.#grdPredlosciLinije"/>
              <action type="control focus" value="parent.#grdPredlosciLinije">
                <parameter value="$KUPOdobriPredlozakId" />
              </action>            
            </action>
            <action elseif="$Ind_Unos==2||$Ind_Unos==3">
              <action type="form close"/> 
              <action type="control populate" value="parent.#grdPredlosciLinije"/>
              <action type="control focus" value="parent.#grdPredlosciLinije">
                <parameter value="parent.$NoviKUPOdobriLinijaId" />
              </action> 
           </action>
          </event>            
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spCKUPPredlosciILinije" name="dtPredlozak">
        <parameter name="@action" value="cmbpredlosci"/>
      </data>

      <data command="spCKUPPredlosciILinije" name="dtLinije">
        <parameter name="@action" value="insertlinija" if ="$Ind_Unos==2"/>
        <parameter name="@action" value="updatelinija" else =""/>
        <parameter name="@Id" value="$KUPOdobriPredlozakId"/>
        <parameter name="@KUPOdobriLinijaId" value="$KUPOdobriLinijaId"/>
        <parameter name="@Naziv" value="#txtLinija"/>
        <parameter name="@Red" value="#txtRedOdobravanjaLinija"/>
      </data>

      <data command="spCKUPPredlosciILinije" name="dtSpremiPredlozak">
        <parameter name="@action" value="insertpredlozak" if ="$Ind_Unos==1"/>
        <parameter name="@action" value="updatepredlozak" else =""/>
        <parameter name="@Naziv" value="#txtPredlozak"/>
        <parameter name="@Id" value="$KUPOdobriPredlozakId"/>
      </data>


    </datalist>
  </form>
</root>
