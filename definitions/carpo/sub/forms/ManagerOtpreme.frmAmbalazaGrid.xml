<root>
    <form name="frmAmbalazaGrid" caption="Ambalaža" fixedsize="false" width="800" height="570">
		<event type="onload">
			<action type="datarun nonquery" value="~dtDetAmbalaza" />
			<action type="control populate" value="#grdAmbalaza" />
			<action type="control disable" value="#btnEditAmb, #btnDeleteAmb" if="#grdAmbalaza.rowcount==0"/>
			<action type="control enable" value="#btnEditAmb, #btnDeleteAmb" else="" />				
		</event>
		<layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols ="1" rows="1" groupbordervisible="False">
                    <item row="1" col="1" colspan="2">
                        <grid name="grdAmbalaza" async="true" dataname="dtDetAmbalaza" key="ProNOtpDetAmbId" showgrouppanel="False" multiselect="true">
                            <fields>					
                                <field name="Sifra" caption="Šifra" />
                                <field name="Naziv" caption="Ambalaža" />
								<field name="JM" caption="JM" />								
                                <field name="Kolicina" caption="Količina" formatstring="n0"/>
								<field name="Tezina" caption="Bruto težina" formatstring="n3"/>
                            </fields>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="UNESI" type="add" dock="left">
                    <event type="click">
						<action type="form open" value="frmStavkaAmb">
							<parameter name="ProNotpDetId" value="$ProNotpDetId"/>
							<parameter name="ProNotpGlaId" value="$ProNotpGlaId" />
							<parameter name="Action_Notp" value="$Action_Notp"/>										
							<parameter name="Action_Amb" value="0"/>
						</action>
						<action type="control populate" value="#grdAmbalaza" />
						<action type="control disable" value="#btnEditAmb, #btnDeleteAmb" if="#grdAmbalaza.rowcount==0"/>
						<action type="control enable" value="#btnEditAmb, #btnDeleteAmb" else="" />							
                    </event>
                </button>
                <button name="btnEditAmb" caption="IZMIJENI" type="edit" dock="left">
                    <event type="click">
 						<action type="form open" value="frmStavkaAmb">
							<parameter name="ProNOtpDetAmbId" value="#grdAmbalaza.@ProNOtpDetAmbId"/>
							<parameter name="ProNotpDetId" value="$ProNotpDetId"/>
							<parameter name="ProNotpGlaId" value="$ProNotpGlaId" />
							<parameter name="Action_Notp" value="$Action_Notp"/>										
							<parameter name="Action_Amb" value="1"/>
						</action>
						<action type="control populate" value="#grdAmbalaza" />						
                    </event>
                </button>
                <button name="btnDeleteAmb" caption="OBRIŠI" type="delete" dock="left">
                    <event type="click">
						<action type="control foreachrow selected" value="#grdAmbalaza">
							<action type="datarun nonquery" value="~dtAmb_Brisanje" />							
						</action>
						<action type="control populate" value="#grdAmbalaza" />
						<action type="control disable" value="#btnEditAmb, #btnDeleteAmb" if="#grdAmbalaza.rowcount==0"/>
						<action type="control enable" value="#btnEditAmb, #btnDeleteAmb" else="" />													
                    </event>
                </button>				
                <button caption="IZLAZ" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_NotpDet_Ambalaza" name="dtDetAmbalaza">
				<parameter name="@Action" value="1" />
				<parameter name="@ProNotpDetId" value="$ProNotpDetId" />	
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@OperateriId" value="@@OperateriId" />				
            </data>
            <data command="spProd_NotpDet_Ambalaza" name="dtAmb_Brisanje">
				<parameter name="@Action" value="4" />
				<parameter name="@ProNotpDetAmbId" value="#grdAmbalaza.@ProNotpDetAmbId" />		
				<parameter name="@ProNotpDetId" value="$ProNotpDetId" />	
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@OperateriId" value="@@OperateriId" />					
            </data>			
        </datalist>
    </form>
</root>