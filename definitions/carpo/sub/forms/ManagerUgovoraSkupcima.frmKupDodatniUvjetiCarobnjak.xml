<root>
    <form name="frmKupDodatniUvjetiCarobnjak" caption="Dodatni uvjeti" fixedsize="true">
        <layout  itemspadding="5" textposition="left">
            <group cols="1" rows="3" >
               <rowsdefinition>
					<row position="1" size="33%"></row>
					<row position="2" size="33%"></row>
					<row position="3" size="33%"></row>
				</rowsdefinition>
                <item row="1" col="1" caption="Bonus:">
                    <textedit name="txtBonus" caption="Bonus" type="int" format="n0" />
                </item>
                <item row="2" col="1" caption="Cassa:"> 
                    <textedit name="txtCassa" caption="Cassa" type="int" format="n2" /> 
                </item>
                <item row="3" col="1" caption="Kamata:"> 
                    <textedit name="txtKamata" caption="Kamata" type="int" format="n2" /> 
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnPrihvati" caption="Prihvati">
                    <event type="click">
                        <action type="datarun nonquery" value="~dtDodatniUvjeti" />
                        <action type="form close" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_KupUgoIzmjena_DodatniUvjetiUnos_Temp" name="dtDodatniUvjeti">
                <parameter name="@Bonus" value="#txtBonus" />
                <parameter name="@Cassa" value="#txtCassa" />
                <parameter name="@Kamata" value="#txtKamata" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
        </datalist>
    </form>
</root>