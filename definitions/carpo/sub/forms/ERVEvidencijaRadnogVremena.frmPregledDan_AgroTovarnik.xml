<root>
	<!--
  Komentari:
  
  v3: 24.9.2021. MP - za cmb_smjene šaljem orgshemaid, mjesec, godina, operatera, selectedids, te se cmb_smjene puni na promjenu orgsheme 
  v2: 10.9.2021. MP - dodao disejblanje čvorova orgsheme na koja operater nema pravi i provjeru istih na spremanju (obzirom se strelicom može odabrati zabranjena orgshema)
  9.9.2021. Marin - namjestio captione uz checkedit kontrole
  v1:01.09.2021. Mihajlo - kreirao formu ver 1.0.
  -->
	<form name="frmPregledDan" caption="$Caption" width="1450" height="770" saveformsize="false" showversion="true" version="1">
		<event type="init">
			<action type="datarun reader" value="~dtDajDatum"/>
		</event>
		<event type="load">
			<action type="control value" value="#datDatum">
				<parameter value="~dtDajDatum.@datum"/>
			</action>
			<action type="control populate" value="#grdDetalj"/>
		</event>
		<event type="shown">
			<action type="datarun reader" value="~dtVrijeme"/>
			<action type="control value" value="#txtVrijemeOd">
				<parameter value="~dtVrijeme.@VrijemeOd"/>
			</action>
			<action type="control value" value="#txtVrijemeDo">
				<parameter value="~dtVrijeme.@VrijemeDo"/>
			</action>
			<!-- varijabla koja bilježi jel se kliknulo na brisanje/unos kako bi znali trebali li nakon zatvaranja forme odraditi refresh -->
			<action type="variable value" value="brojAkcija">
				<parameter value="0"/>
			</action>


			<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
			<action type="variable value" value="global.$RefreshajMaster">
				<parameter value="0" type="int"/>
			</action>
		</event>


		<!-- <event type="close">
				<action type="message" value="zatvaram....">	</action>
			<action if="parent.$brojAkcija!=0">
				<action type="message" value="refresh master grida....">	</action>
				<action type="control populate" value="parent.#grdERV">	</action>
			</action>
		</event>
		 -->
		<layout>
			<group cols="2" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="60%"/>
					<column position="2" size="40%"/>
				</columnsdefinition>
				<!--1. red-->
				<group cols="4" rows="7" col="1" row="1" rowspan="2" spacing="2,1,2,2">
					<columnsdefinition>
						<column position="1" size="20%"/>
						<column position="2" size="10%"/>
						<column position="3" size="40%"/>
						<column position="4" size="30%"/>
					</columnsdefinition>
					<rowsdefinition>
						<row size="35" position="1"/>
					</rowsdefinition>
					<item col="1" row="1" colspan="2" highlight="false" caption="Pregled za datum:" textposition="left">
						<dateedit name="datDatum">
							<event type="valuechanged">
								<action type="control populate" value="#grdDetalj"/>
							</event>
						</dateedit>
					</item>
					<item col="4" row="1" colspan="1" highlight="false" caption=" ">
					</item>
					<item caption="" col="1" row="2" rowspan="6" colspan="4" highlight="false">
						<grid name="grdDetalj" key="DneEv_MPId" caption="Pregled zapisa za odabrani datum" dataname="~dtDet" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false" multiselect="true" savelayout="true">
							<fields inherited="true">
								<field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
							</fields>
							<event type="doubleclick">
								<action type="form open" value="frmUnos" if="#grdDetalj.@dneev_mpid!=null">
									<parameter name="Caption" value="Izmjena odabranog zapisa "/>
									<parameter name="OperateriId" value="@@OperateriId"/>
									<parameter name="selectedids" value="#grdDetalj.@hrkadroviid"/>
									<parameter name="dneev_mpid" value="#grdDetalj.@dneev_mpid"/>
									<parameter name="godina" value="$godina"/>
									<parameter name="mjesec" value="$mjesec"/>
								</action>
								<action type="control populate" value="#grdDetalj" if="dialogresult!=cancel">
								</action>
							</event>
							<event type="focusedrowchanged">
								<action type="control value" value="#txtRazdobljeOd">
									<parameter value="#grdDetalj.@Dan"/>
								</action>
								<action type="control value" value="#txtRazdobljeDo">
									<parameter value="#grdDetalj.@Dan"/>
								</action>
								<action type="control value" value="#chckSubote">
									<parameter value="#grdDetalj.@chSubotaId"/>
								</action>
								<action type="control value" value="#chckNedelje">
									<parameter value="#grdDetalj.@chNedjeljaId"/>
								</action>
							</event>
						</grid>
					</item>
				</group>
				<group cols="3" rows="9" col="2" row="1" spacing="1,2,1,2" caption="Unos novog zapisa za odabrane djelatnike">
					<columnsdefinition>
						<column position="1" size="30%"/>
						<column position="3" size="30%"/>
					</columnsdefinition>
					<rowsdefinition>
						<row position="9" size="35"/>
					</rowsdefinition>
					<item caption="Organizacijska jedinica" col="1" row="1" colspan="3" textposition="left" highlight="false">
						<combotreeedit name="cmbOrgJedinica" required="false" tooltip="Orgshema lista" allownull="True" showmultiselecttext="True" valuefield="Id" displayfield="Naziv" parentfieldname="parent" dataname="~dtOrgJedinica">
							<event type="rowclick">
								<action type="disallow" if="#cmbOrgJedinica.@SmijeId==0"/>
							</event>
							<event type="valuechanged">
								<action type="control populate" value="#cmbSmjena"/>
							</event>
						</combotreeedit>
					</item>
					<item row="2" col="1" caption="Dimenzija:" highlight="false" colspan="3" textposition="left">
						<searchedit name="srcDimenzija" dataname="~dtDimenzije" fieldtext="Dimenzija" fieldvalue="DimenzijeId">
						</searchedit>
					</item>
					<item row="3" col="1" caption="Razdoblje:" textposition="left" highlight="False" required="true">
						<textedit name="txtRazdobljeOd" maxlength="2"/>
					</item>
					<item row="3" col="2" caption=" " textposition="right" highlight="False" required="true">
						<textedit name="txtRazdobljeDo" maxlength="2"/>
					</item>
					<item row="4" col="1" caption="Smjena:" highlight="false" colspan="2" textposition="left">
						<comboedit name="cmbSmjena" valuefield="Dne_SmjeneId" displayfield="Naziv" dataname="~dtSmjene" required="true" allownull="false">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtVrijeme"/>
								<action type="control value" value="#txtVrijemeOd">
									<parameter value="~dtVrijeme.@VrijemeOd"/>
								</action>
								<action type="control value" value="#txtVrijemeDo">
									<parameter value="~dtVrijeme.@VrijemeDo"/>
								</action>
							</event>
						</comboedit>
					</item>
					<item row="5" col="1" colspan="2" caption="Operacija:" textposition="left" highlight="False">
						<comboedit name="cmbOperacije" valuefield="OOPOperacijeId" displayfield="Naziv" dataname="~dtOperacije" required="false" allownull="true" datavalue="~dtGet.@OOPOperacijeId">
						</comboedit>
					</item>
					<item row="6" col="1" caption="Vrijeme od-do:" highlight="false" textposition="left" required="true">
						<textedit name="txtVrijemeOd" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="false">
						</textedit>
					</item>
					<item row="6" col="2" caption=" " highlight="false" textposition="right" required="true">
						<textedit name="txtVrijemeDo" format="([0-9]|1[0-9]|2[0-3])[.][0-5][0-9]" formattype="regex" value="00.00" allownull="false"/>
					</item>
					<group row="7" col="1" rows="1" cols="2" groupbordervisible="false">
						<item row="1" col="1" padding="4,39,6,0">
							<labeledit value="Uključi subote:"/>
						</item>
						<item row="1" col="2" highlight="False">
							<checkedit name="chckSubote"/>
						</item>
					</group>
					<group row="8" col="1" rows="1" cols="2" groupbordervisible="false">
						<item row="1" col="1" padding="4,34,6,0">
							<labeledit value="Uključi nedjelje:"/>
						</item>
						<item row="1" col="2" highlight="False">
							<checkedit name="chckNedelje"/>
						</item>
					</group>
					<item row="9" col="1" highlight="false">
						<button name="btnSpremi" caption="Spremi">
							<event type="click">
								<!-- <action type="message" value="#grdDetalj.selectedids.hrkadroviid"/> -->
								<action type="validate"/>
								<!-- traži pravo na odabranu orgshemu -->
								<action type="datarun reader" value="~dtPravoNaOrg"/>
								<!-- u varijablu spremi vrijednost orgshemaopid						 -->
								<action type="variable value" value="nastavak">
									<parameter value="~dtPravoNaOrg.@Pravo"/>
								</action>
								<!-- ako nemaš pravo javi porukom -->
								<action if="$nastavak==0">
									<action type="message" value="Nemate pravo na odabranu org jedinicu"/>
								</action>
								<!-- stopiraj daljnje izvršavanje ako uvjet nije zadovoljen...obrnuta logika!! -->
								<action if="$nastavak!=0"  stop="true">
								</action>

								<action type="datarun reader" value="~dtSpremi"/>
								<action if="$indGreske==0">
									<action type="control populate keepfocus" value="#grdDetalj"/>
									<action type="variable value" value="brojAkcija">
										<parameter value="1"/>
									</action>


									<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
									<action type="variable value" value="global.$RefreshajMaster">
										<parameter value="1" type="int"/>
									</action>
								</action>
							</event>
						</button>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnBrisi" caption="Obriši odabrane zapise" width="200">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane zapise?">
							<parameter name="captionYes" value="Obriši"/>
							<parameter name="captionNo" value="Odustani"/>
							<!-- <action type="message" value="Krećem brisati..."/> -->
							<action type="datarun reader" value="~dtBrisi" waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..." sleep="2000"/>
							<action type="variable value" value="brojAkcija">
								<parameter value="1"/>
							</action>


							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
						  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action if="$indGreske==0">
								<action type="control populate keepfocus" value="#grdDetalj"/>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spERVHelp" name="dtPravoNaOrg">
				<parameter name="@Action" value="daj_pravo_na_org"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@id" value="#cmbOrgJedinica"/>
			</data>
			<data command="spERVHelp" name="dtOrgJedinica">
				<parameter name="@action" value="cmb_orgshema"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spERVHelp" name="dtDimenzije">
				<parameter name="@action" value="src_dimenzije"/>
				<parameter name="@tekst" value="#srcDimenzija.text"/>
			</data>
			<data command="spERVHelp" name="dtSmjene">
				<parameter name="@action" value="cmb_smjene"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@orgshemaid" value="#cmbOrgJedinica"/>
				<parameter name="@selectedids" value="$selectedids"/>
			</data>
			<data command="spERVPregledZaDan" name="dtDet">
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spERVHelp" name="dtVrijeme">
				<parameter name="@action" value="getVrijeme"/>
				<parameter name="@Dne_SmjeneId" value="#cmbSmjena"/>
			</data>
			<data command="spERVPregledZaDan" name="dtDajDatum">
				<parameter name="@action" value="daj_datum"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
			</data>
			<data command="spERVAzur_AgroTovarnik" name="dtBrisi">
				<parameter name="@Action" value="brisanje"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@nizid" value="#grdDetalj.selectedids"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spERVAzur_AgroTovarnik" name="dtSpremi">
				<parameter name="@action" value="unos_niz"/>
				<parameter name="@dneev_mpid" value="0" type="int"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@nizid" value="#grdDetalj.selectedids.hrkadroviid"/>
				<parameter name="@godina" value="$godina"/>
				<parameter name="@mjesec" value="$mjesec"/>
				<parameter name="@danod" value="#txtRazdobljeOd" type="int"/>
				<parameter name="@dando" value="#txtRazdobljeDo" type="int"/>
				<parameter name="@satod" value="#txtVrijemeOd"/>
				<parameter name="@satdo" value="#txtVrijemeDo"/>
				<parameter name="@orgshemaid" value="#cmbOrgJedinica"/>
				<parameter name="@dne_smjeneid" value="#cmbSmjena"/>
				<parameter name="@dimenzijeid" value="#srcDimenzija"/>
				<parameter name="@chsubota" value="#chckSubote"/>
				<parameter name="@chnedjelja" value="#chckNedelje"/>
				<parameter name="@oopoperacijeId" value="#cmbOperacije"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spERVHelp" name="dtOperacije">
				<parameter name="@action" value="cmb_operacije"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
		</datalist>
	</form>
</root>