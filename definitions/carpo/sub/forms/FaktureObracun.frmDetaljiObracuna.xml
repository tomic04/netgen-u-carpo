<root>
<form name="frmDetaljiObracuna" caption="Detalji obračuna" fixedsize="false" width="800" height="570">
		<event type="load">		
			<action type="control populate" value="#grdDonos"></action>		
		</event>
        <layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid name="grdDonos" dataname="dtDetalji" showgrouppanel="False" showfooter="True" savelayout="true" >
                            <fields>
                                <field name="PartnerObracun" caption="Partner (Obračun)" />
								<field name="PartnerPT" caption="Partner (PT)" />
								<field name="Roba" caption="Roba" />
								<field name="Konzultant" caption="Konzultant" />
								<field name="KolicinaObracun" caption="Količina obračun" showtotalsum="false"/>
								<field name="NacinObracuna" caption="Način obračuna" />								
								<field name="KolicinaLink" caption="Količina link" showtotalsum="false"/>
								<field name="VrijemeZaObracun" caption="Vrijeme za obračun"/>
								<field name="VrijemeNaPutu" caption="Vrijeme na putu" />
								<field name="PutniTroskovi" caption="Putni troškovi" />
								<field name="TrosakBoravka" caption="Trošak boravka" />
								<field name="DanaBoravaka" caption="Dana boravka" />
								<field name="KM" caption="KM" />
								<field name="PTOpis" caption="PT opis" />
								<field name="OpisPosla" caption="Opis posla" />
                            </fields>
 				 			<styles>
								<!-- <style name="bold" if="#grdDonos.@Kolicina&gt;0" /> -->
							</styles>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>                           
                <button caption="IZLAZ" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spFaktureObracun_SatiAnalitika" name="dtDetalji">
				<parameter name="@FaktureObracunDetId" type="int" value="$FaktureObracunDetId" />
			</data>	
	    </datalist>
    </form>
</root>