<root>
	<form name="frmFilter" caption="Filter" width="400">
		<event type="init">
			<action type="datarun reader" value="~dtFilterObjekti" />
			<action type="datarun reader" value="~dtFilterNumberOfRows" />
			<action type="datarun reader" value="~dtFilterSetRow" />
			<action type="datarun reader" value="~dtFilterGet" />
			<action type="datarun reader" value="~dtVarKontrole" />
			<action type="variable value">
				<parameter name="VarFilter" value="Faktura" type="string" />
				<!-- u VarFilter saljem Faktura pa u toj varijabli ovisi prikazivanje kontrola na formi(prtFilter) -->
			</action>
			<action type="variable value">
				<parameter name="VarLokacija" value="false" />
			</action>		
			<action type="variable value">
				<parameter name="VarDatumRow" value="~dtFilterSetRow.@Datum" />
			</action>
			<action type="variable value">
				<parameter name="VarRazdobljeRow" value="~dtFilterSetRow.@Razdoblje" />
			</action>	
			<action type="variable value">
				<parameter name="VarZadnjihDanaRow" value="~dtFilterSetRow.@ZadnjihDana" />
			</action>			
			<action type="variable value">
				<parameter name="VarFakturiraniRow" value="~dtFilterSetRow.@Fakturirani" />
			</action>			
			<action type="variable value">
				<parameter name="VarStatusRow" value="~dtFilterSetRow.@Status" />
			</action>		
			<action type="variable value">
				<parameter name="VarVrstaDokRow" value="~dtFilterSetRow.@VrstaDok" />
			</action>			
			<action type="variable value">
				<parameter name="VarOrgShemaRow" value="~dtFilterSetRow.@OrgShema" />
			</action>			
			<action type="variable value">
				<parameter name="VarSkladisteRow" value="~dtFilterSetRow.@skladiste" />
			</action>			
			<action type="variable value">
				<parameter name="VarUlaznoSkladisteRow" value="~dtFilterSetRow.@UlaznoSkladiste" />
			</action>			
			<action type="variable value">
				<parameter name="VarPartnerRow" value="~dtFilterSetRow.@Partner" />
			</action>			
			<action type="variable value">
				<parameter name="VarLokacijaRow" value="~dtFilterSetRow.@Lokacija" />
			</action>			
			<action type="variable value">
				<parameter name="VarOperaterRow" value="~dtFilterSetRow.@Operater" />
			</action>			
			<action type="variable value">
				<parameter name="VarOsobaRow" value="~dtFilterSetRow.@Osoba" />
			</action>			
			<action type="variable value">
				<parameter name="VarNacinPlacanjaRow" value="~dtFilterSetRow.@NacinPlacanja" />
			</action>			
			<action type="variable value">
				<parameter name="VarInstrPlacanjaRow" value="~dtFilterSetRow.@InstrPlacanja" />
			</action>			
			<action type="variable value">
				<parameter name="VarNacinIsporukeRow" value="~dtFilterSetRow.@NacinIsporuke" />
			</action>			
			<action type="variable value">
				<parameter name="VarValutaRow" value="~dtFilterSetRow.@Valuta" />
			</action>			
			<action type="variable value">
				<parameter name="VarRajonRow" value="~dtFilterSetRow.@Rajon" />
			</action>			
			<action type="variable value">
				<parameter name="VarRadniNalogRow" value="~dtFilterSetRow.@RadniNalog" />
			</action>			
			<action type="variable value">
				<parameter name="VarBrojDokRow" value="~dtFilterSetRow.@BrojDok" />
			</action>			
			<!-- <action type="message" value="~dtFilterObjekti.@BrojRedova" />			 -->
			<!-- <action type="variable value"> -->
			<!-- <parameter name="Test" value="~dtFilterObjekti.@BrojRedova" /> -->
			<!-- </action> -->
			<action type="variable value">
				<parameter name="VarRows" value="~dtFilterNumberOfRows.@BrojRedova" />
			</action>
			<action type="variable value">
				<parameter name="VarVisible" value="False" />
			</action>	
			<action type="variable value">
				<parameter name="Varkontrole" value="txtRadniNalog" type="string"/>
			</action>
			<action type="variable value">
				<parameter name="VarCurrentRow" value="2" />
				<!-- VarCurrentRow je na ulasku 0, a onda dinamicki dodijeljujem vrijednost /> -->
			</action>						
			<!-- <action type="message" value="#dtFilterObjekti.@BrojRedova" /> -->
		</event>	
		<event type="shown">
			<action type="control visible" value="#txtRadniNalog, #cmbRajon">
				<parameter value="$VarVisible" />
			</action>		
			<action type="control visible" value="#datDatumOd, #datDatumDo">
				<parameter value="false" if="~dtFilterObjekti.Datum==0"/>
				<parameter value="true" else=""/>
			</action>
			<!-- <action type="control visible" value="#cmbRazdoblje"> -->
				<!-- <parameter value="false" if="~dtFilterObjekti.Razdoblje==0"/> -->
				<!-- <parameter value="true" else=""/> -->
			<!-- </action> -->
			<action type="control visible" value="#grpZadnjih">
				<parameter value="false" if="~dtFilterObjekti.ZadnjihDana==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cteOrgShema">
				<parameter value="false" if="~dtFilterObjekti.OrgShema==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbStatus">
				<parameter value="false" if="~dtFilterObjekti.Status==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#srcPartner">
				<parameter value="false" if="~dtFilterObjekti.Partner==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#srcParstru">
				<parameter value="false" if="~dtFilterObjekti.Lokacija==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#txtBrojDok">
				<parameter value="false" if="~dtFilterObjekti.BrojDok==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbFakturirani">
				<parameter value="false" if="~dtFilterObjekti.Fakturirani==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbSkladiste">
				<parameter value="false" if="~dtFilterObjekti.Skladiste==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbUlaznoSkladiste">
				<parameter value="false" if="~dtFilterObjekti.UlaznoSkladiste==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbOperater">
				<parameter value="false" if="~dtFilterObjekti.Operater==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbOsobe">
				<parameter value="false" if="~dtFilterObjekti.@Osoba==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbNacinPlacanja">
				<parameter value="false" if="~dtFilterObjekti.NacinPlacanja==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbInstrumentPlacanja">
				<parameter value="false" if="~dtFilterObjekti.InstrPlacanja==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbNacinOtpreme">
				<parameter value="false" if="~dtFilterObjekti.NacinIsporuke==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbValuta">
				<parameter value="false" if="~dtFilterObjekti.Valuta==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#cmbRajon">
				<parameter value="false" if="~dtFilterObjekti.Rajon==0"/>
				<parameter value="true" else=""/>
			</action>
			<action type="control visible" value="#txtRadniNalog">
				<parameter value="false" if="~dtFilterObjekti.RadniNalog==0"/>
				<parameter value="true" else=""/>
			</action>		
		</event>
		<part name="filter" path="prtFilter.xml">
		</part>
		<datalist>
			<part name="filterData" path="prtFilter.xml" />
		</datalist>	
	</form>

</root>


