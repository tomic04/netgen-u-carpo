<root>
  
  <form name="frmOSImovinaOP_Brisanje" caption="$Caption" fixedsize="false" width="500" >
    
    <!--<event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>-->
    
    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item caption="" col="1" row="1" >
          <labeledit name="lblBrisanje" value="Da li ste sigurni da želite obrisati označeni slog s obračunskim podacima?" fontbold="true" />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnBrisi"  caption="Da" type="delete" function="BrisiOP">
          <event type="click">
            <action type="datarun nonquery" value="~dtBrisi"/>
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdObracunski"/>
            <action type="control refreshvalue" value="parent.#grdImovina"/>
          </event>
        </button>
        <button caption="Ne" type="cancel" dock="right">
          <event type="click"/>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaOP_AzurCP" name="dtBrisi">
        <parameter name="@Action" value="Brisanje"/>
        <parameter name="@OSImovinaOPId" value="$OSImovinaOPId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
      </data>
    </datalist>
    
  </form>
  
</root>