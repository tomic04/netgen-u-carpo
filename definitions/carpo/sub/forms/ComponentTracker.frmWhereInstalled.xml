<root>
	<form name="frmWhereInstalled" caption="Firme">
        <event type="load">
            <action type="control populate" value="#grdInstalirano" />
        </event>
        <layout>
            <group cols="1" rows="1">
                <item row="1" col="1" height="300" width="300">
                    <grid name="grdInstalirano" dataname="~dtWhereInstalled" multiselect="false" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false"/>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnZatvori" caption="Zatvori" dock="right">
                    <event type="click">
                        <action type="formclose"/>
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtNapuniComboStatus">
                <parameter name="@Action" value="cmbStatus" />
            </data>
            <data command="spComponentTrackerAzur" name="dtUredi">
                <parameter name="@VersionId" value="parent.#grdGlava.@id" />
                <parameter name="@Action" value="edit" />
                <parameter name="@txtVersionNumber" value="#txtVersionNumber" />
                <parameter name="@txtPublisher" value="#txtPublisher" />
                <parameter name="@txtReviewer" value="#txtReviewer" />
                <parameter name="@datPublishDate" value="#datPublishDate" />
                <parameter name="@cmbStatus" value="#cmbStatus" />
                <parameter name="@memoStatus" value="#memoStatus" />
            </data>
            <data command="spComponentTracker" name="dtWhereInstalled">
                <parameter name="@Action" value="whereInstalled" />
                <!-- <parameter name="@VersionId" value="parent.#grdGlava.@id" if="global.$filter==Komponente"/>
                <parameter name="@VersionId" value="parent.#grdGlava.@VersionId" if="global.$filter==Partneri" /> -->
                <parameter name="@VersionId" value="global.$versionId" />
            </data>
        </datalist>
    </form>
</root>