<root>
	<form name="frmLokacijeSearch" caption="Popis lokacija" width="600">

		<event type="load">
			<action type="datarun reader" value="~dtPuniLokaciju">
				<parameter name="@partneriid" value="$partneriid" />
				<parameter name="@action" value="Parstru" />
				<parameter name="@Ind_postotak" value="1" />
				<parameter name="@uvjet" value="%" />
			</action>
        	<action type="control populate" value="#grdLokacije" />
		</event>
		
		<layout>
			<group rows="2" cols="1">

					<item col="1" row="1">	
						<grid name="grdLokacije" dataname="~dtPuniLokaciju" >
							<fields>
	                            <field name="Lokacija3000" caption="Lokacija" />
                                <field name="Šifra lokacije" caption="Šifra" />
                                <field name="Adresa" caption="Adresa" />
                                <field name="Mjesto" caption="Mjesto"/>
                                <field name="Partner" caption="Partner" />
							</fields>
							<event type="keydown" value="13">
								<action type="form close"></action>				
								<action type="control value" value="parent.#srcParstru">
									<parameter value="#grdLokacije.@parstruid" text="#grdLokacije.@Lokacija3000"/>
								</action>
							</event>
						</grid>
					</item>
			</group>
		</layout>

			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="Odaberi" dock="right">
						<event type="click">
						<action type="form close"></action>				
						<action type="control value" value="parent.#srcParstru">
							<parameter value="#grdLokacije.@parstruid" text="#grdLokacije.@Lokacija3000"/>
						</action>	
						</event>
					</button>
					<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
				</buttons>
			</panelbuttons>

		<datalist>
			<data command="spTraziParstru" name="dtPuniLokaciju">
				<parameter name="@partneriid" value="$partneriid" />
				<parameter name="@action" value="Parstru" />
				<parameter name="@Ind_postotak" value="1" />
				<parameter name="@Uvjet" value="%" />
			</data>
		</datalist>

	</form>
</root>	