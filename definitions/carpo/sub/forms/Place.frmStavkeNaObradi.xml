<root>
  <form name="frmStavkeNaObradi" caption="$caption"  width="800" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtStavke" />
    </event>

    <event type="load">
      <action type="control populate" value="#grdStavke" >     </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdStavke" key="OOPObradeDetId" dataname="~dtStavke" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="true" autowidth="true" showtotalsum="true" showfooter="true">
            <fields inherited="true">
              <field name="Sati" editable="true"></field>
              <field name="Bodovi" editable="true"></field>
              <field name="Postotak" editable="true"></field>
              <field name="DanOd" editable="true" caption="Od dana"></field>
              <field name="DanDo" editable="true" caption="Do dana"></field>
              <field name="Iznos" editable="true"></field>
            </fields>

            <event type="cellvaluechanged" >
              <action type="datarun nonquery" value="dtSpremi"/>
            </event>
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="IZLAZ" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceDetQuery" name="dtStavke">
        <parameter name="@Action" value="stavke_na_obradi"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
      <data command="spPlaceDetAzur" name="dtSpremi">
        <parameter name="@Action" value="izmjena_stavkeNaObradi"/>
        <parameter name="@OOPObradeDetId" value="#grdStavke.@OOPObradeDetId" type="int"/>
        <parameter name="@sati" value="#grdStavke.@sati"/>
        <parameter name="@bodovi" value="#grdStavke.@bodovi"/>
        <parameter name="@postotak" value="#grdStavke.@postotak"/>
        <parameter name="@danod" value="#grdStavke.@danod"/>
        <parameter name="@dando" value="#grdStavke.@dando"/>
        <parameter name="@iznos" value="#grdStavke.@iznos"/>
      </data>
    </datalist>
  </form>


</root>