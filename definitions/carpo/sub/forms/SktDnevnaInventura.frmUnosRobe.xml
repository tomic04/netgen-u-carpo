<root>
	<form name="frmUnosRobe" caption="Unos robe">
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" if="$SktDnevnaInventGlaId!=null" />
			<action type="datarun reader" value="Global.~dtPopisSkladista">
				<parameter value="~dtPopisSkladista.@Skladista"/>
			</action>
			<action type="datarun reader" value="~dtStanjeUkupno" />
		</event>
		<event type="load">
		</event>
		<event type="shown">
			<action type="control disable" value="#txtStanjeUkupno,#txtStanjeZaliha,#txtStanjeZalihaPAK,#txtStanjeSkladIzbrojano,#txtStanjeSkladIzbrojanoPAK" if="#srcRoba==null"/>
			<action type="control enable" value="#txtStanjeUkupno,#txtStanjeZaliha,#txtStanjeZalihaPAK,#txtStanjeSkladIzbrojano,#txtStanjeSkladIzbrojanoPAK" else=""/>

			<action type="control value" value="#txtStanjeUkupno">
				<parameter value="0" type="int" />
			</action>
			<action type="control enable" value="#txtOvlastenaOsoba" if="@==0" />
		</event>
		<event type="onclose">
			<action type="control populate" value="parent.#grdMaster">
				<action type="control focus" value="parent.#grdMaster">
					<parameter value="$SktDnevnaInventGlaId" />
				</action>
			</action>
		</event>
		<layout textposition="top" itemspadding="3">
			<group cols="2" rows="5" groupbordervisible="true">
				<columnsdefinition>
					<column size="50%" position="1" />
					<column size="50%" position="2" />
				</columnsdefinition>
				<group row="1" col="1" rows="1" cols="1" groupbordervisible="false" colspan="2">
					<item caption="Roba:" row="1" col="1" textalignmode="left">
						<searchedit netgenfields="true" name="srcRoba" required="true" fontbold="true" dataname="dtRoba" fieldtext="NazivId" fieldvalue="RobaId" datavalue="#dtGet.@RobaId" datatext="#dtGet.@Naziv">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtStanjeUkupno" />
								<action type="control refreshvalue" value="#txtStanjeUkupno"/>
								<action type="control value" value="#txtStanjeUkupno,#txtStanjeZaliha,#txtStanjeZalihaPAK,#txtStanjeSkladIzbrojano,#txtStanjeSkladIzbrojanoPAK"  if="#srcRoba==null"/>
								<action type="control disable" value="#txtStanjeUkupno,#txtStanjeZaliha,#txtStanjeZalihaPAK,#txtStanjeSkladIzbrojano,#txtStanjeSkladIzbrojanoPAK" if="#srcRoba==null"/>
								<action type="control enable" value="#txtStanjeUkupno,#txtStanjeZaliha,#txtStanjeZalihaPAK,#txtStanjeSkladIzbrojano,#txtStanjeSkladIzbrojanoPAK" else=""/>
								</event>
						</searchedit>
					</item>
				</group>
				<group row="2" col="1" rows="1" cols="1" groupbordervisible="false">
					<item caption="Stanje skladište:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeSkladiste" datavalue="" value="0" format="n0" readonly="true"/>
					</item>
				</group>
				<group row="2" col="2" rows="1" cols="1" groupbordervisible="false">
					<item caption="Stanje zbirno:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeZbirno" datavalue="" value="0" format="n0" readonly="true"/>
					</item>
				</group>
				<group row="3" col="1" rows="1" cols="1" groupbordervisible="false">
					<item caption="Stanje zaliha ZP kom:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeZaliha" datavalue="~dtStanjeUkupno.StanjeZaliha" format="n0">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtStanjeUkupno" />
								<action type="control refreshvalue" value="#txtStanjeUkupno, #txtStanjeZalihaPAK"/>
							</event>
						</textedit>
					</item>
				</group>
				<group row="3" col="2" rows="1" cols="1" groupbordervisible="false">
					<item caption="Sklad. stanje izbrojano kom:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeSkladIzbrojano" datavalue="~dtStanjeUkupno.StanjeSkladIzbrojano" format="n0">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtStanjeUkupno" />
								<action type="control refreshvalue" value="#txtStanjeUkupno,#txtStanjeSkladIzbrojanoPAK"/>
							</event>
						</textedit>
					</item>
				</group>
				<group row="4" col="1" rows="1" cols="1" groupbordervisible="false">
					<item caption="Stanje zaliha ZP paketi:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeZalihaPAK" datavalue="~dtStanjeUkupno.StanjeZalihaPAK" format="n2">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtStanjeUkupno" />
								<action type="control refreshvalue" value="#txtStanjeUkupno, #txtStanjeZaliha"/>
							</event>
						</textedit>
					</item>
				</group>
				<group row="4" col="2" rows="1" cols="1" groupbordervisible="false">
					<item caption="Sklad. stanje izbrojano paketi:" row="1" col="1" textalignmode="left">
						<textedit name="txtStanjeSkladIzbrojanoPAK" datavalue="~dtStanjeUkupno.StanjeSkladIzbrojanoPAK" format="n2">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtStanjeUkupno" />
								<action type="control refreshvalue" value="#txtStanjeUkupno,#txtStanjeSkladIzbrojano"/>
							</event>
						</textedit>
					</item>
				</group>

				<group row="5" col="1" rows="1" cols="1" groupbordervisible="false" textalignmode="left">
					<item caption="Stanje ukupno:" row="1" col="1">
						<textedit name="txtStanjeUkupno" datavalue="~dtStanjeUkupno.stanjeUkupno" format="n0" readonly="true" />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtStavkaInsert">
							<parameter name="SktDnevnaInventDetId" />
						</action>
						<action type="control populate" value="parent.#grdDetalj">
							<action type="control focus" value="parent.#grdDetalj">
								<parameter value="$sktDnevnaInventDetId" type="int" />
							</action>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba" />
				<parameter name="@Uvjet" value="#srcRoba.text" />
				<parameter name="@PokaziVPCijene" value="1" />
				<parameter name="@PokaziNabCijene" value="1" />
				<parameter name="@Retired" value="0" />
				<parameter name="@Prikazi_Dodatno" value="1" />
				<parameter name="@PokaziStanje" value="1" />
			</data>
			<data command="spSktDnevnaInventDetInsert" name="dtStavkaInsert">
				<parameter name="@SktDnevnaInventGlaId" value="$SktDnevnaInventGlaId" />
				<parameter name="@RobaId" value="#srcRoba" />
				<parameter name="@StanjeSkladiste" value="0" />
				<parameter name="@StanjeZbirno" value="0" />
				<parameter name="@StanjeZaliha" value="#txtStanjeZaliha" />
				<parameter name="@StanjeSkladIzbrojano" value="#txtStanjeSkladIzbrojano" />
				<parameter name="@StanjeZalihaPAK" value="#txtStanjeZalihaPAK" />
				<parameter name="@StanjeSkladIzbrojanoPAK" value="#txtStanjeSkladIzbrojanoPAK" />
				<parameter name="@StanjeUkupno" value="#txtStanjeUkupno" />
			</data>
			<data command="spSktDnevnaInventStanjeUkupno" name="dtStanjeUkupno">
				<parameter name="@StanjeZaliha" value="#txtStanjeZaliha" />
				<parameter name="@StanjeSkladIzbrojano" value="#txtStanjeSkladIzbrojano" />
				<parameter name="@StanjeZalihaPAK" value="#txtStanjeZalihaPAK"/>
				<parameter name="@StanjeSkladIzbrojanoPAK" value="#txtStanjeSkladIzbrojanoPAK" />
				<parameter name="@StanjeZbirno" value="0" />
				<parameter name="@StanjeSkladiste" value="0" />
				<parameter name="@RobaId" value="#srcRoba" />
			</data>
		</datalist>
	</form>
</root>
