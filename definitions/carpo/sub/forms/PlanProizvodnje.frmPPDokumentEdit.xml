<root>
	<form name="frmPPDokumentEdit" caption="Izmjena dokumenta" width="1150" >
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<event type="load">
			<action type="control disable" value="#btnAddDetalj, #btnEditDetalj, #btnDelDetalj" if="$StatusPon==2"/>
			<action type="control enable" value="#btnAddDetalj, #btnEditDetalj, #btnDelDetalj" else="" />
			<action type="variable value" >
				<action type="datarun scalar" value="Global.~dtVrstaDokGet">
					<parameter name="VrstaDokId" value="$VrstaDokId" />
				</action>	
			</action>	
		</event>
		<layout textposition="left" itemspadding="3">
			<group padding="0" groupbordervisible="False" cols="3" rows="1">
				<columnsdefinition>
					<column size="400" position="1" />
					<column size="8" position="2" />
				</columnsdefinition>
				<item row="1" col="2" />
				<group padding="0" groupbordervisible="False" cols="1" rows="2" col="3" row="1">
					<rowsdefinition>
						<row size="60" position="2" />
					</rowsdefinition>
					<item row="1" col="1" highlight="False" >
						<grid name="grdRoba" autopopulate="true" keyfield="RobaId" dataname="dtDetail" multiselect="true" savelayout="true">
							<event type="cellvaluechanged">
								<action type="datarun nonquery" value="~dtUpdateKolicina"/>
								<action type="control populate" value="grdRoba" />
							</event>
							<!-- 							<event type="showingeditor">
								<action type="editor allow" value="true" if="#grdRoba.@ProPonGlaId==45791" />
							</event> -->	

<!-- 							<event type="doubleclick" >
								<action type="message" value="Ovdje treba ici forma o Računima utrška" if="#grdRoba.@Sifra==102"/>
							</event> -->

							<fields>

								<field name="NadKlasa" caption="Nadklasa" />
								<field name="Klasa" caption="Klasifikacija" />
								<field name="Sifra" caption="Roba" />
								<field name="RobaNaziv" caption="Naziv" fontbold="True" />
								<field name="JMNaziv" caption="JM" />
								<field name="KolicinaPlan1" caption="Plan prodaja"  editable="true" format="n3"/>
								<field name="KolicinaPlan2" caption="Plan nabava" />
								<field name="KolicinaPlan3" caption="Plan proizvodnja" />
								<field name="KolicinaStanje" caption="Raspoloživo" />
								<field name="KolicinaRezervirano" caption="Rezervirano" />
								<field name="KolicinaProizvodnja" caption="U proizvodnji" />
								<field name="KolicinaPlanProdaje" caption="Plan prodaje" />
								<field name="KolicinaMin" caption="Min. zaliha" />
								<field name="Cijena" caption="Cijena" />
								<field name="JM2Naziv" caption="JM2" />
								<field name="jm2Kolicina" caption="Plan - osn. JM" />	
							</fields>
							<styles>
								<!-- <style name="fontcolor" value="red" if="#grdRoba.@KolicinaPlan==500"/> -->
								<!-- <style name="bold" value="true" if="#grdRoba.@KolicinaPlan1==500"/> -->
								<!-- <style name="fontcolor" value="red" if="#grdRoba.cellvalue==aaa"/> -->
								<!-- <style name="fontcolor" value="red" if="#grdRoba.fieldvalue==aaa"/> -->
							</styles>
						</grid>
					</item>
					<group padding="0" groupbordervisible="true" cols="3" rows="1" col="1" row="2" width="250">
						<group padding="0" groupbordervisible="false" cols="3" rows="1" col="1" row="1" width="250">
							<item row="1" col="1" textvisible="False">
								<button name="btnAddDetalj" caption="Dodaj" image="add" type="add">
									<event type="click">
										<action type="form open" value="frmRoba">
											<parameter name="ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId" />
											<parameter name="OrgShemaId" value="#cteOrgShema" />
											<parameter name="ParStruId" value="#cmbLokacija" />
											<parameter name="Action" value="0" type ="int" />
										</action>
										<action type="control populate" value="#grdRoba" />
									</event>
								</button>
							</item>
							<item row="1" col="2" textvisible="False">
								<button name="btnEditDetalj" caption="Izmijeni" type ="edit" image="edit">
									<event type="click">
										<action type="form open" value="frmRoba">
											<parameter name="ProPlanProizvodnjeDetId" value="#grdRoba.@ProPlanProizvodnjeDetId"/>
											<parameter name="ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId" />
											<parameter name="OrgShemaId" value="#cteOrgShema" />
											<parameter name="Action" value="1" type="int"/>
										</action>
										<action type="control populate" value="#grdRoba" />
									</event>
								</button>
							</item>
							<item row="1" col="3" textvisible="False">
								<button caption="Obriši" name="btnDelDetalj" image="delete">
									<event type="click">
										<action type="confirm" value="Želite li obrisati označeno?">
											<action type="control foreachrow selected" value="#grdRoba">
												<action type="datarun nonquery" value="~dtDetDelete">
												</action>
											</action>
											<action type="control populate" value="#grdRoba" />
										</action>
									</event>
								</button>
							</item>
							<!-- 						<item row="1" col="4" textvisible="False">
							<button name="btnOsvjeziObveze" caption="Osvježi obveze">
								<event type="click">
									<action type="datarun nonquery" value="~dtOsvjeziObveze">
										<action type="control populate" value="#grdRoba" />
									</action>
								</event>
							</button>
						</item>
						<item row="1" col="5" textvisible="False">
							<button name="btnOsvjeziOtpremu" caption="Osvježi otpremu">
								<event type="click">
									<action type="datarun nonquery" value="~dtOsvjeziOtpremu">
										<action type="control populate" value="#grdRoba" />
									</action>
								</event>
							</button>
						</item>
						<item row="1" col="6" textvisible="False">
							<button name="btnOsvjeziCijene" caption="Osvježi cijene">
								<event type="click">
									<action type="datarun nonquery" value="~dtOsvjeziCijene">
										<action type="control populate" value="#grdRoba" />
									</action>
								</event>
							</button>
						</item> -->
						</group>
					</group>
				</group>
				<tabs row="1" col="1" >
					<group caption="Osnovno" cols="1" rows="6" col="1" row="1" alignmode="local">
						<part name="planProizvodnjeAtributi" path="prtPlanProizvodnje.xml" />						
					</group>
					<group caption="Napomena" cols="3" rows="3" col="1" row="1">
						<columnsdefinition>
							<column position="1" size="100%"/>
							<column size="70" position="2"/>
							<column size="70" position="3"/>
						</columnsdefinition>
						<rowsdefinition>
							<row size="30" position="2" />
						</rowsdefinition>
						<item caption="Standardne napomene:" row="1" col="1" colspan="3" textposition="top">
							<comboedit name="cmbNapomena" enabled="true" valuefield="Poruka" displayfield="Poruka" datavalue="#dtGet.@Poruka" dataname="Global.dtPoruke" >
							</comboedit>
						</item>
						<item row="2" col="2">
							<button name="btnDodaj" caption="Dodaj" dock="right">
								<!--Dodaj red niže on postojeću napomenu -->
								<event type="click">
									<action type="datarun reader" value="~dtNapomena"/>
									<action type="control value" value="#MemoGlava">
										<parameter value="~dtNapomena.@tekst"/>
									</action>
								</event>
							</button>
						</item>
						<item row="2" col="3" >
							<button name ="btnZamjeni" caption="Zamjeni" type="edit" dock="right" >
								<event type="click">
									<action type="control value" value="#MemoGlava">
										<parameter value="#cmbNapomena"/>
									</action>
								</event>
							</button>
						</item>
						<item name="Memo" textvisible="False" row="3" col="1" colspan="3" >
							<memoedit name="MemoGlava" datavalue="~dtGet.@Memo"  />
							<event type="valuechanged">
								<action type="control disable" value="#btnZamjeni" if="#Memo!=null"/>
							</event>
						</item>
					</group>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtDataInsert">
						</action>
						<!-- 						<action type="control focus" value="parent.#grdMaster">
							<parameter value="$ProPlanProizvodnjeGlaId" />
						</action>	 -->
						<action type="variable value"  >
							<parameter name="parent.tmpId" value="$ProPlanProizvodnjeGlaId"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnZakljuci" caption="ZAKLJUČI" >
					<event type="click">
						<action type="confirm" value="Želite li zaključiti dokument?">
							<action type="datarun nonquery" value="dtZakljuci"/>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnBilanca" caption="Bilanca">
					<event type="click">
						<action type="datarun nonquery" value="~dtBilancaTempDelete"/>
						<action type="control foreachrow selected" value="#grdRoba">
							<action type="datarun nonquery" value="~dtBilancaTempInsert"/>
						</action>
						<action type="form open" value="frmBilanca">
							<parameter name="Nivo" value="0" />
						</action>
					</event>
				</button>
				<button name="btnSirovine" caption="Sirovine">
					<event type="click">
						<action type="datarun nonquery" value="~dtPrnPlanTempDelete"/>
						<action type="control foreachrow selected" value="#grdRoba">
							<action type="datarun nonquery" value="~dtPrnPlanTempInsert"/>
						</action>					
						<action type="form open" value="frmSirovine">

						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>		
		<datalist>
			<data command="spProPlanProizvodnjeGlaAzur" name="dtDataInsert">
				<parameter name="@Action" value="1" />
				<parameter name="@DatumDok" value="#datDatumdok" />
				<parameter name="@OsobeId" value="#cmbOsobe" />
				<parameter name="@OrgShemaId" value="#cteOrgShema" />
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@DatumOd" value="#datDatumOd" />
				<parameter name="@DatumDo" value="#datDatumDo" />
				<parameter name="@RefDatumOd" value="#datRefDatumOd" />
				<parameter name="@RefDatumDo" value="#datRefDatumDo" />
				<parameter name="@ID" value="$ProPlanProizvodnjeGlaId" />
			</data>
			<data command="spProPlanProizvodnjeGlaQuery" name="dtGet">
				<parameter name="@Action" value="masterforma" />
				<parameter name="@ID" value="$ProPlanProizvodnjeGlaId" />
			</data>	
			<data command="spProPlanProizvodnjeDetQuery" name="dtDetail">
				<parameter name="@Action" value="detail" />
				<parameter name="@ID" value="$ProPlanProizvodnjeGlaId" />
			</data>		
			<data command="spPrnPlanBilancaTempAzur" name="dtBilancaTempDelete">
				<parameter name="@Action" value="0"/>
			</data>
			<data command="spPrnPlanBilancaTempAzur" name="dtBilancaTempInsert">
				<parameter name="@action" value="1"/>
				<parameter name="@robaid" value="#grdRoba.@RobaId"/>
				<parameter name="@kolicina" value="#grdRoba.@KolicinaPlan1"/>
			</data>	
			<data command="spPrnPlanTempAzur" name="dtPrnPlanTempDelete">
				<parameter name="@Action" value="0"/>
			</data>
			<data command="spPrnPlanTempAzur" name="dtPrnPlanTempInsert">
				<parameter name="@action" value="1"/>
				<parameter name="@robaid" value="#grdRoba.@RobaId"/>
				<parameter name="@kolicina" value="#grdRoba.@KolicinaPlan1"/>
			</data>	
			<data command="spProPlanProizvodnjeDetAzur" name="dtUpdateKolicina">
				<parameter name="@action" value="5"/>
				<parameter name="@id" value="#grdRoba.@ProPlanProizvodnjeDetId"/>
				<parameter name="@kolicinaplan1" value="#grdRoba.@KolicinaPlan1"/>
			</data>				
			<data command="spProPlanProizvodnjeDetAzur" name="dtOsvjeziObveze">
				<parameter name="@action" value="4"/>
				<parameter name="@ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId"/>
			</data>	
			<data command="spProPlanProizvodnjeDetAzur" name="dtOsvjeziOtpremu">
				<parameter name="@action" value="5"/>
				<parameter name="@ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId"/>
			</data>
			<data command="spProPlanProizvodnjeDetAzur" name="dtOsvjeziCijene">
				<parameter name="@action" value="6"/>
				<parameter name="@ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId"/>
				<parameter name="@VrCjenikId" value="#cmbCjenik" if="#cmbCjenik!=null"/>
			</data>				
			<data command="spProPlanProizvodnjeDetAzur" name="dtDetDelete">
				<parameter name="@action" value="2"/>
				<parameter name="@id" value="#grdRoba.@ProPlanProizvodnjeDetId"/>
			</data>				
		</datalist>		
	</form>
</root>