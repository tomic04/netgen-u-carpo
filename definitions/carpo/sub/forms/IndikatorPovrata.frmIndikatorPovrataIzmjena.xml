<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmIndikatorPovrataIzmjena" caption="Izmjeni" width="400" height="300" type="master">		
		<event type="init">
			<action type="datarun reader" value="~dtPopulate" />
		</event>

		<event type="load">
			<action type="control disable" value="#cmbZabLok" if="#rdoZabrana==false" />
		</event>


		<layout>
		<group cols="3" rows="5" row="1" col="1">
					<item col="1" row="2" caption="Roba:" colspan="3">
						<searchedit name="txtRoba" fontsizedelta="0" fontbold="True" fieldtext="NazivId" fieldvalue="RobaId"  
						dataname="~dtRoba" datavalue="~dtPopulate.@robaid" datatext="~dtPopulate.@NazivRobe" netgenfields="true">
						</searchedit>
					</item>
					<item col="1" row="1" caption="Partner:" colspan="3">
						<searchedit name="partner" fieldtext="NazivId" fieldvalue="partneriid"  fontbold="true" required="true" 
						dataname="~dtPartneri" datavalue="~dtPopulate.partnerid" datatext="~dtPopulate.@NazivPartnera" netgenfields="true">
						</searchedit>	
					</item>
				 
                    <item row="3" col="1">
                        <radioedit name="rdoZabrana" caption="Zabrana" value="true">
                            <event type="checkchanged">	
                            </event>
                        </radioedit>
                     </item>

                     <item row="3" col="2" colspan="2" caption="Org.shema:">
                     	 <comboedit name="cmbZabLok" dataname="~dtViPogoni" valuefield="OrgShemaID" displayfield="Naziv" datavalue="~dtPopulate.@OrgShemaID" >
                     	 </comboedit>
                    </item>
                    
                    <item row="4" col="1">
                        <radioedit name="rdoCjelobrojni" caption="Cjelobrojni" datavalue="~dtPopulate.@cjelobrojni" >
                            <event type="checkedchanged">
                            	<action type="control disable" value="#cmbZabLok" if="#rdoZabrana==false" />
								<action type="control enable" value="#cmbZabLok" else="" />	
								<action type="control value" value="cmbZabLok">
                            		<parameter name="cmbZabLok" value="null" type="int" if="#rdoZabrana==false"/>
                            	</action>
                            </event>
                        </radioedit>
                    </item>				
                    <item row="5" col="1">
                        <radioedit name="rdoPosebni" caption="Posebni" datavalue="~dtPopulate.@posebni">
                            <event type="checkedchanged">
                            	<action type="control disable" value="#cmbZabLok" if="#rdoZabrana==false" />
								<action type="control enable" value="#cmbZabLok" else="" />	
								 	<action type="control value" value="cmbZabLok">
                            		<parameter name="cmbZabLok" value="null" type="int" if="#rdoZabrana==false"/>
                            	</action>
                            </event>
                        </radioedit>
                    </item>	
               
               			
				</group> 


		</layout>
		<panelbuttons>
			<buttons>
				<button name="Izmjeni" caption="Izmjeni" type="add" dock="left">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtUpdate"/>
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close"/>
					</event>
				</button>
				<button name="Odustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>		
			</buttons>
		</panelbuttons>
		<datalist>
 			
			<data command="spTraziRoba" name="dtRoba">
			  <parameter name="@action" value="Roba"/>
			  <parameter name="@Uvjet" value="#txtRoba.text"/>
			  <parameter name="@PokaziVPCijene" value="0"/>
			  <parameter name="@PokaziNabCijene" value="0"/>
			  <parameter name="@Retired" value="0"/>
			</data>
			<data command="spTraziPartneri" name="dtPartneri">
				  <parameter name="@Action" value="Partneri" />
				  <parameter name="@Uvjet" value="#partner.text" />
			</data>

					<data command="spProPovratIndQuery" name="dtPopulate">
        					<parameter name="@action" value='1' />
        					<parameter name="@ProPovratIndId" value="$ProPovratIndId" />
    				</data>

					<data command="spProPovratIndUpdate" name="dtUpdate">
				        <parameter name="@ProPovratIndId" value="parent.#grdGlava.@ProPovratIndId" />
				        <parameter name="@PartnerId" value="#partner" />
				        <parameter name="@robaid" value="#txtRoba" />
				        <parameter name="@zabrana" value="#rdoZabrana" />
				        <parameter name="@cjelobrojni" value="#rdoCjelobrojni" />
				        <parameter name="@posebni" value="#rdoPosebni" />
				        <parameter name="@orgshema" value="#cmbZabLok" if="#rdoZabrana==true"></parameter>
						<parameter name="@orgshema" value="null" else=""></parameter>
				    </data>
				    <data command="select orgshemaid, naziv, sortkey, oznaka from viPogoni" name="dtViPogoni" type="text" />

		</datalist>
	</form>
</root>


<!-- Z.M. 13.03.2018. trebam izmjeniti storu u ViPogoni za punjenje padajućeg izbornika kod zabrane 
	 Vratiti na viPogoni pogled na kratice
	 
	 Z.M. 14.03.2018.

	 popis stora:

	spProPovratIndQuery - stora za čitanje podataka (edited)
	spProPovratIndInsert - stora za insert podataka (edited)
	spProPovratIndDelete - stora za brisanje podataka (netaknuto)
	spProPovratIndUpdate - za edit podataka (nova)
	spTraziRoba - postoji (netaknuto)
	spTraziPartneri - postoji(Netaknuto)


	viPogoni - prepravljeno za potrebe testiranja vratiti na inicijalno

- povezao orgshemaid u propovratiid sa orgshemaid u tablici orgshema

	 -->