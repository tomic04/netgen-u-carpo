<root>
	<!--
  Komentari:
  09.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmDopStatusi" caption="Statusi obračuna doprinosa za {parent.#txtPrezime} {parent.#txtIme}" width="850" height="350" >
		<event type="load">
			<action type="control populate" value="#grdDopStatusi"/>		
			<action type="control disable" value="#btnIzmjena,btnBrisanje" if="#grdDopStatusi.rowcount==0"/>

		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<group cols="1" rows="1" groupbordervisible="true" col="1" row="1" spacing="2,2,2,1">
					<item row="1" col="1" highlight="false">
						<grid name="grdDopStatusi" key="HRKadroviDopStatusiId" dataname="~dtDopStatusi" fieldsmartspaces="false" multiselect="true" savelayout="true" showgrouppanel="false" bestfitonrefresh="true">
							<fields inherited="true">
							</fields>
							<event type="doubleclick">
								<action type="form open" value="frmUnosIzmjenaDopStatusi">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviDopStatusiId" value="#grdDopStatusi.@HRKadroviDopStatusiId" />	
									<parameter name="Caption" value="Izmjena doprinosa za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdDopStatusi"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>
						</grid>
					</item>
				</group>
				<group cols="8" rows="1" groupbordervisible="true" col="1" row="2" spacing="2,2,1,2">
					<item row="1" col="1" highlight="false" height="40">
						<button name="btnUnos" caption="Unos" function="UNOS_DOPSTATUSI"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaDopStatusi"> 
									<parameter name="Caption" value="Unos doprinosa za {parent.#txtPrezime} {parent.#txtIme}"/>		
									<parameter name="HRKadroviDopStatusiId" value="0"/>   
									<parameter name="HRKadroviId" value="$HRKadroviId" />	

								</action>  
								<action type="control populate keepfocus" value="#grdDopStatusi"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>  
						</button>
					</item>
					<item row="1" col="2" highlight="false" height="40" >
						<button name="btnIzmjena" caption="Izmjena" function="IZMJENA_DOPSTATUSI"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaDopStatusi">  
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviDopStatusiId" value="#grdDopStatusi.@HRKadroviDopStatusiId" />	
									<parameter name="Caption" value="Izmjena doprinosa za {parent.#txtPrezime} {parent.#txtIme}"/>										
								</action>  
								<action type="control populate keepfocus" value="#grdDopStatusi"/>
								<action type="control populate" value="parent.#grdPodaci"/>		
							</event>  
						</button>
					</item>
					<item row="1" col="3" highlight="false" height="40">
						<button name="btnBrisanje" caption="Brisanje" function="BRISANJE_DOPSTATUSI"> 
							<event type="click">   
								<action type="confirm" value="Jeste li sigurni da želite obrisati izabrani zapis?">
									<action type="datarun nonquery" value="~dtBrisanjeDopStatusi">

									</action>
								</action>
								<action type="control populate" value="#grdDopStatusi,parent.#grdPodaci"></action>    
								<action type="control disable" value="#btnIzmjena,btnBrisanje" if="#grdDopStatusi.rowcount==0"/>
							</event>  
						</button>
					</item>

					<item row="1" col="4" colspan="4" highlight="false" height="40"/>
					<item row="1" col="8" highlight="false" height="40">
						<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
			</group>

		</layout>
		<datalist>
			<data command="spHRManagerMaster_Podaci_DopStatusi_CP" name="dtDopStatusi">
				<parameter name="@action" value="grid_dopstatusi" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_DopStatusi_CP" name="dtBrisanjeDopStatusi">
				<parameter name="@action" value="brisanje"/>
				<parameter name="@HRKadroviDopStatusiId" value="#grdDopStatusi.@HRKadroviDopStatusiId"/>
			</data>
		</datalist>
	</form>

	<!-- FORMA ZA UNOS,IZMJENU-->
	<form name="frmUnosIzmjenaDopStatusi" caption="$Caption" width="380" height="100" fixedsize="true">
				<event type="init">
<action type="datarun reader" value="~dtDopStatusi" if="$HRKadroviDopStatusiId!=0" />
		</event>
		<event type="shown">
		</event>
		<layout>
		<group cols="2" rows="2" groupbordervisible="true">
             <item row="1" col="1" caption="Status za obračun doprinosa:" highlight="false" colspan="2">
				<comboedit name="cmbStatusObracuna" required="true" valuefield="HRDopStatusiId" displayfield="Naziv" dataname="~dtHRDopStatusi" datavalue="~dtDopStatusi.@HRDopStatusiId"/>
			</item>
			<item row="2" col="1" caption="Datum:" highlight="false" >
					<dateedit name="dtDatum" value="now" allownull="false" datavalue="~dtDopStatusi.@DatumOd">
					</dateedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$HRKadroviDopStatusiId==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#grdDopStatusi">
									<action type="control focus" value="parent.#grdDopStatusi">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
							<action type="control enable" value="parent.#btnIzmjena,parent.#btnBrisanje"/>
						</action>
						<action if="$indGreske==0">
							<action type="message" value="Uspješno spremljeno!"/>
							<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
							<action type="variable value" value="global.$RefreshajMaster">
								<parameter value="1" type="int"/>
							</action>
							<action type="form close" />
						</action>
						<action if="$HRKadroviDopStatusiId!=0">
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
		<data command="spHRHelp" name="dtHRDopStatusi">
				<parameter name="@action" value="hrdopstatusi"/>
			</data>
		<data command="spHRManagerMaster_Podaci_DopStatusi_CP" name="dtDopStatusi">
				<parameter name="@action" value="getDopStatusi" />
				<parameter name="@HRKadroviDopStatusiId" value="$HRKadroviDopStatusiId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_DopStatusi_CP" name="dtUnos">
				<parameter name="@action" value="unos"/>
				<parameter name="@HRKadroviDopStatusiId.output.int" variablename="noviID"></parameter>
				<parameter name="@hrkadroviid"  value="$HRKadroviId" />
				<parameter name="@OperateriId"  value="@@operateriid" />
				<parameter name="@HRDopStatusiId"  value="#cmbStatusObracuna" />
				<parameter name="@Datumod"  value="#dtDatum" />
				<parameter name="@indGreske.output.int"/>			
			</data>
			<data  command="spHRManagerMaster_Podaci_DopStatusi_CP" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@HRKadroviDopStatusiId" value="$HRKadroviDopStatusiId"/>
				<parameter name="@hrkadroviid"  value="$HRKadroviId" />
				<parameter name="@OperateriId"  value="@@operateriid" />
				<parameter name="@HRDopStatusiId"  value="#cmbStatusObracuna" />
				<parameter name="@Datumod"  value="#dtDatum" />
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>
</root>