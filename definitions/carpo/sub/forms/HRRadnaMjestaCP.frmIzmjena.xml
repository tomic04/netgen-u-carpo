<root>
	<!--
  Komentari:
  05.10.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmIzmjena" caption="$Caption" width="860" height="810" >
		<event type="init">
			<action type="datarun reader" value="~getRadnoMjesto" if="$HRRadnaMjestaId!=0" />

		</event>
		<event type="load">
			<action type="control populate" value="#grdOpis"/>
			<action type="control populate" value="#grdSpreme"/>
			<action type="control populate" value="#grdVjestine"/>
			<action type="control populate" value="#grdKlase"/>
			<action type="control enable" value="#btnIzmjenaSpreme,#btnBrisanjeSpreme" if="#grdSpreme.rowcount!=0"/>
			<action type="control disable" value="#btnIzmjenaSpreme,#btnBrisanjeSpreme" else=""/>
			<action type="control enable" value="#btnBrisanjeVjestine,#btnIzmjenaVjestine" if="#grdVjestine.rowcount!=0"/>
			<action type="control disable" value="#btnBrisanjeVjestine,#btnIzmjenaVjestine" else=""/>
			<action type="control enable" value="#btnBrisanjeKlase" if="#grdKlase.rowcount!=0"/>
			<action type="control disable" value="#btnBrisanjeKlase" else=""/>
		</event>
		<event type="shown">
			<action if="$Tip=='Izmjena'">
				<action type="control value" value="#srcOrgJedinica">
					<parameter text="~getRadnoMjesto.@OrgJedinica" value="~getRadnoMjesto.@OrgShemaId" />
				</action>
				<action type="control value" value="#srcNadredjenoRM">
					<parameter text="~getRadnoMjesto.@NadredjenoRM" value="~getRadnoMjesto.@NadredenoRMId" />
				</action>
			</action>
		</event>
		<layout autotaborder="false">
			<group rows="5" cols="1" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="100%"/>
				</columnsdefinition>
				<group col="1" row="1" cols="4" rows="2" groupbordervisible="true" spacing="2,1,2,2">
					<item row="1" col="1" caption="Naziv:" highlight="false" colspan="2">
						<textedit name="txtNaziv" allownull="false"  datavalue="~getRadnoMjesto.@Naziv" tabindex="1" required="true"/>
					</item>
					<item row="1" col="3" caption="Oznaka:" highlight="false" >
						<textedit name="txtOznaka" datavalue="~getRadnoMjesto.@oznaka" tabindex="2" />
					</item>
					<item row="1" col="4" highlight="false" padding="18">
						<checkedit name="chckUmirovljeno"  caption="Umirovljeno" datavalue="~getRadnoMjesto.@Umirovljeno"  tabindex="3"/>
					</item>
					<item row="2" col="1" caption="Organizacijska jedinica:" colspan="2" highlight="false">
						<searchedit name="srcOrgJedinica" dataname="~dtOrgJedinica" fieldvalue="orgshemaid" fieldtext="Naziv" tabindex="4" >
						</searchedit>
					</item>
					<item row="2" col="3" caption="Nadređeno radno mjesto:" colspan="2" highlight="false">
						<searchedit name="srcNadredjenoRM" dataname="~dtNadredjenoRM" fieldvalue="hrradnamjestaid" fieldtext="Naziv" tabindex="5" >
						</searchedit>
					</item>
				</group>

				<group col="1" row="2" cols="4" rows="1" groupbordervisible="true" spacing="1,1,2,2">
					<item row="1" col="1" caption="Grupa poslova:" highlight="false" >
						<textedit name="txtGrupaPoslova" allownull="false"  datavalue="~getRadnoMjesto.@GrupaPoslova" tabindex="6"/>
					</item>
					<item row="1" col="2" caption="Broj izvršitelja prema sistematizaciji:" highlight="false" >
						<textedit name="txtBrojIzvrsitelja" datavalue="~getRadnoMjesto.@BrojIzvrsitelja" format="n0" value="0" tabindex="7" />
					</item>
					<item row="1" col="3" caption="Koeficijent:" highlight="false">
						<textedit name="txtKoeficijent" datavalue="~getRadnoMjesto.@Koeficijent" format="n3" value="0" tabindex="8" />
					</item>
					<item row="1" col="4" caption="Osnovica:" highlight="false">
						<textedit name="txtOsnovica" datavalue="~getRadnoMjesto.@Osnovica" format="n2" value="0" tabindex="9" />
					</item>
				</group>

				<group col="1" row="3" cols="4" rows="3" caption="Zahtjevi" groupbordervisible="true" spacing="1,1,2,2">
					<item row="1" col="1" highlight="false" >
						<checkedit name="chckSanitarna" caption="Sanitarna knjižica" datavalue="~getRadnoMjesto.@SanitarnaKnjizica" tabindex="10"/>
					</item>
					<item row="1" col="2" highlight="false">
						<checkedit name="chckZNR" caption="Ispit zaštite na radu" datavalue="~getRadnoMjesto.@IspitZNR" tabindex="11"/>
					</item>
					<item row="1" col="3" highlight="false">
						<checkedit name="chckClanUprave" caption="Član uprave" datavalue="~getRadnoMjesto.@ClanUprave" tabindex="12"/>
					</item>
					<item row="2" col="1" highlight="false" >
						<checkedit name="chckHigijenski" caption="Higijenski minimum" datavalue="~getRadnoMjesto.@HigijenskiMinimum" tabindex="13"/>
					</item>
					<item row="2" col="2" highlight="false">
						<checkedit name="chckTjeziUvjetRada" caption="Teži uvjeti rada" datavalue="~getRadnoMjesto.@TeziUvjetiRada" tabindex="14"/>
					</item>
					<item row="2" col="3" highlight="false">
						<checkedit name="chckClanNadzora" caption="Član nadzornog odbora" datavalue="~getRadnoMjesto.@ClanNadzornogOdbora" tabindex="15"/>
					</item>
					<item row="3" col="1" highlight="false">
						<checkedit name="chckLjecnicki" caption="Lječnički pregled" datavalue="~getRadnoMjesto.@LjecnickiPregled" tabindex="16"/>
					</item>
					<item row="3" col="2" highlight="false">
						<checkedit name="chckStetniUtjecaji" caption="Štetni utjecaji" datavalue="~getRadnoMjesto.@StetniUtjecaji" tabindex="17"/>
					</item>
					<item row="3" col="3" highlight="false">
						<checkedit name="chckPoslovi" caption="Poslovi na kojima radnik može raditi samo nakon prethodnog i redovitog utvrđivanja radne sposobnosti" datavalue="~getRadnoMjesto.@IndRadSpos" tabindex="18"/>
					</item>
				</group>
				<group col="1" row="4" cols="4" rows="1" groupbordervisible="true" spacing="1,1,2,2">	
					<item row="1" col="1" highlight="false" caption="Staž osiguranja s povećanim trajanjem:" >
						<textedit name="txtStazPovecanje" format="n0" value="0" tabindex="19" datavalue="~getRadnoMjesto.@Staz" />
					</item>
					<item row="1" col="2" highlight="false" caption="Kadrovski dodatak (%):" >
						<textedit name="txtKadrovskiDodatak" format="n2" value="0" tabindex="20" datavalue="~getRadnoMjesto.@KadDod"/>
					</item>
					<item row="1" col="3" colspan="2" highlight="false"/>
				</group>
				<tabs col="1" row="5" >
					<group col="1" row="1" cols="4" rows="7" caption="Opis poslova" groupbordervisible="true" >
						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
							<grid  name="grdOpis" key="HRRadnaMjestaId" dataname="~dtOpis"   fieldsmartspaces="false" showgrouppanel="false" bestfitonrefresh="true">

								<fields inherited="true">
									<field name="Memo" caption="Opis posla" />
									<!-- editable="true" rowautoheight="true" cellstayonenter="true" minwidth="770"/> -->
								</fields>	
								<event type="doubleclick">   
									<action type="form open" value="frmOpis">  
										<parameter name="Caption" value="Opis poslova za radno mjesto {#txtNaziv}"/> 	
										<parameter name="HRRadnaMjestaId" value="#grdOpis.@HRRadnaMjestaId" />										
									</action>      
								</event>  								
						
						 <!-- editabilne ćelije -->
                        <!-- <event type="cellvaluechanged"> -->
                            <!-- <action type="datarun reader" value="~dtUnosOpisa"> -->
                                <!-- <action if="$indGreske==0"> -->
                                    <!-- <action type="control populate keepfocus" value="#grdOpis" /> -->
                                    <!-- <action type="message" value="Uspješno spremljeno!" /> -->
                                <!-- </action> -->
                                <!-- <action else=""> -->
                                    <!-- <action type="control refreshvalue" value="#grdOpis"/> -->
                                <!-- </action> -->

                            <!-- </action> -->

                        <!-- </event> -->
							</grid>							
						</item>
						<item row="7" col="1" highlight="false" height="40">
							<button name="btnUnos" caption="Unos" > 
								<event type="click">   
									<action type="form open" value="frmOpis">  
										<parameter name="Caption" value="Opis poslova za radno mjesto {#txtNaziv}"/> 	
										<parameter name="HRRadnaMjestaId" value="#grdOpis.@HRRadnaMjestaId" />										
									</action>      
								</event>  
							</button>
						</item>


					</group>
					<group col="1" row="1" cols="4" rows="7" caption="Spreme" groupbordervisible="true"  >

						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
							<grid  name="grdSpreme" key="HRRadnaMjestaSpremeId" dataname="~dtSpreme" savelayout="true" multiselect="true"  bestfitonrefresh="true" fieldsmartspaces="false" showgrouppanel="false"  >
								<event type="doubleclick">   
									<action type="form open" value="frmSpreme">  
										<parameter name="Tip" value="Izmjena"/>
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />
										<parameter name="HRRadnaMjestaSpremeId" value="#grdSpreme.@HRRadnaMjestaSpremeId" />	
										<parameter name="Caption" value="Izmjena spreme"/>										
									</action>  
									<action type="control populate keepfocus" value="#grdSpreme"/>									
								</event> 
							</grid>

						</item>
						<item row="7" col="1" highlight="false" height="40">
							<button name="btnUnos" caption="Unos"> 
								<event type="click">   
									<action type="form open" value="frmSpreme"> 
										<parameter name="Caption" value="Unos spreme"/>		
										<parameter name="HRRadnaMjestaSpremeId" value="0"/>   
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />	

									</action>  
									<action type="control populate keepfocus" value="#grdSpreme"/>									
								</event>  
							</button>
						</item>
						<item row="7" col="2" highlight="false" height="40" >
							<button name="btnIzmjenaSpreme" caption="Izmjena"> 
								<event type="click">   
									<action type="form open" value="frmSpreme">  
										<parameter name="Tip" value="Izmjena"/>
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />
										<parameter name="HRRadnaMjestaSpremeId" value="#grdSpreme.@HRRadnaMjestaSpremeId" />	
										<parameter name="Caption" value="Izmjena spreme"/>										
									</action>  
									<action type="control populate keepfocus" value="#grdSpreme"/>									
								</event>  
							</button>
						</item>
						<item row="7" col="3" highlight="false" height="40">
							<button name="btnBrisanjeSpreme" caption="Brisanje"> 
								<event type="click">   
									<action type="confirm" value="Jeste li sigurni da želite obrisati {#grdSpreme.@Sprema}?">
										<action type="datarun nonquery" value="~dtBrisanjeSpreme">

										</action>
									</action>
									<action type="control populate" value="#grdSpreme"></action>    
									<action type="control disable" value="#btnIzmjenaSpreme,btnBrisanjeSpreme" if="#grdSpreme==null"/>
								</event>  
							</button>
						</item>


					</group>
					<group col="1" row="1" cols="4" rows="7" caption="Vještine" groupbordervisible="true" >

						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
							<grid  name="grdVjestine" key="HRRadnaMjestaVjestineId" dataname="dtVjestine" savelayout="true" multiselect="true" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
							<event type="doubleclick">   
									<action type="form open" value="frmVjestine"> 
										<parameter name="Tip" value="Izmjena"/>
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />
										<parameter name="HRRadnaMjestaVjestineId" value="#grdVjestine.@HRRadnaMjestaVjestineId" />
										<parameter name="Caption" value="Izmjena vještine"/>									
									</action>  
									<action type="control populate keepfocus" value="#grdVjestine"/>	
								</event>
							</grid>			
						</item>
						<item row="7" col="1" highlight="false" height="40">
							<button name="btnUnos" caption="Unos"> 
								<event type="click">   
									<action type="form open" value="frmVjestine"> 
										<parameter name="Caption" value="Unos vještine"/>
										<parameter name="HRRadnaMjestaVjestineId" value="0"/>   
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />											
									</action>     
								</event>  
							</button>
						</item>
						<item row="7" col="2" highlight="false" height="40" >
							<button name="btnIzmjenaVjestine" caption="Izmjena"> 
								<event type="click">   
									<action type="form open" value="frmVjestine"> 
										<parameter name="Tip" value="Izmjena"/>
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />
										<parameter name="HRRadnaMjestaVjestineId" value="#grdVjestine.@HRRadnaMjestaVjestineId" />
										<parameter name="Caption" value="Izmjena vještine"/>									
									</action>  
									<action type="control populate keepfocus" value="#grdVjestine"/>	
								</event>  
							</button>
						</item>
						<item row="7" col="3" highlight="false" height="40">
							<button name="btnBrisanjeVjestine" caption="Brisanje"> 
								<event type="click">   
									<action type="confirm" value="Jeste li sigurni da želite obrisati {#grdVjestine.@Naziv}?">
										<action type="datarun nonquery" value="dtBrisanjeVjestine">

										</action>
									</action>
									<action type="control populate" value="#grdVjestine"></action>    
									<action type="control disable" value="#btnBrisanjeVjestine,btnIzmjenaVjestine" if="#grdVjestine.rowcount==0"/>   
								</event>  
							</button>
						</item>


					</group>
					<group col="1" row="1" cols="4" rows="7" caption="Klase" groupbordervisible="true" >

						<item  row="1" col="1" highlight="false" colspan="4" rowspan="6">
							<grid  name="grdKlase" key="HRRadnaMjestaKlaseRMId" dataname="dtKlase" fieldsmartspaces="false" savelayout="true" multiselect="true"  bestfitonrefresh="true" showgrouppanel="false" />			
						</item>
						<item row="7" col="1" highlight="false" height="40">
							<button name="btnUnos" caption="Unos"> 
								<event type="click">   
									<action type="form open" value="frmKlase">  
										<parameter name="Caption" value="Unos klase"/>	
										<parameter name="HRRadnaMjestaKlaseRMId" value="0"/>   
										<parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" />											
									</action>      
								</event>  
							</button>
						</item>
						<item row="7" col="2" highlight="false"  height="40">
							<button name="btnBrisanjeKlase" caption="Brisanje"> 
								<event type="click">   
									<action type="confirm" value="Jeste li sigurni da želite obrisati {#grdKlase.@Naziv}?">
										<action type="datarun nonquery" value="dtBrisanjeKlase">

										</action>
									</action>
									<action type="control populate" value="#grdKlase"></action>    
									<action type="control disable" value="#btnBrisanjeKlase" if="#grdKlase.rowcount==0"/>        
								</event>  
							</button>
						</item>
						<!-- <item row="7" col="3" highlight="false" height="40"> -->
							<!-- <button name="btnBrisanjeKlase" caption="Obriši">  -->
								<!-- <event type="click">    -->
									<!-- <action type="confirm" value="Da li ste sigurni da želite obrisati {#grdKlase.@Naziv}?"> -->
										<!-- <action type="datarun nonquery" value="dtBrisanjeKlase"> -->

										<!-- </action> -->
									<!-- </action> -->
									<!-- <action type="control populate" value="#grdKlase"></action>     -->
									<!-- <action type="control disable" value="#btnBrisanjeKlase,btnIzmjenaKlase" if="#grdKlase.rowcount==0"/>         -->
								<!-- </event>   -->
							<!-- </button> -->
						<!-- </item> -->
						<!-- <item row="7" col="2" highlight="false"  height="40"> -->
							<!-- <button name="btnIzmjenaKlase" caption="Izmjena">  -->
								<!-- <event type="click">    -->
									<!-- <action type="form open" value="frmKlase"> -->
										<!-- <parameter name="Tip" value="Izmjena"/> -->
										<!-- <parameter name="HRRadnaMjestaId" value="$HRRadnaMjestaId" /> -->
										<!-- <parameter name="HRRadnaMjestaKlaseRMId" value="#grdKlase.@HRRadnaMjestaKlaseRMId" />									 -->
										<!-- <parameter name="Caption" value="Izmjena klase"/>										 -->
									<!-- </action>     -->
									<!-- <action type="control populate keepfocus" value="#grdKlase"/>										 -->
								<!-- </event>   -->
							<!-- </button> -->
						<!-- </item> -->


					</group>
				</tabs>

			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$HRRadnaMjestaId!=0">
							<action type="datarun reader" value="~dtIzmjenaRM"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<action type="form close"/>
							</action>
						</action>

					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
		
			<data command="spHRHelp" name="dtOrgJedinica">
				<parameter name="@action" value="orgshema_nivo" />
				<parameter name="@tekst" value="#srcOrgJedinica.text" />
			</data>
			<data command="spHRHelp" name="dtNadredjenoRM">
				<parameter name="@action" value="nadredenorm" />
				<parameter name="@tekst" value="#srcNadredjenoRM.text" />
			</data>
			<data command="spHRRadnaMjestaQueryCP" name="getRadnoMjesto">
				<parameter name="@action" value="getRadnoMjesto" />
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId" />
			</data>
			<data command="spHRRadnaMjestaQueryCP" name="dtOpis">
				<parameter name="@Action" value="grdOpis"/>
				<parameter name="@OperateriId"  value="@@OperateriId" />
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId" />
			</data>
			<data command="spHRRadnaMjestaQueryCP" name="dtSpreme">
				<parameter name="@Action" value="grdSpreme"/>
				<parameter name="@OperateriId"  value="@@OperateriId" />
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId" />
			</data>
			<data command="spHRRadnaMjestaAzurCP" name="dtBrisanjeSpreme">
				<parameter name="@Action" value="BrisanjeSpreme" type="string"/>
				<parameter name="@HRRadnaMjestaSpremeId" value="#grdSpreme.@HRRadnaMjestaSpremeId"/> 
			</data>
			<data command="spHRRadnaMjestaQueryCP" name="dtVjestine">
				<parameter name="@Action" value="grdVjestine"/>
				<parameter name="@OperateriId"  value="@@OperateriId" />
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId" />
			</data>
			<data command="spHRRadnaMjestaAzurCP" name="dtBrisanjeVjestine">
				<parameter name="@Action" value="BrisanjeVjestine" type="string"/>
				<parameter name="@HRRadnaMjestaVjestineId" value="#grdVjestine.@HRRadnaMjestaVjestineId"/> 
			</data>
			<data command="spHRRadnaMjestaQueryCP" name="dtKlase">
				<parameter name="@Action" value="grdKlase"/>
				<parameter name="@OperateriId"  value="@@OperateriId" />
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId" />
			</data>
			<data command="spHRRadnaMjestaAzurCP" name="dtBrisanjeKlase">
				<parameter name="@Action" value="BrisanjeKlase" type="string"/>
				<parameter name="@HRRadnaMjestaKlaseRMId" value="#grdKlase.@HRRadnaMjestaKlaseRMId"/> 
			</data>
			<data  command="spHRRadnaMjestaAzurCP" name="dtIzmjenaRM">
				<parameter name="@action" value="IzmjenaRM"/>
				<parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@OrgShemaId" value="#srcOrgJedinica"/>
				<parameter name="@NadredenoRMId" value="#srcNadredjenoRM"/>
				<parameter name="@Koeficijent" value="#txtKoeficijent"/>
				<parameter name="@BrojIzvrsitelja" value="#txtBrojIzvrsitelja"/>
				<parameter name="@GrupaPoslova" value="#txtGrupaPoslova"/>
				<parameter name="@Osnovica" value="#txtOsnovica"/>
				<parameter name="@PotrebnaSK" value="#chckSanitarna"/>
				<parameter name="@PotrebanMinimum" value="#chckHigijenski"/>
				<parameter name="@PotrebanPregled" value="#chckLjecnicki"/>
				<parameter name="@PotrebanIspitZNR" value="#chckZNR"/>
				<parameter name="@TeziUvjetiRada" value="#chckTjeziUvjetRada"/>
				<parameter name="@StetniUtjecaji" value="#chckStetniUtjecaji"/>
				<parameter name="@ClanUprave" value="#chckClanUprave"/>
				<parameter name="@ClanNadzornogOdbora" value="#chckClanNadzora"/>
				<parameter name="@Oznaka" value="#txtOznaka"/>
				<parameter name="@Staz" value="#txtStazPovecanje"/>
				<parameter name="@IndRadSpos" value="#chckPoslovi"/>
				<parameter name="@KadDod" value="#txtKadrovskiDodatak"/>
				<parameter name="@Umirovljeno" value="#chckUmirovljeno"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@indGreske.output.int"/>
			</data>
