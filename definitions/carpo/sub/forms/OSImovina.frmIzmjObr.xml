<root version =" 1.0">

  <!--******************************************FILTER - IZMJENA BORAČUNSKIH PODATAKA****************************************-->

  <form name="frmIzmjObr" caption="$caption" fixedsize="false" width="1250" height="500" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtIzmjena" />
      <action type="datarun reader" value="~dtIzmjObr" />
    </event>
    <event type="close">
      <action type="datarun reader" value="~dtBrisanje" />
    </event>
    <layout >
      <group cols="1" rows="2" groupbordervisible="false">
        <group rows="2" cols="6" col="1" row="1" spacing="2,2,2,1">
          <item caption="Grupa:" row="1" col="1" colspan="3" highlight="false">
            <comboedit name="cmbGrupa" valuefield="OSGrupeId" displayfield="NazivGrupe" dataname="~dtGrupa" allownull="false">
              <!--na promjenu grupe puni formu-->
              <event type="valuechanged">
                <action type="datarun reader" value="~dtPodaciZaGrupu"  />
                <action type="control value" value="#txtRedovna"  >
                  <parameter value="~dtPodaciZaGrupu.@Redovna" />
                </action>
                <action type="control value" value="#txtUbrzana"  >
                  <parameter value="~dtPodaciZaGrupu.@Ubrzana" />
                </action>
                <action type="control value" value="#txtJednokratna"  >
                  <parameter value="~dtPodaciZaGrupu.@Jednokratna" />
                </action>
                <action type="control value" value="#txtUmanjena"  >
                  <parameter value="~dtPodaciZaGrupu.@Umanjena" />
                </action>
                <action type="control value" value="#srcNabava"  >
                  <parameter value="~dtPodaciZaGrupu.@KntNabaveId" text="~dtPodaciZaGrupu.@KontoN"/>
                </action>
                <action type="control value" value="#srcPriprema"  >
                  <parameter value="~dtPodaciZaGrupu.@KntPripremeId" text="~dtPodaciZaGrupu.@KontoP"/>
                </action>
                <action type="control value" value="#srcIspravak"  >
                  <parameter value="~dtPodaciZaGrupu.@KntIspravkaId" text="~dtPodaciZaGrupu.@KontoI"/>
                </action>
                <action type="control value" value="#srcTrosak"  >
                  <parameter value="~dtPodaciZaGrupu.@KntTroskaId" text="~dtPodaciZaGrupu.@KontoT"/>
                </action>
                <action type="variable value">
                  <parameter name="VarPromjenaGrupe" value="1" type="int"/>
                </action>
              </event>
            </comboedit>
          </item>
          <item caption="Tip stope:" row="1" col="4" highlight="false">
            <comboedit name="cmbStopaTip"  valuefield="StopaTip" displayfield="Naziv" dataname="~dtStopaTip" allownull="false"/>
          </item>
          <group row="1" col="5" rows="1" cols="4" caption="Stope amortizacije"  groupbordervisible="false" colspan="2">
            <columnsdefinition>
              <column position="1" size="25%"></column>
              <column position="2" size="25%"></column>
              <column position="3" size="25%"></column>
              <column position="4" size="25%"></column>
            </columnsdefinition>
            <item caption="Redovna:"  row="1" col="1" highlight="false" >
              <textedit name="txtRedovna" format="n2" valuefield="StopaRedovna" nulltext="0,00" textposition="left"/>
            </item>
            <item caption="Ubrzana:"  row="1" col="2" highlight="false" >
              <textedit name="txtUbrzana" format="n2" valuefield="StopaUbrzana" nulltext="0,00" textposition="left"/>
            </item>
            <item caption="Jednokratna:"  row="1" col="3" highlight="false" >
              <textedit name="txtJednokratna" format="n2" valuefield="StopaJednokratna" nulltext="0,00" textposition="left"/>
            </item>
            <item caption="Umanjena:"  row="1" col="4" highlight="false" >
              <textedit name="txtUmanjena" format="n2" valuefield="StopaUmanjena" nulltext="0,00" textposition="left"/>
            </item>
          </group>
          <!--tražilice konta-->
          <group row="2" col="1" cols="4" rows="1" caption="Konta" groupbordervisible="false" colspan="5">
            <item caption="Konto nabave:" col="1" row="1" highlight="false" >
              <searchedit name="srcNabava" fieldvalue="KntNabaveId" fieldtext="KontoN" dataname="dtNabava" />
            </item>
            <item caption="Konto pripreme:" col="2" row="1" highlight="false" >
              <searchedit name="srcPriprema" fieldvalue="KntPripremeId" fieldtext="KontoP" dataname="dtPriprema" />
            </item>
            <item caption="Konto ispravka:" col="3" row="1" highlight="false" >
              <searchedit name="srcIspravak" fieldvalue="KntIspravkaId" fieldtext="KontoI" dataname="dtIspravak" />
            </item>
            <item caption="Konto troška:" col="4" row="1" highlight="false" >
              <searchedit name="srcTrosak" fieldvalue="KntTroskaId" fieldtext="KontoT" dataname="dtTrosak" />
            </item>
          </group>
          <group rows="1" cols="2" col="6" row="2"  groupbordervisible="false">
            <columnsdefinition>
              <column pos="1" size="50%"></column>
              <column pos="2" size="50%"></column>
            </columnsdefinition>
            <item caption="Datum:" col="1" row="1" highlight="false" >
              <dateedit name="datDatum" value="now" />
            </item>
            <item caption="" col="2" row="1" highlight="false" >
              <button name="btnSpremi"  caption="Spremi" >
                <event type="click">
                  <action type="datarun reader" value="~dtKontrolaBlokade">
                    <action type="message" value="~dtKontrolaBlokade.@Poruka" if="~dtKontrolaBlokade.@IndGreska==1" />
                    <action type="control focus" value="#datDatum"/>
                  </action>
                  <action if="~dtKontrolaBlokade.@IndGreska==0">
                    <action type="datarun nonquery" value="~dtIzmjenaObr" />
                    <action type="control populate" value="#grdIzmjObr" />
                    <action type="control refreshvalue" value="#cmbGrupa,#cmbStopaTip,#txtRedovna,#txtUbrzana,#txtJednokratna,#txtUmanjena,#srcNabava,#srcPriprema,#srcIspravak,#srcTrosak"/>
                    <action type="control focus" value="#cmbGrupa"/>
                  </action>
                </event>
              </button>
            </item>
          </group>
        </group>
        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,2" >
          <item col="1" row="1">
            <grid caption="" name="grdIzmjObr" dataname="dtIzmjObr" fieldsmartspaces="false" autopopulate="true" key="OSImovinaFilterId" keyfield="OSImovinaFilterId" multiselect="true" showcheckboxes="true">
              <fields inherited="true">
                <field name="AmGrupa" caption="Amortizacijska grupa"  />
                <field name="NovaAmGrupa" caption="Nova amortizacijska grupa"  />
                <field name="Stopa" caption="Tip stope"  />
                <field name="NovaStopa" caption="Novi tip stope"  />
                <field name="Redovna" caption="Redovna stopa"  />
                <field name="NovaRedovna" caption="Nova redovna stopa"  />
                <field name="Ubrzana" caption="Ubrzana stopa"  />
                <field name="NovaUbrzana" caption="Nova ubrzana stopa"  />
                <field name="Jednokratna" caption="Jednokratna stopa"  />
                <field name="NovaJednokratna" caption="Nova jednokratna stopa"  />
                <field name="Umanjena" caption="Umanjena stopa"  />
                <field name="NovaUmanjena" caption="Nova umanjena stopa"  />
                <field name="KontoN" caption="Konto nabave"  />
                <field name="NoviKontoN" caption="Novi konto nabave"  />
                <field name="KontoP" caption="Konto pripreme"  />
                <field name="NoviKontoP" caption="Novi konto pripreme"  />
                <field name="KontoI" caption="Konto ispravka"  />
                <field name="NoviKontoI" caption="Novi konto ispravka"  />
                <field name="KontoT" caption="Konto troška"  />
                <field name="NoviKontoT" caption="Novi konto troška"  />
              </fields>
            </grid>
          </item>
        </group>

      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnIzmjena"  caption="Izmijeni OP" >
          <event type="click">
            <action type="datarun nonquery" value="~dtIzmjenaSpremi" />
            <action type="control populate" value="#grdIzmjObr" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSFilter_AzurCP" name="dtKontrolaBlokade">
        <parameter name="@Action" value="Kontrola_blokade"/>
        <parameter name="@Datum" value="#datDatum" />
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtPodaciZaGrupu">
        <parameter name="@Action" value="Podaci_grupa"/>
        <parameter name="@OSGrupeId" value="#cmbGrupa.@OSGrupeId"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtGrupa">
        <parameter name="@Action" value="Amortizacijska_grupa"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtStopaTip">
        <parameter name="@Action" value="Tip_stope"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtNabava">
        <parameter name="@Action" value="Konto_nabave"/>
        <parameter name="@Tekst" value="#srcNabava.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtPriprema">
        <parameter name="@Action" value="Konto_pripreme"/>
        <parameter name="@Tekst" value="#srcPriprema.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtIspravak">
        <parameter name="@Action" value="Konto_ispravka"/>
        <parameter name="@Tekst" value="#srcIspravak.text"/>
      </data>
      <data command="spOSImovinaOP_HelpCP" name="dtTrosak">
        <parameter name="@Action" value="Konto_troska"/>
        <parameter name="@Tekst" value="#srcTrosak.text"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjena">
        <parameter name="@action" value="ObracunskiIzmjena_Spremi"/>
        <parameter name="@SelectedIds" value="$SelectedIds"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_HelpCP" name="dtIzmjObr">
        <parameter name="@Action" value="Grid_ObracunskiIzmjena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtBrisanje">
        <parameter name="@action" value="Izlaz_Brisanje"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjenaObr">
        <parameter name="@action" value="ObracunskiIzmjena_Podaci"/>
        <parameter name="@OSGrupeId" value="#cmbGrupa"/>
        <parameter name="@StopaTip" value="#cmbStopaTip"/>
        <parameter name="@StopaRedovna" value="#txtRedovna"/>
        <parameter name="@StopaUbrzana" value="#txtUbrzana"/>
        <parameter name="@StopaJednokratna" value="#txtJednokratna"/>
        <parameter name="@StopaUmanjena" value="#txtUmanjena"/>
        <parameter name="@KntNabaveId" value="#srcNabava"/>
        <parameter name="@KntPripremeId" value="#srcPriprema"/>
        <parameter name="@KntIspravkaId" value="#srcIspravak"/>
        <parameter name="@KntTroskaId" value="#srcTrosak"/>
        <parameter name="@SelectedIds" value="#grdIzmjObr.SelectedIds"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjenaSpremi">
        <parameter name="@action" value="Obracunski_filter"/>
        <parameter name="@SelectedIds" value="#grdIzmjObr.SelectedIds.OSImovinaId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
        <parameter name="@DatumDok" value="#datDatum"/>
      </data>
    </datalist>
  </form>

</root>

<!--******************************************KRAJ  FILTER - IZMJENA BORAČUNSKIH PODATAKA****************************************-->