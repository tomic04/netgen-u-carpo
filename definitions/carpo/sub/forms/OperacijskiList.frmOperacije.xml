<root>
	<form name="frmOperacije" caption="Operacije" width="320" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$PrnOprListDetId!=null" />
			<action type="datarun reader" value="~dtRbr" if="$PrnOprListDetId==null" />
			
			<action type="datarun scalar" value="~dtmaxlengthOPIS">
				<parameter name="maxlengthOPIS" value="~dtmaxlengthOPIS.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>
			<action type="datarun scalar" value="~dtmaxlengthMEMO">
				<parameter name="maxlengthMEMO" value="~dtmaxlengthMEMO.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>

		</event>
		<event type="load">
			<action type="variable value">
				<parameter name="Rbr" value="~dtRbr.@rbr" />
			</action>
			<action type="control value" value="#txtRedniBroj" if="$PrnOprListDetId==null">
				<parameter value="$Rbr"/>
			</action>
		</event>
		<event type="shown">
			<!-- <action type="control enable" value="#txtVrijemeRadaE" else=""/> if="#srcHRRadnaMjesta!=null" -->
			<!-- <action type="control enable" value="#txtVrijemeRadaS" else=""/>  if="#cteOsGrupe!=null" -->
			<action type="control disable" value="#txtVrijemeRadaE" if="#srcHRRadnaMjesta==null"/>
			<action type="control disable" value="#txtBrRadnika" if="#srcHRRadnaMjesta==null"/>
			<!-- <action type="control enable" value="#txtVrijemeRadaE" if="#srcHRRadnaMjesta!=null"/>  -->
			<action type="control disable" value="#txtVrijemeRadaS" if="#srcOsImovina==null"/>
			<action type="control disable" value="#txtAmort" if="#srcOsImovina==null"/>
			<action type="control disable" value="#txtStruja" if="#srcOsImovina==null"/>
			<!-- <action type="control enable" value="#txtVrijemeRadaS" if="#cteOsGrupe!=null"/> -->
			<action type="variable value" value="Oper">
				<parameter value="~dtget.@OOPOperacijeId"/>
			</action>
			<action type="variable value" value="TipOper">
				<parameter value="~dtget.@OOPTipOperacijeId"/>
			</action>
		</event>
		<layout textposition="top" >
			<group cols="2" rows="5" bordervisible="false">
				<group col="1" row="1" colspan="2" cols="5" rows="1"  bordervisible="false">
					<columnsdefinition>
						<column size="50" position="1"/>
						<column size="220" position="2"/>
						<column size="85" position="3"/>
						<column size="35" position="4"/>
					</columnsdefinition>
					<item caption="R.br." col="1" row="1">
						<textedit name="txtRedniBroj" datavalue="~dtGet.@RedniBroj" value="$rbr+1" tooltip="Redoslijed izvođenja operacije" required="true"/>
					</item>
					<item caption="Opis operacije" col="2" row="1"> <!-- value="false"  -->
						<textedit name="txtOpis" datavalue="~dtGet.@Opis" tooltip="Opis operacije" maxlength="$maxlengthOPIS"/>
					</item>
					<!-- <item col="3" row="1" caption="Vrijeme operacije:"> -->
					<!-- <textedit name="datDatumIsporuke" required="true" format="n2" value="0.00" > -->

					<!-- </textedit> -->
					<!-- </item> -->
					<!-- <group col="1" row="2" colspan="2" cols="2" rows="1" itemspadding="4" bordervisible="false"> -->
					<item caption="Ukupno vrijeme" col="3" row="1">
						<textedit name="txtUkupnoVrijeme" required="true" datavalue="~dtGet.@UkupnoVrijemeRada" tooltip="Trajanje operacije u obliku HH:mm:ss ili HHH:mm:ss" format="[0-9]?[0-9][0-9]:[0-5][0-9]:[0-5][0-9]" value="000:00:00" formattype="regex" nulltext="000:00:00"> <!--  formattype="varchar" format="[0-9]?[0-9][0-9]:[0-9][0-9]:[0-5][0-9]" value="000:00:00">  formattype="datetime" format="HH:mm:ss" value="00:00:00">  -->
							<event type="valuechanged" raiseonload="false">
								<action type="variable value" >
									<parameter name="txtUkupnoVrijeme" value="#txtUkupnoVrijeme" /> <!-- ako ćemo kontrolirati da broj nije manji od efektivnog i rada stroja -->
								</action>
							</event>
						</textedit>
					</item>
					<!-- <item caption=" " col="4" row="1" > -->
						<!-- <labeledit name="lblJM1" value="HHH:mm:ss"/>  fontsizedelta="1" fontbold="True" -->
					<!-- </item> -->
					<!-- </group> -->
				</group>
				<group col="1" row="2" colspan="2" cols="3" rows="2" bordervisible="false">
					<columnsdefinition>
						<column size="270" position="1" />
						<column size="80" position="2" />
						<column size="8" position="3" />
					</columnsdefinition>
				</group>
				<group caption="Detalj operacijskog lista" col="1" row="3" colspan="2" cols="3" rows="3" > <!-- bordervisible="false" -->
					<columnsdefinition>
						<column size="200" position="1" />
						<column size="70" position="2" />
						<column size="80" position="3" />
					</columnsdefinition>
					<group  col="1" row="1" colspan="3" cols="3" rows="1" bordervisible="false"> 
						<item caption="Operacija" fontbold="True" col="1" row="1" colspan="2" >
							<searchedit name="srcOperacija" fontbold="True" fieldtext="Operacije" fieldvalue="OOPOperacijeId" entermovenextcontrol="false" required="true"  datavalue="~dtGet.@OOPOperacijeId" datatext="~dtGet.@Operacije" dataname="global.~dtOOPOperacije">
								<event type="valuechanged">
									<action type="variable value" value="TipOper2">
										<parameter value="~dtTip.@OOPTipOperacijeId"/>
									</action>
								</event>
							</searchedit>
						</item>
						<!-- <item caption=" " col="3" row="1" colspan="2"> value="false"  --> 
							<!-- <labeledit name="lblTipOp" datavalue="$TipOper" fontsizedelta="1" fontbold="True" /> -->
						<!-- </item> -->
					</group>
					<group  col="1" row="2" colspan="3" cols="5" rows="2" bordervisible="false">
					<columnsdefinition>
						<column size="100" position="1" />
						<column size="100" position="2" />
						<column size="70" position="3" />
						<column size="85" position="4" />
						<column size="35" position="5" />
					</columnsdefinition>
						<item caption="Radno mjesto" fontbold="True" col="1" colspan="2" row="2" > <!-- width="150" -->
							<searchedit name="srcHRRadnaMjesta" fieldtext="RadnaMjesta" fieldvalue="HRRadnaMjestaID" entermovenextcontrol="false" datavalue="~dtGet.@HRRadnaMjestaId" datatext="~dtGet.@RadnaMjesta" dataname="global.~dtHRRadnaMjesta">
								<event type="valuechanged" raiseonload="false">
									<action type="control enable" value="#txtVrijemeRadaE" if="#srcHRRadnaMjesta!=null"/>
									<action type="control enable" value="#txtBrRadnika" if="#srcHRRadnaMjesta!=null"/>
									<action type="control disable" value="#txtVrijemeRadaE" if="#srcHRRadnaMjesta==null"/>
									<action type="control disable" value="#txtBrRadnika" if="#srcHRRadnaMjesta==null"/>
								</event>
							</searchedit>
						</item>
						<item caption="Broj radnika" col="3" row="2"  > 
							<textedit name="txtBrRadnika" datavalue="~dtGet.@BrRadnika" tooltip="Ukupan broj radnika za obavljanje operacije" value="0"/>
						</item>
						<item caption="Trajanje rada" col="4" row="2">
							<textedit name="txtVrijemeRadaE" datavalue="~dtGet.@VrijemeRadaEfektivno" tooltip="Efektivno vrijeme trajanja rada jednog radnika na odabranoj operaciji u obliku HH:mm:ss ili HHH:mm:ss" format="[0-9]?[0-9][0-9]:[0-5][0-9]:[0-5][0-9]" value="000:00:00" formattype="regex" nulltext="000:00:00"> <!-- format="[0-9][0-9]:[0-9][0-9]" formattype="regex"   -->					
							</textedit>
						</item>				
<!-- 						<item caption=" " col="5" row="2" >
							<labeledit name="lblJM2" fontsizedelta="1" fontbold="True" value="min" />
						</item> -->
					</group>
					<group col="1" row="3" colspan="3" cols="5" rows="4" bordervisible="false">
						<item caption="Stroj" fontbold="True" col="1" row="1" colspan="5" >				
							<searchedit name="srcOsImovina" fieldtext="Stroj" fieldvalue="OSImovinaId" entermovenextcontrol="false" datavalue="~dtGet.@OsImovinaId" datatext="~dtGet.@Stroj" dataname="global.~dtOsImovina">
								<event type="valuechanged" raiseonload="false">
									<action type="control enable" value="#txtVrijemeRadaS" if="#srcOsImovina!=null"/>
									<action type="control enable" value="#txtAmort" if="#srcOsImovina!=null"/>
									<action type="control enable" value="#txtStruja" if="#srcOsImovina!=null"/>
									<action type="control disable" value="#txtVrijemeRadaS" if="#srcOsImovina==null"/>
									<action type="control disable" value="#txtAmort" if="#srcOsImovina==null"/>
									<action type="control disable" value="#txtStruja" if="#srcOsImovina==null"/>
								</event>
							</searchedit>	
						</item>
						<group col="1" row="2" colspan="5" cols="5" rows="1" bordervisible="false">
							<columnsdefinition>
								<column size="100" position="1" />
								<column size="100" position="2" />
								<column size="70" position="3" />
								<column size="85" position="4" />
								<column size="35" position="5" />
							</columnsdefinition>
							<item caption="Amortizacija" col="1" row="1"> <!-- value="false"  -->
								<textedit name="txtAmort" datavalue="~dtGet.@Amortizacija" type="decimal" value="0,00" tooltip="Iznos amortizacije odabranog stroja po minuti" />
							</item>
							<item caption="Potrošnja struje" col="2" row="1"> <!-- value="false"  -->
								<textedit name="txtStruja" datavalue="~dtGet.@Struja" type="decimal" value="0,00" tooltip="Potrošnja struje na odabranom stroju KW/min" />
							</item>
							<item caption=" " col="3" row="1" >
								<labeledit name="lblKWMIN" fontsizedelta="1" fontbold="True" value="KW/min" />
							</item>
							<item caption="Trajanje rada" col="4" row="1">
								<textedit name="txtVrijemeRadaS" datavalue="~dtGet.@VrijemeRadaStroja" tooltip="Vrijeme rada stroja odabrane operacije u obliku HH:mm:ss ili HHH:mm:ss" format="[0-9]?[0-9][0-9]:[0-5][0-9]:[0-5][0-9]" value="000:00:00" formattype="regex" nulltext="000:00:00"> <!-- nulltext="Izraženo u sekundama" --> 	
								</textedit>
							</item>	
<!-- 							<item caption=" " col="5" row="1" >
								<labeledit name="lblJM3" fontsizedelta="1" fontbold="True" value="min" />
							</item>	 -->						
						</group>					
					</group>
<!-- 					<group col="1" row="4" colspan="3" cols="3" rows="3" bordervisible="false">
						<columnsdefinition>
							<column size="100" position="1" />
							<column size="100" position="2" />
							<column size="8" position="3" />
						</columnsdefinition>
					</group>	 -->							
				
				</group>
				<item caption="Memo" col="1" row="4" colspan="2">
					<memoedit name="txtMemo" datavalue="~dtGet.Memo" maxlength="$maxlengthMEMO"/>
				</item>	
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtEdit" if="$PrnOprListDetId!=null">
							<parameter name="parent.$PrnOprListDetId"/>
							<!-- <action type="control populate" value="parent.#grdOprListDet" /> -->
							<!-- <action type="control populate" value="parent.#grdDetail" if="$PrnOprListDetId!=null"/> -->
							<!-- <action type="control populate" value="parent.#lblSUMA" /> -->
						</action>
						<action type="datarun scalar" value="~dtInsert" else="">
							<parameter name="parent.$PrnOprListDetId"/>
								<action type="control populate" value="parent.#grdOprListDet" />
								<!-- <action type="control populate" value="parent.#lblSUMA" /> -->
								<action type="control focus" value="parent.#grdOprListDet">
									<parameter value="parent.$PrnOprListDetId" type="int"/>
								</action>
						</action>
						<!-- <action type="control populate" value="parent.#lblSUMA"/> -->
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOPIS">
				<parameter name="@table_name" value="PrnOprListDet" />
				<parameter name="@column_name" value="Opis" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthMEMO">
				<parameter name="@table_name" value="PrnOprListDet" />
				<parameter name="@column_name" value="Memo" />
			</data>
			<data command="spPrnOprListDet_Query" name="dtGet">
				<parameter name="@Action" value="detailform" />
				<parameter name="@ID" value="$PrnOprListDetId" />
			</data>
			<data command="spPrnOprListDet_Query" name="dtTip">
				<parameter name="@Action" value="Tip" />
				<parameter name="@ID" value="$Oper" />
			</data>
			<data command="spPrnOprListDet_Query" name="dtRbr">
				<parameter name="@Action" value="Rbr" />
				<parameter name="@PrnOprListGlaId" value="$PrnOprListGlaId" />
			</data>
			<data command="spPrnOprListDet_Azur" name="dtInsert">
				<parameter name="@action" value="0" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@PrnOprListGlaId" value="$PrnOprListGlaId" />
				<parameter name="@OOPOperacijeId" value="#srcOperacija" />
				<parameter name="@RedniBroj" value="#txtRedniBroj" type="int"/>
				<parameter name="@UkupnoVrijemeRada" value="#txtUkupnoVrijeme" />
				<parameter name="@HRRadnaMjestaId" value="#srcHRRadnaMjesta" />
				<parameter name="@BrRadnika" value="#txtBrRadnika" type="int"/>			
				<parameter name="@VrijemeRadaEfektivno" value="#txtVrijemeRadaE" />
				<parameter name="@OsImovinaId" value="#srcOsImovina" />
				<parameter name="@Amortizacija" value="#txtAmort" type="decimal"/>
				<parameter name="@Struja" value="#txtStruja" type="decimal"/>
				<parameter name="@VrijemeRadaStroja" value="#txtVrijemeRadaS" />
				<!-- <parameter name="@SortKey" value=" " /> -->
				<parameter name="@Memo" value="#txtMemo" />
			</data>
			<data command="spPrnOprListDet_Azur" name="dtEdit">
				<parameter name="@action" value="1"/>
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@Id" value="$PrnOprListDetId"/>
				<parameter name="@PrnOprListGlaId" value="$PrnOprListGlaId"/>
				<parameter name="@OOPOperacijeId" value="#srcOperacija" />
				<parameter name="@RedniBroj" value="#txtRedniBroj" type="int"/>
				<parameter name="@UkupnoVrijemeRada" value="#txtUkupnoVrijeme" />
				<parameter name="@HRRadnaMjestaId" value="#srcHRRadnaMjesta" />
				<parameter name="@BrRadnika" value="#txtBrRadnika" type="int"/>				
				<parameter name="@VrijemeRadaEfektivno" value="#txtVrijemeRadaE" />
				<parameter name="@OsImovinaId" value="#srcOsImovina" />
				<parameter name="@Amortizacija" value="#txtAmort" type="decimal"/>
				<parameter name="@Struja" value="#txtStruja" type="decimal"/>
				<parameter name="@VrijemeRadaStroja" value="#txtVrijemeRadaS" />
				<!-- <parameter name="@SortKey" value=" " /> -->
				<parameter name="@Memo" value="#txtMemo" />

			</data>			
		</datalist>
	</form>
</root>