<root>
  <form name="frmRasporedPlacanjaPregled" caption="Raspored plaćanja - pregled" height="500" width="700">
    <event type="init">
      <action type="datarun reader" value="~dtGetIznosUkupno"/>
    </event>
    <event type="load">
      <action type="control populate" value="#grdRaspored"/>
      <action type="control value" value="#lblIznosPlacanjaUkupno">
        <parameter value="~dtGetIznosUkupno.@IznosPlacanjaUkupno"/>
      </action>
    </event>
    <layout>
      <group rows="2" cols="1">
        <item row="1" col="1">
          <grid name="grdRaspored" bestfitonrefresh="true" dataname="~dtGetRasporedPlacanja">
            <fields inherited="true">
              <field name="RedniBroj" caption="Redni broj"/>
              <field name="ValutaNaziv" caption="Valuta"/>
              <field name="DatumDospijeca" caption="Datum dospijeća"/>
              <field name="IznosPlacanja" caption="Iznos plaćanja"/>
              <field name="UkljuceneUslugeUiznosNajma" caption="Uključene usluge u iznos najma" />
              <field name="RazlogNepravilnogPlacanja" caption="Razlog nepravilnog plaćanja"/>
            </fields>
          </grid>
        </item>
        <item row="2" col="1" caption="Ukupni iznos plaćanja" fontbold="true">
          <labeledit name="lblIznosPlacanjaUkupno" format="n2"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnZatvori" caption="Zatvori" type="cancel" dock="right"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtGetRasporedPlacanja" command="spUgovoriNajamDet_GetRasporedPlacanja">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
      </data>
      <data name="dtGetIznosUkupno" command="spUgovoriNajamDet_RasporedPlacanja_UkupniIznos">
        <parameter name="@UgovoriNajamDetId" value="$UgovoriNajamDetId"/>
      </data>
    </datalist>
  </form>
</root>