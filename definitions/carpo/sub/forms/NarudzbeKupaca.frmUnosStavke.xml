<root>
    <form name="frmUnosStavke" caption="{parent.$Naslov} stavke">

    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$Indikator==2"/>
        <!-- <action type="message" value="~dtGet.@Kolicina" /> -->
    </event>
  
     <event type="load">
            <action type="variable value" >
				<parameter name="SpremiIndikator" value="0" />
			</action>
            <!-- <action type="control enable" value="txtKolicina2"/> -->
                
            


        <!-- <action if="parent.#grdRoba.rowcount!=0">
            <action type="datarun scalar" value="~dtPoljaZaOperatera" />
            <action type="control value" value="#cmbSkladiste" >
                <parameter value="~dtPoljaZaOperatera.@SkladisteId"/>
            </action>
        </action> -->

        <action if="$Indikator==1">
            <action type="datarun reader" value="~dtPoljaZaOperatera" />
            <action type="control value" value="#cmbSkladiste" >
                <parameter value="~dtPoljaZaOperatera.@SkladisteId"/>
            </action>
            <action type="control value" value="#cmbRajon" >
                <parameter value="~dtPoljaZaOperatera.@RajonId"/>
            </action>
            <action type="control value" value="#cmbRute" >
                <parameter value="~dtPoljaZaOperatera.@RuteId"/>
            </action>
            <action type="control value" value="#cmbTura" >
                <parameter value="~dtPoljaZaOperatera.@ProNacinIsporukeId"/>
            </action>
            <action type="control value" value="#cmbOrgShema" >
                <parameter value="~dtPoljaZaOperatera.@OrgShemaId"/>
            </action>
        </action>
        
    </event>

    <event type="shown">
        <action type="control disable" value="#txtKolicina2" />
        <action type="control disable" value="#srcRoba" if="$Indikator==2"/> -->

        <action if="$Indikator==2">
            <!-- <action type="control enable" value="txtKolicina2" /> -->
            <action type="control enable" value="#txtKolicina2" if="~dtGet.@DodatnaJM!=null" />
            <action type="control disable" value="#txtKolicina2" else="" />

            <action type="datarun scalar" value="~dtVrijednost">
                <parameter name="Vrijednost" />
            </action>
            <action type="control value" value="#txtVrijednost">
                <parameter value="$Vrijednost" />
            </action>
            <action type="variable value" >
                <parameter name="BrDecimalaDodJM" value="~dtGet.@dod_jm_br_dec" />
            </action>
            <action type="variable value" >
                <parameter name="BrDecimala" value="~dtGet.@jm_br_dec" />
            </action>
            <action type="variable value" >
                <parameter name="JM" value="~dtGet.@JM" />
            </action>
            <action type="variable value" >
                <parameter name="DodatnaJM" value="~dtGet.@DodatnaJM" />
            </action>                  
            <action type="control attribute" value="txtKolicina2">
                <parameter name="format" value="n{$BrDecimalaDodJM}"></parameter>
            </action>
            <action type="control itemcaption" value="txtKolicina2">
                <parameter  value="Količina2 ({$DodatnaJM})"></parameter>
            </action>                 
            <action type="control attribute" value="txtKolicina">
                <parameter name="format" value="n{$BrDecimala}"></parameter>
            </action>                    
            <action type="control itemcaption" value="txtKolicina">
                <parameter  value="Količina ({$JM})"></parameter>
            </action>

            <!-- <action type="datarun scalar" value="~dtKalk">
                <parameter name="Izracun" />
            </action> -->
                            
            <!-- <action type="control value" value="#txtKolicina2" if="~dtGet.@dod_JmId!=null">
                <parameter value="$Izracun" />
            </action> -->
        </action>

       
      

        <!-- <action type="control itemcaption" value="frmUnosStavke" >
			<parameter  value="Unos stavke"  if="parent.$Indikator==1"></parameter>
            <parameter  value="Izmjena stavke"  elseif="parent.$Indikator==2"></parameter>
		</action> -->
    </event>
   	<!-- <event type="close">
			<action type="control populate" value="parent.#grdRoba"> 
				<action type="control focus" value="parent.#grdRoba">
                    <parameter value="parent.#grdRoba.@ProNarudzbeDetId"/>
                </action>
			</action>
		</event> -->
        <layout>
            <group cols="1" rows="13">
                <item row="1" col="1" caption="Roba" textposition="left">
	            	 <searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtPuniRobu" required="true" datavalue="~dtGet.@RobaId" datatext="~dtGet.@Naziv" entermovenextcontrol="false">
                        <event type="valuechanged" raiseonload="false" >
                        <action if="$SpremiIndikator==0">
                            <action type="variable value" >
								<parameter name="BrDecimalaDodJM" value="#srcRoba.@BrDecimala_DodJmId" />
							</action>
                            <action type="variable value" >
								<parameter name="BrDecimala" value="#srcRoba.@BrDecimala_JmId" />
							</action>
                             <action type="variable value" >
				                <parameter name="JM" value="#srcRoba.@JM" />
			                </action>
                            <action type="variable value" >
								<parameter name="DodatnaJM" value="#srcRoba.@Dodatna JM" />
							</action>
                          
                            <action type="control attribute" value="txtKolicina2">
								<parameter name="format" value="n{$BrDecimalaDodJM}"></parameter>
							</action>
                             <action type="control itemcaption" value="txtKolicina2">
								<parameter  value="Kolicina2 ({$DodatnaJM})"></parameter>
							</action>
                             
                            <action type="control attribute" value="txtKolicina">
								<parameter name="format" value="n{$BrDecimala}"></parameter>
							</action>
                            
                            <action type="control itemcaption" value="txtKolicina">
								<parameter  value="Kolicina ({$JM})"></parameter>
							</action>
                            <action type="datarun reader" value="~dtPuniRabatiCijenu" />
		    		        <action type="variable value">
		    			        <parameter name="Cijena" value="~dtPuniRabatiCijenu.@Cijena" />
		    		        </action>
                            <action type="control value" value="#txtCijena">
				                <parameter value="$Cijena"/>
			                </action>
                             <action type="variable value">
		    			        <parameter name="Rabat" value="~dtPuniRabatiCijenu.@Rabat" />
		    		        </action>
                            <action type="control value" value="#txtRabat">
				                <parameter value="$Rabat"/>
			                </action>
                            <action type="control enable" value="#txtKolicina2" if="#srcRoba!=null&amp;&amp;#srcRoba.@dod_JmId!=null" />
                            <action type="control disable" value="#txtKolicina2" else="" />

                            <action type="control focus" value="#txtKolicina" if="#srcRoba==null||#srcRoba.@dod_JmId==null"  /> 
                            <action type="control focus" value="#txtKolicina2" else="" /> 

                            <action type="datarun scalar" value="~dtVrijednost">
                                <parameter name="Vrijednost" />
                            </action>
                           
                            <action type="control value" value="#txtVrijednost">
                                <parameter value="$Vrijednost" />
                            </action>
                            </action>

                             <!-- <action type="control disable" value="#txtKolicina2" if="#srcRoba==null&amp;&amp;#srcRoba.@dod_JmId==null" /> -->
                        </event>
                     </searchedit>
                </item>
                <item row="2" col="1" caption="Količina2" textposition="left" >
	            	 <textedit name="txtKolicina2"  datavalue="~dtGet.@Kolicina2">
                        <event type="leave">
                            <action type="variable value">
								<parameter name="Ind_Kol" value="0"  />
							</action>
                            <action type="datarun scalar" value="~dtKalk">
                                <parameter name="Izracun" />
                            </action>
                            <!-- <action type="message" value="$Izracun" /> -->
                            <action type="control value" value="#txtKolicina">
                             <parameter value="$Izracun" />
                            </action>
                        </event>
                     </textedit>
                </item>
                <item row="3" col="1" caption="Količina" textposition="left" >
	            	 <textedit name="txtKolicina"  required="true" datavalue="~dtGet.@Kolicina">
                        <event type="leave">
                            <action type="variable value">
								<parameter name="Ind_Kol" value="1"  />
							</action>
                            <action type="datarun scalar" value="~dtKalk">
                                <parameter name="Izracun" />
                            </action>
                            
                            <action type="control value" value="#txtKolicina2" if="#srcRoba!=null&amp;&amp;#srcRoba.@dod_JmId!=null">
                                <parameter value="$Izracun" />
                            </action>
                            <action type="control value" value="#txtKolicina2" elseif="~dtGet.@JM2Id!=null">
                                <parameter value="$Izracun" />
                            </action>

                            <action type="datarun scalar" value="~dtVrijednost">
                                <parameter name="Vrijednost" />
                            </action>

                            <action type="control value" value="#txtVrijednost">
                                <parameter value="$Vrijednost" />
                            </action>
                        </event>
                     </textedit>
                </item>
                <item row="4" col="1" caption="Cijena" textposition="left" >
	            	 <textedit format="n2" name="txtCijena" enabled="false" datavalue="~dtGet.@Cijena" />
                </item>
                <item row="5" col="1" caption="Rabat" textposition="left">
	            	 <textedit format="2n" name="txtRabat" enabled="false" datavalue="~dtGet.@Rabat"/>
                </item>
                <item row="6" col="1" caption="Vrijednost" textposition="left">
	            	  <textedit name="txtVrijednost" enabled="false" dataname="~dtVrijednost"/>
                </item>
                <item row="7" col="1" caption="Skladište" textposition="left">
	            	 <comboedit name="cmbSkladiste" valuefield="SkladisteId" dataname="~dtPuniSkladiste" displayfield="Opis" datavalue="~dtGet.@SkladisteId" />
                </item>
                <item row="8" col="1" caption="Rajon" textposition="left">
	            	 <comboedit name="cmbRajon" valuefield="RajonId" dataname="~dtPuniRajon" displayfield="Opis" datavalue="~dtGet.@RajonId" />
                </item>
                 <item row="9" col="1" caption="Rute" textposition="left">
	            	 <comboedit name="cmbRute" dataname="~dtPuniRute" valuefield="RuteId"  displayfield="Naziv" datavalue="~dtGet.@RuteId"/>
                </item>
                <item row="10" col="1" caption="Tura" textposition="left">
	            	 <comboedit name="cmbTura" valuefield="ProNacinIsporukeId" dataname="~dtPuniTuru" displayfield="Naziv" datavalue="~dtGet.@ProNacinIsporukeId" />
                </item>
                 <item row="11" col="1" caption="Organizacijska shema" textposition="left">
	            	 <comboedit name="cmbOrgShema" dataname="~dtPuniOrgShemu" valuefield="OrgShemaId"  displayfield="Naziv" datavalue="~dtGet.@OrgShemaId" />
                </item>
                 <item row="12" col="1" caption="Broj narudžbe" textposition="left">
	            	 <textedit name="txtBrojNarudzbe" maxlenght="100" datavalue="~dtGet.@BrojNarudzbe" />
                </item>
                <item row="13" col="1" caption="Napomena" textposition="left">
	            	 <textedit name="txtNapomena" maxlenght="100"  datavalue="~dtGet.@Memo" />
                </item>
            </group>
        </layout>

    <panelbuttons>
			<buttons>
				<button name="btnUnosStavke" caption="Spremi">
					<event type="click">
                        <action type="variable value" >
				            <parameter name="SpremiIndikator" value="1" />
			            </action>
					    <action type="validate"/>
                        <action if="$Indikator==1">
                            <action type="datarun scalar" value="~dtUnosStavke" />
                            <action type="control refreshvalue" value="#srcRoba,#txtKolicina2, #txtKolicina, #txtCijena, #txtVrijednost, #txtBrojNarudzbe, #txtNapomena"/>
                        </action>
                        <action if="$Indikator==2">
                            <action type="datarun scalar" value="~dtIzmjenaStavke" />
                            <action type="form close" />
                        </action>

					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
                         
                        <!-- <action type="control populate keepfocus" value="parent.#grdRoba" /> -->
                                                   
					 </event> 
				</button>	
			</buttons>
		</panelbuttons>
    <datalist>

        <data command="spProd_ProNarudzbeDet_IzracunajVrijednost" name="dtVrijednost">
			<parameter name="@Kolicina" value="#txtKolicina" type="decimal" />
			<parameter name="@Cijena" value="#txtCijena" type="decimal" />
            <parameter name="@Rabat" value="#txtRabat" />
		</data>
        <data command="spTraziRoba" name="dtPuniRobu">
            <parameter name="@action" value="Roba" />
            <parameter name="@uvjet" value="#srcRoba.text" />
            <parameter name="@PokaziVPCijene" value="1" />
            <parameter name="@PokaziNabCijene" value="0" />
            <parameter name="@Retired" value="0" />
            <parameter name="@Prikazi_Dodatno" value="1" />
            <parameter name="@PokaziStanje" value="0" />
            <parameter name="@SkladisteId" value="null" />
        </data>

        <data command="spProd_ProNarudzbeDet_Cijena " name="dtPuniRabatiCijenu">
            <parameter name="@ProNarudzbeGlaId" value="parent.$GlavaId" />
            <parameter name="@RobaId" value="#srcRoba" />
        </data>

         

         <data command="spProd_ProNarudzbeDet_PoljaZaOperatera " name="dtPoljaZaOperatera">
            <parameter name="@ProNarudzbeGlaId" value="parent.$GlavaId" />
        </data>

        <data command="spProd_ProNarudzbeDet_Query" name="dtGet">
            <parameter name="@ProNarudzbeDetId" value="$DetaljId"/>
        </data>

        <data command="spNG_Combo" name="dtPuniSkladiste">
            <parameter name="@Action" value="skladiste" />
            <parameter name="@Ind" value="1" />
        </data>

        <data command="spNG_Combo" name="dtPuniTuru">
            <parameter name="@Action" value="ProNacinIsporuke" />
        </data>
        
        <data command="spProd_ProNarudzbe_GetRajon" name="dtPuniRajon" />

        <data command="spProd_ProNarudzbe_GetOrgShemaDio" name="dtPuniOrgShemu" />

        <data command="spProd_DodJM_Kalk" name="dtKalk">
            <parameter name="@action" value="0" />
            <parameter name="@Kolicina" type="decimal" value="#txtKolicina2" if="$Ind_Kol==0" />
            <parameter name="@Kolicina" type="decimal" value="#txtKolicina" if="$Ind_Kol==1"/>
            <parameter name="@br_decimala" value="3"/>
            <parameter name="@Ind" type="int" value="$Ind_Kol" />
            <parameter name="@Faktor" value="#srcRoba.@Faktor_Id" if="$indikator==1"/>
            <parameter name="@Faktor" value="~dtGet.@Faktor" if="$indikator==2"/>
        </data>

        <data command="spProd_ProNarudzbe_GetRute " name="dtPuniRute" />

         <data command="spProd_ProNarudzbeDet_Unos" name="dtUnosStavke">
            <parameter name="@ProNarudzbeGlaId" value="parent.$GlavaId" />
            <parameter name="@RobaId" value="#srcRoba" />
            <parameter name="@Kolicina" value="#txtKolicina" />
            <parameter name="@Kolicina2" value="#txtKolicina2" />
            <parameter name="@Memo" value="#txtNapomena" />
            <parameter name="@Cijena" value="#txtCijena" />
            <parameter name="@Rabat" value="#txtRabat" />
            <parameter name="@BrojNarudzbe" value="#txtBrojNarudzbe" />
            <parameter name="@OperateriId" value="@@operateriid" />
            <parameter name="@RuteId" value="#cmbRute" />
            <parameter name="@JmRobaId" value="#srcRoba.@jmrobaid" />
            <parameter name="@SkladisteId" value="#cmbSkladiste" />
            <parameter name="@RajonId" value="#cmbRajon" />
            <parameter name="@ProNacinIsporukeId" value="#cmbTura" />
            <parameter name="@OrgShemaId" value="#cmbOrgShema" />
        </data>

         <data command="spProd_ProNarudzbeDet_Izmjena" name="dtIzmjenaStavke">
            <parameter name="@ProNarudzbeDetId" value="$DetaljId"/>
            <parameter name="@RobaId" value="#srcRoba" />
            <parameter name="@Kolicina" value="#txtKolicina" />
            <parameter name="@Kolicina2" value="#txtKolicina2" />
            <parameter name="@Memo" value="#txtNapomena" />
            <parameter name="@Cijena" value="#txtCijena" />
            <parameter name="@Rabat" value="#txtRabat" />
            <parameter name="@BrojNarudzbe" value="#txtBrojNarudzbe" />
            <parameter name="@OperateriId" value="@@operateriid" />
            <parameter name="@RuteId" value="#cmbRute" />
            <parameter name="@JmRobaId" value="#srcRoba.@jmid" />
            <parameter name="@SkladisteId" value="#cmbSkladiste" />
            <parameter name="@RajonId" value="#cmbRajon" />
            <parameter name="@ProNacinIsporukeId" value="#cmbTura" />
            <parameter name="@OrgShemaId" value="#cmbOrgShema" />
        </data>

    </datalist>
        
    </form>

   
</root>