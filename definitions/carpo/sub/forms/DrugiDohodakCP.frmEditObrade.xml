<!--
  8.9.2021. MG - doradio izgled za DevX 20 
  (pretvorio iteme lijevo od polja napomena u grupu, 
  namjestio caption, namjestio dateedit kontrole)
-->

<root>
  <!--FORMA ZA UNOS/IZMJENU OBRADE-->

  <form name="frmEditObrade" caption="$caption" width="900" height="600" fixedsize="true" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtGet">
        <!--<parameter name="Tip" value="~dtGet.@Tip"/>-->
      </action>
      <!--action type="datarun reader" value="~dtParametri">
        <parameter name="Tip" value="~dtGet.@Tip"/>
      </action-->
    </event>

    <event type="load">
      <action type="control value" value="#rdoOpcija1" if="~dtget.@status==0">
        <parameter value="true" />
      </action>
      <action type="control value" value="#rdoOpcija2" if="~dtget.@status==1">
        <parameter value="true" />
      </action>
      <action type="control disable" value="#rdoOpcija1" if="$tip==unos" />
      <action type="control enable" value="#rdoOpcija1" else="" />

      <action if="$tip==izmjena" type="control value" value="#srcOrgshema">
        <parameter value="~dtGet.Orgshemaid" text="~dtGet.Orgshemanaziv" />
      </action>


      <action type="control disable" value="#rdoOpcija2" if="$tip==unos" />
      <action type="control enable" value="#rdoOpcija2" else="" />

      <action type="control disable" value="#txtGodina,#txtMjesec,#txtRbr,#txtDanOd,#txtDanDo,#cmbVrstaDohotka,#cmbVrstaObrade,#srcOrgshema,#srcDimenzija,#datDatumObrade,#datDatumDoprinosa,#txtNapomena,#chkIndIsti" if="~dtGet.@status==1" />


    </event>

    <layout>

      <!--omotač-->
      <group cols="1" rows="3" groupbordervisible="false">

        <rowsdefinition>
          <row position="1" size="32%"></row>
          <row position="2" size="7%"></row>
          <row position="3" size="15%"></row>
        </rowsdefinition>

        <!--def obrade-->
        <group col="1" row="1" cols="1" rows="8" groupbordervisible="true" caption="Definicija obrade" spacing="2,1,2,2">

          <item caption="Godina:" col="1" row="1" textposition="left" highlight="false">
            <textedit name="txtGodina" required="true" datavalue="~dtGet.@Godina" textposition="left" maxlength="4" format="[0-9][0-9][0-9][0-9]" formattype="regex">

              <event type="leave">
                <action type="datarun reader" value="~dtPopuniDane" if="#txtGodina!=null" />
                <action type="control value" value="#txtDanOd" if="#txtGodina!=null">
                  <parameter value="~dtPopuniDane.@DanOd" />
                </action>
                <action type="control value" value="#txtDanDo" if="#txtGodina!=null">
                  <parameter value="~dtPopuniDane.@DanDo" />
                </action>
              </event>
            </textedit>
          </item>
          <item caption="Mjesec:" col="1" row="2" textposition="left" highlight="false">
            <textedit name="txtMjesec" required="true" datavalue="~dtGet.@Mjesec" textposition="left" maxlength="2" format="[1-9]|1[0-2]" formattype="regex">
              <event type="leave">
                <action type="datarun reader" value="~dtPopuniDane" if="#txtMjesec!=null" />
                <action type="control value" value="#txtDanOd" if="#txtMjesec!=null">
                  <parameter value="~dtPopuniDane.@DanOd" />
                </action>
                <action type="control value" value="#txtDanDo" if="#txtMjesec!=null">
                  <parameter value="~dtPopuniDane.@DanDo" />
                </action>
                <action type="control value" value="#txtRbr" if="#txtMjesec!=null">
                  <parameter value="~dtPopuniDane.@rbr" />
                </action>
              </event>
            </textedit>
          </item>
          <item caption="Rbr:" col="1" row="3" textposition="left" highlight="false">
            <!--<textedit name="txtRbr" required="true"  datavalue="~dtGet.@Rbr" textposition="left" maxlength="2" format="n0"/>-->
            <textedit name="txtRbr" required="true" datavalue="~dtGet.@Rbr" textposition="left" maxlength="2" />
          </item>

          <item caption="Dan od:" col="1" row="4" textposition="left">
            <textedit name="txtDanOd" required="true" format="n0" datavalue="~dtGet.@Danod" textposition="left" maxlength="2" enabled="false" />
          </item>
          <item caption="Dan do:" col="1" row="5" textposition="left">
            <textedit name="txtDanDo" required="true" format="n0" datavalue="~dtGet.@Dando" textposition="left" maxlength="2" enabled="false" />
          </item>

          <item row="6" col="1" caption="Organizacijska jedinica: " highlight="false" textposition="left">
            <searchedit name="srcOrgShema" dataname="~dtOrgShema" valuefield="OrgShemaId" textfield="Naziv" datavalue="~dtGet.@orgshemaid" textvalue="~dtGet.orgshemanaziv" required="true"></searchedit>
          </item>

          <item row="7" col="1" caption="Dimenzija: " highlight="false" textposition="left">
            <searchedit name="srcDimenzija" dataname="~dtDimenzija" valuefield="DimenzijeId" textfield="Naziv"></searchedit>
          </item>

          <item caption="Vrsta isplate:" col="1" row="8" textposition="left" highlight="false">
            <comboedit name="cmbVrstaDohotka" valuefield="OOPIsStavkeid" displayfield="Naziv" dataname="~dtVrstaDohotka" datavalue="#dtGet.@OOPIsStavkeid" required="true" allownull="false">
              
            </comboedit>
          </item>
        </group>
        <group col="1" row="2" cols="2" rows="1" groupbordervisible="true" caption="Datumi obrade" spacing="2,1,2,2">

        <columnsdefinition>
          <column position="1" size="50%"></column>
          <column position="2" size="50%"></column>
        </columnsdefinition>

          <item caption="Datum obrade:" col="1" row="1" textposition="left" highlight="false">
            <dateedit name="datDatumObrade" required="true" datavalue="~dtGet.@DatumObrade" value="now" />
          </item>
          <item caption="Datum doprinosa:" col="2" row="1" textposition="left" highlight="false">
            <dateedit name="datDatumDoprinosa" required="true" datavalue="~dtGet.@DatumDoprinosa" value="now" />
          </item>
        </group>
        <!--kraj datumi obrade-->

        <!--napomena i status-->
        <group col="1" row="3" cols="3" rows="2" groupbordervisible="false" caption="Dodatno" spacing="2,1,2,2">

          <columnsdefinition>
            <column position="1" size="10%"></column>
            <!--column position="2" size="5%"></column-->
            <column position="3" size="20%"></column>
          </columnsdefinition>

          <item caption="Napomena:" col="3" row="1" rowspan="2" highlight="false">
            <memoedit name="txtNapomena" datavalue="~dtGet.@Napomena" />
          </item>
          <group col="1" row="1" cols="2" rows="2" groupbordervisible="false">
            <item col="1" row="1" colspan="2">
              <labeledit name="lblCaptionStatusCheck" value="Status:" fontbold="true" />
            </item>
            <item col="1" row="2" highlight="False">
            <radioedit name="rdoOpcija1" caption="Otvorena" value="true"></radioedit>
            </item>
            <item col="2" row="2" highlight="False">
              <radioedit name="rdoOpcija2" caption="Zatvorena"></radioedit>
            </item>
          </group>
          <item col="1" row="2" highlight="false" caption="Dopušten unos više isplata za istog partnera: " padding="4,0,6,0"></item>
          <item col="2" row="2" highlight="false" textposition="left">
            <checkedit name="chkIndIsti" datavalue="~dtGet.@IndIsti" />
          </item>
        </group>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtKontrola" />
            <action if="$indGreske==0">
              <action type="datarun reader" value="~dtSpremi" waittype="progress" waitcaption="Pričekajte..." waittext="..spremanje u tijeku...">
                <action type="variable value">
                  <parameter name="OOPisObradeId" value="$noviId" />
                </action>
                <action type="variable value">
                  <parameter name="parent.$drvoFokusId" value="$noviId" type="string" />
                  <parameter name="parent.$filterFokus" value="otvorene" />
                </action>
              </action>

              <action type="message" value="$Poruka" if="$IndGreske==0" />
              <action type="form close" if="$IndGreske==0" />
            </action>


          </event>
        </button>
        <button name="btnOdustani" type="cancel" caption="ODUSTANI">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spDD_help_CP" name="dtPopuniDane">
        <parameter name="@Action" value="default_parametri" type="string" />
        <!--parameter name="@operateriid" value="@@operateriid"/-->
        <parameter name="@godina" value="#txtGodina" type="string" />
        <parameter name="@mjesec" value="#txtMjesec" type="string" />
      </data>
      <data command="spDD_help_CP" name="dtGet">
        <parameter name="@Action" value="obrada_query" type="string" />
        <parameter name="@oopisobradeid" value="$oopisobradeid" type="int" />
        <!--parameter name="@operateriid" value="@@operateriid"/-->
      </data>
      <data command="spDD_help_CP" name="dtOrgShema">
        <parameter name="@action" value="orgshema2" />
        <parameter name="@Tekst" value="#srcOrgShema.text" />
      </data>
      <data command="spDD_help_CP" name="dtDimenzija">
        <parameter name="@action" value="dimenzija" />
        <parameter name="@Tekst" value="#srcDimenzija.text" />
      </data>
      <data command="spDDObradeAzur_CP" name="dtKontrola">
        <parameter name="@Action" value="kontrola_spremanje" type="string" />
        <parameter name="@oopisobradeid" value="$oopisobradeid" type="int" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@godina" value="#txtGodina" type="string" />
        <parameter name="@mjesec" value="#txtMjesec" type="string" />
        <parameter name="@rbr" value="#txtRbr" type="string" />
        <parameter name="@danod" value="#txtDanOd" type="int" />
        <parameter name="@dando" value="#txtDanDo" type="int" />
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date" />
        <parameter name="@indIsti" value="1" if="#chkIndIsti==true" type="int" />
        <parameter name="@indGreske.output.int" />
      </data>
      <!-- specifično za HRMOD - provjera je li vrsta isplate provizija-->
      <data command="spDDObradeAzur_CP" name="dtProvjeriProvizija">
        <parameter name="@action" value="provjeri_indisti" />
        <parameter name="@oopisstavkeid" value="#cmbVrstaDohotka" type="int" />
        <parameter name="@indIsti.output.int" />
      </data>
      <data command="spDD_help_CP" name="dtVrstaObrade">
        <parameter name="@Action" value="vrste_obrada" />
        <!--parameter name="@granula" value="@@moduleid"/-->
      </data>
      <data command="spDD_help_CP" name="dtVrstaDohotka">
        <parameter name="@Action" value="vrste_dohotka" />
        <!--parameter name="@granula" value="@@moduleid"/-->
      </data>
      <data command="spDDObradeAzur_CP" name="dtSpremi" if="$tip==unos">
        <parameter name="@Action" value="0" type="string" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@godina" value="#txtGodina" type="string" />
        <parameter name="@mjesec" value="#txtMjesec" type="string" />
        <parameter name="@rbr" value="#txtRbr" type="string" />
        <parameter name="@danod" value="#txtDanOd" type="int" />
        <parameter name="@dando" value="#txtDanDo" type="int" />
        <parameter name="@oopisstavkeid" value="#cmbVrstaDohotka" type="int" />
        <!--parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade" type="int"/-->
        <parameter name="@orgshemaId" value="#srcOrgShema" type="int" />
        <parameter name="@dimenzijeId" value="#srcDimenzija" type="int" />
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date" />
        <parameter name="@DatumDoprinosa" value="#datDatumDoprinosa" type="date" />
        <parameter name="@status" value="0" type="int" />
        <parameter name="@napomena" value="#txtNapomena" type="string" />
        <parameter name="@indIsti" value="1" if="#chkIndIsti==true" type="int" />
        <parameter name="@poruka.output.string" />
        <parameter name="@indGreske.output.int" />
        <parameter name="@noviId.output.int" />
      </data>
      <data command="spDDObradeAzur_CP" name="dtSpremi" if="$tip==izmjena">
        <parameter name="@Action" value="1" type="string" />
        <parameter name="@oopisobradeid" value="$oopisobradeid" type="int" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@godina" value="#txtGodina" type="string" />
        <parameter name="@mjesec" value="#txtMjesec" type="string" />
        <parameter name="@rbr" value="#txtRbr" type="string" />
        <parameter name="@danod" value="#txtDanOd" type="int" />
        <parameter name="@dando" value="#txtDanDo" type="int" />
        <parameter name="@orgshemaId" value="#srcOrgShema" type="int" />
        <parameter name="@dimenzijeId" value="#srcDimenzija" type="int" />
        <parameter name="@oopisstavkeid" value="#cmbVrstaDohotka" type="int" />
        <!--parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade" type="int"/-->
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date" />
        <parameter name="@DatumDoprinosa" value="#datDatumDoprinosa" type="date" />
        <parameter name="@status" value="0" type="int" if="#rdoOpcija1==true" />
        <parameter name="@status" value="1" type="int" if="#rdoOpcija2==true" />
        <parameter name="@napomena" value="#txtNapomena" type="string" />
        <parameter name="@indIsti" value="1" if="#chkIndIsti==true" type="int" />
        <parameter name="@poruka.output.string" />
        <parameter name="@indGreske.output.int" />
        <parameter name="@noviId.output.int" />
      </data>

    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>
