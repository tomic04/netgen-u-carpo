												</data>
												<fields inherited="true">
													<field name="AutorskoPravo" caption="Autorsko pravo" />
													<field name="Avansuplaceni" caption="Avans uplaćeni" />
													<field name="Avansuplacenigodisnji" caption="Avans uplaćeni godišnji" />
													<field name="Datumugovora" caption="Datum ugovora" />
												</fields>
											</grid>
