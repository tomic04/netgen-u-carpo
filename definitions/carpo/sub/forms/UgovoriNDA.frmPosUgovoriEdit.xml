											<column size="50%" position="2" />
											<column size="75" position="3" />
										</columnsdefinition>
										<item caption="Autorsko pravo (%):" col="1" row="1">
											<textedit name="txtAutorsko" datavalue="#dtDetaljStavke.@AutorskoPravo" function="Autorsko" format="n2" />
										</item>
										<item caption="Valuta:" col="2" row="3" colspan="1">
