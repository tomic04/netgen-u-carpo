<root>
	<form name="frmUgovoriNDAEdit" caption="Izmjena dokumenta" width="1200" height="570" operaterlocktable="PosUgovorigla" operaterlockkey="PosUgovoriglaId" operaterlockkeyvalue="global.$OperaterLockId">
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet" if="$PosUgovoriglaId!=null" />
			<action type="datarun reader" value="Global.~dtGet">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<action type="datarun reader" value="Global.~dtDetaljStavke" if="$PosUgovoriDetId!=null" />
			<action type="datarun reader" value="Global.~dtDetaljStavke">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<!-- <action type="datarun reader" value="Global.~dtGetDet" if="$PosUgovoriDetId!=null" />
			<action type="datarun reader" value="Global.~dtGetDet">
				<parameter value="@PosUgovoriDetId" />
			</action> -->
			<action type="variable value" if="$Izmjena==1" />
			<!-- <action type="variable value">
				<parameter name="Global.OperaterLockId" value="0" type="int" />
			</action> -->
		</event>
		<event type="load">
			<action type="variable value">
				<parameter name="OsobaTrazilica" value="~dtGet.@OsobaTrazilica" />
			</action>
			<!-- <action type="variable value">
				<parameter name="PosUgovoriDetIdww" value="~dtGetDet.@PosUgovoriDetId" />
			</action> -->
			<action type="variable value">
				<parameter name="Izmjena" value="0" />
			</action>
			<action type="control populate" value="#grdRoba" />
			<!-- <action type="control refreshvalue" value="#grdRoba" /> -->
		</event>
		<event type="shown">
			<action type="control focus" value="#srcPartner" if="$PosUgovoriglaId==null" />
			<action type="control disable" value="#txtOIB, #txtMBS, #txtAdresa,#txtMjesto,#txtHPTBroj,#txtTelefon,#txtFax,#txtIBAN,#txtNacinPlacanja" />
			<action type="control enable" value="#txtKreditniLimit,#txtOdgoda,#txtRabat,#txtAneks,#srcPartner, #txtZaduznica" if="$PosUgovoriglaId!=null" />
			<action type="control disable" value="#txtBroj,#srcPartner" if="$PosUgovoriglaId!=null" />
			<action type="control enable" value="#srcOvlastenaOsobaTrazilica" if="$OsobaTrazilica==1" />
			<action type="control enable" value="#srcOvlastenaOsobaTrazilica" elseif="$OsobaTrazilica==null" />
			<action type="control disable" value="#srcOvlastenaOsobaTrazilica" else="" />
			<action type="control enable" value="#txtOvlastenaOsoba" if="$OsobaTrazilica==0" />
			<action type="control enable" value="#txtOvlastenaOsoba" elseif="$OsobaTrazilica==null" />
			<action type="control disable" value="#txtOvlastenaOsoba" else="" />
			<action type="control disable" value="#btnPoveziRoba" if="#txtNaslov==null" />
			<action type="control enable" value="#btnPoveziRoba" else="" />
			<action type="control disable" value="#btnIzmijeni, #btnObrisi" if="#grdRoba.rowcount==0"/>
			<action type="control enable" value="#btnIzmijeni, #btnObrisi" else="" />
		</event>
		<layout itemspadding="3">
			<group cols="1" rows="1">
				<group padding="0" groupbordervisible="False" cols="3" rows="1">
