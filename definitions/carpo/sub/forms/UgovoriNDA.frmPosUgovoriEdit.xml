													<action type="form open" value="frmRobaPronadi">
														<parameter name="PosUgovoriglaId" value="$PosUgovoriglaId" />
														<parameter name="Izmjena" value="$Izmjena" />
														<parameter name="PosUgovoriDetId" value="null" />
													</action>
												</event>
											</button>
										</item>
									</group>
									<group padding="4" groupbordervisible="false" cols="3" rows="2" col="1" row="2">
