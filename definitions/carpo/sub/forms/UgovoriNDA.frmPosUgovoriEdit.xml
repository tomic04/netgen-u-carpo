													<action type="control  focus" value="#grdRoba">
														<parameter value="$PosUgovoriDetIdNew" type="int"/>
													</action>
													<action type="control refreshvalue" value="##" />
													<action type="control focus" value="#txtNaslov" />
													<action type="control disable" value="#btnIzmijeni, #btnObrisi" if="#grdRoba.rowcount==0"/>
													<action type="control enable" value="#btnIzmijeni, #btnObrisi" else="" />
												</event>
											</button>
										</item>


										<action type="datarun scalar" value="~dtInsertDetalj" if="$Izmjena==0">
											<!-- <parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" /> -->
											<parameter name="NewDetiId" value="$NewDetiId" />
										</action>



