						<column size="560" position="1" />
						<column size="8" position="2" />
					</columnsdefinition>
					<item row="1" col="3" />
					<group padding="0" groupbordervisible="False" cols="1" rows="1" col="3" row="2">
						<rowsdefinition>
							<row size="1" position="3" />
							<row size="54" position="4" />
						</rowsdefinition>
						<group padding="4" groupbordervisible="False" cols="2" rows="1" col="1" row="1">
							<tabs col="1" row="1">
