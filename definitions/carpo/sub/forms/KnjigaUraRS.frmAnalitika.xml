<root>
	<form name="frmAnalitika" saveformsize="true" statusbar="true">
		<event type="shown">
			<action type="control populate" value="#grdAnalitika"/>
			<!-- <action type="form caption" value="Pregled svih stavki poreza za mjesec {$Vrijeme}" if="$Indikator==mjesec"/> -->
			<action type="form caption" value="Pregled knjige ulaznih računa: {$Naziv}"/>			
			<action type="footer text" value="Broj slogova: {#grdAnalitika.rowcount}"/>
		</event>
		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdAnalitika" dataname="~dtAnalitika" fieldsmartspaces="false" multiselect="true" key="KntKnjigaUraRSId" bestfitonrefresh="false" savelayout="true">
						<fields inherited="true">
							<field name="OznakaKnjige" caption="Oznaka knjige"/>
							<field name="NazivKnjige" caption="Naziv knjige" fixwidth="200"/>
							<field name="OznakaPorez" caption="Porezna oznaka"/>
							<field name="IznosUkupno" caption="Iznos ukupno"/>
							<field name="Partner"/>
							<field name="DatumDok" caption="Datum dokumenta"/>
							<field name="DatumKnjizenja" caption="Datum knjiženja"/>
							<field name="DatumUnosa" caption="Datum unosa"/>
							<field name="DatumZakljucka" caption="Datum zaključka"/>
							<field name="MesecDokumenta" caption="Mesec dokumenta"/>
							<field name="MesecKnjizenja" caption="Mesec knjiženja"/>
						</fields>
						<styles>
							<style name="fontcolor" value="red" if="#grdAnalitika.@PartneriId==global.$NasId&amp;&amp;#grdAnalitika.fieldname==Partner"/>
							<style name="bold" value="true" if="#grdAnalitika.@PartneriId==global.$NasId&amp;&amp;#grdAnalitika.fieldname==Partner"/>
						</styles>
						<print header="PREGLED KNJIGE ULAZNIH RAČUNA\n" headeralign="center"/>					
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIspisiSucelje" caption="Ispis sučelja">
					<event type="click">
						<action type="control printcontrol" value="#grdAnalitika"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtAnalitika" command="spCKntKnjigaUraRSQuery">
				<parameter name="@Action" value="4"/>
				<parameter name="@node" value="$node"/>
			</data>
		</datalist>
	</form>
</root>