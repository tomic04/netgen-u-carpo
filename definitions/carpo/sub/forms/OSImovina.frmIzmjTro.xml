<root version="1.0">

  <!--******************************************FILTER - IZMJENA MJESTA TROŠKA****************************************-->
  <form name="frmIzmjTro" caption="$caption" fixedsize="false" width="800" height="800" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtIzmjena" />
      <action type="datarun reader" value="~dtIzmjTro" />
    </event>
    <event type="close">
      <action type="datarun reader" value="~dtBrisanje" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="3" groupbordervisible="false">
        <group rows="1" cols="4" col="1" row="1" spacing="2,2,2,1">
          <columnsdefinition>
            <column pos="1" size="50%"></column>
            <column pos="2" size="20%"></column>
            <column pos="3" size="30%"></column>
            <column pos="4" size="100"></column>
          </columnsdefinition>
          <item caption="Mjesto troška:" col="1" row="1"  >
            <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="dtOrgShema" required="true"/>
          </item>
          <item caption="Postotak:" col="2" row="1" >
            <textedit name="txtPostotak" format="n2" value="0"/>
          </item>
          <item caption="Datum:" col="3" row="1" >
            <dateedit name="datDatum" value="now" />
          </item>
          <item caption="" col="4" row="1" >
            <button name="btnSpremi"  caption="Spremi" >
              <event type="click">
                <action type="validate"/>
                <action type="datarun reader" value="~dtKontrolaBlokade">
                  <action type="message" value="~dtKontrolaBlokade.@Poruka" if="~dtKontrolaBlokade.@IndGreska==1" />
                  <action type="control focus" value="#datDatum"/>
                </action>
                <action type="datarun reader" value="~dtKontrolaPostotka" if="~dtKontrolaBlokade.@IndGreska==0">
                  <action type="message" value="~dtKontrolaPostotka.@Poruka" if="~dtKontrolaPostotka.@Id==1" />
                  <action type="control focus" value="#txtPostotak"/>
                </action>
                <action if="~dtKontrolaPostotka.@Id==0&amp;&amp;~dtKontrolaBlokade.@IndGreska==0">
                  <action type="datarun nonquery" value="~dtDodajTrosak" />
                  <action type="control refreshvalue" value="#grdTrosak" />
                  <action type="control refreshvalue" value="#srcOrgShema,#txtPostotak"/>
                  <action type="control focus" value="#srcOrgShema"/>
                </action>
              </event>
            </button>
          </item>
        </group>
        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,1" >
          <item col="1" row="1">
            <grid caption="" name="grdTrosak" dataname="dtTrosak" fieldsmartspaces="false" autopopulate="true" bestfitonrefresh="true" >
              <fields inherited="true">
              </fields>
              <menu>
                <menuitem caption="Obriši" name="menObrisi" sort="1">
                  <event type="click">
                    <action type="datarun reader" value="~dtObrisi" />
                    <action type="control populate" value="#grdTrosak" />
                  </event>
                </menuitem>
                <menuitem caption="Obriši sve" name="menObrisiSve" sort="1">
                  <event type="click">
                    <action type="datarun reader" value="~dtObrisiSve" />
                    <action type="control populate" value="#grdTrosak" />
                  </event>
                </menuitem>
              </menu>
            </grid>
          </item>
        </group>
        <group cols="1" rows="1" col="1" row="3" spacing="2,2,1,2" >
          <item col="1" row="1">
            <grid caption="" name="grdIzmjTro" dataname="dtIzmjTro" fieldsmartspaces="false" autopopulate="true" key="OSImovinaFilterId" keyfield="OSImovinaFilterId" multiselect="true" showcheckboxes="true" bestfitonrefresh="true">
              <fields inherited="true">
                <field name="Trosak" caption="Mjesto troška"  />
              </fields>
            </grid>
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnIzmjena"  caption="Izmijeni MT" >
          <event type="click">
            <action type="datarun nonquery" value="~dtIzmjenaSpremi" />
            <action type="control populate" value="#grdIzmjTro" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSFilter_AzurCP" name="dtKontrolaPostotka">
        <parameter name="@Action" value="Kontrola_Postotka"/>
        <parameter name="@Postotak" value="#txtPostotak" type="decimal"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtKontrolaBlokade">
        <parameter name="@Action" value="Kontrola_blokade"/>
        <parameter name="@Datum" value="#datDatum" />
      </data>
      <data command="spOSImovinaSmjestaj_HelpCP" name="dtOrgShema">
        <parameter name="@Action" value="OrgShema_src"/>
        <parameter name="@tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtBrisanje">
        <parameter name="@action" value="Izlaz_Brisanje"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtDodajTrosak">
        <parameter name="@action" value="TrosakDodaj"/>
        <parameter name="@OrgShemaId" value="#srcOrgShema"/>
        <parameter name="@Postotak" value="#txtPostotak"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_HelpCP" name="dtTrosak">
        <parameter name="@action" value="Grid_Trosak2Izmjena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_HelpCP" name="dtIzmjTro">
        <parameter name="@action" value="Grid_TrosakIzmjena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjena">
        <parameter name="@action" value="TrosakIzmjena_Spremi"/>
        <parameter name="@SelectedIds" value="$SelectedIds"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtIzmjenaSpremi">
        <parameter name="@Action" value="Trosak_filter"/>
        <parameter name="@SelectedIds" value="#grdIzmjTro.SelectedIds.OSImovinaId"/>
        <parameter name="@DatumDok" value="#datDatum"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtObrisi">
        <parameter name="@action" value="Trosak_Brisanje"/>
        <parameter name="@OSImovinaFilterTrosakId" value="#grdTrosak.@OSImovinaFilterTrosakId"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSFilter_AzurCP" name="dtObrisiSve">
        <parameter name="@action" value="Trosak_BrisanjeSve"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ FILTER - IZMJENA MJESTA TROŠKA**************************************************-->

</root>

