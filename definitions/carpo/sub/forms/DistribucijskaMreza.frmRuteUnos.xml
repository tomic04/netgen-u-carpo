<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmRuteUnos" caption="Unos" width="400" height="200">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="2" caption="Naziv" >
					<textedit name="txtNaziv" >
					</textedit> 
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" >
					<event type="click">
						<action type="datarun nonquery" value="~dtRuteInsert" />
						<action type="control populate" value="parent.#tree" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" >
				</button>				
			</buttons>
		</panelbuttons>
        <datalist>
            <data command="spRuteInsert" name="dtRuteInsert">
                <parameter name="@RajonId" value="$Id" />
				<parameter name="@parentid" value="$parentid" />
				<parameter name="@Naziv" value="#txtNaziv" />
            </data>	
		</datalist>		
	</form>
</root>	