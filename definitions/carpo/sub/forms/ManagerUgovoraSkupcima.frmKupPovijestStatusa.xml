<root>
	<form name="frmKupPovijestStatusa" caption="Povijest statusa" width="550" height="400" saveformsize="false"> 
    <event type="shown">
        <action type="control populate" value="#grdPovijest" />
    </event>
		<layout>
            <group rows="1" cols="1">
                <item row="1" col="1">
                    <grid name="grdPovijest" dataname="~dtPopuniPovijest"  bestfitonrefresh="true">
                    </grid>      
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
               <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_KupUgoStatus" name="dtPopuniPovijest">
                <parameter name="@action" value="0" />
                <parameter name="@id" value="$KupUgovoriGlaId" />
            </data>
        </datalist>
	</form> 
</root>
