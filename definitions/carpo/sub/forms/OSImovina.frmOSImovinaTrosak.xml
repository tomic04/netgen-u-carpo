<root>

  <!--******************************************UNOS / IZMJENA MJESTA TROŠKA****************************************-->
  <form name="frmOSImovinaTrosak" caption="$Caption" fixedsize="false" width="500" >
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSTrosakId!=0"/>
    </event>
    <event type="onload">
      <action type="control disable" value="#datDatumOd" if="$OSTrosakId!=0" />
    </event>
    
    <layout textposition="left" >
      <group cols="1" rows="3" spacing="2,2,2,2">
        <item caption="Org.jedinica:" col="1" row="1" >
          <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="dtOrgShema" datavalue="~dtGet.@OrgShemaId" datatext="~dtGet.@NazivOrg"/>
        </item>
        <item caption="Postotak:" col="1" row="2" >
          <textedit name="txtPostotak" datavalue="~dtGet.@Postotak" format="n2" textposition="left"/>
        </item>
        <item caption="Od datum:" row="3" col="1" highlight="false">
          <dateedit name="datDatumOd"  value="now" datavalue="~dtGet.@DatumOd"   />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" function="SpremiMT" >
          <event type="click">
            <action type="datarun reader" value="~dtKontrolaPostotka"/>
            <action type="message" value="~dtKontrolaPostotka.@Poruka" if="~dtKontrolaPostotka.@Id==1" />
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSTrosakId!=0&amp;&amp;~dtKontrolaPostotka.@Id==0"/>
            <action type="datarun nonquery" value="~dtAdd" elseif="$OSTrosakId==0&amp;&amp;~dtKontrolaPostotka.@Id==0" />
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdTrosak"/>
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaTrosak_QueryCP" name="dtOrgShema">
        <parameter name="@Action" value="OrgShema_src"/>
        <parameter name="@tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spOSImovinaTrosak_QueryCP" name="dtGet">
        <parameter name="@Action" value="Trosak_popuni"/>
        <parameter name="@OSTrosakId" value="$OSTrosakId"/>
      </data>
      <data command="spOSImovinaTrosak_AzurCP" name="dtKontrolaPostotka">
        <parameter name="@Action" value="Kontrola_Postotka"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@Postotak" value="#txtPostotak" type="decimal"/>
      </data>
      <data command="spOSImovinaTrosak_AzurCP" name="dtEdit">
        <parameter name="@Action" value="Trosak_izmjena"/>
        <parameter name="@OSTrosakId" value="$OSTrosakId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OrgShemaId" value="#srcOrgShema"/>
        <parameter name="@Postotak" value="#txtPostotak" type="decimal"/>
        <parameter name="@DatumOd" value="#datDatumOd"/>
      </data>
      <data command="spOSImovinaTrosak_AzurCP" name="dtAdd">
        <parameter name="@Action" value="Trosak_unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OrgShemaId" value="#srcOrgShema"/>
        <parameter name="@Postotak" value="#txtPostotak" type="decimal"/>
        <parameter name="@DatumOd" value="#datDatumOd"/>
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ UNOS / IZMJENA MJESTA TROŠKA**************************************************-->
</root>