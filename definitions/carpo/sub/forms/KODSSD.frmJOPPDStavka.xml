<root>


	<!--FORMA ZA UNOS/IZMJENU STATUSA DOPRINOSA-->

	<form name="frmJOPPDStavka" caption ="$caption" width="600">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$LnOOPSSDGlaId!=null"/>
			<action type="datarun reader" value="~dtPrebroj"/>
			<action type="variable value">
				<parameter name="rdo1broj" value="~dtPrebroj.@rdo1broj"/>
				<parameter name="rdo2broj" value="~dtPrebroj.@rdo2broj"/>
				<parameter name="rdo3broj" value="~dtPrebroj.@rdo3broj"/>
				<parameter name="rdo4broj" value="~dtPrebroj.@rdo4broj"/>
			</action>
		</event>
		<event type="load">
			<action type="control disable" value="#cbOpcinaPrebivanja" if="#chkIndJOPPDBezOpcinePrebivanja==true"/>
			<action type="control enable" value="#cbOpcinaPrebivanja" else=""/>
			<action type="control disable" value="#cbOpcinaRada" if="#chkIndJOPPDBezOpcineRada==true"/>
			<action type="control enable" value="#cbOpcinaRada" else=""/>
		</event>
		<event type="shown">
			<action type="control caption" value="#rdoOpcija1">
				<!--<parameter value="Spremi izmjene samo za ovu kombinaciju ({$rdo1broj})"/>-->
				<parameter value="Spremi izmjene za ovu stavku u ovom statusu ({$rdo1broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija2">
				<!--<parameter value="Spremi izmjene za sve kombinacije ove stavke ({$rdo2broj})"/>-->
				<parameter value="Spremi izmjene za ovu stavku u svim statusima ({$rdo2broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija3">
				<!--<parameter value="Spremi izmjene za sve kombinacije ovog statusa ({$rdo3broj})"/>-->
				<parameter value="Spremi izmjene za sve stavke u ovom statusu ({$rdo3broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija4">
				<!--<parameter value="Spremi izmjene za sve kombinacije ({$rdo4broj})"/>-->
				<parameter value="Spremi izmjene za sve stavke u svim statusima ({$rdo4broj})"/>
			</action>
		</event>

		<layout>
			<group cols="1" rows="4" groupbordervisible="false">
				<!--grupa s katalozima joppd-->
				<group cols="1" rows="5"  col="1" row="1"  spacing="2,2,2,2"  groupbordervisible="false">
					<item caption="Osiguranik (JOPPD):" col="1" row="1" highlight="False" textposition="left">
						<searchedit name="srcKODOsiguranici" fieldtext="OS_TextId" fieldvalue="KODOsiguraniciId" dataname="dtSrcKODOsiguranici" datavalue="~dtGet.@KODOsiguraniciId" datatext="~dtGet.@OS_TextId"/>
					</item>
					<item caption="Primitak (JOPPD):" col="1" row="2" highlight="False"  textposition="left">
						<searchedit name="srcKODPrimici" fieldtext="KP_TextId" fieldvalue="KODPrimiciId" dataname="dtSrcKODPrimici" datavalue="~dtGet.@KODPrimiciId" datatext="~dtGet.@KP_TextId"/>
					</item>
					<item caption="Neoporezivi primitak (JOPPD):" col="1" row="3"   highlight="False" textposition="left">
						<searchedit name="srcKODNeoporeziviPrimici" fieldtext="KNP_TextId" fieldvalue="KODNeoporeziviPrimiciId" dataname="dtsrcKODNeoporeziviPrimici" datavalue="~dtGet.@KODNeoporeziviPrimiciId" datatext="~dtGet.@KNP_TextId"/>
					</item>
					<item caption="Način plaćanja (JOPPD):" col="1" row="4"  highlight="False" textposition="left">
						<searchedit name="srcKODNaciniIsplate" fieldtext="KNI_TextId" fieldvalue="KODNaciniIsplateId" dataname="dtsrcKODNaciniIsplate" datavalue="~dtGet.@KODNaciniIsplateId" datatext="~dtGet.@KNI_TextId"/>
					</item>
					<item caption="Beneficirani staž (JOPPD):" col="1" row="5"  highlight="False" textposition="left">
						<searchedit name="srcKODBeneficirani" fieldtext="KB_TextId" fieldvalue="KODBeneficiraniId" dataname="dtsrcKODBeneficirani" datavalue="~dtGet.@KODBeneficiraniId" datatext="~dtGet.@KB_TextId"/>
					</item>
					<!--<item caption="Razdoblje (JOPPD):" col="1" row="6" highlight="False"  textposition="left">
            <comboedit name="cbKODJOPPDRazdoblje" dataname="dtKODJOPPDRazdoblje" valuefield="KODJOPPDRazdobljeId" displayfield="KR_Naziv" datavalue="~dtGet.@KODJOPPDRazdobljeId" datatext="~dtGet.@KR_Naziv"/>
          </item>-->
				</group>

				<!--grupa s podacima o općinama-->
				<group cols="2" rows="4" col="1" row="2"  groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="50%"></column>
						<column position="2" size="50%"></column>
					</columnsdefinition>
					<item caption="Prvi/zadnji mjesec:" col="1" row="1" highlight="False"  textposition="left">
						<comboedit name="cbPrviZadnjiMjesec" dataname="dtPrviZadnjiMjesec" valuefield="KODPrviZadnjiMjesecId" displayfield="Naziv" datavalue="~dtGet.@KODPrviZadnjiMjesecId" datatext="~dtGet.@KPZM_Naziv"/>
					</item>
					<item caption="Radno vrijeme:" col="2" row="1" highlight="False"  textposition="left" >
						<comboedit name="cbRadnoVrijeme" dataname="dtRadnoVrijeme" valuefield="HRVrsteRVId" displayfield="Naziv" datavalue="~dtGet.@HRVrsteRVId" datatext="~dtGet.@RadnoVrijeme_Naziv"/>
					</item>
					<item caption="Općina prebivanja:" col="1" row="2" highlight="False"  textposition="left">
						<comboedit name="cbOpcinaPrebivanja" dataname="dtOpcinaPrebivanja" valuefield="OOPMjestaPorezId" displayfield="Naziv" datavalue="~dtGet.@OpcinaPrebivanjaId" datatext="~dtGet.@OpcinaPrebivanja_Naziv"/>
					</item>
					<item col="2" row="2" highlight="False">
						<checkedit caption="Fiksno bez općine prebivanja" name="chkIndJOPPDBezOpcinePrebivanja" datavalue="~dtGet.@IndJOPPDBezOpcinePrebivanja"  value="0">
							<event type="valuechanged">
								<action type="control disable" value="#cbOpcinaPrebivanja" if="#chkIndJOPPDBezOpcinePrebivanja==true"/>
								<action type="control enable" value="#cbOpcinaPrebivanja" else=""/>
							</event>
						</checkedit>
					</item>
					<item caption="Općina rada:" col="1" row="3" highlight="False"  textposition="left">
						<comboedit name="cbOpcinaRada" dataname="dtOpcinaRada" valuefield="OOPMjestaPorezId" displayfield="Naziv" datavalue="~dtGet.@OpcinaRadaId" datatext="~dtGet.@OpcinaRada_Naziv"/>
					</item>
					<item col="2" row="3" highlight="False">
						<checkedit caption="Fiksno bez općine rada" name="chkIndJOPPDBezOpcineRada" datavalue="~dtGet.@IndJOPPDBezOpcineRada"  value="0">
							<event type="valuechanged">
								<action type="control disable" value="#cbOpcinaRada" if="#chkIndJOPPDBezOpcineRada==true"/>
								<action type="control enable" value="#cbOpcinaRada" else=""/>
							</event>
						</checkedit>
					</item>
					<item caption="Prioritet JOPPD:" col="1" row="4" highlight="False"  textposition="left" >
						<textedit name="txtPrioritetStJOPPD" datavalue="~dtGet.@KODJOPPDPrioritet" tooltip="Prioritet prilikom određivanja redosljeda obračuna!" format="n0" type="int"/>
					</item>

				</group>
				<!--grupa s chk boxovima prikazi dana-->
				<group cols="3" rows="1" col="1" row="3"  spacing="2,2,2,2"  groupbordervisible="true">
					<columnsdefinition>
						<column position="1" size="33%"></column>
						<column position="2" size="33%"></column>
						<column position="3" size="34%"></column>
					</columnsdefinition>
					<item col="1" row="1" highlight="False">
						<checkedit caption="Prikaži dane u polju 10" name="chkIndJOPPDDani10" datavalue="~dtGet.@IndJOPPDDani10"  value="0"/>
					</item>
					<item col="2" row="1" highlight="False">
						<checkedit caption="Prikaži sate u polju 10.2" name="chkIndJOPPDSati2" datavalue="~dtGet.@IndJOPPDSati2"  value="0"/>
					</item>
					<item col="3" row="1" highlight="False">
						<checkedit caption="Prikaži plaću u polju 17" name="chkIndJOPPDPlaca17" datavalue="~dtGet.@IndJOPPDPlaca17" value="1"  />
					</item>

				</group>
				<group cols="1" rows="5" col="1" row="4" entermovenextcontrol="true"  spacing="2,2,2,2"  groupbordervisible="false">
					<rowsdefinition>
						<row position ="1" size="20"/>
					</rowsdefinition>
					<item row="1" col="1" caption="Opcija spremanja:" highlight="False">
					</item>
					<item row="2" col="1" highlight="False">
						<radioedit name="rdoOpcija1" caption="" value="true" >
						</radioedit>
					</item>
					<item row="3" col="1" highlight="False">
						<radioedit name="rdoOpcija2" caption="" >
						</radioedit>
					</item>
					<item row="4" col="1" highlight="False">
						<radioedit name="rdoOpcija3" caption="" >
						</radioedit>
					</item>
					<item row="5" col="1" highlight="False">
						<radioedit name="rdoOpcija4" caption="" >
						</radioedit>
					</item>
				</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- Provjeri required fields -->
						<action type="validate" />
						<!-- Okini storu -->
						<action type="datarun reader" value="~dtSpremi"/>
						<action type="message" value="~dtSpremi.@poruka"/>

						<!-- Osvježi grid na parent formi -->
						<action type="control populate" value="parent.#grdStatusi"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spLnOOPSSDGlaAzur" name="dtGet">
				<parameter name="@Action" value="Dohvat_izmjena" type="string"/>
				<parameter name="@LnOOPSSDGlaId" value="$LnOOPSSDGlaId" type="int"/>
			</data>


			<data command="spLnOOPSSDGlaAzur" name="dtSpremi">
				<parameter name="@Action" value="izmjena" type="string"/>
				<parameter name="@LnOOPSSDGlaid" value="$LnOOPSSDGlaId" type="int"/>
				<parameter name="@KODOsiguraniciId" value="#srcKODOsiguranici" type="int"/>
				<parameter name="@KODPrimiciId" value="#srcKODPrimici" type="int"/>
				<parameter name="@KODBeneficiraniId" value="#srcKODBeneficirani" type="int"/>
				<parameter name="@KODNeoporeziviPrimiciId" value="#srcKODNeoporeziviPrimici" type="int"/>
				<parameter name="@KODNaciniIsplateId" value="#srcKODNaciniIsplate" type="int"/>
				<parameter name="@indPostavkaZaStavku" value="1" type="int" if="#rdoOpcija1==true"/>
				<parameter name="@indPostavkaZaStavkuSvihStatusa" value="1" type="int" if="#rdoOpcija2==true"/>
				<parameter name="@indPostavkaZaSveStavkeUStatusu" value="1" type="int" if="#rdoOpcija3==true"/>
				<parameter name="@indPostavkaZaSveStavkeSvihStatusa" value="1" type="int" if="#rdoOpcija4==true"/>
				<!--<parameter name="@KODJOPPDRazdobljeId" value="#cbKODJOPPDRazdoblje" type="int"/>-->
				<parameter name="@KODPrviZadnjiMjesecId" value="#cbPrviZadnjiMjesec" type="int"/>
				<parameter name="@HRVrsteRVId" value="#cbRadnoVrijeme" type="int"/>
				<!--<parameter name="@OpcinaRadaId" value="#cbOpcinaRada" type="int"/>
        <parameter name="@OpcinaPrebivanjaId" value="#cbOpcinaPrebivanja" type="int"/>-->
				<parameter name="@OpcinaRadaId" value="#cbOpcinaRada" type="int" if="#chkIndJOPPDBezOpcineRada==false"/>
				<parameter name="@OpcinaRadaId" value="null" else="" />
				<parameter name="@OpcinaPrebivanjaId" value="#cbOpcinaPrebivanja" type="int" if="#chkIndJOPPDBezOpcinePrebivanja==false"/>
				<parameter name="@OpcinaPrebivanjaId" value="null" else="" />
				<parameter name="@indJOPPDSati2" value="#chkIndJOPPDSati2" />
				<parameter name="@indJOPPDDani10" value="#chkIndJOPPDDani10" />
				<parameter name="@indJOPPDPlaca17" value="#chkIndJOPPDPlaca17" />
				<parameter name="@IndJOPPDBezOpcinePrebivanja" value="#chkIndJOPPDBezOpcinePrebivanja" />
				<parameter name="@IndJOPPDBezOpcineRada" value="#chkIndJOPPDBezOpcineRada" />
				<parameter name="@KODJOPPDPrioritet" value="#txtPrioritetStJOPPD" />
			</data>
			<data command="spLnOOPSSDQuery" name="dtPrebroj">
				<parameter name="@Action" value="Brojanje" type="string"/>
				<parameter name="@oopstavkeid" value="$oopstavkeid" type="int"/>
				<parameter name="@hrdopstatusiid" value="$hrdopstatusiid" type="int"/>
				<parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
				<parameter name="@Tip" value="$Tip" />
			</data>


			<data command="spLnOOPSSDHelp" name="dtSrcKODOsiguranici">
				<parameter name="@action" value="trazilica_kodosiguranici"/>
				<parameter name="@Tekst" value="#srckodosiguranici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODPrimici">
				<parameter name="@action" value="trazilica_kodprimici"/>
				<parameter name="@Tekst" value="#srckodprimici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODNeoporeziviPrimici">
				<parameter name="@action" value="trazilica_kodneoporeziviprimici"/>
				<parameter name="@Tekst" value="#srckodneoporeziviprimici.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODBeneficirani">
				<parameter name="@action" value="trazilica_kodbeneficirani"/>
				<parameter name="@Tekst" value="#srckodbeneficirani.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtSrcKODNaciniIsplate">
				<parameter name="@action" value="trazilica_kodnaciniisplate"/>
				<parameter name="@Tekst" value="#srckodnaciniisplate.text"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtKODJOPPDRazdoblje">
				<parameter name="@action" value="combo_razdoblje"/>
			</data>

			<data command="spLnOOPSSDHelp" name="dtPrviZadnjiMjesec">
				<parameter name="@action" value="combo_prvi_zadnji_mjesec"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtOpcinaRada">
				<parameter name="@action" value="combo_opcina"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtOpcinaPrebivanja">
				<parameter name="@action" value="combo_opcina"/>
			</data>
			<data command="spLnOOPSSDHelp" name="dtRadnoVrijeme">
				<parameter name="@action" value="combo_radno_vrijeme"/>
			</data>

		</datalist>
	</form>


	<!--kraj FORMA ZA UNOS DOPRINOSA-->
</root>