<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmDonosUcinakAgrar" caption ="$caption" width="450" height="215"  fixedsize="true" saveformsize="false" showversion="true" version="1">


    <layout>

      <group cols="1" rows="3"  groupbordervisible="true">


        <item col="1" row="1" fontsizedelta="1"  highlight="False" textposition="right">
          <checkedit name="chkObracunUcinka"  caption="napravi obračun učinka" fontsizedelta="3" />
        </item>
        <item col="1" row="2" fontsizedelta="1"  highlight="False" textposition="right">
          <checkedit name="chkBrisanjePrijenosaUcinka" caption="obriši prethodni prijenos obračuna učinka" fontsizedelta="3" />
        </item>
        <item col="1" row="3"  fontsizedelta="1"  highlight="False" textposition="right">
          <checkedit name="chkPrijenosObracunaUcinka" caption="napravi prijenos obračuna učinka u plaću" fontsizedelta="3" />
        </item>

      </group>


    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnObracunaj" caption="IZVRŠI" >
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />

            <!-- Okini storu -->
              <action type="datarun reader" value="~dtPrijenos" waittype="progress" waitcaption="Pričekajte..." waittext="..izvršavanje u tijeku..." >
                
              </action>
              <action type="message" value="~dtPrijenos.@Poruka8000"/>
            <action type="control populate" value="parent.#grdPlace"/>

          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spUcinakAgrar_PrijenosUPlace" name="dtPrijenos">
        <parameter name="@tekst" value="global.$Oznaka" type="string"/>
        <parameter name="@check2" value="#chkObracunUcinka"/>
        <parameter name="@check3" value="#chkBrisanjePrijenosaUcinka"/>
        <parameter name="@check4" value="#chkPrijenosObracunaUcinka"/>
      </data>
    </datalist>
  </form>


</root>