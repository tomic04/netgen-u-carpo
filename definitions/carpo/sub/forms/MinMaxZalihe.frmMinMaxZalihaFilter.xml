<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmMinMaxZalihaFilter" caption="Filter" width="400" height="80">
	<event type="init">
		<!-- <action type="control value" value="#chkSva">
				<parameter value="1"></parameter>
			</action> -->
			<action type="datarun reader" value="~dtGet" />
	</event>
	<event type="load">
	<!--	<action type="control value" value="#chkSva">
				<parameter value="$indKolicina"></parameter>
		</action> -->
	</event>
		<layout>
				<group cols="1" rows="3">
					<item col="1" row="1" caption="Skladište:" >
						<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis"  dataname="dtSkladiste" required="true" datavalue="#dtGet.@skladisteid" datatext="#dtGet.@opis">
						</comboedit>
					</item>
					<item col="1" row="2" >
						<checkedit name="chkSva" value="false" savevalue="app" caption="Prikaži samo artikle koji imaju definirane količine">
						</checkedit>
					</item>
						<item col="1" row="3" >
						<checkedit name="chkPromet"  value="false" savevalue="app" caption="Prikaži samo artikle koji su imali promet na skladištu"/>
					</item>
				</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="Spremi" dock="left">
						<event type="click">
							<action type="validate"/>
							<action type="variable value" value="parent.$skladiste">
								<parameter value="#cmbSkladiste"/>
							</action>
							<action type="variable value" value="parent.$indKolicina">
								<parameter value="#chkSva"/>
							</action>
							<action type="variable value" value="parent.$indPromet">
								<parameter value="#chkPromet"/>
							</action>
							<action type="form close">
							</action> 
						</event>
					</button>
					<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
						<event type="click">
								<action type="form close">
							</action>
						</event>					
					</button>
				</buttons>
		</panelbuttons> 
		<datalist>
			<data command="spNG_Combo" name="dtSkladiste">
				<parameter name="@Action" value="skladiste"/>
				<parameter name="@Ind" value="1"/> 
			</data>
			<data command="spSktMinMaxZalihaZadnjeSkladiste" name="dtGet">
				<parameter name="@operateriId" value="@@operateriId" />
			</data>				
		</datalist>
	</form>
</root>