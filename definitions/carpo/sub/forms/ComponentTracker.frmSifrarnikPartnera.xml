<root>
	<form name="frmSifrarnikPartnera" caption="Šifrarnik partnera">
        <event type="load">
            <action type="control populate" value="#grdSifrarnikPartnera" />
        </event>
        <event type="close">
            <action type="control populate" value="parent.#trTree" if="global.$filter==Partneri"/>
        </event>
        <layout>
            <group cols="1" rows="1">
                <item row="1" col="1" height="396" width="380">
                    <grid name="grdSifrarnikPartnera" key="id" dataname="~dtGetSifrarnikPartnera" multiselect="false" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false">
                        <fields inherited="true">
                            <field name="Naziv" minwidth="300" />
                        </fields>
                    </grid>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodajPartnera" caption="Dodaj">
                    <event type="click">
                        <action type="form open" value="frmDodajPartnera" />
                    </event>
                </button>
                <button name="btnObrisiPartnera" caption="Obriši">
                    <event type="click">
                        <action type="confirm" value="Želite li sigurno obrisati ovu stavku?">
                            <action type="datarun nonquery" value="~dtDeletePartner" />
                            <action type="control populate" value="#grdSifrarnikPartnera" />
                        </action>
                    </event>
                </button>
                <button name="btnCancel" caption="Odustani" dock="right">
                    <event type="click">
                        <action type="formclose" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtGetSifrarnikPartnera">
                <parameter name="@Action" value="getPartneri" />
            </data>
            <data command="spComponentTrackerAzur" name="dtDeletePartner">
                <parameter name="@Action" value="deletePartner" />
                <parameter name="@CustomerId" value="#grdSifrarnikPartnera.@id" />
            </data>
        </datalist>
    </form>
</root>