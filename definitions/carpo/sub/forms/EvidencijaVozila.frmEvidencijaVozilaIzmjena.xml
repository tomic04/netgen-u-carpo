<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmEvidencijaVozilaIzmjena" caption="Izmjeni" width="400" height="300">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet"></action>
		</event>
		<event type="onload">
			<action type="control disable" value="#srcPartner,#txtregistracija"></action>
		</event>
		<layout>
			<group cols="1" rows="3">
				<item caption="Prijevoznik:" row="1" col="1" fontbold="true">
					<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" required="true" fontbold="true" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@Prijevoznik">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtOdgovornaOsoba"/>
							<action type="control populate" value="#cmbOsobe" />
						</event>
					</searchedit>
				</item>
				<item caption="Registracija:" row="2" col="1">
					<textedit name="txtRegistracija" required="true" datavalue="#dtGet.@Registracija">
					</textedit>
				</item>
				<item caption="Vozač:" row="3" col="1">
					<comboedit name="cmbOsobe" enabled="true" valuefield="OsobeId" displayfield="Naziv" datavalue="#dtGet.@VozacId" dataname="dtOdgovornaOsoba" required="true">
					</comboedit>
				</item>
			</group>
		</layout>
		
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtEvidencijaVozilaUpdate">
						</action>
						<action type="form close"/>
					</event>
				</button>
                <button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
		<data command="spEvidencijaVozilaQuery" name="dtGet">
			<parameter name="@kamionid" value="$kamionid" />  
		</data>
			<data command="spTrazipartneri" name="dtPartneri">
				<parameter name="@Action" value="1" />
				<parameter name="@Uvijet" value="Naziv" />
			</data>
		<data command="spOsobeQuery" name="dtOdgovornaOsoba">
            <parameter name="@Action" value="2" />
			<parameter name="@Id" value="#srcPartner" />
        </data>
		<data command="spEvidencijaVozilaUpdate" name="dtEvidencijaVozilaUpdate">
			<parameter name="@kamionid" value="$kamionid" />
			<parameter name="@Vozacid" value="#cmbOsobe" />
        </data>

		</datalist>
	</form>
</root>