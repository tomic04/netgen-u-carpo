<?xml version="1.0" encoding="utf-8"?>
<root>

  <!--******************************************UNOS/IZMJENA GLAVE****************************************-->
  <form name="frmOSPrometFin_Unos" caption="Promet imovine" fixedsize="false" width="1100" height="600" >
    <!--init pri podizanju-->
    <event type="oninit">
      <action type="datarun reader" value="~dtVrstaDok" />
      <action type="datarun reader" value="~dtOdgovornaOsoba" />
      <action type="datarun reader" value="~dtGet" if="$OSPrometGlaId!=0" />
      <!--deklariraj varijablu $OsobeId da znaš defaultno postaviti prilikom unosa novog dokumenta-->
      <action type="variable value">
        <parameter name="OsobeId" value="308" type="int"></parameter>
      </action>
      <action type="variable value">
        <parameter name="OsvjeziGrid" value="0" type="int"></parameter>
      </action>
    </event>

    <!--enable/disable gumba-->
    <event type="onload">
      <action type="control disable" value="#btnIns" if="$OSPrometGlaId==0" />
      <action type="control disable" value="#btnEdit,#btnDel" />
      <action type="control disable" value="#cmbVrstaDok" if="$OSPrometGlaId!=0" />
      <action type="control populate" value="#grdStavke" if="$OSPrometGlaId!=0" />
    </event>

    <event type="onshown">
      <action type="control focus" value="cmbVrstaDok" />
      <action type="control value" value="#cmbOsobe"  if="$OSPrometGlaId==0">
        <parameter value="$OsobeId" type="int"></parameter>
      </action>
    </event>
    <!--layout - forma za unos/izmjenu-->
    <layout textposition="left" itemspadding="3">
      <group cols="1" rows="2"  backgroundcolor="#f5f5f5" groupbordervisible="false" >
        <!--GLAVA DOKUMENTA-->
        <group cols="3" rows="2" col="1" row="1" backgroundcolor="#f5f5f5" spacing="2,2,2,1">
          <columnsdefinition>
            <column  position="2" size="50%" />
          </columnsdefinition>
          <item caption="Vrsta dokumenta:" row="1" col="1" highlight="false">
            <comboedit name="cmbVrstaDok"  required="true" valuefield="VrstaDokId" displayfield="Naziv" datavalue="~dtGet.@VrstaDokId" dataname="~dtVrstaDok" />
          </item>
          <item caption="Datum dokumenta:" row="2" col="1" highlight="false">
            <dateedit name="datTemDatum"  datavalue="~dtGet.@TemDatum" value="now" required="true" />
          </item>
          <item caption="Broj dokumenta:" row="1" col="2" highlight="false">
            <textedit name="txtBroj" datavalue="~dtGet.@Broj"  enabled="false" fontbold="true" nulltext="&lt;novi dokument&gt;"/>
          </item>
          <item caption="Odgovorna osoba:" row="2" col="2" highlight="false">
            <comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" datavalue="~dtGet.@OsobeId" dataname="~dtOdgovornaOsoba" required="true"/>
          </item>
          <!--btnSPREMI NA GLAVI-->
          <group cols="1" rows="1" row="2" col="3" groupbordervisible="false" >
            <columnsdefinition>
              <column  position="1" size="80" />
            </columnsdefinition>
            <rowsdefinition>
              <row size="40" position="1" />
            </rowsdefinition>
            <item caption="" row="1" col="1" highlight="false">
              <button name="btnSpremi"  caption="Spremi" type="add"  >
                <event type="click">
                  <action type="validate"/>
                  <action type="datarun reader" value="~dtOSPrometGlaIns" />
                  <action type="message" value="~dtOSPrometGlaIns.@Poruka" if="~dtOSPrometGlaIns.@IndGreska==1"/>
                  <action type="control value" value="#txtBroj" >
                    <parameter value="~dtOSPrometGlaIns.@Broj" />
                  </action>
                  <action type="variable value"  >
                    <parameter name="OSPrometGlaId" value="~dtOSPrometGlaIns.@OSPrometGlaId" type="int" />
                  </action>
                  <action type="control enable" value="#btnIns" if="$OSPrometGlaId!=0" />
                  <action type="control enable" value="#btnEdit" if="#grdStavke.rowcount!=0" />
                  <action type="control enable" value="#btnDel" if="#grdStavke.rowcount!=0" />
                  <action type="control disable" value="#btnIns" if="~dtOSPrometGlaIns.@IndGreska==1" />
                  <action type="control disable" value="#cmbVrstaDok" if="$OSPrometGlaId!=0" />
                  <action if="#grdStavke.rowcount==0&amp;&amp;~dtOSPrometGlaIns.@IndGreska!=1" type="form open" value="frmOSPrometFin_UnosDet" >
                    <parameter name="OSImovinaId" value="$OSImovinaId"/>
                    <parameter name="OSPrometGlaId" value="~dtOSPrometGlaIns.@OSPrometGlaId" type="int" />
                    <parameter name="OSPrometDetId" value="0" type="int" />
                    <parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" />
                    <parameter name="akcija" value="unos stavke"  />
                    <parameter name="DatumPromjene" value="#datTemDatum" type="date" />
                  </action>
                  <action type="control populate" value="#grdStavke" />
                </event>
              </button>
            </item>
          </group>
        </group >
        <!--GRID SA STAVKAMA-->
        <group cols="1" rows="2" col="1" row="2" backgroundcolor="#f5f5f5" spacing="2,2,1,2">
          <group cols="1" rows="1" col="1" row="1" backgroundcolor="#f5f5f5" spacing="2,2,2,1">
            <item caption="" row="1" col="1">
              <grid name="grdStavke" dataname="dtStavke" key="OSPrometDetId" keyfield="OSPrometDetId" type="master" multiselect="true" bestfitonrefresh="True" fieldsmartspaces="false">
                <event type="focusedrowchanged">
                  <action type="control disable" value="#btnIns" if="#grdStavke.rowcount!=0" />
                  <action type="control enable" value="#btnEdit" if="#grdStavke.rowcount!=0" />
                  <action type="control disable" value="#btnEdit" else="" />
                  <action type="control enable" value="#btnDel" if="#grdStavke.rowcount!=0" />
                  <action type="control disable" value="#btnDel" else="" />
                </event>
              </grid>
            </item>
          </group>
          <!--GUMBI DETALJA-->
          <group cols="6" rows="1" col="1" row="2" backgroundcolor="#f5f5f5" spacing="2,2,1,2">
            <columnsdefinition>
              <column  position="1" size="80" />
              <column  position="2" size="80" />
              <column  position="3" size="80" />
            </columnsdefinition>
            <rowsdefinition>
              <row size="40" position="1" />
            </rowsdefinition>
            <item caption="" row="1" col="1">
              <button name="btnIns"  caption="Unos" type="add"  >
                <event type="click">
                  <action type="variable value" value="OSPrometDetId" >
                    <parameter value="#grdStavke.@OSPrometDetId" type="int" />
                  </action>
                  <action type="form open" value="frmOSPrometFin_UnosDet" >
                    <parameter name="OSImovinaId" value="$OSImovinaId"/>
                    <parameter name="OSPrometGlaId" value="$OSPrometGlaId" type="int" />
                    <parameter name="OSPrometDetId" value="0" type="int" />
                    <parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" />
                    <parameter name="akcija" value="unos stavke"  />
                    <parameter name="DatumPromjene" value="#datTemDatum" type="date" />
                    <parameter name="Tip" value="Unos"  />
                  </action>
                  <action type="control populate" value="#grdStavke" >
                    <action type="control focus" value="#grdStavke" >
                      <parameter value="$OSPrometDetId" />
                    </action>
                  </action>
                </event>
              </button>
            </item>
            <item caption="" row="1" col="2">
              <button name="btnEdit"  caption="Izmjena" type="edit"  >
                <event type="click">
                  <action type="form open" value="frmOSPrometFin_UnosDet" >
                    <parameter name="OSPrometGlaId" value="$OSPrometGlaId" type="int" />
                    <parameter name="OSPrometDetId" value="#grdStavke.@OSPrometDetId" type="int" />
                    <parameter name="OSImovinaId" value="$OSImovinaId"/>
                    <parameter name="VrstaDokId" value="#cmbVrstaDok" type="int" />
                    <parameter name="akcija" value="izmjena stavke"  />
                    <parameter name="Tip" value="Izmjena"  />
                  </action>
                  <action type="control populate keepfocus" value="#grdStavke" />
                </event>
                <menuitem control="#grdStavke" />
              </button>
            </item>
            <item caption="" row="1" col="3">
              <button name="btnDel" caption="Brisanje" type="del" >
                <event type="click">
                  <action type="confirm" value="Želite li obrisati označene stavke?">
                    <action type="datarun nonquery" value="~dtDelStavke">
                      <action type="control populate" value="#grdStavke" >
                        <action type="control focus" value="#grdStavke" >
                          <parameter value="0"  />
                        </action>
                      </action>
                    </action>
                  </action>
                </event>
                <!-- KONTROLA: MENUITEM MASTER -->
                <menuitem control="#grdStavke" />
              </button>
            </item>
          </group>
        </group >
      </group >
    </layout>
    <!--GUMBI FORME-->
    <panelbuttons>
      <buttons>
        <!--zaključavanje dokumenta omogućeno na menuitem u granuli imovina-->
        <!--<button name="btnZakljuciDok" caption="Zaključi dokument" type="add" dock="right">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtZakljuciDok">
						</action>
						<action type="variable value" value="parent.OSPrometGlaId" >
							<parameter value="$OSPrometGlaId" type="int" />
						</action>
            <action type="variable value" value="parent.OsvjeziGrid" >
              <parameter value="$OSPrometGlaId" type="int" />
            </action>            
						<action type="form close"/>
					</event>
				</button>-->
        <button caption="IZLAZ" type="cancel" dock="right" >
          <event type="click" >
            <action type="variable value" value="parent.OSPrometGlaId" if="$OSPrometGlaId!=0" >
              <parameter value="$OSPrometGlaId" type="int" />
            </action>
            <!--za svaki slučaj vrati varijablu OsvjeziGrid=0-->
            <action type="variable value" value="parent.OsvjeziGrid" >
              <parameter value="0" type="int" />
            </action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <!--DATALISTS-->
    <datalist>
      <data command="spOSPrometFin_GlaAzur" name="dtOSPrometGlaIns">
        <parameter name="@Action" value="0" />
        <parameter name="@OSPrometGlaId" value="$OSPrometglaId" />
        <parameter name="@VrstaDokId" value="#cmbVrstaDok" />
        <parameter name="@TemDatum" value="#datTemDatum" />
        <parameter name="@OsobeId" value="#cmbOsobe" />
        <parameter name="@OperateriId" value="@@OperateriId" />
      </data>
      <data command="spOSPrometFin_Help" name="dtVrstaDok">
        <parameter name="@action" value="vrstadok" />
      </data>
      <data command="spOSobeQuery" name="dtOdgovornaOsoba">
        <parameter name="@action" value="16" />
      </data>
      <data command="spOSPrometFin_Query" name="dtStavke">
        <parameter name="@action" value="stavke_imovina" />
        <parameter name="@OSPRometGlaId" value="$OSPrometGlaId" />
        <parameter name="@OSImovinaId" value="$OSImovinaId" />
      </data>
      <data command="spOSPrometFin_Query" name="dtGet">
        <parameter name="@action" value="glava" />
        <parameter name="@OSPRometGlaId" value="$OSPrometGlaId" />
      </data>
      <data command="spOSPrometFin_DetAzur" name="dtDelStavke">
        <parameter name="@Action" value="2" />
        <parameter name="@SelectedIds" value="#grdStavke.selectedids" />
      </data>
      <data command="spOSPrometFin_GlaAzur" name="dtZakljuciDok">
        <parameter name="@Action" value="10" />
        <parameter name="@OSPrometglaId" value="$OSPrometglaId" />
      </data>
    </datalist>
  </form>
  <!--**************************************KRAJ UNOS/IZMJENA GLAVE****************************************-->


  <!--******************************************UNOS/IZMJENA STAVAKA****************************************-->
  <form name="frmOSPrometFin_UnosDet" caption="Promet imovine: {parent.#cmbVrstaDok.text} {parent.#txtBroj} - {$akcija}"  width="1000" fixedsize="true"  >
    <event type="oninit">
      <action type="datarun reader" value="~dtImovinaOpci" />
      <action type="datarun reader" value="~dtOSDokumenti" />
      <action if="$OSPrometDetId!=0" type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtOSTraziIzvorniDokValidate" />
      <action type="variable value" >
        <parameter name="Req" value="~dtOSTraziIzvorniDokValidate.@Postavka" />
      </action>
    </event>
    <event type="onload">
      <!--<action type="control disable" value="#srcOSImovina" />-->
      <action type="control disable" value="#txtKolUlaz" if="~dtOSDokumenti.@KolUlaz==0" />
      <action type="control disable" value="#txtKolUlaz" if="~dtOSDokumenti.@KolUlaz==0" />
      <action type="control disable" value="#txtKolIzlaz" if="~dtOSDokumenti.@KolIzlaz==0" />
      <action type="control disable" value="#txtNabavaDug" if="~dtOSDokumenti.@NabavaDug==0" />
      <action type="control disable" value="#txtNabavaPot" if="~dtOSDokumenti.@NabavaPot==0" />
      <action type="control disable" value="#txtOtpisDug" if="~dtOSDokumenti.@OtpisDug==0" />
      <action type="control disable" value="#txtOtpisPot" if="~dtOSDokumenti.@OtpisPot==0" />
      <action type="control disable" value="#btnKartica" if="$OSImovinaid==null" />
      <!--<action type="control disable" value="#btnNabavaRoot" if="#cmbNabavaRoot==null" />
      <action type="control disable" value="#cmbNabavaRoot" if="#cmbNabavaRoot==null" />-->
      <action type="control value" value="#datDatumPromjene" if="$OSPrometDetId==0">
        <parameter value="$DatumPromjene"/>
      </action>
      <action type="control attribute" value="#cmbIzvProm">
        <parameter name="required" value="$Req"/>
      </action>
      <action type="control attribute" value="#txtIzvBroj">
        <parameter name="required" value="$Req"/>
      </action>
      <action type="datarun nonquery" value="~dtOSImovinaResetTempAm"  />
      <action type="datarun reader" value="~dtOSImovinaTek" />
      <action type="control value" value="#txtKolTek"  >
        <parameter value="~dtOSImovinaTek.@Kolicina" />
      </action>
      <action type="control value" value="#txtNabavaTek"  >
        <parameter value="~dtOSImovinaTek.@Nabava" />
      </action>
      <action type="control value" value="#txtOtpisTek"  >
        <parameter value="~dtOSImovinaTek.@Otpis" />
      </action>
      <action type="variable value" value="Labela"  >
        <parameter value="~dtOSImovinaTek.@lblStanje" />
      </action>
      <action type="control value" value="#lblStanje"  >
        <parameter value="{$Labela}" />
      </action>
      <action type="control value" value="#txtKolIzlaz"  >
        <parameter value="~dtOSImovinaTek.@KolIzlaz" />
      </action>
      <action type="control value" value="#txtNabavaPot"  >
        <parameter value="~dtOSImovinaTek.@NabavaPot" />
      </action>
      <action type="control value" value="#txtOtpisDug"  >
        <parameter value="~dtOSImovinaTek.@OtpisDug" />
      </action>
      <action type="control enable" value="#txtKolIzlaz" if="~dtOSDokumenti.@KolIzlaz==1" />
      <action type="control disable" value="#txtKolIzlaz" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
      <action type="control enable" value="#txtNabavaPot" if="~dtOSDokumenti.@NabavaPot==1" />
      <action type="control disable" value="#txtNabavaPot" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
      <action type="control enable" value="#txtOtpisDug" if="~dtOSDokumenti.@OtpisDug==1" />
      <action type="control disable" value="#txtOtpisDug" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
    </event>

    <event type="onshown">
      <!--<action type="control populate" value="cmbNabavaRoot" >
        <action type="control value" value="#cmbNabavaRoot" if="~dtGet.@NabavaRootId!=null">
          <parameter value="~dtGet.@NabavaRootId" />
        </action >
      </action>-->
      <!--<action type="control focus" value="srcOSImovina" />-->
    </event>

    <layout textposition="left" itemspadding="3">
      <group cols="1" rows="3"  backgroundcolor="#f5f5f5">
        <group cols="4" rows="4" col="1" row="1" backgroundcolor="#f5f5f5" alignmode="local" >

          <columnsdefinition>
            <column  position="1" size="20%" />
            <column  position="2" size="30%" />
            <column  position="3" size="80" />
            <column  position="4" size="0%" />
          </columnsdefinition>

          <item caption="Imovina:" row="1" col="1" colspan="2" >
            <textedit name="txtImovina" datavalue="~dtImovinaOpci.@NazivId" readonly="true" />
          </item>

          <item caption="Datum promjene:" row="2" col="1">
            <dateedit name="datDatumPromjene"  datavalue="~dtGet.@DatumPromjene" value="$DatumPromjene" required="true" nulltext="now" readonly="true"/>
          </item>

          <item caption="Veza na nabavu:" row="3" col="1" colspan="2" >
            <comboedit name="cmbNabavaRoot"  required="false" enabled="true" valuefield="NabavaRootId" displayfield="Naziv" datavalue="~dtGet.@NabavaRootId" dataname="~dtNabavaRoot" >
              <event type="valuechanged">
                <!--<action type="control enable" value="#btnNabavaRoot" if="#cmbNabavaRoot!=null" />
                <action type="control disable" value="#btnNabavaRoot" else="" />-->
                <action type="datarun reader" value="~dtOSImovinaTek" if="$Tip==Unos" />
                <action type="control value" value="#txtKolTek"  >
                  <parameter value="~dtOSImovinaTek.@Kolicina" />
                </action>

                <action type="variable value" value="t1" >
                  <parameter value="2" type="int" />
                </action>
                <action type="control value" value="#txtNabavaTek"  >
                  <parameter value="~dtOSImovinaTek.@Nabava" />
                </action>
                <action type="control value" value="#txtOtpisTek"  >
                  <parameter value="~dtOSImovinaTek.@Otpis" />
                </action>
                <action type="variable value" value="Labela"  >
                  <parameter value="~dtOSImovinaTek.@lblStanje" />
                </action>
                <action type="control value" value="#lblStanje"  >
                  <parameter value="{$Labela}" />
                </action>
                <action type="control value" value="#txtKolIzlaz"  >
                  <parameter value="~dtOSImovinaTek.@KolIzlaz" />
                </action>
                <action type="control value" value="#txtNabavaPot"  >
                  <parameter value="~dtOSImovinaTek.@NabavaPot" />
                </action>
                <action type="control value" value="#txtOtpisDug"  >
                  <parameter value="~dtOSImovinaTek.@OtpisDug" />
                </action>
                <action type="control enable" value="#txtKolIzlaz" if="~dtOSDokumenti.@KolIzlaz==1" />
                <action type="control disable" value="#txtKolIzlaz" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
                <action type="control enable" value="#txtNabavaPot" if="~dtOSDokumenti.@NabavaPot==1" />
                <action type="control disable" value="#txtNabavaPot" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
                <action type="control enable" value="#txtOtpisDug" if="~dtOSDokumenti.@OtpisDug==1" />
                <action type="control disable" value="#txtOtpisDug" if="#cmbNabavaRoot==null&amp;&amp;~dtOSDokumenti.@Izlaz==1" />
              </event>
            </comboedit>
          </item>
          <item caption="Opis:" row="4" col="1" colspan="2" >
            <textedit name="txtOpis" datavalue="~dtGet.@Opis"  enabled="true" fontbold="true" nulltext="&lt;opis promjene&gt;"/>
          </item>

          <item caption="" row="1" col="3">
            <button name="btnKartica"  caption="Kartica" type=""  tabstop="false"  >
              <event type="click">
                <!--<action type="message" value="gumb kartica"/>-->
                <action type="form open" value="frmOSPrometFin_KarticaOS" >
                  <parameter name="OSImovinaId" value="$osimovinaid" type="int" />
                  <parameter name="NabavaRootId" value="0" type="int" />
                  <parameter name="NazivImovina" value="~dtget.@Naziv" />
                </action>
              </event>
            </button>
          </item>

          <item caption="" row="3" col="3">
            <button name="btnNabavaRoot"  caption="Nabava" type="" tabstop="false"  >
              <event type="click">
                <action type="form open" value="frmOSPrometFin_KarticaOS" >
                  <parameter name="OSImovinaId" value="$osimovinaid" type="int" />
                  <parameter name="NabavaRootId" value="#cmbNabavaRoot" type="int" />
                  <parameter name="NazivImovina" value="~dtget.@Naziv" />
                </action>
              </event>
            </button>
          </item>


        </group>

        <group cols="6" rows="4" col="1" row="2" backgroundcolor="#f5f5f5" alignmode="local" >

          <columnsdefinition>
            <column  position="1" size="10%" />
            <column  position="2" size="10%" />
            <column  position="3" size="10%" />
            <column  position="4" size="0%" />
            <column  position="5" size="10%" />
            <column  position="6" size="10%" />
          </columnsdefinition>

          <rowsdefinition>
            <row position="1" size="30" />
          </rowsdefinition>



          <item caption="Duguje:" row="1" col="2">
            <label name="lblDuguje" required="true" enabled="true"  />
          </item>
          <item caption="Potražuje:" row="1" col="3">
            <label name="lblPotrazuje" required="true" enabled="true"  />
          </item>
          <item caption="" row="1" col="5">
            <labeledit name="lblStanje" required="true" enabled="true"  />
          </item>
          <item caption="Količina:" row="2" col="1">
            <label name="lblKolicina" required="true" enabled="true"  />
          </item>
          <item caption="Nabava:" row="3" col="1">
            <label name="lblNabava" required="true" enabled="true"  />
          </item>
          <item caption="Otpis:" row="4" col="1">
            <label name="lblOtpis" required="true" enabled="true"  />
          </item>

          <item caption="" row="2" col="5">
            <textedit name="txtKolTek"  format="n0" required="false" enabled="false" />
          </item>
          <item caption="" row="3" col="5">
            <textedit name="txtNabavaTek" format="n2" required="false" enabled="false"  />
          </item>
          <item caption="" row="4" col="5">
            <textedit name="txtOtpisTek" format="n2" required="false" enabled="false"  />
          </item>



          <item caption="" row="2" col="2">
            <textedit name="txtKolUlaz" format="n0" datavalue="~dtGet.@KolUlaz"  value="0" fontbold="true" nulltext="0"/>
          </item>
          <item caption="" row="2" col="3">
            <textedit name="txtKolIzlaz" format="n0" datavalue="~dtGet.@KolIzlaz"  value="0"   fontbold="true" nulltext="0">
