<root>
	<form name="frmRacun" caption="URA"  width="500" height="570">
		<event type="load">
			<action type="datarun reader" value="~dtPopuni"/>
			<action type="control value" value="#txtBroj">
				<parameter value="~dtPopuni.@Broj"/>
			</action>
			<action type="control value" value="#datDatumdok">
				<parameter value="~dtPopuni.@DatumDok" type="date"/>
			</action>
			<action type="control value" value="#datValuta">
				<parameter value="~dtPopuni.@DatumValute" type="date"/>
			</action>
			<action type="control value" value="#txtIznosFakture">
				<parameter value="~dtPopuni.@IznosFakture" />
			</action>
			<action type="control value" value="#txtPlaceniIznos">
				<parameter value="~dtPopuni.@IznosPlaceni" />
			</action>
			<action type="control value" value="#txtPartner">
				<parameter value="~dtPopuni.@Naziv" />
			</action>
			<action type="control value" value="#txtIznosPoreza">
				<parameter value="~dtPopuni.@IznosPoreza" />
			</action>	
			<action type="control value" value="#txtUgovor">
				<parameter value="~dtPopuni.@OpisKupUgovori" />
			</action>
			<action type="control value" value="#txtOsoba">
				<parameter value="~dtPopuni.@ImePrezime" />
			</action>
			<action type="control value" value="#txtOrgShema">
				<parameter value="~dtPopuni.@NazivOrgShema" />
			</action>
			<action type="control value" value="#txtAdresa">
				<parameter value="~dtPopuni.@Adresa"/>
			</action>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdRacun"/>
			<action type="control disable" value="#txtBroj,#datDatumDok,#datValuta,#txtIznosFakture,
			#txtIznosPoreza,#txtPlaceniIznos,#txtPartner,#txtUgovor,#txtOsoba,#txtOrgShema,#txtAdresa"/>
		</event>
		<layout>
			<group cols="1" rows="2">
				<group col="1" row="1" cols="2" rows="7">
					<item col="1" row="1" caption="Broj:" textposition="left">
						<textedit name="txtBroj" />
					</item>
					<item col="1" row="2" caption="Datum dokumenta:" textposition="left">
						<dateedit name="datDatumDok" />
					</item>
					<item col="2" row="2" caption="Valuta:" textposition="left">
						<dateedit name="datValuta" />
					</item>
					<item col="1" row="5" caption="Iznos fakture:" textposition="left">
						<textedit name="txtIznosFakture" format="n2" />
					</item>
					<item col="1" row="6" caption="Iznos poreza." textposition="left">
						<textedit name="txtIznosPoreza" format="n2" />
					</item>
					<item col="1" row="7" caption="Plaćeni iznos:" textposition="left">
						<textedit name="txtPlaceniIznos" format="n2" />
					</item>		
					<item col="1" row="3" colspan="2" caption="Partner:" textposition="left">
						<textedit name="txtPartner" />
					</item>
					<item col="1" row="4" colspan="2" caption="Adresa:" textposition="left">
						<textedit name="txtAdresa"/>
					</item>
					<item col="2" row="5" caption="Ugovor:" textposition="left">
						<textedit name="txtUgovor" />
					</item>
					<item col="2" row="6" caption="Osoba:" textposition="left">
						<textedit name="txtOsoba" />
					</item>
					<item col="2" row="7" caption="Org. shema:" textposition="left">
						<textedit name="txtOrgShema" />
					</item>				
				</group>
				<group col="1" row="2" cols="1" rows="1">
					<item col="1" row="1">
						<grid name="grdRacun" dataname="~dtRacun">
							<fields>
								<field name="RobaKod" caption="Šifra"/>
								<field name="RobaNaziv" caption="Naziv robe"/>
								<field name="JMNaziv" caption="JM"/>
								<field name="Kolicina" caption="Količina"/>
								<field name="Cijena"/>
								<field name="Iznos" caption="Vrijednost"/>
							</fields>
						</grid>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIzlaz" caption="IZLAZ" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtRacun" command="spCKntKarticaKontaDevRacun">
				<parameter name="@Action" value="2"/>
				<parameter name="@Id" value="parent.#grdGlavni.@IdDok"/>
			</data>
			<data name="dtPopuni" command="spCKntKarticaKontaDevRacun">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="parent.#grdGlavni.@IdDok"/>
			</data>
		</datalist>
	</form>
</root>