<root version="1.0.0.1">
	<form name="frmZakljucakRS" caption="Zaključak" fixedsize="true">
		<event type="shown">
			<action type="control value" value="#datDatumZak">
				<parameter value="$datumzak"/>
			</action>
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="1" groupbordervisible="true">
				<item col="1" row="1" caption="Zaključak sa:">
					<dateedit  name="datDatumZak">
					</dateedit>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="&amp;ZAKLJUČI" dock="left">
					<event type="click">
						<!-- <action type="datarun scalar" value="~dtDatumZaZakljucak"/> -->
						<!-- <action type="datarun scalar" value="~dtZakljuci">	-->
							<!-- <parameter name="parent.$PozDrvoZak"/>	-->
						<!-- </action>  -->
						<action type="datarun reader" value="~dtProvjeraDatZak"/>
						<action type="message" value="Zaključak s datumom {~dtProvjeraDatZak.@Datum::dd.MM.yyyy} za odabranu knjigu već postoji. Odabrite drugi datum!" if="~dtProvjeraDatZak.@Provjera==1"/>
						<action type="message" value="Nedozvoljeni datum zaključka! Odaberite drugi datum!" elseif="~dtProvjeraDatZak.@Provjera==-1"/>
						<action else="~dtProvjeraDatZak.@Provjera==0">
							<action type="datarun nonquery" value="~dtZakljuci"/>
							<action type="variable value" value="parent.$PozDrvoZak">
								<!--fokus na nezaključen-->
								<parameter value="201844441231"/>
							</action>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="variable value" value="parent.$Odustani">
							<parameter value="true" type="bool"/>
						</action>
					</event>
				</button>  
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spCKntKnjigaUraCalc" name="dtDatumZaZakljucak"> -->
				<!-- <parameter name="@action" value="ProvjeraDatZak" /> -->
				<!-- <parameter name="@node"  value="$node" /> -->
				<!-- <parameter name="@treevalue"  value="$treevalue" /> -->
				<!-- <parameter name="@DatZakForma"  value="#datDatumZak" type="date"/> -->
			<!-- </data> -->
			<data name="dtZakljuci" command="spCKntKnjigaUraRSCalc">
				<parameter name="@action" value="Zakljuci" />
				<parameter name="@node"  value="$node" />
				<parameter name="@lastrb"  value="$lastrb" />
				<parameter name="@DatZakForma"  value="#datDatumZak" type="date"/>
			</data>
			<data name="dtProvjeraDatZak" command="spCKntKnjigaUraRSCalc">
				<parameter name="@Action" value="ProvjeraDatZak"/>
				<parameter name="@DatZakForma" value="#datDatumZak"/>
				<parameter name="@node" value="$node"/>
			</data>
		</datalist>
	</form>
</root>