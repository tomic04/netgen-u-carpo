<root>
	<!--
  *******************************************************************************************
  FORMA ZA UNOS I IZMJENU PRIJEVOZNIH TROŠKOVA
  *******************************************************************************************
  -->
	<form name="frmPrijevozniTros" caption="$caption" fixedsize="false" saveformlayout="false" width="500" height="500">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$ID!=0"/>
			<action type="datarun reader" value="~dtGetSNaloga"/>
			<action type="variable value">
				<parameter name="OrgShemaTrId" value="~dtGetSNaloga.@OrgShemaTrId" type="int"/>
			</action>
			<action type="variable value" value="global.OrgShemaTrId">
				<parameter value="~dtGetSNaloga.@OrgShemaTrId" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="DimenzijeId" value="~dtGetSNaloga.@dimenzijeid" type="int"/>
			</action>
			<action type="variable value" value="global.dimenzijeid">
				<parameter value="~dtGetSNaloga.@dimenzijeid" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="pnvrprijevozaoid" value="~dtGetSNaloga.@pnvrprijevozaoid" type="int"/>
			</action>
			<action type="variable value" value="global.pnvrprijevozaoid">
				<parameter value="~dtGetSNaloga.@pnvrprijevozaoid" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="datobracuna" value="~dtGetSNaloga.@datobracuna"/>
			</action>
			<action type="variable value" value="global.datobracuna">
				<parameter value="~dtGetSNaloga.@datobracuna"/>
			</action>
		</event>
		<event type="load">
			<action if="$ID==0">
				<action type="datarun reader" value="~dtDajTecaj">
					<action type="control value" value="#txtTecaj">
						<parameter value="~dtDajTecaj.@Tecaj"/>
					</action>
				</action>
				<action type="control value" value="#cmbJedTroska">
					<parameter value="global.$OrgShemaTrId"/>
				</action>
				<action type="control value" value="#cmbDimenzija">
					<parameter value="global.$dimenzijeid"/>
				</action>
				<action type="control value" value="#cmbVrPrijevoza">
					<parameter value="global.$pnvrprijevozaoid"/>
				</action>
				<action type="control value" value="#datDatum">
					<parameter value="global.$datobracuna"/>
				</action>
				<action type="datarun reader" value="~dtRelacijaOd">
					<action type="control value" value="#txtRelacijaOd">
						<parameter value="~dtRelacijaOd.@RelacijaOd"/>
					</action>
				</action>
			</action>
		</event>
		<event type="shown">
			<action type="control value" value="#srcPartner">
				<parameter text="~dtGet.@PartnerNaziv" value="~dtGet.@partneriid"/>
			</action>
			
			<action type="control disable" value="#datDatum" if="global.$DatumNaStavci==0"/>
		</event>
		<layout>
			<group cols="5" rows="3" groupbordervisible="false" >
					 <columnsdefinition>
						<column position="1" size="24%"/>
						<column position="2" size="24%"/>
						<column position="3" size="24%"/>
						<column position="4" size="24%"/>
						<column position="5" size="4%"/>
					</columnsdefinition> 
					<item row="1" col="1" caption="Datum tečaja:" highlight="false" textposition="top" colspan="1">
						<dateedit name="datDatum" value="now"  datavalue="~dtGet.@Datum"/>
					</item>
					<item row="1" col="2" colspan="4">
					</item>
					
					<group caption="Podaci o prijevozu" row="2" col="1" cols="5" rows="4" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
					
						<item row="1" col="1" caption="Relacija od:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtRelacijaOd"  datavalue="~dtGet.@relacijaod"  value=""/>
						</item>
						<item row="1" col="3" caption="Relacija do:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtRelacijaDo"  datavalue="~dtGet.@relacijado"  value=""/>
						</item>
						<item row="2" col="1" caption="Vrsta prijevoza:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbVrPrijevoza" valuefield="pnvrprijevozaid" displayfield="Naziv"  dataname="~dtVrPrijevoza" datavalue="~dtGet.@pnvrprijevozaid" allownull="false">
								<event type="valuechanged">
										<action type="datarun reader" value="~dtDajUkKm">
											<action type="control value" value="#txtUkKm">
												<parameter value="~dtDajUkKm.@ukkm"/>
											</action>
											<action type="control value" value="#txtIznosVal">
												<parameter value="~dtDajUkKm.@iznos"/>
											</action>
										</action>
								</event>
							</comboedit>
						</item>
						<item row="2" col="3" caption="Klasa:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtKlasa"  datavalue="~dtGet.@klasa"  value=""/>
						</item>
						
						<item row="3" col="1" caption="Km start:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtPocKm"  datavalue="~dtGet.@pockm" format="n0" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajUkKm">
										<action type="control value" value="#txtUkKm">
											<parameter value="~dtDajUkKm.@ukkm"/>
										</action>
										<action type="control value" value="#txtIznosVal">
											<parameter value="~dtDajUkKm.@iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="2" caption="Km kraj:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtZavKM"  datavalue="~dtGet.@zavkm" format="n0" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajUkKm">
										<action type="control value" value="#txtUkKm">
											<parameter value="~dtDajUkKm.@ukkm"/>
										</action>
										<action type="control value" value="#txtIznosVal">
											<parameter value="~dtDajUkKm.@iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="3" caption="Km ukupno:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtUkKm"  datavalue="~dtGet.@ukkm" format="n0" value="0" readonly="true">
							
							</textedit>
						</item>						
					</group>
					
					<group caption="Obračun" row="3" col="1" cols="5" rows="7" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
						<item row="1" col="1" caption="Valuta:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbValute" valuefield="valuteid" displayfield="naziv" dataname="~dtValute" datavalue="~dtGet.@ValuteId" allownull="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajTecaj">
										<action type="control value" value="#txtTecaj">
											<parameter value="~dtDajTecaj.@Tecaj"/>
										</action>
									</action>
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</comboedit>
						</item>
						<item row="1" col="3" caption="Tečaj:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtTecaj" format="n4" value="0" datavalue="~dtGet.@Tecaj">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						
						<item row="2" col="1" highlight="false" caption="Iznos valuta:">
							<textedit name="txtiznosval" datavalue="~dtGet.@iznosval" format="n2" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="2" col="2" highlight="false" caption="Iznos u EUR">
							<textedit name="txtiznos"  datavalue="~dtGet.@Iznoskn" format="n2" value="0"/>
						</item>
						
						<item row="3" col="1" caption="Podmirio trošak:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbNaciniPlacanja" valuefield="pnnaciniplacanjaId" displayfield="naziv"  dataname="~dtNaciniPlacanja" datavalue="~dtGet.@pnnaciniplacanjaId"/>
						</item>
						<item row="4" col="1" caption="Jedinica troška:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbJedTroska" valuefield="orgshemaid" displayfield="naziv"  dataname="~dtJedinicaTroska" datavalue="~dtGet.@OrgShemaTrId"/>
						</item>
						<item row="5" col="1" caption="Dimenzija:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbDimenzija" valuefield="dimenzijeid" displayfield="naziv"  dataname="~dtDimenzija" datavalue="~dtGet.@dimenzijeid"/>
						</item>
						<item row="6" col="1" caption="Partner:" highlight="false" colspan="4">
							<searchedit name="srcPartner" dataname="~dtPartner" fieldtext="Naziv" fieldvalue="partneriid">
							</searchedit>
						</item>
						<item row="7" col="1" caption="Napomena:" highlight="false" textposition="top" colspan="4">
							<textedit name="txtNapomena"  value="" datavalue="~dtGet.@Opis"/>
						</item>
					</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						
						<!-- izmjena -->
						<action if="$ID!=0">
							<!-- <action type="message" value="izmjena!!"/> -->
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
								<action type="form close"/> 
							</action>
							<action if="$indGreske==1">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
							</action>
						</action>
						
						<!-- unos -->
						<action if="$ID==0">
							
							<!-- <action type="message" value="unos!!"/> -->
							<action type="datarun reader" value="~dtUnos">
								<action if="$indGreske==0">
									<!-- <action type="message" value="$poruka"/> -->									
									
									 <action type="form close"/> 
								</action>
								<action if="$indGreske==1">
								</action>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPNPutniTroskovi" name="dtGet">
				<parameter name="@action" value="dtGet"/>
				<parameter name="@pnnalozidetid" value="$ID"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPNPutniTroskovi" name="dtGetSNaloga">
				<parameter name="@action" value="PodaciSNaloga"/>
				<parameter name="@pnnaloziid" value="$pnnaloziid"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPNHelp" name="dtValute">
				<parameter name="@action" value="valute"/>
			</data>
			<data command="spPNHelp" name="dtRelacijaOd">
				<parameter name="@action" value="RelacijaOd"/>
			</data>
			<data command="spPNHelp" name="dtJedinicaTroska">
				<parameter name="@action" value="orgshema_help"/>
			</data>
			<data command="spPNHelp" name="dtDimenzija">
				<parameter name="@action" value="dimenzije"/>
			</data>
			<data command="spPNHelp" name="dtNaciniPlacanja">
				<parameter name="@action" value="PNNaciniPlacanja"/>
			</data>
			<data command="spPNHelp" name="dtVrPrijevoza">
				<parameter name="@action" value="Prijevozi"/>
			</data>
			<data command="spPNHelp" name="dtPartner">
				<parameter name="@action" value="partneri"/>
				<parameter name="@tekst" value="#srcPartner.text"/>
			</data>
			<data command="spPNHelp" name="dtDajTecaj">
				<parameter name="@action" value="Tecaj"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
			</data>
			<data command="spPNHelp" name="dtDajIznos">
				<parameter name="@action" value="izracunaj_iznos"/>
				<parameter name="@tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
			</data>
			<data command="spPNHelp" name="dtDajUkKm">
				<parameter name="@action" value="izracunaj_ukkm"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
				<parameter name="@PNVrPrijevozaId" value="#cmbVrPrijevoza" type="int"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@datum" value="#datDatum"/>
			</data>
			<data command="spPNPutniTroskovi" name="dtUnos">
				<parameter name="@action" value="unos"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@PNNaloziDetId" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@klasa" value="#txtKlasa"/>
				<parameter name="@relacijaod" value="#txtRelacijaOd"/>
				<parameter name="@relacijado" value="#txtRelacijaDo"/>
				<parameter name="@pnvrprijevozaid" value="#cmbVrPrijevoza"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
				<parameter name="@ukkm" value="#txtUkKm" type="int"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>				
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNPutniTroskovi" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@PNNaloziDetId" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@klasa" value="#txtKlasa"/>
				<parameter name="@relacijaod" value="#txtRelacijaOd"/>
				<parameter name="@relacijado" value="#txtRelacijaDo"/>
				<parameter name="@pnvrprijevozaid" value="#cmbVrPrijevoza"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
				<parameter name="@ukkm" value="#txtUkKm" type="int"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>			
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>

<!--
  *******************************************************************************************
  FORMA ZA UNOS I IZMJENU PRIJEVOZNIH TROŠKOVA - KADAR
  *******************************************************************************************
  -->
	<form name="frmPrijevozniTrosKadar" caption="$caption" fixedsize="false" saveformlayout="false" width="500" height="500">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$ID!=0"/>
		</event>
		<event type="load">
			<action if="$ID==0">
				<action type="datarun reader" value="~dtDajTecaj">
					<action type="control value" value="#txtTecaj">
						<parameter value="~dtDajTecaj.@Tecaj"/>
					</action>
				</action>
			</action>
		</event>
		<event type="shown">
			<action type="control value" value="#srcPartner">
				<parameter text="~dtGet.@PartnerNaziv" value="~dtGet.@partneriid"/>
			</action>
			<action type="control disable" value="#datDatum" if="global.$DatumNaStavci==0"/>
		</event>
		<layout>
			<group cols="5" rows="3" groupbordervisible="false" >
					 <columnsdefinition>
						<column position="1" size="24%"/>
						<column position="2" size="24%"/>
						<column position="3" size="24%"/>
						<column position="4" size="24%"/>
						<column position="5" size="4%"/>
					</columnsdefinition> 
					<item row="1" col="1" caption="Datum tečaja:" highlight="false" textposition="top" colspan="1">
						<dateedit name="datDatum" value="now"  datavalue="~dtGet.@Datum"/>
					</item>
					<item row="1" col="2" colspan="4">
					</item>
					
					<group caption="Podaci o prijevozu" row="2" col="1" cols="5" rows="4" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
					
						<item row="1" col="1" caption="Relacija od:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtRelacijaOd"  datavalue="~dtGet.@relacijaod"  value=""/>
						</item>
						<item row="1" col="3" caption="Relacija do:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtRelacijaDo"  datavalue="~dtGet.@relacijado"  value=""/>
						</item>
						<item row="2" col="1" caption="Vrsta prijevoza:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbVrPrijevoza" valuefield="pnvrprijevozaid" displayfield="Naziv"  dataname="~dtVrPrijevoza" datavalue="~dtGet.@pnvrprijevozaid" allownull="false"/>
						</item>
						<item row="2" col="3" caption="Klasa:" highlight="false" textposition="top" colspan="2">
							<textedit name="txtKlasa"  datavalue="~dtGet.@klasa"  value=""/>
						</item>
						
						<item row="3" col="1" caption="Km start:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtPocKm"  datavalue="~dtGet.@pockm" format="n0" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajUkKm">
										<action type="control value" value="#txtUkKm">
											<parameter value="~dtDajUkKm.@ukkm"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="2" caption="Km kraj:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtZavKM"  datavalue="~dtGet.@zavkm" format="n0" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajUkKm">
										<action type="control value" value="#txtUkKm">
											<parameter value="~dtDajUkKm.@ukkm"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="3" caption="Km ukupno:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtUkKm"  datavalue="~dtGet.@ukkm" format="n0" value="0" readonly="true">
							
							</textedit>
						</item>						
					</group>
					
					<group caption="Obračun" row="3" col="1" cols="5" rows="5" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
						<item row="1" col="1" caption="Valuta:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbValute" valuefield="valuteid" displayfield="naziv" dataname="~dtValute" datavalue="~dtGet.@ValuteId" allownull="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajTecaj">
										<action type="control value" value="#txtTecaj">
											<parameter value="~dtDajTecaj.@Tecaj"/>
										</action>
									</action>
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</comboedit>
						</item>
						<item row="1" col="3" caption="Tečaj:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtTecaj" format="n4" value="0" datavalue="~dtGet.@Tecaj" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						
						<item row="2" col="1" highlight="false" caption="Iznos valuta:">
							<textedit name="txtiznosval" datavalue="~dtGet.@iznosval" format="n2" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="2" col="2" highlight="false" caption="Iznos u EUR">
							<textedit name="txtiznos"  datavalue="~dtGet.@Iznoskn" format="n2" value="0"  visible="false"/>
						</item>
						
						<item row="3" col="1" caption="Podmirio trošak:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbNaciniPlacanja" valuefield="pnnaciniplacanjaId" displayfield="naziv"  dataname="~dtNaciniPlacanja" datavalue="~dtGet.@pnnaciniplacanjaId"/>
						</item>
						<item row="4" col="1" caption="Jedinica troška:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbJedTroska" valuefield="orgshemaid" displayfield="naziv"  dataname="~dtJedinicaTroska" datavalue="~dtGet.@OrgShemaTrId"/>
						</item>
						<item row="5" col="1" caption="Dimenzija:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbDimenzija" valuefield="dimenzijeid" displayfield="naziv"  dataname="~dtDimenzija" datavalue="~dtGet.@dimenzijeid"  visible="false"/>
						</item>
						<item row="6" col="1" caption="Partner:" highlight="false" colspan="4">
							<searchedit name="srcPartner" dataname="~dtPartner" fieldtext="Naziv" fieldvalue="partneriid"  visible="false">
							</searchedit>
						</item>
						<item row="5" col="1" caption="Napomena:" highlight="false" textposition="top" colspan="4">
							<textedit name="txtNapomena"  value="" datavalue="~dtGet.@Opis"/>
						</item>
					</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						
						<!-- izmjena -->
						<action if="$ID!=0">
							<!-- <action type="message" value="izmjena!!"/> -->
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
								<action type="form close"/> 
							</action>
							<action if="$indGreske==1">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
							</action>
						</action>
						
						<!-- unos -->
						<action if="$ID==0">
							
							<!-- <action type="message" value="unos!!"/> -->
							<action type="datarun reader" value="~dtUnos">
								<action if="$indGreske==0">
									<!-- <action type="message" value="$poruka"/> -->									
									
									 <action type="form close"/> 
								</action>
								<action if="$indGreske==1">
								</action>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPNPutniTroskovi" name="dtGet">
				<parameter name="@action" value="dtGet_izv"/>
				<parameter name="@pnnaloziizvdetid" value="$ID"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPNHelp" name="dtValute">
				<parameter name="@action" value="valute"/>
			</data>
			<data command="spPNHelp" name="dtJedinicaTroska">
				<parameter name="@action" value="orgshema_help"/>
			</data>
			<data command="spPNHelp" name="dtDimenzija">
				<parameter name="@action" value="dimenzije"/>
			</data>
			<data command="spPNHelp" name="dtNaciniPlacanja">
				<parameter name="@action" value="PNNaciniPlacanja"/>
			</data>
			<data command="spPNHelp" name="dtVrPrijevoza">
				<parameter name="@action" value="Prijevozi"/>
			</data>
			<data command="spPNHelp" name="dtPartner">
				<parameter name="@action" value="partneri"/>
				<parameter name="@tekst" value="#srcPartner.text"/>
			</data>
			<data command="spPNHelp" name="dtDajTecaj">
				<parameter name="@action" value="Tecaj"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
			</data>
			<data command="spPNHelp" name="dtDajIznos">
				<parameter name="@action" value="izracunaj_iznos"/>
				<parameter name="@tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
			</data>
			<data command="spPNHelp" name="dtDajUkKm">
				<parameter name="@action" value="izracunaj_ukkm"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
			</data>
			<data command="spPNPutniTroskovi" name="dtUnos">
				<parameter name="@action" value="unos_izv"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@pnnaloziizvdetid" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@klasa" value="#txtKlasa"/>
				<parameter name="@relacijaod" value="#txtRelacijaOd"/>
				<parameter name="@relacijado" value="#txtRelacijaDo"/>
				<parameter name="@pnvrprijevozaid" value="#cmbVrPrijevoza"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
				<parameter name="@ukkm" value="#txtUkKm" type="int"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>				
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNPutniTroskovi" name="dtIzmjena">
				<parameter name="@action" value="izmjena_izv"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@pnnaloziizvdetid" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@klasa" value="#txtKlasa"/>
				<parameter name="@relacijaod" value="#txtRelacijaOd"/>
				<parameter name="@relacijado" value="#txtRelacijaDo"/>
				<parameter name="@pnvrprijevozaid" value="#cmbVrPrijevoza"/>
				<parameter name="@pockm" value="#txtPocKm" type="int"/>
				<parameter name="@zavkm" value="#txtZavKM" type="int"/>
				<parameter name="@ukkm" value="#txtUkKm" type="int"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>			
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>

</root>