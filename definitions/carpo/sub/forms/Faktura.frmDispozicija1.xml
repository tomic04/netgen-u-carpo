<?xml version="1.0" encoding="utf-8"?>
<root>
	<form type="master" name="frmDispozicija" caption="Dispozicija za izvoz" width="300" height="500" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="global.~dtGetDispozicija" />
		</event>
		<event type="shown">
			<action type="control value" value="#txtPartner" >
				<parameter value="$Partner"/>
			</action>			
		</event>		
		<layout textposition="left">
			<group rows="3" cols="1">
				<group row="1" col="1" rows="3" cols="3">
					<item row="1" col="1" caption="Broj:">
						<textedit name="txtBroj" value="" />
					</item>
					<item row="1" col="2" caption="Broj Dok:" >
						<textedit name="txtBroj" value="" enabled="false"/>
					</item>
					<item row="1" col="3" caption="Broj Zaduženja:">
						<textedit name="txtBroj" value="" />
					</item>
					<item row="2" col="1" caption="Datum:" colspan="1">
						<dateedit  name="txtDatum" value="" />
					</item>
					<item row="3" col="1" caption="Vrsta Dok:" colspan="2">
						<comboedit name="txtVrstaDok" value="" dataname="dtVrstaDok" displayfield="Opis"/>
					</item>
				</group>


				<group row="3" col="1" rows="16" cols="1" >
					<item row="1" col="1" caption="Partner:" >
						<textedit name="txtPartner" value="" />
					</item>
					<item row="2" col="1" caption="Primatelj:" >
						<textedit name="txtPrimatelj" value="" />
					</item>
					<item row="3" col="1" caption="Špediter:" >
						<textedit name="txtSpediter" value="" />
					</item>
					<item row="4" col="1" caption="Paritet:" >
						<textedit name="txtParitet" value="" />
					</item>
					<item row="5" col="1" caption="Mjesto carinjenja:" >
						<textedit name="txtCarina" value="" />
					</item>
					<item row="6" col="1" caption="Granični prijelaz:" >
						<textedit name="txtPrijelaz" value="" />
					</item>
					<item row="7" col="1" caption="Vrsta transporta:" >
						<textedit name="txtTransport" value="" />
					</item>
					<item row="8" col="1" caption="Reg. oznaka vozila:" >
						<textedit name="txtRegistracija" value="" />
					</item>
					<item row="9" col="1" caption="Broj plombi:"  >
						<textedit name="txtPlombe" value="" />
					</item>
					<item row="10" col="1" caption="Vozač:" >
						<textedit name="txtVozac" value="" />
					</item>
					<item row="11" col="1" caption="Zemlja naplate:" >
						<comboedit name="txtZemljaNaplate" value="" dataname="dtZemljaNaplate" displayfield="Naziv" />
					</item>
					<item row="12" col="1" caption="Zemlja namjene:" >
						<comboedit name="txtZemljaNamjene" value="" dataname="dtZemljaNamjene" displayfield="Naziv" />
					</item>
					<item row="13" col="1" caption="Vrsta carinskog postupka:" >
						<textedit name="txtCarina" value="" />
					</item>
					<item row="14" col="1" caption="Otpremnik:" >
						<textedit name="txtOtpremnik" value="" />
					</item>
					<item row="15" col="1" caption="Dodane upute:" >
						<memoedit  name="txtUpute" value="" />
					</item>
					<item row="16" col="1" caption="Upute za popunjavanje Eura:" >
						<memoedit  name="txtUputeEuro" value="" />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIspisi" caption="ISPIŠI" type="add" dock="left" />
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="left"/>
				<button name="btnUputi" caption="Uputi me" dock="right"/>
			</buttons>  
		</panelbuttons>
		<datalist>
			<data command="spNG_Combo" name="dtVrstaDok">
				<parameter name="@Action" value="VrstaDok" />
			</data>
			<data command="spNG_Combo" name="dtZemljaNaplate">
				<parameter name="@Action" value="Drzave" />
			</data>
			<data command="spNG_Combo" name="dtZemljaNamjene">
				<parameter name="@Action" value="Drzave" />
			</data>
		</datalist>
	</form>
</root>