<root>
	<form name="frmUsluga" caption="Usluga" width="1000" saveformsize="false">
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run"/>
		<event type="shown">
			<action type="control disable" value="#srcUsluga" if="$Edit==1"/>
			<action type="control visible" value="#srcIzvrsitelj" if="parent.$PoljeIzvrsitelj==0">
				<parameter value="false"/>
			</action>
			<action type="control attribute" value="#srcIzvrsitelj" if="parent.$PoljeIzvrsitelj==0">
				<parameter name="required" value="false"/>
			</action>
			<action type="control value" value="#cmbOrgShema" if="$Edit==0">
				<parameter value="$RealOrgShemaId"/>
			</action>
			<action type="control value" value="#txtObrVrijeme" if="$Edit==0">
				<parameter value="0"/>
			</action>
			<action type="control value" value="#cmbNacinObracuna" if="$Edit==0">
				<parameter value="$ServisNacinObrId"/>
			</action>
		</event>
		<event type="init">
			<action type="datarun reader" value="global.~dtUcitajStavku" if="$Edit==1"/>
			<action type="variable value" value="VManual">
				<parameter value="0" type="int"/>
			</action>
		</event>
		<layout>
			<group rows="2" cols="2">
				<columnsdefinition>
					<column position="1" size="50%"/>
					<column position="2" size="50%"/>
				</columnsdefinition>
				<group row="1" col="1" rows="1" cols="1" colspan="2">
					<item row="1" col="1" caption="Usluga:">
						<searchedit name="srcUsluga" dataname="global.~dtUsluga" fieldvalue="RobaId" fieldtext="Roba" datavalue="global.~dtUcitajStavku.@RobaId" datatext="global.~dtUcitajStavku.@Roba" required="true">
							<event type="valuechanged">
								<action if="#srcUsluga!=null">
									<action if="$Edit!=1">
										<action type="datarun reader" value="~dtRobaCijena"/>
										<action type="variable value">
											<parameter name="VrCjenikId" value="~dtRobaCijena.@VrCjenikId"/>
										</action>
										<action type="variable value">
											<parameter name="NaknadaTR" value="~dtRobaCijena.@NaknadaTR"/>
										</action>
										<action type="variable value">
											<parameter name="NaknadaPO" value="~dtRobaCijena.@NaknadaPO"/>
										</action>
										<action type="variable value">
											<parameter name="NaknadaNZ" value="~dtRobaCijena.@NaknadaNZ"/>
										</action>
										<action type="variable value">
											<parameter name="KupUgovoriDetId" value="~dtRobaCijena.@KupUgovoriDetId"/>
										</action>
										<action type="variable value">
											<parameter name="OznakaValute" value="~dtRobaCijena.@OznakaValute"/>
										</action>
										<action type="variable value">
											<parameter name="ValuteId" value="~dtRobaCijena.@ValuteId"/>
										</action>
										<action type="variable value">
											<parameter name="TarifaId" value="~dtRobaCijena.@TarifaId"/>
										</action>
										<action type="variable value">
											<parameter name="OrgRabatP" value="~dtRobaCijena.@Rabat"/>
										</action>
										<action type="control value" value="#bteNabavna">
											<parameter value="~dtRobaCijena.@CijenaNabavna"/>
										</action>
										<action type="control value" value="#lblNabavna">
											<parameter value="$OznakaValute"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="ValutaTekst" value="$OznakaValute"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Cijena" value="~dtRobaCijena.@Cijena"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatPosto" value="~dtRobaCijena.@Rabat"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CassaPosto" value="~dtRobaCijena.@Cassa"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="PorezPosto" value="~dtRobaCijena.@Porez"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost1" value="~dtRobaCijena.@Rabat1"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost2" value="~dtRobaCijena.@Rabat2"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost3" value="~dtRobaCijena.@Rabat3"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost4" value="~dtRobaCijena.@Rabat4"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost5" value="~dtRobaCijena.@Rabat5"/>
										</action>
										<action type="control value" value="#txtRokPlacanja">
											<parameter value="~dtRobaCijena.@Odgoda"/>
										</action>
									</action>
									<action else="">
										<action type="variable value">
											<parameter name="OznakaValute" value="global.~dtUcitajStavku.@OznakaValute"/>
										</action>
										<action type="variable value">
											<parameter name="ValuteId" value="global.~dtUcitajStavku.@ValuteId"/>
										</action>
										<!-- <action type="variable value" > -->
										<!-- <parameter name="TarifaId" value="~dtUcitajStavku.@TarifaId"/> -->
										<!-- </action> -->
										<!-- <action type="variable value" > -->
										<!-- <parameter name="OrgRabatP" value="~dtUcitajStavku.@OrgRabatP"/> -->
										<!-- </action> -->
										<action type="control value" value="#bteNabavna">
											<parameter value="global.~dtUcitajStavku.@NabCijenaKn"/>
										</action>
										<action type="control value" value="#lblNabavna">
											<parameter value="$OznakaValute"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="ValutaTekst" value="$OznakaValute"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Kolicina" value="#txtObrVrijeme" type="decimal"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Cijena" value="global.~dtUcitajStavku.@NettoCijenaKn"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CijenaPDV" value="global.~dtUcitajStavku.@BruttoCijenaKn"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Iznos" value="global.~dtUcitajStavku.@NettoVrijednostKn"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="IznosPDV" value="global.~dtUcitajStavku.@BruttoVrijednostKn"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatPosto" value="global.~dtUcitajStavku.@RabatP"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CassaPosto" value="global.~dtUcitajStavku.@Cassa"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="PorezPosto" value="global.~dtUcitajStavku.@PorezP"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost1" value="global.~dtUcitajStavku.@Rabat1"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost2" value="global.~dtUcitajStavku.@Rabat2"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost3" value="global.~dtUcitajStavku.@Rabat3"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost4" value="global.~dtUcitajStavku.@Rabat4"/>
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost5" value="global.~dtUcitajStavku.@Rabat5"/>
										</action>
										<action type="control value" value="#txtRokPlacanja">
											<parameter value="global.~dtUcitajStavku.@Odgoda"/>
										</action>
									</action>
								</action>
							</event>
						</searchedit>
					</item>
				</group>
				<group rows="3" cols="2" row="2" col="1">
					<columnsdefinition>
						<column position="1" size="50%"/>
						<column position="2" size="50%"/>
					</columnsdefinition>
					<item row="1" col="1">
						<daysedit caption="Rok isporuke (dana)" name="txtRokIsporuke" datavalue="global.~dtUcitajStavku.@RokIsporuke"/>
					</item>
					<item row="1" col="2">
						<daysedit caption="Rok plaćanja (dana)" name="txtRokPlacanja" datavalue="global.~dtUcitajStavku.@RokPlacanja"/>
					</item>
					<item row="2" col="1" colspan="2">
						<separator/>
					</item>
					<item row="3" col="1" colspan="2" caption="Napomena:">
						<memoedit name="memNapomena" datavalue="global.~dtUcitajStavku.@Napomena"/>
					</item>
				</group>
				<group row="2" col="2" rows="6" cols="6">
					<item row="1" col="1" colspan="3" caption="Datum:" textposition="left" textalignmode="auto">
						<dateedit name="dateDatum" value="now" datavalue="global.~dtUcitajStavku.@Datum"/>
					</item>
					<item row="2" col="1" colspan="2" caption="Vrijeme za obračun:">
						<textedit name="txtObrVrijeme" format="n2" value="0" datavalue="global.~dtUcitajStavku.@Količina">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtSatiMinute" if="$VManual==0"/>
								<action type="control value" value="#timeUtrVrijeme" if="$VManual==0">
									<parameter value="~dtSatiMinute.@SatiMinute"/>
								</action>
								<action type="control value" value="#cusCalc">
									<parameter name="Kolicina" value="#txtObrVrijeme" type="decimal"/>
								</action>
							</event>
						</textedit>
					</item>
					<item row="2" col="3" colspan="2" caption="Stvarno utrošeno vrijeme:">
						<timeedit name="timeUtrVrijeme" value="00:00" datavalue="global.~dtUcitajStavku.@Vrijeme">
							<event type="valuechanged">
								<action type="variable value" value="VManual">
									<parameter value="1" type="int"/>
								</action>
							</event>
						</timeedit>
					</item>
					<item row="2" col="5" caption="Nabavna cijena:">
						<textedit name="bteNabavna" format="n4" value="0" datavalue="global.~dtUcitajStavku.@NabCijenaKn" readonly="true"/>
					</item>
					<item row="2" col="6" padding="0,0,22,0">
						<labeledit name="lblNabavna" value=" "/>
					</item>
					<item row="3" col="1" colspan="6" caption="OrgShema:">
						<combotreeedit name="cmbOrgShema" required="true" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" datavalue="global.~dtUcitajStavku.@TrosOrgShemaId" datatext="global.~dtUcitajStavku.@OrgShema">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtIzvrsiteljT"/>
								<action type="control value" value="#srcIzvrsitelj">
									<parameter value="null" text="null"/>
								</action>
								<action type="control refreshvalue" value="#srcIzvrsitelj"/>
							</event>
						</combotreeedit>
					</item>
					<item row="4" col="1" colspan="6" caption="Izvršitelj:">
						<searchedit name="srcIzvrsitelj" required="true" dataname="~dtIzvrsiteljT" fieldvalue="HRKadroviId" fieldtext="Izvrsitelj" datavalue="global.~dtUcitajStavku.@HRKadroviId" datatext="global.~dtUcitajStavku.@Izvršitelj"/>
					</item>
					<item row="5" col="1" colspan="6" caption="Način obračuna:">
						<comboedit name="cmbNacinObracuna" dataname="global.~dtNacinObracuna" valuefield="ServisNacinObrId" displayfield="Naziv" datavalue="global.~dtUcitajStavku.@ServisNacinObrId" datatext="global.~dtUcitajStavku.@NacinObr" allownull="false"/>
					</item>
					<item row="6" col="1" colspan="6">
						<customcontrol name="cusCalc" dll="Carpo.Specific" class="Carpo.Specific.Cjenik.Kalkulacija"/>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDimenzije" caption="DIMENZIJE">
					<event type="click">
						<action if="global.$IndDimenzije==1">
							<action type="method run" value="fnDimenzijeGla">
								<parameter name="server" value="@@server"/>
								<parameter name="database" value="@@database"/>
								<parameter name="username" value=""/>
								<parameter name="password" value=""/>
								<parameter name="OperateriId" value="@@operateriid"/>
								<parameter name="Parent" value="-99999"/>
								<parameter name="pTop" value="0"/>
								<parameter name="pLeft" value="0"/>
								<parameter name="path" value=""/>
								<parameter name="tip" value="ServisRNDetId"/>
								<parameter name="id" value="$ServisRnDetId"/>
								<parameter name="glaid" value="0"/>
							</action>
						</action>
						<action else="">
							<action type="message" value="'postaviti .net Dimenzije.'"/>
						</action>
					</event>
				</button>
				<button name="btnSpremi" caption="SPREMI" dock="right">
					<event type="click">
						<action type="message" value="Količina mora biti veća od 0!" if="#txtObrVrijeme==0"/>
						<action else="">
							<action type="validate"/>
							<action type="datarun scalar" value="~dtSpremiDet">
								<parameter name="NoviDet"/>
							</action>
							<action type="control populate" value="parent.#grdDetail"/>
							<action type="control focus" value="parent.#grdDetail">
								<parameter value="$NoviDet"/>
							</action>
							<action type="variable value" value="global.$countdet37">
								<parameter value="1" type="int"/>
							</action>
							<action type="control disable" value="parent.#cmbModel, parent.#btnVratiStatus" if="global.$countdet37==1&amp;&amp;global.$statusRNCaption55==Aktiviran"/>
							<action type="control enable" value="parent.#cmbModel, parent.#btnVratiStatus" elseif="global.$CountDet37==0&amp;&amp;global.$statusRNCaption55==Aktiviran"/>
							<action type="control value" value="##,!#cmbOrgShema,!#cmbNacinObracuna,!#srcIzvrsitelj,!#txtObrVrijeme,!#dateDatum" if="$Edit==0">
								<parameter value=""/>
							</action>
							<action type="control value" value="#txtObrVrijeme" if="$Edit==0">
								<parameter value="0" type="int"/>
							</action>
							<action type="control value" value="#dateDatum" if="$Edit==0">
								<parameter value="now"/>
							</action>
							<action type="form close" if="$Edit==1"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtRobaCijena" command="spServisRN_Kalk">
				<parameter name="@DatumDok" value="parent.#dateDatum"/>
				<parameter name="@PartneriId" value="parent.#srcPartner"/>
				<parameter name="@ParStruId" value="parent.#srcLokacija"/>
				<parameter name="@OrgShemaId" value="parent.#cmbOrgShema"/>
				<parameter name="@RobaId" value="#srcUsluga"/>
			</data>
			<data name="dtSatiMinute" command="spServisDatumVrijeme">
				<parameter name="@Action" value="SatiMinute"/>
				<parameter name="@VrijemeDec" value="#txtObrVrijeme"/>
			</data>
			<data name="dtIzvrsiteljT" command="spServisRNFilterCarpo">
				<parameter name="@Action" value="Izvrsitelj"/>
				<parameter name="@String" value="#srcIzvrsitelj.text"/>
				<parameter name="@Orgshemaid" value="#cmbOrgShema"/>
			</data>
			<data name="dtSpremiDet" command="spServisRNDetAzurCarpo">
				<parameter name="@Action" value="0" if="$Edit==0"/>
				<parameter name="@Action" value="1" if="$Edit==1"/>
				<parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId"/>
				<parameter name="@ID" value="$ServisRnDetId" if="$Edit==1"/>
				<parameter name="@ServisId" value="parent.#cmbModel"/>
				<parameter name="@Indikator" value="U"/>
				<parameter name="@RobaId" value="#srcUsluga" if="$Edit==0"/>
				<parameter name="@Kolicina" value="#txtObrVrijeme"/>
				<parameter name="@Vrijeme" value="#timeUtrVrijeme"/>
				<parameter name="@JmId" value="#srcUsluga.@JmId" if="$Edit==0"/>
				<parameter name="@OrgNettoCijenaKn" value="#bteNabavna"/>
				<parameter name="@Cijena" value="#cusCalc.@Cijena"/>
				<parameter name="@CijenaPDV" value="#cusCalc.@CijenaPDV"/>
				<parameter name="@IznosBezPDV" value="#cusCalc.@IznosBezPDV"/>
				<parameter name="@IznosPDV" value="#cusCalc.@IznosPDV"/>
				<parameter name="@OrgRabatP" value="$OrgRabatP"/>
				<parameter name="@RabatP" value="#cusCalc.@RabatPosto"/>
				<parameter name="@Cassa" value="#cusCalc.@CassaPosto"/>
				<parameter name="@PorezP" value="#cusCalc.@PorezPosto"/>
				<parameter name="@Rabat1" value="#cusCalc.@RabatVrijednost1" if="$Edit==0"/>
				<parameter name="@Rabat2" value="#cusCalc.@RabatVrijednost2" if="$Edit==0"/>
				<parameter name="@Rabat3" value="#cusCalc.@RabatVrijednost3" if="$Edit==0"/>
				<parameter name="@Rabat4" value="#cusCalc.@RabatVrijednost4" if="$Edit==0"/>
				<parameter name="@Rabat5" value="#cusCalc.@RabatVrijednost5" if="$Edit==0"/>
				<parameter name="@Datum" value="#dateDatum"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@RealOrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@TrosOrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@RokIsporuke" value="#txtRokIsporuke"/>
				<parameter name="@RokPlacanja" value="#txtRokPlacanja"/>
				<parameter name="@HRKadroviId" value="#srcIzvrsitelj"/>
				<parameter name="@ServisNacinObrId" value="#cmbNacinObracuna"/>
				<parameter name="@Opis" value="#memNapomena"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste"/>
				<parameter name="@ValuteId" value="$ValuteId"/>
				<parameter name="@TarifaId" value="$TarifaId"/>
			</data>
		</datalist>
	</form>
</root>