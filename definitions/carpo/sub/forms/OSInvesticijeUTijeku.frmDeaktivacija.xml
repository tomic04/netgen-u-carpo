<root version="1.1">
  
  <!--1.1. MZ saveformlayout-->

  <form name="frmDeaktivacija" caption="$Caption" fixedsize="false" width="500" saveformlayout="true" >

    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtKontrola" />
    </event>
    <event type="onload">
      <action type="control enable" value="#btnDeaktiviraj" if="~dtKontrola.@IdDeakt==0"/>
      <action type="control disable" value="#btnDeaktiviraj" else="" />
    </event>

    <layout>
      <group cols="1" rows="8" groupbordervisible="false" >
        <item caption="" col="1" row="1" >
          <labeledit name="lblPoruka" value="Za odabranu investiciju u tijeku postoje slijedeći zapisi u imovini:" fontbold="true" />
        </item>
        <item caption="" col="1" row="2" >
          <labeledit name="lblTrosak" datavalue="~dtGet.@Trosak" />
        </item>
        <item caption="" col="1" row="3" >
          <labeledit name="lblStatus" datavalue="~dtGet.@Status" />
        </item>
        <item caption="" col="1" row="4" >
          <labeledit name="lblGrupe" datavalue="~dtGet.@Grupe" />
        </item>
        <item caption="" col="1" row="5" >
          <labeledit name="lblFinancijski" datavalue="~dtGet.@Financijski" />
        </item>
        <item caption="" col="1" row="6" >
          <labeledit name="lblSmjestajni" datavalue="~dtGet.@Smjestajni"/>
        </item>
        <item caption="" col="1" row="7" >
        </item>
       <item caption="" col="1" row="8" >
          <labeledit name="lblPostavka" datavalue="~dtGet.@Postavka" fontbold="true"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnDeaktiviraj"  caption="Deaktiviraj" >
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite deaktivirati investiciju u tijeku?" >
              <action type="datarun reader" value="~dtDeakt" >
                <action type="message" value="~dtDeakt.@Poruka" />
              </action>
            </action>
            <action type="form close" />
          </event>
        </button>

        <button caption="Odustani" type="cancel" dock="right">
          <event type="click"/>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaIT_HelpCP" name="dtGet">
        <parameter name="@Action" value="Deaktivacija_info"/>
        <parameter name="@OSImovinaITId" value="$OSImovinaITId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@DatumAktiviranja" value="$DatumAktiviranja"/>
      </data>
      <data command="spOSImovinaIT_AktivacijaCP" name="dtKontrola">
        <parameter name="@Action" value="Kontrola_deaktivacije"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@DatumAktiviranja" value="$DatumAktiviranja"/>
      </data>
      <data command="spOSImovinaIT_AktivacijaCP" name="dtDeakt">
        <parameter name="@Action" value="Deaktivacija"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@DatumAktiviranja" value="$DatumAktiviranja"/>
      </data>
    </datalist>

  </form>

</root>