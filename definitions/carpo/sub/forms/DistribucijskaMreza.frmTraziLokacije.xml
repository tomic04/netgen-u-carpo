<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmTraziLokacije" caption="Tražilica" width="350" height="100">
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="2" caption="Naziv" >
					<textedit name="lokacije"  fieldvalue="kamionId" fieldtext="registracija">
						<event type="keydown" value="13">
							<action type="form open" value="frmLokacije">
								<parameter name="naziv" value="#lokacije"/>
								<parameter name="Id" value="$Id"/>
								<parameter name="parentid" value="$parentid"/>
							</action>
							<action type="form close"/>
						</event>
					</textedit>
				</item>				
			</group>
		</layout>	
	</form>
</root>	