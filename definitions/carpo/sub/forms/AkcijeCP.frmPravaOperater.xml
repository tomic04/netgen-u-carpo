<root>

<!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::-->
<!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::-->
<!-- :::::::::::::::::::::::::::::::::    FORM ZA PRAVA OPERATERA     :::::::::::::::::::::::::::::::-->
<!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::-->
<!-- ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::-->

    <form name="frmPravaOperater" caption="Sva prava operatera {parent.#grdDetalj.@naziv} na akciju {parent.#grdMaster.@Naziv}" saveformlayout="false" width="800" height="600" fixedsize="true">

        <event type="load">
            <action type="control populate" value="#grdSvaPrava" />
        </event>

        <layout>
            <group cols="1" rows="1">
                <item col="1" row="1">
                    <!-- prikazuje SVA PRAVA operatera na akciju odabranu u master gridu-->
                    <grid showgrouppanel="false" name="grdSvaPrava" type="master" key="AkcijeOpDetId" dataname="dtGrdSvaPrava" bestfitonrefresh="true" fieldsmartspaces="false" multiselect="false">
                        <!-- bold sva prava koja se odnose na umirovljene org jedinice, to uključuje i prava koja nisu sama po sebi umirovljena, ali su po sortKey-u ispod prava koja jesu
                        umirovljena-->
                        <styles>
                            <style name="bold" if="#grdSvaPrava.@Umirovljeno==1" />
                        </styles>
                        <fields inherited="true">
                            <field name="AkcOznaka" caption="Oznaka akcije" />
                        </fields>
                    </grid>
                </item>
            </group>
        </layout>

        <!-- GRID SVA PRAVA OPERATERA NA AKCIJU-->
        <datalist>
            <data command="spDneEv_Akcije_Query_CP" name="dtGrdSvaPrava">
                <parameter name="@action" value="sva_prava" />
                <parameter name="@akcoznaka" value="parent.#grdDetalj.@AkcOznaka" />
                <parameter name="@operateriid" value="parent.#grdDetalj.@operateriid" />
            </data>
        </datalist>

    </form>
    
</root>