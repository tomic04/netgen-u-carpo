<root>
	<form name="frmDodajPartnera" caption="Dodaj partnera">
        <event type="close">
            <action type="control populate" value="parent.#grdSifrarnikPartnera" />
        </event>
        <layout>
            <group cols="1" rows="1">
                <item row="1" col="1">
                   <textedit name="txtCustomerName" />
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodajPartnera" caption="Spremi">
                    <event type="click">
                    	<action type="variable value" value="$lastId">
                            <parameter value="null"/>
                        </action>
                        <action type="datarun scalar" value="~dtDodajPartnera">
                            <parameter name="lastId"/>
                        </action>
                        <action type="control populate" value="parent.#grdSifrarnikPartnera">
                            <action type="control focus" value="parent.#grdSifrarnikPartnera">
                                <parameter name="id" value="$lastId" type="int"/>
                            </action>
                        </action>
                        <action type="formclose" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani">
                    <event type="click">
                        <action type="formclose" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTrackerAzur" name="dtDodajPartnera">
                <parameter name="@Action" value="addPartner" />
                <parameter name="@CustomerName" value="#txtCustomerName" />
            </data>
        </datalist>
    </form>
</root>