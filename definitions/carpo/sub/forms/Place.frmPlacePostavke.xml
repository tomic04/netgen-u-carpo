<root>

  <form name="frmPlacePostavke" caption="$Caption"  width="800" height="800"  fixedsize="true" saveformsize="false" showversion="true" version="1">
    <!--ne odrađujem na initu iz razloga što još ne poznaje kontrole pa ne zna popuniti na učitavanju forme i grida
        zbog toga se na shown popuni grid-->
    <!--<event type="oninit">
      <action type="datarun reader" value="~dtPostavke" />
    </event>-->
    <event type="onload">
    </event>
    <event type="onshown">
      <action type="control populate" value="#grdPostavke" />
      <action type="variable value">
        <parameter name="Tip" value="Ulaz" />
      </action>
      <action type="control disable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
    </event>

    <layout textposition="left" >
      <!--glavna grupa - 1 red dvije kolone-->
      <group cols="1" rows="2" groupbordervisible="false">

        <!--prvi red prva kolona glavne grupe - grid-->
        <group col="1" row="1" cols="1" rows="1" spacing="2,2,2,1" caption="Postavke">
          <item col="1" row="1" textposition="top" >
            <grid caption="" name="grdPostavke" dataname="dtPostavke" fieldsmartspaces="false"  key="PlacePostavkeId" >
              <event type="focusedrowchanged">
                <action type="datarun reader" value="~dtPopuni"/>
                <action type="control value" value="#txtNaziv">
                  <parameter value="~dtPopuni.@Naziv"/>
                </action>
                <action type="control value" value="#txtDatoteka">
                  <parameter value="~dtPopuni.@Datoteka"/>
                </action>
                <action type="control value" value="#txtTip">
                  <parameter value="~dtPopuni.@Tip"/>
                </action>
                <action type="control value" value="#txtSort">
                  <parameter value="~dtPopuni.@Sort"/>
                </action>
                <action type="control value" value="#txtCaption">
                  <parameter value="~dtPopuni.@Caption"/>
                </action>
                <action type="control value" value="#txtParent">
                  <parameter value="~dtPopuni.@Parent"/>
                </action>
                <action type="control value" value="#txtGridNaziv">
                  <parameter value="~dtPopuni.@GridNaziv"/>
                </action>
                <action type="control value" value="#txtGridDt">
                  <parameter value="~dtPopuni.@GridDt"/>
                </action>
                <action type="control value" value="#txtFunkcija">
                  <parameter value="~dtPopuni.@Funkcija"/>
                </action>
                <action type="control value" value="#rdoEvent">
                  <parameter value="~dtPopuni.@IndEvent"/>
                </action>
                <action type="control value" value="#rdoXml">
                  <parameter value="~dtPopuni.@IndXmlText"/>
                </action>
                <action type="control value" value="#txtEventXml">
                  <parameter value="~dtPopuni.@EventXml"/>
                </action>
                <action type="control value" value="#chkUmirovljeno">
                  <parameter value="~dtPopuni.@IndUmirovljeno"/>
                </action>
                <action type="control value" value="#txtOpis">
                  <parameter value="~dtPopuni.@Opis"/>
                </action>
                <action type="control value" value="#txtMeniGrupa">
                  <parameter value="~dtPopuni.@MeniGrupa"/>
                </action>
                <action type="control attribute" value="#picTest">
                  <parameter name="dbimg" value="~dtPopuni.@SlikaVB"/>
                </action>
              </event>
              <menu>
                <menuitem caption="Obriši" sort="1">
                  <event type="click">
                    <action type="confirm" value="Da li ste sigurni da želite obrisati postavku?" >
                      <action type="datarun reader" value="~dtObrisi"  />
                      <!--<action type="message" value="~dtObrisi.@Poruka" />-->
                    </action>
                    <action type="control populate" value="#grdPostavke" />
                  </event>
                </menuitem>
              </menu>
            </grid>
          </item>
        </group>

        <!--drugi red prva kolona glavne grupe - kontrole-->
        <group col="1" row="2" cols="2" rows="1" spacing="2,2,1,2">
          <!--grupa s kontrolama se sastoji od 2 kolone i 1 reda-->
          <columnsdefinition>
            <column position="1" size="27%"/>
            <column position="2" size="27%"/>
            <column position="3" size="46%"/>
          </columnsdefinition>

          <!--prvi red prva kolona su kontrole - ima 1 kolona i 11 redova-->
          <group col="1" row="1" cols="1" rows="13" groupbordervisible="false" >
            <item caption="Naziv:" col="1" row="1" highlight="false" >
              <textedit name="txtNaziv" datavalue="~dtPopuni.@Naziv" required="true"/>
            </item>
            <item caption="Datoteka:" col="1" row="2">
              <textedit name="txtDatoteka" datavalue="~dtPopuni.@Datoteka" required="true"/>
            </item>
            <item caption="Tip:" col="1" row="3">
              <textedit name="txtTip" datavalue="~dtPopuni.@Tip" required="true"/>
            </item>
            <item caption="Sort:" col="1" row="4">
              <textedit name="txtSort" datavalue="~dtPopuni.@Sort" required="true" format="n0" textposition="left"/>
            </item>
            <item caption="Caption:" col="1" row="5">
              <textedit name="txtCaption" datavalue="~dtPopuni.@Caption" />
            </item>
            <item caption="Parent:" col="1" row="6">
              <textedit name="txtParent" datavalue="~dtPopuni.@Parent" />
            </item>
            <item caption="Naziv grida:" col="1" row="7">
              <textedit name="txtGridNaziv" datavalue="~dtPopuni.@GridNaziv" />
            </item>
            <item caption="Dataset grida:" col="1" row="8">
              <textedit name="txtGridDt" datavalue="~dtPopuni.@GridDt" />
            </item>
            <item caption="Funkcija:" col="1" row="9">
              <textedit name="txtFunkcija" datavalue="~dtPopuni.@Funkcija" />
            </item>
            <item caption="Meni grupa:" col="1" row="10">
              <textedit name="txtMeniGrupa" datavalue="~dtPopuni.@MeniGrupa" format="n0" textposition="left" />
            </item>
            <group col="1" row="11" cols="2" rows="1" groupbordervisible="false">
              <item col="1" row="1" caption="">
                <radioedit name="rdoEvent" caption="Event" value="true" datavalue="~dtPopuni.@IndEvent"/>
              </item>
              <item col="2" row="1" caption="" >
                <radioedit name="rdoXml" caption="XmlText" datavalue="~dtPopuni.@IndXmlText"/>
              </item>
            </group>
            <item caption="" col="1" row="12" >
              <memoedit name="txtEventXml" datavalue="~dtPopuni.@EventXml" required="true"/>
            </item>
            <item col="1" row="13" >
              <checkedit caption="Umirovljeno" name="chkUmirovljeno" datavalue="~dtPopuni.@IndUmirovljeno" />
            </item>
          </group>
          <group col="2" row="1" cols="1" rows="2" groupbordervisible="false">
            <rowsdefinition>
              <row position="1" size="70%"/>
              <row position="2" size="30%"/>
            </rowsdefinition>
            <item col="1" row="1" caption="" >
              <!--<button name="btnSlika"  caption="Slika" />-->
              <!--<pictureedit name="picTest" localfolder="\\Datastation\Install\Carpo\" localimg="~dtPopuni.@slikaNaziv"/>-->
              <!--<pictureedit name="picTest" localfolder="\\datastation\Install\Carpo\" localimg="#grdPostavke.@Slika"/>-->
              <pictureedit name="picTest" dbimg="~dtPopuni.@SlikaVB"/>

              <!--<pictureedit name="picTest" localfolder="d:\slike\" localimg="~dtPopuni.@slikaNaziv"/>-->
              <!--<pictureedit name="picTest" localfolder="c:\users\mpavic\desktop\" localimg="~dtPopuni.@slikaNaziv"/>-->



            </item>
            <item caption="Opis:" col="1" row="2" rowspan="2" textposition="top">
              <memoedit name="txtOpis" datavalue="~dtPopuni.@Opis" />
            </item>
          </group>
        </group>

      </group>


    </layout>

    <!--panelbuttoni spremi i odustani-->
    <panelbuttons>
      <buttons>
        <button name="btnUnesi" caption="Unesi novu postavku" type="add" >
          <event type="click">
            <action if="$Tip==Ulaz" >
              <action type="variable value" value="$Tip">
                <parameter value="Spremi" />
              </action>
              <action type="control disable" value="#grdPostavke, #btnIzmijeni"/>
              <action type="control enable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
              <action type="control caption" value="#btnUnesi" >
                <parameter value="Spremi"/>
              </action>
              <action type="control value" value="#txtDatoteka">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtTip">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtSort">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtCaption">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtParent">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtGridNaziv">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtGridDt">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtFunkcija">
                <parameter value=""/>
              </action>
              <action type="control value" value="#rdoEvent">
                <parameter value="true"/>
              </action>
              <action type="control value" value="#rdoXml">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtEventXml">
                <parameter value=""/>
              </action>
              <action type="control value" value="#chkUmirovljeno">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtOpis">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtNaziv">
                <parameter value=""/>
              </action>
              <action type="control value" value="#txtMeniGrupa">
                <parameter value=""/>
              </action>
            </action>
            <!--varijabla postoji zbog izmjene captiona gumba-->
            <action elseif="$Tip==Spremi">
              <action type="validate"/>
              
              
              <action type="datarun reader" value="~dtSpremi"/>
              <action type="message" value="~dtSpremi.@Poruka"/>
              <action type ="control enable" value="#grdPostavke, #btnIzmijeni" />
              <action type="control caption" value="#btnUnesi" >
                <parameter value="Unesi novu postavku"/>
              </action>
              <action type="control populate" value="#grdPostavke">
                <action type="control focus" value="#grdPostavke">
                  <parameter value="~dtSpremi.@PlacePostavkeId" type="int"/>
                </action>
              </action>
              <action type="variable value" value="$Tip">
                <parameter value="Ulaz" />
              </action>
              <action type="control disable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
            </action>


          </event>
        </button>

        <button name="btnIzmijeni" caption="Izmijeni postavku" >
          <event type="click">
            <action  if="$Tip==Ulaz" >
              <action type="variable value" value="$Tip">
                <parameter value="Izmjena" />
              </action>
              <action type="control disable" value="#grdPostavke, #btnUnesi"/>
              <action type="control enable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
              <action type="control caption" value="#btnIzmijeni" >
                <parameter value="Spremi"/>
              </action>
            </action>
            <!--varijabla postoji zbog izmjene captiona gumba-->
            <action  elseif="$Tip==Izmjena">



              <action type="message" value="#picTest"/>
              
              <action type="validate"/>
              <action type="datarun reader" value="~dtIzmijeni"/>
              <action type="message" value="~dtIzmijeni.@Poruka"/>
              <action type ="control enable" value="#grdPostavke, #btnUnesi" />
              <action type="control caption" value="#btnIzmijeni" >
                <parameter value="Izmijeni postavku"/>
              </action>
              <action type="control populate" value="#grdPostavke">
                <action type="control focus" value="#grdPostavke">
                  <parameter value="~dtIzmijeni.@PlacePostavkeId" type="int"/>
                </action>
              </action>
              <action type="variable value" value="$Tip">
                <parameter value="Ulaz" />
              </action>
              <action type="control disable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
            </action>
          </event>
        </button>
        <button name="btnOdustani"  caption="Odustani"  >
          <event type="click">
            <action if="$Tip==Spremi">
              <action type="control refreshvalue" value="##"/>
              <action type="control disable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
              <action type="control enable" value="#btnIzmijeni,#grdPostavke"/>
              <action type="control caption" value="#btnUnesi" >
                <parameter value="Unesi novu postavku"/>
              </action>
              <action type="variable value" value="$Tip">
                <parameter value="Ulaz" />
              </action>
            </action>
            <action elseif="$Tip==Izmjena">
              <action type="control refreshvalue" value="##"/>
              <action type="control disable" value="#txtNaziv,#txtDatoteka,#txtTip,#txtSort,#txtCaption,#txtParent,#txtGridNaziv,#txtGridDt,#txtFunkcija,#rdoEvent,#rdoXml,#txtEventXml,#chkUmirovljeno,#picTest,#txtOpis,#btnOdustani,#txtMeniGrupa" />
              <action type="control enable" value="#btnUnesi,#grdPostavke"/>
              <action type="control caption" value="#btnIzmijeni" >
                <parameter value="Izmijeni postavku"/>
              </action>
              <action type="variable value" value="$Tip">
                <parameter value="Ulaz" />
              </action>
            </action>
          </event>
        </button>

        <button name="btnIzlaz"  caption="Izlaz" type="cancel" dock="right" >
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlacePostavke" name="dtPostavke">
        <parameter name="@Action" value="grdPostavke_load"/>
      </data>
      <data command="spPlacePostavke" name="dtPopuni">
        <parameter name="@Action" value="Edit_popuni"/>
        <parameter name="@PlacePostavkeId" value="#grdPostavke.@PlacePostavkeId"/>
      </data>
      <data command="spPlacePostavke" name="dtSpremi">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@Datoteka" value="#txtDatoteka"/>
        <parameter name="@Tip" value="#txtTip"/>
        <parameter name="@IndUmirovljeno" value="#chkUmirovljeno"/>
        <parameter name="@Sort" value="#txtSort"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Caption" value="#txtCaption"/>
        <parameter name="@Parent" value="#txtParent"/>
        <parameter name="@GridNaziv" value="#txtGridNaziv"/>
        <parameter name="@GridDt" value="#txtGridDt"/>
        <parameter name="@Funkcija" value="txtFunkcija"/>
        <parameter name="@EventXml" value="#txtEventXml"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@IndEvent" value="1" type="int" if="#rdoEvent==true"/>
        <parameter name="@IndXmlText" value="1" type="int" if="#rdoXml==true"/>
        <parameter name="@MeniGrupa" value="#txtMeniGrupa"/>
      </data>
      <data command="spPlacePostavke" name="dtIzmijeni">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@PlacePostavkeId" value="#grdPostavke.@PlacePostavkeId"/>
        <parameter name="@Datoteka" value="#txtDatoteka"/>
        <parameter name="@Tip" value="#txtTip"/>
        <parameter name="@IndUmirovljeno" value="#chkUmirovljeno"/>
        <parameter name="@Sort" value="#txtSort"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Caption" value="#txtCaption"/>
        <parameter name="@Parent" value="#txtParent"/>
        <parameter name="@GridNaziv" value="#txtGridNaziv"/>
        <parameter name="@GridDt" value="#txtGridDt"/>
        <parameter name="@Funkcija" value="txtFunkcija"/>
        <parameter name="@EventXml" value="#txtEventXml"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@IndEvent" value="1" type="int" if="#rdoEvent==true"/>
        <parameter name="@IndXmlText" value="1" type="int" if="#rdoXml==true"/>
        <parameter name="@MeniGrupa" value="#txtMeniGrupa"/>
      </data>
      <data command="spPlacePostavke" name="dtObrisi">
        <parameter name="@Action" value="Brisanje"/>
        <parameter name="@PlacePostavkeId" value="#grdPostavke.@PlacePostavkeId"/>
      </data>
    </datalist>

  </form>
</root>
