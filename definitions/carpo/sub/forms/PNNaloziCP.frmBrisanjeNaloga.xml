<root version="1.0">
  <!--
  *******************************************************************************************
  FORMA ZA BRISANJE
  *******************************************************************************************
  -->
  <form name="frmBrisanjeNaloga" caption ="Brisanje putnog naloga" width="500" height="100" fixedsize="true" saveformsize="false" >	  	  
	  <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati putni nalog {parent.#grdMaster.@Broj naloga} {parent.#grdMaster.@Djelatnik}?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="false" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"/>
			
			<action if="$indGreske==0">
				<action type="message" value="$poruka"/>
				<action type="control populate keepfocus" value="parent.#grdMaster"/>
				<action type="form close"/>
			</action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPNAzur" name="dtBrisanje">
        <parameter name="@Action" value="obrisi_pn"/>
		<parameter name="@pnnaloziid" value="$PNNaloziId"></parameter>
		<!--<parameter name="@selectedids" value="$selectedids"/>-->
        <parameter name="@indGreske.output.int"></parameter>
        <parameter name="@poruka.output.string"></parameter>
      </data>
    </datalist>
  </form>



</root>