<root>
	<form name="frmManagerStrojeva" path="frmManagerStrojeva.xml"/>
	<form name="frmUpit" caption="Upit">
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<labeledit name="lblPoruka" value="Stroj nije pronađen!"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDodajStroj" caption="Dodaj stroj">
					<event type="click">
						<action type="form open" value="frmManagerStrojeva"/>
						<action type="datarun reader" value="~dtGetVozilo"/>
						<action type="variable value" value="global.$NewVoziloName">
							<parameter value="~dtGetVozilo.@Vozilo"/>
						</action>
						<action type="control value" value="parent.#srcStroj">
							<parameter value="global.$NewVoziloId" text="global.$NewVoziloName"/>
						</action>
						<action type="control value" value="parent.#txtSerijskiBroj">
							<parameter value="~dtGetVozilo.@BrojSasije"/>
						</action>
						<action type="control value" value="parent.#txtBrojReg">
							<parameter value="~dtGetVozilo.@RegOznaka"/>
						</action>
						<action type="control value" value="parent.#txtInvBroj">
							<parameter value="~dtGetVozilo.@InvBroj"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnPonoviTrazenje" caption="Ponovi traženje">
					<event type="click">
						<action type="control value" value="parent.#srcStroj">
							<parameter value=""/>
						</action>
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGetVozilo" command="spVoziloHelp">
				<parameter name="@Action" value="VoziloInfo"/>
				<parameter name="@VoziloId" value="global.$NewVoziloId"/>
			</data>
		</datalist>
	</form>
</root>