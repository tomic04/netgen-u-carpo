<root>
  <form name="frmUnosIzmjenaDet"  width="800" height="800">
    <event type="load">
      <action type="control value" value="#cusUgovorDetail">
        <parameter name="GlaId" value="$GlaId" />
        <parameter name="Operateriid" value="@@operateriid" />
      </action>
      <action type="control value" value="#cusUgovorDetail" if="$DetId==null">
        <parameter name="DetId" value="0" />
      </action>
      <action type="control value" value="#cusUgovorDetail" else="">
        <parameter name="DetId" value="$DetId"/>
      </action>
      <action type="form caption" value="Stavke - unos" if="$DetId==null"/>
      <action type="form caption" value="Stavke - izmjena" else=""/>
    </event>
    
    <layout>
      <group rows="1" cols="1">
        <item row="1" col="1">
          <customcontrol name="cusUgovorDetail" dll="Carpo.Specific" class="Carpo.Specific.UgovoriONajmu.UgovoriDetail" />
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action if="$DetId==null">
              <!--insert stavke-->
              <action if="#cusUgovorDetail.@IsValid==True">
                <action type="message" value="Neispravni podaci. Vrsta troška je najam, a vrijednost ugovorenog iznosa je 0!" if="#cmbVrstaTroska.text=='Najam'&amp;&amp;#txtUgovoreniIznos==0"/>
                <action type="datarun scalar" value="~dtCheckUgovorZaStruju">
                  <parameter name="ugovorZaStrujuPostoji"/>
                </action>
                <action if="$ugovorZaStrujuPostoji==0">
                  <action type="datarun scalar" value="~dtInsertStavka">
                    <parameter name="newDetId"/>
                  </action>
                  <action type="control populate" value="parent.#grdDetStavke"/>
                  <action type="control focus" value="parent.#grdDetStavke">
                    <parameter value="$newDetId" type="int"/>
                  </action>
                  <!--<action type="control value" value="#cusUgovorDetail">
                    <parameter name="IsprazniKontrole" value="false" />
                  </action>-->
                   
                  <!--<action type="variable value">
                    <parameter name="fakeVarZaCiscenjeKontroli" value="#cusUgovorDetail.@IsprazniKontrole"/>
                  </action>-->
                  <!--<action type="#cusUgovorDetail.@IsprazniKontrole==True"/>-->
                  <!--<action type="form close"/>-->
                </action>
              </action>
              <action else="">
                <!--<action type="message" value="Niste utvrdili imovinu."/>-->
              </action>
            </action>
            <action else="">
              <!--edit stavke-->
              <action if="#cusUgovorDetail.@IsValid==True">
                <action type="datarun scalar" value="dtCheckUgovorZaStruju">
                    <parameter name="ugovorZaStrujuPostoji"/>
                  </action>
                  <action if="$ugovorZaStrujuPostoji==0">
                    <action type="datarun nonquery" value="~dtEditStavka"/>
                    <action type="control populate" value="parent.#grdDetStavke"/>
                    <action type="control focus" value="parent.#grdDetStavke">
                      <parameter value="$newDetId" type="int"/>
                    </action>
                    <action type="form close"/>  
                  </action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right" type="cancel"/>
      </buttons>
    </panelbuttons>
    <datalist>
      <!--insert stavke-->
      <data command="spUgovoriNajamDet_Insert" name="dtInsertStavka">
        <parameter name="@UgovoriNajamVrsteOznaka" value="#cusUgovorDetail.@VrstaUgovoraOznaka"/>
        <parameter name="@UgovoriNajamGlaId" value="#cusUgovorDetail.@GlaId"/>  
        <parameter name="@UgovoriNajamVrsteTroskovaId" value="#cusUgovorDetail.@DT.ugovorinajamvrstetroskovaid"/>  
        <parameter name="@PartneriId" value="#cusUgovorDetail.@DT.partneriid"/>  
        <parameter name="@IFRS16" value="#cusUgovorDetail.@DT.ifrs16"/>  
        <parameter name="@Opis" value="#cusUgovorDetail.@DT.opis"/>  
        <parameter name="@DimenzijeId" value="#cusUgovorDetail.@DT.dimenzijeid"/>  
        <parameter name="@DatumPrimopredaje" value="#cusUgovorDetail.@DT.datumprimopredaje"/>  
        <parameter name="@UgovoriNajamOpcijeId" value="#cusUgovorDetail.@DT.ugovorinajamopcijeid"/>  
        <parameter name="@UgovoreniIznos" value="#cusUgovorDetail.@DT.ugovoreniiznos"/>  
        <parameter name="@DevValuteId" value="#cusUgovorDetail.@DT.devvaluteid"/>  
        <parameter name="@DatumPocetkaPlacanja" value="#cusUgovorDetail.@DT.datumpocetkaplacanja"/>  
        <parameter name="@NacinPlacanjaTip" value="#cusUgovorDetail.@DT.nacinplacanjatip"/>  
        <parameter name="@UgovoriNajamPeriodiPlacanjaId" value="#cusUgovorDetail.@DT.ugovorinajamperiodiplacanjaid"/>  
        <parameter name="@ugovorinajamindeksiid" value="#cusUgovorDetail.@DT.ugovorinajamindeksiid"/>  
        <parameter name="@DatumSljedeceIndeksacije" value="#cusUgovorDetail.@DT.datumsljedeceindeksacije"/>  
        <parameter name="@VrijednostIndeksa" value="#cusUgovorDetail.@DT.vrijednostindeksa"/>  
        <parameter name="@DatumZadnjeIndeksacije" value="#cusUgovorDetail.@DT.datumzadnjeindeksacije"/>  
        <parameter name="@PlacanjeNalogomInd" value="#cusUgovorDetail.@DT.placanjenalogomind"/>  
        <parameter name="@DevValutePlacanjaId" value="#cusUgovorDetail.@DT.tecajid"/>  
        <parameter name="@DatumDospijecaSljedecegRacuna" value="#cusUgovorDetail.@DT.datumdospijecasljedecegracuna"/>  
        <parameter name="@Status" value="#cusUgovorDetail.@DT.status"/>  
        <parameter name="@UgovoriNajamMjernaMjestaId" value="#cusUgovorDetail.@DT.ugovorinajammjernamjestaid"/>  
        <parameter name="@UgovoriNajamMjernaMjestaNacinObracunaId" value="#cusUgovorDetail.@DT.ugovorinajammjernamjestanacinobracunaid"/>  
        <parameter name="@UgovoriNajamMjernaMjestaTipPlacanjaId" value="#cusUgovorDetail.@DT.ugovorinajammjernamjestatipplacanjaid"/>  
        <parameter name="@ProstorUNajmu" value="#cusUgovorDetail.@DT.prostorunajmu"/>  
        <parameter name="@RegOznaka" value="#cusUgovorDetail.@DT.regoznaka"/>  
        <parameter name="@SerBr" value="#cusUgovorDetail.@DT.serbr"/>  
        <parameter name="@IznosPenala" value="#cusUgovorDetail.@DT.iznospenala"/>  
        <parameter name="@PlacNajamPrijePocetka" value="#cusUgovorDetail.@DT.placnajamprijepocetka"/>  
        <parameter name="@InicijalniDirektniTroskovi" value="#cusUgovorDetail.@DT.inicijalnidirektnitroskovi"/>  
        <parameter name="@OrganizacijskaJedinica" value="#cusUgovorDetail.@DT.orgshemaid"/> 
        <parameter name="@UtvrdjenaImovina" value="#cusUgovorDetail.@UtvrdenaImovinaBoolValue"/> 
        <parameter name="@UtvrdjenaImovinaRazlog" value="#cusUgovorDetail.@UtvrdenaImovinaOpis"/>
        <parameter name="@BankeId" value="#cusUgovorDetail.@DT.bankeid"/>
        <parameter name="@ProcijenjeniDatumPrestankaVazenjaUgovora" value="#cusUgovorDetail.@DT.procijenjenidatumprestankavazenjaugovora"/>
        <parameter name="@ProductCarRegistrationId" value="#cusUgovorDetail.@DT.ProductCarRegistrationId"/>
        <parameter name="@VrstaTecaja" value="#cusUgovorDetail.@DT.VrstaTecaja"/>
        <parameter name="@OperateriId" value="@@operateriid"/> 
      </data>
      <!--update stavke-->
      <data command="spUgovoriNajamDet_Edit" name="dtEditStavka">
        <parameter name="@UgovoriNajamDetId" value="$DetId"/>
        <parameter name="@UgovoriNajamVrsteOznaka" value="#cusUgovorDetail.@VrstaUgovoraOznaka"/>
