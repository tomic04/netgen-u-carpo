        <parameter name="@UgovoriNajamVrsteTroskovaId" value="#cusUgovorDetail.@DT.ugovorinajamvrstetroskovaid"/>
        <parameter name="@PartneriId" value="#cusUgovorDetail.@DT.partneriid"/>
