<root>
    <form name="frmDonesiNaFakturu" caption="Donos na fakturu" width="" height="" fixedsize="">
		<event type="onclose">
			<action type="control populate" value="parent.#grdGlava" /> 			
		</event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="true">
                <group rows="1" cols="1" row="1" col="1" entermovenextcontrol="true" groupbordervisible="False">                    
					<item caption="Faktura:" row="1" col="1">
						<searchedit netgenfields="true" savelayout="true" name="srcFaktura" required="true" fontbold="true" dataname="Global.dtTraziFak" fieldtext="Fiskalni broj" fieldvalue="FaktureId" datavalue="" datatext="">						
						</searchedit>
                    </item>                  				
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="DONESI" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtDonesi"/>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spFaktureObracun_Donesi" name="dtDonesi">
                <parameter name="@faktureid" value="#srcFaktura" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
				<parameter name="@niz" value="$SelectedIds" type="string" />
            </data>		
        </datalist>
    </form>
</root>