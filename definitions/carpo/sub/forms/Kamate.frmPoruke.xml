<root>
	<form name="frmPoruke" height="300" width="400">
		<event type="shown">
			<action type="datarun reader" value="~dtGetTekst"/>
			<action type="control value" value="txtZag1">
				<parameter value="~dtGetTekst.@Z1"/>
			</action>
			<action type="control value" value="txtZag2">
				<parameter value="~dtGetTekst.@Z2"/>
			</action>
			<action type="control value" value="txtZag3">
				<parameter value="~dtGetTekst.@Z3"/>
			</action>
			<action type="control value" value="txtPod1">
				<parameter value="~dtGetTekst.@P1"/>
			</action>
			<action type="control value" value="txtPod2">
				<parameter value="~dtGetTekst.@P2"/>
			</action>
			<action type="control value" value="txtPod3">
				<parameter value="~dtGetTekst.@P3"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="6">
				<group cols="1" rows="3" col="1" row="1" caption="Zaglavlje">
					<item col="1" row="1" caption="1.">
						<textedit name="txtZag1"/>
					</item>
					<item col="1" row="2" caption="2.">
						<textedit name="txtZag2"/>
					</item>
					<item col="1" row="3" caption="3.">
						<textedit name="txtZag3"/>
					</item>				
				</group>
				<group cols="1" rows="3" col="1" row="4" caption="Podnožje">
					<item col="1" row="1" caption="1.">
						<textedit name="txtPod1"/>
					</item>
					<item col="1" row="2" caption="2.">
						<textedit name="txtPod2"/>
					</item>
					<item col="1" row="3" caption="3.">
						<textedit name="txtPod3"/>
					</item>				
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrint" caption="ISPIŠI">
					<event type="click">
						<action type="datarun nonquery" value="~dtTekst"/>
						<action type="datarun scalar" value="~dtRepxReplace">
							<parameter name="SelectedIds"/>
						</action>
						<action type="print" value="repx:rptKteTekst">
							<!-- <parameter name="id" value="$kntKteGlavaID"/> -->
							<parameter name="id" value="$SelectedIds" TYPE="STRING"/>
						</action>
					</event>
				</button>
				<button name="btnCancel" type="cancel" caption="ODUSTANI"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtTekst" command="spCKteTekstAzur">
				<parameter name="Zag1" value="#txtZag1" /> 
				<parameter name="Zag2" value="#txtZag2" /> 
				<parameter name="Zag3" value="#txtZag3" /> 
				<parameter name="Pod1" value="#txtPod1" /> 
				<parameter name="Pod2" value="#txtPod2" /> 
				<parameter name="Pod3" value="#txtPod3" /> 
			</data>
			<data name="dtGetTekst" command="spCKteTekstQuery"/>
			<data name="dtRepxReplace" type="text" command="select replace('{$SelectedIds}',',','~') as SelectedIds"/>
		</datalist>
	</form>
</root>