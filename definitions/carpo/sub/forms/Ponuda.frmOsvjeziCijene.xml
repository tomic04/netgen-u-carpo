<root>
	<form name="frmOsvjeziCijene" caption="Koje cijene želite osvježiti?" width="300" fixedsize="true">
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<group cols="1" rows="3" entermovenextcontrol="true" groupbordervisible="false">
					<item row="1" col="1">
						<radioedit name="rdoNabavneCijene" caption="Samo nabavne" value="true" >
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item>
					<item row="2" col="1">
						<radioedit name="rdoProdajneCijene" caption="Samo prodajne" >
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item>
					<item row="3" col="1">
						<radioedit name="rdoSveCijene" caption="Nabavne i prodajne" >
							<event type="checkedchanged">
							</event>
						</radioedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="PROVEDI" type="add" dock="right">
					<event type="click">
						<action type="validate" text="Cijena"/>
						<action type="datarun nonquery" value="~dtOsvjezi" />
						<action type="control populate" value="parent.#grdRoba" />
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_PonDet_OsvjeziCijene" name="dtOsvjezi">
				<parameter name="@Ind" value="1" if="#rdoNabavneCijene==true"/>
				<parameter name="@Ind" value="0" elseif="#rdoProdajneCijene==true"/>
				<parameter name="@Ind" value="2" else="#rdoSveCijene==true"/>
				<parameter name="@ProPonGlaId" value="$ProPonGlaId" />
			</data>
		</datalist>
	</form>
</root>