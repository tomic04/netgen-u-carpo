<root version="1.0">
  <form name="frmDodajDokument" caption="$caption" width="500" height="250" >
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$tip==izmjena"/>
    </event>
    <event type="onload">
      <action type="control disable" value="#cmbDokumenti" if="$tip==izmjena" />
    </event>
    <event type="onshown">
    </event>
    <layout>
      <group cols="1" rows="3" groupbordervisible="true" spacing="2,2,2,2">        
        <item  col="1" row="1" caption="Vrsta dokumenta:"  highlight="false" textposition="left">
          <comboedit name="cmbDokumenti" valuefield="ZNRVrsteDokumenataId" displayfield="Naziv" datavalue="~dtGet.@ZNRVrsteDokumenataId" dataname="~dtDokumenti" required="true" />
        </item>
        <item  col="1" row="2" caption="Datum:"   highlight="false" textposition="left">
          <dateedit name="datDatum" value="now" datavalue="~dtGet.@DatumDodavanja"/>
        </item>
        <item  col="1" row="3" caption="Napomena:"   highlight="false" textposition="left">
          <memoedit name="memNapomena"  datavalue="~dtGet.@Napomena"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$tip==izmjena" />
            <action type="datarun reader" value="~dtUnos" else="">
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@NoviId" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRDjelatnici_Help" name="dtDokumenti">
        <parameter name="@Action" value="Dokumenti_cmb"  />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Query" name="dtGet">
        <parameter name="@Action" value="Dokumenti_get" />
        <parameter name="@ZNRDjelatniciDokumentiId" value="$ZNRDjelatniciDokumentiId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtUnos">
        <parameter name="@Action" value="Dokumenti_unos" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@DatumDodavanja" value="#datDatum"/>
        <parameter name="@ZNRVrsteDokumenataId" value="#cmbDokumenti"/>
        <parameter name="@Napomena" value="#memNapomena"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtIzmjena">
        <parameter name="@Action" value="Dokumenti_izmjena" />
        <parameter name="@ZNRDjelatniciDokumentiId" value="$ZNRDjelatniciDokumentiId"/>
        <parameter name="@DatumDodavanja" value="#datDatum"/>
        <parameter name="@Napomena" value="#memNapomena"/>
      </data>
    </datalist>
  </form>
</root>
