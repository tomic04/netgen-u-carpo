<root>
	<form name="frmDodajModel" caption="Dodaj model">
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" caption="Naziv:">
					<textedit name="txtNaziv" required="true" />
				</item>
				<item row="2" col="1" caption="Proizvođač:">
					<comboedit name="cmbProizvodjac" dataname="~dtProizvodjac" valuefield="VozProizvodjacId" displayfield="Naziv" required="true" />
				</item>
				<item row="3" col="1" caption="Tip vozila:">
					<comboedit name="cmbTipVozila" dataname="~dtTipVozila" valuefield="VozTipId" displayfield="Tip" required="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtSpremi">
							<parameter name="VozModelId" />
						</action>
						<action type="datarun reader" value="~dtGetModel" />
						<action type="control value" value="parent.#srcModel">
							<parameter value="~dtGetModel.@VozModelId" text="~dtGetModel.@Naziv" />
						</action>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtProizvodjac" command="spVozProizvodjacQuery">
				<parameter name="@Action" value="0" />
			</data>
			<data name="dtTipVozila" command="spVozTipQuery">
				<parameter name="@Action" value="0" />
			</data>
			<data name="dtSpremi" command="spVozModelAzurCarpo">
				<parameter name="@Action" value="0" />
				<parameter name="@VozProizvodjacId" value="#cmbProizvodjac" />
				<parameter name="@VozTipId" value="#cmbTipVozila" />
				<parameter name="@Naziv" value="#txtNaziv" />
			</data>
			<data name="dtGetModel" command="spVozModelQueryCarpo">
				<parameter name="@Action" value="3" />
				<parameter name="@VozModelId" value="$VozModelId" />
			</data>
		</datalist>
	</form>
</root>
