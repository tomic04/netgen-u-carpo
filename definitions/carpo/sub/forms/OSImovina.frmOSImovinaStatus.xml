<root>

  <!--******************************************UNOS / IZMJENA Statusa****************************************-->
  <form name="frmOSImovinaStatus" caption="$Caption" fixedsize="false" width="500" >
    
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSImovinaStatusiId!=0"/>
    </event>
    <event type="onload">
      <action type="control disable" value="#datDatumOd" if="$OSImovinaStatusiId!=0" />
    </event>
    <event type="onshown">
      <action type="variable value">
        <parameter name="VarPromjenaStatusa" value="0" type="int"/>
      </action>
    </event>
    
    <layout textposition="left" >
      <group cols="1" rows="2" spacing="2,2,2,2" >
        <item caption="Status:" row="1" col="1" highlight="false">
          <comboedit name="cmbStatus" valuefield="OSStatusiId" displayfield="Naziv" datavalue="~dtGet.@OSStatusiId" dataname="~dtStatusi" allownull="false">
            <event type="valuechanged" >
              <action type="variable value">
                <parameter name="VarPromjenaStatusa" value="1" type="int"/>
              </action>
            </event>
          </comboedit>
        </item>
        <item caption="Od datum:" row="2" col="1" highlight="false">
          <dateedit name="datDatumOd"  value="now" datavalue="~dtGet.@DatumOd"   />
        </item>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" function="SpremiST">
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSImovinaStatusiId!=0"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            
            <!-- MIJENJANJE STATUSA -->
            <action type="control populate" value="parent.#grdImovina" if="$VarPromjenaStatusa==1&amp;&amp;global.$filter==Filter imovine"/>
            <action type="control populate" value="parent.#tree" elseif="$VarPromjenaStatusa==1">
              <action type="control focus" value="parent.#tree">
                <parameter value="#cmbStatus" type="int"/>
              </action>             
              <action type="control focus" value="parent.#grdImovina">
                <parameter value="$OSImovinaId" type="int"/>
              </action>
            </action>
            <!-- MIJENJANJE SAMO STAVKE -->
            <action type="form close" />
          </event>
        </button>
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaStatusi_CP" name="dtStatusi">
        <parameter name="@Action" value="Statusi_combo"/>
      </data>
      <data command="spOSImovinaStatusi_CP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSStatusiId" value="#cmbStatus"/>
        <parameter name="@DatumOd" value="#datDatumOd" />
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSImovinaStatusi_CP" name="dtEdit">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@OSImovinaStatusiId" value="$OSImovinaStatusiId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@OSStatusiId" value="#cmbStatus"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSImovinaStatusi_CP" name="dtGet">
        <parameter name="@Action" value="Popuni_izmjena"/>
        <parameter name="@OSImovinaStatusiId" value="$OSImovinaStatusiId"/>
      </data>
   
     
    </datalist>
  </form>
  <!--*******************************************KRAJ UNOS / IZMJENA Statusa**************************************************-->
</root>