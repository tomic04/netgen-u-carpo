  8.9.2021. MG - doradio izgled za DevX 20 
  (namjestio caption ispod tražilice orgshema)
-->

<root>

  <!--******************************************FILTER****************************************-->

  <form name="frmFilter" caption="Filter prikaza" width="580" height="200" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>

    <event type="load">
      <action type="control value" value="#srcOrgShema">
        <parameter value="~dtGet.@orgshemaid" text="~dtGet.orgshemanaziv"/>
      </action>
    </event>

    <layout textposition="left">
      <group cols="1" rows="5">
        <item caption="Org. jedinica:" col="1" row="1" highlight="false">
          <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" datavalue="~dtGet.@orgshemaid" datatext="~dtGet.@OrgShemaNaziv" />
        </item>
        <group rows="1" cols="2" col="1" row="2" groupbordervisible="false">
          <item row="1" col="1" padding="4,90,6,0">
            <labeledit name="lblChkCaption" value="i ispod"/>
          </item>
          <item col="2" row="1" highlight="False">
            <checkedit name="chkPodorgsheme" datavalue="~dtGet.@podorgsheme" />
          </item>
        </group>
        <item caption="Broj mjeseci za arhivu:" col="1" row="3">
          <textedit name="txtArhivaMjeseci" required="true" format="n0" datavalue="~dtGet.@ArhivaMjeseci" textposition="left" />
        </item>
        <item caption="Status obrade za arhivu:" col="1" row="4">
          <comboedit name="cmbArhivaStatus" valuefield="Status" displayfield="Naziv" dataname="~dtArhivaStatusi" datavalue="~dtGet.@ArhivaStatus" />
        </item>
        <item caption="Vrsta obrade za arhivu:" col="1" row="5">
          <comboedit name="cmbArhivaVrstaObrade" valuefield="OOPObradeVrsteId" displayfield="Naziv" dataname="~dtArhivaVrstaObrade" datavalue="#dtGet.@ArhivaVrstaObrade" />
        </item>

      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtFilterAzur" >
              <!--action if="$indGreske==0" type="message" value="$poruka"></action-->
            </action>
            <action type="form close" if="$indGreske==0" />
          </event>
        </button>

        <button name="btnOdustani" type="cancel" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>

      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spDDFilter_help_CP" name="dtGet">
        <parameter name="@Action" value="filter_query" />
        <parameter name="@operateriid" value="@@operateriid" />
      </data>
      <data command="spDDFilter_help_CP" name="dtFilterAzur">
        <parameter name="@Action" value="napuni_filter" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@OrgShemaId" value="#srcOrgShema" />
        <parameter name="@Podorgsheme" value="1" if="#chkPodorgsheme==true" />
        <parameter name="@Podorgsheme" value="0" else="" />
        <parameter name="@ArhivaMjeseci" value="#txtArhivaMjeseci" />
        <parameter name="@ArhivaStatus" value="#cmbArhivaStatus" />
        <parameter name="@ArhivaVrstaObrade" value="#cmbArhivaVrstaObrade" />
        <parameter name="@indGreske.output.int" />
        <parameter name="@poruka.output.string" />
        
      </data>
      <data command="spDD_help_CP" name="dtOrgShema">
        <parameter name="@action" value="orgshema2"/>
        <parameter name="@Tekst" value="#srcOrgShema.text" />
      </data>
      <data command="spDD_help_CP" name="dtArhivaStatusi">
        <parameter name="@Action" value="statusi_obrada" />
      </data>
      <data command="spDD_help_CP" name="dtArhivaVrstaObrade">
        <parameter name="@Action" value="vrste_obrada" />
      </data>
    </datalist>

  </form>
  <!--*******************************************KRAJ FILTER**************************************************-->

</root>
