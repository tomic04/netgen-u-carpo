<root>
	<form name="frmDodijeliVozaca" caption="Dodijeli vozača" fixedsize="false">
		<layout textposition="top" itemspadding="1">
			<group cols="1" rows="2" groupbordervisible="false">
                <item caption="Prijevoznik:" row="1" col="1" textposition="left" highlight="False">
                    <searchedit name="srcPrijevoznik" fontbold="True" datavalue="#dtGet.@PrijevoznikId" dataname="Global.dtPrijevoznik" datatext="#dtGet.@PrijevoznikNaziv" fieldtext="NazivId" fieldvalue="partneriid" netgenfields="True" />
                </item>
                <item caption="Vozač:" row="2" col="1" textposition="left" highlight="False">
                    <searchedit name="srcVozac" fontbold="True" datavalue="#dtGet.@VozacId" dataname="Global.dtVozac" datatext="#dtGet.@Osoba"  fieldtext="Osoba" fieldvalue="OsobeId" netgenfields="True" />
                </item>
			</group>
		</layout>
        <panelbuttons>
			<buttons>
				<button caption="PRIHVATI" dock="right" type="add">
					<event type="click">
                        <action type="confirm" value="Jeste li sigurni da želite dodijeliti vozača označenim nalozima za otpremu?">
                            <action type="control foreachrow selected" value="parent.#grdGlava" >
                                <action type="datarun nonquery" value="~dtSpremi"/>
                            </action>			
                        </action> 
                        <action type="control populate" value="parent.#grdGlava" />
                        <action type="form close"/>				
					</event>
				</button>
				<button caption="ODUSTANI" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
        <datalist>
            <data command="spProd_Notp_DodijeliVozaca" name="dtSpremi" >
                <parameter name="@ProNotpGlaId" value="parent.#grdGlava.@ProNotpGlaId" />
                <parameter name="@PrijevoznikId" value="#srcPrijevoznik" />
                <parameter name="@VozacId" value="#srcVozac" />
            </data>
            <data command="spProd_NotpGla_Query" name="dtGet">
                <parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
            </data>
        </datalist> 
    </form>
</root>



