<parts>
	<part name="prtTabPrivitci">
		<group col="1" row="2" cols="2" rows="2" groupbordervisible="false" caption="PRIVITCI" name="tabPrivitci">
			<columnsdefinition>
				<column position="1" size="800" />
				<column position="2" size="70" />
			</columnsdefinition>
			<rowsdefinition>
				<row position="1" size="40" />
			</rowsdefinition>
			<item col="1" row="1" rowspan="2">
				<grid caption="Popis privitaka" autopopulate="false" name="grdPrivitci" dataname="~dtPrivitci" showgrouppanel="false" showautofilterrow="false" key="KUPSkenerId" bestfitonrefresh="true" savelayout="true">
					<event type="focusedrowchanged">
						<action type="control refreshvalue" value="#picPrivitak">
						</action>
					</event>
					<fields inherited="true">
						<field name="DokBLOB" visible="false" />
					</fields>
				</grid>
			</item>
			<item col="2" row="1">
				<button name="btnDodajPrivitak" image="add" enabled="true">
					<event type="click">
						<action type="method run" value="Dokument">
							<parameter name="id" value="$KupPrometId" />
							<parameter name="operateriId" value="@@operateriid" />
							<parameter name="cs" value="Driver={SQL Server};Server={@@server};Database={@@database};Trusted_Connection=true;" />
							<parameter name="IsDms" value="true" />
						</action>
					</event>
				</button>
			</item>
		</group>
	</part>
</parts>
