<!--partovi za objedinjenu KUP/URA formu frmKnjigaUraKupInsert-->
<parts>
	<part name="prtdtKupPopuni">
		<action type="datarun reader" value="~dtKUP"/>	
		<action type="variable value" value="$PartneriId">
			<parameter value="~dtKUP.@PartneriId"/>
		</action>				
		<action type="control value" value="#txtRacun">
			<parameter value="~dtKUP.@Broj"/>
		</action>
		<action type="control value" value="#datNadnevak">
			<parameter value="~dtKUP.@DatumDokumenta"/>
		</action>
		<action type="control value" value="#datKnjizenja">
			<parameter value="~dtKUP.@DatumDokumenta"/>
		</action>				
		<action type="control value" value="#datDVO">
			<parameter value="~dtKUP.@DatumDokumenta"/>
		</action>	
		<action type="control value" value="#datValuta">
			<parameter value="~dtKUP.@DatumValute"/>
		</action>				
		<action type="control value" value="#srcPartner">
			<parameter value="~dtKUP.@PartneriId" text="~dtKUP.@PartnerNaziv"/>
		</action>		
		<action type="control value" value="#cmbOrgShema">
			<parameter value="~dtKUP.@OrgShemaId"/>
		</action>
		<!--zbog HD52661 uključujem valutu; bio problem s nekreiranjem virmana ako se povuče HRK-->
		<action type="control value" value="#cmbDevValuta">
			<parameter value="~dtKUP.@ValuteId"/>
		</action>		
		<action type="control value" value="#curTecaj">
			<parameter value="0"/>
		</action>			
		<action if="~dtKUP.@ValuteId!=null">
			<!-- <action type="control value" value="#curIznossPdv">-->
			<!-- <parameter value="0"/> -->
			<!-- </action> -->
			<action type="datarun reader" value="~dtTecaj"/>
			<action type="control value" value="#curTecaj" >
				<parameter value="~dtTecaj.@tecaj" type="decimal"/>
			</action>
		</action>
		<action type="control value" value="#curIznossPdv" else="">
			<parameter value="~dtKUP.@Iznos"/>
		</action>	
		<action type="control value" value="#curDevIznos" if="~dtKUP.@ValuteId!=null">
			<parameter value="~dtKUP.@Iznos"/>
		</action>
		<action type="control value" value="#curDevIznos" else="">
			<parameter value="0"/>
		</action>					
		<action type="control value" value="#txtGodina">
			<parameter value="~dtKUP.@Godina"/>
		</action>
		<action type="control value" value="#txtDana">
			<parameter value="~dtKUP.@Dana"/>
		</action>									
		<action type="control value" value="#txtNapomena">
			<parameter value="~dtKUP.@Opis"/>
		</action>
		<!-- eRačun punjenje -->
		<action type="control value" value="#curOsnovica25">
			<parameter value="~dtKUP.@Osnovica25"/>
		</action>				
		<action type="control value" value="#cur25Odbiv">
			<parameter value="~dtKUP.@PorezOdbiv25"/>
		</action>
		<action type="control value" value="#cur25NeOdbiv">
			<parameter value="~dtKUP.@PorezNeOdbiv25"/>
		</action>
		<action type="control value" value="#curOsnovica13">
			<parameter value="~dtKUP.@Osnovica13"/>
		</action>				
		<action type="control value" value="#cur13Odbiv">
			<parameter value="~dtKUP.@PorezOdbiv13"/>
		</action>	
		<action type="control value" value="#cur13Neodbiv">
			<parameter value="~dtKUP.@PorezNeOdbiv13"/>
		</action>				
		<action type="control value" value="#curOsnovica10">
			<parameter value="~dtKUP.@Osnovica10"/>
		</action>	
		<action type="control value" value="#cur10Odbiv">
			<parameter value="~dtKUP.@PorezOdbiv10"/>
		</action>
		<action type="control value" value="#cur10Neodbiv">
			<parameter value="~dtKUP.@PorezNeOdbiv10"/>
		</action>
		<action type="control value" value="#curOsnovica5">
			<parameter value="~dtKUP.@Osnovica5"/>
		</action>
		<action type="control value" value="#cur5Odbiv">
			<parameter value="~dtKUP.@PorezOdbiv5"/>
		</action>	
		<action type="control value" value="#cur5NeOdbiv">
			<parameter value="~dtKUP.@PorezNeOdbiv5"/>
		</action>	
		<action type="control value" value="#curNeoporezivo">
			<parameter value="~dtKUP.@IznosNeoporeziv"/>
		</action>	
		<action type="control value" value="#curNePod">
			<parameter value="~dtKUP.@NePod"/>
		</action>		
		<action type="control value" value="#txtPozivNaBroj">
			<parameter value="~dtKUP.@PozivNaBrojXml"/>
		</action>	
		<action type="control value" value="#txtModel">
			<parameter value="~dtKUP.@ModelXml"/>
		</action>
		<action type="control value" value="#curProlazneStavke">
			<parameter value="~dtKUP.@PovNaknada"/>
		</action>	
		<action type="control value" value="#curIznosBezPdv">
			<parameter value="~dtKUP.@IznosBezPdv"/>
		</action>
		<action type="control value" value="#curPdvUkupno">
			<parameter value="~dtKUP.@PorezUkupno"/>
		</action>					
		<action type="control disable" value="#srcPartner"/>
		<!--sa eventa load-->
		<action type="datarun reader" value="~dtPartneri" if="$PartneriId!=null"/>
		<action type="datarun reader" value="~dtIndUgovor" />		
		<action type="datarun reader" value="~dtTekGodina"/>
		<!--permission za SpremiProknjizi iz KUP-a-->

		<action type="control value" value="#cmbVrstaKnjige" if="$KntVrsteKnjigaUraIdInsert!=null">
			<parameter value="$KntVrsteKnjigaUraIdInsert"/>
		</action>
		<action else="">
			<action type="datarun reader" value="~dtPonudiKnjigu"/>
			<action type="control value" value="#cmbVrstaKnjige" >
				<parameter value="~dtPonudiKnjigu.@KntVrsteKnjigaUraId"/>
			</action>
		</action>
		<!--ako pozivam iz KUP-a daj sljedeći broj od one godine iz koje je račun-overwrite broj-->
		<action if="$KupPrometId!=null">
			<action type="datarun reader" value="~dtPraviBrojDok"/>
			<action type="control value" value="#txtURA">
				<parameter value="~dtPraviBrojDok.@BrojDok"/>
			</action>
		</action>			
		<!--otkomentirano zbog punjenja varijable EUSlucaj-->
		<action type="datarun reader" value="~dtGetPodaci" />
		<action type="variable value" if="~dtGetPodaci.@PDV==G||~dtGetPodaci.@PDV==S||~dtGetPodaci.@PDV==B||~dtGetPodaci.@PDV==A||~dtGetPodaci.@PDV==E">
			<parameter name="EUSlucaj" value="1" type="int" />
		</action>
		<action type="variable value" else="">
			<parameter name="EUSlucaj" value="0" type="int" />
		</action>
		<action type="variable value" value="$PDVN" if="~dtGetPodaci.@PDV==N">
			<parameter value="1" type="int"/>
		</action>
		<action type="variable value" value="$PDVN" else="">
			<parameter value="0" type="int"/>
		</action>				
		<action type="variable value">
			<parameter name="IndUgovor" value="~dtIndUgovor.@IndUgovor" type="int" />
		</action>
		<action type="variable value">
			<parameter name="IndDatDvoDatVal" value="~dtUraDatDVO.@IndDatDVO" type="int" />
		</action>	
		<action type="variable value">
			<parameter name="IznosFakture" value="0" type="decimal" />
		</action>
		<action type="variable value">
			<parameter name="NoviFaktureDobId" value="null" type="int" />
		</action>
		<action type="control disable" value="#txtBrojUCD,#datUCD,#txtBrojZak"/>
		<action type="variable value">
			<parameter name="IbanPubVar" value="~dtIbanPubVar.@DodajIban"/>
		</action>
		<!--sa eventa shown-->
		<action type="control focus" value="#txtRacun"/>
		<action type="control value" value="#cheTem">
			<parameter value="#cheTemLazni"/>
		</action>
		<!--varijabla za provjeru dolazi li do izmjene iznosaspdvom, ako ne, ne treba preračunavati tečaj-->
		<action type="variable value" value="$IzmjenaTecaj">
			<parameter value="0"/>
		</action>				
	</part>
	<part name="prtUraEditPopuni">
		<action type="variable value" if="~dtGetPodaciEdit.@PDV==G||~dtGetPodaciEdit.@PDV==S||~dtGetPodaciEdit.@PDV==B||~dtGetPodaciEdit.@PDV==A||~dtGetPodaciEdit.@PDV==E">
			<parameter name="EUSlucaj" value="1" type="int" />
		</action>
		<action type="variable value" else="">
			<parameter name="EUSlucaj" value="0" type="int" />
		</action>
		<action type="variable value" value="$PDVN" if="~dtGetPodaciEdit.@PDV==N">
			<parameter value="1" type="int"/>
		</action>
		<action type="variable value" value="$PDVN" else="">
			<parameter value="0" type="int"/>
		</action>				
		<!-- <action type="variable value"> -->
			<!-- <parameter name="KUPPrometId" value="~dtGetPodaciEdit.@KupPrometId" type="int"/> -->
		<!-- </action>			 -->
		<action type="datarun reader" value="~dtIndUgovor"/>
		<action type="variable value" value="$DisableDatKnjEdit">
			<parameter value="0"/>
		</action>	
		<action type="variable value">
			<parameter name="IndUgovor" value="~dtIndUgovor.@IndUgovor" type="int" />
		</action>
		<action type="variable value">
			<parameter name="IndDatDvoDatVal" value="~dtUraDatDVO.@IndDatDVO" type="int" />
		</action>	
		<action type="variable value">
			<parameter name="IznosFakture" value="0" type="decimal" />
		</action>
		<action if="~dtGetPodaciEdit.@R1==2">	
			<action type="control value" value="#rbR2">
				<parameter value="true"/>
			</action>					
		</action> 
		<action type="control focus" value="#txtRacun"/>
		<action if="$EUSlucaj==1">
			<action if="~dtGetPodaciEdit.@IznosBezPoreza!=0&amp;&amp;~dtGetPodaciEdit.@DevIznos!=0">
				<action type="datarun reader" value="~dtTecajCalc" />
				<action type="control value" value="#curTecaj">
					<parameter value="~dtTecajCalc.@Tecaj"/>
				</action>
			</action> 				
		</action> 
		<action else="">
			<action type="control value" value="#curTecaj">
				<parameter value="0" />
			</action>
		</action>	
		<!--zbog čudnog baga, control value ovdje-->
		<action type="control value" value="#cmbUgovori">
			<parameter value="~dtGetPodaciEdit.@DobUgovoriId"/>
		</action>	
		<!-- <action type="control disable" value="#btnProknjizi" if="$SpremiProknjizi==0"/>			 -->
	</part>
</parts>
