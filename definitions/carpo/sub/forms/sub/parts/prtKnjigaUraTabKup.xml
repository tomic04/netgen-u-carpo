<parts>
	<part name="prtTabKupLoad">
		<action type="control disable" value="#cmbVrstaPoste,#txtUrudzbeni"/>
	</part>
	<part name="prtTabKupDisableAll">
		<action type="control disable" 
				value="#cmbVrstaPoste,#txtUrudzbeni,#txtVezaNaUrudzbeni,#txtPosiljatelj,#srcPartnerKup,#txtBrojDokumenta,
						#srcNarudzba,#txtRjesenje,#txtOpisKup,#cmbOrgShemaKup,#cmbValutaKup,#txtIznosKup,
						#txtOsnovicaKup,#datDatumDokKup,#datDatumPrijema,#datDatumValuteKup,#txtBrojDanaKup,#btnSpremiKup"/>
	</part>
	<part name="prtTabKupAsParentDisableAll">	
		<action type="control disable" value="parent.#cmbVrstaPoste,parent.#txtUrudzbeni,parent.#txtVezaNaUrudzbeni,parent.#txtPosiljatelj,parent.#srcPartnerKup,parent.#txtBrojDokumenta,
												parent.#srcNarudzba,parent.#txtRjesenje,parent.#txtOpisKup,parent.#cmbOrgShemaKup,parent.#cmbValutaKup,parent.#txtIznosKup,
												parent.#txtOsnovicaKup,parent.#datDatumDokKup,parent.#datDatumPrijema,parent.#datDatumValuteKup,parent.#txtBrojDanaKup,parent.#btnSpremiKup" 
				/>	
	</part>
	<part name="prtTabKup">
		<group col="1" row="1" cols="1" rows="1" name="tabKUP" caption="KUP" groupbordervisible="false" spacing="2,2,2,2" if="$SmijeKUP!=0">											
			<group col="1" row="1" cols="4" rows="9" caption="Urudžbeni podaci" groupbordervisible="true" spacing="2,2,2,2">
				<columnsdefinition>
					<column size="25%" position="1"/>
					<column size="25%" position="2"/>
					<column size="25%" position="3"/>
					<column size="25%" position="4"/>							
				</columnsdefinition>
				<item col="1" row="1" colspan="2" caption="Vrsta pošte:" padding="0" highlight="false">
					<comboedit name="cmbVrstaPoste" required="true" allownull="false" valuefield="KupVrstaPosteId" autopopulate="false" displayfield="naziv" datavalue="~dtGetKup.@KupVrstaPosteId" dataname="~dtVrstaPoste">
						<event type="valuechanged">

						</event>
					</comboedit>
				</item>
				<item col="1" row="2" colspan="2" caption="Urudžbeni broj:" padding="0" highlight="false">
					<textedit name="txtUrudzbeni" enabled="false" datavalue="~dtGetKup.@UrudzbeniBroj"/>
				</item>
				<item col="3" row="2" colspan="2" caption="Veza na urudžbeni broj:" padding="0" highlight="false">
					<textedit name="txtVezaNaUrudzbeni" datavalue="~dtGetKup.@UrudzbeniBrojVeza"/>
				</item>
				<item col="1" row="3" colspan="2" caption="Partner:" padding="0" highlight="false">
					<searchedit  name="srcPartnerKup" required="true" fieldtext="NazivId" fieldvalue="PartneriId" datavalue="~dtGetKup.@PartneriId" datatext="~dtGetKup.@Partner" dataname="~dtPartneriKup" savelayout="true">

					</searchedit>
				</item>
				<item col="3" row="3" colspan="2" caption="Pošiljatelj:" padding="0" highlight="false">
					<textedit name="txtPosiljatelj" datavalue="~dtGetKup.@Posiljatelj"/>
				</item>
				<item col="1" row="4" colspan="2" caption="Broj dokumenta:" padding="0" highlight="false">
					<textedit name="txtBrojDokumenta" required="true" datavalue="~dtGetKup.@Broj"/>
				</item>
				<!-- <item col="3" row="4" colspan="2" caption="Broj UFE:" padding="0" highlight="false"> -->
				<!-- <textedit name="txtBrojUFE"/> -->
				<!-- </item> -->
				<item col="1" row="5" colspan="2" caption="Broj narudžbe:" padding="0" highlight="false">
					<searchedit name="srcNarudzba" fieldtext="BrojNarudzbe" fieldvalue="NabNarGlaId" datavalue="~dtGetKup.@NabNarGlaId" datatext="~dtGetKup.@BrojNarudzbe" dataname="~dtNabNar" savelayout="true"/>
				</item>
				<item col="3" row="5" colspan="2" caption="Rješenje:" padding="0" highlight="false">
					<textedit name="txtRjesenje" datavalue="~dtGetKup.@Rjesenje"/>
				</item>
				<item col="1" row="6" colspan="2" caption="Opis:" padding="0" highlight="false">
					<textedit name="txtOpisKup" datavalue="~dtGetKup.@Opis"/>
				</item>
				<item col="3" row="6" colspan="2" caption="Organizacijska shema:" padding="0" highlight="false">
					<combotreeedit name="cmbOrgShemaKup" autopopulate="false" valuefield="Id" displayfield="Naziv" parentfieldname="ParentId" datavalue="~dtGetKup.@OrgShemaId" dataname="~dtGetOrgShema">
						<event type="valuechanged" raiseonload="false" > 
						</event>
					</combotreeedit>
				</item>	
				<item col="1" row="7" caption="Valuta:" padding="0" highlight="false">
					<comboedit name="cmbValutaKup" autopopulate="false" valuefield="ValuteId" displayfield="Oznaka" datavalue="~dtGetKup.@ValuteId" dataname="~dtGetValute"/>
				</item>							
				<item col="2" row="7" caption="Iznos:" padding="0" highlight="false">
					<textedit name="txtIznosKup" format="n2" value="0" required="true" datavalue="~dtGetKup.@Iznos"/>
				</item>		
				<item col="3" row="7" caption="Osnovica:" padding="0" highlight="false">
					<textedit name="txtOsnovicaKup" value="0" format="n2" required="true" datavalue="~dtGetKup.@Osnovica"/>
				</item>
				<item col="1" row="8" caption="Datum prijema:" padding="0" highlight="false">
					<dateedit name="datDatumPrijema" value="now" required="true" datavalue="~dtGetKup.@DatumPrijema"/>
				</item>
				<item col="2" row="8" caption="Datum dokumenta:" padding="0" highlight="false">
					<dateedit name="datDatumDokKup" value="now" required="true" datavalue="~dtGetKup.@DatumDokumenta"/>
				</item>
				<item col="4" row="8" caption="Datum valute:" padding="0" highlight="false">
					<dateedit name="datDatumValuteKup" value="now" required="true" datavalue="~dtGetKup.@DatumValute"/>
				</item>
				<item col="3" row="8" caption="Broj dana:" padding="0" highlight="false">
					<textedit name="txtBrojDanaKup" format="n0" value="0" datavalue="~dtGetKup.@Dana">
						<event type="leave">
							<action type="datarun reader" value="~dtDatumValuteIzBrojDana"/>
							<action type="control value" value="#datDatumValuteKup">
								<parameter value="~dtDatumValuteIzBrojDana.@DatumValute"/>
							</action>
						</event>
					</textedit>
				</item>	
				<group col="3" row="9" cols="2" rows="2" padding="0" groupbordervisible="false">
					<columnsdefinition>
						<column size="130" position="1"/>
						<!-- <column size="100%" position="2"/> -->
					</columnsdefinition>
					<rowsdefinition>
						<row size="40" position="2"/>
					</rowsdefinition>
					<item col="1" row="2">
						<button name="btnSpremiKup" caption="SPREMI">
							<!--TO DO: nakon spremanja popunjavam urudžbeni broj i kupprometid-->
							<event type="click">
								<!-- <action type="validate"/> ne mogu validate zbog kontrola na URA tabu-->
								<action if="#srcPartnerKup!=null">
									<action if="#txtBrojDokumenta!=null">
										<!--spremi-->
										<action if="$KupPrometId==null">
											<action type="datarun reader" value="~dtKupInsert"/>
											<!-- <action type="message" value="~dtKupInsert.@id"/> -->
											<action type="variable value">
												<parameter name="KupPrometId" value="~dtKupInsert.@id"/>
												<parameter name="UrudzbeniBroj" value="~dtKupInsert.@InfoUrBr"/>
											</action>
											<action type="datarun nonquery" value="~dtPoveziKupSkenerDMS"/>
											<action type="control value" value="#txtUrudzbeni">
												<parameter value="$UrudzbeniBroj"/>
											</action>
											<action type="form caption" value="Unos dokumenta || {#txtBrojDokumenta} || {$UrudzbeniBroj}"/>
											<!-- <action type="control enable" value="#btnSpremi,#btnProknjizi,#cheTem" if="#cmbVrstaPoste.@oznaka==URA"/> -->
											<action type="form close" if="$AutoClose==KUP"/>																	</action>
										<!--izmijeni-->
										<!--TO DO: ne dozvoli izmjenu ako je proknjižen u uru-->
										<action else="$KupPrometId!=null">
											<action type="datarun nonquery" value="~dtKupUpdate"/>
										</action>
										<action if="$KupPrometId!=null&amp;&amp;$AutoClose!=KUP">
											<action if="#cmbVrstaPoste.@oznaka==URA">
												<action type="control enable" value="#btnSpremi,#btnProknjizi,#cheTem" />
												<part name="prtTabUraEnableAll" path="prtKnjigaUraTabUra.xml"/>
												<partsql name="partUraKupSpremiProknjizi" dataname="~dtPartUraKupSpremiProknjizi"/>
											</action>
											<action type="control disable" value="#cmbVrstaPoste"/>
											<action type="datarun reader" value="~dtStatus"/>
											<action type="datarun reader" value="~dtGetKup"/>
											<action type="form caption" value="Izmjena dokumenta || {~dtGetKup.@Broj} || {~dtGetKup.@UrudzbeniBroj} || {~dtGetKup.@BrojUFE} || **** STATUS: {~dtStatus.@Status} ****"/>
											<action type="tab focus" value="tabURA"/>
											<!--TO DO: prepiši podatke s taba KUP-->
											<part name="prtdtKupPopuni" path="prtKnjigaUraKupPopuni.xml"/>
										</action>
									</action>
									<action type="message" value="Obavezan broj dokumenta!" else=""/>
								</action>
								<action type="message" value="Obavezan partner!" else=""/>
							</event>
						</button>
					</item>
					<item col="1" row="2"/>
				</group>
			</group>

		</group>
		<group name="tabKUP" caption="KUP" cols="1" rows="1" elseif="$SmijeKUP==0">
			<item col="1" row="1">
				<labeledit name="lblUpozorenje" fontbold="true" fontsizedelta="3" value="Funkcionalnost nije dozvoljena!"/>
			</item>
		</group>
	</part>
</parts>