	<layout textposition="left">
			<group cols="1" rows="5" > 
				
				 <group col="1" row="1" rows="1" cols="2"> 
				
						
				
					<item col="1" row="1" caption="Konto:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtKonto" valuefield="Konto" displayfield="Naziv" dataname="~dtGetDataPrijava.@Konto" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
					<item col="2" row="1"  caption="Iznos:" fontsizedelta="2" readonly="true">
						<textedit name="curDuguje" value="0" format="n2" readonly="true"  textposition="right">
						</textedit>
					</item>
				</group>					

				 <group col="1" row="2" rows="1" cols="1"> 	
					<item col="1" row="1" caption="Dimenzije:" fontsizedelta="2" textvisible="false" >
						<textedit  name="txtDimenzije" valuefield="Dimenzija" displayfield="Naziv" dataname="~dtGetDataPrijava.@Dimenzija" fontsizedelta="2" textposition="right" readonly="true" allownull="true"/>

					</item>
				</group>

						
								
				<!-- </group> -->
				
				

				
				
