	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">			
				<event type="click">
					<action type ="datarun scalar" value="~datSpremi">
						<parameter name="parent.$KntPrometId" ></parameter>
					</action>
					<!-- zatvaranje forme -->
					<action type="form close" value="frmPrijava"> </action>	
					<!-- popuni varijablu i fokusiraj se na spremljeni podatak, paziti na varijablu u parent formi tj odakle se poziva -->
			
					
				</event>
				
				
			</button>

				<button  name="btnOdustani" caption="Odustani" type="cancel">
					<!-- <action type="control populate" value="#grdStavke"> -->
						<!-- <action type="control focus" value="#grdStavke"> -->
							<!-- <parameter value="$KntPrometId" /> -->
						<!-- </action> -->
					<!-- </action> -->

			</button>
		</buttons>
	</panelbuttons>
	<!-- dohvat podataka -->
	<datalist>

		<data name="dtGetDataPrijava" command="spCKntTroskoviEUQuery">
			 <parameter name="@action" value="16"></parameter> 
			 <parameter name="@KntPrometId" value="global.$KntPrometId"></parameter> 

		</data>
		
		<data name="datSpremi" command="spCKntTroskoviEUAzur">
			 <parameter name="@action" value="Prijava"></parameter> 
			 <parameter name="@Iznos" value="#curDuguje"></parameter> 
			 <parameter name="@KntPrometId" value="global.$KntPrometId"></parameter> 
			 <parameter name="@PrijavljenIznos" value="#curPrijavaIznos"></parameter> 
			 <parameter name="@DatumPrijave" value="#datDatumPrijave"></parameter> 
			 <parameter name="@DokumentPrijave" value="#txtDokumentPrijave"></parameter> 
			 
		</data>
		

		
		<data command="spCKntTroskoviEUIzracun" name="dtGetIznosPrijava">
				<parameter name="@Action" value="PostoUnos" />
				<parameter name="@PostotakPrijava" value="#txtprijavaPosto" />
				<parameter name="@Iznos" value="#curDuguje" />
				
				
		</data>
		
				<data command="spCKntTroskoviEUIzracun" name="dtGetPostotakPrijava">
				<parameter name="@Action" value="IznosUnos" />
				<parameter name="@Iznos" value="#curDuguje" />
				<parameter name="@IznosPrijavaPromjena" value="#curPrijavaIznos" />			
				
		</data>
		
		
	</datalist>
	</form>
</root>