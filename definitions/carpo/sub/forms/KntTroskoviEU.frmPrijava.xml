										<!--Čitam podatak-->
										<action type="datarun reader"  value="~dtGetIznosPrijava" ></action> 
										<!-- Punim kontrolu  -->
										<action type="control value" value="#curPrijavaIznos">
											<parameter  value="~dtGetIznosPrijava.@curPrijavaIznos" />
										</action>										
								</event>
							</textedit>
							
					</item>
					
					
					<item col="2" row="1"  caption="Prijava iznos:" fontsizedelta="2" >
