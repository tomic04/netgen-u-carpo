<root>
    <form  name="frmKupDodajDetaljeNovo" caption="Dodavanje stavke 2222 2">
        <event type="oninit">
            <action type="datarun reader" value="~dtGet" if="$KupUgovoriDetId!=null"/>
            <action type="datarun reader" value="~dtGetPostavke" />
            <action type="datarun reader" value="dtGetImeRabat" />
        </event>
        <event type="onload">
            <action type="control value" value="#txtCijena">
              <parameter value="0" />
            </action>
            <action type="control value" value="#txtKolicina">
                <parameter value="0" />
            </action>
            <action type="datarun reader" value="~dtRabat" />
            <action type="control itemcaption" value="#txtRabat1">   
                <parameter value="~dtGetImeRabat.@Rabat1"/>
            </action>
            <action type="control itemcaption" value="#txtRabat2">   
                <parameter value="~dtGetImeRabat.@Rabat2"/>
            </action>
            <action type="control itemcaption" value="#txtRabat3">   
                <parameter value="~dtGetImeRabat.@Rabat3"/>
            </action>
            <action type="control itemcaption" value="#txtRabat4">   
                <parameter value="~dtGetImeRabat.@Rabat4"/>
            </action>
            <action type="control itemcaption" value="#txtRabat5">   
                <parameter value="~dtGetImeRabat.@Rabat5"/>
            </action>
        </event>
        <event type="onshown">
            <action type="control value" value="#rdoKlasifikacija" if="$KupUgovoriDetId==null||~dtGet.@KlMasterRobaId!=null">
                <parameter value="true" />
            </action>
            <action type="control value" value="#rdoRoba" if="~dtGet.@RobaId!=null">
                <parameter value="true" />
            </action>
            <action type="control value" value="#txtRabatUkupno">
                <parameter value="~dtRabat.@RabatUK" />
            </action>
            <action type="control focus" value="#cmbKlasifikacija" if="#rdoKlasifikacija==True"/>
            <action type="control focus" value="#srcRoba" if="#rdoKlasifikacija==False"/>
            <action type="control disable" value="#srcRoba" if="#rdoKlasifikacija==True"/>
            <action type="control disable" value="#cmbKlasifikacija" if="#rdoKlasifikacija==False"/>
            <action type="control disable" value="#txtKolicina" if="#rdoKlasifikacija==True" />
            <action type="control disable" value="#txtCijena" if="#rdoKlasifikacija==True" />
            <action type="control value" value="#srcRoba">
                <parameter value="~dtGet.@RobaId" text="~dtGet.@Naziv" if="~dtGet.@RobaId!=null&amp;&amp;#rdoRoba==True" />
            </action>
            <action type="control value" value="#cmbKlasifikacija" if="~dtGet.@KlMasterRobaId!=null">
                <parameter value="~dtGet.@KlMasterRobaId" />
            </action>
       </event>
      <!--  <event type="init">
            <action type="datarun reader" value="~dtGetPostavke" />
       </event> -->
            <layout autotaborder="false" focusdirection="downthenacross">
                <group rows="5" cols="1" > <!--podjela forme-->
                    <group rows="2" cols="2" row="1" col="1" caption="Odnosi se na ..." spacing="0,0,0,15"><!--podjela prvog itema forme-->
                        <item row="1" col="1"><!--childovi prvog itema forme-->
                            <radioedit name="rdoKlasifikacija" caption="Klasifikaciju:" required="true">
                                <event type="checkedchanged">
                                    <action type="control enable" value="#cmbKlasifikacija" if="#rdoKlasifikacija==true" >
                                        <action type="control focus" value="#cmbKlasifikacija"></action>
                                    </action>
                                    <action type="control disable" value="#srcRoba,#txtCijena,txtKolicina" if="#rdoKlasifikacija==true" />
                                    <action type="control value" value="#srcRoba" if="#rdoKlasifikacija==true">
                                        <parameter value="null" />
                                    </action>
                                </event>
                            </radioedit>
                        </item>
                        <item row="2" col="1">
                            <radioedit name="rdoRoba" caption="Robu:">
                                <event type="checkedchanged">
                                    <action type="control enable" value="#srcRoba,#txtCijena,txtKolicina" if="#rdoRoba==true" >
                                        <action type="control focus" value="#srcRoba"></action>
                                    </action>
                                    <action type="control disable" value="#cmbKlasifikacija" if="#rdoRoba==true" />
                                    <action type="control value" value="#cmbKlasifikacija" if="#rdoRoba==true">
                                        <parameter value="null" />
                                    </action>
                                </event>
                            </radioedit>
                        </item>
                        <item row="1" col="2">
                            <comboedit name="cmbKlasifikacija" valuefield="KlMasterRobaId"  displayfield="naziv" dataname="Global.~dtPuniKlas"
                            required="true" />
                        </item>
                        <item row="2" col="2">
                            <searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtPuniRobu" required="true"/>
                        </item>
                    </group>             
                    <group rows="3" cols="2" row="2" col="1" caption="Postavke" spacing="0,0,0,15">
                      <item row="1" col="1" caption="Cjenik:">
                          <comboedit name="cmbCjenik" valuefield="vrcjenikid" displayfield="Opis" datavalue="~dtGetPostavke.@VrCjenikId" dataname="~dtPuniCjenik" />
                      </item>
                      <item row="2" col="1" caption="Cijena:">
                        <textedit name="txtCijena" format="n4" datavalue="~dtGet.@Cijena" value="0" allownull="false"/>
                      </item>
                      <item row="3" col="1" caption="Odgoda:">
                        <textedit name="txtodgoda" nulltext="0 dana" value="0"  format="n0" datavalue="~dtGetPostavke.@Odgoda" allownull="false" />  
                      </item>
                      <item row="1" col="2" caption="Naplata:">
                        <comboedit name="cmbNaplata" valuefield="ProNacinNaplateId" displayfield="Opis" datavalue="~dtGetPostavke.@ProNacinNaplateId" dataname="~dtPuniNaplatu" tabindex="0"/>
                      </item>
                      <item row="2" col="2" caption="Isporuka:">
                        <comboedit name="cmbIsporuka" valuefield="ProNacinIsporukeId" displayfield="Naziv" datavalue="~dtGetPostavke.@ProNacinIsporukeId" dataname="~dtPuniIsporuku"  tabindex="1"/>
                      </item>
                      <item row="3" col="2" caption="Količina:">
                        <textedit name="txtKolicina" format="n4" value="0" datavalue="~dtGetPostavke.@Kolicina"  tabindex="2"/>
                      </item>
                    </group>
                    <group rows="3" cols="5" row="3" col="1" caption="Rabat" spacing="0,0,0,4">
                        <item row="1" col="1" caption="Prvi:">
                            <textedit name="txtRabat1" value="0" maxlength="8"  format="n4" type="decimal" datavalue="~dtGet.@Rabat1" allownull="false">
                                <event type="valuechanged">
                                    <action type="datarun scalar" value="Global.~dtRabat">
                                        <parameter name="rabatUK" />
                                    </action>
                                    <action type="control value" value="#txtRabatUkupno">
                                        <parameter value="$rabatUK" />
                                    </action>
                                </event>
                            </textedit>
                        </item>
                        <item row="1" col="2" caption="Drugi:">
                            <textedit name="txtRabat2" value="0" maxlength="8" format="n4" type="decimal" datavalue="~dtGet.@Rabat2" allownull="false">
                                <event type="valuechanged">
                                    <action type="datarun scalar" value="Global.~dtRabat">
                                        <parameter name="rabatUK" />
                                    </action>
                                    <action type="control value" value="#txtRabatUkupno">
                                        <parameter value="$rabatUK" />
                                    </action>
                                </event>
                            </textedit>
                        </item>
                        <item row="1" col="3" caption="Treći:">
                            <textedit name="txtRabat3" value="0" maxlength="8" format="n4" type="decimal" datavalue="~dtGet.@Rabat3" allownull="false">
                                <event type="valuechanged">
                                    <action type="datarun scalar" value="Global.~dtRabat">
                                        <parameter name="rabatUK" />
                                    </action>
                                    <action type="control value" value="#txtRabatUkupno">
                                        <parameter value="$rabatUK" />
                                    </action>
                                </event>
                            </textedit>
                        </item>
                        <item row="1" col="4" caption="Četvrti:">
                            <textedit name="txtRabat4" value="0" maxlength="8"  format="n4" type="decimal" datavalue="~dtGet.@Rabat4" allownull="false">
                                <event type="valuechanged">
                                    <action type="datarun scalar" value="Global.~dtRabat">
                                        <parameter name="rabatUK" />
                                    </action>
                                    <action type="control value" value="#txtRabatUkupno">
                                        <parameter value="$rabatUK" />
                                    </action>
                                </event>
                            </textedit>
                        </item>
                        <item row="1" col="5" caption="Peti:">
                            <textedit name="txtRabat5" value="0" maxlength="8"  format="n4" type="decimal" datavalue="~dtGet.@Rabat5" allownull="false">
                                <event type="valuechanged">
                                    <action type="datarun scalar" value="Global.~dtRabat">
                                        <parameter name="rabatUK" />
                                    </action>
                                    <action type="control value" value="#txtRabatUkupno">
                                        <parameter value="$rabatUK" />
                                    </action>
                                </event>
                            </textedit>
                        </item>
                        <item row="2" col="1" caption="Ukupni rabat:" colspan="2">
                            <textedit name="txtRabatUkupno" value="0"  format="n4" readonly="true" />
                        </item>
                        <item row="3" col="1" caption="Cassa:" colspan="2">
                            <textedit name="txtCassa" format="n4"  value="0" datavalue="~dtGet.@Cassa1"/>
                        </item>
                        <item row="3" col="3" caption="Ukupni popust:" colspan="2">
                          <textedit name="txtUkPopust" value="0"  format="n4" readonly="true"/>
                        </item>
                        <item row="3" col="5" caption="Paušal:">
                            <checkedit name="chkPausal" value="0" datavalue="~dtGet.@indPausal" />
                        </item>
                    </group>
                  <!--<group rows="1" cols="1" row="4" col="1" caption="Cassa:" >
                        <item row="1" col="1">
                            <textedit name="txtCassa" format="n4"  value="0" datavalue="~dtGet.@Cassa1"/>
                        </item>
                    </group> -->
                    <group rows="1" cols="1" row="5" col="1" caption="Napomena:" >
                        <item row="1" col="1">
                            <memoedit name="txtNapomena" maxlength="180" datavalue="~dtGet.@Napomena"/>
                        </item>
                    </group>
                </group>
            </layout>
            <panelbuttons>
                <buttons>
                    <button name="btnSpremi" caption="Spremi" type="add" dock="right">
                        <event type="click">
                            <action type="validate"/>
                            <action type="datarun nonquery" value="~dtDetaljUnos" if="$KupUgovoriDetId==null" />
                            <action type="datarun nonquery" value="~dtDetaljIzmjena" else="" />                  
                            <action type="control populate" value="parent.#grdDetalj" >
                                <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                            </action>
                            <action type="variable value" value="parent.$IndStavki">
                                <parameter value="1" />
                            </action>
                            <action type="form close">      
                            </action>
                            <action type="form open" value="frmKupDodajDetaljeNovo">                     
                            </action>
                            <action type="control enable" value="parent.#btnEditDetalj" />
                            <action type="control enable" value="parent.#btnDelDetalj" />
                            <action type="control enable" value="parent.#btnStavke" />
                            <!--<action type="form open" value="frmKupIzmjena" />-->
                        </event>
                    </button>
                    <button name="btnOdustani" caption="Odustani" image="delete" type="cancel" dock="right"/>
                </buttons>
            </panelbuttons>
            <datalist>
                 <data command="spng_combo" name="dtPuniCjenik">
                    <parameter name="@action" value="VrCjenik" />
                </data>
                <data command="spng_combo" name="dtPuniNaplatu">
                    <parameter name="@action" value="ProNacinNaplate" />
                </data>
                <data command="spng_combo" name="dtPuniIsporuku">
                    <parameter name="@action" value="ProNacinIsporuke" />
                </data>
                <data command="spProd_KupUgoIzmjena_Stavke" name="dtDetaljUnos">
                    <parameter name="@Action" value="0" />
                    <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                    <parameter name="@KlMasterRobaId" value="#cmbKlasifikacija" />
                    <parameter name="@RobaId" value="#srcRoba" />
                    <parameter name="@VrCjenikId" value="#cmbCjenik" />
                    <parameter name="@ProNacinNaplateId" value="#cmbNaplata" />
                    <parameter name="@ProNacinIsporukeId" value="#cmbIsporuka" />
                    <parameter name="@Odgoda" value="#txtodgoda" />
                    <parameter name="@Rabat1" value="#txtRabat1" />
                    <parameter name="@rabat2" value="#txtRabat2" />
                    <parameter name="@Rabat3" value="#txtRabat3" />
                    <parameter name="@Rabat4" value="#txtRabat4" />
                    <parameter name="@Rabat5" value="#txtRabat5" />
                    <parameter name="@Cassa1" value="#txtCassa" />
                    <parameter name="@Cassa2" value="0" />
                    <parameter name="@Cassa3" value="0" />
                    <parameter name="@Cassa4" value="0" />
                    <parameter name="@Cassa5" value="0" />
                    <parameter name="@Cijena" value="#txtCijena" />
                    <parameter name="@PovratUcesce" value="0" />
                    <parameter name="@Kolicina" value="#txtKolicina" />
                    <parameter name="@Napomena" value="#txtNapomena" />
                    <parameter name="@Pausal" value="#chkPausal" />
                </data>
                <data command="spProd_KupUgoIzmjena_Stavke" name="dtDetaljIzmjena">
                    <parameter name="@Action" value="1" />
                    <parameter name="@KupUgovoriDetId" value="parent.#grdDetalj.@KupUgovoriDetId" />
                    <parameter name="@KlMasterRobaId" value="#cmbKlasifikacija" />
                    <parameter name="@RobaId" value="#srcRoba" />
                    <parameter name="@VrCjenikId" value="#cmbCjenik" />
                    <parameter name="@ProNacinNaplateId" value="#cmbNaplata" />
                    <parameter name="@ProNacinIsporukeId" value="#cmbIsporuka" />
                    <parameter name="@Odgoda" value="#txtodgoda" />
                    <parameter name="@Rabat1" value="#txtRabat1" />
                    <parameter name="@rabat2" value="#txtRabat2" />
                    <parameter name="@Rabat3" value="#txtRabat3" />
                    <parameter name="@Rabat4" value="#txtRabat4" />
                    <parameter name="@Rabat5" value="#txtRabat5" />
                    <parameter name="@Cassa1" value="#txtCassa" />
                    <parameter name="@Cassa2" value="0" />
                    <parameter name="@Cassa3" value="0" />
                    <parameter name="@Cassa4" value="0" />
                    <parameter name="@Cassa5" value="0" />
                    <parameter name="@Cijena" value="#txtCijena" />
                    <parameter name="@PovratUcesce" value="0" />
                    <parameter name="@Kolicina" value="#txtKolicina" />
                    <parameter name="@Napomena" value="#txtNapomena" />
                    <parameter name="@Pausal" value="#chkPausal" />
                </data>
                <data command="spProd_KupUgoIzmjena_Stavke" name="dtGetPostavke">
                    <parameter name="@Action" value="4" />
                    <parameter name="@KupUgovoriDetId" value="$KupUgovoriDetId" />
                </data>
                <!--ROBA-->
                <data command="spTraziRoba" name="dtPuniRobu">
                    <parameter name="@action" value="Roba" />
                    <parameter name="@uvjet" value="#srcRoba.text" />
                </data>
           <!-- <data command="spProd_KupUgoIzmjena_Stavke" name="dtGet">
                    <parameter name="@Action" value="2" />
                    <parameter name="@KupUgovoriDetId" value="$KupUgovoriDetId" />
                </data> -->
                <data command="select @rabat1 + @rabat2 + @rabat3 + @rabat4 + @rabat5 as rabatUK" type="text" name="dtRabat">
                    <parameter name="@rabat1" value="~dtGet.@Rabat1" type="decimal" />
                    <parameter name="@rabat2" value="~dtGet.@Rabat2" type="decimal" />
                    <parameter name="@rabat3" value="~dtGet.@Rabat3" type="decimal" />
                    <parameter name="@rabat4" value="~dtGet.@Rabat4" type="decimal" />
                    <parameter name="@rabat5" value="~dtGet.@Rabat5" type="decimal" />
                </data>
                <data command="spProd_kupUgovori_ImeRabata" name="dtGetImeRabat">           
                </data>
            </datalist>
        </form>
    </root>