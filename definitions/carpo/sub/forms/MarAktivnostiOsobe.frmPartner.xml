<root version="8.0.0.2">
	<form name="frmPartner" caption="Izaberi osobe" savelayout="true" width="770" height="500" statusbar="true">
		<event type="load">
			<!-- <action type="control populate" value="#trDrvo" /> -->
		</event>
		<event type="shown">
			<action type="footer text" value="Broj slogova: {#grdOsobe.rowcount}" />
		</event>
		<layout>
			<group cols="1" rows="2" backgroundcolor="" groupbordervisible="false">
				<item col="1" row="1" caption="Partner:" highlight="false">
					<searchedit name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" dataname="dtPartner" function="srcPartner">
						<event type="valuechanged">
							<action type="control populate" value="#grdOsobe" />
							<!-- <action type="footer text" value="Broj slogova: {#grdOsobe.rowcount}" /> -->
							<action type="footer text" value="Broj slogova: {#grdOsobe.rowcount}  Broj označenih slogova: {#grdOsobe.selectedrowscount}" />
						</event>
					</searchedit>
				</item>
				<item col="1" row="2" highlight="false">
					<grid name="grdOsobe" key="OsobeId" savelayout="true" dataname="dtOsobe" bestfitonrefresh="true" autopopulate="true" showcheckboxes="true" keepselectionafterfilter="true">
						<fields>
							<field name="KeyContact" caption="Key" />
							<field name="OdjelNaziv" caption="Odjel" />
							<field name="KlFunkcijeNaziv" caption="Funkcija" />
							<field name="Osoba" caption="Osoba" />
							<field name="Telefon" caption="Telefon" />
							<field name="Mobitel" caption="Mobitel" />
							<field name="LNemail" caption="Privatni Email" />
							<field name="PSemail" caption="Poslovni Email" />
							<field name="Email" caption="E-mail tvrtke" />
							<field name="ParStruNaziv" caption="Lokacija" />
							<field name="ParStruAdresa" caption="Adresa lokacije" />
							<field name="Fax" caption="Fax" />
							<field name="Lokal" caption="Lokal" />
						</fields>
						<event type="selectionchanged">
							<action type="footer text" value="Broj slogova: {#grdOsobe.rowcount}  Broj označenih slogova: {#grdOsobe.selectedrowscount}" />
						</event>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="DODAJ">
					<event type="click">
						<action type="control foreachrow selected" value="#grdOsobe">
							<action type="datarun nonquery" value="~dtDodaj">
							</action>
						</action>
						<action type="control populate" value="parent.#grdStavke" />
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTraziPartneri" name="dtPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtOsobe">
				<parameter name="@Action" value="4" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@Id" value="#srcPartner" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtDodaj">
				<parameter name="@Action" value="0" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@PartneriId" value="#grdOsobe.@partneriid" />
				<parameter name="@LnOsoParId" value="#grdOsobe.@LnOsoParId" />
				<parameter name="@OsobeId" value="#grdOsobe.@OsobeId" />
			</data>
		</datalist>
	</form>
</root>
