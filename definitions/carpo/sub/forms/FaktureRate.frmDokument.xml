<root version="1.0.0.1">
	<form name="frmDokument" type="master" caption="Uvjeti plaćanja, Broj Fakture: '{$BrojDok}', od Datum Fakture: '{$DatumDok}'" width="500" height="600" statusbar="true">
		<event type="init"/> 
		<event type="load">	
			<action type="variable value" >
				<parameter name="NoviId" value="0" type="int"/>
				<parameter name="FaktureID" value="$FaktureID" /> 
			</action>  
			<action type="control populate" value="#grdDokument"/>
		</event>
		<event type="shown">	
			<action type="control populate" value="#grdDokument"/>
		</event>
		<layout itemspadding="1" >
			<group cols="1" rows="5" groupbordervisible="false">
				<group cols="1" rows="1" col="2" row="3" groupbordervisible="false">
					<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
						<item row="1" col="1" highlight="False" >
							<grid name="grdDokument" dataname="~dtgrdDok" header="" headeralign="center" multiselect="false" key="brojDana" showgrouppanel="true" showfooter="false" showautofilterrow = "false" savelayout="true">												
								<fields>	
									<field name="brojDana" caption="Broj Dana "/>
									<field name="datumValute" caption="Datum Valute"/>
									<field name="Vrijednost" caption="Vrijednost "/>
									<field name="Naziv" caption="Instr. Plaćanja"/>
								</fields>
							</grid>
						</item>
					</group>
				</group>	
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIzmjeni" caption="&amp;Izmjeni" type="edit" dock="left">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
							<parameter name="tekst" value="izmjena" />
							<parameter name="ID" value="#grdDokument.@ProNaplataRateId" />
						</action>
						<action type="control populate keepfocus" value="#grddokument"/>
					</event>
				</button>
				<button name="btnIspis" caption="Ispiši"  dock="right" >
					<event type="click">
						<action type="control printcontrol" value="#grdDokument"/>
					</event>
				</button>
				<button caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCProNaplataRateQuery" name="dtgrdDok">
				<parameter name="@action" value="5"/>
				<parameter name="@Id" value="$FaktureID"/>
			</data>
			<data command="spCProNaplataRateAzur"  name="dtDelete">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="#grdDokument.@ProNaplataRateId" />
			</data>
			<data command="spCProNaplataRateQuery" name="dtNacinPlac">
				<parameter name="@Action" value="6" />
			</data>	
			<data command="spCProNacinNaplateQuery" name="dtProNaplata">
				<parameter name="@Action" value="0" />
			</data>	
			<data command="spCBodoviQuery" name="dtbodovi">
				<parameter name="@Action" value="0" />
			</data>	
		</datalist>	
	</form>
	<form name="frmDodaj" path="frmDodaj.xml"/>
	<form name="frmIzmjeni" path="frmIzmjeni.xml"/>
	<form name="frmGeneriraj" path="frmGeneriraj.xml"/>


</root>