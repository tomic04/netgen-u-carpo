<root>
    <form name="frmKreiranaFaktura" caption="Obavijest" width="400" height="150" fixedsize="">
        <event type="oninit">
            <action type="datarun reader" value="~dtGet" />
			<action type="variable value">
				<parameter name="PartneriId" value="~dtGet.@PartneriId" />
			</action>				
        </event>
        <event type="onshown">
			<action type="control value" value="#lblFaktura">
				<parameter value="Uspješno je kreirana faktura br. {$Broj}.\nMolimo odabrati jednu od ponuđenih opcija."/>
			</action>
        </event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group rows="1" cols="1" row="1" col="1" entermovenextcontrol="true" groupbordervisible="false">
                    <item caption="" row="1" col="1" >
                        <labeledit name="lblFaktura" datavalue="" prefix="" value=""  sufix="" multiline="true" fontsizedelta="5"/>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
				<button name="btnPrintFak" caption="IS&amp;PIŠI" dataname="Global.dtPrintFak" displayfield="Opis" >
					<event type="click">
						<action type="control print" value="parent.#grdGlava">
							<action type="print template" value="#btnPrintFak.@Template">
								<parameter name="id" value="$FaktureId" />
							</action>
						</action>
					</event>
				</button>
                <button caption="POGLEDAJ" type="add" dock="left">
                    <event type="click">
                    </event>
                </button>				
                <button caption="ZATVORI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
    </form>
</root>