<root>
	<form name="frmUgovorAzur" caption="Ugovori Supporta">
		<event type="init">
			<action type="variable value" value="global.$FormOpen">
				<parameter value="1"/>
			</action>
		</event>
		<event type="shown">
			<action type="control populate" value="#grdUgovorAzur"/>
		</event>
		<event type="close">
			<action type="control populate" value="parent.#grdMaster"/>
			<action type="variable value">
				<parameter name="global.FormOpen" value="0" type="int"/>
			</action>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1">
					<grid name="grdUgovorAzur" dataname="~dtMaster" caption="Ugovori Supporta {global.$Datum::dd.MM.yyyy.}" showcheckboxes="true" multiselect="true" key="suppKorisnikId" bestfitonrefresh="true">
						<fields>
							<field name="Naziv" caption="Support nositelj"/>
							<field name="OsnovicaLic" caption="Osnovica Lic"/>
							<field name="Licenca" caption=" "/>
							<field name="OsnovicaDB" caption="Osnovica DB"/>
							<field name="DB" caption=" "/>
							<field name="OsnovicaMP" caption="Osnovica MP"/>
							<field name="MP" caption=" "/>
							<field name="OsnovicaDev" caption="Osnovica Dev"/>
							<field name="Razvoj" caption=" "/>
							<field name="RabatCAL" caption="Rabat CAL"/>
							<field name="SuppRabatCAL" caption=" "/>
							<field name="RabatLoy" caption="Rabat Loy"/>
							<field name="SuppRabatLoy" caption=" "/>
						</fields>
						<styles>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==OsnovicaLic&amp;&amp;#grdUgovorAzur.@OsnovicaLic!=#grdUgovorAzur.@Licenca"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==OsnovicaDB&amp;&amp;#grdUgovorAzur.@OsnovicaDB!=#grdUgovorAzur.@DB"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==OsnovicaMP&amp;&amp;#grdUgovorAzur.@OsnovicaMP!=#grdUgovorAzur.@MP"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==OsnovicaDev&amp;&amp;#grdUgovorAzur.@OsnovicaDev!=#grdUgovorAzur.@Razvoj"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==RabatCAL&amp;&amp;#grdUgovorAzur.@RabatCAL!=#grdUgovorAzur.@SuppRabatCAL"/>
							<style name="backgroundcolor" value="green" if="#grdUgovorAzur.fieldname==RabatLoy&amp;&amp;#grdUgovorAzur.@RabatLoy!=#grdUgovorAzur.@SuppRabatLoy"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==OsnovicaLic&amp;&amp;#grdUgovorAzur.@OsnovicaLic!=#grdUgovorAzur.@Licenca"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==OsnovicaDB&amp;&amp;#grdUgovorAzur.@OsnovicaDB!=#grdUgovorAzur.@DB"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==OsnovicaMP&amp;&amp;#grdUgovorAzur.@OsnovicaMP!=#grdUgovorAzur.@MP"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==OsnovicaDev&amp;&amp;#grdUgovorAzur.@OsnovicaDev!=#grdUgovorAzur.@Razvoj"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==RabatCAL&amp;&amp;#grdUgovorAzur.@RabatCAL!=#grdUgovorAzur.@SuppRabatCAL"/>
							<style name="fontcolor" value="white" if="#grdUgovorAzur.fieldname==RabatLoy&amp;&amp;#grdUgovorAzur.@RabatLoy!=#grdUgovorAzur.@SuppRabatLoy"/>
						</styles>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="control foreachrow selected" value="grdUgovorAzur">
							<action type="datarun nonquery" value="~dtSpremi"/>
						</action>
						<action type="control populate" value="#grdUgovorAzur"/>
					</event>
				</button>
				<button name="btnZatvori" caption="Zatvori">
					<event type="click">
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="variable value">
							<parameter name="global.FormOpen" value="0" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnFilter" caption="Filter" dock="right">
					<event type="click">
						<action type="form open" value="frmFilter"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSpremi" command="spSuppIzracunAzurCarpo">
				<parameter name="@SuppKorisnikId" value="#grdUgovorAzur.@SuppKorisnikId"/>
				<parameter name="@Datum" value="global.$Datum"/>
				<parameter name="@Osnovica" value="#grdUgovorAzur.@IznosUkupneLicence"/>
				<parameter name="@IznosProsSupp" value="#grdUgovorAzur.@IznosProsSupporta"/>
				<parameter name="@SuppModelProsId" value="#grdUgovorAzur.@SuppModelProsId"/>
				<parameter name="@RabatAdmin" value="#grdUgovorAzur.@RabatAdmin"/>
				<parameter name="@RabatDodatni" value="#grdUgovorAzur.@RabatDodatni"/>
				<parameter name="@RabatRef" value="#grdUgovorAzur.@RabatRef"/>
				<parameter name="@IznosSuppKriticne" value="#grdUgovorAzur.@IznosSuppKriticne"/>
				<parameter name="@Opis" value="#grdUgovorAzur.@Opis"/>
				<!-- <parameter name="@Popust" value=" -->
				<parameter name="@RabatCAL" value="#grdUgovorAzur.@RabatCAL"/>
				<parameter name="@RabatLoy" value="#grdUgovorAzur.@RabatLoy"/>
				<parameter name="@IznosSupportaLic" value="#grdUgovorAzur.@IznosSupportaLic"/>
				<parameter name="@IznosSupportaRazvoj" value="#grdUgovorAzur.@IznosSupportaRazvoj"/>
				<parameter name="@IznosSupportaMp" value="#grdUgovorAzur.@IznosSupportaMp"/>
				<parameter name="@IznosSupportaDb" value="#grdUgovorAzur.@IznosSupportaDb"/>
				<parameter name="@IznosITsupport" value="#grdUgovorAzur.@IznosITsupport"/>
				<parameter name="@IznosSQLsupport" value="#grdUgovorAzur.@IznosSQLsupport"/>
				<parameter name="@IznosSupporta" value="#grdUgovorAzur.@IznosSupporta"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@Izvor" value="A"/>
				<parameter name="@OsnovicaLic" value="#grdUgovorAzur.@Licenca"/>
				<parameter name="@OsnovicaDB" value="#grdUgovorAzur.@DB"/>
				<parameter name="@OsnovicaMP" value="#grdUgovorAzur.@MP"/>
				<parameter name="@OsnovicaDev" value="#grdUgovorAzur.@Razvoj"/>
				<parameter name="@StopaLic" value="#grdUgovorAzur.@StopaLic"/>
				<parameter name="@StopaDB" value="#grdUgovorAzur.@StopaDB"/>
				<parameter name="@StopaMP" value="#grdUgovorAzur.@StopaMP"/>
				<parameter name="@StopaDev" value="#grdUgovorAzur.@StopaDev"/>
				<parameter name="@StopaITsupport" value="#grdUgovorAzur.@StopaITsupport"/>
				<parameter name="@StopaSQLsupport" value="#grdUgovorAzur.@StopaSQLsupport"/>
				<parameter name="@NapomenaKriticne" value="#grdUgovorAzur.@NapomenaKriticne"/>
				<parameter name="@ProsSuppCSata" value="#grdUgovorAzur.@ProsSuppCSata"/>
				<parameter name="@ProsSuppSati" value="#grdUgovorAzur.@ProsSuppSati"/>
				<parameter name="@ProsSuppPopust" value="#grdUgovorAzur.@ProsSuppPopust"/>
			</data>
			<data name="dtMaster" command="spSuppIzracunUgovoriSupportaCarpo">
				<parameter name="@Datum" value="global.$Datum"/>
			</data>
		</datalist>
	</form>
</root>