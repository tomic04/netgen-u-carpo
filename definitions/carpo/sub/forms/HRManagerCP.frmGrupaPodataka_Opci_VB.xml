<root>
	<!--
  Komentari:
  08.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  05.05.2022. Jadranka Vučenović Vojvodić - dorada forme za unos boravišta
  -->
	<form name="frmOpci_VB" caption="Izmjena podataka za {parent.#txtPrezime} {parent.#txtIme}" width="600" height="600" >
		<event type="init">
			<action  type="datarun reader" value="~dtOpcePodatke" if="$HRKadroviId!=0"/>
		</event>
		<event type="shown">
		<action if="#txtMaticniBroj!=null">
		<action type="control disable" value="#btnUnos" ></action> 
		</action>
			<action if="$Tip=='Izmjena'">
				<action type="control value" value="#srcMjestoPrebivanja">
					<parameter text="~dtOpcePodatke.@NazivPrebivanja" value="~dtOpcePodatke.@ID" />
				</action>
				<action type="control value" value="#srcBoraviste">
					<parameter text="~dtOpcePodatke.@MjestoBoraviste" value="~dtOpcePodatke.@Boraviste" />
				</action>
<action type="control value" value="#cmbUlica">
					<parameter text="~dtOpcePodatke.@Naziv" value="~dtOpcePodatke.@Uliceid"  />
				</action>
				<action type="control disable" value="#dtDatumRodjenja" if="~dtOpcePodatke.@DatumRodenja==null"></action> 
				<action if="~dtOpcePodatke.@DatumRodenja==null">
					<action type="control value" value="#dtDatumRodjenja" >
						<parameter value="now" />
					</action>
				</action>
			</action> 
		</event>
		<layout>
			<group cols="1" rows="2" caption="Opći podaci" groupbordervisible="true">
				<group cols="4" rows="3" groupbordervisible="true" col="1" row="1" spacing="2,2,2,1">
					<columnsdefinition>
						<column  position="1" size="150" /> 
						<column  position="2" size="150" />  
						<column  position="3" size="150" /> 
						<column  position="4" size="50" />  
					</columnsdefinition>
					<rowsdefinition>
						<row  position="1" size="55" /> 
					</rowsdefinition>
					<item row="1" col="1" highlight="false" caption="Ime:">
						<textedit name="txtIme" datavalue="~dtOpcePodatke.@Ime" />
					</item>
					<item row="1" col="2" caption="Ime roditelja:" highlight="false">
						<textedit name="txtImeR" datavalue="~dtOpcePodatke.@ImeRoditelja" />
					</item>
					<item row="1" col="3" caption="Matični broj:" highlight="false" >
						<textedit name="txtMaticniBroj" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtOpcePodatke.@MaticniBroj" >
						
						</textedit>
					</item>
					<item row="1" col="4" highlight="false" padding="10">
						<button name="btnUnos" caption="Novi" > 
							<event type="click">     
								<action type="datarun reader" value="dtMaticniBroj">

									<action type="control value" value="#txtMaticniBroj" >
										<parameter value="~dtMaticniBroj.@maticnibroj" />
									</action>
								</action>						 
							</event>  
						</button>
					</item>
					<item row="2" col="1" caption="Prezime:" highlight="false" >
						<textedit name="txtPrezime" datavalue="~dtOpcePodatke.@Prezime" />
					</item>
					<item row="2" col="2" caption="Djevojačko prezime:" highlight="false" >
						<textedit name="txtDjPrezime" datavalue="~dtOpcePodatke.@DjevojackoPrezime" />
					</item>
					<item row="2" col="3" caption="Ident. broj:" highlight="false" colspan="2">
						<textedit name="txtIdentBroj" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtOpcePodatke.@IdentBroj" />
					</item>
					<item row="3" col="1" caption="JMBG:" highlight="false" >
						<textedit name="txtJMBG" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtOpcePodatke.@JMBG" />
					</item>
					<item row="3" col="2" caption="OIB:" highlight="false" >
						<textedit name="txtOIB" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtOpcePodatke.@OIB" />
					</item>

					<item row="3" col="3" caption="Datum rođenja:" highlight="false" >
						<dateedit name="dtDatumRodjenja" value="now" allownull="true" datavalue="~dtOpcePodatke.@DatumRodenja">
						</dateedit>
					</item>
					<item row="3" col="4" caption="Spol:" highlight="false" >
						<textedit name="txtSpol" format="[M]|[Ž]|[Z]" formattype="regex" tooltip="Možete upisati samo 'M' ili 'Ž' (Z)" datavalue="~dtOpcePodatke.@Spol" />
					</item>

				</group>
				<group cols="4" rows="5" groupbordervisible="true" col="1" row="2" spacing="2,2,1,2">
					<columnsdefinition>
						<column  position="1" size="150" /> 
						<column  position="2" size="150" />  
						<column  position="3" size="180" /> 
						<column  position="4" size="20" />  

					</columnsdefinition>
					<rowsdefinition>
						<row  position="1" size="55" /> 
						<row  position="2" size="55" /> 
					</rowsdefinition>
					<item row="1" col="1" highlight="false" caption="Mjesto rođenja:" colspan="2">
						<comboedit name="cmbMjestoRodjenja" valuefield="mjestaid" displayfield="naziv" dataname="~dtMjestoRodjenja" datavalue="~dtOpcePodatke.@MjestoRodenjaId"/>
					</item>
					<item row="1" col="3" caption="Mjesto rođenja:" highlight="false" >
						<textedit name="txtMjestoR" datavalue="~dtOpcePodatke.@MjestoRodenja"/>
					</item>
					<item row="1" col="4" highlight="false" padding="10">
					<button name="btnUnos" image="add" imagelocation="middlecenter"> 
					<event type="click">   
					<action type="form open" value="frmUnosMjesta"> 
					<parameter name="Caption" value="Mjesta"/>		  	
					</action> 								
					</event>   
					</button>
					</item>
					<item row="2" col="1" highlight="false" caption="Mjesto prebivanja:" colspan="2">
						<searchedit name="srcMjestoPrebivanja" dataname="~dtMjestoPrebivanja" fieldtext="Naziv" fieldvalue="mjestaid"  >
							<!-- AKO JE UNESENO MJESTO PREBIVANJA U TRAŽILICU, DA NAPUNI COMBO SA ULICAMA IZABRANOG MJESTA PREBIVANJA-->
							<event type="valuechanged">
								<action if="#srcMjestoPrebivanja!=null">
									<action type="datarun reader" value="dtUlice">
										<action type="control populate" value="#cmbUlica" />
									</action>
								</action>
								<action else="">
									<action type="control populate" value="#cmbUlica" />
								</action>
							</event>
						</searchedit>
					</item>
					<item row="2" col="3" highlight="false" caption="Boravište:" colspan="2">
						<searchedit name="srcBoraviste" dataname="~dtMjestoBoraviste" fieldtext="Naziv" fieldvalue="mjestaid"  >
						</searchedit>
					</item>
					
					<item row="3" col="1" highlight="false" caption="Ulica:" >
						<comboedit name="cmbUlica" valuefield="Uliceid" displayfield="Naziv" dataname="~dtUlica" />
					</item>
					<item row="3" col="4" highlight="false" padding="8">
	
						<button name="btnUnosUlice" image="add" imagelocation="middlecenter">
							<event type="click">
								<action type="form open" value="frmUnosUlice"></action>
							</event>
						</button>
	
					</item>
					<item row="3" col="2" caption="Kućni broj:" highlight="false" >
						<textedit name="txtKucniBroj"   datavalue="~dtOpcePodatke.@KucniBroj" />
					</item>
					<item row="3" col="3" caption="Kućni broj dodatak:" highlight="false">
						<textedit name="txtKucniBrojD" datavalue="~dtOpcePodatke.@KucniBrojDodatak" />
					</item>
					<item row="4" col="1" highlight="false" caption="Državljanstvo:" >
						<comboedit name="cmbDrzavljanstvo" valuefield="hrdrzavljanstvoid" displayfield="naziv" dataname="~dtDrzavljanstvo" datavalue="~dtOpcePodatke.@HRDrzavljanstvoId"/>
					</item>
					<item row="4" col="2" highlight="false" caption="Nacionalnost:" >
						<comboedit name="cmbNacionalnost" valuefield="hrnacionalnostid" displayfield="naziv" dataname="~dtNacionalnost" datavalue="~dtOpcePodatke.@HRNacionalnostId"/>
					</item>
					<item row="4" col="3" highlight="false" caption="Smještaj:" colspan="2">
						<comboedit name="cmbSmjestaj" valuefield="SmjestajId" displayfield="naziv" dataname="~dtSmjestaj" datavalue="~dtOpcePodatke.@SmjestajId"/>
					</item>
					<item row="5" col="1" caption="Opis:" highlight="false" colspan="4" >
						<memoedit name="memOpis"  datavalue="~dtOpcePodatke.@Memo">
						</memoedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$hrkadroviid!=0">
							<action type="datarun reader" value="~dtIzmjenaDjelatnika"/>
							<action if="$indGreske==0">
								<action type="control populate" value="parent.#grdPodaci"/>	
								<action type="message" value="Uspješno spremljeno!"/>

								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
							<!-- AKO OIB NIJE ISPRAVAN FOKUSIRA SE NA POLJE ZA OIB PRILIKOM IZMJENE-->
							<action if="$indGreske==1">
								<action type="control focus" value="#txtOIB" >
									<parameter value="~dtIzmjenaDjelatnika.@OIB" />
								</action>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRHelp" name="dtDrzavljanstvo">
				<parameter name="@action" value="drzavljanstvo"/>
			</data>
			<data command="spHRHelp" name="dtNacionalnost">
				<parameter name="@action" value="nacionalnost"/>
			</data>
			<data command="spHRHelp" name="dtMjestoRodjenja">
				<parameter name="@action" value="mjesto_rodenja"/>
			</data>
			<data command="spHRHelp" name="dtMjestoPrebivanja">
				<parameter name="@action" value="mjesto_prebivanja"/>
				<parameter name="@tekst" value="#srcMjestoPrebivanja.text"/>
			</data>
			<data command="spHRHelp" name="dtMjestoBoraviste">
				<parameter name="@action" value="mjesto_boravista"/>
				<parameter name="@tekst" value="#srcBoraviste.text"/>
			</data>
			<data command="spHRHelp" name="dtUlica">
				<parameter name="@action" value="ulica" />
				<parameter name="@mjestaid" value="#srcMjestoPrebivanja"/>
			</data>
			<data command="spHRHelp" name="dtSmjestaj">
				<parameter name="@action" value="smjestaj"/>
			</data>
			<data command="spHRHelp" name="dtMaticniBroj">
				<parameter name="@action" value="novi_maticni_broj" />
			</data>


			<data command="spHRManagerMaster_Podaci_Opci_CP_VB" name="dtOpcePodatke">
				<parameter name="@action" value="getOpcePodatke" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>

			<data command="spHRManagerMaster_Podaci_Opci_CP_VB" name="dtIzmjenaDjelatnika">
				<parameter name="@action" value="izmjena_kadra"/>
				<parameter name="@hrkadroviid" value="$HRKadroviId"/>
				<parameter name="@Ime" value="#txtIme"/>
				<parameter name="@Prezime" value="#txtPrezime"/>
				<parameter name="@MaticniBroj" value="#txtMaticniBroj"/>
				<parameter name="@imeroditelja" value="#txtImeR"/>
				<parameter name="@djevojackoprezime" value="#txtDjevojackoPrezime"/>
				<parameter name="@IdentBroj" value="#txtIdentBroj"/>
				<parameter name="@OIB" value="#txtOIB"/>
				<parameter name="@JMBG" value="#txtJMBG"/>
				<parameter name="@datumrodenja" value="#dtDatumRodjenja"/>
				<parameter name="@spol" value="#txtSpol"/>
				<parameter name="@mjestorodenjaid" value="#cmbMjestoRodjenja"/>
				<parameter name="@mjestorodenja" value="#txtMjestoRTekst"/>
				<parameter name="@MjestoPrebivanjaId" value="#srcMjestoPrebivanja"/>
				<parameter name="@UliceId" value="#cmbUlica"/>
				<parameter name="@KucniBroj" value="#txtKucniBroj"/>
				<parameter name="@KucniBrojDodatak" value="#txtKucniBrojD"/>
				<parameter name="@hrdrzavljanstvoid" value="#cmbDrzavljanstvo"/>
				<parameter name="@hrnacionalnostid" value="#cmbNacionalnost"/>
				<parameter name="@SmjestajId" value="#cmbSmjestaj"/>
                <parameter name="@Memo" value="#memOpis"/>		
				<parameter name="@Boraviste" value="#srcBoraviste"/>
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>
	
	<!--
  *******************************************************************************************
  FORMA ZA UNOS ULICE
  *******************************************************************************************
  -->

	<form name="frmUnosUlice" caption="Unos ulice" fixedsize="true" saveformlayout="false" width="200" height="100">

		<event type="shown">
			  <action type="control value" value="#srcMjestoPrebivanja">
				 <parameter value="parent.#srcMjestoPrebivanja" text="parent.#srcMjestoPrebivanja.text"/>
			 </action>
		 </event>

		 <layout>
			 <group cols="1" rows="2">
				 <item row="1" col="1" caption="Mjesto: " highlight="false" textposition="left">
					 <searchedit name="srcMjestoPrebivanja" dataname="~dtMjestoPrebivanja" fieldtext="Naziv" fieldvalue="mjestaid" tabindex="8" required="true" enabled="false">
					 </searchedit>
				 </item>
				 <item row="2" col="1" caption="Ulica: " highlight="false" textposition="left">
					 <textedit name="txtUlica" required="true"></textedit>
				 </item>
			 </group>
		 </layout>

		 <panelbuttons>
			 <buttons>
		
				 <button name="btnSpremi" caption="SPREMI">
				
					 <event type="click">
						 <action type="validate"/>
				
						 <action type="datarun reader" value="~dtUnosUlice">
				
							 <action if="$indGreske==0">
								 <action type="control populate" value="parent.#cmbUlica">
								 </action>

								 <action type="control value" value="parent.#cmbUlica">
									 <parameter value="$noviId" text="#txtUlica"/>
								 </action>

								 <action type="form close"></action>
							 </action>
				
						 </action>
					 </event>
				
				 </button>

				 <button name="btnOdustani" caption="ODUSTANI" dock="right">
					 <event type="click">
						 <action type="form close"/>
					 </event>
				 </button>
		
			 </buttons>
		 </panelbuttons>

		 <datalist>
			 <data command="spHRManagerMaster_Podaci_Opci_CP_VB" name="dtMjestoPrebivanja">
				 <parameter name="@action" value="getMjestoPrebivanja" />

				 <parameter name="@tekst" value="#srcMjestoPrebivanja.text" />
			 </data>
			 <data command="spHRManagerMaster_Podaci_Opci_CP_VB" name="dtUnosUlice">
				 <parameter name="@action" value="unos_ulice"/>

				 <parameter name="@ulica" value="#txtUlica"/>
				 <parameter name="@mjestoPrebivanjaid" value="#srcMjestoPrebivanja"/>

				 <parameter name="@indGreske.output.int"/>
				 <parameter name="@noviid.output.int"/>
			 </data>
		 </datalist>
	</form>
	
			<!--
  *******************************************************************************************
  FORMA ZA UNOS MJESTA
  *******************************************************************************************
  -->

	<form name="frmUnosMjesta" caption="Unos mjesta" fixedsize="true"  saveformlayout="false" width="200" height="100">



		 <layout>
			 <group cols="2" rows="4">
				 <item row="1" col="1" caption="Mjesto: " highlight="false" colspan="2">
					 <textedit name="txtMjesto" required="true"></textedit>
				 </item>
				 <item row="2" col="1" caption="Poštanski broj: " highlight="false" >
					 <textedit name="txtPostanskiBroj" required="true"></textedit>
				 </item>
				 <item row="3" col="1" caption="Pozivni broj: " highlight="false">
					 <textedit name="txtPozivniBroj" required="true"></textedit>
				 </item>
				 <item row="4" col="1" caption="Županija (Provincija): " highlight="false" colspan="2">
					 <comboedit name="cmbZupanija" valuefield="ZupanijeId" displayfield="naziv" dataname="~dtMjesta" />
				 </item>
			 </group>
		 </layout>

		 <panelbuttons>
			 <buttons>
		
				 <button name="btnSpremi" caption="SPREMI">
				
					 <event type="click">
						 <action type="validate"/>
				
						 <action type="datarun reader" value="~dtUnosMjesta">
				
							 <action if="$indGreske==0">
								 <action type="control populate" value="parent.#cmbMjestoRodjenja">
								 </action>

								 <action type="control value" value="parent.#cmbMjestoRodjenja">
									 <parameter value="$noviId" />
								 </action>

								 <action type="form close"></action>
							 </action>
				
						 </action>
					 </event>
				
				 </button>

				 <button name="btnOdustani" caption="ODUSTANI" dock="right">
					 <event type="click">
						 <action type="form close"/>
					 </event>
				 </button>
		
			 </buttons>
		 </panelbuttons>

		 <datalist>
		 <data command="spHRHelp" name="dtMjesta">
				<parameter name="@action" value="zupanije"/>
			</data>
			 <data command="spHRManagerMaster_Podaci_Opci_CP_VB" name="dtUnosMjesta">
				 <parameter name="@action" value="unos_mjesta"/>
				 <parameter name="@Naziv" value="#txtMjesto"/>
				 <parameter name="@HptBroj" value="#txtPostanskiBroj"/>
				 <parameter name="@HptPoziv" value="#txtPozivniBroj"/>
				 <parameter name="@ZupanijeId" value="#cmbZupanija"/>
				 <parameter name="@indGreske.output.int"/>
				 <parameter name="@noviid.output.int"/>
			 </data>
		 </datalist>
	</form>

</root>