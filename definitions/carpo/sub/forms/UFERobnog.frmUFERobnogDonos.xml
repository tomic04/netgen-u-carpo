<!-- 18.07.2021. IF Carpo bug fixing - dodao caption="Svi partneri" textposition="left" u checkedit radi pravilnog prikaza podataka -->
<root>
	<form name="frmUFERobnogDonos" caption="Primke">
		<event type="shown">
			<action type="control disable" value="#btnUredu" if="#grdPrimke.rowcount==0"/>
		</event>
		<layout>
			<group cols="2" rows="2" highlight="false">
				<columnsdefinition>
					<column position="1" size="80%"/>
					<column position="2" size="20%"/>
				</columnsdefinition>
				<item col="1" row="1" caption="Broj:">
					<textedit name="txtBroj">
						<event type="leave">
							<action type="control populate" value="#grdPrimke"/>
							<action type="control focus" value="#grdPrimke"/>
						</event>
					</textedit>
				</item>
				<item col="2" row="1" >
					<checkedit name="chePartneri" caption="Svi partneri" textposition="left">
						<action type="control populate" value="#grdPrimke"/>
					</checkedit>
				</item>
				<item col="1" row="2" colspan="2" caption="">
					<grid name="grdPrimke" dataname="dtPrimke" savelayout="true" showgrouppanel="false" showautofilterrow="false" multiselect="true" key="SktPrometGlaId">
						<event type="click">
							<action type="control populate" value="#grdPrimke"/>
						</event>
						<event type="focusedrowchanged">
							<action type="control disable" value="#btnUredu" if="#grdPrimke.rowcount==0"/>
							<action type="control enable" value="#btnUredu" if="#grdPrimke.rowcount&gt;0"/>						
						</event>
						<event type="keydown">
							<!--ENTER-->
							<action if="key==13">
								<action if="#grdPrimke.rowcount&gt;0">
									<action type="control foreachrow selected" value="#grdPrimke">
										<action type="datarun nonquery" value="~dtDonesi"/>
									</action>
									<action type="control populate" value="parent.#grdStavke"/>
									<action type="form close"/>
								</action>
							</action>
						</event>
					</grid>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUredu" caption="U redu" dock="left">
					<event type="click">
						<action if="#grdPrimke.rowcount&gt;0">
							<action type="control foreachrow selected" value="#grdPrimke">
								<action type="datarun nonquery" value="~dtDonesi"/>
							</action>
							<action type="control populate" value="parent.#grdStavke"/>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPrimke" command="spCRobnoPrimke">
				<parameter name="@Action" value="1"/>
				<parameter name="@PartneriId" value="null" if="#chePartneri==true"/>
				<parameter name="@PartneriId" value="$PartneriId" elseif="#chePartneri==false"/>
				<parameter name="@Broj" value="#txtBroj" type="string" if="#txtBroj!=null"/>
				<parameter name="@Broj" value="" type="string" if="#txtBroj==null"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId" type="int"/>
			</data>
			<data name="dtDonesi" command="spCRobnoPrimke">
				<parameter name="@Action" value="2"/>
				<parameter name="@PartneriId" value="#grdPrimke.@PartneriId"/>
				<parameter name="@SktPrometGlaId" value="#grdPrimke.@SktPrometGlaId"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
			</data>			
		</datalist>
	</form>
</root>