<root>
	<form name="frmUrednikCasse" caption="Urednik Casse" width="100" height="100" >
		<event type="shown">
			<action type="control focus" value="#txtCassa"/>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1" groupbordervisible="False">
				<group cols="2" rows="2" row="1" col="1">
					<item row="1" col="1">
						<!-- <labeledit value="Za sve stavke dokumenta:" /> -->
						<labeledit value="Za označene stavke:" />
					</item>
					<item row="2" col="1" textalignmode="auto"  highlight="False">
						<textedit name="txtCassa" value="0" format="n4" />
					</item>
					<item row="2" col="2" textvisible="False" padding="0" textalignmode="left">
						<labeledit value="%" textalignmode="left"/>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="control foreachrow selected" value="parent.#grdRoba">
							<action type="datarun nonquery" value="~dtCassaDet"/>
						</action>
						<action type="datarun nonquery" value="~dtCassaGla"/>
						<action type="control populate" value="parent.#grdRoba" />
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spProd_FakDetalj_UrednikCasse" name="dtCassa"> -->
			<!-- <parameter name="@FaktureId" value="$FaktureId" /> -->
			<!-- <parameter name="@Cassa" value="#txtCassa" /> -->
			<!-- </data> -->
			<data command="spProd_FakDetalj_UrednikCasse" name="dtCassaDet">
				<parameter name="@Action" value="1" />
				<parameter name="@FakDetaljId" value="parent.#grdRoba.@FakDetaljId" />
				<parameter name="@FaktureId" value="$FaktureId" />
				<parameter name="@Cassa" value="#txtCassa" />
			</data>			
			<data command="spProd_FakDetalj_UrednikCasse" name="dtCassaGla">
				<parameter name="@Action" value="2" />
				<parameter name="@FaktureId" value="$FaktureId" />
				<parameter name="@Cassa" value="#txtCassa" />
			</data>			
		</datalist>
	</form>
</root>