<root>
	<form name="frmPar" caption="Filter prikaza">
		<!-- <event type="init"> -->
			<!-- <action type="datarun reader" value="~dtSkladiste"/> -->
		<!-- </event> -->
		<layout>
			<group rows="2" cols="2" >
				<item row="1" col="1" caption="Klasifikacija:">
					<combotreeedit name="cmbKlRoba" valuefield="ID" displayfield="Naziv" parentfieldname="ParentID" dataname="~dtKlRoba" allownull="true" savevalue="session">
						<event type="leave" raiseonload="false">
							<action type="variable value" >
								<parameter name="global.KlRobaPar" value="#cmbKlRoba" type="int"/>
							</action>
						</event>
					</combotreeedit>
				</item>
				<item row="1" col="2" caption="Proizvod:">
					<searchedit  name="txtRoba"  fieldtext="Naziv" fieldvalue="RobaId" entermovenextcontrol="false" dataname="global.~dtRoba" allownull="true"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrikazi" caption="Prikaži">
					<event type="click"> 
						<action type="validate"/>
						<action type="variable value">
							<parameter name="global.KlRobaPar" value="#cmbKlRoba" type="int"/>
							<parameter name="global.RobaPar" value="#txtRoba" type="int"/>
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdMaster"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPrnOprListGla_Query" name="dtKlRoba">
				<parameter name="@Action" value="KlMasterRoba" />
			</data>

		</datalist>
	</form>
</root>