<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmBrisanjeObrade" caption="$caption" width="400" height="130" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="shown">
      <action type="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati {$lblCaption} ?" />
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true">
        <item col="1" row="1" highlight="False">
          <labeledit name="lblPitanje" fontsizedelta="2" value="" />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action if="$OOPIsObradeId!=null">
              <action type="datarun reader" value="~dtBrisanje" waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..." />
              <action type="message" value="$Poruka" if="$IndGreske==0"></action>
              <action type="form close" if="$IndGreske==0" />
            </action>

            <action else="">
              <action type="datarun reader" value="~dtBrisanjeGla" waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..." />
              <action type="message" value="$Poruka" if="$IndGreske==0"></action>
              <action type="form close" if="$IndGreske==0" />
            </action>
            
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spDDObradeAzur_CP" name="dtBrisanje" timeout="600">
        <parameter name="@Action" value="2" type="int" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@oopisobradeid" value="$oopisobradeid" />
        <parameter name="@oznaka" value="$oznaka" />
        <parameter name="@indGreske.output.int"/>
        <parameter name="@poruka.output.string"/>
      </data>

      <data command="spDDObradeDjelatniciAzur_CP" name="dtBrisanjeGla">
        <parameter name="@action" value="7" type="int"/>
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@selectedids" value="$selectedids"/>
        <parameter name="@indGreske.output.int"/>
        <parameter name="@poruka.output.string"/>
      </data>

    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>