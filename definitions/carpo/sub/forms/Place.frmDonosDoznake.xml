<root>
  <form name="frmDonosDoznake" caption ="$caption" width="500" height="200">
    
    <event type="shown">
      <action type="control value" value="#rdoPrenesi" >
        <parameter value="1"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="3" groupbordervisible="false" >
        <item col="1" row="1"  highlight="False">
          <radioedit caption="Prenesi zapise iz doznaka" name="rdoPrenesi" fontsizedelta="2" value="true"  />
        </item>
        <item col="1" row="2"  highlight="False">
          <radioedit caption="Poništi prijenos" name="rdoPonisti"  fontsizedelta="2"/>
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnIzvrsi" caption="IZVRŠI" >
          <event type="click">
            <action type="datarun reader" value="~dtPrenesi" if="#rdoPrenesi==true">
              <action type="message" value="~dtPrenesi.@poruka"></action>
            </action>
            <action type="datarun reader" value="~dtPonisti" if="#rdoPonisti==true">
              <action type="message" value="~dtPonisti.@poruka"></action>
            </action>
            <action type="form close"></action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spKOD_Donos_Sve" name="dtPrenesi">
        <parameter name="@action" value="bolovanje" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@indporuka" value="1"/>
      </data>
      <data command="spKOD_Donos_Sve" name="dtPonisti">
        <parameter name="@action" value="bolovanje_ponisti" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@indporuka" value="1"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>