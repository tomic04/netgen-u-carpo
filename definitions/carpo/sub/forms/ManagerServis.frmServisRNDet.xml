<root>
	<form name="frmServisRNDet" caption="Servis stavka" fixedsize="true" width="900" saveformsize="false">
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="shown">
			<action type="control disable" value="#cmbskladiste" if="global.$ModelIzdavanjaMaterijala==0" />
			<action type="control disable" value="#srcRoba" if="$Edit==1" />
			<action if="$Edit==1">
				<action type="datarun reader" value="global.~dtUcitajStavku" />
				<action type="variable value" value="$VRSTArobe">
					<parameter value="global.~dtUcitajStavku.@indikator" />
				</action>
			</action>
			<action type="variable value" if="global.$modelizdavanjamaterijala==0&amp;&amp;$Edit==0">
				<parameter name="VrstaRobe" value="U" />
			</action>
			<action type="control disable" value="#txtKolicinaPak,#txtKolicinaKom,#timeUtrVrijeme" if="$Edit==1&amp;&amp;global.$modelizdavanjamaterijala==0&amp;&amp;$VRstaRobe!=U" />
			<!-- <action type="control enable" value="#txtKolicinaPak,#txtKolicinakom,#timeUtrVrijeme" if="$Edit==0"/> -->
			<action type="control enable" value="#txtKolicinaPak,#txtKolicinaKom,#timeUtrVrijeme" if="$Edit==1&amp;&amp;global.$modelizdavanjamaterijala==0&amp;&amp;$VRstaRobe==U" />
			<action type="control disable" value="#timeUtrVrijeme" if="$VRstaRobe!=U" />
			<action type="variable value" if="$Edit==1">
				<parameter name="Robaid" value="#srcRoba" />
			</action>
			<action type="control visible" value="#srcIzvrsitelj" if="parent.$PoljeIzvrsitelj==0">
				<parameter value="false" />
			</action>
			<action type="control attribute" value="#srcIzvrsitelj" if="parent.$PoljeIzvrsitelj==0||parent.$IzvrsiteljObavezan==false">
				<parameter name="required" value="false" />
			</action>
			<action type="control attribute" value="#cmbskladiste" if="$VRstaRobe==U">
				<parameter name="required" value="false" />
			</action>
			<action type="control attribute" value="#cmbskladiste" else="">
				<parameter name="required" value="true" />
			</action>
			<action type="control value" value="#cmbOrgShema" if="$Edit==0">
				<parameter value="$RealOrgShemaId" />
			</action>
			<action type="control value" value="#txtKolicinaKom" if="$Edit==0">
				<parameter value="0" type="decimal" />
			</action>
			<action type="control value" value="#cmbNacinObracuna" if="$Edit==0">
				<parameter value="$ServisNacinObrId" />
			</action>
			<action type="control visible" value="#txtKolicinaPak" if="$JMRoba==null">
				<!-- &amp;&amp;$Edit==1 -->
				<parameter value="false" />
			</action>
			<action type="control visible" value="#txtKolicinaPak" else="">
				<parameter value="true" />
			</action>
			<action type="variable value" if="$Edit==0">
				<parameter name="JMRoba" value="null" />
			</action>
			<action type="datarun reader" value="~dtJMRoba" if="$Edit==1" />
			<action type="variable value" value="JMRoba" if="$Edit==1">
				<parameter value="~dtJMRoba.@JMId" />
			</action>
			<!--
			<action type="control visible" value="#lblKolicinaPak" if="$JMRoba!=null">
			<parameter value="true"/>
			</action>
			<action type="control visible" value="#lblKolicinaPak" else="">
			<parameter value="false"/>
			</action>
			-->
			<action if="$Edit==1">
				<action type="datarun reader" value="~dtPakRez" />
				<action type="control value" value="#txtKolicinaPak">
					<parameter value="~dtPakRez.@KolicinaPak" />
				</action>
			</action>
			<action if="$Edit==1">
				<action type="variable value">
					<parameter name="FaktorFix" value="~dtJMRoba.@FaktorFix" />
					<parameter name="Faktor" value="~dtJMRoba.@Faktor" />
					<parameter name="NazivDodatneJM" value="~dtJMRoba.@NazivDodatneJM" />
				</action>
				<action type="control value" value="#lblKolicinaPak">
					<parameter value="$NazivDodatneJM" />
				</action>
			</action>
		</event>
		<event type="init">
			<action type="datarun reader" value="global.~dtUcitajStavku" if="$Edit==1" />
			<action type="variable value" if="global.$modelizdavanjamaterijala==0&amp;&amp;$Edit==0">
				<parameter name="VRSTArobe" value="u" />
			</action>
			<action type="variable value" if="$Edit==1">
				<parameter name="VRSTArobe" value="global.~dtUcitajStavku.@indikator" />
			</action>
			<action type="variable value" value="VManual">
				<parameter value="0" type="int" />
			</action>
			<action type="variable value" if="$Edit==1">
				<parameter name="Robaid" value="#srcRoba" />
			</action>
			<action type="datarun reader" value="~dtJMRoba" if="$Edit==1" />
			<action type="variable value" if="$Edit==0">
				<parameter name="JMRoba" value="null" />
			</action>
			<action type="variable value" value="JMRoba" if="$Edit==1">
				<parameter value="~dtJMRoba.@JMId" />
			</action>
			<action if="$Edit==1">
				<action type="variable value">
					<parameter name="FaktorFix" value="~dtJMRoba.@FaktorFix" />
					<parameter name="Faktor" value="~dtJMRoba.@Faktor" />
					<parameter name="NazivDodatneJM" value="~dtJMRoba.@NazivDodatneJM" />
				</action>
			</action>
			<!--
			<action type="datarun reader" value="~dtRobaCijena" if="$Edit==1"/>
			<action type="variable value" if="$Edit==1">
			<parameter name="OznakaValute" value="~dtRobaCijena.@OznakaValute"/>
			</action>
			<action type="control value" value="#lblNabavna" if="$Edit==1">
			<parameter value="$OznakaValute"/>
			</action>
			-->
			<!--
			<action type="control visible" value="#txtKolicinaPak" if="$JMRoba!=null&amp;&amp;$Edit==1">
			<parameter value="true"/>
			</action>
			<action type="control visible" value="#txtKolicinaPak" else="">
			<parameter value="false"/>
			</action>
			-->
			<!--
			<action type="control visible" value="#lblKolicinaPak" if="$JMRoba!=null&amp;&amp;$Edit==1">
			<parameter value="true"/>
			</action>
			<action type="control visible" value="#lblKolicinaPak" else="">
			<parameter value="false"/>
			</action>
			-->
			<action type="control value" value="#lblKolicinaPak" if="$RobaId!=null">
				<parameter value="$NazivDodatneJM" />
			</action>
			<!--
			<action type="datarun reader" value="~dtKomRez"/>
			<action type="control value" value="#txtKolicinaKom">
			<parameter value="~dtKomRez.@KolicinaKom"/>
			</action>
			-->
			<!--
			<action type="control value" value="#cusCalc">
			<parameter name="Kolicina" value="#txtKolicinaKom" type="decimal"/>
			</action>
			-->
			<!--
			<action type="control value" value="#cmbOrgShema" if="$Edit==0">
			<parameter value="$global.RealOrgShemaId"/>
			</action>
			<action type="control value" value="#cmbNacinObracuna" if="$Edit==0">
			<parameter value="$global.ServisNacinObrId"/>
			</action>
			-->
			<action type="variable value" if="global.$modelizdavanjamaterijala==0&amp;&amp;$Edit==0">
				<parameter name="VRstaRobe" value="U" />
			</action>
			<action type="datarun scalar" value="~dtmaxlengthNapomena">
				<parameter name="maxlengthNapomena" value="~dtmaxlengthNapomena.@CHARACTER_MAXIMUM_LENGTH" />
			</action>
		</event>
		<layout autotaborder="false">
			<group rows="2" cols="2">
				<columnsdefinition>
					<column position="1" size="400" />
					<column position="2" size="400" />
				</columnsdefinition>
				<group row="1" col="1" rows="1" cols="1" colspan="2">
					<item row="1" col="1" caption="Roba:">
						<searchedit name="srcRoba" dataname="global.~dtRoba" fieldvalue="RobaId" fieldtext="Roba" datavalue="global.~dtUcitajStavku.@RobaId" datatext="global.~dtUcitajStavku.@Roba" required="true" tabindex="0">
							<event type="valuechanged" raiseonload="true">
								<action if="#srcRoba!=null">
									<action type="datarun reader" value="~dtProvjeriRobu" />
									<action type="variable value">
										<parameter name="VrstaRobe" value="~dtProvjeriRobu.@VrstaRobe" />
									</action>
									<action type="variable value" if="global.$modelizdavanjamaterijala==0&amp;&amp;$Edit==0">
										<parameter name="VRstaRobe" value="U" />
									</action>
									<!-- <action type="control focus" value="#txtKolicinaKom"/> -->
									<!--
									<action type="control disable" value="#cmbskladiste" if="$VrstaRobe==U">
									<parameter value="true"/>
									</action>
									<action type="control disable" value="#cmbskladiste" else="">
									<parameter value="false"/>
									</action>
									-->
									<action type="control disable" value="#cmbskladiste" if="$VrstaRobe==U" />
									<action type="control enable" value="#cmbskladiste" else="" />
									<!--
									<action type="control disable" value="#timeUtrVrijeme" if="$VrstaRobe==U">
									<parameter value="false"/>
									</action>
									<action type="control disable" value="#timeUtrVrijeme" else="">
									<parameter value="true"/>
									</action>
									-->
									<action type="control attribute" value="#cmbskladiste" if="$VRstaRobe==U">
										<parameter name="required" value="false" />
									</action>
									<action type="control attribute" value="#cmbskladiste" else="">
										<parameter name="required" value="true" />
									</action>
									<action type="datarun reader" value="global.~dtStanjeSkladista" />
									<action type="variable value">
										<parameter name="RobaId" value="#srcRoba" type="int" />
									</action>
									<action type="variable value" if="$Edit!=1">
										<parameter name="JMNaziv" value="#srcRoba.@JM" />
									</action>
									<action type="variable value" else="">
										<parameter name="JMNaziv" value="parent.#grdDetail.@JM" />
									</action>
									<action type="control value" value="#lblKolicinaKom">
										<parameter value="$JMNaziv" />
									</action>
									<action type="control value" value="#lblStvarnoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@stanje" />
									</action>
									<action type="control value" value="#lblRaspolozivoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@raspolozivo" />
									</action>
									<action type="control value" value="#lblRezerviranoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@rezervirano" />
									</action>
									<action if="$Edit!=1">
										<action type="datarun reader" value="~dtRobaCijena" />
										<action type="variable value">
											<parameter name="VrCjenikId" value="~dtRobaCijena.@VrCjenikId" />
										</action>
										<action type="variable value">
											<parameter name="NaknadaTR" value="~dtRobaCijena.@NaknadaTR" />
										</action>
										<action type="variable value">
											<parameter name="NaknadaPO" value="~dtRobaCijena.@NaknadaPO" />
										</action>
										<action type="variable value">
											<parameter name="NaknadaNZ" value="~dtRobaCijena.@NaknadaNZ" />
										</action>
										<action type="variable value">
											<parameter name="KupUgovoriDetId" value="~dtRobaCijena.@KupUgovoriDetId" />
										</action>
										<action type="variable value">
											<parameter name="OznakaValute" value="~dtRobaCijena.@OznakaValute" />
										</action>
										<action type="variable value">
											<parameter name="ValuteId" value="~dtRobaCijena.@ValuteId" />
										</action>
										<action type="variable value">
											<parameter name="TarifaId" value="~dtRobaCijena.@TarifaId" />
										</action>
										<action type="variable value">
											<parameter name="OrgRabatP" value="~dtRobaCijena.@Rabat" />
										</action>
										<action type="variable value">
											<parameter name="CijenaNabavna" value="~dtRobaCijena.@CijenaNabavna" />
										</action>
										<action type="variable value">
											<parameter name="CijenaProdajna" value="~dtRobaCijena.@Cijena" />
										</action>
										<!-- on povuče i nabavnu i prodajnu… samo mislim da u modelu kada trebaju biti nabavne cijene (Servis.VrstaCijenaUsluga=1), proslijedi kalkulacije dll-u prodajnu a trebao bi nabavnu. -->
										<action type="control value" value="#bteNabavna" if="$VRstaRobe==U&amp;&amp;global.$VrstaCijenaUsluga==1">
											<parameter value="$CijenaNabavna" />
										</action>
										<action type="control value" value="#bteNabavna" if="$VRstaRobe==U&amp;&amp;global.$VrstaCijenaUsluga==0">
											<parameter value="$CijenaProdajna" />
										</action>
										<action type="control value" value="#bteNabavna" if="$VRstaRobe==M&amp;&amp;global.$VrstaCijenaRoba==1">
											<parameter value="$CijenaNabavna" />
										</action>
										<action type="control value" value="#bteNabavna" if="$VRstaRobe==M&amp;&amp;global.$VrstaCijenaRoba==0">
											<parameter value="$CijenaProdajna" />
										</action>
										<action type="control value" value="#lblNabavna">
											<parameter value="$OznakaValute" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="ValutaTekst" value="$OznakaValute" />
										</action>
										<action type="control value" value="#cusCalc" if="$VRstaRobe==U&amp;&amp;global.$VrstaCijenaUsluga==1">
											<parameter name="Cijena" value="~dtRobaCijena.@CijenaNabavna" type="n4" />
										</action>
										<action type="control value" value="#cusCalc" if="$VRstaRobe==U&amp;&amp;global.$VrstaCijenaUsluga==0">
											<parameter name="Cijena" value="~dtRobaCijena.@Cijena" type="n4" />
										</action>
										<action type="control value" value="#cusCalc" if="$VRstaRobe==M&amp;&amp;global.$VrstaCijenaRoba==1">
											<parameter name="Cijena" value="~dtRobaCijena.@CijenaNabavna" type="n4" />
										</action>
										<action type="control value" value="#cusCalc" if="$VRstaRobe==M&amp;&amp;global.$VrstaCijenaRoba==0">
											<parameter name="Cijena" value="~dtRobaCijena.@Cijena" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatPosto" value="~dtRobaCijena.@Rabat" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CassaPosto" value="~dtRobaCijena.@Cassa" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="PorezPosto" value="~dtRobaCijena.@Porez" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost1" value="~dtRobaCijena.@Rabat1" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost2" value="~dtRobaCijena.@Rabat2" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost3" value="~dtRobaCijena.@Rabat3" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost4" value="~dtRobaCijena.@Rabat4" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost5" value="~dtRobaCijena.@Rabat5" type="n4" />
										</action>
										<action type="control value" value="#txtRokPlacanja">
											<parameter value="~dtRobaCijena.@Odgoda" />
										</action>
									</action>
									<action else="">
										<action type="variable value">
											<parameter name="OznakaValute" value="~dtUcitajStavku.@OznakaValute" />
										</action>
										<action type="variable value">
											<parameter name="ValuteId" value="~dtUcitajStavku.@ValuteId" />
										</action>
										<!-- <action type="variable value" > -->
										<!-- <parameter name="TarifaId" value="~dtUcitajStavku.@TarifaId"/> -->
										<!-- </action> -->
										<!-- <action type="variable value" > -->
										<!-- <parameter name="OrgRabatP" value="~dtUcitajStavku.@OrgRabatP"/> -->
										<!-- </action> -->
										<action type="control value" value="#bteNabavna">
											<parameter value="~dtUcitajStavku.@NabCijenaKn" />
										</action>
										<action type="control value" value="#lblNabavna">
											<parameter value="$OznakaValute" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="ValutaTekst" value="$OznakaValute" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Kolicina" value="#txtKolicinaKom" type="decimal" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Cijena" value="~dtUcitajStavku.@NettoCijenaKn" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CijenaPDV" value="~dtUcitajStavku.@BruttoCijenaKn" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="Iznos" value="~dtUcitajStavku.@NettoVrijednostKn" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="IznosPDV" value="~dtUcitajStavku.@BruttoVrijednostKn" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatPosto" value="~dtUcitajStavku.@RabatP" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="CassaPosto" value="~dtUcitajStavku.@Cassa" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="PorezPosto" value="~dtUcitajStavku.@PorezP" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost1" value="~dtUcitajStavku.@Rabat1" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost2" value="~dtUcitajStavku.@Rabat2" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost3" value="~dtUcitajStavku.@Rabat3" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost4" value="~dtUcitajStavku.@Rabat4" type="n4" />
										</action>
										<action type="control value" value="#cusCalc">
											<parameter name="RabatVrijednost5" value="~dtUcitajStavku.@Rabat5" type="n4" />
										</action>
										<action type="control value" value="#txtRokPlacanja">
											<parameter value="~dtUcitajStavku.@Odgoda" />
										</action>
									</action>
									<action type="datarun reader" value="~dtJMRoba" />
									<action type="variable value" value="JMRoba">
										<parameter value="~dtJMRoba.@JMId" />
									</action>
									<action type="control visible" value="#txtKolicinaPak" if="$JMRoba!=null">
										<parameter value="true" />
									</action>
									<action type="control visible" value="#txtKolicinaPak" else="">
										<parameter value="false" />
									</action>
									<action type="variable value">
										<parameter name="FaktorFix" value="~dtJMRoba.@FaktorFix" />
										<parameter name="Faktor" value="~dtJMRoba.@Faktor" />
										<parameter name="NazivDodatneJM" value="~dtJMRoba.@NazivDodatneJM" />
									</action>
									<action type="control value" value="#lblKolicinaPak">
										<parameter value="$NazivDodatneJM" />
									</action>
								</action>
								<action else="">
									<action type="control value" value="#lblStvarnoVrijednost">
										<parameter value="0" />
									</action>
									<action type="control value" value="#lblRaspolozivoVrijednost">
										<parameter value="0" />
									</action>
									<action type="control value" value="#lblRezerviranoVrijednost">
										<parameter value="0" />
									</action>
									<action type="control value" value="##,!#cmbOrgShema,!#cmbNacinObracuna,!#dateDatumDet,!#txtKolicinaKom,!#txtKolicinaPak,!#srcIzvrsitelj" if="$Edit==0">
										<parameter value="" />
									</action>
									<action type="control value" value="#srcIzvrsitelj" if="$Edit==0">
										<parameter value="null" />
									</action>
									<action type="control value" value="#txtKolicinaPak, #txtKolicinaKom" if="$Edit==0">
										<parameter value="0" type="decimal" />
									</action>
									<action type="control value" value="#dateDatumDet" if="$Edit==0">
										<parameter value="now" />
									</action>
									<action type="control refreshvalue" value="#cusCalc" />
								</action>
							</event>
						</searchedit>
					</item>
				</group>
				<group rows="5" cols="2" row="2" col="1" backgroundcolor="white">
					<rowsdefinition>
						<row position="1" size="35" />
						<row position="2" size="20" />
						<row position="3" size="100" />
						<row position="4" size="20" />
						<row position="5" size="auto" />
					</rowsdefinition>
					<columnsdefinition>
						<column position="1" size="200" />
						<column position="2" size="200" />
					</columnsdefinition>
					<item row="1" col="1">
						<daysedit caption="Rok isporuke (dana)" name="txtRokIsporuke" datavalue="global.~dtUcitajStavku.@RokIsporuke" tabindex="1" />
					</item>
					<item row="1" col="2">
						<daysedit caption="Rok plaćanja (dana)" name="txtRokPlacanja" datavalue="global.~dtUcitajStavku.@RokPlacanja" tabindex="2" />
					</item>
					<item row="2" col="1" colspan="2">
						<separator />
					</item>
					<item row="3" col="1" caption="Skladište:">
						<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="Global.~dtSkladiste" datavalue="global.~dtUcitajStavku.@SkladisteId" datatext="global.~dtUcitajStavku.@Skladiste" tabindex="3">
							<event type="valuechanged" raiseonload="true">
								<action if="#srcRoba!=null&amp;&amp;#cmbSkladiste!=null">
									<action type="datarun reader" value="global.~dtStanjeSkladista" />
									<action type="control value" value="#lblStvarnoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@stanje" />
									</action>
									<action type="control value" value="#lblRaspolozivoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@raspolozivo" />
									</action>
									<action type="control value" value="#lblRezerviranoVrijednost">
										<parameter value="global.~dtStanjeSkladista.@rezervirano" />
									</action>
								</action>
							</event>
						</comboedit>
					</item>
					<group groupbordervisible="false" rows="3" cols="2" row="3" col="2">
						<item row="1" col="1">
							<labeledit value="Stvarno:" />
						</item>
						<item row="1" col="2">
							<labeledit textposition="right" name="lblStvarnoVrijednost" value="0" format="n3" datavalue="global.~dtStanjeSkladista.@stanje" sufix=" {$JMNaziv}" />
						</item>
						<item row="2" col="1">
							<labeledit value="Raspoloživo:" />
						</item>
						<item row="2" col="2">
							<labeledit textposition="right" name="lblRaspolozivoVrijednost" value="0" format="n3" datavalue="global.~dtStanjeSkladista.@raspolozivo" sufix=" {$JMNaziv}" />
						</item>
						<item row="3" col="1">
							<labeledit value="Rezervirano:" />
						</item>
						<item row="3" col="2">
							<labeledit textposition="right" name="lblRezerviranoVrijednost" value="0" format="n3" datavalue="global.~dtStanjeSkladista.@rezervirano" sufix=" {$JMNaziv}" />
						</item>
					</group>
					<item row="4" col="1" colspan="2">
						<separator />
					</item>
					<item row="5" col="1" colspan="2" caption="Napomena:">
						<memoedit name="memNapomena" maxlength="$maxlengthNapomena" datavalue="global.~dtUcitajStavku.@Napomena" tabindex="4" />
					</item>
				</group>
				<group row="2" col="2" rows="7" cols="7">
					<columnsdefinition>
						<column position="1" size="80" />
						<column position="2" size="30" />
						<column position="3" size="80" />
						<column position="4" size="30" />
						<column position="5" size="100" />
						<column position="6" size="100" />
						<column position="7" size="10" />
					</columnsdefinition>
					<item row="1" col="1" colspan="3" caption="Datum:" textposition="left" textalignmode="auto">
						<dateedit name="dateDatumDet" value="now" datavalue="global.~dtUcitajStavku.@Datum" tabindex="5">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtRobaCijena" if="$RobaId!=null" />
								<action type="variable value" if="$RobaId!=null">
									<parameter name="OznakaValute" value="~dtRobaCijena.@OznakaValute" />
								</action>
								<action type="control value" value="#lblNabavna">
									<parameter value="$OznakaValute" />
								</action>
								<action type="control value" value="#cusCalc">
									<parameter name="Kolicina" value="#txtKolicinaKom" type="decimal" />
								</action>
								<action type="control value" value="#cusCalc">
									<parameter name="ValutaTekst" value="$OznakaValute" />
								</action>
							</event>
						</dateedit>
					</item>
					<item row="2" col="1" caption="Količina:" padding="0,0,0,0">
						<textedit name="txtKolicinaPak" visible="false" format="n6" value="0" tabindex="6">
							<event type="leave" raiseonload="false">
								<action type="datarun reader" value="~dtKomRez" />
								<action type="control value" value="#txtKolicinaKom">
									<parameter value="~dtKomRez.@KolicinaKom" type="decimal" />
								</action>
							</event>
						</textedit>
					</item>
					<item row="2" col="2" padding="0,0,22,0">
						<labeledit name="lblKolicinaPak" value=" " />
					</item>
					<item row="2" col="3" caption="Količina:" padding="0,0,0,0">
						<textedit name="txtKolicinaKom" format="n6" value="0" datavalue="global.~dtUcitajStavku.@Količina" required="true" tabindex="7">
							<event type="leave" raiseonload="true">
								<action type="control value" value="#cusCalc">
									<parameter name="Kolicina" value="#txtKolicinaKom" type="decimal" />
								</action>
								<action if="$JMRoba!=null&amp;&amp;$FaktorFix==1">
									<action type="datarun reader" value="~dtPakRez" />
									<action type="control value" value="#txtKolicinaPak">
										<parameter value="~dtPakRez.@KolicinaPak" />
									</action>
								</action>
							</event>
							<event type="valuechanged">
								<action if="$VrstaRobe==U">
									<!-- roba usluga -->
									<action type="datarun reader" value="~dtSatiMinute" if="$VManual==0" />
									<action type="control value" value="#timeUtrVrijeme" if="$VManual==0">
										<parameter value="~dtSatiMinute.@SatiMinute" />
									</action>
									<action type="control value" value="#cusCalc">
										<parameter name="Kolicina" value="#txtKolicinaKom" type="decimal" />
									</action>
								</action>
							</event>
						</textedit>
					</item>
					<item row="2" col="4" padding="0,0,22,0">
						<labeledit name="lblKolicinaKom" value=" " datavalue="global.~dtUcitajStavku.@JM" />
					</item>
					<item row="2" col="5" caption="Stvarno utrošeno vrijeme:">
						<timeedit name="timeUtrVrijeme" value="00:00:00" datavalue="global.~dtUcitajStavku.@Vrijeme" tabindex="8">
							<event type="valuechanged">
								<action type="variable value" value="VManual">
									<parameter value="1" type="int" />
								</action>
							</event>
						</timeedit>
					</item>
					<item row="2" col="6" caption="Nabavna cijena:">
						<textedit name="bteNabavna" format="n4" value="0" datavalue="global.~dtUcitajStavku.@NabCijenaKn" readonly="true" />
					</item>
					<item row="2" col="7" padding="0,0,22,0">
						<labeledit name="lblNabavna" value=" " />
					</item>
					<item row="3" col="1" colspan="7" caption="OrgShema:">
						<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" datavalue="global.~dtUcitajStavku.@TrosOrgShemaId" datatext="global.~dtUcitajStavku.@OrgShema" required="true" tabindex="9">
							<event type="valuechanged">
								<action type="datarun reader" value="~dtIzvrsiteljT" />
								<action type="control value" value="#srcIzvrsitelj">
									<parameter value="null" text="null" />
								</action>
								<action type="control refreshvalue" value="#srcIzvrsitelj" />
							</event>
						</combotreeedit>
					</item>
					<item row="4" col="1" colspan="7" caption="Izvršitelj:">
						<searchedit name="srcIzvrsitelj" required="true" dataname="~dtIzvrsiteljT" fieldvalue="HRKadroviId" fieldtext="Izvrsitelj" datavalue="global.~dtUcitajStavku.@HRKadroviId" datatext="global.~dtUcitajStavku.@Izvršitelj" tabindex="10" />
					</item>
					<item row="5" col="1" colspan="7" caption="Način obračuna:">
						<comboedit name="cmbNacinObracuna" dataname="global.~dtNacinObracuna" valuefield="ServisNacinObrId" displayfield="Naziv" datavalue="global.~dtUcitajStavku.@ServisNacinObrId" datatext="global.~dtUcitajStavku.@NacinObr" required="true" allownull="false" tabindex="11" />
					</item>
					<item row="6" col="1" colspan="7">
						<customcontrol name="cusCalc" dll="Carpo.Specific" class="Carpo.Specific.Cjenik.Kalkulacija" tabindex="12" />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDimenzije" caption="DIMENZIJE" tabindex="13">
					<event type="click">
						<action if="global.$IndDimenzije==1">
							<action type="method run" value="fnDimenzijeGla">
								<parameter name="server" value="@@server" />
								<parameter name="database" value="@@database" />
								<parameter name="username" value="" />
								<parameter name="password" value="" />
								<parameter name="OperateriId" value="@@operateriid" />
								<parameter name="Parent" value="-99999" />
								<parameter name="pTop" value="0" />
								<parameter name="pLeft" value="0" />
								<parameter name="path" value="" />
								<parameter name="tip" value="ServisRNDetId" />
								<parameter name="id" value="$ServisRnDetId" />
								<parameter name="glaid" value="0" />
							</action>
						</action>
						<action else="">
							<action type="message" value="'postaviti .net Dimenzije.'" />
						</action>
					</event>
				</button>
				<button name="btnSpremi" caption="SPREMI" dock="right" tabindex="14">
					<event type="click">
						<action type="message" value="Količina mora biti veća od 0!" if="#txtKolicinaKom==0" />
						<action else="">
							<action type="validate" />
							<action type="datarun scalar" value="~dtSpremiDet">
								<parameter name="NoviDet" />
							</action>
							<action type="control populate" value="parent.#grdDetail, parent.#txtNpdv, parent.#txtYpdv, parent.#txtUkupno-pdv, parent.#txtUkupnopdv" />
							<action type="control focus" value="parent.#grdDetail">
								<parameter value="$NoviDet" />
							</action>
							<action type="variable value" value="global.$countdet37">
								<parameter value="1" type="int" />
							</action>
							<action type="control disable" value="parent.#btnVratiStatus" if="global.$countdet37==1&amp;&amp;global.$statusRNCaption55==Otvoren" />
							<action type="control disable" value="parent.#cmbModel" if="global.$countdet37==1" />
							<action type="control enable" value="parent.#cmbModel, parent.#btnVratiStatus" elseif="global.$CountDet37==0&amp;&amp;global.$statusRNCaption55==Otvoren" />
							<action type="control value" value="##,!#cmbOrgShema,!#cmbNacinObracuna,!#dateDatumDet,!#txtKolicinaKom,!#txtKolicinaPak,!#srcIzvrsitelj" if="$Edit==0">
								<parameter value="" />
							</action>
							<action type="control value" value="#txtKolicinaPak, #txtKolicinaKom" if="$Edit==0">
								<parameter value="0" type="decimal" />
							</action>
							<action type="control value" value="#dateDatumDet" if="$Edit==0">
								<parameter value="now" />
							</action>
							<action type="control value" value="#srcIzvrsitelj" if="$Edit==0">
								<parameter value="null" />
							</action>
							<action type="variable value" value="$VManual">
								<parameter value="0" />
							</action>
							<action type="form close" if="$Edit==1" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" tabindex="15" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtProvjeriRobu" command="spProvjeriRobu">
				<parameter name="@RobaId" value="#srcRoba" />
			</data>
			<data name="dtRobaCijena" command="spServisRN_Kalk">
				<parameter name="@DatumDok" value="parent.#dateDatum" />
				<parameter name="@PartneriId" value="parent.#srcPartner" />
				<parameter name="@ParStruId" value="parent.#srcLokacija" />
				<parameter name="@OrgShemaId" value="parent.#cmbOrgShema" />
				<parameter name="@RobaId" value="#srcRoba" />
				<parameter name="@SkladisteId" value="#cmbSkladiste" />
			</data>
			<data name="dtSatiMinute" command="spServisDatumVrijeme">
				<parameter name="@Action" value="SatiMinute" />
				<parameter name="@VrijemeDec" value="#txtKolicinaKom" />
			</data>
			<data type="text" name="dtKomRez" command="SELECT KolicinaKom = CONVERT(DECIMAL(18,4), @Kolicina) * @Faktor">
				<parameter name="@Kolicina" value="#txtKolicinaPak" />
				<parameter name="@Faktor" value="$Faktor" />
			</data>
			<data type="text" name="dtPakRez" command="SELECT KolicinaPak = CONVERT(DECIMAL(18,4), @Kolicina) / @Faktor">
				<parameter name="@Kolicina" value="#txtKolicinaKom" />
				<parameter name="@Faktor" value="$Faktor" />
			</data>
			<data type="text" name="dtJMRoba" command="SELECT jmr.jmid, jm.naziv AS NazivDodatneJM, Faktor = CONVERT(DECIMAL(18,4), jmr.Faktor), jmr.FaktorFix FROM JMRoba jmr INNER JOIN jm ON jmr.JMId = jm.JmId WHERE jmr.robaid = @RobaId AND jmr.DefaultInd = 1">
				<parameter name="@RobaId" value="$RobaId" />
			</data>
			<data name="dtIzvrsiteljT" command="spServisRNFilterCarpo">
				<parameter name="@Action" value="Izvrsitelj" />
				<parameter name="@String" value="#srcIzvrsitelj.text" />
				<parameter name="@Orgshemaid" value="#cmbOrgShema" />
			</data>
			<data name="dtSpremiDet" command="spServisRNDetAzurCarpo">
				<parameter name="@Action" value="0" if="$Edit==0" />
				<parameter name="@Action" value="1" if="$Edit==1" />
				<parameter name="@ServisRNGlaId" value="global.$noviRN" if="parent.$IzDodaj==1" />
				<parameter name="@ServisRNGlaId" value="global.$ServisRNGlaId" else="" />
				<parameter name="@ServisId" value="parent.#cmbModel" />
				<parameter name="@ID" value="$ServisRnDetId" if="$Edit==1" />
				<parameter name="@Indikator" value="$VrstaRobe" />
				<parameter name="@RobaId" value="#srcRoba" if="$Edit==0" />
				<parameter name="@Kolicina" value="#txtKolicinaKom" />
				<parameter name="@Vrijeme" value="#timeUtrVrijeme" />
				<parameter name="@JmId" value="#srcRoba.@JmId" if="$Edit==0" />
				<parameter name="@OrgNettoCijenaKn" value="#bteNabavna" />
				<parameter name="@Cijena" value="#cusCalc.@Cijena" />
				<parameter name="@CijenaPDV" value="#cusCalc.@CijenaPDV" />
				<parameter name="@IznosBezPDV" value="#cusCalc.@IznosBezPDV" />
				<parameter name="@IznosPDV" value="#cusCalc.@IznosPDV" />
				<parameter name="@OrgRabatP" value="$OrgRabatP" />
				<parameter name="@RabatP" value="#cusCalc.@RabatPosto" />
				<parameter name="@Cassa" value="#cusCalc.@CassaPosto" />
				<parameter name="@PorezP" value="#cusCalc.@PorezPosto" />
				<parameter name="@Rabat1" value="#cusCalc.@RabatVrijednost1" if="$Edit==0" />
				<parameter name="@Rabat2" value="#cusCalc.@RabatVrijednost2" if="$Edit==0" />
				<parameter name="@Rabat3" value="#cusCalc.@RabatVrijednost3" if="$Edit==0" />
				<parameter name="@Rabat4" value="#cusCalc.@RabatVrijednost4" if="$Edit==0" />
				<parameter name="@Rabat5" value="#cusCalc.@RabatVrijednost5" if="$Edit==0" />
				<parameter name="@Datum" value="#dateDatumDet" />
				<parameter name="@OperateriId" value="@@operateriid" />
				<parameter name="@RealOrgShemaId" value="#cmbOrgShema" />
				<parameter name="@TrosOrgShemaId" value="#cmbOrgShema" />
				<parameter name="@RokIsporuke" value="#txtRokIsporuke" />
				<parameter name="@RokPlacanja" value="#txtRokPlacanja" />
				<parameter name="@HRKadroviId" value="#srcIzvrsitelj" />
				<parameter name="@ServisNacinObrId" value="#cmbNacinObracuna" />
				<parameter name="@Opis" value="#memNapomena" />
				<parameter name="@SkladisteId" value="#cmbSkladiste" />
				<parameter name="@ValuteId" value="$ValuteId" />
				<parameter name="@TarifaId" value="$TarifaId" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthNapomena">
				<parameter name="@table_name" value="ServisRNDet" />
				<parameter name="@column_name" value="Opis" />
			</data>
		</datalist>
	</form>
</root>
