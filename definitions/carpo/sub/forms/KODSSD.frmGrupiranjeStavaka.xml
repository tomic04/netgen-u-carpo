<root>
  <form name="frmGrupiranjeStavaka" type="master" caption="$caption"  width="500" height="500">
    <event type="load">
      <action type="control populate" value="#grdStavke"/>
    </event>
    <layout textposition="left">
      <group cols="1" rows="2" groupbordervisible="false">
        
        <group cols="5" rows="1" col="1" row="1" spacing="2,2,2,1">
          <item col="1" row="1" caption="Grupa:" colspan="4">
            <comboedit name="cbGrupe" dataname="~dtGrupe" valuefield="oopstavkegrupeid" displayfield="Naziv" />
          </item>
         
          <item col="5" row="1" >
            <button name="btnSpremi"  caption="Postavi grupu" type="add" >
              <event type="click">
                <action type="datarun reader" value="~dtSpremiGrupu" />
                <action type="control populate" value="#grdStavke" />
                <action type="control refreshvalue" value="#cbGrupe"/>
                <action type="control focus" value="#cbGrupe"/>
              </event>
            </button>
          </item>
        </group>
        
        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,2">
          <item col="1" row="1">
            <grid name="grdStavke" key="OOPStavkeId" dataname="dtGrid" showautofilterrow="false" multiselect="true" keyfield="OOPStavkeId">
              
            </grid>
          </item>
        </group>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        <!--GUMB IZLAZ-->
        <button name="btnIzlaz" caption="Izlaz" type="cancel" dock="right">

        </button>


      </buttons>
    </panelbuttons>
    
    <datalist>
      <data command="spOOPStavkeGrupeCP" name="dtGrupe">
        <parameter name="@Action" value="combo_grupe" />
      </data>
      <data command="spOOPStavkeGrupeCP" name="dtSpremiGrupu">
        <parameter name="@Action" value="grupa_set" />
        <parameter name="@oopstavkegrupeid" value="#cbGrupe" />
        <parameter name="@selectedids" value="#grdStavke.selectedids" />
      </data>
      <data command="spOOPStavkeGrupeCP" name="dtGrid">
        <parameter name="@Action" value="grid_stavke_grupe" />
      </data>
    </datalist>
  </form>

</root>