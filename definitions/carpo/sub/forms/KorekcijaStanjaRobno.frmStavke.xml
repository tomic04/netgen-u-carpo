<root>
  <!-- ovo je prva forma unosa 
  22.12.2021. AA shortcuti
  15.11.2018 PJ datumKnjizenja datum s dokumenta
  -->
  <form name="frmStavke" caption="Korekcije prometa" height="500" width="700">
    <event type="shown">
      <action type="datarun reader" value="~dtGet"/>
      <action type="control value" value="#txtBroj">
        <parameter value="~dtGet.@Broj"/>
      </action>
      <action type="control value" value="#cmbSkladiste">
        <parameter value="~dtGet.@SkladisteId"/>
      </action>
      <action type="control value" value="#cmbOdgOsoba">
        <parameter value="~dtGet.@OsobeId"/>
      </action>
      <action type="control value" value="#cmbVrstaDok">
        <parameter value="~dtGet.@VrstaDokId"/>
      </action>
      <action type="control value" value="#cmbOrgShema">
        <parameter value="~dtGet.@OrgShemaId"/>
      </action>
      <action type="control value" value="#datDatum">
        <parameter value="~dtGet.@DatumDok"/>
      </action>
      <action type="control value" value="#txtOpis">
        <parameter value="~dtGet.@OrgDok"/>
      </action>
      <action type="control populate" value="#grdRobaPromet"/>
     <!-- <action type="control disable" value="##" if="~dtGet.@SkladisteId==2"/>-->
<!--      <action type="control disable" value="#btnZakljuci" if="~dtGet.@SkladisteId==2"/>
      <action type="control enable" value="#btnDodaj,#btnIzmjeni,#btnObrisi,#btnDonesi" if="~dtGet.@SkladisteId==1"/>
      <action type="control caption" value="#btnSpremi" if="~dtGet.@SkladisteId==2">
        <parameter value="Izlaz"/>
      </action>-->
      <action type="control caption" value="#btnSpremi" else="">
        <parameter value="Spremi"/>
      </action>
      <action type="variable value">
        <parameter name="DatKnjizenja" value="now" type="date"/>
      </action>
      <action type="control disable" value="#txtBroj,#cmbSkladiste,#cmbOdgOsoba,#cmbVrstaDok,#cmbOrgShema,#txtOpis,#datDatum"/>
    </event>
    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <part name="prtUnosMaster" path="prtKorekcijaStanjaRobno.xml"/>
        <group col="1" row="2" cols="3" rows="4" groupbordervisible="false">
          <columnsdefinition>
            <column position="1" size="40%"/>
            <column position="2" size="40%"/>
            <column position="3" size="20%"/>
          </columnsdefinition>
          <rowsdefinition>
            <row position="1" size="25%"/>
            <row position="2" size="25%"/>
            <row position="3" size="25%"/>
            <row position="4" size="25%"/>
            <!-- <row position="5" size="20%"/> -->
          </rowsdefinition>
          <item col="1" row="1" colspan="2" rowspan="4">
            <grid name="grdRobaPromet" dataname="~dtGrdRobaPromet" showfooter="true" showgrouppanel="false" key="SktPrometDetId" multiselect="true">
              <event type="keydown">
                <action type="form open" value="frmStavkeDetalj" if="key==45">
                  <parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
                </action>
                <action type="confirm" value="Jeste li sigurni da želite obrisati stavku?" if="key==46">
                  <action type="datarun nonquery" value="~dtObrisiDet"/>
                  <action type="control populate" value="#grdRobaPromet"/>
                </action>
                <action type="form open" value="frmStavkeDetalj" if="key==13">
                  <parameter name="SktPrometDetId" value="#grdRobaPromet.@SktPrometDetId"/>
                  <parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
                </action>
              </event>
              <fields>
                <field name="Šifra" showtotalsum="false"/>
                <field name="RobaNaziv"/>
                <field name="VrijednostUlaz"/>
                <field name="VrijednostIzlaz"/>
              </fields>
            </grid>
          </item>
          <item col="3" row="1">
            <button name="btnDodaj" caption="&amp;Dodaj">
              <event type="click">
                <action type="form open" value="frmStavkeDetalj">
                  <parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
                </action>
              </event>
            </button>
          </item>
          <item col="3" row="2">
            <button name="btnIzmjeni" caption="&amp;Izmijeni">
              <event type="click">
                <action type="form open" value="frmStavkeDetalj">
                  <parameter name="SktPrometDetId" value="#grdRobaPromet.@SktPrometDetId"/>
                  <parameter name="SktPrometGlaId" value="$SktPrometGlaId"/>
                </action>
              </event>
            </button>
          </item>
          <item col="3" row="3">
            <button name="btnObrisi" caption="&amp;Obriši">
              <event type="click">
                <action type="confirm" value="Jeste li sigurni da želite obrisati stavku?">
                  <action type="datarun nonquery" value="~dtObrisiDet"/>
                  <action type="control populate" value="#grdRobaPromet"/>
                </action>
              </event>
            </button>
          </item>
          <item col="3" row="4">
            <button name="btnDonesi" caption="Do&amp;nesi">
              <event type="click">
                <action type="datarun reader" value="~dtDonesi"/>
                <action type="control populate" value="#grdRobaPromet"/>
              </event>
            </button>
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnNapomene" caption="Napo&amp;mene">
          <event type="click">
            <action type="form open" value="frmNapomene">
              <parameter name="BrojKorekcije" value="#txtBroj"/>
              <parameter name="VrstaDokId" value="#cmbVrstaDok"/>
            </action>
          </event>
        </button>
        <button name="btnSpremi" caption="&amp;Spremi">
          <event type="click">
            <action type="datarun nonquery" value="~dtSpremi" if="parent.#grdMaster.@StatusStr!=Zaključen"/>
            <action type="variable value" value="Status">
              <parameter value="1"/>
            </action>
            <action type="datarun scalar" value="~dtGetParsedText">
              <parameter name="DodatnoTemp" />
            </action>
            <action type="variable value" value="parent.$DodatnoTemp">
              <parameter value="$DodatnoTemp"/>
            </action>
            <action type="variable value" value="parent.$SktPrometGlaId">
              <parameter value="$SktPrometGlaId"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnZakljuci" caption="&amp;Zaključi">
          <event type="click">
            <action type="datarun nonquery" value="~dtSpremi"/>
            <action type="datarun nonquery" value="~dtZakljuci"/>
            <action type="variable value" value="Status">
              <parameter value="2"/>
            </action>
            <action type="datarun scalar" value="~dtGetParsedText">
              <parameter name="DodatnoTemp" />
            </action>
            <action type="variable value" value="parent.$DodatnoTemp">
              <parameter value="$DodatnoTemp"/>
            </action>
            <action type="variable value" value="parent.$SktPrometGlaId">
              <parameter value="$SktPrometGlaId"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnIspis" caption="Ispiši" dataname="~dtPrint" displayfield="Template">
          <event type="click">
            <action type="control print" value="#grdRobaPromet">
              <action type="print template" value="#btnIspis.@Template">
                <parameter name="id" value="$SktPrometGlaId"/>
              </action>
            </action>
          </event>
        </button>
        <button name="btnUputiMe" caption="Uputi me">
          <event type="click">
            <action type="message" value="Ova funkcionalnost trenutno nije dostupna, molimo kontaktirajte Spin!"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtGetParsedText" command="spCRobnoKorekcijaHelp">
        <parameter name="@Filter" value="$Filter"/>
        <parameter name="@DatumDokumenta" value="#datDatum"/>
        <parameter name="@SkladisteId" value="#cmbSkladiste"/>
        <parameter name="@Status" value="$Status"/>
      </data>
      <data name="dtSkladiste" command="spSkladisteQueryCarpo">
        <parameter name="@Action" value="0"/>
      </data>
      <data name="dtOsoba" command="spCKntPopuniKontrole">
        <parameter name="@Action" value="odgosobe"/>
        <parameter name="@Id" value="null"/>
      </data>
      <data name="dtOrgShema" command="spOrgShemaQueryCarpo">
        <parameter name="@Action" value="0"/>
      </data>
      <data name="dtVrstaDok" command="spVrstaDokQueryCarpo">
        <parameter name="@Action" value="10"/>
        <parameter name="@ID" value="parent.$VrstaPrometa"/>
      </data>
      <data name="dtGet" command="spCRobnoKorekcijaGlaQuery_Jedan">
        <parameter name="@Action" value="0"/>
        <parameter name="@ID" value="$SktPrometGlaId"/>
      </data>
      <data name="dtGrdRobaPromet" command="spSklad_DetailGridKorekcija">
        <parameter name="@Id" value="$SktPrometGlaId"/>
      </data>
      <data name="dtObrisiDet" command="spCRobnoPrometKorekcija">
        <parameter name="@Action" value="2"/>
        <parameter name="@selectedids" value="#grdRobaPromet.selectedids"/>
        <parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
      </data>
      <data name="dtDonesi" command="spCRobnoPrometKorekcija">
        <parameter name="@Action" value="3"/>
        <parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
      </data>
      <data name="dtSpremi" command="spSklad_SktPrometGla_Update">
        <parameter name="@ID" value="$SktPrometGlaId"/>
        <parameter name="@OrgShemaId" value="#cmbOrgShema"/>
        <parameter name="@DatumDok" value="#datDatum"/>
        <parameter name="@SkladisteId" value="#cmbSkladiste"/>
        <parameter name="@OrgDok" value="#txtOpis"/>
        <parameter name="@OsobeId" value="#cmbOdgOsoba"/>
        <parameter name="@Memo" value="$Memo"/>
      </data>
      <data name="dtZakljuci" command="spCRobnoKorekcijaKnjizenje">
        <parameter name="@ID" value="$SktPrometGlaId"/>
        <!--<parameter name="@DatumKnjizenja" value="$DatKnjizenja"/>-->
		<parameter name="@DatumKnjizenja" value="#datDatum"/>
        <parameter name="@OperaterKnjizenjaId" value="@@operateriid"/>
      </data>
      <data name="dtPrint" command="spCRobnoKorekcije_Print">
        <parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
      </data>
    </datalist>
  </form>
</root>