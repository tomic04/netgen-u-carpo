<root>
	<form name="frmPromjenaUnosBrisanjeOOPIsStavke" caption="Vrsta isplate" width="200" height="300">
		<event type='init'>
			<action type="datarun reader" value="~dtGet" if="$oopisstavkeid!=null"/>
		</event>
		<event type="onload">
			<action if="$Tip=='izmjena'">
				<action type="control value" value="#memNaziv" >
					<parameter value="~dtGet.@Naziv"  />
				</action>
			</action>
		</event>
		<layout saveformlayout="true">
			<group cols="1" rows="1" bordervisible="false" >
				<group rows="1" cols="1" spacing="2,2,2,2" highlight="false">
					<item row="1" col="1" caption="Naziv" textposition="left">
						<memoedit name="memNaziv" required="true" />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- Gumb spremi -->
				<button name="btnSpremi" caption="Spremi" >
					<event type="click">
						<action type="validate" />					
						<action type="datarun reader" value="~dtAdd" if="$Tip=='unos'">
						<action type="form close"/>
							<action type="control populate" value="parent.#grdDrugiDohodak" >
								<action type="control focus" value="parent.#grdDrugiDohodak">
									<parameter value="~dtAdd.@noviNaziv" type="int"/>
									
								</action>
								
							</action>
							<action type="message" value="~dtAdd.@poruka" />
						</action>						
						<action type="datarun reader" value="~dtEdit" else="">
						<action type="message" value="~dtEdit.@poruka" />
							<action type="form close"/>	
						</action>
					</event>
				</button>
				<!--Gumb odustani-->
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
					<action type="form close"/>	
				</button>
			</buttons>
		</panelbuttons>	
		<datalist>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtAdd">
				<parameter name="@action" value="unos" />
				<parameter name="@OOPIsStavkeId" value="$noviNaziv"/>
				<parameter name="@naziv" value="#memNaziv"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtEdit">
				<parameter name="@action" value="izmjena" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
				<parameter name="@naziv" value="#memNaziv"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGet">
				<parameter name="@action" value="dtGrid" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
			</data>
		</datalist>
	</form>
</root>