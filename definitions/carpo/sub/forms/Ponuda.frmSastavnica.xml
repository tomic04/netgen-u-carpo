<root>
    <form name="frmSastavnica" caption="Odabir sastavnice" width="800" height="570" >
        <!--Tu pozivam varijablu iz parent forme na onload i postavljam ju u caption-->
        <event type="onload">
            <action type="control caption" value="#rdoSveSlSastZaPr">
                <parameter value="Slobodne sastavnice za proizvod &lt;b&gt;{$NazivRobe}&lt;/b&gt;"/>
            </action>
            <action type="control caption" value="#rdoSveSastZaPr">
                <parameter value="Sve sastavnice za proizvod &lt;b&gt;{$NazivRobe}&lt;/b&gt;"/>
            </action>
            <action type="variable value">
                <parameter name="id1" value="$id" type="int" />
            </action>
        </event>
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="2">
                <group cols="1" rows="2" col="1" row="1" backgroundcolor="#f5f5f5"  >
                    <item row="1" col="1" >
                        <radioedit name="rdoSveSlSastZaPr" value="true" caption="Slobodne sastavnice za proizvod" groupindex="1">
                            <event type="checkedchanged">
                                <action type="variable value" if="#rdoSveSlSastZaPr==true">
                                    <parameter name="action" value="9" type="int"/>
                                    <parameter name="id" value="$id1" type="int"/>
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item>
                    <item row="2" col="1">
                        <radioedit name="rdoSveSastZaPr" caption="Sve sastavnice za proizvod" groupindex="1">
                            <event type="checkedchanged">
                                <action type="variable value" if="#rdoSveSastZaPr==true">
                                    <parameter name="action" value="10" type="int"/>
                                    <parameter name="id" value="$id1" type="int"/>
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item>
<!--                     <item row="3" col="1">
                        <radioedit name="rdoSveSlSastZaSvePr" caption="Sve slobodne sastavnice za sve proizvode" groupindex="1">
                            <event type="checkedchanged">
                                <action type="variable value" if="#rdoSveSlSastZaSvePr==true">
                                    <parameter name="action" value="9" type="int"/>
                                    <parameter name="id" value="0" type="int"/>
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item>
                    <item row="4" col="1">
                        <radioedit name="rdoSveSastZaSvePr" caption="Sve sastavnice za sve proizvode" groupindex="1">
                            <event type="checkedchanged">
                                <action type="variable value" if="#rdoSveSastZaSvePr==true">
                                    <parameter name="action" value="10" type="int"/>
                                    <parameter name="id" value="0" type="int"/>
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item> -->
                </group>
                <group  padding="0" cols="4" rows="2" col="2" row="2" >
                    <colsdefinition>
                        <column position="1" size="100%"></column>
                    </colsdefinition>
                    <item   row="1" col="1" colspan="4" highlight="False" >
                        <grid  name="grdSastavnica" showgrouppanel="False" showfooter="false" autopopulate="true" >
                            <data command="spProizvodiQuery">
                                <parameter name="@Action" value="$action" />
                                <parameter name="@Id" value="$id" />
                                <parameter name="@Tip" value="1" />
                                <parameter name="@PonDetId" value="0" />
                                <parameter name="@RadniNalogId" value="0" />
                            </data>
                            <fields>
                                <field name="RobaNaziv" caption="Naziv" fontbold="true"  />
                                <field name="DatumDok" caption="Datum" />
                                <field name="UserId" caption="Proizvod" />
                                <field name="Oznaka" />
                                <field name="Opis" />
								<field name="Broj" />
                                <!-- <field name="TipStr" caption="Tip"  /> -->
                                <field name="SastCijena" caption="Nabavna cijena"  />
                                <field name="ProdCijena" caption="Prodajna cijena"  />
                                <field name="DatumRefresh" caption="Izmjena"  />
                            </fields>
<!-- 							<styles>
								<style name="bold" value="true" if="#grdSastavnica.@PonDetId&gt;0" />
							</styles> -->								
                        </grid>
                    </item>
					<!-- ZAKOMENTIRAO ZK - imamo filter, da li je ovo onda potrebno? -->
                 <!--    <item row="2" col="2">
                        <radioedit name="rdoTehnoloske" caption="Tehnološke" groupindex="2">
