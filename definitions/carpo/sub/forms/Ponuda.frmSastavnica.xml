                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item> -->
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
				<button name="btnSastavnicaUnesi" caption="Unesi" enabled="false">
					<event type="click">
					</event>
				</button>			
				<button name="btnSastavnicaIzmijeni" caption="Izmijeni" enabled="false">
					<event type="click">
					</event>
				</button>	
				<button name="btnSastavnicaObrisi" caption="Obriši" enabled="false">
					<event type="click">
					</event>
				</button>
				<button name="btnSastavnicaKopiraj" caption="Kopiraj" enabled="false">
					<event type="click">
					</event>
				</button>				
                <button caption="POVEŽI" type="add" dock="right">
                    <!--provjeri Id-->
                    <!--zatvori-->
                    <!--proslijedi parent formi id-->
                    <event type="click">
                        <action type="variable value"  >
                            <parameter name="parent.ProizvodiId" value="#grdSastavnica.@ProizvodiId"  />
                        </action>
                        <action type="control value" value="parent.#lblSastavnica">
                            <parameter value="#grdSastavnica.@Oznaka"/>
                        </action>
                        <action type="control enable" value="parent.#btnSastavnicaDelete" if="parent.$ProizvodiId!=null"/>
                        <action type="control disable" value="parent.#btnSastavnicaAdd" if="parent.$ProizvodiId!=null"/>
                        <!--<action type="control populate" value="parent.#txtSastavnica" />-->
                        <action type="form close"></action>
                        <!--ovdje deklariraj koju kontrolu popunjavaš-->
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right"></button>
            </buttons>
        </panelbuttons>
    </form>
</root>