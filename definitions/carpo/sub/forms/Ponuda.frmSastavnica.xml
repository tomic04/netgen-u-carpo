                                <action type="variable value"  if="#rdoTehnoloske==true">
                                    <parameter name="tip" value="0"  />
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
                        </radioedit>
                    </item>
                    <item row="2" col="3" >
                        <radioedit name="rdoKomercijalne" caption="Komercijalne" dock="right" groupindex="2">
                            <event type="checkedchanged">
                                <action type="variable value"  if="#rdoKomercijalne==true">
                                    <parameter name="tip" value="1" />
                                </action>
                                <action type="control populate" value="#grdSastavnica"/>
                            </event>
