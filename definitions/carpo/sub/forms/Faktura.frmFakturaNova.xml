<!-- 
06.03.2023. MJ - čitanje DatumIzdPopulate iz ProdPostavke
05.05.2022. AR - Zakomentirao <action type="control disable" value="#datDatumOd, #datDatumDo" /> zbog promjene tipa kontrole -->
<root>
	<form name="frmFakturaNova" caption="Unos dokumenta: {$VrstaDok}" width="400">
		<event type="init">
			<action type="datarun reader" value="Global.dtPubVars"/>
			<action type="datarun reader" value="Global.dtPopuniPolja"/>
			<action type="datarun reader" value="Global.dtProdPostavke"/>
			<action type="variable value">
				<parameter name="FakturePromjenaTecaja" value="~dtPubVars.@FakturePromjenaTecaja" type="int" />
			</action>	
			<action type="variable value">
				<parameter name="FakOrgshemaKupac" value="~dtPubVars.@FakOrgshemaKupac" type="int" />
			</action>				
			<action type="variable value">
				<parameter name="IndLoad" value="0" />
			</action>
			<action type="variable value">
				<parameter name="Global.ParStruOdgovornaOsoba" value="~dtPubVars.@ParStruOdgovornaOsoba" type="int" />
			</action>
			<action type="variable value">
				<parameter name="Global.DatumIzdPopulate" value="~dtProdPostavke.@DatumIzdPopulate" type="int" />
			</action>			
		</event>
		<event type="shown">
			<action type="control value" value="#txtBroj">
				<parameter value="&lt;interni broj&gt;"/>
			</action>			
			<action type="control value" value="#txtFisklani">
				<parameter value="&lt;fiskalni broj&gt;"/>
			</action>		
			<action type="control value" value="#cmbKomercijalist">
				<parameter value="null" if="$faktureid=null" />
			</action>	
			<action type="control disable" value="#txtBroj" />
			<action type="control disable" value="#txtFisklani" />
			<action type="control disable" value="#cmbKontakt" if="#srcPartner==null" />
			<action type="control enable" value="#cmbKontakt" else="" />
			<action type="control disable" value="#bteVrBoda" if="#cmbValuta==null" />
			<action type="control enable" value="#bteVrBoda" else="" />			
			<!-- <action type="control value" value="#txtOpcija"> -->
				<!-- <parameter value="~dtPubVars.@PonudaVrijediDana"/> -->
			<!-- </action> -->
			<action type="control value" value="#bteVrBoda">
				<parameter value="~dtPubVars.@NasBod"/>
			</action>			
			<action type="control value" value="#cmbOrgShema">
				<parameter value="~dtPopuniPolja.@OrgShemaId"/>
			</action>
			<action type="control value" value="#cmbOsobe">
				<parameter value="~dtPopuniPolja.@OsobeId"/>
			</action>	
			<action type="control value" value="#cmbNacinOtpreme">
				<parameter value="~dtPopuniPolja.@NacinIsporukeId"/>
			</action>
			<!-- <action type="control value" value="#cmbNacinPlacanja"> -->
				<!-- <parameter value="~dtPopuniPolja.@ProNacinNaplateId"/> -->
			<!-- </action> -->
			<action type="control value" value="#cmbInstrumentPlacanja">
				<parameter value="~dtPopuniPolja.@KntNacinPlacId"/>
			</action>			
			<!--<action type="control disable" value="#datDatumOd, #datDatumDo" />-->
			<action type="control value" value="#datDatumOd, #datDatumDo">
				<parameter value="null" />
			</action>			
			<action type="control focus" value="#srcPartner"/>			
		</event>
		<layout textposition="left">
			<group cols="1" rows="17" groupbordervisible="false">
				<part name="fakturaatributi" path="prtFaktura.xml" />
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="UNESI" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="global.~dtGlavaInsert">
							<parameter name="FaktureId" />
						</action>
						<action type="variable value" value="Global.$DokId">
							<parameter value="$FaktureId" />
						</action>
						<action type="form close"/>
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form open" value="frmFakturaIzmjena">
							<parameter name="FaktureId" value="$FaktureId"/>
							<action type="variable value" value="Global.$DokId">
								<parameter value="$FaktureId" />
							</action>
							<parameter name="StatusFak" value="1"/>
							<parameter name="FakInsert" value="1" />
							<parameter name="VrstaDokId" value="$VrstaDokId" />
							<parameter name="VrstaDok" value="$VrstaDok" />
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>		
	</form>
</root>