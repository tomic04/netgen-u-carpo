<root>
	<form name="frmObracun" width="1000" height="800">
		<event type="shown">
			<action type="control populate" value="#grdObracun"/>
			<action type="datarun reader" value="~dtZaglavlje"/>
			<action type="form caption" value="Prijedlog obračuna kamata za razdoblje od {~dtZaglavlje.@DatumOd::dd.MM.yyyy.} do {~dtZaglavlje.@DatumDo::dd.MM.yyyy.} Vrsta kamate: {~dtZaglavlje.@VrstaKamate}"/>
			<action type="datarun reader" value="~dtBrojcanik"/>
			<action type="variable value">
				<parameter name="brObr" value="~dtBrojcanik.@BrObr"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdObracun" dataname="~dtGrdObracun" showfooter="true" key="tmpKteObracunId" bestfitonrefresh="true">
						<fields>
							<field name="Partner" groupindex="0"/>
							<field name="BrojFak" caption="Broj računa" groupindex="1"/>
							<field name="Duguje"/>
							<field name="Potrazuje" caption="Potražuje"/>
							<field name="Datum"/>
							<field name="BrojDana" caption="Broj dana"/>
							<field name="Koef" caption="Koeficijent" showgroupsum="false" showtotalsum="false"/>
							<field name="Stopa" showgroupsum="false" showtotalsum="false"/>
							<field name="Godmje" caption="Obračunski period" showgroupsum="false" showtotalsum="false"/>
							<field name="Osnovica" showgroupsum="false" showtotalsum="false"/>
							<field name="Kamate"/>	
							<field name="Valuta"/>	
						</fields>
					</grid>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDelete" caption="OBRIŠI">
					<dropdownitem caption="Račun">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati račun: {#grdObracun.@BrojFak}?">
								<action type="datarun nonquery" value="~dtObrisiRc"/>								
								<action type="control populate keepfocus" value="#grdObracun"/>
							</action>
						</event>
					</dropdownitem>
					<dropdownitem caption="Partnera">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati obračun za partnera: {#grdObracun.@Partner}?">
								<action type="datarun nonquery" value="~dtObrisiPrt"/>								
								<action type="control populate keepfocus" value="#grdObracun"/>
							</action>
						</event>
					</dropdownitem>
					<dropdownitem caption="Obračun">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite poništiti obračun?">
								<action type="datarun nonquery" value="~dtObrisiSve"/>								
								<action type="control populate keepfocus" value="#grdObracun"/>
							</action>
						</event>
					</dropdownitem>
				</button>
				<button name="btnSave" caption="SPREMI" waittype="progress" waitcaption="Spremanje obračuna" sleep="2000">
					<event type="click">
						<action type="datarun reader" value="~dtSpremi"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnCancel" type="cancel" caption="ODUSTANI"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGrdObracun" command="spCKteObracunQuery">
				<parameter name="@Action" value="1"/>
				<parameter name="@ID" value="$Id"/>
			</data>
			<data name="dtSpremi" command="spCKteSpremiMulti" timeout="200">
				<parameter name="@tmpKteGlavaID" value="$Id"/>
				<parameter name="@OperateriID" value="@@operateriid"/>
				<parameter name="@BrObr" value="$brObr"/>
			</data>
			<data name="dtObrisiRc" command="spCKteObracunAzur">
				<parameter name="@Action" value="2"/>
				<parameter name="@SelectedId" value="#grdObracun.selectedids"/>
			</data>
			<data name="dtObrisiPrt" command="spCKteObracunAzur">
				<parameter name="@Action" value="3"/>
				<parameter name="@SelectedId" value="#grdObracun.selectedids"/>
			</data>
			<data name="dtObrisiSve" command="spCKteObracunAzur">
				<parameter name="@Action" value="4"/>
				<parameter name="@ID" value="$Id"/>
			</data>
			<data name="dtZaglavlje" command="spCKteGlavaQuery">
				<parameter name="@Action" value="5"/>
				<parameter name="@ID" value="$Id"/>
			</data>		
			<data name="dtBrojcanik" command="spCKntKteBroj">
				<parameter name="@Datum" value="$Datum"/>
			</data>
		</datalist>
	</form>
</root>
