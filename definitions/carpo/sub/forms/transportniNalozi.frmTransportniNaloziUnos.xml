<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmTransportniNaloziUnos" caption="Unos" width="900" height="500">ž
		<layout>
			<group cols="2" rows="4">
			        <columnsdefinition>
                        <column size="33%" position="1" />
                        <column size="33%" position="2" />
						<column size="33%" position="3" />
					</columnsdefinition>
					<item col="1" row="1">
						<labeledit name="lblKupca" value="Podaci o kupcu">
						</labeledit>
					</item>
				<group col="1" row="2" cols="2" rows="4">
					<item col="1" row="1" caption="Kupac:" >
						<searchedit type="partner" name="partner" fieldtext="Naziv" fieldvalue="PartneriId"  fontbold="true" required="true">
							<event type="valuechanged">
								<action type="control enable" value="#txtLokacija" if="#partner!=null" />
								<action type="control populate" value="#txtLokacija" />
								<action type="control popup" value="#txtLokacija" />
							</event>
						</searchedit>						
					</item>
					<item caption="Lokacija:" row="1" col="2">
						<comboedit name="txtLokacija" enabled="false" valuefield="ParStruId" displayfield="Naziv" datavalue="#get.@ParStruId" dataname="dtLokacija" >
						</comboedit>
					</item>	
					<item col="1" row="2" caption="Roba otprema:" >
						<textedit name="txtRoba" required="true">
						</textedit>
					</item>
					<item col="2" row="2" caption="Količina otprema:">
						<textedit name="txtKolicinaOtprema">
						</textedit>
					</item>
					<item col="1" row="3" caption="Napomena:">
						<textedit name="txtNapomena">
						</textedit>
					</item>	
				</group>
					<item col="2" row="1">
						<labeledit name="lblTransport" value="Podaci o transportu">
						</labeledit>
					</item>	
				<group col="2" row="2" cols="2" rows="4">
					<item col="1" row="1" caption="Datum isporuke:">
						<dateedit name="datIsporuke" value="now">
						</dateedit>
					</item>	
					<item col="2" row="1" caption="Vrijeme isporuke:">
						<textedit name="vrijemeIsporuke" value="00:00" formattype="regex" format="([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]">
						</textedit>
					</item>	
					<item col="1" row="2" caption="Ulaz/izlaz:">
						<comboedit name="cmbVrstaIsporuke" dataname="dtVrstaIsporuke" displayfield="tekst" valuefield="Id">
						</comboedit>
					</item>
					<item col="2" row="2" caption="Prijevoznik:" >
						<searchedit type="partner" name="prijevoznik" fieldtext="Naziv" fieldvalue="PartneriId" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@PartnerNaziv" fontbold="true" required="true">
							<event type="valuechanged">
								<action type="control enable" value="kamion" if="#prijevoznik!=null" />

								
								<action type="control populate" value="kamion" />
							</event>
						</searchedit>						
					</item>
					<item caption="Kamion:" row="3" col="1">
						<searchedit name="kamion" enabled="false" fieldvalue="kamionId" fieldtext="registracija" datavalue="#get.@ParStruId" dataname="dtKamion"  >
							<event type="valuechanged">
								<action type="datarun reader" value="~dtVozaci"/>
								<action type="control refreshvalue" value="#vozac"/>
								<action type="control populate" value="vozac" if="#kamion!=null"/>						
							</event>
						</searchedit>
					</item>	
					<item caption="Vozač:" row="3" col="2">
						<searchedit name="vozac"  fieldvalue="OsobeId" fieldtext="Naziv" datavalue="~dtVozaci.@VozacId" datatext="~dtVozaci.@Naziv" dataname="dtVozaci1" >						
						</searchedit>
					</item>						
				</group>
				<item col="1" row="3">
					<labeledit name="lblFakturiranje" value="Podaci za fakturiranje">
					</labeledit>
				</item>					
				<group col="1" row="4" cols="2" rows="3">
					<columnsdefinition>
						<column size="340" position="1" />
						<column size="8" position="2" />
					</columnsdefinition>				
					<item textvisible="false" row="1" col="1" fontsizedelta="1" caption="Roba:">
						<searchedit type="roba" name="txtUsluga" fontsizedelta="1" fontbold="True" fieldtext="Naziv" fieldvalue="RobaId" >
							<event type="valuechanged">
								<action type="control focus" value="txtKolicina"></action>
								<action type="control enable" value="txtKolicina" if="#txtRoba!=null" />
							</event>
						</searchedit>
					</item>
					<item caption="Količina" textposition="top" row="1" col="2"  >
						<textedit name="txtKolicina" fontsizedelta="1" fontbold="True" format="n2" value="1" enabled="true">
							<event type="valuechanged">
								<action type="control value" value="cusCalc">
									<parameter name="Kolicina" value="this"/>
								</action>
							</event>
						</textedit>
					</item>
					<item caption="Cijena" textposition="top" row="2" col="2" >
						<textedit name="txtCijena" fontsizedelta="2" format="n2" value="0" enabled="true">
							<event type="valuechanged">
								<action type="control value" value="#lblVrijednost">
									<parameter name="Cijena" value="txtCijena.text" type="decimal"/>									
								</action>
								<action type="datarun reader" value="~dtVrijednost"/>
						
								<action type="control value" value="#lblVrijednost" >
								<parameter value="~dtVrijednost.@Vrijednost"/>
								</action>		
							</event>
						</textedit>
					</item>
					<item caption="Vrijednost:"  row="3" col="2">
						<labeledit name="lblVrijednost" textposition="right" value="0" format="n2" datavalue="~dtVrijednost">
						</labeledit>
					</item>
					<item caption="Valuta:" row="2" col="1">
						<comboedit name="cmbValute" valuefield="ValuteId" displayfield="Naziv" datavalue="#get.@DevValuteId" dataname="dtValute" />
					</item>
				</group>		
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtsktNalogTransportInsert">
						</action>
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close"/> 
					</event>
				</button>
                <button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>	
		<datalist>
			<data command="spTestiram" name="dtLokacija">
				<parameter name="@Action" value="Lokacije" />
				<parameter name="@PartneriId" value="#partner" />
			</data>
			<data command="spEvidencijaVozilaQuery" name="dtKamion">
				<parameter name="@PartneriId" value="#prijevoznik" />
				<parameter name="@registracija" value="#kamion.text" />
			</data>
			<data command="spVozaci" name="dtVozaci">
				<parameter name="@naziv" value="#vozac.text"/>
				<parameter name="@partneriid" value="#prijevoznik"/>
				<parameter name="@kamionId" value="#kamion"/>
			</data>
			<data command="spVozaci" name="dtVozaci1">
				<parameter name="@naziv" value="#vozac.text"/>
				<parameter name="@partneriid" value="#prijevoznik"/>
				<parameter name="@kamionId" value="#kamion"/>
				<parameter name="@ind" value="1"/>
			</data>				
			<data command="select  @id1 as Id,@par1 as tekst union all select  @id2 as Id,@par2 as tekst" type="text" name="dtVrstaIsporuke">
				<parameter name="@par1" value="Ulaz" />
				<parameter name="@Id1" value="U" />
				<parameter name="@par2" value="Izlaz" />
				<parameter name="@Id2" value="I" />
			</data>
			<data command="spJKatalogTree" name="dtOrgShema">
				<parameter name="@Action" value="orgshema" />
			</data>
			<data command="spNG_Combo" name="dtValute">
				<parameter name="@Action" value="valute"/>
				<parameter name="@Oznaka" value="Oznaka"/>
			</data>
			<data command="select cast(@Kolicina * (coalesce(@Cijena, 0)) as decimal(18,2)) as Vrijednost" type="text" name="dtVrijednost">
				<parameter name="@Kolicina" type='decimal' value="#txtKolicina"/>
				<parameter name="@Cijena" type='decimal' value="#txtCijena"/>
			</data>					
			<data command="spsktNalogTransportInsert" name="dtsktNalogTransportInsert">
				<parameter name="@datumIsporuke" value="#datIsporuke" />
				<parameter name="@vrijemeIsporuke" value="#vrijemeIsporuke" />
				<parameter name="@prijevoznikId" value="#prijevoznik" />
				<parameter name="@kamionId" value="#kamion" />
				<parameter name="@vozacId" value="#vozac" />
				<parameter name="@partnerId" value="#partner" />
				<parameter name="@parStruId" value="#txtLokacija" />
				<parameter name="@roba" value="#txtRoba" />
				<parameter name="@kolicinaOtprema" value="#txtKolicinaOtprema" />
				<parameter name="@napomena" value="#txtNapomena" />
				<parameter name="@kolicinaRobe" value="#txtKolicina" />
				<parameter name="@cijena" value="#txtCijena" />
				<parameter name="@vrstaIsporuke" value="#cmbVrstaIsporuke" />
				<parameter name="@valute" value="#cmbValute" />
				<parameter name="@robaId" value="#txtUsluga" />
			</data>
		<data command="spsktNalogTransportQuery" name="dtGet">
				<parameter name="@Id" value="$sktNalogTransportId"/>
		</data>			
		</datalist>			
	</form>
</root>