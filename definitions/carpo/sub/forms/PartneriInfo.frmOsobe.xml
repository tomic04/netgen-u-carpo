<?xml version="1.0" encoding="utf-8"?>
<root>
  <form name="frmOsobe" caption="Poslovni podaci" width="550" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet"/>
    </event>
    <layout itemspadding="3" textposition="left">
      <group cols="2" rows="4" >
        <rowsdefinition>
          <row position="3" size="10"/>
        </rowsdefinition>
        <group cols="2" rows="2" col="1" row="1" groupbordervisible="false">
          <!-- potreban atribut koji će poravnati headere sa parentom -->
          <item caption="Šifra:" col="1" row="1" highlight="false" >
            <textedit name="txtSifra" datavalue="~dtGet.@Sifra"/>
          </item>
          <item caption="Titula:" col="1" row="2" highlight="false">
            <comboedit name="cmbTitula" valuefield="PreTitleId" displayfield="Naziv" dataname="dtTitule" datavalue="~dtGet.@PreTitleId" datatext="~dtGet.@PreTitleNaziv"/>
          </item>
          <item caption="Zvanje:" col="2" row="2" highlight="false">
            <comboedit name="cmbZvanje" valuefield="PosTitleId" displayfield="Naziv" dataname="dtZvanja" datavalue="~dtGet.@PosTitleId" datatext="~dtGet.@PosTitleNaziv"/>
          </item>
        </group>
        <group cols="6" rows="6" col="1" row="2" colspan="2" groupbordervisible="false">
          <rowsdefinition>
            <row position="3" size="10"/>
          </rowsdefinition>
          <item caption="Ime:" col="1" row="1" colspan="3" highlight="false" fontbold="true" >
            <textedit name="txtIme" fontbold="true" datavalue="~dtGet.@Ime"/>
          </item>
          <item caption="Prezime:" col="4" row="1" colspan="3" highlight="false" fontbold="true" >
            <textedit name="txtPrezime" fontbold="true" datavalue="~dtGet.@Prezime" />
          </item>
          <item caption="OIB:" col="1" row="2" colspan="3" highlight="false" >                                                                                                        <!-- required dodati -->
            <textedit name="txtOIB" datavalue="~dtGet.@OIB"/>
          </item>
          <item caption="JMBG:" col="4" row="2" colspan="3" highlight="false" >
            <textedit name="txtJMBG" datavalue="~dtGet.@JMBG"/>
          </item>
          <item col="1" row="3" colspan="2"/>
          <item caption="Adresa:" col="1" row="4" colspan="4" highlight="false" >
            <textedit name="txtAdresa" datavalue="~dtGet.@Adresa" />
          </item>
          <item caption="Mjesto" col="5" row="4" colspan="2" highlight="false" >
            <comboedit name="cmbMjesto" valuefield="MjestaId" displayfield="Naziv" dataname="dtMjesta" datavalue="~dtGet.@MjestaId" datatext="~dtGet.@MjestaNaziv" />
          </item>
          <item caption="Private:" col="1" row="5" colspan="2" highlight="false" >
            <textedit name="txtPrivate" datavalue="~dtGet.@Private"/>
          </item>
          <item caption="Mobile:" col="3" row="5" colspan="2" highlight="false" >
            <textedit name="txtMobile" datavalue="~dtGet.@Mobile"/>
          </item>
          <item caption="Pager:" col="5" row="5" colspan="2" highlight="false" >
            <textedit name="txtPager" datavalue="~dtGet.@Pager"/>
          </item>
          <item caption="Email:" col="1" row="6" colspan="3" highlight="false" >
            <textedit name="txtEmail" datavalue="~dtGet.@Email"/>
          </item>
        </group>
        <item col="1" row="3" colspan="2"/>
        <group caption="Poslovni podaci" cols="3" rows="6" col="1" row="4" colspan="2" >
          <item caption="Partner" col="1" row="1" colspan="3">
            <textedit name="txtPartner" datavalue="~dtGet.@PartnerNaziv" enabled="false"/>
          </item>
          <item caption="Lokacija:" col="1" row="2" colspan="3" >
            <comboedit name="cmbLokacija" valuefield="ParStruId" displayfield="Naziv" dataname="dtLokacije" datavalue="~dtGet.@ParStruId" datatext="~dtGet.@ParStruNaziv"/>
          </item>
          <group cols="2" rows="1" col="1" row="3" colspan="3" groupbordervisible="false">
            <item caption="Funkcija:" col="1" row="1" >
              <comboedit name="cmbFunkcija" valuefield="KlFunkcijeId" displayfield="Naziv" dataname="dtFunkcije" datavalue="~dtGet.@KlFunkcijeId" datatext="~dtGet.@KlFunkcijeNaziv"/>
            </item>
            <item  col="2" row="1" >
              <checkedit name="chkKeyContact" caption="Key contact" datavalue="~dtGet.@KeyContact"/>
            </item>
          </group>
          <item caption="Odjel:" col="1" row="4" colspan="3" >
            <comboedit name="cmbOdjel" valuefield="OdjelId" displayfield="Naziv" dataname="dtOdjel" datavalue="~dtGet.@OdjelId" datatext="~dtGet.@OdjelNaziv"/>
          </item>
          <group col="1" row="5" cols="3" rows="1" colspan="3" groupbordervisible="false" >
            <item caption="Telefon:" col="1" row="1" >
              <textedit name="txtTelefon" datavalue="~dtGet.@Telefon"/>
            </item>
            <item caption="Fax:" col="2" row="1" >
              <textedit name="txtFax" datavalue="~dtGet.@Fax"/>
            </item>
            <item caption="Lokal:" col="3" row="1" >
              <textedit name="txtLokal" datavalue="~dtGet.@Lokal"/>
            </item>
          </group>
          <item caption="Email:" col="1" row="6" colspan="2" >
            <textedit name="txtEmailPos" datavalue="~dtGet.@LnOsoParEmail"/>
          </item>
        </group>
      </group>
    </layout>
    <datalist>
      <data command="spPreTitleQuery_Carpo" name="dtTitule">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
        <parameter name="@Naziv" value=" " />
      </data>
      <data command="spPosTitleQuery_Carpo" name="dtZvanja">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
        <parameter name="@Naziv" value="" />
      </data>
      <data command="spMjestaQuery_Carpo" name="dtMjesta">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
        <parameter name="@Naziv" value=" " />
        <parameter name="@HPTBroj" value=" " />
      </data>
      <data command="spPartneriQuery_Carpo" name="dtLokacije">
        <parameter name="@Action" value="2" />
        <parameter name="@ID" value="$PartneriId" />
        <parameter name="@IDPartneri" value="0" />
        <parameter name="@DownUnder" value="0" />
        <parameter name="@SortKey" value="" />
        <parameter name="@Naziv" value="" />
        <parameter name="@Sifra" value="" />
        <parameter name="@MatBroj" value="" />
        <parameter name="@Ziro" value="" />
      </data>
      <data command="spKlFunkcijeQuery_Carpo" name="dtFunkcije">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
      </data>
      <data command="spOdjelQuery_Carpo" name="dtOdjel">
        <parameter name="@Action" value="0" />
        <parameter name="@ID" value="0" />
      </data>
      <data command="spCrOsobaQuery_Carpo" name="dtGet">
        <parameter name="@ID" value="$PartneriId"/>
        <parameter name="@OsobeId" value="$OsobeId"/>
      </data>
      <data command="spOsobeAzur_Carpo" name="dtOsobeEdit">
        <parameter name="@Action" value="1"/>
        <parameter name="@ID" value="$OsobeId"/>
        <parameter name="@Ime" value="#txtIme"/>
        <parameter name="@Prezime" value="#Prezime"/>
        <parameter name="@Telefon" value="#txtTelefon"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@EmailPos" value="#txtEmail"/>
        <parameter name="@EmailPos" value="#txtEmailPos"/>
        <parameter name="@Mobile" value="#txtMobile"/>
        <parameter name="@Pager" value="#txtPager"/>
        <parameter name="@Private" value="#txtPrivate"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@Lokal" value="#txtLokal"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@LnOsoParId" value="~dtGet.@LnOsoParId"/> <!-- -->
        <parameter name="@ParStruId" value="~dtGet.@ParStruId"/>
        <parameter name="@KlFunkcijeId" value="~dtGet.@KlFunkcijeId"/>
        <parameter name="@JMBG" value="#txtJMBG"/>
        <parameter name="@PreTitleId" value="#cmbTitula"/>
        <parameter name="@PosTitleId" value="#cmbZvanje"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@OdjelId" value="~dtGet.@OdjelId"/>
        <parameter name="@Sifra" value="#txtSifra"/>
        <parameter name="@SubAction" value="0"/>
        <parameter name="@KeyContact" value="#"/> <!-- proslijediti ček box -->
        <parameter name="@OIB" value="#txtOIB"/>
        <parameter name="@OsobeKategorijeId" value="0"/>
        <parameter name="@ZSIskaznica" value=""/>
      </data>
      <data command="spOsobeAzur_Carpo" name="dtOsobeEdit">
        <parameter name="@Action" value="1"/>
        <parameter name="@ID" value="$OsobeId"/>
        <parameter name="@Ime" value="#txtIme"/>
        <parameter name="@Prezime" value="#Prezime"/>
        <parameter name="@Telefon" value="#txtTelefon"/>
        <parameter name="@Fax" value="#txtFax"/>
        <parameter name="@EmailPos" value="#txtEmail"/>
        <parameter name="@EmailPos" value="#txtEmailPos"/>
        <parameter name="@Mobile" value="#txtMobile"/>
        <parameter name="@Pager" value="#txtPager"/>
        <parameter name="@Private" value="#txtPrivate"/>
        <parameter name="@Adresa" value="#txtAdresa"/>
        <parameter name="@Lokal" value="#txtLokal"/>
        <parameter name="@MjestaId" value="#cmbMjesto"/>
        <parameter name="@LnOsoParId" value="~dtGet.@LnOsoParId"/> <!-- -->
        <parameter name="@ParStruId" value="~dtGet.@ParStruId"/>
        <parameter name="@KlFunkcijeId" value="~dtGet.@KlFunkcijeId"/>
        <parameter name="@JMBG" value="#txtJMBG"/>
        <parameter name="@PreTitleId" value="#cmbTitula"/>
        <parameter name="@PosTitleId" value="#cmbZvanje"/>
        <parameter name="@PartneriId" value="$PartneriId"/>
        <parameter name="@OdjelId" value="~dtGet.@OdjelId"/>
        <parameter name="@Sifra" value="#txtSifra"/>
        <parameter name="@SubAction" value="0"/>
        <parameter name="@KeyContact" value="#"/> <!-- proslijediti ček box -->
        <parameter name="@OIB" value="#txtOIB"/>
        <parameter name="@OsobeKategorijeId" value="0"/>
        <parameter name="@ZSIskaznica" value=""/>
      </data>
    </datalist>
  </form>
</root>
