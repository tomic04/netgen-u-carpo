<root>
	<form name="frmDokumentInfo" caption="Info dokumenta {$Broj}" width="350" height="160" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGetQuery"/>
			<action type="variable value">
				<parameter name="ValutaOznaka" value="~dtGetQuery.@Valuta" />
			</action>
		</event>
		<event type="onload">
			<action type="variable value">
				<parameter name="UkupnoBrutoKn" value="~dtGetQuery.@IznosFakture" />
			</action>
			<action type="variable value">
				<parameter name="IznosPlaceno" value="~dtGetQuery.@IznosPlaceni" />
			</action>
			<action type="datarun reader" value="~dtSaldo"/>
			<action type="control value" value="#lblStatus">
				<parameter value="~dtGetQuery.@StatusStr"/>
			</action>
			<action type="control value" value="#lblKreiran">
				<parameter value="~dtGetQuery.@Kreiran"/>
			</action>
			<action type="control value" value="#lblZadnjaIzmjena">
				<parameter value="~dtGetQuery.@ZadnjaIzmjena"/>
			</action>
<!--		<action type="control value" value="#lblOtkljucan">
				<parameter value="~dtGetQuery.@Otkljucan"/>
			</action>   -->
			<action type="control value" value="#lblBrutoDev" if="$ValutaOznaka!=null">
				<parameter value="~dtGetQuery.@DevIznos"/>
			</action>
			<action type="control value" value="#lblBrutoDev" else="">
				<parameter value=""/>
			</action>
			<action type="control value" value="#lblBrutoKn">
				<parameter value="$UkupnoBrutoKn"/>
			</action>
			<action type="control value" value="#lblPlacenoKn">
				<parameter value="$IznosPlaceno"/>
			</action>
			<action type="control value" value="#lblNetoDev" if="$ValutaOznaka!=null">
				<parameter value="~dtGetQuery.@DevIznos"/>
			</action>
			<action type="control value" value="#lblNetoDev" else="">
				<parameter value=""/>
			</action>
			<action type="control value" value="#lblNetoKn">
				<parameter value="~dtGetQuery.@IznosBezPoreza"/>
			</action>		
			<action type="control value" value="#lblPlacenoDev" if="$ValutaOznaka!=null">
                <parameter value="~dtGetQuery.@DevUplata"/>
            </action>
			<action type="control value" value="#lblPlacenoDev" else="">
                <parameter value=""/>
            </action>
	<!-- 	<action type="control value" value="lblFakturirano">
                <parameter value="~dtGet.@IznosZatvoreno"/>
            </action> -->
			<action type="control value" value="lblSaldo">
				<parameter value="~dtSaldo.@Saldo"/>
			</action>
		</event>
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<group rows="1" cols="1" row="1" col="1" colspan="2" groupbordervisible="false">
					<tabs row="1" col="1" padding="4">
						<group caption="Status" cols="3" rows="11" col="1" row="1">
							<item row="1" col="1" textvisible="False" padding="5">
								<labeledit value="Status:" />
							</item>
							<item row="1" col="2" colspan="2" textvisible="False" padding="5">
								<labeledit name="lblStatus" value="#lblStatus" />
							</item>
							<item row="2" col="1" textvisible="False" padding="5">
								<labeledit value="Kreiran:" />
							</item>
							<item row="2" col="2" colspan="2" textvisible="False" padding="5">
								<labeledit name="lblKreiran" value="..."/>
							</item>
							<item row="3" col="1" textvisible="False" padding="5">
								<labeledit value="Zadnja izmjena:" />
							</item>
							<item row="3" col="2" colspan="2" textvisible="False" padding="5">
								<labeledit name="lblZadnjaIzmjena" value="..."/>
							</item>
	<!--					<item row="4" col="1" textvisible="False" padding="5">
								<labeledit value="Zaključen:" />
							</item>
							<item row="4" col="2" colspan="2" textvisible="False" padding="5">
								<labeledit name="lblAktiviran" value="..."/>
							</item>
							<item row="5" col="1" textvisible="False" padding="5">
								<labeledit value="Otključan:" />
							</item>
							<item row="5" col="2" colspan="2" textvisible="False" padding="5">
								<labeledit name="lblOtkljucan" value="..."/>
							</item>    -->
							<item row="8" col="1" textvisible="False" colspan="3">
								<separator dark="true" backcolor="gray" />
							</item>
							<item row="9" col="1" textvisible="False" padding="5">
								<labeledit value="Iznos s PDV-om:" />
							</item>
							<item row="9" col="2" textvisible="False" padding="5">
								<labeledit name="lblBrutoKn" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
							<item row="9" col="3" textvisible="False" padding="5">
								<labeledit name="lblBrutoDev" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
							<item row="10" col="1" textvisible="False" padding="5">
								<labeledit value="Iznos bez PDV-a:" />
							</item>
							<item row="10" col="2" textvisible="False" padding="5">
								<labeledit name="lblNetoKn" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
							<item row="10" col="3" textvisible="False" padding="5">
								<labeledit name="lblNetoDev" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
							<item row="11" col="1" textvisible="False" padding="5">
								<labeledit value="Ukupno plaćeno:" />
							</item>
							<item row="11" col="2" textvisible="False" padding="5">
								<labeledit name="lblPlacenoKn" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
							<item row="11" col="3" textvisible="False" padding="5">
								<labeledit name="lblPlacenoDev" value="0.00" format="n2" sufix=" {$ValutaOznaka}"/>
							</item>
						</group>
					<group caption="Plaćanje" cols="2" rows="3" col="1" row="1">
							<group cols="1" rows="1" col="1" row="1" groupbordervisible="false" colspan="2" >
								<item row="1" col="1" highlight="False" >
									<grid name="grdPlaceno" showgrouppanel="False" showfooter="true" autopopulate="true" showautofilterrow="false">
							<!--		<data command="spFaktureRateQuery">
											<parameter name="@id" value="$FaktureId" />
										</data>  -->
										<fields>
											<field name="datumvalute" caption="Datum" />
											<field name="iznosfakture" caption="Zaduženje" />
											<field name="placeno" caption="Uplata" />
										</fields> 
									</grid> 
								</item>
							</group> 
							<item row="2" col="1" textvisible="False" padding="5">
								<labeledit value="Saldo:" />
							</item>
							<item row="2" col="2" textvisible="False" padding="5">
								<labeledit name="lblSaldo" value="0.00" format="n2" />
							</item>
							<item row="3" col="1" textvisible="False" padding="5">
								<labeledit value="Fakturirano:" />
							</item>
							<item row="3" col="2" textvisible="False" padding="5">
								<labeledit name="lblFakturirano" value="0.00" format="n2" />
							</item>
						</group> 
				</tabs>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="select coalesce(@IznosFakture, 0) - coalesce(@IznosPlaceni, 0) as Saldo" type="text" name="dtSaldo">
				<parameter name="@IznosFakture" type='decimal' value="$UkupnoBrutoKn"/>
				<parameter name="@IznosPlaceni" type='decimal' value="$IznosPlaceno"/>
			</data>
			<data command="spProd_FakInfoDok_Query" name="dtGetQuery">
				<parameter name="@Id" value="$FaktureId"/>
			</data>
		</datalist>
	</form>
</root>