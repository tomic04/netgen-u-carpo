<root>
	<form name="frmDonos" height="700" width="700">
		<event type="shown">
			<action type="control populate" value="#grdDonos"/>
		</event>
		<layout>
			<group col="1" row="1" cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdDonos" dataname="~dtDonos" showcheckboxes="true" showgroupedcolumns="true" key="rbrId">
						<fields>
							<field name="Skladiste" groupindex="1"/>
							<field name="Roba" showgroupsum="false"/>
							<field name="NazivRobe"/>
							<field name="VrijednostUlaz"/>
							<field name="VrijednostIzlaz"/>
							<field name="OrgShema"/>
						</fields>
					</grid>
				</item>
			</group>			
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnKnjizenje" caption="Proknjiži">
					<event type="click">
						<action type="datarun nonquery" value="~dtKnjizenje"/>
						<action type="form close"/>							
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtVrstaDok" command="spVrstaDokQueryCarpo">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtOsoba" command="spCKntPopuniKontrole">
				<parameter name="@Action" value="odgosobe"/>
				<parameter name="@Id" value="null"/>
			</data>
			<data name="dtDonos" command="spCRobnoPrometKorekcija_DonosSKlad">
				<parameter name="ID" value="$ID"/>
			</data>
			<data name="dtKnjizenje" command="spCRobnoKorekcija_DonosSkladKnjizenje">
				<parameter name="@selectedDet" value="#grdDonos.selectedids.table"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>
		</datalist>
	</form>
</root>