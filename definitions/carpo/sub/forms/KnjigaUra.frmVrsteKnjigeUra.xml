<root version="1.0.0.1">
	<form name="frmVrsteKnjigeUra" caption="Vrsta knjige URA unos" fixedsize="true">
		<event type="init"> 
			<!-- <action type="datarun reader" value="~dtTekGodina" /> -->
			<action type="datarun reader" value="~dtPodaciZaIzmjenu" />
			<!--insert-->
			<action type="variable value" if="$KntVrsteKnjigaUraId==null">
				<parameter name="act" value="0" type="int" />
			</action>
			<!--udate-->
			<action type="variable value" elseif="$KntVrsteKnjigaUraId!=null">
				<parameter name="act" value="1" type="int" />
			</action>
		</event>
		<event type="load">	
		</event>
		<event type="shown">
			<action type="form caption" value="Vrsta knjige URA unos" if="$KntVrsteKnjigaUraId==null"/>
			<action type="form caption" value="Vrsta knjige URA izmjena" elseif="$KntVrsteKnjigaUraId!=null"/>		
		</event>
		<layout itemspadding="2">
			<group cols="2" rows="2" groupbordervisible="true">
				<columnsdefinition>
					<column size="20%" position="1" />
					<column size="80%" position="2" />	
				</columnsdefinition>
				<item col="1" row="1" caption="Naziv:" colspan="2">
					<textedit name="txtNaziv"  datavalue="~dtPodaciZaIzmjenu.@NazivKnjige"/>
				</item>
				<item col="1" row="2" caption="PDV:" colspan="1">
					<textedit name="txtPDV"  datavalue="~dtPodaciZaIzmjenu.@PDV" maxlength="1"
								tooltip="Plaćeni i R2 računi - I
										Uvoz proizvoda - U
										Uvoz usluga - 3
										Vlastita potrošnja - V"/>
				</item>
				<item col="2" row="2" caption="Organizacijska shema:" colspan="1">
					<combotreeedit name="cmbOrgShema" autopopulate="true" parentfieldname="ParentId" valuefield="Id" displayfield="Naziv" datavalue="~dtPodaciZaIzmjenu.@OrgShemaId" dataname="~dtGetOrgShema"/>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnAdd" caption="&amp;Spremi" dock="left">
					<event type="click">
						<action type="datarun scalar" value="~dtUrediKnjigu">
							<parameter name="parent.$DrvoPoz"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntTemOrgShemaQuery" name="dtGetOrgShema">
				<parameter name="@Action" value="0" />
			</data>	
			<data command="spCKntVrsteKnjigaUraAzur" name="dtUrediKnjigu">
				<parameter name="@action" value="$act" type="int"/>
				<parameter name="@ID" value="$KntVrsteKnjigaUraId" type="int"/>
				<parameter name="@NazivKnjige" value="#txtNaziv"/>
				<parameter name="@PDV" value="" type="string" if="#txtPDV==null"/>
				<parameter name="@PDV" value="#txtPDV" else=""/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema" type="int"/>
				<parameter name="@Godina" value="parent.#tree.@id" if="parent.#tree.@id!=0"/>
				<parameter name="@Godina" value="$Godina" else="parent.#tree.@id==0"/>
			</data>	
			<data command="spCKntVrsteKnjigaUraQuery" name="dtPodaciZaIzmjenu">
				<parameter name="@action" value="1" type="int"/>
				<parameter name="@ID" value="$KntVrsteKnjigaUraId" type="int"/>
			</data>
		</datalist>
	</form>
</root>