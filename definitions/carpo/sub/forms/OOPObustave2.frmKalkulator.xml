<root>
  <form name="frmKalkulator"  caption="$caption" width="150" height="150" saveformsize="false" fixedsize="true"  >

    <!--<event type="init">
      <action type="datarun reader" value="~dtPodaciObustava"/>
      <action type="datarun reader" value="~dtGet" if="$OOPObustaveDetId!=0"/>
    </event>-->

    <event type="load">
      <action type="control value" value="#txtSaldo">
        <parameter value="$saldo"/>
      </action>
      <action type="control disable" value="#txtSaldo">
      </action>
      <!--<action type="message" value="$tip"/>-->
    </event>
    <event type="shown">
      <action type="datarun reader" value="~dtObroci">
      </action>
      <action type="control value" value="#txtPrviObrok">
        <parameter value="~dtObroci.@PrviObrok"/>
      </action>
      <action type="control value" value="#txtOstaliObroci">
        <parameter value="~dtObroci.@OstaliObroci"/>
      </action>
      <action type="control value" value="#txtBrojObroka">
        <parameter value="~dtObroci.@BrojObroka"/>
      </action>
    </event>

    <layout>
      <group rows="4" cols="1" groupbordervisible="false" spacing="2" textposition="left">
        
        <item caption="Saldo:" col="1" row="1" highlight="false">
          <textedit name="txtSaldo" enabled="false" />
        </item>
        <item caption="Broj obroka:" col="1" row="2" highlight="false">
          <textedit name="txtBrojObroka" type="integer" value="1">
            <event type="valuechanged">
              <action type="datarun reader" value="~dtObroci">
              </action>
              <action type="control value" value="#txtPrviObrok">
                <parameter value="~dtObroci.@PrviObrok"/>
              </action>
              <action type="control value" value="#txtOstaliObroci">
                <parameter value="~dtObroci.@OstaliObroci"/>
              </action>
              <action type="control value" value="#txtBrojObroka">
                <parameter value="~dtObroci.@BrojObroka"/>
              </action>
            </event>
          </textedit>
        </item>
        <item caption="Prvi obrok:" col="1" row="3" highlight="false">
          <textedit name="txtPrviObrok" type="decimal" value="#txtSaldo" readonly="true" format="n2"/>
        </item>
        <item caption="Ostali obroci:" col="1" row="4" highlight="false">
          <textedit name="txtOstaliObroci" type="decimal" value="#txtSaldo" readonly="true" format="n2"/>
        </item>

      </group>
    </layout>

    <!--gumbi-->

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Prihvati">
          <event type="click">
              <action type="validate"/>
              <action type="form close"/>
              <action type="control value" value="parent.#txtPrviObrok">
                <parameter value="#txtPrviObrok"/>
              </action>
            <!--ako je verzija 2 obustava, ona ima ostale obroke i nju popuni-->
            <action type="control value" value="parent.#txtOstaliObroci" if="$tip==2">
              <parameter value="#txtOstaliObroci"/>
            </action>
          </event>
        </button>

        <button name="btnOdustani" caption="Odustani" type="cancel"/>
      </buttons>

    </panelbuttons>

    <!--datalist-->

    <datalist>
      <data command="spOOPObustaveHelpCP" name="dtObroci">
        <parameter name="@action" value="izracunaj_obroke" type="string"/>
        <parameter name="@saldo" value="#txtSaldo" type="decimal"/>
        <parameter name="@brojobroka" value="#txtBrojObroka"/>
      </data>
    </datalist>


  </form>
</root>
