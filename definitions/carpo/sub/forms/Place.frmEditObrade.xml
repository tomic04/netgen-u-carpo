<root>
  <!--FORMA ZA UNOS/IZMJENU OBRADE-->

  <form name="frmEditObrade" caption ="$caption" width="780" height="615" fixedsize="true" saveformsize="false" showversion="true" version="1" >
    <event type="init">
      <action type="datarun reader" value="~dtGet">
        <!--<parameter name="Tip" value="~dtGet.@Tip"/>-->
      </action>
      <action type="datarun reader" value="~dtParametri">
        <!--<parameter name="Tip" value="~dtGet.@Tip"/>-->
      </action>
    </event>

    <event type="load">
      <action type="control populate" value="#grdParametri" >     </action>
      <action type="control value" value="#rdoOpcija1" if="~dtget.@status==0">
        <parameter value="true"/>
      </action>
      <action type="control value" value="#rdoOpcija2" if="~dtget.@status==1">
        <parameter value="true"/>
      </action>
      <action type="control disable" value="#rdoOpcija1" if="$tip==unos"/>
      <action type="control enable" value="#rdoOpcija1" else=""/>


      <action type="control disable" value="#rdoOpcija2" if="$tip==unos"/>
      <action type="control enable" value="#rdoOpcija2" else=""/>

      <action type="control disable" value="#chkSviAktivni" if="$tip==Izmjena"/>
      <action type="control enable" value="#chkSviAktivni" else=""/>

      <action type="control disable" value="#txtGodina,#txtMjesec,#txtRbr,#txtDanOd,#txtDanDo,#cmbVrstaObrade,#datDatumObrade,#datDatumDospijeca,#datDatumIsplate,#datDatumObustava,#chkSviAktivni,#grdParametri,#txtNapomena" if="~dtGet.@status==1"/>


    </event>

    <layout>

      <!--omotač-->
      <group cols="2" rows="4"  groupbordervisible="false">

        <columnsdefinition>
          <column position="1" size="35%"></column>
          <column position="2" size="65%"></column>
        </columnsdefinition>
        <!--<rowsdefinition>
          <row position="1" size="50%"></row>
          <row position="2" size="35%"></row>
          <row position="2" size="15%"></row>
        </rowsdefinition>-->

        <!--def obrade-->
        <group col="1" row="1" cols="1" rows="6"  groupbordervisible="true"  caption="Definicija obrade"  spacing="2,1,2,2" >

          <item caption="Godina:" col="1" row="1" textposition="left">
            <textedit name="txtGodina" required="true"   datavalue="~dtGet.@Godina" textposition="left" maxlength="4" format="[0-9][0-9][0-9][0-9]" formattype="regex">

              <event type="leave">
                <action type="datarun reader" value="~dtPopuniDane" if="#txtGodina!=null"/>
                <action type="control value" value="#txtDanOd" if="#txtGodina!=null">
                  <parameter value="~dtPopuniDane.@DanOd"/>
                </action>
                <action type="control value" value="#txtDanDo" if="#txtGodina!=null">
                  <parameter value="~dtPopuniDane.@DanDo"/>
                </action>
              </event>
            </textedit>
          </item>
          <item caption="Mjesec:" col="1" row="2" textposition="left">
            <textedit name="txtMjesec" required="true"   datavalue="~dtGet.@Mjesec" textposition="left" maxlength="2"  format="[1-9]|1[0-2]" formattype="regex">
              <event type="leave">
                <action type="datarun reader" value="~dtPopuniDane" if="#txtMjesec!=null"/>
                <action type="control value" value="#txtDanOd" if="#txtMjesec!=null">
                  <parameter value="~dtPopuniDane.@DanOd"/>
                </action>
                <action type="control value" value="#txtDanDo" if="#txtMjesec!=null">
                  <parameter value="~dtPopuniDane.@DanDo"/>
                </action>
              </event>
            </textedit>
          </item>
          <item caption="Rbr:" col="1" row="3" textposition="left">
            <!--<textedit name="txtRbr" required="true"  datavalue="~dtGet.@Rbr" textposition="left" maxlength="2" format="n0"/>-->
          <textedit name="txtRbr" required="true"  datavalue="~dtGet.@Rbr" textposition="left" maxlength="2"/>
          </item>

          <item caption="Dan od:" col="1" row="4" textposition="left">
            <textedit name="txtDanOd" required="true" format="n0"  datavalue="~dtGet.@DanOd" textposition="left" maxlength="2" enabled="false"/>
          </item>
          <item caption="Dan do:" col="1" row="5" textposition="left">
            <textedit name="txtDanDo" required="true" format="n0"  datavalue="~dtGet.@DanDo" textposition="left" maxlength="2" enabled="false"/>
          </item>

          <item caption="Vrsta obrade:" col="1"  row="6" textposition="left">
            <comboedit name="cmbVrstaObrade"  valuefield="OOPObradeVrsteId" displayfield="Naziv" dataname="~dtVrstaObrade" datavalue="#dtGet.@OOPObradeVrsteId"  required="true" allownull="false"/>
          </item>
        </group>
        <group col="1" row="2" cols="1" rows="4"  groupbordervisible="true"  caption="Datumi obrade"  spacing="2,1,2,2" >

          <item caption="Datum obrade:" col="1" row="1" textposition="left">
            <dateedit name="datDatumObrade" required="true"  datavalue="~dtGet.@DatumObrade" value="now"/>
          </item>
          <item caption="Datum dospijeća:" col="1" row="2" textposition="left">
            <dateedit name="datDatumDospijeca" required="true"  datavalue="~dtGet.@DatumDospijeca" value="now"/>
          </item>
          <item caption="Datum isplate:" col="1" row="3" textposition="left">
            <dateedit name="datDatumIsplate" required="true"  datavalue="~dtGet.@DatumIsplate" value="now"/>
          </item>
          <item caption="Datum obustave:" col="1" row="4" textposition="left">
            <dateedit name="datDatumObustava" required="true"  datavalue="~dtGet.@DatumObustava" value="now"/>
          </item>
        </group>
        <!--kraj datumi obrade-->
        <group col="1" row="3" cols="1" rows="1"  groupbordervisible="true"  caption="Opcije prijenosa"  spacing="2,1,2,2" alignmode="local">

          <item col="1" row="1" textposition="left" >
            <checkedit caption="Prenesi sve aktivne djelatnike" name="chkSviAktivni"/>
          </item>

        </group>
        <!--kraj datumi obrade-->

        <!--parametri obrade-->
        <group col="2" row="1" cols="1" rows="1" rowspan="3"  groupbordervisible="false"  caption="Parametri obrade"  spacing="2,1,2,2">
          <item col="1" row="1">
            <grid name="grdParametri" dataname="dtParametri" fieldsmartspaces="false" key="PlaceTempId"  keyfield="PlaceTempId" showgrouppanel="false" showautofilterrow="false" bestfitonrefresh="true">
              <fields inherited="true">
                <field name="Vrijednost" editable="true"></field>
              </fields>

              <event type="cellvaluechanged" >
                <action type="datarun nonquery" value="dtSpremiParametar"/>
              </event>
            </grid>
          </item>
        </group>

        <!--kraj parametri obrade-->

        <!--napomena i status-->
        <group col="1" row="4" cols="2" rows="2" colspan="2" groupbordervisible="false"  caption="Dodatno"  spacing="2,1,2,2">
          <item caption="Napomena:" col="2" row="1" rowspan="2" >
            <memoedit name="txtNapomena" datavalue="~dtGet.@Napomena" />
          </item>
          <item  col="1" row="1" caption="Status:" highlight="False">
            <radioedit name="rdoOpcija1" caption="Otvorena" value="true" >
            </radioedit>
          </item>
          <item  col="1" row="2" highlight="False">
            <radioedit name="rdoOpcija2" caption="Zatvorena" >
            </radioedit>
          </item>
        </group>


      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtKontrola"/>
            <action type="message" value="~dtKontrola.@Poruka"  if="~dtKontrola.@Id!=0"/>
            <action elseif="~dtKontrola.@Id==0">
              <action type="datarun reader" value="~dtSpremi" waittype="progress" waitcaption="Pričekajte..." waittext="..spremanje u tijeku...">
                <action type="variable value">
                  <parameter name="OOPObradeId" value="~dtSpremi.@OOPObradeId"/>
                </action>
                <action type="variable value">
                  <parameter name="parent.$drvoFokusId" value="~dtSpremi.@OOPObradeId"/>
                  <parameter name="parent.$filterFokus" value="otvorene"/>
                </action>
              </action>

              <action type="message" value="~dtSpremi.@Poruka"/>
              <action type="form close" if="~dtSpremi.@Id==0"/>
            </action>


          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <!--<action type="control populate" value="parent.#grdPlace"/>-->
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlace_help" name="dtPopuniDane">
        <parameter name="@Action" value="daj_dane_za_oznaku" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@godina" value="#txtGodina" type="string"/>
        <parameter name="@mjesec" value="#txtMjesec" type="string"/>
      </data>
      <data command="spPlaceObradeQuery" name="dtGet">
        <parameter name="@Action" value="podaci_obrada" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid" type="int"/>
        <parameter name="@operateriid" value="@@operateriid"/>
      </data>
      <data command="spPlaceObradeAzur" name="dtKontrola">
        <parameter name="@Action" value="kontrola_spremanje" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid" type="int"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@godina" value="#txtGodina" type="string"/>
        <parameter name="@mjesec" value="#txtMjesec" type="string"/>
        <parameter name="@rbr" value="#txtRbr" type="string"/>
        <parameter name="@danod" value="#txtDanOd" type="int"/>
        <parameter name="@dando" value="#txtDanDo" type="int"/>
        <parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade" type="int"/>
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date"/>
        <parameter name="@DatumDospijeca" value="#datDatumDospijeca" type="date"/>
        <parameter name="@DatumIsplate" value="#datDatumIsplate" type="date"/>
        <parameter name="@DatumObustava" value="#datDatumObustava" type="date"/>
      </data>
      <data command="spPlace_help" name="dtVrstaObrade">
        <parameter name="@Action" value="cmb_vrstaobrade"/>
        <!-- <parameter name="@granula" value="@@moduleid"/> -->
      </data>
      <data command="spPlaceObradeAzur" name="dtSpremi" if="$tip==unos">
        <parameter name="@Action" value="unos" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@godina" value="#txtGodina" type="string"/>
        <parameter name="@mjesec" value="#txtMjesec" type="string"/>
        <parameter name="@rbr" value="#txtRbr" type="string"/>
        <parameter name="@danod" value="#txtDanOd" type="int"/>
        <parameter name="@dando" value="#txtDanDo" type="int"/>
        <parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade" type="int"/>
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date"/>
        <parameter name="@DatumDospijeca" value="#datDatumDospijeca" type="date"/>
        <parameter name="@DatumIsplate" value="#datDatumIsplate" type="date"/>
        <parameter name="@DatumObustava" value="#datDatumObustava" type="date"/>
        <parameter name="@status" value="0" type="int"/>
        <parameter name="@napomena" value="#txtNapomena" type="string"/>
        <parameter name ="@ind" value="1" if="#chkSviAktivni==true" type="int"/>
      </data>
      <data command="spPlaceObradeAzur" name="dtSpremi" if="$tip==izmjena">
        <parameter name="@Action" value="izmjena" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid" type="int"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@godina" value="#txtGodina" type="string"/>
        <parameter name="@mjesec" value="#txtMjesec" type="string"/>
        <parameter name="@rbr" value="#txtRbr" type="string"/>
        <parameter name="@danod" value="#txtDanOd" type="int"/>
        <parameter name="@dando" value="#txtDanDo" type="int"/>
        <parameter name="@OOPObradeVrsteId" value="#cmbVrstaObrade" type="int"/>
        <parameter name="@DatumObrade" value="#datDatumObrade" type="date"/>
        <parameter name="@DatumDospijeca" value="#datDatumDospijeca" type="date"/>
        <parameter name="@DatumIsplate" value="#datDatumIsplate" type="date"/>
        <parameter name="@DatumObustava" value="#datDatumObustava" type="date"/>
        <parameter name="@status" value="0" type="int" if="#rdoOpcija1==true"/>
        <parameter name="@status" value="1" type="int" if="#rdoOpcija2==true"/>
        <parameter name="@napomena" value="#txtNapomena" type="string"/>
      </data>
      <data command="spPlaceParametri_help" name="dtParametri">
        <parameter name="@Action" value="daj_parametre" type="string"/>
        <parameter name="@TIP" value="parametriPlace" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid" type="int"/>
      </data>

      <data command="spPlaceParametri_help" name="dtSpremiParametar">
        <parameter name="@Action" value="izmijeni_parametar" type="string"/>
        <parameter name="@PlaceTempId" value="#grdParametri.@PlaceTempId" type="int"/>
        <parameter name="@vrijednost" value="#grdParametri.@Vrijednost" type="string"/>
      </data>

    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>