<root>
	<form name="frmTerminalAzur_Lokacije"  caption="Povezivanje terminala s rutama">
		<event type="oninit">
			<action type="datarun reader" value="~dtTerminalLokacije" />
			<action type="datarun reader" value="~dtTerminalSkladiste" />
		</event>
		<event type="onload">
			<action type="control populate" value="#grdRute, #grdSkladiste" />
			<action type="control selectedrows" value="#grdRute">
				<parameter value="$RuteIds"/>
			</action>
			<action type="control selectedrows" value="#grdSkladiste">
				<parameter value="$SkladisteIds"/>
			</action>			
		</event>
		<layout>
			<group padding="0" groupbordervisible="False" cols="1" rows="1">
				<tabs col="1" row="1" padding="4">
					<group caption="Rute" rows="1" cols="1">
						<item row="1" col="1" >
							<grid name="grdRute" key="RuteId" dataname="~dtGetLokacije" showcheckboxes="true" bestfitonrefresh="true" />
						</item>
					</group>
					<group caption="Skladište" rows="1" cols="1" col="1" row="1">
						<item row="1" col="1" >
							<grid name="grdSkladiste" key="SkladisteId" dataname="~dtGetSkladiste" showcheckboxes="true" bestfitonrefresh="true" />
						</item>
					</group>			
				</tabs>	
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremiLokacije" caption="SPREMI">
					<event type="click">
						<action type="datarun nonquery" value="~dtSpremiLokacije" />
						<action type="datarun nonquery" value="~dtSpremiSkladiste" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spTerminalRute_Query" name="dtGetLokacije" />
			<data command="spTerminalRute_RutePoTerminalima" name="dtTerminalLokacije">
				<parameter name="@TerminalId" value="$TerminalId" />
			</data>
			<data command="spTerminalAzur_UpdateTerminalLokacije" name="dtSpremiLokacije">
				<parameter name="@RuteId" value="#grdRute.selectedids" />
				<parameter name="@TerminalId" value="$TerminalId" />
			</data>
			<data command="spTerminalSkladiste_Query" name="dtGetSkladiste" />
			<data command="spTerminalskladiste_SkladistePoTerminalima" name="dtTerminalSkladiste">
				<parameter name="@TerminalId" value="$TerminalId" />
			</data>
			<data command="spTerminalAzur_UpdateTerminalskladiste" name="dtSpremiSkladiste">
				<parameter name="@SkladisteId" value="#grdSkladiste.selectedids" />
				<parameter name="@TerminalId" value="$TerminalId" />
			</data>			
		</datalist>
	</form>
</root>
