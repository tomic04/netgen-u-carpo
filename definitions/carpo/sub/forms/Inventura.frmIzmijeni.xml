<root>
<form name="frmIzmijeni" caption="Inventura - skladišna" width="800" height="500">
		<event type="oninit">
		
			<action type="datarun reader" value="Global.~dtGet" />
			<action type="datarun reader" value="Global.~dtGetGlava" />
		</event>
		<layout textposition="left" itemspadding="3" >
			<group cols="1" rows="1" >
				<group cols="1" rows="2" >
					<part name="partUnos1" path="prtInventura.xml"/>	
						<group  cols="2" rows="7" col="1" row="2" spacing="3">
						  <columnsdefinition>
							<column size="100%" position="1" />
							<column size="80" position="2" />
						  </columnsdefinition>
						  <tabs row="1" col="1" padding="4" rowspan="7">
							  <group row="1" col="1" rows="1" cols="1" caption="Stavke">
								<item row="1" col="1" highlight="False" >
								<grid name="grdRoba1" autopopulate="True"  showfooter="False" dataname="Global.dtGet">
									<fields>
										<field name="UserId" caption="Roba" />
										<field name="RobaNaziv" caption="Naziv"/>
										<field name="JMNaziv" caption="JM"/>
										<field name="KKvalGla_broj" caption="Kontingent"/>
										<field name="KolicinaStvarnaKorigirana" caption="Popisana kol."/>
										<field name="DatumPopisa" caption="Datum popisa"/>
										<field name="KolicinaPeriodUlaz" caption="Ulaz kol."/>
										<field name="KolicinaPeriodIzlaz" caption="Izlaz kol."/>
										<field name="KolicinaStvarna" caption="Stvarna kol."/>
										<field name="KolicinaKnjizna" caption="Knjižna kol."/>
										<field name="Cijena" caption="Cijena"/>
										<field name="Klasifikacija" caption="Klasifikacija"/>
										<field name="konto" caption="Konto"/>
									</fields>
								</grid>
							 </item>
							  </group>
							  <group caption="Napomena" cols="3" rows="3" col="1" row="1">
									  <columnsdefinition>
										<column size="100%" position="1" />
										<column size="70" position="2" />
										<column size="70" position="3" />
									  </columnsdefinition>
									  <rowsdefinition>
										<row size="30" position="2" />
									  </rowsdefinition>
									  <item caption="Standardne napomene:" textposition="top" row="1" col="1" colspan="3">
										<comboedit name="cmbNapomena" enabled="True" valuefield="Poruka" displayfield="Poruka" datavalue="#dtGet.@Poruka" dataname="Global.dtPoruke" />
									  </item>
									  <item row="2" col="2">
										<button name="btnDodaj" caption="Dodaj" enabled="False" dock="right">
										  <event type="click">
											<action type="datarun reader" value="~dtNapomena" />
											<action type="control value" value="#MemoGlava">
											  <parameter value="~dtNapomena.@tekst" />
											</action>
										  </event>
										</button>
									  </item>
									  <item row="2" col="3">
										<button name="btnZamjeni" caption="Zamjeni" type="edit" enabled="False" dock="right">
										  <event type="click">
											<action type="control value" value="#MemoGlava">
											  <parameter value="#cmbNapomena" />
											</action>
										  </event>
										</button>
									  </item>
									  <item row="3" col="1" textvisible="False" colspan="3">
										<memoedit name="MemoGlava" datavalue="~dtGet.@Memo" />
									  </item>
								</group>
							 </tabs>
							 <item row="1" col="2">
								<button caption="Priprema"></button>
							 </item>
							 <item row="2" col="2">
								<button caption="Prijenos"></button>
							 </item>
							 <item row="3" col="2">
								<button caption="Dodaj">
									<event type="click">
										<action type="form open" value="frmRoba"/>
									</event>
								</button>
							 </item>
							 <item row="4" col="2">
								<button caption="Izmijeni"></button>
									<event type="click">
										<action type="form open" value="frmRoba"/>
									</event>
							 </item>
							 <item row="5" col="2">
								<button caption="Donos iz sklad. posl."></button>
							 </item>
							 <item row="6" col="2">
								<button caption="Donos iz rob.mat. posl."></button>
							 </item>
							<item row="7" col="2">
								<button caption="Popuni popis. kol."></button>
							</item>
						</group>					
				</group>
			</group>
		</layout>
		<panelbuttons>
            <buttons>
              <button name="" caption="Inv. lista" dock="right" >
              </button>
               <button name="" caption="Inv. razlike" dock="right">
               </button>
				<button name="" caption="Spremi" dock="right">
				</button>
                <button name="" caption="Zaključi" dock="right">
                </button>
				<button name="" caption="Ispiši" dock="right">
                </button>
				<button name="" caption="Upomoć!" dock="right">
                </button>
            </buttons>
        </panelbuttons>
	</form>
</root>