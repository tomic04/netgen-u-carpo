<root>
	<form name="frmRoba" path="frmRoba.xml"/>
	<form name="frmUvjeti" caption="Spremi promjene?" width="600">
		<event type="init">
			<action type="variable value" value="global.SpremiUvjete">
				<parameter value="null"/>
			</action>
		</event>
		<layout>
			<group rows="2" cols="1">
				<item row="1" col="1">
					<labeledit name="lblObavijest" value="Promjene na dokumentu nisu spremljene, a mogu utjecati na vrijednosti prilikom dodavanja nove stavke."/>
				</item>
				<item row="2" col="1">
					<labeledit name="lblPitanje" value="Želite li spremiti dokument prije dodavanja nove stavke?"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi i nastavi">
					<event type="click">
						<action type="variable value" value="global.$SpremiUvjete">
							<parameter value="true"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdbaci" caption="Odbaci i nastavi">
					<event type="click">
						<action type="variable value" value="global.$SpremiUvjete">
							<parameter value="false"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>