				<parameter name="@PartneriId" value="#srcPartner"/>
				<parameter name="@Datum" value="#datDatumDok"/>
				<parameter name="@TroskoviIznos" value="#txtTrosakIznos" type="decimal"/>
				<parameter name="@TroskoviPosto" value="#txtTrosakPosto" type="decimal"/>
				<parameter name="@Status" value="$Status"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@OsobeId" value="#cmbOsobe"/>
				<parameter name="@DatumZak" value="$DatumZak"/>			
				<parameter name="@FakturniIznos" value="#txtFVrijednost" type="decimal"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@ValuteId" value="#cmbValuta"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>	
				<parameter name="@OrgShemaId" value="#cteOrgShema"/>
				<parameter name="@ParStruId" value="#cmbLokacija"/>				
