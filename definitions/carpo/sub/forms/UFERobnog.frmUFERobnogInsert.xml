				<parameter name="@PartneriId" value="#srcPartner" type="int"/>
				<parameter name="@OperateriId" value="@@OperateriId" type="int"/>
				<parameter name="@OsobeId" value="#cmbOsobe" type="int"/>			
				<parameter name="@ValuteId" value="#cmbValuta" type="int"/>
				<parameter name="@OrgShemaId" value="#cteOrgShema" type="int"/>
				<parameter name="@ParStruId" value="#cmbLokacija" type="int"/>
				<parameter name="@TroskoviIznos" value="#txtTrosakIznos" type="decimal"/>
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@TroskoviPosto" value="#txtTrosakPosto" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Datum" value="#datDatumDok" type="datetime"/>
				<parameter name="@FakturniIznos" value="#txtFVrijednost" type="decimal"/>
				<parameter name="@Status" value="1"/>					
			</data>
			<data name="dtLokHqInd" command="spCRobnoKalkHelp">
				<parameter name="@Action" value="1"/>
				<parameter name="@PartneriId" value="#srcPartner"/>
			</data>
