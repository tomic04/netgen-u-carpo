				<parameter name="@Action" value="3"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
			</data>
			<data name="dtOperaterLockReset" command="spCarpoOperaterLock">
				<parameter name="@Action" value="Close"/>
				<parameter name="@OperaterLockTable" value="RobnoKalkGla"/>
				<parameter name="@OperaterLockKey" value="RobnoKalkGlaId"/>
				<parameter name="@OperaterLockKeyValue" value="$RobnoKalkGlaId"/>
			</data>	
			<data name="dtTroskovi" command="spCRobnoTroskoviQuery">
				<parameter name="@Action" value="3"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>		
			</data>	
			<data name="dtNepovezaneFakture" command="spCRobnoNepovezaneFaktureQuery">
				<parameter name="@PartneriId" value="#srcPartner"/>
				<parameter name="@BrojDok" value="#txtUra"/>				
				<parameter name="@Id"  value="$RobnoKalkGlaId"/>
			</data>	
			<data name="dtPozicija" command="spCRobnoKalkHelp">
				<parameter name="@Action" value="4"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>	
				<parameter name="@DrvoFilter" value="parent.#filter"/>
				<parameter name="@DrvoId" value="parent.#tree.@Id"/>						
			</data>	
			<data name="dtMainValuta" command="spKntDvojno_KnEur">
				<parameter name="@Datum" value="#datDatumDok"/>
			</data>				
