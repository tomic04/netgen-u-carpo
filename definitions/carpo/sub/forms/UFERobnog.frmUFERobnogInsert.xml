<!--30.11.2020. AA Roba je Roba zbog RobaDefKey-->
 <form name="frmUFERobnogInsert" operaterlocktable="RobnoKalkGla" operaterlockkey="RobnoKalkGlaId" operaterlockkeyvalue="global.$OperaterLockId" width="1050" height="550">
	<event type="init">
			<!-- <action type="datarun reader" value="~dtRobaDet"/> -->
			<action  if="$RobnoKalkGlaId!=null">
				<action type="datarun reader" value="~dtKalkGlaQuery"/>
				<action type="datarun reader" value="~dtTroskovi"/>				
				<action type="variable value">
					<parameter name="UFA" value="~dtKalkGlaQuery.@FaktureDobId"/>
				</action>		
				<action type="variable value">
					<parameter name="UFADatumDok" value="~dtKalkGlaQuery.@DatumDok"/>
				</action>				
			</action>
			<action else="">
				<action type="variable value">
					<parameter name="UFA" value="null"/>
				</action>
				<action type="variable value">
					<parameter name="UFADatumDok" value="null"/>
				</action>					
			</action>			
			<action type="variable value">
				<parameter name="indProm" value="0"/>
			</action>	
			<action type="variable value" value="global.$OtvorenaEditForma">
				<parameter value="0"/>
			</action>
			<action type="variable value" value="global.$RafalniUnos">
				<parameter value="0"/>
			</action>					
		</event>
		<event type="load">
			<action type="control populate" value="#grdStavke"/>
			<action type="control disable" value="#btnDonesi,#btnEditDetalj,#btnEditDetaljSve,#btnDeleteDetalj,#btnDodajDetalj,#btnUrednik,#btnSpremi,#btnZakljuci,#btnPrint" if="$RobnoKalkGlaId==null"/>
			<action type="control disable" value="#btnSpremiGlavu" if="$RobnoKalkGlaId!=null"/>
			<action type="control disable" value="#srcPartner,#cmbLokacija,#cmbValuta,#txtTrosakIznos,#txtTrosakPosto,#btnDonesi,#btnEditDetalj,#btnEditDetaljSve,#btnDeleteDetalj,#btnDodajDetalj,#btnZakljuci" if="$Status==2||$Status==S"/>
			<action type="control disable" value="#btnEditDetalj,#btnEditDetaljSve,#btnUrednik,#btnZakljuci,#btnDeleteDetalj" if="#grdStavke.rowcount==0"/>
			<action type="control disable" value="#txtTrosakIznos,#txtTrosakPosto" if="$RobnoKalkGlaId!=null&amp;&amp;~dtTroskovi.@RobnoTroskoviId!=null"/>
			<action type="control disable" value="#srcPartner,#cmbLokacija" if="$UFA!=null"/>
			<action type="control enable" value="#srcPartner,#cmbLokacija" else=""/>			
			<part name="prtRobnoKalkSum" path="prtUFERobnogKalk.xml"/>
			<action type="control enable" value="#txtTecaj,#btnTecajOsvjezi" if="#cmbValuta!=null"/>
			<action type="control disable" value="#txtTecaj,#btnTecajOsvjezi" else=""/>	
			<action type="datarun reader" value="~dtMainValuta"/>	
			<action type="variable value" value="$MainValuta">
				<parameter value="~dtMainValuta.@ValutaNow"/>
			</action>			
		</event>
		<event type="shown">
			<action type="form caption" value="$Caption"/>
			<!--fejk varijabla za fokus na prvi kod izmijeni sve -->
			<action type="variable value" value="$TopRobnoKalkDetId">
				<parameter value="#grdStavke.@RobnoKalkDetId"/>
			</action>
			<action type="control value" value="#lblMainValuta1, #lblMainValuta2, #lblMainValuta3, #lblMainValuta4, #lblMainValuta5">
				<parameter value="$MainValuta"/>
			</action>			
		</event>
		<event type="close">
			<action type="datarun nonquery" value="~dtOperaterLockReset" if="$RobnoKalkGlaId!=null"/>
			<!-- <action type="control populate keepfocus" value="parent.#grdGlava"/> -->
			<action if="$RobnoKalkGlaId!=null">
				<action type="datarun reader" value="~dtPozicija"/>
				<action type="variable value" value="parent.$DrvoId">
					<parameter value="~dtPozicija.@DrvoId"/>
				</action>
				<action type="variable value" value="parent.$GridId">
					<parameter value="~dtPozicija.@RobnoKalkGlaId"/>
				</action>				
			</action>	
			<action type="variable value">
				<parameter name="global.OperaterLockId" value="0" type="int"/>
			</action>				
		</event>
