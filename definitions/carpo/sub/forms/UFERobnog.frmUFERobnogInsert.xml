								<action if="key==46">
									<part name="prtRobnoKalkDetDelete" path="prtUFERobnog.xml"/>
								</action>
								<!--EDIT-->
								<action if="key==13">
									<part name="prtRobnoKalkDetUpdate" path="prtUFERobnog.xml"/>
								</action>
								<!--INSERT-->
								<action if="key==45">
									<part name="prtRobnoKalkDetInsert" path="prtUFERobnog.xml"/>
								</action>
							</event>							
							<fields>	 
