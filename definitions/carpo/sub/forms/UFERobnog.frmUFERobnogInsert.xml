								<event type="click">
									<!--vraćam fokus na prvi u gridu, inače petlja ne odvrti sve slogove -->
									<!-- <action type="control focus" value="#grdStavke"> -->
										<!-- <parameter value="$TopRobnoKalkDetId" /> -->
									<!-- </action> -->
									<action type="control focus" value="#grdStavke">
										<parameter value="#grdStavke.@RobnoKalkDetId"/>
									</action>									
									<action type="variable value" value="global.$RafalniUnos" if="#grdStavke.rowcount&gt;0">
										<parameter value="1"/>
									</action>
									<action if="#grdStavke.rowcount&gt;0&amp;&amp;global.$RafalniUnos==1">
										<action type="form open" value="frmUFERobnogStavka" if="#cmbValuta!=null">
											<parameter name="Action" value="1"/>
											<parameter name="PartneriId" value="#srcPartner"/>
											<parameter name="Tecaj" value="#txtTecaj"/>
											<parameter name="TrosakP" value="#txtTrosakPosto"/>
											<parameter name="valutaOznaka" value="#cmbValuta.@oznaka"/>
											<parameter name="RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
											<parameter name="RobnoKalkDetId" value="#grdStavke.@RobnoKalkDetId"/>
											<parameter name="RobaId" value="#grdStavke.@RobaId"/>
											<parameter name="Status" value="$Status"/>
											<parameter name="ValuteId" value="#cmbValuta"/>
										</action>
										<action type="variable value" value="global.$RafalniUnos" if="dialogresult==cancel">
											<parameter value="0"/>
										</action>										
										<action type="form open" value="frmUFERobnogStavka" elseif="#cmbValuta==null">
											<parameter name="Action" value="1"/>
											<parameter name="PartneriId" value="#srcPartner"/>
											<parameter name="Tecaj" value="#txtTecaj"/>
											<parameter name="TrosakP" value="#txtTrosakPosto"/>
											<parameter name="valutaOznaka" value="$MainValuta"/>
											<parameter name="RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
											<parameter name="RobnoKalkDetId" value="#grdStavke.@RobnoKalkDetId"/>
											<parameter name="RobaId" value="#grdStavke.@RobaId"/>
											<parameter name="Status" value="$Status"/>
											<parameter name="ValuteId" value="#cmbValuta"/>
										</action>
										<action type="variable value" value="global.$RafalniUnos" if="dialogresult==cancel">
											<parameter value="0"/>
										</action>
									</action>
									<action type="variable value" value="global.$RafalniUnos" if="global.$Close==true">
										<parameter value="0"/>
									</action>																			
									<action type="variable value" value="global.$RafalniUnos" if="#grdStavke.rowcount==#grdStavke.rownumber">
										<parameter value="0"/>
									</action>
									<action type="variable value" value="global.$OtvorenaEditForma">
										<parameter value="0"/>
									</action>
									<action  if="global.$RafalniUnos==1">
										<action type="control focusnextrow" value="#grdStavke"/>													
									</action>									
									<action if="global.$RafalniUnos!=1">								
										<action type="control populate keepfocus" value="#grdStavke"/>
										<part name="prtRobnoKalkSum" path="prtUFERobnogKalk.xml"/>
									</action>
									<!-- <action type="control populate" value="parent.#grdDetail"/>									 -->								
								</event>
							</button>
						</item>
						<item row="1" col="4" textvisible="False" spacing="0,0,0,0">
							<button name="btnDeleteDetalj" caption="&amp;OBRIŠI">
								<event type="click">
									<part name="prtRobnoKalkDetDelete" path="prtUFERobnog.xml"/>				
								</event>
							</button>
						</item>
						<item row="1" col="5" textvisible="False" spacing="0,0,0,0">
							<button name="btnUrednik" caption="&amp;UREDNIK RABATA">
								<event type="click">
									<action type="form open" value="frmUrednikRabata" if="#grdStavke.rowcount&gt;0">
										<parameter name="RobaId" value="#grdStavke.@RobaId"/>
										<parameter name="RobnoKalkDetId" value="#grdStavke.@RobnoKalkDetId"/>
									</action>
									<action type="control populate" value="#grdStavke"/>
									<action type="control populate" value="parent.#grdGlava"/>
									<part name="prtRobnoKalkSum" path="prtUFERobnogKalk.xml"/>
								</event>
							</button>							
						</item>
						<item row="1" col="7" textvisible="False" spacing="0,0,0,0">												
						</item>
					</group>
				</group>
				<group caption="" cols="1" rows="5" groupbordervisible="false">
					<rowsdefinition>
						<row size="5" position="2" />
					</rowsdefinition>
					<group caption="Opći podaci" cols="1" rows="6" col="1" row="1" >
						<part name="uferobnogatributi" path="prtUFERobnogOpci.xml"/>
					</group>
					<group caption="URA" cols="3" rows="1" col="1" row="3" backgroundcolor="#d2d2e0">					
						<part name="uferobnogufa" path="prtUFERobnogUFA.xml"/>	
					</group>	
					<group caption="" cols="1" rows="1" col="1" row="4" groupbordervisible="false">			
						<rowsdefinition>
							<row position="1" size="40"/>
						</rowsdefinition>						
						<item row="1" col="1">
							<button name="btnSpremiGlavu" caption="S&amp;TAVKE" dock="right">
								<event type="click">
									<part name="prtRobnoKalkGlaSave" path="prtUFERobnog.xml"/>
									<action type="control focus" value="#btnDonesi"/>
								</event>
							</button>
						</item>
						<item col="2" row="1"/>
					</group>
					<item col="1" row="5"/>
				</group>		
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDonesi" caption="&amp;DONESI">
					<event type="click">
						<action type="form open" value="frmUFERobnogDonos">
							<parameter name="PartneriId" value="#srcPartner"/>
							<parameter name="RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
						</action>
						<part name="prtRobnoKalkSum" path="prtUFERobnogKalk.xml"/>
						<action type="control disable" value="#btnEditDetalj,#btnEditDetaljSve,#btnUrednik,#btnZakljuci,#btnDeleteDetalj" if="#grdStavke.rowcount==0"/>
						<action type="control enable" value="#btnEditDetalj,#btnEditDetaljSve,#btnUrednik,#btnZakljuci,#btnDeleteDetalj" elseif="#grdStavke.rowcount!=0&amp;&amp;$Status!=2&amp;&amp;$Status!=S"/>						
					</event>
				</button>
				<button name="btnSpremi" caption="&amp;SPREMI" type="add" >
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="spremanje dokumenta..." sleep="2000">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtKalkGlaAzur"/>
						<!-- <action type="control populate keepfocus" value="parent.#grdGlava"/> -->
						<action type="form close"/>
					</event>			
				</button>		
				<button name="btnZakljuci" caption="&amp;ZAKLJUČI" >
					<event type="click">
						<action type="datarun nonquery" value="~dtKalkGlaAzur"/>
						<action type="datarun nonquery" value="dtZakljuci"/>
						<!-- <action type="control populate keepfocus" value="parent.#grdGlava"/> -->
						<action type="form close"/>
						<!-- </action> -->
					</event>
				</button>
				<button name="btnPrint" caption="IS&amp;PIŠI" dataname="global.~dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="control print" value="parent.#grdGlava" if="#grdStavke.rowcount&gt;0">
							<action type="print template" value="#btnPrint.@Template">
								<parameter name="id" value="$RobnoKalkGlaId" />
							</action>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>	
			<data name="dtGetPartneri" command="spCKntTemTraziPartneri">
				<parameter name="@Action" value="Partneri"/>
				<parameter name="@Uvjet" value="#srcPartner.text"/>
				<parameter name="@broj_lokacija" value="1"/>
			</data>			
			<data name="dtLokacija" command="spKatalogLokacije">
				<parameter name="@action" value="lokacije"/> 
				<parameter name="@partneriid" value="#srcPartner"/>
			</data>
			<data name="dtOrgShema" command="spJKatalogTree">
				<parameter name="@Action" value="orgshema"/>
			</data>
			<data name="dtOdgovornaOsoba" command="spOsobeQuery">
				<parameter name="@Action" value="16"/>
			</data>
			<data name="dtRobaDet" command="spCRobnoKalkDetQuery">
				<parameter name="@Action" value="2"/>
				<parameter name="@id" value="$RobnoKalkGlaId"/>
