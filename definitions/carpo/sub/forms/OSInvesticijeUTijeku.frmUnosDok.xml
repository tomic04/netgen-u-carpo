<root version="1.1">

  <!--1.1. MZ - dodala konto na unos/izmjena dokumenta-->

  <form name="frmUnosDok" caption="$Caption" fixedsize="false" width="450" saveformlayout="true">

    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSPrometITId!=0"/>
      <action type="datarun reader" value="~dtOSTraziIzvorniDok" />
    </event>
    <event type="onshown">
      <action type="variable value">
        <parameter name="IzvBroj" value="~dtGet.@IzvBroj" type="string" />
        <parameter name="BrojId" value="~dtGet.@BrojId" type="int"/>
      </action>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="10" spacing="2,2,2,2" >
        <item caption="Datum dokumenta:" col="1" row="1" highlight="false">
          <dateedit name="datDatumDok" value="now" datavalue="~dtGet.@DatumDok"/>
        </item>
        <item caption="Vrsta dokumenta:" col="1" row="2">
          <comboedit name="cmbVrstaDok"  valuefield="VrstaDokId" displayfield="OpisV" dataname="~dtVrstaDok"  datavalue="~dtGet.@VrstaDokId" datatext="~dtGet.@OpisV"/>
        </item>
        <item caption="Broj dokumenta:" col="1" row="3">
          <textedit name="txtBrojDok" datavalue="~dtGet.@BrojDok"  enabled="false" fontbold="true" nulltext="" textposition="left"/>
        </item>
        <item caption="Dobavljač:" col="1" row="4" >
          <searchedit name="srcPartneri" fieldvalue="PartneriId" fieldtext="NazivP" dataname="~dtPartneri" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@NazivP"/>
        </item>
        <item caption="Iznos:"  col="1" row="5" >
          <textedit name="txtNabavaDug" format="n2" value="0" datavalue="~dtGet.@NabavaDug" textposition="left"/>
        </item>
        <item caption="Opis:"  col="1" row="6" >
          <textedit name="txtOpis" datavalue="~dtGet.@Opis" textposition="left"/>
        </item>
        <item caption="Konto pripreme:" col="1" row="7" >
          <searchedit name="srcPriprema" fieldvalue="KntPripremeId" fieldtext="KontoP" dataname="dtPriprema" datavalue="~dtGet.@KntPripremeId" datatext="~dtGet.@KontoP"/>
        </item>
        <item caption="Vrsta izv.dokumenta:" col="1" row="8" >
          <comboedit name="cmbVrstaDokIzv"  valuefield="IzvVrstaPromId" displayfield="NazivIzv" dataname="~dtVrstaDokIzv" datavalue="~dtGet.@IzvVrstaPromId" datatext="~dtGet.@NazivIzv"/>
        </item>
        <group  col="1" row="9" cols="1" rows="1" if="~dtOSTraziIzvorniDok.@Postavka==0" groupbordervisible="false">
          <item caption="Broj izv.dokumenta:"  col="1" row="1" colspan="1">
            <textedit name="srcBrojIzv" datavalue="~dtGet.@IzvBroj" textposition="left"/>
          </item>
        </group>
        <group  col="1" row="9" cols="1" rows="1" else="" groupbordervisible="false">
          <item caption="Broj izv.dokumenta:"  col="1" row="1" colspan="1">
            <searchedit name="srcBrojIzv"  fieldvalue="BrojId" fieldtext="IzvBroj" dataname="~dtBrojIzv" datavalue="~dtGet.@BrojId" datatext="~dtGet.@IzvBroj">
              <event type="valuechanged">
                <action type="variable value" value="$BrojId">
                  <parameter value="#srcBrojIzv.@BrojId"/>
                </action>
                <action type="variable value" value="$IzvBroj">
                  <parameter value="#srcBrojIzv.@IzvBroj"/>
                </action>
              </event>
            </searchedit>
          </item>
        </group>
        <item caption="Napomena:"  col="1" row="10" >
          <textedit name="txtNapomena" datavalue="~dtGet.@Napomena" textposition="left"/>
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" >
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtEdit" if="$OSPrometITId!=0" >
              <action type="message" value="~dtEdit.@Poruka" />
            </action>
            <action type="datarun reader" value="~dtAdd" else="" >
              <action type="message" value="~dtAdd.@Poruka" />
            </action>
            <action type="form close" />
          </event>
        </button>
        <button caption="Izlaz" type="cancel" dock="right">
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaIT_HelpCP" name="dtVrstaDok">
        <parameter name="@Action" value="VrstaDok_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtPartneri">
        <parameter name="@Action" value="Dobavljac_src"/>
        <parameter name="@Tekst" value="#srcPartneri.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtPriprema">
        <parameter name="@Action" value="Konto_pripreme"/>
        <parameter name="@Tekst" value="#srcPriprema.text"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtVrstaDokIzv">
        <parameter name="@Action" value="IzvorniDok_cmb"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtBrojIzv">
        <parameter name="@Action" value="Broj_src"/>
        <parameter name="@Tekst" value="#srcBrojIzv.text"/>
        <parameter name="@VrstaPromId" value="#cmbVrstaDokIzv.@IzvVrstaPromId"/>
      </data>
      <!--pokupi pubvars-->
      <data command="spOSImovinaIT_HelpCP" name="dtOSTraziIzvorniDok">
        <parameter name="@Action" value="OSTraziIzvorniDok"/>
      </data>
      <data command="spOSImovinaIT_HelpCP" name="dtGet">
        <parameter name="@Action" value="Edit_dok"/>
        <parameter name="@OSPrometITId" value="$OSPrometITId"/>
      </data>
      <data command="spOSImovinaIT_AzurCP" name="dtAdd">
        <parameter name="@Action" value="Insert_dok"/>
        <parameter name="@OSPrometITId" value="0" type="int"/>
        <parameter name="@OSImovinaITId" value="$OSImovinaITId" />
        <parameter name="@DatumDok" value="#datDatumDok" />
        <parameter name="@VrstaDokId" value="#cmbVrstaDok" />
        <parameter name="@BrojDok" value="#txtBrojDok" />
        <parameter name="@PartneriId" value="#srcPartneri"/>
        <parameter name="@NabavaDug" value="#txtNabavaDug"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@KntPriprema" value="#srcPriprema"/>
        <parameter name="@IzvVrstaPromId" value="#cmbVrstaDokIzv"/>
        <parameter name="@IzvBroj" value="#srcBrojIzv.@IzvBroj"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
      <data command="spOSImovinaIT_AzurCP" name="dtEdit">
        <parameter name="@Action" value="Edit_dok"/>
        <parameter name="@OSPrometITId" value="$OSPrometITId"/>
        <parameter name="@DatumDok" value="#datDatumDok" />
        <parameter name="@VrstaDokId" value="#cmbVrstaDok" />
        <parameter name="@PartneriId" value="#srcPartneri"/>
        <parameter name="@NabavaDug" value="#txtNabavaDug" type="decimal"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@KntPriprema" value="#srcPriprema"/>
        <parameter name="@IzvVrstaPromId" value="#cmbVrstaDokIzv"/>
        <parameter name="@IzvBroj" value="#srcBrojIzv"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@OperateriId" value="@@OperateriId"/>
      </data>
    </datalist>
  </form>

</root>
