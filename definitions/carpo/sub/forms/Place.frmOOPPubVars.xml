<root>
  <form name="frmOOPPubVars" caption="$caption"  width="800" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtPubvars" />
    </event>

    <event type="load">
      <action type="control populate" value="#grdPubvars" >     </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdPubvars" key="OOPPubVarsId" dataname="~dtPubvars" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" autowidth="true">
            <fields inherited="true">
              <field name="Vrijednost" editable="true"></field>
            </fields>

            <event type="cellvaluechanged" >
              <action type="datarun nonquery" value="dtSpremiParametar"/>
            </event>
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="IZLAZ" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlacePubvars" name="dtPubvars">
        <parameter name="@Action" value="grdPubvars"/>
      </data>
      <data command="spPlacePubvars" name="dtSpremiParametar">
        <parameter name="@Action" value="izmjena"/>
        <parameter name="@OOPPubvarsId" value="#grdPubvars.@OOPPubvarsId" type="int"/>
        <parameter name="@vrijednost" value="#grdPubvars.@Vrijednost" type="string"/>
      </data>
    </datalist>
  </form>


</root>