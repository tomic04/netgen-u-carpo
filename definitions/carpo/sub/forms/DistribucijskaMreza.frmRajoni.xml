<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmRajoni" caption="Rajoni" width="600" height="800">
		<layout>
			<group cols="2" rows="2">
			        <columnsdefinition>
                        <column size="90%" position="1" />
                        <column size="10%" position="2" />
					</columnsdefinition>
				<group col="1" row="1" cols="1" rows="2" groupbordervisible="false">
					<item col="1" row="1">
						<labeledit name="lblRajon" value="Rajoni">
						</labeledit>
					</item>
					<item col="1" row="2">
						<grid name="grdRajon" autopopulate="true" dataname="dtRajoniQuery" >
							<event type="focusedrowchanged">
								<action type="control populate" value="#grdLokacije" />
							</event>
						</grid>
					</item>
				</group>
				<group col="2" row="1" cols="1" rows="7" groupbordervisible="false">
					<item col="1" row="2">
						<button name="btnDodaj" caption="Dodaj">
							<event type="click">
								<action type="form open" value="frmRajoniUnos">
								</action>
							</event>
						</button>
					</item>
					<item col="1" row="3">
						<button name="btnIzmjeni" caption="Izmjeni">
							<event type="click">						
								<action type="form open" value="frmRajoniIzmjeni">
									<parameter name="Id" value="#grdRajon.@RajonId"/>
								</action>
							</event>							
						</button>
					</item>
					<item col="1" row="4">
						<button name="grdObrisi" caption="Obriši">
							<event type="click">
								<action type="confirm" value="Želite li obrisati stavku?">
									<action type="datarun nonquery" value="~dtRajoniDelete">
										<action type="control populate" value="#grdRajon" />
								 </action>
								</action>
							</event>							
						</button>
					</item>	
					<item col="1" row="5">
					</item>	
					<item col="1" row="6">
					</item>
					<item col="1" row="7">
					</item>							
				</group>								
				<group col="1" row="2" cols="1" rows="2" groupbordervisible="false">
					<item col="1" row="1">
						<labeledit name="lblLokacije" value="Lokacije">
						</labeledit>
					</item>				
					<item col="1" row="2">
						<grid name="grdLokacije">
							<data command="spParStruQuery" name="dtParStruQuery">
								<parameter name="@Action" value="3" />     
								<parameter name="@Id" value="#grdRajon.@RajonId" />     
							</data>
						</grid>
					</item>
				</group>
				<group col="2" row="2" cols="1" rows="7" groupbordervisible="false">
					<item col="1" row="2">
						<button name="btnDodaj" caption="Dodaj">
						</button>
					</item>
					<item col="1" row="3">
						<button name="btnIzmjeni" caption="Izmjeni">
						</button>
					</item>
					<item col="1" row="4">
						<button name="btnObrisi" caption="Obriši">							
						</button>
					</item>	
					<item col="1" row="5">
					</item>	
					<item col="1" row="6">
					</item> 
					<item col="1" row="7">
					</item>							
				</group>				
				
			</group>
		</layout>
		<datalist>
			<data command="spRajoniQuery" name="dtRajoniQuery">
				<parameter name="Action" value="0"/>
			</data>
			<data command="spTrazipartneri" name="dtPartneri">			
			</data>
            <data command="spRajoniDelete" name="dtRajoniDelete">
				<parameter name="@Id" value="#grdRajon.@RajonId" />                				
            </data>				
		</datalist>
	</form>
</root>