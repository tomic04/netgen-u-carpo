<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmTransportniNaloziFakturiranje" caption="Fakturiranje" width="400" height="300">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<layout >
			<group cols="1" rows="3">
					<item col="1" row="1" caption="Vrsta fakture:" >
						<comboedit name="txtVrstaFakture" valuefield="vrstaDokId" displayfield="Opis" dataname="dtVrstaFak" datavalue="#dtGet.@VrstaDokId" datatext="#dtGet.@NazivDok">

						</comboedit>
					</item>
					<item col="1" row="2" caption="Pertner:" >
						<searchedit type="partner" name="partner" fieldtext="Naziv" fieldvalue="PartneriId"  fontbold="true" required="true" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@NazivPartnera">
						</searchedit>	
					</item>
					<item col="1" row="3" caption="Datum fakture:">
						<dateedit name="datFakture" value="now" >
						</dateedit>
					</item>						
				</group> 
		</layout>
		<panelbuttons>
			<buttons>
				<button name="Spremi" caption="Spremi" type="add" dock="left">
					<event type="click">
						<action type="datarun nonquery" value="~dtMinMaxZaliheUpdateMulti"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="Odustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>		
			</buttons>
		</panelbuttons>
		<datalist>
 			<data command="select vrstaDokId,Opis from vrstaDok where vrstaPromId=2" type="text" name="dtVrstaFak">
			</data> 
			<data command="spProd_PopuniPoljaZaOperatera" name="dtGet">
				<parameter name="@tablica" value="fakture"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>			
		</datalist>
	</form>
</root>