<root>
	<!--
  Komentari:
  4.11.2025. MP - PERMISSION -> FUNCTION NAME
  08.02.2024. MP - izmijenio setiranje nadređene osobe kod unosa
  29.4.2022. JVV dodala opcije ispisa Word ili Repx ugovora
  03.03.2022. JVV dorade za tekuće rano mjesto
  08.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmRadnoMjesto" caption="Radno mjesto za {parent.#txtPrezime} {parent.#txtIme}" width="960" height="340" >
<method name="openWordTemplate" dll="PrintWordtemplate" class="WordTemplate.WordTemplate" method="OpenWordTemplate"/>
		<event type="load">
			<action type="control populate" value="#grdRadnoMjesto"/>		
			<action type="control disable" value="#btnIzmjena,btnBrisanje" if="#grdRadnoMjesto.rowcount==0"/>

		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<group cols="1" rows="1" groupbordervisible="true" col="1" row="1" spacing="2,2,2,1">
					<item row="1" col="1" highlight="false">
						<grid name="grdRadnoMjesto" key="HRKadroviRadnaMjestaId"  dataname="~dtRadnoMjesto" multiselect="true" savelayout="true" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false">
							<fields inherited="true">
							</fields>
							<event type="doubleclick">
								<action type="form open" value="frmUnosIzmjenaRadnoMjesto">  	
									<parameter name="Caption" value="Izmjena radnog mjesta za {parent.#txtPrezime} {parent.#txtIme}"/>								
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviRadnaMjestaId" value="#grdRadnoMjesto.@HRKadroviRadnaMjestaId" />		
								</action>  
								<action type="control populate keepfocus" value="#grdRadnoMjesto"/>	
								<action type="control populate" value="parent.#grdPodaci"/>									
							</event>
						</grid>
					</item>
				</group>
				<group cols="8" rows="1" groupbordervisible="true" col="1" row="2" spacing="2,2,1,2">
					<item row="1" col="1" highlight="false" height="40">
						<button name="btnUnos" caption="Unos" function="UNOS_RM"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaRadnoMjesto"> 
									<parameter name="Caption" value="Unos radnog mjesta za {parent.#txtPrezime} {parent.#txtIme}"/>	
									<parameter name="HRKadroviRadnaMjestaId" value="0"/>   
									<parameter name="HRKadroviId" value="$HRKadroviId" />	
									<parameter name="Tip" value="unos"/>
								</action>  
								<action type="control populate keepfocus" value="#grdRadnoMjesto"/>	
								<action type="control populate" value="parent.#grdPodaci"/>									
							</event>  
						</button>
					</item>
					<item row="1" col="2" highlight="false" height="40" >
						<button name="btnIzmjena" caption="Izmjena" function="IZMJENA_RM"> 
							<event type="click">   
								<action type="form open" value="frmUnosIzmjenaRadnoMjesto">  	
									<parameter name="Caption" value="Izmjena radnog mjesta za {parent.#txtPrezime} {parent.#txtIme}"/>								
									<parameter name="Tip" value="Izmjena"/>
									<parameter name="HRKadroviId" value="$HRKadroviId" />
									<parameter name="HRKadroviRadnaMjestaId" value="#grdRadnoMjesto.@HRKadroviRadnaMjestaId" />		
								</action>  
								<action type="control populate keepfocus" value="#grdRadnoMjesto"/>		
								<action type="control populate" value="parent.#grdPodaci"/>									
							</event>  
						</button>
					</item>
					<item row="1" col="3" highlight="false" height="40">
						<button name="btnBrisanje" caption="Brisanje" function="BRISANJE_RM"> 
							<event type="click">   
								<action type="confirm" value="Jeste li sigurni da želite obrisati izabrani zapis?">
									<action type="datarun nonquery" value="~dtBrisanjeRadnoMjesto">

									</action>
								</action>
								<action type="control populate" value="#grdRadnoMjesto,parent.#grdPodaci"></action>    
								<action type="control disable" value="#btnIzmjena,btnBrisanje" if="#grdRadnoMjesto.rowcount==0"/>
							</event>  
						</button>
					</item>
					<item row="1" col="4"  highlight="false" height="40"/>
					<item row="1" col="5" highlight="false" height="40">
					<button name="btnIspisUgovora" caption="Ispis ugovora" begingroup="true"> 
					  <event type="click">  
					  <action if="#grdRadnoMjesto.@VrstaIspis==repx">
					  <action type="print" value="#grdRadnoMjesto.@TemplateId">
					  <parameter name="HRKadroviRadnaMjestaId" value="#grdRadnoMjesto.@HRKadroviRadnaMjestaId"></parameter> 
					  </action> 
					  </action>
					  <action if="#grdRadnoMjesto.@VrstaIspis==word">
					  <action type="method run" value="openWordTemplate">  
						<parameter name="connectionString" value="#grdRadnoMjesto.@KonekcijaId" type="string"/>    
						<parameter name="stringIds" value="#grdRadnoMjesto.@HRKadroviRadnaMjestaId" type="string"/>    
						<parameter name="path" value="#grdRadnoMjesto.@TemplateId" type="string"/> 
						</action> 
					  </action>
					  </event> 
					  </button>
					</item>
					<item row="1" col="6" colspan="2" highlight="false" height="40"/>
					<item row="1" col="8" highlight="false" height="40">
						<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
							<event type="click">
								<action type="form close" />
							</event>
						</button>
					</item>
				</group>
			</group>

		</layout>
		<datalist>
			<data command="spHRManagerMaster_Podaci_RadnoMjesto_CP" name="dtRadnoMjesto">
				<parameter name="@action" value="grid_RadnaMjesta" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_RadnoMjesto_CP" name="dtBrisanjeRadnoMjesto">
				<parameter name="@action" value="brisanje"/>
				<parameter name="@HRKadroviRadnaMjestaId" value="#grdRadnoMjesto.@HRKadroviRadnaMjestaId"/>
			</data>
		</datalist>
	</form>

	<!-- FORMA ZA UNOS,IZMJENU -->
	<form name="frmUnosIzmjenaRadnoMjesto" caption="$Caption" width="1070" height="450" fixedsize="true">
		<event type="init">
			<action  type="datarun reader" value="~dtGetRadnoMjesto" if="$HRKadroviRadnaMjestaId!=0"/>
			<action  type="datarun reader" value="~dtGetZadnjiUgovor" if="$Tip=='unos'"/>
			<action  type="datarun reader" value="~dtGetTekuceRM" />
		</event>

		
		
		<event type="shown">
	

				
				<action type="control visible" value="#chckTekuceRadnoMjesto" if="~dtGetTekuceRM.@TekuceRM!=0">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#chckTekuceRadnoMjesto" else="">
				<parameter value="false"/>
			</action>
			<action if="$Tip=='unos'&amp;&amp;parent.#grdRadnoMjesto.rowcount!=0">
			
		

				<action type="control disable" value="#dtRazdobljeDo" if="~dtGetZadnjiUgovor.@DatumDo==null"></action>
				<action type="control disable" value="#dtDatumUgovora" if="~dtGetZadnjiUgovor.@ugovordatumod==null"></action>
				<action type="control disable" value="#dtDatumPotpisa" if="~dtGetZadnjiUgovor.@DatumPotpisa==null"></action>
				
				<action type="control disable" value="#dtDoDatuma" if="~dtGetZadnjiUgovor.@PokusniRadDatumDo==null"></action>
				<action type="control disable" value="#dtDoDatuma1" if="~dtGetZadnjiUgovor.@PripravnikDatumDo==null"></action>	
				
				<action if="~dtGetZadnjiUgovor.@PokusniRadDatumDo==null">
					<action type="control value" value="#dtDoDatuma" >
						<parameter value="now" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#dtDoDatuma" >
						<parameter  value="~dtGetZadnjiUgovor.@PokusniRadDatumDo" />
					</action>
				</action>
				
				<action if="~dtGetZadnjiUgovor.@PripravnikDatumDo==null">
					<action type="control value" value="#dtDoDatuma1" >
						<parameter value="now" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#dtDoDatuma1" >
						<parameter  value="~dtGetZadnjiUgovor.@PripravnikDatumDo" />
					</action>
				</action>
				
				<action if="~dtGetZadnjiUgovor.@ZabranaMje==null">
					<action type="control value" value="#txtMjeseciZ" >
						<parameter value="0" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#txtMjeseciZ" >
						<parameter  value="~dtGetZadnjiUgovor.@ZabranaMje" />
					</action>
				</action>
				
				<action if="~dtGetZadnjiUgovor.@DatumDo==null">
					<action type="control value" value="#dtRazdobljeDo" >
						<parameter value="now" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#dtRazdobljeDo" >
						<parameter  value="~dtGetZadnjiUgovor.@DatumDo" />
					</action>
				</action>
				<action if="~dtGetZadnjiUgovor.@ugovordatumod==null">
					<action type="control value" value="#dtDatumUgovora" >
						<parameter value="now" />
					</action>
				</action>
				<action else="">
					<action type="control value" value="#dtDatumUgovora" >
						<parameter  value="~dtGetZadnjiUgovor.@ugovordatumod" />
					</action>
				</action>
				<action if="~dtGetZadnjiUgovor.@DatumPotpisa==null">
					<action type="control value" value="#dtDatumPotpisa" >
						<parameter value="now" />
					</action>
				</action>	
				<action else="">
					<action type="control value" value="#dtDatumPotpisa" >
						<parameter  value="~dtGetZadnjiUgovor.@DatumPotpisa" />
					</action>
				</action>				

				<action type="control value" value="#srcOrgJedinica">
					<parameter text="~dtGetZadnjiUgovor.@OrgShema" value="~dtGetZadnjiUgovor.@OrgShemaId" />
				</action>
				<action type="control value" value="#srcRadnoMjesto">
					<parameter text="~dtGetZadnjiUgovor.@RadnoMjesto" value="~dtGetZadnjiUgovor.@HRRadnaMjestaId" />
				</action>
				<action type="control value" value="#srcPoreznaOpcina">
					<parameter text="~dtGetZadnjiUgovor.@Mjesto" value="~dtGetZadnjiUgovor.@MjestaId" />
				</action>
				<action type="control value" value="#srcNadredjenaOsoba">
					<parameter text="~dtGetZadnjiUgovor.@NadredjenaOsoba" value="~dtGetZadnjiUgovor.@hrkadroviIdNadOsoba" />
				</action>
				<action type="control value" value="#srcZamjenskaOsoba">
					<parameter text="~dtGetZadnjiUgovor.@ZamjenskaOsoba" value="~dtGetZadnjiUgovor.@hrkadroviIdZamOsoba" />
				</action>
				<action type="control value" value="#dtRazdobljeOd">
					<parameter value="~dtGetZadnjiUgovor.@DatumOd" />
				</action>
				<action type="control value" value="#cmbVrstaUgovora">
					<parameter  value="~dtGetZadnjiUgovor.@HRDokumentiId" />
				</action>
				<action type="control value" value="#txtBrojUgovora">
					<parameter  value="~dtGetZadnjiUgovor.@UgovorBroj" />
				</action>
				<action type="control value" value="#cmbVrstaRO">
					<parameter  value="~dtGetZadnjiUgovor.@HRVrsteROId" />
				</action>
				<action type="control value" value="#cmbVrstaRV">
					<parameter  value="~dtGetZadnjiUgovor.@HRVrsteRVId" />
				</action>
				<action type="control value" value="#cmbSprema">
					<parameter  value="~dtGetZadnjiUgovor.@HRSpremePriznataId" />
				</action>
				<action type="control value" value="#txtDnevniBrSati">
					<parameter  value="~dtGetZadnjiUgovor.@DnevniBrojSati" />
				</action>
				<action type="control value" value="#txtTjedniBrSati">
					<parameter  value="~dtGetZadnjiUgovor.@TjedniBrojSati" />
				</action>
				<action type="control value" value="#txtBrojRadnihDana">
					<parameter  value="~dtGetZadnjiUgovor.@BrojRadnihDana" />
				</action>
				<action type="control value" value="#txtNapomena">
					<parameter  value="~dtGetZadnjiUgovor.@Napomena" />
				</action>
				<action type="control value" value="#txtOsnovica">
					<parameter  value="~dtGetZadnjiUgovor.@Osnovica" />
				</action>
				<action type="control value" value="#txtVarijabilniDio">
					<parameter  value="~dtGetZadnjiUgovor.@DodOsnovica" />
				</action>
				<action type="control value" value="#txtVrstaOsnovica">
					<parameter  value="~dtGetZadnjiUgovor.@VrstaOsnovice" />
				</action>
				<action type="control value" value="#chckTekuceRadnoMjesto">
					<parameter  value="~dtGetZadnjiUgovor.@tekuceradnomjesto" />
				</action>
			</action>
		
		
			<action if="$Tip=='Izmjena'">
				<action type="control disable" value="#dtRazdobljeDo" if="~dtGetRadnoMjesto.@DatumDo==null"></action>
				<action type="control disable" value="#dtDatumUgovora" if="~dtGetRadnoMjesto.@ugovordatumod==null"></action>
				<action type="control disable" value="#dtDatumPotpisa" if="~dtGetRadnoMjesto.@DatumPotpisa==null"></action>		
				<action type="control disable" value="#dtDoDatuma" if="~dtGetRadnoMjesto.@PokusniRadDatumDo==null"></action>
				<action type="control disable" value="#dtDoDatuma1" if="~dtGetRadnoMjesto.@PripravnikDatumDo==null"></action>	
				
				<action if="~dtGetRadnoMjesto.@PokusniRadDatumDo==null">
					<action type="control value" value="#dtDoDatuma" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetRadnoMjesto.@PripravnikDatumDo==null">
					<action type="control value" value="#dtDoDatuma1" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetRadnoMjesto.@ZabranaMje==null">
					<action type="control value" value="#txtMjeseciZ" >
						<parameter value="0" />
					</action>
				</action>
				<action if="~dtGetRadnoMjesto.@DatumDo==null">
					<action type="control value" value="#dtRazdobljeDo" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetRadnoMjesto.@ugovordatumod==null">
					<action type="control value" value="#dtDatumUgovora" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtGetRadnoMjesto.@DatumPotpisa==null">
					<action type="control value" value="#dtDatumPotpisa" >
						<parameter value="now" />
					</action>
				</action>			

				<action type="control value" value="#srcOrgJedinica">
					<parameter text="~dtGetRadnoMjesto.@OrgShema" value="~dtGetRadnoMjesto.@OrgShemaId" />
				</action>
				<action type="control value" value="#srcRadnoMjesto">
					<parameter text="~dtGetRadnoMjesto.@RadnoMjesto" value="~dtGetRadnoMjesto.@HRRadnaMjestaId" />
				</action>
				<action type="control value" value="#srcPoreznaOpcina">
					<parameter text="~dtGetRadnoMjesto.@Mjesto" value="~dtGetRadnoMjesto.@MjestaId" />
				</action>
				<action type="control value" value="#srcNadredjenaOsoba">
					<parameter text="~dtGetRadnoMjesto.@NadredjenaOsoba" value="~dtGetRadnoMjesto.@hrkadroviIdNadOsoba" />
				</action>
				<action type="control value" value="#srcZamjenskaOsoba">
					<parameter text="~dtGetRadnoMjesto.@ZamjenskaOsoba" value="~dtGetRadnoMjesto.@hrkadroviIdZamOsoba" />
				</action>
			</action>
		</event>
		<layout>
			<group cols="2" rows="1" groupbordervisible="false">
				<group cols="3" rows="8" col="1" row="1" groupbordervisible="true" spacing="2,1,2,2">
					<columnsdefinition>
						<column  position="1" size="170" /> 
						<column  position="2" size="170" /> 
						<column  position="3" size="170" /> 
					</columnsdefinition>
					<item row="1" col="1" caption="Organizacijska jedinica:" colspan="3" highlight="false">
						<searchedit name="srcOrgJedinica" required="true" dataname="~dtOrgShema" fieldtext="naziv" fieldvalue="orgshemaid" />
					</item>
					<item row="2" col="1" caption="Radno mjesto:" colspan="3" highlight="false">
						<searchedit name="srcRadnoMjesto" required="true" dataname="~dtRadnoMjestoDjelatnika" fieldtext="naziv" fieldvalue="hrradnamjestaid" />
					</item>
					<item row="3" col="1" caption="Porezna općina mjesta rada (za JOPPD obrazac):" colspan="3" highlight="false">
						<searchedit name="srcPoreznaOpcina" dataname="~dtPoreznaOpcina" fieldtext="naziv" fieldvalue="id" />
					</item>
					<item row="4" col="1" caption="Razdoblje od:" highlight="false">
						<dateedit name="dtRazdobljeOd" value="now" datavalue="~dtGetRadnoMjesto.@DatumOd">
						</dateedit>
					</item>
					<item row="4" col="2" caption="Razdoblje do:"  highlight="false">
						<dateedit name="dtRazdobljeDo" value="now" allownull="true" datavalue="~dtGetRadnoMjesto.@DatumDo">
						</dateedit>
					</item>
					<item row="4" col="3" caption="Vrsta ugovora:" highlight="false" >
						<comboedit name="cmbVrstaUgovora" required="true" valuefield="hrdokumentiid" displayfield="naziv"  dataname="~dtHRDokument" datavalue="~dtGetRadnoMjesto.@HRDokumentiId"/>
					</item>
					<item row="5" col="1" caption="Broj ugovora:" highlight="false">
						<textedit name="txtBrojUgovora" datavalue="~dtGetRadnoMjesto.@UgovorBroj"/>
					</item>
					<item row="5" col="2" caption="Datum ugovora:" highlight="false" >
						<dateedit name="dtDatumUgovora" value="now" allownull="true" datavalue="~dtGetRadnoMjesto.@ugovordatumod">
						</dateedit>
					</item>
					<item row="5" col="3" caption="Datum potpisa:" highlight="false" >
						<dateedit name="dtDatumPotpisa" value="now" allownull="true" datavalue="~dtGetRadnoMjesto.@DatumPotpisa">
						</dateedit>
					</item>
					<item row="6" col="1" caption="Vrsta radnog odnosa:" highlight="false" >
						<comboedit name="cmbVrstaRO"  valuefield="HRVrsteROId" displayfield="Naziv"  dataname="~dtHRVrsteRO" datavalue="~dtGetRadnoMjesto.@HRVrsteROId"/>
					</item>
					<item row="6" col="2" caption="Vrsta radnog vremena:" highlight="false" >
						<comboedit name="cmbVrstaRV"  valuefield="HRVrsteRVId" displayfield="Naziv"  dataname="~dtHRVrsteRV" datavalue="~dtGetRadnoMjesto.@HRVrsteRVId"/>
					</item>
					<item row="6" col="3" caption="Sprema:" highlight="false" >
						<comboedit name="cmbSprema"  valuefield="hrspremeid" displayfield="Naziv"  dataname="~dtHRSpreme" datavalue="~dtGetRadnoMjesto.@HRSpremePriznataId"/>
					</item>

					<item row="7" col="1" caption="Dnevni broj sati:" highlight="false" >
						<textedit name="txtDnevniBrSati" format="n2" value="0" datavalue="~dtGetRadnoMjesto.@DnevniBrojSati"/>
					</item>
					<item row="7" col="2" caption="Tjedni broj sati:" highlight="false" >
						<textedit name="txtTjedniBrSati" format="n0" value="0" datavalue="~dtGetRadnoMjesto.@TjedniBrojSati"/>
					</item>
					<item row="7" col="3" caption="Broj radnih dana:" highlight="false" >
						<textedit name="txtBrojRadnihDana" format="n0" value="0" datavalue="~dtGetRadnoMjesto.@BrojRadnihDana"/>
					</item>
					<!-- <item row="8" col="1" caption=" " highlight="false" colspan="3"> -->
					
					<!-- </item> -->
				</group>
				<group cols="3" rows="8" col="2" row="1" groupbordervisible="true" spacing="1,2,2,2">
					<columnsdefinition>
						<column  position="1" size="170" /> 
						<column  position="2" size="170" /> 
						<column  position="3" size="170" /> 
					</columnsdefinition>
					<item row="1" col="1" caption="Osnovica:" highlight="false" >
						<textedit name="txtOsnovica" format="n3" value="0" datavalue="~dtGetRadnoMjesto.@Osnovica"/>
					</item>
					<item row="1" col="2" caption="Varijabilni dio:" highlight="false" >
						<textedit name="txtVarijabilniDio" format="n2" value="0" datavalue="~dtGetRadnoMjesto.@DodOsnovica"/>
					</item>
					<item row="1" col="3" caption="Vrsta osnovice:" highlight="false" >
						<textedit name="txtVrstaOsnovica"  datavalue="~dtGetRadnoMjesto.@VrstaOsnovice"/>
					</item>
					<item row="2" col="1" caption="Probni rad do datuma:" highlight="false" >
						<dateedit name="dtDoDatuma" value="now" allownull="true" datavalue="~dtGetRadnoMjesto.@PokusniRadDatumDo">
						</dateedit>
					</item>
					<item row="2" col="2" caption="Pripravnik do datuma:" highlight="false" >
						<dateedit name="dtDoDatuma1" value="now" allownull="true" datavalue="~dtGetRadnoMjesto.@PripravnikDatumDo">
						</dateedit>
					</item>
					<item row="2" col="3" caption="Mjeseci:" highlight="false" >
						<textedit name="txtMjeseciZ" format="(0[0-9]|1[0-2])" formattype="regex" value="0" datavalue="~dtGetRadnoMjesto.@ZabranaMje"/>
					</item>
