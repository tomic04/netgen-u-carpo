<root version="1.0">
  <!--
  *******************************************************************************************
  FORMA ZA IZMJENU BROJAČA
  *******************************************************************************************
  -->
  <form name="frmPomakniBrojac" caption ="Ažuriranje broja naloga" width="500" height="100" fixedsize="true" saveformsize="false" >	  	  
	  <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Upišite za koliko želite pomaknuti brojač naloga: {parent.#grdMaster.@Broj naloga} - {parent.#grdMaster.@Djelatnik}?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="10" rows="2" groupbordervisible="false" >
        <item col="1" row="1"  highlight="false" colspan="10">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>
		<item col="1" row="2" caption="Pomakni za:" highlight="false">
			<textedit name="txtPomakniZa" format="n0" required="true" />
		</item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnPomakni" caption="Promijeni" >
          <event type="click">
            <!-- Okini storu -->

            <action type="validate" />
            <action type="datarun reader" value="~dtPomakni"/>
			
			<action if="$indGreske==0">
				<action type="message" value="$poruka"/>
				<action type="control populate keepfocus" value="parent.#grdMaster"/>
				<action type="form close"/>
			</action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPNAzur" name="dtPomakni">
        <parameter name="@Action" value="pomakni_brojac"/>
		<parameter name="@pnnaloziid" value="$PNNaloziId"></parameter>
		<parameter name="@pomakniza" value="#txtPomakniZa"></parameter>
		<parameter name="@operateriid" value="@@operateriid"></parameter>
        <parameter name="@indGreske.output.int"></parameter>
        <parameter name="@poruka.output.string"></parameter>
      </data>
    </datalist>
  </form>



</root>