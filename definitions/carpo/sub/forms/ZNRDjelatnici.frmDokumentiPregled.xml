<root>
  <form name="frmDokumentiPregled" caption="$caption" width="500" height="500" >
    <method name="funDmsOpen" dll="DmsManagerV1" class="DmsManagerV1.Start" method="OpenDocument" />
    <method name="funDmsSave" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocuments" />
    <layout>
      <group cols="1" rows="1" groupbordervisible="true" spacing="2,2,2,2">
        <item  col="1" row="1"  highlight="false" textposition="left">
          <grid name="grdDms" keyfield="DokId" multiselect="true" dataname="dtDms" showmenuprintitem="false" showmenutools="false" fieldsmartspaces="false" bestfitonrefresh="true" autopopulate="true" showgrouppanel="false" showautofilterrow="false">
            <menu>
              <menuitem caption="Spremi na disk" >
                <event type="click">
                  <action type="method run" value="funDmsSave">
                    <parameter name="server" value="@@server" />
                    <parameter name="database" value="@@database" />
                    <parameter name="username" value="" />
                    <parameter name="password" value="" />
                    <parameter name="operaterid" value="@@operateriid" />
                    <parameter name="dokIds" value="#grdDms.selectedids" />
                  </action>
                </event>
              </menuitem>
              <menuitem caption="Obriši" function="dmsobrisi">
                <event type="click">
                  <action type="confirm" value="Da li ste sigurni da želite obrisati označeni(e) dokument(e)?">
                    <action type="datarun nonquery"   value="~dtDeleteDoc"/>
                    <action type="control populate" value="#grdDms"/>
                  </action>
                </event>
              </menuitem>
            </menu>
            <event type="doubleclick">
              <action type="method run" value="funDmsOpen" >
                <parameter name="server" value="@@server" />
                <parameter name="database" value="@@database" />
                <parameter name="username" value="" />
                <parameter name="password" value="" />
                <parameter name="operaterid" value="@@operateriid" />
                <parameter name="dokId" value="#grdDms.@DokID" />
                <parameter name="name" value="#grdDms.@Naziv" />
              </action>
            </event>
            <fields inherited="true">
              <field name="Naziv" caption="Naziv dokumenta" />
              <field name="Velicina" caption="Veličina [KB]" />
            </fields>
          </grid>
        </item>
      </group>
    </layout>
    <datalist>
      <data command="spZNRCarpoDMSQuery" name="dtDms">
        <parameter name="@EntityName" value="$EntityName" />
        <parameter name="@HRKadroviId" value="$HRKadroviId" />
      </data>
      <data command="spCarpoDMSAzur" name="dtDeleteDoc">
        <parameter name="@Action" value="Delete"/>
        <parameter name="@EntityName" value="$EntityName"/>
        <parameter name="@selectedids" value="#grdDms.selectedids"/>
      </data>
    </datalist>
  </form>

</root>
