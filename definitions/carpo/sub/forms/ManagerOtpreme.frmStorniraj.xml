<root>
    <form name="frmStorniraj" caption="Storniranje" fixedsize="false">
        <event type="shown">
            <action type="control value" value="#cmbVrstaDok">
                <parameter value="parent.#grdGlava.@vrstadokid"  />
            </action>
            <action type="control value" value="#cmbOsobe">
                <parameter value="parent.#grdGlava.@osobeid"  />
            </action>
        </event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group rows="3" cols="1" row="1" col="1" entermovenextcontrol="true">
                    <item caption="Datum:" row="1" col="1">
                        <dateedit name="datDatumdok" value="now" required="true"/>
                    </item>
                    <item caption="Vrsta dokumenta:" row="2" col="1">
                        <comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" dataname="Global.dtVrstaDokNotp" required="true"/>
                    </item>
					<item caption="Odg. osoba:" row="3" col="1">
						<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Osoba" dataname="Global.dtOdgovornaOsoba" required="true"/>
					</item>	
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="STORNIRAJ" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="confirm" value="Jeste li sigurni da želite stornirati dokument?">
                            <action type="datarun nonquery" value="~dtStorniraj"/>
							                <action type="control populate keepfocus" value="parent.#grdGlava" />
                            <action type="form close" />
                        </action>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_NotpGla_Storniraj" name="dtStorniraj">
                <parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
                <parameter name="@vrstadokid" value="#cmbVrstaDok" />
                <parameter name="@OperateriId" value="@@OperateriId" />
                <parameter name="@DatumDok" value="#datDatumdok" />
                <parameter name="@OsobeId" value="#cmbOsobe" />
            </data>
        </datalist>
    </form>
</root>