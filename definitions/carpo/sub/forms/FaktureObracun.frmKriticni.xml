<root>
    <form name="frmKriticni" caption="Naknada za kritične poslove" width="" height="" fixedsize="">
		<event type="onclose">
			<action type="control populate" value="parent.#grdGlava" /> 			
		</event>		
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="true">
                <group rows="1" cols="1" row="1" col="1" entermovenextcontrol="true" groupbordervisible="False">                    
					<item caption="Postotak:" row="1" col="1">
                        <textedit name="txtPostotak" datavalue="" required="true" format="N2">
                        </textedit>
                    </item>                  				
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="AŽURIRAJ" type="" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtKriticni"/>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spFaktureObracun_Kriticni" name="dtKriticni">
                <parameter name="@partneriid" value="$FPartneriId" />
				<parameter name="@FaktureObracunDetId" value="$FaktureObracunDetId" />
                <parameter name="@postotak" value="#txtPostotak" />
                <parameter name="@operateriid" value="@@operateriid" />
            </data>
        </datalist>
    </form>
</root>