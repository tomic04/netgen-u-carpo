<!-- *****Layout forma***** -->
<root version="1.0">


  <form name="frmLayout" type="master" caption="Kartica"  width="1205" height="500" saveformlayout="true">

    <!--<event type="init">
      <action type="datarun reader" value="~dtGet" if="$SitKarticaId!=null" />
    </event>-->
    <event type="oninit">
      <action type="datarun reader" value="~dtDatumi" />
    </event>


    <layout textposition="left">

      <group  backgroundcolor="grey"  bordervisible="false" caption="Grupa" rows="2" cols="1">
        <itemdefault highlight="False" />
        <group cols="4" rows="1" col="1" row="1" height="50" spacing="2,2,2,1" >
          <columnsdefinition>
            <column position="1" size="250"/>
            <column position="2" size="250"/>
            <column position="3" size="130"/>
          </columnsdefinition>
          <item caption="Datum od:" col="1" row="1" highlight="false"  rowspan="2">
            <dateedit name="txtDatumOd" datavalue="~dtDatumi.@DatumOd" formattype="datetime" format="dd.MM.yyyy" />
          </item>
          <item caption="Datum do:" col="2" row="1" highlight="false">
            <dateedit name="txtDatumDo" datavalue="~dtDatumi.@DatumDo" formattype="datetime" format="dd.MM.yyyy"  />
          </item>
          <item col="3" row="1" >
            <button name="btnIzvrsi" caption="Izvrši" >
              <event type="click">
                <action type="control populate" value="#grdKartica"/>
              </event>
            </button>
          </item>
        </group>

        <group cols="1" rows="2" col="1" row="2" height="200" spacing="2,2,1,2" >
          <rowsdefinition>
            <row position="1" size="100%"/>
            <row position="2" size="40"/>
          </rowsdefinition>
          <item row="1" col="1" >
            <grid name="grdKartica" autopopulate="false" dataname="dtKartica" showfooter="false" showgrouppanel="false"  multiselect="true" showautofilterrow="false" bestfitonrefresh="true">
              <fields>
                <field caption="Naziv" name="Naziv" fixed="true"></field>
                <field caption="Šifra" name="Sifra" fixed="true"></field>
                <field caption="JM"  name="JM"></field>
                <field caption="Datum dokumenta"  name="Datum"></field>
                <field caption="Vrsta dokumenta" name="Vrsta Dokumenta"></field>
                <field caption="Dokument" name="Dokument"></field>
                <field caption="Dodatak nazivu" name="Dodatak nazivu" ></field>
                <field caption="Opis dokumenta" name="Opis dokumenta"></field>
                <field caption="Cijena" name="Cijena"></field>
                <field caption="Ulaz" name="Ulaz"></field>
                <field caption="Izlaz" name="Izlaz"></field>
                <field caption="Kumulativno stanje" name="Kumulativno stanje"></field>
                <field caption="Vrijednost ulaz" name="Vrijednost Ulaz"></field>
                <field caption="Vrijednost izlaz" name="Vrijednost Izlaz"></field>
                <field caption="Vrijednost" name="Vrijednost"></field>
                <field caption="Osoba" name="Osoba"></field>
                <field caption="Org. jedinica" name="Org.jed."></field>
                <field caption="Smještaj" name="Smjestaj" ></field>
              </fields>
            </grid>
          </item>
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spSitManagerHelpCP" name="dtKartica">
        <parameter name="@Action" value="Grid_kartica" />
        <parameter name="@SitKarticaId" value="$SitKarticaId" />
        <parameter name="@SitKlaseId" value="$SitKlaseId"/>
        <parameter name="@DatumOd" value="#txtDatumOd" />
        <parameter name="@DatumDo" value="#txtDatumDo" />
      </data>
      <data command="spSitManagerHelpCP" name="dtDatumi">
        <parameter name="@Action" value="Datumi" />
      </data>

    </datalist>

  </form>
</root>