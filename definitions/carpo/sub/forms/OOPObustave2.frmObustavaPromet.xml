<root>

  <form name="frmObustavaPromet" caption="$caption" width="800" height="460" fixedsize="true" saveformsize="false" >
    <event type="load">
      <action type="control populate" value="#grdPromet" >     </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdPromet" key="OOPObustavePrometId" dataname="~dtGridPromet" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true">
            <fields>
              <field name="CarpoRowNumberColumn" fixed="true" caption="Rbr"/>
              <field name="Datum" caption="Datum"/>
              <field name="DugVal" caption="Zaduženje (val)"/>
              <field name="PotVal" caption="Uplata (val)"/>
              <field name="SaldoVal" caption="Saldo (val)"/>
              <field name="DugKn" caption="Zaduženje (kn)"/>
              <field name="PotKn" caption="Uplata (kn)"/>
              <field name="SaldoKn" caption="Saldo (kn)"/>
              <field name="Napomena" caption="Napomena"/>
              <field name="Opis" caption="Dokument"/>
            </fields>

            <event type="focusedrowchanged">
              <action type="control disable" value="#btnBrisi,#btnIzmijeni" if="#grdPromet.@oopobradeglaid!=null"></action>
              <action type="control enable" value="#btnBrisi,#btnIzmijeni" else=""></action>
              
            </event>
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unesi">
          <event type="click">
            <action type="form open" value="frmObustavaPrometEdit">
              <parameter name="OOPObustaveDetId" value="$OOPObustaveDetId"/>
              <parameter name="OOPObustavePrometId" value="0"/>
              <parameter name="caption" value="Unos prometa"/>
            </action>
            <action type="control populate keepfocus" value="#grdPromet"/>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmObustavaPrometEdit">
              <parameter name="OOPObustaveDetId" value="$OOPObustaveDetId"/>
              <parameter name="OOPObustavePrometId" value="#grdPromet.@OOPObustavePrometId"/>
              <parameter name="caption" value="Izmjena prometa"/>
            </action>
            <action type="control populate keepfocus" value="#grdPromet"/>
          </event>
        </button>
        <button name="btnBrisi" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmObustavaPrometBrisi">
              <parameter name="OOPObustavePrometId" value="#grdPromet.@OOPObustavePrometId"/>
              <parameter name="oopobradeglaid" value="#grdPromet.@oopobradeglaid" if="#grdPromet.@oopobradeglaid!=null"/>
              <parameter name="oopobradeglaid" value="0" else=""/>
              <parameter name="caption" value="Brisanje prometa"/>
            </action>
            <action type="control populate" value="#grdPromet"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPObustavePrometQuery" name="dtGridPromet">
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId"/>
      </data>
    </datalist>
  </form>

  <form name="frmObustavaPrometEdit" caption="$caption" width="530" height="350" fixedsize="true" saveformsize="false">
    <event type="init">
      <action type="datarun reader" value="~dtGet_detalj"/>
      <action type="datarun reader" value="~dtGet" if="$OOPObustavePrometId!=0" />
    </event>
    <event type="shown">
      <action type="datarun reader" value="~dtDaj_tecaj"/>
      <action type="control value" value="#txtTecaj">
        <parameter value="~dtDaj_tecaj.@Tecaj"/>
      </action>
      <action type="control disable" value="#cmbValuta"/>
    </event>


    <layout>
      <group cols="4" rows="8" groupbordervisible="false" alignmode="local">
        <columnsdefinition>
          <column position="1" size="15%" />
		   <column position="3" size="15%" />
        </columnsdefinition>
        <item col="1" row="1"  textposition="left" caption="Datum:" highlight="false" colspan="2">
          <dateedit name="datDatum" datavalue="~dtget.@Datum" value="NOW"/>
        </item>
        <item caption="Valuta:" col="1" row="2" colspan="3" textposition="left" highlight="false">
          <comboedit name="cmbValuta"  valuefield="OOPValuteId" displayfield="NazivText" dataname="~dtOOPValute" required="true" allownull="false" datavalue="~dtGet_detalj.@OOPValuteId">            
          </comboedit>
        </item>
        <item col="1" row="3"  textposition="left" caption="Tečaj:" highlight="false" >
          <textedit name="txtTecaj" format="n6" value="1">
            
          </textedit>
        </item>
		<item col="1" row="4" textposition="left" caption="Zaduženje:" highlight="false" fontbold="true" >
        </item>
        <item col="2" row="4" textposition="left" highlight="false" fontbold="true" >
          <labeledit name="lblZad" value=" " />
        </item>
		<item col="3" row="4" textposition="left" caption="Uplata:" highlight="false" fontbold="true" >
        </item>
        <item col="4" row="4" textposition="left" highlight="false" fontbold="true" >
          <labeledit name="lblUpl" value=" "/>
        </item>
        <item col="1" row="5"  textposition="left" caption="Valuta:" highlight="false" colspan="2">
          <textedit datavalue="~dtGet.@DugVal" name="txtDugVal" format="n2" value="0">
            <event type="leave">
              <action type="control value" value="#txtDugVal" if="#txtDugVal==null">
                <parameter value="0"/>
              </action>
              <action type="variable value" value="cifra">
                <parameter value="#txtDugVal"/>
              </action>
              <action type="datarun reader" value="~dtUmnozak">
              </action>
              <action type="control value" value="#txtDugKn">
                <parameter value="~dtUmnozak.@rezultat"/>
              </action>
            </event>
          </textedit>
        </item>
        <item col="3" row="5"  textposition="left" caption="Valuta:" highlight="false" colspan="2">
          <textedit datavalue="~dtGet.@PotVal" name="txtPotVal" format="n2" value="0">
            <event type="leave">
              <action type="control value" value="#txtPotVal" if="#txtPotVal==null">
                <parameter value="0"/>
              </action>
              <action type="variable value" value="cifra">
                <parameter value="#txtPotVal"/>
              </action>
              <action type="datarun reader" value="~dtUmnozak">
              </action>
              <action type="control value" value="#txtPotKn">
                <parameter value="~dtUmnozak.@rezultat"/>
              </action>
            </event>
          </textedit>
        </item>
        <item col="1" row="6"  textposition="left" caption="Kn:" highlight="false" colspan="2">
          <textedit datavalue="~dtGet.@DugKn" name="txtDugKn" format="n2" value="0">
            <event type="leave">
              <action type="control value" value="#txtDugKn" if="#txtDugKn==null">
                <parameter value="0"/>
              </action>
            </event>
          </textedit>
        </item>
        <item col="3" row="6"  textposition="left" caption="Kn:" highlight="false" colspan="2">
          <textedit datavalue="~dtGet.@PotKn" name="txtPotKn" format="n2" value="0">
            <event type="leave">
              <action type="control value" value="#txtPotKn" if="#txtPotKn==null">
                <parameter value="0"/>
              </action>
            </event>
          </textedit>
        </item>
        <item col="3" row="7"  textposition="left" caption="Broj obroka:" highlight="false" colspan="2">
          <textedit datavalue="~dtGet.@BrObrokaOtpl" name="txtBrObrokaOtpl" format="n0" value="0"></textedit>
        </item>
        
        

        <item col="1" row="8" colspan="2"  textposition="left" caption="Napomena:" highlight="false" >
          <textedit datavalue="~dtGet.@Napomena" name="txtNapomena" value=" "></textedit>
        </item>



      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$OOPObustavePrometId==0">
              <action type="datarun reader" value="~dtUnos"/>
              <action type="form close"/>
              <action type="control populate keepfocus" value="parent.#grdPromet"/>
            </action>
            <action if="$OOPObustavePrometId!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
              <action type="form close"></action>
              <action type="control populate keepfocus" value="parent.#grdPromet"/>
            </action>
          </event>
        </button>

        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      
      <data command="spOOPObustaveHelpCP" name="dtGet">
        <parameter name="@action" value="dtGet_promet" type="string"/>
        <parameter name="@OOPObustavePrometId" value="$OOPObustavePrometId" type="int"/>
      </data>
      <data command="spOOPObustaveHelpCP" name="dtGet_detalj">
        <parameter name="@action" value="dtGet_detalj1" type="string"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
      </data>

      <data command="spOOPObustaveHelpCP" name="dtDaj_tecaj">
        <parameter name="@action" value="dtDaj_tecaj" type="string"/>
        <parameter name="@oopvaluteid" value="#cmbValuta"/>
      </data>

      <!--<data command="spoopuzmivalute" name="dtValute">      </data>-->
      <data command="spOOPObustaveHelpCP" name="dtOOPValute">
        <parameter name="@action"  value="cmb_OOPValute" />
      </data>
      
      <data command="spOOPObustaveHelpCP" name="dtUmnozak">
        <parameter name="@action" value="umnozak_dva_broja" type="string"/>
        <parameter name="@tecaj" value="#txtTecaj" type="decimal"/>
        <parameter name="@iznosValuta" value="$cifra" type="decimal"/>
      </data>

      <data command="spOOPObustavePrometAzur" name="dtUnos">
        <parameter name="@action" value="0" type="int"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
        <parameter name="@Datum" value="#datDatum" type="date"/>
        <parameter name="@DugVal" value="#txtDugVal" type="decimal"/>
        <parameter name="@PotVal" value="#txtPotVal" type="decimal"/>
        <parameter name="@DugKn" value="#txtDugKn" type="decimal"/>
        <parameter name="@PotKn" value="#txtPotKn" type="decimal"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@status" value="1" type="int"/>
        <parameter name="@BrObrokaOtpl" value="txtBrObrokaOtpl" type="int"/>
      </data>


      <data command="spOOPObustavePrometAzur" name="dtIzmjena">
        <parameter name="@action" value="1" type="int"/>
        <parameter name="@OOPObustaveDetId" value="$OOPObustaveDetId" type="int"/>
        <parameter name="@ID" value="$OOPObustavePrometId" type="int"/>
        <parameter name="@Datum" value="#datDatum" type="date"/>
        <parameter name="@DugVal" value="#txtDugVal" type="decimal"/>
        <parameter name="@PotVal" value="#txtPotVal" type="decimal"/>
        <parameter name="@DugKn" value="#txtDugKn" type="decimal"/>
        <parameter name="@PotKn" value="#txtPotKn" type="decimal"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
        <parameter name="@status" value="1" type="int"/>
        <parameter name="@BrObrokaOtpl" value="txtBrObrokaOtpl" type="int"/>
      </data>


    </datalist>
  </form>

  <form name="frmObustavaPrometBrisi" caption ="Brisanje" saveformsize="false" width="400" height="125" fixedsize="true">
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrani zapis?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <!--<action type="datarun reader" value="~dtBrisanje"/>
            <action type="message" value="~dtBrisanje.@Poruka"></action>
            <action type="control populate keepfocus" value="parent.#grdValute"/>
            <action type="form close" if="~dtBrisanje.@IndGreske==0" />-->


            <action type="datarun reader" value="~dtBrisanje"></action>
            <action type="form close"></action>
            <action type="control populate keepfocus" value="parent.#grdPromet"/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spOOPObustavePrometAzur" name="dtBrisanje">
        <parameter name="@Action" value="2" type="int" />
        <parameter name="@ID" value="$OOPObustavePrometId"/>
        <parameter name="@oopobradeglaid" value="$oopobradeglaid"/>
      </data>
    </datalist>
  </form>



</root>