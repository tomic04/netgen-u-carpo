<root>
	<form name="frmManagerStrojeva" caption="{$caption}{$caption2}" saveformsize="false" width="824">
		<event type="init">
			<action type="variable value">
				<parameter name="global.$VoziloId" value="$VoziloId" />
				<parameter name="global.$NewVoziloId" value="null" />
				<parameter name="global.$NewVoziloName" value="null" />
			</action>
			<action type="datarun reader" value="~dtLoad" if="global.$VoziloId!=null" />
			<action type="datarun reader" value="~dtLoadParametri" />
			<action type="variable value">
				<parameter name="SerijskiBroj" value="~dtLoadParametri.@SerijskiBroj" />
				<parameter name="RegOznaka" value="~dtLoadParametri.@RegOznaka" />
			</action>
		</event>
		<event type="shown">
			<action if="global.$VoziloId==null">
				<action type="control value" value="#srcModel">
					<parameter value="global.$VozModelId" />
				</action>
			</action>
			<action type="control attribute" value="#txtSasija" if="$SerijskiBroj==True">
				<parameter name="required" value="true" />
			</action>
			<action type="control attribute" value="#txtReg" if="$RegOznaka==True">
				<parameter name="required" value="true" />
			</action>
		</event>
		<event type="load">
			<action if="global.$VoziloId!=null">
				<action type="control disable" value="#datReg" if="~dtLoad.@DatumPrveReg==null" />
				<action type="control value" value="#chkReg">
					<parameter value="True" if="~dtLoad.@DatumPrveReg!=null" />
					<parameter value="False" if="~dtLoad.@DatumPrveReg==null" />
				</action>
				<action type="control disable" value="#btnDodajModel" />
				<action type="control disable" value="#datKup" if="~dtLoad.@DatumKupnje==null" />
				<action type="control value" value="#chkKup">
					<parameter value="True" if="~dtLoad.@DatumKupnje!=null" />
					<parameter value="False" if="~dtLoad.@DatumKupnje==null" />
				</action>
				<action type="control disable" value="#datPro" if="~dtLoad.@DatumProdaje==null" />
				<action type="control value" value="#chkPro">
					<parameter value="True" if="~dtLoad.@DatumProdaje!=null" />
					<parameter value="False" if="~dtLoad.@DatumProdaje==null" />
				</action>
				<action type="control disable" value="#datOdj" if="~dtLoad.@DatumOdjave==null" />
				<action type="control value" value="#chkOdj">
					<parameter value="True" if="~dtLoad.@DatumOdjaved!=null" />
					<parameter value="False" if="~dtLoad.@DatumOdjave==null" />
				</action>
				<action type="control disable" value="#datKasko" if="~dtLoad.@Kasko==null" />
				<action type="control value" value="#chkKasko">
					<parameter value="True" if="~dtLoad.@Kasko!=null" />
					<parameter value="False" if="~dtLoad.@Kasko==null" />
				</action>
				<action type="control disable" value="#datOsnovno" if="~dtLoad.@Osnovno==null" />
				<action type="control value" value="#chkOsnovno">
					<parameter value="True" if="~dtLoad.@Osnovno!=null" />
					<parameter value="False" if="~dtLoad.@Osnovno==null" />
				</action>
				<action type="control disable" value="#datTahograf" if="~dtLoad.@Tahograf==null" />
				<action type="control value" value="#chkTahograf">
					<parameter value="True" if="~dtLoad.@Tahograf!=null" />
					<parameter value="False" if="~dtLoad.@Tahograf==null" />
				</action>
			</action>
			<action if="global.$VoziloId==null">
				<action type="control value" value="#srcModel">
					<parameter value="global.$VozModelId" />
				</action>
				<action type="control disable" value="#datReg" />
				<action type="control value" value="#datReg">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datKup" />
				<action type="control value" value="#datKup">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datPro" />
				<action type="control value" value="#datPro">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datOdj" />
				<action type="control value" value="#datOdj">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datKasko" />
				<action type="control value" value="#datKasko">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datOsnovno" />
				<action type="control value" value="#datOsnovno">
					<parameter value="null" />
				</action>
				<action type="control disable" value="#datTahograf" />
				<action type="control value" value="#datTahograf">
					<parameter value="null" />
				</action>
			</action>
		</event>
		<layout>
			<group rows="1" cols="1">
				<tabs>
					<group rows="5" cols="12" caption="Osnovno">
						<columnsdefinition>
							<column position="1" size="65" />
							<column position="2" size="65" />
							<column position="3" size="65" />
							<column position="4" size="65" />
							<column position="5" size="65" />
							<column position="6" size="65" />
							<column position="7" size="65" />
							<column position="8" size="65" />
							<column position="9" size="65" />
							<column position="10" size="65" />
							<column position="11" size="65" />
							<column position="12" size="65" />
						</columnsdefinition>
						<item row="1" col="1" colspan="5" caption="Model:">
							<searchedit name="srcModel" dataname="~dtModel" datavalue="~dtLoad.@VozModelId" datatext="~dtLoad.@NazivSve2" fieldvalue="VozModelId" fieldtext="Naziv" required="true" />
						</item>
						<item row="1" col="6" colspan="5" caption="Kategorija stroja:">
							<comboedit name="cmbKategorijaVozila" dataname="~dtKategorijeVozila" datavalue="~dtLoad.@KategorijeVozilaId" valuefield="KategorijeVozilaId" displayfield="Oznaka" />
						</item>
						<item row="1" col="11" colspan="2" highlight="false" spacing="25,10,18,10">
							<checkedit name="chkZaduzeno" datavalue="~dtLoad.@ZaduzenoInd" caption="Zaduženo" />
						</item>
						<item row="2" col="1" colspan="3" caption="Garažni broj:">
							<textedit name="txtGarazni" datavalue="~dtLoad.@GarazniBroj" />
						</item>
						<item row="2" col="4" colspan="3" caption="Serijski broj:">
							<textedit name="txtSasija" datavalue="~dtLoad.@BrojSasije" />
						</item>
						<item row="2" col="7" colspan="3" caption="Broj motora:">
							<textedit name="txtMotor" datavalue="~dtLoad.@BrojMotora" />
						</item>
						<item row="2" col="10" colspan="3" caption="Namjena stroja:">
							<comboedit name="cmbNamjenaStroja" dataname="~dtNamjenaStroja" datavalue="~dtLoad.@NamjenaStrojaId" valuefield="NamjenaStrojaId" displayfield="Naziv" />
						</item>
						<item row="3" col="1" colspan="3" caption="Registarska oznaka:">
							<textedit name="txtReg" datavalue="~dtLoad.@RegOznaka" />
						</item>
						<item row="3" col="4" colspan="3" caption="Godina proizvodnje:">
							<textedit name="txtGod" datavalue="~dtLoad.@GodinaProizvodnje" />
						</item>
						<item row="3" col="7" colspan="3" caption="Boja:">
							<textedit name="txtBoja" datavalue="~dtLoad.@Boja" />
						</item>
						<!--
						<item row="3" col="10" colspan="3" caption="Radni zahvat stroja:">
						<textedit name="txtZahvat" />
						</item>
						-->
						<item row="4" col="1" colspan="5" caption="Partner:">
							<searchedit name="srcPartner" dataname="~dtPartner" datavalue="~dtLoad.@PartneriId" datatext="~dtLoad.@PartneriNaziv" fieldtext="Naziv" />
						</item>
						<item row="4" col="6" colspan="5" caption="Osoba:">
							<searchedit name="srcOsoba" dataname="~dtOsoba" datavalue="~dtLoad.@OsobeId" datatext="~dtLoad.@OsobaNaziv" fieldtext="Naziv" />
						</item>
						<item row="5" col="1" colspan="5" caption="Osnovno sredstvo:">
							<searchedit name="srcSredstvo" dataname="~dtSredstvo" datavalue="~dtLoad.@OSImovinaId" datatext="~dtLoad.@InvNaziv" fieldtext="InvNaziv" />
						</item>
						<item row="5" col="6" colspan="5" caption="Dimenzija:">
							<searchedit name="srcDimenzija" dataname="~dtDimenzija" datavalue="~dtLoad.@DimenzijeId" datatext="~dtLoad.@DimNaziv" fieldtext="Naziv" />
						</item>
						<item row="5" col="11" colspan="2" highlight="false" spacing="23,10,18,10">
							<checkedit name="chkUmirovljeno" datavalue="~dtLoad.@Umirovljeno" caption="Umirovljeno" />
						</item>
					</group>
					<group rows="3" cols="4" caption="Dodatno">
						<rowsdefinition>
							<row position="1" size="34%" />
							<row position="2" size="33%" />
							<row position="3" size="33%" />
						</rowsdefinition>
						<group row="1" col="1" rows="1" cols="4" colspan="4" caption="Masa, nosivost, osovine">
							<columnsdefinition>
								<column position="1" size="25%" />
								<column position="2" size="25%" />
								<column position="3" size="25%" />
								<column position="4" size="25%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Masa praznog vozila (kg):">
								<textedit name="txtMasa" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@Masa" />
							</item>
							<item row="1" col="2" caption="Dopuštena nosivost (kg):">
								<textedit name="txtNosivost" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@Nosivost" />
							</item>
							<item row="1" col="3" caption="Broj osovina (kom):">
								<textedit name="txtBrojOsovina" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@BrojOsovina" />
							</item>
							<item row="1" col="4" caption="Broj pogonskih osovina (kom):">
								<textedit name="txtBrojPogonskihOsovina" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@BrojPogonskihOsovina" />
							</item>
						</group>
						<group row="2" col="1" rows="1" cols="3" colspan="3" caption="Pneumatici">
							<columnsdefinition>
								<column position="1" size="34%" />
								<column position="2" size="33%" />
								<column position="3" size="33%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Ukupan broj (kom):">
								<textedit name="txtBrojPneumatika" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@BrojPneumatika" />
							</item>
							<item row="1" col="2" caption="Dimenzije (prednji):">
								<textedit name="txtDimenzijePrednjihPneumatika" datavalue="~dtLoad.@DimenzijePrednjihPneumatika" />
							</item>
							<item row="1" col="3" caption="Dimenzije (zadnji):">
								<textedit name="txtDimenzijeZadnjihPneumatika" datavalue="~dtLoad.@DimenzijeZadnjihPneumatika" />
							</item>
						</group>
						<group row="3" col="1" rows="1" cols="3" colspan="3" caption="Motor">
							<columnsdefinition>
								<column position="1" size="34%" />
								<column position="2" size="33%" />
								<column position="3" size="33%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Obujam (ccm3):">
								<textedit name="txtObujam" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@Obujam" />
							</item>
							<item row="1" col="2" caption="Snaga (kW):">
								<textedit name="txtSnaga" format="[1-9]+[0-9]*" formattype="regex" datavalue="~dtLoad.@Snaga" />
							</item>
							<item row="1" col="3" caption="Eko kategorija (euro):">
								<textedit name="txtEkoKategorija" format="[1-9]" formattype="regex" datavalue="~dtLoad.@EkoKategorija" />
							</item>
						</group>
						<group row="2" col="4" rows="2" cols="2" rowspan="2" caption="DA/NE">
							<rowsdefinition>
								<row position="1" size="50%" />
								<row position="2" size="50%" />
							</rowsdefinition>
							<columnsdefinition>
								<column position="1" size="34%" />
								<column position="2" size="66%" />
							</columnsdefinition>
							<item row="1" col="1" highlight="false">
								<checkedit name="chkAdBlue" datavalue="~dtLoad.@AdBlue" caption="AdBlue" />
							</item>
							<item row="2" col="1" highlight="false">
								<checkedit name="chkGPSLokator" datavalue="~dtLoad.@GPSLokator" caption="GPS lokator" />
							</item>
							<item row="2" col="2" highlight="false">
								<checkedit name="chkSondaZaGorivo" datavalue="~dtLoad.@SondaZaGorivo" caption="Sonda za gorivo" />
							</item>
							<item row="1" col="2" highlight="false">
								<checkedit name="chkPratiRadHidraulike" datavalue="~dtLoad.@PratiRadHidraulike" caption="Praćenje rada hidraulike" />
							</item>
						</group>
					</group>
					<group rows="3" cols="8" caption="Datumi">
						<rowsdefinition>
							<row position="1" size="34%" />
							<row position="2" size="33%" />
							<row position="3" size="33%" />
						</rowsdefinition>
						<group row="1" col="1" rows="1" cols="8" colspan="8" caption="Osnovni datumi">
							<columnsdefinition>
								<column position="1" size="20%" />
								<column position="2" size="5%" />
								<column position="3" size="20%" />
								<column position="4" size="5%" />
								<column position="5" size="20%" />
								<column position="6" size="5%" />
								<column position="7" size="20%" />
								<column position="8" size="5%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Datum prve registracije:">
								<dateedit name="datReg" datavalue="~dtLoad.@DatumPrveReg" />
							</item>
							<item row="1" col="2" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkReg">
									<event type="checkedchanged">
										<action type="control enable" value="#datReg" if="#chkReg==True" />
										<action type="control disable" value="#datReg" if="#chkReg==False" />
										<action type="control value" value="#datReg">
											<parameter value="now" if="#chkReg==True" />
											<parameter value="null" if="#chkReg==False" />
										</action>
									</event>
								</checkedit>
							</item>
							<item row="1" col="3" caption="Datum kupnje:">
								<dateedit name="datKup" datavalue="~dtLoad.@DatumKupnje" />
							</item>
							<item row="1" col="4" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkKup">
									<event type="checkedchanged">
										<action type="control enable" value="#datKup" if="#chkKup==True" />
										<action type="control disable" value="#datKup" if="#chkKup==False" />
										<action type="control value" value="#datKup">
											<parameter value="now" if="#chkKup==True" />
											<parameter value="null" if="#chkKup==False" />
										</action>
									</event>
								</checkedit>
							</item>
							<item row="1" col="5" caption="Datum prodaje:">
								<dateedit name="datPro" datavalue="~dtLoad.@DatumProdaje" />
							</item>
							<item row="1" col="6" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkPro">
									<event type="checkedchanged">
										<action type="control enable" value="#datPro" if="#chkPro==True" />
										<action type="control disable" value="#datPro" if="#chkPro==False" />
										<action type="control value" value="#datPro">
											<parameter value="now" if="#chkPro==True" />
											<parameter value="null" if="#chkPro==False" />
										</action>
									</event>
								</checkedit>
							</item>
							<item row="1" col="7" caption="Datum odjave:">
								<dateedit name="datOdj" datavalue="~dtLoad.@DatumOdjave" />
							</item>
							<item row="1" col="8" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkOdj">
									<event type="checkedchanged">
										<action type="control enable" value="#datOdj" if="#chkOdj==True" />
										<action type="control disable" value="#datOdj" if="#chkodj==False" />
										<action type="control value" value="#datOdj">
											<parameter value="now" if="#chkOdj==True" />
											<parameter value="null" if="#chkOdj==False" />
										</action>
									</event>
								</checkedit>
							</item>
						</group>
						<group row="2" col="1" rows="1" cols="6" colspan="8" caption="Osiguranje i tahograf">
							<columnsdefinition>
								<column position="1" size="28%" />
								<column position="2" size="6%" />
								<column position="3" size="27%" />
								<column position="4" size="6%" />
								<column position="5" size="27%" />
								<column position="6" size="6%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Kasko osiguranje:">
								<dateedit name="datKasko" datavalue="~dtLoad.@Kasko" />
							</item>
							<item row="1" col="2" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkKasko">
									<event type="checkedchanged">
										<action type="control enable" value="#datKasko" if="#chkKasko==True" />
										<action type="control disable" value="#datKasko" if="#chkKasko==False" />
										<action type="control value" value="#datKasko">
											<parameter value="now" if="#chkKasko==True" />
											<parameter value="null" if="#chkKasko==False" />
										</action>
									</event>
								</checkedit>
							</item>
							<item row="1" col="3" caption="Osnovno osiguranje:">
								<dateedit name="datOsnovno" datavalue="~dtLoad.@Osnovno" />
							</item>
							<item row="1" col="4" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkOsnovno">
									<event type="checkedchanged">
										<action type="control enable" value="#datOsnovno" if="#chkOsnovno==True" />
										<action type="control disable" value="#datOsnovno" if="#chkOsnovno==False" />
										<action type="control value" value="#datOsnovno">
											<parameter value="now" if="#chkOsnovno==True" />
											<parameter value="null" if="#chkOsnovno==False" />
										</action>
									</event>
								</checkedit>
							</item>
							<item row="1" col="5" caption="Tahograf:">
								<dateedit name="datTahograf" datavalue="~dtLoad.@Tahograf" />
							</item>
							<item row="1" col="6" spacing="0,0,16,0" highlight="false">
								<checkedit name="chkTahograf">
									<event type="checkedchanged">
										<action type="control enable" value="#datTahograf" if="#chkTahograf==True" />
										<action type="control disable" value="#datTahograf" if="#chkTahograf==False" />
										<action type="control value" value="#datTahograf">
											<parameter value="now" if="#chkTahograf==True" />
											<parameter value="null" if="#chkTahograf==False" />
										</action>
									</event>
								</checkedit>
							</item>
						</group>
						<group row="3" col="1" rows="1" cols="3" colspan="8" caption="Pregledi i registracija">
							<columnsdefinition>
								<column position="1" size="34%" />
								<column position="2" size="33%" />
								<column position="3" size="33%" />
							</columnsdefinition>
							<item row="1" col="1" caption="Periodični pregled:">
								<textedit name="txtPregledPeriod" datavalue="~dtLoad.@PregledPeriod" />
							</item>
							<item row="1" col="2" caption="Tehnički i reg. (dan):">
								<textedit name="txtTehRegDan" datavalue="~dtLoad.@TehRegDan" />
							</item>
							<item row="1" col="3" caption="Tehnički i reg. (mjesec):">
								<textedit name="txtTehRegMj" datavalue="~dtLoad.@TehRegMj" />
							</item>
						</group>
					</group>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action if="global.$VoziloId!=null">
							<action type="datarun nonquery" value="~dtUpsert" />
							<action type="datarun reader" value="~dtGetVozilo" />
							<action type="variable value" value="global.$NewVoziloName">
								<parameter value="~dtGetVozilo.@Stroj" />
							</action>
							<action type="control value" value="parent.#srcStroj">
								<parameter value="$VoziloId" text="global.$NewVoziloName" />
							</action>
							<action type="control value" value="parent.#txtSerijskiBroj">
								<parameter value="~dtGetVozilo.@SerijskiBroj" />
							</action>
							<action type="control value" value="parent.#txtBrojReg">
								<parameter value="~dtGetVozilo.@RegOznaka" />
							</action>
							<action type="control value" value="parent.#txtInvBroj">
								<parameter value="~dtGetVozilo.@InventurniBroj" />
							</action>
							<action type="form close" />
						</action>
						<action if="global.$VoziloId==null">
							<action type="datarun scalar" value="~dtUpsert">
								<parameter name="VoziloId" />
							</action>
							<action type="variable value" value="global.$NewVoziloId">
								<parameter name="global.$NewVoziloId" value="$VoziloId" />
								<parameter name="global.$NotFound" value="true" />
							</action>
							<action type="datarun reader" value="~dtGetVozilo" />
							<action type="variable value" value="global.$NewVoziloName">
								<parameter value="~dtGetVozilo.@Stroj" />
							</action>
							<action type="control value" value="parent.#srcStroj">
								<parameter value="global.$NewVoziloId" text="global.$NewVoziloName" />
							</action>
