<root>
	<form name="frmKopirajMulti" caption="Kopiraj više dokumenata1" fixedsize="false">
		<event type="shown">
			<action type="control value" value="#datDatumDok">
				<parameter value="now"/>
			</action>
			<!-- <action type="control value" value="#datDatumIsporuke"> -->
			<!-- <parameter value="now"/> -->
			<!-- </action>			 -->
		</event>		
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<group rows="2" cols="1" row="1" col="1" entermovenextcontrol="true">
					<item caption="Datum dokumenta:" row="1" col="1">
						<dateedit name="datDatumDok" datavalue="" required="true"/>
					</item>
					<!-- <item caption="Datum isporuke:" row="2" col="1"> -->
					<!-- <dateedit name="datDatumIsporuke" datavalue="" required="true"/> -->
					<!-- </item>					 -->
					<item caption="" row="2" col="1" highlight="false" >
						<checkedit caption="Obnovi uvjete prema datumu" name="chkObnovi" enabled="" />
					</item>						
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="KOPIRAJ" type="add" dock="left">
					<event type="click">
						<action type="datarun reader" value="Global.dtProvjeraKopiranja" />
						<action if="~dtProvjeraKopiranja.@greska==1">
							<action type="message" value="Datum je izvan dopuštenog razdoblja fakture!"/>
						</action>
						<action elseif="~dtProvjeraKopiranja.@greska==2">
							<action type="message" value="Operater nema pravo na status!"/>
						</action>
						<action else="">
							<action type="validate" />
							<action type="datarun reader" value="~dtKopirajMulti"/>
							<action type="control value" value="parent.#grdGlava">
								<parameter name="$Oznaceni"/>
							</action>
							<action type="datarun scalar" value="Global.dtDajNode">
								<parameter name="Tree_node" />
							</action>
							<action type="control focus" value="parent.#tree" if="parent.#tree.Id!=$Tree_node">
								<parameter value="$Tree_node"/>
							</action>							
							<action type="control populate" value="parent.#grdGlava" >
								<action type="control focus" value="parent.#grdGlava">
									<parameter value="$ProNotpGlaId" />
								</action>
							</action>	
						</action>						
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_NotpGla_KopirajMulti" name="dtKopirajMulti">
				<parameter name="@Idijevi" value="parent.$Oznaceni" type="string" />
				<parameter name="@DatumDok" value="#datDatumDok" />
				<parameter name="@DatumIsporuke" value="#datDatumIsporuke" />
				<parameter name="@obnovi" value="#chkObnovi" />
				<parameter name="@operateriid" value="@@OperateriId" />
			</data>
		</datalist>
	</form>
</root>