<root>
	<form name="frmPovezi" caption="Povezivanje s dokumentima" saveformsize="true">
		<event type="shown">
			<action type="datarun reader" value="~dtGrid" />
			<action type="datarun reader" value="~dtComboVrstaDok" />
			<action type="control populate" value="#grdPovezaniDokumenti" />
		</event>
		<layout>
			<group cols="4" rows="4">
				<columnsdefinition>
					<column size="20%" position="1" />
					<column size="20%" position="2" />
					<column size="20%" position="3" />
					<column size="20%" position="4" />
				</columnsdefinition>
				<rowsdefinition>
					<row size="10%" position="1" />
					<row size="10%" position="2" />
					<row size="70%" position="3" />
					<row size="10%" position="4" />
				</rowsdefinition>
				<item col="1" row="1" caption="Vrsta dokumenta:" colspan="3">
					<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Dokument" dataname="~dtComboVrstaDok" datavalue="~dtComboVrstaDok.@vrstadokid" />
				</item>
				<item col="1" row="2" caption="Dokument:" colspan="3">
					<searchedit name="srcDokument" fieldtext="Broj" fieldvalue="SktPrometGlaId" dataname="~dtTrazilica">
					</searchedit>
				</item>
				<item col="4" row="2">
					<button name="btnPoveziDok" caption="POVEŽI" fontsizedelta="1" fontbold="True" image="link" imagelocation="middleleft">
						<event type="click">
							<action type="datarun scalar" value="~dtPovezi" />
							<action type="control refreshvalue" value="#grdPovezaniDokumenti,#cmbVrstaDok,#srcDokument" />
						</event>
					</button>
				</item>
				<item col="1" row="3" colspan="4">
					<grid name="grdPovezaniDokumenti" dataname="~dtGrid" showgrouppanel="false">
						<fields>
							<field name="Opis" caption="Opis" minwidth="120" />
							<field name="Datum dokumenta" caption="Datum dokumenta" minwidth="120" />
							<field name="Broj" caption="Broj" minwidth="120" />
							<field name="Broj dokumenta" caption="Broj dokumenta" minwidth="120" />
						</fields>
					</grid>
				</item>
				<item col="1" row="4">
					<button name="btnObrisiPovezane" caption="OBRIŠI STAVKU" fontsizedelta="1" image="delete" imagelocation="middleleft">
						<event type="click">
							<action type="datarun scalar" value="~dtObrisiStavku" />
							<action type="control refreshvalue" value="#grdPovezaniDokumenti" />
						</event>
					</button>
				</item>
				<item col="4" row="4">
					<button name="btnZatvori" caption="ZATVORI" fontsizedelta="1">
						<event type="click">
							<action type="form close" />
						</event>
					</button>
				</item>
			</group>
		</layout>
		<datalist>
			<data name="dtComboVrstaDok" command="spKUPSktDokumenti">
				<parameter name="@Action" value="33" />
			</data>
			<data name="dtTrazilica" command="spKUPLinkSktDok">
				<parameter name="@Action" value="115" />
				<parameter name="@Uvjet" value="#srcDokument.text" />
				<parameter name="@VrstaDokId" value="#cmbVrstaDok" />
				<parameter name="@Id" value="$KupPrometId" />
			</data>
			<data name="dtGrid" command="spKUPLinkSktDok">
				<parameter name="@Action" value="100" />
				<parameter name="@Id" value="$KupPrometId" />
			</data>
			<data name="dtPovezi" command="spKUPLinkSktDok">
				<parameter name="@Action" value="5" />
				<parameter name="@Id" value="$KupPrometId" />
				<parameter name="@GlaId" value="#srcDokument" />
				<parameter name="@VrstaDokId" value="#cmbVrstaDok" />
			</data>
			<data name="dtObrisiStavku" command="spKUPLinkSktDok">
				<parameter name="@Action" value="10" />
				<parameter name="@Id" value="$KupPrometId" />
				<parameter name="@GlaId" value="#grdPovezaniDokumenti.@GlaId" />
			</data>
		</datalist>
	</form>
</root>
