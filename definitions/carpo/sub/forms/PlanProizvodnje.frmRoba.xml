<root>
	<form name="frmRoba" caption="Roba" width="320" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$ProPlanProizvodnjeDetId!=null" />
		</event>
			<event type="load">
            <action type="variable value" >
                <parameter name="NazivRobe" value="~dtGet.@RobaNaziv"/>
                <parameter name="RobaId" value="~dtGet.@RobaId" type="int"/>
            </action>			
			</event>
		<layout textposition="top" itemspadding="4">
			<group cols="2" rows="4">
				<item caption="Roba" col="1" row="1" type="visible" value="false" colspan="2">
					<searchedit type="roba" name="txtRoba" fontsizedelta="1" fontbold="True" fieldtext="Naziv" fieldvalue="RobaId" entermovenextcontrol="false" required="true"  datavalue="~dtGet.@RobaId" datatext="~dtGet.@RobaNaziv">
						<event type="valuechanged" raiseonload="false">
							<action type="control focus" value="#txtKolicina"/>
						
							<action type="variable value" >
								<parameter name="RobaId" value="#txtRoba.@robaid" type="int"/>
								<parameter name="NazivRobe" value="#txtRoba.@Naziv"/>
								<!--#txtRoba.@Naziv <parameter name="NazivRobe" value="#txtNaziv"/> -->
							</action>
							<action type="control value" value="#lblJM1">
								<parameter value="#txtRoba.@JMNaziv"/>
							</action>
						</event>						
					</searchedit>
				</item>
				<item caption="Količina" col="1" row="2" width="150">
					<textedit name="txtKolicina" fontsizedelta="1" fontbold="True" value="0" format="n2" required="true" datavalue="~dtGet.KolicinaPlan1"/>
				</item>
				<item caption=" " col="2" row="2" itemspadding="4">
					<labeledit name="lblJM1" fontsizedelta="1" fontbold="True" datavalue="~dtGet.JMNaziv"/>
				</item>				
				<item caption="Cijena" col="1" row="3">
					<textedit name="txtCijena" fontsizedelta="1" fontbold="True" format="n2" value="0" datavalue="~dtGet.Cijena"/>
				</item>
				<item caption=" " col="2" row="3" itemspadding="4">
					<labeledit name="lblJM" fontsizedelta="1" fontbold="True" value="kn"/>
				</item>						
				<item caption="Napomena" col="1" row="4" colspan="2">
					<textedit name="txtNapomena" fontsizedelta="1" fontbold="True"  datavalue="~dtGet.opis"  required="true"/>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="SPREMI" type="add" dock="right">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtEdit" if="$ProPlanProizvodnjeDetId!=null"/>
						<action type="datarun scalar" value="~dtInsert" else="">
							<parameter name="parent.$ProPlanProizvodnjeDetId"/>
							<action type="control populate" value="parent.#grdRoba"/>
							<action type="control focus" value="parent.#grdRoba">
								<parameter value="parent.$ProPlanProdajeDetId" type="int"/>
							</action>
							
						</action>
						<action type="form close" />
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProPlanProizvodnjeDetQuery" name="dtGet">
				<parameter name="@Action" value="detailform" />
				<parameter name="@ID" value="$ProPlanProizvodnjedetId" />
			</data>	
			<data command="spProPlanProizvodnjeDetAzur" name="dtInsert">
				<parameter name="@action" value="0" />
				<parameter name="@ProPlanProizvodnjeGlaId" value="$ProPlanProizvodnjeGlaId"/>
				<parameter name="@robaid" value="#txtRoba.@robaid" type="int"/>
				<parameter name="@kolicinaplan1" value="#txtKolicina"/>
				<parameter name="@kolicinaplan2" value="#txtKolicina"/>
				<parameter name="@kolicinaplan3" value="#txtKolicina"/>
				<parameter name="@Cijena" value="#txtCijena"/>
				<parameter name="@Opis" value="#txtNapomena"/>
				<parameter name="@JMId" value="#txtRoba.@JMId"/>
				<parameter name="@OrgShemaId" value="$OrgShemaId"/>
			</data>
			<data command="spProPlanProizvodnjeDetAzur" name="dtEdit">
				<parameter name="@action" value="1"/>
				<parameter name="@Id" value="$ProPlanProizvodnjeDetId"/>
				<parameter name="@robaid" value="#txtRoba.@robaid" type="int"/>
				<parameter name="@kolicinaplan1" value="#txtKolicina"/>
				<parameter name="@kolicinaplan2" value="#txtKolicina"/>
				<parameter name="@kolicinaplan3" value="#txtKolicina"/>
				<parameter name="@Cijena" value="#txtCijena"/>
				<parameter name="@Opis" value="#txtNapomena"/>	
				<parameter name="@JMId" value="#txtRoba.@JMId"/>
				<parameter name="@OrgShemaId" value="$OrgShemaId"/>				
			</data>			
		</datalist>
	</form>
</root>