<root version="1.0.0.1">
	<form name="frmLegenda" type="master" caption="Legenda"  statusbar="false"  width="400" height="150">
	<!-- width="600" height="250" -->
		<event type="init"> 

		</event>
		<event type="load">	
			<action type="control populate" value="#grdLegenda"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Legenda" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdLegenda"  multiselect="false" key="Status" showgrouppanel="false" showfooter="false" showautofilterrow = "false" savelayout="false">												
							<data command="spCRobnaAnalizaProdajeLegenda"/>
							<fields>	
								<field name="Status" caption="Status" />
								<field name="opis" caption="Opis" />
							</fields>
							
							<styles>
								<!-- BOJANJE-->
								<style name="backgroundcolor" value="blue" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==1" />
								<style name="backgroundcolor" value="red" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==2" />
								<style name="backgroundcolor" value="green" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==3" />
								<style name="backgroundcolor" value="black" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==4" />							
							</styles>	
							
						</grid>
					</item>
				</group>
			</group>	
		</layout>

		<datalist>

		</datalist>
	</form>
</root>