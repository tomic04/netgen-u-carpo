<root>
	<form name="frmRoba" caption="Spajanje Jupiter Software objekta s robom" template="splitter vertical" width="1120" height="590" saveformsize="true">
		<event type="oninit">
			<action type="variable value" value="OdabranaRoba">
				<parameter value="null" />
			</action>
			<action type="variable value" value="global.NovaRobaId">
				<parameter value="null" />
			</action>
			<action type="variable value" value="global.Tip">
				<parameter value="Spajanje" />
			</action>
		</event>
		<event type="shown">
		</event>
		<layout name="panel1" minsize="250" type="collapsable">
			<group rows="2" cols="2">
				<item col="1" row="1" colspan="2">
					<labeledit value="Odaberite Jupiter Software objekte koje želite spojiti s Robom:" fontsizedelta="1" fontbold="true" />
				</item>
				<item col="1" row="2" caption="JS Objekti:" colspan="2">
					<grid name="grdObjektiRoba" key="JupiterObjectId" savelayout="true" dataname="dtObjekti" bestfitonrefresh="true" autopopulate="true" showcheckboxes="true">
						<fields>
							<field name="Naziv" caption="Jupiter Software objekt" />
							<field name="Parametar" />
							<field name="Ikona" />
							<field name="NivoSlozenosti" caption="Nivo složenosti" />
							<field name="Opis" />
							<field name="RobaId" hidden="false" showtotalsum="false" />
							<field name="Roba" />
							<field name="Sifra" caption="Šifra robe" />
							<field name="Klasa" caption="Aplikacija" />
							<field name="KomercijalniOpis" />
							<field name="Cijena" showtotalsum="false" />
							<field name="Operater" caption="Operater unosa" />
							<field name="DatumUnosa" />
							<field name="OperaterOdobravanja" caption="Operater odobravanja" />
							<field name="DatumOdobravanja" />
							<field name="Status" caption="Status" />
							<field name="Checked" caption="Default" edittype="bit" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<layout name="panel2">
			<group rows="2" cols="2">
				<columnsdefinition>
					<column size="60%" position="1" />
					<column size="40%" position="2" />
				</columnsdefinition>
				<item col="1" row="1">
					<labeledit value="Odaberite Robu s kojom želite spojiti Jupiter Software objekte:" fontsizedelta="1" fontbold="true" />
				</item>
				<item col="1" row="2">
					<grid name="grdRoba" key="RobaId" savelayout="true" dataname="dtRobaGrid" bestfitonrefresh="true" autopopulate="true">
						<fields>
							<field name="Checked" caption=" " editable="true" edittype="bit" fixwidth="50" />
							<field name="Roba" />
							<field name="Sifra" caption="Šifra robe" />
							<field name="Aplikacija" caption="Aplikacija" />
							<field name="KomercijalniOpis" />
							<field name="Cijena" showtotalsum="false" />
							<field name="RobaId" hidden="false" showtotalsum="false" />
						</fields>
						<event type="cellvaluechanged">
							<action type="variable value" value="$OdabranaRoba">
								<parameter value="#grdRoba.@RobaId" />
							</action>
							<action type="datarun reader" value="~dtRobaGrid" />
							<action type="control populate" value="#grdRoba" />
						</event>
					</grid>
				</item>
				<item col="2" row="1">
					<labeledit value="Odabir nove robe" fontsizedelta="1" fontbold="true" />
				</item>
				<item col="2" row="2" caption="Roba:">
					<textedit name="srcRobaNova" fieldtext="Roba" fieldvalue="RobaId">
						<event type="keydown">
							<action if="key==13">
								<action type="form open" value="frmRobaTrazilica">
									<parameter name="Naziv" value="#srcRobaNova" />
								</action>
								<action type="datarun reader" value="~dtRobaGrid" />
								<action type="control populate" value="#grdRoba" />
							</action>
						</event>
					</textedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpoji" caption="SPOJI" dock="left">
					<event type="click">
						<action type="confirm" value="Želite li spojiti sve odabrane Jupiter Software objekte na odabranu Robu?">
							<action type="datarun nonquery" value="~dtPromjenaRobe" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" />
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right">
					<event type="click">
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJSObjektiQuery" name="dtObjekti">
				<parameter name="@action" value="9" />
				<parameter name="@table" value="$SelectedId" />
			</data>
			<data command="spJSObjektiQuery" name="dtRobaGrid">
				<parameter name="@action" value="10" />
				<parameter name="@table" value="$SelectedId" />
				<parameter name="@RobaId" value="global.$NovaRobaId" />
				<parameter name="@SelectedRobaId" value="$OdabranaRoba" />
			</data>
			<data command="spTraziRoba" name="dtSearchRoba">
				<parameter name="@Action" value="Roba" />
				<parameter name="@uvjet" value="#srcRobaNova.text" />
			</data>
			<data command="spJSObjektiAzur" name="dtPromjenaRobe">
				<parameter name="@action" value="11" />
				<parameter name="@RobaId" value="$OdabranaRoba" />
				<parameter name="@table" value="#grdObjektiRoba.selectedids.table" />
				<parameter name="@OperateriId" value="@@OperateriId" />
			</data>
		</datalist>
	</form>
</root>
