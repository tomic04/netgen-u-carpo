<root version="1.0">

  <!--******************************************IMOVINA - NOVI UNOS****************************************-->
  <form name="frmNoviUnos" caption="$Caption" width="1500" >
    <event type="oninit">
      <!--iz pub varsa uzmi varset prema kojem će se prikazati tražilica ili textedit za izvorni dokument--> 
      <action type="datarun reader" value="~dtOSTraziIzvorniDok" />
      <action type="datarun reader" value="~dtOSTraziIzvorniDokValidate" />
      <action type="variable value" >
        <parameter name="Req" value="~dtOSTraziIzvorniDokValidate.@Postavka" />
      </action>
      <!--<action type="datarun reader" value="~dtSmjestajUnos" />-->
    </event>
    <event type="onload">
      <action type="datarun reader" value="~dtDatumPoc"  />
      <action type="control value" value="#datDatumPoc"  >
        <parameter value="~dtDatumPoc.@DatumOtp" />
      </action>
      <action type="control attribute" value="#cmbVrstaDokIzv">
        <parameter name="required" value="$Req"/>
      </action>
      <action type="control attribute" value="#srcBrojIzv">
        <parameter name="required" value="$Req"/>
      </action>
    </event>
    
    <layout textposition="left" >
      <!--glavna-->
      <group cols="3" rows="3" groupbordervisible="false">
        <!--osnovni podaci-->
        <group col="1" row="1" cols="2" rows="2" colspan="2" caption="Osnovni podaci" spacing="2,1,2,1"> 
          <!--osnovni- kolona 1 - grupa od 2 kolone i 8 redova - zbug buttona novi -->
          <group col="1" row="1" cols="3" rows="7" groupbordervisible="false">            
            <item caption="Inventurni broj:" col="1" row="1" highlight="false" colspan="2">
              <textedit name="txtInvBroj" required="true"/>
            </item>
            <item caption="Naziv:" col="1" row="2" highlight="false" colspan="3" >
              <textedit name="txtNaziv" required="true"/>
            </item>
            <item caption="Naziv2:" col="1" row="3" highlight="false" colspan="3">
              <textedit name="txtNaziv2" />
            </item>
            <item caption="Dobavljač:" col="1" row="4" highlight="false" colspan="3">
              <searchedit name="srcPartneri" fieldvalue="PartneriId" fieldtext="Naziv" dataname="~dtPartneri" />
            </item>
            <item caption="Vrsta:" col="1" row="5" highlight="false" colspan="3">
              <comboedit name="cmbVrsta"  valuefield="OSVrsteId" displayfield="Naziv" dataname="~dtVrste" />
            </item>
            <item caption="Serijski broj:" col="1" row="6" highlight="false" colspan="3">
              <textedit name="txtSerBroj" />
            </item>
            <item caption="Garažni broj:" col="1" row="7" highlight="false" colspan="3">
              <textedit name="txtGarBroj" />
            </item>
            <item caption="" col="3" row="1" >
              <button name="btnNoviInv"  caption="Novi inv.broj" type="add" >
                <event type="click">
                  <action type="datarun reader" value="~dtNoviBroj" />
                  <action type="control value" value="#txtInvBroj">
                    <parameter value="~dtNoviBroj.@InvBroj"/>
                  </action>
                </event>
              </button>
            </item>
          </group>
          <!--osnovni- kolona 2 -->
          <group col="2" row="1" cols="1" rows="7" groupbordervisible="false">
            <item caption="Status:" col="1" row="1" highlight="false" >
              <comboedit name="cmbStatus"  valuefield="OSStatusiId" displayfield="Naziv" dataname="~dtStatusi" allownull="false"/>
            </item>
            <item caption="JM:" col="1" row="2" highlight="false" >
              <comboedit name="cmbJM"  valuefield="JMId" displayfield="Naziv" dataname="~dtJM" allownull="false"/>
            </item>
            <item caption="Mjesto troška:" col="1" row="3" highlight="false" >
              <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" required="true"/>  
            </item>
            <item caption="Barcode:" col="1" row="4" highlight="false" >
              <textedit name="txtBarCode" />
            </item>
            <item caption="Broj šasije:" col="1" row="5" highlight="false">
              <textedit name="txtBrojSas" />
            </item>
            <item caption="Klasa:" col="1" row="6" highlight="false" >
              <comboedit name="cmbKlasa"  valuefield="OSKlaseId" displayfield="Naziv" dataname="~dtKlase" />
            </item>
          </group>
          <item caption="Opis:" col="1" row="2" highlight="false" colspan="2" >
            <textedit name="txtOpis" />
          </item>
        </group>

        <!--izvorni dokument i zaduženja - 1 kolona i 2 reda-->
        <group col="3" row="1" cols="1" rows="2" groupbordervisible="false" >
          <!--izvorni dokument-->
          <group col="1" row="1" cols="1" rows="5" caption="Izvorni dokument" fontbold="true" spacing="1,2,2,1">
            <item caption="Vrsta:" col="1" row="1" highlight="false" colspan="1">
              <comboedit name="cmbVrstaDokIzv"  valuefield="VrstaPromId" displayfield="Naziv" dataname="~dtVrstaDokIzv" />
            </item>
            <!--ukoliko je u pubvars upisana 0, na formi se prikazuje trazilica-->
            <group  col="1" row="2" cols="1" rows="1" if="~dtOSTraziIzvorniDok.@Postavka==0" groupbordervisible="false">
              <item caption="Broj:"  col="1" row="1" colspan="1">
                <textedit name="srcBrojIzv"   />
              </item>
            </group>
            <!--za sve ostale slučajeve, na formi se prikazuje textedit-->
            <group  col="1" row="2" cols="1" rows="1" else="" groupbordervisible="false">
              <item caption="Broj:"  col="1" row="1" colspan="1">
                <searchedit name="srcBrojIzv"  fieldvalue="Id" fieldtext="IzvBroj" dataname="~dtBrojIzv" />
              </item>
            </group>
            <!--<item caption="Broj:"  col="1" row="2" colspan="1">
              <searchedit name="srcBrojIzv"  fieldvalue="Id" fieldtext="IzvBroj" dataname="~dtBrojIzv" />
            </item>-->
            <item caption="Datum:" col="1" row="3" highlight="false">
              <dateedit name="datDatumIzv"  />
            </item>
            <item caption="Sa skladišta:" col="1" row="4" highlight="false" colspan="2">
              <searchedit name="srcSkladisteIzv"  fieldvalue="SkladisteId" fieldtext="Naziv" dataname="~dtSkladiste" />
            </item>
            <item caption="Roba:" col="1" row="5" highlight="false" colspan="2">
              <searchedit name="srcRobaIzv" fieldvalue="RobaId" fieldtext="Naziv" dataname="~dtRoba" />
            </item>            
          </group>
          <!--zaduženja-->
          <group col="1" row="2" cols="1" rows="3" caption="Zaduženja" fontbold="true" spacing="1,2,1,1">
            <item caption="Osoba:" col="1" row="1" highlight="false" colspan="2">
              <searchedit name="srcOsoba" fieldvalue="HRKadroviId" fieldtext="Naziv" dataname="~dtOsoba" />
            </item>
            <item caption="Lokacija:" col="1" row="2" highlight="false" colspan="2">
              <searchedit name="srcLokacija" fieldvalue="SmjestajId" fieldtext="Naziv" dataname="~dtLokacija" />
            </item>
            <item caption="Org.jedinica:" col="1" row="3" highlight="false" colspan="2">
              <searchedit name="srcOrgShemaZad"  fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShemaZad" />
            </item>
          </group>
        </group>
                
        <!--obračunski podaci-->
        <group cols="3" rows="1" col="1" row="2" colspan="3" caption="Obračunski podaci" spacing="2,2,1,1">
          <columnsdefinition>
            <column position="1" size="20%" />
            <column position="2" size="20%" />
            <column position="3" size="20%" />
          </columnsdefinition>
          <!--am.grupa i stope-->
          <group cols="1" rows="3" col="1" row="1" groupbordervisible="false">
            <item caption="Am. grupa:" col="1" row="1" highlight="false" >
              <comboedit name="cmbAmGrupa"  valuefield="OSGrupeId" displayfield="Naziv" dataname="~dtAmGrupa" allownull="false" >
                <!--na promjenu grupe puni formu-->
                <event type="valuechanged">
                  <action type="datarun reader" value="~dtPodaciZaGrupu"  />
                  <action type="control value" value="#txtRedovna"  >
                    <parameter value="~dtPodaciZaGrupu.@Redovna" />
                  </action>
                  <action type="control value" value="#txtUbrzana"  >
                    <parameter value="~dtPodaciZaGrupu.@Ubrzana" />
                  </action>
                  <action type="control value" value="#txtJednokratna"  >
                    <parameter value="~dtPodaciZaGrupu.@Jednokratna" />
                  </action>
                  <action type="control value" value="#txtUmanjena"  >
                    <parameter value="~dtPodaciZaGrupu.@Umanjena" />
                  </action>
                  <action type="control value" value="#srcNabava"  >
                    <parameter value="~dtPodaciZaGrupu.@KntNabaveId" text="~dtPodaciZaGrupu.@KontoN"/>
                  </action>
                  <action type="control value" value="#srcPriprema"  >
                    <parameter value="~dtPodaciZaGrupu.@KntPripremeId" text="~dtPodaciZaGrupu.@KontoP"/>
                  </action>
                  <action type="control value" value="#srcIspravak"  >
                    <parameter value="~dtPodaciZaGrupu.@KntIspravkaId" text="~dtPodaciZaGrupu.@KontoI"/>
                  </action>
                  <action type="control value" value="#srcTrosak"  >
                    <parameter value="~dtPodaciZaGrupu.@KntTroskaId" text="~dtPodaciZaGrupu.@KontoT"/>
                  </action>
                </event>
              </comboedit>
            </item>
            <item caption="Tip stope:" col="1" row="2" highlight="false" >
              <comboedit name="cmbStopaTip"  valuefield="StopaTip" displayfield="Naziv" dataname="~dtStopaTip" allownull="false"/>
            </item>
            <!--stope amortizacije-->
            <group cols="2" rows="2" col="1" row="3" groupbordervisible="false">
              <item caption="Redovna:"  col="1" row="1" >
                <textedit name="txtRedovna" format="n2" value="0"/>
              </item>
              <item caption="Ubrzana:"  col="1" row="2" >
                <textedit name="txtUbrzana" format="n2" value="0"/>
              </item>
              <item caption="Umanjena:"  col="2" row="1" >
                <textedit name="txtUmanjena" format="n2" value="0"/>
              </item>
              <item caption="Jednokratna:"  col="2" row="2" >
                <textedit name="txtJednokratna" format="n2" value="0"/>
              </item>
            </group>
          </group>
          <!--konta-->
          <group cols="1" rows="4" col="2" row="1" groupbordervisible="false">
            <item caption="Konto nabave:" col="1" row="1" highlight="false" >
              <searchedit name="srcNabava" fieldvalue="KntPlanAId" fieldtext="Naziv" dataname="~dtNabava" />
            </item>
            <item caption="Konto pripreme:" col="1" row="2" highlight="false" >
              <searchedit name="srcPriprema" fieldvalue="KntPlanAId" fieldtext="Naziv" dataname="~dtPriprema" />
            </item>
            <item caption="Konto ispravka:" col="1" row="3" highlight="false" >
              <searchedit name="srcIspravak" fieldvalue="KntPlanAId" fieldtext="Naziv" dataname="~dtIspravak" />
            </item>
            <item caption="Konto troška:" col="1" row="4" highlight="false" >
              <searchedit name="srcTrosak" fieldvalue="KntPlanAId" fieldtext="Naziv" dataname="~dtTrosak" />
            </item>
          </group>
          <!--datumi-->
          <group cols="1" rows="4" col="3" row="1" colspan="3" groupbordervisible="false">
            <item caption="Datum nabave:" col="1" row="1" highlight="false" required="true">
              <dateedit name="datDatumNab"  value="now" >
                <event type="valuechanged">
                  <action type="control value" value="#datDatumAkt"  >
                    <parameter value="#datDatumNab" />
                  </action>
                </event>
              </dateedit>
            </item>
            <item caption="Datum aktivacije:" col="1" row="2" highlight="false" >
              <dateedit name="datDatumAkt" value="now" allownull="true">
                <event type="valuechanged">
                  <action type="datarun reader" value="~dtDatumPoc"  />
                  <action type="control value" value="#datDatumPoc"  >
                    <parameter value="~dtDatumPoc.@DatumOtp" />
                  </action>
                </event>                  
              </dateedit>
            </item>
            <item caption="Datum početka otpisa:" col="1" row="3" highlight="false" >
              <dateedit name="datDatumPoc" allownull="true"/>
            </item>
          </group>
        </group>
        
        <!--dodatni podaci-->
        <group cols="6" rows="3" col="1" row="3" colspan="2" spacing="2,2,1,2">
          <columnsdefinition>
            <column position="1" size="20%" />
            <column position="3" size="20%" />
            <column position="6" size="20%" />
          </columnsdefinition>
          <item caption="Nabavna vrijednost:"  col="1" row="1" colspan="2">
            <textedit name="txtNabVr" format="n2" value="0">
              <event type="valuechanged">
                <action type="control value" value="#txtOsnAm"  >
                  <parameter value="#txtNabVr" />
                </action>
              </event>
            </textedit>
          </item>
          <item caption="Osnovica za amortizaciju:"  col="1" row="2" colspan="2" >
            <textedit name="txtOsnAm" format="n2" value="0"/>
          </item>
          <item caption="Otpisana vrijednost:"  col="1" row="3" colspan="2">
            <textedit name="txtOtpVr" format="n2" value="0"/>
          </item>
          <item caption="Vrsta dokumenta:" col="3" row="1" highlight="false" colspan="3">
            <comboedit name="cmbVrstaDok"  valuefield="VrstaDokId" displayfield="Naziv" dataname="~dtVrstaDok" allownull="false"/>
          </item>
          <item caption="Odgovorna osoba:" col="3" row="2" highlight="false" colspan="3">
            <searchedit name="srcOdgOsoba" fieldvalue="OsobeId" fieldtext="Naziv" dataname="~dtOdgOsoba" />
          </item>
          <item caption="Količina:"  col="6" row="1" >
            <textedit name="txtKolicina" format="n2" value="1"/>
          </item>
          <item caption="Količina za unos:"  col="6" row="2" >
            <textedit name="txtKolUnos" format="n0" value="1" tooltip="Ukoliko želite multiplicirati ovaj inv.broj, unesite željenu količinu (cijeli broj)!"/>
          </item>
        </group>

      </group>
    </layout>
    
    <!--panelbuttoni spremi i odustani-->
    <panelbuttons>
      <buttons>
        <button name="btnSpremiNovi" caption="Spremi" type="add" >
          <event type="click">
            <action type="validate"/>
            <action type="datarun reader" value="~dtKontrola"/>
            <action type="confirm" value="Da li ste sigurni da želite spremiti imovinu?" if="~dtKontrola.@Id==0">
              <!--reader jer vracam poruku i id kako bi refreshala grid ukoliko prode spremanje bez greske-->
              <action type="datarun reader" value="~dtSpremi"  waittype="progress" waitcaption="Pričekajte..." waittext="..spremanje u tijeku...">
                <!--<parameter name="Poruka"/>-->
              </action>
              <!--<action type="message" value="{$Poruka}" />-->
             <action type="message" value="~dtSpremi.@Poruka" />
            </action>
            <action type="message" value="~dtKontrola.@Poruka" else="~dtKontrola.@Id!=0"/>     
            <action type="control refreshvalue" value="##" if="~dtSpremi.@IndGreska==0"/>
            <action type="control populate" value="parent.#grdImovina" if="~dtSpremi.@IndGreska==0"/> 
          </event>
        </button>
        
        <button name="btnOdustani"  caption="Odustani" type="cancel" dock="right" >
          <event type="click">
          </event>
        </button>
      </buttons>
    </panelbuttons>
  
    <datalist>
      <!--punjenje comba i trazilica-->
      <data command="spOSImovina_HelpCP" name="dtPartneri">
         <parameter name="@Action" value="Dobavljaci_src"/>
         <parameter name="@Tekst" value="#srcPartneri.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtOrgShema">
         <parameter name="@Action" value="OrgShema_src"/>
         <parameter name="@Tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtNabava">
         <parameter name="@Action" value="Konto_src"/>
         <parameter name="@Tekst" value="#srcNabava.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtPriprema">
         <parameter name="@Action" value="Konto_src"/>
         <parameter name="@Tekst" value="#srcPriprema.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtIspravak">
         <parameter name="@Action" value="Konto_src"/>
         <parameter name="@Tekst" value="#srcIspravak.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtTrosak">
         <parameter name="@Action" value="Konto_src"/>
         <parameter name="@Tekst" value="#srcTrosak.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtOdgOsoba">
         <parameter name="@Action" value="OdgOsoba_src"/>
         <parameter name="@Tekst" value="#srcOdgOsoba.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtOsoba">
         <parameter name="@Action" value="Osoba_src"/>
         <parameter name="@Tekst" value="#srcOsoba.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtLokacija">
         <parameter name="@Action" value="Lokacija_src"/>
         <parameter name="@Tekst" value="#srcLokacija.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtBrojIzv">
        <parameter name="@Action" value="Broj_src"/>
        <parameter name="@Tekst" value="#srcBrojIzv.text"/>
        <parameter name="@VrstaPromId" value="#cmbVrstaDokIzv.@VrstaPromId"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtSkladiste">
        <parameter name="@Action" value="Skladiste_src"/>
        <parameter name="@Tekst" value="#srcSkladisteIzv.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtRoba">
        <parameter name="@Action" value="Roba_src"/>
        <parameter name="@Tekst" value="#srcRobaIzv.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtOrgShemaZad">
         <parameter name="@Action" value="OrgShema_src"/>
         <parameter name="@Tekst" value="#srcOrgShemaZad.text"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtVrste">
         <parameter name="@Action" value="Vrste_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtStatusi">
         <parameter name="@Action" value="Status_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtJM">
         <parameter name="@Action" value="JM_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtAmGrupa">
         <parameter name="@Action" value="AmGrupe_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtStopaTip">
         <parameter name="@Action" value="StopaTip_cmb"/>
      </data>  
      <data command="spOSImovina_HelpCP" name="dtVrstaDok">
         <parameter name="@Action" value="VrstaDok_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtVrstaDokIzv">
        <parameter name="@Action" value="IzvorniDok_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtKlase">
        <parameter name="@Action" value="Klase_cmb"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtDatumPoc">
        <parameter name="@Action" value="Datum_otpisa"/>
        <parameter name="@DatumAkt" value="#datDatumAkt.@DatumAkt"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtPodaciZaGrupu">
        <parameter name="@Action" value="Podaci_grupa"/>
        <parameter name="@OSGrupeId" value="#cmbAmGrupa.@OSGrupeId"/>
      </data>
      <!--pokupi pubvars-->
      <data command="spOSImovina_HelpCP" name="dtOSTraziIzvorniDok">
        <parameter name="@Action" value="OSTraziIzvorniDok"/>
      </data>
      <data command="spOSImovina_HelpCP" name="dtOSTraziIzvorniDokValidate">
        <parameter name="@Action" value="OSIzvorniDokValidate"/>
      </data>
      <!--update podataka-->
      <data command="spOSImovina_AzurCP" name="dtNoviBroj">
        <parameter name="@Action" value="InventurniBroj"/>
      </data>
      <data command="spOSImovina_AzurCP" name="dtKontrola">
        <parameter name="@Action" value="Kontrola_spremanja"/>
        <parameter name="@KolUnos" value="#txtKolUnos"/>
        <parameter name="@Kolicina" value="#txtKolicina"/>
        <parameter name="@InvBroj" value="#txtInvBroj"/>
        <parameter name="@DatumNab" value="#datDatumNab"/>
        <parameter name="@DatumAkt" value="#datDatumAkt"/> 
        <parameter name="@OsnAm" value="#txtOsnAm"/>  
        <parameter name="@NabVr" value="#txtNabVr"/>    
      </data> 
      <data command="spOSImovina_AzurCP" name="dtSpremi">
        <parameter name="@Action" value="Insert"/>
        <parameter name="@SerBroj" value="#txtSerBroj"/>
        <parameter name="@InvBroj" value="#txtInvBroj"/>
        <parameter name="@BarCode" value="#txtBarCode"/>
        <parameter name="@Naziv2" value="#txtNaziv2"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Opis" value="#txtOpis"/>     
        <parameter name="@DobavljacId" value="#srcPartneri"/>
        <parameter name="@OSVrsteId" value="#cmbVrsta"/>
        <parameter name="@OSKlaseId" value="#cmbKlasa"/>
        <parameter name="@DatumNab" value="#datDatumNab"/>
        <parameter name="@DatumAkt" value="#datDatumAkt"/>
        <parameter name="@DatumPoc" value="#datDatumPoc"/> 
        <parameter name="@JMId" value="#cmbJM"/>
        <parameter name="@RobaId" value="#srcRobaIzv"/>
        <parameter name="@SkladisteId" value="#srcSkladisteIzv"/>
        <parameter name="@Kolicina" value="#txtKolicina" type="decimal"/>
        <parameter name="@GarBroj" value="#txtGarBroj"/>      
        <parameter name="@BrojSas" value="#txtBrojSas"/>
        <parameter name="@NabVr" value="#txtNabVr"/>    
        <parameter name="@KolUnos" value="#txtKolUnos" type="decimal"/>
        <parameter name="@OperateriInsertId" value="@@OperateriId"/>
        <parameter name="@VrstaDokId" value="#cmbVrstaDok"/>    
        <parameter name="@OsobeId" value="#srcOdgOsoba"/>  
        <parameter name="@DatumIzv" value="#datDatumIzv"/>
        <parameter name="@IzvBroj" value="#srcBrojIzv.@IzvBroj" />
        <parameter name="@OrgShemaO" value="#srcOrgShemaZad"/>  
        <parameter name="@OrgShemaT" value="#srcOrgShema"/>  
        <parameter name="@OsnAm" value="#txtOsnAm"/>  
        <parameter name="@OtpVr" value="#txtOtpVr"/>        
        <parameter name="@OSGrupeId" value="#cmbAmGrupa"/>  
        <parameter name="@StopaTip" value="#cmbStopaTip"/>      
        <parameter name="@Redovna" value="#txtRedovna" type="decimal"/>      
        <parameter name="@Ubrzana" value="#txtUbrzana" type="decimal"/>      
        <parameter name="@Jednokratna" value="#txtJednokratna" type="decimal"/>      
