<root>
	<!--
  Komentari:
  08.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmOpci_VB" caption="Izmjena podataka za {parent.#txtPrezime} {parent.#txtIme}" width="400" height="400" >
		<event type="init">
			<action  type="datarun reader" value="~dtOpcePodatke" if="$HRKadroviId!=0"/>
		</event>
		<event type="shown">
			<action if="$Tip=='Izmjena'">
				<action type="control value" value="#srcPoreznaOpcina">
					<parameter text="~dtOpcePodatke.@PoreznaOpcina" value="~dtOpcePodatke.@PoreznaOpcinaId" />
				</action>
				<action type="control disable" value="#dtDatumPZaposlenja" if="~dtOpcePodatke.@DatumPrvogZaposlenja==null"></action> 
				<action type="control disable" value="#dtDatumPZaposlenjaGrupa" if="~dtOpcePodatke.@DatumZaposlenjaGrupa==null"></action> 
				<action if="~dtOpcePodatke.@DatumPrvogZaposlenja==null">
					<action type="control value" value="#dtDatumPZaposlenja" >
						<parameter value="now" />
					</action>
				</action>
				<action if="~dtOpcePodatke.@DatumZaposlenjaGrupa==null">
					<action type="control value" value="#dtDatumPZaposlenjaGrupa" >
						<parameter value="now" />
					</action>
				</action>
			</action> 
		</event>
		<layout>
			<group cols="1" rows="2" caption="Opći podaci" groupbordervisible="true">
				<group cols="4" rows="3" groupbordervisible="true" col="1" row="1" spacing="2,2,2,1">
					<columnsdefinition>
						<column  position="1" size="150" /> 
						<column  position="2" size="150" />  
						<column  position="3" size="150" /> 
						<column  position="4" size="50" />  
					</columnsdefinition>
					<item row="1" col="1" highlight="false" caption="Ime:">
						<textedit name="txtIme" datavalue="~dtGetOpcePodatke.@Ime" />
					</item>
					<item row="1" col="2" caption="Ime roditelja:" highlight="false">
						<textedit name="txtImeR" datavalue="~dtGetOpcePodatke.@ImeRoditelja" />
					</item>
					<item row="1" col="3" caption="Matični broj:" highlight="false" >
						<textedit name="txtMaticniBroj" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@MaticniBroj" />
					</item>
					<item row="1" col="4" highlight="false" >
						<button name="btnUnos" caption="Novi"> 
							<event type="click">   
								<action type="form open" value="frmStavkeZaObracun"> 
									<parameter name="Caption" value="Stavke za obračun za {parent.#grdMaster.@Prezime} {parent.#grdMaster.@Ime}"/>		  
									<parameter name="HRKadroviId" value="$HRKadroviId" />	
								</action> 								
							</event>   
						</button>
					</item>
					<item row="2" col="1" caption="Prezime:" highlight="false" >
						<textedit name="txtPrezime" datavalue="~dtGetOpcePodatke.@Prezime" />
					</item>
					<item row="2" col="2" caption="Djevojačko prezime:" highlight="false" >
						<textedit name="txtDjPrezime" datavalue="~dtGetOpcePodatke.@DjevojackoPrezime" />
					</item>
					<item row="2" col="3" caption="Ident. broj:" highlight="false" colspan="2">
						<textedit name="txtIdentBroj" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@IdentBroj" />
					</item>
					<item row="3" col="1" caption="JMBG:" highlight="false" >
						<textedit name="txtJMBG" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@JMBG" />
					</item>
					<item row="3" col="2" caption="OIB:" highlight="false" >
						<textedit name="txtOIB" format="[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@OIB" />
					</item>

					<item row="3" col="3" caption="Datum rođenja:" highlight="false" >
						<dateedit name="dtDatumRodjenja" value="now" allownull="true" datavalue="~dtGetOpcePodatke.@DatumRodenja">
						</dateedit>
					</item>
					<item row="3" col="4" caption="Spol:" highlight="false" >
						<textedit name="txtSpol" format="[M]|[Ž]|[Z]" formattype="regex" tooltip="Možete upisati samo 'M' ili 'Ž' (Z)" datavalue="~dtGetOpcePodatke.@Spol" />
					</item>

				</group>
				<group cols="4" rows="6" groupbordervisible="true" col="1" row="2" spacing="2,2,1,2">
					<columnsdefinition>
						<column  position="1" size="150" /> 
						<column  position="2" size="150" />  
						<column  position="3" size="180" /> 
						<column  position="4" size="20" />  

					</columnsdefinition>
					<item row="1" col="1" highlight="false" caption="Mjesto rođenja:" colspan="2">
						<comboedit name="cmbMjestoRodjenja" valuefield="mjestaid" displayfield="naziv" dataname="~dtMjestoRodjenja" datavalue="~dtGetOpcePodatke.@MjestoRodenjaId"/>
					</item>
					<item row="1" col="3" caption="Mjesto rođenja:" highlight="false" >
						<textedit name="txtMjestoR" datavalue="~dtGetOpcePodatke.@MjestoRodenja"/>
					</item>
					<item row="1" col="4" highlight="false">
					<button name="btnUnos" image="add" imagelocation="middlecenter"> 
					<event type="click">   
					<action type="form open" value="frmMjesta"> 
					<parameter name="Caption" value="Mjesta"/>		  	
					</action> 								
					</event>   
					</button>
					</item>
					<item row="2" col="1" highlight="false" caption="Mjesto prebivanja:" colspan="2">
						<searchedit name="srcMjestoPrebivanja" dataname="~dtMjestoPrebivanja" fieldtext="Naziv" fieldvalue="mjestaid"  >
							<!-- AKO JE UNESENO MJESTO PREBIVANJA U TRAŽILICU, DA NAPUNI COMBO SA ULICAMA IZABRANOG MJESTA PREBIVANJA-->
							<event type="valuechanged">
								<action if="#srcMjestoPrebivanja!=null">
									<action type="datarun reader" value="dtUlice">
										<action type="control populate" value="#cmbUlica" />
									</action>
								</action>
								<action else="">
									<action type="control populate" value="#cmbUlica" />
								</action>
							</event>
						</searchedit>
					</item>
					<item row="2" col="4" highlight="false">
					<button name="btnUnos" image="add" imagelocation="middlecenter"> 
					<event type="click">   
					<action type="form open" value="frmStavkeZaObracun"> 
					<parameter name="Caption" value="Stavke za obračun za {parent.#grdMaster.@Prezime} {parent.#grdMaster.@Ime}"/>		  
					<parameter name="HRKadroviId" value="$HRKadroviId" />	
					</action> 								
					</event>   
					</button>
					</item>
					<item row="3" col="1" highlight="false" caption="Ulica:" colspan="2">
						<comboedit name="cmbUlica" valuefield="Uliceid" displayfield="Naziv" dataname="~dtUlica" datavalue="~dtGetOpcePodatke.@UliceId"/>
					</item>
					<item row="3" col="4" highlight="false">
						<button name="btnUnos" image="add" imagelocation="middlecenter"> 
							<event type="click">   
								<action type="form open" value="frmUnosUlice1"> 



								</action> 							
								<action type="datarun reader" value="dtUlice">
									<action type="control populate" value="#cmbUlica" />

								</action>	
							</event>   
						</button>
					</item>
					<item row="4" col="1" caption="Kućni broj:" highlight="false" >
						<textedit name="txtKucniBroj"  format="[a-z0-9][a-z0-9][a-z0-9][a-z0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@KucniBroj" />
					</item>
					<item row="4" col="2" caption="Kućni broj dodatak:" highlight="false">
						<textedit name="txtKucniBrojD" format="[a-z0-9][a-z0-9][a-z0-9][a-z0-9]" formattype="regex" datavalue="~dtGetOpcePodatke.@KucniBrojDodatak" />
					</item>
					<item row="4" col="3" highlight="false" caption="Državljanstvo:" colspan="2">
						<comboedit name="cmbDrzavljanstvo" valuefield="hrdrzavljanstvoid" displayfield="naziv" dataname="~dtDrzavljanstvo" datavalue="~dtGetOpcePodatke.@HRDrzavljanstvoId"/>
					</item>
					<item row="5" col="1" highlight="false" caption="Nacionalnost:" colspan="2">
						<comboedit name="cmbNacionalnost" valuefield="hrnacionalnostid" displayfield="naziv" dataname="~dtNacionalnost" datavalue="~dtGetOpcePodatke.@HRNacionalnostId"/>
					</item>
					<item row="5" col="3" highlight="false" caption="Smještaj:" colspan="2">
						<comboedit name="cmbSmjestaj" valuefield="SmjestajId" displayfield="naziv" dataname="~dtSmjestaj" datavalue="~dtGetOpcePodatke.@SmjestajId"/>
					</item>
					<item row="6" col="1" caption="Opis:" highlight="false" colspan="4" >
						<memoedit name="memOpis"  datavalue="~dtGetOpcePodatke.@Memo">
						</memoedit>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left">
					<event type="click">
						<action type="validate"/>
						<action if="$hrkadroviid!=0">
							<action type="datarun reader" value="~dtIzmjenaDjelatnika"/>
							<action if="$indGreske==0">
								<action type="control populate" value="parent.#grdPodaci"/>	
								<action type="message" value="Uspješno spremljeno!"/>

								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
							<!-- AKO OIB NIJE ISPRAVAN FOKUSIRA SE NA POLJE ZA OIB PRILIKOM IZMJENE-->
							<action if="$indGreske==1">
								<action type="control focus" value="#txtOIB" >
									<parameter value="~dtIzmjenaDjelatnika.@OIB" />
								</action>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRHelp" name="dtDrzavljanstvo">
				<parameter name="@action" value="drzavljanstvo"/>
			</data>
			<data command="spHRHelp" name="dtNacionalnost">
				<parameter name="@action" value="nacionalnost"/>
			</data>
			<data command="spHRHelp" name="dtMjestoRodjenja">
				<parameter name="@action" value="mjesto_rodenja"/>
			</data>
			<data command="spHRHelp" name="dtMjestoPrebivanja">
				<parameter name="@action" value="mjesto_prebivanja"/>
				<parameter name="@tekst" value="#srcMjestoPrebivanja.text"/>
			</data>
			<data command="spHRHelp" name="dtUlica">
				<parameter name="@action" value="ulica"/>
			</data>
			<data command="spHRHelp" name="dtSmjestaj">
				<parameter name="@action" value="smjestaj"/>
			</data>


			<data command="spHRManagerMaster_Podaci_Opci_CP" name="dtOpcePodatke">
				<parameter name="@action" value="getOpcePodatke" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Opci_CP" name="dtAdrese">
				<parameter name="@action" value="grid_adrese" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Opci_CP" name="dtKontakti">
				<parameter name="@action" value="grid_kontakti" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Opci_CP" name="dtOlaksica">
				<parameter name="@action" value="grid_olaksica" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_RadnaKnjizica_CP" name="dtZvanja">
				<parameter name="@action" value="grid_zvanja" />
				<parameter name="@hrkadroviid" value="$HRKadroviId" type="int"/>
			</data>
			<data command="spHRManagerMaster_Podaci_Opci_CP" name="dtIzmjenaDjelatnika">
				<parameter name="@action" value="izmjena_kadra"/>
				<parameter name="@hrkadroviid" value="$HRKadroviId"/>
				<parameter name="@Ime" value="#txtIme"/>
				<parameter name="@Prezime" value="#txtPrezime"/>
				<parameter name="@MaticniBroj" value="#txtMaticniBroj"/>
				<parameter name="@OIB" value="#txtOIB"/>
				<parameter name="@JMBG" value="#txtJMBG"/>
				<parameter name="@datumrodenja" value="#dtDatumRodjenja"/>
				<parameter name="@spol" value="#txtSpol"/>
				<parameter name="@mjestorodenjaid" value="#cmbMjestoRodjenja"/>
				<parameter name="@mjestorodenja" value="#txtMjestoRTekst"/>
				<parameter name="@hrdrzavljanstvoid" value="#cmbDrzavljanstvo"/>
				<parameter name="@hrnacionalnostid" value="#cmbNacionalnost"/>
				<parameter name="@datumdolaska" value="#dtDatumZaposlenja"/>
				<parameter name="@prvozaposlenje" value="#txtBrOsiguranja"/>
				<parameter name="@hrrazlogdolaskaid" value="#cmbRazlogZaposlenja"/>
				<parameter name="@napomenadolaska" value="#txtNapomena"/>
				<parameter name="@oopvrsteracunaid" value="#cmbVrstaRedovniRacun"/>
				<parameter name="@ziroracun" value="#txtBrojRRacuna"/>
				<parameter name="@bankaid" value="#cmbBankaRRacuna"/>		
				<parameter name="@oopvrsteracuna2id" value="#cmbVrstaZRacuna"/>
				<parameter name="@ziro2racun" value="#txtBrojZRacuna"/>
				<parameter name="@banka2id" value="#cmbBankaZRacuna"/>
				<parameter name="@stazprije" value="#txtUkupno"/>
				<parameter name="@stazufirmi" value="#txtKodNas"/>
				<parameter name="@stazzajubilarnu" value="#txtZaJub"/>
				<parameter name="@stazzaminulirad" value="#txtZaMinuliRad"/>
				<parameter name="@osobnibroj" value="#txtOsobniBroj"/>
				<parameter name="@mboo" value="#txtMBOsiguraneOsobe"/>
				<parameter name="@postotakinvalidnosti" value="#txtPostotak"/>
				<parameter name="@hrinvalidnostvrsteid" value="#cmbVrstaInvalidnosti"/>
				<parameter name="@ooprelacijeid" value="#cmbRelacija"/>
				<parameter name="@PoreznaOpcinaId" value="#srcPoreznaOpcina"/>
				<parameter name="@djevojackoprezime" value="#txtDjevojackoPrezime"/>
				<parameter name="@imeroditelja" value="#txtImeR"/>
				<parameter name="@datumprvogzaposlenja" value="#dtDatumPZaposlenja"/>
				<parameter name="@datumzaposlenjagrupa" value="#dtDatumPZaposlenjaGrupa"/>
				<parameter name="@hrrazlogoslodopid" value="#txtBrOsiguranja"/>
				<parameter name="@hrtituleid" value="#cmbTitula"/>			
				<parameter name="@brojrk" value="#txtBrOsobneIskaz"/>
				<parameter name="@oibroj" value="#txtBrRadneK"/>
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>

</root>