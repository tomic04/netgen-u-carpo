<root>
  <form name="frmMultiDop" caption ="$caption"  width="970" height="600">

  <event type="load">
    <action type="control caption" value="#btnSpremi" if="$tip==brisanje">
      <parameter value="Obriši označene"/>
    </action>
  </event>

  <layout>
    <group cols="1" rows="2" caption="Doprinosi">

      <item col="1" row="1" highlight="False" rowspan="2">
        <grid name="grdDoprinosi" showgrouppanel="true" showfooter="False" autopopulate="true" showcheckboxes="true" bestfitonrefresh="true" key="LnOOPssddetid">
          <data command="spLnOOPSSDQuery">
            <parameter name="@Action" value="doprinosi_svi_izmjena" type="string"/>
          </data>
        </grid>
      </item>


    </group>
  </layout>

  <panelbuttons>
    <buttons>
      <button name="btnSpremi" caption="Izmijeni označene">

        <event type="click">
          <!-- Okini storu -->
          <!--<action type="message" value="selectedids"/>
            <action type="message" value="#grdDoprinosi.selectedids"/>-->

          <action type="form open" value="frmIzmjenaDop" if="$tip==Izmjena">
            <parameter name="caption" value="Izmjena parametara za doprinos '{$doprinosNaziv}'" type="string" />
            <parameter name="OOPDoprinosiId" value="#grdDoprinosi.@OOPDoprinosiId" />
            <parameter name="doprinosNaziv" value="$doprinosNaziv" />
          </action>

          <action type="datarun reader" value="~dtBrisanjeDop" if="$tip==Brisanje"/>
          <action type="message" value="~dtBrisanjeDop.@poruka" if="$tip==Brisanje"/>

          <!-- Osvježi grid na parent formi -->
          <action type="control populate" value="parent.#grdDoprinosiStavka"/>
          <action type="control populate" value="parent.#grdDoprinosiRaspolozivi"/>

          <!--zatvori formu-->
          <action type="form close" />

        </event>

      </button>

      <button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
    </buttons>
  </panelbuttons>

  <datalist>

    <data command="spLnOOPSSDDetAzur" name="dtBrisanjeDop">
      <parameter name="@Action" value="brisanje" type="string"/>
      <parameter name="@OperateriId" value="@@OperateriId" />
      <parameter name="@table" value="#grdDoprinosi.selectedids.table"/>
    </data>


  </datalist>

</form>

</root>