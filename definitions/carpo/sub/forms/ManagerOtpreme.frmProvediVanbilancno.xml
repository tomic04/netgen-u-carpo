<root>
    <form name="frmProvediVanbilancno" caption="Provedi vanbilančno" fixedsize="false">	
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group rows="2" cols="1" row="1" col="1" entermovenextcontrol="true">
					<item caption="Skladište:" row="1" col="1">
						<comboedit name="cmbSkladisteVB" valuefield="SkladisteId" displayfield="Opis" datavalue="" dataname="dtSkladisteVB" required="true" allownull="false"/>
					</item>	
					<item caption="Vrsta dokumenta:" row="2" col="1">
						<comboedit name="cmbVrstaDokVB" valuefield="VrstaDokId" displayfield="Opis" datavalue="#dtVrstaDokVB.@VrstaDokId" dataname="dtVrstaDokVB" required="true" allownull="false"/>
					</item>					
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="PROVEDI" type="add" dock="left">
                    <event type="click">
                        <action type="validate" />
                        <action type="datarun nonquery" value="~dtProvediVB"/>
						<action type="control populate keepfocus" value="parent.#grdGlava" />
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
			<data command="spNG_Combo" name="dtSkladisteVB">
				<parameter name="@Action" value="skladiste" />
				<parameter name="@Ind" value="1" />
				<parameter name="@filter_kolona" value="MetodaRobnoMat" />
				<parameter name="@filter_vrijednost" value="N" />
			</data>
			<data command="spNG_Combo" name="dtVrstaDokVB">
				<parameter name="@Action" value="VrstaDok" />
				<parameter name="@Oznaka" value="01" />
			</data>
			<data command="spProNOtpGla_Vanbilancno" name="dtProvediVB">
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@SkladisteId" value="#cmbSkladisteVB" />
				<parameter name="@VrstaDokId" value="#cmbVrstaDokVB" />
				<parameter name="@OperateriId" value="@@OperateriId" />
			</data>				
        </datalist>
    </form>
</root>