<root>
	<form name="frmMailingLista" caption="Postavke">
    <event type="load">
        <action type="control populate" value="#grdSubscriptionList"/>
    </event>
    <layout>
        <group cols="1" rows="1">
            <item row="1" col="1" height="400" width="300">
                <grid name="grdSubscriptionList" dataname="~dtGetComponents">
                    <event type="showingeditor">
                        <action type="editor allow" value="true"/>
                    </event>
                    <fields inherited="true">
                        <field name="Pretplata" editable="true" edittype="bit"/>
                        <field name="Opis" maxwidth="300" visible="false"/>
                    </fields>
                    <event type="cellvaluechanged">
                        <action type="datarun nonquery" value="~dtAddRemove"/>
                    </event>
                </grid>
            </item>
        </group>
    </layout>
    <panelbuttons>
        <buttons>
            <button name="btnOdustani" caption="Zatvori" dock="right" tabstop="false">
                <event type="click">
                    <action type="formclose"/>
                </event>
            </button>
        </buttons>
    </panelbuttons>
    <datalist>
        <data command="spComponentTracker" name="dtGetComponents">
            <parameter name="@Action" value="getComponents" />
			<parameter name="@Login" value="@@login" />
        </data>
        <data command="spComponentTrackerAzur" name="dtAddRemove">
            <parameter name="@Action" value="mailAddRemove" />
            <parameter name="@ComponentId" value="#grdSubscriptionList.@id" />
        </data>
    </datalist>
    </form>
</root>