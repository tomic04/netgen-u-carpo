<root>
  <!--FORMA ZA UNOS/IZMJENU OBRADE-->

  <form name="frmPregledVirman" caption="$caption" width="800" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtGridGore"></action>
    </event>

    <event type="load">
      <action type="control populate" value="#grdGore"></action>

    </event>

    <layout>
      <group cols="1" rows="10" groupbordervisible="false">

        <item caption="Pregled virmana" col="1" row="1" rowspan="10" textposition="top">
          <grid name="grdGore" key="VirmaniId" dataname="~dtGridGore" preventfocusgroup="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="true" showgroupsum="true" showfooter="true">
            <fields inherited="true"></fields>
          </grid>
        </item>
      </group>


      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spDDPregledVirman_CP" name="dtGridGore">
        <parameter name="@Action" value="grid" type="string" />
        <parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@oopisobradeid" value="global.$OOPisObradeId" />
      </data>


    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>