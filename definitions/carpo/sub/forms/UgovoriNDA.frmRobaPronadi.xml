<root>
	<form name="frmRobaPronadi" caption="Pronađi robu" width="350" height="450">
		<event type="init">
			<action type="datarun reader" value="Global.~dtGet">
				<parameter value="@PosUgovoriglaId" />
			</action>
			<!-- <action type="datarun reader" value="Global.~dtDetaljStavke">
				<parameter value="@PosUgovoriDetId" />
			</action> -->
		</event>
		<event type="load">
			<action type="control refreshvalue" value="#grdRobaPovezi" />
			<action type="control populate" value="#grdRobaPovezi" if="$Izmjena==1"/>
		</event>
		<layout>
			<group cols="2" rows="5" bordervisible="false">
				<item caption="Naslov" col="1" row="1" highlight="false" colspan="2">
					<!-- <searchedit name="txtNaslov" datavalue="#dtGet.@Broj" nulltext="&lt;naslov&gt;"/> -->
					<searchedit netgenfields="true" name="srcRoba" required="true" fontbold="true" dataname="dtRoba" fieldtext="NazivId" fieldvalue="RobaId" datavalue="#dtGet.@RobaId" datatext="#dtGet.@Naziv" />
				</item>
				<item col="1" row="2" rowspan="4">
					<grid type="master" name="grdRobaPovezi" dataname="dtRobaPovezana" key="LnPosUgovori_LnRobaId">						<!-- key="LnPosUgovori_LnRobaId"-->
						<!-- <action type="control populate" value="#grdRobaPovezi" /> -->
						<fields inherited="true">
							<field name="Naziv" caption="Roba" width="250" />
							<field name="UserId" caption="Šifra" visible="true" fontbold="true"/>
							<!-- <field name="RobaKod" caption="RobaKod" /> -->
						</fields>
					</grid>
				</item>
				<item col="2" row="2" height="50" width="50">
					<button name="btnOdaberi" type="add" image="add" imagelocation="middlecenter">
						<event type="click">
							<action type="validate" />
							<action type="datarun scalar" value="~dtRobaUnos">
								<parameter name="LnPosUgovori_LnRobaId" />
							</action>
							<action type="control populate" value="#grdRobaPovezi" />
							<action type="control focus" value="#grdRobaPovezi">
								<parameter value="$LnPosUgovori_LnRobaId" type="int" />
							</action>
							<action type="control refreshvalue" value="#srcRoba" />
							<action type="control focus" value="srcRoba" />
						</event>
					</button>
					<!-- <button caption="SPREMI1" type="add" dock="right">
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="Global.~dtEdit" if="$PosUgovoriglaId!=null"/>
            <action type="datarun scalar" value="Global.~dtAdd" else="">
              <parameter name="parent.PosUgovoriglaId" value="$PosUgovoriglaId" />
            </action>
            <action type="form close" />
          </event>
        </button> -->
				</item>
				<item col="2" row="3" height="50" width="50">
					<button name="btnObrisi" type="delete" image="delete" imagelocation="middlecenter">
						<event type="click">
							<action type="confirm" value="Želite li obrisati označenu robu?">
								<action type="control foreachrow selected" value="#grdRobaPovezi">
									<action type="datarun nonquery" value="~dtRobaBrisanje">
									</action>
								</action>
								<action type="control populate" value="#grdRobaPovezi" />
							</action>
						</event>
					</button>
				</item>
				<item col="2" row="4" height="50" width="50">
					<button name="btnIzlaz" type="close" image="close" imagelocation="middlecenter"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- <button name="btnOdaberi" type="add" caption="&amp;ODABERI"/>
				<button name="btnObrisi" type="delete" caption="&amp;Obriši"/> -->
				<button name="btnOdustani" type="cancel" caption="&amp;Izlaz" dock="left"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<!-- <data command="spTraziRobaCarpo" name="dtRoba">
				<parameter name="@Action" value="Roba" />
				<parameter name="@Prikazi_Dodatno" value="1" />
				<parameter name="@Uvjet" value="#srcRoba.searchtext" />
			</data> -->
			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba" />
				<parameter name="@Uvjet" value="#srcRoba.text" />
				<parameter name="@PokaziVPCijene" value="1" />
				<parameter name="@PokaziNabCijene" value="1" />
				<parameter name="@Retired" value="0" />
				<parameter name="@Prikazi_Dodatno" value="1" />
				<parameter name="@PokaziStanje" value="1" />
			</data>
			<data command="spProd_PosUgovori_RobaQuery" name="dtRobaPovezana">
				<parameter name="@Id" value="$PosUgovoriGlaId"/>
				<!-- <parameter name="@PosUgovoriDetId" value="$PosUgovoriDetId"/> -->
			</data>
			<data command="spProd_PosUgovori_RobaInsert" name="dtRobaUnos">
				<parameter name="@PosUgovoriGlaId" value="$PosUgovoriglaId"/>
				<parameter name="@RobaId" value="#srcRoba"/>

			</data>
			<data command="spProd_PosUgovori_RobaDelete" name="dtRobaBrisanje">
				<parameter name="@PosUgovoriGlaId" value="#grdRobaPovezi.@PosUgovoriGlaId"/>
				<parameter name="@RobaId" value="#grdRobaPovezi.@robaId"/>
			</data>
			<!-- 
			<data command="spProd_PosUgovori_RobaUpdateDetLn" name="dtUpdateDetLN">
				<parameter name="@PosUgovoriGlaId" value="$PosUgovoriGlaId" />
				<parameter name="@RobaId" value="#grdRobaPovezi.@robaId" />
			</data> -->
		</datalist>
	</form>
</root>