<root>
	<form name="frmUFERobnogNepovezaneFakture" caption="Nepovezane fakture" height="300" fixedsize="false">
        <event type="load">
      		<action type="control value" value="#lblDobavljac">
				<parameter value="Dobavljač:  {$dobavljac}"/>
			</action>
        </event>
        <layout textposition="left" itemspadding="3">
			<group groupbordervisible="false" cols="1" rows="2">
				<item col="1" row="1">
					<labeledit name="lblDobavljac" fontbold="true"/>
				</item>
				<item  row="2" col="1"  highlight="False" >
					<grid name="grdNepovezaneFakture" dataname="~dtNepovezane" showgrouppanel="true" showfooter="false" autopopulate="true" async="true">
						<event type="doubleclick">
							<action type="control value" value="parent.#txtURA">
								<parameter value="#grdNepovezaneFakture.@BrojDok"/>
							</action>  
							<action type="control value" value="parent.#txtFVrijednost">
								<parameter value="#grdNepovezaneFakture.@IznosFakture"/>
							</action>
							<action type="variable value" value="parent.$UFA">
								<parameter value="#grdNepovezaneFakture.@FaktureDobId"/>
							</action>				
							<action type="form close"/>
						</event>
						<fields>
							<field caption="UFA" name="BrojDok"/>
							<field caption="Faktura" name="Broj"/>
							<field caption="Datum" name="Datumdok"/>			
							<field caption="Iznos" name="Iznosfakture"/>
						</fields>	
					</grid>
				</item>
			</group>
		</layout>
        <panelbuttons>
            <buttons>
                <button caption="&amp;IZABERI" type="add" dock="right">
                    <event type="click">
						<action type="control value" value="parent.#txtURA">
								<parameter value="#grdNepovezaneFakture.@BrojDok"/>
							</action>  
							<action type="control value" value="parent.#txtFVrijednost">
								<parameter value="#grdNepovezaneFakture.@IznosFakture"/>
							</action>
							<action type="variable value" value="parent.$UFA">
								<parameter value="#grdNepovezaneFakture.@FaktureDobId"/>
							</action>
							<action type="variable value" value="parent.$IndUfaAdd">
								<parameter value="1"/>
							</action>							
                        <action type="form close"/>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right"/>
            </buttons>
        </panelbuttons>
        <datalist>
			<data name="dtNepovezane" command="spCRobnoNepovezaneFaktureQuery">
				<parameter name="@Id" value="$RobnoKalkGlaId"/> 
				<parameter name="@PartneriId" value="$PartneriId"/>	
				<parameter name="@BrojDok" value="$BrojDok"/>					
			</data>      
        </datalist>
    </form>
</root>