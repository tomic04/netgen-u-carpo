								<action type="control refreshvalue" value="##,!#lblTecaj,!#txtTrosakP,!#grdPrimke" else="$Action==0"/>
								<action type="control focus" value="#srcRoba"/>
			<!-- <action type="message" value="spremi {global.$OtvorenaEditForma},{global.$RafalniUnos}"/>								 -->
								<action type="form close" if="$Action==1"/>
								<action type="control populate" value="parent.#grdStavke" if="$isvalid==1&amp;&amp;global.$RafalniUnos!=1">				
