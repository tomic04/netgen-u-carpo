 <root>
	<form name="frmUFERobnogStavka" caption="Stavka kalkulacije" fixedsize="true" width="900">
		<!-- <method name="fnDimenzije" dll="Dimenzije" class="DimenzijeNet.DimenzijeCarpo" method="run"/> -->
        <event type="init">
			<action if="$Action==1">
				<action type="datarun reader" value="~dtGet"/>
				<action type="datarun reader" value="~dtRobnoPrimkaCijena"/>				
				<!--grid zatvaranje primki-->
				<action type="datarun reader" value="~dtPovezanePrimke"/> 
				<action type="datarun reader" value="~dtPovNak"/>
				<action type="variable value">
					<parameter name="JMNaziv" value="~dtGet.@RobaJM"/>
					<parameter name="indProm" value="0"/>
				</action>
			</action>
			<action type="variable value" value="global.$OtvorenaEditForma">
				<parameter value="1"/>
			</action>		
			<action type="variable value" value="global.$Close"> 
				<parameter value="false" type="bool"/> 
			</action> 			
		</event>
		<event type="load">
			<action type="control enable" value="#chkRasporedi" if="global.$NKU_Rasporedi==1"/>
			<action type="control disable" value="#chkRasporedi" else=""/>
			<action type="control itemcaption" value="txtKolicina">
				<parameter value="Količina ({$JMNaziv}):" if="$JMNaziv!=null"/>
				<parameter value="Količina:" else=""/>
			</action>
			<action type="control value" value="#txtTrosakP">
				<parameter value="$TrosakP"/>
			</action>	
			<action type="control value" value="#lblTecaj">
				<parameter value="$Tecaj"/>
			</action>			
		</event>
		<event type="shown">
			<action if="$Action==1">
				<!--na silu izazivamo valuechanged i leave kako bi se preračunale lbl kontrole-->				
				<action type="variable value">
					<parameter name="indProm" value="1"/>
				</action>				
				<action type="control focus" value="#txtTrosakP"/>
				<action type="control focus" value="#txtDevCijena"/>
				<!-- <action type="control value" value="#txtVpc"> -->
					<!-- <parameter value="~dtRobnoPrimkaCijena.@Vpc"/> -->
				<!-- </action>	 -->
				<!-- <action type="control value" value="#txtMpc"> -->
					<!-- <parameter value="~dtRobnoPrimkaCijena.@Mpc"/> -->
				<!-- </action>	 -->
				<action type="control disable" value="#srcRoba, #txtKolicina"/>
				<action type="control disable" value="#txtPovrat" if="~dtPovNak.@Broj==0"/>
				<action type="control populate" value="#grdPrimke"/>
				<action type="variable value">
					<parameter name="TopSktPrometGlaId" value="#grdPrimke.@SktPrometGlaId"/>
				</action>
			</action>
			<action type="control disable" value="#txtDevCijena,#txtDevVrijednost" if="$ValuteId==null"/>
			<action type="control enable" value="#txtDevCijena,#txtDevVrijednost" else=""/>
		</event>
