                        <searchedit  name="srcRoba" fontsizedelta="1" dataname="~dtRoba" fontbold="True" fieldtext="NazivId" required="true" fieldvalue="robaid" entermovenextcontrol="false" datavalue="~dtGet.@RobaId" datatext="~dtGet.@RobaNaziv" tabindex="1">							
							<event type="valuechanged" raiseonload="false">	
								<!-- <action type="datarun reader" value="~dtRobaDostupna" if="#srcRoba!=null"/> -->
								<action type="control populate" value="#grdPrimke" if="#srcRoba!=null"/>
								<action type="variable value">
									<parameter name="TopSktPrometGlaId" value="#grdPrimke.@SktPrometGlaId"/>
								</action>								
								<!--ako je roba dostupna-->
								<action if="#grdPrimke.rowcount!=0">
									<action type="variable value" value="$tip">
										<parameter value=""/>
									</action>
									<action type="variable value" >
										<parameter name="Faktor" value="#srcRoba.@Faktor_Id"/>
									</action>
									<!-- <action type="variable value" > -->
										<!-- <parameter name="FaktorFix" value="#srcRoba.@FaktorFix_Id"/> -->
									<!-- </action> -->
									<action type="variable value" if="#srcRoba!=null">
										<parameter name="JMNaziv" value="#srcRoba.@JM"/>
									</action> 
									<action type="control itemcaption" value="#txtKolicina">
										<parameter value="Količina ({$JMNaziv}):" if="$JMNaziv!=null"/>
										<parameter value="Količina:" else=""/>
									</action>								
									<!-- <part name="prtRobnoKalkResult" path="prtUFERobnogKalk.xml"/>	 -->
									<action type="control refreshvalue" value="##" if="#srcRoba==null&amp;&amp;$action==0"/>																						
									<action type="control focus" value="#txtKolicina"/>
								</action>
								<!--ako nije dostupna poništi odabir-->
								<action else="">
									<action type="control value" value="#srcRoba">
										<parameter value="null"/>
									</action>
								</action>
							</event>
                        </searchedit>
                    </item>
                </group>				
				<group padding="4" groupbordervisible="True" caption="Izračun..." cols="1" rows="3" col="1" row="3">
