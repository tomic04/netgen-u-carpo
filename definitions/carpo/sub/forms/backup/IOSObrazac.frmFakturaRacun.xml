<!--
Poziv iz druge granule:
	<form name="frmFakturaRacun" path="IOSObrazac.frmFakturaRacun.xml"/>
Parametri za poziv:
		<action type="form open" value="frmFakturaRacun" >
			<parameter name="FaktureId" value="#grdDetalj.@KId"/>  		PaktureID
			<parameter name="StatusFak" value="2"/>                		Uvijek šalji 2 da sve kontrole budu disableane
			<parameter name="PartneriId" value="#grdGlava.@gridPid"/>	PartneriId :  Nije obavezan
		</action>
-->
<root>
	<form name="frmFakturaRacun" caption="Faktura" width="1000" height="600"   template="splitter">
		<!-- <method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" /> -->
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="~dtPubVars"/>
			<action type="datarun reader" value="~dtNasbod"/>

			<action type="variable value">
				<parameter name="Global.tablicaGla" value="Fakture" />
			</action>	
			<action type="variable value">
				<parameter name="Global.tablicaDet" value="FakDetalj" />
			</action>
		</event>
		<event type="load">
			<!-- TODO: enable/disable kontrola -->
			<action type="control populate" value="#grdRoba" />
			<action type="control enable" value="#btnZakljuci, #btnOtpisi, #btnSpremi" if="$StatusFak==1"/>
			<action type="control disable" value="#btnZakljuci, #btnOtpisi, #btnSpremi" else="" />
			<action type="datarun scalar" value="~dtStatusiProvjeraButton" >
				<parameter name="PromijeniVrati"/>
			</action>

		</event>		
		<event type="shown">
			<!-- <action type="control disable" value="#txtBroj,#txtFisklani" /> -->
			<action type="control itemcaption" value="#bteVrBoda">
				<parameter value="Tečaj:" if="#cmbValuta!=null"/>
				<parameter value="Bod:" else=""/>
			</action>	
			<action type="control value" value="#bteVrBoda" if="~dtGet.@DevValuteId!=null">
				<parameter value="~dtGet.@VrBodaDev"/>
			</action>
			<action type="control value" value="#bteVrBoda" elseif="~dtGet.@VrBoda==null">
				<parameter value="~dtNasbod.@NasBod"/>
			</action>

			<action type="variable value" if="~dtGet.@DevValuteId!=null" >
				<parameter name="global.VrBodaProd" value="~dtGet.@VrBodaDev" />
			</action>	
			<action type="variable value" else="" >
				<parameter name="global.VrBodaProd" value="~dtNasbod.@NasBod" />
			</action>			
			<action type="control disable" value="#btnZakljuci" if="$PromijeniVrati==-1"/>
			<action type="control enable" value="#btnZakljuci" else=""/>
			<action type="control populate" value="#cmbKontakt"/>
			<!--za deviznu karticu konta sve disableano-->
			<action type="control disable" value="#txtFisklani,#txtBroj,#datDatumDok,#cmbOrgShema,#cmbOsobe,#srcPartner,#srcParStru,#cmbKontakt,#cmbValuta,#bteVrBoda,#cmbNacinOtpreme,#cmbNacinPlacanja,#cmbInstrumentPlacanja,#datDatumIsp,#datDatumIzd,#txtBrNar,#txtOpis1,#btnSpremi,#btnZakljuci,#btnOtpisi,#btnPokojnik,#btnDimenzije,#btnUrednik,#btnDonesiDetalj,#btnDelDetalj,#btnEditDetalj,#btnAddDetalj,#cmbIBAN,#grdUvjeti,#txtDani,#btnIzmijeniDane,#btnKredit,#cmbNapomena,#btnDodaj,#btnZamjeni,#btnMoveDown,#btnMoveUp"/>						
		</event>
		<!-- <event type="close"> -->
		<!-- <action type="datarun scalar" value="Global.~dtStatusiProvjeraMenu"> -->
		<!-- <parameter name="PromijeniVrati"/> -->
		<!-- </action>				 -->
		<!-- <action type="menu disable" value="#menVratiStatus" if="$PromijeniVrati==-1||#grdGlava.rowcount==0"/> -->
		<!-- <action type="menu enable" value="#menVratiStatus" else=""/>			 -->
		<!-- TODO: problem kod fokusa nakon izmijeni/spremi -->
		<!-- <action type="control populate" value="parent.#grdGlava" > -->
		<!-- <action type="control focus" value="parent.#grdGlava"> -->
		<!-- <parameter value="$FaktureId" /> -->
		<!-- </action> -->
		<!-- </action> -->
		<!-- </event>		 -->
		<layout name="panel1" type="collapsable" textposition="left">
			<group padding="0" groupbordervisible="False" cols="1" rows="1">
				<!-- <group padding="0" groupbordervisible="False" cols="2" rows="2"> -->
				<columnsdefinition>
					<column size="390" position="1" />
					<!-- <column size="8" position="2" /> -->
				</columnsdefinition>
				<tabs row="1" col="1" padding="4">
					<!-- tab lijevo -->
					<group caption="Osnovno" name="tabOsnovno" cols="1" rows="15" col="1" row="1">

						<group col="1" row="1" cols="3" rows="1" groupbordervisible="false">
							<columnsdefinition>
								<column size="90" position="1" />
								<column size="100%" position="2" />
								<column size="100%" position="3" />
							</columnsdefinition>		
							<item  col="1" row="1" >
								<labeledit value="Broj:" />
							</item>
							<item caption="" col="2" row="1" fontbold="true" >
								<textedit name="txtFisklani" datavalue="#dtGet.@fiskalnibroj" fontbold="true" nulltext="&lt;fiskalni broj&gt;" readonly="true"/>
							</item>
							<item caption="" col="3" row="1" fontbold="true" >
								<action type="message" value="#dtGet.@Broj" />
								<textedit name="txtBroj" datavalue="#dtGet.@Broj"  fontbold="true" nulltext="&lt;interni broj&gt;" readonly="true"/>
							</item>	
						</group>
						<item caption="Datum:" col="1" row="2" >
							<action type="variable value">
								<parameter name="DatumPromijenjen" value="0" type="int" />
							</action>		
							<dateedit name="datDatumdok" value="now" datavalue="#dtGet.@DatumDok" required="true">
								<!-- ovo komentiram jer mi je ionako disableana kontrola
								<event type="leave">
									<action type="confirm" value="Želite li promijeniti vrijednost boda? (Vrijednost svih stavaka bit će preračunata u skladu s novom vrijednošću boda)" if="#cmbValuta!=null&amp;&amp;$DatumPromijenjen==1">
										<action type="datarun reader" value="Global.~dtDatumValidate" />
										<action type="control value" value="#bteVrBoda">
											<parameter value="~dtDatumValidate.@tecaj"/>
										</action>						
										<action type="datarun nonquery" value="global.~dtUpdateFaktureDevValute" />
										<action type="datarun nonquery" value="Global.~dtPromijeniTecaj">
											<action type="control populate" value="#grdRoba" />
										</action>										
									</action>
									<action type="datarun nonquery" value="Global.~dtProvjeraDatuma">
										<action type="control focus" value="#datDatumdok"/> 
									</action>
									<action type="variable value">
										<parameter name="DatumPromijenjen" value="0" type="int" />
									</action>					
								</event>
								-->
								<event type="valuechanged">
									<action type="variable value">
										<parameter name="DatumPromijenjen" value="1" type="int" />
									</action>
									<action type="control value" value="#datDatumIzd">
										<parameter value="#datDatumdok"/>
									</action>					
								</event>
							</dateedit>
						</item>	
						<item caption="Org shema:" col="1" row="3" >
							<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" datavalue="#dtGet.@OrgShemaId" dataname="~dtOrgShema" required="true"/>
						</item>
						<item caption="Odg osoba:" col="1" row="4">
							<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Osoba" datavalue="#dtGet.@OsobeId" dataname="~dtOdgovornaOsoba" required="true"/>
							<!-- <comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="#dtGet.@DevValuteId" dataname="Global.dtValuta" > -->
						</item>	
						<item caption="Partner:" col="1" row="5" fontbold="true"> 
							<searchedit name="srcPartner" netgenfields="true" required="true" fontbold="true" savelayout="true" dataname="~dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@Kupac" entermovenextcontrol="false">
								<!--ovo zakomentiram jer se vrijednost ne mijenja
								<event type="valuechanged">
									<action type="variable value">
										<parameter name="PartneriId" value="#srcPartner" />
									</action>	
									<action type="variable value">
										<parameter name="IndPromijenjeno" value="1" />
									</action>

									<action type="datarun reader" value="Global.~dtPartnerZabrana" />

									<action if="~dtPartnerZabrana.@Zabrana!=1">
										<action type="datarun reader" value="Global.dtDajPartnera" if="#srcPartner!=null"/>	

										<action type="control value" value="#srcParstru" if="#srcPartner!=null">
											<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
										</action>
										<action type="form open" value="frmLokacije" if="#srcPartner.@BrojLokacija_Id!=null&amp;&amp;#srcPartner.@BrojLokacija_Id&gt;1&amp;&amp;$IndPromijenjeno==1&amp;&amp;~dtDajPartnera.@parstruid==null">
											<parameter name="PartneriId" value="#srcPartner" />
											<parameter name="IndLokacija" value="1" />
											<parameter name="ParStruId" value="#srcParstru" />
										</action>
										<action type="control refreshvalue" value="#srcParstru" if="#srcPartner==null"/>
										<action type="variable value">
											<parameter name="IndLokacija" value="0" />
										</action>
										<action type="variable value">
											<parameter name="IndPromijenjeno" value="0" />
										</action>
										<action type="control focus" value="#srcParstru"/>
					
									</action>
									<action elseif="~dtPartnerZabrana.@Zabrana==1">
										<action type="message" value="Partner ima postavljenu zabranu!"  >
											<action type="control value" value="#srcPartner, #srcParstru">
												<parameter value=""/>
											</action>
											<action type="control focus" value="#srcPartner"/>
										</action>
									</action>
								</event>
								-->
							</searchedit>
						</item>
						<item caption="Lokacija:" col="1" row="6" >
							<searchedit netgenfields="true" name="srcParstru" required="true" dataname="~dtParstru" fieldtext="NazivId" fieldvalue="ParStruId" datavalue="#dtGet.@ParStruId" datatext="#dtGet.@ParStruNaziv" >                  
								<!-- ovo komentiram jer se vrijednost ne mijenja
								<event type="leave">
									<action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null"/>
									<action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
										<parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv"/>
									</action>
								</event>	
								-->								
							</searchedit>
						</item>
						<item caption="Kontakt:" col="1" row="7">
							<!-- TODO: ne radi na edit -->
							<comboedit name="cmbKontakt" valuefield="OsobeId" displayfield="Osoba" datavalue="#dtGet.@OsobeParId" dataname="~dtKontakt" autopopulate="false" /> 
						</item>

						<group col="1" row="8" cols="2" rows="1" groupbordervisible="false">
							<columnsdefinition>
								<column size="250" position="1" />
								<column size="100" position="2" />
								<!-- <column size="100%" position="1" /> -->
								<!-- <column size="100" position="2" /> -->
							</columnsdefinition>		
							<item caption="Valuta:" col="1" row="1" >
								<comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="#dtGet.@DevValuteId" dataname="~dtValuta" >
									<!-- <event type="leave">-->
									<!-- ovo zakomentiram jer je kontrola disableana
									<event type="valuechanged">
										<action type="confirm" value="Jeste li sigurni da želite promijeniti valutu na dokumentu?" if="$FaktureId!=null">
											<action type="control enable" value="#bteVrBoda" if="#cmbValuta!=null" />
											<action type="control disable" value="#bteVrBoda" else="" />
											<action type="datarun reader" value="Global.dtTecaj" if="#cmbValuta!=null"/>
											<action type="control value" value="#bteVrBoda" if="#cmbValuta!=null">
												<parameter value="~dtTecaj.@Tecaj"/>
											</action>
											<action type="control value" value="#bteVrBoda" else="">
												<parameter value="~dtPubVars.@NasBod"/>
											</action>
											<action type="datarun nonquery" value="global.~dtUpdateFaktureDevValute" />
											<action type="control foreachrow" value="#grdRoba">
												<action type="datarun nonquery" value="Global.~dtPromijeniTecaj" />
											</action>
											<action type="control populate" value="#grdRoba" />
										</action>
										<action if="$FaktureId==null">
											<action type="control enable" value="#bteVrBoda" if="#cmbValuta!=null" />
											<action type="control disable" value="#bteVrBoda" else="" />
											<action type="datarun reader" value="Global.dtTecaj" if="#cmbValuta!=null"/>
											<action type="control value" value="#bteVrBoda" if="#cmbValuta!=null">
												<parameter value="~dtTecaj.@Tecaj"/>
											</action>
											<action type="control value" value="#bteVrBoda" else="">
												<parameter value="~dtPubVars.@NasBod"/>
											</action>
										</action>	
										<action type="control itemcaption" value="#bteVrBoda">
											<parameter value="Tečaj:" if="#cmbValuta!=null"/>
											<parameter value="Bod:" else=""/>
										</action>						
									</event>
									-->
								</comboedit>
							</item>	
							<item caption="Bod:" col="2" row="1" textalignmode="auto">				
								<textedit name="bteVrBoda" format="n6" datavalue="#dtGet.@VrBoda" >
									<!--ovo komentiram jer je kontrola disableana
									<event type="leave" >								
										<action type="confirm" value="Jeste li sigurni da želite promijeniti vrijednost boda na dokumentu?" if="$FaktureId!=null">
											<action type="datarun nonquery" value="global.~dtUpdateFaktureDevValute" />
											<action type="datarun nonquery" value="Global.dtPromijeniTecaj">
												<action type="control populate" value="#grdRoba" />
											</action>
										</action>
									</event>
									-->
								</textedit>	
							</item>
						</group>		


						<item caption="Način otpreme:" col="1" row="9" >
							<comboedit name="cmbNacinOtpreme" valuefield="NacinIsporukeId" displayfield="Naziv" datavalue="#dtGet.@ProNacinIsporukeId" dataname="~dtNacinIsporuke" required="true"/>
						</item>	
						<item caption="Način plaćanja:" col="1" row="10" >
							<comboedit name="cmbNacinPlacanja" valuefield="ProNacinNaplateId" displayfield="Opis" datavalue="#dtGet.@ProNacinNaplateId" dataname="~dtNacinPlacanja" required="true" allownull="false">
								<event type="leave">
									<action type="variable value" >
										<parameter name="IndKredit" value="#cmbNacinPlacanja.@Indikator"/>
									</action>
									<action if="$FaktureId!=null">
										<action type="control populate" value="#grdUvjeti" if="$"/>
										<action type="control enable" value="#btnKredit, #grdUvjeti" if="#cmbNacinPlacanja.@Indikator==2&amp;&amp;$StatusFak==1" />
										<action type="control disable" value="#btnKredit, #grdUvjeti" else="" />
										<action type="control disable" value="#btnIzmijeniDane, #txtDani" if="#cmbNacinPlacanja.@Indikator==2||$StatusFak!=1" />
										<action type="control enable" value="#btnIzmijeniDane, #txtDani" else="" />
									</action>						
								</event>
							</comboedit>
						</item>
						<item caption="Instr plaćanja:" row="11" col="1">
							<comboedit name="cmbInstrumentPlacanja" valuefield="KntNacinPlacId" displayfield="Naziv" datavalue="#dtGet.@KntNacinPlacId" dataname="~dtInstrumentPlacanja" required="true" allownull="false"/>
						</item>			
						<item caption="Datum isporuke:" col="1" row="12" >
							<dateedit name="datDatumIsp" value="now" datavalue="#dtGet.@DatumIsporuke" />
						</item>	
						<item caption="Datum izdavanja:" col="2" row="13" >
							<dateedit name="datDatumIzd" value="now" datavalue="#dtGet.@DatumIzdavanja" />
						</item>			
						<item caption="Broj narudžbe:" col="1" row="14">
							<textedit name="txtBrNar" entermovenextcontrol="true" datavalue="#dtGet.@BrojNarudzbe" />
						</item>
						<item caption="Opis:" col="1" row="15">
							<textedit name="txtOpis1" entermovenextcontrol="true" datavalue="#dtGet.@Opis1" />
						</item>		
					</group>
					<group caption="Uvjeti" name="tabUvjeti" cols="2" rows="13" col="1" row="1" alignmode="local">
						<rowsdefinition>
							<row size="40" position="13" />
						</rowsdefinition>

						<item caption="IBAN:" row="1" col="1" colspan="2" textposition="top">
							<comboedit name="cmbIBAN" enabled="true" valuefield="ParZiroId" displayfield="IBAN" datavalue="#dtGet.@ParZiroId" dataname="~dtIBAN" >
							</comboedit>
						</item>		
						<item row="2" col="1" colspan="2" rowspan="10">
							<grid name="grdUvjeti" key="ProNaplataRateId" autopopulate="true" multiselect="true" showfooter="True" showgrouppanel="false" showautofilterrow="false">
								<fields>
									<field name="Dana" caption="Dana"  formatstring="n1" showtotalsum="false"/>
									<field name="Datum" caption="Datum"  />
									<field name="Iznos" caption="Iznos"  formatstring="n2"/>
								</fields>
								<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtUvjetiIzmjena"/> 
									<action type="control populate keepfocus" value="#grdUvjeti"/> 
								</event>						
								<data command="spProd_UvjetiKK">
									<parameter name="@ID" value="$ProPonGlaId" type='int' if="Global.$tablicaGla=='ProPonGla'"/>
									<parameter name="@ID" value="$FaktureId" type='int' if="Global.$tablicaGla=='Fakture'"/>
									<parameter name="@ID" value="$ProNotpGlaId" type='int' if="Global.$tablicaGla=='ProNOtpGla'"/>
									<parameter name="@Action" value="1" />
									<parameter name="@IndKredit" value="1" if="$IndKredit==2"/>
									<parameter name="@IndKredit" value="0" else=""/>
									<parameter name="@tablicaGla" value="global.$tablicaGla"/>
									<parameter name="@tablicaDet" value="global.$tablicaDet"/>							
								</data>						
							</grid>
						</item>
						<group padding="0" caption="Izmijeni broj dana na svim stavkama na:" groupbordervisible="true" cols="2" rows="1" col="1" row="12" colspan="2" spacing="5,5,5,5">
							<rowsdefinition>
								<row size="40" position="1" />
							</rowsdefinition>				
							<item caption="Broj dana:" row="1" col="1" textposition="left">
								<textedit name="txtDani" value="0" format="n0" type="integer" required="true"/>
							</item>	
							<item row="1" col="2"> 
								<button name="btnIzmijeniDane" caption="Izmijeni" >
									<!-- ovo komentiram jer je kontrola disablena
									<event type="click">
										<action type="validate"/>
										<action type="datarun nonquery" value="Global.dtRokPlacanja"/>
										<action type="control populate" value="#grdUvjeti" />
										<action type="control populate" value="#grdRoba" />
									</event>
									-->
								</button> 
							</item>				
						</group>
						<item row="13" col="1">
							<button name="btnKredit" caption="Kredit" >
								<event type="click">
									<action type="form open" value="frmKredit">
										<parameter name="ProPonGlaId" value="$ProPonGlaId" type='int' if="Global.$tablicaGla=='ProPonGla'"/>
										<parameter name="FaktureId" value="$FaktureId" type='int' if="Global.$tablicaGla=='Fakture'"/>
										<parameter name="ProNotpGlaId" value="$ProNotpGlaId" type='int' if="Global.$tablicaGla=='ProNOtpGla'"/>
										<parameter name="KntNacinPlacId" value="#cmbNacinPlacanja" />
										<parameter name="IndKredit" value="$IndKredit" />
									</action>
								</event>
							</button>
						</item>				
					</group>						
					<group caption="Napomena" cols="3" rows="3" col="1" row="1" alignmode="local">
						<columnsdefinition>
							<column position="1" size="100%"/>
							<column size="70" position="2"/>
							<column size="70" position="3"/>
						</columnsdefinition>
						<rowsdefinition>
							<row size="30" position="2" />
						</rowsdefinition>
						<item caption="Standardne napomene:" row="1" col="1" colspan="3" textposition="top">
							<comboedit name="cmbNapomena" enabled="true" valuefield="Poruka" displayfield="Poruka" datavalue="#dtGet.@Poruka" dataname="~dtPoruke" >
							</comboedit>
						</item>
						<item row="2" col="2">
							<button name="btnDodaj" caption="Dodaj" dock="right">
								<event type="click">
									<action type="datarun reader" value="~dtNapomena"/>
									<action type="control value" value="#MemoGlava">
										<parameter value="~dtNapomena.@tekst"/>
									</action>
								</event>
							</button>
						</item>
						<item row="2" col="3" >
							<button name ="btnZamjeni" caption="Zamjeni" type="edit" dock="right" >
								<event type="click">
									<action type="control value" value="#MemoGlava">
										<parameter value="#cmbNapomena"/>
									</action>
								</event>
							</button>
						</item>
						<item name="Memo" textvisible="False" row="3" col="1" colspan="3" >
							<memoedit name="MemoGlava" datavalue="~dtGet.@Memo"  />
							<event type="valuechanged">
								<action type="control disable" value="#btnZamjeni" if="#Memo!=null"/>
							</event>
						</item>
					</group>
				</tabs>	
			</group>
		</layout>				
		<!-- <item row="1" col="2" /> -->
		<layout name="panel2">
