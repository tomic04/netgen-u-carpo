<root version="1.0.0.1">
<!--11.2.2020. AA brojdok preko odabranog datuma, a ne datuma knjizenja original temeljnice-->
	<form name="frmTemStorno" caption="Storniraj" fixedsize="true">
		<event type="init"> 
		</event>
		<event type="load">	
			<action type="datarun reader" value="~dtBrojDokNovi"/>
			<!-- BrojDokNovi-->
			<action type="variable value" >
				<parameter name="BrojDok" value="~dtBrojDokNovi.@BrojDok" type="string" />
			</action>	
		</event>
		<event type="shown">
			<action type="control focus" value="#datStornoDatum"/>		
			<action type="control refreshvalue" value="#txtBrojDok"/>		
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="2" groupbordervisible="true">
				<item col="1" row="1" caption="Datum:">
					<dateedit  name="datStornoDatum"  value="now">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtBrojDokNovi" />
							<!-- BrojDokNovi-->
							<action type="variable value" >
								<parameter name="BrojDok" value="~dtBrojDokNovi.@BrojDok" type="string" />
							</action>
							<action type="control value" value="#txtBrojDok">
								<parameter value="~dtBrojDokNovi.@BrojDok" type="string" />
							</action>							
						</event>
					</dateedit>
				</item>
				<item col="1" row="2" caption="Broj:">
					<textedit name="txtBrojDok"  value=""  datavalue="~dtBrojDokNovi.@BrojDok"/>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStorniraj" caption="&amp;STORNIRAJ" dock="left">
					<event type="click">
						<action type="datarun scalar" value="~dtStorniraj">
							<parameter name="parent.$NoviId" />
						</action>
						<!-- DODAO OGNJEN -->
						<action type="datarun scalar" value="~dtGetParsedText">
							<parameter name="parent.$DodatnoTemp"/>
						</action>
						<!-- ***** -->
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="variable value" value="parent.$Izadji">
							<parameter value="true" type="bool"/>
						</action>
					</event>
				</button>  
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKntTemQuery" name="dtBrojDokNovi">
				<parameter name="@action" value="6"/>
				<parameter name="@Id" value="parent.#grdGlava.@VrstaDokId"/>
				<!-- <parameter name="@DatumKnjizenja" value="parent.#grdGlava.@DatumKnjizenja"/> -->
				<parameter name="@DatumKnjizenja" value="#datStornoDatum"/>
			</data>		
			<data command="spCKntTemStorniraj" name="dtStorniraj">
				<parameter name="@ID" value="parent.#grdGlava.@KntTemId" />
				<parameter name="@DatumKnjizenja" value="#datStornoDatum" />
				<parameter name="@BrojDok" value="#txtBrojDok" />
				<parameter name="@OperateriId" value="@@operateriid"/>
			</data>
			<!-- DODAO OGNJEN -->
			<data command="spCKntTemStornirajHelp" name="dtGetParsedText">
				<parameter name="@VrsteDok" value="$VrsteDok"/>
				<parameter name="@ParsedTreeValue" value="#datStornoDatum"/>
				<parameter name="@Rbr" value="$Rbr" if="$VrsteDok==true"/>
			</data>
			<!-- ***** -->
		</datalist>
	</form>
</root>