<root>
	<form name="frmUFERobnogTrosak" caption="Specifikacija troškova" width="500" height="400" fixedsize="false">
		<event type="shown">
            <action type="control populate" value="#grdTroskovi">	
				<action type="control disable" value="#btnObrisi,#btnZamjeni" if="#grdTroskovi.rowcount==0"/>
				<action type="control enable" value="#btnObrisi,#btnZamjeni" else=""/>
			</action>
        </event>
        <layout textposition="left" itemspadding="3">
			<group groupbordervisible="false" cols="1" rows="1">
				<item  row="1" col="1"  highlight="False" >
					<grid name="grdTroskovi" dataname="~dtTroskovi" showgrouppanel="False" showfooter="true" autopopulate="false" async="true" bestfitonrefresh="true">					
						<fields inherited="false">
							<field caption="Naziv partnera" name="PartnerNaziv"/>
							<field caption="Konto" name="Konto"/>
							<field caption="Naziv konta" name="Naziv"/>				
							<field caption="Broj računa" name="Opis"/>
							<field caption="Iznos" name="Iznos" fixed="right"/>
							<field caption="Datum" name="Datum"/>
							<field caption="Broj UFE" name="Brojufe"/>
							<field caption="Organizacijska shema" name="OrgShema"/>
						</fields>						
					</grid>
				</item>
			</group>
		</layout>
        <panelbuttons>
            <buttons>
                <button caption="&amp;DODAJ" name="btnDodaj" type="add" dock="left">
                    <event type="click">					
						<action type="form open" value="frmUFERobnogTrosakDetail">
							<parameter name="tekst" value="unos"/>
							<parameter name="RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
							<parameter name="Action" value="0"/>
						</action>
						<action type="control populate keepfocus" value="#grdTroskovi">
							<action type="control disable" value="#btnObrisi,#btnZamjeni"  if="#grdTroskovi.rowcount==0" />
							<action type="control enable" value="#btnObrisi,#btnZamjeni"  else="" />
						</action>
						<action if="#grdTroskovi.@Iznos.sum&gt;0">
							<action type="variable value" value="global.$sumaTroska">
								<parameter value="#grdTroskovi.@Iznos.sum"/>	
							</action>								
							<action type="control value" value="parent.#txtTrosakIznos">
								<parameter value="global.$sumaTroska"/>
							</action>
							<action if="parent.#txtFVrijednost!=0">
								<action type="datarun reader" value="~dtCalcTroskovi"/>	
								<action type="control value" value="parent.#txtTrosakPosto">
									<parameter value="~dtCalcTroskovi.@TroskoviP"/>
								</action>
							</action>							
						</action>
						<action type="control disable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  if="#grdTroskovi.@Iznos.sum&gt;0"/>
						<action type="control enable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  else=""/>				
					</event>
                </button>
				 <button caption="IZMIJENI"  name="btnZamjeni" dock="left">
                    <event type="click">
						<action type="form open" value="frmUFERobnogTrosakDetail">
							<parameter name="RobnoTroskoviId" value="#grdTroskovi.@RobnoTroskoviId"/>
							<parameter name="tekst" value="izmijena"/>
							<parameter name="RobnoKalkGlaId" value="$RobnoKalkGlaId"/>
							<parameter name="Action" value="1"/>
						</action>
						<action type="control populate keepfocus" value="#grdTroskovi" />
						<action if="#grdTroskovi.@Iznos.sum&gt;0">
							<action type="variable value" value="global.$sumaTroska">
								<parameter value="#grdTroskovi.@Iznos.sum"/>	
							</action>								
							<action type="control value" value="parent.#txtTrosakIznos">
								<parameter value="global.$sumaTroska"/>
							</action>
							<action if="parent.#txtFVrijednost!=0">
								<action type="datarun reader" value="~dtCalcTroskovi"/>	
								<action type="control value" value="parent.#txtTrosakPosto">
									<parameter value="~dtCalcTroskovi.@TroskoviP"/>
								</action>
							</action>							
						</action>
						<action type="control disable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  if="#grdTroskovi.@Iznos.sum&gt;0"/>
						<action type="control enable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  else=""/>									
                    </event>
                </button>
				 <button caption="OBRIŠI" name="btnObrisi" dock="left">
                    <event type="click">
                        <action type="confirm" value="Želite li obrisati odabrani trošak?">
                            <action type="datarun nonquery" value="~dtTroskoviDel">
								<action type="control populate keepfocus" value="#grdTroskovi">
									<action type="control disable" value="#btnObrisi,#btnZamjeni"  if="#grdTroskovi.rowcount==0" />
									<action type="control enable" value="#btnObrisi,#btnZamjeni"  else="" />
								</action>
                            </action>
							<action if="#grdTroskovi.@Iznos.sum&gt;0">
								<action type="variable value" value="global.$sumaTroska">
									<parameter value="#grdTroskovi.@Iznos.sum"/>	
								</action>								
								<action type="control value" value="parent.#txtTrosakIznos">
									<parameter value="global.$sumaTroska"/>
								</action>
								<action if="parent.#txtFVrijednost!=0">
									<action type="datarun reader" value="~dtCalcTroskovi"/>	
									<action type="control value" value="parent.#txtTrosakPosto">
										<parameter value="~dtCalcTroskovi.@TroskoviP"/>
									</action>
								</action>							
							</action>
							<action else="">
								<action type="variable value" value="global.$sumaTroska">
									<parameter value="0"/>	
								</action>								
								<action type="control value" value="parent.#txtTrosakIznos">
									<parameter value="0"/>
								</action>
								<action type="control value" value="parent.#txtTrosakPosto">
									<parameter value="0"/>
								</action>								
							</action>
                        </action>	
						<action type="control disable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  if="#grdTroskovi.@Iznos.sum&gt;0"></action>
						<action type="control enable" value="parent.#txtTrosakIznos, parent.#txtTrosakPosto"  else=""></action>						

                    </event>
                </button>
                <button caption="IZLAZ"  dock="right" type="cancel">		
					<event type="click">
						<action type="variable value" value="global.$sumaTroska" if="#grdTroskovi.@Iznos.sum&gt;0">
							<parameter value="#grdTroskovi.@Iznos.sum"/>
						</action>
					</event>
				</button>
            </buttons>
        </panelbuttons>
        <datalist>
			<data name="dtTroskovi" command="spCRobnoTroskoviQuery">
				<parameter name="@Action" value="3"/>
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>		
			</data>	
			<data name="dtTroskoviDel" command="spCRobnoTroskoviAzur">
				<parameter name="@Action" value="2"/>
				<parameter name="@Id" value="#grdTroskovi.@RobnoTroskoviId"/>	
				<parameter name="@RobnoKalkGlaId" value="$RobnoKalkGlaId"/>		
			</data>	
			<data name="dtCalcTroskovi" command="spCRobnoKalkCalcTroskovi">
				<parameter name="@Action" value="spectr"/>
				<parameter name="@FakVrijednost" value="parent.#txtFVrijednost"/>
				<parameter name="@TroskoviP" value="parent.#txtTrosakPosto"/>
				<parameter name="@TroskoviI" value="parent.#txtTrosakIznos"/>
			</data>				
		</datalist>
    </form>
</root>