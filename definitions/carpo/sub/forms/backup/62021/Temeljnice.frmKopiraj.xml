<root>
	<form name="frmTemKopiraj" caption="Kopiranje temeljnice" fixedsize="true">
		<event type="init"> 
		</event>
		<event type="load">	
			<action type="datarun reader" value="~dtBrojDokNovi" />
			<!-- BrojDokNovi-->
			<action type="variable value" >
				<parameter name="BrojDok" value="~dtBrojDokNovi.@BrojDok" type="string" />
			</action>	
		</event>
		<event type="shown">
			<action type="control focus" value="#datKopiDatum"/>		
			<action type="control refreshvalue" value="#txtBrojDok"/>		
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="3" groupbordervisible="true">
				<item col="1" row="1" caption="Datum:">
					<dateedit  name="datKopiDatum"  value="now">
					</dateedit>
				</item>
				<item col="1" row="2" caption="Broj:">
					<textedit name="txtBrojDok"  value=""  datavalue="~dtBrojDokNovi.@BrojDok"/>
				</item>
				<item col="1" row="3" caption="Opis:">
					<textedit name="txtOpis"  value=""/>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnKopiraj" caption="&amp;KOPIRAJ" dock="left">
					<event type="click">
						<action type="datarun scalar" value="~dtKopiraj">
							<parameter name="parent.$Noviid" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spCKnt_Tem_Query" name="dtBrojDokNovi">
				<parameter name="@action" value="6" />
				<parameter name="@Id" value="parent.#grdGlava.@VrstaDokId" />
				<parameter name="@DatumKnjizenja" value="parent.#grdGlava.@DatumKnjizenja" />
			</data>	
			<data command="spCKnt_Tem_Kopiraj" name="dtKopiraj">
				<parameter name="@KntTemId" value="parent.#grdGlava.@KntTemId" />
				<parameter name="@Datum" value="#datKopiDatum" />
				<parameter name="@BrojDok" value="#txtBrojDok" />
				<parameter name="@Opis" value="#txtOpis" />
			</data>				
		</datalist>
	</form>
</root>