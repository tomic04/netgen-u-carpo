<root>
    <form name="frmPromjenaStatusa" caption="Promjena statusa">
        <layout>
            <group cols="1" rows="2">
                <item col="1" row="1" caption="Status:">
					<comboedit name="cmbStatus" />
				</item>
                <item col="1" row="2" caption="Napomena:">
					<textedit name="txtNapomena" />
				</item>
            </group>
        </layout>
		<panelbuttons>
			<buttons>
				<button name="btnPromijeni" caption="&amp;PROMIJENI">
					<event type="click">
						<!-- <action type="datarun nonquery" value="~dtZakljuci" if="$ZakljucakInd==1"/> -->
						<!-- <action type="datarun nonquery" value="~dtVrati" else=""/> -->
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="&amp;ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spStatusi_CARPO" name="dtStatus">
				<parameter name="@action" value="1" if="$ZakljucakInd==1"/>
				<parameter name="@action" value="2" else=""/>
				<parameter name="@tablica" value="NabPriGla"/>				
				<parameter name="@operateriid" value="@@OperateriId" />
				<parameter name="@id" value="$NabPriGlaId" type ="int" />
			</data>	
			<!-- <data command="spNab_ZahGla_GetNextStatus" name="dtStatus"> -->
			<!-- <parameter name="@id" value="$NabZahGlaId"/> -->
			<!-- <parameter name="@operateriid" value="@@operateriid"/> -->
			<!-- </data> -->
			<data command="spProd_PosUgovoriGla_Zakljuci" name="dtZakljuci">
				<parameter name="@id" value="$NabPriGlaId"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@statusiid" value="#cmbStatus"/>
				<parameter name="@napomena" value="#txtNapomena"/>
			</data>
			<data command="spProd_PosUgovoriGla_Zakljuci" name="dtVrati">
				<parameter name="@id" value="$NabPriGlaId"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@statusiid" value="#cmbStatus"/>
				<parameter name="@napomena" value="#txtNapomena"/>
			</data>
		</datalist>
    </form>
</root>