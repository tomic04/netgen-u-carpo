<!-- 6.10.2020. AA devizne sume ispod grida -->
<!--v1.0.0.4 11.3.2020. AA kolona KljucTroska-->
<!--v1.0.0.3 6.6.2019. AA mogućnost izmjene iz Kartice konta-->
<!--v1.0.0.2 2.10.2018. AA dodala ZakljInd za ponašanje temeljnice kao da je zaključana (pozivanje iz drugih projekata)-->
<root version="1.0.0.3">
	<form name="frmTemEdit" caption="Izmjena temeljnice" width="900" height="570" saveformsize="true"> 
		<event type="init">
			<action type="variable value">
				<parameter name="Global.$KntTemId" value="$KntTemId" type="int"/>
			</action>
			<action type="datarun reader" value="~dtGlavaGet" />
			<action type="datarun reader" value="~dtCalc"/>
			<action type="datarun reader" value="~dtCalcDev"/>			
			<action type="variable value" >
				<parameter name="Global.$DatumKnjizenja" value="~dtGlavaGet.@DatumKnjizenja" type="date" />
				<parameter name="Global.$BrojDok" value="~dtGlavaGet.@BrojDok" type="string"/>
				<!-- <parameter name="Global.$Sifra" value="$Sifra" type="int"/> -->
			</action>
		</event>
		<event type="load">
			<!--za enable/disable rada na temeljnici prilikom pozivanja iz kartice konta-->
			<action if="$KarticaKontaInd==1">
				<action type="variable value">
					<parameter name="KarticaKontaTemEdit" value="0" type="int"/>
				</action>
				<action type="datarun scalar" value="~dtKarticaKontaTemEdit">
					<parameter name="KarticaKontaTemEdit"/>
				</action>
				<action type="variable value" if="$KarticaKontaTemEdit==0">
					<parameter name="ZakljInd"  value="1"/>
				</action>		
			</action>
			<action type="control populate" value="#grdStavke"/>
			<!-- <action type="control enable" value="#btnAddDetalj,#btnEditDetalj,#btnDelDetalj,#btnZakljuci,#btnSpec" if="~dtGlavaGet.@Status==N&amp;&amp;#grdStavke.rowcount!=0"/> -->
			<!-- <action type="control enable" value="#btnSpec" elseif="#grdStavke.rowcount!=0"/> -->
			<!-- <action type="control enable" value="#btnAddDetalj" elseif="~dtGlavaGet.@Status==N"/> -->
			<!-- <action type="control disable" value="#btnAddDetalj,#btnEditDetalj,#btnDelDetalj,#btnZakljuci" else=""/> -->
			<action type="control enable" value="#btnAddDetalj" if="~dtGlavaGet.@Status==N"/>
			<action type="control disable" value="#btnAddDetalj" else=""/>
			<action type="control enable" value="#btnEditDetalj,#btnDelDetalj,#btnZakljuci" if="~dtGlavaGet.@Status==N&amp;&amp;#grdStavke.rowcount!=0"/>
			<action type="control disable" value="#btnEditDetalj,#btnDelDetalj,#btnZakljuci" else=""/>			
			<action type="control enable" value="#btnSpec" if="#grdStavke.rowcount!=0"/>
			<action type="control disable" value="#btnSpec" else=""/>
			<action type="control disable" value="#btnAddDetalj,#btnEditDetalj,#btnDelDetalj,#btnZakljuci" if="$ZakljInd==1"/>
			<action type="variable value" >
				<parameter name="NoviId" value="0" type="int"/>
			</action> 
			<!--<action type="control disable" value="#datDatumdok, #cmbVrstaDok, #txtBroj"/>   -->
			<action type="variable value" value="Global.$Sifra" if="$UraInd==1">
				<parameter value="53"/>
			</action>
               <action type="variable value" value="Global.$Sifra" if="$IraInd==1">
                    <parameter value="54"/>
               </action>               
		</event>
		<event type="shown">
			<action type="control focus" value="#grdStavke"/>
			<!-- <action type="control selectedrows" value="#grdStavke"/> -->
			<action if="$DoubleClick==1">
				<action type="control focus" value="#grdStavke">
					<parameter value="$KntPrometId"/>
				</action>
				<part name="prtTemStavkaIzmijeni" path="prtTemeljnice.xml"/>
			</action>
		    <action type="control attribute" value="#curSaldo" if="#curSaldo!=0">
				<parameter name="fontcolor" value="red"/>
		    </action>
		    <action type="control attribute" value="#curSaldo" else="">
				<parameter name="fontcolor" value="black"/>
		    </action>
			
		</event>
		<event type="close">
			<action if="$UraInd!=1&amp;&amp;$IraInd!=1">
				<action type="datarun scalar" value="~dtGetParsedText">
					<parameter name="parent.$DodatnoTemp"/>
				</action>						
				<action type="variable value">
					<parameter name="parent.$NoviId" value="Global.$KntTemId"/>
				</action>
			</action>
			<action type="form close"/>	
		</event>		
		<layout textposition="top" itemspadding="3">
			<group padding="0" groupbordervisible="false" cols="1" rows="3">
				<group cols="1" rows="1">
					<group padding="0" groupbordervisible="false" cols="5" rows="1" alignmode="local">
						<columnsdefinition>
							<column size="20%" position="1" />
							<column size="10%" position="2" />	
							<column size="40%" position="3" />	
							<column size="10%" position="4" />
							<column size="20%" position="5" />
						</columnsdefinition>
						<item caption="Datum:" row="1" col="1" width="300" textposition="left" fontsizedelta="1">
							<dateedit name="datDatumdok" datavalue="~dtGlavaGet.@DatumKnjizenja" readonly="true" fontsizedelta="1"/>
						</item>	
						<group padding="0" groupbordervisible="false" cols="1" rows="1" row="1" col="3">
							<item caption="Vrsta dokumenta:" row="1" col="1" readonly="true" textposition="left" fontsizedelta="1">
								<comboedit name="cmbVrstaDok" autopopulate="true" valuefield="VrstaDokId" fontsizedelta="1" displayfield="Opis" datavalue="~dtGlavaGet.@VrstaDokId" dataname="dtVrstaDok" readonly="true">
								</comboedit>			
							</item>
						</group>
						<group padding="0" groupbordervisible="false" cols="1" rows="1" row="1" col="5">
							<item caption="Broj:" row="1" col="1" readonly="true" textposition="left" fontsizedelta="1">
								<textedit name="txtBroj" datavalue="~dtGlavaGet.@BrojDok" readonly="true" fontsizedelta="1"/>
							</item>	
						</group> 
					</group>  
				</group>
				<group padding="0" cols="1" rows="1" groupbordervisible="false" col="1" row="2">
					<item row="1" col="1" highlight="False" >
						<grid name="grdStavke" dataname="~dtStavke" multiselect="true" key="KntPrometId" showfooter="false" savelayout="true">								
							<event type="doubleclick">
								<part name="prtTemStavkaIzmijeni" path="prtTemeljnice.xml"/>
							</event>
							<event type="keydown">
								<!--DELETE-->							
								<action if="key==46">
                                             <action if="#grdStavke.rowcount!=0">
									     <part name="prtTemStavkaObrisi" path="prtTemeljnice.xml"/>	
                                             </action>
								</action>
								<!--ENTER-->
								<action if="key==13">
                                             <action if="#grdStavke.rowcount!=0">
									     <part name="prtTemStavkaIzmijeni" path="prtTemeljnice.xml"/>
								     </action>
                                             <action elseif="#grdStavke.rowcount==0">
                                        	     <part name="prtTemStavkaDodaj" path="prtTemeljnice.xml"/>
								     </action>
                                        </action>		
								<!--INSERT-->
								<action if="key==45">
									<part name="prtTemStavkaDodaj" path="prtTemeljnice.xml"/>
								</action>								
							</event>
							<event type="focusedrowchanged">
								<action type="datarun reader" value="~dtGetCumulative"/>
								<action type="control value" value="#curSalDuguje">
									<parameter value="~dtGetCumulative.@CumSumDuguje"/>
								</action>
								<action type="control value" value="#curSalPotrazuje">
									<parameter value="~dtGetCumulative.@CumSumPotrazuje"/>
								</action>
								<action type="control value" value="#curSalSaldo">
									<parameter value="~dtGetCumulative.@CumSumSaldo"/>
								</action>
								<action type="datarun reader" value="~dtGetCumulativeDev"/>
								<action type="control value" value="#curSalDevDug">
									<parameter value="~dtGetCumulativeDev.@CumSumDuguje"/>
								</action>
								<action type="control value" value="#curSalDevPot">
									<parameter value="~dtGetCumulativeDev.@CumSumPotrazuje"/>
								</action>
								<action type="control value" value="#curSalSaldoDev">
									<parameter value="~dtGetCumulativeDev.@CumSumSaldo"/>
								</action>								
							</event>
							<fields>	
								<field name="KntPrometId" caption="KntPrometId" fixwidth="50" hidden="true"/>
								<field name="Konto" caption="Konto" fixwidth="50"/>
								<field name="Naziv" caption="Naziv" fixwidth="150"/>
								<field name="Opis" caption="Opis knjiženja" fixwidth="100"/>
								<field name="duguje" caption="Duguje" showsum="true" fixwidth="100"/>
								<field name="potrazuje" caption="Potražuje" showsum="true" fixwidth="100"/>
								<field name="Broj" caption="Račun" fixwidth="100"/>
								<field name="DatumDokumenta" caption="Datum dokumenta" fixwidth="100"/>
                                        <field name="DatumValute" caption="Datum valute"/>
								<field name="Ufa" caption="Ufa" fixwidth="40"/>
								<field name="OrgShemaNaziv" caption="Organizacijska\nshema" />
								<field name="NacinPlac" caption="Način plaćanja" />
								<field name="devdug" caption="Duguje\ndevizno" fixwidth="100"/>
								<field name="devpot" caption="Potražuje\ndevizno" fixwidth="100"/>
								<field name="Valuta" caption="Valuta"/>
								<field name="Dimenzija" caption="Dimenzija" fixwidth="40"/>
								<field name="Inicijali" caption="Operater" fixwidth="40"/>
								<field name="DatumUnosa" caption="Datum unosa" fixwidth="100" format="dd.MM.yyyy HH:mm"/>	
								<field name="KljucTroska" caption="Ključ troška"/>	
								<!--specifične kolone po firmama dodati u part-->
								<part name="prtTemGridLokal" path="prtTemeljnice.xml"/>
							</fields>
							<styles>
								<style name="fontcolor" value="#800000" if="#grdStavke.@Duguje&lt;0||#grdStavke.@Potrazuje&lt;0"/>
								<style name="fontcolor" value="black" else=""/>
							</styles>
						</grid>
					</item>
				</group>
				<group padding="0" spacing="0" alignmode="local" groupbordervisible="true" cols="1" rows="2" col="1" row="3">
					<!--KUNE-->
					<group padding="0" spacing="0" alignmode="local" groupbordervisible="true" cols="8" rows="1" col="1" row="1">
						<columnsdefinition>
							<column size="90" position="1" />
							<column size="10%" position="2" />
							<column size="10%" position="3" />
							<column size="10%" position="4" />
							<column size="90" position="5" />
							<column size="10%" position="6" />
							<column size="10%" position="7" />
							<column size="10%" position="8" />						
						</columnsdefinition>
						<!-- <group padding="0" groupbordervisible="false" cols="1" rows="2" col="1" row="1"> -->
						<!-- <item caption="UKUPNA SUMA:" textposition="right" row="1" col="1"/> -->
						<!-- <item caption="MEĐUSUMA:" textposition="right" row="2" col="1"/>	 -->
						<!-- </group> -->
						<!-- <group padding="0" groupbordervisible="false" cols="6" rows="1" col="2" row="1"> -->
						<group groupbordervisible="false" cols="1" rows="1" row="1" col="5">
							<item caption="UKUPNO:" textposition="left" col="1" row="1"/>
						</group>
						<group groupbordervisible="false" cols="1" rows="1" row="1" col="1">
							<item caption="MEĐUSUMA:" textposition="left" />
						</group>
						<item textposition="left" row="1" col="6" caption="D:">
							<textedit name="curDuguje" value="0" format="n2" datavalue="~dtCalc.@SumDuguje" readonly="true"/>
						</item>	
						<item row="1" col="7" caption="P:" textposition="left">
							<textedit name="curPotrazuje" value="0" format="n2" datavalue="~dtCalc.@SumPotrazuje" readonly="true"/>
						</item>
						<item row="1" col="8" caption="S:" textposition="left">
							<textedit name="curSaldo" value="0" format="n2" datavalue="~dtCalc.@SumSaldo" readonly="true">
								<event type="valuechanged">	
									<!--čeka novu verziju Carpa-->
									<action type="control attribute" value="#curSaldo" if="#curSaldo!=0">
										<parameter name="fontcolor" value="red"/>
									</action>
											<action type="control attribute" value="#curSaldo" else="">
												 <parameter name="fontcolor" value="black"/>
											</action>                                        
								</event>
							</textedit>
						</item>		
						<item textposition="left" row="1" col="2" caption="D:">
							<textedit name="curSalDuguje" value="0" format="n2" datavalue="~dtGetCumulative.@CumSumDuguje" readonly="true"/>
						</item>	
						<item row="1" col="3" caption="P:" textposition="left">
							<textedit name="curSalPotrazuje" value="0" format="n2" datavalue="~dtGetCumulative.@CumSumPotrazuje" readonly="true"/>
						</item>
						<item row="1" col="4" caption="S:" textposition="left">
							<textedit name="curSalSaldo" value="0" format="n2" datavalue="~dtGetCumulative.@CumSumSaldo" readonly="true"/>
						</item>			
						<!-- </group> -->
					</group>
					<!--DEVIZE-->
					<group padding="0" spacing="0" alignmode="local" groupbordervisible="true" cols="8" rows="1" col="1" row="2">
						<columnsdefinition>
							<column size="90" position="1" />
							<column size="10%" position="2" />
							<column size="10%" position="3" />
							<column size="10%" position="4" />
							<column size="90" position="5" />
							<column size="10%" position="6" />
							<column size="10%" position="7" />
							<column size="10%" position="8" />						
						</columnsdefinition>
						<!-- <group padding="0" groupbordervisible="false" cols="1" rows="2" col="1" row="1"> -->
						<!-- <item caption="UKUPNA SUMA:" textposition="right" row="1" col="1"/> -->
						<!-- <item caption="MEĐUSUMA:" textposition="right" row="2" col="1"/>	 -->
						<!-- </group> -->
						<!-- <group padding="0" groupbordervisible="false" cols="6" rows="1" col="2" row="1"> -->
						<group groupbordervisible="false" cols="1" rows="1" row="1" col="5">
							<item caption="UKUPNO DEV:" textposition="left" col="1" row="1"/>
						</group>
						<group groupbordervisible="false" cols="1" rows="1" row="1" col="1">
							<item caption="MEĐUSUMA DEV:" textposition="left" />
						</group>
						<item textposition="left" row="1" col="6" caption="D:">
							<textedit name="curDevDug" value="0" format="n2" datavalue="~dtCalcDev.@SumDuguje" readonly="true"/>
						</item>	
						<item row="1" col="7" caption="P:" textposition="left">
							<textedit name="curDevPot" value="0" format="n2" datavalue="~dtCalcDev.@SumPotrazuje" readonly="true"/>
						</item>
						<item row="1" col="8" caption="S:" textposition="left">
							<textedit name="curSaldoDev" value="0" format="n2" datavalue="~dtCalcDev.@SumSaldo" readonly="true">
								<event type="valuechanged">	
									<!--čeka novu verziju Carpa-->
									<action type="control attribute" value="#curSaldoDev" if="#curSaldoDev!=0">
										<parameter name="fontcolor" value="red"/>
									</action>
											<action type="control attribute" value="#curSaldoDev" else="">
												 <parameter name="fontcolor" value="black"/>
											</action>                                        
								</event>
							</textedit>
						</item>		
						<item textposition="left" row="1" col="2" caption="D:">
							<textedit name="curSalDevDug" value="0" format="n2" datavalue="~dtGetCumulativeDev.@CumSumDuguje" readonly="true"/>
						</item>	
						<item row="1" col="3" caption="P:" textposition="left">
							<textedit name="curSalDevPot" value="0" format="n2" datavalue="~dtGetCumulativeDev.@CumSumPotrazuje" readonly="true"/>
						</item>
						<item row="1" col="4" caption="S:" textposition="left">
							<textedit name="curSalSaldoDev" value="0" format="n2" datavalue="~dtGetCumulativeDev.@CumSumSaldo" readonly="true"/>
						</item>			
						<!-- </group> -->
					</group>				
				</group>
			</group>
		</layout>
		<actionpanel>
			<items>
				<!-- <buttons>	 -->
				<item>
					<button name="btnAddDetalj" caption="&amp;DODAJ" type="add">
						<event type="click">
							<part name="prtTemStavkaDodaj" path="prtTemeljnice.xml"/>
							<action type="control focus" value="#grdStavke"/>
						</event>
					</button>	
				</item>
				<item>
					<button name="btnEditDetalj" caption="&amp;IZMIJENI" type="edit">
						<event type="click">
							<part name="prtTemStavkaIzmijeni" path="prtTemeljnice.xml"/>
						</event>
					</button>
				</item>
				<item>
					<button name="btnDelDetalj" caption="&amp;OBRIŠI"  type="delete">
						<event type="click">
							<part name="prtTemStavkaObrisi" path="prtTemeljnice.xml"/>
						</event>
					</button>
				</item>
				<item>
					<button name="btnSpec" caption="SPECIFIKACIJA" dataname="~dtPrint" displayfield="Opis" width="100">
						<event type="click">
							<action type="control print" value="#grdStavke" if="#grdStavke.@PartneriId!=null">
								<action type="print template" value="#btnSpec.@Template">
									<parameter name="id" value="Global.$KntTemId" />
									<parameter name="PartneriId" value="#grdStavke.@PartneriId"/>
									<parameter name="KntPlanAId" value="#grdStavke.@KntPlanAId"/>
								</action>
							</action>
						</event>
					</button>
				</item>
				<item>
					<labeledit value=" " />
				</item>
				<item>
					<button name="btnOdustani" caption="SPREMI" type="cancel">
						<event type="click">
							<!--AA: možda su ovdje ova dva actiona nepotrebna jer su postavljena iza form open u frmTemeljnice, ali ostavljam za svaki slučaj-->
							<action if="$UraInd!=1&amp;&amp;$IraInd!=1">
								<action type="datarun scalar" value="~dtGetParsedText">
									<parameter name="parent.$DodatnoTemp"/>
								</action>						
								<action type="variable value">
									<parameter name="parent.$NoviId" value="Global.$KntTemId"/>
								</action>
							</action>
							<action type="form close"/>	
						</event>		
					</button>
				</item>
				<item>
					<button name="btnZakljuci" caption="ZAKLJUČI" dock="right" >
						<event type="click">
							<action type="confirm" value="Želite li zaključiti dokument?">
								<action type="validate"/>
								<action type="message" value="Temeljnica nije u ravnoteži!" if="#curSaldo!=0"/>
								<action else="">
									<action type="datarun nonquery" value="~dtZakljuci"/>
									<action type="control focus" value="parent.#grdGlava" if="$UraInd!=1&amp;&amp;$IraInd!=1">
										<parameter value="Global.$KntTemId" />
									</action>
									<action type="form close"/>	
								</action>
							</action>
						</event>
					</button>
				</item>				
				<!-- </buttons> -->
			</items>
		</actionpanel>
		<datalist>							
			<data name="dtStavke" command="spCKntPrometQuery">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="Global.$KntTemId" />
			</data>
			<data command="spCKntTemQuery" name="dtGlavaGet">
				<parameter name="@Action" value="1" />
				<parameter name="@Id" value="Global.$KntTemId" /> 
			</data>
			<data command="spCKntTemCalc" name="dtCalc">
				<parameter name="@action" value="1" />
				<parameter name="@id" value="Global.$KntTemId" />
			</data>
			<data name="dtVrstaDok" command="spCKntTemVrstaDokQuery">
				<parameter name="@Action" value="8"/>
			</data>
			<data command="spCKntTemCalc" name="dtGetCumulative">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="Global.$KntTemId" />
				<parameter name="@KntprometId" value="#grdStavke.@KntPrometId" />
			</data>
			<data command="spCKntTemAzur" name="dtZakljuci">
				<parameter name="@action" value="14" />
				<parameter name="@Id" value="Global.$KntTemId" />
				<parameter name="@Status" value="1" />
			</data>
			<data command="spCarpoPrint" name="dtPrint">
				<parameter name="@Action" value="Temeljnica" />
				<parameter name="@Id" value="Global.$KntTemId" type="int" />
			</data>
			<data command="spCKntPrometAzur" name="dtDeleteStavka">
				<!-- unutra exec spCKntTemAzurirajRacune-->
				<parameter name="@action" value="4" />
				<parameter name="@Id" value="#grdStavke.@KntPrometId" />
			</data>
			<data name="dtZadnjiKntPromet" command="spCKntTemZadnjaStavka">
				<parameter name="@Action" value="1"/>
				<parameter name="@KntTemId" value="global.$KntTemId"/>
			</data>
			<data command="spCKntFaktureAzur" name="dtFaktureIndGlk">
				<parameter name="@action" value="4" />
				<parameter name="@IndGlk" value="0"/>
				<parameter name="@Id" value="#grdStavke.@IdDok" />
                    <parameter name="@KntTemId" value="global.$KntTemId"/>
			</data>
			<data command="spCKntFaktureDobAzur2" name="dtFaktureDobIndGlk">
				<parameter name="@action" value="4" />
				<parameter name="@IndGlk" value="0" />
				<parameter name="@Id" value="#grdStavke.@IdDok" />
			</data>				
			<!-- DODAO OGNJEN -->
			<data command="spCKntTemStornirajHelp" name="dtGetParsedText">
				<parameter name="@VrsteDok" value="$VrsteDok"/>
				<parameter name="@ParsedTreeValue" value="#datDatumdok"/>
				<parameter name="@Rbr" value="Global.$VrstaDokId" if="$VrsteDok==true"/>
			</data>
			<!--AA-->
			<data name="dtTemAzur" command="spCKntTemAzur">
				<parameter name="@Action" value="3"/>
				<parameter name="@Duguje" value="#curDuguje"/>
				<parameter name="@Potrazuje" value="#curPotrazuje"/>
				<parameter name="@Id" value="$KntTemId"/>
			</data>
			<data name="dtFokus" command="spCKntTemInfo">
				<parameter name="@Action" value="2"/>
				<parameter name="@KntTemId" value="$KntTemId"/>
				<parameter name="@KntPrometId" value="$FokusIdPomoc"/>
			</data>
