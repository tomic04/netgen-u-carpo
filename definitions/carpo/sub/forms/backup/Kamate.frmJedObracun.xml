<root>
	<form name="frmJedObracun" caption="Obračun kamata" width="750" height="700">
		<event type="shown">
			<action type="control populate" value="#grdStavkeObracun"/>
		</event>
		<layout>
			<group cols="1" rows="1" caption="Obračun">
				<item col="1" row="1">
					<grid name="grdStavkeObracun" key="BrojFak" dataname="~dtObrGrid" showfooter="true"  multiselect="true" showgrouppanel="false" bestfitonrefresh="true">
						<fields>
							<field name="BrojFak" caption="Broj računa" groupindex="0"/>
							<field name="Duguje"/>
							<field name="Potrazuje" caption="Potražuje"/>
							<field name="Datum"/>
							<field name="BrojDana" caption="Broj dana"/>
							<field name="Koef" caption="Koeficijent" showgroupsum="false" showtotalsum="false"/>
							<field name="Stopa" showgroupsum="false" showtotalsum="false"/>
							<field name="Godmje" caption="Obračunski period" showgroupsum="false" showtotalsum="false"/>
							<field name="Osnovica" showgroupsum="false" showtotalsum="false"/>
							<field name="Kamate"/>							
						</fields>
					</grid>
				</item>				
			</group>
		</layout>
		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<button name="btnDeleteAll" caption="PONIŠTI OBRAČUN">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite poništiti obračun?">
							<action type="datarun nonquery" value="~dtObrisiObr"/>								
							<action type="control populate" value="#grdStavkeObracun"/>
						</action>
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI RAČUN">
						<event type="click">
							<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?">
								<action type="datarun nonquery" value="~dtObrisiObrRc"/>								
								<action type="control populate keepfocus" value="#grdStavkeObracun"/>
							</action>
						</event>
					</button>
				<button name="btnPrint" caption="ISPIS SUČELJA" dock="right">
					<event type="click">
						<action type="control printcontrol" value="#grdStavkeDetalj" /> 
					</event>
				</button>
				<!-- <button name="btnUpute" caption="Uputi me" dock="right"> -->
					<!-- <event type="click"> -->
						<!-- <action type="message" value="Ova funkcionalnost trenutno nije dostupna, molimo kontaktirajte Spin!"/> -->
					<!-- </event> -->
				<!-- </button> -->
				<button name="btnExit" type="cancel" caption="SPREMI" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtObrisiObr" command="spCKteObracunAzur">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$kntKteGlavaId"/>
			</data>
			<data name="dtObrisiObrRc" command="spCKteObracunAzur">
				<parameter name="@Action" value="0"/>
				<parameter name="@Id" value="$kntKteGlavaId"/>
				<parameter name="@SelectedId" value="#grdStavkeObracun.selectedids.BrojFak"/>
			</data>
			<data name="dtObrGrid" command="spCKteObracunQuery">
				<parameter name="@Action" value="0"/>
				<parameter name="@ID" value="$kntKteGlavaId"/>
			</data>
		</datalist>
	</form>
</root>