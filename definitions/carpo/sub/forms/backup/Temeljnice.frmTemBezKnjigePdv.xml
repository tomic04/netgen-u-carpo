<root>
	<form name="frmTemBezKnjigePdv" caption="Novi račun bez PDV knjige" fixedsize="true">
		<event type="init"> 
		   <action type="datarun reader" value="~dtGetVrstaDok" />
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="4" groupbordervisible="true">
				<item col="1" row="1" caption="Broj računa:">
					<textedit name="txtRacun"  value=""  datavalue=""/>
				</item>
				<item col="1" row="2" caption="Datum dokumenta:">
					<dateedit  name="datDatumDok"  value="now">
					</dateedit>
				</item>
				<item col="1" row="3" caption="Datum valute:">
					<dateedit  name="datDatumValute"  value="now">
					</dateedit>
				</item>
				<item col="1" row="4"  caption="Valuta:">
					<comboedit name="cbDevValuta" autopopulate="true" valuefield="ValuteId" displayfield="Oznaka" datavalue="~dtGetDevValute.@ValuteId" dataname="dtGetDevValute">
					</comboedit>
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOK" caption="&amp;U REDU" dock="left">
				   <event type="click">
						<action type="datarun scalar" value="~dtInsertBezPDV"/>	
						<action type="form close"/>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
		    <data command="spCKntTemValuteQuery" name="dtGetDevValute">
				<parameter name="@Action" value="0" />
			</data>	
			<data command="dbo.spCKntTemInsertFak" name="dtInsertBezPDV">
				<parameter name="@tablica" value="$Tablica" />
				<parameter name="@broj " value="#txtRacun" />
				<parameter name="@datumDok" value="#datDatumDok" />
				<parameter name="@datumValute" value="#datDatumValute" />
				<parameter name="@devValuteId" value="#cbDevValuta" />
                <parameter name="@partneriId" value="$PartneriId" />
                <parameter name="@operateriId" value="@@operateriid" />
				<parameter name="@vrstaDokId" value="~dtGetVrstaDok.@VrstaDokId" />
			</data>	
			 <data command="spCKntTemVrstaDokQuery" name="dtGetVrstaDok">
				<parameter name="@Action" value="3" />
				<parameter name="@Opis" value="Faktura kontor" />
			</data>	
		</datalist>
	</form>
</root>