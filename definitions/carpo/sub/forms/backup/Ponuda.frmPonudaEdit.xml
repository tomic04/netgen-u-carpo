<root>
	<form name="frmPonudaEdit" caption="Izmjena dokumenta" width="1000" height="570" statusbar="true" operaterlocktable="ProPonGla" operaterlockkey="ProPonGlaId" operaterlockkeyvalue="Global.$DokId" > 
		<method name="fnRobaInfo" dll="RobaInfoNet" class="RobaInfo.frmMain" method="Open" />
		<method name="fnRTFNapomena" dll="ProNapomenaRTF" class="ProNapomenaRTF.Napomena" method="run" />
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.DimenzijeCarpo" method="run" />
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="Global.dtPubVars"/>
			<action type="variable value" >
				<parameter name="IndKredit" value="~dtGet.@IndKredit"/>
			</action>
			<action type="variable value">
				<parameter name="PartneriId" value="~dtGet.@PartneriId" />
			</action>
			<action type="variable value">
				<parameter name="InitTecaj" value="~dtGet.@VrBoda" />
			</action>
			<action type="variable value">
				<parameter name="InitValuta" value="~dtGet.@DevValuteId" />
			</action>
			<action type="variable value">
				<parameter name="Smije" value="~dtGet.@Smije" />
			</action>
			<action type="variable value">
				<parameter name="Izmjena" value="1" />
			</action>			
		</event>
		<event type="onload">
			<action type="control visible" value="#btnPokojnik">
				<parameter value="false" if="Global.$FakturaUkopInd==0"/>
			</action>	
			<action type="variable value" if="#cmbValuta!=null">
				<parameter name="BrDecimalaValuta" value="#cmbValuta.@BrDecimala" />
			</action>
			<action type="variable value" else="">
				<parameter name="BrDecimalaValuta" value="6" />
			</action>								
			<action type="control attribute" value="bteVrBoda" >
				<parameter name="format" value="n{$BrDecimalaValuta}"></parameter>
			</action>				
			<action type="control disable" value="##" if="$StatusPon==2||$StatusPon==0||$Smije==0" />
			<action type="control disable" value="#btnPokojnik" if="$StatusPon==2||$StatusPon==0||$Smije==0" />
			<action type="control populate" value="#grdRoba,#grdDimenzije"></action>
			<action type="control enable" value="#btnOtpisi, #btnSpremi" if="$StatusPon==1&amp;&amp;$Smije==1"/>
			<action type="control disable" value="#btnOtpisi, #btnSpremi" else="" />	
			<action type="control disable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" if="$StatusPon!=1||#grdRoba.rowcount==0||$Potvrda==Potvrđeno||$Smije!=1"/>
			<action type="control enable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" else="" />	
			<action type="control disable" value="#btnAddDetalj, #btnDonesiDetalj" if="$StatusPon!=1||$Potvrda==Potvrđeno||$Smije!=1"/>
			<action type="control enable" value="#btnAddDetalj, #btnDonesiDetalj" else="" />				
			<action type="control disable" value="#bteVrBoda" if="#cmbValuta==null||$StatusPon!=1||$Smije!=1" />
			<action type="control enable" value="#bteVrBoda" else="" />
			<action type="control disable" value="#btnRobaInfo" if="#grdRoba.rowcount==0" />
			<action type="control enable" value="#btnRobaInfo" else="" />				
			<action type="control enable" value="#btnKredit, #grdUvjeti" if="~dtGet.@IndKredit==2&amp;&amp;$StatusPon==1&amp;&amp;$Smije==1" />
			<action type="control disable" value="#btnKredit, #grdUvjeti" else="" />
			<action type="control disable" value="#btnIzmijeniDane, #txtDani" if="~dtGet.@IndKredit==2||$StatusPon!=1||$Smije!=1" />
			<action type="control enable" value="#btnIzmijeniDane, #txtDani" else="" />
			<action type="control enable" value="#srcRadniNalog" if="~dtPubVars.@Ponude_KoopUgovori==1&amp;&amp;$StatusPon==1&amp;&amp;$Smije==1"/>			
			<action type="control disable" value="#srcRadniNalog" else=""/>			
			<action type="control itemcaption" value="#bteVrBoda">
				<parameter value="Tečaj:" if="#cmbValuta!=null"/>
				<parameter value="Bod:" else=""/>>
			</action>
			<action type="control value" value="#cmbNacinOtpreme">
				<parameter value="~dtGet.@NacinIsporukeId"/>
			</action>
			<action type="control value" value="#cmbNacinPlacanja">
				<parameter value="~dtGet.@ProNacinNaplateId"/>
			</action>
			<action type="control value" value="#cmbOrgShema">
				<parameter value="~dtGet.@OrgShemaId"/>
			</action>
			<action type="control value" value="#cmbSkladiste">
				<parameter value="~dtGet.@SkladisteId"/>
			</action>
			<action type="control value" value="#cmbInstrumentPlacanja">
				<parameter value="~dtGet.@KntNacinPlacId"/>
			</action>
      <action type="control disable" value="#datDatumSlanja" if="#datDatumSlanja==null" />
      <action type="control value" value="#datDatumSlanja">
        <!--  <parameter value="now" /> -->
        <parameter value="~dtGet.@DatumSlanja" if="~dtGet.@provdatum==1"/>
        <parameter value="null" else=""/>
      </action>
		</event>
		<event type="onshown">
			<action type="variable value">
				<parameter name="IndLoad" value="1" />
			</action>		
			<action type="control focus" value="#btnAddDetalj"/>
			<!-- <action type="control value" value="#lblZvjezdica" if="~dtPubVars.@Ponude_ObaveznoSkladište==1"> -->
				<!-- <parameter value="*"></parameter> -->
			<!-- </action> -->
			<!-- <action type="control value" value="#lblZvjezdica" else=""> -->
				<!-- <parameter value=" "></parameter> -->
			<!-- </action> -->
			<action type="control value" value="txtIznosSPDV" if="$DokIznosSPDV!=null">
				<parameter value="$DokIznosSPDV" />
            </action>
			<action type="control value" value="txtIznosSPDV" else="">
				<parameter value="0" />
            </action>			
			<action type="control value" value="txtIznosBezPDV" if="$DokIznosBezPDV!=null">
				<parameter value="$DokIznosBezPDV" />
            </action>
			<action type="control value" value="txtIznosBezPDV" else="">
				<parameter value="0" />
            </action>
			<action type="footer text" value="Broj stavaka: {#grdRoba.rowcount}"/>			
		</event>
		<event type="close">
			<action type="datarun reader" value="~dtProvjeriRate" if="~dtGet.@IndKredit==2&amp;&amp;$StatusPon==1&amp;&amp;$Smije==1"/>
			<action type="variable value" >
				<parameter name="IndDiff" value="~dtProvjeriRate.@IndDiff"/>
			</action>	
			<action type="variable value" >
				<parameter name="Poruka" value="~dtProvjeriRate.@Poruka"/>
			</action>
			<action type="message" value="$Poruka" if="$IndDiff==1">
			</action>
			<action if="$IndTSP!=1">
				<action type="control populate" value="parent.#grdGlava" >
					<action type="control focus" value="parent.#grdGlava">
						<parameter value="$ProPonGlaId" />
					</action>
					<action type="control populate" value="parent.#grdDetail" />
					<action type="control populate" value="parent.#grdDimenzije" />
				</action>
			</action>
		</event>		
		<layout textposition="left" itemspadding="3">
			<group cols="1" rows="1">
				<group padding="0" groupbordervisible="False" cols="3" rows="1">
					<columnsdefinition>
						<column size="390" position="1" />
						<column size="8" position="2" />
					</columnsdefinition>
					<item row="1" col="2" />
					<group padding="0" groupbordervisible="False" cols="1" rows="4" col="3" row="1">
						<rowsdefinition>
							<row size="54" position="4" />
						</rowsdefinition>
						<part name="partBrziUnos" path="prtPonudaLokalizacije.xml" />
						<group padding="0" groupbordervisible="False" cols="1" rows="1" col="1" row="2">
						<tabs col="1" row="1">
						<group padding="0" caption="Stavke" groupbordervisible="False" cols="1" rows="1" col="1" row="1">
						<item row="2" col="1" highlight="False" >
							<grid name="grdRoba" multiselect="true" key="ProPonDetId" showgrouppanel="False" showfooter="True" savelayout="true" bestfitonrefresh="true">
								<event type="focusedrowchanged">
									<action type="control populate" value="#grdDimenzije" />
								</event>							
								<event type="doubleclick">
									<action type="form open" value="frmRoba" if="#grdRoba.rowcount&gt;0">
										<parameter name="ProPonDetId" value="#grdRoba.@ProPonDetId"/>
										<parameter name="ProPonGlaId" value="$ProPonGlaId" />
										<parameter name="Action" value="1" type="int"/>										
										<parameter name="ParStruId" value="#srcParstru" />
										<parameter name="PartneriId" value="#srcPartner" />
										<parameter name="SkladisteId" value="#cmbSkladiste" />
										<parameter name="DatumDok" value="#datDatumdok" />
										<parameter name="OrgShemaId" value="#cmbOrgShema" />
										<parameter name="ValuteId" value="#cmbValuta"/>
										<parameter name="Valuta" value="#cmbValuta.@MalaOznaka"/>
										<parameter name="Tecaj" value="#bteVrBoda"/>										
										<parameter name="StatusPon" value="$StatusPon"/>
										<parameter name="Smije" value="$Smije"/>										
										<parameter name="Potvrda" value="$Potvrda"/>	
									</action>
									<action type="control populate keepfocus" value="#grdRoba" />
									<action type="datarun reader" value="~dtIznos"/>									
									<action type="control value" value="txtIznosSPDV">
										<parameter value="~dtIznos.@IznosKn" />
									</action>	
									<action type="control value" value="txtIznosBezPDV">
										<parameter value="~dtIznos.@IznosOsnovica" />
									</action>									
								</event>
								<event type="keydown" value="46">
									<action type="confirm" value="Želite li obrisati označene stavke s ponude?">
										<action type="control foreachrow selected" value="#grdRoba">
											<action type="datarun nonquery" value="~dtDetDelete"></action>
										</action>
										<action type="control populate" value="#grdRoba" />
										<action type="control disable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" if="$StatusPon!=1||#grdRoba.rowcount==0||$Potvrda==Potvrđeno||$Smije!=1"/>
										<action type="control enable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" else="" />	
										<action type="control disable" value="#btnRobaInfo" if="#grdRoba.rowcount==0" />
										<action type="control enable" value="#btnRobaInfo" else="" />										
									</action>
									<action type="datarun reader" value="~dtIznos"/>									
									<action type="control value" value="txtIznosSPDV">
										<parameter value="~dtIznos.@IznosKn" />
									</action>	
									<action type="control value" value="txtIznosBezPDV">
										<parameter value="~dtIznos.@IznosOsnovica" />
									</action>									
								</event>								
								<data command="spProd_PonDet_Grid">
									<parameter name="@Id" value="$ProPonGlaId" />
								</data>
								<part name="partPonudaDetaljGrid" path="prtPonudaLokalizacije.xml" />
 								<styles>
									<style name="fontcolor" value="gray" if="#grdRoba.@IndOpcija==true" />
									<style name="fontcolor" value="red" elseif="#grdRoba.@IndRucnoZatvoreno==1" />
									<style name="fontcolor" value="blue" elseif="#grdRoba.@IndUsluga==1" />
									<style name="bold" value="true" if="#grdRoba.@IndBold==1" />
								</styles>							
							</grid>
						</item>
						</group>
						<group caption="Dimenzije" padding="0" groupbordervisible="False" cols="1" rows="1" col="1" row="1">
							<item col="2" row="1" highlight="False" >
								<grid name="grdDimenzije" keyfield="ProPonGlaId" multiselect="true" dataname="~dtDimenzije" showmenuprintitem="false" showmenutools="false" savelayout="true">
									<fields inherited="true">
										<field name="Sifra" caption="Šifra" fontbold="true" fixed="left" index="0" />
										<field name="Roba" caption="Naziv robe" fontbold="true" fixed="left" index="1" />
										<field name="Kolicina" caption="Količina" width="1000" index="2" />
									</fields>
								</grid>
							</item>					
						</group>						
						</tabs>
						</group>
						<group padding="0" groupbordervisible="false" cols="6" rows="1" col="1" row="3">
							<columnsdefinition>
								<column size="94" position="1" />
								<column size="100" position="2" />
								<column size="89" position="3" />
								<column size="100" position="4" />								
							</columnsdefinition>
							<item row="1" col="1" textalignmode="auto">
								<labeledit name="lblIznosBezPDV" value="Iznos bez PDV-a:"/>
							</item>	
							<item caption="" row="1" col="2" textalignmode="auto">
								<textedit name="txtIznosBezPDV" value="~dtIznos.@IznosOsnovica" format="n2" enabled="false"/>
							</item>	
							<item caption="" row="1" col="3" textalignmode="auto">
								<labeledit name="lblIznosSPDV" value="Iznos s PDV-om:"/>
							</item>								
							<item caption="" row="1" col="4" textalignmode="auto">
								<textedit name="txtIznosSPDV" value="~dtIznos.@IznosKn" format="n2" enabled="false"/>
							</item>
							</group>
							<group padding="0" groupbordervisible="false" cols="2" rows="1" col="1" row="4">
							<group padding="0" groupbordervisible="true" cols="7" rows="1" col="1" row="1">
								<item row="1" col="1" textvisible="False">
									<button name="btnAddDetalj" caption="Dodaj" image="add" type="add">
										<event type="click">
											<action type="validate"/>
											<action type="datarun nonquery" value="~dtSpremi"/>
											<action type="form open" value="frmRoba">
												<parameter name="ProPonGlaId" value="$ProPonGlaId" />
												<parameter name="ParStruId" value="#srcParstru" />
												<parameter name="PartneriId" value="#srcPartner" />
												<parameter name="Action" value="0" type ="int" />
												<parameter name="SkladisteId" value="#cmbSkladiste" />
												<parameter name="DatumDok" value="#datDatumdok" />
												<parameter name="OrgShemaId" value="#cmbOrgShema" />
												<parameter name="ValuteId" value="#cmbValuta"/>	
												<parameter name="Valuta" value="#cmbValuta.@MalaOznaka"/>												
												<parameter name="Tecaj" value="#bteVrBoda"/>
												<parameter name="StatusPon" value="$StatusPon"/>	
												<parameter name="Smije" value="$Smije"/>
												<parameter name="Potvrda" value="$Potvrda"/>											
												</action>
												<action type="control disable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" if="$StatusPon!=1||#grdRoba.rowcount==0||$Potvrda==Potvrđeno||$Smije!=1"/>
												<action type="control enable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" else="" />
												<action type="control disable" value="#btnRobaInfo" if="#grdRoba.rowcount==0" />
												<action type="control enable" value="#btnRobaInfo" else="" />													
												<action type="control populate" value="#grdUvjeti" />
																							<action type="datarun reader" value="~dtIznos"/>									
												<action type="control value" value="txtIznosSPDV">
													<parameter value="~dtIznos.@IznosKn" />
												</action>	
												<action type="control value" value="txtIznosBezPDV">
													<parameter value="~dtIznos.@IznosOsnovica" />
												</action>
												<action type="footer text" value="Broj stavaka: {#grdRoba.rowcount}"/>
										</event>
									</button>
								</item>
										<item row="1" col="2" textvisible="False">
										<button name="btnEditDetalj" caption="Izmijeni" type ="edit" image="edit">
										<event type="click">
											<action type="validate"/>
											<action type="datarun nonquery" value="~dtSpremi"/>
											<action type="form open" value="frmRoba">
												<parameter name="ProPonDetId" value="#grdRoba.@ProPonDetId"/>
												<parameter name="ProPonGlaId" value="$ProPonGlaId" />
												<parameter name="ParStruId" value="#srcParstru" />
												<parameter name="PartneriId" value="#srcPartner" />
												<parameter name="Action" value="1" type="int"/>
												<parameter name="SkladisteId" value="#cmbSkladiste" />
												<parameter name="DatumDok" value="#datDatumdok" />
												<parameter name="OrgShemaId" value="#cmbOrgShema" />
												<parameter name="ValuteId" value="#cmbValuta"/>
												<parameter name="Valuta" value="#cmbValuta.@MalaOznaka"/>
												<parameter name="Tecaj" value="#bteVrBoda"/>
												<parameter name="StatusPon" value="$StatusPon"/>	
												<parameter name="Smije" value="$Smije"/>
												<parameter name="Potvrda" value="$Potvrda"/>											
											</action>
											<action type="control populate keepfocus" value="#grdRoba" />
											<action type="datarun reader" value="~dtIznos"/>									
											<action type="control value" value="txtIznosSPDV">
												<parameter value="~dtIznos.@IznosKn" />
											</action>	
											<action type="control value" value="txtIznosBezPDV">
												<parameter value="~dtIznos.@IznosOsnovica" />
											</action>											
										</event>
									</button>
								</item>
								<item row="1" col="3" textvisible="False">
									<button caption="Obriši" name="btnDelDetalj" image="delete">
										<event type="click">
											<action type="validate"/>
											<action type="datarun nonquery" value="~dtSpremi"/>
											<action type="confirm" value="Želite li obrisati označene stavke s ponude?">
												<action type="control foreachrow selected" value="#grdRoba">
													<action type="datarun nonquery" value="~dtDetDelete"></action>
												</action>
												<action type="control populate" value="#grdRoba" />
											<action type="control disable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" if="$StatusPon!=1||#grdRoba.rowcount==0||$Potvrda==Potvrđeno||$Smije!=1"/>
											<action type="control enable" value="#btnEditDetalj, #btnDelDetalj, #btnCijeneDetalj, #btnUrednik, #btnMoveDown, #btnMoveUp" else="" />	
											<action type="control disable" value="#btnRobaInfo" if="#grdRoba.rowcount==0" />
											<action type="control enable" value="#btnRobaInfo" else="" />												
											<action type="control populate" value="#grdUvjeti" />
											<action type="datarun reader" value="~dtIznos"/>									
											<action type="control value" value="txtIznosSPDV">
												<parameter value="~dtIznos.@IznosKn" />
											</action>	
											<action type="control value" value="txtIznosBezPDV">
												<parameter value="~dtIznos.@IznosOsnovica" />
											</action>
											<action type="footer text" value="Broj stavaka: {#grdRoba.rowcount}"/>											
											</action>											
										</event>
									</button>
								</item>
								<item row="1" col="4" textvisible="False">
									<button name="btnRobaInfo" caption="Roba info" function="RobaInfo">
										<event type="click">
											<action type="method run" value="fnRobaInfo">
												<parameter name="server" value="@@server" />
												<parameter name="baza" value="@@database" />
												<parameter name="username" value="" />        
												<parameter name="password" value="" />
												<parameter name="OperateriId" value="@@operateriid" />
												<parameter name="path" value="" />            
												<parameter name="robaid" value="#grdRoba.@RobaId" />
											</action>
										</event>
									</button>
								</item>
								<item row="1" col="5" textvisible="False">
									<button name="btnCijeneDetalj" caption="Osvježi cijene">
										<event type="click">
											<action type="validate"/>
											<action type="datarun nonquery" value="~dtSpremi"/>
											<action type="form open" value="frmOsvjeziCijene">
												<parameter name="ProPonGlaId" value="$ProPonGlaId"/>
											</action>
											<action type="control populate" value="#grdUvjeti" />
											<action type="datarun reader" value="~dtIznos"/>									
											<action type="control value" value="txtIznosSPDV">
												<parameter value="~dtIznos.@IznosKn" />
											</action>	
											<action type="control value" value="txtIznosBezPDV">
												<parameter value="~dtIznos.@IznosOsnovica" />
											</action>											
										</event>
									</button>
								</item>
								<item row="1" col="6" textvisible="False">
									<button  caption="Urednik" name="btnUrednik">
										<dropdownitem caption="Rabata">
											<event type="click">
												<action type="validate"/>
												<action type="datarun nonquery" value="~dtSpremi"/>
												<action type="form open" value="frmUrednikRabata">
													<parameter name="ProPonGlaId" value="$ProPonGlaId"/>
												</action>
												<action type="control populate" value="#grdUvjeti" />
												<action type="datarun reader" value="~dtIznos"/>									
												<action type="control value" value="txtIznosSPDV">
													<parameter value="~dtIznos.@IznosKn" />
												</action>	
												<action type="control value" value="txtIznosBezPDV">
													<parameter value="~dtIznos.@IznosOsnovica" />
												</action>												
											</event>
										</dropdownitem>
										<dropdownitem caption="Prijenos na ugovore s kupcima">
											<event type="click">
												<action type="validate"/>
												<action type="datarun nonquery" value="~dtSpremi"/>
												<action type="form open" value="frmUrednikKupUgovori">
													<parameter name="ProPonGlaId" value="$ProPonGlaId"/>
												</action>
											</event>
										</dropdownitem>
									</button>
								</item>
								<item row="1" col="7" textvisible="False">
