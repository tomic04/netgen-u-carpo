<root>
	<form name="frmKnjigaUra_Insert_Rucno" caption="Unos dokumenta" fixedsize="true" > 
		<event type="init">
			<action type="datarun reader" value="~dtGetPodaci" />	
		</event>
		<event type="load">
			<action type="control value" value="#cbVrstaKnjige">
				<parameter value="$KntVrsteKnjigaUraId"/>
			</action>
			<action type="datarun reader" value="~dtGetPodaci" />
		</event>
		<event type="shown">
			<action type="control focus" value="#txtRacun"/>
			<action type="control attribute" value="#curIznosBezPdv,#curPdvUkupno">
				<parameter name="tabstop" value="false"/>
			</action>
		</event>
	
		<layout textposition="top" >
			<group cols="2" rows="1" groupbordervisible="false">
				<columnsdefinition>
					<column size="50%" position="1" />
					<column size="50%" position="2" />

				</columnsdefinition>
				<group  name="" cols="1" rows="3" col="1" row="1" groupbordervisible="false">
					<group caption="Opći podaci" col="1" row="1" cols="1" rows="3" spacing="2,2,2,2">
						<group caption="" col="1" row="1" cols="4" rows="1"  groupbordervisible="false">
							<columnsdefinition>
								<column position="1" size="200" />
								<column position="2" size="30" />
								<column position="3" size="30" />
								<column position="4" size="100" />
							</columnsdefinition>
							<item col="1" row="1" caption="Vrsta knjige:" padding="0">
								<comboedit name="cbVrstaKnjige" autopopulate="true" valuefield="KntVrsteKnjigaUraId" displayfield="NazivKnjige" datavalue="~dtVrstaKnjige.@KntVrsteKnjigaUraId" dataname="dtVrstaKnjige"/>
							</item>
							<group  name="" col="2" row="1" cols="2" rows="1"  groupbordervisible="false" alignmode="local">
								<item col="1" row="1" caption="R1"  padding="0" highlight="false"> 
									<radioedit name="rbR1" value="1" />
								</item>
								<item col="2" row="1" caption="R2"  padding="0" highlight="false"> 
									<radioedit name="rbR2" value="0" />
								</item>
							</group>
							
							<item col="4" row="1" caption="Redni broj:"  padding="0" > 
								<textedit name="txtRedniBroj" readonly="true" />
							</item>
							
						</group>
						<group caption="" col="1" row="2" cols="6" rows="1" colspan="6" groupbordervisible="false">
							<item col="1" row="2" caption="Račun:" colspan="4" padding="0" > 
								<textedit name="txtRacun"  />
							</item>
							<item col="5" row="2" caption="URA" colspan="2" padding="0"  > 
								<textedit name="txtURA" value=""/>
							</item>
						</group>
						<group caption="" col="1" row="3" cols="3" rows="1" colspan="6" groupbordervisible="false">
							<columnsdefinition>
								<column position="1" size="100" />
								<column position="2" size="100" />
								<column position="3" size="100" />
							</columnsdefinition>

							<item col="1" row="1" caption="Nadnevak:"  padding="0"  >
								<dateedit  name="datNadnevak" datavalue="~dtGetPodaci.@Nadnevak" minvalue="Global.$BlokadaOd" maxvalue="Global.$BlokadaDo">
									<event type="valuechanged" raiseonload="false" >
										<action type="datarun reader" value="~dtNadnevakGodina"/>
										<action type="control value" value="#txtGodina">
											<parameter value="~dtNadnevakGodina.@god"/>
										</action>
									</event>
								</dateedit>
							</item>
							<item col="2" row="1" caption="God.:"  padding="0"  > 
								<textedit name="txtGodina"  datavalue="~dtGetPodaci.@Godina"/>
							</item>
						</group>
					</group>

					<group caption="Partner" name="partner" cols="2" rows="3" col="1" row="2" colspan="6" spacing="2,2,8,2" >
						<item col="1" row="1" colspan="2" caption="Partner:" padding="0" >
							<searchedit  name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" dataname="dtGetPartneri">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtGetPodaciZaPartnera" /> 

									<action type="datarun reader" value="~dtGetPDVID" /> 

									<action type="control focus" value="#srcPartner" if="#srcPartner==null"/>
									<action type="control value" value="#txtAdresa">
										<parameter value="~dtGetPodaciZaPartnera.@Adresa"/>
									</action>
									<action type="control value" value="#txtMjesto">
										<parameter value="~dtGetPodaciZaPartnera.@Mjesto"/>
									</action>
									<action type="control value" value="#txtOIB">
										<parameter value="~dtGetPodaciZaPartnera.@OIB"/>
									</action>
									<action type="control populate" value="#cbPDVID" />
									<action type="control refreshvalue" value="#cbPDVID" />
								</event>
							</searchedit>
						</item>
						<item col="1" row="2" caption="Adresa:" colspan="1" padding="0" >
							<textedit name="txtAdresa" readonly="true"/>
						</item>
						<item col="2" row="2" caption="Mjesto:" colspan="1" padding="0" >
							<textedit name="txtMjesto" readonly="true"/>
						</item>
						<item col="1" row="3" caption="OIB:" colspan="1" padding="0" >
							<textedit name="txtOIB" readonly="true"/>
						</item>
						<item col="2" row="3" caption="PDVID:" colspan="1" padding="0" >
							<comboedit name="cbPDVID" autopopulate="true" valuefield="ParStruId" displayfield="Naziv"  dataname="dtGetPDVID" allownull="false">
								<event type="valuechanged" raiseonload="false"> 
									<action type="datarun reader" value="~dtEuPartnerParStru"/>
									<action type="variable value" value="$EUPartner" >
										<parameter value="~dtEuPartnerParStru.@EuPartner" type="int"/>
									</action>
								</event>
							</comboedit>
						</item>

					</group>

					<group caption="" name="" cols="2" rows="1" col="1" row="3" colspan="6" spacing="2,2,8,2" groupbordervisible="false">
						<!-- 10 red -->
						<item col="1" row="1" caption="Napomena:" colspan="2" padding="2,2,8,2" >
