<root>
    <form name="frmUrednikRabata" caption="Urednik rabata" width="400" height="250" fixedsize="true">
		<method name="funPriListKalkUrednikRabata" dll="Carpo.Specific" class="Carpo.Specific.Matpos.PriListKalkUrednikRabata" method="CalculationRabat" />

        <event type="onshown">
            <action type="control focus" value="#txtRabat1"></action>
        </event>
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group cols="5" rows="5" row="1" col="1">
                    <item row="1" col="1">
                        <labeledit value="Za označene stavke:" />
                    </item>
					 <item row="1" col="2">
                        <labeledit value="Rabat1:" />
                    </item>
					 <item row="1" col="3">
                        <labeledit value="Rabat2:" />
                    </item>
					 <item row="1" col="4">
                        <labeledit value="Rabat3:" />
                    </item>
                    <item row="2" col="1" caption="">
                        <radioedit name="rdoRabat" caption="Postavi rabat na" value="true" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabat1,#txtRabat2,#txtRabat3" if="#rdoRabat==true" >
                                    <action type="control focus" value="#txtRabat1"></action>
                                </action>
                                <action type="control disable" value="#txtRabat1,#txtRabat2,#txtRabat3" else="#rdoRabat==false" >
                                    <action type="control value" value="#txtRabat1,#txtRabat2,#txtRabat3">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item row="2" col="2" textalignmode="auto">
                        <textedit name="txtRabat1" value="0" format="n2" />
                    </item>
					<item row="2" col="3" textalignmode="auto">
                        <textedit name="txtRabat2" value="0" format="n2" />
                    </item>
					<item row="2" col="4" textalignmode="auto">
                        <textedit name="txtRabat3" value="0" format="n2" />
                    </item>
                    <item row="2" col="5" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                    <item row="3" col="1">
                        <radioedit name="rdoRabatPodigni" caption="Podigni postojeći rabat za" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatPodigni1,#txtRabatPodigni2,#txtRabatPodigni3" if="#rdoRabatPodigni==true">
                                    <action type="control focus" value="#txtRabatPodigni1"></action>
                                </action>
                                <action type="control disable" value="#txtRabatPodigni1,#txtRabatPodigni2,#txtRabatPodigni3" else="#rdoRabatPodigni==false" >
                                    <action type="control value" value="#txtRabatPodigni1,#txtRabatPodigni2,#txtRabatPodigni3">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="3" col="2" textalignmode="auto">
                        <textedit name="txtRabatPodigni1" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="3" col="3" textalignmode="auto">
                        <textedit name="txtRabatPodigni2" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="3" col="4" textalignmode="auto">
                        <textedit name="txtRabatPodigni3" value="0" format="n2" enabled="false"/>
                    </item>
                    <item row="3" col="5" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                    <item row="4" col="1">
                        <radioedit name="rdoRabatPodigniPlus" caption="Podigni rabat na postojeći rabat plus" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatPodigniPlus1,#txtRabatPodigniPlus2,#txtRabatPodigniPlus3" if="#rdoRabatPodigniPlus==true" >
                                    <action type="control focus" value="#txtRabatPodigniPlus1"></action>
                                </action>
                                <action type="control disable" value="#txtRabatPodigniPlus1,#txtRabatPodigniPlus2,#txtRabatPodigniPlus3" else="#rdoRabatPodigniPlus==false">
                                    <action type="control value" value="#txtRabatPodigniPlus1,#txtRabatPodigniPlus2,#txtRabatPodigniPlus3">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="4" col="2" textalignmode="auto">
                        <textedit name="txtRabatPodigniPlus1" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="4" col="3" textalignmode="auto">
                        <textedit name="txtRabatPodigniPlus2" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="4" col="4" textalignmode="auto">
                        <textedit name="txtRabatPodigniPlus3" value="0" format="n2" enabled="false"/>
                    </item>
                    <item row="4" col="5" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="postotnih poena" textalignmode="left"/>
                    </item>
                    <item row="5" col="1">
                        <radioedit name="rdoRabatOstatak" caption="Rabat na ostatak" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatOstatak1,#txtRabatOstatak2,#txtRabatOstatak3" if="#rdoRabatOstatak==true">
                                    <action type="control focus" value="#txtRabatOstatak1"></action>
                                </action>
                                <action type="control disable" value="#txtRabatOstatak1,#txtRabatOstatak2,#txtRabatOstatak3" else="#rdoRabatOstatak==false">
                                    <action type="control value" value="#txtRabatOstatak1,#txtRabatOstatak2,#txtRabatOstatak3">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="5" col="2" textalignmode="auto">
                        <textedit name="txtRabatOstatak1" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="5" col="3" textalignmode="auto">
                        <textedit name="txtRabatOstatak2" value="0" format="n2" enabled="false"/>
                    </item>
					<item caption="" row="5" col="4" textalignmode="auto">
                        <textedit name="txtRabatOstatak3" value="0" format="n2" enabled="false"/>
                    </item>
                    <item row="5" col="5" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="right">
                    <event type="click">
                        <action type="control foreachrow selected" value="parent.#grdRoba">
							<action type="method run" value="funPriListKalkUrednikRabata">
								<parameter name="NabPriDetId" value="parent.#grdRoba.@NabPriDetId" type="int"/>

                                <parameter name="rabat1P" value="#txtRabat1" type="decimal" if="#rdoRabat==true"/>
                                <parameter name="rabat1P" value="#txtRabatPodigni1" type="decimal" elseif="#rdoRabatPodigni==true"/>
                                <parameter name="rabat1P" value="#txtRabatPodigniPlus1" type="decimal" elseif="#rdoRabatPodigniPlus==true"/>
                                <parameter name="rabat1P" value="#txtRabatOstatak1" type="decimal" else=""/>
								
								<parameter name="rabat2P" value="#txtRabat2" type="decimal" if="#rdoRabat==true"/>
                                <parameter name="rabat2P" value="#txtRabatPodigni2" type="decimal" elseif="#rdoRabatPodigni==true"/>
                                <parameter name="rabat2P" value="#txtRabatPodigniPlus2" type="decimal" elseif="#rdoRabatPodigniPlus==true"/>
                                <parameter name="rabat2P" value="#txtRabatOstatak2" type="decimal" else=""/>
								
								<parameter name="rabat3P" value="#txtRabat3" type="decimal" if="#rdoRabat==true"/>
                                <parameter name="rabat3P" value="#txtRabatPodigni3" type="decimal" elseif="#rdoRabatPodigni==true"/>
                                <parameter name="rabat3P" value="#txtRabatPodigniPlus3" type="decimal" elseif="#rdoRabatPodigniPlus==true"/>
                                <parameter name="rabat3P" value="#txtRabatOstatak3" type="decimal" else=""/>
								
                                <parameter name="kojiRabat" value="rabatObicni" type="string" if="#rdoRabat==true"/>
                                <parameter name="kojiRabat" value="rabatPodigni" type="string" elseif="#rdoRabatPodigni==true"/>
                                <parameter name="kojiRabat" value="rabatPodigniPlus" type="string" elseif="#rdoRabatPodigniPlus==true"/>
                                <parameter name="kojiRabat" value="rabatOstatak" type="string" else=""/>
                            </action>
                        </action>
<!--                         <action type="control populate" value="parent.#grdRoba" /> -->
                        <action type="form close" />
                        <!-- </action> -->
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>

    </form>
</root>