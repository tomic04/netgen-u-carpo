<root>
    <form name="frmIzborTecaja" caption="Izbor tečaja">
        <event type="init">
            <action type="datarun reader" value="dtDonosTecaja"/>
        </event>
        <event type="load">
            <action type="control populate" value="#grdTecaj"/>
        </event>
        <layout>
            <group cols="1" rows="1">
                <item col="1" row="1" caption="Izbor tečaja">
                    <grid name="grdTecaj" dataname="~dtDonosTecaja">
                        <fields inherited="true">
                            <field name="Tecaj" format="n8"/>
                        </fields>
                    </grid>
                </item> 
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="&amp;IZABERI" type="add" dock="right">
                    <event type="click">
							<action type="variable value" value="global.Tecaj">
								<parameter value="#grdTecaj.@Tecaj"/>
							</action>
                            <action type="control value" value="parent.#txtFVrijednost">
								<parameter value="#grdNepovezaneFakture.@IznosFakture"/>
							</action>                        	
                            <action type="form close"></action>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spNabPriDetQuery" name="dtDonosTecaja">
                <parameter name="@Action" value="7"/>
                <parameter name="@DatumUFA" value="global.$DatumUFA"/>
                <parameter name="@DatumURA" value="parent.#grdNepovezaneFakture.@DatumDok"/>
                <parameter name="@ID" value="global.$ValutaId"/>
                <parameter name="@NabPriGlaId" value="null"/>
                <parameter name="@NabNarDetId" value="null"/>
                <parameter name="@SkladisteId" value="null"/>
                <parameter name="@RobaId" value="null"/>
            </data>
        </datalist>
    </form>
</root>