<root>
	<form name="frmCjenik" caption="Cjenik" width="500" height="400" fixedsize="true">
	
		<event type="load">
            <action type="control populate" value="#grdCjenik" if="$RobaId!=null&amp;&amp;$skladisteid!=null"/>
        </event>
		
        <layout textposition="left" itemspadding="3">
			<group groupbordervisible="false" cols="1" rows="1">
				<item  row="1" col="1"  highlight="False" >
					<grid  name="grdCjenik" showgrouppanel="False" autopopulate="false" dataname="~dtGet">
					
						<fields inherited="false">
							<field caption="Cjenik" name="Opis"></field>
							<field caption="Nab.Cijena" name="NabavnaCij"></field>
							<field caption="Nab.Cijena stara" name="NabavnaCijStara"></field>
							<field caption="Netto cijena" name="NetoCijenaKn" editable="true"></field>
							<field caption="Netto cijena stara" name="NetoCijenaKnStara"></field>
							<field caption="MP Cijena" name="MPCijena" editable="true"></field>
							<field caption="MP Cijena stara" name="MPCijenaStara"></field>
							<field caption="VPMarža" name="VPMarza" editable="true"></field>
							<field caption="VPMarža stara" name="VPMarzaStara"></field>
							<field caption="MPMarža" name="MPMarza" editable="true"></field>
							<field caption="MPMarža stara" name="MPMarzaStara"></field>
							<field caption="VP fiksno" name="IndFixStr"></field>
							<field caption="MP fiksno" name="IndMPFixStr"></field>
						</fields>
						
					</grid>
				</item>
			</group>
		</layout>
        <panelbuttons>
            <buttons>
                <button caption="&amp;SPREMI" name="btnSpremi" type="add" dock="left">
                    <event type="click">					
						
					</event>
                </button>
                <button caption="IZLAZ"  dock="right" type="cancel"></button>
            </buttons>
        </panelbuttons>
        <datalist>
			<data command="spNabPlkCarpoNKUCjenikQuery" name="dtGet">
				<parameter name="@Action" value="0" />
				<parameter name="@NabCijena" value="$NabCijena" />
				<parameter name="@RobaId" value="$RobaId" />
				<parameter name="@skladisteid" value="$skladisteid" />
			</data>
		</datalist>
    </form>
</root>