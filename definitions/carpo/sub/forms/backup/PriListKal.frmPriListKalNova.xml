<root>
<!--18.3.2020. AA pri otvaranju frmPriListKalEdit VrstaDokId za ispis-->
	<form name="frmPriListKalNova" caption="Direktna primka - ulazna kalkulacija :: unos" width="750" height="550">
	
		<layout textposition="left" itemspadding="3">
			<group groupbordervisible="false" cols="2" rows="1" col="1" row="1">
				<group caption="{$vrstaDok}" cols="1" rows="12" col="1" row="1" backgroundcolor="#f5f5f5" spacing="-1,2,-1,-1">
					<part name="prijemnilistkalkulacijaatributi" path="prtPriListKal.xml" />
				</group>
				<group caption="URA" cols="3" rows="3" col="2" row="1" backgroundcolor="#f5f5f5" spacing="2,-1,-1,-1">
					<part name="prtUfa" path="prtUfa.xml" />
				</group>
			</group>
			
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="KREIRAJ" type="add">
					<!--insert-->
					<!--primi ID-->
					<!--zatvori-->
					<!--proslijedi child formi id i startaj formu-->
					<event type="click" waittype="progress" waitcaption="Obrada" waittext="spremanje dokumenta..." sleep="2000">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtDataInsert" if="$NabPriGlaId==null">
							<parameter name="NabPriGlaId" value="$NabPriGlaId"/>
						</action>
						<action type="control populate" value="parent.#grdGlava">
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$NabPriGlaId" />
							</action>
						</action>

						<!-- zaključaj insertani dokument na trenutnog operatera						 -->
						<action type="variable value" value="Global.$OperaterLockId">
							<parameter value="$NabPriGlaId" />
						</action>
						<action type="form close"/>
						
                        <!-- nakon inserta otvori editFormu sa dodatnim gridom i tabovima -->					
						<action type="form open" value="frmPriListKalEdit">
							<parameter name="NabPriGlaId" value="$NabPriGlaId"/>
							<parameter name="VrstaDokId" value="$VrstaDokId"/>
						</action>
                    </event>
								
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNabPlkCarpoGlaAzur" name="dtDataInsert">
				<parameter name="@Action" value="insert" />
				<parameter name="@Status" value="0" />
				<parameter name="@OrgShemaId" value="#cteOrgShema" />
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@VrstaDokId" value="$VrstaDokId" />
				<parameter name="@Prefix" value="" />
				<parameter name="@Sufix" value="" />
				<parameter name="@DatumDok" value="#datDatumdok" />
				<parameter name="@DatumValute" value="#datDatumval" />
				<parameter name="@Opis" value="#opis" />
				<parameter name="@OsobeId" value="#cmbOsobe" />
				<parameter name="@SkladisteId" value="#cmbSkladiste" />
				<parameter name="@Otpremnica" value="#otpremnica" />
				<parameter name="@TroskoviIznos" value="#txtTrosakIznos" type="decimal"/>
				<parameter name="@TroskoviPosto" value="#txtTrosakPosto" type="decimal" />
				<parameter name="@FakturniIznos" value="#txtFVrijednost" type="decimal"/>
				<parameter name="@FaktureDobId" value="$UFA" />
				<parameter name="@ProNacinIsporukeId" value="#nacinotpreme" />
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@ValuteId" value="#cmbValuta" />
				<parameter name="@ParStruId" value="#cmbLokacija" />
				<parameter name="@Memo" value="#MemoGlava" />
			</data>
			<data command="spPriListKalParstru" name="dtDohvatiDefaultniParstruId">
				<parameter name="@PartneriId" value="#srcPartner" />
			</data>	
			<data name="dtGetPartneri" command="spCKntTemTraziPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>			
		</datalist>
	</form>
</root>