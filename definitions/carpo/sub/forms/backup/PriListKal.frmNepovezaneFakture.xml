<!-- 
17.04.2019 PJ maknuo fixedsize="true"
-->
<root>
	<form name="frmNepovezaneFakture" caption="Nepovezane fakture" height="300" >

        <event type="oninit">
			<action type="datarun reader" value="dtPubVarNabKalkUfaTecaj" />
        </event>
        <event type="onload">
      		<action type="control value" value="#lblDobavljac">
				<parameter value="Dobavljač:  {$dobavljac}"></parameter>
			</action>
			<action type="variable value" value="global.ValutaId">
				<parameter value="parent.#cmbValuta"/>
			</action>
			<action type="variable value" value="$PubVarNabKalkUfaTecaj">
				<parameter value="~dtPubVarNabKalkUfaTecaj.@NabKalkUfaTecaj" />
			</action>
        </event>
        <layout textposition="left" itemspadding="3">
			<group groupbordervisible="false" cols="1" rows="2">
				<item col="1" row="1">
					<labeledit name="lblDobavljac" fontbold="true"></labeledit>
				</item>
				<item  row="2" col="1"  highlight="False" >
					<grid  name="grdNepovezaneFakture" showgrouppanel="true" showfooter="false" autopopulate="true" async="true">
						<event type="doubleclick">
							<action type="control value" value="parent.#txtURA">
								<parameter value="#grdNepovezaneFakture.@BrojDok"/>
							</action>  
							<action type="control value" value="parent.#txtFVrijednost">
								<parameter value="#grdNepovezaneFakture.@IznosFakture"/>
							</action>
							<action type="variable value" value="parent.$UFA">
								<parameter value="#grdNepovezaneFakture.@FaktureDobId"/>
							</action>

							<action type="form close"></action>
						</event>
						<data command="spNabPlkCarpoRobnoKalkGlaQuery" >
							<parameter name="@Action"  value="11" />
							<parameter name="@PartneriId"  value="$partnerID" />		
						</data>
						<fields>
							<field caption="UFA" name="BrojDok"></field>
							<field caption="Faktura" name="Broj"></field>
							<field caption="Datum" name="Datumdok"></field>			
							<field caption="Iznos" name="Iznosfakture"></field>
						</fields>
						
					</grid>
				</item>
			</group>
		</layout>
        <panelbuttons>
            <buttons>
                <button caption="&amp;IZABERI" type="add" dock="right">
                    <event type="click">
							<action type="form open" value="frmIzborTecaja" if="$PubVarNabKalkUfaTecaj==1"/>
							<action type="control value" value="parent.#txtURA">
								<parameter value="#grdNepovezaneFakture.@BrojDok"/>
							</action>  
							<action type="control value" value="parent.#txtFVrijednost">
								<parameter value="#grdNepovezaneFakture.@IznosFakture"/>
							</action>
							<action type="variable value" value="parent.$UFA">
								<parameter value="#grdNepovezaneFakture.@FaktureDobId"/>
							</action>
                        	<action type="form close"></action>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spPriListKalPubVars" name="dtPubVarNabKalkUfaTecaj" />
        </datalist>
    </form>
</root>