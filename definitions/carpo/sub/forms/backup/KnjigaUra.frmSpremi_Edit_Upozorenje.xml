<root>
	<form name="frmSpremi_Edit_Upozorenje" caption="Upozorenje" fixedsize="true">

		<event type="init"> 
			<action type="datarun reader" value="~dtUraDatDVO" />
		</event>
		<event type="load">	

		</event>
		<event type="shown">
			<action type="control value" value="#lblPitanje">
				<parameter value="Promjene mogu prouzročiti razlike kartica i knjiga PDV-a!\nJeste li sigurni da želite nastaviti?" Fontbold="true" fontsizedelta="6"/>
			</action>
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="1" groupbordervisible="true">
				<item col="1" row="1" caption="">					
					<labeledit name="lblPitanje" value="Promjene mogu prouzročiti razlike kartica i knjiga PDV-a!\nJeste li sigurni da želite nastaviti?" Fontbold="true" fontsizedelta="6"/> 
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="left" />
				<button name="btnNastavi" caption="&amp;Nastavi" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>	
			<data command="select 1" type="text" name="dtUraDatDVO">
			</data>					
		</datalist>
	</form>
</root>