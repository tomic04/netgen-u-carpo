<root>
	<form name="frmSpremiEditUpozorenje" caption="Upozorenje" fixedsize="true" width="550" height="150">
		<event type="init"> 
			<action type="datarun reader" value="~dtUraDatDVO" />
		</event>
		<event type="load">	
		</event>
		<event type="shown">
			<action type="control value" value="#lblPitanje">
				<parameter value="Promjene mogu prouzročiti razlike kartica i knjiga PDV-a!\nJeste li sigurni da želite nastaviti?"/>
			</action>
		</event>
		<layout itemspadding="2">
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1" caption="">					
					<labeledit name="lblPitanje" fontbold="true" fontsizedelta="4"/> 
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="left" />
				<button name="btnNastavi" caption="&amp;Nastavi" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>	
			<data name="dtUraDatDVO" command="select 1" type="text"/>				
		</datalist>
	</form>
</root>