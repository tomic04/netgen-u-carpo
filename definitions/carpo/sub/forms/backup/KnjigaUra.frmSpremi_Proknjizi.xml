<root>
	<form name="frmSpremi_Proknjizi" caption="Knjiženje" fixedsize="true">
		<event type="init"> 
			<action type="datarun reader" value="~dtUraDatDVO" />
		</event>
		<event type="load">	

		</event>
		<event type="shown">

			<action type="control value" value="#lblPitanje">
				<parameter value="Proknjiži UFU na temeljnicu?" Fontbold="true" fontsizedelta="6"/>
			</action>

		</event>
		<layout itemspadding="2">
			<group cols="1" rows="1" groupbordervisible="true">
				<item col="1" row="1" caption="">					
					<labeledit name="lblPitanje" value="Proknjiži UFU na temeljnicu?" Fontbold="true" fontsizedelta="6"/> 
				</item>
			</group>	
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDA" caption="&amp;DA" dock="left">
					<event type="click">
						<action type="datarun scalar" value="~dtProknjizi">
							<parameter name="parent.$NoviId" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnNE" caption="NE" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>

			<data command="spC_FaktureDobKnjizenje" name="dtProknjizi">
				<parameter name="@ID" value="$FaktureDobId" />
			</data>	
			<data command="select 1" type="text" name="dtUraDatDVO">
			</data>					
		</datalist>
	</form>
</root>