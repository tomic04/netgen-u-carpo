<root>
	<form path="frmJedObracun.xml" name="frmJedObracun"/>		
	<form name="frmStavke" width="700" height="500">
		<event type="shown">
			<action type="form caption" value="Unos stavki za obračun" if="$kntKteGlavaId==null"/>
			<action type="form caption" value="Izmjena stavki za obračun" else=""/>
			<action type="datarun reader" value="~dtGet"/>			
			<action type="control value" value="#datDatum" if="$kntKteGlavaId!=null">
				<parameter value="~dtGet.@DatumDok"/>
			</action>			
			<action type="control refreshvalue" value="#srcPartner">
				<!-- <parameter value="~dtGet.@PartneriId"/> -->
			</action>
			<action type="control value" value="#cmbKamata">
				<parameter value="~dtGet.@kteVrsteStopaID"/>
			</action>
			<action type="control value" value="#datOd">
				<parameter value="~dtGet.@datOd"/>
			</action>
			<action type="control value" value="#datDo">
				<parameter value="~dtGet.@datDo"/>
			</action>
			<action type="control value" value="#txtBrObr">
				<parameter value="~dtGet.@BrObr"/>
			</action>
			<action type="control value" value="#txtMinIznos">
				<parameter value="~dtGet.@MinIznos"/>
			</action>
			<action type="control populate" value="#grdStavkeDetalj"/>
			<!-- <action type="control populate" value="#grdStavkeObracun"/> -->
			<action type="control disable" value="#datDatum,#srcPartner,#cmbKamata,#datOd,#datDo,#txtBrObr,#txtMinIznos" if="$kntKteGlavaId!=null"/>
			<action type="control enable" value="#datDatum,#srcPartner,#cmbKamata,#datOd,#datDo,#txtBrObr,#txtMinIznos" if="$kntKteGlavaId==null"/>
		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<part name="prtKamate" path="prtKamate.xml"/>								
				<group col="1" row="2" cols="6" rows="8" caption="Stavke">
					<columnsdefinition>
						<column position="1" size="10%"/>
						<column position="2" size="10%"/>
						<column position="3" size="20%"/>
						<column position="4" size="20%"/>
						<column position="5" size="20%"/>
						<column position="6" size="15%"/>						
					</columnsdefinition>
					<!-- <rowsdefinition> -->
						<!-- <row position="1" size="30%"/> -->
						<!-- <row position="2" size="25%"/> -->
						<!-- <row position="3" size="25%"/> -->
						<!-- <row position="4" size="25%"/> -->
					<!-- </rowsdefinition>-->
					<item col="1" row="1" colspan="5" rowspan="8">
						<grid name="grdStavkeDetalj" key="kntKteDetaljID" dataname="~dtSDGrid" showfooter="true"  multiselect="true" showgrouppanel="false" bestfitonrefresh="true" savelayout="true">
							<fields>
								<field name="BrojFak" caption="Broj računa"/>
								<field name="Datum"/>
								<field name="Opis"/>
								<field name="Duguje"/>
								<field name="Potrazuje" caption="Potražuje"/>
								<field name="Ind" hidden="true"/>
							</fields>
						</grid>
					</item>
					<item col="6" row="1" rowspan="2">
						<button name="btnAdd" caption="DODAJ">
							<event type="click">
								<action type="form open" value="frmSlUnos">
									<parameter name="kntKteGlavaId" value="$kntKteGlavaId"/>
									<parameter name="PartneriId" value="#srcPartner"/>
								</action>
							</event>
						</button>
					</item>
					<item col="6" row="3" rowspan="2">
						<button name="btnEdit" caption="IZMIJENI">
							<event type="click">
								<action type="form open" value="frmSlUnos">
									<parameter name="kntKteGlavaId" value="$kntKteGlavaId"/>
									<parameter name="PartneriId" value="#srcPartner"/>
									<parameter name="kntKteDetaljId" value="#grdStavkeDetalj.@kntKteDetaljID"/>
								</action>
							</event>
						</button>
					</item>
					<item col="6" row="5" rowspan="2">
						<button name="btnDelete" caption="OBRIŠI">
							<event type="click">
								<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?">
									<action type="datarun nonquery" value="~dtObrisiDet"/>								
									<action type="control populate keepfocus" value="#grdStavkeDetalj"/>
								</action>
							</event>
						</button>
					</item>
					<item col="6" row="7" rowspan="2">
						<button name="btnDonesi" caption="DONESI SK">
							<event type="click">
								<action type="form open" value="frmSCDonos">
									<parameter name="KntKteGlavaId" value="$KntKteGlavaId"/>
									<parameter name="PartneriId" value="#srcPartner"/>
								</action>
							</event>
						</button>
					</item>
					<!-- <item col="6" row="8"/> -->
				</group>				
			</group>
		</layout>		
		<panelbuttons displaycontrolsprint="true">
			<buttons>
				<button name="btnObracun" caption="OBRAČUNAJ">
					<event type="click">
						<action type="form close"/>
						<action type="form open" value="frmIzmjenaGla">
							<parameter name="KntKteGlavaId" value="$KntKteGlavaId"/>
							<parameter name="Obracun" value="true"/>
						</action>						
					</event>
				</button>
				<button name="btnPrint" caption="ISPIS SUČELJA" dock="right">
					<event type="click">
						<action type="control printcontrol" value="#grdStavkeDetalj"/> 
					</event>
				</button>
				<!-- <button name="btnUpute" caption="Uputi me" dock="right"> -->
					<!-- <event type="click"> -->
						<!-- <action type="message" value="Ova funkcionalnost trenutno nije dostupna, molimo kontaktirajte Spin!"/> -->
					<!-- </event> -->
				<!-- </button> -->
				<button name="btnExit" type="cancel" caption="SPREMI" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGet" command="spCKteGlavaQuery">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$kntKteGlavaId"/>
			</data>
			<data name="dtObrisiDet" command="spCKteDetaljAzur">
				<parameter name="@Action" value="2"/>
				<parameter name="@SelectedId" value="#grdStavkeDetalj.selectedids.table"/>
				<parameter name="@Datum" value="#grdStavkeDetalj.@Datum"/>
			</data>
			<data name="dtKamate" command="spCKntKtePopuniKontrole">
				<parameter name="@Action" value="vrste"/>
			</data>
			<data name="dtSDGrid" command="spCKteDetaljQuery">
				<parameter name="@Action" value="0"/>
				<parameter name="@ID" value="$kntKteGlavaId"/>
			</data>
		</datalist>
	</form>
</root>