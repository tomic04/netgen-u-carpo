<root>
	<form name="frmSCDonos" caption="Donos stavaka za obračun kamata" statusbar="true" width="250" height="200">
		<event type="shown">
			<action type="datarun reader" value="~dtPrviDan"/>
			<action type="control value" value="#datOd">
				<parameter value="~dtPrviDan.@Datum"/>
			</action>
			<action type="control value" value="#datDo">
				<parameter value="now" type="date"/>
			</action>
			<action type="control value" value="#rdoSvi">
				<parameter value="True"/>
			</action>
		</event>
		<layout>
			<group cols="4" rows="5">
				<item col="1" row="1" colspan="4" caption="Analitički konto:">
					<comboedit name="cmbKonto" dataname="~dtKonto" valuefield="KntPlanAId" displayfield="Konto"/>
				</item>
				<item col="1" row="2" colspan="4" caption="Datum od:">
					<dateedit name="datOd"/>
				</item>
				<item col="1" row="3" colspan="4" caption="Datum do:">
					<dateedit name="datDo"/>
				</item>
				<item col="1" row="4" colspan="4" caption="Valuta">
					<comboedit name="cmbValuta" dataname="~dtValuta" valuefield="ValuteId" displayfield="Naziv"/>
				</item>				
				<item col="1" row="5">
					<labeledit name="lblTxt" value="Računi:"/>
				</item>
				<item col="2" row="5">
					<radioedit name="rdoSvi" caption="Svi">
						<event type="checkedchanged">
							<action if="#rdoSvi==true">
								<action type="control value" value="#rdoZat,#rdoOtv">
									<parameter value="false"/>
								</action>
								<action type="variable value">
									<parameter name="Racuni" value="0"/>
								</action>
							</action>
						</event>
					</radioedit>
				</item>
				<item col="3" row="5">
					<radioedit name="rdoZat" caption="Zatvoreni">
						<event type="checkedchanged">
							<action if="#rdoZat==true">
								<action type="control value" value="#rdoSvi,#rdoOtv">
									<parameter value="false"/>
								</action>
								<action type="variable value">
									<parameter name="Racuni" value="1"/>
								</action>
							</action>
						</event>
					</radioedit>
				</item>
				<item col="4" row="5">
					<radioedit name="rdoOtv" caption="Otvoreni">
						<event type="checkedchanged">
							<action if="#rdoOtv==true">
								<action type="control value" value="#rdoZat,#rdoSvi">
									<parameter value="false"/>
								</action>
								<action type="variable value">
									<parameter name="Racuni" value="2"/>
								</action>
							</action>
						</event>
					</radioedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDonos" caption="DONESI">
					<event type="click">
						<action type="datarun nonquery" value="~dtSCDonos"/>
						<action type="control populate" value="parent.#grdStavkeDetalj"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnCancel" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtPrviDan" command="select datename(year, getdate()) + '0101' as Datum" type="text"/>
			<data name="dtKonto" command="spCKntKtePopuniKontrole">
				<parameter name="@Action" value="konto"/>
			</data>
			<data name="dtValuta" command="spCKntKtePopuniKontrole">
				<parameter name="@Action" value="valuta"/>				
			</data>
			<data name="dtSCDonos" command="spCKteDonos">
				<parameter name="@kntKteGlavaId" value="$kntKteGlavaId"/>
				<parameter name="@ParId" value="$PartneriId"/>
				<parameter name="@kntPlanAId" value="#cmbKonto"/>
				<parameter name="@DatumOd" value="#datOd"/>
				<parameter name="@DatumDo" value="#datDo"/>
				<parameter name="@Zatvoreni" value="$Racuni"/>
				<parameter name="@ValuteId" value="#cmbValuta"/>				
			</data>
			
		</datalist>
	</form>
</root>