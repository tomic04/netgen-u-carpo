<root>
	<form name="frmPromijeniStatus" caption="{$Naslov}" width="250" height="350" >
    <event type="init">
      <action type="variable value">
        <parameter name="Naslov" value="$NaslovTekst"/>
      </action>
    </event>	  
    <event type="shown">
		<action type="datarun reader" value="Global.dtRevizija"/>
		<action type="variable value" >
			<parameter name="Ind_Revizija" value="~dtRevizija.@Ind_Revizija"/>
		</action>		
		<action type="control disable" value="#txtRevizija" if="$VratiStatus==0||$Ind_Revizija==0" />
		<action type="control enable" value="#txtRevizija" if="$VratiStatus==1&amp;&amp;$Ind_Revizija==1" />
		<action type="control value" value="#txtRevizija" if="$VratiStatus==1&amp;&amp;$Ind_Revizija==1">
			<parameter value="~dtRevizija.@Revizija"/>
		</action>	
		<action type="control value" value="#txtRevizija" else="">
			<parameter value="#cmbStatusi.@Revizija"/>
		</action>		  
    </event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="3" >
				<item col="1" row="1" caption="Jeste li sigurni da želite promijeniti status?">
					<comboedit name="cmbStatusi" valuefield="StatusiId" displayfield="Korak" dataname="Global.dtStatusi" allownull="false"> 
						<event type="valuechanged" raiseonload="false">
							<action type="datarun reader" value="Global.dtRevizija"/>
							<action type="variable value" >
								<parameter name="Ind_Revizija" value="~dtRevizija.@Ind_Revizija"/>
							</action>
							<action type="control disable" value="#txtRevizija" if="$VratiStatus==0||$Ind_Revizija==0" />
							<action type="control enable" value="#txtRevizija" if="$VratiStatus==1&amp;&amp;$Ind_Revizija==1" />							
							<action type="control value" value="#txtRevizija" if="$VratiStatus==1&amp;&amp;$Ind_Revizija==1">
								<parameter value="~dtRevizija.@Revizija"/>
							</action>	
							<action type="control value" value="#txtRevizija" else="">
								<parameter value="#cmbStatusi.@Revizija"/>
							</action>	
						</event>													
					</comboedit>
				</item>
				<item caption="Napomena:" col="1" row="2">
					<memoedit name="txtNapomena" entermovenextcontrol="true" />
				</item>					
				<group cols="2" rows="1" col="1" row="3" padding="0" groupbordervisible="False">
					<columnsdefinition>
						<column size="50" position="2" />
						<column size="250" position="1" />					
					</columnsdefinition>
					<item caption=" " col="1" row="1">
						<labeledit name="lblBlank" value=" " />
					</item>					
					<item caption="Revizija:" col="2" row="1">
						<textedit name="txtRevizija" format="f0" />
					</item>
				</group>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
							<action type="datarun nonquery" value="global.~dtPromijeniStatus"/>
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="Odustani" type="cancel"></button>
			</buttons>
		</panelbuttons>		
	</form>
</root>