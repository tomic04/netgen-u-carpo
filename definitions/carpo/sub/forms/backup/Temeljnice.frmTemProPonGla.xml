<root>
	<form name="frmTemProPonGla" caption="Ostalo - ponuda" width="750" height="500" saveformsize="true">
		<event type="shown">
			<action type="control populate" value="#grdGlavni"/>
			<action type="control focus" value="#grdGlavni"/>
		</event>
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdGlavni" type="master" dataname="~dtGlavni" bestfitonrefresh="true" savelayout="true" showgrouppanel="false" showautofilterrow="true">
						<event type="doubleclick">
							<!-- <action type="datarun reader" value="~dtSaldoMinus" if="#grdGlavni.@Saldo&lt;0"/> -->
							<action type="variable value" value="parent.$ProPonGlaId">
								<parameter value="#grdGlavni.@ProPonGlaId"/>
							</action>
							<action type="variable value" value="parent.$BrojRacuna">
								<parameter value="#grdGlavni.@Broj"/>
							</action>	
							<action type="variable value" value="parent.$Duguje">
								<parameter value="#grdGlavni.@Duguje"/>
							</action>
							<action type="variable value" value="parent.$Potrazuje">
								<parameter value="#grdGlavni.@Potrazuje"/>
							</action>							
							<action type="variable value" value="parent.$DevDug">
								<parameter value="#grdGlavni.@DevDug"/>
							</action>	
							<action type="variable value" value="parent.$DevPot">
								<parameter value="#grdGlavni.@DevPot"/>
							</action>	
							<action type="variable value" value="parent.$OrgShemaId">
								<parameter value="#grdGlavni.@OrgShemaId"/>
							</action>
							<action type="variable value" value="parent.$DevValuteId">
								<parameter value="#grdGlavni.@ValuteId"/>
							</action>
							<!--ne povlači datum s računa, nego stavi datum temeljnice-->
							<action type="variable value" value="parent.$DatDok">
								<parameter value="global.$DatumKnjizenja"/>
							</action>
							<action type="variable value" value="parent.$DatVal">
								<parameter value="global.$DatumKnjizenja"/>
							</action>								
							<action type="variable value" value="parent.$NoviUnos">
								<parameter value="1"/>
							</action>							
							<action type="form close"/>
						</event>
						<event type="keydown" value="13">
							<!-- <action type="datarun reader" value="~dtSaldoMinus" if="#grdGlavni.@Saldo&lt;0"/> -->
							<action type="variable value" value="parent.$ProPonGlaId">
								<parameter value="#grdGlavni.@ProPonGlaId"/>
							</action>
							<action type="variable value" value="parent.$BrojRacuna">
								<parameter value="#grdGlavni.@Broj"/>
							</action>	
							<action type="variable value" value="parent.$Duguje">
								<parameter value="#grdGlavni.@Duguje"/>
							</action>
							<action type="variable value" value="parent.$Potrazuje">
								<parameter value="#grdGlavni.@Potrazuje"/>
							</action>							
							<action type="variable value" value="parent.$DevDug">
								<parameter value="#grdGlavni.@DevDug"/>
							</action>	
							<action type="variable value" value="parent.$DevPot">
								<parameter value="#grdGlavni.@DevPot"/>
							</action>	
							<action type="variable value" value="parent.$OrgShemaId">
								<parameter value="#grdGlavni.@OrgShemaId"/>
							</action>
							<action type="variable value" value="parent.$DevValuteId">
								<parameter value="#grdGlavni.@ValuteId"/>
							</action>
							<!--ne povlači datum s računa, nego stavi datum temeljnice-->
							<action type="variable value" value="parent.$DatDok">
								<parameter value="global.$DatumKnjizenja"/>
							</action>
							<action type="variable value" value="parent.$DatVal">
								<parameter value="global.$DatumKnjizenja"/>
							</action>							
							<action type="variable value" value="parent.$NoviUnos">
								<parameter value="1"/>
							</action>
							<action type="form close"/>					
						</event>
						<fields inherited="true">
							<field name="Broj" fixed="left"/>
							<field name="DatumValute" caption="Datum valute"/>
							<field name="Potrazuje" caption="Potražuje"/>
							<field name="DevDug" caption="Devizno\nduguje"/>
							<field name="DevPot" caption="Devizno\npotrazuje"/>
							<field name="DevSaldo" caption="Devizno\nsaldo"/>
							<field name="OrgShema" caption="Organizacijska\nshema"/>
						</fields>
						<styles>
							<style name="fontcolor" value="black"/>
							<style name="bold" value="true" if="#grdGlavni.fieldname==Broj"/>
						</styles>
					</grid>
				</item>
			</group>
		</layout>
		<datalist>
			<data name="dtGlavni" command="spCKntOstaloQuery">
				<parameter name="@Action" value="104"/>
				<parameter name="@Id" value="$PartneriId"/>
			</data>
			<!-- <data name="dtSaldoMinus" type="text" command="select (-1)*@Iznos as Saldo, (-1)*DevIznos as DevSaldo"> -->
				<!-- <parameter name="@Iznos" value="#grdGlavni.@Saldo"/> -->
				<!-- <parameter name="@DevIznos" value="#grdGlavni.@DevSaldo"/> -->
			<!-- </data> -->
		</datalist>
	</form>
</root>