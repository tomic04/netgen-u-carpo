<root>
	<!--FORMA ZA DODAVANJE/BRISANJE KADROVA-->
	<!--
  V2. 28.11.2018. dodana opcija brisanja odabranih kadrova
  V1. kreirano

-->

	<form name="frmDodajKadrove" caption ="$caption"  width="800" height="500" fixedsize="true" saveformsize="false" showversion="true" version="1" >
		<event type="init">
			<action type="datarun reader" value="~dtPopuniTemp" />
			<action type="datarun reader" value="~dtGridGore">
			</action>
			<action type="datarun reader" value="~dtGridDolje">
			</action>
		</event>

		<event type="load">
			<action type="control populate" value="#grdGore" >     </action>
			<action type="control populate" value="#grdDolje" >     </action>
			<action type="datarun reader" value="~dtPreobrojKandidate">
				<action type="control value" value="#lblZaBrisanje">
					<parameter value="~dtPreobrojKandidate.@zaBrisanje"/>
				</action>
				<action type="control value" value="#lblZaUnos">
					<parameter value="~dtPreobrojKandidate.@zaUnos"/>
				</action>
			</action>
		</event>

		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<!--1. red-->
				<group cols="2" rows="5" groupbordervisible="false" col="1" row="1">
					<columnsdefinition>
						<column position="1" size="85%"></column>
						<column position="2" size="15%"></column>
					</columnsdefinition>
					<rowsdefinition>
						<row position ="1" size="20"/>
						<row position ="2" size="25"/>
						<row position ="3" size="20"/>
					</rowsdefinition>
					<!--grid gore-->
					<item caption="" col="1" row="1" rowspan="5" textposition="left">
						<grid name="grdGore" key="HRKadroviId" dataname="~dtGridGore" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true">
							<fields inherited="true">
							</fields>
						</grid>
					</item>
					<!--gumbi desno gore-->
					<item row="1" col="2" caption="Za obrisati:">
					</item>
					<item row="2" col="2">
						<labeledit name="lblZaBrisanje"/>
					</item>
					<item row="5" col="2" >
						<button image="bottom" caption="Prebaci dolje" imagelocation="bottomcenter">
							<!--na klik prebaci selectedids iz grdgore i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciDolje"/>
								<action type="control populate" value="#grdGore"/>
								<action type="control populate" value="#grdDolje"/>
								<action type="datarun reader" value="~dtPreobrojKandidate">
									<action type="control value" value="#lblZaBrisanje">
										<parameter value="~dtPreobrojKandidate.@zaBrisanje"/>
									</action>
									<action type="control value" value="#lblZaUnos">
										<parameter value="~dtPreobrojKandidate.@zaUnos"/>
									</action>
								</action>
							</event>
						</button>
					</item>

				</group>



				<!--2. red-->
				<group cols="2" rows="5" groupbordervisible="false" col="1" row="2">
					<columnsdefinition>
						<column position="1" size="85%"></column>
						<column position="2" size="15%"></column>
					</columnsdefinition>
					<rowsdefinition>
						<row position ="1" size="20"/>
						<row position ="2" size="25"/>
						<row position ="3" size="20"/>
					</rowsdefinition>
					<!--grid gore-->
					<item caption="" col="1" row="1" rowspan="5" textposition="left">
						<grid name="grdDolje" key="HRKadroviId" dataname="~dtGridDolje" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" multiselect="true">
							<fields inherited="true">
							</fields>
						</grid>
					</item>
					<!--gumbi desno dolje-->
					<item row="1" col="2" caption="Za dodati:">
					</item>
					<item row="2" col="2" rowspan="2" >
						<labeledit name="lblZaUnos"/>
					</item>
					<item row="5" col="2" >
						<button image="top" caption="Prebaci gore" imagelocation="topcenter">
							<!--na klik prebaci selectedids iz grddolje i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciGore"/>
								<action type="control populate" value="#grdGore"/>
								<action type="control populate" value="#grdDolje"/>
								<action type="datarun reader" value="~dtPreobrojKandidate">
									<action type="control value" value="#lblZaBrisanje">
										<parameter value="~dtPreobrojKandidate.@zaBrisanje"/>
									</action>
									<action type="control value" value="#lblZaUnos">
										<parameter value="~dtPreobrojKandidate.@zaUnos"/>
									</action>
								</action>
							</event>
						</button>
					</item>


				</group>


			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- Provjeri required fields -->
						<action type="validate" />
						<!-- Okini storu -->
						<!--<action type="transaction">-->
						<action type="datarun reader" value="~dtSpremi" waittype="progress" waitcaption="Pričekajte..." waittext="..spremanje u tijeku...">
						</action>
						<action type="message" value="~dtSpremi.@Poruka"/>
						<!--</action>-->

						<action type="form close" if="~dtSpremi.@Id==0"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spPlaceUnosKadrova" name="dtSpremi" timeout="600">
				<parameter name="@Action" value="unos_kadrova_spremanje" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>

			<data command="spPlaceUnosKadrova" name="dtPreobrojKandidate">
				<parameter name="@Action" value="unos_kadrova_prebroj_kandidate" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>

			<data command="spPlaceUnosKadrova" name="dtPopuniTemp">
				<parameter name="@Action" value="unos_kadrova_popuni_temp_init" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
				<parameter name="selectedids" value="$selectedids" />
			</data>

			<data command="spPlaceUnosKadrova" name="dtprebaciDolje">
				<parameter name="@Action" value="unos_kadrova_prebaci_dolje" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
				<parameter name="@table" value="#grdGore.selectedids.table"/>
			</data>

			<data command="spPlaceUnosKadrova" name="dtprebaciGore">
				<parameter name="@Action" value="unos_kadrova_prebaci_gore" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
				<parameter name="@table" value="#grdDolje.selectedids.table"/>
			</data>

			<!--<parameter name="@table" value="parent.#grdDoprinosi.selectedids.table"/>-->

			<data command="spPlaceUnosKadrova" name="dtGridGore">
				<parameter name="@Action" value="unos_kadrova_grid_gore" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>

			<data command="spPlaceUnosKadrova" name="dtGridDolje">
				<parameter name="@Action" value="unos_kadrova_grid_dolje" type="string"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>

		</datalist>
	</form>


	<!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>