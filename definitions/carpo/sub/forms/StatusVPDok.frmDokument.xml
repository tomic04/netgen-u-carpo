<root version="1.0.0.1">
	<form name="frmDokument" type="master" caption="Dokument {parent.#grdStavke.@broj}, od datuma: {parent.#grdStavke.@datumdok},  Skladište: {parent.#grdStavke.@skladiste}" width="800" height="600" statusbar="true">
		<event type="init"> 
			
		</event>
		<event type="load">	
			<action type="control populate" value="#grdDokument"/>
		</event>
		<event type="shown">	
		<action type="control populate" value="#grdDokument"/>
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Dokument" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdDokument" printcaptionalign="center" printcaption="Dokument {parent.#grdStavke.@broj}, od datuma: {parent.#grdStavke.@datumdok},  Skladište: {parent.#grdStavke.@skladiste}, Kupac: {parent.#grdStavke.@kupac}"  
						header=" \n " headeralign="center" multiselect="false" key="klasa" showgrouppanel="true" showfooter="false" showautofilterrow = "false" savelayout="false">												
							<data command="spCRobnoStatusVPDokStavke">
									
								<parameter name="@pronotpglaid" value="parent.#grdStavke.@pronotpglaid"/>
							</data>
							<fields>	
								<field name="userid" caption="Roba "/>
								<field name="klasa" caption="Klasa" />
								<field name="robanaziv" caption="Roba Naziv" />
								<field name="jm" caption="JM" />
								<field name="Kolicina" caption="Količina" />
								<field name="cijena" caption="Neto cijena" />
								<field name="rabat" caption="Rabat %" /> 
								<field name="rabatvri" caption="Rabat Vrijednost"/>
								<field name="nettovrijednostkn" caption="Vrijednost bez PDV-a"/>
								<field name="porez" caption="PDV"/>	
								<field name="pdviznos" caption="PDV vrijednost"/>
								<field name="bruttovrijednostkn" caption="Vrijednost sa PDV-om"/>
								<field name="nabavnavrijednost" caption="Nabavna Vrijednost"/>
								<field name="nabavnacijena" caption="Nabavna Cijena"/>
								<field name="brojfakture" caption="Broj Fakture"/>
							</fields>
						</grid>
					</item>
				</group>
			</group>	
		</layout>
		<panelbuttons>
		
			<buttons>
				<button name="btnIspis" caption="Ispiši"  dock="right" >
				<event type="click">
					<action type="control printcontrol" value="#grdDokument"/>
				</event>
			</button>
				<button caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>
				
			</buttons>
		</panelbuttons>
		<datalist>
		

		</datalist>
	</form>
</root>