<root>
	<form name="frmPodIzvrsiteljiIzmjena" caption="Izmjena" width="250" height="350" >
    <event type="init">
		<action type="datarun reader" value="~dtGetPodIzvrsitelji" />
    </event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="5" >
				<part name="partPodizvrsitelji" path="prtGradUgovori.xml" />
				<item caption="Ugovoreni iznos:" row="5" col="1" fontbold="" >
					<textedit name="txtPodizvrsiteljiUgovoreniIznos" datavalue="~dtGetPodIzvrsitelji.@UgovoreniIznos" format="n2" fontbold="" nulltext=""/>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
							<action type="datarun nonquery" value="~dtIzmjenaPodizvrsitelja"/>
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="Odustani" type="cancel"></button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_GradUgovori_LnPodizvrsitelji_Query" name="dtGetPodIzvrsitelji">
				<parameter name="@ProdGradUgovori_LnPodizvrsiteljiId" value="$ProdGradUgovori_LnPodizvrsiteljiId" />
			</data>
			<data command="spProd_GradUgovori_LnPodizvrsitelji_Izmjena" name="dtIzmjenaPodizvrsitelja">
				<parameter name="@ProdGradUgovori_LnPodizvrsiteljiId" value="$ProdGradUgovori_LnPodizvrsiteljiId" />
				<parameter name="@PodIzvrsiteljiId" value="#srcPodIzvrsitelji" />
				<parameter name="@GradUgovoriVrsteId" value="#cmbPodizvrsiteljiVrstaUgovora" />
				<parameter name="@BrojUgovora" value="#txtPodizvrsiteljiBrojUgovora" />
				<parameter name="@OpisUsluge" value="#txtPodizvrsiteljiOpisUsluge" />
				<parameter name="@UgovoreniIznos" value="#txtPodizvrsiteljiUgovoreniIznos" />
			</data>			
		</datalist>			
	</form>
</root>