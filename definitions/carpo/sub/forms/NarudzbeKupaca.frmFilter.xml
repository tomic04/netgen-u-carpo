<root>
<form name="frmFilter" caption="Filtriraj">

<event type="load">
		<action type="datarun scalar" value="~dtSutrasnjiDatum">
		<parameter name="SutrasnjiDatum"/>
            </action>

			
			<action type="control value" value="#datDatDo">
				<parameter value="$SutrasnjiDatum"/>
			</action>	
		</event>
    <layout>			


        <group cols="1" rows="6" groupbordervisible="false" showcheckboxes="true">
			<item col="1" row="1" caption="Datum od:"  textposition="left" >
				<dateedit name="datDatOd" value="now"  required="true"/>
			</item>
			<item col="1" row="2" caption="Datum do:"  textposition="left" >
				<dateedit name="datDatDo" allownull="true"/>
			</item>
			<item col="1" row="3" caption="Naručitelj:" textposition="left">
				<searchedit name="srcPartner" fontbold="True" fieldtext="Partner3000" fieldvalue="PartneriID" dataname="~dtGetPartner" function="srcPartner">
					<event type="valuechanged">
						<action type="variable value">
							<parameter name="PartneriId" value="#srcPartner" />
						</action>	
						<action type="variable value">
							<parameter name="IndPromijenjeno" value="1" />
						</action>						
						<action type="variable value">
							<parameter name="IndLoad" value="0" />
						</action>					
                    </event>
					<event type="leave">
						<action type="variable value">
							<parameter name="PartneriId" value="#srcPartner"/>
						</action>					
                    	<action type="datarun reader" value="Global.dtDajPartnera" if="#srcPartner!=null"/>						
						<action type="control value" value="#srcParstru" if="#srcPartner!=null&amp;&amp;#srcPartner.@BrojLokacija_Id==1">
							<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
						</action>
						<action type="form open" value="frmLokacije" if="#srcPartner!=null&amp;&amp;#srcPartner.@BrojLokacija_Id!=1&amp;&amp;$IndPromijenjeno==1">
							<parameter name="PartneriId" value="#srcPartner" />
							<parameter name="IndLokacija" value="1" />
							<parameter name="ParStruId" value="#srcParstru" />
						</action>
						<!-- <action type="control refreshvalue" value="#srcParstru" if="#srcPartner==null"/> -->
						<action type="control value" value="#srcParstru" if="#srcPartner==null">
							<parameter value="null"/>
						</action>						
						<action type="variable value">
							<parameter name="IndLokacija" value="0" />
						</action>
						<action type="variable value">
							<parameter name="IndPromijenjeno" value="0" />
						</action>						
					</event>
				</searchedit>
	        </item>
			<item netgenfields="true" col="1" row="4" caption="Mjesto isporuke:" textposition="left">
				<searchedit name="srcParstru" fieldvalue="ParStruId" fontbold="True" datavalue="" dataname="~dtGetParstru">
					
				<event type="leave">
                    	<action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null"/>
                        <action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
							<parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv"/>
						</action>
												
					</event>				
				</searchedit>
	        </item>	
			<item col="1" row="5" caption="Trgovina:"  textposition="left" >
				<searchedit name="srcTrgovina" fieldvalue="TrgovinaId" fontbold="True" datavalue="" dataname="~dtGetTrgovina" />
			</item>
			<item col="1" row="6" caption="Vrsta dokumenta:"  textposition="left" >
				<comboedit name="cmbVrstaDokumenta" valuefield="ProNarudzbeVrstaPrometaId" displayfield="Naziv" dataname="~dtVrstaDokumenta" />
			</item>			
		</group>	
	</layout>

    <panelbuttons>
			<buttons>
				<button name="btnPokazi" caption="Pokazi">
					 <event type="click">
					 <action type = "validate" />
					 <action type="variable value">
					 <action type="variable value"  >
						<parameter name="global.DatumOd" value="#datDatOd" />
						<parameter name="global.DatumDo" value="#datDatDo" />
							<parameter name="global.PartneriId" value="#srcPartner" />
							<parameter name="global.ParStruId" value="#srcParstru" />
							<parameter name="global.TrgovinaId" value="#srcTrgovina" />
							<parameter name="global.ProNarudzbeVrstaPrometaId" value="#cmbVrstaDokumenta" />
						</action>
                        	
                        
					</action>
						
					 	
                        <action type="form close"/>
						 
                        
                        
                    </event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>

	<datalist>
				<data command="spTraziPartneri" name="dtGetPartner">
					<parameter name="@action" value="Partneri"></parameter>
					<parameter name="@uvjet" value="#srcPartner.text"></parameter>
				</data>

				<data command="spTraziParstru" name="dtGetParstru">
        			<parameter name="@action" value="Parstru" />
        			<parameter name="@uvjet" value="#srcParstru.text" />
                    <parameter name="@Partneriid" value="#srcPartner" />
      			</data>

				<data command="spTraziTrgovine" name="dtGetTrgovina">
					<parameter name="@uvjet" value="#srcTrgovina.text" />
				</data>

				<data command="spProd_ProNarudzbe_GetVrstaNarudzbe" name="dtVrstaDokumenta">
				</data>

                <data command="spSutrasnjiDatum" name="dtSutrasnjiDatum">
				</data>

				
	</datalist>

</form>
</root>