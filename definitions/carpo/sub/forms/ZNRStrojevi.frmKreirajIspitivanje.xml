<root version="1.0">
	<form name="frmKreirajIspitivanje" caption="$caption" width="500" height="250" >
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" if="$tip==izmjena"/>
		</event>
		<event type="onshown">
		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="true" spacing="2,2,2,2">
				<item  col="1" row="1" caption="Datum ispitivanja radnog stroja:"  highlight="false" textposition="left">
					<dateedit name="datDatumIspitivanja" value="now" datavalue="~dtGet.@DatumIspitivanja">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtIstekIzracun"  />
							<action type="control value" value="#datDatumIsteka"  >
								<parameter value="~dtIstekIzracun.@DatumIsteka" />
							</action>
						</event>
					</dateedit>
				</item>
				<item  col="1" row="2" caption="Datum isteka:"   highlight="false" textposition="left">
					<dateedit name="datDatumIsteka" value="now" datavalue="~dtGet.@DatumIsteka"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun reader" value="~dtIzmjena" if="$tip==izmjena" />
						<action type="datarun reader" value="~dtUnos" else="">
							<action type="variable value">
								<parameter name="parent.$Fokus" value="~dtUnos.@NoviId" type="int"/>
							</action>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spZNRStrojevi_Query" name="dtGet">
				<parameter name="@Action" value="Dohvati_ispitivanja" />
				<parameter name="@ZNRStrojeviPrometId" value="$ZNRStrojeviPrometId"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtIstekIzracun">
				<parameter name="@Action" value="DatumIsteka_izracun" />
				<parameter name="@DatumIspitivanja" value="#datDatumIspitivanja"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtUnos">
				<parameter name="@Action" value="Unos_ispitivanja" />
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
				<parameter name="@DatumIspitivanja" value="#datDatumIspitivanja"/>
				<parameter name="@DatumIsteka" value="#datDatumIsteka"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtIzmjena">
				<parameter name="@Action" value="Izmjena_ispitivanja" />
				<parameter name="@ZNRStrojeviPrometId" value="$ZNRStrojeviPrometId"/>
				<parameter name="@DatumIspitivanja" value="#datDatumIspitivanja"/>
				<parameter name="@DatumIsteka" value="#datDatumIsteka"/>
			</data>
		</datalist>
	</form>
</root>
