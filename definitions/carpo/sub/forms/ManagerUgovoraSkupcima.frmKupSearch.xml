<root>
	<form name="frmKupSearch" caption="Pronađi na stablu" fixedsize="true">
        <event type="load">
            <action type="variable value" value="FilterInd">
                <parameter value="parent.$FilterInd" />
            </action>
        </event>
        <layout> 
            <group rows="1" cols="1">
                <columnsdefinition>
                    <column position="1" size="55%" />
                </columnsdefinition>
                <item row="1" col="1" caption="Pozicioniraj se na partnera: ">
                    <searchedit name="srcKupci" dataname="~dtPartneri" fieldtext="NazivId" fieldvalue="partneriid">
                        <event type="keydown" value="13">
                            <action type="control focus" value="parent.#tree">
                                <parameter value="#srcKupci" />
                            </action>
                            <action if="parent.#tree.@id!=#srcKupci" >
                                <action type="message" value="Traženi partner nema ugovora" />
                                <action type="control value" value="#srcKupci">
                                    <parameter value="null" />
                                </action>
                                <action type="control focus" value="#srcKupci" />
                            </action>
                            <action else="">
                                <action type="form close" />
                            </action>
                        </event>
                    </searchedit>
                </item>
            </group>
        </layout>
        <datalist>
            <data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcKupci.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
        </datalist>
	</form> 
</root>
