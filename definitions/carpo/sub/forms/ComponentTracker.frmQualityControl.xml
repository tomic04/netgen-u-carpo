<root>
	<form name="frmQualityControl" caption="QualityControl">
        <event type="load">
            <action type="control populate" value="#grdQC" />
        </event>
        <layout>
            <group cols="1" rows="1">
                <item row="1" col="1" height="396" width="380">
                    <grid name="grdQC" key="VersionTestId" dataname="~dtGetQcVersionInfo" multiselect="false" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false">
                    </grid>
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnDodajQcSlog" caption="Dodaj">
                    <event type="click">
                        <action type="form open" value="frmDodajQcInfo" />
                    </event>
                </button>
                <button name="btnObrisiQcSlog" caption="Obriši">
                    <event type="click">
                        <action type="confirm" value="Želite li sigurno obrisati ovu stavku?">
                            <action type="datarun nonquery" value="~dtDeleteQc" />
                            <action type="control populate" value="#grdQC" />
                        </action>
                    </event>
                </button>
                <button name="btnCancel" caption="Odustani" dock="right">
                    <event type="click">
                        <action type="formclose" />
                    </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtGetQcVersionInfo">
                <parameter name="@Action" value="getQcVersionInfo" />
                <!-- <parameter name="@VersionId" value="parent.#grdGlava.@id" if="global.$filter==Komponente"/>
                <parameter name="@VersionId" value="parent.#grdGlava.@VersionId" if="global.$filter==Partneri"/>    -->
                <parameter name="@VersionId" value="global.$versionId" />
            </data>
            <data command="spComponentTrackerAzur" name="dtDeleteQc">
                <parameter name="@Action" value="deleteQc" />
                <parameter name="@VersionTestId" value="#grdQC.@VersionTestId"/>
            </data>
        </datalist>
    </form>
</root>