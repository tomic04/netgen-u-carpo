<root>
  <form name="frmDonosUcinka" caption ="$caption" width="500" height="200">
    <event type="init">
      <action type="datarun reader" value="~dtProvjeri"></action>
    </event>
    <event type="shown">
      <action type="control disable" value="#rdoPrenesi" if="~dtProvjeri.@ImaPrijenos==1"/>
      <action type="control enable" value="#rdoPrenesi" elseif="~dtProvjeri.@ImaPrijenos==0"/>

      <action type="control disable" value="#rdoPonisti" if="~dtProvjeri.@ImaPrijenos==0"/>
      <action type="control enable" value="#rdoPonisti" elseif="~dtProvjeri.@ImaPrijenos==1"/>

      <action type="control value" value="#rdoPrenesi" if="~dtProvjeri.@ImaPrijenos==0">
        <parameter value="1"/>
      </action>
      <action type="control value" value="#rdoPonisti" if="~dtProvjeri.@ImaPrijenos==1">
        <parameter value="1"/>
      </action>


    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="3" groupbordervisible="false" >
        <item col="1" row="1"  highlight="False">
          <radioedit caption="Prenesi stavke iz učinka" name="rdoPrenesi" fontsizedelta="2" value="true"  />
        </item>
        <item col="1" row="2"  highlight="False">
          <radioedit caption="Poništi prijenos" name="rdoPonisti"  fontsizedelta="2"/>
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnIzvrsi" caption="IZVRŠI" >
          <event type="click">
            <action type="datarun reader" value="~dtPrenesi" if="#rdoPrenesi==true" waittype="progress" waitcaption="Pričekajte..." waittext="..izvršavanje u tijeku...">
              <action type="message" value="Nije otvorena obrada učinka s oznakom {global.$Oznaka}!" if="~dtPrenesi.@broj==-2"></action>
              <action type="message" value="Učinak je već prenesen!" if="~dtPrenesi.@broj==-1"></action>
              <action type="message" value="Preneseno je {~dtPrenesi.@broj} zapisa!" if="~dtPrenesi.@broj&gt;=0"></action>
            </action>
            <action type="datarun reader" value="~dtPonisti" if="#rdoPonisti==true">
              <action type="message" value="Obrisano je {~dtPonisti.@broj} zapisa!"></action>
            </action>
            <action type="form close"></action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlace_help" name="dtProvjeri">
        <parameter name="@action" value="kontrola_prijenosa_ucinka" type="string"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
      <data command="spOOPUcinakDonos_1" name="dtPrenesi">
        <parameter name="@action" value="1" type="int"/>
        <parameter name="@id" value="$oopobradeid"/>
        <parameter name="@oznaka" value="global.$Oznaka"/>
      </data>
      <data command="spOOPUcinakDonos_1" name="dtPonisti">
        <parameter name="@action" value="2" type="int"/>
        <parameter name="@id" value="$oopobradeid"/>
        <parameter name="@oznaka" value="global.$Oznaka"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>