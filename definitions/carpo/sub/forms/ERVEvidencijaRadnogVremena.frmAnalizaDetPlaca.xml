<root>
  <!--
    FORMA ZA uspoređivanje zapisa smjene i analitike za plaću
    Komentari:
    9.9.2021. Marin - dodao columnsdefinition da se gridovi ispravno iscrtavaju i na DevX20
  -->

  <form name="frmAnalizaDetPlaca" caption ="$caption" width="800" height="650"  statusbar="true" fixedsize="false" saveformsize="true" showversion="true" version="1">

    <event type="shown">
      <action type="control populate" value="#grdDet" />
	<action type="control selectedrows" value="#grdDet">
	  <parameter value="$zacekiraj"/>
	</action>
    </event>

    <layout>
      <group cols="2" rows="1" groupbordervisible="false" spacing="2,2,2,1">

      <columnsdefinition>
        <column position="1" size="50%"/>
        <column position="2" size="50%"/>
      </columnsdefinition>

          <item col="1" row="1">
            <grid name="grdDet"  caption="Izvorni zapisi" key="DneEv_MPId" dataname="dtDet" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showcheckboxes="true" showautofilterrow="true" allowfilter="true" savelayout="true">
              <event type="selectionchanged">
                <action type="control populate" value="#grdAnalitika"></action>
              </event>
            </grid>
          </item>
		  
		  <item col="2" row="1">
            <grid name="grdAnalitika"  caption="Analitika" key="DneEvId" dataname="dtAnalitika" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showautofilterrow="true" allowfilter="true" savelayout="true" multiselect="true">
              <event type="focusedrowchanged">
              </event>
            </grid>
          </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>

      <buttons>
        <button name="btnOdustani" caption="IZLAZ" dock="right" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spErvAnalizaDetPlaca" name="dtDet">
        <parameter name="@Action" value="detalji"/>
		<parameter name="@godina" value="$godina"/>
		<parameter name="@mjesec" value="$mjesec"/>
		<parameter name="@hrkadroviid" value="$hrkadroviid"/>
		<parameter name="@varSelectedIds.output.string" variablename="zacekiraj"/>
		
		
		
      </data>
      <data command="spErvAnalizaDetPlaca" name="dtAnalitika">
        <parameter name="@Action" value="analitika"/>
        <parameter name="@selectedids" value="#grdDet.selectedids"/>
      </data>
    </datalist>
  </form>


</root>