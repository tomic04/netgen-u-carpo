<root>
		<form name="frmDDDefinicijaIsplateAzur_Det" type="master" caption="$caption" width="250" height="250" fixedsize="false">
			<event type="load">
				<action type="control disable" value="#txtRbr"/>
				<action type="datarun reader" value="~dtGet" if="oopisstavkedefid!=0"/>
				<action type="datarun reader" value="~dtGetRbrIza"/>
			</event>
			<event type="shown">
				<action type="control value" value="#cmbTipStavke">
					<parameter value="~dtGet.@OOPIsStavkeTipId" text="~dtGet.@OOPIsStavkeTipId" if="$tip==IzmjenaDetAzur"/>
				</action>
				<action type="control value" value="#txtNaziv">
					<parameter value="~dtGet.@Naziv" if="$tip==IzmjenaDetAzur"/>
				</action>
				<action type="control value" value="#txtRbr">
					<parameter value="1" if="parent.#grdFormuleIzm.rowcount==0"/>
					<parameter value="~dtGet.@rbr" if="$tip!=IzmjenaAzur"/>
					<parameter value="~dtGetRbrIza.@rbr" else=""/>					
				</action>			
				<action type="control value" value="#txtPostotak">
					<parameter value="~dtGet.@Postotak" if="$tip==IzmjenaDetAzur"/>
				</action>
				<action type="control value" value="#txtFormula">
					<parameter value="~dtGet.@Formula" if="$tip==IzmjenaDetAzur"/>
				</action>
			</event>
			<layout>
				<group cols="2" rows="6" col="1" row="1" groupbordervisible="true">
					<item row="1" col="1" caption="Tip stavke:" textposition="left">
						<comboedit name="cmbTipStavke"  valuefield="OOPIsStavkeTipId" displayfield="Naziv" dataname="~dtGetTip" allownull="false"/>
					</item>
					<item row="2" col="1"  caption="Naziv:" textposition="left">
						<textedit name="txtNaziv"  required="true"/>
					</item>
					<item row="3" col="1"  caption="Rbr:"  textposition="left">
						<textedit name="txtRbr" />
					</item>
					<item row="4" col="1" caption="Postotak:"  textposition="left">
						<textedit name="txtPostotak" format="n2" value="0" allownull="false" nulltext="0.00"/>
					</item>
					<item row="5" col="1"  caption="Formula:"  textposition="left">
						<textedit name="txtFormula" />
					</item>
				</group>
				
			</layout>

			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="Spremi" type="add">
						<event type="click">
							<action type="validate"/>
							<action type="datarun reader" value="~dtUnosFormule" if="$tip==IzmjenaAzur">
								<parameter name="oopisstavkedefid" type="int"/>
								<action type="control populate" value="parent.#grdFormuleIzm"/>
								<action type="form close"/>
								
							</action>
							<action type="datarun reader" value="~dtUnosFormule" if="$tip==IzmjenaAzurI">
								<parameter name="oopisstavkedefid" type="int"/>
								<action type="control populate" value="parent.#grdFormuleIzm"/>
								<action type="form close"/>
							</action>
							<action type="datarun reader" value="~dtIzmjenaFormule" if="$tip==IzmjenaDetAzur">
								<parameter name="oopisstavkedefid" type="int"/>
								<action type="control focus" value="parent.#grdFormuleIzm">
									<parameter value="$oopisstavkedefid" type="int"/>
								</action>
								<action type="form close"/>								
							</action>
						</event>
					</button>
					<!-- KONTROLA: BUTTON -->
					<button name="Odustani" caption="Odustani" type="cancel" dock="right">
						<event type="click">
						</event>
					</button>
				</buttons>
			</panelbuttons>

			<datalist>
				<!--ovaj data puni grid-->				
				<data command="spDrugiDohodakQueryCP_Ivan" name="dtGetTip">
					<parameter name="@action" value="Tipcombo" />
				</data>

				<data command="spDrugiDohodakAzurCP_Ivan" name="dtUnosFormule">
					<parameter name="@action" value="Unos_formule" />
					<parameter name="@oopisStavkeId" value="$oopisStavkeId" />
					<parameter name="@naziv" value="#txtNaziv" />
					<parameter name="@postotak" value="#txtPostotak" />
					<parameter name="@formula" value="#txtFormula" />
					<parameter name="@rbr" value="#txtRbr" />
					<parameter name="@OOPIsStavkeTipId" value="#cmbTipStavke" />
				</data>
				<data command="spDrugiDohodakAzurCP_Ivan" name="dtIzmjenaFormule">
					<parameter name="@action" value="Izmjena_detalj" />
					<parameter name="@naziv" value="#txtNaziv" />
					<parameter name="@postotak" value="#txtPostotak" />
					<parameter name="@formula" value="#txtFormula" />
					<parameter name="@OOPIsStavkeTipId" value="#cmbTipStavke" />
					<parameter name="@oopisstavkedefid" value="parent.#grdFormuleIzm.@oopisstavkedefid" />
				</data>
				<data command="spDrugiDohodakQueryCP_Ivan" name="dtGet">
					<parameter name="@action" value="GetRbr" />
					<parameter name="@oopisstavkedefid" value="parent.#grdFormuleIzm.@oopisstavkedefid" />
				</data>
				<data command="spDrugiDohodakQueryCP_Ivan" name="dtGetRbrIza">
					<parameter name="@action" value="GetRbrIza" />
					<parameter name="@oopisstavkedefid" value="parent.#grdFormuleIzm.@oopisstavkedefid" />
				</data>
			</datalist>
		</form>

	<form name="frmDDDefinicijaIsplateAzur_DetKoef" type="master" caption="$caption" width="250" height="250" fixedsize="false">
		<event type="init">
			<action type="datarun reader" value="~dtGetKoef" if="$OOPIsStavkeKoefId!=0"/>
		</event>
		<layout>
			<group cols="2" rows="6" col="1" row="1" groupbordervisible="true">
				<item row="1" col="1"  caption="Prirez:" textposition="left">
					<textedit name="txtPrirez" format="n2" value="0" allownull="false" datavalue="~dtGetKoef.@Prirez"/>
				</item>
				<item row="2" col="1"  caption="Koeficijent:"  textposition="left">
					<textedit name="txtKoeficijent" format="n7"  value="0" allownull="false" datavalue="~dtGetKoef.@Koeficijent"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="datarun reader" value="~dtUnosKoef" if="$tip==UnosAzurKoef">
							<parameter name="OOPIsStavkeKoefId" type="int"/>
							<action type="control populate" value="parent.#grdKoefIzm"/>
							<action type="message" value="~dtUnosKoef.@Poruka" />
							<action type="control refreshvalue" value="#txtPrirez, #txtKoeficijent" if="~dtUnosKoef.@greska!=1"/>
						</action>
						<action type="datarun reader" value="~dtIzmjenakoef" if="$tip==IzmjenaAzurKoef">
							<parameter name="OOPIsStavkeKoefId" type="int"/>
							<action type="control focus" value="parent.#grdKoefIzm">
								<parameter value="$OOPIsStavkeKoefId" type="int"/>
							</action>
							<action type="message" value="~dtIzmjenakoef.@Poruka" />
							<action type="form close" if="~dtIzmjenakoef.@greska!=1"/>
						</action>
					</event>
				</button>
				<!-- KONTROLA: BUTTON -->
				<button name="Odustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
						<action type="control populate" value="parent.#grdKoefIzm"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<!--ovaj data puni grid-->
			<data command="spDrugiDohodakQueryCP_Ivan" name="dtGetTip">
				<parameter name="@action" value="Tipcombo" />
			</data>

			<data command="spDrugiDohodakQueryCP_Ivan" name="dtGetKoef">
				<parameter name="@action" value="KoeficijentIzmjena" />
				<parameter name="@OOPIsStavkeKoefId" value="$OOPIsStavkeKoefId" />
			</data>

			<data command="spDrugiDohodakAzurCP_Ivan" name="dtUnosKoef">
				<parameter name="@action" value="Unoskoef" />
				<parameter name="@oopisStavkeId" value="$oopisStavkeId" />
				<parameter name="@prirez" value="#txtPrirez" />
				<parameter name="@koeficijent" value="#txtkoeficijent" />
			</data>
			<data command="spDrugiDohodakAzurCP_Ivan" name="dtIzmjenakoef">
				<parameter name="@action" value="Izmjenakoef" />
				<parameter name="@prirez" value="#txtPrirez" />
				<parameter name="@koeficijent" value="#txtKoeficijent" />
				<parameter name="@oopisstavkekoefid" value="$OOPIsStavkeKoefId" />
				<parameter name="@oopisstavkeid" value="$OOPIsStavkeId" />
			</data>
		</datalist>
	</form>
</root>
