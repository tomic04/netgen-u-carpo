<root>
	<form name="frmFakturaPostavke" caption="Postavke fakture">
		<event type="load">
			<action type="datarun scalar" value="~dtDatumValute">
				<parameter name="DatumValute"/>
			</action>
			<action type="control value" value="#datDatumValute">
				<parameter value="$DatumValute"/>
			</action>
		</event>
		<layout>
			<group cols="1" rows="4">
				<item col="1" row="1" caption="Roba:">
					<comboedit name="cmbRoba" dataname="~dtRoba" valuefield="RobaId" displayfield="Naziv" savevalue="app" autopopulate="true"/>
				</item>
				<item col="1" row="2" caption="Organizacijska shema:">
					<combotreeedit name="cmbOrgShema" dataname="~dtOrgShema" parentfieldname="ParentId" valuefield="Id" displayfield="Naziv" autopopulate="true" savevalue="app"/>				
				</item>	
				<item col="1" row="3" caption="Datum valute:">
					<dateedit name="datDatumValute"/>			
				</item>	
				<item col="1" row="4" caption="Napomena:">
					<comboedit name="cmbNapomena" valuefield="PorukeId" displayfield="Poruka" dataname="~dtPoruke" autopopulate="true" savevalue="app"/>			
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnFakturiraj" caption="FAKTURIRAJ">
					<event type="click">
						<action type="control foreachrow selected" value="parent.#grdMaster">
							<action type="datarun nonquery" value="~dtFaktura"/>
						</action>
						<!-- <action if="transaction==success"> -->
							<!-- <action type="message" value="Faktura {$BrojFak} uspješno kreirana!"/> -->
						<!-- </action> -->
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtRoba" command="spCKteFakturaPostavke">
				<parameter name="@Action" value="1"/>
			</data>
			<data name="dtOrgShema" command="spCKntTemOrgShemaQuery">
				<parameter name="@Action" value="0"/>
			</data>	
			<data name="dtDatumValute" command="spCKteFakturaPostavke">
				<parameter name="@Action" value="2"/>
			</data>
			<data name="dtFaktura" command="spCKteKamateFakturiraj">
				<parameter name="@KntKteGlavaId" value="parent.#grdMaster.@KntKteGlavaId"/>
				<parameter name="@PartneriId" value="parent.#grdMaster.@PartneriId"/>
				<parameter name="@DatumFakture" value="parent.#grdMaster.@DatumDok"/>
				<parameter name="@OperateriId" value="@@OperateriId"/>
				<parameter name="@OrgShemaId" value="#cmbOrgShema"/>
				<parameter name="@RobaId" value="#cmbRoba"/>
				<parameter name="@DatumValute" value="#datDatumValute"/>
				<parameter name="@PorukeId" value="#cmbNapomena"/>
			</data>
			<data name="dtPoruke" command="spPorukeQuery">
				<parameter name="@Action" value="3" />
				<parameter name="@Sifra" value="30" />
			</data>	
		</datalist>
	</form>
</root>