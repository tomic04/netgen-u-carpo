<root>

  <!--******************************************FILTER****************************************-->

  <form name="frmFilter" caption="Filter prikaza"  width="570" height="380" fixedsize="true" saveformsize="false" showversion="true" version="1"  >
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" />
    </event>

    <layout textposition="left">
      <group cols="1" rows="8" >
        <item caption="Org. jedinica:" col="1" row="1" highlight="false" >
          <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" datavalue="~dtGet.@orgshemaid" datatext="~dtGet.@OrgShemaNaziv"/>
        </item>
        <item col="1" row="2"  highlight="False" >
          <checkedit caption="i ispod" name="chkPodorgsheme" datavalue="~dtGet.@podorgsheme" />
        </item>

        <item caption="Broj mjeseci za arhivu:" col="1" row="3" highlight="False">
          <textedit name="txtArhivaMjeseci" required="true" format="n0"  datavalue="~dtGet.@ArhivaMjeseci" textposition="left"/>
        </item>
        <item caption="Status obrade za arhivu:" col="1"  row="4" highlight="False">
          <comboedit name="cmbArhivaStatus"  valuefield="Status" displayfield="Naziv"  dataname="~dtArhivaStatusi" datavalue="~dtGet.@ArhivaStatus"/>
        </item>
        <item caption="Vrsta obrade za arhivu:" col="1"  row="5" highlight="False">
          <comboedit name="cmbArhivaVrstaObrade"  valuefield="OOPObradeVrsteId" displayfield="Naziv" dataname="~dtArhivaVrstaObrade" datavalue="#dtGet.@ArhivaVrstaObrade" />
        </item>

        <item caption="Status obustava:" col="1"  row="6" highlight="False">
          <comboedit name="cmbObustaveStatus"  valuefield="Status" displayfield="Naziv"  dataname="~dtObustaveStatusi" datavalue="~dtGet.@ObustaveStatus"/>
        </item>

        <item caption="Vrsta obustava:" col="1"  row="7" highlight="False">
          <comboedit name="cmbObustaveVrsta"  valuefield="OOPVrsteObustavaId" displayfield="Naziv" dataname="~dtObustaveVrsta" datavalue="#dtGet.@ObustaveVrsta" />
        </item>

        <item caption="Broj mjeseci za doznake:" col="1" row="8" highlight="False">
          <textedit name="txtDoznakeMjeseci" required="true" format="n0"  datavalue="~dtGet.@DoznakeMjeseci" textposition="left"/>
        </item>
        
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI" >
          <event type="click">
            <action type="validate"/>
            <action type="datarun reader" value="~dtFilterAzur" />
            <action type="form close" />
          </event>
        </button>

        <button name="btnOdustani" caption="ODUSTANI" dock="right">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>

      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spPlaceFilter_Help" name="dtGet">
        <parameter name="@Action" value="filter_query"/>
        <parameter name="@operateriid" value="@@operateriid"/>
      </data>
      <data command="spPlaceFilter_Help" name="dtFilterAzur">
        <parameter name="@Action" value="napuni_filter"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@OrgShemaId" value="#srcOrgShema"/>
        <parameter name="@Podorgsheme" value="1" if="#chkPodorgsheme==true"/>
        <parameter name="@Podorgsheme" value="0" else=""/>
        <parameter name="@ArhivaMjeseci" value="#txtArhivaMjeseci"/>
        <parameter name="@ArhivaStatus" value="#cmbArhivaStatus"/>
        <parameter name="@ArhivaVrstaObrade" value="#cmbArhivaVrstaObrade"/>
        <parameter name="@ObustaveStatus" value="#cmbObustaveStatus"/>
        <parameter name="@ObustaveVrsta" value="#cmbObustaveVrsta"/>
        <parameter name="@DoznakeMjeseci" value="#txtDoznakeMjeseci"/>
      </data>
      <data command="spPlace_help" name="dtOrgShema">
        <parameter name="@Action" value="src_orgshema"/>
        <parameter name="@Tekst" value="#srcOrgShema.text"/>
      </data>
      <data command="spPlace_help" name="dtArhivaStatusi">
        <parameter name="@Action" value="cmb_statusiobrada"/>
      </data>
      <data command="spPlace_help" name="dtArhivaVrstaObrade">
        <parameter name="@Action" value="cmb_VrstaObrade"/>
      </data>
      <data command="spPlace_help" name="dtObustaveStatusi">
        <parameter name="@Action" value="cmb_statusiobustava"/>
      </data>
      <data command="spPlace_help" name="dtObustaveVrsta">
        <parameter name="@Action" value="cmb_vrsteobustava"/>
      </data> 
      

    </datalist>

  </form>
  <!--*******************************************KRAJ FILTER**************************************************-->
  
</root>


