<root>
	<form name="frmDodajBezPriloga" caption="Dodaj verziju bez priloga">
	<event type="load">
			<action type="datarun reader" value="~dtLogin"/>
			<action type="datarun reader" value="~dtDatum"/>
            <action type="control value" value="#txtPublisher">
                <parameter value="~dtLogin.@Login"/>
            </action>
            <action type="control value" value="#dateObjava">
                <parameter value="~dtDatum.@Datum"/>
            </action>
		</event>
	<layout>
		<group cols="1" rows="7">
			<item row="1" col="1" caption="Naziv komponente">
				<comboedit name="cmbKomponenta" dataname="~dtKomponente" valuefield="id" displayfield="Naziv" required="true" />
			</item>
			<item row="2" col="1" caption="Verzija">
				<textedit name="txtVerzija" required="true"/>
			</item>
			<item row="3" col="1" caption="Kreator">
				<comboedit name="txtKreator" dataname="~dtOperateri" valuefield="OperateriId" displayfield="Naziv" required="true"/>
			</item>
			<item row="4" col="1" caption="Objavio" >
				<textedit name="txtPublisher" enabled="false" required="true"/>
			</item>
			<item row="5" col="1" caption="Datum objave">
				<dateedit name="dateObjava" required="true"/>
			</item>
			<item row="6" col="1" caption="Status">
				<comboedit name="cmbStatus" dataname="~dtStatus" valuefield="id" displayfield="Naziv" required="true"/>
			</item>
			<item row="7" col="1" caption="Memo">
				<memoedit name="memo"/>
			</item>
		</group>
	</layout>
	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">
				<event type="click">		
					<action type="validate" />
					<action type="datarun nonquery" value="~dtDodajVerziju" />
					<action type="control populate" value="parent.#grdGlava" />
					<action type="formclose" />
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani">
				<event type="click">
					<action type="formclose" />
				</event>
			</button>
		</buttons>
	</panelbuttons>
	<datalist>
		<data command="spComponentTracker" name="dtKomponente">
			<parameter name="@Action" value="getComponents" />
		</data>
		<data command="spComponentTracker" name="dtLogin">
			<parameter name="@Action" value="getLogin" />
		</data>
		<data command="spComponentTracker" name="dtStatus">
			<parameter name="@Action" value="cmbStatus" />
		</data>
		<data command="spComponentTrackerAzur" name="dtDodajVerziju">
			<parameter name="@Action" value="insertVersion" />
			<parameter name="@ComponentId" value="#cmbKomponenta" />
			<parameter name="@VersionNo" value="#txtVerzija" />
			<parameter name="@Creator" value="#txtKreator" />
			<parameter name="@PublishDate" value="#dateObjava" />
			<parameter name="@Status" value="#cmbStatus" />
			<parameter name="@Memo" value="#memo" />
		</data>
		<data command="select OperateriId, Naziv from ssOperateri where Active = 1" type="text" name="dtOperateri"/>
		<data command="select GETDATE() as Datum" type="text" name="dtDatum"/>

	</datalist>
	</form>
</root>