<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmBrisanjeDetalja" caption ="$caption"  width="500" height="130" fixedsize="true" saveformsize="false" showversion="true" version="1" >
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrane detalje plaće?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"/>
            <action type="message" value="~dtBrisanje.@Poruka"></action>
            <action type="form close" if="~dtBrisanje.@Id==0" />
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceDetAzur" name="dtBrisanje">
        <parameter name="@Action" value="detalj_brisanje" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@table" value="parent.#grdObradeDet.selectedids.table"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>