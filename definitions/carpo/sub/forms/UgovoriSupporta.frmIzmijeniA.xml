<root>
	<form name="frmIzmijeniA" caption="{parent.#grdMaster.@Naziv}">
		<event type="load">
			<action type="control value" value="#cmbModelSupporta">
				<parameter value="$SuppModelProsId"/>
			</action>
			<action type="control value" value="#txtIznosProsSupp">
				<parameter value="$IznosProsSupporta"/>
			</action>
			<action type="control value" value="#txtRabatDodatni">
				<parameter value="$RabatDodatni"/>
			</action>
			<action type="control value" value="#txtRabatRef">
				<parameter value="$RabatRef"/>
			</action>
			<action type="control value" value="#txtRabatAdmin">
				<parameter value="$RabatAdmin"/>
			</action>
			<action type="control value" value="#txtIznosSuppKriticne">
				<parameter value="$IznosSuppKriticne"/>
			</action>
		</event>
		<layout>
			<group rows="3" cols="4">
				<item row="1" col="1" colspan="3" caption="Model supporta">
					<comboedit name="cmbModelSupporta" dataname="~dtModelSupporta" valuefield="ModelSupporta" displayfield="Naziv"/>
				</item>
				<item row="1" col="4" caption="Iznos Pros Supp">
					<textedit name="txtIznosProsSupp" format="n2"/>
				</item>
				<item row="2" col="1" caption="Dodatni rabat">
					<textedit name="txtRabatDodatni" format="n2"/>
				</item>
				<item row="2" col="2" caption="Referentni rabat">
					<textedit name="txtRabatRef" format="n2"/>
				</item>
				<item row="2" col="3" caption="Admin rabat">
					<textedit name="txtRabatAdmin" format="n2"/>
				</item>
				<item row="2" col="4" caption="Iznos kritične funk.">
					<textedit name="txtIznosSuppKriticne" format="n2"/>
				</item>
				<item row="3" col="1" colspan="4" caption="Opis">
					<memoedit name="memOpis"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtSpremi"/>
						<action type="control populate" value="parent.#grdMaster"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSpremi" command="spSuppIzracunAzurCarpo">
				<parameter name="@Action" value="1"/>
				<parameter name="@SuppKorisnikId" value="parent.#grdMaster.@SuppKorisnikId"/>
				<parameter name="@Datum" value="global.$Datum"/>
				<parameter name="@Osnovica" value="parent.#grdMaster.@IznosUkupneLicence"/>
				<parameter name="@IznosProsSupp" value="#txtIznosProsSupporta"/>
				<parameter name="@SuppModelProsId" value="#cmbModelSupporta"/>
				<parameter name="@RabatAdmin" value="#txtRabatAdmin"/>
				<parameter name="@RabatDodatni" value="#txtRabatDodatni"/>
				<parameter name="@RabatRef" value="#txtRabatRef"/>
				<parameter name="@IznosSuppKriticne" value="#txtIznosSuppKriticne"/>
				<parameter name="@Opis" value="#memOpis"/>
				<parameter name="@RabatCAL" value="parent.#grdMaster.@RabatCAL"/>
				<parameter name="@RabatLoy" value="parent.#grdMaster.@RabatLoy"/>
				<parameter name="@IznosSupportaLic" value="parent.#grdMaster.@IznosSupportaLic"/>
				<parameter name="@IznosSupportaRazvoj" value="parent.#grdMaster.@IznosSupportaRazvoj"/>
				<parameter name="@IznosSupportaMp" value="parent.#grdMaster.@IznosSupportaMp"/>
				<parameter name="@IznosSupportaDb" value="parent.#grdMaster.@IznosSupportaDb"/>
				<parameter name="@IznosITsupport" value="parent.#grdMaster.@IznosITsupport"/>
				<parameter name="@IznosSupporta" value="parent.#grdMaster.@IznosSupporta"/>
			</data>
			<data name="dtModelSupporta" command="spBugsSuppQueryCarpo">
				<parameter name="@Action" value="MODEL SUPPORTA"/>
			</data>
		</datalist>
	</form>
</root>