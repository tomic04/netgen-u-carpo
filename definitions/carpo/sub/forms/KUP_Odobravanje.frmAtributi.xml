<root>
	<!--
	18.7.2025. AČ dodala partnera u poziv dimenzije i u frmAtributiEdit
	17.7.2025. AČ dvoklik na stavku grida i menuitem - pozivanje forme za izmjenu atributa
	-->
	<form name="frmAtributi" caption="Atributi za knjiženje" saveformsize="true" savelayout="true" saveformlayout="true">
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="shown">
			<action type="datarun reader" value="~dtGridAtributi" />
			<action type="datarun reader" value="~dtTecaj" />
			<action type="control value" value="#txtTecaj">
				<parameter value="~dtTecaj.@Tecaj" />
			</action>
			<action type="control disable" value="#txtTecaj" />
			<action type="control populate" value="#grdAtributi" />
			<action type="datarun reader" value="~dtLabel" />
			<action type="control value" value="#lblUR">
				<parameter value="~dtLabel.@LblUR" />
			</action>
			<action type="control visible" value="#chkRazdoblje,#datDatumOd,#datDatumDo">
				<parameter value="true" />
			</action>
			<action type="control visible" value="#btnDimenzije">
				<parameter value="true" />
			</action>
			<action type="control disable" value="#datDatumod,#datDatumdo" />
		</event>
		<layout>
			<group cols="5" rows="10">
				<columnsdefinition>
					<column size="80%" position="1" />
					<column size="80%" position="2" />
					<column size="80%" position="3" />
					<column size="10%" position="4" />
					<column size="40%" position="5" />
				</columnsdefinition>
				<rowsdefinition>
					<row size="5%" position="1" />
					<row size="5%" position="2" />
					<row size="5%" position="3" />
					<row size="5%" position="4" />
					<row size="5%" position="5" />
					<row size="5%" position="6" />
					<row size="5%" position="7" />
					<row size="5%" position="8" />
					<row size="25%" position="9" />
					<row size="4%" position="10" />
				</rowsdefinition>
				<item col="1" row="1" caption="" colspan="5">
					<labeledit name="lblUR" />
				</item>
				<item col="1" row="2" caption="Konto:" colspan="5">
					<searchedit name="srcKonto"  dataname="~dtKonto" fieldvalue="KntPlanAId" fieldtext="KNaziv" />
				</item>
				<item col="1" row="3" caption="Duguje:">
					<textedit name="txtDuguje" format="n2" />
				</item>
				<item col="2" row="3" caption="Potražuje:">
					<textedit name="txtPotrazuje" format="n2" />
				</item>
				<item col="1" row="4" caption="Dev. Duguje:">
					<textedit name="txtDevDuguje" format="n2" />
				</item>
				<item col="2" row="4" caption="Dev. Potražuje:">
					<textedit name="txtDevPotrazuje" format="n2" />
				</item>
				<item col="3" row="4" caption="Tečaj:">
					<textedit name="txtTecaj" datavalue="~dtTecaj.@Tecaj" />
				</item>
				<item col="1" row="5" caption="Ključ rasporeda troška:" colspan="5">
					<searchedit name="srcTrosak" required="true" dataname="~dtTrosak" fieldvalue="KeyCostMasterId" />
				</item>
				<item col="1" row="6" caption="Organizacijska jedinica:" colspan="5">
					<searchedit name="srcOrgShema" required="true" dataname="~dtOrgShema" fieldvalue="OrgShemaId" />
				</item>
				<item col="1" row="7" caption="Opis:" colspan="5">
					<textedit name="txtOpis" />
				</item>
				<group col="1" row="8" cols="5" rows="1" colspan="5">
					<!-- <columnsdefinition>
						<column size="20%" position="1" />
						<column size="7%" position="2" />
						<column size="30%" position="3" />
						<column size="30%" position="4" />
						<column size="20%" position="5" />
					</columnsdefinition> -->
					<item col="1" row="1">
						<button name="btnDimenzije" caption="Dimenzije" image="list">
							<event type="click">
								<action type="method run" value="fnDimenzijeGla">
									<parameter name="server" value="@@server" />
									<parameter name="database" value="@@database" />
									<parameter name="username" value="" />
									<parameter name="password" value="" />
									<parameter name="OperateriId" value="@@operateriid" />
									<parameter name="Parent" value="0" />
									<parameter name="pTop" value="0" />
									<parameter name="pLeft" value="0" />
									<parameter name="path" value="" />
									<parameter name="tip" value="kupprometufadetid" />
									<parameter name="id" value="kupprometufadetid" />
									<parameter name="glaid" value="$KupPrometId" />
									<parameter name="partneriid" value="$PartneriId"/>
								</action>
							</event>
						</button>
					</item>
					<item col="2" row="1">
						<checkedit name="chkRazdoblje" value="false">
							<event type="valuechanged">
								<action type="control enable" value="#datDatumod,#datDatumdo" if="#chkRazdoblje==true">
								</action>
								<action type="control disable" value="#datDatumod,#datDatumdo" else="">
								</action>
							</event>
						</checkedit>
					</item>
					<item col="3" row="1" caption="Datum od:">
						<dateedit name="datDatumod" valuefield="" dataname="" datavalue="" />
					</item>
					<item col="4" row="1" caption="Datum do:">
						<dateedit name="datDatumdo" valuefield="" dataname="" datavalue="" />
					</item>
					<item col="5" row="1">
						<button name="btnSpremiStavku" valuefield="" dataname="" datavalue="" caption="Spremi novu stavku" image="add">
							<event type="click">
								<action type="datarun scalar" value="~dtSpremiStavku" />
								<action type="control refreshvalue" value="#grdAtributi,parent.#grdAtributi" />
								<action type="control refreshvalue" value="#srcKonto,#txtDuguje,#txtPotrazuje,#txtDevDuguje,#txtDevPotrazuje,#txtTecaj, #srcTrosak,#srcOrgShema,#txtOpis" />
							</event>
						</button>
					</item>
				</group>
				<item col="1" row="9" colspan="5">
					<grid name="grdAtributi" dataname="~dtGridAtributi" showgrouppanel="false" savelayout="true" key="KupPrometUfaDetId">
						<event type="doubleclick">
							<action type="form open" value="frmAtributiEdit">
								<parameter name="KupPrometUfaDetId" value="#grdAtributi.@KupPrometUfaDetId"/>
								<parameter name="KupPrometId" value="$KupPrometId"/>
								<parameter name="PartneriId" value="$PartneriId"/>
							</action>
							<action type="control populate" value="#grdAtributi"/>
						</event>
						<fields>
							<field name="Konto4000" caption="Konto" />
							<field name="Partner4000" caption="Partner" />
							<field name="Broj računa1500" caption="Broj računa" />
							<field name="Duguje1500" caption="Duguje" type="decimal" />
							<field name="Potražuje1500" caption="Potražuje" type="decimal" />
							<field name="Dev. duguje1500" caption="Dev. duguje" type="decimal" />
							<field name="Dev. potražuje1500" caption="Dev. potražuje" type="decimal" />
							<field name="Tečaj1500" caption="Tečaj" />
							<field name="Org.jedinica3500" caption="Org.jedinica" />
							<field name="DIMJedan1200" caption="DIMJedan" />
							<field name="DIMDva1200" caption="DIMDva" />
							<field name="Objekt" caption="Objekt" />
							<field name="Ugovori" caption="Ugovori" />
							<field name="Ključ rasporeda troška2000" caption="Ključ rasporeda troška" />
							<field name="Opis" caption="Opis" />
						</fields>
						<menu>
							<menuitem name="menObrisi" caption="Obriši stavku">
								<event type="click">
									<action type="confirm" value="Jeste li sigurni da želite obrisati označenu stavku?">
										<action type="datarun nonquery" value="~dtObrisi">
											<action type="control refreshvalue" value="#grdAtributi" />
										</action>
									</action>
								</event>
							</menuitem>
							<menuitem name="menIzmjena" caption="Izmijeni stavku">
								<event type="click">
									<action type="form open" value="frmAtributiEdit">
										<parameter name="KupPrometUfaDetId" value="#grdAtributi.@KupPrometUfaDetId"/>
										<parameter name="KupPrometId" value="$KupPrometId"/>
										<parameter name="PartneriId" value="$PartneriId"/>
									</action>
									<action type="control populate" value="#grdAtributi"/>
								</event>
							</menuitem>
						</menu>
					</grid>
				</item>
				<item col="5" row="10">
					<button name="btnGotovo" caption="GOTOVO" fontsizedelta="1">
						<event type="click">
							<action type="form close" />
						</event>
					</button>
				</item>
			</group>
		</layout>
		<datalist>
			<data name="dtGridAtributi" command="spKUPPrometUfaDetQuery">
				<parameter name="@Action" value="queryufa" />
				<parameter name="@KUPPrometId" value="$KupPrometId" />
			</data>
			<data name="dtTecaj" command="spKUPPrometUfaDetQuery">
				<parameter name="@Action" value="tecaj" />
				<parameter name="@Id" value="$KupPrometId" />
			</data>
			<data name="dtSpremiStavku" command="spKUPPrometUfaDetQuery ">
				<parameter name="@Action" value="insertufa" />
				<parameter name="@KUPPrometId" value="$KupPrometId" />
				<parameter name="@KntPlanAId" value="#srcKonto" />
				<parameter name="@Duguje" value="#txtDuguje" />
				<parameter name="@Iznos" value="#txtPotrazuje" />
				<parameter name="@devdug" value="#txtDevDuguje" />
				<parameter name="@devpot" value="#txtDevPotrazuje" />
				<parameter name="@tecaj" value="#txtTecaj" type="decimal" />
				<parameter name="@KeyCostMasterId" value="#srcTrosak" />
				<parameter name="@OrgshemaId" value="#srcOrgShema" />
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data name="dtKonto" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="konto" />
				<parameter name="@Konto" value="#srcKonto.text" />
			</data>
			<data name="dtTrosak" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="trosak" />
				<parameter name="@Trosak" value="#srcTrosak.text" />
			</data>
			<data name="dtOrgShema" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="orgshema" />
				<parameter name="@OrgShema" value="#srcOrgShema.text" />
			</data>
			<data name="dtLabel" command="spKUPDonosNar">
				<parameter name="@Action" value="11" />
				<parameter name="@KupPrometId" value="$KupPrometId" />
			</data>
			<data name="dtObrisi" command="spKUPPrometUfaDetQuery">
				<parameter name="@Action" value="deleteufa" />
				<parameter name="@Id" value="#grdAtributi.@KupPrometUfaDetId" />
			</data>
		</datalist>
	</form>
</root>
