17.05.2017. PJ prilagodio za pozivanje iz drugih projekata
Forma se može pozivati iz drugih projekata:
Varijable:
IndUnosa=2		označava unos,Poslati iz parent forme na click eventu
ParId=			PartneriId, za punjenje tražilice,Poslati iz parent forme na click eventu
ParNaziv=		PartnerNaziv, za punjenje tražilice, Poslati iz parent forme na click eventu
DatumOd=		Ako se ne pošalje, gleda se defaultno ponašanje. Poslati iz parent forme na click eventu
DatumDo=		Poslati iz parent forme na click eventu
Projekti:  
KupciDobavljaci.xml
-->
<form name="frmPrijeboj"  caption="Prijeboj" width="1000" height="800"  statusbar="true">
		<event type="oninit">
			<action type="datarun reader" value="~dtPocetni" />
		</event>
		<event type="onload">
			<action if="parent.$IndUnosa!=1" type="control disable"  value="#srcPartner"/>
			<action if="parent.#grdGlava.@Zakljucena==1&amp;&amp;parent.$IndUnosa!=1" type="control disable" value="#datDatum, #txtBroj, #datDatumValute, #txtNapomena, #grdDuznik, #grdVjerovnik, #btnZakljuci, #btnZapamti, #btnObnovi, #cmbValuta, #txtTecaj" />
			<action type="datarun nonquery"  if="parent.$IndUnosa!=1" value="~dtOcistiTablice" />
			<action type="variable value" value="VrstaDokId" >
				<parameter  value="~dtPocetni.@VrstaDokId" />
			</action>
			<action type="variable value" value="ActionDuznik" if="parent.$IndUnosa==1||$IndUnosa==2">
				<parameter  value="23" />
			</action>
			<action type="variable value" value="ActionDuznik" if="parent.$IndUnosa==0">
				<parameter  value="9" />
			</action>
			<action type="variable value" value="ActionVjerovnik" if="parent.$IndUnosa==1||$IndUnosa==2">
				<parameter  value="24" />
			</action>
			<action type="variable value" value="ActionVjerovnik" if="parent.$IndUnosa==0">
				<parameter  value="10" />
			</action>


			<action type="datarun nonquery"  if="parent.$IndUnosa==0" value="~dtGetDuznik" />
			<action type="datarun nonquery"  if="parent.$IndUnosa==0" value="~dtGetVjerovnik" />
			<action type="control populate" value="#grdDuznik" if="parent.$IndUnosa==0||$IndUnosa==2"/>
			<action type="control populate" value="#grdVjerovnik" if="parent.$IndUnosa==0||$IndUnosa==2"/>
			<action type="datarun reader"  if="parent.$IndUnosa==0" value="~dtGet" />
			<action type="datarun reader"  if="parent.$IndUnosa==0" value="~dtGetDuznikIds" />
			<action type="datarun reader"  if="parent.$IndUnosa==0" value="~dtGetVjerovnikIds" />
			
			<!--Ovdje setam pomoćnu varijablu PartneriId samo za okidanje na leave datDatumValute -->
			<action type="variable value" value="PartneriId" if="parent.$IndUnosa==1||$IndUnosa==2">
				<parameter  value="null" />
			</action>
			<action type="variable value" value="PartneriId" if="parent.$IndUnosa==0"> <!--2 je samo kad se kreira iz izvještaja kupci/dobavljači -->
				<parameter  value="~dtGet.@partneriid" />
			</action>
			
			<action type="control selectedrows" value="#grdDuznik" >
				<parameter value="~dtGetDuznikIds.@dokid"/>
			</action>
			<action type="control selectedrows" value="#grdVjerovnik">
				<parameter value="~dtGetVjerovnikIds.@dokid"/>
			</action>
			

			
			<action type="control value" value="#datDatumValute" if="$IndUnosa==2">
				<parameter value="$DatumDo"></parameter>
			</action>
			<action type="control value" value="#datDatum" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@Datum"></parameter>
			</action>	
			<action type="control value" value="#txtBroj" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@Broj"></parameter>
			</action>	
			<action type="control value" value="#datDatumValute" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@DatVal"></parameter>
			</action>
			<action type="control value" value="#txtNapomena" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@Napomena"></parameter>
			</action>
			<action type="control value" value="#cmbValuta" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@ValuteId"></parameter>
			</action>
			<action type="control value" value="#txtTecaj" if="parent.$IndUnosa==0">
				<parameter value="~dtGet.@Tecaj"></parameter>
			</action>
			
		</event>
		
		<event type="onshown">
			<action type="control value" value="#srcPartner" if="$IndUnosa==2">
				<parameter value="$ParId" text="$ParNaziv"/>
			</action>
			<action type="datarun nonquery" value="~dtPuniTempDob" if="$IndUnosa==2"/>
			<action type="datarun nonquery" value="~dtPuniTempKup" if="$IndUnosa==2"/>
			<action type="footer text" value="Broj stavaka: Dužnik: {#grdDuznik.rowcount} / Vjerovnik: {#grdVjerovnik.rowcount}"  ></action>
					
					
		</event>
		<layout textposition="top" itemspadding="2"   > <!--autotaborder="false" focusdirection="downthenacross"-->
			<group cols="1" rows="1" groupbordervisible="false" >
				<group cols="4" rows="3" groupbordervisible="false">
					<group cols="4" rows="2" col="1" row="1" colspan="4" >
						<item col="1" row="1" caption="Datum:" >
							<dateedit name="datDatum"  required="true" value="now"   >
								<event type="valuechanged">
									<action type="variable value">
										<parameter name="Datum" value="#datDatum" />
									</action>
									<!--<action type="datarun reader" value="~dtBrojac" > <!{1}**if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"**{1}>
									</action>
									<action type="control value" value="#txtBroj" > <!{1}**if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"**{1}>
										<parameter value="~dtBrojac.@broj"></parameter>
									</action>	-->
								</event>
								<!--<event type="leave">							
									<action type="datarun reader" value="~dtBrojac" if="parent.$IndUnosa!=0"> <!{1}**if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"**{1}>
									</action>
									<action type="control value" value="#txtBroj" if="parent.$IndUnosa!=0"> <!{1}**if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"**{1}>
										<parameter value="~dtBrojac.@broj"></parameter>
									</action>								
								</event>-->							
							</dateedit>
						</item >
						<item col="2" row="1" caption="Broj:">
							<textedit name="txtBroj"  >
							</textedit>
						</item>
						<item col="3" row="1" caption="Datum valute:" >
							<dateedit name="datDatumValute"  required="true" value="now" >
								<event type="valuechanged">
									<action type="variable value">
										<parameter name="DatumValute" value="#datDatumValute" />
									</action>
								</event>
								<event type="leave" >
									<action type="datarun nonquery" value="~dtPuniTempDob"  if="$PartneriId!=null" />
									<action type="datarun nonquery" value="~dtPuniTempKup" if="$PartneriId!=null"/>
									<action type="control populate" value="#grdDuznik"  if="$PartneriId!=null"/>
									<action type="control populate" value="#grdVjerovnik" if="$PartneriId!=null" />
									<action type="datarun nonquery" value="~dtUkupnoDob"  if="$PartneriId!=null"/>
									<action type="datarun nonquery" value="~dtUkupnoKup" if="$PartneriId!=null"/>	
									<action type="datarun reader" value="~dtUkupno" if="$PartneriId!=null"/>									
								</event>							
							</dateedit>
						</item >
						<item col="4" row="1" caption="Napomena:">
							<textedit name="txtNapomena"  datavalue="~dtGet.@Napomena"  >
							</textedit>
						</item>
						<item col="1" row="2" caption="Valuta:">
							<comboedit name="cmbValuta"  dataname="~dtValute" displayfield="Naziv" valuefield="valuteid" autopopulate="true" allownull="false" required="true" >
								<event type="leave">
									<action type="datarun reader" value="~dtTecaj"/>
									<action type="control value" value="#txtTecaj">
										<parameter value="~dtTecaj.@tecaj" />
									</action>
								</event>
								<!-- ovo odkomentirati ako želimo da se na promjenu valute automatski refreshaju gridovi 
								<event type="valuechanged">	
									<action type="variable value" value="ActionDuznik">
										<parameter  value="23" />
									</action>
									<action type="variable value" value="ActionVjerovnik">
										<parameter  value="24" />
									</action>
									<action type="datarun nonquery" value="~dtPuniTempDob"  if="$PartneriId!=null" />
									<action type="datarun nonquery" value="~dtPuniTempKup" if="$PartneriId!=null"/>
									<action type="control populate" value="#grdDuznik"  if="$PartneriId!=null"/>
									<action type="control populate" value="#grdVjerovnik" if="$PartneriId!=null" />
									<action type="datarun nonquery" value="~dtUkupnoDob"  if="$PartneriId!=null"/>
									<action type="datarun nonquery" value="~dtUkupnoKup" if="$PartneriId!=null"/>	
									<action type="datarun reader" value="~dtUkupno" if="$PartneriId!=null"/>
								</event>	
								-->								
							</comboedit>
						</item>
						<item col="2" row="2" caption="Tečaj:">
							<textedit name="txtTecaj"   value="1" format="n6" >
							</textedit>
						</item>
					</group>
					<group cols="1" rows="3" col="1" row="2" colspan="2">
						<item col="1" row="1" caption="Dužnik:" >
							<searchedit type="partner" name="srcPartner" fieldtext="Naziv" fieldvalue="PartneriId" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartneriTra" tabindex="0" >
								<event type="valuechanged">
<!--									<action type="variable value">
										<parameter name="PartneriId" value="#srcPartner" />
									</action>-->
									<action type="datarun nonquery" value="~dtPuniTempDob" if="parent.$IndUnosa==1"/>
									<action type="datarun nonquery" value="~dtPuniTempKup" if="parent.$IndUnosa==1"/>
									<action type="control populate" value="#grdDuznik" />
									<action type="control populate" value="#grdVjerovnik" />
									<action type="datarun nonquery" value="~dtUkupnoDob" /> <!--if="$IndUnosa!=2"-->
									<action type="datarun nonquery" value="~dtUkupnoKup"/>	<!-- if="$IndUnosa!=2"-->
									<action type="datarun reader" value="~dtUkupno"/>
								</event>
							</searchedit>
						</item>
						<item col="1" row="2"  >
							<grid name="grdDuznik" async="true" dataname="~dtGridDuznik" datavalue="~dtGridDuznik" showcheckboxes="true" showfooter="True" key="dokid"  savelayout="true" multiselect="true" >
								<menu>
									<menuitem caption="Promet">
										<event type="click">
											<action type="variable value">
												<parameter name="BrojRacuna" value="#grdDuznik.@Broj" />
											</action>
											<action type="variable value">
												<parameter name="DuznikInd" value="1" />
											</action>
											<action type="form open" value="frmPromet"/>
										</event>
									</menuitem>
								</menu>
								<event type="focusedrowchanged">
									<action type="footer text" value="Broj stavaka: Dužnik: {#grdDuznik.rowcount} / Vjerovnik: {#grdVjerovnik.rowcount}"  ></action>
								</event>
								<event type="cellvaluechanged">					
									<action type="control selectedrows" value="#grdDuznik">
										<parameter value="{#grdDuznik.@dokid}" if="#grdDuznik.selectedids==null"/>
										<parameter value="{#grdDuznik.selectedids},{#grdDuznik.@dokid}" if="#grdDuznik.selectedids!=null"/>														
									</action>																						
									 <action type="datarun nonquery" value="~dtUpdateDuznik" />	
									 <action type="variable value" value="ActionDuznik">
										<parameter  value="23" />
									</action>
									<action type="control populate" value="#grdDuznik" />									 
									 <action type="datarun reader" value="~dtUkupnoKup"/> 
									 <action type="control value" value="#txtUkupnoDuznik" >	 
										 <parameter value="~dtUkupnoKup.@ukupnok" /> 
									 </action> 
									 <action type="datarun reader" value="~dtUkupno"/>	 
									 <action type="control value" value="#txtRazlika" >	 
										 <parameter value="~dtUkupno.@IznosUk" /> 
									 </action>									 
								</event>
								<event type="selectionchanged" >
									<action type="datarun reader" value="~dtUkupnoKup"/>
									<action type="control value" value="#txtUkupnoDuznik" >	
										<parameter value="~dtUkupnoKup.@ukupnok" />
									</action>
									<action type="datarun reader" value="~dtUkupno"/>	
									<action type="control value" value="#txtRazlika" >	
										<parameter value="~dtUkupno.@IznosUk" />
									</action>
									<action type="variable value">
										<parameter name="SelectedIDs" value="#grdDuznik.selectedids" />
									</action>
								</event>
								<fields>								
									<field name="Konto" />
									<field name="DatumDokumenta" />
									<field name="Broj" />
									<field name="DatumValute" caption="Datum valute" />
									<field name="Iznos" />
									<field name="IznosDev" caption="Iznos DEV" editable="true"/>
									<field name="Valuta" />
									<field name="Valuta2" caption="Datum valute2" />
									<field name="Upozorenje" />
									<field name="KompOznaka" caption="Oznaka"/>
									<field name="OrgShema" />
									<field name="BrojIra" />
									<field name="OpisKnjizenjaIRA" caption="Opis knjiženja" />
								</fields>
								<styles>
									<style name="fontcolor" value="black" if="#grdDuznik.@Upozorenje==''" />
									<style name="fontcolor" value="red" elseif="#grdDuznik.@Upozorenje!=''" />
								</styles>
							</grid>
						</item>
						<item col="1" row="3" caption="Ukupno:" textposition="left">
							<textedit name="txtUkupnoDuznik"  value="0" format="n2" fontsizedelta="2" formattype="numeric" dataname="~dtUkupnoKup" datavalue="~dtUkupnoKup.@ukupnok" enabled="false"/>
						</item>
					</group>
					<group cols="1" rows="3" col="3" row="2" colspan="2">
						<item col="1" row="1" caption="Vjerovnik:" >
							<searchedit type="partner" name="srcPartnerMi" fieldtext="Naziv" fieldvalue="PartneriId" datavalue="~dtPocetni.@vjerid" datatext="~dtPocetni.@vjerovnik" tabindex="0" enabled="false" >
<!--								<event type="valuechanged">									
									<action type="variable value">
										<parameter name="PartneriId" value="#srcPartner" />
									</action>
								</event>-->
							</searchedit>
						</item>
						<item col="1" row="2"  >
							<grid name="grdVjerovnik" async="true" dataname="~dtGridVjerovnik" datavalue="~dtGridVjerovnik" showcheckboxes="true" showfooter="True" key="dokid"  savelayout="true" >
								<menu>
									<menuitem caption="Promet">
										<event type="click">
											<action type="variable value">
												<parameter name="BrojRacuna" value="#grdVjerovnik.@Broj" />
											</action>
											<action type="variable value">
												<parameter name="DuznikInd" value="0" />
											</action>
											<action type="form open" value="frmPromet"/>
										</event>
									</menuitem>
								</menu>	
								<event type="focusedrowchanged">
									<action type="footer text" value="Broj stavaka: Dužnik: {#grdDuznik.rowcount} / Vjerovnik: {#grdVjerovnik.rowcount}"  ></action>
								</event>
								<event type="cellvaluechanged">
									<action type="control selectedrows" value="#grdVjerovnik">
										<parameter value="{#grdVjerovnik.@dokid}" if="#grdVjerovnik.selectedids==null"/>
										<parameter value="{#grdVjerovnik.selectedids},{#grdVjerovnik.@dokid}" if="#grdVjerovnik.selectedids!=null"/>														
									</action>	
									<action type="datarun nonquery" value="~dtUpdateVjerovnik" />
									<action type="variable value" value="ActionVjerovnik">
										<parameter  value="24" />
									</action>
									<action type="control populate" value="#grdVjerovnik" />
									<action type="datarun reader" value="~dtUkupnoDob"/>
									<action type="control value" value="#txtUkupnoVjerovnik" >	
										<parameter value="~dtUkupnoDob.@ukpd" />
									</action>
									<action type="datarun reader" value="~dtUkupno"/>	
									<action type="control value" value="#txtRazlika" >	
										<parameter value="~dtUkupno.@IznosUk" />
									</action>									
								</event>
								<event type="selectionchanged" >
									<action type="datarun reader" value="~dtUkupnoDob"/>
									<action type="control value" value="#txtUkupnoVjerovnik" >	
										<parameter value="~dtUkupnoDob.@ukpd" />
									</action>
									<action type="datarun reader" value="~dtUkupno"/>	
									<action type="control value" value="#txtRazlika" >	
										<parameter value="~dtUkupno.@IznosUk" />
									</action>
								</event>
								<fields>
									<field name="Konto" />
									<field name="DatumDokumenta" />
									<field name="Broj" />
									<field name="DatumValute" />
									<field name="Iznos" />
									<field name="IznosDev" caption="Iznos DEV" editable="true"/>
									<field name="Valuta" />
									<field name="Upozorenje" />
									<field name="KompOznaka" caption="Oznaka"/>
									<field name="OrgShema" />
									<!--TODO provjeri i po potrebi dodaj status plaćanja za Tele2
									<field name="StatusPlacanja" />
									-->
									<field name="BrojUra" />
									<field name="OpisKnjizenjaURA" caption="Opis knjiženja" />
								</fields>
								<styles>
									<style name="fontcolor" value="black" if="#grdVjerovnik.@Upozorenje==''" />
									<style name="fontcolor" value="red" elseif="#grdVjerovnik.@Upozorenje!=''" />
								</styles>
							</grid>
						</item>
						<item col="1" row="3" caption="Ukupno:" textposition="left">
							<textedit name="txtUkupnoVjerovnik"  value="0" format="n2" fontsizedelta="2"  formattype="numeric" dataname="~dtUkupnoDob" datavalue="~dtUkupnoDob.@ukpd" enabled="false"/>
						</item>
					</group>
					<item col="2" row="3" caption="Razlika:" colspan="2" textposition="left">
							<textedit name="txtRazlika"  value="0" format="n2" fontsizedelta="2"  formattype="numeric" datavalue="~dtSaldoUkupno.@IznosUk" enabled="false"/>
					</item>
				</group>
			</group>
		</layout>
			<panelbuttons>
				<buttons>
					<button name="btnObnovi" caption="Obnovi"> 
						<event type="click">
							<action type="variable value" value="ActionDuznik">
								<parameter  value="23" />
							</action>
							<action type="variable value" value="ActionVjerovnik">
								<parameter  value="24" />
							</action>
							<action type="datarun nonquery" value="~dtPuniTempDob"/>
							<action type="datarun nonquery" value="~dtPuniTempKup"/>
							<action type="control populate" value="#grdDuznik" />
							<action type="control populate" value="#grdVjerovnik" />
							<action type="datarun nonquery" value="~dtUkupnoDob"/>
							<action type="datarun nonquery" value="~dtUkupnoKup"/>	
							<action type="datarun reader" value="~dtUkupno"/>
						</event>
					</button>
					<!--disableam i sakrivam ovaj button -->
					<button name="btnZakljuci" caption="Zaključi" dock="right" visible="false" enabled="false">
						<event type="click">
								<action type="datarun reader" value="~dtBrojac" if="parent.$IndUnosa!=0"> <!--if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"-->
								</action>
								
								<action type="control value" value="#txtBroj" if="parent.$IndUnosa!=0"> <!--if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"-->
									<parameter value="~dtBrojac.@broj"></parameter>
								</action>	
							<action type="datarun nonquery" value="~dtZakljuci" if="parent.$IndUnosa==0"/>
							<action type="datarun scalar" value="~dtZakljuci" if="parent.$IndUnosa==1||$IndUnosa==2">
								<parameter name="KntKompMasterId"  />
							</action>
							<action type="variable value" if="parent.$IndUnosa!=1&amp;&amp;$IndUnosa!=2">
								<parameter name="KntKompMasterId" value="parent.#grdGlava.@KntKompMasterId" />
							</action>
							<action type="datarun nonquery" value="~dtUpdateZakljucena"/>
							<!--TODO provjeri zašto je ovaj if uvijet tu jer stvara problem!!-->
							<action type="datarun nonquery" value="~dtOcistiTablice" if="parent.$IndUnosa==1||$IndUnosa==2"/>
							<action type="form close" />
						</event>
					</button>
					<button name="btnZapamti" caption="Spremi" dock="right">
						<event type="click">						
								<action type="datarun reader" value="~dtBrojac" if="parent.$IndUnosa!=0"> <!--if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"-->
