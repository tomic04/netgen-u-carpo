								<action type="control value" value="#txtBroj" if="parent.$IndUnosa!=0"> <!--if="parent.$IndUnosa==1&amp;&amp;parent.#grdGlava.@Broj==''"-->
									<parameter value="~dtBrojac.@broj"></parameter>
								</action>														
							<action type="datarun nonquery" value="~dtZakljuci"/>
							<action type="datarun nonquery" value="~dtOcistiTablice"/>							
							<action type="form close" />
						</event>
