<root>
	<form name="frmObracun" caption="$caption" width="1050" height="800" fixedsize="false" saveformlayout="false" >
		<event type="init">
			<action  type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="~dtGetIspis"/>
		</event>
		<event type="load">
			<!-- <action type="control populate" value="#grdSintetika"/> -->
			<action type="control populate" value="#grdOpciPodaci"/>
			<action type="control populate" value="#grdStavke"/>
			

			<action type="control caption" value="#btnVirman">
				<parameter value="Kreiraj virman za {global.$Broj}"/>
			</action>		
			
			<action  type="datarun reader" value="~dtSintetika" />
			<action type="control value" value="#lbl1">
			  <parameter value="~dtSintetika.@lbl1"/>
			</action>
			<action type="control value" value="#lbl1vr">
			  <parameter value="~dtSintetika.@lbl1vr"/>
			</action>
			<action type="control value" value="#lbl2">
			  <parameter value="~dtSintetika.@lbl2"/>
			</action>
			<action type="control value" value="#lbl2vr">
			  <parameter value="~dtSintetika.@lbl2vr"/>
			</action>
			<action type="control value" value="#lbl3">
			  <parameter value="~dtSintetika.@lbl3"/>
			</action>
			<action type="control value" value="#lbl3vr">
			  <parameter value="~dtSintetika.@lbl3vr"/>
			</action>
			<action type="control attribute" value="#lbl1vr">
			  <parameter name="fontcolor" value="~dtSintetika.@lbl1_boja"/>
			</action> 
			<action type="control attribute" value="#lbl2vr">
			  <parameter name="fontcolor" value="~dtSintetika.@lbl2_boja"/>
			</action> 
			<action type="control attribute" value="#lbl3vr">
			  <parameter name="fontcolor" value="~dtSintetika.@lbl3_boja"/>
			</action> 
		</event>
		<event type="shown">
			<action type="control disable" value="#btnVirman" if="~dtGet.@indvirman==0">
			</action>	
			<action type="control disable" value="#btnProknjizi" if="~dtGet.@indknjizenje==0">
			</action>	
			<action type="control disable" value="#btnSpremiDat" if="~dtGet.@indizmjena==0">
			</action>	
		</event>
		<layout>
			<group rows="2" cols="3" groupbordervisible="false">
				<rowsdefinition>
					<row position="1" size="40%" />
					<row position="2" size="60%" />
				</rowsdefinition>
				<columnsdefinition>
					<column position="1" size="30%" />
					<column position="2" size="35%" />
					<column position="3" size="25%" />
				</columnsdefinition>
				<group col="1" row="1" rows="1" cols="1" spacing="2,2,2,2" caption="Opći podaci">
					<item row="1" col="1" highlight="false" >
						<grid name="grdOpciPodaci" dataname="~dtOpciPodaci" savelayout="false" fieldsmartspaces="true"  bestfitonrefresh="true" showgrouppanel="false" allowfilter="false" showautofilterrow="false" showcolumnheaders="false" showfooter="False" showfilter="false">
							<fields inherited="true"/>
						</grid>
					</item>
				</group>
				<group col="2" row="1" rows="5" cols="3" spacing="2,2,2,2" caption="Obračunski podaci">
					<rowsdefinition>
						<row position="1" size="20%" />
						<row position="2" size="20%" />
						<row position="3" size="20%" />
						<row position="4" size="20%" />
						<row position="4" size="20%" />
					</rowsdefinition>

					<item row="1" col="1" caption="Datum i vrijeme odlaska:" highlight="false">
						<textedit name="txtDatumVrO"  datavalue="~dtGet.@VrOdlaska" enabled ="true" readonly="true"/>
					</item>
					<item row="1" col="2" caption="Datum i vrijeme dolaska:" highlight="false" >
						<textedit name="txtDatumVrD"  datavalue="~dtGet.@VrDolaska" enabled ="true" readonly="true"/>
					</item>
					<item row="1" col="3" caption="Uk. vrijeme:" highlight="false" >
						<textedit name="txtUkVrijeme"  datavalue="~dtGet.@brsati" enabled ="true"  readonly="true"/>
					</item>
					<item row="2" col="1" highlight="false" caption="Tečaj:">
						<comboedit name="cmbTecaj" valuefield="IndTecaj" displayfield="naziv"  dataname="~dtTecaj" datavalue="~dtGet.@IndTecaj" allownull="false" enabled ="false"/>
					</item>
					<item row="2" col="2" caption="Banka:" highlight="false" colspan="2">
						<comboedit name="cmbBanka" valuefield="BankaId" displayfield="naziv"  dataname="~dtBanka" datavalue="~dtGet.@BankaId" allownull="false" enabled ="false"/>
					</item>
					<item row="3" col="1" caption="Datum obračuna:" highlight="false" >
						<dateedit name="dtDatumObracuna" value="now"  datavalue="~dtGet.@DatObracuna"/>
					</item>
					<item row="3" col="2" caption="Datum isplate:" highlight="false">
						<dateedit name="dtDatumIsplate" value="now"  datavalue="~dtGet.@DatIsplate"/>
					</item>
					<item row="3" col="3"  highlight="false" >
						<button name="btnSpremiDat" caption="Spremi datume" function="ButtonDatum">
							<event type="click">
								<action type="datarun reader" value="~dtPromjenaDatuma"/>
								<action type="control populate" value="parent.#grdMaster"/>
							</event>
						</button>
					</item>
					<item row="4" col="1" caption="Datum knjiženja:" highlight="false">
						<dateedit name="dtDatumknjizenja" value="now"  datavalue="~dtGet.@DatKnjizenja"/>
					</item>
					
					<!--<item row="4" col="1" caption="Uk. troškovi:" highlight="false">
						<textedit name="txtUkTroskovi"  datavalue="150.00" enabled ="true" readonly="true"/>
					</item>
					<item row="4" col="2" caption="Akontacija:" highlight="false">
						<textedit name="txtAkontacija"  datavalue="150.00" enabled ="true" readonly="true"/>
					</item>
					<item row="4" col="3" caption="Za isplatu:" highlight="false">
						<textedit name="txtZaIsplatu"  datavalue="150.00" enabled ="true" readonly="true"/>
					</item>-->
					
					<group row="5" col="1" rows="1" cols="2" groupbordervisible="false" colspan="2">
						<item row="1" col="1"  highlight="false">
							<button name="btnVirman" caption="Kreiraj virman" function="ButtonVirman">
								<event type="click">
									<action type="datarun reader" value="~dtKreirajVirman"/>
								</event>
							</button>
						</item>
						<item row="1" col="2"  highlight="false" >
							<button name="btnProknjizi" caption="Pregled knjiženja" function="ButtonProknjizi">
								<event type="click">
									<!--<action type="datarun reader" value="~dtProknjizi"/>-->
									<action type="form open" value="frmKnjizenje"/>
								</event>
							</button>
						</item>
					</group>
				</group>
				
				
				<!--<group col="3" row="1" rows="1" cols="1" spacing="2,2,2,2" caption="Sintetika">
					<item row="2" col="1" highlight="false" >
						<grid name="grdSintetika" key="sortid"  dataname="~dtSintetika" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" netgenfields="true">
							<fields inherited="true"/>
						</grid>
					</item>
				</group>-->
				<group col="3" row="1" rows="5" cols="3" spacing="2,2,2,2" caption="Sintetika">
					<!--<rowsdefinition>
						<row position="1" size="20%" />
						<row position="2" size="20%" />
						<row position="3" size="20%" />
						<row position="4" size="20%" />
						<row position="4" size="20%" />
					</rowsdefinition>-->
					
					<item caption="" row="1" col="1" >
						<labeledit name="lbl1" fontsizedelta="2" textposition="right" fontbold="true"/>
					</item>
					<item caption="" row="1" col="3" >
						<labeledit name="lbl1vr" fontsizedelta="2" textposition="right" fontbold="true" format="n2"/>
					</item>
					
					<item caption="" row="2" col="1" >
						<labeledit name="lbl2" fontsizedelta="2" textposition="right" fontbold="true"/>
					</item>
					<item caption="" row="2" col="3" >
						<labeledit name="lbl2vr" fontsizedelta="2" textposition="right" fontbold="true" format="n2"/>
					</item>
					
					<item caption="" row="3" col="1" >
						<labeledit name="lbl3" fontsizedelta="2" textposition="right" fontbold="true"/>
					</item>
					<item caption="" row="3" col="3" >
						<labeledit name="lbl3vr" fontsizedelta="2" textposition="right" fontbold="true" format="n2"/>
					</item>
					
				</group>
				
				
				<group col="1" row="2" rows="1" cols="1" spacing="2,2,2,2" caption="Stavke putnog naloga" colspan="3">
					<item row="1" col="1" highlight="false" >
						<grid name="grdStavke" key="pnnalozidetid"  dataname="~dtStavke" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" netgenfields="true" multiselect="true">
							<fields inherited="true"/>
							 <event type="doubleclick">
								<action type="form open" value="#grdStavke.@editformaid">
									<parameter name="pnnaloziid" value="$PNNaloziId"/>
									<parameter name="ID" value="#grdStavke.@PNNaloziDetId"/>
									<parameter name="caption" value="#grdStavke.@editcapid"/>
								</action>
													
								<action type="control populate" value="#grdOpciPodaci"/>
								<action type="control populate" value="#grdStavke"/>
								<action type="datarun reader" value="~dtGet" />
								<!-- <action type="control refreshvalue" value="##"/> -->
								<action type="datarun reader" value="~dtSintetika" />
								<action type="control value" value="#lbl1">
								  <parameter value="~dtSintetika.@lbl1"/>
								</action>
								<action type="control value" value="#lbl1vr">
								  <parameter value="~dtSintetika.@lbl1vr"/>
								</action>
								<action type="control value" value="#lbl2">
								  <parameter value="~dtSintetika.@lbl2"/>
								</action>
								<action type="control value" value="#lbl2vr">
								  <parameter value="~dtSintetika.@lbl2vr"/>
								</action>
								<action type="control value" value="#lbl3">
								  <parameter value="~dtSintetika.@lbl3"/>
								</action>
								<action type="control value" value="#lbl3vr">
								  <parameter value="~dtSintetika.@lbl3vr"/>
								</action>
								<action type="control attribute" value="#lbl1vr">
								  <parameter name="fontcolor" value="~dtSintetika.@lbl1_boja"/>
								</action> 
								<action type="control attribute" value="#lbl2vr">
								  <parameter name="fontcolor" value="~dtSintetika.@lbl2_boja"/>
								</action> 
								<action type="control attribute" value="#lbl3vr">
								  <parameter name="fontcolor" value="~dtSintetika.@lbl3_boja"/>
								</action> 
							</event> 
							<menu>
								<menuitem name="mnuBrisanje" caption="Obriši" function="BrisanjeStavke">
									<event type="click">
										<action type="datarun reader" value="~dtBrisiStavke">	
											<action if="$indGreske==0">
												<action type="message" value="Uspješno obrisano!"/>
												
												<action type="control populate" value="#grdOpciPodaci"/>
												<action type="control populate" value="#grdStavke"/>
												<action type="datarun reader" value="~dtGet" />
												<!-- <action type="control refreshvalue" value="##"/> -->
												<action type="datarun reader" value="~dtSintetika" />
												<action type="control value" value="#lbl1">
												  <parameter value="~dtSintetika.@lbl1"/>
												</action>
												<action type="control value" value="#lbl1vr">
												  <parameter value="~dtSintetika.@lbl1vr"/>
												</action>
												<action type="control value" value="#lbl2">
												  <parameter value="~dtSintetika.@lbl2"/>
												</action>
												<action type="control value" value="#lbl2vr">
												  <parameter value="~dtSintetika.@lbl2vr"/>
												</action>
												<action type="control value" value="#lbl3">
												  <parameter value="~dtSintetika.@lbl3"/>
												</action>
												<action type="control value" value="#lbl3vr">
												  <parameter value="~dtSintetika.@lbl3vr"/>
												</action>
												<action type="control attribute" value="#lbl1vr">
												  <parameter name="fontcolor" value="~dtSintetika.@lbl1_boja"/>
												</action> 
												<action type="control attribute" value="#lbl2vr">
												  <parameter name="fontcolor" value="~dtSintetika.@lbl2_boja"/>
												</action> 
												<action type="control attribute" value="#lbl3vr">
												  <parameter name="fontcolor" value="~dtSintetika.@lbl3_boja"/>
												</action> 
											</action>
										</action>
									</event>
								</menuitem>
							</menu>
						</grid>
					</item>
				</group>
			</group>
		</layout>
