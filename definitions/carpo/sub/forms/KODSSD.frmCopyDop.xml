<root>

  <!--FORMA ZA izmjenu DOPRINOSA-->
  <form name="frmCopyDop" caption ="$caption" miwidth="800" >
    <event type="init">
      <action type="datarun reader" value="~dtGet"/>
    </event>

    <layout>
      <group cols="1" rows="5"  spacing="2,2,2,2">
        <item caption="Sa datuma:" col="1" row="1" highlight="False" textposition="left">
          <dateedit name="datDatumDo"   required="true" textposition="left" datavalue="~dtGet.@DatumDo"/>
        </item>
        <item caption="Na datum:" col="1" row="2" highlight="False" textposition="left">
          <dateedit name="datDatumOd"   required="true" textposition="left" datavalue="~dtGet.@DatumOd"/>
        </item>
        <item caption="Min. osnovica:" col="1" row="3" highlight="False" textposition="left">
          <textedit name="txtMinOsnovica" required="false" nulltext="0,00" format="n2" textposition="left" />
        </item>
        <item caption="Max. osnovica:" col="1" row="4" highlight="False" textposition="left">
          <textedit name="txtMaxOsnovica" required="false" nulltext="0,00" format="n2" textposition="left"  />
        </item>
        <item caption="God. osnovica:" col="1" row="5"  highlight="False" textposition="left">
          <textedit name="txtGodOsnovica" required="false" nulltext="0,00" format="n2" textposition="left" />
        </item>
      </group>
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <action type="datarun reader" value="~dtSpremi"/>
            <action type="message" value="~dtSpremi.@poruka"/>
            <!-- Osvježi grid na parent formi -->
            <action type="control populate" value="parent.#grdDoprinosiStavka"/>
            <action type="form close" />
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spLnOOPSSDHelp" name="dtGet">
        <parameter name="@Action" value="kopiranje_datumi"/>
      </data>

      <data command="spLnOOPSSDDetAzur" name="dtSpremi">
        <parameter name="@Action" value="kopiranje_sve" />
        <parameter name="@OperateriId" value="@@OperateriId" />
        <parameter name="@datumod" value="#datDatumOd" type="date"/>
        <parameter name="@datumdo" value="#datDatumDo" type="date"/>
        <parameter name="@MinOsnovica" value="#txtMinOsnovica" type="decimal"/>
        <parameter name="@MaxOsnovica" value="#txtMaxOsnovica" type="decimal"/>
        <parameter name="@GodOsnovica" value="#txtGodOsnovica" type="decimal"/>
      </data>
    </datalist>
  </form>

  <!--kraj FORMA ZA izmjenu DOPRINOSA-->
</root>