<root>
<!--4.6.2020. AA format n3-->
	<form name="frmRobnaKartica" height="600" width="1000">
	<!--IndGranula 0 rekap po vrsta dok, 1 rekap po skt-->
		<event type="shown">
			<action type="datarun reader" value="~dtDohvatiCaption"/>
			<action type="form caption" value="{~dtDohvatiCaption.@userid}: {~dtDohvatiCaption.@naziv}/{~dtDohvatiCaption.@JMNaziv} " />
			<action type="variable value" if="#chkRedoslijed==False">
				<parameter name="Order" value="0" type="int" />
			</action>	
			<action type="variable value" if="#chkRedoslijed==True">
				<parameter name="Order" value="1" type="int" />
			</action>
			<action type="control populate" value="#grdRobnaKartica"/>
			<action type="datarun reader" value="~dtDohvatiSkladiste"/>
		</event>
		<layout>
			<group cols="1" rows="2" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdRobnaKartica" dataname="~dtRobnaKartica" bestfitonrefresh="true" async="false" multiselect="true" savelayout="true">
						<fields>
							<!-- <field name="ind" visible="false"/> -->
							<field name="Datumknjizenja" caption="Datum"/>
							<field name="Datumdok" caption="Datum dokumenta"/>
							<field name="Broj" caption="Broj dokumenta"/>
							<field name="OrgDok" caption="Izvorni dokument"/>
							<field name="VrstaDok" caption="Vrsta dokumenta"/>
							<field name="Cijena"/>
							<field name="KolicinaUlaz" caption="Količina ulaz" format="n3"/>
							<field name="KolicinaIzlaz" caption="Količina izlaz" format="n3"/>
							<field name="Stanje" format="n3"/>
							<field name="VrijednostUlaz" caption="Duguje"/>
							<field name="VrijednostIzlaz" caption="Potražuje"/>
							<field name="Saldo" />
							<field name="Partner" caption="Partner/Org. jedinica"/>
							<field name="Inicijali" caption="Operater"/>
							<field name="ImePrezime" caption="Odgovorna osoba"/>
							<field name="Skladiste2" caption="Skladište 2"/>
							<field name="RadniNalog" caption="Radni nalog"/>							
						</fields>
						<styles>
							<style name="bold" value="true" if="#grdRobnaKartica.@Broj==UKUPNO||#grdRobnaKartica.@Broj==SVEUKUPNO"/>
						</styles>
						<print caption="Kartica za robu: {~dtDohvatiCaption.@userid}: {~dtDohvatiCaption.@naziv}/{~dtDohvatiCaption.@JMNaziv} "
						       captionalign="center"
							   header="\n Skladište: {~dtDohvatiSkladiste.@opis}\n Razdoblje: od {$DatumOd::dd.MM.yyyy} do {$DatumDo::dd.MM.yyyy}"/>
					</grid>
				</item>
				<group col="1" row="2" cols="4" rows="1" groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="100"/>
						<column position="2" size="100"/>
						<column position="3" size="200"/>
						<!-- <column position="4" size="70%"/> -->
					</columnsdefinition>
					<rowsdefinition>
						<row position="2" size="45"/>
					</rowsdefinition>
					<item col="1" row="1">
						<button name="btnIspis" caption="ISPIS    SUČELJA">
							<event type="click">
								<action type="control printcontrol" value="#grdRobnaKartica"/>
							</event>
						</button>
					</item>
					<item col="2" row="1">
						<button name="btnIzlaz" caption="IZLAZ">
							<event type="click">
								<action type="form close"/>
							</event>
						</button>				
					</item> 
					<item col="3" row="1">
						<checkedit caption="Kartica po redoslijedu unosa" name="chkRedoslijed" savevalue="app">
							<event type="checkedchanged">
								<action type="variable value" if="#chkRedoslijed==False">
									<parameter name="Order" value="0" type="int" />
								</action>	
								<action type="variable value" if="#chkRedoslijed==True">
									<parameter name="Order" value="1" type="int" />
								</action>									
								<action type="control populate" value="#grdRobnaKartica"></action>									
							</event>								
						</checkedit>
					</item>		
				</group>
			</group>
		</layout>
		<datalist>
			<data name="dtRobnaKartica" command="spCSktKarticaRobna">
				<parameter name="@DatumOd" value="$DatumOd"/>
				<parameter name="@DatumDo" value="$DatumDo"/>
				<parameter name="@SkladisteId" value="$SkladisteId"/>
				<parameter name="@RobaId" value="$RobaId"/>
				<parameter name="@order" value="$Order"/>
			</data>
			<data name="dtDohvatiCaption" command="spCRekapDokument" >
				<parameter name="@Action" value="4"/>
				<parameter name="@VrstaDokId" value="$RobaId"/>
			</data>
			<data name="dtDohvatiSkladiste" command="spCRekapDokument">
				<parameter name="@Action" value="5"/>
				<parameter name="@VrstaDokId" value="$SkladisteId"/>
			</data>
		</datalist>
	</form>
</root>