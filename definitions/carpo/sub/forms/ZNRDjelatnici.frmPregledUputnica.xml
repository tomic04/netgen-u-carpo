<root version="1.0">
  <form name="frmPregledUputnica" caption="$caption" width="1000" height="700" >
    <event type="init">
      <action type="datarun reader" value="~dtUputnice" />
    </event>
    <layout>
      <group cols="1" rows="1" groupbordervisible="true" spacing="2,2,2,2">
        <item col="1" row="1" highlight="false">
          <grid name="grdUputnice" key="ZNRUputniceId" type="master" async="true" dataname="dtUputnice" preventfocusgroup="false" fieldsmartspaces="false" multiselect="false" bestfitonrefresh="true" autopopulate="true">
            <fields inherited="true">
              <field name="Datum" caption="Datum uputnice" />
              <field name="Broj" caption="Broj uputnice" />
              <field name="Pregled" caption="Vrsta pregleda" />
              <field name="RadnoMjesto" caption="Radno mjesto" fixwidth="400" rowautoheight="true"/>
              <field name="Clanci" caption="Članak 3.točka" />
              <field name="Pravilnici" caption="Ostali pravilnici" fixwidth="400" rowautoheight="true"/>
            </fields>
            <menu>
              <menuitem caption="Ispis uputnice" name="menIspisUputnice" sort="1">
                <event type="click">
                  <action type="control print" value="#grdUputnice">
                    <action type="print template" value="repx:rptZNRUputnice">
                      <parameter name="Action" value="UputnicaIspis" />
                      <parameter name="ZNRUputniceId" value="#grdUputnice.@ZNRUputniceId" />
                    </action>
                  </action>
                </event>
              </menuitem>
              <menuitem caption="Obriši uputnicu" name="menBrisanjeUputnice" sort="2">
                <event type="click">
                  <action type="datarun reader" value="~dtBrisi" />
                  <action type="control populate keepfocus" value="#grdUputnice"/>
                </event>
              </menuitem>
            </menu>
          </grid>
        </item>
      </group>
    </layout>
    <datalist>
      <data command="spZNRDjelatnici_Query" name="dtUputnice">
        <parameter name="@Action" value="Uputnice_grid"/>
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtBrisi">
        <parameter name="@Action" value="Uputnice_brisanje"/>
        <parameter name="@ZNRUputniceId" value="#grdUputnice.@ZNRUputniceId"/>
      </data>
    </datalist>
  </form>
</root>
