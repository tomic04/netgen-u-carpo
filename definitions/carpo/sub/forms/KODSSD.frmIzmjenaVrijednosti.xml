<root>

	<form name="frmIzmjenaVrijednosti" caption ="$caption" width="800"  height="665" fixedsize="false" saveformsize="false">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="~dtPrebroj" />
			<action type="variable value">
				<parameter name="rdo1broj" value="~dtPrebroj.@rdo1broj"/>
				<parameter name="rdo2broj" value="~dtPrebroj.@rdo2broj"/>
				<parameter name="rdo3broj" value="~dtPrebroj.@rdo3broj"/>
				<parameter name="rdo4broj" value="~dtPrebroj.@rdo4broj"/>
				<parameter name="rdo5broj" value="~dtPrebroj.@rdo5broj"/>
				<parameter name="rdo6broj" value="~dtPrebroj.@rdo6broj"/>
				<parameter name="rdo7broj" value="~dtPrebroj.@rdo7broj"/>
				<parameter name="rdo8broj" value="~dtPrebroj.@rdo8broj"/>
			</action>
		</event>
		<event type="load">
			<action type="control value" value="#txtDoprinos">
				<parameter value="$doprinosNaziv"></parameter>
			</action>

		</event>

		<event type="shown">
			<action type="control caption" value="#rdoOpcija1">
				<!--<parameter value="Spremi izmjene samo za ovu kombinaciju ({$rdo1broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za ovu stavku u ovom statusu ({$rdo1broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija2">
				<!--<parameter value="Spremi izmjene za sve kombinacije ove stavke ({$rdo2broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za ovu stavku u svim statusima ({$rdo2broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija3">
				<!--<parameter value="Spremi izmjene za sve kombinacije ovog statusa ({$rdo3broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za sve stavke u ovom statusu ({$rdo3broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija4">
				<!--<parameter value="Spremi izmjene za sve kombinacije ({$rdo4broj})"/>-->
				<parameter value="Spremi izmjene samo za ovaj doprinos za sve stavke u svim statusima ({$rdo4broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija5">
				<!--<parameter value="Spremi izmjene samo za ovu kombinaciju ({$rdo1broj})"/>-->
				<parameter value="Spremi izmjene za sve doprinose za ovu stavku u ovom statusu ({$rdo5broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija6">
				<!--<parameter value="Spremi izmjene za sve kombinacije ove stavke ({$rdo2broj})"/>-->
				<parameter value="Spremi izmjene za sve doprinose za ovu stavku u svim statusima ({$rdo6broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija7">
				<!--<parameter value="Spremi izmjene za sve kombinacije ovog statusa ({$rdo3broj})"/>-->
				<parameter value="Spremi izmjene za sve doprinose za sve stavke u ovom statusu ({$rdo7broj})"/>
			</action>
			<action type="control caption" value="#rdoOpcija8">
				<!--<parameter value="Spremi izmjene za sve kombinacije ({$rdo4broj})"/>-->
				<parameter value="Spremi izmjene za sve doprinose za sve stavke u svim statusima ({$rdo8broj})"/>
			</action>
		</event>

		<layout>
			<group cols="1" rows="4"  groupbordervisible="false">
				<group cols="1" rows="2" col="1" row="1" spacing="2,2,2,1">
					<item caption="Doprinos:" col="1" row="1" highlight="False" textposition="left">
						<textedit name="txtDoprinos"   readonly="true"/>
					</item>
					<group cols="3" rows="5" col="1" row="2" groupbordervisible="false">
						<item col="1" row="1"  highlight="False">
							<checkedit caption="Stopa" name="chkStopa" value="0"/>
						</item>
						<item caption="" col="2" row="1"  highlight="False" textposition="left">
							<textedit name="txtStopa" required="true" nulltext="0,00" format="n2" datavalue="~dtGet.@Stopa" />
						</item>
						<item col="3" row="1"  highlight="False">
							<checkedit caption="Izmijeni zapise različite od 0"  name="chkStopaEdit" value="1"/>
						</item>
						<item col="1" row="2"  highlight="False" >
							<checkedit caption="Min.osnovica" name="chkMinOsnovica"  value="0" />
						</item>
						<item caption="" col="2" row="2" highlight="False" textposition="left">
							<textedit name="txtMinOsnovica" required="false" nulltext="0,00" format="n2" datavalue="~dtGet.@MinOsnovica"/>
						</item>
						<item col="3" row="2"  highlight="False" >
							<checkedit caption="Izmijeni zapise različite od 0" name="chkMinOsnovicaEdit" value="1"/>
						</item>
						<item col="1" row="3"  highlight="False">
							<checkedit caption="Max.osnovica" name="chkIndMaxOsnovica" value="0"/>
						</item>
						<item caption="" col="2" row="3" highlight="False" textposition="left">
							<textedit name="txtMaxOsnovica" required="false" nulltext="0,00" format="n2" datavalue="~dtGet.@MaxOsnovica"  />
						</item>
						<item col="3" row="3"  highlight="False">
							<checkedit caption="Izmijeni zapise različite od 0" name="chkMaxOsnovicaEdit" value="1"/>
						</item>
						<item col="1" row="4"  highlight="False">
							<checkedit caption="God. osnovica" name="chkIndGodOsnovica" value="0"/>
						</item>
						<item caption="" col="2" row="4"  highlight="False" textposition="left">
							<textedit name="txtGodOsnovica" required="false" nulltext="0,00" format="n2" datavalue="~dtGet.@GodOsnovica"/>
						</item>
						<item col="3" row="4"  highlight="False">
							<checkedit caption="Izmijeni zapise različite od 0" name="chkGodOsnovicaEdit" value="1"/>
						</item>
						<item col="1" row="5"  highlight="False" >
							<checkedit caption="Koeficijent:" name="chkIndKoeficijent" value="0"/>
						</item>
						<item caption="" col="2" row="5" highlight="False" textposition="left">
							<textedit name="txtKoeficijent" required="false" value="1" format="n2" datavalue="~dtGet.@Koeficijent"/>
						</item>
						<item col="3" row="5"  highlight="False">
							<checkedit caption="Izmijeni zapise različite od 0" name="chkKoeficijentEdit" value="1"/>
						</item>
					</group>
				</group>

				<group cols="1" rows="5" col="1" row="2" spacing="2,2,1,1">
					<rowsdefinition>
						<row position ="1" size="15"/>
					</rowsdefinition>
					<item row="1" col="1" caption="Opcija spremanja:" highlight="False">
					</item>
					<item row="2" col="1" highlight="False">
						<radioedit name="rdoOpcija1" caption="" value="true" >
							<!--<radioedit name="rdoOpcija1" caption="Spremi izmjene samo za ovu kombinaciju" value="true" >-->
						</radioedit>
					</item>
					<item row="3" col="1" highlight="False">
						<radioedit name="rdoOpcija2" caption="" >
							<!--<radioedit name="rdoOpcija2" caption="Spremi izmjene za sve kombinacije ove stavke" >-->
						</radioedit>
					</item>
					<item row="4" col="1" highlight="False">
						<radioedit name="rdoOpcija3" caption="" >
							<!--<radioedit name="rdoOpcija3" caption="Spremi izmjene za sve kombinacije ovog statusa" >-->
						</radioedit>
					</item>
					<item row="5" col="1" highlight="False">
						<radioedit name="rdoOpcija4" caption="" >
							<!--<radioedit name="rdoOpcija4" caption="Spremi izmjene za sve kombinacije" >-->
						</radioedit>
					</item>

				</group>
				<group cols="1" rows="4" col="1" row="3" spacing="2,2,1,2">
					<item row="1" col="1" highlight="False">
						<radioedit name="rdoOpcija5" caption=""  >
							<!--<radioedit name="rdoOpcija1" caption="Spremi izmjene samo za ovu kombinaciju" value="true" >-->
						</radioedit>
					</item>
					<item row="2" col="1" highlight="False">
						<radioedit name="rdoOpcija6" caption="" >
							<!--<radioedit name="rdoOpcija2" caption="Spremi izmjene za sve kombinacije ove stavke" >-->
						</radioedit>
					</item>
					<item row="3" col="1" highlight="False">
						<radioedit name="rdoOpcija7" caption="" >
							<!--<radioedit name="rdoOpcija3" caption="Spremi izmjene za sve kombinacije ovog statusa" >-->
						</radioedit>
					</item>
					<item row="4" col="1" highlight="False">
						<radioedit name="rdoOpcija8" caption="" >
							<!--<radioedit name="rdoOpcija4" caption="Spremi izmjene za sve kombinacije" >-->
						</radioedit>
					</item>

				</group>
				<group cols="4" rows="1" col="1" row="4" spacing="2,2,1,2">
					<columnsdefinition>
						<column pos="1" size="55%"></column>
						<column pos="2" size="20%"></column>
						<column pos="3" size="5%"></column>
						<column pos="4" size="20%"></column>
					</columnsdefinition>
					<item col="1" row="1" >
						<labeledit name="lblVrijeme" value="Izmijeni postavke doprinosa koje su važeće u periodu:" fontbold="true"/>
					</item>
					<item caption="" col="2" row="1" highlight="False" textposition="left" >
						<dateedit name="datDatumOd"   required="true" textposition="left" datavalue="~dtGet.@DatumOd"/>
					</item>
					<item caption="" col="3" row="1" >
						<labeledit name="lblCrta" value="  -" />
					</item>
					<item caption="" col="4" row="1" highlight="False" textposition="left" >
						<dateedit name="datDatumDo"   required="true" textposition="left" datavalue="~dtGet.@DatumDo"/>
					</item>
				</group>


			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- Provjeri required fields -->
						<action type="validate" />
						<action type="message" value="Potrebno je odabrati najmanje jedan parametar za izmjenu!" if="#chkStopa==false&amp;&amp;#chkMinOsnovica==false&amp;&amp;#chkIndMaxOsnovica==false&amp;&amp;#chkIndGodOsnovica==false&amp;&amp;#chkIndKoeficijent==false" />
						<action type="datarun reader" value="~dtSpremi" else=""  waittype="progress" waitcaption="Pričekajte..." waittext="..izmjena u tijeku..." />
						<action type="message" value="~dtSpremi.@poruka"/>
						<action type="control populate" value="parent.#grdDoprinosiStavka"/>
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spLnOOPSSDQuery" name="dtGet">
				<parameter name="@Action" value="Izmjena_vrijednosti"/>
				<parameter name="@LnOOPSSDDetId" value="$LnOOPSSDDetId"/>
			</data>
			<data command="spLnOOPSSDQuery" name="dtPrebroj">
				<parameter name="@Action" value="Brojanje" type="string"/>
				<parameter name="@oopstavkeid" value="$oopstavkeid" type="int"/>
				<parameter name="@hrdopstatusiid" value="$hrdopstatusiid" type="int"/>
				<parameter name="@oopdoprinosiid" value="$oopdoprinosiid" type="int"/>
			</data>

			<data command="spLnOOPSSDDetAzur" name="dtSpremi">
				<parameter name="@Action" value="Izmjena_vrijednost" type="string"/>
				<parameter name="@lnOOPSSDDetId" value="$LnOOPSSDDetId" type="decimal"/>
				<parameter name="@DatumOd" value="#datDatumOd" type="date"/>
				<parameter name="@DatumDo" value="#datDatumDo" type="date"/>
				<parameter name="@chkStopa" value="#chkStopa"/>
				<parameter name="@chkStopaEdit" value="#chkStopaEdit"/>
				<parameter name="@chkMinOsnovica" value="#chkMinOsnovica"/>
				<parameter name="@chkMinOsnovicaEdit" value="#chkMinOsnovicaEdit"/>
				<parameter name="@chkIndMaxOsnovica" value="#chkIndMaxOsnovica"/>
				<parameter name="@chkMaxOsnovicaEdit" value="#chkMaxOsnovicaEdit"/>
				<parameter name="@chkIndGodOsnovica" value="#chkIndGodOsnovica"/>
				<parameter name="@chkGodOsnovicaEdit" value="#chkGodOsnovicaEdit" type="int"/>
				<parameter name="@lnOOPSSDGlaId" value="$LnOOPSSDGlaId" type="int"/>
				<parameter name="@OOPDoprinosiId" value="$OOPDoprinosiId" type="int"/>
				<parameter name="@hrdopstatusiId" value="$hrdopstatusiId" type="int"/>
				<parameter name="@OOPStavkeId" value="$OOPStavkeId" type="int"/>
				<parameter name="@OperateriId" value="@@OperateriId" />
				<parameter name="@Stopa" value="#txtStopa" type="decimal"/>
				<parameter name="@MinOsnovica" value="#txtMinOsnovica" type="decimal"/>
				<parameter name="@MaxOsnovica" value="#txtMaxOsnovica" type="decimal"/>
				<parameter name="@GodOsnovica" value="#txtGodOsnovica" type="decimal"/>
				<parameter name="@Koeficijent" value="#txtKoeficijent" type="decimal"/>
				<parameter name="@chkIndKoeficijent" value="#chkIndKoeficijent"/>
				<parameter name="@chkKoeficijentEdit" value="#chkKoeficijentEdit"/>
				<parameter name="@indDoprinosZaStavku" value="1" type="int" if="#rdoOpcija1==true"/>
				<parameter name="@indDoprinosZaStavkuSvihStatusa" value="1" type="int" if="#rdoOpcija2==true"/>
				<parameter name="@indDoprinosSveStavkeStatusa" value="1" type="int" if="#rdoOpcija3==true"/>
				<parameter name="@indDoprinosZaSveStavkeSvihStatusa" value="1" type="int" if="#rdoOpcija4==true"/>
				<parameter name="@indDopStavkaUstatusu" value="1" type="int" if="#rdoOpcija5==true"/>
				<parameter name="@indDopStavkaUStatusima" value="1" type="int" if="#rdoOpcija6==true"/>
				<parameter name="@indDopSveStavkeStatusa" value="1" type="int" if="#rdoOpcija7==true"/>
				<parameter name="@indDopSveStavkeSvihStatusa" value="1" type="int" if="#rdoOpcija8==true"/>
			</data>
		</datalist>
	</form>

</root>