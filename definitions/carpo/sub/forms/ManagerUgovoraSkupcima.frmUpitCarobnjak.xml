<root>

	<form name="frmUpitCarobnjak" caption="Želite li prenijeti sve stavke s odabranog ugovora?" type="master" width="300" height="200">
		<layout>
			<group cols="2" rows="1" col="1" row="1" bordervisible="true">
				<item col="1" row="1" caption="Prenesi sve stavke s odabranog ugovora" textposition="right" fontbold="true">
					<radioedit name="rdoSveStavke" value="1" />
				</item>
				<item col="2" row="1" caption="Prenesi bez stavaka" textposition="right" fontbold="true">
					<radioedit name="rdoBezStavaka" value="" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrijenos" caption="Potvrdi">
					<event type="click">
						<action type="variable value" value="Global.$OperaterLockId">
	                      <parameter value="$KupUgovoriGlaId" />
	                    </action>
	                    <action type="form open" value="frmKupCarobnjakBezStavki" if="#rdoBezStavaka==true">
	                    	<parameter name="KupUgovoriGlaID" value="$KupUgovoriGlaID"/>
	                		<parameter name="Status" value="$status" />
	                		<parameter name="Opis" value="$Opis" />
	                		<parameter name="KupUgovoriDetID" value="$KupUgovoriDetID" />
	                    </action>
	                    <action type="form open" value="frmKupCarobnjak" if="#rdoSveStavke==true">
                      		<parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                      		<parameter name="Status" value="$status" />
                  		</action>
                  		<action type="form close" value="frmUpitCarobnjak" />
					</event>
				</button>
				<button name="btnCancel" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
	</form>

</root>