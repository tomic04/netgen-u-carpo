<root>

  <!--******************************************UNOS / IZMJENA Sastavnice****************************************-->
  <form name="frmOSImovinaSastavnice" caption="$Caption" fixedsize="false" width="500" >
    
    <event type="oninit">
      <action type="datarun reader" value="~dtGet" if="$OSSastavnicaId!=0"/>
    </event>      
  
    <layout textposition="left" >
      <group cols="1" rows="7" spacing="2,2,2,2" >
        <item caption="Roba:" col="1" row="1" highlight="false" >
          <searchedit name="srcRoba" fieldvalue="RobaId" fieldtext="NazivRoba" dataname="~dtRoba" datavalue="~dtGet.@RobaId" datatext="~dtGet.@NazivRoba">
            <!--na promjenu  puni formu-->
            <event type="valuechanged" raiseonload="false" >
              <action type="datarun reader" value="~dtPopuniNaziv" if="$OSSastavnicaId==0" />
              <action type="control value" value="#txtNaziv"  >
                <parameter value="~dtPopuniNaziv.@Naziv" />
              </action>
            </event>
          </searchedit>
        </item>
        <item caption="Naziv:" col="1" row="2" highlight="false" >
          <textedit name="txtNaziv" datavalue="~dtGet.@Naziv"/>
        </item>
        <item caption="Količina:"  col="1" row="3" >
          <textedit name="txtKolicina" format="n2" value="1" datavalue="~dtGet.@Kolicina" textposition="left"/>
        </item>
        <item caption="Iznos:"  col="1" row="4" >
          <textedit name="txtIznos" format="n2" value="0" datavalue="~dtGet.@Iznos" textposition="left"/>
        </item>
        <item caption="Datum nabave:" col="1" row="5" highlight="false" >
          <dateedit name="datDatumNab" value="now" allownull="true" datavalue="~dtGet.@DatumNab"/>
        </item>
        <item caption="Datum rashoda:" col="1" row="6" highlight="false" >
          <dateedit name="datDatumRas" value="now" allownull="true" datavalue="~dtGet.@DatumRas"/>
        </item>
        <item caption="Napomena:"  col="1" row="7" >
          <textedit name="txtNapomena" datavalue="~dtGet.@Napomena"/>
        </item>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        <button name="btnSpremi"  caption="Spremi" type="add" >
          <event type="click">
            <action type="validate" />
            <action type="datarun nonquery" value="~dtEdit" if="$OSSastavnicaId!=0"/>
            <action type="datarun nonquery" value="~dtAdd" else="" />
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdSastavnice"/>
          </event>
        </button>
        <button caption="Izlaz" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovinaSastavnice_CP" name="dtRoba">
        <parameter name="@Action" value="Roba_src"/>
        <parameter name="@Tekst" value="#srcRoba.text"/>
      </data>
      <data command="spOSImovinaSastavnice_CP" name="dtPopuniNaziv">
        <parameter name="@Action" value="Popuni_naziv"/>
        <parameter name="@RobaId" value="#srcRoba.@RobaId"/>
        <parameter name="@OSSastavnicaId" value="$OSSastavnicaId"/>
      </data>
      <data command="spOSImovinaSastavnice_CP" name="dtGet">
        <parameter name="@Action" value="Sastavnica_popuni"/>
        <parameter name="@OSSastavnicaId" value="$OSSastavnicaId"/>
      </data>
      <data command="spOSImovinaSastavnice_CP" name="dtAdd">
        <parameter name="@Action" value="Unos"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
        <parameter name="@RobaId" value="#srcRoba"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Kolicina" value="#txtKolicina" type="decimal"/>
        <parameter name="@Iznos" value="#txtIznos" type="decimal"/>
        <parameter name="@DatumNab" value="#datDatumNab"/>
        <parameter name="@DatumRas" value="#datDatumRas"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
      </data>
      <data command="spOSImovinaSastavnice_CP" name="dtEdit">
        <parameter name="@Action" value="Izmjena"/>
        <parameter name="@OSSastavnicaId" value="$OSSastavnicaId"/>
        <parameter name="@RobaId" value="#srcRoba"/>
        <parameter name="@Naziv" value="#txtNaziv"/>
        <parameter name="@Kolicina" value="#txtKolicina" type="decimal"/>
        <parameter name="@Iznos" value="#txtIznos" type="decimal"/>
        <parameter name="@DatumNab" value="#datDatumNab"/>
        <parameter name="@DatumRas" value="#datDatumRas"/>
        <parameter name="@Napomena" value="#txtNapomena"/>
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ UNOS / IZMJENA Statusa**************************************************-->
</root>