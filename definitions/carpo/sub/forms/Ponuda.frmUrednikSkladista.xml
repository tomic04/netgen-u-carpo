<root>
    <form name="frmUrednikSkladista" caption="Urednik skladišta" width="400" height="50" fixedsize="true">
        <!--<method name="funProdKalk" dll="Carpo.Specific" class="Carpo.Specific.Matpos.ProdKalk" method="CalculationRabat" />
        <event type="onshown">
            <action type="control focus" value="#txtRabat"></action>
        </event>-->
        <layout textposition="left">
			<group cols="1" rows="1" bordervisible="false">
				<item caption="Skladište:" row="1" col="1">
					<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" datavalue="#dtGet.@SkladisteId" dataname="dtUrednikSkladista" />
				</item>
			</group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="right">
                    <event type="click">
                        <action type="control foreachrow selected" value="parent.#grdRoba">
                            <action type="datarun nonquery" value="~dtSkladisteAzur"/>
                        </action>
                        <action type="control populate" value="parent.#grdRoba" />
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_PonDet_UrednikSkladista" name="dtSkladisteAzur">
                <parameter name="@ProPonDetId" value="parent.#grdRoba.@ProPonDetId" />
                <parameter name="@SkladisteId" value="#cmbSkladiste" />

            </data>

			<data command="spProd_PonDet_UrednikSkladista_getSkladista" name="dtUrednikSkladista">

			</data>
			
        </datalist>
    </form>
</root>