<root>
    <form name="frmUrednikRabata" caption="Urednik rabata" width="400" height="250" fixedsize="true">
        <event type="onshown">
            <action type="control focus" value="#txtRabat"></action>
        </event>
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols="3" rows="5" row="1" col="1">
                    <item row="1" col="1">
                        <labeledit value="Za označene stavke:" />
                    </item>
                    <item row="2" col="1" caption="">
                        <radioedit name="rdoRabat" caption="Postavi rabat na" value="true" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabat" if="#rdoRabat==true" >
                                    <action type="control focus" value="#txtRabat"></action>
                                </action>
                                <action type="control disable" value="#txtRabat" else="#rdoRabat==false" >
                                    <action type="control value" value="#txtRabat">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item row="2" col="2" textalignmode="auto">
                        <textedit name="txtRabat" value="0" format="n4" />
                    </item>
                    <item row="2" col="3" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                    <item row="3" col="1">
                        <radioedit name="rdoRabatPodigni" caption="Podigni postojeći rabat za" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatPodigni" if="#rdoRabatPodigni==true">
                                    <action type="control focus" value="#txtRabatPodigni"></action>
                                </action>
                                <action type="control disable" value="#txtRabatPodigni" else="#rdoRabatPodigni==false" >
                                    <action type="control value" value="#txtRabatPodigni">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="3" col="2" textalignmode="auto">
                        <textedit name="txtRabatPodigni" value="0" format="n4" enabled="false"/>
                    </item>
                    <item row="3" col="3" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                    <item row="4" col="1">
                        <radioedit name="rdoRabatPodigniPlus" caption="Podigni rabat na postojeći rabat plus" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatPodigniPlus" if="#rdoRabatPodigniPlus==true" >
                                    <action type="control focus" value="#txtRabatPodigniPlus"></action>
                                </action>
                                <action type="control disable" value="#txtRabatPodigniPlus" else="#rdoRabatPodigniPlus==false">
                                    <action type="control value" value="#txtRabatPodigniPlus">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="4" col="2" textalignmode="auto">
                        <textedit name="txtRabatPodigniPlus" value="0" format="n4" enabled="false"/>
                    </item>
                    <item row="4" col="3" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="postotnih poena" textalignmode="left"/>
                    </item>
                    <item row="5" col="1">
                        <radioedit name="rdoRabatOstatak" caption="Rabat na ostatak" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtRabatOstatak" if="#rdoRabatOstatak==true">
                                    <action type="control focus" value="#txtRabatOstatak"></action>
                                </action>
                                <action type="control disable" value="#txtRabatOstatak" else="#rdoRabatOstatak==false">
                                    <action type="control value" value="#txtRabatOstatak">
                                        <parameter value="0"/>
                                    </action>
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <item caption="" row="5" col="2" textalignmode="auto">
                        <textedit name="txtRabatOstatak" value="0" format="n4" enabled="false"/>
                    </item>
                    <item row="5" col="3" textvisible="False" padding="0" textalignmode="left">
                        <labeledit value="%" textalignmode="left"/>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="right">
                    <event type="click">
                        <action type="control foreachrow selected" value="parent.#grdRoba">
							<action type="datarun reader" value="~dtRabatKalk"/>
							<action type="variable value">
								<parameter name="Rabat" value="~dtRabatKalk.@RabatPosto" />
							</action>
							<action type="variable value">
								<parameter name="BruttoCijenaKn" value="~dtRabatKalk.@BruttoCijenaKn" />
							</action>	
							<action type="variable value">
								<parameter name="BruttoCijenaBod" value="~dtRabatKalk.@BruttoCijenaBod" />
							</action>								
                            <action type="datarun nonquery" value="~dtRabat"/>
                        </action>
                        <action type="control populate" value="parent.#grdRoba" />
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_PonDet_UrednikRabata" name="dtRabat">
                <parameter name="@ProPonDetId" value="parent.#grdRoba.@ProPonDetId" />
                <parameter name="@Rabat" value="$Rabat" />
                <parameter name="@BruttoCijenaKn" value="$BruttoCijenaKn" />				
                <parameter name="@BruttoCijenaBod" value="$BruttoCijenaBod" />						
            </data>
			<data command="spProd_PonDet_UrednikRabata_Kalk" name="dtRabatKalk">
				<parameter name="@kolicina" value="parent.#grdRoba.@Kolicina" type="decimal" />
				<parameter name="@cijena" value="parent.#grdRoba.@Cijena" type="decimal" />
				<parameter name="@porez" value="parent.#grdRoba.@Porez" type="decimal" />
				<parameter name="@cassa" value="0" type="decimal" />
				<parameter name="bod" value="Global.$NasBod" type="decimal" />
                <parameter name="@gridRabat" value="parent.#grdRoba.@Rabat" type="string" />
				<parameter name="@rabatposto" value="#txtRabat" type="decimal" if="#rdoRabat==true"/>
				<parameter name="@rabatposto" value="#txtRabatPodigni" type="decimal" elseif="#rdoRabatPodigni==true"/>
				<parameter name="@rabatposto" value="#txtRabatPodigniPlus" type="decimal" elseif="#rdoRabatPodigniPlus==true"/>
				<parameter name="@rabatposto" value="#txtRabatOstatak" type="decimal" else=""/>
				<parameter name="@kojiRabat" value="rabatObicni" type="string" if="#rdoRabat==true"/>
				<parameter name="@kojiRabat" value="rabatPodigni" type="string" elseif="#rdoRabatPodigni==true"/>
				<parameter name="@kojiRabat" value="rabatPodigniPlus" type="string" elseif="#rdoRabatPodigniPlus==true"/>
				<parameter name="@kojiRabat" value="rabatOstatak" type="string" else=""/>				
			</data>
        </datalist>
    </form>
</root>