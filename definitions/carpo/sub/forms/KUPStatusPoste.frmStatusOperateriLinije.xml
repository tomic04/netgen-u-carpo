      </buttons>
    </panelbuttons>
    
    <datalist>

      <data command="spCKUPPredlosciILinije" name="dtLinijeOdobravatelji">
        <parameter name="@action" value="linijeodobravatelji"/>
        <parameter name="@KUPOdobriLinijaId" value="$KUPOdobriLinijaId"/>
        <parameter name="@id" value="$KUPOdobriPredlozakId"/>

      </data>
      
      
      <data command="spCKUPPredlosciILinije" name="dtInsertLinijeOdobravatelji">
        <parameter name="@action" value="insertlinijeodobravatelji"/>
        <parameter name="@operateriniz" value="#grdLinijeOdobravatelji.selectedids" type="string"/>
        <parameter name="@KUPOdobriLinijaId" value="$KUPOdobriLinijaId"/>
        <parameter name="@id" value="$KUPOdobriPredlozakId"/>
        
      </data>
    </datalist>
    
  </form>
</root>

