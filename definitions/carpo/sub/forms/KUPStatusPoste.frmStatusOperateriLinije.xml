<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmStatusOperateriLinije" type="master" caption="Operateri :: {$Tekst}" statusbar="false">
    <event type="init">
     
    </event>

    <event type="load">
      <action type="control populate" value="#grdLinijeOdobravatelji"/>
    </event>
    <event type="shown">

    </event>
    <layout textposition="left" itemspadding="3">
      <group cols="1" rows="1" col="1" row="1">
        <item caption=" " row="1" col="1" >
          <grid name="grdLinijeOdobravatelji" keyfield="operateriid" multiselect="true" key="operateriid" dataname="dtLinijeOdobravatelji" showmenuprintitem="false" showmenutools="false" savelayout="true" showcheckboxes="false">
            <fields inherited="true">
              <field name="checked" caption=" " editable="true" edittype="bit" showtotalsum="false"/>
              <field name="Operater" caption="Operater" fixwidth="200" />
            </fields>
            <event type="cellvaluechanged">
              <action type="datarun nonquery" value="~dtInsertLinijeOdobravatelji" />
              <action type="control populate keepfocus" value="#grdLinijeOdobravatelji" />
            </event>
            <styles>
               <!--BOJANJE-->
              <style name="fontcolor" value="green" if="#grdLinijeOdobravatelji.@Checked==True" />
            </styles>
          </grid>
        </item>  
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <!--button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="datarun scalar" value="~dtInsertLinijeOdobravatelji"/>        
            <action type="form close"/>
