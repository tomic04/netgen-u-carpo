          <event type="click">
            <action type="form close"/>
			 <action type="control populate" value="parent.#grdPredlosciLinije">
              <action type="control focus" value="parent.#grdPredlosciLinije">
                <parameter value="parent.$KUPOdobriPredlozakId" />
              </action>
            </action>
			<action type="control populate" value="parent.#grdPredlosciLinije">
              <action type="control focus" value="parent.#grdPredlosciLinije">
                <parameter value="parent.$KUPOdobriPredlozakId" />
              </action>
            </action>
            <!--<action type="control populate" value="parent.#grdPredlosciLinije">
