<root version="1.0">
<!--
  *******************************************************************************************
  FORMA ZA BRISANJE DJELATNIKA IZ MANAGERA GO ZA ODABRANU GODINU
  *******************************************************************************************
 -->
	<form name="frmBrisanjeDjelatnika" caption ="Brisanje djelatnika iz Managera GO" width="500" height="150" fixedsize="true" saveformsize="false" >
		<event type="shown">
			<action type ="control value" value="#lblPitanje">
				<parameter value="Jeste li sigurni da želite obrisati djelatnika {parent.#grdMaster.@Djelatnik} za {parent.#grdMaster.@Godina}?"/>
			</action>
		</event>
		<layout>

			<!--omotač-->
			<group cols="1" rows="1" groupbordervisible="true" >
				<item col="1" row="1"  highlight="false">
					<labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
				</item>

			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnBrisi" caption="OBRIŠI" type="del">
					<event type="click">
						<!-- Okini storu -->

						<action type="datarun reader" value="~dtBrisanje"/>

						<action if="$indGreske==0">
							<action type="control populate keepfocus" value="parent.#grdMaster"/>
							<action type="form close"/>
						</action>
						<action type="control populate" value="parent.#grdIskoristenoZaGodinu" />
						<action type="control populate" value="parent.#grdIskoristenoUGodini" />
						<action type="control populate" value="parent.#grdMaster" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel" dock="right" >
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>

			<data command="spHRGodisnjiAllCP" name="dtBrisanje">
				<parameter name="@Action" value="Brisanje_djelatnika" type="string"/>				
				<parameter name="@HRGodisnjiId" value="$HRGodisnjiId"/>
				<!--<parameter name="@selectedids" value="$selectedids"/>-->
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>
</root>