<root>
<form name="frmKopiraj">
		<event type="init">
		
			<action type="datarun reader" value="~dtSutrasnjiDatum"/>
		</event>
		<event type="load">	
			<action type="control value" value="#datDatumIsporuke">
				<parameter value="~dtSutrasnjiDatum.@SutrasnjiDatum"/>
			</action>
		</event>


	<layout caption="Kopiraj">
		<group cols="1" rows="1">
			<item col="1" row="1" caption="Datum isporuke:" textposition="left">
				<dateedit name="datDatumIsporuke" datavalue="~dtSutrasnjiDatum.@SutrasnjiDatum" />
	        </item>
		</group>

	</layout>

	<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Kopiraj">
					 <event type="click">
					 	<action type="validate" />
                        <action type="datarun scalar" value="~dtKopiraj" >
							<parameter name="NoviId" />
						</action>
														<!-- <action type="message" value="~dtKopiraj.@ID" /> -->

						<action type="form open" value="frmIzmjena">
							<parameter name="GlavaId" value="$NoviId"/>
							<parameter name="IndKopirano" value="1" />
						</action>	
						
						<action type="variable value">
							<parameter name="global.GlavaIdKopirano" value="$NoviId" />
						</action>
                        <action type="form close"/>
						
							
                    </event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" >
					 <event type="click"> 
						 <action type="form close"/> 
					 </event> 
				</button>
			</buttons>
		</panelbuttons>

	<datalist>
		<data command="spSutrasnjiDatum" name="dtSutrasnjiDatum" />

		<data command="spProd_ProNarudzbeGla_Kopiraj" name="dtKopiraj">
					<parameter name="@ProNarudzbeGlaId" value="parent.#grdMaster.@ProNarudzbeGlaId" />
					<parameter name="@Datumisporuke" value="#datDatumIsporuke"/>				
					<parameter name="@OperateriId" value="@@operateriid" />
				</data>
	</datalist>
</form>
</root>