<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmZakljuci" caption="Zaključi nalog {parent.#grdKKvalGla.@BrojDok}" >
		<event type="init">
			<action type="datarun reader" value="~dtUnIzPopuni"/>
			
		</event>
		
		<event type="load">
			
			<action type="control populate" value="#grdRez" />
			
            <action type="control value" value="rdoS1" if="~dtUnIzPopuni.@KKvalStatusId==1">
                <parameter value="true"/>
            </action>
            <action type="control value" value="rdoS2" if="~dtUnIzPopuni.@KKvalStatusId==2">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoS3" if="~dtUnIzPopuni.@KKvalStatusId==3">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoS4" if="~dtUnIzPopuni.@KKvalStatusId==4">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoS5" if="~dtUnIzPopuni.@KKvalStatusId==5">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoS1" else="">
                <parameter value="true"/>
            </action>
			
			<action type="control value" value="rdoZ2" if="~dtUnIzPopuni.@statusid==2">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoZ3" if="~dtUnIzPopuni.@statusid==3">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoZ4" if="~dtUnIzPopuni.@statusid==4">
                <parameter value="true"/>
            </action>
			<action type="control value" value="rdoZ2" else="">
                <parameter value="true"/>
            </action>
        </event>
		
		<layout>
			<group rows="3" cols="1">
				<item row="1" col="1" >
					<grid name="grdRez" dataname="~dtRez" key="KKvalGlaId" multiselect="true"  master="true" savelayout="true"> <!-- bestfitmaxrowcount="" -->
						
						
						<fields inherited="true">
							<field name="ParametarKontrole" caption="Parametar" />
							<field name="Uzorak" caption="U" />
							<field name="Obavezan" visible="false" />
							<field name="TipPodatka" visible="false" />
							<field name="Tip" visible="false" />
							<field name="DecVal" visible="false" />
							<field name="BoolVal" visible="false" />
							<field name="StringVal" visible="false" />
							<field name="jmNaziv" visible="false" />
							<field name="datumuzorka" visible="false" />
							<field name="dodanakontrola" visible="false" />
							
							<field name="Rezultat"/>
							<field name="Napomena" caption="Napomena"/>
							<field name="Min" format="n4" />
							<field name="Max" format="n4" />
							<filed name="operater"/>
						</fields>
						<styles>
							<style name="fontcolor" value="#cc0000" if="#grdRez.@Rezultat&gt;#grdRez.@Max"/>
							<style name="fontcolor" value="#cc0000" if="#grdRez.@Rezultat&lt;#grdRez.@Min"/>
							<style name="fontcolor" value="#cc0000" if="#grdRez.@Rezultat==''"/>
							<style name="fontcolor" value="#cc0000" if="#grdRez.@Rezultat==null"/>
						</styles>
					</grid>
				</item>
				<group row="2" col="1" rows="1" cols="2" >
					<group row="1" col="1" rows="5" cols="1"  caption="Status">
						<item row="1" col="1">
							<radioedit name="rdoS1" caption="Zadovoljava - potpuno" value="true" groupindex="1" datavalue="~dtUnIzPopuni.@kkvalstatusid"/>
						</item>
						<item row="2" col="1">
							<radioedit name="rdoS2" caption="Zadovoljava - nepotpuno" groupindex="1" datavalue="~dtUnIzPopuni.@kkvalstatusid"/>
						</item>
						<item row="3" col="1">
							<radioedit name="rdoS3" caption="Kontrola nije izvršena" groupindex="1" datavalue="~dtUnIzPopuni.@kkvalstatusid"/>
						</item>
						<item row="4" col="1" >
							<radioedit name="rdoS4" caption="Ne zadovoljava" groupindex="1" datavalue="~dtUnIzPopuni.@kkvalstatusid"/>
						</item>
						<item row="5" col="1">
							<radioedit name="rdoS5" caption="Promiješati ponovo" groupindex="1" datavalue="~dtUnIzPopuni.@kkvalstatusid"/>
						</item>
					</group>
					
					<group row="1" col="2" rows="5" cols="1"  caption="Zaključak">
						<item row="1" col="1">
							<radioedit name="rdoZ2" caption="Zadovoljava" value="true" groupindex="2" datavalue="~dtUnIzPopuni.@statusid"/>
						</item>
						<item row="2" col="1">
							<radioedit name="rdoZ3" caption="Djelomično zadovoljava" groupindex="2" datavalue="~dtUnIzPopuni.@statusid"/>
						</item>
						<item row="3" col="1">
							<radioedit name="rdoZ4" caption="Ne zadovoljava" groupindex="2" datavalue="~dtUnIzPopuni.@statusid"/>
						</item>
					</group>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnZakljuci" caption="Zaključi">
				
					<event type="click">
						<action type="datarun nonquery" value="~dtZakljuci"/>
						<action type="control populate keepfocus" value="parent.#grdKKvalGla"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtRez" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="detalji"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
			</data>
			<data name="dtUnIzPopuni" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="popuni"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
			</data>
			<data name="dtZakljuci" command="spCarpoKKvalGlaAzur">
			<parameter name="@Action" value="zakljuci"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
				<parameter name="@KKvalStatusId" value="1" if="#rdoS1==true"/>
				<parameter name="@KKvalStatusId" value="2" if="#rdoS2==true"/>
				<parameter name="@KKvalStatusId" value="3" if="#rdoS3==true"/>
				<parameter name="@KKvalStatusId" value="4" if="#rdoS4==true"/>
				<parameter name="@KKvalStatusId" value="5" if="#rdoS5==true"/>
				<parameter name="@Status" value="2" if="#rdoZ2==true"/>
				<parameter name="@Status" value="3" if="#rdoZ3==true"/>
				<parameter name="@Status" value="4" if="#rdoZ4==true"/>
				<parameter name="@Osobeid" value="@@operateriid"/>
			</data>
		</datalist>
	</form>
</root>