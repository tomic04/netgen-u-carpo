<root>
	<form name="frmDefault" caption="Određivanje defaultnog Jupiter Software objekta">
		<event type="oninit">
		</event>
		<event type="shown">
		</event>
		<layout>
			<group rows="1" cols="2">
				<item col="1" row="1" caption="JS Objekti:" colspan="2">
					<grid name="grdObjekti" key="JupiterObjectId" savelayout="true" dataname="dtObjekti" bestfitonrefresh="true" autopopulate="true">
						<event type="doubleclick">
							<action type="form open" value="frmUpsert">
								<parameter name="JupiterObjectId" value="#grdObjekti.@JupiterObjectId" />
								<parameter name="Caption" value="Izmjena JS Objekta" />
							</action>
							<action type="control populate keepfocus" value="#grdObjekti" />
						</event>
						<event type="cellvaluechanged">
							<action type="datarun nonquery" value="~dtPromjenaDefault0" />
							<action type="datarun nonquery" value="~dtPromjenaDefault1" />
							<action type="control populate keepfocus" value="#grdObjekti" />
							<action type="control populate" value="parent.#grdMaster" />
						</event>
						<fields>
							<field name="Checked" caption="Default" editable="true" edittype="bit" />
							<field name="Naziv" />
							<field name="Parametar" />
							<field name="Ikona" />
							<field name="NivoSlozenosti" caption="Nivo složenosti"/>
							<field name="Opis" />
							<field name="Roba" />
							<field name="OpisKom" caption="Komercijalni opis" />
							<field name="Cijena" />
							<field name="Status" caption="Status" />
						</fields>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIzlaz" caption="IZLAZ" type="cancel" dock="right">
					<event type="click">
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spJSObjektiQuery" name="dtObjekti">
				<parameter name="@action" value="6" />
				<parameter name="@RobaId" value="$RobaId" />
			</data>
			<data command="spJSObjektiAzur" name="dtPromjenaDefault1">
				<parameter name="@action" value="9" />
				<parameter name="@JupiterObjectId" value="#grdObjekti.@JupiterObjectId" />
			</data>
			<data command="spJSObjektiAzur" name="dtPromjenaDefault0">
				<parameter name="@action" value="10" />
				<parameter name="@RobaId" value="$RobaId" />
			</data>
		</datalist>
	</form>
	<form name="frmUpsert" path="JSObjektiOdobravanje.frmUpsert.xml" />
</root>
