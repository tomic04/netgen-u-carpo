<root>
	<form name="frmFilter" caption="Filter">
		<event type="init">
			<action type="datarun reader" value="~dtDatum" if="global.$Init==0"/>
			<action type="variable value" value="global.$Datum" if="global.$Init==0">
				<parameter value="~dtDatum.@Datum"/>
			</action>
			<action type="variable value" value="global.$Init">
				<parameter value="1"/>
			</action>
		</event>
		<event type="load">
			<action type="control value" value="#datDatum">
				<parameter value="global.$Datum"/>
			</action>
		</event>
		<layout>
			<group rows="1" cols="1">
				<item row="1" col="1" caption="Datum:">
					<dateedit name="datDatum"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPotvrdi" caption="Potvrdi">
					<event type="click">
						<action type="variable value" value="global.$Datum">
							<parameter value="#datDatum"/>
						</action>
						<action type="form close"/>
						<action type="form open" value="frmUgovorAzur" if="global.$FormOpen==0"/>
						<action type="control populate" value="parent.#grdUgovorAzur" if="global.$FormOpen==1"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtDatum" command="SELECT DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0) AS Datum" type="text"/>
		</datalist>
	</form>
</root>