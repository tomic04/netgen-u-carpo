<root>
    <form name="frmStavke" caption="Stavke" fixedsize="false" width="800" height="570">
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols ="2" rows="2" groupbordervisible="False">
                    <columnsdefinition>
                        <column size="80%" position="1" />
                        <column size="20%" position="2" />
                    </columnsdefinition>
                    <item caption="Klasifikacija:" row="1" col="1" >
                        <combotreeedit name="cmbKlasaRobe" valuefield="KlMasterRobaId" displayfield="Naziv" dataname="Global.dtCmbKlasaRobe" />
                    </item>
                    <item row="1" col="2" textvisible="True">
                        <button caption="Izvrši">
                            <event type="click">
								<action type="validate" />
								<action type="datarun nonquery" value="~dtDetMulti" />
                                <action type="control populate" value="#grdStavke" />
                            </event>
                        </button>
                    </item>
                    <item row="2" col="1" colspan="2">
                        <grid name="grdStavke" async="true" dataname="dtDetMulti" multiselect="true" key="robaid">
                            <fields>
                                <field name="Sifra" caption="Šifra" />
                                <field name="Naziv" caption="Naziv" />
                                <field name="Kolicina" caption="Količina" editable="true" formatstring="n3"/>
								<field name="JM" caption="JM" />
<!-- 								<field name="NetoCijenaKn" caption="Cijena (kn)" />
								<field name="NetoCijenaBod" caption="Cijena (bod)" /> -->
								<field name="VPStanje" caption="VP stanje" />
								<field name="Klasa" caption="Klasa robe" />
                            </fields>
				 			<styles>								
								<style name="bold" if="#grdStavke.@Kolicina&gt;0" />
							</styles>					  
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="DONESI" type="add" dock="right">
                    <event type="click">
                        <action type="control foreachrow " value="#grdStavke">
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="RobaId" value="#grdStavke.@robaid" />
							</action>							
							<action type="datarun reader" value="Global.dtRobaCijena" if="#grdStavke.@Kolicina&gt;0"/>
							<action type="datarun reader" value="~dtKolPak" if="#grdStavke.@Kolicina&gt;0"/>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat" value="~dtRobaCijena.@Rabat" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat1" value="~dtRobaCijena.@Rabat1" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat2" value="~dtRobaCijena.@Rabat2" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat3" value="~dtRobaCijena.@Rabat3" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat4" value="~dtRobaCijena.@Rabat4" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Rabat5" value="~dtRobaCijena.@Rabat5" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Cassa" value="~dtRobaCijena.@Cassa" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="NaknadaNZ" value="~dtRobaCijena.@NaknadaNZ" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="NaknadaPO" value="~dtRobaCijena.@NaknadaPO" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="NaknadaTR" value="~dtRobaCijena.@NaknadaTR" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="Odgoda" value="~dtRobaCijena.@Odgoda" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="NabCijena" value="~dtRobaCijena.@CijenaNabavna" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="BruttoCijenaKn" value="~dtRobaCijena.@BruttoCijenaKn" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="NettoCijenaBod" value="~dtRobaCijena.@NettoCijenaBod" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="BruttoCijenaBod" value="~dtRobaCijena.@BruttoCijenaBod" />
							</action>							
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="KupUgovoriDetId" value="~dtRobaCijena.@KupUgovoriDetId" />
							</action>							
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="PakKolicina" value="~dtKolPak.@PakKolicina" />
							</action>	
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="VrCjenikId" value="~dtRobaCijena.@VrCjenikId" />
							</action>
							<action type="variable value" if="#grdStavke.@Kolicina&gt;0">
								<parameter name="CijenaNeto" value="~dtRobaCijena.@Cijena" />
							</action>					
                            <action type="datarun nonquery" value="~dtStavkaUnos" if="#grdStavke.@Kolicina&gt;0"></action>
                        </action>
                        <action type="control populate" value="parent.#grdRoba" />
                        <action type="form close"></action>
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_PonDet_Multi" name="dtDetMulti">
                <parameter name="@KlMasterRobaId" value="#cmbKlasaRobe" />
                <parameter name="@SkladisteId" value="$SkladisteId" />
				<parameter name="@ProPonglaId" value="$ProPonGlaId" />
            </data>
            <data command="select case when @PakJMId is null then 0 else case when @Faktor = 0 then @Kolicina else @Kolicina / @Faktor end end as PakKolicina" type="text" name="dtKolPak">
                <parameter name="@Kolicina" value="#grdStavke.@Kolicina" />
                <parameter name="@Faktor" value="#grdStavke.@faktor" />
				<parameter name="@PakJMId" value="#grdStavke.@jm2id" />
            </data>			
            <data command="spProd_PonDet_Unos" name="dtStavkaUnos">
                <parameter name="@ProPonGlaId" value="$ProPonGlaId" />
                <parameter name="@RobaId" value="#grdStavke.@RobaId" />
                <parameter name="@Opcija" type="int" value="0" />
                <parameter name="@Kolicina" value="#grdStavke.@Kolicina" />
                <parameter name="@NettoCijenaKn" value="$CijenaNeto" />
				<parameter name="@Porez" value="#grdStavke.@Stopa" />
				<parameter name="@VrCjenikId" value="$VrCjenikId" />
				<parameter name="@PakKolicina" value="$PakKolicina"/>
				<parameter name="@PakJMId" value="#grdStavke.@jm2id" type="int"/>
				<parameter name="@PakFaktor" value="#grdStavke.@faktor" type="decimal" if="#grdStavke.@jm2id!=null"/>
				<parameter name="@PakFaktor" value="1" type="decimal" else=""/>
				<parameter name="@PakFaktorFix" value="#grdStavke.@pakfaktorfix" type="int"/>  				
				<parameter name="@RokPlacanja" value="$Odgoda" />
 				<parameter name="@Rabat1" value="$Rabat1"/>
				<parameter name="@Rabat2" value="$Rabat2"/>
				<parameter name="@Rabat3" value="$Rabat3"/>
				<parameter name="@Rabat4" value="$Rabat4"/>
				<parameter name="@Rabat5" value="$Rabat5"/>					
                <parameter name="@Rabat" value="$Rabat" />
                <parameter name="@Cassa" value="$Cassa" />
                <parameter name="@NabCijena" value="$NabCijena" />				
 				<parameter name="@NaknadaTR" value="$NaknadaTR" type="decimal"/>
				<parameter name="@NaknadaPO" value="$NaknadaPO" type="decimal"/>
				<parameter name="@NaknadaNZ" value="$NaknadaNZ" type="decimal"/>				
                <parameter name="@BruttoCijenaKn" value="$BruttoCijenaKn" />                
				<parameter name="@KupUgovoriDetId" value="$KupUgovoriDetId" type="int"/>	
				<parameter name="@BruttoCijenaBod" value="$BruttoCijenaBod" />
				<parameter name="@NettoCijenaBod" value="$NettoCijenaBod" />
            </data>
        </datalist>
    </form>
</root>