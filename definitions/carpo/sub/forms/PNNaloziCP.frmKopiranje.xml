<root>
	<!--
  *******************************************************************************************
  FORMA ZA KOPRIANJE NALOGA
  *******************************************************************************************
  -->
	<form name="frmKopiraj" caption="$caption" width="500" height="300">
		<event type="init">
			<action type="datarun reader" value="~dtInitKopiranje"/>						
		</event>
		<event type="load">
			<action type="control populate" value="#grdKadrovi" />					
		</event>		
		<layout>
			<group cols="2" rows="6" groupbordervisible="false" >
				<columnsdefinition>
						<column position="1" size="80%"/>
						<column position="2" size="20%"/>
					</columnsdefinition> 
				<item row="1" col="1" caption="Djelatnik:" highlight="false" >
					<searchedit name="srcDjelatnik" dataname="~dtDjelatnik" fieldtext="radnik" fieldvalue="hrkadroviid">
						
					</searchedit>
					
				</item>
				<item row="1" col="2" highlight="false" >
					<button name="btnDodajKadra" caption="Dodaj">
						<event type="click">
							<action type="datarun reader" value="~dtKadarDodaj">
								<action if="$indGreske==0">
									<action type="control value" value="#srcDjelatnik">
										<parameter text="" value=""/>
									</action>
									<action type="control populate" value="#grdKadrovi">
									</action>
									<action type="control focus" value="#srcDjelatnik">
									</action>
								</action>
								<action if="$indGreske==1">
								</action>
							</action>
						</event>
					</button>
					
				</item>
				<item row="2" col="1" highlight="false" textposition="top" rowspan="5" colspan="2">
					<grid name="grdKadrovi" caption="Odabrani djelatnici" key="HRKadroviId"  dataname="~dtKadrovi" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" netgenfields="true" multiselect="true"/>
				</item>				
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Kopiraj">
					<event type="click">
						<action type="datarun reader" value="~dtKopiraj">
							<action if="$indGreske==0">
								 <action type="form close"/> 
							</action>
							<action if="$indGreske==1">
							</action>
						</action>
					</event>
				</button>
				<button name="btnBrisanje" caption="Obriši">
					<event type="click">
						<action type="datarun reader" value="~dtKadarBrisi">
							<action if="$indGreske==0">
								 <action type="form close"/> 
							</action>
							<action if="$indGreske==1">
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPNHelp" name="dtDjelatnik">
				<parameter name="@action" value="kadrovi_help"/>
				<parameter name="@pnnaloziid" value="$pnnaloziid"/>
				<parameter name="@operateriid" value="@@OperateriId"/>
				<parameter name="@tekst" value="#srcDjelatnik.text"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNHelp" name="dtKadrovi">
				<parameter name="@action" value="grid_kopiranje"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNHelp" name="dtKadarDodaj">
				<parameter name="@action" value="dodaj_kopiranje"/>
				<parameter name="@hrkadroviid" value="#srcDjelatnik"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNHelp" name="dtKadarBrisi">
				<parameter name="@action" value="brisi_kopiranje"/>
				<parameter name="@ids" value="#grdKadrovi.selectedids"/>
				<parameter name="@operateriid" value="@@OperaterId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNAzur" name="dtKopiraj">
				<parameter name="@action" value="kopiraj"/>
				<parameter name="@pnnaloziid" value="$pnnaloziid"/>
				<parameter name="@operateriid" value="@@OperateriId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNHelp" name="dtInitKopiranje">
				<parameter name="@action" value="init_kopiranje"/>
				<parameter name="@operateriid" value="@@OperateriId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
	

</root>