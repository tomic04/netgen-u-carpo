20.02.2023. MB dodala <event type="click">
-->
<root>
<form name="frmPovijest" caption="Povijest robe: {$RobaNaziv}" fixedsize="false" width="800" height="570">
	<event type="load">			
		<action type="variable value">
			<parameter name="SviKupci" value="0" type="int"/>
		</action>	
		<action type="variable value">
			<parameter name="IndSvi" value="0" type="int"/>
		</action>			
		<action type="control populate" value="#grdPovijest"></action>			
	</event>
	<event type="click">
		<action type="control populate" value="#grdPovijest"/>
	</event>    
	<layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid name="grdPovijest" dataname="dtPovijest" >
                            <fields>
                                <field name="Vrsta dokumenta" caption="Vrsta dokumenta" />
                                <field name="Datum" caption="Datum dokumenta" />
                                <field name="Broj" caption="Broj dokumenta" />
                                <field name="Kupac" caption="Kupac"/>
                                <field name="Količina" caption="Količina" />
                                <field name="Cijena" caption="Cijena" />
								<field name="Rabat %" caption="Rabat %" />
								<field name="Rabat" caption="Rabat" />
								<field name="Cassa %" caption="Cassa %" />
								<field name="Cassa" caption="Cassa" />
								<field name="Prodajna vrijednost" caption="Prodajna vrijednost" />
								<field name="Rok plaćanja" caption="Rok plaćanja" />								
                            </fields>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SVI KUPCI" dock="right">
                    <event type="click">
						<action type="variable value" if="$IndSvi==0">
							<parameter name="SviKupci" value="1" type="int"/>
						</action>
						<action type="variable value" if="$IndSvi==1">
							<parameter name="SviKupci" value="0" type="int"/>
						</action>	
						<action type="variable value" if="$SviKupci==1">
							<parameter name="IndSvi" value="1" type="int"/>
						</action>
						<action type="variable value" if="$SviKupci==0">
							<parameter name="IndSvi" value="0" type="int"/>
						</action>						
                     	<action type="control populate" value="#grdPovijest" />			
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spKomercijalaKartica_Ponude" name="dtPovijest">
				<parameter name="@PartneriId" type="int" value="$PartneriId" if="$SviKupci==0"/>
				<parameter name="@PartneriId" type="int" value="null" if="$SviKupci==1"/>
				<parameter name="@RobaId" type="int" value="$RobaId" />
				<parameter name="@VrstaPromId" type="int" value="Global.$VrstaPromId" />
			</data>	
	    </datalist>
    </form>
</root>