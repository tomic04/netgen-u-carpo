<root>
	<form name="frmIzmijeni" caption="{parent.#grdLicAzur.@Partner}">
		<event type="load">
			<action type="control value" value="#cmbSupportKorisnik">
				<parameter value="$SuppKorisnikId"/>
			</action>
			<action type="control value" value="#chkPrimijeni">
				<parameter value="$Primijeni"/>
			</action>
			<action type="control value" value="#memOpis">
				<parameter value="$Opis"/>
			</action>
			<action type="control disable" value="#chkPrimijeni" if="parent.#grdLicAzur.@VrijednostKlijenta==parent.#grdLicAzur.@NovaVrijednostKlijenta"/>
		</event>
		<layout>
			<group rows="2" cols="2">
				<item row="1" col="1" caption="Support korisnik:">
					<comboedit name="cmbSupportKorisnik" dataname="~dtSupportKorisnik" valuefield="SuppKorisnikId" displayfield="Naziv"/>
				</item>
				<item row="1" col="2">
					<checkedit name="chkPrimijeni" caption="Primijeni"/>
				</item>
				<item row="2" col="1" colspan="2" caption="Opis:">
					<memoedit name="memOpis"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="datarun nonquery" value="~dtSpremi"/>
						<action type="control populate" value="parent.#grdLicAzurDet, parent.#grdLicAzur"/>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSpremi" command="spSuppIzracunLicAzurCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@SuppKorisnikId" value="#cmbSupportKorisnik"/>
				<parameter name="@Opis" value="#memOpis"/>
				<parameter name="@BrojJSCALs" value="parent.#grdLicAzur.@BrojJSCALs"/>
				<parameter name="@BrojOstCALs" value="parent.#grdLicAzur.@BrojOstCALs"/>
				<parameter name="@VrstaOstCALs" value="parent.#grdLicAzur.@VrstaOstCALs"/>
				<parameter name="@VrijednostLic" value="parent.#grdLicAzur.@VrijednostLic"/>
				<parameter name="@Popust" value="parent.#grdLicAzur.@Rabat"/>
				<parameter name="@OstaliCALs" value="parent.#grdLicAzur.@OstaliCALs"/>
				<parameter name="@FakDetaljId" value="parent.#grdLicAzur.@FakDetaljId"/>
				<parameter name="@FakDatumDok" value="parent.#grdLicAzur.@Datum"/>
				<parameter name="@ChangedVrKlijenta" value="#chkPrimijeni"/>
				<parameter name="@Kolicina" value="parent.#grdLicAzur.@KolicinaAlt"/>
				<parameter name="@suppLicVrstaId" value="parent.#grdLicAzur.@suppLicVrstaId"/>
				<parameter name="@OperaterId" value="@@operateriid"/>
			</data>
			<data name="dtSupportKorisnik" command="spSuppIzracunLicQueryCarpo">
				<parameter name="@Action" value="0"/>
				<parameter name="@PartneriId" value="parent.#grdLicAzur.@PartneriId"/>
			</data>
		</datalist>
	</form>
</root>