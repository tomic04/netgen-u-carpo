<root>
<form name="frmRoba" caption="Stavka inventure" height="400">
		<event type="oninit">
			<action type="datarun reader" value="" /><!--TODO dataset za punjenje-->
		</event>
		<layout textposition="left" itemspadding="3" >
			<group cols="1" rows="1" >
				<group cols="1" rows="7" >
					<item row="1" col="1" textvisible="False" fontsizedelta="1" caption="Roba:">
					<searchedit name="txtRoba" type="roba" fontsizedelta="1" fontbold="True" entermovenextcontrol="False" datavalue="~dtDetquery.@RobaId" datatext="~dtDetquery.@RobaNaziv" fieldtext="Naziv" fieldvalue="RobaId">
					  <event type="valuechanged" raiseonload="False">			
<!--						<action type="control caption" value="#txtKolicina">
						  <parameter if="#txtRoba!=null" value="Količina ({#txtRoba.@JMNaziv}):" />
						  <parameter else="" value="Količina:" />
						</action>-->
						<action type="control focus" value="#txtKolicina" />
					  </event>
					</searchedit>
					</item>				
					<group cols="4" rows="1" col="1" row="2" groupbordervisible="False">
					<columnsdefinition>
						<column size="50%" position="1" />
						<column size="30" position="2" />
						<column size="50%" position="3" />
						<column size="30" position="4" />
					</columnsdefinition>
						<item caption="Količina" textposition="top" row="1" col="1">
						<textedit name="txtKolicina" value="0" format="n2" fontsizedelta="1" fontbold="True" datavalue="~dtDetquery.@Kolicina">
						  <event type="valuechanged"  raiseonload="False">
						  </event>
						</textedit>
						</item>
						<item row="1" col="2" caption="kom" textposition="left" padding="0,0,15,0">
							
						</item>
						<item row="1" col="3"  caption="Zatečeno" textposition="top" padding="0,0,4,0">
							<textedit name="txtZateceno" fontsizedelta="1"  format="n2" value="0" fontbold="True" enabled="false"/><!--TODO provjeri padding da se izravna, stavi label-->
						</item>
						<item row="1" col="4" padding="0,0,15,0" caption="kom" textposition="left"  >
						</item>
					</group>
					<item row="3" col="1"  caption="Kontingent:">
						<textedit name="txtKontingent"   />
					</item>
					<item row="4" col="1"  caption="Cjena:">
						<textedit name="txtCijena" value="0" format="n2" />
					</item>
					<item row="5" col="1" caption="Datum:">
						<dateedit name="datDatum" required="True" datavalue="Global.~dtGetGlava.@DatumPopisa" />
					</item>
					<item row="6" col="1"  caption="Ser. broj:" textposition="left" >
							<textedit name="txtSerBroj" fontsizedelta="1"  />
					</item>
					<item row="7" col="1"   textposition="left" >
							<memoedit name="memSerBroj" fontsizedelta="1"  />
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="Spremi"  dock="right">
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
				</button>
<!--				<button name="btnHelp" caption="Uputi me" dock="right" >
				</button>-->
			</buttons>
		</panelbuttons>
	</form>
</root>