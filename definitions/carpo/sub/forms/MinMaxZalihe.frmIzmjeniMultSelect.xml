<?xml version="1.0" encoding="utf-8"?> 
<root>
	<form name="frmIzmjeniMultSelect" caption="Izmjena" width="250" height="150">		
		<layout >
				<group cols="2" rows="1">
					<item col="1" row="1" caption="Min. zaliha:" >
						<textedit name="txtMin" format="f0">
						</textedit>
					</item>
					<item col="2" row="1" caption="Max. zaliha:" >
						<textedit name="txtMax" format="f0">
						</textedit>
					</item> 
				</group> 
		</layout>
		<panelbuttons>	
			<buttons>
				<button name="Spremi" caption="Spremi" type="add" dock="left">
					<event type="click">
						<action if="#txtMin&lt;0">
							<action type="message" value="Nije dozvoljen unos minimalne zalihe s minus predznakom"/>
						</action>
						<action elseif="#txtMax&lt;0">
							<action type="message" value="Nije dozvoljen unos maksimalne zalihe s minus predznakom"/>
						</action>
						<action else="">
							<action type="datarun nonquery" value="~dtMinMaxZaliheUpdateMulti"/>
							<action type="form close"/>
						</action>	
					</event>
				</button>
				<button name="Odustani" caption="Odustani" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>		
			</buttons>
		</panelbuttons>
		<datalist>
 			<data command="spSktMinMaxZalihaUpdateMulti" name="dtMinMaxZaliheUpdateMulti">
				<parameter name="@Robaid" value="$multi"></parameter>
				<parameter name="@kolicinaMin" value="#txtMin"></parameter>
				<parameter name="@kolicinaMax" value="#txtMax"></parameter>
				<parameter name="skladisteId" value="$skladiste"></parameter>
				<parameter name="@operateriId" value="@@operateriId"></parameter>
			</data> 
			<data command="" name="dtPopuniPolja">
			</data>
		</datalist>
	</form>
</root>