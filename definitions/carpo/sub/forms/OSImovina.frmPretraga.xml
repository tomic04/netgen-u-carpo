<root version="1.0">

  <!--******************************************IMOVINA - PRETRAGA****************************************-->
  <form name="frmPretraga" caption="$Caption" fixedsize="false" width="700" height="500" saveformlayout="true" >
    
    <event type="oninit">
      <!--<action type="variable value">
        <parameter name="$Imovina" value="''" />
      </action>-->
    </event>
    <event type="onload">

    </event>
    
    <layout textposition="left" >
      <group cols="1" rows="2" groupbordervisible="false" >
       
        <group cols="6" rows="2" col="1" row="1" spacing="2,2,2,1">
          <item caption="Traži:" row="1" col="1" highlight="false" colspan="5" >
            <textedit name="txtNaziv" textposition="left" required="true">
              <event type="keydown" value="13">
                <action type="validate" />
                <action type="datarun reader" value="~dtRezultatiPretrage"/>
                <action type="control populate" value="#grdRezultatiPretrage">
                  <parameter value="#txtNaziv.@Tekst"/>
                </action>
              </event>
            </textedit>
          </item>
          <item row="1" col="6" >
            <button name="btnTrazi"  caption="Traži" >
              <event type="click">
                <action type="validate" />
                <action type="datarun reader" value="~dtRezultatiPretrage"/>
                <action type="control populate" value="#grdRezultatiPretrage">
                  <parameter value="#txtNaziv.@Tekst"/>
                </action>
              </event>
            </button>
          </item>
          <item row="2" col="2" highlight="false">
            <radioedit name="rdo1" caption="Sadrži traženi pojam" value="true" colspan="2"/>
          </item>
          <item row="2" col="4" highlight="false">
            <radioedit name="rdo2" caption="Počinje traženim pojmom" colspan="2"/>
          </item>
        </group>       
        <item caption="" row="2" col="1" highlight="false" spacing="2,2,1,2">
          <grid name="grdRezultatiPretrage" key="OSImovinaId" dataname="dtRezultatiPretrage" fieldsmartspaces="false" bestfitonrefresh="true">
            <event type="doubleclick">
                <action type="control focus" value="parent.#tree"  waittype="progress" waitcaption="Pričekajte..." waittext="..traženje u tijeku...">
                  <parameter value="#grdRezultatiPretrage.@OSGrupeId" type="int" if="global.$filter==Grupe"/>
                  <parameter value="#grdRezultatiPretrage.@OSStatusiId" type="int" elseif="global.$filter==Statusi"/>
                  <parameter value="#grdRezultatiPretrage.@OSVrsteId" type="int" elseif="global.$filter==Vrste"/>
                  <parameter value="#grdRezultatiPretrage.@OSKlaseId" type="int" elseif="global.$filter==Klase"/>
                  <parameter value="#grdRezultatiPretrage.@OrgShemaId" type="int" elseif="global.$filter==Organizacijske jedinice"/>
                </action>
                <action type="control focus" value="parent.#grdImovina">
                  <parameter value="#grdRezultatiPretrage.@OSImovinaId" type="int"/>
                </action>
              <!--</action>-->
              <action type="form close" />
            </event>
          </grid>
        </item>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>        
        <button caption="Odustani" type="cancel" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOSImovina_PretragaCP" name="dtRezultatiPretrage">
        <parameter name="@Action" value="Pretraga"/>
        <parameter name="@TipPretrage" value="Pocinje" if="#rdo2==true"/>
        <parameter name="@TipPretrage" value="Sadrzi" else=""/>
        <parameter name="@Tekst" value="#txtNaziv.@Tekst" />
      </data>
    </datalist>
  </form>
  <!--*******************************************KRAJ IMOVINA - PRETRAGA**************************************************-->
</root>