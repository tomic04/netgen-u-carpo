<root>
  <form name="frmObustavaEdit"  caption="$caption" width="700" fixedsize="true" saveformsize="false"  >

    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$OOPObustaveGlaId!=0"/>
    </event>

    <layout>
      <group rows="5" cols="1" groupbordervisible="false" spacing="2">
          <item caption="Partner:" col="1" row="1" textposition="left" highlight="false">
            <searchedit name="srcPartner" fieldvalue="PartneriId" fieldtext="Naziv" dataname="~dtPartneri" required="true" tooltip="Tražilica partnera. Nakon unesenog pojma stisnite ENTER." datatext="~dtGet.@PartnerText" datavalue="~dtget.@PartneriId">
            </searchedit>
          </item>
          <item caption="Naziv:" col="1" row="2" textposition="left" highlight="false">
            <textedit name="txtNaziv" required="true" datavalue="~dtGet.@Naziv"/>
          </item>
          <item caption="Opis:" col="1" row="3" textposition="left" highlight="false">
            <textedit name="txtOpis" required="false" datavalue="~dtGet.@Opis"/>
          </item>
          <item caption="Vrsta:" col="1"  row="4" textposition="left"  highlight="false" >
            <comboedit name="cmbVrste"  valuefield="OOPVrsteObustavaId" displayfield="Naziv" dataname="~dtVrste" required="false" allownull="true" datavalue="~dtGet.@OOPVrsteObustavaId" >
          </comboedit>
          </item>
          <item col="1" row="5" highlight="false" >
            <checkedit caption="Specifikacija" name="chkSpecifikacija" value="true" datavalue="~dtGet.@indSpecifikacija" />
          </item>
        </group>
    </layout>

    <!--gumbi-->

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <!--<action type="message" value="TEST!!:{$OOPObustaveGlaId}"/>-->

            <!--izmjena-->
            <action if="$OOPObustaveGlaId!=0">


              <!--<action type="message" value="IZMJENA!!!!"/>-->
              <action type="datarun reader" value="~dtEdit"/>

              <action if="~dtEdit.@IndGreske==1">
                <action type="message" value="~dtEdit.@poruka"/>
              </action>

              <action if="~dtEdit.@IndGreske==0">

                <action type="form close"/>

                <action type="control populate keepfocus" value="parent.#grdGla">
                  <parameter value="$OOPObustaveGlaId"/>
                </action>
              </action>
            </action>


            <!--<action type="message" value="$OOPObustaveGlaId"/>-->
            
            <!--unos-->
            <action if="$OOPObustaveGlaId==0">

              <!--<action type="message" value="UNOS!!!!"/>-->
              <action type="datarun reader" value="~dtUnos"/>
      

              <!--<action type="message" value="~dtUnos.@IndGreske"/>-->

              <action if="~dtUnos.@IndGreske==1">
                <action type="message" value="~dtUnos.@poruka"/>
              </action>

              <action if="~dtUnos.@IndGreske==0">
                <action type="variable value" value="$OOPObustaveGlaId">
                  <parameter value="~dtUnos.@OOPObustaveGlaId"/>
                </action>
                <action type="form close"/>

                <action type="control populate" value="parent.#grdGla"/>

                <action type="control focus" value="parent.#grdGla">
                  <parameter value="$OOPObustaveGlaId"/>
                </action>
              </action>
            </action>

           
            
            

          </event>
        </button>

        <button type="cancel" caption="Odustani"/>
      </buttons>

    </panelbuttons>

    <!--datalist-->

    <datalist>
      <data command="spOOPObustaveHelpCP" name="dtPartneri">
        <parameter name="@action"  value="trazi_partnera" />
        <parameter name="@tekst"  value="#srcPartner.text" />
      </data>
      <data command="spOOPObustaveHelpCP" name="dtVrste">
        <parameter name="@action"  value="cmb_vrste" />
      </data>

      <data command="spOOPObustaveHelpCP" name="dtGet">
        <parameter name="@action" value="dtGet_glave" type="string"/>
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId" type="int"/>
      </data>



      <data command="spOOPObustaveHelpCP" name="dtUnos">
        <parameter name="@action" value="unos_glave" type="string"/>
        <parameter name="@partneriid" value="#srcPartner" />
        <parameter name="@naziv" value="#txtNaziv" type="string"/>
        <parameter name="@opis" value="#txtOpis" type="string"/>
        <parameter name="@OOPVrsteObustavaId" value="#cmbVrste"/>
        <parameter name="@indSpecifikacija" value="#chkSpecifikacija"/>
        <parameter name="@operateriid" value="@@operateriid"/>
       
      </data>

      <data command="spOOPObustaveHelpCP" name="dtEdit">
        <parameter name="@action" value="izmjena_glave" type="string"/>
        <parameter name="@OOPObustaveGlaId" value="$OOPObustaveGlaId" type="int"/>
        <parameter name="@partneriid" value="#srcPartner" />
        <parameter name="@naziv" value="#txtNaziv" type="string"/>
        <parameter name="@opis" value="#txtOpis" type="string"/>
        <parameter name="@OOPVrsteObustavaId" value="#cmbVrste"/>
        <parameter name="@indSpecifikacija" value="#chkSpecifikacija"/>
        <parameter name="@operateriid" value="@@operateriid"/>

      </data>

    </datalist>
    
    
  </form>
</root>
