<root version="1.1">

	<form name="frmKarticaStrojaRucno" caption="$caption" height="700"  width="1000" fixedsize="true">
		<method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="global.$ZNRStrojeviId!=null"/>
			<action type="datarun reader" value="~dtZNRDMS" />
		</event>
		<event type="shown">
			<action type="control disable" value="#chkIndStroj" if="$tip==izmjena rucno" />
			<action type="control enable" value="#chkIndStroj" else="" />
			<action type="control disable" value="#btnPregled,#btnIspitivanja" if="$tip==unos rucno" />
			<action type="control enable" value="#btnPregled,#btnIspitivanja" else="" />
			<action type="control attribute" value="#picSlika"   if="global.$ZNRStrojeviId!=null">
				<parameter name="dbimg" value="~dtGet.@Slika" />
			</action>
			<action type="control visible" value="#menDokument,#menDokumentPregled" if="~dtZNRDMS.@Postavka==0">
				<parameter value="false"/>
			</action>
		</event>
		<layout textposition="left" autotaborder="false">
			<group cols="1" rows="1"   groupbordervisible="false" >
				<tabs col="1" row="1" spacing="2,2,1,2" >
					<group col="1" row="1" cols="3" rows="10" caption="Podaci o radnom stroju"  >
						<rowsdefinition>
							<row position ="1" size="5%" />
							<row position ="2" size="5%" />
							<row position ="3" size="5%" />
							<row position ="4" size="5%" />
							<row position ="5" size="5%" />
							<row position ="6" size="5%" />
							<row position ="7" size="5%" />
							<row position ="8" size="29%" />
							<row position ="9" size="29%" />
							<row position ="10" size="8%" />
						</rowsdefinition>
						<columnsdefinition>
							<column position ="1" size="20%" />
							<column position ="2" size="40%" />
							<column position ="3" size="40%" />
						</columnsdefinition>
						<item caption="" col="1" row="1" rowspan="5"  highlight="false" >
							<pictureedit name="picSlika" dbimg="" tabindex="1"/>
						</item>
						<item col="2" row="1" highligh="false" >
							<checkedit name="chkIndStroj" caption="unos radnog stroja"  datavalue="~dtGet.@IndStroj" value="1" tabindex="2">
								<event type="valuechanged">
									<action type="control disable" value="#cmbMjestoRada,#cmbPrikljucni,#btnPregled,#txtTvornickiBroj,#memTehnickiPodaci,#memNamjena" if="#chkIndStroj==false"/>
									<action type="control enable" value="#cmbMjestoRada,#cmbPrikljucni,#btnPregled,#txtTvornickiBroj,#memTehnickiPodaci,#memNamjena" else=""/>
								</event>
							</checkedit>
						</item>
						<item col="2" row="2" caption="Naziv:" highlight="false">
							<textedit name="txtNaziv" datavalue="~dtGet.@Naziv"  textposition="left" tabindex="3"/>
						</item>
						<item col="2" row="3" caption="Inventurni broj:" highligh="false" >
							<textedit name="txtInvBroj" datavalue="~dtGet.@InvBroj"  textposition="left" tabindex="4"/>
						</item>
						<item col="2" row="4" caption="Marka:" highligh="false" >
							<textedit name="txtMarka" datavalue="~dtGet.@Marka"  textposition="left" tabindex="5"/>
						</item>
						<item col="2" row="5" caption="Model/Tip:" highligh="false" >
							<textedit name="txtModel" datavalue="~dtGet.@Model"  textposition="left" tabindex="6"/>
						</item>
						<item col="3" row="1" caption="Napomena:" highligh="false" >
							<textedit name="txtNapomena" datavalue="~dtGet.@Napomena"  textposition="left" tabindex="7"/>
						</item>
						<item col="3" row="2" caption="Serijski broj:" highligh="false" >
							<textedit name="txtSerBroj" datavalue="~dtGet.@SerBroj"  textposition="left" tabindex="8"/>
						</item>
						<item col="3" row="3" caption="Mjesto troška:" highligh="false" >
							<comboedit name="cmbMjestoTroska" valuefield="OrgShemaId" displayfield="MjestoTroska" datavalue="~dtGet.@OrgshemaId"  dataname="~dtMjestoTroska" textposition="left" tabindex="9"/>
						</item>
						<item col="3" row="4" caption="Datum nabave:" highligh="false" >
							<dateedit name="datDatumNabave" datavalue="~dtGet.@DatumNabave" value="now" textposition="left" tabindex="10"/>
						</item>
						<item col="3" row="5" caption="Mjesto rada:" highligh="false" >
							<comboedit name="cmbMjestoRada" valuefield="ZNRMjestaRadaId" displayfield="MjestoRada" datavalue="~dtGet.@ZNRMjestaRadaId" dataname="~dtMjestoRada" tabindex="11"/>
						</item>
						<group col="1" row="6" cols="2" rows="1" groupbordervisible="false" colspan="3">
							<columnsdefinition>
								<column position ="1" size="80%" />
								<column position ="2" size="20%" />
							</columnsdefinition>
							<item col="1" row="1" caption="Priključni stroj:" highligh="false" >
								<combomultiedit name="cmbPrikljucni" valuefield="OSImovinaPrikljucniId" displayfield="PrikljucniNaziv" datavalue="~dtGet.@OSImovinaPrikljucniId" dataname="~dtOSImovinaPrikljucni" textposition="left" tabindex="12"/>
							</item>
							<item col="2" row="1" caption="" highligh="false">
								<button name="btnPregled" caption="Pregled priključnih strojeva" tabindex="13">
									<event type="click">
										<action type="form open" value="frmPrikljucniPregled" >
											<parameter name="tip" value="pregled" />
											<parameter name="caption" value="Pregled priključnih strojeva radnog stroja {global.$Naziv} (inv.broj:{global.$InvBroj})" />
										</action>
									</event>
								</button>
							</item>
						</group>
						<item col="1" row="7" caption="Tvornički broj:" highligh="false" colspan="3" >
							<textedit name="txtTvornickiBroj" datavalue="~dtGet.@TvornickiBroj"  textposition="left" tabindex="14"/>
						</item>
						<item col="1" row="8" caption="Tehnički podaci:" highligh="false" colspan="3" >
							<memoedit name="memTehnickiPodaci" datavalue="~dtGet.@TehnickiPodaci"  textposition="left" tabindex="15"/>
						</item>
						<item col="1" row="9" caption="Namjena:" highligh="false" colspan="3" >
							<memoedit name="memNamjena" datavalue="~dtGet.@Namjena"  textposition="left" tabindex="16"/>
						</item>
						<group col="1" row="10" cols="3" rows="1" groupbordervisible="false">
							<item caption="" col="1" row="1"  colspan="2" highlight="false">
								<button name="btnSpremi" caption="Spremi" type="add" tabindex="17">
									<event type="click">
										<action type="validate" />
										<action type="datarun reader" value="~dtIzmjenaR" if="global.$ZNRStrojeviId!=null"/>
										<action type="datarun reader" value="~dtUnosR" else="" >
											<action type="variable value">
												<parameter name="parent.$Fokus" value="~dtUnos.@Fokus" type="int"/>
											</action>
										</action>
										<action type="form close" />
									</event>
								</button>
							</item>
						</group>
						<group col="3" row="10" cols="3" rows="1" groupbordervisible="false">
							<item caption="" col="1" row="1"   highlight="false" />
							<item caption="" col="2" row="1"   highlight="false" />
							<item caption="" col="3" row="1"  highlight="false">
								<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" tabindex="18"/>
							</item>
						</group>
					</group>
					<group col="1" row="1" cols="5" rows="2" caption="Ispitivanja radnog stroja" groupbordervisible="false">
						<rowsdefinition>
							<row position ="1" size="93%" />
							<row position ="2" size="7%" />
						</rowsdefinition>
						<item col="1" row="1" highlight="false" colspan="5">
							<grid name="grdIspitivanja" autopopulate="true" key="ZNRStrojeviPrometId" dataname="dtIspitivanja" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
								<fields inherited="true">
									<field name="BrojZapisnika" caption="Broj zapisnika" editable="true" />
									<field name="Ocjena" caption="Ocjena" editable="true" />
									<field name="Nedostatak" caption="Opis nedostatka" editable="true" />
								</fields>
								<event type="cellvaluechanged">
									<action type="datarun nonquery" value="~dtUpdateEdit" />
									<action type="control populate keepfocus" value="#grdIspitivanja" />
								</event>
								<menu>
									<menuitem caption="Izmijeni datume" name="menIzmijeni" sort="1">
										<event type="click">
											<action type="form open" value="frmKreirajIspitivanje" >
												<parameter name="ZNRStrojeviPrometId" value="#grdIspitivanja.@ZNRStrojeviPrometId"/>
												<parameter name="caption" value="Izmjena datuma ispitivanja radnog stroja {global.$Naziv} (inv.broj:{global.$InvBroj})" />
												<parameter name="tip" value="izmjena"/>
											</action>
											<action type="control populate" value="#grdIspitivanja" />
										</event>
									</menuitem>
									<menuitem caption="Obriši" function="menObrisi" sort="2">
										<event type="click">
											<action type="confirm" value="Da li ste sigurni da želite obrisati označeno ispitivanje radnog stroja {global.$Naziv} (inv.broj:{global.$InvBroj})?">
												<action type="datarun nonquery"   value="~dtDeleteIspit"/>
												<action type="control populate" value="#grdIspitivanja"/>
											</action>
										</event>
									</menuitem>
									<menuitem type="separator"/>
									<menuitem caption="Priloži dokument" name="menDokument" sort="3">
										<event type="click">
											<action type="method run" value="funDmsAdd">
												<parameter name="server" value="@@server" />
												<parameter name="database" value="@@database" />
												<parameter name="username" value="" />
												<parameter name="password" value="" />
												<parameter name="operaterid" value="@@operateriid"/>
												<parameter name="entityName" value="ZNRStrojevi" />
												<parameter name="entityId" value="global.$ZNRStrojeviId" />
											</action>
										</event>
									</menuitem>
									<menuitem caption="Pregled dokumenata" name="menDokumentPregled" sort="4">
										<event type="click">
											<action type="form open" value="frmDokumentiPregled">
												<parameter name="ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
												<parameter name="caption" value="Pregled dokumenata radnog stroja {global.$Naziv} (inv.broj:{global.$InvBroj})"/>
												<parameter name="tip" value="strojevi"/>
												<parameter name="EntityName" value="ZNRStrojevi"/>
											</action>
										</event>
									</menuitem>
								</menu>
							</grid>
						</item>
						<item col="1" row="2" highlight="false" >
							<button name="btnIspitivanja"  caption="Unesi ispitivanje" >
								<event type="click">
									<action type="form open" value="frmKreirajIspitivanje">
										<parameter name="caption" value="Unos ispitivanja za radni stroj {global.$Naziv} (inv.broj:{global.$InvBroj})"/>
										<parameter name="tip" value="unos"/>
									</action>
									<action if="dialogresult!=cancel">
										<action type="control populate " value="#grdIspitivanja" >
											<action type="control focus" value="#grdIspitivanja">
												<parameter value="$Fokus"/>
											</action>
										</action>
									</action>
								</event>
							</button>
						</item>
					</group>
				</tabs>
			</group>
		</layout>
		<datalist>
			<data command="spZNRStrojevi_Query" name="dtZNRDMS">
				<parameter name="@Action" value="DMS_dohvati"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtGet">
				<parameter name="@Action" value="Dohvati_podaciRucno" />
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtMjestoRada">
				<parameter name="@Action" value="Cmb_MjestoRada" />
			</data>
			<data command="spZNRStrojevi_Query" name="dtMjestoTroska">
				<parameter name="@Action" value="Cmb_MjestoTroska" />
			</data>
			<data command="spZNRStrojevi_Query" name="dtOSImovinaPrikljucni">
				<parameter name="@Action" value="Cmb_Prikljucni" />
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtPopuni">
				<parameter name="@Action" value="Popuni_unos" />
				<parameter name="@OSImovinaId" value="#srcOSImovina"/>
			</data>
			<data command="spZNRStrojevi_Query" name="dtIspitivanja">
				<parameter name="@Action" value="Ispitivanja_pregled" />
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtUpdateEdit">
				<parameter name="@Action" value="Update_Editabilno"/>
				<parameter name="@ZNRStrojeviPrometId" value="#grdIspitivanja.@ZNRStrojeviPrometId"/>
				<parameter name="@BrojZapisnika" value="#grdIspitivanja.@BrojZapisnika"/>
				<parameter name="@Ocjena" value="#grdIspitivanja.@Ocjena"/>
				<parameter name="@Nedostatak" value="#grdIspitivanja.@Nedostatak"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtUnosR">
				<parameter name="@Action" value="UnosRucno_spremi"/>
				<parameter name="@IndStroj" value="#chkIndStroj" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@InvBroj" value="#txtInvBroj" />
				<parameter name="@Marka" value="#txtMarka" />
				<parameter name="@ModelTip" value="#txtModelTip" />
				<parameter name="@Napomena" value="#txtNapomena" />
				<parameter name="@SerBroj" value="#txtSerBroj" />
				<parameter name="@OrgShemaId" value="#cmbMjestoTroska" />
				<parameter name="@DatumNabave" value="#datDatumNabave" />
				<parameter name="@TvornickiBroj" value="#txtTvornickiBroj" />
				<parameter name="@TehnickiPodaci" value="#memTehnickiPodaci" />
				<parameter name="@Namjena" value="#memNamjena" />
				<parameter name="@ZNRMjestaRadaId" value="#cmbMjestoRada"/>
				<parameter name="@SelectedPrikljucniIds" value="#cmbPrikljucni"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtIzmjenaR">
				<parameter name="@Action" value="IzmjenaRucno_spremi"/>
				<parameter name="@ZNRStrojeviId" value="global.$ZNRStrojeviId"/>
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@InvBroj" value="#txtInvBroj" />
				<parameter name="@Marka" value="#txtMarka" />
				<parameter name="@ModelTip" value="#txtModelTip" />
				<parameter name="@Napomena" value="#txtNapomena" />
				<parameter name="@SerBroj" value="#txtSerBroj" />
				<parameter name="@OrgShemaId" value="#cmbMjestoTroska" />
				<parameter name="@DatumNabave" value="#datDatumNabave" />
				<parameter name="@TvornickiBroj" value="#txtTvornickiBroj" />
				<parameter name="@TehnickiPodaci" value="#memTehnickiPodaci" />
				<parameter name="@Namjena" value="#memNamjena" />
				<parameter name="@ZNRMjestaRadaId" value="#cmbMjestoRada"/>
				<parameter name="@SelectedPrikljucniIds" value="#cmbPrikljucni"/>
			</data>
			<data command="spZNRStrojevi_Azur" name="dtDeleteIspit">
				<parameter name="@Action" value="Brisanje_ispitivanja" />
				<parameter name="ZNRStrojeviPrometId" value="#grdIspitivanja.@ZNRStrojeviPrometId"/>
			</data>
		</datalist>
	</form>
</root>

