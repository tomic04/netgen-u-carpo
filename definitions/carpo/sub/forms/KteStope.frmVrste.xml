<root>
	<form name="frmVrste" caption="Vrste kamatne stope" fixedsize="true" >
		<event type="init">
			<action type="datarun reader" value="~dtVGet" if="$SaljemId!=null"/>
		</event>
		<event type="shown">
			<action type="form caption" value="Unos vrste stope" if="$SaljemId==null"/>
			<action type="form caption" value="Izmjena vrste stope" else=""/>
		</event>
		<layout>
			<group cols="1" rows="2" bordervisible="false" >
				<item caption="Opis:" col="1" row="1">
					<textedit name="txtOpis" datavalue="~dtVGet.@Opis"/>
				</item>
				<item caption="Standardna stopa" col="1" row="2" highlight="false" width="25%">
					<checkedit name="ckInd" datavalue="~dtVGet.@Ind"/>
				</item> 		
		   </group>       
		</layout>
		<panelbuttons>
			<buttons>
				<button caption="&amp;SPREMI" dock="right">
					<event type="click">
						<!-- izmjena postojećeg -->
						<action type="datarun nonquery" value="~dtVStavkaAzur" if="$Action==1">
							<action type="form close"/>
						</action>
						<!-- unos novog -->
						<action type="datarun scalar" value="~dtVStavkaAzur" else="">
							<parameter name="NewId"/>
						</action>
						<action type="variable value" value="parent.$Id">
							<parameter value="$NewId"/>
						</action>
						<action type="control populate" value="parent.#trKamate"/>
						<action type="control focus" value="parent.#trKamate">
							<parameter value="#txtStopa"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button caption="&amp;ODUSTANI" type="cancel" dock="right"/>
		  </buttons>
		</panelbuttons>
		<datalist>
			<data command="spKteVrsteStopaQuery" name="dtVGet">
				<parameter name="@Action" value="1"/>
				<parameter name="@Id" value="$SaljemId"/>
			</data>
			<data command="spCKteVrsteStopaAzur" name="dtVStavkaAzur">
				<parameter name="@Action" value="$Action"/>
				<parameter name="@ID" value="$SaljemId" if="$Action==1"/>
				<parameter name="@ID" value="null" else=""/>
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@Ind" value="#ckInd"/>
			</data>
		</datalist>
	</form>
</root>