<root>
  
  <form name="frmOSImovinaDodatni_Brisanje" caption="$Caption" fixedsize="false" width="500" >

    <layout>
      <group cols="1" rows="1" groupbordervisible="false">
        <item caption="" col="1" row="1" >
          <labeledit name="lblBrisanje" value="Da li ste sigurni da želite obrisati označeni dodatni podatak?" fontbold="true"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnBrisi"  caption="Da" type="delete" >
          <event type="click">
            <action type="datarun nonquery" value="~dtBrisi"/>
            <action type="form close" />
            <action type="control refreshvalue" value="parent.#grdDodatni"/>
          </event>
        </button>
        <button caption="Ne" type="cancel" dock="right">
          <event type="click"/>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spOSImovinaDodatni_CP" name="dtBrisi">
        <parameter name="@Action" value="Brisanje"/>
        <parameter name="@OSImovinaDodPodaciId" value="$OSImovinaDodPodaciId"/>
        <parameter name="@OSImovinaId" value="$OSImovinaId"/>
      </data>
    </datalist>
    
  </form>
  
</root>