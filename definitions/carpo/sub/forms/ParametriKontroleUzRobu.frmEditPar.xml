<root>
	<form name="frmEditPar" caption="Postavke za parametar" >
		<event type="init">
		<!-- 	<action type="datarun reader" value="~dtPopuni"/> -->
			<action type="datarun reader" value="~dtPopuniIzmj" if="$KKvalLnParametarRobaId!=null"/>
			<!-- <action type="control populate" value="#cmbPar"/> -->
			<action type="datarun reader" value="~dtPar" />
		</event>
		<event type="load">
			<action type="control populate" value="#cmbPar"/>
			<action type="variable value">
				<parameter name="$kkvalParametriId" value="#cmbPar.@kkvalParametriId"/>
			</action>
			<action type="variable value">
				<parameter name="$tip" value="#cmbPar.@tip"/>
			</action>
			<action if="$tip==2">
			<!-- 	<action type="control value" value="rdoDA" if="~dtPopuniIzmj.@booltrue==true">
					<parameter value="true"/>
				</action>
				<action type="control value" value="rdoDA" if="~dtPopuniIzmj.@booldef==0">
					<parameter value="false"/>
				</action>
				<action type="control value" value="rdoNE" if="~dtPopuniIzmj.@booldef==1">
					<parameter value="true"/>
				</action>
				<action type="control value" value="rdoNE" if="~dtPopuniIzmj.@booldef==0">
					<parameter value="false"/>
				</action> -->
				<action type="control value" value="#rdoDa">
					<parameter value="true" if="~dtPopuniIzmj.@booldef==1"/>
					<parameter value="false" if="~dtPopuniIzmj.@booldef==0"/>
				</action>
				<action type="control value" value="#rdoNe">
					<parameter value="true" if="~dtPopuniIzmj.@booldef==0"/>
					<parameter value="false" if="~dtPopuniIzmj.@booldef==1"/>
				</action>
            </action>
			
			<action type="control visible" value="#rdoDA,#rdoNE,#txtDefNum,#txtMin,#txtMax" if="$tip==0">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#txtDefAlfa,#rdoDA,#rdoNE" if="$tip==1">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#txtDefAlfa,#txtDefNum,#txtMin,#txtMax" if="$tip==2">
				<parameter value="false"/>
			</action>
			
			<action type="control visible" value="#txtDefAlfa" if="$tip==0">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#txtDefNum,#txtMin,#txtMax" if="$tip==1">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#rdoDA,#rdoNE" if="$tip==2">
				<parameter value="true"/>
			</action>
		</event>
		<event type="shown">
			<action type="control visible" value="#rdoDA,#rdoNE,#txtDefNum,#txtMin,#txtMax" if="$tip==0">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#txtDefAlfa,#rdoDA,#rdoNE" if="$tip==1">
				<parameter value="false"/>
			</action>
			<action type="control visible" value="#txtDefAlfa,#txtDefNum,#txtMin,#txtMax" if="$tip==2">
				<parameter value="false"/>
			</action>
			
			<action type="control visible" value="#txtDefAlfa" if="$tip==0">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#txtDefNum,#txtMin,#txtMax" if="$tip==1">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#rdoDA,#rdoNE" if="$tip==2">
				<parameter value="true"/>
			</action>
			<!-- <action type="control visible" value="#txtDefAlfa" if="$tip==0">
				<parameter value="true"/>
			</action>
			<action type="control visible" value="#txtDefNum,#txtMin,#txtMax" if="$tip==1">
				<parameter value="true"/>
			</action> -->

			<!-- <action type="control disable" value="#txtMin,#txtMax" if="$tip==0||$tip==2"/> -->
			<!-- <action type="control visible" value="#txtMin" if="$tip==1"/>
			<action type="control visible" value="#txtMax" if="$tip==1"/> -->
		</event>
		<layout>
			<group rows="4" cols="1">
				<item row="1" col="1" caption="Parametar:">
					<comboedit name="cmbPar" displayfield="Naziv" valuefield="KKvalParametriId" dataname="~dtPar" 
								datavalue="~dtPopuniIzmj.@KKvalParametriId" datatext="~dtPopuniIzmj.@Naziv" required="true" allownull="false">
						<event type="valuechanged" raiseonload="false">
							<action if="$kkvallnParametarrobaid==null">
								<action type="datarun reader" value="~dtParDod"/>
									<action type="variable value" value="$tip">
										<parameter value="~dtParDod.@tip"/>
									</action>
									<action type="control visible" value="#rdoDA,#rdoNE,#txtDefNum,#txtMin,#txtMax" if="$tip==0">
										<parameter value="false"/>
									</action>
									<action type="control visible" value="#txtDefAlfa,#rdoDA,#rdoNE" if="$tip==1">
										<parameter value="false"/>
									</action>
									<action type="control visible" value="#txtDefAlfa,#txtDefNum,#txtMin,#txtMax" if="$tip==2">
										<parameter value="false"/>
									</action>
									
									<action type="control visible" value="#txtDefAlfa" if="$tip==0">
										<parameter value="true"/>
									</action>
									<action type="control visible" value="#txtDefNum,#txtMin,#txtMax" if="$tip==1">
										<parameter value="true"/>
									</action>
									<action type="control visible" value="#rdoDA,#rdoNE" if="$tip==2">
										<parameter value="true"/>
									</action>
							</action>
							
							<action else="">
								<action type="variable value" value="$KKvalLnParametarRobaId" if="KKvalLnParametarRobaId!=null" >
									<parameter value="#cmbPar.@KKvalLnParametarRobaId"/>
								</action>
								<action type="variable value" value="$idKKvalParametri" if="KKvalLnParametarRobaId==null" >
									<parameter value="#cmbPar.@KKvalParametriId"/>
								</action>
								<action type="variable value" value="$tip">
									<parameter value="#cmbPar.@tip"/>
								</action>
								
								<action type="control visible" value="#rdoDA,#rdoNE,#txtDefNum,#txtMin,#txtMax" if="$tip==0">
									<parameter value="false"/>
								</action>
								<action type="control visible" value="#txtDefAlfa,#rdoDA,#rdoNE" if="$tip==1">
									<parameter value="false"/>
								</action>
								<action type="control visible" value="#txtDefAlfa,#txtDefNum,#txtMin,#txtMax" if="$tip==2">
									<parameter value="false"/>
								</action>
								
								<action type="control visible" value="#txtDefAlfa" if="$tip==0">
									<parameter value="true"/>
								</action>
								<action type="control visible" value="#txtDefNum,#txtMin,#txtMax" if="$tip==1">
									<parameter value="true"/>
								</action>
								<action type="control visible" value="#rdoDA,#rdoNE" if="$tip==2">
									<parameter value="true"/>
								</action>
								
								<action type="control disable" value="#txtMin,#txtMax" if="$tip==0"/>
								<action type="control enable" value="#txtMin,#txtMax" else=""/>
								
								
								<action type="datarun reader" value="~dtPopuniIzmj"/>
								
								<action type="control value" value="#chkObavezan">
									<parameter value="~dtPopuniIzmj.@obavezan"/>
								</action>
								<action type="control value" value="#txtDefNum" if="$tip==1">
									<parameter value="~dtPopuniIzmj.@StrDefault"/>
								</action>
								<action type="control value" value="#txtDefAlfa" if="$tip==0">
									<parameter value="~dtPopuniIzmj.@StrDefault"/>
								</action>
								<action type="control value" value="#txtMin">
									<parameter value="~dtPopuniIzmj.@DecMin"/>
								</action>
								<action type="control value" value="#txtMax">
									<parameter value="~dtPopuniIzmj.@DecMax"/>
								</action>
								<action type="control value" value="#rdoDa">
									<parameter value="true" if="~dtPopuniIzmj.@booldef==1"/>
									<parameter value="false" if="~dtPopuniIzmj.@booldef==0"/>
								</action>
								<action type="control value" value="#rdoNe">
									<parameter value="true" if="~dtPopuniIzmj.@booldef==0"/>
									<parameter value="false" if="~dtPopuniIzmj.@booldef==1"/>
								</action>
								<action type="control value" value="#txtNap">
									<parameter value="~dtPopuniIzmj.@opis"/>
								</action>
							</action>
						</event>
					</comboedit>
				</item>
				<item row="2" col="1" caption="Obavezan:" textposition="left">
					<checkedit name="chkObavezan" value="true" datavalue="~dtPopuniIzmj.@obavezan"/>
				</item>
				<group row="3" col="1" rows="3" cols="2"  caption="Vrijednosti parametra:">
					
					<item row="1" col="1" caption="Defaultna" if="$tip==0" colspan="2">
						<textedit name="txtDefAlfa" datavalue="~dtPopuniIzmj.@StrDefault" />
					</item>			
					<item row="1" col="1" caption="Defaultna"  if="$tip==1" colspan="2"> <!-- textvisible="false" -->
						<textedit name="txtDefNum" datavalue="~dtPopuniIzmj.@StrDefault" textposition="right" format="n4"/>
					</item>
					
					<item row="2" col="1" caption="Minimalna">
						<textedit name="txtMin" format="n4" datavalue="~dtPopuniIzmj.@decmin"/>
					</item>
					<item row="2" col="2" caption="Maksimalna">
						<textedit name="txtMax" format="n4" datavalue="~dtPopuniIzmj.@decmax"/>
					</item>
					<item row="2" col="1" >
						<radioedit name="rdoDA" caption="Da" />
					</item>	
					<item row="2" col="2" >
						<radioedit name="rdoNe" caption="Ne" />
					</item>	
				</group>
				<item row="4" col="1" caption="Opis:">
					<textedit name="txtNap" value=" " datavalue="~dtPopuniIzmj.@opis"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
			<!-- spremi -->
				<button caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action if="$KKvalLnParametarRobaId!=null">
							<action type="datarun nonquery" value="~dtIzmjeniPar"/>
							<action type="control populate keepfocus" value="parent.#grdParametri"/>
							<action type="form close"/>
						</action>
						<action else="">
							<action type="datarun scalar" value="~dtDodajPar">
								<parameter name="FocusId"/>
							</action>
							<action type="control populate" value="parent.#grdParametri">
								<action type="control focus" value="parent.#grdParametri">
									<parameter value="$FocusId" type="int"/>
								</action>
							</action>
							<action type="form close"/>						
						</action>
					</event>
				</button>
			<!-- odustani -->
				<button caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
	<!-- store -->
		<datalist>
			<!-- <data name="dtPopuni" command="spCarpoKKvalLnParRobaQuery">
				<parameter name="@action" value="1" />
				<parameter name="@KKvalLnParametarRobaId" value="$KKvalLnParametarRobaId"/>
			</data> -->
			<data name="dtPopuniIzmj" command="spCarpoKKvalLnParRobaQuery">
				<parameter name="@action" value="2" />
				<parameter name="@KKvalLnParametarRobaId" value="$KKvalLnParametarRobaId"/>
			</data>
			<!-- <data name="dtPopuni" command="spCarpoKKvalLnParRobaQuery">
				<parameter name="@KKvalLnParametarRobaId" value="$KKvalLnParametarRobaId"/>
			</data> -->
			<data name="dtPar" command="spKKvalParametriQuery">
				<parameter name="@Action" value="3" />
				<parameter name="@kkvallnParametarrobaid" value="$kkvallnParametarrobaid" />
				<parameter name="@robaid" value="$RobaParId" if="KKvalLnParametarRobaId!=null"/>	
			</data>
			<data name="dtParDod" command="spKKvalParametriQuery">
				<parameter name="@Action" value="1" />
				<parameter name="@KKvalParametriId" value="#cmbpar.@KKvalParametriId" />	
			</data>
			<data name="dtDodajPar" command="spCarpoKKvalLnParRobaAzur"> 
				<parameter name="@Action" value="0"/>
				<parameter name="@RobaId" value="$RobaParId"/>
				<parameter name="@KKvalParametriId" value="#cmbPar.@KKvalParametriId"/>
				
				<parameter name="@Obavezan" value="#chkObavezan"/>
				
                <parameter name="@booldef" value="1" if="#rdoDa==true" />
				<parameter name="@booldef" value="0" elseif="#rdoNe==true" />
				
               <!--  <parameter name="@BoolTrue" value="True" if="#rdoDa==true" />
                <parameter name="@BoolTrue" value="False" if="#rdoNe==true" />
				
                <parameter name="@BoolFalse" value="True" if="#rdoNe==true"/>
                <parameter name="@BoolFalse" value="False" if="#rdoDa==true"/> -->
				
				
				<parameter name="@DecDef" value="#txtDefNum" type="decimal" if="$tip==1"/>
				<parameter name="@StringDef" value="#txtDefAlfa" type="string" if="$tip==0" />
				<parameter name="@DecMin" value="#txtMin" type="decimal"/>
				<parameter name="@DecMax" value="#txtMax" type="decimal"/>
				<parameter name="@Opis" value="#txtNap"/>												
			</data>
			<data name="dtIzmjeniPar" command="spCarpoKKvalLnParRobaAzur">
				<parameter name="@Action" value="11"/>
				<parameter name="@KKvalLnParametarRobaId" value="$KKvalLnParametarRobaId"/>
				
				<parameter name="@RobaId" value="$RobaParId"/>
				<parameter name="@KKvalParametriId" value="$KKvalParametriId"/> 
				
				<parameter name="@Obavezan" value="#chkObavezan"/>
				<parameter name="@StringDef" value="#txtDefAlfa" type="string" />
				<parameter name="@DecDef" value="#txtDefNum" type="decimal" />
				<parameter name="@DecMin" value="#txtMin" type="decimal"/>
				<parameter name="@DecMax" value="#txtMax" type="decimal"/>
				
				<parameter name="@booldef" value="1" if="#rdoDa==true" />
				<parameter name="@booldef" value="0" if="#rdoNe==true" />
				
                <!-- <parameter name="@BoolTrue" value="True" if="#rdoDa==true" />
                <parameter name="@BoolTrue" value="False" if="#rdoNe==true" />
				
                <parameter name="@BoolFalse" value="True" if="#rdoNe==true"/>
                <parameter name="@BoolFalse" value="False" if="#rdoDa==true"/> -->
				
				<parameter name="@Opis" value="#txtNap"/>
				<!-- <parameter name="@aktivan" value="0" if="txtMin!=parent.#grdParametri.@decmin||txtMax!=parent.#grdParametri.@decmax"/>
				<parameter name="@aktivan" value="1" else=""/> -->
				<!-- <parameter name="@datumNEAktivan" value="now" if="txtMin!=parent.#grdParametri.@decmin||txtMax!=parent.#grdParametri.@decmax"/>
				<parameter name="@datumNEAktivan" value="null" else=""/> -->
			</data>
		</datalist>
	</form>
</root>