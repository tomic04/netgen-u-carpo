<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmUnos" caption="Unos nove stavke" width="400" height="100">		
		<layout >
			<group cols="1" rows="2">
				<item col="1" row="1" caption="Partner:" >
					<searchedit netgenfields="true" name="srcPartner" fieldtext="NazivId" fieldvalue="partneriid" fontbold="true" required="true" dataname="Global.dtPartneri"/>
				</item>			
				<item col="1" row="2" caption="Roba:" >
					<searchedit netgenfields="true" required="true" name="srcRoba" fontsizedelta="1" fontbold="True" dataname="Global.dtRoba" fieldtext="NazivId" fieldvalue="robaid" entermovenextcontrol="false"/>
				</item>				
			</group> 
		</layout>
		<panelbuttons>
			<buttons>
				<button name="Spremi" caption="Spremi" type="add" dock="left">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtUnesi"/>
						<action type="control populate" value="parent.#grdGlava"/>
						<action type="control refreshvalue" value="#srcRoba"/>			
						<action type="control focus" value="#srcRoba"/>	
					</event>
				</button>
				<button name="Odustani" caption="Izlaz" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>		
			</buttons>
		</panelbuttons>
		<datalist>
 			<data command="spRobaLnPartneri_Unos" name="dtUnesi">
				<parameter name="@partneriid" value="#srcPartner"></parameter>
				<parameter name="@robaid" value="#srcRoba"></parameter>
				<parameter name="@operateriid" value="@@OperateriId"></parameter>
			</data>
		</datalist>
	</form>
</root>