<root>
	<form name="frmPromijeniStatus" caption="Promijeni status" height="300">
		<layout textposition="top" itemspadding="3" autotaborder="false">
			<group cols="1" rows="2">
				<item col="1" row="1" caption="Jeste li sigurni da želite promijeniti status?">
					<comboedit name="cmbStatusi" valuefield="StatusiId" displayfield="Korak" dataname="Global.~dtStatusi" allownull="false" tabindex="0" />
				</item>
				<item caption="Napomena:" col="1" row="2">
					<memoedit name="txtNapomena" entermovenextcontrol="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" tabindex="1">
					<event type="click">
						<action type="datarun reader" value="global.~dtProvjeraPrava" />
						<action type="variable value">
							<parameter name="ImaPravo" value="global.~dtProvjeraPrava.@ImaPravo" />
							<parameter name="global.$statusRNCaption55" value="#cmbStatusi.@Korak" />
							<parameter name="TrenutniStatus" value="#cmbStatusi" />
						</action>
						<action if="$ImaPravo==1">
							<action type="datarun nonquery" value="global.~dtStatusiAzur">
							</action>
							<action type="variable value">
								<parameter name="global.TrenutniStatus" value="#cmbStatusi" />
							</action>
							<!--
							<action type="control populate" value="parent.#grdMaster">
							<action type="control focus" value="parent.#grdMaster">
							<parameter value="global.$ServisRNGlaId"/>
							</action>
							</action>
							-->
							<action type="form close" />
						</action>
						<action type="message" value="Nemate pravo na ovu promjenu statusa!" if="$ImaPravo==0" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>
</root>
