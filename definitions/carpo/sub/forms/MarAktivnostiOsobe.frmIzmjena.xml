<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="frmIzmjena" caption="$Caption" template="splitter" width="900" height="500" statusbar="true">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="global.$MarAktivnostiId!=null" />
		</event>
		<event type="load">
		</event>
		<event type="shown">
			<action type="control populate" value="#grdStavke" if="global.$MarAktivnostiId!=null" />
			<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
			<action type="control disable" value="#btnDodaj,#btnIzmijeni,#btnObrisi,#btnDodajPartnera,#btnDodajOsobu" if="global.$MarAktivnostiId==null" />
		</event>
		<layout name="panel1" type="collapsable" minsize="300">
			<group cols="1" rows="1" bordervisible="false">
				<tabs col="1" row="1">
					<group cols="1" rows="1" caption="Osnovno" name="tabOsnovno">
						<group col="1" row="1" cols="2" rows="9" bordervisible="false">
							<item col="1" row="1" colspan="2" caption="Naziv:" highlight="false">
								<textedit name="txtNaziv" maxlength="20" datavalue="~dtGet.@Naziv" required="true">
								</textedit>
							</item>
							<item col="1" row="2" caption="Datum:" highlight="false">
								<dateedit name="datDatum" value="now" datavalue="~dtGet.@Datum">
								</dateedit>
							</item>
							<item col="1" row="3" colspan="2" caption="Klasa aktivnosti:" highlight="false">
								<comboedit name="cmbKlasa" valuefield="Id" dataname="~dtKlase" displayfield="Naziv" datavalue="~dtGet.@MarKlAktId" required="true">
								</comboedit>
							</item>
							<item col="1" row="4" colspan="2" caption="Osoba:" highlight="false">
								<comboedit name="cmbOsoba" valuefield="OsobeId" dataname="~dtOdgovornaOsoba" displayfield="Osoba" datavalue="~dtGet.@OsobeId" required="true">
								</comboedit>
							</item>
							<item col="1" row="5" colspan="2" caption="Status:" highlight="false">
								<comboedit name="cmbStatus" valuefield="StatusId" dataname="~dtStatus" displayfield="Status" datavalue="~dtGet.@Status" required="true">
								</comboedit>
							</item>
							<item col="1" row="6" colspan="2" caption="Opis:" highlight="false">
								<textedit name="txtOpis" maxlength="50" datavalue="~dtGet.@Opis">
								</textedit>
							</item>
							<item col="1" row="7" colspan="2" caption="Org. shema:" highlight="false">
								<comboedit name="cmbOrgShema" valuefield="OrgShemaId" dataname="~dtOrgShema" displayfield="Naziv" datavalue="~dtGet.@OrgShemaId">
								</comboedit>
							</item>
							<item col="1" row="8" caption="TrosakFix:" highlight="false">
								<textedit name="txtTrosakFix" format="n4" datavalue="~dtGet.@TrosakFix" value="0">
								</textedit>
							</item>
							<item col="2" row="8" caption="TrosakVar:" highlight="false">
								<textedit name="txtTrosakVar" format="n4" datavalue="~dtGet.@TrosakVar" value="0">
								</textedit>
							</item>
						</group>
					</group>
				</tabs>
			</group>
		</layout>
		<layout name="panel2">
			<group col="2" row="1" cols="1" rows="2" caption="Stavke">
				<rowsdefinition>
					<row position="1" size="100%" />
					<row position="2" size="46" />
				</rowsdefinition>
				<item col="1" row="1" highlight="false">
					<grid name="grdStavke" dataname="dtDet" bestfitonrefresh="true" savelayout="true" multiselect="true">
						<fields>
							<field name="Osoba" caption="Osoba" />
							<field name="Partner" caption="Partner" />
							<field name="Datum" caption="Datum" />
							<field name="Ocjena" caption="Ocjena" />
							<field name="statusNaziv" caption="Status" />
							<field name="Mobitel" caption="Mobitel (osobni)" />
							<field name="MobitelPosl" caption="Mobitel (poslovni)" />
							<field name="email" caption="E-mail (osobni)" />
							<field name="LNemail" caption="E-mail (poslovni)" />
							<field name="PSemail" caption="Tvrtkin e-mail" />
							<field name="Napomena" caption="Napomena" />
						</fields>
						<event type="focusedrowchanged">
						</event>
						<event type="doubleclick" if="#grdStavke.rowcount&gt;0">
							<action type="form open" value="frmOsobaUpsert">
								<parameter name="MarAktDetId" value="#grdStavke.@Maraktdetid" />
								<parameter name="caption" value="Izmjena" />
							</action>
							<action type="control populate" value="#grdStavke">
							</action>
							<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
						</event>
						<event type="selectionchanged">
							<action type="variable value">
								<parameter name="global.OdabraneStavkeId" value="#grdStavke.selectedids" />
							</action>
						</event>
					</grid>
				</item>
				<group col="1" row="2" cols="7" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="20%" position="1" />
						<column size="20%" position="2" />
						<column size="20%" position="3" />
					</columnsdefinition>
					<item col="1" row="1" highlight="false">
						<button name="btnDodaj" caption="&amp;Dodaj" image="add">
							<event type="click">
								<action type="form open" value="frmOsobaUpsert">
									<parameter name="MarAktDetId" value="null" />
									<parameter name="caption" value="Unos" />
								</action>
								<action type="control populate" value="#grdStavke">
								</action>
								<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
							</event>
						</button>
					</item>
					<item col="2" row="1" highlight="false">
						<button name="btnIzmijeni" caption="&amp;Izmijeni" image="edit" function="stavkaizmijeni">
							<event type="click">
								<action type="form open" value="frmOsobaUpsert">
									<parameter name="MarAktDetId" value="#grdStavke.@Maraktdetid" />
									<parameter name="caption" value="Izmjena" />
								</action>
								<action type="control populate" value="#grdStavke">
								</action>
								<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
							</event>
						</button>
					</item>
					<item col="3" row="1" highlight="false">
						<button name="btnObrisi" caption="O&amp;briši" imagealign="left" image="delete">
							<event type="click">
								<action type="confirm" value="Želite li sigurno obrisati označenu stavku?">
									<action type="control foreachrow selected" value="#grdStavke">
										<action type="datarun nonquery" value="~dtObrisi">
										</action>
									</action>
								</action>
								<action type="control populate" value="#grdStavke" />
								<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
							</event>
						</button>
					</item>
					<item col="4" row="1" highlight="false">
						<button name="btnDodajPartnera" caption="Dodaj partnera" imagealign="left">
							<event type="click">
								<action type="form open" value="frmPartner">
								</action>
								<action type="control populate" value="#grdStavke">
								</action>
								<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
							</event>
						</button>
					</item>
					<item col="5" row="1" highlight="false">
						<button name="btnDodajOsobu" caption="Odaberi osobe" imagealign="left">
							<event type="click">
								<action type="form open" value="frmOsobe">
									<parameter name="MarAktDetId" value="#grdStavke.@Maraktdetid" />
								</action>
								<action type="control populate" value="#grdStavke">
								</action>
								<action type="footer text" value="Broj slogova: {#grdStavke.rowcount}" />
							</event>
						</button>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="&amp;SPREMI" dock="left">
					<event type="click">
						<action type="validate" />
						<action if="global.$MarAktivnostiId!=null">
							<action type="datarun nonquery" value="~dtIzmjena" />
							<action type="variable value" value="Close">
								<parameter value="1" type="int" />
							</action>
						</action>
						<action else="">
							<action type="datarun scalar" value="~dtUnos">
								<parameter name="NoviMarAktivnostiId" />
							</action>
							<action type="control enable" value="#btnDodaj,#btnIzmijeni,#btnObrisi,#btnDodajPartnera,#btnDodajOsobu" />
							<action type="variable value" value="global.MarAktivnostiId">
								<parameter value="$NoviMarAktivnostiId" type="int" />
							</action>
							<action type="variable value" value="Close">
								<parameter value="0" type="int" />
							</action>
						</action>
						<action type="form close" if="$Close==1" />
					</event>
				</button>
				<button name="btnOdustani" caption="ZATVORI" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktivnostiQuery" name="dtGet">
				<parameter name="@action" value="1" />
				<parameter name="@Id" value="global.$MarAktivnostiId" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtKlase">
				<parameter name="@Action" value="24" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtOdgovornaOsoba">
				<parameter name="@Action" value="NaseOsobe" />
			</data>
			<data command="select 0 as StatusId, 'Otvoren' as Status union all select 1 as StatusId, 'Zatvoren' as Status " type="text" name="dtStatus">
			</data>
			<data command="spMarAktivnostiCombo" name="dtOrgShema">
				<parameter name="@Action" value="OrgShema" />
			</data>
			<data command="spMarAktivnostiQuery" name="dtDet">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="global.$MarAktivnostiId" />
			</data>
			<data command="spMarAktAzur" name="dtIzmjena">
				<parameter name="@action" value="1" />
				<parameter name="@Id" value="global.$MarAktivnostiId" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@MarKlAktId" value="#cmbKlasa" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Status" value="#cmbStatus" />
				<parameter name="@OsobeId" value="#cmbOsoba" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@TrosakFix" value="#txtTrosakFix" />
				<parameter name="@TrosakVar" value="#txtTrosakVar" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@Staza" value="null" />
			</data>
			<data command="spMarAktAzur" name="dtUnos">
				<parameter name="@action" value="0" />
				<parameter name="@Id" value="null" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@MarKlAktId" value="#cmbKlasa" />
				<parameter name="@Datum" value="#datDatum" />
				<parameter name="@Status" value="#cmbStatus" />
				<parameter name="@OsobeId" value="#cmbOsoba" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@TrosakFix" value="#txtTrosakFix" />
				<parameter name="@TrosakVar" value="#txtTrosakVar" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@Staza" value="null" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtObrisi">
				<parameter name="@Action" value="2" />
				<parameter name="@Id" value="#grdStavke.@Maraktdetid" />
			</data>
		</datalist>
	</form>
	<form name="frmOsobaUpsert" path="frmOsobaUpsert.xml" />
	<form name="frmOsobe" path="frmOsobe.xml" />
	<form name="frmPartner" path="frmPartner.xml" />
</root>
