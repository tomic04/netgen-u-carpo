<root>
	<form name="frmStavke" path="Inventura.frmStavke.xml"/>
	<form name="frmGlava" caption="Inventura - skladišna" width="800" >
		<event type="shown">
			<action type="control value" value="#datDatumDok">
				<parameter value="now" type="date"/>
			</action>
			<action type="control value" value="#datDatumPopisa">
				<parameter value="now" type="date"/>
			</action>
		</event>
		<layout textposition="left" itemspadding="3">
		<group cols="1" rows="1">
			<group cols="2" rows="3" col="1" row="1" >
				<item caption="Skladište:" row="1" col="1" >
					<comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="OznakaOpis" dataname="~dtSkladiste" allownull="false"/>
				</item>
				<item caption="Datum inventure:" row="1" col="2" >
					<dateedit name="datDatumDok" required="true" />
				</item>
				<item caption="Odgovorna osoba:" row="2" col="1">
					<comboedit name="cmbOsobe" required="true" valuefield="OsobeId" displayfield="Naziv" dataname="~dtOdgovornaOsoba" />
				</item>
				<item caption="Klasifikacija:" row="2" col="2">
					<combotreeedit name="cmbKlasaRobe" valuefield="KlmasterRobaId" displayfield="Naziv" dataname="~dtKlasaRobe" />
				</item>
				<item caption="Sort po:" row="3" col="1" >
					<comboedit name="cmbSort" required="true" dataname="" enabled="false" />
				</item>
				<item caption="Datum popisa:" row="3" col="2" >
					<dateedit name="datDatumPopisa" required="true"/>
				</item>
			</group>
		</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnStavke" caption="STAVKE" dock="right">
					<event type="click">
						<action type="validate"/>
						<action type="datarun scalar" value="~dtGlaSpremi">
							<parameter name="SktInventuraGlaId"/>
						</action>
						<action type="form close"/>
						<action type="form open" value="frmStavke">
							<parameter name="Indikator" value="1"/>
							<parameter name="SktInventuraGlaId" value="$SktInventuraGlaId"/>
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
				<data name="dtSkladiste" command="spSkladisteQueryCarpo" >
					<parameter name="@Action" value="0"/>
				</data>
				<data command="spOsobeQueryCarpo" name="dtOdgovornaOsoba">
					<parameter name="@Action" value="16" />
				</data>	
				<data name="dtGlaSpremi" command="spCSktInventuraGlaAzur">
					<parameter name="@Action" value="0"/>
					<parameter name="@DatumDok" value="#datDatumDok"/>
					<parameter name="@OperateriId" value="@@operateriid"/>
					<parameter name="@DatumKnjizenja" value="null"/>
					<parameter name="@OsobeId" value="#cmbOsobe"/>
					<parameter name="@DatumPopisa" value="#datDatumPopisa"/>
					<parameter name="@SkladisteId" value="#cmbSkladiste"/>
					<parameter name="@KlMasterRobaId" value="#cmbKlasaRobe"/>
					<parameter name="@Status" value="0"/>
					<parameter name="@Sort" value="0"/>
				</data>
				<data command="spManKlMasterRobaGet" name="dtKlasaRobe" />				
		</datalist>
	</form>
</root>