<root>
	<form name="frmUnosViseRoba" type="master" caption="Unos više roba">
		<event type="init">
			<action type="datarun nonquery" value="~dtGetKlasifikacija" />
			<action type="datarun reader" value="~dtGetRobaID">
			</action>
		</event>
		<event type="onload">

		</event>
		<event type="close">
			<action type="variable value">
				<parameter name="parent.$Odabrani" value="#grdViseRoba.selectedids" />
				<parameter name="parent.$KlRobaID" value="#grdViseRoba.@KlRobaID" />
			</action>
		</event>
		<layout>
			<group cols="4" rows="4" col="3" row="1" spacing="0,0,0">
				 <rowsdefinition>
                       <row position="3" size="45" /> 
                </rowsdefinition>
                <columnsdefinition>
                	<column position="1" size="70" />
                </columnsdefinition>
				<item col="1" row="1" colspan="4" caption="Klasifikacija:">
					<comboedit name="cmbKlasifikacija" valuefield="KlKlRobaID" displayfield="Naziv" datavalue="~dtGetKlasifikacija.@KlKlRobaID" dataname="~dtGetKlasifikacija">
							<event type="valuechanged">
							<action type="datarun reader" value="~dtGetKlasa" />
							<action type="control populate" value="#cmbKlasa">
								<parameter value="~dtgetKlasa.@Naziv" />
							</action>
						</event>
					</comboedit>
				</item>
				<item col="1" row="2" colspan="4" caption="Klasa:">
					<comboedit name="cmbKlasa" displayfield="naziv" valuefield="KlRobaID" dataname="~dtGetKlasa">
					
					</comboedit>
				</item>

				<item col="4" row="3" colspan="2">
					<button name="btnPokazi" caption="Pokaži">
						<event type="click">
							<action type="datarun nonquery" value="~dtGetGrid" />
							<action type="control populate" value="#grdViseRoba" />
								<action type="datarun reader" value="~dtGetRobaID" />
								<action type="control selectedrows" value="#grdViseRoba">
									<parameter value="~dtGetRobaID.@selectedid"/>
								</action>
						</event>
					</button>
				</item>
				<item col="1" row="4" colspan="4">
					<grid name="grdViseRoba" dataname="~dtGetGrid" bestfitonrefresh="true" showcheckboxes="true" autopopulate="true" key="RobaID" keyfield="RobaID" showgrouppanel="false" multiselect="true">
						<fields>
							<field name="aktivno" caption="Aktivno" visible="false"/> -->
							<field name="RobaID" visible="false" />
							<field name="KLRobaID" visible="false" />
							<field name="Naziv2000" caption="Naziv"/>
							<field name="Šifra1000" caption="Šifra" />
							<field name="PostojiNaUgovoru" caption="Postoji na ugovoru" />
							<field name="selectedid" visible="false"/>
						</fields>
						<styles>
							<style name="fontcolor" value="red" if="#grdViseRoba.@selectedid==0" /> 
						</styles>
					</grid>
				</item>
			</group>
		</layout>
	<panelbuttons>
		<buttons>
			<button name="btnPrihvati" caption="Prihvati">
				<event type="click">
					<action type="form close" />
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
		</buttons>
	</panelbuttons>
	<datalist>
		<data command="spProd_KupUgo_KlKlRobaQuery" name="dtGetKlasifikacija" />
		<data command="spProd_KupUgo_KlRobaQuery" name="dtGetKlasa">
			<parameter name="@KlKlRobaID" value="#cmbKlasifikacija" />
		</data>
		<data command="spProd_KupUgovoriGlaInsertMultiRobe" name="dtGetGrid">
			<parameter name="@action" value="1" />
			<parameter name="@KlRobaid" value="#cmbKlasa" />
			<parameter name="@KupUgovoriGlaID" value="$KupUgovoriGlaID" />
			<parameter name="@Odabrani" value="" />
		</data>

		<data command="spProd_KupUgovoriGla_PostojiNaUgovoru" name="dtGetRobaID">
			<parameter name="@KupUgovoriGlaID" value="$KupUgovoriGlaID" />
			<parameter name="@KlrobaID" value="#cmbKlasa" />
			<parameter name="@Odabrani" value="" />
		</data>
	</datalist>
	</form>
</root>