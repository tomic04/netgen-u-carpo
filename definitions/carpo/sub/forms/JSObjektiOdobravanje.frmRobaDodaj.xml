<root>
	<form name="frmRobaDodaj" caption="Dodavanje nove robe">
		<event type="oninit">
			<action type="datarun reader" value="~dtObjekt" />
		</event>
		<event type="shown">
			<action type="control value" value="#txtNaziv" if="global.$Tip==Unos">
				<parameter value="$Objekt" />
			</action>
		</event>
		<layout>
			<group rows="5" cols="3">
				<columnsdefinition>
					<column size="60%" position="1" />
					<column size="20%" position="2" />
					<column size="20%" position="3" />
				</columnsdefinition>
				<item col="1" row="1" caption="Naziv robe:" colspan="3">
					<textedit name="txtNaziv" required="true" datavalue="~dtObjekt.@Naziv" />
				</item>
				<item col="1" row="2" caption="Klasifikacija robe:" colspan="3">
					<comboedit name="cmbKlasa" valuefield="KlMasterRobaID" dataname="~dtKlase" displayfield="Klasa" required="true" />
				</item>
				<item col="1" row="3" caption="Jedinica mjere:" colspan="3">
					<comboedit name="cmbJM" valuefield="JMID" dataname="~dtJM" displayfield="JM" value="26" required="true" />
				</item>
				<item col="1" row="4" caption="Porezna grupa:" colspan="3">
					<comboedit name="cmbPorez" valuefield="TarifaID" dataname="~dtPorez" displayfield="Porez" value="10" required="true" />
				</item>
				<item col="1" row="5" caption="VP Cijena (€):" colspan="3">
					<textedit name="txtCijena" value="0" format="n2" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" dock="left">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtAdd">
							<parameter name="global.NovaRobaId" />
						</action>
						<action type="datarun scalar" value="~dtCijena">
						</action>
						<action type="variable value">
							<parameter name="parent.Close" value="1" />
						</action>
						<action type="form close" value="frmRobaTrazilica" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="variable value">
							<parameter name="parent.Close" value="0" />
						</action>
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spRobaNET_Azur" name="dtAdd">
				<parameter name="@action" value="1" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@klmasterrobaid" value="#cmbKlasa" />
				<parameter name="@jmid" value="#cmbJM" />
				<parameter name="@tarifaid" value="#cmbPorez" />
				<!-- <parameter name="@EOL" value="0" /> -->
				<parameter name="@status" value="0" />
			</data>
			<data command="spJSObjektiAzur" name="dtCijena">
				<parameter name="@Action" value="7" />
				<parameter name="@Cijena" value="#txtCijena" />
				<parameter name="@RobaId" value="global.$NovaRobaId" />
				<parameter name="@OperateriId" value="@@OperateriId" />
			</data>
			<data command="spJSObjektiQuery" name="dtKlase">
				<parameter name="@action" value="14" />
			</data>
			<data command="spJSObjektiQuery" name="dtJM">
				<parameter name="@action" value="15" />
			</data>
			<data command="spJSObjektiQuery" name="dtPorez">
				<parameter name="@action" value="16" />
			</data>
			<data command="spJSObjektiQuery" name="dtObjekt" if="global.$Tip!=Unos">
				<parameter name="@action" value="5" />
				<parameter name="@JupiterObjectId" value="global.$JSObjektId" />
			</data>
		</datalist>
	</form>
</root>
