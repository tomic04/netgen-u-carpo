<root>
  <!--
  ****************************************************************
  OVO JE DIJELJENA DATOTEKA - KORISTI SE ZA MANIPULACIJU PREDLOŠCIMA VIRMANA ZA BANKE, DOPRINOSE I POREZE
  prema $OOPOznaka se daje lista virmana
  ****************************************************************
  -->


  <!--
  ****************************************************************
  FORMA ZA LISTU VIRMANA
  prema oopoznaka se daje lista virmana
  2021. frmVirmani VER 1: inicijalna forma samo za banke
  2021. frmVirmani ver 2: doradio da prima oopoznaka i na temelju toga radi listu, sve prebačeno na spPlaceVirmaniAll strou
  2021. frmVirmani ver 3: dodao opciju kopiranja virmana
  ****************************************************************
  -->
  <form name="frmVirmani" caption="$caption" width="800" height="500" showversion="true"  version="3">
    <event type="init">
      <action type="datarun reader" value="~dtGridVrimani" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdVirmani" > </action>
      <action if="#grdVirmani.rowcount==0">
        <action type="control disable" value="#btnIzmijeni,#btnBrisi"/>
      </action>
      <action else="#grdVirmani.rowcount==0">
        <action else="#grdVirmani.rowcount!=0" type="control enable" value="#btnIzmijeni,#btnBrisi"/>
      </action>
    </event>

    <layout>
      <group cols="1" rows="5" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdVirmani" key="OOPVirmaniId" dataname="~dtGridVrimani" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false">
            
          </grid>
        </item>
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Unos">
          <event type="click">
            <action type="form open" value="frmVirmanEdit">
              <parameter name="OOPVirmaniId" value="0"/>
              <parameter name="OOPId" value="$OOPId"/>
              <parameter name="caption" value="Unos naloga"/>
              <parameter name="oopoznaka" value="$oopoznaka" type="string"/>
              <!--na temelju ovoga će se popuniti primatelj na nalogu-->
			  <!-- <parameter name="PrimateljId" value="$OOPId"/>  -->
              <!-- <parameter name="PrimateljText" value="$Banka"/> -->
              <parameter name="PrimateljId" value="$PrimateljId"/> 
              <parameter name="PrimateljText" value="$PrimateljText"/>
            </action>
            <action type="control populate keepfocus" value="#grdVirmani"/>
            <action type="control disable" value="#btnIzmijeni,#btnBrisi" if="#grdVirmani.rowcount==0" />
            <action type="control enable" value="#btnIzmijeni,#btnBrisi" else="" />
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmijeni">
          <event type="click">
            <action type="form open" value="frmVirmanEdit">
              <parameter name="OOPVirmaniId" value="#grdVirmani.@OOPVirmaniId"/>
              <parameter name="OOPId" value="$OOPId"/>
              <parameter name="caption" value="Izmjena naloga"/>
              <parameter name="oopoznaka" value="$oopoznaka" type="string"/>
            </action>
            <action type="control populate keepfocus" value="#grdVirmani"/>
            <action type="control disable" value="#btnIzmijeni,#btnBrisi" if="#grdVirmani.rowcount==0" />
            <action type="control enable" value="#btnIzmijeni,#btnBrisi" else="" />
          </event>
        </button>
        <button name="btnBrisi" caption="Obriši">
          <event type="click">
            <action type="form open" value="frmVirmanBrisi">
              <parameter name="OOPVirmaniId" value="#grdVirmani.@OOPVirmaniId"/>
              <parameter name="caption" value="Brisanje naloga"/>
            </action>
            <action type="control populate" value="#grdVirmani"/>
            <action type="control disable" value="#btnIzmijeni,#btnBrisi" if="#grdVirmani.rowcount==0" />
            <action type="control enable" value="#btnIzmijeni,#btnBrisi" else="" />
          </event>
        </button>
		
		<button name="btnKopiraj" caption="Kopiranje">
          <event type="click">
            <action type="form open" value="frmVirmanKopiranje">
              <parameter name="OOPId" value="$OOPId"/>
              <parameter name="OOPOznaka" value="$OOPOznaka"/>
              <parameter name="caption" value="Kopiranje naloga na {$Banka}"/>
              <parameter name="ObjektNaziv" value="$Banka"/>
            </action>
			
            <action type="control populate" value="#grdVirmani"/>
          </event>
        </button>
		
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
            <action type="control populate keepfocus" value="#grdVirmani"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceVirmaniAll" name="dtGridVrimani">
        <parameter name="@action" value="virmani_lista" type="string"/>
        <parameter name="@OOPId" value="$OOPId" type="int"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
      </data>
    </datalist>
  </form>
  
  <!--
  ****************************************************************
  FORMA ZA UNOS/IZMJENU VIRMANA
  ver1: inicijalna forma
  ver2: dodao default punjenje nalogodavca ako je unos novog naloga, kod pražnjenja tražilice ispraznio kontrole
  25.3.2021. ver3: combo računa nije imao datavalue->ubacio
  ****************************************************************
  -->

  <form name="frmVirmanEdit" caption="$caption" width="1230" height="590" version="3" showversion="true">
    <event type="init">
      <action type="datarun reader" value="~dtHeader" />
      <action type="datarun reader" value="~dtBanka" />
      <action type="datarun reader" value="~dtGet" if="$OOPVirmaniId!=0" />
    </event>
    <event type="load">
      <!--zatvori formu ako nemaš ID-->
      <action if="$OOPVirmaniId==null">
        <action type="form close"></action>
      </action>

      
<!--sakrij combo stavke i vrste računa ako nije virman za banke-->
      <action type="control visible" value="#cmbVrstaracuna" if="$OOPOznaka==BA">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#cmbVrstaracuna" else="">
        <parameter value="false"/>
      </action>

      <action type="control visible" value="#cmbStavke" if="$OOPOznaka==BA">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#cmbStavke" else="">
        <parameter value="false"/>
      </action>

      <!--prikaži textedit ovisno o oopoznaka--> 
      <action type="control visible" value="#txtBA" if="$OOPOznaka==BA">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#txtBA" else="">
        <parameter value="false"/>
      </action>

      <action type="control visible" value="#txtDO" if="$OOPOznaka==DO">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#txtDO" else="">
        <parameter value="false"/>
      </action>

      <action type="control visible" value="#txtPO" if="$OOPOznaka==PO">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#txtPO" else="">
        <parameter value="false"/>
      </action>

      <action type="control visible" value="#txtOB" if="$OOPOznaka==OB">
        <parameter value="true"/>
      </action>
      <action type="control visible" value="#txtOB" else="">
        <parameter value="false"/>
      </action>

    </event>
    
    <event type="shown">
      <!--AKO JE UNOS POPUNI PLATITELJA NA NASID-->
      <action type="control value" value="#srcPlatitelj" if="$OOPVirmaniid==0">
        <parameter value="~dtBanka.@partneriid" text="~dtBanka.@naziv" />
      </action>
      <action type="control value" value="#srcPlatitelj" else="">
        <parameter value="~dtget.@nalogodavacId" text="~dtget.@PlatiteljNaziv" />
      </action>


      <!--AKO JE POSLAN PRIMATELJID I PRIMATELJTEXT POPUNI PRIMATELJA-->
	  
	  <action if="$OOPVirmaniid==0&amp;&amp;$PrimateljId!=null">
		  <action type="control value" value="#srcPrimatelj">
			<parameter value="$PrimateljId" text="$PrimateljText" />
		  </action>
	  </action>
    </event>

    <layout>
      <group cols="1" rows="2" groupbordervisible="false" alignmode="local">
        <rowsdefinition>
          <row position="1" size="30%"/>
          <row position="2" size="70%"/>
        </rowsdefinition>
        <group col="1" row="1" cols="4" rows="3" groupbordervisible="true" alignmode="local">

          
          <item caption="Banka:"  col="1" row="1" colspan="2" textposition="left" highlight="false" >
            <textedit datavalue="~dtHeader.@Podatak" name="txtBA" readonly="true"   ></textedit>
          </item>
          <item caption="Doprinos:"  col="1" row="1" colspan="2" textposition="left" highlight="false" >
            <textedit datavalue="~dtHeader.@Podatak" name="txtDO" readonly="true" ></textedit>
          </item>
          <item caption="Porezna općina:"  col="1" row="1" colspan="2" textposition="left" highlight="false" >
            <textedit datavalue="~dtHeader.@Podatak" name="txtPO" readonly="true"   ></textedit>
          </item>
          <item caption="Obustava:"  col="1" row="1" colspan="2" textposition="left" highlight="false" >
            <textedit datavalue="~dtHeader.@Podatak" name="txtOB" readonly="true"   ></textedit>
          </item>

          <item col="3" row="1" colspan="2" textposition="left" caption="Vrsta računa:" highlight="false" >
            <comboedit name="cmbVrstaracuna"  valuefield="OOPVrsteRacunaId" displayfield="Naziv" dataname="~dtVrstaRacuna" allownull="true" datavalue="~dtGet.@OOPVrsteRacunaId"></comboedit>
          </item>

          <item col="1" row="2" colspan="1" textposition="left" caption="Dodatna oznaka:" highlight="false" >
            <textedit datavalue="~dtget.@Dodatak" name="txtDodatak"></textedit>
          </item>

          <item col="2" row="2" colspan="1" textposition="left" caption="Postotak:" highlight="false" >
            <textedit datavalue="~dtget.@Postotak" name="txtPostotak" format="n2" value="100.00" required="true"></textedit>
          </item>


          <item col="3" row="2" colspan="2" textposition="left" caption="Dohodovna stavka:" highlight="false" >
            <comboedit name="cmbStavke"  valuefield="OOPStavkeId" displayfield="Naziv" dataname="~dtStavke" allownull="true"  datavalue="~dtGet.@OOPstavkeId"></comboedit>
          </item>

          <item col="1" row="3" colspan="1" textposition="left" caption="Iznos:" highlight="false" >
            <textedit datavalue="~dtget.@IznosTemplate" name="txtIznos" format="" value=""></textedit>
          </item>

        </group>        <!--kraj definicija-->

        <group col="1" row="2"  cols="4" rows="10" groupbordervisible="true" caption="Elementi naloga za plaćanje" alignmode="local">


          <item caption="Platitelj:" col="1" row="1" textposition="left" colspan="2">
            <searchedit name="srcPlatitelj" fieldvalue="PartneriId" fieldtext="Naziv" dataname="~dtSrcPlatitelj">
              <event type="valuechanged">
                <action if="#srcPlatitelj!=null">
                  <action type="datarun reader" value="~dtGetPlatitelj"></action>
                  <action type="control value" value="#txtPlatitelj1">
                    <parameter value ="~dtGetPlatitelj.@Adresa"/>
                  </action>
                  <action type="control value" value="#txtPlatitelj2">
                    <parameter value ="~dtGetPlatitelj.@Mjesto"/>
                  </action>
                  <action type="control populate" value="#cmbNalogodavacZiro"/>
                </action>
                <action else="">
                  <action type="control refreshvalue" value="#txtPlatitelj1,#txtPlatitelj2,#cmbNalogodavacZiro" />
                  <action type="control populate" value="#cmbNalogodavacZiro" />
                </action>
              </event>
            </searchedit>
          </item>
          <item caption=" " col="1" row="2" textposition="left" colspan="2">
            <textedit name="txtPlatitelj1" datavalue="" ></textedit>
          </item>
          <item caption=" " col="1" row="3" textposition="left" colspan="2">
            <textedit name="txtPlatitelj2" datavalue=""></textedit>
          </item>

          <item caption="Primatelj:" col="1" row="4" textposition="left" colspan="2">
            <searchedit name="srcPrimatelj" fieldvalue="PartneriId" fieldtext="Naziv" dataname="~dtSrcPrimatelj" datatext="~dtget.@PrimateljNaziv" datavalue="~dtget.@partneriId" required="true">
              <event type="valuechanged">
                <action if="#srcPrimatelj!=null">
                  <action type="datarun reader" value="~dtGetPrimatelj"></action>
                  <action type="control value" value="#txtPrimatelj1">
                    <parameter value ="~dtGetPrimatelj.@Adresa"/>
                  </action>
                  <action type="control value" value="#txtPrimatelj2">
                    <parameter value ="~dtGetPrimatelj.@Mjesto"/>
                  </action>
                  <action type="control populate" value="#cmbPartneriZiro"/>
                </action>
                <action else="">
                  <action type="control refreshvalue" value="#txtPrimatelj1,#txtPrimatelj2,#cmbPartneriZiro" />
                  <action type="control populate" value="#cmbPartneriZiro" />
                </action>
              </event>
            </searchedit>
          </item>
          <item caption=" " col="1" row="5" textposition="left" colspan="2">
            <textedit name="txtPrimatelj1" datavalue=""></textedit>
          </item>
          <item caption=" " col="1" row="6" textposition="left" colspan="2">
            <textedit name="txtPrimatelj2" datavalue=""></textedit>
          </item>

          <item caption="Model" col="3" row="1" textposition="left" colspan="1">
            <textedit name="txtPzvBrZad1" datavalue="~dtGet.@PzvBrZad1" format="[0-9]{2,2}" formattype="regex" maxlength="2"></textedit>
          </item>
          <item col="4" row="1" colspan="1" textposition="left" caption="Račun:" highlight="false" >
            <comboedit name="cmbNalogodavacZiro"  valuefield="ParziroId" displayfield="Racun" datavalue="~dtGet.@NalogodavacZiroId" dataname="~dtRacuniPlatitelj" allownull="false" required="true"></comboedit>
          </item>
          <item col="3" row="2" colspan="2" textposition="left" caption="Poziv na br. zaduženja:" highlight="false" >
            <textedit name="txtPzvBrZad2" datavalue="~dtGet.@PzvBrZad2" ></textedit>
          </item>


          <item caption="Model" col="3" row="4" textposition="left" colspan="1">
            <textedit name="txtPzvBrOd1" datavalue="~dtGet.@PzvBrOd1" format="[0-9]{2,2}" formattype="regex" maxlength="2" ></textedit>
          </item>

          <item col="4" row="4" colspan="1" textposition="left" caption="Račun:" highlight="false" >
            <comboedit name="cmbPartneriZiro"  valuefield="ParZiroId" displayfield="Racun" datavalue="~dtGet.@ParziroId"  dataname="~dtRacuniPrimatelj" allownull="false" required="true"></comboedit>
          </item>

          <item col="3" row="5" colspan="2" textposition="left" caption="Poziv na br. odobrenja:" highlight="false"  >
            <textedit name="txtPzvBrOd2" datavalue="~dtGet.@PzvBrOd2" ></textedit>
          </item>

          
          <!--opis plaćanja-->
          <item col="1" row="7" colspan="4" textposition="left" caption=" " highlight="false" >
          </item>
          <item col="3" row="8" colspan="2" textposition="left" caption="Opis plaćanja:" highlight="false" >
            <textedit name="txtSvrha1" datavalue="~dtGet.@Svrha1" ></textedit>
          </item>
          <item col="3" row="9" colspan="2" textposition="left" caption=" " highlight="false" >
            <textedit name="txtSvrha2" datavalue="~dtGet.@Svrha2" ></textedit>
          </item>
          <item col="3" row="10" colspan="2" textposition="left" caption=" " highlight="false" >
            <textedit name="txtSvrha3" datavalue="~dtGet.@Svrha3" ></textedit>
          </item>
          
          
        </group>        <!--kraj elementi-->

      </group>
      <!--kraj omotača-->
      

      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <action type="validate"/>
            <action if="$OOPVirmaniId==0">
              <action type="datarun reader" value="~dtUnos"></action>
              <action type="message" value="~dtUnos.@Poruka"></action>
              <action type="form close" if="~dtUnos.@Id==0"></action>
            </action>
            <action if="$OOPVirmaniId!=0">
              <action type="datarun reader" value="~dtIzmjena"></action>
              <action type="message" value="~dtIzmjena.@Poruka"></action>
              <action type="form close" if="~dtIzmjena.@Id==0"></action>
            </action>
          </event>
        </button>

        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceVirmaniAll" name="dtGet">
        <parameter name="@action" value="podaci_virman" type="string"/>
        <parameter name="@oopvirmaniid" value="$oopvirmaniid" type="int"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
      </data>

      <data command="spPlaceVirmaniAll" name="dtHeader">
        <parameter name="@action" value="virman_header" type="string"/>
        <parameter name="@oopid" value="$oopid" type="int"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
      </data>

      <data command="spPlaceVirmaniAll" name="dtUnos">
        <parameter name="@action" value="unos" type="string"/>
        <parameter name="@ssOperateriId" value="@@operateriid"/>
        <parameter name="@OOPId" value="$OOPId"/>
        <parameter name="@NalogodavacId" value="#srcPlatitelj"/>
        <parameter name="@NalogodavacZiroId" value="#cmbNalogodavacZiro"/>
        <parameter name="@NalogodavacZiro" value="#cmbNalogodavacZiro.@Racun"/>
        <parameter name="@PzvbrZad1" value="#txtPzvbrZad1"/>
        <parameter name="@Pzvbrzad2" value="#txtPzvbrzad2"/>
        <parameter name="@Svrha1" value="#txtSvrha1"/>
        <parameter name="@Svrha2" value="#txtSvrha2"/>
        <parameter name="@Svrha3" value="#txtSvrha3"/>
        <parameter name="@Partneriid" value="#srcPrimatelj"/>
        <parameter name="@ParZiroId" value="#cmbPartneriZiro"/>
        <parameter name="@PartneriZiro" value="#cmbPartneriZiro.@Racun"/>
        <parameter name="@PzvbrOd1" value="#txtPzvbrOd1"/>
        <parameter name="@PzvbrOd2" value="#txtPzvbrOd2"/>
        <parameter name="@Postotak" value="#txtPostotak"/>
        <parameter name="@OOPVrsteRacunaId" value="#cmbVrstaracuna"/>
        <parameter name="@OOPStavkeId" value="#cmbStavke"/>
        <parameter name="@Dodatak" value="#txtDodatak"/>
        <parameter name="@IznosTemplate" value="#txtIznos"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
      </data>

      <data command="spPlaceVirmaniAll" name="dtIzmjena">
        <parameter name="@action" value="izmjena" type="string"/>
        <parameter name="@ssOperateriId" value="@@operateriid"/>
        <parameter name="@OOPVirmaniId" value="$OOPVirmaniId"/>
        <parameter name="@NalogodavacId" value="#srcPlatitelj"/>
        <parameter name="@NalogodavacZiroId" value="#cmbNalogodavacZiro"/>
        <parameter name="@NalogodavacZiro" value="#cmbNalogodavacZiro.@Racun"/>
        <parameter name="@PzvbrZad1" value="#txtPzvbrZad1"/>
        <parameter name="@Pzvbrzad2" value="#txtPzvbrzad2"/>
        <parameter name="@Svrha1" value="#txtSvrha1"/>
        <parameter name="@Svrha2" value="#txtSvrha2"/>
        <parameter name="@Svrha3" value="#txtSvrha3"/>
        <parameter name="@Partneriid" value="#srcPrimatelj"/>
        <parameter name="@ParZiroId" value="#cmbPartneriZiro"/>
        <parameter name="@PartneriZiro" value="#cmbPartneriZiro.@Racun"/>
        <parameter name="@PzvbrOd1" value="#txtPzvbrOd1"/>
        <parameter name="@PzvbrOd2" value="#txtPzvbrOd2"/>
        <parameter name="@Postotak" value="#txtPostotak"/>
        <parameter name="@OOPVrsteRacunaId" value="#cmbVrstaracuna"/>
        <parameter name="@OOPStavkeId" value="#cmbStavke"/>
        <parameter name="@Dodatak" value="#txtDodatak"/>
        <parameter name="@IznosTemplate" value="#txtIznos"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
      </data>


      <data command="spPlaceVirmaniAll" name="dtBanka">
        <parameter name="@action" value="daj_banku_nasid" type="string"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtVrstaRacuna">
        <parameter name="@action" value="virmani_vrste_racuna" type="string"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtVrstaRacuna">
        <parameter name="@action" value="virmani_vrste_racuna" type="string"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtStavke">
        <parameter name="@action" value="daj_stavke_naknada" type="string"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtSrcPlatitelj">
        <parameter name="@action" value="partneri_virmani" type="string"/>
        <parameter name="@Tekst" value="#srcPlatitelj.text"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtSrcPrimatelj">
        <parameter name="@action" value="partneri_virmani" type="string"/>
        <parameter name="@Tekst" value="#srcPrimatelj.text"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtRacuniPlatitelj">
        <parameter name="@action" value="cmb_partneri_racuni" type="string"/>
        <parameter name="@partneriid" value="#srcPlatitelj" type="int"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtRacuniPrimatelj">
        <parameter name="@action" value="cmb_partneri_racuni" type="string"/>
        <parameter name="@partneriid" value="#srcPrimatelj" type="int"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtGetPlatitelj">
        <parameter name="@action" value="podaci_partner" type="string"/>
        <parameter name="@partneriid" value="#srcPlatitelj" type="int"/>
      </data>
      <data command="spPlaceVirmaniAll" name="dtGetPrimatelj">
        <parameter name="@action" value="podaci_partner" type="string"/>
        <parameter name="@partneriid" value="#srcPrimatelj" type="int"/>
      </data>
    </datalist>
  </form>



  <!--
  ****************************************************************
  FORMA ZA BRISANJE VIRMANA
  ****************************************************************
  -->

<form name="frmVirmanBrisi" caption ="Brisanje" saveformsize="false" fixedsize="true" version="1" showversion="true" width="500" height="150" >
    <event type="shown">

      <action if="$OOPVirmaniId==null">
        <action type="form close"></action>
      </action>
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati odabrani nalog?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="false">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->

            <action type="datarun reader" value="~dtBrisanje"/>
            <action type="message" value="~dtBrisanje.@Poruka"></action>
            <action type="control populate keepfocus" value="parent.#grdVirmani"/>
            <action type="form close" if="~dtBrisanje.@Id==0" />
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceVirmaniAll" name="dtBrisanje">
        <parameter name="@Action" value="brisanje" type="string"/>
        <parameter name="@OOPVirmaniId" value="$OOPVirmaniId"/>
      </data>
    </datalist>
  </form>
  
  
  <!-- forma za kopiranje naloga -->
<form name="frmVirmanKopiranje" caption="$caption" width="800" height="500" showversion="true"  version="1">
    <!-- <event type="init">
      <action type="datarun reader" value="~dtGridVrimani" />
    </event> -->
    <!-- <event type="load">
      <action type="control populate" value="#grdVirmani" > </action>
      <action if="#grdVirmani.rowcount==0">
        <action type="control disable" value="#btnIzmijeni,#btnBrisi"/>
      </action>
      <action else="#grdVirmani.rowcount==0">
        <action else="#grdVirmani.rowcount!=0" type="control enable" value="#btnIzmijeni,#btnBrisi"/>
      </action>
    </event> -->

    <layout>
      <group cols="1" rows="6" groupbordervisible="false">
        <item caption="" col="1" row="1" rowspan="5" textposition="left">
          <grid name="grdVirmani" key="OOPVirmaniId" dataname="~dtGridVrimani" savelayout="true" multiselect="true" showcheckboxes="true" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" showgrouppanel="false" autopopulate="true">
            
          </grid>
        </item>
		<item col="1" row="6" highlight="false">
			<checkedit caption="Prethodno obriši sve postojeće naloge" name="chkPrethodnoBrisi" value="false" />
		</item>
		
      </group>
      <!--kraj omotača-->
    </layout>

    <panelbuttons>
      <buttons>
		
        <button name="btnKopiraj" caption="Kopiraj">
          <event type="click">
            <action type="validate"/>
			<!-- <action type="message" value="kopiram {#grdVirmani.selectedids}" /> -->
            <action type="datarun reader" value="~dtKopiranje"></action>
			<action type="message" value="~dtKopiranje.@Poruka"></action>
			<action type="form close" if="~dtKopiranje.@Id==0"></action>
          </event>
        </button>
		
        <button name="btnOdustani" caption="ODUSTANI" dock="right" >
          <event type="click">
            <action type="form close" />
            <action type="control populate keepfocus" value="#grdVirmani"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spPlaceVirmaniAll" name="dtGridVrimani">
        <parameter name="@action" value="virmani_lista" type="string"/>
        <parameter name="@OOPId" value="$OOPId" type="int"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
        <parameter name="@indKopiranje" value="1" type="int"/>
        <parameter name="@ssOperateriId" value="@@operateriid" />
      </data>
	  
      <data command="spPlaceVirmaniAll" name="dtKopiranje">
        <parameter name="@action" value="kopiraj" type="string"/>
        <parameter name="@OOPId" value="$OOPId" type="int"/>
        <parameter name="@oopoznaka" value="$oopoznaka" type="string"/>
        <parameter name="@indPrethodnoPobrisi" value="1" if="#chkPrethodnoBrisi==true"/>
        <parameter name="@indPrethodnoPobrisi" value="0" else=""/>
        <parameter name="@lista" value="#grdVirmani.selectedids" type="string"/>
        <parameter name="@ssOperateriId" value="@@operateriid" />
      </data>
	  
    </datalist>
  </form>

</root>