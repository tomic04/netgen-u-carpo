				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>		
				<parameter name="@iznoporezivo" value="$iznosoporezivo" type="decimal"/>		
				<parameter name="@Postotak" value="#txtPostotak" type="decimal"/>	
