<root>
	<!--
  *******************************************************************************************
  FORMA ZA UNOS I IZMJENU DNEVNICE
  *******************************************************************************************
  -->
	<form name="frmDnevnice" caption="$caption" fixedsize="false" saveformlayout="false" width="500" height="500">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$ID!=0"/>
			<action type="datarun reader" value="~dtGetSNaloga"/>
			<action type="variable value">
				<parameter name="OrgShemaTrId" value="~dtGetSNaloga.@OrgShemaTrId" type="int"/>
			</action>
			<action type="variable value" value="global.OrgShemaTrId">
				<parameter value="~dtGetSNaloga.@OrgShemaTrId" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="DimenzijeId" value="~dtGetSNaloga.@dimenzijeid" type="int"/>
			</action>
			<action type="variable value" value="global.dimenzijeid">
				<parameter value="~dtGetSNaloga.@dimenzijeid" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="DatOdlaska" value="~dtGetSNaloga.@datodlaska"/>
			</action>
			<action type="variable value" value="global.DatOdlaska">
				<parameter value="~dtGetSNaloga.@datodlaska"/>
			</action>
			<action type="variable value">
				<parameter name="DatPovratka" value="~dtGetSNaloga.@datpovratka"/>
			</action>
			<action type="variable value" value="global.datpovratka">
				<parameter value="~dtGetSNaloga.@datpovratka"/>
			</action>
			<action type="variable value">
				<parameter name="satodlaska" value="~dtGetSNaloga.@satodlaska"/>
			</action>
			<action type="variable value" value="global.satodlaska">
				<parameter value="~dtGetSNaloga.@satodlaska"/>
			</action>
			<action type="variable value">
				<parameter name="satpovratka" value="~dtGetSNaloga.@satpovratka"/>
			</action>
			<action type="variable value" value="global.satpovratka">
				<parameter value="~dtGetSNaloga.@satpovratka"/>
			</action>
			<action type="variable value">
				<parameter name="datobracuna" value="~dtGetSNaloga.@datobracuna"/>
			</action>
			<action type="variable value" value="global.datobracuna">
				<parameter value="~dtGetSNaloga.@datobracuna"/>
			</action>
			<action type="variable value" value="cijenaneoporezivo">
				<parameter value="0" type="decimal"/>
			</action>
			<action type="variable value" value="iznosoporezivo">
				<parameter value="0" type="decimal"/>
			</action>
		</event>
		<event type="load">
			<action if="$ID==0">
				<action type="datarun reader" value="~dtDajTecaj">
					<action type="control value" value="#txtTecaj">
						<parameter value="~dtDajTecaj.@Tecaj"/>
					</action>
				</action>
				<action type="control value" value="#cmbJedTroska">
					<parameter value="global.$OrgShemaTrId"/>
				</action>
				<action type="control value" value="#cmbDimenzija">
					<parameter value="global.$dimenzijeid"/>
				</action>
				<action type="control value" value="#dtDatOdlaska">
					<parameter value="global.$DatOdlaska"/>
				</action>
				<action type="control value" value="#dtDatPovratka">
					<parameter value="global.$DatPovratka"/>
				</action>
				<action type="control value" value="#teSatOdlaska">
					<parameter value="global.$satodlaska"/>
				</action>
				<action type="control value" value="#teSatPovratka">
					<parameter value="global.$satpovratka"/>
				</action>
				<action type="control value" value="#datDatum">
					<parameter value="global.$datobracuna"/>
				</action>
				<action type="datarun reader" value="~dtDajCijenuDnevnice">
					<action type="control value" value="#txtcijenaval">
						<parameter value="~dtDajCijenuDnevnice.@cijenaval"/>
					</action>
					<action type="control value" value="#cmbValute">
						<parameter value="~dtDajCijenuDnevnice.@valuteid"/>
					</action>
					<action type="variable value" value="$cijenaneoporezivo">
						<parameter value="~dtDajCijenuDnevnice.@cijenaneoporezivo" type="decimal"/>
					</action>
				</action>
			</action>
		</event>
		<event type="shown">
			<action type="control value" value="#srcPartner">
				<parameter text="~dtGet.@PartnerNaziv" value="~dtGet.@partneriid"/>
			</action>
			<action type="control disable" value="#datDatum" if="global.$DatumNaStavci==0"/>
		</event>
		<layout>
			<group cols="5" rows="3" groupbordervisible="false" >
					 <columnsdefinition>
						<column position="1" size="24%"/>
						<column position="2" size="24%"/>
						<column position="3" size="24%"/>
						<column position="4" size="24%"/>
						<column position="5" size="4%"/>
					</columnsdefinition> 
					<item row="1" col="1" caption="Datum tečaja:" highlight="false" textposition="top" colspan="1">
						<dateedit name="datDatum" value="now"  datavalue="~dtGet.@Datum"/>
					</item>
					<item row="1" col="2" colspan="4">
					</item>
					
					<group caption="Podaci o vremenu" row="2" col="1" cols="5" rows="3" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
					
						<item row="1" col="1" caption="Datum odlaska:" highlight="false" textposition="top" colspan="1">
							<dateedit name="dtDatOdlaska" value="now"  datavalue="~dtGet.@DatOdlaska" controlref="#teSatOdlaska">
								<event type="onleave">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</dateedit>
						</item>
						<item row="1" col="2" caption="Vrijeme:" highlight="false" textposition="top" colspan="1">
							<timeedit name="teSatOdlaska" value="now" format="HH:mm" datavalue="~dtGet.@satodlaska">
								<event type="onleave">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</timeedit>
						</item>
						
						<item row="2" col="1" caption="Datum povratka:" highlight="false" textposition="top" colspan="1">
							<dateedit name="dtDatPovratka"  value="now" datavalue="~dtGet.@DatPovratka"  controlref="#teSatPovratka">
								<event type="onleave">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</dateedit>
						</item>
						<item row="2" col="2" caption="Vrijeme:" highlight="false" textposition="top" colspan="1">
							<timeedit name="teSatPovratka" value="now" format="HH:mm" datavalue="~dtGet.@satpovratka">
								<event type="onleave">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</timeedit>
						</item>
						<item row="2" col="3" caption="Uk. sati:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtSati"  datavalue="~dtGet.@brsati" format="n2" value="0" readonly="true"/>
						</item>
						<item row="3" col="1" caption="Broj dnevnica:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtBrDnevnica"  datavalue="~dtGet.@brdnevnica" format="n2" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
									</action>									
								</event>
									
							</textedit>
						</item>
						<item row="3" col="2"  highlight="false" textposition="top" colspan="1" padding="1,1,18,1">
							<checkedit name="chkIndDnevnice" caption="Ručni unos" datavalue="~dtGet.@inddnevnice"/>
						</item>
					
					</group>
					<group caption="Obračun" row="3" col="1" cols="5" rows="7" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
						<item row="1" col="1" caption="Vrsta dnevnice:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbVrstaDnevnice" valuefield="PNVrDnevnicaId" displayfield="Naziv"  dataname="~dtDnevnice" datavalue="~dtGet.@PNVrDnevnicaId" allownull="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajCijenuDnevnice">
										<action type="control value" value="#txtcijenaval">
											<parameter value="~dtDajCijenuDnevnice.@cijenaval"/>
										</action>
										<action type="control value" value="#cmbValute">
											<parameter value="~dtDajCijenuDnevnice.@valuteid"/>
										</action>
										<action type="variable value" value="$cijenaneoporezivo">
											<parameter value="~dtDajCijenuDnevnice.@cijenaneoporezivo" type="decimal"/>
										</action>
										
										
									</action>
									
								</event>
							</comboedit>
						</item>
						
						<item row="1" col="3" highlight="false" caption="Cijena:" >
							<textedit name="txtcijenaval"  datavalue="~dtGet.@cijenaval" format="n2" value="0" readonly="true">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
										<action type="variable value" value="$iznosoporezivo">
											<parameter value="~dtDajIznosDnevnice.@iznosoporezivo" type="decimal"/>
										</action>
									</action>									
								</event>
							</textedit>
						</item>
						<item row="2" col="1" caption="Valuta:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbValute" valuefield="valuteid" displayfield="naziv"  dataname="~dtValute" datavalue="~dtGet.@ValuteId" allownull="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajTecaj">
										<action type="control value" value="#txtTecaj">
											<parameter value="~dtDajTecaj.@Tecaj"/>
										</action>
									</action>
								</event>
							</comboedit>
						</item>
						<item row="2" col="3" caption="Tečaj:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtTecaj" format="n4" value="0" datavalue="~dtGet.@Tecaj">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						
						
						<item row="3" col="1" caption="Broj obroka:" highlight="false" textposition="top" colspan="1">
							<comboedit name="cmbVrObroka" valuefield="PNVrObrokaId" displayfield="Naziv"  dataname="~dtObroci" datavalue="~dtGet.@PNVrObrokaId" allownull="false">
								<fields>
									<field name="Naziv"></field>
									<field name="Postotak"></field>
								</fields>
								<event type="valuechanged">
									<action type="control value" value="#txtPostotak">
										<parameter value="#cmbVrObroka.@Postotak"/>
									</action>
									
								</event>
							</comboedit>
						</item>
						
						<item row="3" col="2" highlight="false" caption="Postotak:">
							<textedit name="txtPostotak"  datavalue="~dtGet.@Postotak" format="n2" value="100">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
										<action type="variable value" value="$iznosoporezivo">
											<parameter value="~dtDajIznosDnevnice.@iznosoporezivo" type="decimal"/>
										</action>
									</action>	
								</event>								
							</textedit>
						</item>
						
						<item row="3" col="3" highlight="false" caption="Iznos valuta:">
							<textedit name="txtiznosval"  datavalue="~dtGet.@iznosval" format="n2" value="0">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos" type="decimal"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="4" highlight="false" caption="Iznos u EUR">
							<textedit name="txtiznos"  datavalue="~dtGet.@Iznoskn" format="n2" value="0"/>
						</item>
						<item row="4" col="1" caption="Jedinica troška:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbJedTroska" valuefield="orgshemaid" displayfield="naziv"  dataname="~dtJedinicaTroska" datavalue="~dtGet.@OrgShemaTrId"/>
						</item>
						<item row="5" col="1" caption="Dimenzija:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbDimenzija" valuefield="dimenzijeid" displayfield="naziv"  dataname="~dtDimenzija" datavalue="~dtGet.@dimenzijeid"/>
						</item>
						<item row="6" col="1" caption="Partner:" highlight="false" colspan="4">
							<searchedit name="srcPartner" dataname="~dtPartner" fieldtext="Naziv" fieldvalue="partneriid">
							</searchedit>
						</item>
						<item row="7" col="1" caption="Napomena:" highlight="false" textposition="top" colspan="4">
							<textedit name="txtNapomena"  value="" datavalue="~dtGet.@Opis"/>
						</item>
					</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
					
						<!--<action type="message" value="#dtDatOdlaska"/>
						<action type="message" value="#dtDatPovratka"/>-->
						
						<action type="validate"/>
						
						<!-- izmjena -->
						<action if="$ID!=0">
							<!-- <action type="message" value="izmjena!!"/> -->
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
								<action type="form close"/> 
							</action>
							<action if="$indGreske==1">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
							</action>
						</action>
						
						<!-- unos -->
						<action if="$ID==0">
							
							<!-- <action type="message" value="unos!!"/> -->
							<action type="datarun reader" value="~dtUnos">
								<action if="$indGreske==0">
									<!-- <action type="message" value="$poruka"/> -->									
									
									 <action type="form close"/> 
								</action>
								<action if="$indGreske==1">
								</action>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPNDnevnice" name="dtGet">
				<parameter name="@action" value="dtGet"/>
				<parameter name="@pnnalozidetid" value="$ID"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPNDnevnice" name="dtGetSNaloga">
				<parameter name="@action" value="PodaciSNaloga"/>
				<parameter name="@pnnaloziid" value="$pnnaloziid"/>
				<parameter name="@indGreske.output.int"/>
			</data>
			<data command="spPNHelp" name="dtValute">
				<parameter name="@action" value="valute"/>
			</data>
			<data command="spPNHelp" name="dtJedinicaTroska">
				<parameter name="@action" value="orgshema_help"/>
			</data>
			<data command="spPNHelp" name="dtDimenzija">
				<parameter name="@action" value="dimenzije"/>
			</data>
			<data command="spPNHelp" name="dtNaciniPlacanja">
				<parameter name="@action" value="PNNaciniPlacanja"/>
			</data>
			<data command="spPNHelp" name="dtDnevnice">
				<parameter name="@action" value="vrdnevnice"/>
			</data>
			<data command="spPNHelp" name="dtIzracunSati">
				<parameter name="@action" value="izracun_sati"/>
				<parameter name="@vriodlaska_d" value="#dtDatOdlaska"/>
				<parameter name="@vripovratka_d" value="#dtDatPovratka"/>
			</data>
			<data command="spPNHelp" name="dtDajCijenuDnevnice">
				<parameter name="@action" value="dnevnice_cijena"/>
				<parameter name="@id" value="#cmbVrstaDnevnice"/>
				<parameter name="@datum" value="#datDatum"/>
			</data>
			<data command="spPNHelp" name="dtDajIznosDnevnice">
				<parameter name="@action" value="izracunaj_iznos_dnevnice_val"/>
				<parameter name="@brdnevnica" value="#txtBrDnevnica" type="decimal"/>
				<parameter name="@Postotak" value="#txtPostotak" type="decimal"/>				
				<parameter name="@cijenaval" value="#txtcijenaval" type="decimal"/>			
				<parameter name="@cijenaneoporezivo" value="$cijenaneoporezivo" type="decimal"/>			
			</data>
			<data command="spPNHelp" name="dtObroci">
				<parameter name="@action" value="vrobroka"/>
			</data>
			<data command="spPNHelp" name="dtPartner">
				<parameter name="@action" value="partneri"/>
				<parameter name="@tekst" value="#srcPartner.text"/>
			</data>
			<data command="spPNHelp" name="dtDajTecaj">
				<parameter name="@action" value="Tecaj"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
			</data>
			<data command="spPNHelp" name="dtDajIznos">
				<parameter name="@action" value="izracunaj_iznos"/>
				<parameter name="@tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
			</data>
			<data command="spPNDnevnice" name="dtUnos">
				<parameter name="@action" value="unos"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@PNNaloziDetId" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@PNVrDnevnicaId" value="#cmbVrstaDnevnice"/>
				<parameter name="@PNVrObrokaId" value="#cmbVrObroka"/>
				<parameter name="@DatOdlaska" value="#dtDatOdlaska" />
				<parameter name="@DatPovratka" value="#dtDatPovratka" />
				<parameter name="@satodlaska" value="#teSatOdlaska" />
				<parameter name="@satpovratka" value="#teSatPovratka" />
				<parameter name="@brsati" value="#txtSati" type="decimal"/>
				<parameter name="@brdnevnica" value="#txtBrDnevnica" type="decimal"/>
				<parameter name="@cijenaval" value="#txtcijenaval" type="decimal"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>		
				<parameter name="@iznoporezivo" value="$iznosoporezivo" type="decimal"/>		
				<parameter name="@Postotak" value="#txtPostotak" type="decimal"/>	
				<parameter name="@inddnevnice" value="1" if="#chkIndDnevnice==true"/>
				<parameter name="@inddnevnice" value="0" if="#chkIndDnevnice==false"/>		
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
			<data command="spPNDnevnice" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@PNNaloziDetId" value="$ID"/>
				<parameter name="@datum" value="#datDatum"/>
				<parameter name="@PNVrDnevnicaId" value="#cmbVrstaDnevnice"/>
				<parameter name="@PNVrObrokaId" value="#cmbVrObroka"/>
				<parameter name="@DatOdlaska" value="#dtDatOdlaska" />
				<parameter name="@DatPovratka" value="#dtDatPovratka" />
				<parameter name="@satodlaska" value="#teSatOdlaska" />
				<parameter name="@satpovratka" value="#teSatPovratka" />
				<parameter name="@brsati" value="#txtSati" type="decimal"/>
				<parameter name="@brdnevnica" value="#txtBrDnevnica" type="decimal"/>
				<parameter name="@cijenaval" value="#txtcijenaval" type="decimal"/>
				<parameter name="@valuteid" value="#cmbValute"/>
				<parameter name="@IznosVal" value="#txtIznosVal" type="decimal"/>
				<parameter name="@Tecaj" value="#txtTecaj" type="decimal"/>
				<parameter name="@Iznos" value="#txtIznos" type="decimal"/>		
				<parameter name="@iznoporezivo" value="$iznosoporezivo" type="decimal"/>		
				<parameter name="@Postotak" value="#txtPostotak" type="decimal"/>	
				<parameter name="@inddnevnice" value="1" if="#chkIndDnevnice==true"/>
				<parameter name="@inddnevnice" value="0" if="#chkIndDnevnice==false"/>	
				<parameter name="@pnnaciniplacanjaid" value="#cmbNaciniPlacanja"/>
				<parameter name="@orgshematrid" value="#cmbJedTroska"/>
				<parameter name="@dimenzijeid" value="#cmbDimenzija"/>
				<parameter name="@partneriid" value="#srcPartner"/>
				<parameter name="@opis" value="#txtNapomena"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>


<!--
  *******************************************************************************************
  FORMA ZA UNOS I IZMJENU DNEVNICE - KADAR
  *******************************************************************************************
  -->
	<form name="frmDnevniceKadar" caption="$caption" fixedsize="false" saveformlayout="false" width="500" height="500">
		<event type="init">
			<action type="datarun reader" value="~dtGet" if="$ID!=0"/>
			<action type="variable value" value="cijenaneoporezivo">
				<parameter value="0" type="decimal"/>
			</action>
			<action type="variable value" value="iznosoporezivo">
				<parameter value="0" type="decimal"/>
			</action>
		</event>
		<event type="load">
			<action if="$ID==0">
				<action type="datarun reader" value="~dtDajTecaj">
					<action type="control value" value="#txtTecaj">
						<parameter value="~dtDajTecaj.@Tecaj"/>
					</action>
				</action>
				<action type="datarun reader" value="~dtDajCijenuDnevnice">
					<action type="control value" value="#txtcijenaval">
						<parameter value="~dtDajCijenuDnevnice.@cijenaval"/>
					</action>
					<action type="control value" value="#cmbValute">
						<parameter value="~dtDajCijenuDnevnice.@valuteid"/>
					</action>
					<action type="variable value" value="$cijenaneoporezivo">
						<parameter value="~dtDajCijenuDnevnice.@cijenaneoporezivo" type="decimal"/>
					</action>
				</action>
			</action>
		</event>
		<event type="shown">
			<action type="control value" value="#srcPartner">
				<parameter text="~dtGet.@PartnerNaziv" value="~dtGet.@partneriid"/>
			</action>
			<action type="control disable" value="#datDatum" if="global.$DatumNaStavci==0"/>
		</event>
		<layout>
			<group cols="5" rows="3" groupbordervisible="false" >
					 <columnsdefinition>
						<column position="1" size="24%"/>
						<column position="2" size="24%"/>
						<column position="3" size="24%"/>
						<column position="4" size="24%"/>
						<column position="5" size="4%"/>
					</columnsdefinition> 
					<item row="1" col="1" caption="Datum tečaja:" highlight="false" textposition="top" colspan="1">
						<dateedit name="datDatum" value="now"  datavalue="~dtGet.@Datum"/>
					</item>
					<item row="1" col="2" colspan="4">
					</item>
					
					<group caption="Podaci o vremenu" row="2" col="1" cols="5" rows="2" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
					
						<item row="1" col="1" caption="Datum odlaska:" highlight="false" textposition="top" colspan="1">
							<dateedit name="dtDatOdlaska" value="now"  datavalue="~dtGet.@DatOdlaska" controlref="#teSatOdlaska">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</dateedit>
						</item>
						<item row="1" col="2" caption="Vrijeme:" highlight="false" textposition="top" colspan="1">
							<timeedit name="teSatOdlaska" value="now" format="HH:mm" datavalue="~dtGet.@satodlaska">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</timeedit>
						</item>
						
						<item row="2" col="1" caption="Datum povratka:" highlight="false" textposition="top" colspan="1">
							<dateedit name="dtDatPovratka" value="now"  datavalue="~dtGet.@DatPovratka"  controlref="#teSatPovratka">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</dateedit>
						</item>
						<item row="2" col="2" caption="Vrijeme:" highlight="false" textposition="top" colspan="1">
							<timeedit name="teSatPovratka" value="now" format="HH:mm" datavalue="~dtGet.@satpovratka">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtIzracunSati">
										<action type="control value" value="#txtSati">
											<parameter value="~dtIzracunSati.@brsati"/>
										</action>
										<action type="control value" value="#txtBrDnevnica">
											<parameter value="~dtIzracunSati.@brdnevnica"/>
										</action>
									</action>									
								</event>
							</timeedit>
						</item>
						<item row="2" col="3" caption="Uk. sati:" highlight="false" textposition="top" colspan="1">
							<textedit name="txtSati"  datavalue="~dtGet.@brsati" format="n2" value="0" readonly="true"/>
						</item>
						<item row="2" col="4" caption="Broj dnevnica:" highlight="false" textposition="top" colspan="1" >
							<textedit name="txtBrDnevnica"  datavalue="~dtGet.@brdnevnica" format="n2" value="0" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
									</action>									
								</event>
									
							</textedit>
						</item>
						<!--<item row="3" col="2"  highlight="false" textposition="top" colspan="1" padding="1,1,18,1">
							<checkedit name="chkIndDnevnice" caption="Ručni unos" datavalue="~dtGet.@inddnevnice"/>
						</item>-->
					
					</group>
					<group caption="Obračun" row="3" col="1" cols="5" rows="3" colspan="5" spacing="2,2,2,2">
						<columnsdefinition>
							<column position="1" size="24%"/>
							<column position="2" size="24%"/>
							<column position="3" size="24%"/>
							<column position="4" size="24%"/>
							<column position="5" size="4%"/>
						</columnsdefinition>
						<item row="1" col="1" caption="Vrsta dnevnice:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbVrstaDnevnice" valuefield="PNVrDnevnicaId" displayfield="Naziv"  dataname="~dtDnevnice" datavalue="~dtGet.@PNVrDnevnicaId" allownull="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajCijenuDnevnice">
										<action type="control value" value="#txtcijenaval">
											<parameter value="~dtDajCijenuDnevnice.@cijenaval"/>
										</action>
										<action type="control value" value="#cmbValute">
											<parameter value="~dtDajCijenuDnevnice.@valuteid"/>
										</action>
										<action type="variable value" value="$cijenaneoporezivo">
											<parameter value="~dtDajCijenuDnevnice.@cijenaneoporezivo" type="decimal"/>
										</action>
										
										
									</action>
									
								</event>
							</comboedit>
						</item>
						
						<item row="1" col="3" highlight="false" caption="Cijena:" >
							<textedit name="txtcijenaval"  datavalue="~dtGet.@cijenaval" format="n2" value="0" readonly="true" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
										<action type="variable value" value="$iznosoporezivo">
											<parameter value="~dtDajIznosDnevnice.@iznosoporezivo" type="decimal"/>
										</action>
									</action>									
								</event>
							</textedit>
						</item>
						<item row="2" col="1" caption="Valuta:" highlight="false" textposition="top" colspan="2">
							<comboedit name="cmbValute" valuefield="valuteid" displayfield="naziv"  dataname="~dtValute" datavalue="~dtGet.@ValuteId" allownull="false" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajTecaj">
										<action type="control value" value="#txtTecaj">
											<parameter value="~dtDajTecaj.@Tecaj"/>
										</action>
									</action>
								</event>
							</comboedit>
						</item>
						<item row="2" col="3" caption="Tečaj:" highlight="false" textposition="top" colspan="1" >
							<textedit name="txtTecaj" format="n4" value="0" datavalue="~dtGet.@Tecaj" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						
						
						<item row="1" col="3" caption="Broj obroka:" highlight="false" textposition="top" colspan="1">
							<comboedit name="cmbVrObroka" valuefield="PNVrObrokaId" displayfield="Naziv"  dataname="~dtObroci" datavalue="~dtGet.@PNVrObrokaId" allownull="false">
								<fields>
									<field name="Naziv"></field>
									<field name="Postotak"></field>
								</fields>
								<event type="valuechanged">
									<action type="control value" value="#txtPostotak">
										<parameter value="#cmbVrObroka.@Postotak"/>
									</action>
									
								</event>
							</comboedit>
						</item>
						
						<item row="3" col="2" highlight="false" caption="Postotak:">
							<textedit name="txtPostotak"  datavalue="~dtGet.@Postotak" format="n2" value="100" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznosDnevnice">
										<action type="control value" value="#txtiznosval">
											<parameter value="~dtDajIznosDnevnice.@Iznos"/>
										</action>
										<action type="variable value" value="$iznosoporezivo">
											<parameter value="~dtDajIznosDnevnice.@iznosoporezivo" type="decimal"/>
										</action>
									</action>	
								</event>								
							</textedit>
						</item>
						
						<item row="3" col="3" highlight="false" caption="Iznos valuta:">
							<textedit name="txtiznosval"  datavalue="~dtGet.@iznosval" format="n2" value="0" visible="false">
								<event type="valuechanged">
									<action type="datarun reader" value="~dtDajIznos">
										<action type="control value" value="#txtIznos">
											<parameter value="~dtDajIznos.@Iznos" type="decimal"/>
										</action>
									</action>
								</event>
							</textedit>
						</item>
						<item row="3" col="4" highlight="false" caption="Iznos u EUR">
							<textedit name="txtiznos"  datavalue="~dtGet.@Iznoskn" format="n2" value="0" visible="false"/>
						</item>
						<item row="2" col="1" caption="Jedinica troška:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbJedTroska" valuefield="orgshemaid" displayfield="naziv"  dataname="~dtJedinicaTroska" datavalue="~dtGet.@OrgShemaTrId"/>
						</item>
						<item row="5" col="1" caption="Dimenzija:" highlight="false" textposition="top" colspan="4">
							<comboedit name="cmbDimenzija" valuefield="dimenzijeid" displayfield="naziv"  dataname="~dtDimenzija" datavalue="~dtGet.@dimenzijeid" visible="false"/>
						</item>
						<item row="6" col="1" caption="Partner:" highlight="false" colspan="4">
							<searchedit name="srcPartner" dataname="~dtPartner" fieldtext="Naziv" fieldvalue="partneriid" visible="false">
							</searchedit>
						</item>
						<item row="3" col="1" caption="Napomena:" highlight="false" textposition="top" colspan="4">
							<textedit name="txtNapomena"  value="" datavalue="~dtGet.@Opis"/>
						</item>
					</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
					
						<!--<action type="message" value="#dtDatOdlaska"/>
						<action type="message" value="#dtDatPovratka"/>-->
						
						<action type="validate"/>
						
						<!-- izmjena -->
						<action if="$ID!=0">
							<!-- <action type="message" value="izmjena!!"/> -->
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
								<action type="form close"/> 
							</action>
							<action if="$indGreske==1">
								<!-- <action type="message" value="Uspješno spremljeno!"/> -->
								<!-- <action type="message" value="$poruka"/> -->
							</action>
						</action>
						
						<!-- unos -->
						<action if="$ID==0">
							
							<!-- <action type="message" value="unos!!"/> -->
							<action type="datarun reader" value="~dtUnos">
								<action if="$indGreske==0">
									<!-- <action type="message" value="$poruka"/> -->									
									
									 <action type="form close"/> 
								</action>
								<action if="$indGreske==1">
								</action>
							</action>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>

