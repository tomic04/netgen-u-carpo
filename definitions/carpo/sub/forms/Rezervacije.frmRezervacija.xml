<root>
	<form name="frmRezervacijaAzur" caption="Rezervacija" fixedsize="true" >
	
		<event type="load">
			<action type="control disable" value="#cmbSkladiste, #cmbTrgovina" />
		</event>
	
	
		<layout textposition="top" itemspadding="4">
			<group cols="1" rows="6">
				<item caption="Originalni dokument:" col="1" row="1" fontbold="true">
					<textedit name="txtDokument"  required="True"  />
				</item>	
				<item caption="Odgovorna osoba:" row="2" col="1">
					<comboedit name="cmbOsoba1" required="True" autopopulate="true"  valuefield="OsobeId" displayfield="Osoba" datavalue="Global.dtOdgovornaOsoba.@OsobeId" dataname="Global.dtOdgovornaOsoba">

					</comboedit>
				</item>
				<item caption="Skladište sa kojeg se rezervira:"  row="3" col="1">
					<comboedit name="cmbSkladiste1" required="True" autopopulate="true"  valuefield="SkladisteId" displayfield="Opis" datavalue="Global.dtSkladiste.@SkladisteId" dataname="Global.dtSkladiste">

					</comboedit>
				</item>
				<group caption="Rezervacija za:" cols="2" rows="3" col="1" row="4">
					<columnsdefinition>
						<column size="30" position="1" />
						<column size="100%" position="2" />
					</columnsdefinition>
					<item caption=" " col="1" row="1">
						<radioedit name="rdoPartner" value="true"  groupindex="1" function="srcPartner">
							<event type="checkedchanged">
								<action type="control enable" value="#srcPartner" if="#rdoPartner==true">
									<action type="control focus" value="#srcPartner" />
								</action>
								<action type="control disable" value="#cmbSkladiste, #cmbTrgovina" />
								<action type="control refreshvalue" value="#cmbSkladiste, #cmbTrgovina" />
							</event>
						</radioedit>
					</item>						
					<item caption="Partner" col="2" row="1" type="visible" value="false" >
						<searchedit  name="srcPartner" required="True" fieldtext="Partner3000" fieldvalue="PartneriId"  fontbold="true" dataname="dtSearchPartner">
							<event type="valuechanged">
							</event>
						</searchedit>
					</item>
					<item caption=" " col="1" row="2" >
						<radioedit name="rdoSkladiste" caption="" value="false"  groupindex="1" function="cmbSkladiste">
							<event type="checkedchanged">
								<action type="control enable" value="#cmbSkladiste" if="#rdoSkladiste==true">
									<action type="control focus" value="#cmbSkladiste" />
								</action>						
								<action type="control disable" value="#srcPartner, #cmbTrgovina" />
								<action type="control refreshvalue" value="#srcPartner, #cmbTrgovina" />
							</event>
						</radioedit>						
					</item>
					<item caption="Skladište:" col="2" row="2">
						<comboedit name="cmbSkladiste" required="True" autopopulate="true"  valuefield="SkladisteId" displayfield="Opis" datavalue="Global.dtSkladiste.@SkladisteId" dataname="dtSkladisteBezPrava" function="cmbSkladiste">

						</comboedit>
					</item>	
					<item caption=" " col="1" row="3" >
						<radioedit name="rdoTrgovina" caption="" value="false"  groupindex="1" function="cmbTrgovina">
							<event type="checkedchanged">
								<action type="control enable" value="#cmbTrgovina" if="#rdoTrgovina==true">
									<action type="control focus" value="#cmbTrgovina" />
								</action>						
								<action type="control disable" value="#srcPartner, #cmbSkladiste" />
								<action type="control refreshvalue" value="#srcPartner, #cmbSkladiste" />
							</event>
						</radioedit>						
					</item>
					<item caption="Trgovina:" col="2" row="3">
						<comboedit name="cmbTrgovina"  required="True" valuefield="trgovinaid" displayfield="naziv" datavalue="Global.dtTrgovina.@trgovinaid" dataname="Global.dtTrgovina" function="cmbTrgovina">

						</comboedit>
					</item>	
				</group>
				<item caption="Roba:" col="1" row="5">
					<searchedit name="srcRoba" fontsizedelta="1" fontbold="True" fieldtext="Roba3000" fieldvalue="RobaId" required="true" entermovenextcontrol="false" dataname="Global.dtSearchRoba" function="srcRoba">
						<action type="variable value" >
							<parameter name="RobaId" value="#srcRoba" type="int"/>
							<parameter name="NazivRobe" value="#srcRoba.@Naziv"/>
							<!--#srcRoba.@Naziv <parameter name="NazivRobe" value="#txtNaziv"/> -->
						</action>						
					</searchedit>
				</item>	
				<group  cols="2" rows="1" col="1" row="6">
					<item caption="Količina:" row="1" col="1">
						<textedit name="curKolicina" required="true" value="0" format="n2" datavalue="~dtDetQuery.@DevDug" />
					</item>	
					<item caption="Datum preuzimanja:" row="1" col="2">
						<dateedit name="datDatumdok" value="now" datavalue="#dtGet.@DatumDok" />
					</item>	
				</group>
			</group>			
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- <action type="validate" /> -->
						<action type="datarun scalar" value="~dtAdd">
							<parameter name="parent.$Noviid" />
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spProd_Rezervacije_Unos" name="dtAdd">
				<parameter name="@OrgDok" value="#txtDokument"/>
				<parameter name="@DatumRezervacije" value="#datDatumdok"/>	
				<parameter name="@DatumPreuzimanja" value="#datDatumdok"/>
				<parameter name="@OsobeId" value="#cmbOsoba1"/>
				<parameter name="@OperateriId" value="@@operateriid"/>
				<parameter name="@SkladisteId" value="#cmbSkladiste1"/>
				<parameter name="@PartneriId" value="#srcPartner" if="#rdoPartner==true"/>
				<parameter name="@PartneriId" value="null" else=""/>
				<parameter name="@Skladiste2Id" value="#cmbSkladiste" if="#rdoSkladiste==true"/>
				<parameter name="@Skladiste2Id" value="null" else="#"/>
				<parameter name="@TrgovineId" value="#cmbTrgovina" if="#rdoTrgovina==true"/>
				<parameter name="@TrgovineId" value="null" else=""/>
				<parameter name="@RobaId" value="#srcRoba"/>
				<parameter name="@kolicina" value="#curKolicina"/>
				<parameter name="@IndBrisanja" value="0"/>
			</data>
			<data command="spTraziPartneri" name="dtSearchPartner" >
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />			
			</data>
			<data command="spNG_Combo" name="dtSkladisteBezPrava">
				<parameter name="@Action" value="Skladiste"/>
				<parameter name="@Ind" value="1"/>
				<parameter name="@BezPrava" value="1"/>
			</data>
		</datalist>
    </form>
</root>