<root version="1.0.0.1">
	<form name="frmLegenda" type="master" caption="Legenda" width="600" height="200" statusbar="false">
		<event type="init"> 
			
		</event>
		<event type="load">	
			<action type="control populate" value="#grdLegenda"/>
		</event>
		<event type="shown">
			
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Legenda" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdLegenda"  multiselect="false" key="Status" showgrouppanel="false" showfooter="false" showautofilterrow = "false" savelayout="false">												
							<data command="spCRobnoStatusVPSkladisteQuery">
								<parameter name="@action" value="11"/>
							</data>
							<fields>	
								<field name="Status" caption="Status" showsum="true" fixwidth="40" />
								<field name="Opis" caption="Opis" />
							</fields>
							
							<styles>
								<!-- BOJANJE-->
								<style name="backgroundcolor" value="white" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==1" />
								<style name="backgroundcolor" value="red" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==2" />
								<style name="backgroundcolor" value="orange" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==3" />
								<style name="backgroundcolor" value="yellow" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==4" />
								<style name="backgroundcolor" value="olive" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==5" />	
								<style name="backgroundcolor" value="aqua" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==6" />		
								<style name="backgroundcolor" value="LightGreen" if="#grdLegenda.fieldname==Status&amp;&amp;#grdLegenda.cellvalue==7" />		
							</styles>	
							
						</grid>
					</item>
				</group>
			</group>	
		</layout>

		<datalist>

		</datalist>
	</form>
</root>