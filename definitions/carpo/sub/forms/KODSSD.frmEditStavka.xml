<root>

<!-- 03.02.2022. JVV promjena kod dtGet obustavu da uzima oopobustaveglaid jer je tako u proceduri -->
  <!--FORMA ZA UNOS/IZMJENU STAVKE-->

  <form name="frmEditStavka" caption ="$caption">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$OOPStavkeId!=null">
        <parameter name="Tip" value="~dtGet.@Tip"/>
      </action>
    </event>

    <event type="load">
      <action type="control disable" value="#btnOdnosneStavke,#btnZavisneStavke,#btnDodatneStavke" if="$Tip==Unos"/>
      <action type="control enable" value="#btnOdnosneStavke,#btnZavisneStavke,#btnDodatneStavke" else=""/>
      <action type="control disable" value="#btnPonisti" />
      <action type="control disable" value="#srcStavka,#btnKopirajStavku" if="$Tip==Izmjena"/>
      <action type="control enable" value="#srcStavka,#btnKopirajStavku" else=""/>
      <action type="control disable" value="#srcKODPrimici" if="#chkIndBruto==false"/>
      <action type="control enable" value="#srcKODPrimici" else=""/>
      <action type="control disable" value="#srcKODNeoporeziviPrimici" if="#chkIndBruto==true"/>
      <action type="control enable" value="#srcKODNeoporeziviPrimici" else=""/>
      <action type="control disable" value="#cbOpcinaPrebivanja" if="#chkIndJOPPDBezOpcinePrebivanja==true"/>
      <action type="control enable" value="#cbOpcinaPrebivanja" else=""/>
      <action type="control disable" value="#cbOpcinaRada" if="#chkIndJOPPDBezOpcineRada==true"/>
      <action type="control enable" value="#cbOpcinaRada" else=""/>
    </event>

    <layout>
      
      <!--omotač-->
      <group cols="1" rows="2" groupbordervisible="false">

        <group cols="6" rows="1" col="1" row="1" spacing="2,2,2,1">
				<columnsdefinition>
						<column position="1" size="15%"></column>
						<column position="2" size="15%"></column>
						<column position="3" size="20%"></column>
						<column position="4" size="20%"></column>
						<column position="5" size="15%"></column>
						<column position="6" size="15%"></column>
					</columnsdefinition>
          <item caption="Kopiraj sa stavke:" col="1" row="1" highlight="false" colspan="4" >
            <searchedit name="srcStavka" fieldvalue="OOPStavekeId" fieldtext="Naziv" dataname="~dtStavka" />
          </item>
          <item col="5" row="1">
            <button name="btnKopirajStavku"  caption="Popuni" type="add" >
              <event type="click">
                <action type="datarun reader" value="~dtPopuni" />
                <action type="control value" value="#txtNaziv">
                  <parameter value="~dtPopuni.@Naziv"/>
                </action>
                <action type="control value" value="#txtOznaka">
                  <parameter value="~dtPopuni.@Oznaka"/>
                </action>
                <action type="control value" value="#chkIndBruto">
                  <parameter value="~dtPopuni.@IndBruto"/>
                </action>
                <action type="control value" value="#chkIndUmirovljeno">
                  <parameter value="~dtPopuni.@Umirovljeno"/>
                </action>
                <action type="control value" value="#chkIndBezPoreza">
                  <parameter value="~dtPopuni.@IndBezPoreza"/>
                </action>
                <action type="control value" value="#chkIndZasticeni">
                  <parameter value="~dtPopuni.@IndZasticeni"/>
                </action>
                <action type="control value" value="#chkIndSati">
                  <parameter value="~dtPopuni.@IndSati"/>
                </action>
                <action type="control value" value="#rdoOpcija1">
                  <parameter value="~dtPopuni.@StvarniSati"/>
                </action>
                <action type="control value" value="#rdoOpcija2">
                  <parameter value="~dtPopuni.@ObrSati"/>
                </action>
                <action type="control value" value="#chkIndIznos">
                  <parameter value="~dtPopuni.@IndIznos"/>
                </action>
                <action type="control value" value="#chkIndMtr">
                  <parameter value="~dtPopuni.@IndMtr"/>
                </action>
                <action type="control value" value="#chkIndPostotak">
                  <parameter value="~dtPopuni.@IndPostotak"/>
                </action>
                <action type="control value" value="#chkIndBodovi">
                  <parameter value="~dtPopuni.@IndBodovi"/>
                </action>
                <action type="control value" value="#chkIndOrgShema">
                  <parameter value="~dtPopuni.@IndOrgShema"/>
                </action>
                <action type="control value" value="#chkIndRelacije">
                  <parameter value="~dtPopuni.@IndRelacije"/>
                </action>
                <action type="control value" value="#txtProcedura">
                  <parameter value="~dtPopuni.@Procedura"/>
                </action>
                <action type="control value" value="#srcKntPlanAIdDug">
                  <parameter value="~dtPopuni.@KntPlanAIdDug" text="~dtPopuni.@KontoDuguje"/>
                </action>
                <action type="control value" value="#srcKntPlanAIdPot">
                  <parameter value="~dtPopuni.@KntPlanAIdPot" text="~dtPopuni.@KontoPotrazuje"/>
                </action>
                <action type="control value" value="#srcPrimjenaMinPlace">
                  <parameter value="~dtPopuni.@PrimjenaMinPlacaId" text="~dtPopuni.@PMP_Oznaka"/>
                </action>
                <action type="control value" value="#txtKoeficijent">
                  <parameter value="~dtPopuni.@Koeficijent"/>
                </action>
                <action type="control value" value="#txtPrioritet">
                  <parameter value="~dtPopuni.@Prioritet"/>
                </action>
                <action type="control value" value="#srcObustava">
                  <parameter value="~dtPopuni.@ObustavaId" text="~dtPopuni.@ObustavaNaziv"/>
                </action>
                <action type="control value" value="#srcPrimjenaMinOsnoDop">
                  <parameter value="~dtPopuni.@PrimjenaMinOsnoDopId" text="~dtPopuni.@PMD_Oznaka"/>
                </action>
                <action type="control value" value="#srcKODOsiguranici">
                  <parameter value="~dtPopuni.@KODOsiguraniciId" text="~dtPopuni.@OS_TextId"/>
                </action>
                <action type="control value" value="#srcKODPrimici">
                  <parameter value="~dtPopuni.@KODPrimiciId" text="~dtPopuni.@KP_TextId"/>
                </action>
                <action type="control value" value="#srcKODNeoporeziviPrimici">
                  <parameter value="~dtPopuni.@KODNeoporeziviPrimiciId" text="~dtPopuni.@KNP_TextId"/>
                </action>
                <action type="control value" value="#cbPrviZadnjiMjesec">
                  <parameter value="~dtPopuni.@KODPrviZadnjiMjesecId" text="~dtPopuni.@KPZM_Naziv"/>
                </action>
                <action type="control value" value="#cbOpcinaPrebivanja">
                  <parameter value="~dtPopuni.@OpcinaPrebivanjaId" text="~dtPopuni.@OpcinaPrebivanja_Naziv"/>
                </action>
                <action type="control value" value="#chkIndJOPPDDani10">
                  <parameter value="~dtPopuni.@IndJOPPDDani10" />
                </action>
                <action type="control value" value="#cbRadnoVrijeme">
                  <parameter value="~dtPopuni.@HRVrsteRVId" text="~dtPopuni.@RadnoVrijeme_Naziv"/>
                </action>
                <action type="control value" value="#chkIndJOPPDBezOpcinePrebivanja">
                  <parameter value="~dtPopuni.@IndJOPPDBezOpcinePrebivanja" />
                </action>
                <action type="control value" value="#chkIndJOPPDSati2">
                  <parameter value="~dtPopuni.@IndJOPPDSati2" />
                </action>
                <action type="control value" value="#srcKODBeneficirani">
                  <parameter value="~dtPopuni.@KODBeneficiraniId" text="~dtPopuni.@KB_TextId"/>
                </action>
                <action type="control value" value="#srcKODNaciniIsplate">
                  <parameter value="~dtPopuni.@KODNaciniIsplateId" text="~dtPopuni.@KNI_TextId"/>
                </action>
                <action type="control value" value="#cbKODJOPPDRazdoblje">
                  <parameter value="~dtPopuni.@KODJOPPDRazdobljeId" text="~dtPopuni.@KR_Naziv"/>
                </action>
                <action type="control value" value="#txtPrioritetJOPPD">
                  <parameter value="~dtPopuni.@IndJOPPDPlaca17" />
                </action>
                <action type="control value" value="#chkIndJOPPDPlaca17">
                  <parameter value="~dtPopuni.@IndJOPPDPlaca17" />
                </action>
                <action type="control value" value="#cbOpcinaRada">
                  <parameter value="~dtPopuni.@OpcinaRadaId" text="~dtPopuni.@OpcinaRada_Naziv"/>
                </action>
                <action type="control value" value="#chkIndJOPPDBezOpcineRada">
                  <parameter value="~dtPopuni.@IndJOPPDBezOpcineRada" />
                </action>
                <action type="control value" value="#cmbVOP">
                  <parameter value="~dtPopuni.@OOPVOPId" />
                </action>
                <action type="control disable" value="#srcStavka,#btnKopirajStavku" />
                <action type="control enable" value="#btnPonisti" />
              </event>
            </button>
          </item>
          <item col="6" row="1">
            <button name="btnPonisti"  caption="Poništi" >
              <event type="click">
                <action type="form close"></action>
                <action type="form open" value="frmEditStavka"></action>
              </event>
            </button>
          </item>
        </group>
        
      <group cols="1" rows="4" col="1" row="2"  groupbordervisible="false">
        <!--gornja grupa-->
        <group col="1" row="1" cols="2" rows="1"  groupbordervisible="false">
          <columnsdefinition>
            <column size="60%" position="1" />
            <column size="40%" position="2" />
          </columnsdefinition>
          <!--opći podaci-->
          <group col="1" row="1" cols="5" rows="3"  groupbordervisible="true" caption="Opći podaci"  spacing="2,1,2,2">
            <columnsdefinition>
              <column size="20%" position="1" />
              <column size="20%" position="2" />
              <column size="20%" position="3" />
              <column size="20%" position="4" />
              <column size="20%" position="5" />
            </columnsdefinition>
            <item caption="Naziv:" col="1" row="1" highlight="False" colspan="5">
              <textedit name="txtNaziv" datavalue="~dtGet.@Naziv" required="true"/>
            </item>
            <item caption="Oznaka:" col="1" row="2"  highlight="False"  textposition="left" >
              <textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" required="true" maxlength="10"  />
            </item>
            <item col="2" row="2"  highlight="False" textposition="left" >
              <checkedit caption="Bruto stavka" name="chkIndBruto" datavalue="~dtGet.@IndBruto">
                <event type="valuechanged">
                  <action type="control disable" value="#srcKODPrimici" if="#chkIndBruto==false"/>
                  <action type="control enable" value="#srcKODPrimici" else=""/>
                  <action type="control disable" value="#srcKODNeoporeziviPrimici" if="#chkIndBruto==true"/>
                  <action type="control enable" value="#srcKODNeoporeziviPrimici" else=""/>
                </event>
              </checkedit>
            </item>
            <item caption="Vrsta osobnog primitka:" col="3" row="2"  highlight="False"  textposition="left"  colspan="3">
              <comboedit name="cmbVOP" dataname="dtcmbVOP" valuefield="OOPVOPId" displayfield="VOP_Naziv" datavalue="~dtGet.@OOPVOPId" datatext="~dtGet.@VOP_Naziv"/>
            </item>
            <item  col="1" row="3"  highlight="False" textposition="left">
              <checkedit caption="Umirovljeno" name="chkIndUmirovljeno" datavalue="~dtGet.@Umirovljeno"  />
            </item>
            <item  col="2" row="3"  highlight="False" textposition="left">
              <checkedit caption="Bez poreza" name="chkIndBezPoreza" datavalue="~dtGet.@IndBezPoreza"  />
            </item>
            <item  col="3" row="3"  highlight="False" textposition="left">
              <checkedit caption="Zaštićeno" name="chkIndZasticeni" datavalue="~dtGet.@IndZasticeni"  />
            </item>

          </group>
          <!--kraj opći podaci-->
          <!--opcije unosa 3 kolone-->
          <group col="2" row="1" cols="1" rows="2"  groupbordervisible="true"  caption="Opcije unosa" spacing="1,2,2,2">
            <!--prvi red-->
            <group col="1" row="1" cols="3" rows="1"  groupbordervisible="true">
              <item  col="1" row="1"  highlight="False" textposition="left">
                <checkedit caption="Sati" name="chkIndSati" datavalue="~dtGet.@IndSati"  />
              </item>
              <item col="2" row="1" caption="" highlight="False"  textposition="left">
                <radioedit name="rdoOpcija1" caption="Stvarni sati" value="true"  datavalue="~dtGet.@StvarniSati" />
              </item>
              <item col="3" row="1" highlight="False"  textposition="left">
                <radioedit name="rdoOpcija2" caption="Obračunski sati"  datavalue="~dtGet.@ObrSati"/>
              </item>


            </group>            <!--kraj prvi red-->

            <!--drugi red-->
            <group col="1" row="2" cols="3" rows="2"  groupbordervisible="true" >
              <item col="1" row="1"  highlight="False"  textposition="left">
                <checkedit caption="Iznos" name="chkIndIznos" datavalue="~dtGet.@IndIznos"  />
              </item>
              <item col="1" row="2"  highlight="False"  textposition="left">
                <checkedit caption="Mj. troška" name="chkIndMtr" datavalue="~dtGet.@IndMtr"  />
              </item>
              <item caption="Postotak:" col="3" row="1"  highlight="False"  textposition="left">
                <checkedit caption="Postotak" name="chkIndPostotak" datavalue="~dtGet.@IndPostotak"  />
              </item>
              <item col="2" row="1"  highlight="False"  textposition="left">
                <checkedit caption="Bodovi" name="chkIndBodovi" datavalue="~dtGet.@IndBodovi"  />
              </item>
              <item col="2" row="2"  highlight="False"  textposition="left">
                <checkedit caption="Org. jedinica" name="chkIndOrgShema" datavalue="~dtGet.@IndOrgShema"  />
              </item>
              <item col="3" row="2"  highlight="False"  textposition="left">
                <checkedit caption="Relacija" name="chkIndRelacije" datavalue="~dtGet.@IndRelacije"  />
              </item>

            </group>
          </group>
          <!--kraj opcije unosa-->
        </group>
        <!--kraj gornja grupe-->
        <!--donja grupa-->
        <group col="1" row="2" cols="2" rows="2"  groupbordervisible="true"  spacing="2,2,1,2" caption="Obračun"  alignmode="local" >
          <group col="1" row="1" cols="2" rows="3"  groupbordervisible="false">
            <item caption="Procedura:" col="1" row="1" highlight="False"  textposition="left" colspan="2">
              <textedit name="txtProcedura" datavalue="~dtGet.@Procedura"/>
            </item>
            <item caption="Duguje:" col="1" row="2" highlight="False"  textposition="left">
              <searchedit name="srcKntPlanAIdDug" fieldtext="Konto" fieldvalue="KntPlanAId" dataname="dtSrcKontoDug" required="false" datavalue="~dtGet.@KntPlanAIdDug" datatext="~dtGet.@KontoDuguje"/>
            </item>
            <item caption="Potražuje:" col="2" row="2" highlight="False"  textposition="left">
              <searchedit name="srcKntPlanAIdPot" fieldtext="Konto" fieldvalue="KntPlanAId" dataname="dtSrcKontoPot" required="false" datavalue="~dtGet.@KntPlanAIdPot" datatext="~dtGet.@KontoPotrazuje"/>
            </item>
            <item caption="Primjena min. plaće:" col="1" row="3"  highlight="False"  textposition="left" colspan="2">
              <!--<searchedit name="srcPrimjenaMinPlace" fieldtext="Oznaka" fieldvalue="OOPstavkePrimjenaMinId" dataname="dtSrcPrimjenaMinPlace" required="false" datavalue="~dtGet.@PrimjenaMinPlacaId" datatext="~dtGet.@PMP_Oznaka"/>-->
              <comboedit name="srcPrimjenaMinPlace" dataname="dtSrcPrimjenaMinPlace" valuefield="OOPstavkePrimjenaMinId" displayfield="Oznaka" datavalue="~dtGet.@PrimjenaMinPlacaId" datatext="~dtGet.@PMP_Oznaka"/>
            </item>
          </group>
          <group col="2" row="1" cols="2" rows="3"  groupbordervisible="false" >
            <item caption="Koeficijent:" col="1" row="1"  highlight="False"  textposition="left">
              <textedit name="txtKoeficijent" datavalue="~dtGet.@Koeficijent" required="true" format="n2" value="1"/>
            </item>
            <item caption="Prioritet:" col="2" row="1"  highlight="False"  textposition="left">
              <textedit name="txtPrioritet" datavalue="~dtGet.@Prioritet" tooltip="0 - bez prioriteta!" format="n0" type="int"  required="true" value="0"/>
            </item>
            <item caption="Obustava:" col="1" row="2"  highlight="False" textposition="left" colspan="2">
              <searchedit name="srcObustava" fieldtext="ObustavaNaziv" fieldvalue="ObustavaId" dataname="dtSrcObustave" required="false" datavalue="~dtGet.@oopobustaveglaid" datatext="~dtGet.@ObustavaNaziv"/>
            </item>
            <item caption="Primjena min. osnovice:" col="1" row="3"  highlight="False"  textposition="left"  colspan="2">
              <!--<searchedit name="srcPrimjenaMinOsnoDop" fieldtext="Oznaka" fieldvalue="OOPstavkePrimjenaMinId" dataname="dtSrcPrimjenaMinOsnoDop" required="false" datavalue="~dtGet.@PrimjenaMinOsnoDopId" datatext="~dtGet.@PMD_Oznaka"/>-->
              <comboedit name="srcPrimjenaMinOsnoDop" dataname="dtSrcPrimjenaMinOsnoDop" valuefield="OOPstavkePrimjenaMinId" displayfield="Oznaka" datavalue="~dtGet.@PrimjenaMinOsnoDopId" datatext="~dtGet.@PMD_Oznaka"/>
            </item>
          </group>


        </group>
        <!--kraj donja grupa-->
        <!--grupa JOPPD-->
        <group col="1" row="3" cols="4" rows="7"  groupbordervisible="true"  spacing="2,2,1,2" caption="JOPPD"  alignmode="local">
          <columnsdefinition>
            <column position="1" size="25%"></column>
            <column position="2" size="25%"></column>
            <column position="3" size="25%"></column>
            <column position="4" size="25%"></column>
          </columnsdefinition>
          <item caption="Osiguranik:" col="1" row="1" highlight="False" textposition="left" colspan="2">
            <searchedit name="srcKODOsiguranici" fieldtext="OS_TextId" fieldvalue="KODOsiguraniciId" dataname="dtSrcKODOsiguranici" required="false" datavalue="~dtGet.@KODOsiguraniciId" datatext="~dtGet.@OS_TextId"/>
          </item>
          <item caption="Primitak:" col="1" row="2" highlight="False"  textposition="left" colspan="2">
            <searchedit name="srcKODPrimici" fieldtext="KP_TextId" fieldvalue="KODPrimiciId" dataname="dtSrcKODPrimici" required="false" datavalue="~dtGet.@KODPrimiciId" datatext="~dtGet.@KP_TextId"/>
          </item>
          <item caption="Neoporezivi primitak:" col="1" row="3" highlight="False"  textposition="left" colspan="2">
            <searchedit name="srcKODNeoporeziviPrimici" fieldtext="KNP_TextId" fieldvalue="KODNeoporeziviPrimiciId" dataname="dtSrcKODNeoporeziviPrimici" required="false" datavalue="~dtGet.@KODNeoporeziviPrimiciId" datatext="~dtGet.@KNP_TextId"/>
          </item>
          <item caption="Prvi/zadnji mjesec:" col="1" row="4" highlight="False"  textposition="left">
            <comboedit name="cbPrviZadnjiMjesec" dataname="dtPrviZadnjiMjesec" valuefield="KODPrviZadnjiMjesecId" displayfield="Naziv" datavalue="~dtGet.@KODPrviZadnjiMjesecId" datatext="~dtGet.@KPZM_Naziv"/>
          </item>
          <item caption="Općina prebivanja:" col="1" row="5" highlight="False"  textposition="left">
            <comboedit name="cbOpcinaPrebivanja" dataname="dtOpcinaPrebivanja" valuefield="OOPMjestaPorezId" displayfield="Naziv" datavalue="~dtGet.@OpcinaPrebivanjaId" datatext="~dtGet.@OpcinaPrebivanja_Naziv"/>
          </item>
          <item col="1" row="6" highlight="False" >
            <checkedit caption="Prikaži dane u polju 10" name="chkIndJOPPDDani10" datavalue="~dtGet.@IndJOPPDDani10"  value="0"/>
          </item>
          <item caption="Radno vrijeme:" col="2" row="4" highlight="False"  textposition="left">
            <comboedit name="cbRadnoVrijeme" dataname="dtRadnoVrijeme" valuefield="HRVrsteRVId" displayfield="Naziv" datavalue="~dtGet.@HRVrsteRVId" datatext="~dtGet.@RadnoVrijeme_Naziv"/>
          </item>          
          <item col="2" row="5" highlight="False" >
            <checkedit caption="Fiksno bez općine prebivanja" name="chkIndJOPPDBezOpcinePrebivanja" datavalue="~dtGet.@IndJOPPDBezOpcinePrebivanja"  value="0">
              <event type="valuechanged">
                <action type="control disable" value="#cbOpcinaPrebivanja" if="#chkIndJOPPDBezOpcinePrebivanja==true"/>
                <action type="control enable" value="#cbOpcinaPrebivanja" else=""/>
              </event>
            </checkedit>
          </item>
          <item col="2" row="6" highlight="False" >
                <checkedit caption="Prikaži sate u polju 10.2" name="chkIndJOPPDSati2" datavalue="~dtGet.@IndJOPPDSati2"  value="0"/>
          </item>   
          <item caption="Beneficirani staž:" col="3" row="1"   highlight="False" textposition="left" colspan="2">
            <searchedit name="srcKODBeneficirani" fieldtext="KB_TextId" fieldvalue="KODBeneficiraniId" dataname="dtsrcKODBeneficirani" datavalue="~dtGet.@KODBeneficiraniId" datatext="~dtGet.@KB_TextId"/>
          </item>
          <item caption="Način plaćanja:" col="3" row="2"  highlight="False" textposition="left" colspan="2">
            <searchedit name="srcKODNaciniIsplate" fieldtext="KNI_TextId" fieldvalue="KODNaciniIsplateId" dataname="dtsrcKODNaciniIsplate" datavalue="~dtGet.@KODNaciniIsplateId" datatext="~dtGet.@KNI_TextId"/>
          </item>
          <item caption="Razdoblje:" col="3" row="3" highlight="False"  textposition="left" colspan="2">
            <!--<searchedit name="srcKODJOPPDRazdoblje" fieldtext="Opis" fieldvalue="KODJOPPDRazdobljeId" dataname="dtSrcKODJOPPDRazdoblje" required="false" datavalue="~dtGet.@KODJOPPDRazdobljeId" datatext="~dtGet.@KR_TextId"/>-->
              <comboedit name="cbKODJOPPDRazdoblje" dataname="dtKODJOPPDRazdoblje" valuefield="KODJOPPDRazdobljeId" displayfield="KR_Naziv" datavalue="~dtGet.@KODJOPPDRazdobljeId" datatext="~dtGet.@KR_Naziv"/>
          </item>
          <item caption="Prioritet JOPPD:" col="3" row="4" highlight="False"  textposition="left" >
            <textedit name="txtPrioritetJOPPD" datavalue="~dtGet.@KODJOPPDPrioritet" tooltip="Prioritet prilikom određivanja redosljeda obračuna!" format="n0" type="int" />
          </item>
          <item col="3" row="6" highlight="False">
                <checkedit caption="Prikaži plaću u polju 17" name="chkIndJOPPDPlaca17" datavalue="~dtGet.@IndJOPPDPlaca17" value="1"  />
          </item>
          <item caption="Općina rada:" col="3" row="5" highlight="False"  textposition="left">
            <comboedit name="cbOpcinaRada" dataname="dtOpcinaRada" valuefield="OOPMjestaPorezId" displayfield="Naziv" datavalue="~dtGet.@OpcinaRadaId" datatext="~dtGet.@OpcinaRada_Naziv"/>
          </item>
          <item col="4" row="5" highlight="False">
