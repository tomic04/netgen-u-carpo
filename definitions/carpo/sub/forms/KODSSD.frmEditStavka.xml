    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI">
          <event type="click">
            <!-- Provjeri required fields -->
            <action type="validate" />
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtSpremi"></action> />
            <action type="variable value">
              <parameter name="OOPStavkeId" value="~dtSpremi.@oopstavkeid"/>
            </action>
            <action type="message" value="~dtSpremi.@poruka" />

            <!-- Osvježi grid na parent formi -->
            <action type="control populate" value="parent.#grdStatusi"/>

            <action type="form close" if="$tip==Izmjena"/>
            <action type="datarun reader" value="~dtGet"></action>
            <action type="variable value">
              <parameter name="Tip" value="~dtGet.@tip"/>
            </action>
            <action type="control disable" value="#btnOdnosneStavke,#btnZavisneStavke,#btnDodatneStavke" if="$Tip==Unos"/>
            <action type="control enable" value="#btnOdnosneStavke,#btnZavisneStavke,#btnDodatneStavke" else=""/>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="control populate" value="parent.#grdStavke"/>
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

