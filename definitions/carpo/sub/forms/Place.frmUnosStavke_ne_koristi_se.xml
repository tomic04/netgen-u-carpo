<root>
  <!--FORMA ZA UNOS STAVKE PLAĆE-->

  <form name="frmUnosStavke" caption ="$caption" saveformsize="true" width="400" height="200">
    <event type="init">
        <!--uzmi pozicije za stavku-->

      
    </event>

    <event type="load">
      <action type="control value" value="#cmbStavke">
        <parameter value="global.$OOPStavkeUnosId"/>
      </action>
    </event>

    <event type="shown">

      
      <!--enejblaj/disejblaj kontrole-->
      <action type="control visible" value="#txtSati">
        <parameter value="false" if="global.$vSati==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtBodovi">
        <parameter value="false" if="global.$vBodovi==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtPostotak">
        <parameter value="false" if="global.$vPostotak==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtIznos">
        <parameter value="false" if="global.$vIznos==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtOrgShema">
        <parameter value="false" if="global.$vOrgShema==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtMtr">
        <parameter value="false" if="global.$vMtr==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtOd">
        <parameter value="false" if="global.$vOd==0"/>
        <parameter value="true" else=""/>
      </action>
      <action type="control visible" value="#txtDo">
        <parameter value="false" if="global.$vDo==0"/>
        <parameter value="true" else=""/>
      </action>



    </event>

    <layout>

      <!--omotač-->
      <group cols="1" rows="2" groupbordervisible="false">
        <group col="1" row="1" cols="1" rows="1" groupbordervisible="true">

          <item caption="Stavka:" col="1"  row="1" textposition="left">
            <comboedit name="cmbStavke"  valuefield="OOPStavekeId" displayfield="Naziv" dataname="~dtStavke" allownull="false">
              <event type="valuechanged">
                <!--na promjenu comba spremi ID stavke u global.$OOPStavkeUnosId-->
                <action type="variable value" value="global.$OOPStavkeUnosId" >
                  <parameter value="#cmbStavke"/>
                </action>
                <!--uzmi pozicije za odabranu stavku i spremi ih u globalne varijable kao i kod prvog podizanja forme-->
                <action type="datarun reader" value="~dtDajPozicije"/>

              
                <action type="variable value">
                  <parameter name="global.maxrbr" value="~dtDajPozicije.@maxrbr" />
                </action>
                <action type="variable value">
                  <parameter name="global.rSati" value="~dtDajPozicije.@rSati" />
                </action>
                <action type="variable value">
                  <parameter name="global.rBodovi" value="~dtDajPozicije.@rBodovi" />
                </action>
                <action type="variable value">
                  <parameter name="global.rPostotak" value="~dtDajPozicije.@rPostotak" />
                </action>
                <action type="variable value">
                  <parameter name="global.rIznos" value="~dtDajPozicije.@rIznos" />
                </action>
                <action type="variable value">
                  <parameter name="global.rOrgShema" value="~dtDajPozicije.@rOrgShema" />
                </action>
                <action type="variable value">
                  <parameter name="global.rMtr" value="~dtDajPozicije.@rMtr" />
                </action>
                <action type="variable value">
                  <parameter name="global.rOd" value="~dtDajPozicije.@rOd" />
                </action>
                <action type="variable value">
                  <parameter name="global.rDo" value="~dtDajPozicije.@rDo" />
                </action>

               <!--vidljivost kontrola-->
                <action type="variable value">
                  <parameter name="global.vSati" value="~dtDajPozicije.@vSati" />
                </action>
                <action type="variable value">
                  <parameter name="global.vBodovi" value="~dtDajPozicije.@vBodovi" />
                </action>
                <action type="variable value">
                  <parameter name="global.vPostotak" value="~dtDajPozicije.@vPostotak" />
                </action>
                <action type="variable value">
                  <parameter name="global.vIznos" value="~dtDajPozicije.@vIznos" />
                </action>
                <action type="variable value">
                  <parameter name="global.vOrgShema" value="~dtDajPozicije.@vOrgShema" />
                </action>
                <action type="variable value">
                  <parameter name="global.vMtr" value="~dtDajPozicije.@vMtr" />
                </action>
                <action type="variable value">
                  <parameter name="global.vOd" value="~dtDajPozicije.@vOd" />
                </action>
                <action type="variable value">
                  <parameter name="global.vDo" value="~dtDajPozicije.@vDo" />
                </action>

                <action type="form close"/>
                <action type="form open" value="frmUnosStavke" >
                  <parameter name="Caption" value="Unos stavke za {#grdPlace.@djelatnik}"/>
                  <!--proslijedi ju-->
                  <parameter name="OperateriId"  value="@@OperateriId" />
                  <parameter name="OOPObradeId" value="#tree.@Value" />
                </action>


              </event>
              
              
              
            </comboedit>
          </item>
          
        </group>

        <group col="1" row="2" cols="2" rows="global.$maxrbr" groupbordervisible="true">

          <item caption="Sati:" col="1" row="global.$rSati" textposition="left">
            <textedit name="txtSati" format="n2" textposition="left" />
          </item>
          <item caption="Bodovi:" col="1" row="global.$rBodovi" textposition="left">
            <textedit name="txtBodovi" format="n2" textposition="left" />
          </item>
          <item caption="Postotak:" col="1" row="global.$rPostotak" textposition="left">
            <textedit name="txtPostotak" format="n2" textposition="left" />
          </item>
          <item caption="Iznos:" col="1" row="global.$rIznos" textposition="left">
            <textedit name="txtIznos"  format="n2" textposition="left" />
          </item>
          <item caption="Org. jedinica:" col="1" row="global.$rOrgShema" textposition="left" colspan="2">
            <searchedit name="txtOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtsrcOrgShema" />
          </item>
          <item caption="Mtr:" col="1" row="global.$rMtr" textposition="left" colspan="2">
            <textedit name="txtMtr"  format="n2" textposition="left" />
          </item>
          <item caption="Od:" col="1" row="global.$rOd" textposition="left">
            <textedit name="txtOd"  format="n2" textposition="left" />
          </item>
          <item caption="Do:" col="2" row="global.$rOd" textposition="left">
            <textedit name="txtDo"  format="n2" textposition="left" />
          </item>

          </group>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="SPREMI" >
          
        </button>
        <button name="btnOdustani" caption="ODUSTANI" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlace_help" name="dtDajPozicije">
        <parameter name="@Action" value="daj_pozicije_za_unos_stavke" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopstavkeid" value="global.$OOPStavkeUnosId"/>
      </data>
      <data command="spPlace_help" name="dtStavke">
        <parameter name="@Action" value="cmb_stavke" type="string"/>
        <parameter name="@operateriid" value="@@operateriid"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS STAVKE PLAĆE-->
</root>