<root>
    <form name="frmFakturiraj" caption="Fakturiranje" width="" height="" fixedsize="">
		<event type="shown">
			<action type="datarun reader" value="~dtPopuniPolja">
				<action type="control value" value="#cmbOrgShema">
					<parameter value="#dtPopuniPolja.@OrgShemaId"/>
				</action>	
				<action type="control value" value="#srcOsobe">
					<parameter value="#dtPopuniPolja.@OsobeId" text="#dtPopuniPolja.@NazivOsobe"/>
				</action>
				<action type="control value" value="#cmbVrstaDok">
					<parameter value="#dtPopuniPolja.@VrstaDokId"/>
				</action>
				<action type="control value" value="#cmbNacPlac">
					<parameter value="#dtPopuniPolja.@ProNacinNaplateId"/>
				</action>
				<action type="control value" value="#datDatumDok">
					<parameter value="parent.#grdGlava.@DatumFakture"/>
				</action>		
			</action>				
		</event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="6" col="1" row="1" >
				<item caption="Datum dokumenta:" row="1" col="1">
					<dateedit name="datDatumDok" required="true" value="Now"/>
				</item>	
				<item caption="Način plaćanja:" row="2" col="1">
					<comboedit name="cmbNacPlac" valuefield="ProNacinNaplateId" displayfield="Opis" datavalue="#dtcmbNacPlac.@ProNacinNaplateId" dataname="dtcmbNacPlac" required="true"/>
				</item>	
				<item caption="Vrsta dokumenta:" row="3" col="1">
					<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" datavalue="#dtcmbVrstaDok.@VrstaDokId" dataname="dtcmbVrstaDok" required="true"/>
				</item>									
				<item caption="Org. shema:" row="4" col="1">
					<comboedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv" datavalue="#dtcmbOrgShema.@OrgShemaId" dataname="dtcmbOrgShema" required="true"/>
				</item>
				<item caption="Odgovorna osoba:" row="5" col="1">
					<searchedit name="srcOsobe" fieldtext="Osoba" fieldvalue="OsobeId" dataname="dtsrcOsobe" required="true"/>
				</item>		
				<item row="6" col="1" textposition="right" textalignmode="auto" >
					<checkedit name="chkInd" caption="Prenesi i stavke"/>
				</item>										
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnFakturiraj" caption="Fakturiraj">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtFakturiraj"/>						
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close"/>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spFaktureObracun_Fakturiraj" name="dtFakturiraj" timeout="60">
				<parameter name="@operateriid" value="@@OperateriId" />	
				<parameter name="@faktureobracunid" value="$FaktureObracunId" />	
				<parameter name="@datumdok" value="#datDatumDok" />	
				<parameter name="@ProNacinPlacanjaId" value="#cmbNacPlac" />	
				<parameter name="@orgshemaid" value="#cmbOrgShema" />	
				<parameter name="@osobeid" value="#srcOsobe" />	
				<parameter name="@indstavke" value="#chkInd" />	
				<parameter name="@vrstadokid" value="#cmbVrstaDok" />					
				<parameter name="@niz" value="parent.#grdGlava.selectedids.table" />
			</data>
			<data command="spNG_Combo" name="dtcmbNacPlac">
				<parameter name="@action" value="ProNacinNaplate"/>					
			</data>
			<data command="spNG_Combo" name="dtcmbOrgShema">
				<parameter name="@action" value="OrgShema"/>					
			</data>				
			<data command="spTraziOsobe" name="dtsrcOsobe">
				<parameter name="@action" value="NaseOsobe"/>					
				<parameter name="@Uvjet" value="#srcOsobe.text"/>					
			</data>
			<data command="spFaktureObracun_Popuni" name="dtPopuniPolja">
				<parameter name="@operateriid" value="@@OperateriId"/>									
			</data>
			<data command="spNG_Combo" name="dtcmbVrstaDok">
				<parameter name="@action" value="VrstaDok"/>	
				<parameter name="@id" value="2" />	
			</data>			
		</datalist>			
    </form>
</root>