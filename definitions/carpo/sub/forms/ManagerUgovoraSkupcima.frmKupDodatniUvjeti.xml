<root>
    <form name="frmKupDodatniUvjeti" caption="Dodatni uvjeti" fixedsize="true">
    <event type="oninit">
        <action type="datarun reader" value="~dtGet"/>
    </event>
    <event type="load">
        <action type="control value" value="#txtBonus" if="~dtGet.@Bonus!=null">
            <parameter value="~dtGet.@Bonus" />
        </action>
        <action type="control value" value="#txtCassa" if="~dtGet.@Cassa!=null">
            <parameter value="~dtGet.@Cassa" />
        </action>
        <action type="control value" value="#txtKamata" if="~dtGet.@Kamata!=null">
            <parameter value="~dtGet.@Kamata" />
        </action>
    </event>
        <layout  itemspadding="5" textposition="left">
            <group cols="1" rows="3" >
               <rowsdefinition>
					<row position="1" size="33%"></row>
					<row position="2" size="33%"></row>
					<row position="3" size="33%"></row>
				</rowsdefinition>
                <item row="1" col="1" caption="Bonus:">
                    <textedit name="txtBonus" caption="Bonus"/>
                </item>
                <item row="2" col="1" caption="Cassa:"> 
                    <textedit name="txtCassa" caption="Cassa"/> 
                </item>
                <item row="3" col="1" caption="Kamata:"> 
                    <textedit name="txtKamata" caption="Kamata"/> 
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnPrihvati" caption="Prihvati">
                    <event type="click">
                        <action type="datarun nonquery" value="~dtDodatniUvjeti" />
                        <action type="control populate" value="parent.#grdDetalj" />
                        <action type="form close" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_KupUgoIzmjena_DodatniUvjetiUnos" name="dtDodatniUvjeti">
                <parameter name="@Bonus" value="#txtBonus" />
                <parameter name="@Cassa" value="#txtCassa" />
                <parameter name="@Kamata" value="#txtKamata" />
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>
            <data command="spProd_KupUgoIzmjena_DodatniUvjetiGet" name="dtGet">
                <parameter name="@KupUgovoriGlaID" value="$KupUgovoriGlaID" />
            </data>
        </datalist>
    </form>
</root>