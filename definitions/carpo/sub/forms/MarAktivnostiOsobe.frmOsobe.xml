<root version="8.0.0.2">
	<form name="frmOsobe" caption="Izaberi osobe" savelayout="true" width="775" height="700" statusbar="true">
		<event type="load">
		</event>
		<event type="shown">
			<action type="footer text" value="Broj slogova: {#grdTab.rowcount}" />
		</event>
		<layout itemspadding="3">
			<group cols="1" rows="1" backgroundcolor="" groupbordervisible="false">
				<tabs row="1" col="1" padding="4" backgroundcolor="" rowspan="2">
					<group caption="Partneri" name="tabPartneri" cols="1" rows="1" col="1" row="1" groupbordervisible="true">
						<part name="prtMarAktivnostiPartneri" path="prtMarAktivnostiPartneri.xml">
						</part>
					</group>
					<group caption="Osobe" name="tabOsobe" cols="1" rows="1" col="1" row="1" groupbordervisible="false">
						<part name="prtMarAktivnostiOsobe" path="prtMarAktivnostiOsobe.xml">
						</part>
					</group>
					<group caption="Promet" name="tabPromet" cols="1" rows="1" col="1" row="1">
						<part name="prtMarAktivnostiPromet" path="prtMarAktivnostiPromet.xml">
						</part>
					</group>
					<group caption="Roba" name="tabRoba" cols="1" rows="1" col="1" row="1">
						<part name="prtMarAktivnostiRoba" path="prtMarAktivnostiRoba.xml">
						</part>
					</group>
				</tabs>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOsvjezi" caption="OSVJEŽI">
					<event type="click">
						<action type="datarun reader" value="~dtCheck" />
						<action type="variable value">
							<parameter name="Provjera" value="~dtCheck.@Provjera" type="int" />
						</action>
						<action type="datarun reader" value="~dtCheckRuc" />
						<action type="variable value">
							<parameter name="ProvjeraRuc" value="~dtCheckRuc.@Provjera" type="int" />
						</action>
						<action type="message" value="Neispravno zadana Neto vrijednost!" if="$Provjera==1" />
						<action type="message" value="Neispravno zadan RUC!" if="$ProvjeraRuc==1" />
						<action type="control populate" value="#grdTab" />
						<action type="control populate" value="#grdTabOsobe" />
						<action type="control populate" value="#grdTabPromet" />
						<action type="control populate" value="#grdTabRoba" />
						<action type="footer text" value="Broj slogova: {#grdTab.rowcount}" />
					</event>
				</button>
				<button name="btnDodaj" caption="PREBACI +">
					<event type="click">
						<action type="control foreachrow selected" value="#grdTab" if="$Tab==Partneri">
							<action type="datarun nonquery" value="~dtDodaj">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabOsobe" if="$Tab==Osobe">
							<action type="datarun nonquery" value="~dtDodaj">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabPromet" if="$Tab==Promet">
							<action type="datarun nonquery" value="~dtDodaj">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabRoba" if="$Tab==Roba">
							<action type="datarun nonquery" value="~dtDodaj">
							</action>
						</action>
						<action type="control populate" value="parent.#grdStavke" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOduzmi" caption="PREBACI -">
					<event type="click">
						<action type="control foreachrow selected" value="#grdTab" if="$Tab==Partneri">
							<action type="datarun nonquery" value="~dtOduzmi">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabOsobe" if="$Tab==Osobe">
							<action type="datarun nonquery" value="~dtOduzmi">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabPromet" if="$Tab==Promet">
							<action type="datarun nonquery" value="~dtOduzmi">
							</action>
						</action>
						<action type="control foreachrow selected" value="#grdTabRoba" if="$Tab==Roba">
							<action type="datarun nonquery" value="~dtOduzmi">
							</action>
						</action>
						<action type="control populate" value="parent.#grdStavke" />
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spMarAktivnostiCombo" name="dtDjelatnosti">
				<parameter name="@Action" value="2" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtKlPartneri">
				<parameter name="@Action" value="3" />
			</data>
			<data command="spTraziPartneri" name="dtSearchPartner">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@uvjet" value="#srcPartner.text" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbDrzave">
				<parameter name="@Action" value="4" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbZupanije">
				<parameter name="@Action" value="5" />
				<parameter name="@Id" value="#cmbDrzave" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbMjesta">
				<parameter name="@Action" value="6" />
				<parameter name="@Id" value="#cmbZupanije" />
				<parameter name="@Id1" value="#cmbDrzave" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtKlOsobe">
				<parameter name="@Action" value="7" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbPreTitule">
				<parameter name="@Action" value="10" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbOdjel">
				<parameter name="@Action" value="8" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbPosTitule">
				<parameter name="@Action" value="11" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCmbFunkcija">
				<parameter name="@Action" value="9" />
			</data>
			<data command="spMarAktTabSve" name="dtTab">
				<!-- TAB OSOBE -->
				<parameter name="@ko_key" value="" if="#cmbKlOsobe==null" />
				<parameter name="@ko_key" value="#cmbKlOsobe" else="" />
				<parameter name="@ko_ispod" value="#chkIspodKlOsobe" />
				<parameter name="@kf_key" value="" if="#cmbFunkcija==null" />
				<parameter name="@kf_key" value="#cmbFunkcija" else="" />
				<parameter name="@kf_ispod" value="#chkIspodFunkcije" />
				<parameter name="@mjestaid" value="0" if="#cmbMjestaOsobe==null" />
				<parameter name="@mjestaid" value="#cmbMjestaOsobe" else="" />
				<parameter name="@pretitleid" value="0" if="#cmbPreTitule==null" />
				<parameter name="@pretitleid" value="#cmbPreTitule" else="" />
				<parameter name="@postitleid" value="0" if="#cmbPosTitule==null" />
				<parameter name="@postitleid" value="#cmbPosTitule" else="" />
				<parameter name="@odjelid" value="0" if="#cmbOdjel==null" />
				<parameter name="@odjelid" value="#cmbOdjel" else="" />
				<parameter name="@keycontact" value=" " if="#chkKeyContact==false" />
				<parameter name="@keycontact" value="#chkKeyContact" else="" />
				<parameter name="@email" value="1" if="#chkPrivatni==True" />
				<parameter name="@email" value="2" if="#chkFirmin==True" />
				<parameter name="@email" value="3" if="#chkPoslovni==True" />
				<parameter name="@email" value="4" if="#chkBiloKoji==True" />
				<parameter name="@email" value="0" else="" />
				<!-- TAB PARTNER -->
				<parameter name="@kp_key" value="" if="#cmbKlPartner==null" />
				<parameter name="@kp_key" value="#cmbKlPartner" else="" />
				<parameter name="@kp_ispod" value="#chkIspod" />
				<parameter name="@djelatnostiid" value="0" if="#cmbDjelatnost==null" />
				<parameter name="@djelatnostiid" value="#cmbDjelatnost" else="" />
				<parameter name="@partneriid" value="0" if="#srcPartner==null" />
				<parameter name="@partneriid" value="#srcPartner" else="" />
				<parameter name="@pMjestaid" value="0" if="#cmbMjesta==null" />
				<parameter name="@pMjestaid" value="#cmbMjesta" else="" />
				<parameter name="@pZupanijeid" value="0" if="#cmbZupanije==null" />
				<parameter name="@pZupanijeid" value="#cmbZupanije" else="" />
				<parameter name="@pDrzaveid" value="0" if="#cmbDrzave==null" />
				<parameter name="@pDrzaveid" value="#cmbDrzave" else="" />
				<!-- TAB PRomet -->
				<parameter name="@Tab_Promet" value="#chkTabPromet" />
				<parameter name="@datOd_Promet" value="#datRazOdPromet" />
				<parameter name="@datDo_Promet" value="#datRazDoPromet" />
				<parameter name="@kr_key" value="" if="#cmbKlRobaPromet==null" />
				<parameter name="@kr_key" value="#cmbKlRobaPromet" else="" />
				<parameter name="@kr_ispod" value="#chkIspodKlRobaPromet" />
				<parameter name="@orgsh_key" value="" if="#cmbOrgShemaPromet==null" />
				<parameter name="@orgsh_key" value="#cmbOrgShemaPromet" else="" />
				<parameter name="@orgsh_ispod" value="#chkIspodOrgShemaPromet" />
				<parameter name="@curPrometOd" value="#txtVrijednostOd" if="#txtVrijednostOd!=null" />
				<parameter name="@curPrometOd" value="0" else="" />
				<parameter name="@curPrometDo" value="#txtVrijednostDo" if="#txtVrijednostDo!=null" />
				<parameter name="@curPrometDo" value="0" else="" />
				<parameter name="@curRUCOd" value="#txtRucOd" if="#txtRucOd!=null" />
				<parameter name="@curRUCOd" value="0" else="" />
				<parameter name="@curRUCDo" value="#txtRucDo" if="#txtRucDo!=null" />
				<parameter name="@curRUCDo" value="0" else="" />
				<!-- TAB Roba -->
				<parameter name="@Tab_Roba" value="#chkTabRoba" />
				<parameter name="@datOd_Roba" value="#datRazOdRoba" />
				<parameter name="@datDo_Roba" value="#datRazDoRoba" />
				<parameter name="@Robaid" value="0" if="#srcRoba==null" />
				<parameter name="@Robaid" value="#srcRoba" else="" />
				<parameter name="@kr_keyRoba" value="" if="#cmbKlRoba==null" />
				<parameter name="@kr_keyRoba" value="#cmbKlRoba" else="" />
				<parameter name="@kr_ispodRoba" value="#chkIspodKlRoba" />
				<parameter name="@orgsh_keyRoba" value="" if="#cmbOrgShemaRoba==null" />
				<parameter name="@orgsh_keyRoba" value="#cmbOrgShemaRoba" else="" />
				<parameter name="@orgsh_ispodRoba" value="#chkIspodOrgShemaRoba" />
				<parameter name="@TipProdajeRoba" value="1" if="#chkNuđeno==true" />
				<parameter name="@TipProdajeRoba" value="0" else="" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtTjedan">
				<parameter name="@Action" value="12" if="$Datum==1" />
				<parameter name="@Action" value="14" if="$Datum==2" />
				<parameter name="@Action" value="15" if="$Datum==3" />
				<parameter name="@Action" value="16" if="$Datum==4" />
				<parameter name="@Action" value="13" if="$Datum==5" />
				<parameter name="@Action" value="17" if="$Datum==6" />
				<parameter name="@Action" value="18" if="$Datum==7" />
				<parameter name="@Action" value="19" if="$Datum==8" />
				<parameter name="@Action" value="20" if="$Datum==9" />
				<parameter name="@Action" value="21" if="$Datum==10" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtKlRoba">
				<parameter name="@Action" value="22" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtOrgShema">
				<parameter name="@Action" value="23" />
			</data>
			<data command="spTraziRoba" name="dtRoba">
				<parameter name="@action" value="Roba" />
				<parameter name="@uvjet" value="#srcRoba.text" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtDodaj">
				<parameter name="@Action" value="0" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@PartneriId" value="#grdTab.@partneriid" if="$Tab==Partneri" />
				<parameter name="@PartneriId" value="#grdTabOsobe.@partneriid" if="$Tab==Osobe" />
				<parameter name="@PartneriId" value="#grdTabPromet.@partneriid" if="$Tab==Promet" />
				<parameter name="@PartneriId" value="#grdTabRoba.@partneriid" if="$Tab==Roba" />
				<parameter name="@LnOsoParId" value="#grdTab.@LnOsoParId" if="$Tab==Partneri" />
				<parameter name="@LnOsoParId" value="#grdTabOsobe.@LnOsoParId" if="$Tab==Osobe" />
				<parameter name="@LnOsoParId" value="#grdTabPromet.@LnOsoParId" if="$Tab==Promet" />
				<parameter name="@LnOsoParId" value="#grdTabRoba.@LnOsoParId" if="$Tab==Roba" />
				<parameter name="@OsobeId" value="#grdTab.@OsobeId" if="$Tab==Partneri" />
				<parameter name="@OsobeId" value="#grdTabOsobe.@OsobeId" if="$Tab==Osobe" />
				<parameter name="@OsobeId" value="#grdTabPromet.@OsobeId" if="$Tab==Promet" />
				<parameter name="@OsobeId" value="#grdTabRoba.@OsobeId" if="$Tab==Roba" />
			</data>
			<data command="spMarAktivnostiDetAzur" name="dtOduzmi">
				<parameter name="@Action" value="1" />
				<parameter name="@MarAktivnostiId" value="global.$MarAktivnostiId" />
				<parameter name="@PartneriId" value="#grdTab.@partneriid" if="$Tab==Partneri" />
				<parameter name="@PartneriId" value="#grdTabOsobe.@partneriid" if="$Tab==Osobe" />
				<parameter name="@PartneriId" value="#grdTabPromet.@partneriid" if="$Tab==Promet" />
				<parameter name="@PartneriId" value="#grdTabRoba.@partneriid" if="$Tab==Roba" />
				<parameter name="@LnOsoParId" value="#grdTab.@LnOsoParId" if="$Tab==Partneri" />
				<parameter name="@LnOsoParId" value="#grdTabOsobe.@LnOsoParId" if="$Tab==Osobe" />
				<parameter name="@LnOsoParId" value="#grdTabPromet.@LnOsoParId" if="$Tab==Promet" />
				<parameter name="@LnOsoParId" value="#grdTabRoba.@LnOsoParId" if="$Tab==Roba" />
				<parameter name="@OsobeId" value="#grdTab.@OsobeId" if="$Tab==Partneri" />
				<parameter name="@OsobeId" value="#grdTabOsobe.@OsobeId" if="$Tab==Osobe" />
				<parameter name="@OsobeId" value="#grdTabPromet.@OsobeId" if="$Tab==Promet" />
				<parameter name="@OsobeId" value="#grdTabRoba.@OsobeId" if="$Tab==Roba" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCheck">
				<parameter name="@Action" value="26" type="int" />
				<parameter name="@Vrijednost1" value="#txtVrijednostDo" />
				<parameter name="@Vrijednost2" value="#txtVrijednostOd" />
			</data>
			<data command="spMarAktivnostiCombo" name="dtCheckRuc">
				<parameter name="@Action" value="26" type="int" />
				<parameter name="@Vrijednost1" value="#txtRucDo" />
				<parameter name="@Vrijednost2" value="#txtRucOd" />
			</data>
		</datalist>
	</form>
</root>
