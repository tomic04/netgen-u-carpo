<root>
  <!--FORMA ZA OBRAČUN OBRADE-->

  <form name="frmBrisiDonosPomEvid" caption ="$caption" width="550" height="130" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="shown">
      <action type ="control value" value="#lblPitanje">
        <parameter value="Jeste li sigurni da želite obrisati donos iz pomoćne evidencije?"/>
      </action>
    </event>
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="true" >
        <item col="1" row="1"  highlight="False">
          <labeledit name="lblPitanje" fontsizedelta="2"  value=""  />
        </item>

      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnBrisi" caption="OBRIŠI" type="del">
          <event type="click">
            <!-- Okini storu -->
            <action type="datarun reader" value="~dtBrisanje"  waittype="progress" waitcaption="Pričekajte..." waittext="..brisanje u tijeku..."/>
            <action type="message" value ="Obrisan je donos iz pomoćne evidencije"/>
            <action type="form close" />
            
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel" >
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPUnosProknjizi" name="dtBrisanje">
        <parameter name="@action" value="1" type="int"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>