<root>
	<form name="frmUnesiIzmjeniNalog" caption="Unesi/Izmjeni nalog" width="500" savevalue="session">
		<event type="init">
			<action type="datarun reader" value="~dtUnIzPopuni" if="$KKvalGlaId!=null"/>
			<action type="datarun reader" value="~dtVrstaDok" if="$KKvalGlaId==null"/>
		<!-- 	<action type="datarun reader" value="~dtBrojDok" if="$KKvalGlaId==null" waittype="progress" waitcaption="Pričekajte..." waittext="..pretraga u tijeku..."/>
			
			 -->
				
			<!-- <action type="datarun reader" value="~dtsifra"/> -->
			<!-- <action type="datarun reader" value="~dtBrojDok"/> -->
			<!-- <action type="control value">
				<parameter name="srcRoba" value="~dtGetizDok.@robaid" />
			</action> -->
		</event>
		<event type="load">
			<action type="variable value" >
				<parameter name="vrstapromid" value="null"/>
			</action>
			<action type="datarun reader" value="~dtBrojDok" if="$KKvalGlaId==null" waittype="progress" waitcaption="Pričekajte..." waittext="..pretraga u tijeku..."/>
			
			<!-- <action type="datarun reader" value="~dtGetizDok" if ="$iddok!=null"/> -->
			<!-- <action type="control disable" value="#btnIzmjena" if="#srcBrojDok.==null" /> -->
		</event>
		<layout>
			<group rows="10" cols="4" >
				<group row="1" col="1" rows="1" cols="2" colspan="4" caption="Izvorni dokument">
					<item row="1" col="1"  caption="Vrsta dokumenta:" >
						<comboedit name="cmbVrstaDok" dataname="~dtVrstaDok" valuefield="VrstaPromId" 
									displayfield="VrstaDokumenta" datavalue="~dtUnIzPopuni.@lnVrstaPromId" datatext="~dtUnIzPopuni.@VrstaDokumenta">
							<event type="valuechanged" reiseonload="false">
								<action type="variable value" value="$vrstapromid">
									<parameter value="#cmbVrstaDok.@vrstapromid"/>
								</action>
							</event>
						</comboedit>
					</item>
					<item row="1" col="2" caption="Broj dokumenta:">
					<searchedit name="srcBrojDok" datavalue="~dtUnIzPopuni.@iddok" datatext="~dtUnIzPopuni.@brojDok" dataname="~dtBrojDok"
								 fieldvalue="iddok" fieldtext="BrojDok" > <!-- fieldvalue="Broj" jer mora upisati broj dokumenta a ne id dokumenta, datavalue="~dtUnIzPopuni.@brojdok" a ne lndokumentid jer treba upisati broj dok a ne id dok-->
						<event type="valuechanged" raiseonload="false"> <!-- waittype="progress" waitcaption="Pričekajte..." waittext="..traženje u tijeku..." -->
							<action type="variable value" value="$iddok">
								<parameter value="#srcBrojDok.@iddok"/>
							</action>
							
							<action  if="$vrstapromid==110">
								<action type="variable value" >
									<parameter name="idkkval" value="#srcBrojDok.brojdok" type="int"/>
								</action>
							</action>
							<action if="$vrstapromid==88||$vrstapromid==6||$vrstapromid==92">
								<action type="control value" value="#srcRoba">
									<parameter value="#srcBrojDok.@idroba" text="#srcBrojDok.@roba"/>
								</action>
								<action type="variable value" value="$robaid">
									<parameter value="#srcBrojDok.@idroba"/>
								</action>
								<action type="variable value" value="$iddok">
									<parameter value="#srcBrojDok.@idroba"/>
								</action>
								<action type="control value" value="#lbSifra">
									<parameter value="#srcBrojDok.@userkod"/>
								</action>
								<action type="control value" value="#cmbJM">
									<parameter value="#srcBrojDok.@jmid" text="#srcBrojDok.@jm"/>
								</action>
								<action type="control value" value="#txtkolicina">
									<parameter value="#srcBrojDok.@kolicina" />
								</action>
								<action type="control value" value="#cmbSkladiste">
									<parameter value="#srcBrojDok.@skladisteid" text="#srcBrojDok.@skladiste"/>
								</action>
								<action type="control value" value="#datRokTrajanja">
									<parameter value="#srcBrojDok.@roktrajanja" text="#srcBrojDok.@roktrajanja"/>
								</action>
								<action type="control value" value="#srcOrgShema">
									<parameter value="#srcBrojDok.@orgshemaid" text="#srcBrojDok.@orgshema"/>
								</action>
								<action type="control value" value="#srcProizvodac">
									<parameter value="#srcBrojDok.@PartneriId" text="#srcBrojDok.@proizvodjac"/>
								</action>
								<!-- <action type="datarun nonquery" value="~dtGetIzDok"/>	
								<action type="control value" value="#lbSifra">
									<parameter value="#srcBrojDok.@userkod"/>
								</action> -->
								<!-- <action type="control value" value="#txtBroj">
									<parameter value="~dtGetIzDok.@jmid" text="~dtGetIzDok.@jm"/>
								</action>  -->
							<!--</action> -->
							</action>
						</event>
					</searchedit>
					</item>
				</group>
				<item row="3" col="1" caption="Broj zahtjeva za analizu:">
					<textedit name="txtBrojZahAn" datavalue="~dtUnIzPopuni.@BrojZahtjeva" />
				</item>
				<item row="3" col="2" caption="Bar kod:">
					<textedit name="txtBarkod" datavalue="~dtUnIzPopuni.@Barcode" />
				</item>
				<item row="3" col="3" caption="Broj analize:">
					<textedit name="txtBrojAnalize" datavalue="~dtUnIzPopuni.@BrojAnalize"/>
				</item>
				<item row="3" col="4" caption="Datum dokumenta:">
					<dateedit name="datDatumDok" value="now" datavalue="~dtUnIzPopuni.@DatumDok" type="datetime"/>
				</item>
				
				<item row="4" col="1" caption="Kontingent?:" >
					<textedit readonly="true" name="txtBroj" datavalue="~dtUnIzPopuni.@Kontingent" value=""/> <!-- {broj+'/'+cast(right(serija,2)} -->
				</item>
				<item row="4" col="2" caption="Šifra robe:">
					<labeledit name="lbSifra" datavalue="~dtUnIzPopuni.@Sifra" dataname="$sifra"/>
				</item>
				<item row="4" col="3" colspan="2" caption="Roba:">
					<searchedit name="srcRoba" datavalue="~dtUnIzPopuni.@RobaId" datatext="~dtUnIzPopuni.@roba" 
								fieldtext="Naziv" fieldvalue="RobaId" required="true" dataname="~dtRoba"> <!-- dataname="~dtRoba" -->
						<event type="valuechanged" raiseonload="false"> 
							<action type="variable value" value="$idroba">
								<parameter value="#srcRoba.@RobaId"/>
							</action>
							<!-- <action type="datarun reader" value="~dtsifra"/> -->
							<action type="control value" value="#lbSifra">
								<parameter value="#srcRoba.@userkod"/>
							</action>
							<action type="control value" value="#cmbJM">
								<parameter value="#srcRoba.@jmid"/>
							</action>
							<action type="control value" value="#srcDobavljac">
								<parameter value="#srcRoba.@dobavljacid" text="#srcRoba.@dobavljac"/>
							</action>
							<action type="control value" value="#datRokTrajanja">
								<parameter value="#srcRoba.@roktrajanja"/>
							</action>
                        </event>
					</searchedit>
				</item>
				
				<item row="5" col="1" caption="Količina:">
					<textedit name="txtkolicina" datavalue="~dtUnIzPopuni.@Kolicina" format="n4" required="true"/>
				</item>
				<item row="5" col="2" caption="Pakovanje:" >
					<comboedit name="cmbJM" datavalue="~dtUnIzPopuni.@jmid" datatext="~dtUnIzPopuni.@jmnaziv" dataname="~dtJM" 
							   valuefield="JMId" displayfield="Naziv"/>			
				</item>
				<item row="5" col="3" caption="Rok trajanja:">
					<dateedit name="datRokTrajanja" datavalue="~dtUnIzPopuni.@RokTrajanja"/>
				</item>
				<item row="5" col="4"  caption="Odg. osoba:">
					<searchedit name="srcOsobe" datavalue="~dtUnIzPopuni.@osobeid" datatext="~dtUnIzPopuni.@OdgOsoba" dataname="~dtosobe"
						fieldtext="osobe" fieldvalue="osobeid" savevalue="session" required="true"/>
				</item>
				<!-- <item row="5" col="4" caption="Broj uzoraka:">
					<textedit name="txtbrUzoraka" datavalue="~dtUnIzPopuni.@BrojUzoraka" format="n0"/>
				</item> -->
				
				<item row="6" col="1" colspan="2" caption="Proizvođač:">
					<searchedit name="srcProizvodac" datavalue="~dtUnIzPopuni.@proizvodjacid" datatext="~dtUnIzPopuni.@Proizvodjac" dataname="~dtPartneri"
						fieldtext="proizvodjac" fieldvalue="proizvodjacid"/>
				</item>
				<item row="6" col="3" colspan="2" caption="Dobavljač:">
					<searchedit name="srcDobavljac" datavalue="~dtUnIzPopuni.@partneriid" datatext="~dtUnIzPopuni.@Dobavljac" dataname="~dtDobavljaci"
						fieldtext="dobavljac" fieldvalue="dobavljacid"/>
				</item>
				
				<item row="7" col="1" colspan="2" caption="Org. shema:">
					<searchedit name="srcOrgShema" datavalue="~dtUnIzPopuni.@OrgShemaid" datatext="~dtUnIzPopuni.@OrgShema" dataname="~dtOrgShema"
						fieldtext="Naziv" fieldvalue="orgshemaid" savevalue="session" required="true"/>
				</item>
				<item row="7" col="3" colspan="2" caption="Skladište:">
					<comboedit name="cmbSkladiste" datavalue="~dtUnIzPopuni.@skladisteid" datatext="~dtUnIzPopuni.@Skladiste" dataname="~dtSkladista"
						displayfield="skladiste" valuefield="skladisteid"/>
				</item>	
				
				<item row="8" col="1" colspan="3" caption="Opis:" textposition="left">
					<textedit name="txtOpis" datavalue="~dtUnIzPopuni.@opis" value=" " savevalue="session"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="&amp;Spremi" >
					<event type="click">
						<action type="validate"/>
						<action if="$KKvalGlaId==null">
							<action type="datarun scalar" value="~dtUnesiGla">
								<parameter name="idkkvalgla" value="$idkkvalgla" />
							</action>
							<action type="control populate" value="parent.#grdKKvalGla">
								<action type="control focus" value="parent.#grdKKvalGla">
								  <parameter value="$idkkvalgla" type="int" />
								</action>
							</action>
							<action type="datarun nonquery" value="~dtAddlndok"/>
							<action type="control populate" value="parent.#grdKKvalgla"/>
							
							<!-- ovo izbaciti kad se napravi uvođenje sa barkodom jer automatski dodaje jedan uzorak a nije potrebno jer će i taj prvi biti doveden barkodom -->
							<action type="datarun nonquery" value="~dtAddUz"/>
							<!--  -->
							<action type="control populate" value="parent.#grdKKvalDet"/>
							<action type="form close"/>
						</action>
						
						<action else="">
							<action type="datarun nonquery" value="~dtIzmjeniGla"/>
							<action type="control populate keepfocus" value="parent.#grdKKvalGla"/>
							<action type="form close"/>
						</action>

					</event>
				</button>
				<button caption="Odustani" dock="right" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtUnIzPopuni" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="popuni"/>
				<parameter name="@KKvalGlaId" value="$KKvalGlaId"/>
			</data>
			
			<data name="dtUnesiGla" command="spCarpoKKvalGlaAzur" >
				<parameter name="@action" value="addGla"/>
				<parameter name="@VrstaDokId" value="124"/>
				
				<parameter name="@BrojDok" value="#srcBrojDok.@brojdok" />
				<parameter name="@BrojZahtjeva" value="#txtBrojZahAn"/>
				<!-- <parameter name="@Barcode" value="#txtBarkod"/> -->
				<parameter name="@BrojAnalize" value="#txtBrojAnalize"/>
				<parameter name="@DatumDok" value="#datDatumDok"/>
				<parameter name="@RobaId" value="#srcRoba"/>
				<!-- <parameter name="@Broj" value="#txtBroj"/> -->
				<!-- <parameter name="@Sifra" value="#lbSifra"/> -->
				<!-- <parameter name="@kolicina" value="#txtkolicina"/> -->
				<parameter name="@JMId" value="#cmbJM"/>
				<parameter name="@RokTrajanja" value="#datRokTrajanja"/>
				<!-- <parameter name="@brojuzoraka" value="#txtbrUzoraka"/> -->
				<parameter name="@PartneriId" value="#srcDobavljac"/>
				<parameter name="@ProizvodjacId" value="#srcProizvodac"/>
				<parameter name="@OperateriId" value="global.@@operateriid"/>
				<parameter name="@OsobeId" value="#srcOsobe"/>
				<parameter name="@OrgShemaId" value="#srcOrgShema"/>
				<parameter name="@Status" value="0"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<!-- <parameter name="@KKvalStatusId" value="#srcOsobe"/> -->
				<!-- <parameter name="@PrnRadniNalogId" value="#srcOsobe"/> -->			
			</data>
			<data name="dtAddlndok" command="spKKvalLnDok">
				<parameter name="@action" value="0"/>
				<parameter name="@Kkvalglaid" value="$idkkvalgla"/>
				<parameter name="@VrstapromId" value="#cmbVrstaDok.@vrstapromid"/>
				<!-- <parameter name="@DokumentId" value="0" if="$vrstapromid==110" type="int"/> -->
				<parameter name="@DokumentId" value="#srcBrojDok.@iddok" />
				<parameter name="@Origin" value="1"/>
				<parameter name="@Broj" value="#srcBrojDok"/>   <!-- else=""/>	<parameter name="@Broj" value="0" if="$vrstapromid==110" type="int"/> -->
				<parameter name="@DokumentDetId" value="#srcBrojDok.@iddokdet" /> 
				<!-- <parameter name="@DokumentDetId" value=" " if="$vrstapromid==110||" type="int"/> -->
				<parameter name="@kolicina" value="#txtkolicina"/>			
			</data>
			
			<!-- spKKvalLnDok @action='0', @Kkvalglaid=236142, @VrstapromId=88, @Origin='1', @DokumentDetId=133381, @kolicina=1,0000 -->
			
			<!-- ovo izbaciti kad se napravi uvođenje sa barkodom jer automatski dodaje jedan uzorak a nije potrebno jer će i taj prvi biti doveden barkodom -->
			<data name="dtAddUz" command="spCarpoKKvalDetAzur">
				<parameter name="@action" value="addUzorak"/>
				<parameter name="@Kkvalglaid" value="$idkkvalgla"/>
			</data>
			
			<data name="dtIzmjeniGla" command="spCarpoKKvalGlaAzur" >
				<parameter name="@action" value="updateGla"/>
				<parameter name="@KKvalGlaId" value="$kkvalglaid"/>
				<!-- <parameter name="@VrstaDokId" value="#cmbVrstaDok"/> -->
				<!-- <parameter name="@BrojDok" value="#srcBrojDok"/> -->
				<!--  -->
				<!-- <parameter name="@Barcode" value="#txtBarkod"/> -->
				<parameter name="@BrojAnalize" value="#txtBrojAnalize"/>
				<parameter name="@BrojZahtjeva" value="#txtBrojZahAn"/>
				<parameter name="@DatumDok" value="#datDatumDok"/>
				<parameter name="@RobaId" value="#srcRoba"/>
				<!-- <parameter name="@Broj" value="#txtBroj"/> -->
				<!-- <parameter name="@Sifra" value="#lbSifra"/> -->
				<!-- <parameter name="@kolicina" value="#txtkolicina"/> -->
				<parameter name="@JMId" value="#cmbJM"/>
				<parameter name="@RokTrajanja" value="#datRokTrajanja"/>
				<!-- <parameter name="@Brojuzoraka" value="#txtbrUzoraka"/> -->
				<parameter name="@PartneriId" value="#srcDobavljac"/>
				<parameter name="@ProizvodjacId" value="#srcProizvodac"/>
				<parameter name="@OperateriId" value="global.@@operateriid"/>
				<parameter name="@OsobeId" value="#srcOsobe"/>
				<parameter name="@OrgShemaId" value="#srcOrgShema"/>
				<parameter name="@Status" value="0"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<!-- <parameter name="@KKvalStatusId" value="#srcOsobe"/> -->
				<!-- <parameter name="@PrnRadniNalogId" value="#srcOsobe"/> -->			
			</data>
			
			<data name="dtRoba" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="roba"/>
				<parameter name="@uvjet" value="#srcRoba.text"/>
			</data>
			<data name="dtSifra" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="sifra"/>
				<parameter name="@robaid" value="$robaid"/>
			</data>
			<!-- <data name="dtBroj" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="kontignet"/>
				<parameter name="@robaid" value="#srcRoba.@robaid"/>
			</data> -->
			<data name="dtVrstaDok" command="spCarpoKKvalQuery">
				<parameter name="@action" value="vrstadok"/>
			</data>

			<data name="dtBrojDok" command="spCarpoKKvalQuery">
				<!-- <parameter name="@Action" value="brojdokumenta"/> -->
				<parameter name="@Action" value="popuniIzRN" if="#cmbVrstaDok.@vrstapromid==88"/>
				<parameter name="@Action" value="popuniIzPP" elseif="#cmbVrstaDok.@vrstapromid==92"/>
				<parameter name="@Action" value="popuniIzPL" elseif="#cmbVrstaDok.@vrstapromid==6"/>
				<parameter name="@Action" value="idkkval" elseif="#cmbVrstaDok.@vrstapromid==110"/>
				<parameter name="@uvjet" value="#srcBrojDok.text"/>
				
			</data>
			<!-- <data name="dtGetIzDok" command="spCarpoKKvalQuery">
				<parameter name="@Action" value="getIzRN" if="#cmbVrstaDok.@vrstapromid==88"/>
				<parameter name="@Action" value="getIzPP" elseif="#cmbVrstaDok.@vrstapromid==77"/>
				<parameter name="@Action" value="getIzPL" esleif="#cmbVrstaDok.@vrstapromid==6"/>
				<parameter name="@iddok" value="$iddok"/>
			</data> -->
			
			<data name="dtJM" command="spCarpoKKvalQuery">
				<parameter name="@action" value="JM"/>
			</data>
			<data name="dtorgshema" command="spCarpoKKvalQuery">
				<parameter name="@action" value="orgshema"/>
				<parameter name="@uvjet" value="#srcOrgShema.text"/>
			</data>
			<data name="dtosobe" command="spCarpoKKvalQuery">
				<parameter name="@action" value="osobe"/>
				<parameter name="@uvjet" value="#srcOsobe.text"/>
			</data>
			<data name="dtskladista" command="spCarpoKKvalQuery">
				<parameter name="@action" value="getskladista"/>
			</data>
			<data name="dtPartneri" command="spCarpoKKvalQuery">
				<parameter name="@action" value="partneri"/>
				<parameter name="@uvjet" value="#srcProizvodac.text"/>
			</data>
			<data name="dtDobavljaci" command="spCarpoKKvalQuery">
				<parameter name="@action" value="dobavljaci"/>
				<parameter name="@uvjet" value="#srcDobavljac.text"/>
			</data>
		</datalist>
	</form>
</root>