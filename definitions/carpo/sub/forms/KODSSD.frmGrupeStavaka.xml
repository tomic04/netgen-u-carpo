<root>
  <form name="frmGrupeStavaka" type="master" caption="$caption"  width="800" height="500">
    <event type="load">
      <action type="control populate" value="#grdGrupe"/>
    </event>
    <layout textposition="left">
      <group cols="1" rows="2" groupbordervisible="false">
        
        <group cols="5" rows="1" col="1" row="1" spacing="2,2,2,1">
          <item col="1" row="1" caption="Grupa:" colspan="3">
            <textedit name="txtNaziv" required="true"/>
          </item>
          
          <item col="5" row="1" >
            <button name="btnSpremi"  caption="Spremi" type="add" >
              <event type="click">
                <action type="datarun reader" value="~dtSpremiGrupu">
                  <action type="message" value="~dtSpremiGrupu.@poruka" />
                </action>/>
                <action type="control populate" value="#grdGrupe" />
                <action type="control refreshvalue" value="#txtNaziv"/>
                <action type="control focus" value="#txtNaziv"/>
              </event>
            </button>
          </item>
        </group>
        
        <group cols="1" rows="1" col="1" row="2" spacing="2,2,1,2">
          <item col="1" row="1">
            <grid name="grdGrupe" dataname="dtGrupe" showautofilterrow="false" keyfield="oopstavkegrupeid">
              <fields inherited="true">
                <field name="Naziv" editable="true" />
              </fields>
              
              <event type="cellvaluechanged">
                <!--okidanje store-->
                <action type="datarun nonquery" value="~dtEditGrupe" />
                <!--nakon okidanja se pozicionira-->
                <action type="control populate keepfocus" value="#grdGrupe" />
              </event>
            </grid>
          </item>
        </group>
      </group>
    </layout>
    
    <panelbuttons>
      <buttons>
        
        <!--GUMB OBRIŠI-->
        <button name="btnBrisi" caption="Obriši" type="delete">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označenu grupu?">
              <action type="datarun reader" value="~dtDelete">
                <action type="message" value="~dtDelete.@poruka" />
                <action type="control populate keepfocus" value="#grdGrupe" />
              </action>
            </action>
            <action type="control populate" value="#grdGrupe"></action>
          </event>
        </button>
        <!--GUMB UNESI-->
        <button name="btnIzlaz" caption="Izlaz" type="cancel" dock="right">

        </button>


      </buttons>
    </panelbuttons>
    
    <datalist>
      <data command="spOOPStavkeGrupeCP" name="dtGrupe">
        <parameter name="@Action" value="grid" />
      </data>
      <data command="spOOPStavkeGrupeCP" name="dtSpremiGrupu">
        <parameter name="@Action" value="unos" />
        <parameter name="@Naziv" value="#txtNaziv" type="string"/>
      </data>
      <data command="spOOPStavkeGrupeCP" name="dtEditGrupe">
        <parameter name="@Action" value="izmjena" />
        <parameter name="@oopstavkegrupeid" value="#grdGrupe.@oopstavkegrupeid" />
        <parameter name="@Naziv" value="#grdGrupe.focusedvalue"/>
        <parameter name="@Kolona" value="#grdGrupe.focusedfield"/>
      </data>
      <data command="spOOPStavkeGrupeCP" name="dtDelete">
        <parameter name="@Action" value="brisanje" />
        <parameter name="@oopstavkegrupeid" value="#grdGrupe.@oopstavkegrupeid" />
      </data>
    </datalist>
  </form>

</root>