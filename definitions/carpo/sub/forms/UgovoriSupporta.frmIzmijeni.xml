<root>
	<form name="frmIzmijeni" caption="{$Korisnik}">
		<event type="init">
			<action type="datarun reader" value="~dtLoad"/>
		</event>
		<layout focusdirection="downthenacross">
			<group rows="6" cols="6">
				<item row="1" col="1" caption="Model proširenog supporta:">
					<comboedit name="cmbModelProsSupporta" dataname="~dtModelSupporta" valuefield="ModelSupporta" displayfield="Naziv" datavalue="~dtLoad.@suppModelProsId">
						<event type="valuechanged">
							<action type="datarun reader" value="~dtModelInfo"/>
							<action type="control value" value="#txtBrojSati">
								<parameter value="~dtModelInfo.@BrojSati"/>
							</action>
							<action type="control value" value="#txtPopust">
								<parameter value="~dtModelInfo.@Popust"/>
							</action>
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosProsSupp">
								<parameter value="~dtRacunaj.@IznosProsSupp"/>
							</action>
						</event>
					</comboedit>
				</item>
				<item row="2" col="1" caption="Cijena sata:">
					<textedit name="txtCijenaSata" datavalue="~dtLoad.@CijenaSata" format="n2">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosProsSupp">
								<parameter value="~dtRacunaj.@IznosProsSupp"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="3" col="1" caption="Broj sati u paketu:">
					<textedit name="txtBrojSati" datavalue="~dtLoad.@BrojSati">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosProsSupp">
								<parameter value="~dtRacunaj.@IznosProsSupp"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="4" col="1" caption="Popust na cijenu sata:">
					<textedit name="txtPopust" datavalue="~dtLoad.@Popust" format="n2">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosProsSupp">
								<parameter value="~dtRacunaj.@IznosProsSupp"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="5" col="1" caption="Iznos proširenog supporta:">
					<labeledit name="lblIznosProsSupp" datavalue="~dtLoad.@IznosProsSupp" format="n2"/>
				</item>
				<item row="1" col="2" caption="Osnovica LIC:">
					<labeledit name="lblOsnovicaLIC" datavalue="~dtLoad.@OsnovicaLIC" format="n2"/>
				</item>
				<item row="2" col="2" caption="Osnovica DB:">
					<labeledit name="lblOsnovicaDB" datavalue="~dtLoad.@OsnovicaDB" format="n2"/>
				</item>
				<item row="3" col="2" caption="Osnovica MP:">
					<labeledit name="lblOsnovicaMP" datavalue="~dtLoad.@OsnovicaMP" format="n2"/>
				</item>
				<item row="4" col="2" caption="Osnovica DEV:">
					<labeledit name="lblOsnovicaDEV" datavalue="~dtLoad.@OsnovicaDEV" format="n2"/>
				</item>
				<item row="5" col="2" caption="Ukupna vrijednost licence:">
					<labeledit name="lblOsnovica" datavalue="~dtLoad.@Osnovica" format="n2"/>
				</item>
				<item row="6" col="2" caption="Iznos za kritične p. procese:">
					<textedit name="txtIznosKPP" datavalue="~dtLoad.@IznosKPP" format="n2"/>
				</item>
				<item row="1" col="3" caption="Stopa LIC:">
					<textedit name="txtStopaLIC" datavalue="~dtLoad.@StopaLIC" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosLIC">
								<parameter value="~dtRacunaj.@IznosLIC"/>
							</action>
							<action type="control value" value="#lblIznos">
								<parameter value="~dtRacunaj.@Iznos"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="2" col="3" caption="Stopa DB:">
					<textedit name="txtStopaDB" datavalue="~dtLoad.@StopaDB" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosDB">
								<parameter value="~dtRacunaj.@IznosDB"/>
							</action>
							<action type="control value" value="#lblIznos">
								<parameter value="~dtRacunaj.@Iznos"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="3" col="3" caption="Stopa MP:">
					<textedit name="txtStopaMP" datavalue="~dtLoad.@StopaMP" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosMP">
								<parameter value="~dtRacunaj.@IznosMP"/>
							</action>
							<action type="control value" value="#lblIznos">
								<parameter value="~dtRacunaj.@Iznos"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="4" col="3" caption="Stopa DEV:">
					<textedit name="txtStopaDEV" datavalue="~dtLoad.@StopaDEV" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosLIC">
								<parameter value="~dtRacunaj.@IznosLIC"/>
							</action>
							<action type="control value" value="#lblIznos">
								<parameter value="~dtRacunaj.@Iznos"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="5" col="3" rowspan="2" caption="Opis za kritične p. procese:">
					<memoedit name="memOpis" datavalue="~dtLoad.@Opis"/>
				</item>
				<item row="1" col="4" caption="Iznos supporta LIC:">
					<labeledit name="lblIznosLIC" datavalue="~dtLoad.@IznosLIC" format="n2"/>
				</item>
				<item row="2" col="4" caption="Iznos supporta DB:">
					<labeledit name="lblIznosDB" datavalue="~dtLoad.@IznosDB" format="n2"/>
				</item>
				<item row="3" col="4" caption="Iznos supporta MP:">
					<labeledit name="lblIznosMP" datavalue="~dtLoad.@IznosMP" format="n2"/>
				</item>
				<item row="4" col="4" caption="Iznos supporta DEV:">
					<labeledit name="lblIznosDEV" datavalue="~dtLoad.@IznosDEV" format="n2"/>
				</item>
				<item row="5" col="4" caption="Iznos supporta:">
					<labeledit name="lblIznos" datavalue="~dtLoad.@Iznos" format="n2"/>
				</item>
				<item row="6" col="4" caption="Konačni iznos supporta:">
					<labeledit name="lblIznosFinal" datavalue="~dtLoad.@IznosFinal" format="n2"/>
				</item>
				<item row="1" col="5" caption="Stopa za IT nadzor:">
					<textedit name="txtStopaIT" datavalue="~dtLoad.@StopaIT" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosIT">
								<parameter value="~dtRacunaj.@IznosIT"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="2" col="5" caption="Iznos IT supporta:">
					<labeledit name="lblIznosIT" datavalue="~dtLoad.@IznosIT" format="n2"/>
				</item>
				<item row="3" col="5" caption="Stopa za SQL nadzor:">
					<textedit name="txtStopaSQL" datavalue="~dtLoad.@StopaSQL" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblIznosSQL">
								<parameter value="~dtRacunaj.@IznosSQL"/>
							</action>
							<action type="control value" value="#lblSupportUkupno">
								<parameter value="~dtRacunaj.@SupportUkupno"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="4" col="5" caption="Iznos SQL supporta:">
					<labeledit name="lblIznosSQL" datavalue="~dtLoad.@IznosSQL" format="n2"/>
				</item>
				<item row="5" col="5" caption="Sveukupno support:">
					<labeledit name="lblSupportUkupno" datavalue="~dtLoad.@SupportUkupno" format="n2"/>
				</item>
				<item row="6" col="5" caption="Rabat ukupno kn:">
					<labeledit name="lblRabatUkupnoKn" datavalue="~dtLoad.@RabatUkupnoKn" format="n2"/>
				</item>
				<item row="1" col="6" caption="Rabat vel.:">
					<labeledit name="lblRabatVel" datavalue="~dtLoad.@RabatVel" format="n4"/>
				</item>
				<item row="2" col="6" caption="Rabat loy.:">
					<labeledit name="lblRabatLoy" datavalue="~dtLoad.@RabatLoy" format="n4"/>
				</item>
				<item row="3" col="6" caption="Rabat admin.:">
					<textedit name="txtRabatAdmin" datavalue="~dtLoad.@RabatAdmin" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblRabatUkupnoP">
								<parameter value="~dtRacunaj.@RabatUkupnoP"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="4" col="6" caption="Rabat ref.:">
					<textedit name="txtRabatRef" datavalue="~dtLoad.@RabatRef" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblRabatUkupnoP">
								<parameter value="~dtRacunaj.@RabatUkupnoP"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="5" col="6" caption="Rabat dodatni:">
					<textedit name="txtRabatDodatni" datavalue="~dtLoad.@RabatDodatni" format="n4">
						<event type="leave">
							<action type="datarun reader" value="~dtRacunaj"/>
							<action type="control value" value="#lblRabatUkupnoP">
								<parameter value="~dtRacunaj.@RabatUkupnoP"/>
							</action>
							<action type="control value" value="#lblRabatUkupnoKn">
								<parameter value="~dtRacunaj.@RabatUkupnoKn"/>
							</action>
							<action type="control value" value="#lblIznosFinal">
								<parameter value="~dtRacunaj.@IznosFinal"/>
							</action>
						</event>
					</textedit>
				</item>
				<item row="6" col="6" caption="Rabat ukupno %:">
					<labeledit name="lblRabatUkupnoP" datavalue="~dtLoad.@RabatUkupnoP" format="n4"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
					
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtModelInfo" command="spUgovoriSupporta">
				<parameter name="@Action" value="MODEL INFO"/>
				<parameter name="@suppModelProsId" value="#cmbModelProsSupporta"/>
			</data>
			<data name="dtModelSupporta" command="spBugsSuppQueryCarpo">
				<parameter name="@Action" value="MODEL SUPPORTA"/>
			</data>
			<data name="dtLoad" command="spUgovoriSupporta">
				<parameter name="@Action" value="LOAD"/>
				<parameter name="@suppKorSuppId" value="$SuppKorSuppId"/>
			</data>
			<data name="dtRacunaj" command="spUgovoriSupporta">
				<parameter name="@Action" value="RACUNAJ"/>
				<parameter name="@stopaLIC" value="#txtStopaLIC"/>
				<parameter name="@stopaDB" value="#txtStopaDB"/>
				<parameter name="@stopaMP" value="#txtStopaMP"/>
				<parameter name="@stopaDEV" value="#txtStopaDEV"/>
				<parameter name="@stopaITsupport" value="#txtStopaIT"/>
				<parameter name="@stopaSQLsupport" value="#txtStopaSQL"/>
				<parameter name="@rabatAdmin" value="#txtRabatAdmin"/>
				<parameter name="@rabatRef" value="#txtRabatRef"/>
				<parameter name="@rabatDodatni" value="#txtRabatDodatni"/>
				<parameter name="@cijenaSata" value="#txtCijenaSata"/>
				<parameter name="@brojSati" value="#txtBrojSati"/>
				<parameter name="@popust" value="#txtPopust"/>
				<parameter name="@suppKorSuppId" value="$SuppKorSuppId"/>
			</data>
		</datalist>
	</form>
</root>