<root version="1.0.0.1">
<!--19.5.2020. AA zamjena bojanih polja HD 55458-->
	<form name="frmLegenda" type="master" caption="Legenda" width="600" height="250" statusbar="false">
		<event type="init"> 

		</event>
		<event type="load">	
			<action type="control populate" value="#grdLegenda"/>
		</event>
		<event type="shown">	
		</event>

		<layout itemspadding="2" >
			<group cols="1" rows="1" groupbordervisible="false">
				<group caption="Legenda" padding="0" groupbordervisible="false" cols="1" rows="1" col="1" row="1">
					<item row="1" col="1" highlight="False" >
						<grid name="grdLegenda"  multiselect="false" key="Status" showgrouppanel="false" showfooter="false" showautofilterrow = "false" savelayout="false">												
							<data command="spC_Robno_StatusUlDok">
								<parameter name="@action" value="legenda"/>
							</data>
							<fields>	
								<field name="Status" caption="Status" />
								<field name="opis" caption="Opis" />
							</fields>
							
							<styles>
								<!-- BOJANJE-->
								<style name="backgroundcolor" value="white" if="#grdLegenda.fieldname==Opis&amp;&amp;#grdLegenda.@Status==1" />
								<style name="backgroundcolor" value="red" if="#grdLegenda.fieldname==Opis&amp;&amp;#grdLegenda.@Status==2" />
								<style name="backgroundcolor" value="blue" if="#grdLegenda.fieldname==Opis&amp;&amp;#grdLegenda.@Status==3" />
								<style name="backgroundcolor" value="yellow" if="#grdLegenda.fieldname==Opis&amp;&amp;#grdLegenda.@Status==4" />
								<style name="backgroundcolor" value="green" if="#grdLegenda.fieldname==Opis&amp;&amp;#grdLegenda.@Status==5" />								
							</styles>	
							
						</grid>
					</item>
				</group>
			</group>	
		</layout>

		<datalist>

		</datalist>
	</form>
</root>