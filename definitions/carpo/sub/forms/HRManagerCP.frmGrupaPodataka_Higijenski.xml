<root>
	<!--
  Komentari:
  4.11.2025. MP - PERMISSION -> FUNCTION NAME
  09.11.2021. Jadranka Vučenović Vojvodić - kreirala sub formu za unos i izmjenu.
  -->
	<form name="frmHigijenski" caption="Pregledi za {parent.#txtPrezime} {parent.#txtIme}" width="400" height="250" fixedsize="true">
				<event type="init">
<action type="datarun reader" value="~dtGetHigijenski" if="$HRKadroviId!=0" />
		</event>
		<event type="shown">
		<!-- AKO JE IZMIJENA, POPUNI KONTROLE-->
			<action if="$Tip=='Izmjena'">
			<action type="control disable" value="#dtDatumSK" if="~dtGetHigijenski.@DatumOvjereSK==null"></action>
			<action type="control disable" value="#dtDatumHM" if="~dtGetHigijenski.@DatumPolaganjaHM==null"></action>
			<action type="control disable" value="#dtDatumLjP" if="~dtGetHigijenski.@DatumLijecnickog==null"></action>
			<action type="control disable" value="#dtDatumZNR" if="~dtGetHigijenski.@DatumIspita==null"></action>
			
			<action if="~dtGetHigijenski.@DatumOvjereSK==null">
					<action type="control value" value="#dtDatumSK" >
						<parameter value="now" />
					</action>
				</action>
			<action if="~dtGetHigijenski.@DatumPolaganjaHM==null">
					<action type="control value" value="#dtDatumHM" >
						<parameter value="now" />
					</action>
				</action>
			<action if="~dtGetHigijenski.@DatumLijecnickog==null">
					<action type="control value" value="#dtDatumLjP" >
						<parameter value="now" />
					</action>
				</action>
			<action if="~dtGetHigijenski.@DatumIspita==null">
					<action type="control value" value="#dtDatumZNR" >
						<parameter value="now" />
					</action>
				</action>
			</action>
		</event>
		<layout>
		<group cols="1" rows="4" groupbordervisible="true" spacing="2,2,2,2">

			<item row="1" col="1" caption="Datum ovjere sanitarne knjižice:" highlight="false" textposition="left">
					<dateedit name="dtDatumSK" value="now" allownull="true" datavalue="~dtGetHigijenski.@DatumOvjereSK">
					</dateedit>
				</item>
				<item row="2" col="1" caption="Datum polaganja higijenskog minimuma:" highlight="false" textposition="left">
					<dateedit name="dtDatumHM" value="now" allownull="true" datavalue="~dtGetHigijenski.@DatumPolaganjaHM">
					</dateedit>
				</item>
				<item row="3" col="1" caption="Datum važenja liječničkog pregleda:" highlight="false" textposition="left">
					<dateedit name="dtDatumLjP" value="now" allownull="true" datavalue="~dtGetHigijenski.@DatumLijecnickog">
					</dateedit>
				</item>
				<item row="4" col="1" caption="Datum polaganja ispita zaštite na radu:" highlight="false" textposition="left">
					<dateedit name="dtDatumZNR" value="now" allownull="true" datavalue="~dtGetHigijenski.@DatumIspita">
					</dateedit>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<!-- BUTTON SPREMI-->
				<button name="btnSpremi" caption="Spremi" dock="left" function="SPREMI_HIGIJENSKI">
					<event type="click">
						<action type="validate"/>
						
						<action if="$HRKadroviId!=0">
							<action type="datarun reader" value="~dtIzmjena"/>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!"/>
								<action type="control populate" value="parent.#grdPodaci"/>
								<!-- setiraj globalnu varijablu koju će se postavljati na child formama a ovisno o vrijednosti pozivati refresh grida
		  ovime se omogućuje da se ne troši vrijeme na refresh ako child forma nije ništa odradila -->
								<action type="variable value" value="global.$RefreshajMaster">
									<parameter value="1" type="int"/>
								</action>
								<action type="form close"/>
							</action>
						</action>
					</event>
				</button>
				<!-- BUTTON ODUSTANI-->
				<button name="btnOdustani" caption="Odustani" dock="right" type="cancel">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
		<data command="spHRManagerMaster_Podaci_Higijenski_CP" name="dtGetHigijenski">
				<parameter name="@action" value="getHigijenski" />
				<parameter name="@HRKadroviId" value="$HRKadroviId" type="int"/>
			</data>
			<data  command="spHRManagerMaster_Podaci_Higijenski_CP" name="dtIzmjena">
				<parameter name="@action" value="izmjena"/>
				<parameter name="@HRKadroviId" value="$HRKadroviId"/>
				<parameter name="@DatumOvjereSK"  value="#dtDatumSK" />
				<parameter name="@DatumPolaganjaHM"  value="#dtDatumHM" />
				<parameter name="@DatumLijecnickog" value="#dtDatumLjP"/>
				<parameter name="@DatumIspita"  value="#dtDatumZNR" />
				<parameter name="@indGreske.output.int"/>
			</data>
		</datalist>
	</form>
</root>