<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmManPlanKontoUnos" type="master" caption="Plan {$Tekst}" statusbar="false">
    <event type="init">
      <action type="datarun reader" value="Global.dtGet" if="$Ind_Unos==0"/>
      <action type="datarun reader" value="dtGodine" else=""/>
    </event> 
    <event type="shown">
      <action type="control value" value="#txtGodina" if="$Ind_Unos==1">
        <parameter value="~dtGodine.@TekucaGodina"/>
      </action>
       <action type="control value" value="#txtGodina" else="">
        <parameter value="~dtGet.@Godina"/>
      </action>
        
      <action type="control value" value="#txtRefGodina" if="$Ind_Unos==1">
        <parameter value="~dtGodine.@RefGodina" />
      </action>
       <action type="control value" value="#txtRefGodina" else="">
        <parameter value="~dtGet.@RefGodina"/>
       
      </action>
      
      <action type="control value" value="#txtRefGodina" if="$Ind_Unos==1">
        <parameter value="~dtGodine.@RefGodina" />
      </action>
       <action type="control value" value="#txtRefGodina" else="">
        <parameter value="~dtGet.@RefGodina"/>
      </action>
        
  </event>    
    <layout textposition="left" itemspadding="3">
      <group cols="4" rows="4" col="1" row="1">
        <item caption="Naziv:" row="1" col="1" colspan="4">
          <textedit name="txtNaziv" required="false" value="" datavalue="~dtGet.@Naziv" readonly="false"/>
        </item>
        <item caption="Godina:" row="2" col="1"  colspan="2">
          <textedit name="txtGodina" required="false" value="" type="int" datavalue="~dtGet.@Godina" readonly="false"/>
        </item>
        <item caption="Referentna godina:" row="3" col="1"  colspan="2">
          <textedit name="txtRefGodina" required="false" value=""  type="int" datavalue="~dtGet.@RefGodina"/>
        </item>
        <item caption="Referentni plan:" row="4" col="1" colspan="4">
          <comboedit name="cmbRefPlan" valuefield="ManPlanKontoGlaRefId" displayfield="Naziv" datavalue="#dtGet.@ManPlanKontoGlaRefId" dataname="dtRefPlan"/>
        </item>       
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <!--<action type="validate"/>-->

            <action type="datarun scalar" value="~dtInsert" if="$Ind_Unos==1">
              <parameter name="parent.$NoviManPlanKontoGlaId" />
            </action>
            
            <action type="datarun nonquery" value="dtUpdate" if="$Ind_Unos==0"/>
            
            <action type="form close"/>
            
            <action type="control populate" value="parent.#grdGlava">
              <action type="control focus" value="parent.#grdGlava" if="$Ind_Unos==1">
                <parameter value="parent.$NoviManPlanKontoGlaId" />
              </action>
            
              <action type="control focus" value="parent.#grdGlava" if="$Ind_Unos==0">
                 <parameter value="$ManPlanKontoGlaId" />
               </action>
            </action>
            
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spManPlanKontoGlaRefKontrole" name="dtRefPlan">
        <parameter name="@kontrola" value="cbRefPlan" />
        <parameter name="@id" value="null" if="$ManPlanKontoGlaId==null"/>
        <parameter name="@id" value="$ManPlanKontoGlaId" else=""/>
        <parameter name="@indunos" value="$Ind_Unos"/>
      
      </data>
      <data command="spManPlanKontoGlaRefKontrole" name="dtGodine">
        <parameter name="@kontrola" value="txtGodina" />
        <parameter name="@id" value="$ManPlanKontoGlaId" />
      </data>
      <data command="spManPlanKontoGlaAzur" name="dtUpdate">
        <parameter name="@action" value="izmjena"/>
        <parameter name="@id" value="$ManPlanKontoGlaId"/>
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Godina" value="#txtGodina" type="int"/>
        <parameter name="@GodinaRef" value="#txtRefGodina" type="int"/>
        <parameter name="@ManPlanKontoGlaRefId" value="#cmbRefPlan" type="int"/>
      </data>
      
      <data command="spManPlanKontoGlaAzur" name="dtInsert">
        <parameter name="@action" value="unos"/>
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Godina" value="#txtGodina" type="int"/>
        <parameter name="@GodinaRef" value="#txtRefGodina" type="int"/>
        <parameter name="@Operateriid" value="@@OperateriId" type="int"/>
        <parameter name="@ManPlanKontoGlaRefId" value="#cmbRefPlan" type="int"/>
      </data>
      
    </datalist>
  </form>
</root>