<root>
<form name="frmDatPar" caption="Filter prikaza">
		<event type="init">
			<action type="datarun reader" value="~dtSkladiste"/>
		</event>
		<layout>
			<group rows="2" cols="2" caption="Datum">
				<item row="1" col="1" caption="Od:">
					<dateedit name="datDatumOd" savevalue="session" value="now"/>
				</item>
				<item row="1" col="2" caption="Do:">
					<dateedit name="datDatumDo" savevalue="session" value="now"/>
				</item>
				<item row="2" col="1" colspan="2" caption="Skladište:">
					<comboedit name="cmbSkla" dataname="~dtSkladiste" valuefield="skladisteid" displayfield="skladiste" savevalue="session"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPrikazi" caption="Prikaži">
					<event type="click" waittype="progress" waitcaption="Pričekajte..." waittext="Filtriranje po parametrima u tijeku..." sleep="5000">
						<action if="#datDatumOd&gt;#datDatumDo">
							<action type="message" value="Vremensko razdoblje nije ispravno!"/>
							<action type="control value" value="#datDatumDo">
								<parameter value="#datDatumOd"/>
							</action>
						</action>
						<action else="">
							<action type="validate"/>
							<action type="variable value">
								<parameter name="parent.$DatumOd" value="#datDatumOd" type="datetime"/>
								<parameter name="parent.$DatumDo" value="#datDatumDo" type="datetime"/>
								<parameter name="parent.$Skladiste" value="#cmbSkla" type="int"/>
							</action>
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtSkladiste" command="spCarpoKKvalQuery">
				<parameter name="@action" value="getSkladista"/>
			</data>
		</datalist>
	</form>
</root>