<root>
    <form name="frmExcelDonos" caption="Donos iz excela" width="" height="" fixedsize="">
		<event type="load">		
			<action type="control populate" value="#grdDonos"></action>		
		</event>
        <layout textposition="top" itemspadding="1">
            <group cols="1" rows="1" groupbordervisible="false">
                <group cols="1" rows="1" groupbordervisible="false">
                    <item row="1" col="1" highlight="false">
                        <grid name="grdDonos" dataname="dtStavkeGet" >
							<fields>
								<field name="Ugovor" caption="Broj ugovora" />
								<field name="PartnerFaktura" caption="Partner za fakturu" />
								<field name="Šifra" caption="Šifra" />
								<field name="Roba" caption="Roba" />	
								<field name="Kolicina" caption="Količina"/>
								<field name="Cijena" caption="Cijena"/>	
								<field name="Rabat" caption="Rabat uk."/>	
								<field name="RokPlacanja" caption="Rok plaćanja"/>
								<field name="Greska" caption="Greška" />						
							</fields>
 				 			<styles>				
								<style name="fontcolor" value="red" if="#grdDonos.@IndGreska==1" />
							</styles>
                        </grid>
                    </item>
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="DONESI" type="add" dock="left" function="Donos">
                    <event type="click">
                        <action type="datarun nonquery" value="~dtDonesi"/>
                        <action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_ObracunPausala_ExcelDonos" name="dtDonesi">
                <parameter name="@FaktureObracunId" value="$FaktureObracunId" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
				<parameter name="@action" value="1"/>
            </data>	
            <data command="spProd_ObracunPausala_ExcelDonos" name="dtStavkeGet">
                <parameter name="@FaktureObracunId" value="$FaktureObracunId" />
				<parameter name="@operateriid" value="@@OperateriId"/>				
				<parameter name="@action" value="0"/>
            </data>			
        </datalist>
    </form>
</root>