
<root version="1.0">

  <form name="frmNovaInvUnos" caption="$caption"  width="600" saveformlayout="true">
      <event type="oninit">
        <!--<action type="datarun reader" value="~dtGet" if="$OSInventuraDetId!=null"/>-->
      </event>

      <layout textposition="left" >
        <group cols="4" rows="8" spacing="2,2,2,2">
          <item caption="Organizacijska jedinica:" col="1" row="1"  colspan="4">
            <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="OrgShema" dataname="~dtOrgShema" datatext="~dtGet.@OrgShema"/>
          </item>
          <item  col="2" row="2" textposition="right" >
            <checkedit name="chkIndIspodO" caption="I ispod" datavalue="#dtGet.@IndIspodOrg"  />
          </item>
          <item caption="Smještaj:" col="1" row="3" highlight="false" colspan="4">
            <searchedit name="srcSmjestaj" fieldvalue="SmjestajId" fieldtext="Smjestaj" dataname="~dtSmjestaj" />
          </item>
          <item  col="2" row="4" textposition="right" >
            <checkedit name="chkIndIspodS" caption="I ispod" datavalue="#dtGet.@IndIspodSmj"  />
          </item>
          <item caption="Djelatnik:" col="1" row="5" highlight="false" colspan="4">
            <searchedit name="srcDjelatnik" fieldvalue="HRKadroviId" fieldtext="Djelatnik" dataname="~dtDjelatnik" />
          </item>
          <item caption="Klasa:" col="1" row="6" highlight="false" colspan="4">
            <comboedit name="cmbKlasa"  valuefield="SitKlaseId" displayfield="Naziv" dataname="~dtKlase" />
          </item>
          <item caption="Datum popisa:" col="1" row="7" colspan="2">
            <dateedit name="datDatumPopisa" value="now" /> 
          </item>
          <item caption="Datum inventure:" col="1" row="8" colspan="2">
            <dateedit name="datDatumInv" value="now" />
          </item>     
        </group>
      </layout>
    
      <panelbuttons>
        <buttons>
          <button name="btnIns"  caption="Unesi" type="add"  >
            <event type="click">
              <action type="datarun reader" value="~dtUnos"/>
              <action type="variable value">
                <parameter name="parent.$TreeFocus" value="~dtUnos.@TreeId" type="string"/>
                <parameter name="parent.$MasterFocus" value="~dtUnos.@Id" type="int"/>
              </action>
              <!--<action type="control populate" value="parent.#tree" />-->
              <action type="form close" />
            </event>
          </button>
          <button caption="Odustani" type="cancel" dock="right">
            <event type="click"/>
          </button>
        </buttons>
      </panelbuttons>

      <datalist>
        <data command="spSitInventura_HelpCP" name="dtOrgShema">
          <parameter name="@Action" value="OrgShema_src"/>
          <parameter name="@tekst" value="#srcOrgShema.text"/>
        </data>
        <data command="spSitInventura_HelpCP" name="dtSmjestaj">
          <parameter name="@Action" value="Smjestaj_src"/>
          <parameter name="@tekst" value="#srcSmjestaj.text"/>
        </data>
        <data command="spSitInventura_HelpCP" name="dtDjelatnik">
          <parameter name="@Action" value="Djelatnik_src"/>
          <parameter name="@tekst" value="#srcDjelatnik.text"/>
        </data>
        <data command="spSitInventura_HelpCP" name="dtKlase">
          <parameter name="@Action" value="Klase_cmb"/>
        </data>
        <data command="spSitInventura_AzurCP" name="dtUnos" >
          <parameter name="@Action" value="Unos_inv"/>
          <parameter name="@OrgShemaId" value="#srcOrgShema"/>
          <parameter name="@IndIspodOrg" value="#chkIndIspodO" />
          <parameter name="@SmjestajId" value="#srcSmjestaj" />
          <parameter name="@IndIspodSmj" value="#chkIndIspodS" />
          <parameter name="@HRKadroviId" value="#srcDjelatnik" />
          <parameter name="@SitKlaseId" value="#cmbKlasa" />
          <parameter name="@DatumPopisa" value="#datDatumPopisa" />
          <parameter name="@DatumInventure" value="#datDatumInv"/>
          <parameter name="@OperateriId" value="@@OperateriId"/>
        </data>     
      </datalist>
    </form>


	
</root>