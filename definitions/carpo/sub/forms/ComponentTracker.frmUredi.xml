<root>
	<form name="frmUredi" caption="Edit">
        <event type="load">
            <action type="control value" value="#txtVersionNumber">
                <parameter value="parent.#grdGlava.@VersionNo"/>
            </action>
            <action type="control value" value="#txtPublisher">
                <parameter value="parent.#grdGlava.@Publisher"/>
            </action>
            <action type="control value" value="#txtReviewer">
                <parameter value="parent.#grdGlava.@Reviewer"/>
            </action>
            <action type="control value" value="#datPublishDate">
                <parameter value="parent.#grdGlava.@PublishDate"/>
            </action>
            <action type="datarun reader" value="~dtNapuniComboStatus" />
            <action type="control value" value="#cmbStatus">
                <parameter value="parent.#grdGlava.@Status"/>
            </action>
            <action type="control value" value="#memoStatus">
                <parameter value="parent.#grdGlava.@Memo"/>
            </action>
            <action type="datarun reader" value="~dtGetLogin" />
            <action type="control value" value="#txtReviewer">
                <parameter value="~dtGetLogin.@Login"/>
            </action>
        </event>
        <layout>
            <group cols="1" rows="6">
                <item row="1" col="1"  caption="Version number">
                    <textedit name="txtVersionNumber" enabled="false"/>
                </item>
                <item row="2" col="1" caption="Publisher" >
                    <textedit name="txtPublisher" enabled="false"/>
                </item>
                <item row="3" col="1" caption="Reviewer" >
                    <textedit name="txtReviewer" enabled="false"/>
                </item>
                <item row="4" col="1" caption="Publish date">
                    <dateedit name="datPublishDate" enabled="true"/>
                </item>
                <item row="5" col="1" caption="Status">
                    <comboedit name="cmbStatus" dataname="~dtNapuniComboStatus" valuefield="id" displayfield="Naziv"/>
                </item>
                <item row="6" col="1" caption="Memo">
                    <memoedit name="memoStatus"  />
                </item>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button name="btnOdustani" caption="Odustani" dock="right" tabstop="false">
                    <event type="click">
                        <action type="formclose"/>
                    </event>
                </button>

                <button name="btnPotvrdi" caption="POTVRDI" dock="right" color="dark">
                        <event type="click">
                            <action type="datarun nonquery" value="~dtUredi" />
                            <action type="control populate" value="parent.#grdGlava" />
                            <action type="formclose"/>
                        </event>
                </button>
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spComponentTracker" name="dtNapuniComboStatus">
                <parameter name="@Action" value="cmbStatus" />
            </data>
            <data command="spComponentTrackerAzur" name="dtUredi">
                <parameter name="@VersionId" value="parent.#grdGlava.@id" />
                <parameter name="@Action" value="edit" />
                <parameter name="@txtVersionNumber" value="#txtVersionNumber" />
                <parameter name="@txtPublisher" value="#txtPublisher" />
                <parameter name="@txtReviewer" value="#txtReviewer" />
                <parameter name="@datPublishDate" value="#datPublishDate" />
                <parameter name="@cmbStatus" value="#cmbStatus" />
                <parameter name="@memoStatus" value="#memoStatus" />
            </data>
            <data command="spComponentTracker" name="dtGetLogin">
                <parameter name="@Action" value="getLogin" />
            </data>
        </datalist>
    </form>
</root>