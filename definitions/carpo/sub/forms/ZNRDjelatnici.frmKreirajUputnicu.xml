<root version="1.0">
  <form name="frmKreirajUputnicu" caption="$caption" width="1000" height="250" >
    <event type="init">
      <action type="datarun reader" value="~dtGet" />
    </event>
    <event type="shown">
      <action type="control disable" value="#txtClanci" />
      <action type="control value" value="#txtRadnoMjesto"  >
        <parameter value="~dtGet.@RadnoMjesto" />
      </action>
      <action type="control value" value="#txtClanci"  >
        <parameter value="~dtGet.@Clanak" />
      </action>
      <action type="control value" value="#txtDjelatnik"  >
        <parameter value="global.$Djelatnik" />
      </action>
    </event>
    <layout>
      <group cols="1" rows="8" groupbordervisible="true" spacing="2,2,2,2">
        <item  col="1" row="1" caption="Broj uputnice:"  highlight="false" textposition="left">
          <textedit name="txtBroj" enabled="false" />
        </item>
        <item  col="1" row="2" caption="Datum uputnice:"  highlight="false" textposition="left">
          <dateedit name="datDatum" value="now" />
        </item>
        <item  col="1" row="3" caption="Djelatnik:"   highlight="false" textposition="left">
          <textedit name="txtDjelatnik" enabled="false"  />
        </item>
        <item  col="1" row="4"  caption="Radno mjesto:" highlight="false" textposition="left">
          <textedit name="txtRadnoMjesto"  enabled="false"  />
        </item>
        <group col="1" row="5" cols="2" rows="1" groupbordervisible="false" >
          <columnsdefinition>
            <column position="1" size="70%"/>
            <column position="2" size="30%"/>
          </columnsdefinition>
          <item  col="1" row="1"  caption="Članak 3.točka:" highlight="false" textposition="left">
            <textedit name="txtClanci"  />
          </item>
          <item  col="2" row="1"  highlight="false" textposition="left">
            <checkedit caption="ispuni ručno"  name="chkRucno" value="false" >
              <event type="valuechanged">
                <action type="control enable" value="#txtClanci" if="#chkRucno==true"/>
                <action type="control disable" value="#txtClanci" else=""/>
              </event>
            </checkedit>
          </item>
        </group>
        <item col ="1" row="6" caption="Ostali pravilnici:" highlight="false" textposition="left">
          <comboedit name="cmbPravilnici" valuefield="ZNRPosloviPosebniId" displayfield="Naziv" dataname="~dtPravilnici"/>
        </item>
        <group col="1" row="7" cols="4" rows="1" groupbordervisible="false" textposition="left">
          <item col ="1" row="1" highlight="false" textposition="left">
            <labeledit name="lblPregledi" value="Vrsta pregleda:" />
          </item>
          <item col ="2" row="1" caption="" highlight="false" textposition="left">
            <radioedit name="rdoPrethodni" caption="prethodni" />
          </item>
          <item col ="3" row="1" caption="" highlight="false" textposition="left">
            <radioedit name="rdoPeriodicki" caption="periodički" value="true"/>
          </item>
          <item col ="4" row="1" caption="" highlight="false" textposition="left">
            <radioedit name="rdoIzvanredni" caption="izvanredni" />
          </item>
        </group>
        <item col ="1" row="8" caption="Prethodni pregled:" highlight="false" textposition="left">
          <comboedit name="cmbUputnicaPrethodna" valuefield="ZNRUputniceId" displayfield="Naziv" dataname="~dtUputnice"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnos" caption="Kreiraj">
          <event type="click">
            <action type="datarun reader" value="~dtUnos" />
            <action type="control value" value="#txtBroj" >
              <parameter value="~dtUnos.@Broj" />
            </action>
            <action type="control disable" value="#btnUnos,#datDatum,#cmbPravilnici,#txtClanci,#chkRucno,#rdoPrethodni,#rdoPeriodicki,#rdoIzvanredni,#cmbUputnicaPrethodna" />
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" dock="right">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRDjelatnici_Help" name="dtPravilnici">
        <parameter name="@Action" value="Pravilnici_cmb" />
      </data>
      <data command="spZNRDjelatnici_Query" name="dtGet">
        <parameter name="@Action" value="get_Clanak"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Help" name="dtUputnice">
        <parameter name="@Action" value="Uputnice_cmb" />
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtUnos">
        <parameter name="@Action" value="Uputnica_dodaj"/>
        <parameter name="@HRRadnaMjestaId" value="$HRRadnaMjestaId"/>
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
        <parameter name="@Datum" value="#datDatum"/>
        <parameter name="@Clanci" value="#txtClanci"/>
        <parameter name="@indRucno" value="#chkRucno"/>
        <parameter name="@ZNRPosloviPosebniId" value="#cmbPravilnici"/>
        <parameter name="@indPrethodni" value="#rdoPrethodni"/>
        <parameter name="@indPeriodicki" value="#rdoPeriodicki"/>
        <parameter name="@indIzvanredni" value="#rdoIzvanredni"/>
        <parameter name="@ZNRUputnicePrethodnaId" value="#cmbUputnicaPrethodna"/>
      </data>
    </datalist>
  </form>
</root>
