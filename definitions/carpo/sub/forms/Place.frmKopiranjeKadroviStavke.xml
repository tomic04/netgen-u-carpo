<root>
	<!--FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->

	<form name="frmKopiranjeKadroviStavke" caption ="$caption" width="800" height="650"  statusbar="true" fixedsize="true" saveformsize="false" showversion="true" version="1">
		<!--<event type="init">
      <action type="datarun reader" value="~dtNapuniTemp" />
      <action type="variable value">
        <parameter name="StavkaId" value="0" type="int"/>
      </action>
    </event>-->
		<event type="shown">
			<action type="control populate" value="#grdObrade" />
			<action type="control populate" value="#grdKadrovi" />
			<action type="control populate" value="#grdStavke" />

			<!--<action type="datarun reader" value="~dtStavke" />-->
			<!--<action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika odabrane obrade: {#grdKadrovi.rowcount}"/>-->

			<action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika na odabranoj obradi: {#grdKadrovi.rowcount} | Broj stavaka: {#grdStavke.rowcount}"/>
		</event>

		<layout>
			<group cols="2" rows="9" groupbordervisible="false">
				<group col="1" row="1" cols="1" rows="8" rowspan="3" spacing="2,1,1,2" caption ="Obrade plaće">
					<item col="1" row="1" rowspan="8">
						<grid name="grdObrade" key="OOPObradeId" dataname="dtObrade" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">
							<event type="focusedrowchanged">
								<action type="control populate" value="#grdKadrovi"></action>
								<action type="control populate" value="#grdStavke" />
								<!--<action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika odabrane obrade: {#grdKadrovi.rowcount}"/>-->
								<action type="footer text" value="Broj djelatnika na postojećoj obradi: {parent.#grdPlace.rowcount} | Broj djelatnika na odabranoj obradi: {#grdKadrovi.rowcount} | Broj stavaka: {#grdStavke.rowcount}"/>
							</event>
						</grid>
					</item>
				</group>

				<group col="2" row="1" cols="1" rows="8" rowspan="3" spacing="1,2,1,2" caption ="Djelatnici s odabrane obrade">
					<item col="2" row="1" rowspan="8">
						<grid name="grdKadrovi" key="HRKadroviId" dataname="dtKadrovi" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

						</grid>
					</item>
				</group>

				<group col="1" row="4" cols="1" rows="1" spacing="2,2,1,2" rowspan="3" colspan="2" caption="Stavke:">
					<group col="1" row="1" cols="1" rows="1" groupbordervisible="false">
						<item caption="Stavke:" col="1"  row="1" >
							<grid name="grdStavke" key="OOPObradeDetId"  dataname="dtStavke" bestfitonrefresh="true" fieldsmartspaces="true" multiselect="true" showautofilterrow="true" showgrouppanel="false" showcheckboxes="true">

							</grid>
						</item>
					</group>


				</group>

				<group col="1" row="7" cols="10" rows="4" colspan="2" spacing="2,2,1,2" rowspan="3" caption ="Opcije kopiranja (postoji Tooltip za svaku ocpiju)">
					<item col="1" row="1" highlight="false" >
						<checkedit caption="Obriši djelatnike s postojeće obrade"  name="chkObrisipostojeceDjelatnike" checked="false" tooltip="Obriši sve djelatnike s postojeće obrade (isprazni obradu)."></checkedit>
					</item>
					<item col="1" row="2" highlight="false">
						<checkedit caption="Kopiraj odabrane djelatnike" name="chkKopirajDjelatnike" checked="true" tooltip="Kopiraj odabrane djelatnike s odabrane obrade na postojeću obradu. Zanemaruju se djelatnici koji već postoje na ovoj obradi."></checkedit>
					</item>
					<item col="1" row="3" highlight="false">
						<checkedit caption="Obriši sve stavke s postojeće obrade za odabrane djelatnike" name="chkObrisiPostojeceStavke" checked="false" tooltip="Obriši stavke s postojeće obrade"></checkedit>
					</item>

					<item col="1" row="4" highlight="false">
						<checkedit caption="Kopiraj odabrane stavke" name="chkKopirajStavke" checked="false" tooltip="Kopiraj odabrane stavke s odabrane obrade djelatnicima na postojećoj obradi."></checkedit>
					</item>

				</group>
			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>

			<buttons>
				<button name="btnSpremi" caption="KOPIRAJ" >
					<event type="click">
						<action type="datarun reader" value="~dtKopiraj" waittype="progress" waitcaption="Pričekajte..." waittext="..kopiranje / brisanje u tijeku...">
						</action>
						<action type="control populate" value="#grdKadrovi" />
						<action type="control populate" value="#grdStavke" />
						<action type="message" value="~dtKopiraj.@Poruka"/>
					</event>

				</button>
				<button name="btnOdustani" caption="IZLAZ" dock="right" >
					<event type="click">
						<action type="form close" />
						<action type="control populate" value="parent.#grdObradeDet">
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlaceKopirajKadroveSObrade" name="dtObrade">
				<parameter name="@Action" value="grid_obrade"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobrade2id" value="global.$oopobradeid"/>
			</data>
			<data command="spPlaceKopirajKadroveSObrade" name="dtKadrovi">
				<parameter name="@Action" value="grid_kadrovi_za_obradu"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="#grdObrade.@OOPObradeId"/>
				<parameter name="@oopobrade2id" value="global.$oopobradeid"/>
			</data>
			<data command="spPlaceKopirajKadroveSObrade" name="dtStavke">
				<parameter name="@Action" value="grid_stavke_za_obradu"/>
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="#grdObrade.@OOPObradeId"/>
				<parameter name="@oopobrade2id" value="global.$oopobradeid"/>
			</data>


			<data command="spPlaceKopirajKadroveSObrade" name="dtKopiraj">
				<parameter name="@Action" value="kopiraj" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@chkKopirajDjelatnike" value="#chkKopirajDjelatnike"/>
				<parameter name="@chkObrisiPostojeceDjelatnike" value="#chkObrisiPostojeceDjelatnike"/>
				<parameter name="@chkKopirajStavke" value="#chkKopirajStavke"/>
				<parameter name="@chkObrisiPostojeceStavke" value="#chkObrisiPostojeceStavke"/>
				<parameter name="@oopobradeid" value="#grdObrade.@OOPObradeId"/>
				<parameter name="@oopobrade2id" value="global.$oopobradeid"/>
				<parameter name="@table" value="#grdStavke.selectedids.table"/>
			</data>
		</datalist>
	</form>


	<!--kraj FORMA ZA brisanje DETALJA PLAĆE ZA KADRA-->
</root>