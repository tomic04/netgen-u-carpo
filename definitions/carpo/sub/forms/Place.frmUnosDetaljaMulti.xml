<root>
	<!--FORMA ZA AŽURIRANJE DETALJA PLAĆE ZA KADRA-->

	<!--v2: dodano polje Napomena-->
	<form name="frmUnosDetaljaMulti" caption ="$caption" width="800" height="650" statusbar="true" fixedsize="true" saveformsize="false" showversion="true" version="2">
		<!--<event type="init">
      <action type="datarun reader" value="~dtNapuniTemp" />
      <action type="variable value">
        <parameter name="StavkaId" value="0" type="int"/>
      </action>
    </event>-->
		<event type="shown">
			<action type="datarun reader" value="~dtNapuniTemp" />
			<action type="variable value">
				<parameter name="StavkaId" value="0" type="int"/>
			</action>
			<action type="variable value">
				<parameter name="StavkaId" value="#cmbStavke" type="int"/>
			</action>
			<action type="control populate" value="#grdOstali" />
			<action type="control populate" value="#grdOdabrani" />
			<action type="datarun reader" value="~dtKontrole" />
			<action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" />
			<action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" />
			<action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" />
			<action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" />
			<action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" />
			<action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" />
			<action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" />
			<action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" />
			<action type="control disable" value="#txtOd" if="~dtKontrole.@vOd==0" />
			<action type="control disable" value="#txtDo" if="~dtKontrole.@vDo==0" />
			<action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
			<action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
			<action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
			<action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
			<action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" />
			<action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" />
			<action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" />
			<action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" />
			<action type="control enable" value="#txtOd" if="~dtKontrole.@vOd==1" />
			<action type="control enable" value="#txtDo" if="~dtKontrole.@vDo==1" />

			<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount}"/>
		</event>

		<layout>
			<group cols="3" rows="5" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="45%"></column>
					<column position="2" size="10%"></column>
					<column position="3" size="45%"></column>
				</columnsdefinition>
				<group col="1" row="1" cols="1" rows="8" rowspan="4" spacing="2,1,1,2" caption="Djelatnici na obradi">
					<item col="1" row="1" rowspan="8" >
						<grid name="grdOstali" key="OOPObradeGlaId" dataname="dtOstali" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

						</grid>
					</item>
				</group>

				<group col="2" row="1" cols="1" rows="8" rowspan="4" spacing="1,1,1,2">
					<rowsdefinition>
						<row position ="3" size="30"/>
						<row position ="4" size="30"/>
						<row position ="5" size="30"/>
					</rowsdefinition>
					<item col="2" row="4" rowspan="1">
						<button image="right" caption="" imagelocation="bottomcenter" name="btnPrebaciDesno">
							<!--na klik prebaci selectedids iz grdgore i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciDesno"/>
								<action type="control populate" value="#grdOstali"/>
								<action type="control populate" value="#grdOdabrani"/>
								<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount}"/>
							</event>
						</button>
					</item>
					<item col="2" row="5" rowspan="1">
						<button image="left" caption="" imagelocation="bottomcenter" name="btnPrebaciLijevo">
							<!--na klik prebaci selectedids iz grdgore i osvježi gridove-->
							<event type="click">
								<action type="datarun nonquery" value="~dtprebaciLijevo"/>
								<action type="control populate" value="#grdOstali"/>
								<action type="control populate" value="#grdOdabrani"/>
								<action type="footer text" value="Broj djelatnika na obradi: {#grdOstali.rowcount} | Broj odabranih djelatnika: {#grdOdabrani.rowcount}"/>
							</event>
						</button>
					</item>
				</group>

				<group col="3" row="1" cols="1" rows="8" rowspan="4" spacing="1,2,1,2" caption="Odabrani djelatnici">
					<item col="3" row="1" rowspan="8" >
						<grid name="grdOdabrani" key="OOPObradeGlaId" dataname="dtOdabrani" preventfocusgroup="false" fieldsmartspaces="false"  bestfitonrefresh="true" multiselect="true" showautofilterrow="true" showgrouppanel="false">

						</grid>
					</item>
				</group>

				<group col="1" row="5" cols="1" rows="2" colspan="3" spacing="2,2,1,2">
					<group col="1" row="1" cols="5" rows="1" groupbordervisible="true">
						<item caption="" col="1"  row="1" >
						</item>
						<item caption="Stavka:" col="1"  row="2" textposition="left" fontbold="true" colspan="4" highlight="false">
							<comboedit name="cmbStavke"  valuefield="OOPStavekeId" displayfield="Naziv" dataname="~dtStavke" allownull="false" >
								<event type="valuechanged">
									<action type="variable value">
										<parameter name="StavkaId" value="#cmbStavke" type="int"/>
									</action>
									<action type="datarun reader" value="~dtKontrole" />
									<action type="control disable" value="#txtSati" if="~dtKontrole.@vSati==0" />
									<action type="control disable" value="#txtBodovi" if="~dtKontrole.@vBodovi==0" />
									<action type="control disable" value="#txtPostotak" if="~dtKontrole.@vPostotak==0" />
									<action type="control disable" value="#txtIznos" if="~dtKontrole.@vIznos==0" />
									<action type="control disable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==0" />
									<action type="control disable" value="#srcMtr" if="~dtKontrole.@vMtr==0" />
									<action type="control disable" value="#srcRelacije" if="~dtKontrole.@vRelacije==0" />
									<action type="control disable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==0" />
									<action type="control disable" value="#txtOd" if="~dtKontrole.@vOd==0" />
									<action type="control disable" value="#txtDo" if="~dtKontrole.@vDo==0" />
									<action type="control enable" value="#txtSati" if="~dtKontrole.@vSati==1" />
									<action type="control enable" value="#txtBodovi" if="~dtKontrole.@vBodovi==1" />
									<action type="control enable" value="#txtPostotak" if="~dtKontrole.@vPostotak==1" />
									<action type="control enable" value="#txtIznos" if="~dtKontrole.@vIznos==1" />
									<action type="control enable" value="#srcOrgShema" if="~dtKontrole.@vOrgShema==1" />
									<action type="control enable" value="#srcMtr" if="~dtKontrole.@vMtr==1" />
									<action type="control enable" value="#srcRelacije" if="~dtKontrole.@vRelacije==1" />
									<action type="control enable" value="#srcRadnaMjesta" if="~dtKontrole.@vRadnaMjesta==1" />
									<action type="control enable" value="#txtOd" if="~dtKontrole.@vOd==1" />
									<action type="control enable" value="#txtDo" if="~dtKontrole.@vDo==1" />
								</event>
							</comboedit>
						</item>
						<item caption="" col="5"  row="1" >
						</item>
					</group>
					<group col="1" row="2" cols="4" rows="8" groupbordervisible="false">
						<item caption="Sati:" col="1" row="2" textposition="left">
							<textedit name="txtSati" format="n2" textposition="left" value="0"/>
						</item>
						<item caption="Bodovi:" col="1" row="3" textposition="left">
							<textedit name="txtBodovi" format="n2" textposition="left" value="0" />
						</item>
						<item caption="Postotak:" col="1" row="4" textposition="left">
							<textedit name="txtPostotak" format="n2" textposition="left" value="0"/>
						</item>
						<item caption="Iznos:" col="1" row="5" textposition="left">
							<textedit name="txtIznos"  format="n2" textposition="left" value="0"/>
						</item>
						<item caption="Org. jedinica:" col="3" row="2" textposition="left" colspan="2">
							<searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtOrgShema" />
						</item>
						<item caption="Mjesto troška:" col="3" row="3" textposition="left" colspan="2">
							<searchedit name="srcMtr"  fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtMtr" />
						</item>
						<item caption="Relacija:" col="3" row="4" textposition="left" colspan="2">
							<searchedit name="srcRelacije" fieldvalue="OOPRelacijeId" fieldtext="Naziv" dataname="~dtRelacije" />
						</item>
						<item caption="Radno mjesto:" col="3" row="5" textposition="left" colspan="2">
							<searchedit name="srcRadnaMjesta"  fieldvalue="HRRadnaMjestaId" fieldtext="Naziv" dataname="~dtRadnaMjesta" />
						</item>
						<group col="3" row="6" cols="5" rows="1" groupbordervisible="false">
							<item caption="" col="1" row="1" >
								<labeledit name="lblRazdoblje" value="Razdoblje:    " />
							</item>
							<item caption="" col="2" row="1" textposition="left">
								<textedit name="txtOd"  format="n0" textposition="left" value="0" maxlength="2"/>
							</item>
							<item caption="" col="3" row="1" >
								<labeledit name="lblCrta" value="   -   " />
							</item>
							<item caption="" col="4" row="1" textposition="left">
								<textedit name="txtDo"  format="n0" textposition="left" value="0" maxlength="2"/>
							</item>
							<item caption="" col="5" row="1">
							</item>
						</group>
						<group col="1" row="7" cols="1" rows="1" colspan="4" groupbordervisible="false">
							<item caption="Napomena:" col="1" row="1" textposition="left">
								<textedit name="txtNapomena" textposition="left" value=""/>
							</item>
						</group>

					</group>

				</group>
			</group>
			<!--kraj omotača-->

		</layout>

		<panelbuttons>

			<buttons>
				<button name="btnSpremi" caption="SPREMI" >
					<event type="click">
						<action type="variable value">
							<parameter name="Greska" value="0" type="int"/>
						</action>
						<action type="datarun reader" value="~dtUnos">
							<action type="message" value="~dtUnos.@Poruka"/>
							<action type="variable value">
								<parameter name="Greska" value="~dtUnos.@Id"/>
							</action>
						</action>

						<action type="control enable" value="#cmbStavke"  if="$Greska==0"/>
						<action type="control refreshvalue" value="##"  if="$Greska==0"/>
					</event>

				</button>
				<button name="btnOdustani" caption="IZLAZ" dock="right" >
					<event type="click">
						<action type="form close" />
						<action type="control populate" value="parent.#grdObradeDet">
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spPlace_help" name="dtStavke">
				<parameter name="@Action" value="cmb_stavke"/>
				<parameter name="@operateriid" value="@@operateriid"/>
			</data>
			<data command="spPlace_help" name="dtOrgShema">
				<parameter name="@Action" value="src_orgshema" />
				<parameter name="@Tekst" value="#srcOrgShema.text"/>
			</data>
			<data command="spPlace_help" name="dtMtr">
				<parameter name="@Action" value="src_orgshema" />
				<parameter name="@Tekst" value="#srcMtr.text"/>
			</data>
			<data command="spPlace_help" name="dtRelacije">
				<parameter name="@Action" value="src_relacije" />
				<parameter name="@Tekst" value="#srcRelacije.text"/>
			</data>
			<data command="spPlace_help" name="dtRadnaMjesta">
				<parameter name="@Action" value="src_radnamjesta" />
				<parameter name="@Tekst" value="#srcRadnaMjesta.text"/>
			</data>
			<data command="spPlace_help" name="dtKontrole">
				<parameter name="@Action" value="daj_pozicije_za_unos_stavke" />
				<parameter name="@OOPStavkeId" value="$StavkaId"/>
			</data>
			<data command="spPlaceUnosStavkiMulti" name="dtNapuniTemp">
				<parameter name="@Action" value="unos_stavki_multi_popuni_temp_init" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="parent.#grdPlace.selectedids.table"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceUnosStavkiMulti" name="dtOstali">
				<parameter name="@Action" value="unos_stavki_multi_grid_ostali" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceUnosStavkiMulti" name="dtOdabrani">
				<parameter name="@Action" value="unos_stavki_multi_grid_odabrani" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopobradeid" value="global.$OOPObradeId"/>
			</data>
			<data command="spPlaceDetAzur" name="dtUnos">
				<parameter name="@Action" value="detalj_unos" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@oopstavkeid" value="#cmbStavke"/>
				<parameter name="@Sati" value="#txtSati"/>
				<parameter name="@Bodovi" value="#txtBodovi"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@Iznos" value="#txtIznos"/>
				<parameter name="@OrgShemaId" value="#srcOrgShema"/>
				<parameter name="@MtrId" value="#srcMtr"/>
				<parameter name="@RelacijaId" value="#srcRelacije"/>
				<parameter name="@HRRadnaMjestaId" value="#srcRadnaMjesta"/>
				<parameter name="@DanOd" value="#txtOd"/>
				<parameter name="@DanDo" value="#txtDo"/>
				<parameter name="@Napomena" value="#txtNapomena"/>
			</data>
			<data command="spPlaceUnosStavkiMulti" name="dtPrebaciLijevo">
				<parameter name="@Action" value="unos_stavki_multi_prebaci_lijevo" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdodabrani.selectedids.table"/>
			</data>
			<data command="spPlaceUnosStavkiMulti" name="dtPrebaciDesno">
				<parameter name="@Action" value="unos_stavki_multi_prebaci_desno" />
				<parameter name="@operateriid" value="@@operateriid"/>
				<parameter name="@table" value="#grdostali.selectedids.table"/>
			</data>
		</datalist>
	</form>


	<!--kraj FORMA ZA AŽURIRANJE DETALJA PLAĆE ZA KADRA-->
</root>