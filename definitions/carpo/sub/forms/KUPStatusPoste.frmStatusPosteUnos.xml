<?xml version="1.0" encoding="utf-8"?>
<root version="1.0">
  <form name="frmStatusPosteUnos" type="master" caption="Status ulazne pošte :: {$Tekst}" statusbar="false">
    <event type="init">
      <action type="datarun reader" value="Global.dtGet" if="$Ind_Unos==0"/>
    </event>
    <event type="shown">
      <action type="control value" value="#txtKorak" if="$Ind_Unos==1">
        <parameter value="~dtGet.@Korak"/>
      </action>
      <action type="control value" value="#txtOpis" if="$Ind_Unos==1">
        <parameter value="~dtGet.@Opis" />
      </action>
      
    </event>
    
    <layout textposition="left" itemspadding="3">
      <group cols="3" rows="2" col="1" row="1">
        
        <group cols="2" rows="1" col="1" row="1" colspan="3" groupbordervisible="false">
          <item caption="Korak:" row="1" col="1">
            <textedit name="txtKorak" required="True" value="" datavalue="~dtGet.@Korak" readonly="false"/>
          </item>
          <item caption="Proknjiži:" row="1" col="2">
            <comboedit name="cmbProknjizi" valuefield="ProknjiziId" displayfield="Naziv" datavalue="#dtGet.@ProknjiziId" dataname="dtProknjizi" required="True"/>
          </item>        
        </group>
        
        <item caption="Opis:" row="2" col="1"  colspan="3">
          <textedit name="txtOpis" required="True" value="" type="int" datavalue="~dtGet.@Opis" readonly="false"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi">
          <event type="click">
            <!--<action type="validate"/>-->

            <action type="datarun scalar" value="~dtInsert" if="$Ind_Unos==1">
              <parameter name="parent.$NoviKUPStatusId" />
            </action>

            <action type="datarun nonquery" value="dtUpdate" if="$Ind_Unos==0"/>

            <action type="form close"/>

            <action type="control populate" value="parent.#grdGlava">
              <action type="control focus" value="parent.#grdGlava" if="$Ind_Unos==1">
                <parameter value="parent.$NoviKUPStatusId" />
              </action>

              <action type="control focus" value="parent.#grdGlava" if="$Ind_Unos==0">
                <parameter value="$KUPStatusId" />
              </action>
            </action>

          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spCKUPStatusPosteQuery" name="dtProknjizi">
        <parameter name="@action" value="proknjizi"/>
      </data>

      <data command="spCKUPStatusPosteAzur" name="dtUpdate">
        <parameter name="@action" value="izmjena"/>
        <parameter name="@id" value="$KUPStatusId"/>
        <parameter name="@Korak" value="#txtKorak"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@ProknjiziId" value="#cmbProknjizi" type="int"/>
      </data>

      <data command="spCKUPStatusPosteAzur" name="dtInsert">
        <parameter name="@action" value="unos"/>
        <parameter name="@id" value="null" type="int"/>
        <parameter name="@Korak" value="#txtKorak"/>
        <parameter name="@Opis" value="#txtOpis"/>
        <parameter name="@ProknjiziId" value="#cmbProknjizi" type="int"/>
      </data>

    </datalist>
  </form>
</root>