
<root version="1.0">

  <form name="frmUnosKol" caption="$caption"  width="1600" height ="600" saveformlayout="true">
    <event type="init">
      <action type="datarun reader" value="~dtUnosKol" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdUnosKol" />
    </event>
      <layout >
        <group cols="1" rows="1" spacing="2,2,2,2">
          <item col="1" row="1" >
            <grid name="grdUnosKol" key="SitInventuraDetId" keyfield="SitInventuraDetId" dataname="dtUnosKol" showautofilterrow="true" fieldsmartspaces="false" multiselect="true" bestfitonrefresh="true">
              <event type="cellvaluechanged">
                <action type="datarun nonquery" value="~dtUpdateKol" />
                <action type="control populate keepfocus" value="#grdUnosKol" />
              </event>
              <fields inherited="true">
                <field name="Naziv" fixed="true" />
                <field name="Sifra" caption="Šifra" fixed="true" />
                <field name="KolicinaPopisana" caption="Količina" editable="true" format="n2"/>
                <field name="DatumPopisa" caption="Datum popisa" editable="true" />
                <field name="Org" caption="Organizacijska jedinica" />
                <field name="Smj" caption="Smještaj" />
              </fields>
            </grid>
          </item>
        </group>
      </layout>
    
      <panelbuttons>
        <buttons>
          <button name="btnKP"  caption="Knjižno -> Popisano" type="add"  >
            <event type="click">
              <action type="datarun reader" value="~dtUnosKnjizPop" />
              <action type="control populate" value="#grdUnosKol" />
              <!--<action type="form close" />-->
            </event>
          </button>
          <button caption="Odustani" type="cancel" dock="right">
            <event type="click"/>
          </button>
        </buttons>
      </panelbuttons>

      <datalist>
        <data command="spSitInventura_QueryCP" name="dtUnosKol">
          <parameter name="@Action" value="Grid_UnosKol"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
        </data>
        <data command="spSitInventura_AzurCP" name="dtUpdateKol">
          <parameter name="@Action" value="Update_Kol"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
          <parameter name="@SitInventuraDetId" value="#grdUnosKol.@SitInventuraDetId" />
          <parameter name="@KolicinaPopisana" value="#grdUnosKol.@KolicinaPopisana" />
          <parameter name="@DatumPopisa" value="#grdUnosKol.@DatumPopisa" />
        </data>
        <data command="spSitInventura_AzurCP" name="dtUnosKnjizPop">
          <parameter name="@Action" value="UnosKnjiz_Popis"/>
          <parameter name="@SitInventuraGlaId" value="$SitInventuraGlaId" />
        </data>
      </datalist>
    </form>


	
</root>