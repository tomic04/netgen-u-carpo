<root>
	<form name="frmPPDokumentEdit" caption="Izmjena dokumenta" width="1150" >
		<event type="init">
			<action type="datarun reader" value="~dtGet" />
			<action type="datarun reader" value="~dtSuma" />

			<action type="datarun scalar" value="~dtmaxlengthMEMO">
				<parameter name="maxlengthMEMO" value="~dtmaxlengthMEMO.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>
			<action type="datarun scalar" value="~dtmaxlengthOP">
				<parameter name="maxlengthOP" value="~dtmaxlengthOP.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>
			<action type="datarun scalar" value="~dtmaxlengthOZ">
				<parameter name="maxlengthOZ" value="~dtmaxlengthOZ.@CHARACTER_MAXIMUM_LENGTH"/>
			</action>
		</event>
		<event type="load">
			<action type="control value" value="#txtRoba">
				<parameter value="~dtGet.@robaid"/>
			</action>
			<action type="variable value" >
				<parameter name="global.RobaId" value="#txtRoba" type="int"/>
			</action>
			<action type="control populate" value="#cmbJM"/>
			<action type="control value" value="#cteOrgShema">
				<parameter value="~dtGet.@ID"/>
			</action>
			<action type="variable value" >
				<action type="datarun scalar" value="Global.~dtVrstaDokGet">
					<parameter name="VrstaDokId" value="$VrstaDokId" />
				</action>	
			</action>	
		</event>
		<layout textposition="left" itemspadding="3">
			<group padding="0" groupbordervisible="False" cols="3" rows="1">
				<columnsdefinition>
					<column size="300" position="1" />
					<column size="8" position="2" />
				</columnsdefinition>
				<tabs row="1" col="1" >
					<group caption="Osnovno" cols="2" rows="6" col="1" row="1" alignmode="local"> <!-- 6redova 2 kolone -->
						<part name="OperacijskiListAtributi" path="prtOperacijskiList.xml" />						
					</group>
					<group caption="Napomena" cols="3" rows="3" col="1" row="1">
						<columnsdefinition>
							<column position="1" size="100%"/>
							<column size="70" position="2"/>
							<column size="70" position="3"/>
						</columnsdefinition>
						<rowsdefinition>
							<row size="30" position="2" />
						</rowsdefinition>
						<!-- <item caption="Standardne napomene:" row="1" col="1" colspan="3" textposition="top">
							<comboedit name="cmbNapomena" enabled="true" valuefield="Poruka" displayfield="Poruka" datavalue="~dtGet.@Poruka" dataname="Global.~dtPoruke" >
							</comboedit> 
						</item>
						<item row="2" col="2">
							<button name="btnDodaj" caption="Dodaj" dock="right">
								Dodaj red niže on postojeću napomenu
								<event type="click">
									<action type="datarun reader" value="~dtNapomena"/>
									<action type="control value" value="#MemoGlava">
										<parameter value="~dtNapomena.@tekst"/>
									</action>
								</event>
							</button>
						</item>
						<item row="2" col="3" >
							<button name ="btnZamjeni" caption="Zamjeni" type="edit" dock="right" >
								<event type="click">
									<action type="control value" value="#MemoGlava">
										<parameter value="#cmbNapomena"/>
									</action>
								</event>
							</button>
						</item> -->
						<item name="Memo" textvisible="False" row="3" col="1" colspan="3" >
							<memoedit name="MemoGlava" datavalue="~dtGet.@Memo"  maxlength="$maxlengthMEMO"/>
							<event type="valuechanged">
								<action type="control disable" value="#btnZamjeni" if="#Memo!=null"/>
							</event>
						</item>
					</group>
				</tabs>
				<item row="1" col="2" />
				<group padding="0" groupbordervisible="False" cols="1" rows="3" col="3" row="1">
					<rowsdefinition>
						<row size="60" position="3" />
					</rowsdefinition>
					<item row="1" col="1" highlight="False" >
						<grid name="grdOprListDet" autopopulate="true" key="PrnOprListDetId" dataname="~dtDetail"  savelayout="true"> <!--  multiselect="true" -->
							<fields inherited="true">
							</fields>
						</grid>
					</item>
<!-- 					<group padding="0" groupbordervisible="false" cols="3" rows="1" col="1" row="2" width="250">
						<item caption="Ukupno trajanje operacijskog lista:"  col="1" row="1">
							<labeledit  name="lblSUMA" datavalue="~dtsuma.@SUMA" value="~dtsuma.@SUMA"/>
						</item>	
					</group> -->
					<group padding="0" groupbordervisible="true" cols="3" rows="1" col="1" row="3" width="250">
						<group padding="0" groupbordervisible="false" cols="3" rows="1" col="1" row="1" width="250">
							<item row="1" col="1" textvisible="False">
								<button name="btnAddDetalj" caption="Dodaj" image="add" type="add">
									<event type="click">
																	
										<action type="form open" value="frmOperacije">
											<parameter name="PrnOprListGlaId" value="$PrnOprListGlaId" />
										</action>

									</event>
								</button>
							</item>
							<item row="1" col="2" textvisible="False">
								<button name="btnEditDetalj" caption="Izmijeni" type ="edit" image="edit">
									<event type="click">
										<action type="form open" value="frmOperacije">
											<parameter name="PrnOprListDetId" value="#grdOprListDet.@PrnOprListDetId"/>
											<parameter name="OrgShemaId" value="#cteOrgShema" />
											<parameter name="PrnOprListGlaId" value="$PrnOprListGlaId" />
											<!-- <parameter name="Action" value="1" type="int"/> -->
										</action>
										<action type="control populate" value="#grdOprListDet" />
									</event>
								</button>
							</item>
							<item row="1" col="3" textvisible="False">
								<button caption="Obriši" name="btnDelDetalj" image="delete">
									<event type="click">
										<action type="confirm" value="Želite li obrisati označeno?">									
											<action type="datarun nonquery" value="~dtDetDelete"/>
											
											<!-- <action type="control populate" value="#lblSUMA" /> -->
										</action>
										<action type="control populate" value="#grdOprListDet" />
									</event>
								</button>
							</item>
						</group>
					</group>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi" type="add">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtDataUpdate">
						</action>
				<!--	<action type="control focus" value="parent.#grdMaster">
							<parameter value="$PrnOprListGlaId" />
						</action>	 -->
						<action type="variable value"  >
							<parameter name="parent.tmpId" value="$PrnOprListGlaId"/>
						</action>
						<action type="form close"/>
					</event>
				</button>
				<button name="btnZakljuci" caption="ZAKLJUČI" function="zakljuci">
					<event type="click">
						<action type="confirm" value="Želite li zaključiti dokument?">
							<action type="datarun nonquery" value="global.~dtZakljuci"/>
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close"/>
						</action>
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>		
		<datalist>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthMEMO">
				<parameter name="@table_name" value="PrnOprListGLA" />
				<parameter name="@column_name" value="Memo" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOZ">
				<parameter name="@table_name" value="PrnOprListGLA" />
				<parameter name="@column_name" value="Oznaka" />
			</data>
			<data command="spGetColumnsInfo_carpo" name="dtmaxlengthOP">
				<parameter name="@table_name" value="PrnOprListGLA" />
				<parameter name="@column_name" value="Opis" />
			</data>
			<data command="spPrnOprListGla_Azur" name="dtDataUpdate">
				<parameter name="@Action" value="1" />
				<parameter name="@ID" value="$PrnOprListGlaId" />

				<parameter name="@Oznaka" value="#txtOznaka"/>
				<parameter name="@Opis" value="#txtOpis"/>
				<parameter name="@RobaId" value="#txtRoba"/>
				<parameter name="@Kolicina" value="#txtKolicina" />
				<parameter name="@JMId" value="#cmbJM" />
				<parameter name="@OrgShemaid" value="#cteOrgShema"/>
				<parameter name="@OsobeId" value="#cmbOsobe"/>
				<parameter name="@Memo" value="#MemoGlava"/>
			</data>
			<data command="spPrnOprListGla_Query" name="dtGet">
				<parameter name="@Action" value="masterforma" />
				<parameter name="@ID" value="$PrnOprListGlaId" />
			</data>	
			<data command="spPrnOprListDet_Query" name="dtSuma">
				<parameter name="@Action" value="suma" />
				<parameter name="@ID" value="$PrnOprListGlaId" />
			</data>
			<data command="spPrnOprListDet_Query" name="dtDetail">
				<parameter name="@Action" value="detail" />
				<parameter name="@ID" value="$PrnOprListGlaId" />
			</data>	
			<data command="spPrnOprListGla_Query" name="dtJM">
				<parameter name="@Action" value="JM" />
				<parameter name="@robaid" value="#txtRoba" />
			</data>
			<data command="spPrnOprListDet_Azur" name="dtDetDelete">
				<parameter name="@action" value="2"/>
				<parameter name="@id" value="#grdOprListDet.@PrnOprListDetId"/>
			</data>				
		</datalist>		
	</form>
</root>