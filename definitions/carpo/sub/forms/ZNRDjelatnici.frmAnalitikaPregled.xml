<root version="1.0">
  <form name="frmAnalitikaPregled" caption="$caption" width="1000" height="500" >
    <event type="shown">
      <action type="menu disable" value="#menAnalitikaBrisanje" if="#grdAnalitika.@IndBrisanoId==1"/>
      <action type="menu enable" value="menAnalitikaBrisanje" else="" />
    </event>
    <layout>
      <group cols="1" rows="1" groupbordervisible="true" spacing="2,2,2,2">
        <item  col="1" row="1"  highlight="false" textposition="left">
          <grid name="grdAnalitika" keyfield="ID" multiselect="true" dataname="dtAnalitika" showmenuprintitem="false" showmenutools="false" fieldsmartspaces="false" bestfitonrefresh="true" autopopulate="true" showgrouppanel="true" showautofilterrow="false" >
            <event type="focusedrowchanged">
              <action type="menu disable" value="#menAnalitikaBrisanje" if="#grdAnalitika.@IndBrisanoId==1"/>
              <action type="menu enable" value="menAnalitikaBrisanje" else="" />
            </event>
            <fields inherited="true">
              <field name="Naziv" caption="$Naziv" />
              <field name="DatumOsposobljavanja" caption="Datum osposobljavanja" />
              <field name="DatumIsteka" caption="Datum isteka" />
              <field name="DatumBrisano" caption="Datum brisanja" />
            </fields>
            <styles>
              <style name="italic" value="true" if="$tip==poslovi rizik&amp;&amp;#grdAnalitika.@IndBrisanoId==1" />
              <style name="italic" value="true" if="$tip==strucna osposobljavanja&amp;&amp;#grdAnalitika.@IndBrisanoId==1" />
              <style name="fontcolor" value="#FF0000" if="$tip==poslovi rizik&amp;&amp;#grdAnalitika.@ZNRRadnaMjesta_PosloviRizikId==0" />
              <style name="fontcolor" value="#FF0000" if="$tip==strucna osposobljavanja&amp;&amp;#grdAnalitika.@ZNRRadnaMjesta_StrucnaOsposobljavanjaId==0" />
            </styles>
            <menu>
              <menuitem caption="Obriši" name="menAnalitikaBrisanje">
                <event type="click">
                  <action type="datarun nonquery" value="~dtBrisanje" />
                  <action type="control populate" value="#grdAnalitika" />
                </event>
              </menuitem>
            </menu>
          </grid>
        </item>
      </group>
    </layout>
    <datalist>
      <data command="spZNRDjelatnici_Query" name="dtAnalitika">
        <parameter name="@Action" value="Analitika_Osnovna" if="$tip==osnovna"/>
        <parameter name="@Action" value="Analitika_PosloviRizik" if="$tip==poslovi rizik"/>
        <parameter name="@Action" value="Analitika_StrucnaOsposobljavanja" if="$tip==strucna osposobljavanja"/>
        <parameter name="@HRKadroviId" value="$HRKadroviId"/>
      </data>
      <data command="spZNRDjelatnici_Azur" name="dtBrisanje">
        <parameter name="@Action" value="Osnovni_Brisanje" if="$tip==osnovna"/>
        <parameter name="@Action" value="PosloviRizik_Brisanje" if="$tip==poslovi rizik"/>
        <parameter name="@Action" value="StrucnaOsposobljavanja_Brisanje" if="$tip==strucna osposobljavanja"/>
        <parameter name="@SelectedIds" value="#grdAnalitika.SelectedIds"/>
      </data>
    </datalist>
  </form>
</root>
