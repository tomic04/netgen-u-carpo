<root>
	<form name="frmPovijestStatusa" caption="Povijest statusa" width="500" height="400" >
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="1" >
				<item col="1" row="1" highlight="False" >
					<grid name="grdStatusiLog" dataname="global.dtStatusiLog" autopopulate="true" >								
						<fields>
							<field name="Datum" caption="Datum" formatstring="dd.MM.yyyy. HH:mm"/>
							<field name="Operater" caption="Operater" />
							<field name="Korak" caption="Korak" />
							<field name="Napomena" caption="Napomena" />
							<!-- <field name="U zamjenu za" caption="U zamjenu za" /> -->
						</fields>						
					</grid>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>		
	</form>
</root>