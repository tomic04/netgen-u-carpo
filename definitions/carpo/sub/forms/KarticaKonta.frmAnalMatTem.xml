<root>
	<form name="frmAnalMatTem" caption="Analitika materijalne temeljnice" width="800" height="500" saveformsize="true">
		<event type="load">
			<action type="control populate" value="#grdAnalMatTem"/>
		</event>
		<event type="shown">
			<action type="footer text" value="Broj stavki: {#grdAnalMatTem.rowcount}"/>
		</event>
		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
				<item col="1" row="1">
					<grid name="grdAnalMatTem" key="Id" dataname="~dtAnalMatTem" multiselect="true" savelayout="true" filedsmartspaces="false" showfooter="true">
						<fields inherited="true">
						
						</fields>
						<print caption="Analitika materijalne temeljnice" header=" "/>
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIspis" caption="ISPIS SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdAnalMatTem"/>
					</event>
				</button>
				<button name="btnZatvori" caption="ZATVORI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtAnalMatTem" command="spCKntKarticaKontaAnalMatTem">
				<parameter name="@Action" value="1"/>
				<parameter name="KntPrometId" value="$KntPrometId"/>
			</data>
		</datalist>
	</form>
</root>