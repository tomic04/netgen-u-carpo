<root>
	<!-- 18.7.2025. AČ dodala partnera u Dimenzije -->
	<form name="frmAtributiEdit" caption="Izmjena atributa za knjiženje" saveformsize="true" savelayout="true" saveformlayout="true">
		<method name="fnDimenzijeGla" dll="Dimenzije" class="DimenzijeNet.Dimenzije" method="run" />
		<event type="init">
			<action type="datarun reader" value="~dtGetAtributi"/>
		</event>
		<layout>
			<group cols="3" rows="8">
				<item col="1" row="1" caption="Konto" colspan="2" >
					<comboedit name="srcKonto" autopopulate="true"  dataname="~dtKonto" valuefield="KntPlanAId" displayfield="KNaziv" datavalue="~dtGetAtributi.@kntplanaid" required="true"/>
				</item>
				<item col="1" row="2" caption="Dev.duguje">
					<textedit name="txtDevDuguje" format="n2" datavalue="~dtGetAtributi.@devdug"/>
				</item>
				<item col="2" row="2" caption="Dev.potražuje">
					<textedit name="txtDevPotrazuje" format="n2" datavalue="~dtGetAtributi.@devpot"/>
				</item>
				<item col="3" row="2" caption="Tečaj">
					<textedit name="txtTecaj" datavalue="~dtGetAtributi.@tecaj"/>
				</item>
				<item col="1" row="3" caption="Duguje">
					<textedit name="txtDuguje" format="n2" datavalue="~dtGetAtributi.@duguje" required="true"/>				 
				</item>              
				<item col="2" row="3" caption="Potražuje">
					<textedit name="txtPotrazuje" format="n2" datavalue="~dtGetAtributi.@iznos" required="true"/>				  
				</item>               
				<item col="1" row="4" caption="Org.jedinica" colspan="2">
					<comboedit name="srcOrgShema" autopopulate="true" required="true" dataname="~dtOrgShema" valuefield="OrgShemaId" displayfield="Naziv"  datavalue="~dtGetAtributi.@OrgShemaId"/>	
				</item>               
				<item col="1" row="5" caption="Ključ rasporeda troška" colspan="2">
					<comboedit name="srcTrosak" autopopulate="true" required="true" dataname="~dtTrosak" valuefield="KeyCostMasterId" displayfield="Naziv"   datavalue="~dtGetAtributi.@KeyCostMasterId"/>
				</item>               
				<item col="1" row="6" caption="Opis" colspan="2">
					<textedit name="txtOpis" datavalue="~dtGetAtributi.@Opis"/>
				</item>
				
			</group>
		</layout>
		<actionpanel>
			<items>
				<item>
					<button name="btnSpremiStavku" caption="Spremi" image="add">
						<event type="click">
							<action type="datarun scalar" value="~dtSpremiStavku" />
							<action type="form close"/>
						</event>
					</button>
				</item>
				<item>
					<button name="btnOdustani" caption="Odustani" image="cancel" >
						<event type="click">
							<action type="form close"/>
						</event>
					</button>
				</item>
				<item>
					<button name="btnDimenzije" caption="Dimenzije" image="list" dock="right">
						<event type="click">
							<action type="method run" value="fnDimenzijeGla">
								<parameter name="server" value="@@server" />
								<parameter name="database" value="@@database" />
								<parameter name="username" value="" />
								<parameter name="password" value="" />
								<parameter name="OperateriId" value="@@operateriid" />
								<parameter name="Parent" value="0" />
								<parameter name="pTop" value="0" />
								<parameter name="pLeft" value="0" />
								<parameter name="path" value="" />
								<parameter name="tip" value="kupprometufadetid" />
								<parameter name="id" value="$kupprometufadetid" />
								<parameter name="glaid" value="$KupPrometId" />
								<parameter name="partneriid" value="$PartneriId"/>
							</action>
						</event>
					</button>
				</item>
			</items>
		</actionpanel>
		<datalist>
			<data name="dtGetAtributi" command="spKUPPrometUfaDetQuery">
				<parameter name="@action" value="stavkaufa"/>
				<parameter name="@Id" value="$KupPrometUfaDetId"/>
			</data>
			<data name="dtTecaj" command="spKUPPrometUfaDetQuery"> 
				<parameter name="@Action" value="tecaj" />
				<parameter name="@Id" value="$KupPrometId" />
			</data>
			<data name="dtSpremiStavku" command="spKUPPrometUfaDetQuery ">
				<parameter name="@Action" value="updateufa" />
				<parameter name="@Id" value="$KupPrometUfaDetId"/>
				<parameter name="@KUPPrometId" value="$KupPrometId" />
				<parameter name="@KntPlanAId" value="#srcKonto" />
				<parameter name="@Duguje" value="#txtDuguje" />
				<parameter name="@Iznos" value="#txtPotrazuje" />
				<parameter name="@devdug" value="#txtDevDuguje" />
				<parameter name="@devpot" value="#txtDevPotrazuje" />
				<parameter name="@tecaj" value="#txtTecaj" type="decimal" />
				<parameter name="@KeyCostMasterId" value="#srcTrosak" />
				<parameter name="@OrgshemaId" value="#srcOrgShema" />
				<parameter name="@opis" value="#txtOpis" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data name="dtKonto" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="konto" />
				<parameter name="@Konto" value="#srcKonto.text" />
			</data>
			<data name="dtTrosak" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="trosak" />
				<parameter name="@Trosak" value="#srcTrosak.text" />
			</data>
			<data name="dtOrgShema" command="spKupOdobravanjeGet">
				<parameter name="@Action" value="orgshema" />
				<parameter name="@OrgShema" value="#srcOrgShema.text" />
			</data>
		</datalist>
	</form>
</root>