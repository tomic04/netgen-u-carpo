<root>
	<form name="frmKupStavkeCarobnjak" width="400" height="480" caption="Ažuriranje više stavaka" operaterlocktable="KupUgovoriGla" operaterlockkey="KupUgovoriGlaId" operaterlockkeyvalue="global.$OperaterLockId"> 
		<event type="load">
            <action type="control disable" value="cmbCjenik" />
            <action type="control disable" value="cmbNaplata" />
            <action type="control disable" value="cmbIsporuka" />
            <action type="control disable" value="txtOdgoda" />
            <action type="control disable" value="txtPrvi" />
            <action type="control disable" value="txtDrugi" />
            <action type="control disable" value="txtTreci" />
            <action type="control disable" value="txtCetvrti" />
            <action type="control disable" value="txtPeti" />
            <action type="control disable" value="txtCassa" />
        </event>
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="3">
            <group caption="Postavke" name="Postavke" cols="2" rows="4" col="1" row="1" spacing="0,0,0,8">
                <item row="1" col="1">
                        <checkedit name="chkCjenik" caption="Cjenik:" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#cmbCjenik" if="#chkCjenik==true" >
                                    <action type="control focus" value="#cmbCjenik"></action>
                                </action>
                                <action type="control disable" value="#cmbCjenik" else="" >
                                    <action type="control focus" value="#chkCjenik"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="2" col="1">
                        <checkedit name="chkNaplata" caption="Naplata:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#cmbNaplata" if="#chkNaplata==true" >
                                    <action type="control focus" value="#cmbNaplata"></action>
                                </action>
                                <action type="control disable" value="#cmbNaplata" else="" >
                                    <action type="control focus" value="#chkNaplata"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="3" col="1">
                        <checkedit name="chkIsporuka" caption="Isporuka:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#cmbIsporuka" if="#chkIsporuka==true" >
                                    <action type="control focus" value="#cmbIsporuka"></action>
                                </action>
                                <action type="control disable" value="#cmbIsporuka" else="" >
                                    <action type="control focus" value="#chkIsporuka"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="4" col="1">
                        <checkedit name="chkOdgoda" caption="Odgoda:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtOdgoda" if="#chkOdgoda==true" >
                                    <action type="control focus" value="#txtOdgoda"></action>
                                </action>
                                <action type="control disable" value="#txtOdgoda" else="" >
                                    <action type="control focus" value="#chkOdgoda"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="1" col="2">
                        <comboedit name="cmbCjenik" valuefield="VrCjenikid" displayfield="Opis" datavalue="~dtGet.@VrCjenikId" dataname="Global.dtPuniCjenik" />
                    </item>		
                    <item row="2" col="2">
                        <comboedit name="cmbNaplata" valuefield="ProNacinNaplateId" displayfield="Opis" datavalue="~dtGet.@ProNacinNaplateId" dataname="Global.dtPuniNaplatu"/>
                    </item>
                     <item row="3" col="2">
                        <comboedit name="cmbIsporuka" valuefield="ProNacinIsporukeId" displayfield="Naziv" datavalue="~dtGet.@ProNacinIsporukeId" dataname="Global.dtPuniIsporuku" />
                    </item>	
                     <item row="4" col="2">
                        <textedit name="txtOdgoda" format="n0" type="int" value="0" datavalue="~dtGet.@Odgoda" />
                    </item>			
                </group>

                <group caption="Rabat" name="Rabat" cols="2" rows="5" col="1" row="2" spacing="0,0,0,8">
                    <item row="1" col="1">
                        <checkedit name="chkPrvi" caption="Prvi:" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtPrvi" if="#chkPrvi==true" >
                                    <action type="control focus" value="#txtPrvi"></action>
                                </action>
                                <action type="control disable" value="#txtPrvi" else="" >
                                    <action type="control focus" value="#chkPrvi"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="2" col="1">
                        <checkedit name="chkDrugi" caption="Drugi:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtDrugi" if="#chkDrugi==true" >
                                    <action type="control focus" value="#txtDrugi"></action>
                                </action>
                                <action type="control disable" value="#txtDrugi" else="" >
                                    <action type="control focus" value="#chkDrugi"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="3" col="1">
                        <checkedit name="chkTreci" caption="Treći:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtTreci" if="#chkTreci==true" >
                                    <action type="control focus" value="#txtTreci"></action>
                                </action>
                                <action type="control disable" value="#txtTreci" else="" >
                                    <action type="control focus" value="#chkTreci"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="4" col="1">
                        <checkedit name="chkCetvrti" caption="Četvrti:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtCetvrti" if="#chkCetvrti==true" >
                                    <action type="control focus" value="#txtCetvrti"></action>
                                </action>
                                <action type="control disable" value="#txtCetvrti" else="" >
                                    <action type="control focus" value="#chkCetvrti"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="5" col="1">
                        <checkedit name="chkPeti" caption="Peti:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtPeti" if="#chkPeti==true" >
                                    <action type="control focus" value="#txtPeti"></action>
                                </action>
                                <action type="control disable" value="#txtPeti" else="" >
                                    <action type="control focus" value="#chkPeti"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="1" col="2">
                        <textedit name="txtPrvi" value="0" maxlength="6"  format="n4" type="decimal"/>
                    </item>		
                    <item row="2" col="2">
                        <textedit name="txtDrugi" value="0" maxlength="6"  format="n4" type="decimal" />
                    </item>
                     <item row="3" col="2">
                        <textedit name="txtTreci" value="0" maxlength="6"  format="n4" type="decimal" />
                    </item>	
                    <item row="4" col="2">
                        <textedit name="txtCetvrti" value="0" maxlength="6"  format="n4" type="decimal"/>
                    </item>	
                    <item row="5" col="2">
                        <textedit name="txtPeti" value="0" maxlength="6"  format="n4" type="decimal"/>
                    </item>			
                </group>

                <group name="Cassa" cols="2" rows="1" col="1" row="3" spacing="0,0,0,4">
                    <item row="1" col="1">
                        <checkedit name="chkCassa" caption="Cassa:">
                            <event type="checkedchanged">
                                <action type="control enable" value="#txtCassa" if="#chkCassa==true" >
                                    <action type="control focus" value="#txtCassa"></action>
                                </action>
                                <action type="control disable" value="#txtCassa" else="" >
                                    <action type="control focus" value="#chkCassa"></action>
                                </action>
                            </event>
                        </checkedit>
                    </item>
                    <item row="1" col="2">
                        <textedit name="txtCassa"  value="0" maxlength="6"  format="n4" type="decimal"/>
                    </item>		
                </group>
            </group>
		</layout>
		<panelbuttons>
			<buttons>
                <button name="btnSpremi" caption="Spremi">
                    <event type="click">
                        <action type="datarun nonquery" value="~dtSpremi" />
                        <action type="control populate" value="parent.#grdDetalj" />
                        <action type="form close" />
                    </event>
                </button>
                <button name="btnOdustani" caption="Odustani" type="cancel" />
			</buttons>
		</panelbuttons>
		<datalist>
            <data command="spProd_KupUgovoriIzmjena_ViseStavaka_Temp" name="dtSpremi">
                <parameter name="@id" value="$@KupUgovoriDetTempId" />
                <parameter name="@VrCjenikId" value="#cmbCjenik" if="#chkCjenik==true"/>
                <parameter name="@ProNacinNaplateId" value="#cmbNaplata" if="#chkNaplata==true"/>
                <parameter name="@ProNacinIsporukeId" value="#cmbIsporuka" if="#chkIsporuka==true"/>
                <parameter name="@Odgoda" value="#txtOdgoda" if="#chkOdgoda==true"/>
                <parameter name="@Rabat1" value="#txtPrvi" if="#chkPrvi==true"/>
                <parameter name="@Rabat2" value="#txtDrugi" if="#chkDrugi==true"/>
                <parameter name="@Rabat3" value="#txtTreci" if="#chkTreci==true"/>
                <parameter name="@Rabat4" value="#txtCetvrti" if="#chkCetvrti==true"/>
                <parameter name="@Rabat5" value="#txtPeti" if="#chkPeti==true"/>
                <parameter name="@Cassa1" value="#txtCassa" if="#chkCassa==true"/>
                <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
            </data>

        </datalist>
	</form>    
    
</root>