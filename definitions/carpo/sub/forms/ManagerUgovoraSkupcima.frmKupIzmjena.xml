<root>
	<form name="frmKupIzmjena"  width="1000" height="570" operaterlocktable="KupUgovoriGla" operaterlockkey="KupUgovoriGlaId" operaterlockkeyvalue="Global.$OperaterLockId"> 
		<event type="oninit">
			    <action type="datarun reader" value="~dtGet" />
          <action type="datarun reader" value="~dtPubVars" />
        </event>
        <event type="onload">
            <action type="variable value" value="pendingPromjenaStatusa">
                <parameter value="0" />
            </action>
            <action type="variable value" value="FilterInd">
                <parameter value="parent.$FilterInd" />
            </action>
            <action type="control visible" value="#srcParStru" if="~dtPubvars.@VarSet==1">
            </action>
            <action type="control disable" value="#srcParStru" if="~dtPubvars.@VarSet==0">
            </action>
            <action type="control visible" value="#srcParStru" if="~dtPubvars.@VarSet==2">
                <parameter value="false" />
            </action>
			      <action type="control visible" value="#btnParstru" if="~dtPubvars.@VarSet==1">
                <parameter value="false" />
            </action>
            <action type="control visible" value="#btnParstru" if="~dtPubvars.@VarSet==0">
                <parameter value="false" />
            </action>
            <action type="control visible" value="#btnParstru" if="~dtPubvars.@VarSet==2">
            </action>
            <action type="control populate" value="#grdDetalj"/>
            <action type="control disable" value="#datVrijedido" if="#datVrijedido==null">
            </action>
            <action type="control value" value="#datVrijedido">
              <parameter value="now" />
            </action>
            <action type="variable value" if="#grdDetalj.rowcount!=0">
                <parameter name="IndStavki" value="1" />
            </action>
            <action type="variable value" else="">
                <parameter name="IndStavki" value="0" />
            </action>
        </event>
        <event type="onshown">
            <action type="form caption" value="Izmjena ugovora s kupcem" if="$kopiranje!=null" />
            <action type="form caption" value="Izmjena dokumenta" else="" />
		      	<action type="control focus" value="#cmbVrsta"/>
            <action type="control disable" value="#btnEditDetalj" if="$IndStavki==0||parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnDelDetalj" if="$IndStavki==0||parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnStavke" if="$IndStavki==0||parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnSpremi" if="parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnPromjeniStatus" if="parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnDodatno" if="parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnSadrzaj" if="parent.#grdGlava.@Status=='Zakljucen'" />
            <action type="control disable" value="#btnAddDetalj" if="parent.#grdGlava.@Status=='Zakljucen'" />
        </event>
        <event type="close">
			    <action type="control populate keepfocus" value="parent.#grdGlava" />
          <action type="variable value" value="Global.$OperaterLockId">
              <parameter value="0" />
          </action> 
		    </event>		
		<layout textposition="left" itemspadding="3">
        <group cols="1" rows="1">
            <group padding="0" groupbordervisible="False" cols="2" rows="1">
                <columnsdefinition>
                    <column size="390" position="1" />
                    <column size="8" position="2" />
                </columnsdefinition>
                <!--PRVI-->
                <group caption="Osnovno" name="Osnovno" cols="1" rows="10" col="1" row="1" >
                    <rowsdefinition>
						<row position="8" size="35" />
					</rowsdefinition>
                    <part name="manageratributi" path="prtManager.xml"/>						
                </group>
                <!--Drugi-->
                <group padding="0" groupbordervisible="False" cols="1" rows="2" col="3" row="1">
                    <rowsdefinition>
                        <row size="54" position="2" />
                    </rowsdefinition>
                    <item row="1" col="1"  >
                                <grid name="grdDetalj" dataname="~detGrid"  bestfitonrefresh="true" key="KupUgovoriDetId" multiselect="true">
                                    <fields inherited="true">
                                        <field name="Naziv" fontbold="true"/>
                                        <field name="Šifra" fontbold="true"/>
                                        <field name="Način Naplate" caption="Način naplate" />
                                        <field name="Način Isporuke" caption="Način isporuke"/>
                                        <field name="rABAT1." format="n4"/>
                                        <field name="rABAT2." format="n4"/>
                                        <field name="rABAT3." format="n4"/>
                                        <field name="rABAT4." format="n4"/>
                                        <field name="rABAT5." format="n4"/>
                                        <field name="Ukupni Rabat" caption="Ukupni rabat" format="n4"/>
                                        <field name="Ukupni Popust" caption="Ukupni popust" format="n4"/>
                                        <field name="Cijena S Popustom" caption="Cijena s popustom" format="n4" />
                                        <field name="Učešće U Povratu" caption="Učešće u povratu" format="n4"/>
                                        <field name="Kolicina" caption="Količina" format="n4" />
                                        <field name="Cassa" format="n4" />
                                        <field name="Cijena" format="n4" />
                                        <field name="Pausal" caption="Paušal" />
                                    </fields>
                                    <styles>
                                        <style name="fontcolor" value="black" if="#grdDetalj.@formatid==black" />
                                        <style name="fontcolor" value="blue" if="#grdDetalj.@formatid==blue" />
                                    </styles>
                                </grid>
                    </item>
                    <group padding="0" groupbordervisible="true" cols="4" rows="1" col="1" row="2">
                        <item row="1" col="1" textvisible="False">
                            <button name="btnAddDetalj" caption="Dodaj" image="add" type="add">
                                <event type="click">
                                    <action type="form open" value="frmKupDodajDetalje" >
                                        <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                                        <parameter name="Odabrani" value="$Odabrani" />
                                    </action>
                                </event>
                            </button>
                        </item>
                        <item row="1" col="2" textvisible="False">
                            <button name="btnEditDetalj" caption="Izmjeni" image="edit">
                                <event type="click">
                                    <action type="form open" value="frmKupIzmjeniDetalje">
                                        <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                                        <parameter name="KupUgovoriDetId" value="#grdDetalj.@KupUgovoriDetId" />
                                    </action>
                                </event>
                            </button>
                        </item>
                        <item row="1" col="3" textvisible="False">
                            <button caption="Obriši" name="btnDelDetalj" image="delete">
                                <event type="click">
                                    <action type="confirm" value="Brisanje stavke {#grdDetalj.@Naziv}. Nastaviti?" if="#grdDetalj.rowcount==1"/>
                                    <action type="confirm" value="Želite li zaista obrisati odabrane stavke?" else=""/>
                                    <action type="control foreachrowselected" value="#grdDetalj">
                                    <action type="datarun nonquery" value="~dtDeleteDetalj" />
                                    </action>
                                    <action type="control populate" value="#grdDetalj">
                                        <action type="control populate" value="parent.#grdDetalj" />
                                    </action>
                                    <action type="control disable" value="#btnEditDetalj" if="#grdDetalj.rowcount==0" />
                                    <action type="control disable" value="#btnDelDetalj" if="#grdDetalj.rowcount==0" />
                                    <action type="control disable" value="#btnStavke" if="#grdDetalj.rowcount==0" />
                                </event>
                            </button>
                        </item>
                        <item row="1" col="4" textvisible="False">
                            <button name="btnStavke" caption="Izmjena više stavaka">
                                <event type="click">
                                    <action type="form open" value="frmKupStavke">
                                        <parameter name="SelectedIDs" value="#grdDetalj.selectedids" />
                                         <parameter name="KupUgovoriGlaId" value="$kupugovoriglaid" />
                                       <parameter name="KupUgovoriDetId" value="#grdDetalj.@KupUgovoriDetId" />
                                    </action>
                                    <action type="control populate" value="#grdDetalj" />
                                </event>
                            </button>
                        </item>
                      </group>
                </group>
            </group>
        </group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnDodatno" caption="Dodatni uvjeti" dock="right">
            <event type="click">
                <action type="form open" value="frmKupDodatniUvjeti" >
                    <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                </action>
            </event>
				</button>			
				<button name="btnSadrzaj" caption="Sadržaj" dock="right" >
				</button>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
            <action type="validate">
              <action type="datarun scalar" value="~dtZahtjevIzmjena">
                <parameter name="KupUgovoriGlaId"  />
              </action>
              <action type="datarun nonquery" value="dtPromjeniStatus" if="$pendingPromjenaStatusa==1" />
              <action type="control populate" value="parent.#tree"/>
              <action type="control focus" value="parent.#tree">
                <parameter value="#srcPartner"/>
              </action>
              <action type="form close"/>
            </action>
          </event>    
        </button>
        <button name="btnPromjeniStatus" caption="Promjeni status" >
					<event type="click">
              <action type="variable value" value="$pendingPromjenaStatusa">
                  <parameter value="1" />
              </action>
              <action type="message" value="'Status će biti izmjenjen u 'Zaključen' nakon spremanja izmjena'" if="parent.#grdGlava.@Status=='Nezaključen'" />
              <action type="message" value="'Status će biti izmjenjen u 'Nezaključen' nakon spremanja izmjena'" else="" />
          </event>
				</button>
				<button name="btnPrint" caption="Ispiši" dataname="~dtPrint" displayfield="Opis" >
					<event type="click">
						<action type="control printcontrol" value="#grdDetalj"/>
					</event>
				</button>
        <button name="btnZatvori" caption="Zatvori" >
            <event type="click">
                <action type="control focus" value="parent.#tree">
                  <parameter value="#srcPartner"/>
                </action>
					      <action type="form close"/>
            </event>
				</button>								
			</buttons>
		</panelbuttons>
		<datalist>
        <data command="spProd_KupUgovori_Izmjena" name="dtZahtjevIzmjena">
				<parameter name="@Broj" value="#txtBroj" />
				<parameter name="@KupUgovoriVrsteId" value="#cmbVrsta" />
				<parameter name="@DatumUgovora" value="#datDatum" />
				<parameter name="@UgovorVrijediDo" value="#datVrijedido" />
				<parameter name="@OrgShemaId" value="#cmbOrgShema" />
				<parameter name="@OsobeId" value="#srcOsobe" />
				<parameter name="@PartneriId" value="#srcPartner" />
				<parameter name="@Opis" value="#txtOpis" />
				<parameter name="@ParStruId" value="#srcParstru" />
				<parameter name="@operateriid" value="@@operateriid" />
        <parameter name="@DinamikaFak" value="#cmbDinFak" />
        <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
       </data>	
       <data command="spProd_KupUgoIzmjena_Stavke" name="dtDeleteDetalj">
          <parameter name="@Action" value="3" />
          <parameter name="@KupUgovoriDetId" value="#grdDetalj.@KupUgovoriDetId" />
       </data>
       <data command="spProd_KupUgoDet_Query" name="detGrid">
          <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
      </data>
			<data command="spProd_KupUgoIzmjena_PuniFormu" name="dtGet">
         <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
			</data>
      <data command="spTraziPartneri" name="dtPartneri">
				<parameter name="@Action" value="Partneri" />
				<parameter name="@Uvjet" value="#srcPartner.text" />
				<parameter name="@broj_lokacija" value="1" />
			</data>
      <data command="spPubVarsQuery" name="dtPubVars">
				<parameter name="@Action" value="2" />
				<parameter name="@VarIme" value="KupUgovoriParsTru" />
				<parameter name="@Id" value="null" />
			</data>
      <data command="spCarpoPrint" name="dtPrint">
				<parameter name="@Action" value="GetTemplates" />
				<parameter name="@Id" value="$KupUgovoriGlaId" type="int" />
				<parameter name="@Tablica" value="KupUgovoriGla" />
			</data>		  
      <data command="spProd_KupUgoStatus" name="dtPromjeniStatus">
			  	<parameter name="@action" value="1" />
		  		<parameter name="@status" value="0" type="int" if="parent.#grdGlava.@Status=='Zaključen'" />
          <parameter name="@status" value="1" type="int" else="" />
				  <parameter name="@kupugovoriglaid" value="parent.#grdGlava.@KupUgovoriGlaId" />
          <parameter name="@vrstadokid" value="220" />
          <parameter name="@operateriid" value="@@operateriid" />
			</data>	
      <data command="spProd_KupUgoObrisiKop" name="dtObrisiKop">
          <parameter name="@KupUgovoriGlaId" value="$KupUgovoriGlaId" />
      </data>
    </datalist>
	</form> 
</root>