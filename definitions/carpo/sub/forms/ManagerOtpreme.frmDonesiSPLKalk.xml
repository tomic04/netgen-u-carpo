<root>
    <form name="frmDonesiSPLKalk" caption="Donesi s prijemnog lista / kalkulacije" >
        <layout textposition="top" itemspadding="3">
            <group cols="1" rows="1" groupbordervisible="False">
                <group cols="3" rows="2" groupbordervisible="False">
                    <columnsdefinition>
                        <column size="20%" position="1" />
                        <column size="35%" position="2" />
						<column size="45%" position="3" />
                    </columnsdefinition>
					<group cols="1" rows="2" row="1" col="1" groupbordervisible="True" caption="Donesi s:">
						<item row="1" col="1" caption="">
							<radioedit name="rdoKalkulacija" caption="Kalkulacije" value="true" groupindex="1">
								<event type="checkedchanged">
								</event>
							</radioedit>
						</item>
						<item row="2" col="1" caption="">
							<radioedit name="rdoPrimka" caption="Primke" value="false" groupindex="1">
								<event type="checkedchanged">
								</event>
							</radioedit>
						</item>
					</group>
					<group cols="1" rows="3" col="2" row="1" groupbordervisible="True" caption="Nabavna cijena:">
						<item row="1" col="1" caption="">
							<radioedit name="rdoNabC_PL_KALK" caption="Nabavna s primke / kalkulacije" value="true" groupindex="2">
								<event type="checkedchanged">
								</event>
							</radioedit>
						</item>
						<item row="2" col="1" caption="">
							<radioedit name="rdoFakC_PL_KALK" caption="Fakturna s primke / kalkulacije" value="false" groupindex="2">
								<event type="checkedchanged">
								</event>
							</radioedit>
						</item>
						<item row="3" col="1" caption="">
							<radioedit name="rdoNabC_Cjenik" caption="Nabavna s cjenika" value="false" groupindex="2">
								<event type="checkedchanged">
								</event>
							</radioedit>
						</item>
					</group>
					<group cols="1" rows="2" col="3" row="1"  groupbordervisible="False" >
						<group cols="1" rows="2" groupbordervisible="True" caption="Prodajna cijena:">
							<group cols="3" rows="1" row="1" col="1" groupbordervisible="false" >
								<columnsdefinition>
									<column size="60%" position="1" />
									<column size="40%" position="2" />
									<column size="10%" position="3" />
								</columnsdefinition>
								<item row="1" col="1" caption="">
									<radioedit name="rdoPC_Nab" caption="Nabavna uvećana za maržu" value="true" groupindex="3">
										<event type="checkedchanged">
											<action type="control enable" value="txtPC_Marza"/>
										</event>
									</radioedit>
								</item>
								<item row="1" col="2" textalignmode="auto">
									<textedit name="txtPC_Marza" value="0" format="n2" />
								</item>
								<item row="1" col="3" textvisible="False" padding="0" textalignmode="left">
									<labeledit value="%" textalignmode="left"/>
								</item>								
							</group>
							<item row="2" col="1" caption="">
								<radioedit name="rdoPC_Prod" caption="Prodajna s cjenika / ugovora" value="false" groupindex="3">
									<event type="checkedchanged">
										<action type="control disable" value="txtPC_Marza"/>
									</event>
								</radioedit>
							</item>
						</group>
						<group cols="2" rows="1" row="2" col="1" groupbordervisible="false" >
							<columnsdefinition>
								<column size="60%" position="1" />
								<column size="40%" position="2" />
							</columnsdefinition>
							<item row="1" col="2" textvisible="True">
								<button caption="Pokaži">
									<event type="click">
										<action type="validate" />
										<!-- <action type="datarun nonquery" value="~dtDetPrimka" /> -->
										<action type="control populate" value="#grdStavke" />
									</event>
								</button>
							</item>
						</group>
					</group>
                    <item row="2" col="1" colspan="3">
                        <grid name="grdStavke" async="true" dataname="dtDetPrimka" multiselect="false" key="id" showgrouppanel="False">
                            <fields inherited="true">
                                <!-- <field name="Sifra" caption="Šifra" /> -->
