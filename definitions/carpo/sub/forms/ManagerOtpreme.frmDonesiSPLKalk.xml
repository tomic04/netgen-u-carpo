        <datalist>
            <data command="spProd_NOtpDonosPrimkeKalk" name="dtDetPrimka">
				<parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
				<parameter name="@donos_sa" value="r" if="#rdoKalkulacija==true"/>
				<parameter name="@donos_sa" value="p" else=""/>
            </data>
            <data command="select case when @PakJMId is null then 0 else case when @Faktor = 0 then @Kolicina else @Kolicina / @Faktor end end as PakKolicina" type="text" name="dtKolPak">
                <parameter name="@Kolicina" value="#grdStavke.@Kolicina" />
                <parameter name="@Faktor" value="#grdStavke.@faktor" />
				<parameter name="@PakJMId" value="#grdStavke.@jm2id" />
            </data>			
            <data command="spProd_NOtpDonosPrimkeKalk_Azur" name="dtStavkaUnos">
                <parameter name="@ProNotpGlaId" value="$ProNotpGlaId" />
                <parameter name="@izvor_id" value="#grdStavke.@Id" />
				<parameter name="@donos_sa" value="r" if="#rdoKalkulacija==true"/>
				<parameter name="@donos_sa" value="p" else=""/>				
				<parameter name="@nabavna_ind" value="0" if="#rdoNabC_PL_KALK==true"/>
				<parameter name="@nabavna_ind" value="1" elseif="#rdoFakC_PL_KALK==true"/>	
				<parameter name="@nabavna_ind" value="2" else=""/>
				<parameter name="@prodajna_ind" value="1" if="#rdoPC_Prod==true"/>
				<parameter name="@prodajna_ind" value="0" else=""/>				
				<parameter name="@marza" value="#txtPC_Marza" />	
				<parameter name="@ParStruId" value="$ParStruId" />	
            </data>
