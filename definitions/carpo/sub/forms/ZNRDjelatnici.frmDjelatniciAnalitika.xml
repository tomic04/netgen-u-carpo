                      <menuitem caption="Izmijeni" name="menIzmjenaStrucnaOsposobljavanja" sort="1">
                        <event type="click">
                          <action type="form open" value="frmIzmjStrucnaOsposobljavanja" >
                            <parameter name="Tip" value="izmjena strucna osposobljavanja" />
                            <parameter name="ZNRDjelatniciStrucnaOsposobljavanjaPrometId" value="#grdStrucnaOsposobljavanja.@ZNRDjelatniciStrucnaOsposobljavanjaPrometId" />
                          </action>
