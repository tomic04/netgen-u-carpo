                  </button>
                </item>
              </group>
            </group>
            <group col="1" row="1" cols="1" rows="3" caption="Liječnički pregledi" fontbold="true" groupbordervisible="false">
              <rowsdefinition>
                <row position="1" size="10%"/>
                <row position="2" size="80%"/>
                <row position="3" size="10%"/>
              </rowsdefinition>
              <group col="1" row="1" cols="3" rows="1" groupbordervisible="false">
                <columnsdefinition>
                  <column position="1" size="10%"/>
                  <column position="2" size="10%"/>
