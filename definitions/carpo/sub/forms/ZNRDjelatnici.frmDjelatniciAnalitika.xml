<root version="1.0">

  <form name="frmDjelatniciAnalitika" caption="" width="1800" height="1000" fixedsize="true">
    <method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
    <event type="init">
      <action type="datarun reader" value="~dtGet" />
      <action type="datarun reader" value="~dtZNRDMS" />
    </event>
    <event type="load">
      <action type="control populate" value="#grdOsnovna" />
      <action type="control populate" value="#grdPosloviRizik" />
      <action type="control populate" value="#grdStrucnaOsposobljavanja" />
    </event> 
    <event type="shown">
      <action type="control visible" value="#btnPregledOsnovniDok,#btnPregledPosloviRizikDok,#btnPregledStrucnaOsposobljavanjakDok,#btnPregledLijecnickiDok,#btnPregledDokumentiDok" if="~dtZNRDMS.@Postavka==0">
        <parameter value="false"/>
      </action>
      <action type="control attribute" value="#picSlika"  >
        <parameter name="dbimg" value="~dtGet.@Slika" />
      </action>
      <action type="control value" value="#lblMaticniBroj"  >
        <parameter value="~dtGet.@MaticniBroj" />
      </action>
      <action type="control value" value="#lblIme"  >
        <parameter value="~dtGet.@Ime" />
      </action>
      <action type="control value" value="#lblPrezime"  >
        <parameter value="~dtGet.@Prezime" />
      </action>
      <action type="control value" value="#lblDatumRodenja"  >
        <parameter value="~dtGet.@DatumRodenja" />
      </action>
      <action type="control value" value="#lblMjestoRodenja"  >
        <parameter value="~dtGet.@MjestoRodenja" />
      </action>
      <action type="control value" value="#lblOIB"  >
        <parameter value="~dtGet.@OIB" />
      </action>
      <action type="control value" value="#lblRoditelj"  >
        <parameter value="~dtGet.@Roditelj" />
      </action>
      <action type="control value" value="#lblZanimanje"  >
        <parameter value="~dtGet.@Zanimanje" />
      </action>
      <action type="control value" value="#lblSprema"  >
        <parameter value="~dtGet.@Sprema" />
      </action>
      <action type="control value" value="#lblDatumZaposlenja"  >
        <parameter value="~dtGet.@DatumZaposlenja" />
      </action>
      <action type="control value" value="#lblUkupanStaz"  >
        <parameter value="~dtGet.@UkupanStaz" />
      </action>
      <action type="control value" value="#lblFirmaStaz"  >
        <parameter value="~dtGet.@FirmaStaz" />
      </action>
      <action type="control value" value="#lblPoslovnajedinica"  >
        <parameter value="~dtGet.@Poslovnajedinica" />
      </action>
      <action type="control value" value="#lblOvlastenik"  >
        <parameter value="~dtGet.@Ovlastenik" />
      </action>
      <action type="control value" value="#lblRM"  >
        <parameter value="~dtGet.@RadnoMjesto" />
      </action>
      <action type="menu disable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" if="#grdOsnovna.@indObvezno==false"/>
      <action type="menu enable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" else="" />
      <action type="menu disable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" if="#grdPosloviRizik.@indObvezno==false"/>
      <action type="menu enable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" else="" />
      <action type="menu disable" value="#menPriloziStrucnaOsposobljavanja,#menIzmjenaStrucnaOsposobljavanja" if="#grdStrucnaOsposobljavanja.@indObvezno==false"/>
      <action type="menu enable" value="#menPriloziStrucnaOsposobljavanja,#menIzmjenaStrucnaOsposobljavanja" else="" />
    </event>
    <layout>
      <group cols="1" rows="2" groupbordervisible="false">
        <rowsdefinition>
          <row position="1" size="25%"/>
          <row position="2" size="75%"/>
        </rowsdefinition>
        <group col="1" row="1" cols="4" rows="5" caption="Osnovni podaci" fontbold="true" spacing="2,2,2,1">
          <columnsdefinition>
            <column position ="1" size="200" />
            <column position ="2" size="300" />
            <column position ="3" size="450" />
            <column position ="4" size="450" />
          </columnsdefinition>
          <item col="1" row="1" fontbold="true" rowspan="5">
            <pictureedit name="picSlika" dbimg="" />
          </item>
          <item  col="2" row="1" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblMaticniBroj" caption="Matični broj:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="2" row="2" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblIme" caption="Ime:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="2" row="3" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblPrezime" caption="Prezime:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="2" row="4" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblDatumRodenja" caption="Datum rođenja:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="2" row="5" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblMjestoRodenja" caption="Mjesto rođenja:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="3" row="1" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblOIB" caption="OIB:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="3" row="2" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblRoditelj" caption="Ime oca/majke:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="3" row="3" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblZanimanje" caption="Zanimanje:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="3" row="4" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblSprema" caption="Školska sprema:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="3" row="5" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblDatumZaposlenja" caption="Datum zaposlenja:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="4" row="1" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblUkupanStaz" caption="Ukupan staž:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="4" row="2" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblFirmaStaz" caption="Staž u firmi:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="4" row="3" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblPoslovnajedinica" caption="Poslovna jedinica/odjel:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="4" row="4" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblOvlastenik" caption="Ovlaštenik poslodavca:  " enabled="false" fontbold="true"/>
          </item>
          <item  col="4" row="5" fontbold="true"  highlight="false" textposition="right">
            <labeledit name="lblRM" caption="Radno mjesto:  " enabled="false" fontbold="true"/>
          </item>
        </group>
        <group col="1" row="2" cols="1" rows="1" spacing="2,2,1,2" >
          <tabs row="1" col="1" >
            <!--grid postavljen u grupu zbog captiona-->
            <group col="1" row="1" cols="2" rows="2" caption="Osposobljavanja" fontbold="true" groupbordervisible="false">
              <rowsdefinition>
                <row position="1" size="270" />
                <row position="2" size="370" />
              </rowsdefinition>
              <group col="1" row="1" cols="8" rows="2" caption="Osnovna osposobljavanja" fontbold="true" groupbordervisible="true" spacing="2,2,2,1" colspan="2">
                <rowsdefinition>
                  <row position="1" size="75%" />
                  <row position="2" size="25%" />
                </rowsdefinition>
                <item col="1" row="1" highlight="false" colspan="8">
                  <grid name="grdOsnovna" key="ZNRDjelatniciOsnovnaPrometId" dataname="dtOsnovna" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
                    <event type="cellvaluechanged">
                      <action type="datarun nonquery" value="~dtUpdateIndOsnovna" />
                      <action type="control populate keepfocus" value="#grdOsnovna" />
                      <action type="menu disable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" if="#grdOsnovna.@indObvezno==false"/>
                      <action type="menu enable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" else="" />
                    </event>
                    <fields inherited="true">
                      <field name="indObvezno" caption="Obvezno" editable="true" edittype="bit"/>
                      <field name="DatumOsposobljavanja" caption="Datum osposobljavanja"/>
                      <field name="DatumIsteka" caption="Datum isteka"/>
                    </fields>
                    <menu>
                      <menuitem caption="Izmijeni" name="menIzmjenaOsnovni" sort="1">
                        <event type="click">
                          <action type="form open" value="frmIzmjOsnovni" >
                            <parameter name="Tip" value="izmjena osnovni" />
                            <parameter name="ZNRDjelatniciOsnovnaPrometId" value="#grdOsnovna.@ZNRDjelatniciOsnovnaPrometId" />
                          </action>
                          <action type="control populate keepfocus" value="#grdOsnovna" />
                        </event>
                      </menuitem>
                      <menuitem caption="Priloži dokument" name="menPriloziOsnovna" sort="2" function="PriloziOsnovna">
                        <event type="click">
                          <action type="method run" value="funDmsAdd">
                            <parameter name="server" value="@@server" />
                            <parameter name="database" value="@@database" />
                            <parameter name="username" value="" />
                            <parameter name="password" value="" />
                            <parameter name="operaterid" value="@@operateriid"/>
                            <parameter name="entityName" value="ZNRDjelatniciOsnovnaPromet" />
                            <parameter name="entityId" value="#grdOsnovna.@ZNRDjelatniciOsnovnaPrometId" />
                          </action>
                        </event>
                      </menuitem>
                    </menu>
                    <event type="focusedrowchanged" >
                      <action type="menu disable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" if="#grdOsnovna.@indObvezno==false"/>
                      <action type="menu enable" value="#menIzmjenaOsnovni,#menPriloziOsnovna" else="" />
                    </event>
                  </grid>
                </item>
                <item col="7" row="2" highlight="false">
                  <button name="btnPregledOsnovniDok"  caption="Pregled dokumenata" >
                    <event type="click">
                      <action type="form open" value="frmDokumentiPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Osnovna osposobljavanja - dokumenti"/>
                        <parameter name="tip" value="osnovna"/>
                        <parameter name="EntityName" value="ZNRDjelatniciOsnovnaPromet"/>
                      </action>
                    </event>
                  </button>
                </item>
                <item col="8" row="2" highlight="false">
                  <button name="btnPregledOsn"  caption="Analitika" >
                    <event type="click">
                      <action type="form open" value="frmAnalitikaPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Osnovna osposobljavanja - analitika"/>
                        <parameter name="tip" value="osnovna"/>
                        <parameter name="Naziv" value="Osnovno osposobljavanje"/>
                      </action>
                      <action type="control populate" value="#grdOsnovna" />
                    </event>
                  </button>
                </item>
              </group>
              <group col="1" row="2" cols="8" rows="2" caption="Osposobljavanja za rad na siguran način" fontbold="true" groupbordervisible="true" spacing="2,1,1,2">
                <rowsdefinition>
                  <row position="1" size="85%" />
                  <row position="2" size="15%" />
                </rowsdefinition>
                <item col="1" row="1" highlight="false" colspan="8">
                  <grid name="grdPosloviRizik" key="ZNRDjelatniciPosloviRizikPrometId" dataname="dtPosloviRizik" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
                    <event type="cellvaluechanged">
                      <action type="datarun nonquery" value="~dtUpdateIndPosloviRizik" />
                      <action type="control populate keepfocus" value="#grdPosloviRizik" />
                      <action type="menu disable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" if="#grdPosloviRizik.@indObvezno==false"/>
                      <action type="menu enable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" else="" />
                    </event>
                    <fields>
                      <field name="Naziv" fixwidth="400" rowautoheight="true"/>
                      <field name="indObvezno" caption="Obvezno" editable="true" edittype="bit"/>
                      <field name="DatumOsposobljavanja" caption="Datum osposobljavanja"/>
                      <field name="DatumIsteka" caption="Datum isteka"/>
                    </fields>
                    <styles>
                      <style name="fontcolor" value="#FF0000" if="#grdPosloviRizik.@ZNRRadnaMjesta_PosloviRizikId==0" />
                    </styles>
                    <menu>
                      <menuitem caption="Izmijeni" name="menIzmjenaPosloviRizik" sort="1">
                        <event type="click">
                          <action type="form open" value="frmIzmjPosloviRizik" >
                            <parameter name="Tip" value="izmjena poslovi rizik" />
                            <parameter name="ZNRDjelatniciPosloviRizikPrometId" value="#grdPosloviRizik.@ZNRDjelatniciPosloviRizikPrometId" />
                          </action>
                          <action type="control populate keepfocus" value="#grdPosloviRizik" />
                        </event>
                      </menuitem>
                      <menuitem caption="Priloži dokument" name="menPriloziPosloviRizik" sort="2" function="PriloziPosloviRizik">
                        <event type="click">
                          <action type="method run" value="funDmsAdd">
                            <parameter name="server" value="@@server" />
                            <parameter name="database" value="@@database" />
                            <parameter name="username" value="" />
                            <parameter name="password" value="" />
                            <parameter name="operaterid" value="@@operateriid"/>
                            <parameter name="entityName" value="ZNRDjelatniciPosloviRizikPromet" />
                            <parameter name="entityId" value="#grdPosloviRizik.@ZNRDjelatniciPosloviRizikPrometId" />
                          </action>
                        </event>
                      </menuitem>
                    </menu>
                    <event type="focusedrowchanged">
                      <action type="menu disable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" if="#grdPosloviRizik.@indObvezno==false"/>
                      <action type="menu enable" value="#menIzmjenaPosloviRizik,#menPriloziPosloviRizik" else="" />
                    </event>
                  </grid>
                </item>
                <item col="1" row="2" highlight="false" colspan="2">
                  <button name="btnDodajPosloviRizik"  caption="Dodaj" >
                    <event type="click">
                      <action type="form open" value="frmDodajPosloviRizik">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="HRRadnaMjestaId" value="parent.#grdDjelatnici.@HRRadnaMjestaId" />
                        <parameter name="caption" value="Osposobljavanja za rad na siguran način - izmjena poslova prema procjeni rizika"/>
                        <parameter name="tip" value="poslovi rizik"/>
                      </action>
                      <action type="control populate" value="#grdPosloviRizik" />
                    </event>
                  </button>
                </item>
                <item col="5" row="2" highlight="false" colspan="2">
                  <button name="btnPregledPosloviRizikDok"  caption="Pregled dokumenata" >
                    <event type="click">
                      <action type="form open" value="frmDokumentiPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Osposobljavanja za rad na siguran način - dokumenti"/>
                        <parameter name="tip" value="poslovi rizik"/>
                        <parameter name="EntityName" value="ZNRDjelatniciPosloviRizikPromet"/>
                      </action>
                    </event>
                  </button>
                </item>
                <item col="7" row="2" highlight="false" colspan="2">
                  <button name="btnPregledPoslRizik"  caption="Analitika" >
                    <event type="click">
                      <action type="form open" value="frmAnalitikaPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Osposobljavanja za rad na siguran način - analitika"/>
                        <parameter name="tip" value="poslovi rizik"/>
                        <parameter name="Naziv" value="Osposobljavanja za rad na siguran način"/>
                      </action>
                      <action type="control populate" value="#grdPosloviRizik" />
                    </event>
                  </button>
                </item>
              </group>
              <group col="2" row="2" cols="8" rows="2" caption="Stručna osposobljavanja" fontbold="true" groupbordervisible="true" spacing="1,2,1,2">
                <rowsdefinition>
                  <row position="1" size="85%" />
                  <row position="2" size="15%" />
                </rowsdefinition>
                <item col="1" row="1" highlight="false" colspan="8">
                  <grid name="grdStrucnaOsposobljavanja" key="ZNRDjelatniciStrucnaOsposobljavanjaPrometId" dataname="dtStrucnaOsposobljavanja" showautofilterrow="false" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false">
                    <event type="cellvaluechanged">
                      <action type="datarun nonquery" value="~dtUpdateIndStrucnaOsposobljavanja" />
