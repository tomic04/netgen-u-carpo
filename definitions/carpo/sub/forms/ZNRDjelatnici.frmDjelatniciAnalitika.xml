                  <button name="btnPregledStrucnaOsposobljavanja"  caption="Analitika" >
                    <event type="click">
                      <action type="form open" value="frmAnalitikaPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Stručna osposobljavanja - analitika"/>
                        <parameter name="tip" value="strucna osposobljavanja"/>
