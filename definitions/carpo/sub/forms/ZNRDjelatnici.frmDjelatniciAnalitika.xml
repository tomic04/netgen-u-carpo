                      <action type="menu enable" value="#menPriloziStrucnaOsposobljavanja,#menIzmjenaStrucnaOsposobljavanja" else="" />
                    </event>
                  </grid>
                </item>
                <item col="1" row="2" highlight="false" colspan="2">
                  <button name="btnDodajStrucnaOsposobljavanja"  caption="Dodaj" >
                    <event type="click">
                      <action type="form open" value="frmDodajStrucnaOsposobljavanja">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="HRRadnaMjestaId" value="parent.#grdDjelatnici.@HRRadnaMjestaId" />
                        <parameter name="caption" value="Stručna osposobljavanja - izmjena"/>
                        <parameter name="tip" value="strucna osposobljavanja"/>
                      </action>
                      <action type="control populate" value="#grdStrucnaOsposobljavanja" />
                    </event>
                  </button>
                </item>
                <item col="5" row="2" highlight="false" colspan="2">
                  <button name="btnPregledStrucnaOsposobljavanjakDok"  caption="Pregled dokumenata" >
                    <event type="click">
                      <action type="form open" value="frmDokumentiPregled">
                        <parameter name="HRKadroviId" value="$HRKadroviId"/>
                        <parameter name="caption" value="Stručna osposobljavanja - dokumenti"/>
                        <parameter name="tip" value="strucna osposobljavanja"/>
                        <parameter name="EntityName" value="ZNRDjelatniciStrucnaOsposobljavanjaPromet"/>
