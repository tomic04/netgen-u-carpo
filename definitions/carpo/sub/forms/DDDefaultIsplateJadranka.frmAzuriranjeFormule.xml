<root>
	<form name="frmAzuriranjeFormule" caption="Vrsta isplate {~dtGet.@Naziv} " saveformlayout="true">
		<event type='init'>
			<action type="datarun reader" value="~dtGet" if="$oopisstavkeid!=null"/>
		</event>
		<event type="onload">
			<action type="control disable" value="#txtNaziv"/>
			<action type="control populate" value="#grdFormuleTaba"/>
			<action type="control disable" value="#btnUnesiIza,#btnObrisi,#btnIzmjeni,#btnUnesiIspred,#btnUp,#btnDown" if="#grdFormuleTaba==null"/>
			<action type="control enable" value="#btnUnesiIza,#btnObrisi,#btnIzmjeni,#btnUnesiIspred,#btnUp,#btnDown" else=""/>
			<action type="control disable" value="#btnUnesi" if="#grdFormuleTaba!=null"/>
			<action type="control enable" value="#btnUnesi" else=""/>
		</event>
		<layout>
			<group cols="1" rows="2" bordervisible="false" >
				<group rows="1" cols="1" spacing="2,2,2,2" highlight="false">
					<item row="1" col="1" caption="Vrsta isplate:">
						<textedit name="txtNaziv"  datavalue="~dtGet.@Naziv"/>
					</item>
				</group>
				<item row="2" col="1" >
					<grid name="grdFormuleTaba" key="OOPIsStavkeDefId" dataname="~dtFormule" >
					</grid>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" type="add" >
					<event type="click">	
						<action type="form open" value="frmUnosFormula" >
							<parameter name="OOPIsStavkeId" value="$oopisstavkeid" type="int" /> 
							<parameter  name="Tip" value="unos"/>
						</action>
						<action type="control enable" value="#btnUnesiIza,#btnObrisi,#btnIzmjeni,#btnUnesiIspred,#btnUp,#btnDown" />
						<action type="control disable" value="#btnUnesi" />
					</event>
				</button>
				<button name="btnUnesiIza" caption="Unesi iza" type="add" begingroup="true">
					<event type="click">	
						<action type="form open" value="frmUnosFormula" >
							<parameter name="OOPIsStavkeId" value="$oopisstavkeid" type="int" /> 
							<parameter  name="Tip" value="unos2"/>
						</action>
					</event>
				</button>
				<button name="btnUnesiIspred" caption="Unesi ispred" type="add">
					<event type="click">	
						<action type="form open" value="frmUnosFormula" >
							<parameter name="OOPIsStavkeId" value="$oopisstavkeid" type="int" /> 
							<parameter  name="Tip" value="unos1"/>
						</action>
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni" type="add">
					<event type="click">	
						<action type="form open" value="frmUnosFormula" >
							<parameter name="OOPIsStavkeDefId" value="#grdFormuleTaba.@oopisstavkedefid" type="int" /> 
							<parameter  name="Tip" value="izmjena"/>
						</action>
						<action type="control populate" value="#grdFormuleTaba" />
						<action type="control focus" value="#grdFormuleTaba"/>
					</event>
				</button>
				<button name="btnObrisi" caption="Obrisi" type="delete" begingroup="true">
					<event type="click">	
						<action type="confirm" value="Da li ste sigurni da želite obrisati {#grdFormuleTaba.@Naziv}?">
							<action type="datarun nonquery" value="~dtBrisiDef">
							</action>
						</action>
						<action type="control populate" value="#grdFormuleTaba"/>
						<action type="control disable" value="#btnUnesiIza,#btnObrisi,#btnIzmjeni,#btnUnesiIspred,#btnUp,#btnDown" if="#grdFormuleTaba==null"/>
						<action type="control enable" value="#btnUnesi" if="#grdFormuleTaba==null"/>
					</event>
				</button>
				<button name="btnUp" image="top" begingroup="true">
					<event type="click">
						<action type="datarun reader" value="~dtPomakGore">
							<parameter name="oopisstavkedefid" type="int" /> 
							<parameter  name="rbr" type="int"/>
						</action>
						<action type="control populate" value="#grdFormuleTaba" />
					</event>
				</button>
				<button name="btnDown" caption="" type="" image="bottom">
					<event type="click">
						<action type="datarun reader" value="~dtPomakDolje">
							<parameter name="oopisstavkedefid" type="int" /> 
							<parameter  name="rbr" type="int"/>
						</action>
						<action type="control populate" value="#grdFormuleTaba" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" begingroup="true">
					<action type="form close"/>	
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGet">
				<parameter name="@action" value="dtGrid" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtFormule">
				<parameter name="@action" value="tabFormule"/>
				<parameter name="@OOPIsStavkeId" value="$oopisstavkeid"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtBrisiDef">
				<parameter name="@action" value="obrisi_Def" />
				<parameter name="@OOPIsStavkeDefId" value="#grdFormuleTaba.@OOPIsStavkeDefId" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid" />
				<parameter name="@rbr" value="#grdFormuleTaba.@rbr" />
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtPomakGore">
				<parameter name="@action" value="pomak_gore" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
				<parameter name="@rbr" value="#grdFormuleTaba.@rbr"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtPomakDolje">
				<parameter name="@action" value="pomak_dolje" />
				<parameter name="@oopisstavkeid" value="$oopisstavkeid"/>
				<parameter name="@rbr" value="#grdFormuleTaba.@rbr"/>
			</data>
		</datalist>
	</form>


	<!--forma za unos-->

	<form name="frmUnosFormula" caption="Stavka" saveformlayout="true">
		<event type='init'>
			<action type="datarun reader" value="~dtFormule1" if="$oopisstavkedefid!=null"/>
		</event>
		<event type="onload">
			<action type="control disable" value="#txtRbr"/>
			<action type="datarun reader" value="~dtGetRbr"/>
			<action type="datarun reader" value="~dtGetRbrIza"/>
		</event>
		<event type="shown">
		<action if="$Tip=='unos'">
				<action type="control value" value="#txtRbr">
					<parameter if="~dtGetRbr.@rbr==null" value="1" />
					<parameter else="" value="~dtGetRbr.@rbr" />
				</action>
			</action>
			<action elseif="$Tip=='unos1'">
				<action type="control value" value="#txtRbr">
					<parameter value="~dtGetRbrIza.@rbr" if="$Tip=='unos1'"/>
				</action>
			</action>
			<action elseif="$Tip=='unos2'">
				<action type="control value" value="#txtRbr">
					<parameter value="~dtGetRbr.@rbr" if="$Tip=='unos2'"/>
				</action>
			</action>
			<action if="$Tip=='izmjena'">
				<action type="control value" value="#txtRbr" >
					<parameter value="~dtFormule1.@rbr"  />
				</action>
				<action type="control value" value="#txtNaziv" >
					<parameter value="~dtFormule1.@Naziv"  />
				</action>
				<action type="control value" value="#txtPostotak" >
					<parameter value="~dtFormule1.@Postotak"  />
				</action>
				<action type="control value" value="#txtFormula" >
					<parameter value="~dtFormule1.@Formula"  />
				</action>
			</action>
		</event>
		<layout>
			<group cols="1" rows="1" bordervisible="false" >
				<group rows="5" cols="1" spacing="2,2,2,2" highlight="false">
					<item row="1" col="1" caption="Rbr:" textposition="left">
						<textedit name="txtRbr" highlight="false" />
					</item>
					<item row="2" col="1" caption="Tip stavke:" textposition="left">
						<comboedit name="cmbTipStavke" valuefield="OOPIsStavkeTipId" displayfield="Naziv" dataname="~dtCombo" allownull="false" datavalue="~dtFormule1.@OOPIsStavkeTipId" >
						</comboedit>
					</item>
					<item row="3" col="1" caption="Naziv:" textposition="left">
						<textedit name="txtNaziv" required="true" highlight="false" />
					</item>
					<item row="4" col="1" caption="Postotak:" textposition="left">
						<textedit name="txtPostotak" highlight="false" format="n2" nulltext="0,00"/>
					</item>
					<item row="5" col="1" caption="Formula:" textposition="left">
						<textedit name="txtFormula" highlight="false" >
						</textedit>
					</item>
				</group>
			</group>		
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">	
						<action type="validate" />	
						<action type="datarun reader" value="~dtAddFormule1" if="$Tip==unos">
							<parameter value="OOPIsStavkeDefid" type="int"/>
							<action type="control populate" value="parent.#grdFormuleTaba" >	
								<action type="control focus" value="parent.#grdFormuleTaba">
									<parameter value="~dtAddFormule1.@noviUnos" type="int"/>
								</action>							
							</action>							
							<action type="form close"/>							 
						</action>
						<action type="datarun reader" value="~dtAddFormule" elseif="$Tip==unos2">
							<parameter value="OOPIsStavkeDefid" type="int"/>
							<action type="control populate" value="parent.#grdFormuleTaba" >
								<action type="control focus" value="parent.#grdFormuleTaba">
									<parameter value="~dtAddFormule.@noviRbr" type="int"/>
								</action>							
							</action>							
							<action type="form close"/>							 
						</action>
						<action type="datarun reader" value="~dtAddFormule" elseif="$Tip==unos1">
							<parameter value="OOPIsStavkeDefid" type="int"/>
							<action type="control populate" value="parent.#grdFormuleTaba" >
								<action type="control focus" value="parent.#grdFormuleTaba">
									<parameter value="~dtAddFormule.@noviRbr" type="int"/>
								</action>							
							</action>
							<action type="form close"/>							 
						</action>
						<action type="datarun reader" value="~dtEditDef" else="">
							<action type="message" value="~dtEditDef.@poruka" />
							<action type="form close"/>	
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtCombo">
				<parameter name="@action" value="dtComboTip"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtFormule1">
				<parameter name="@action" value="dtGetDef"/>
				<parameter name="@OOPIsStavkeDefId" value="$OOPIsStavkeDefId"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtAddFormule1">
				<parameter name="@action" value="unos_Def" />
				<parameter name="@rbr" value="#txtRbr"/>
				<parameter name="@OOPIsStavkeId" value="$OOPIsStavkeId"/>
				<parameter name="@OOPIsStavkeTipId" value="#cmbTipStavke"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@formula" value="#txtFormula"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtAddFormule">
				<parameter name="@action" value="unos_ispred" />
				<parameter name="@OOPIsStavkeDefId" value="$oopisstavkedefid"/>
				<parameter name="@rbr" value="#txtRbr"/>
				<parameter name="@OOPIsStavkeId" value="$oopisstavkeid"/>
				<parameter name="@OOPIsStavkeTipId" value="#cmbTipStavke"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@formula" value="#txtFormula"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtEditDef">
				<parameter name="@action" value="izmjena_Def" />
				<parameter name="@OOPIsStavkeDefid" value="$OOPIsStavkeDefid"/>
				<parameter name="@rbr" value="#txtRbr"/>
				<parameter name="@OOPIsStavkeId" value="$OOPIsStavkeId"/>
				<parameter name="@OOPIsStavkeTipId" value="#cmbTipStavke"/>
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@Postotak" value="#txtPostotak"/>
				<parameter name="@formula" value="#txtFormula"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGetRbr">
				<parameter name="@action" value="dtGetIspred"/>
				<parameter name="@OOPIsStavkeDefId" value="parent.#grdFormuleTaba"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtGetRbrIza">
				<parameter name="@action" value="dtGetIza"/>
				<parameter name="@OOPIsStavkeDefId" value="parent.#grdFormuleTaba"/>
			</data>
		</datalist>
	</form>
</root>