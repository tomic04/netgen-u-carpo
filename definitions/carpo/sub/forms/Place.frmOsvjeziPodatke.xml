<root>


  <form name="frmOsvjeziPodatke" caption ="$caption"  width="525" height="125"  fixedsize="true" saveformsize="false" showversion="true" version="1">

    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="false" >
        <item col="1" row="1"  highlight="False">
          <labeledit value="Jeste li sigurni da želite osvježiti podatke iz kadrovske evidencije?" fontsizedelta="2"/>
        </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnOsvjezi" caption="OSVJEŽI" >
          <event type="click">
            
            <action type="datarun nonquery" value="~dtOsvjeziPodatke" waittype="progress" waitcaption="Pričekajte..." waittext="..osvježavanje podataka u tijeku..."></action>
            <action type="message" value="Osvježavanje podataka je završeno!"></action>
            <action type="form close" />
            <action type="control populate" value="parent.#grdPlace" />
            

          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>

      <data command="spPlaceOsvjeziPodatke" name="dtOsvjeziPodatke">
        <parameter name="@operateriid" value="@@operateriid"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>