<root>
  <form name="frmDonosPomEvid" caption ="$caption" width="550" height="100" fixedsize="true" saveformsize="false" showversion="true" version="1">
    <event type="init">
      <action type="datarun reader" value="~dtKlaseUnosa"></action>
    </event>
   
    
    <layout>

      <!--omotač-->
      <group cols="1" rows="1" groupbordervisible="false" >
        <item caption="Naziv klase:" col="1"  row="1" textposition="left">
            <comboedit name="cmbKlasa"  valuefield="OOPKlaseUnosaId" displayfield="Naziv" dataname="~dtKlaseUnosa" required="true"/>
          </item>
      </group>
      <!--kraj omotača-->

    </layout>

    <panelbuttons>
      <buttons>
        <button name="btnIzvrsi" caption="IZVRŠI" >
          <event type="click">
            <action type="datarun reader" value="~dtPrenesi">
            </action>
            <action type="message" value ="Napravljen je donos iz pomoćne evidencije"/>
            <action type="form close"></action>
          </event>
        </button>
        <button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close" />
          </event>
        </button>
      </buttons>
    </panelbuttons>

    <datalist>
      <data command="spOOPKlaseUnosaQuery" name="dtKlaseUnosa">
        <parameter name="@action" value="0" type="int"/>
      </data>
      <data command="spOOPObradeDjelatniciAzur" name="dtPrenesi">
        <parameter name="@action" value="0" type="int"/>
        <parameter name="@oopobradeid" value="$oopobradeid"/>
        <parameter name="@oopklaseunosaid" value="#cmbKlasa"/>
      </data>
    </datalist>
  </form>


  <!--kraj FORMA ZA UNOS/IZMJENA OBRADE-->
</root>