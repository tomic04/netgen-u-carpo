<root>
	<!--
  *******************************************************************************************
  FORMA ZA PREGLED CIKLUSA NALOGA
  *******************************************************************************************
  -->
	<form name="frmCiklusNaloga" caption="$caption" width="500" height="500">
		<event type="shown">
			<action type="control populate" value="#grdCiklus"/>
		</event>
		<layout>
			<group cols="1" rows="5" groupbordervisible="false">
				<item col="1" row="1" rowspan="5">
					<grid name="grdCiklus" key="PNNaloziId" caption="Ciklus naloga" dataname="~dtGrid" fieldsmartspaces="false" bestfitonrefresh="true" showgrouppanel="false" netgenfields="true" multiselect="true" />
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnOdustani" caption="ODUSTANI" dock="right">
					<event type="click">
						<action type="form close"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spPNHelp" name="dtGrid">
				<parameter name="@action" value="ciklus"/>
				<parameter name="@pnnaloziid" value="$PNNaloziId"/>
				<parameter name="@indGreske.output.int"/>
				<parameter name="@poruka.output.string"/>
			</data>
		</datalist>
	</form>
</root>