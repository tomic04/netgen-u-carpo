    <parts>   
        <part name="prijemnilistkalkulacijaatributi">
            <item caption="Dobavljač:" row="1" col="1" fontbold="true">
                <searchedit name="srcPartner" dataname="~dtGetPartneri" fieldtext="Partner" fieldvalue="PartneriId" required="true" fontbold="true" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@Dobavljac">
                    <event type="valuechanged" raisonload="false">
                        <action type="control enable" value="#cmbLokacija" if="#srcPartner!=null&amp;&amp;$Status==Nezaključen"/>               
						<action type="datarun reader" value="~dtDohvatiDefaultniParstruId" if="#srcPartner!=null"/>
						<action type="control populate" value="#cmbLokacija" />
						<action type="control value" value="#cmbLokacija">
							<parameter value="~dtDohvatiDefaultniParstruId.@ParstruId"/>
						</action> 
                        <action type="control popup" value="#cmbLokacija"/>
                    </event>
                </searchedit>
            </item>
            <item caption="Lokacija:" row="2" col="1">
                <comboedit name="cmbLokacija" valuefield="ParStruId" displayfield="Naziv" datavalue="#dtGet.@ParStruId" dataname="Global.dtLokacija" autopopulate="false">
                </comboedit>
            </item>
            <item caption="Način isporuke:" row="3" col="1">
                <comboedit name="nacinotpreme" valuefield="ProNacinIsporukeID" displayfield="Naziv" datavalue="#dtGet.@ProNacinIsporukeID" dataname="Global.dtNacinIsporuke" savevalue="app"/>
            </item>
            <item caption="Skladište:" row="4" col="1">
                <comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Naziv" datavalue="#dtGet.@SkladisteId" dataname="Global.dtSkladiste" required="true"/>
            </item>			
            <item caption="Broj:" row="5" col="1" fontbold="true" >
                <textedit name="txtBroj" datavalue="#dtGet.@Broj"  fontbold="true" readonly="true"/>
            </item>
			<item caption="Broj računa:" row="6" col="1" fontbold="true" >
                <textedit name="txtBrojRacuna" datavalue="#dtGet.@BrojRacuna" fontbold="true" readonly="true"/>
            </item>
            <item caption="Datum dokumenta:" row="7" col="1">
                <dateedit name="datDatumdok" value="now" datavalue="#dtGet.@DatumDok" />
            </item>
			<item caption="Datum valute:" row="8" col="1">
                <dateedit name="datDatumval" value="now" datavalue="#dtGet.@DatumValute" />
            </item>
            <item caption="Org. shema:" row="9" col="1">
                <combotreeedit name="cteOrgShema" valuefield="ID" displayfield="Naziv"  datavalue="#dtGet.@OrgShemaId" dataname="Global.dtOrgShema" required="true" savevalue="app"/>
            </item>
            <item caption="Odgovorna osoba:" row="10" col="1">
                <comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" datavalue="#dtGet.@OsobeId" dataname="Global.dtOdgovornaOsoba" required="true" savevalue="app"/>
            </item>
			<item caption="Otpremnica:" row="11" col="1">
                <textedit name="otpremnica" datavalue="#dtGet.@Otpremnica" fontbold="true" />
            </item>
			<!-- 
			##prebaceno u tab 'Dodatno'
			<item caption="Valuta:" row="12" col="1">
                    <comboedit name="valuta" valuefield="ValuteId" displayfield="Naziv" datavalue="#dtGet.@ValuteId" dataname="Global.dtValuta" />
            </item>
			<item caption="Tecaj:" row="13" col="1">
                <textedit name="tecaj" datavalue="#dtGet.@Tecaj" />
            </item> -->
            <item caption="Opis:" row="12" col="1">
                <textedit name="opis" entermovenextcontrol="true" datavalue="#dtGet.@Opis" />
            </item>
        </part>
    </parts>