	<part name="prtKalkResult">
		<action type="datarun reader" value="~dtCalc"/>
		<action type="control value" value="#txtFVrijednost" if="#txtFVrijednost!=~dtCalc.@FakVrijednost">
			<parameter  value="~dtCalc.@FakVrijednost" />		
		</action>
		<action type="control value" value="#txtFCijena" if="#txtFCijena!=~dtCalc.@FakCijena">
			<parameter value="~dtCalc.@FakCijena" />
		</action>
		<action type="control value" value="#txtDevVrijednost" if="#txtDevVrijednost!=~dtCalc.@DevVrijednost">
			<parameter value="~dtCalc.@DevVrijednost" />
		</action>
		<action type="control value" value="#txtDevCijena" if="#txtDevCijena!=~dtCalc.@DevCijena">
			<parameter value="~dtCalc.@DevCijena" />
		</action>		
		<action type="control value" value="#txtNabCijena" if="#txtNabCijena!=~dtCalc.@NabCijena">
			<parameter value="~dtCalc.@NabCijena" />
		</action>		
		<action type="control value" value="#txtNabVrij" if="#txtNabVrij!=~dtCalc.@NabVrij">
			<parameter value="~dtCalc.@NabVrij" />
		</action>
		<action type="control value" value="#txtRabat1I" if="#txtRabat1I!=~dtCalc.@Rabat1I">
			<parameter value="~dtCalc.@Rabat1I" />
		</action>
		<action type="control value" value="#txtRabat2I" if="#txtRabat2I!=~dtCalc.@Rabat2I">
			<parameter value="~dtCalc.@Rabat2I" />
		</action>
		<action type="control value" value="#txtRabat3I" if="#txtRabat3I!=~dtCalc.@Rabat3I">
			<parameter value="~dtCalc.@Rabat3I" />
		</action>
		<action type="control value" value="#txtRabat1P" if="#txtRabat1P!=~dtCalc.@Rabat1P">
			<parameter value="~dtCalc.@Rabat1P" />
		</action>
		<action type="control value" value="#txtRabat2P" if="#txtRabat2P!=~dtCalc.@Rabat2P">
			<parameter value="~dtCalc.@Rabat2P" />
		</action>
		<action type="control value" value="#txtRabat3P" if="#txtRabat3P!=~dtCalc.@Rabat3P">
			<parameter value="~dtCalc.@Rabat3P" />
		</action>
		<action type="control value" value="#txtCarinaI" if="#txtCarinaI!=~dtCalc.@CarinaI">
			<parameter value="~dtCalc.@CarinaI" />
		</action>
		<action type="control value" value="#txtCarinaP" if="#txtCarinaP!=~dtCalc.@CarinaP">
			<parameter value="~dtCalc.@CarinaP" />
		</action>
		<action type="control value" value="#txtTrosakI" if="#txtTrosakI!=~dtCalc.@TrosakI">
			<parameter value="~dtCalc.@TrosakI" />
		</action>
		<action type="control value" value="#txtTrosakP" if="#txtTrosakP!=~dtCalc.@TrosakP">
			<parameter value="~dtCalc.@TrosakP" />
		</action>
		<action type="control value" value="#txtTrosakC" if="#txtTrosakC!=~dtCalc.@TrosakC">
			<parameter value="~dtCalc.@TrosakC" />
		</action>		
		<action type="control value" value="#txtTrosarinaC" if="#txtTrosarinaC!=~dtCalc.@TrosarinaC">
			<parameter value="~dtCalc.@TrosarinaC" />
		</action>			
		<action type="control value" value="#txtTrosarina" if="#txtTrosarina!=~dtCalc.@Trosarina">
			<parameter value="~dtCalc.@Trosarina" />
		</action>
		<action type="control value" value="#txtNCijena" if="#txtNCijena!=~dtCalc.@NCijena">
			<parameter value="~dtCalc.@NCijena" />
		</action>
		<action type="control value" value="#txtNVrijednost" if="#txtNVrijednost!=~dtCalc.@NVrijednost">
			<parameter value="~dtCalc.@NVrijednost" />
		</action>
		<action type="control value" value="#txtPoticaj" if="#txtPoticaj!=~dtCalc.@Poticaj">
			<parameter value="~dtCalc.@Poticaj" />
		</action>
		<action type="control value" value="#txtPoticajC" if="#txtPoticajC!=~dtCalc.@PoticajC">
			<parameter value="~dtCalc.@PoticajC" />
		</action>		
		<action type="control value" value="#txtPovrat" if="#txtPovrat!=~dtCalc.@Povrat">
			<parameter value="~dtCalc.@Povrat" />
		</action>
		<action type="control value" value="#txtFVKn" if="#txtFVKn!=~dtCalc.@FVKn">
			<parameter value="~dtCalc.@FVKn" />
		</action>
		<action type="control value" value="#txtFVe" if="#txtFVe!=~dtCalc.@FVDev">
			<parameter value="~dtCalc.@FVDev" />
		</action>
		<action type="control value" value="#txtMarza" if="#txtMarza!=~dtCalc.@Marza">
			<parameter value="~dtCalc.@Marza" />
		</action>
		<action type="control value" value="#txtMarzaP" if="#txtMarzaP!=~dtCalc.@MarzaP">
			<parameter value="~dtCalc.@MarzaP" />
		</action>
		<action type="control value" value="#txtVpc" if="#txtVpc!=~dtCalc.@VPC">
			<parameter value="~dtCalc.@VPC" />
		</action>
		<action type="control value" value="#txtMpc" if="#txtMpc!=~dtCalc.@MPC">
			<parameter value="~dtCalc.@MPC" />
		</action>
		<action type="control value" value="#txtRabat1IDev" if="#txtRabat1IDev!=~dtCalc.@Rabat1IDev">
			<parameter value="~dtCalc.@Rabat1IDev" />
		</action>
		<action type="control value" value="#txtRabat2IDev" if="#txtRabat2IDev!=~dtCalc.@Rabat2IDev">
			<parameter value="~dtCalc.@Rabat2IDev"/>
		</action>
		<action type="control value" value="#txtRabat3IDev" if="#txtRabat3IDev!=~dtCalc.@Rabat3IDev">
			<parameter value="~dtCalc.@Rabat3IDev"/>
		</action>				
		<!-- varijable koje sluze umjesto lblKontrola za prosljeđivanje vrijednosti -->	
		<action type = "variable value" value="$txtMarza">
			<parameter value="~dtCalc.@Marza"/>
		</action>
		<action type = "variable value" value="$txtMarzaP">
			<parameter value="~dtCalc.@MarzaP"/>
		</action>
		<action type = "variable value" value="$txtNabCijena">
			<parameter value="~dtCalc.@NabCijena"/>
		</action>
		<action type = "variable value" value="$txtNabVrij">
			<parameter value="~dtCalc.@NabVrij"/>
		</action>
		<action type = "variable value" value="$txtNVrijednost">
			<parameter value="~dtCalc.@NVrijednost"/>
		</action>
		<action type = "variable value" value="$txtNCijena">
			<parameter value="~dtCalc.@NCijena"/>
		</action>	
		<!-- iznalzni parametri kalkulacije tag values zbog provjere da li je vrijednost mijenjana -->
		<action type = "variable value" value="devVrijednostTag">
			<parameter value="~dtCalc.@DevVrijednost"/>
		</action>
		<action type = "variable value" value="fakVrijednostTag">
			<parameter value="~dtCalc.@FakVrijednost"/>
		</action>
		<action type = "variable value" value="rabat1ITag">
			<parameter value="~dtCalc.@Rabat1I"/>
		</action>
		<action type = "variable value" value="rabat2ITag">
			<parameter value="~dtCalc.@Rabat2I"/>
		</action>
		<action type = "variable value" value="rabat3ITag">
			<parameter value="~dtCalc.@Rabat3I"/>
		</action>			
		<!-- enable/disable button cjenik ovisno o nabavnoj cijeni -->		
		<action type="control disable" value="#btnCjenik" if="~dtCalc.@NCijena==0"/>
		<action type="control enable" value="#btnCjenik" else=""/>			
	</part>	
</parts>