		<action type="control value" value="#txtRabat2I" if="#txtRabat2I!=~dtCalc.@Rabat2I">
			<parameter value="~dtCalc.@Rabat2I"/>
		</action>
		<action type="control value" value="#txtRabat3I" if="#txtRabat3I!=~dtCalc.@Rabat3I">
			<parameter value="~dtCalc.@Rabat3I"/>
		</action>
		<action type="control value" value="#txtRabat1P" if="#txtRabat1P!=~dtCalc.@Rabat1P">
			<parameter value="~dtCalc.@Rabat1P"/>
		</action>
		<action type="control value" value="#txtRabat2P" if="#txtRabat2P!=~dtCalc.@Rabat2P">
