<parts>
	<part name="prtRobnoKalkSum">				
		<action type="datarun reader" value="~dtIzracunSumeFakturna"/>
		<action type="control value" value="#txtFakVrijRabat">
			<parameter value="~dtIzracunSumeFakturna.@fakvrijrabat"/>
		</action>
		<action type="control value" value="#txtFakVrij">
			<parameter value="~dtIzracunSumeFakturna.@fakvrij"/>
		</action>
		<action type="control value" value="#txtRabat">
			<parameter value="~dtIzracunSumeFakturna.@rabat"/>
		</action>
		<action  if="$tecaj&gt;1">
			<action type="control value" value="#txtRabatDev">
				<parameter value="~dtIzracunSumeFakturna.@devrabat"/>
			</action>
			<action type="control value" value="#txtDevVrijRabat">
				<parameter value="~dtIzracunSumeFakturna.@devvrijrabat"/>
			</action>
			<action type="control value" value="#txtDevVrij">
				<parameter value="~dtIzracunSumeFakturna.@devvrij"/>
			</action>
		</action>
		<action else=""> 
			<action type="control value" value="#txtRabatDev">
				<parameter value="0"/>
			</action>
			<action type="control value" value="#txtDevVrijRabat">
				<parameter value="0"/>
			</action>
			<action type="control value" value="#txtDevVrij">
				<parameter value="0"/>
			</action>
		</action>			
		<action type="datarun reader" value="~dtIzracunSumeTroskovi">
			<action type="control value" value="#txtTrosakUkupno">
				<parameter value="~dtIzracunSumeTroskovi.@sumatroskova"/>
			</action>
			<action type="control value" value="#txtTrosak">
				<parameter value="~dtIzracunSumeTroskovi.@trosak"/>
			</action>				
			<action type="control value" value="#txtTrosarina">
				<parameter value="~dtIzracunSumeTroskovi.@trosarina"/>
			</action>
			<action type="control value" value="#txtCarina">
				<parameter value="~dtIzracunSumeTroskovi.@carina"/>
			</action>		
		</action>			
		<action type="datarun reader" value="~dtIzracunSumeNabavna"/> 
			<action type="control value" value="#txtNabVrij">
				<parameter value="~dtIzracunSumeNabavna.@nabvrij"/>
			</action>
			<action type="control value" value="#txtNabVrijPovrat">
				<parameter value="~dtIzracunSumeNabavna.@nabvrijpovrat"/>
			</action>
			<action type="control value" value="#txtPovrat">
				<parameter value="~dtIzracunSumeNabavna.@povrat"/>
			</action>
		<action if="$tecaj&gt;1">
			<action type="control value" value="#txtNabVrijDev">
				<parameter value="~dtIzracunSumeNabavna.@nabvrijdev"/>
			</action>
			<action type="control value" value="#txtDevPovrat">
				<parameter value="~dtIzracunSumeNabavna.@povratdev"/>
			</action>
			<action type="control value" value="#txtNabVrijDevUkupno">
				<parameter value="~dtIzracunSumeNabavna.@nabvrijdevukupno"/>
			</action>		
		</action>		
		<action else="">
			<action type="control value" value="#txtNabVrijDev">
				<parameter value="0"/>
			</action>
			<action type="control value" value="#txtDevPovrat">
				<parameter value="0"/>
			</action>
			<action type="control value" value="#txtNabVrijDevUkupno">
				<parameter value="0"/>
			</action>
		</action>
	</part>	
	<part name="prtRobnoKalkResult">
		<action type="datarun reader" value="~dtCalc"/>
		<action type="control value" value="#txtFVrijednost" if="#txtFVrijednost!=~dtCalc.@FakVrijednost">
			<parameter  value="~dtCalc.@FakVrijednost"/>		
		</action>
		<action type="control value" value="#txtFCijena" if="#txtFCijena!=~dtCalc.@FakCijena">
			<parameter value="~dtCalc.@FakCijena"/>
		</action>
		<action type="control value" value="#txtDevVrijednost" if="#txtDevVrijednost!=~dtCalc.@DevVrijednost">
			<parameter value="~dtCalc.@DevVrijednost"/>
		</action>
		<action type="control value" value="#txtDevCijena" if="#txtDevCijena!=~dtCalc.@DevCijena">
			<parameter value="~dtCalc.@DevCijena"/>
		</action>		
		<action type="control value" value="#txtNabCijena" if="#txtNabCijena!=~dtCalc.@NabCijena&amp;&amp;~dtCalc.@NabCijena!=null">
			<parameter value="~dtCalc.@NabCijena"/>
		</action>		
		<action type="control value" value="#txtNabVrij" if="#txtNabVrij!=~dtCalc.@NabVrij&amp;&amp;~dtCalc.@NabVrij!=null">
			<parameter value="~dtCalc.@NabVrij"/>
