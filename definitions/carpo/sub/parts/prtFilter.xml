<!-- iz frmFilter tu ulazi VarFilter koja kaze o kojem dokumentu je rijec 
23.02.2023. MB - još malo popravila
07.10.2022. MB - popravila filter
28.04.2021. DA - popravio punjenje MG na tipku Filter
-->
<parts>
	<part name="filter">
		<!-- TODO napraviti da je datum ili zadnjih dana obavezan -->
		<layout textposition="left">
			<group cols="1" rows="2" groupbordervisible="false">
				<group col="1" row="1" cols="1" rows="$VarRows" groupbordervisible="true">
					<group col="1" row="1" cols="2" rows="1" groupbordervisible="false">
						<item caption="Datum od:" col="1" row="$VarDatumRow" highlight="false" >
							<dateedit name="datDatumOd" value="now" savevalue="app">
							</dateedit>
						</item>
						<item caption="Datum do:" col="2" row="$VarDatumRow" highlight="false" >
							<dateedit name="datDatumDo" value="now" savevalue="app">
							</dateedit>
						</item>
					</group>
					<!-- <item caption="Razdoblje:" col="1" row="$VarRazdobljeRow" highlight="false" > -->
					<!-- <comboedit name="cmbRazdoblje" valuefield="Id" displayfield="Naziv" datavalue="#dtFilterGet.@RazobljeId" dataname="dtFilterRazdoblje" > -->
					<!-- </comboedit> -->
					<!-- </item> -->
					<group col="1" row="$VarZadnjihDanaRow" cols="3" rows="1" groupbordervisible="false" name="grpZadnjih">
						<item row="1" col="1" highlight="False">
							<checkedit name="chkZadnjih" caption="Zadnjih" value="0" savevalue="app">
								<event type="valuechanged">
									<action if="#chkZadnjih==true">
										<action type="control disable" value="#datDatumOd, #datDatumDo" />
										<action type="control enable" value="#txtZadnjih" />
										<action type="variable value">
											<parameter name="chkZadnjihVar" value="1" />
										</action>
									</action>
									<action else="">
										<action type="control enable" value="#datDatumOd, #datDatumDo" />
										<action type="control disable" value="#txtZadnjih" />
										<action type="variable value">
											<parameter name="chkZadnjihVar" value="0" />
										</action>
									</action>
								</event>
							</checkedit>
						</item>
						<item caption="" col="2" row="3" width="100" spacing="28,0,0,0" highlight="false">
							<textedit name="txtZadnjih" entermovenextcontrol="true" savevalue="app"  datavalue="~dtFilterGet.@ZadnjihDana"/>
						</item>
						<item col="3" row="1">
							<labeledit name="lblDana" value="dana" />
						</item>
					</group>
					<item caption="Org. shema:" col="1" row="$VarOrgShemaRow" highlight="false">
						<combotreeedit name="cteOrgShema" valuefield="ID" displayfield="Naziv" datavalue="~dtFilterGet.@OrgShemaId" dataname="Global.dtOrgShema" savevalue="app" />
					</item>
					<item caption="Vrsta dokumenta:" col="1" row="$VarVrstaDokRow">
						<comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" datavalue="#Global.dtVrstaDokGet.@VrstaDokId" dataname="Global.dtVrstaDokGet" savevalue="app" />
					</item>
					<item caption="Zaključeno:" col="1" row="$VarStatusRow" highlight="false">
						<comboedit name="cmbStatus" valuefield="Id" displayfield="Naziv" datavalue="#dtFilterGet.@Status" dataname="dtFilterStatusi" savevalue="app" />
					</item>
					<item caption="Partner:" col="1" row="$VarPartnerRow" colspan="2" highlight="false">
						<searchedit netgenfields="true" name="srcPartner" dataname="Global.dtPartneri" fieldtext="NazivId" datavalue="~dtFilterGet.@PartneriId" fieldvalue="partneriid" datatext="~dtFilterGet.@Partner" savevalue="app">
							<event type="valuechanged">
								<action type="variable value">
									<parameter name="PartneriId" value="#srcPartner" />
								</action>
								<!-- <action type="message" value="$PartneriId" />											 -->
							</event>
							<!-- <event type="leave">
								<action type="datarun reader" value="Global.dtDajPartnera" if="#srcPartner!=null" />
								<action type="control value" value="#srcParstru" if="#srcPartner!=null">
									<parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv" />
								</action>
								<action type="form open" value="frmLokacije" if="#srcPartner.@BrojLokacija_Id!=null&amp;&amp;#srcPartner.@BrojLokacija_Id&gt;1&amp;&amp;$IndPromijenjeno==1&amp;&amp;~dtDajPartnera.@parstruid==null">
									<parameter name="PartneriId" value="#srcPartner" />
									<parameter name="IndLokacija" value="1" />
									<parameter name="ParStruId" value="#srcParstru" />
								</action>
								<action type="control refreshvalue" value="#srcParstru" if="#srcPartner==null" />
							</event> -->
						</searchedit>
					</item>
					<item caption="Lokacija:" col="1" row="$VarLokacijaRow" colspan="2" highlight="false" visible="false">
						<searchedit netgenfields="true" name="srcParstru" dataname="Global.dtParstru" fieldtext="NazivId" fieldvalue="ParStruId" datavalue="~dtFilterGet.@ParStruId" datatext="~dtFilterGet.@ParStruNaziv" savevalue="app">
							<!-- <event type="leave">
								<action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null" />
								<action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
									<parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv" />
								</action>
							</event> -->
						</searchedit>
					</item>
					<item caption="Fakturirani:" col="1" row="$VarFakturiraniRow" highlight="false">
						<comboedit name="cmbFakturirani" valuefield="FakturiraniId" displayfield="Naziv" datavalue="~dtFilterGet.@FakturiraniId" dataname="dtFilterFakturirani" savevalue="app" />
					</item>
					<item col="1" row="$VarSkladisteRow" highlight="false" caption="Skladište:">
						<comboedit name="cmbSkladiste" dataname="dtSkladiste" displayfield="Opis" valuefield="SkladisteId" datavalue="~dtFilterGet.@SkladisteId" savevalue="app" />
					</item>
					<item col="1" row="$VarUlaznoSkladisteRow" highlight="false" caption="Ulazno skladište:">
						<comboedit name="cmbUlaznoSkladiste" dataname="dtSkladiste" displayfield="Opis" valuefield="SkladisteId" datavalue="~dtFilterGet.@UlaznoSkladisteId" savevalue="app" />
					</item>
					<item caption="Operater:" col="1" row="$VarOperaterRow" highlight="false">
						<comboedit name="cmbOperater" valuefield="OperateriId" displayfield="Naziv" dataname="dtFilterOperateri" savevalue="app" />
					</item>
					<item caption="Odgovorna osoba:" col="1" row="$VarOsobaRow" highlight="false">
						<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" dataname="dtFilterOsoba" savevalue="app" />
					</item>
					<item caption="Način plaćanja:" col="1" row="$VarNacinPlacanjaRow" highlight="false">
						<comboedit name="cmbNacinPlacanja" valuefield="ProNacinNaplateId" displayfield="Opis" datavalue="~dtFilterGet.@ProNacinPlacanjaId" dataname="Global.dtNacinPlacanja" savevalue="app">
						</comboedit>
					</item>
					<item caption="Instr. plaćanja:" col="1" row="$VarInstrPlacanjaRow" highlight="false">
						<comboedit name="cmbInstrumentPlacanja" valuefield="KntNacinPlacId" displayfield="Naziv" datavalue="~dtFilterGet.@KntNacinPlacId" dataname="Global.dtInstrumentPlacanja" savevalue="app" />
					</item>
					<item caption="Način otpreme:" col="1" row="$VarNacinIsporukeRow" highlight="false">
						<comboedit name="cmbNacinOtpreme" valuefield="NacinIsporukeId" displayfield="Naziv" datavalue="~dtFilterGet.@NacinIsporukeId" dataname="Global.dtNacinIsporuke" savevalue="app" />
					</item>
					<item caption="Valuta:" col="1" row="$VarvalutaRow" highlight="false">
						<comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="~dtFilterGet.@DevValuteId" dataname="Global.dtValuta" savevalue="app" />
					</item>
					<item caption="Rajon:" col="1" row="$VarRajonRow" highlight="false">
						<comboedit name="cmbRajon" valuefield="RajonId" displayfield="Naziv" datavalue="~dtFilterGet.@RajonId" dataname="dtFilterRajoni" savevalue="app" />
					</item>
					<item caption="Radni nalog:" col="1" row="$VarRadniNalogRow" textalignmode="" highlight="false">
						<textedit name="txtRadniNalog" entermovenextcontrol="true" datavalue="~dtFilterGet.@PrnRadniNalogID" savevalue="app" />
					</item>
					<item caption="Broj dokumenta" col="1" row="$VarBrojDokRow" highlight="false">
						<textedit name="txtBrojDok" entermovenextcontrol="true" datavalue="~dtFilterGet.@Broj"  savevalue="app" />
					</item>
				</group>
				<group col="1" row="2" cols="3" rows="1" caption="Spremanje filtera">
					<columnsdefinition>
						<column position="2" size="75%"/>
						<column position="3" size="25%"/>
					</columnsdefinition>
					<item row="1" col="1" highlight="False">
						<checkedit name="chkSpremi" caption="" value="0">
							<event type="valuechanged">
								<action type="control caption" value="btnSpremi" if="#chkSpremi==true">
									<parameter value="SPREMI" />
									<action type="control enable" value="#txtNaziv, #txtSortkey" />
								</action>
								<action type="control caption" value="btnSpremi" else="">
									<parameter value="PRIKAŽI" />
									<action type="control disable" value="#txtNaziv, #txtSortkey" />
								</action>
							</event>
						</checkedit>
					</item>
					<item caption="" col="2" row="1" highlight="false">
						<textedit name="txtNaziv" entermovenextcontrol="true" datavalue="#dtFilterGet.@Naziv" required="true" />
					</item>
					<item caption="" col="3" row="1" highlight="false">
						<textedit name="txtSortkey" entermovenextcontrol="true" datavalue="#dtFilterGet.@Sortkey" nulltext="&lt;sortkey&gt;" format="n0"/>
					</item>
				</group>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="PRIKAŽI" >
					<event type="click">
						<action type="validate" />
						<action type="variable value">
							<parameter name="global.SavedFilter" value="0" />
						</action>
						<action if="#chkSpremi==true">
							<action type="variable value">
								<parameter name="global.SavedFilter" value="1" />
							</action>
							<action type="datarun scalar" value="~dtFilterInsert">
								<parameter name="global.CarpoFilterId" />
							</action>
							<action type="variable value" value="Global.$FilterPrikazi">
								<parameter value="true" />
							</action>
						</action>
						<action else="">
							<action type="variable value">
								<parameter name="global.SavedFilter" value="0" />
							</action>
							<action type="variable value" value="Global.$filterDatumOd">
								<parameter value="#datDatumOd" />
							</action>
							<action type="variable value" value="Global.$filterDatumDo">
								<parameter value="#datDatumDo" />
							</action>
							<action type="variable value" value="Global.$filterZadnjih">
								<parameter value="#txtZadnjih" />
							</action>
							<action type="variable value" value="Global.$filterOrgShemaId">
								<parameter value="#cteOrgShema" />
							</action>
							<action type="variable value" value="Global.$filterVrstaDokId">
								<parameter value="#cmbVrstaDok" />
							</action>
							<action type="variable value" value="Global.$filterStatus">
								<parameter value="#cmbStatus" />
							</action>
							<action type="variable value" value="Global.$filterPartneriId">
								<parameter value="#srcPartner" />
							</action>
							<action type="variable value" value="Global.$filterParStruId">
								<parameter value="#srcParstru" />
							</action>
							<action type="variable value" value="Global.$filterFakturirani">
								<parameter value="#cmbFakturirani" />
							</action>
							<action type="variable value" value="Global.$filterSkladisteId">
								<parameter value="#cmbSkladiste" />
							</action>
							<action type="variable value" value="Global.$filterUlaznoSkladisteId">
								<parameter value="#cmbUlaznoSkladiste" />
							</action>
							<action type="variable value" value="Global.$filterOperateriId">
								<parameter value="#cmbOperater" />
							</action>
							<action type="variable value" value="Global.$filterOsobeId">
								<parameter value="#cmbOsobe" />
							</action>
							<action type="variable value" value="Global.$filterProNacinPlacanjaId">
								<parameter value="#cmbNacinPlacanja" />
							</action>
							<action type="variable value" value="Global.$filterKntNacinPlacId">
								<parameter value="#cmbInstrumentPlacanja" />
							</action>
							<action type="variable value" value="Global.$filterNacinIsporukeId">
								<parameter value="#cmbNacinOtpreme" />
							</action>
							<action type="variable value" value="Global.$filterDevValuteId">
								<parameter value="#cmbValuta" />
							</action>
							<action type="variable value" value="Global.$filterRajonId">
								<parameter value="#cmbRajon" />
							</action>
							<action type="variable value" value="Global.$filterPrnRadniNalogID">
								<parameter value="#txtRadniNalog" />
							</action>
							<action type="variable value" value="Global.$filterBrojDok">
								<parameter value="#txtBrojDok" />
							</action>
							<action type="control populate" value="parent.#grdGlava" />
						</action>
						<!--<action type="variable value"> pa ovo valjd treba bit 0 tako mi svega! gore sam setirao na 0, a ako se spremi setiram na 1
							<parameter name="global.SavedFilter" value="1" />
						</action>-->
						<action type="form close" />
						<!-- <action type="control focus" value="#tree">
							<parameter value="global.$CarpoFilterId" type="int" />
						</action> -->
					</event>
				</button>
				<button caption="ODUSTANI" type="cancel" dock="left" />
				<!--			<button name="btnFilterOcisti" caption="OČISTI" dock="right"  type="delete">
					<event type="click">
						<action type="control refreshvalue" value="##" />
					</event>
				</button>  -->
			</buttons>
		</panelbuttons>
	</part>
	<part name="filterData">
		<data command="spFilter_Objekti_Query" name="dtFilterNumberOfRows">
			<parameter name="@tablica" value="global.$tablicaGla" />
			<parameter name="@action" value="0" />
		</data>
		<data command="spFilter_Objekti_Query" name="dtFilterObjekti">
			<parameter name="@tablica" value="global.$tablicaGla" />
			<parameter name="@action" value="1" />
		</data>
		<data command="spFilter_Rows" name="dtFilterSetRow">
			<parameter name="@tablica" value="global.$tablicaGla" />
		</data>
		<data command="spCarpoFilterQuery" name="dtFilterGet">
			<parameter name="@ID" value="$CarpoFilterId" />
		</data>
		<data command="select 1 as Id, 'Tekući tjedan' as Naziv union select 2, 'Tekući mjesec' union select 3, 'Tekući kvartal' union select 4, 'Tekuća godina'" type="text" name="dtFilterRazdoblje">
		</data>
		<data command="select 1 as FakturiraniId, 'Fakturirani' as Naziv union select 2, 'Nefakturirani' union select 3, 'Svi'" type="text" name="dtFilterFakturirani">
		</data>
		<data command="spProd_Operateri_Query" type="text" name="dtFilterOperateri">
		</data>
		<data command="spCarpoFilterAzur" name="dtFilterInsert">
			<parameter name="@CarpoFilterId" value="$CarpoFilterId" />
			<parameter name="@Granula" value="@@moduleid" />
			<parameter name="@Naziv" value="#txtNaziv" />
			<parameter name="@Sortkey" value="#txtSortkey" />
			<parameter name="@OperateriId" value="#cmbOperater" />
			<parameter name="@DatumOd" value="#datDatumOd" if="$chkZadnjihVar==0"/>
			<parameter name="@DatumOd" value="null" else=""/>
			<parameter name="@DatumDo" value="#datDatumDo" if="$chkZadnjihVar==0"/>
			<parameter name="@DatumDo" value="null" else=""/>
			<!-- <parameter name="@ZadnjihDana" value="#txtZadnjih" /> -->
			<!-- <parameter name="StatusiId" value="cmbStatus" /> -->
			<parameter name="@VrstaDokId" value="#cmbVrstaDok" />
			<parameter name="@PartneriId" value="#srcPartner" />
			<parameter name="@ParStruId" value="#srcParstru" />
			<parameter name="@ZadnjihDana" value="null" if="$chkZadnjihVar==0" />
			<parameter name="@ZadnjihDana" value="#txtZadnjih" else=""/>
			<parameter name="@Fakturirani" value="#cmbFakturirani" />
			<parameter name="@Status" value="#cmbStatus" />
			<parameter name="@OrgShemaId" value="#cteOrgShema" />
			<parameter name="@SkladisteId" value="#cmbSkladiste" />
			<parameter name="@UlaznoSkladisteId" value="#cmbUlaznoSkladiste" />
			<parameter name="@OsobeId" value="#cmbOsobe" />
			<!-- <parameter name="@ProNacinNaplateId" value="#" /> -->
			<parameter name="@KntNacinPlacId" value="#cmbInstrumentPlacanja" />
			<parameter name="@NacinIsporukeId" value="#cmbNacinOtpreme" />
			<parameter name="@DevValuteId" value="#cmbValuta" />
			<parameter name="@Broj" value="#txtBrojDok"/>
			<parameter name="@ssOperateriId" value="@@OperateriId" />
			<parameter name="@ProNacinPlacanjaId" value="#cmbNacinPlacanja" />
			<parameter name="@RajonId" value="#cmbRajon" />
			<parameter name="@PrnRadniNalogID" value="#txtRadniNalog" />
		</data>
		<data command="select rajonid, opis as Naziv from rajoni" type="text" name="dtFilterRajoni">
		</data>
		<data command="spFilter_Statusi" name="dtFilterStatusi">
			<parameter name="@id" value="global.$VrstaPromId" type="int" />
		</data>
		<data command="spNG_Combo" name="dtSkladiste">
			<parameter name="@Action" value="skladiste" />
			<parameter name="@Ind" value="1" />
		</data>
		<data command="spOsobeQuery" name="dtFilterOsoba">
			<parameter name="@Action" value="16" />
		</data>
	</part>
	<part name="filterParametriData">
		<data command="spFilter_Objekti_Query" name="dtFilterParametriGet">
			<parameter name="@tablica" value="global.$tablicaGla" />
			<parameter name="@action" value="2" />
			<parameter name="@operateriid" value="@@operateriid" />
		</data>
		<data command="spFilter_Objekti_Insert" name="dtFilterParametriInsert">
			<parameter name="@tablica" value="global.$tablicaGla" />
			<parameter name="@operateriid" value="@@operateriid" />
			<parameter name="@Datum" value="#chkDatum"/>
			<parameter name="@ZadnjihDana" value="#chkZadnjihDana"/>
			<parameter name="@Fakturirani" value="#chkFakturirani"/>
			<parameter name="@Status" value="#chkStatus"/>
			<parameter name="@Vrstadok" value="#chkVrstaDok"/>
			<parameter name="@OrgShema" value="#chkOrgShema"/>
			<parameter name="@Skladiste" value="#chkSkladiste"/>
			<parameter name="@UlaznoSkladiste" value="#chkUlaznoSkladiste"/>
			<parameter name="@Partner" value="#chkPartner"/>
			<parameter name="@Lokacija" value="#chkLokacija"/>
			<parameter name="@Operater" value="#chkOperater"/>
			<parameter name="@osoba" value="#chkOsoba"/>
			<parameter name="@NacinPlacanja" value="#chkNacinPlacanja"/>
			<parameter name="@InstrPlacanja" value="#chkInstrPlacanja"/>
			<parameter name="@NacinIsporuke" value="#chkNacinIsporuke"/>
			<parameter name="@Valuta" value="#chkValuta"/>
			<parameter name="@Rajon" value="#chkRajon"/>
			<parameter name="@RadniNalog" value="#chkRadniNalog"/>
			<parameter name="@BrojDok" value="#chkBrojDok"/>
		</data>
	</part>
	<part name="filterMenu">
		<!-- <action if="#tree.@CarpoFilterId!=0"> -->
		<menuitem caption="Postavke filtera" name="mnuFilterPostavke">
			<event type="click">
				<!-- <action type="message" value="#tree.@CarpoFilterId" /> -->
				<action type="form open" value="frmFilter" if="#tree.@CarpoFilterId!=null">
					<parameter name="CarpoFilterId" value="#tree.@CarpoFilterId" type="int"/>
				</action>
				<action type="control populate" value="#tree">
					<action type="control focus" value="#tree">
						<parameter value="global.$CarpoFilterId" type="string" />
					</action>
					<action type="control populate" value="#grdGlava" />
				</action>
			</event>
		</menuitem>
		<menuitem caption="Izbor parametara" name="mnuFilterParam">
			<event type="click">
				<!-- <action type="message" value="#tree.@CarpoFilterId" /> -->
				<action type="form open" value="frmFilterParametri"/>
			</event>
		</menuitem>
		<menuitem caption="Obriši" name="mnuFilterObrisi">
			<event type="click">
				<action type="confirm" value="Želite li obrisati filter '{#tree.@Name}'?" if="#tree.@CarpoFilterId!=null">
					<action type="datarun nonquery" value="global.~dtFilterDelete">
						<action type="control populate" value="#tree" />
					</action>
				</action>
				<action type="control enable" value="#btnIzmijeni, #btnPrint, #btnDodatno" if="#grdGlava.rowcount!=0" />
				<action type="control disable" value="#btnIzmijeni, #btnPrint, #btnDodatno" else="" />
				<action type="control disable" value="#btnIzmijeni, #btnObrisi, #btnZakljuci" if="#grdGlava.rowcount==0||#grdGlava.@Smije==0" />
				<action type="control enable" value="#btnIzmijeni, #btnObrisi, #btnZakljuci" else="" />
			</event>
		</menuitem>
		<!-- </action> -->
	</part>
	<part name="filterParametri">
		<event type="shown">
			<action type="control value" value="#chkDatum, #chkZadnjihDana, #chkVrstaDok">
				<parameter value="1"/>
			</action>
			<action type="control disable" value="#chkDatum, #chkZadnjihDana, #chkVrstaDok"/>
		</event>
		<layout textposition="left">
			<group cols="1" rows="19" groupbordervisible="true">
				<item col="1" row="1">
					<checkedit name="chkDatum" caption="Datum" value="1" datavalue="~dtFilterParametriGet.@Datum" highlight="false" />
				</item>
				<item col="1" row="2">
