    <parts>
        <part name="manageratributi">
  
            <item caption="Vrsta:" row="1" col="1">
                <comboedit name="cmbVrsta" valuefield="KupUgovoriVrsteId" displayfield="Naziv" datavalue="~dtGet.@KupUgovoriVrsteId" dataname="Global.~dtGetVrsta" />
            </item>     
            <item caption="Broj:" row="2" col="1">
                <textedit name="txtBroj" datavalue="~dtGet.@Broj" type="int"/>
            </item>     
            <item caption="Datum:" row="3" col="1">
                <dateedit name="datDatum" value="now" datavalue="~dtGet.@DatumUgovora" />
            </item>
            <item caption="Vrijedi do:" row="4" col="1">
                <dateedit name="datVrijedido" datavalue="~dtGet.@UgovorVrijediDo" allownull="true" value="now"/>
            </item>         
            <item caption="Org. shema:" row="5" col="1">
                <comboedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv" dataname="Global.~dtGetOrgShema" datavalue="~dtGet.@OrgShemaId" />
            </item>
            <item caption="Odg.osoba:" row="6" col="1" fontbold="true">
               <searchedit name="srcOsobe" required="true" fontbold="true" 
               fieldtext="Osoba" fieldvalue="OsobeId" dataname="Global.~dtOdgovornaOsoba" datavalue="~dtGet.@OsobeId" datatext="~dtGet.@OsobaNaziv"/>
             </item>            
             <item caption="Kupac:" row="7" col="1" fontbold="true" >
                <searchedit netgenfields="true" name="srcPartner" required="true" fontbold="true"
                 datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartnerNaziv" dataname="~dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" >
                    <!--dopušta samo partnerovu lokaciju ukoliko je selektiran-->
                    <event type="valuechanged">
                        <action type="variable value">
                            <parameter name="PartneriId" value="#srcPartner" />
                        </action>   
                        <action type="variable value">
                            <parameter name="IndPromijenjeno" value="1" />
                        </action>                           
                    </event>
                    <event type="leave">

                        <action type="variable value">
                            <parameter name="partneriid" value="#srcPartner" />
                        </action>

                        <action type="datarun reader" value="Global.~dtDajPartnera" if="#srcPartner!=null"/>                        
                        <action type="control value" value="#srcParstru" if="#srcPartner!=null&amp;&amp;#srcPartner.@BrojLokacija_Id==1">
                            <parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>
                        </action>
                      
                        <action type="control refreshvalue" value="#srcParstru" if="#srcPartner==null"/>
                        <action type="variable value">
                            <parameter name="IndLokacija" value="0" />
                        </action>
                        <action type="variable value">
                            <parameter name="IndPromijenjeno" value="0" />
                        </action>                    
                    </event>
                </searchedit>
            </item>
            <item caption="Lokacija:" row="8" col="1">
                <searchedit netgenfields="true" name="srcParstru" dataname="Global.~dtParstru" fieldtext="NazivId" fieldvalue="ParStruId" datavalue="~dtGet.@ParStruId" datatext="~dtGet.@Lokacija" >

                    <event type="leave">
                        <action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null"/>
                        <action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
                            <parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv"/>
                        </action>
                    </event>
                </searchedit>
            </item>
             <item caption="Lokacija:" row="8" col="1">
                <button name="btnParstru" caption="Poveži više lokacija">
                    <event type="click">
                        <action type="form open" value="frmPoveziSlokacijama">
                            <parameter name="KupUgovoriGlaId" value="$KupUgovoriGlaId" />
                        </action>
                        <action type="datarun nonquery" value="Global.dtBrisiSveTempLokacije" />
                    </event>
                </button>
            </item>   
            <item caption="Dinamika fakturiranja:" row="9" col="1">
                <comboedit name="cmbDinFak" valuefield="SecNacinFakturiranjaID" datavalue="~dtget.@SecNacinFakturiranjaID" displayfield="Naziv" dataname="Global.~dtDinFak" />
            </item> 
        
            <item caption="Opis:" row="10" col="1">
                <memoedit name="txtOpis" maxlength="180" datavalue="~dtGet.@Opis"  tabstop="false"/>
            </item>
        </part>

         <part name="carobnjakatributi">
            <item caption="Broj:" row="2" col="1">
                <textedit name="txtBroj" datavalue="~dtGet.@Broj" type="int"/>
            </item>     
            <item caption="Vrsta:" row="1" col="1">
                <comboedit name="cmbVrsta" valuefield="KupUgovoriVrsteId" displayfield="Naziv" datavalue="~dtGet.@KupUgovoriVrsteId" dataname="Global.~dtGetVrsta" />
            </item>     
            <item caption="Datum:" row="3" col="1">
                <dateedit name="datDatum" value="now" datavalue="~dtGet.@DatumUgovora" />
            </item>
            <item caption="Vrijedi do:" row="4" col="1">
                <dateedit name="datVrijedido" datavalue="~dtGet.@UgovorVrijediDo" allownull="true" />
            </item>         
            <item caption="Org. shema:" row="5" col="1">
                <comboedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv" dataname="Global.~dtGetOrgShema" datavalue="~dtGet.@OrgShemaId" />
            </item>
            <item caption="Odg.osoba:" row="6" col="1" fontbold="true">
               <searchedit name="srcOsobe" required="true" fontbold="true" 
               fieldtext="Osoba" fieldvalue="OsobeId" dataname="Global.~dtOdgovornaOsoba" datavalue="~dtGet.@OsobeId" datatext="~dtGet.@OsobaNaziv"/>
             </item>            
            <item caption="Kupac:" row="7" col="1" fontbold="true" >
                <searchedit netgenfields="true" name="srcPartner" required="true" fontbold="true"
                 datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartnerNaziv" dataname="dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" >
                    <!--dopušta samo partnerovu lokaciju ukoliko je selektiran-->
                    <event type="valuechanged">
                        <action type="variable value">
                            <parameter name="PartneriId" value="#srcPartner" />
                        </action>   
                        <action type="variable value">
                            <parameter name="IndPromijenjeno" value="1" />
                        </action>                           
                    </event>
                    <event type="leave">                        
                        <action type="datarun reader" value="Global.~dtDajPartnera" if="#srcPartner!=null"/>                        
                        <action type="control value" value="#srcParstru" if="#srcPartner!=null&amp;&amp;#srcPartner.@BrojLokacija_Id==1">
                            <parameter value="~dtDajPartnera.@parstruid" text="~dtDajPartnera.@Naziv"/>   
                        </action>

                        <action type="form open" value="frmLokacije" if="#srcPartner.@BrojLokacija_Id!=null&amp;&amp;#srcPartner.@BrojLokacija_Id&gt;1&amp;&amp;$IndPromijenjeno==1">
                            <parameter name="PartneriId" value="#srcPartner" />
                            <parameter name="IndLokacija" value="1" />
                            <parameter name="ParStruId" value="#srcParstru" />  
                        </action>



                        <action type="control refreshvalue" value="#srcParstru" if="#srcPartner==null"/>
                        <action type="variable value">
                            <parameter name="IndLokacija" value="0" />
                        </action>
                        <action type="variable value">
                            <parameter name="IndPromijenjeno" value="0" />
                        </action>                       
                    </event>
                </searchedit>
            </item>
            <item caption="Lokacija:" row="8" col="1">
                <searchedit netgenfields="true" name="srcParstru" dataname="Global.~dtParstru" fieldtext="NazivId" fieldvalue="ParStruId" datavalue="~dtGet.@ParStruId" datatext="~dtGet.@Lokacija" >
                    <event type="leave">
                        <action type="datarun reader" value="Global.dtDajPartnera" if="#srcParstru!=null"/>
                        <action type="control value" value="#srcPartner" if="#srcPartner==null&amp;&amp;#srcParstru!=null">
                            <parameter value="~dtDajPartnera.@partneriid" text="~dtDajPartnera.@Naziv"/>
                        </action> 
                    </event>
                </searchedit>
            </item>

            <item caption="Opis:" row="9" col="1">
                <memoedit name="txtOpis" maxlength="180" datavalue="~dtGet.@Opis" ></memoedit>
            </item>
        </part>

        <part name="partTabKupci">
            <group rows="2" cols="1" groupbordervisible="false">
                 <rowsdefinition>
                    <row size="30%" position="1" />
                    <row size="70%" position="2" />
                </rowsdefinition>
                <group rows="4" cols="2" row="1" col="1">
                    <rowsdefinition>
                        <row size="23%" position="1" />
                        <row size="23%" position="2" />
                        <row size="23%" position="3" />
                        <row size="30%" position="4" />
                    </rowsdefinition>
                    <columnsdefinition>
                        <column size="105" position="1" />
                        <column size="105" position="3" />
                    </columnsdefinition>
                    <item row="1" col="1" tabstop="false">
                        <radioedit name="rdoPartneri" caption="Partner:" required="true" >
                            <event type="checkedchanged">
                                <action type="control enable" value="#srcPartneri" if="#rdoPartneri==true" >
                                    <action type="control focus" value="#srcPartneri"></action>
                                </action>
                                <action type="control disable" value="#cmbKlasa" if="#rdoPartneri==true" />
                                <action type="control value" value="#cmbKlasa" if="#rdoPartneri==true">
                                    <parameter value="null" />
                                </action>
                            </event>
                        </radioedit>
                    </item>
                    <group row="2" col="1" rows="1" cols="2" groupbordervisible="false">
                        <item row="1" col="1">
                            <radioedit name="rdoDodajSve" caption="Dodaj sve partnere s aktivnim ugovorom" >
                                <event type="checkedchanged">
                                    <action type="control value" value="#srcPartneri">
                                        <parameter value="null" />
                                    </action>
                                    <action type="control disable" value="#srcPartneri,#cmbKlasa" if="#rdoDodajSve==true" />
                                    <action type="control enable" value="#btnDodaj" if="#rdoDodajSve==true" />
                                    <action type="control disable" value="#btnDodaj" if="#rdoDodajSve==false" />
                                </event>
                            </radioedit>
                        </item>
                    </group>
                    <item row="3" col="1">
                        <radioedit name="rdoKlasa" caption="Klasa partnera:" required="true">
                            <event type="checkedchanged">
                                <action type="control enable" value="#cmbKlasa" if="#rdoKlasa==true" >
                                    <action type="control focus" value="#cmbKlasa"></action>
                                </action>
                                <action type="control disable" value="#srcPartneri" if="#rdoKlasa==true" />
                                <action type="control value" value="#srcPartneri" if="#rdoKlasa==true">
                                    <parameter value="null" />
                                </action>
                            </event>
                        </radioedit>
                    </item>
                   

                    <item row="1" col="2">
                        <searchedit name="srcPartneri" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtTraziPartneri" required="true">
                            <event type="valuechanged">
                                <action type="control enable" value="#btnDodaj" if="#srcPartneri!=null" />
                                <action type="control disable" value="#btnDodaj" if="#srcPartneri==null" />
                            </event>
                        </searchedit>
                    </item>
                    <item row="2" col="2">

                    </item>
                    <item row="3" col="2">
                        <comboedit name="cmbKlasa" valuefield="KlPartneriID" displayfield="Naziv" dataname="dtKlPartneri">
                            <event type="valuechanged">
                                <action type="control enable" value="#btnDodaj" if="#cmbKlasa!=null" />
                                <action type="control disable" value="#btnDodaj" if="#cmbKlasa==null" />
                            </event>
                        </comboedit>
                    </item>
                    <group row="4" col="2" rows="1" cols="4" groupbordervisible="false">
                        <columnsdefinition>
                            <column size="130" position="3" />
                            <column size="20" position="4" />
                        </columnsdefinition>
                        <item row="1" col="4" >
                            <button name="btnDodaj" caption="Dodaj">
                                <event type="click">
                                    <action type="datarun nonquery" value="~dtInsertPartner" if="#rdoPartneri==True" />
                                    <action type="datarun nonquery" value="~dtInsertKlPartneri" elseif="#rdoKlasa==True" />
                                    <action type="datarun nonquery" value="~dtInsertSviPartneri" else="" />
                                    <action type="control populate" value="#grdPartneri">
                                        <action type="control enable" value="#btnSpremi,#btnObrisi" if="#grdPartneri.rowcount>0" />
                                    </action>
                                    <action type="control value" value="#srcPartneri,#cmbKlasa">
                                        <parameter value="null" />
                                    </action>
                                    <action type="control focus" value="#grdPartneri" />
                                </event>
                            </button>
                        </item>
                    </group>
                </group>
                <group row="2" col="1" rows="2" cols="4">
                    <rowsdefinition>
                        <row size="78%" position="1" />
                        <row size="12%" position="2" />
                    </rowsdefinition>
                    <item row="1" col="1" colspan="4">
                        <grid name="grdPartneri" dataname="~dtPuniGrid" netgenfields="true" showcheckboxes="true">
                            <action type="control enable" value="#btnObrisi" if="#grdPartneri.rowcount!=0" />
                        </grid>
                    </item>
                    <group row="2" col="3" colspan="2" rows="1" cols="2" groupbordervisible="false">
                        <item row="1" col="1">
                            <button name="btnSpremi" caption="Spremi">
                                <event type="click">
                                    <action type="tab focus" value="tabOsnovno" />
                                </event>
                            </button>
                        </item>
                        <item row="1" col="2">
                            <button name="btnObrisi" caption="Obriši">
                                <event type="click">
                                    <action type="confirm" value="'Brisanje označenih stavki. Nastaviti?'">
                                        <action type="control foreachrow selected" value="#grdPartneri">
                                            <action type="@action" value="3" />
                                            <action type="datarun nonquery" value="~dtObrisiPartnera"></action>
                                        </action>
                                        <action type="control populate" value="#grdPartneri" />
                                        <action type="control disable" value="#btnSpremi,#btnObrisi" if="#grdPartneri.rowcount==0" />
                                    </action>
                                </event>
                            </button>
                        </item>
                    </group>
                </group>
            </group>
        </part>
    </parts>


    