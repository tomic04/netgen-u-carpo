<parts>
	<part name="partDrvo">
		<lookup name="filter">
			<comboitem value="Vremenska podjela" searchfield="DatumKeyId"/>
			<comboitem value="Skladište" searchfield="SkladisteKeyId"/>
			<comboitem value="Statusi" searchfield="StatusiKeyId"/>
			<comboitem value="Vremenska podjela bez skladišta" searchfield="DatumBezSklKeyId"/>
			<event type="valuechanged">
				<action type="variable value" value="global.filter">
					<parameter value="#filter" />
				</action>
				<action type="variable value" value="global.indFilter">
					<parameter value="1" if="#filter==Vremenska podjela||#filter==Skladište||#filter==Vremenska podjela bez skladišta"/>
					<parameter value="0" else=""/>
				</action>				
			</event>
			<action type="control populate" value="#tree" /> 		
		</lookup>		
		<tree name="tree" key="Id" dataname="global.dtTree" filtermode="smart">
			<fields>
				<field name="Name"/>
			</fields>
			<event type="focusedrowchanged">
				<action type="control populate" value="#grdGlava" if="#tree.@ind!=Skladište&amp;&amp;#tree.@ind!=VrstaDok"/>
				<action type="control datasourceempty" value="#grdGlava,#grdDetalj" if="#tree.@ind==Skladište||#tree.@ind==VrstaDok"/>
			</event>		
		</tree>			
	</part>	
</parts>