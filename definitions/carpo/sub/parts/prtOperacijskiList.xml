<parts>
	<part name="OperacijskiListAtributi">
		<!-- <group col="1" row="1" cols="2" rows="1" alignmode="local" bordervisible="false"> -->
			<item caption="Oznaka:" col="1" row="1" colspan="2" textposition="top" highlight="false" >
				<textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" required="true" maxlength="$maxlengthOZ"/>
			</item>	
			<item caption="Opis:" col="1" row="2"  colspan="2" textposition="top" highlight="false">
				<textedit name="txtOpis" datavalue="~dtGet.@Opis" maxlength="$maxlengthOP"/>
			</item>
		<!-- </group> -->
		<!-- <group col="1" row="2" cols="4" rows="1" alignmode="local" bordervisible="false"> -->
			<item caption="Proizvod:" col="1" row="3" colspan="2" textposition="top" highlight="false">
				<searchedit  name="txtRoba"  fieldtext="Naziv" fieldvalue="RobaId" entermovenextcontrol="false" required="true"  datavalue="~dtGet.@RobaId" datatext="~dtGet.@Roba" dataname="Global.~dtRoba">
					<event type="valuechanged"  raiseonload="false"> <!-- type="leave" -->
						<action type="control focus" value="#txtKolicina"/>
						<action type="variable value" >
							<parameter name="global.RobaId" value="#txtRoba.@robaid" type="int"/>
						</action>
						<action type="variable value" >
							<parameter name="global.ProizvodiId" value="#txtRoba.@ProizvodiId" type="int"/>
						</action>
						<action type="control enable" value="#cmbJM" if="global.$RobaId!=null"/>
						<!-- <action type="datarun nonquery" value="global.~dtJM"/> -->
						<!-- <action type="control value" value="#cmbJM" > -->
							<!-- <parameter value="$JMId"/> -->
						<!-- </action> -->
						<action type="control populate" value="#cmbJM"/>
							<!-- </action> -->
					</event>						
				</searchedit>
			</item>	
			<item caption="Količina"  col="1" row="4" textposition="top" highlight="false">
				<textedit name="txtKolicina" fontsizedelta="1" fontbold="True" value="0" format="n2" required="true" datavalue="~dtGet.@kolicina"/>
			</item>
			<item caption="JM:"  col="2" row="4" textposition="top" highlight="false">
				<comboedit name="cmbJM" valuefield="JMId" displayfield="JM" allownull="false" dataname="Global.~dtJM" datavalue="~dtGet.@Jmid" />
			</item>	
		<!-- </group> -->
		<!-- <group col="1" row="3"  cols="2" rows="1" alignmode="local" bordervisible="false"> -->
			<item caption="Org. shema:" col="1" row="5" colspan="2" textposition="top" highlight="false">
				<combotreeedit name="cteOrgShema" valuefield="ID" displayfield="Naziv" parentfieldname="ParentID" datavalue="~dtGet.@ID" dataname="Global.~dtOrgShema" required="true" allownull="false"/>
			</item>
			<item caption="Odgovorna osoba:" col="1" row="6" colspan="2" textposition="top" highlight="false">
				<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" datavalue="~dtGet.@OsobeId" dataname="Global.dtOdgovornaOsoba" required="true" allownull="false"/>
			</item>	
		<!-- </group> -->
	</part>
</parts>