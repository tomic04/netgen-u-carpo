<parts>
	<part name="Napomena">
		<columnsdefinition>
			<column position="1" size="100%"/>
			<column size="70" position="2"/>
			<column size="70" position="3"/>
		</columnsdefinition>
		<rowsdefinition>
			<row size="30" position="2" />
		</rowsdefinition>
		<item caption="Standardne napomene:" row="1" col="1" colspan="3" textposition="top">
			<comboedit name="cmbNapomena" enabled="true" valuefield="Poruka" displayfield="Poruka" datavalue="#dtGet.@Poruka" dataname="Global.dtPoruke" allownull="false"/>
		</item>
		<item row="2" col="2">
			<button name="btnDodaj" caption="Dodaj" dock="right">
				<event type="click">				
					<action type="datarun reader" value="Global.dtNapomena"/>					
					<action type="control value" value="#MemoGlava">
						<parameter value="~dtNapomena.@tekst"/>
					</action>
				</event>
			</button>
		</item>
		<item row="2" col="3" >
			<button name ="btnZamijeni" caption="Zamijeni" type="edit" dock="right" >
				<event type="click">
					<action type="control value" value="#MemoGlava">
						<parameter value="#cmbNapomena"/>
					</action>
				</event>
			</button>
		</item>
		<item name="Memo" textvisible="False" row="3" col="1" colspan="3" >
			<memoedit name="MemoGlava" datavalue="~dtGet.@Memo"/>
			<event type="valuechanged">
				<action type="control disable" value="#btnZamijeni" if="#Memo!=null"/>
			</event>
		</item>
	</part>
</parts>