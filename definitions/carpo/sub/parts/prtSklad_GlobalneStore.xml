<parts>
	<part name="partGlobalneStore">
		<data command="spProd_CheckPermission" name="dtCheckPermission">
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@Objekt" value="Global.$ImeGranule" />
			<parameter name="@Funkcija" value="$Funkcija" />
		</data>
		<data command="spSklad_Search" name="dtSearch">
			<parameter name="@Pojam" value="#btnSearch.searchtext" />
			<parameter name="@VrstaPromId"  value="Global.$VrstaPromId" />
			<parameter name="@action" value="vrijeme" if="#filter==Vremenska podjela"/>
			<parameter name="@action" value="skladiste" if="#filter==Skladište"/>
			<parameter name="@action" value="statusi" if="#filter==Statusi"/>
		</data>
		<data command="spCarpoPrint" name="dtPrint">
			<parameter name="@Action" value="GetTemplates" />
			<parameter name="@Id" value="$SktPrometGlaId" type="int" if="$Izmjena==1"/>
			<parameter name="@Id" value="#grdGlava.@SktPrometGlaId" type="int" else=""/>
			<parameter name="@Tablica" value="SktPrometGla" />
		</data>	
		<data command="spNG_Combo" name="dtVrstaDok">
			<parameter name="@Action" value="VrstaDok" />
			<parameter name="@ID" value="Global.$VrstaPromId" />
		</data>	
		<data command="spSklad_MasterGrid_Dan" name="dtGlava" if="global.$IndFilter==1&amp;&amp;#tree.@Ind==Dan">
			<parameter name="@ID" value="#tree.@ID" />	
			<parameter name="@ValueId" value="#tree.@ValueId" />
			<parameter name="@SkladisteId" value="#tree.@SkladisteId" />
			<parameter name="@Mjesec" value="#tree.@Mjesec" />
			<parameter name="@Rbr" value="#tree.@Rbr" />
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />
		</data>
		<data command="spSklad_MasterGrid_Tjedan" name="dtGlava" if="global.$IndFilter==1&amp;&amp;#tree.@Ind==Tjedan">
			<parameter name="@ID" value="#tree.@ID" />	
			<parameter name="@ValueId" value="#tree.@ValueId" />
			<parameter name="@SkladisteId" value="#tree.@SkladisteId" />
			<parameter name="@Mjesec" value="#tree.@Mjesec" />
			<parameter name="@Rbr" value="#tree.@Rbr" />
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />
		</data>
		<data command="spSklad_MasterGrid_Mjesec" name="dtGlava" if="global.$IndFilter==1&amp;&amp;#tree.@Ind==Mjesec">
			<parameter name="@ID" value="#tree.@ID" />	
			<parameter name="@ValueId" value="#tree.@ValueId" />
			<parameter name="@SkladisteId" value="#tree.@SkladisteId" />
			<parameter name="@Mjesec" value="#tree.@Mjesec" />
			<parameter name="@Rbr" value="#tree.@Rbr" />
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />
		</data>
		<data command="spSklad_MasterGrid_Godina" name="dtGlava" if="global.$IndFilter==1&amp;&amp;#tree.@Ind==Godina">
			<parameter name="@ID" value="#tree.@ID" />	
			<parameter name="@ValueId" value="#tree.@ValueId" />
			<parameter name="@SkladisteId" value="#tree.@SkladisteId" />
			<parameter name="@Mjesec" value="#tree.@Mjesec" />
			<parameter name="@Rbr" value="#tree.@Rbr" />
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />
		</data>
		<data command="spSklad_MasterGrid_Statusi" name="dtGlava" if="#filter==Statusi">
			<parameter name="@ID" value="#tree.@ID" />	
			<parameter name="@Godina" value="#tree.@Godina" />
			<parameter name="@Statusiid" value="#tree.@Statusiid" />
			<parameter name="@Mjesec" value="#tree.@Mjesec" />
			<parameter name="@VrstaDokId" value="#tree.@VrstaDokId" />
		</data>	
		<data command="spSklad_MasterGrid_Dokument" name="dtGlaRefreshRow" >
			<parameter name="@SktPrometGlaId" value="$SktPrometGlaId" if="$SktPrometGlaId!=null"/>
			<parameter name="@SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" else=""/>			
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />		
		</data>	
		<data command="spTraziOsobe" name="dtOdgovornaOsoba">
			<parameter name="@Action" value="NaseOsobe" />
		</data>
		<data command="spTraziOsobe" name="dtVozac">
			<parameter name="@Action" value="SveOsobe" />
			<parameter name="@Uvjet" value="#srcVozac.text" />
		</data>	
		<data command="spTraziOsobe" name="dtKadrovi">
			<parameter name="@Action" value="Kadrovi" />
			<parameter name="@Svi" value="0" if="#chkSvi==False"/>
			<parameter name="@Svi" value="1" else=""/>
			<parameter name="@uvjet" value="#srcOsoba.text" />
			<parameter name="@razdvoji" value="1" />
		</data>	
		<data command="spNG_Combo" name="dtOrgShema">
			<parameter name="@Action" value="orgshema" />
			<parameter name="@Ind" value="1" />
			<parameter name="@ime_kontrole" value="ID" />
		</data>	
		<data command="spNG_Combo" name="dtSkladiste">
			<parameter name="@Action" value="skladiste" />
			<parameter name="@Ind" value="1" />
			<parameter name="@oznaka" value="viSkladistaZaOperatera"/>
			<parameter name="@join" value="viOrgShemaPrava"/>		
			<parameter name="@dodatno" value="1"/>	
		</data>
		<data command="spNG_Combo" name="dtSkladisteUlaza">
			<parameter name="@Action" value="skladiste" />
			<parameter name="@Ind" value="1" />
			<parameter name="@oznaka" value="Skladiste" if="$Izmjena==1"/>
			<parameter name="@oznaka" value="viSkladistaUlazaZaOperatera" else=""/>
			<parameter name="@join" value="viOrgShemaPrava"/>		
			<parameter name="@dodatno" value="1"/>	
		</data>			
		<data command="spTraziSmjestaj" name="dtSmjestaj">
			<parameter name="@Uvjet" value="#srcSmjestaj.text"/>
		</data>	
		<data command="spSklad_Gla_Konfig" name="dtKonfig">
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@operateriid" value="@@operateriid" />
		</data>	
		<data command="spSklad_PopuniPoljaZaOperatera" name="dtPopuniPolja">
			<parameter name="@vrstadokid" value="$VrstaDokId" />
			<parameter name="@operateriid" value="@@operateriid" />
		</data>
		<data command="spSklad_MasterPozicioniranje" name="dtDajNode">
			<parameter name="@ID" value="Global.$DokId" type="int"/>
			<parameter name="@filter" value="global.$filter" type="string"/>
		</data>
		<data command="select coalesce(@par1, '') + char(13) + char(10) + coalesce(@par2, '') as tekst" type="text" name="dtNapomena">
			<parameter name="@par1" value="#MemoGlava"/>
			<parameter name="@par2" value="#cmbNapomena"/>
		</data>	
		<data command="spPorukeQuery" name="dtPoruke">
			<parameter name="@Action" value="3" />
			<parameter name="@Sifra" value="Global.$VrstaPromSifra" />
		</data>		
		<data command="spNG_Query" name="dtOperaterLock">
			<parameter name="@Action" value="OperaterLock" />
			<parameter name="@id" value="#grdGlava.@SktPrometGlaId" />
			<parameter name="@tablica" value="SktPrometGla" />
			<parameter name="@operateriid" value="@@OperateriId" />
		</data>	
		<data command="spStatusi_NG" name="dtStatusiLog">
			<parameter name="@action" value="0" />
			<parameter name="@id" value="parent.#grdGlava.@SktPrometGlaId" type="int" />
			<parameter name="@tablica" value="SktPrometGla"/>
		</data>
		<data command="spStatusi_NG" name="dtStatusi">
			<parameter name="@action" value="1" if="$VratiStatus==0"/>
			<parameter name="@action" value="2" if="$VratiStatus==1"/>
			<parameter name="@tablica" value="SktPrometGla"/>				
			<parameter name="@operateriid" value="@@OperateriId" />
			<parameter name="@id" value="$SktPrometGlaId" type="int" />
		</data>		
		<data command="spStatusi_NG" name="dtStatusiProvjera">
			<parameter name="@action" value="3" if="$VratiStatus==0"/>
			<parameter name="@action" value="4" if="$VratiStatus==1"/>
			<parameter name="@tablica" value="SktPrometGla"/>				
			<parameter name="@operateriid" value="@@OperateriId" />
			<parameter name="@id" value="$SktPrometGlaId" type ="int" if="$Izmjena==1"/>
			<parameter name="@id" value="#grdGlava.@SktPrometGlaId" type="int" else=""/>
		</data>
		<data command="spStatusi_NG" name="dtStatusiLog">
			<parameter name="@action" value="0" />
			<parameter name="@id" value="parent.#grdGlava.@SktPrometGlaId" type ="int" />
			<parameter name="@tablica" value="SktPrometGla"/>
		</data>	
		<data command="spSklad_Gla_PromijeniStatus" name="dtPromijeniStatus">
			<parameter name="@SktPrometGlaId" value="$SktPrometGlaId" type ="int" if="parent.$Izmjena==1"/>
			<parameter name="@SktPrometGlaId" value="parent.#grdGlava.@SktPrometGlaId" type="int" else=""/>
			<parameter name="@StatusiId" value="#cmbStatusi" />		
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@Napomena" value="#txtNapomena" />
		</data>
		<data command="spSitIzborQuery" name="dtRoba" if="Global.$ImeGranule==Sklad_PovratnicaSitni">
			<parameter name="@action" value="2" type="int"/>		
			<parameter name="@NazivDod" value="#srcRoba.text"/>
			<!-- <parameter name="@PokaziNabCijene" value="2" if="global.$PokaziNC==0"/> -->
			<!-- <parameter name="@PokaziNabCijene" value="1" else=""/> -->
			<parameter name="@SkladisteId" value="$SkladisteId"/>
		</data>	
		<data command="spTraziRoba" name="dtRoba" else="">
			<parameter name="@action" value="Roba"/>		
			<parameter name="@Uvjet" value="#srcRoba.text"/>
			<parameter name="@PokaziNabCijene" value="2" if="global.$PokaziNC==0"/>
			<parameter name="@PokaziNabCijene" value="1" else=""/>
			<parameter name="@Retired" value="0"/>
			<parameter name="@Prikazi_Dodatno" value="1"/>
			<parameter name="@PokaziStanje" value="1"/>
			<parameter name="@SkladisteId" value="$SkladisteId"/>
			<parameter name="@Datum" value="$DatumDok"/>			
			<parameter name="@PokaziVPCijene" value="2"/>
		</data>	
		<data command="spSklad_Tree_Vrijeme" name="dtTree" if="#filter==Vremenska podjela">
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@OperateriId" />
		</data>
		<data command="spSklad_Tree_Vrijeme_BezSkl" name="dtTree" if="#filter==Vremenska podjela bez skladišta">
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@OperateriId" />
		</data>		
		<data command="spSklad_Tree_Skladiste" name="dtTree" if="#filter==Skladište">	
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@OperateriId" />
		</data>		
		<data command="spSklad_Tree_Statusi" name="dtTree" if="#filter==Statusi">	
			<parameter name="@VrstaPromId" value="Global.$VrstaPromId"/>
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@OperateriId" />		
		</data>	
		<data command="spSklad_DetailGrid" name="dtDetalj">
			<parameter name="@SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />					
		</data>
		<data command="spSklad_KKvalGlaHelper_Azur" name="dtDelKKvalGlaHelper">
			<parameter name="@GlaId" value="global.$DokId"/>	
			<parameter name="@OperateriId" value="@@operateriid"/>	
			<parameter name="@Tablica" value="global.$tablicaDet" />		
			<parameter name="@IndObrisi" value="1" />
		</data>	
		<data command="spSklad_KKvalGlaHelper_Azur" name="dtBrKKvalGlaHelper">
			<parameter name="@GlaId" value="global.$DokId"/>	
			<parameter name="@OperateriId" value="@@operateriid"/>	
			<parameter name="@Tablica" value="global.$tablicaDet" />		
			<parameter name="@IndBroj" value="1" />
			<parameter name="@KolicinaDet" value="$KolicinaDet"/>
			<parameter name="@SkladisteId" value="parent.#grdKontingenti.@SkladisteId" if="$IndSkeniraj==1"/>
			<parameter name="@SkladisteId" value="#grdKontingenti.@SkladisteId" else=""/>
		</data>	
		<data command="spSklad_Gla_Kopiraj" name="dtKopiraj">
			<parameter name="@SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />
			<parameter type="date" name="@DatumDok" value="now" />
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@VrstaDokId" value="#btnKopiraj.@VrstaDokId" />
		</data>
		<data command="spSklad_DetailGrid_Dimenzije" name="dtDimenzije">
			<parameter name="@Id" value="$SktPrometGlaId" if="$SktPrometGlaId!=null"/>
			<parameter name="@Id" value="#grdGlava.@SktPrometGlaId" else=""/>
			<parameter name="@IndKolUlazIzlaz" value="Global.$IndKolUlazIzlaz" type="string"/>		
		</data>
		<data command="spSklad_Gla_PromijeniStatus_Provjera" name="dtProvjeraViseStatusa">
			<parameter name="@tablica" value="Global.$tablicaGla" type="string"/>
			<parameter name="@table" value="#grdGlava.selectedids.table"/>		
		</data>	
		<data command="spSklad_Gla_Brisanje" name="dtGlavaObrisi">
			<parameter name="@SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />
			<parameter name="@OperateriId" value="@@operateriid" />
		</data>	
		<data command="spSklad_Tree_Pozicija" name="dtDrvoPozicija">
			<parameter name="@VrstaProm" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@operateriid" />
			<parameter name="@Filter" value="global.$filter" />
		</data>	
		<data command="spSklad_Gla_WMS_Posalji" name="dtWMSPosalji">
			<parameter name="@VrstaPromSifra" value="Global.$VrstaPromSifra" />
			<parameter name="@OperateriId" value="@@operateriid" />
			<parameter name="@GlaId" value="$SktPrometGlaId" type ="int" if="$Izmjena==1"/>
			<parameter name="@GlaId" value="#grdGlava.@SktPrometGlaId" type="int" else=""/>			
		</data>
		<data command="spTraziPartneri" name="dtPartneri">
			<parameter name="@Action" value="Partneri" />
			<parameter name="@Uvjet" value="#srcPartner.text" />
			<parameter name="@broj_lokacija" value="1" />
		</data>
		<data command="spTraziParstru" name="dtParstru">
			<parameter name="@action" value="Parstru"/>
			<parameter name="@Ind_Postotak" value="1"/>				
			<parameter name="@Uvjet" value="" if="$IndLokacija==1"/>
			<parameter name="@Uvjet" value="#srcParstru.text" else=""/>
			<parameter name="@PartneriId" value="$PartneriId"/>
		</data>	
		<data command="spDajPartnera" name="dtDajPartnera">	
			<parameter name="@id" value="#srcParstru" />	
			<parameter name="@partneriid" value="#srcPartner" />
		</data>		
		<data command="spDajPartnera" name="dtProvjeriPartnera">
			<parameter name="@ParstruId" value="$ParstruId"/>
			<parameter name="@PartneriId" value="$PartneriId"/>
			<parameter name="@Action" value="1"/>
		</data>		
		<data command="spTraziKKvalGla" name="dtKKvlaGla">
			<parameter name="@action" value="0"/>
			<parameter name="@Uvjet" value="#srcKKvalGla.text"/>
			<parameter name="@RobaId" value="$RobaId"/>
			<parameter name="@SkladisteId" value="$InitSkladisteId"/>
			<parameter name="@ImaStanje" value="0"/>
			<parameter name="@NoScan" value="1" if="#chkNoScan==True"/>
			<parameter name="@NoScan" value="0" else=""/>
			<parameter name="@Zamjena" value="#cmbBrojKontingenta" if="#chkNoScan==True"/>
			<parameter name="@Zamjena" value="" else=""/>			
		</data>	
		<data command="spTraziOsobe" name="dtKontakt">
			<parameter name="@Action" value="Osobe" />
			<parameter name="@PartneriId" value="$PartneriId" />
		</data>	
		<data command="spTraziRadniNalogNET" name="dtRadniNalog">
			<parameter name="@Uvjet" value="#srcRadniNalog.text" />
		</data>			
	</part>
</parts>