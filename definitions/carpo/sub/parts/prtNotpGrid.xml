	<part name="partDetaljGrid">
		<fields>
			<field name="Šifra" caption="Šifra" fontbold="true"/>
			<field name="RobaNaziv" caption="Naziv" fontbold="true" />
			<field name="JMNaziv" caption="JM" />
			<field name="Kolicina" caption="Zahtjevana količina" showtotalsum="false" format="n{global.$ProNotpDet_Br_Dec_Kolicina}"/>
			<field name="kolicinaizdana" caption="Isporučena količina" showtotalsum="false" formatstring="n3"/>
			<field name="NettoCijenaKn" caption="Cijena" showtotalsum="false" format="n{global.$ProNotpDet_Br_Dec}"/>
			<field name="ciznosneto" caption="Iznos" />
			<field name="Rabat" caption="Rabat %" showtotalsum="false"/>
			<field name="ciznosrabat" caption="Rabat" />
			<field name="Cassa" caption="Cassa %" showtotalsum="false"/>
			<field name="cIznosCassa" caption="Cassa" />
			<field name="CijenaBezPDV" caption="Cijena bez PDV-a" />
			<field name="cIznosOsnovica" caption="Iznos bez PDV-a" showtotalsum="true" fixed="right" />
			<field name="Porez" caption="Porez %" showtotalsum="false"/>
			<field name="cIznosPorez" caption="Porez" />
			<field name="BruttoCijenaKn" caption="Cijena s PDV-om" showtotalsum="false"/>
			<field name="IznosSPDV" caption="Iznos s PDV-om" showtotalsum="true" fixed="right"/>
			<field name="NettoCijenaDev" caption="Cijena (Dev)" showtotalsum="false"/>
			<field name="NettoVrijednostDev" caption="Iznos (Dev)" showtotalsum="false"/>
			<field name="nabcijena" caption="Nabavna cijena" if="global.$PokaziNCijenu==1" />
			<field name="NabVrijednost" caption="Nabavna vrijednost" if="global.$PokaziNCijenu==1" />
			<field name="pakkolicina" caption="Zahtjevana kol. (pak)" showtotalsum="false" formatstring="n3"/>
			<field name="pakkolicinaizdana" caption="Isporučena kol. (pak)" showtotalsum="false" formatstring="n3"/>
			<field name="JM2Naziv" caption="JM (pak)" />
			<field name="klmasterrobanaziv" caption="Klasa robe" />
			<field name="Zaliha" caption="Zaliha" />
			<field name="Zaliha2" caption="Ukupno u minusu" />
			<field name="RokPlacanja" caption="Rok plaćanja" />
			<field name="OrgShemaNaziv" caption="Org. jedinica" />
			<field name="PoslovniUgovor" caption="Poslovni ugovor" />
			<field name="Memo" caption="Napomena" />
			<field name="DokazanaKvaliteta" caption="Dokazana kvaliteta" />
			<field name="GGC" caption="Global Gap certificirano" />
			<!-- <field name="Faktura" caption="Faktura" />	 -->
		</fields>
	</part>
	<part name="partVezaniGrid">
		<tab caption="Vezani dokumenti" name="tabVezani">
			<grid name="grdDetaljVezani"  multiselect="true" dataname="Global.dtDetaljVezani" showgrouppanel="false" showautofilterrow="true" savelayout="true" bestfitonrefresh="true">
				<fields>
					<field name="userid" caption="Šifra" fontbold="true" fixed="left"/>
					<field name="RobaNaziv" caption="Naziv robe" fontbold="true" fixed="left"/>
					<field name="Ponuda" caption="Ponuda" width="2500"/>
					<!-- <field name="KolicinaPonuda" caption="Količina ponuda" width="1000"/> -->
					<field name="Faktura" caption="Faktura" width="2500"/>
					<!-- <field name="KolicinaFaktura" caption="Količina faktura" width="1000"/> -->
					<field name="Narudzba" caption="Narudžba kupca" width="2500"/>
					<!-- <field name="KolicinaNarudzba" caption="Količina narudžba" width="1000"/>		 -->
				</fields>
			</grid>
		</tab>
	</part>
	<part name="partDimenzijeGrid">
		<tab caption="Dimenzije" name="tabDimenzije">
			<grid name="grdDetaljDimenzije" keyfield="ProNotpGlaId" multiselect="true" showgrouppanel="false" showautofilterrow="true" savelayout="true" bestfitonrefresh="true" dataname="global.dtDetaljDimezije" >
				<!--<fields inherited="true">-->
				<fields>
					<field name="Sifra" caption="Šifra" fontbold="true" fixed="left" index="0" />
					<field name="Roba" caption="Naziv robe" fontbold="true" fixed="left" index="1" />
					<field name="Kolicina" caption="Količina" width="1000" index="2" />
				</fields>
			</grid>
		</tab>
	</part>
	<part name="partZalihaGrid">
		<tab caption="Zaliha" name="tabZaliha">
			<grid name="grdDetaljZaliha"  multiselect="true" showgrouppanel="false" showautofilterrow="true" savelayout="true" bestfitonrefresh="true"  dataname="global.dtDetaljZaliha" >
				<!-- <fields inherited="true"/> -->
				<fields>
					<field name="šifra" caption="Šifra" fixed="left"/>
					<field name="RobaNaziv" caption="Naziv robe" fixed="left"/>
					<field name="Stanje" caption="Stanje"/>
					<field name="Raspoloživo" caption="Raspoloživo"/>
					<field name="Rezervirano" caption="Rezervirano"/>
				</fields>
			</grid>
		</tab>
	</part>
</parts>