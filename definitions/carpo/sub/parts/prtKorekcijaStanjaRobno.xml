<!--22.12.2021. AA savevalue cmbSkladiste, isključila punjenje org sheme sa skladišta HD 68914-->
<!--23.12.2020. AA vrstadok allownull=false HD 61331-->
<parts>
  <part name="prtUnosMaster">
    <group cols="2" rows="4">
      <item col="1" row="1" caption="Broj:">
        <textedit name="txtBroj"/>
      </item>
      <item col="1" row="2" caption="Skladište:">
        <comboedit name="cmbSkladiste" dataname="~dtSkladiste" valuefield="SkladisteId" displayfield="OznakaOpis" required="true" savevalue="app">
          <event type="leave">
            <action type="datarun reader" value="~dtIniSkladiste"/>
            <!-- <action type="control value" value="#cmbOrgShema"> -->
              <!-- <parameter value="~dtIniSkladiste.@OrgShemaId"/> -->
            <!-- </action> -->
          </event>
        </comboedit>
      </item>
      <item col="1" row="3" caption="Odgovorna osoba:">
        <comboedit name="cmbOdgOsoba" dataname="~dtOsoba" valuefield="OsobeId" displayfield="Naziv"/>
      </item>
      <item col="2" row="1" caption="Vrsta dok:">
        <comboedit name="cmbVrstaDok" dataname="~dtVrstaDok" valuefield="VrstaDokId" displayfield="Opis" required="true" allownull="false"/>
      </item>
      <item col="2" row="2" caption="Org. Shema:">
        <comboedit name="cmbOrgShema" dataname="~dtOrgShema"  valuefield="OrgShemaId" displayfield="Naziv"/>
      </item>
      <item col="2" row="3" caption="Opis:">
        <textedit name="txtOpis"/>
      </item>
      <item col="2" row="4" caption="Datum:">
        <dateedit name="datDatum" required="true"/>
      </item>
    </group>
  </part>
</parts>