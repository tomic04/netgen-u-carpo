<parts>
	<part name="partMetode">
		<method name="funDmsAdd" dll="DmsManagerV1" class="DmsManagerV1.Start" method="AddDocuments" />
		<method name="funDmsOpen" dll="DmsManagerV1" class="DmsManagerV1.Start" method="OpenDocument" />
		<method name="funDmsSave" dll="DmsManagerV1" class="DmsManagerV1.Start" method="SaveDocuments" />	
	</part>
	<part name="partInit">
		<action type="datarun reader" value="Global.dtDrvoPozicija" />			
		<action type="datarun reader" value="Global.dtVrstaProm" />
		<action type="variable value">
			<parameter name="Global.VrstaPromId" value="~dtVrstaProm.@vrstapromid" type="int" />
			<parameter name="Global.IndStatusOdustani" value="0" type="int" />
			<parameter name="Global.VrstaPromNaziv" value="~dtVrstaProm.@opis" type="string" />
			<parameter name="Global.VrstaPromSifra" value="~dtVrstaProm.@Sifra" type="string" />		
			<parameter name="Global.tablicaGla" value="SktPrometGla" type="string"/>
			<parameter name="Global.tablicaDet" value="SktPrometDet" type="string"/>
		</action>	
		<action type="variable value" value="global.DokId">
			<parameter value="0" type="int"/>
		</action>
		<action type="variable value" value="global.IndIzmjena">
			<parameter value="0" type="int"/>
		</action>
		<action type="datarun reader" value="Global.dtPubvars" />
		<action type="variable value">
			<parameter name="Global.KolFaktor" value="~dtPubvars.@KolFaktor" type="int" />
			<parameter name="Global.VisibleOsoba" value="~dtPubvars.@VisibleOsoba" type="string" />
			<parameter name="Global.VisibleGlaOsoba" value="~dtPubvars.@VisibleGlaOsoba" type="string" />
			<parameter name="Global.VisibleSmjestaj" value="~dtPubvars.@VisibleSmjestaj" type="string" />
			<parameter name="Global.IndKolUlazIzlaz" value="~dtPubvars.@IndKolUlazIzlaz" type="string" />
			<parameter name="Global.VisibleOrgShema" value="~dtPubvars.@VisibleOrgShema" type="string" />
			<parameter name="Global.VisibleProdCijena" value="~dtPubvars.@VisibleProdCijena" type="string" />
			<parameter name="Global.IndInventar" value="~dtPubvars.@IndInventar" type="string" />
			<parameter name="Global.IndDimenzije" value="~dtPubvars.@IndDimenzije" type="string" />
			<parameter name="Global.PokaziNC" value="~dtPubVars.@PokaziNC" type="int" />
			<parameter name="Global.DrvoFilter" value="~dtPubVars.@DrvoFilter" type="int" />
			<parameter name="Global.KopirajDok" value="~dtPubVars.@KopirajDok" type="string"/>
			<parameter name="Global.StornirajDok" value="~dtPubVars.@StornirajDok" type="string"/>
			<parameter name="Global.ProvediDok" value="~dtPubVars.@ProvediDok" type="string"/>
			<parameter name="Global.WMSDok" value="~dtPubVars.@WMSDok" type="string"/>
			<parameter name="Global.ObrisiDok" value="~dtPubVars.@ObrisiDok" type="string"/>
			<parameter name="Global.UnesiDok" value="~dtPubVars.@UnesiDok" type="string"/>			
			<parameter name="Global.RekapitulacijaDok" value="~dtPubVars.@RekapitulacijaDok" type="string"/>			
			<parameter name="Global.IndDonos" value="~dtPubVars.@IndDonos" type="string"/>
			<parameter name="Global.VisibleNapomenaNum" value="~dtPubvars.@VisibleNapomenaNum" type="int" />
			<parameter name="Global.VisibleGlaVozac" value="~dtPubvars.@VisibleGlaVozac" type="string" />
			<parameter name="Global.VisibleGlaPartner" value="~dtPubvars.@VisibleGlaPartner" type="string" />
			<parameter name="Global.VisibleGlaParStru" value="~dtPubvars.@VisibleGlaParStru" type="string" />
			<parameter name="Global.VisibleGlaKontakt" value="~dtPubvars.@VisibleGlaKontakt" type="string" />
			<parameter name="Global.IndKolSmijeUMinus" value="~dtPubvars.@IndKolSmijeUMinus" type="string" />
			<parameter name="Global.VisibleRadniNalog" value="~dtPubvars.@VisibleRadniNalog" type="string" />
			<parameter name="Global.VisibleSkladisteUlaza" value="~dtPubvars.@VisibleSkladisteUlaza" type="string" />
			<parameter name="Global.SkladisteCaption" value="~dtPubvars.@SkladisteCaption" type="string" />
			<parameter name="Global.SkladisteUlazaCaption" value="~dtPubvars.@SkladisteUlazaCaption" type="string" />
			<parameter name="Global.SktRNFors" value="~dtPubvars.@SktRNFors" type="int" />
			<parameter name="Global.VisibleNaljepnica" value="~dtPubvars.@VisibleNaljepnica" type="string" />
		</action>			
	</part>	
	<part name="partLoad">	
	</part>	
	<part name="partShown">
		<action type="control visible" value="#btnKopiraj" if="Global.$KopirajDok==False">
			<parameter value="false"/>
		</action>
		<action type="control visible" value="#btnStorniraj" if="Global.$StornirajDok==False">
			<parameter value="false"/>
		</action>
		<action type="control visible" value="#btnProvedi" if="Global.$ProvediDok==False">
			<parameter value="false"/>
		</action>
		<action type="control visible" value="#btnRekapitulacija" if="Global.$RekapitulacijaDok==False">
			<parameter value="false"/>
		</action>	
		<action type="control visible" value="#btnWMS" if="Global.$WMSDok==False">
			<parameter value="false"/>
		</action>
		<action type="control visible" value="#btnUnesi" if="Global.$ObrisiDok==False">
			<parameter value="false"/>
		</action>
		<action type="control visible" value="#btnObrisi" if="Global.$UnesiDok==False">
			<parameter value="false"/>
		</action>		
		<action type="control value" value="#filter" if="Global.$DrvoFilter==1">
			<parameter value="Skladište"/>
		</action>
		<action type="control value" value="#filter" if="Global.$DrvoFilter==2">
			<parameter value="Statusi"/>
		</action>
		<action type="control value" value="#filter" if="Global.$DrvoFilter==3">
			<parameter value="Vremenska podjela bez skladišta"/>
		</action>		
		<action type="control focus" value="#tree">
			<parameter value="~dtDrvoPozicija.@Poz" type="string"/>
		</action> 
		<action type="formcaption" value="Global.$VrstaPromNaziv"/>	
	</part>	
</parts>