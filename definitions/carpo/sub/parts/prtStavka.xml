<parts>
  <part name="prtStavka">
    <action type="datarun scalar" value="~dtGetCijena">
      <parameter name="Cijena"/>
    </action>
    <action type="control value" value="#txtCijena">
      <parameter value="$Cijena"/>
    </action>
    <action type="datarun reader" value="~dtGetMoguciRokIsporuke"/>
    <action type="control value" value="#txtMoguciRok">
      <parameter value="{~dtGetMoguciRokIsporuke.@Datum::dd.MM.yyyy.} {~dtGetMoguciRokIsporuke.@BrojDana}"/>
    </action>
  </part>
  <!--<part name="prtReset">
    <action type="control value" value=""
  </part>-->
</parts>