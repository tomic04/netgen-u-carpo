				<column position="1" size="800"/>
				<column position="2" size="70"/>
			</columnsdefinition>
			<rowsdefinition>
				<row position="1" size="40"/>
			</rowsdefinition>
			<item col="1" row="1" rowspan="2">
				<grid caption="Popis privitaka" autopopulate="false" name="grdPrivitci" dataname="~dtPrivitci" showgrouppanel="false" showautofilterrow="false" key="DokumentId" bestfitonrefresh="true" savelayout="true">
					<event type="focusedrowchanged">
						<action type="control attribute" value="#picPrivitak">
							<parameter name="dbpdf" value="#grdPrivitci.@DokBLOB"/>
						</action>
					</event>							
					<fields inherited="true">
						<field name="DokBLOB" visible="false"/>
					</fields>
				</grid>
			</item>	
			<item col="2" row="1">
				<button name="btnDodajPrivitak" image="add" enabled="false">

				</button>
			</item>
		</group>
	</part>
</parts>