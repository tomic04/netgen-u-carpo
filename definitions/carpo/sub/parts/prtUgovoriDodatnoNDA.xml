<parts>
  <part name="prtUgovoriDodatnoNDAform">
    <group cols="2" rows="3" groupbordervisible="false">
      <group padding="4" groupbordervisible="false" cols="2" rows="1" col="1" row="1">
        <columnsdefinition>
          <column size="80%" position="1" />
          <column size="100" position="2" />
        </columnsdefinition>
        <item caption="Naslov nda:" col="1" row="1" highlight="false" fontbold="true">
          <textedit name="txtNaslov" datavalue="#dtDetaljStavke.@Naslov" nulltext="&lt;naslov publikacije na engleskom&gt;" function="Naslov" required="false">
            <event type="valuechanged">
              <action type="control disable" value="#btnPoveziRoba" if="#txtNaslov==null" />
              <action type="control enable" value="#btnPoveziRoba" else="" />
            </event>
          </textedit>
        </item>
        <item caption="" col="2" row="1">
          <button name="btnPoveziRoba" image="" caption="Poveži s robom">
            <event type="click">
              <action type="form open" value="frmRobaPronadi">
                <parameter name="PosUgovoriglaId" value="$PosUgovoriglaId" />
                <parameter name="Izmjena" value="$Izmjena" />
                <parameter name="PosUgovoriDetId" value="$PosUgovoridetId" />
              </action>
            </event>
          </button>
        </item>
      </group>
      <group padding="4" groupbordervisible="false" cols="2" rows="3" col="1" row="2">
        <columnsdefinition>
          <column size="50%" position="1" />
          <column size="50%" position="2" />
        </columnsdefinition>
        <item caption="Autorsko pravo NDA(%):" col="1" row="1">
          <textedit name="txtAutorsko" datavalue="#dtDetaljStavke.@AutorskoPravo" function="Autorsko" format="n2" />
        </item>
        <item caption="Valuta:" col="2" row="1" colspan="1">
          <comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="#dtDetaljStavke.@ValuteId" dataname="global.dtValuta" allownull="true" function="Valuta" />
        </item>
        <item caption="Uplaćeni avans:" col="1" row="2">
          <textedit name="txtAvansUplaceni" datavalue="#dtDetaljStavke.@AvansUplaceni" format="n2" function="AvansUplaceni" />
        </item>
        <item caption="Uplaćeni avans godišnji:" col="2" row="2">
          <textedit name="txtAvansGodisnji" datavalue="#dtDetaljStavke.@AvansUplaceniGodisnji" format="n2" function="AvansGodisnji" />
        </item>
      </group>
    </group>
  </part>
</parts>
  


  			