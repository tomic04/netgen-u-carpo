<parts>
	<part name="prtServisOsnovno">
		<item row="1" col="1" caption="Broj:">
			<textedit name="txtBroj" readonly="true" datavalue="~dtLoad.@Broj" />
		</item>
		<item row="1" col="3" caption="Status:">
			<textedit name="txtstatus" readonly="true" datavalue="~dtLoad.@status" />
		</item>
		<group row="2" col="1" rows="9" cols="1" rowspan="8" groupbordervisible="false">
			<item row="1" col="1" caption="Datum:">
				<dateedit name="dateDatum" value="now" required="true" datavalue="~dtLoad.@DatumDok">
					<event type="valuechanged">
						<action type="variable value" value="$DatumDokProm" if="$DatumDok!=#dateDatum">
							<parameter value="true" />
						</action>
						<action type="variable value" value="$DatumDokProm" else="">
							<parameter value="false" />
						</action>
					</event>
				</dateedit>
			</item>
			<item row="2" col="1" caption="Model:">
				<comboedit name="cmbModel" dataname="global.~dtModel" valuefield="ServisId" displayfield="Naziv" required="true" datavalue="~dtLoad.@ServisId" savevalue="app">
					<event type="valuechanged">
						<action type="datarun reader" value="global.~dtParametriModela" />
						<action type="variable value">
							<parameter name="KlMasterRobaId" value="global.~dtParametriModela.@KlMasterRobaId" />
							<parameter name="InterniInd" value="global.~dtParametriModela.@InterniInd" />
							<parameter name="Model" value="global.~dtParametriModela.@Model" />
							<parameter name="OsobeMP" value="global.~dtParametriModela.@OsobeMP" />
							<parameter name="OrgShemaReal" value="global.~dtParametriModela.@OrgShemaReal" />
							<parameter name="TrosOrgShemaId" value="global.~dtParametriModela.@TrosOrgShemaId" />
							<parameter name="RealOrgShemaId" value="global.~dtParametriModela.@RealOrgShemaId" />
							<parameter name="KlasaUslugeId" value="global.~dtParametriModela.@KlasaUslugeId" />
							<parameter name="PartneriInd" value="global.~dtParametriModela.@PartneriInd" />
						</action>
						<action type="variable value">
							<parameter name="global.$InterniIndOLD2" value="global.~dtParametriModela.@InterniInd" />
						</action>
						<action if="$TrosOperaterId==@@OperateriId">
							<action type="control value" value="#cmbOrgShema">
								<parameter value="$TrosOrgShemaId" />
							</action>
						</action>
						<action else="">
							<action type="control value" value="#cmbOrgShema">
								<parameter value="null" />
							</action>
						</action>
						<action if="$InterniInd==true">
							<action type="control value" value="#rdoPartner">
								<parameter value="true" />
							</action>
							<action type="control value" value="#srcPartner">
								<parameter value="global.$NasId" text="global.$NasNaziv" />
							</action>
						</action>
						<action if="$InterniInd==false&amp;&amp;global.$InterniIndOLD==true">
							<action type="control value" value="#srcPartner">
								<parameter value="" text="" />
							</action>
						</action>
						<action if="$InterniInd==false&amp;&amp;$PartneriInd==True">
							<action type="control value" value="#srcPartner">
								<parameter value="global.~dtVoziloInfo.@PartneriId" text="global.~dtVoziloInfo.@PartneriNaziv" />
							</action>
						</action>
						<action if="#cmbModel==null">
							<action type="control value" value="#srcPartner">
								<parameter value="" text="" />
							</action>
							<action type="control attribute" value="#srcUsluga">
								<parameter name="required" value="false" />
							</action>
						</action>
						<action if="$Model!=U||#cmbModel==null">
							<action type="control visible" value="#srcUsluga">
								<parameter value="false" />
							</action>
							<action type="control value" value="#srcUsluga">
								<parameter value="null" />
							</action>
							<action type="control attribute" value="#srcUsluga">
								<parameter name="required" value="false" />
							</action>
						</action>
						<action if="$Model==U||#cmbModel.@model==U">
							<action type="control visible" value="#srcUsluga">
								<parameter value="true" />
							</action>
							<action type="control value" value="#srcUsluga">
								<parameter value="null" />
							</action>
							<action type="control attribute" value="#srcUsluga">
								<parameter name="required" value="true" />
							</action>
						</action>
						<action if="$OsobeMP==0">
							<action type="control disable" value="#srcOsoba" />
							<action type="control value" value="#srcOsoba">
								<parameter value="null" />
							</action>
						</action>
						<action if="$OrgShemaReal==true">
							<action type="control visible" value="#cmbOrgShemaReal">
								<parameter value="true" />
							</action>
							<action type="control attribute" value="#cmbOrgShemaReal">
								<parameter name="required" value="true" />
							</action>
							<action if="$RealOperaterId==@@OperateriId">
								<action type="control value" value="#cmbOrgShemaReal">
									<parameter value="$RealOrgShemaId" />
								</action>
							</action>
							<action else="">
								<action type="control value" value="#cmbOrgShemaReal">
									<parameter value="null" />
								</action>
							</action>
						</action>
						<action else="">
							<action type="control visible" value="#cmbOrgShemaReal">
								<parameter value="false" />
							</action>
							<action type="control attribute" value="#cmbOrgShemaReal">
								<parameter name="required" value="false" />
							</action>
							<action type="control value" value="#cmbOrgShemaReal">
								<parameter value="$TrosOrgShemaId" />
							</action>
						</action>
						<action type="variable value">
							<parameter name="global.$InterniIndOLD" value="global.~dtParametriModela.@InterniInd" />
						</action>
					</event>
				</comboedit>
			</item>
			<item row="3" col="1" caption="Vrsta RN:">
				<comboedit name="cmbVrstaRN" dataname="global.~dtVrstaRN" valuefield="ServisVrsteRNId" displayfield="Naziv" required="true" datavalue="~dtLoad.@ServisVrsteRNId" savevalue="app" />
			</item>
			<item row="4" col="1" caption="Način obračuna:">
				<comboedit name="cmbNacinObracuna" dataname="global.~dtNacinObracuna" valuefield="ServisNacinObrId" displayfield="Naziv" required="true" datavalue="~dtLoad.@ServisNacinObrId" savevalue="app" />
			</item>
			<item row="5" col="3" caption="Odgovorna osoba:">
				<searchedit name="srcOdgovornaOsoba" dataname="global.~dtOdgovornaOsoba" fieldvalue="OsobeId" fieldtext="Naziv" required="true" datavalue="~dtLoad.@OdgovornaOsobaId" datatext="~dtLoad.@OdgovornaOsoba" savevalue="app" />
			</item>
			<item row="6" col="1" caption="Izvršitelj:">
				<searchedit name="srcIzvrsitelj" dataname="global.~dtIzvrsitelj" fieldvalue="HRKadroviId" fieldtext="Izvrsitelj" datavalue="~dtLoad.@HRKadroviId" datatext="~dtLoad.@Izvrsitelj" value="null" />
			</item>
			<item row="7" col="1" caption="Datum završetka:">
				<dateedit name="dateDatumZavrsetka" value="now" required="false" datavalue="~dtLoad.@PredZavrsetakDatum" />
			</item>
		</group>
		<group row="8" col="1" colspan="3" cols="3" rows="1" groupbordervisible="false">
			<columnsdefinition>
				<column position="1" size="47%" />
				<column position="2" size="6%" />
				<column position="3" size="47%" />
			</columnsdefinition>
			<item row="1" col="1" caption="Ponuda:">
				<searchedit name="srcPonuda" dataname="global.~dtPonuda" fieldvalue="ProponglaId" fieldtext="BrojPonude" datavalue="~dtLoad.@ProPonGlaId" datatext="~dtLoad.@BrojPonude" visible="true" required="false">
					<event type="valuechanged">
						<action type="datarun reader" value="global.~dtPonudaInfo" />
						<action type="control value" value="#txtVrijednostPonude">
							<parameter value="global.~dtPonudaInfo.@VrijednostPonude" />
						</action>
					</event>
				</searchedit>
			</item>
			<!--
			<item row="1" col="2" caption="">
			</item>
			-->
			<item row="1" col="3" caption="Vrijednost ponude:">
				<textedit name="txtVrijednostPonude" readonly="true" type="decimal" format="n2" />
			</item>
		</group>
		<item row="9" col="1" caption="Usluga za fakturiranje:">
			<searchedit name="srcUsluga" dataname="global.~dtUslugaIzKlase" valuefield="RobaId" displayfield="Naziv" datavalue="~dtLoad.@UslugaId" datatext="~dtLoad.@UslugaNaziv" />
		</item>
		<item row="2" col="2" highlight="false">
			<radioedit name="rdoPartner">
				<event type="checkedchanged">
					<action if="$UnosNovi==0">
						<action type="control enable" value="#srcPartner, #srcLokacija, #srcKontakt" if="parent.#grdMaster.@Zakljuceno!=1||parent.#grdMaster.@Smije!=0" />
					</action>
					<action else="">
						<action type="control enable" value="#srcPartner, #srcLokacija, #srcKontakt" if="$TrenutniStatus!=global.$MaxStatus||$TrenutniStatus!=global.$NoNextStatus" />
					</action>
					<action type="control attribute" value="#srcPartner, #srcLokacija">
						<parameter name="required" value="true" />
					</action>
					<action type="control disable" value="#srcOsoba" />
					<action type="control value" value="#srcOsoba">
						<parameter value="null" />
					</action>
				</event>
			</radioedit>
		</item>
		<group row="2" col="3" rows="3" cols="1" rowspan="3" caption="Partner">
			<item row="1" col="1" caption="Naziv:">
				<searchedit netgenfields="true" name="srcPartner" dataname="global.~dtPartneri" fieldtext="NazivId" fieldvalue="PartneriId" required="true" datavalue="~dtLoad.@PartneriId" datatext="~dtLoad.@Partner">
					<event type="valuechanged" raiseonload="false">
						<action type="datarun reader" value="global.~dtPop" />
						<action type="control value" value="#srcLokacija">
							<parameter value="global.~dtPop.@ParStruId" text="global.~dtPop.@Naziv" />
						</action>
						<!-- <action type="control populate" value="#srcKontakt"/> -->
						<action type="variable value" value="$PartneriProm" if="$PartneriId!=#srcPartner">
							<parameter value="true" />
						</action>
						<action type="variable value" value="$PartneriProm" else="">
							<parameter value="false" />
						</action>
						<!-- <action type="control value" value="#srcPonuda" if="$PartneriProm==true"> -->
						<action type="control value" value="#srcPonuda">
							<parameter value="null" />
						</action>
					</event>
				</searchedit>
			</item>
			<item row="2" col="1" caption="Lokacija:">
				<searchedit name="srcLokacija" dataname="global.~dtLokacija" fieldtext="Naziv" fieldvalue="ParStruId" required="true" datavalue="~dtLoad.@ParStruId" datatext="~dtLoad.@Lokacija">
					<event type="valuechanged" raiseonload="false">
						<action type="datarun reader" value="global.~dtMjestoPotrosnje" />
						<action type="variable value" value="$ParStruProm" if="$ParStruId!=#srcLokacija">
							<parameter value="true" />
						</action>
						<action type="variable value" value="$ParStruProm" else="">
							<parameter value="false" />
						</action>
						<action type="control value" value="#txtMjestoPotrosnje" if="$Edit==1">
							<parameter value="global.~dtMjestoPotrosnje.@MjestoPotrošnje" />
						</action>
						<action type="control value" value="#srcBrojilo" if="$Edit==1">
							<parameter value="null" />
						</action>
					</event>
				</searchedit>
			</item>
			<item row="3" col="1" caption="Kontakt:">
				<searchedit name="srcKontakt" dataname="global.~dtPartnerOsoba" fieldtext="Naziv" fieldvalue="OsobeId" datavalue="~dtLoad.@PartneriOsobeId" datatext="~dtLoad.@PartnerOsoba" />
			</item>
		</group>
		<item row="5" col="2" highlight="false">
			<radioedit name="rdoOsoba">
				<event type="checkedchanged">
					<action if="$UnosNovi==0">
						<action type="control enable" value="#srcOsoba" if="parent.#grdMaster.@Zakljuceno!=1||parent.#grdMaster.@Smije!=0" />
					</action>
					<action else="">
						<action type="control enable" value="#srcOsoba" />
					</action>
					<action type="control disable" value="#srcPartner, #srcLokacija, #srcKontakt" />
					<action type="control attribute" value="#srcPartner, #srcLokacija">
						<parameter name="required" value="false" />
					</action>
					<action type="control value" value="#srcPartner, #srcLokacija, #srcKontakt">
						<parameter value="null" />
					</action>
				</event>
			</radioedit>
		</item>
		<group row="5" col="3" rows="1" cols="1" rowspan="1" caption="Osoba">
			<item row="1" col="1" caption="Ime:">
				<searchedit name="srcOsoba" dataname="global.~dtOsoba" fieldtext="Naziv" fieldvalue="OsobeId" datavalue="~dtLoad.@OsobeId" datatext="~dtLoad.@Osoba" />
			</item>
		</group>
		<item row="6" col="3" caption="OrgShema:">
			<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" required="true" datavalue="~dtLoad.@TrosOrgShemaId" savevalue="app">
				<event type="valuechanged">
					<action if="$OrgShemaReal==true">
						<action type="control value" value="#cmbOrgShemaReal">
							<parameter value="#cmbOrgShema" />
						</action>
					</action>
					<action type="variable value" value="$TrosOrgShemaProm" if="$TrosOrgShemaId!=#cmbOrgShema">
						<parameter value="true" />
					</action>
					<action type="variable value" value="$TrosOrgShemaProm" else="">
						<parameter value="false" />
					</action>
				</event>
			</combotreeedit>
		</item>
		<item row="7" col="3" caption="OrgShema (real.):">
			<combotreeedit name="cmbOrgShemaReal" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" required="true" datavalue="~dtLoad.@RealOrgShemaId" visible="false" savevalue="app" />
		</item>
		<group row="10" col="1" rows="2" cols="2" colspan="3" caption="Podaci o stroju">
			<columnsdefinition>
				<column position="1" size="50%" />
				<column position="2" size="50%" />
			</columnsdefinition>
			<item row="1" col="1" caption="Stroj:">
				<searchedit name="srcStroj" dataname="global.~dtTraziVozilo" fieldvalue="VoziloId" fieldtext="Stroj" datavalue="~dtLoad.@VoziloId" datatext="~dtLoad.@Vozilo">
					<event type="valuechanged">
						<action type="variable value" value="global.$VoziloId">
							<parameter value="#srcStroj" />
						</action>
						<action type="control caption" value="#btnTemeljniPodaciStroja" if="global.$VoziloId==null">
							<parameter value="Unesi stroj" />
						</action>
						<action type="control caption" value="#btnTemeljniPodaciStroja" else="">
							<parameter value="Izmijeni stroj" />
						</action>
						<action if="global.$Broj!=null">
							<action type="control enable" value="#txtStanjeBrojaca, #txtStanjeGoriva, #txtMjenjac, #txtVozac, #txtZadnjiServis, #memOpaska, #memOstecenjaNaStroju, #txtZaduzeniVozac" if="global.$VoziloId!=null||global.$NewVoziloId!=null" />
							<action type="control disable" value="#txtStanjeBrojaca, #txtStanjeGoriva, #txtMjenjac, #txtVozac, #txtZadnjiServis, #memOpaska, #memOstecenjaNaStroju,#txtZaduzeniVozac" elseif="global.$VoziloId==null||global.$NewVoziloId==null" />
							<action type="control value" value="#txtStanjeBrojaca, #txtStanjeGoriva, #txtMjenjac, #txtVozac, #txtZadnjiServis, #memOpaska, #memOstecenjaNaStroju" if="$VoziloDetaljId==null">
								<parameter value=" " />
							</action>
						</action>
						<action type="datarun reader" value="global.~dtVoziloInfo" />
						<action type="control value" value="#txtSerijskiBroj">
							<parameter value="global.~dtVoziloInfo.@SerijskiBroj" />
						</action>
						<action type="control value" value="#txtBrojReg">
							<parameter value="global.~dtVoziloInfo.@RegOznaka" />
						</action>
						<action type="control value" value="#txtInvBroj">
							<parameter value="global.~dtVoziloInfo.@InventurniBroj" />
						</action>
						<action type="control value" value="#txtZaduzeniVozac" if="$Edit==1">
							<parameter value="global.~dtVoziloInfo.@OsobaNaziv" />
						</action>
						<!--
						<action if="$InterniInd==true">
						<action type="control value" value="#srcPartner">
						<parameter value="global.$NasId" text="global.$NasNaziv" />
						</action>
						</action>
						-->
						<action if="$InterniInd==false&amp;&amp;$PartneriInd==True">
							<action type="control value" value="#srcPartner">
								<parameter value="global.~dtVoziloInfo.@PartneriId" text="global.~dtVoziloInfo.@PartneriNaziv" />
							</action>
						</action>
						<!--
						<action else="">
						<action type="control value" value="#srcPartner">
						<parameter value="global.~dtVoziloInfo.@partneriid" text="global.~dtVoziloInfo.@partnerinaziv" />
						</action>
						</action>
						-->
						<!--
						<action type="control value" value="#srcPartner" if="$InterniInd!=true">
						<parameter value="global.~dtVoziloInfo.@partneriid" text="global.~dtVoziloInfo.@partnerinaziv" />
						</action>
						<action type="control value" value="#srcPartner" else="">
						<parameter value="global.$NasId" text="global.$NasNaziv" />
						</action>
						<action if="$InterniInd==true">
						<action type="control value" value="#srcPartner">
						<parameter value="global.$NasId" text="global.$NasNaziv" />
						</action>
						</action>
						-->
					</event>
				</searchedit>
			</item>
			<item row="2" col="1" caption="Serijski broj:">
				<textedit name="txtSerijskiBroj" readonly="true" />
			</item>
			<item row="1" col="2" caption="Broj registracije:">
				<textedit name="txtBrojReg" readonly="true" />
			</item>
			<item row="2" col="2" caption="Inventurni broj:">
				<textedit name="txtInvBroj" readonly="true" />
			</item>
		</group>
		<item row="11" col="1" colspan="3" caption="Opis:">
			<memoedit name="memOpis" maxlength="$maxlengthOpis" datavalue="~dtLoad.@RobaOpis" />
		</item>
	</part>
</parts>
