<parts>
  <part name="prtZahtjev">
    <group col="1" row="1" cols="2" rows="4" bordervisible="false">
      <item col="1" row="1"  caption="Broj:" highlight="false">
        <textedit name="txtBroj" datavalue="~dtGet.@Broj" fontbold="true" nulltext="&lt;novi dokument&gt;"/>
      </item>
      <item col="2" row="1" caption="Datum:" highlight="false">
        <dateedit name="datDatum" value="now" required="true" datavalue="~dtGet.@DatumDok" function="datum"></dateedit>
      </item>
      <!--<item col="1" row="2" colspan="2" caption="Vrsta dokumenta:" highlight="false">
        <comboedit name="cmbVrstaDok" valuefield="VrstaDokId" displayfield="Opis" datavalue="~dtGet.@VrstaDokId" dataname="Global.dtVrstaDokumenta"  required="true"></comboedit>
      </item>-->
      <item col="1" row="2" colspan="2"  caption="Organizacijska jedinica:" highlight="false">
        <combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" datavalue="~dtGet.@OrgShemaId" dataname="Global.dtOrgShema" required="true"/>
      </item>
      <item col="1" row="3" colspan="2"  caption="Odgovorna osoba:" highlight="false">
        <comboedit name="cmbOdgOsoba" valuefield="OsobeId" displayfield="Osoba" datavalue="~dtGet.@OsobeId" dataname="Global.dtOdgovornaOsoba" required="true"/>
      </item>
      <item col="1" row="4" colspan="2"  caption="Opis:" highlight="false">
        <memoedit name="txtOpis" maxlength="20" datavalue="~dtGet.@Opis" ></memoedit>
      </item>
    </group>
  </part>
</parts>