<parts>
	<part name="partKontingentiSkeniraj">
		<layout textposition="left">
			<group cols="1" rows="3" >
				<item caption="Kontingent / IMEI:" col="1" row="1">
					<searchedit name="srcKKvalGla" savelayout="true" required="true" dataname="Global.dtKKvlaGla" fieldtext="Broj" fieldvalue="kkvalglaid"> 
						<event type="keydown" value="13">
							<action if="#srcKKvalGla&gt;0">
								<action type="datarun scalar" value="~dtKKvalGlaUnos"/>
								<action type="datarun reader" value="Global.dtBrKKvalGlaHelper"/>
								<action if="#chkNoScan==True">	
									<action type="variable value" value="IndNoScanCombo">
										<parameter value="0" type="int"/>
									</action>								
									<action type="datarun reader" value="~dtBrojKontingenta"/>
									<action type="control value" value="#txtBrojStavaka">
										<parameter value="~dtBrojKontingenta.@BrojStavaka"/>
									</action>
								</action>								
								<action type="control populate" value="parent.#grdKontingenti" />
								<action type="control focus" value="parent.#grdKontingenti">
									<parameter value="#srcKKvalGla" />
								</action>								
								<action type="control value" value="parent.#lblNezatvoreno">
									<parameter value="~dtBrKKvalGlaHelper.@KolicinaZatvoreno" />
								</action>
								<action type="control attribute" value="parent.#lblNezatvoreno">
									<parameter name="fontcolor" value="black" if="~dtBrKKvalGlaHelper.@KolicinaZatvoreno==0"></parameter>
									<parameter name="fontcolor" value="red" else=""></parameter>
								</action>							
								<action type="control value" value="#srcKKvalGla">
									<parameter value=""/>
								</action>													
								<action type="control focus" value="#srcKKvalGla"/>
							</action>
						</event>					
					</searchedit>
				</item>
				<item caption="Povrat" col="1" row="2">
					<checkedit name="chkPovrat"/>                                                                                         
				</item>
				<group cols="3" rows="1" row="3" col="1" groupbordervisible="False">
					<item caption="No scan" col="1" row="1">
						<checkedit name="chkNoScan">                                                                                         
							<event type="checkedchanged">
								<action type="variable value" value="IndNoScanCombo">
									<parameter value="1" type="int"/>
								</action>
								<action type="control populate" value="#cmbBrojKontingenta" if="#chkNoScan==true"/>
								<action type="control enable" value="#cmbBrojKontingenta" if="#chkNoScan==true"/>
								<action type="control disable" value="#cmbBrojKontingenta" if="#chkNoScan==false"/>
								<action type="control value" value="#txtBrojStavaka">
									<parameter value="#cmbBrojKontingenta.@BrojStavaka"/>
								</action>								
							</event>
						</checkedit>	
					</item>
					<item caption="" row="1" col="2" textposition="top">
						<comboedit name="cmbBrojKontingenta" enabled="false" valuefield="Kontingent" displayfield="Kontingent" datavalue="" dataname="~dtBrojKontingenta" allownull="false">
							<event type="valuechanged">
								<action type="control value" value="#txtBrojStavaka">
									<parameter value="#cmbBrojKontingenta.@BrojStavaka"/>
								</action>							
							</event>
						</comboedit>
					</item>
					<item caption="" row="1" col="3" textposition="top">
						<textedit name="txtBrojStavaka" enabled="false"/>
					</item>					
				</group>				
			</group>
		</layout>	
		<panelbuttons>
			<buttons>
				<button name="btnZatvori" caption="&amp;ZATVORI" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spSklad_KKvalGlaHelper_Azur" name="dtKKvalGlaUnos">
				<parameter name="@GlaId" value="global.$DokId"/>	
				<parameter name="@OperateriId" value="@@operateriid"/>	
				<parameter name="@kkvalglaid" value="#srcKKvalGla"/>	
				<parameter name="@Kolicina" value="-1" if="#chkPovrat==True"/>	
				<parameter name="@Kolicina" value="1" else=""/>	
				<parameter name="@KolicinaDet" value="$KolicinaDet"/>	
				<parameter name="@Tablica" value="global.$tablicaDet" />	
				<parameter name="@IndIzmjena" value="0" else=""/>
				<parameter name="@SkladisteId" value="$InitSkladisteId"/>
			</data>
			<data command="spSklad_KKvalGlaHelper_NoScan" name="dtBrojKontingenta">
				<parameter name="@OperateriId" value="@@operateriid"/>	
				<parameter name="@RobaId" value="$RobaId"/>
				<parameter name="@SkladisteId" value="$InitSkladisteId"/>
				<parameter name="@Broj" value="#cmbBrojKontingenta" if="$IndNoScanCombo==0"/>
				<parameter name="@Broj" value="" else=""/>
			</data>			
		</datalist>
	</part>
</parts>