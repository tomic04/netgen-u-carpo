<parts>
	<part name="prtServisZahtjev">
		<group row="1" col="1" rows="6" cols="1" caption="Zahtjev" groupbordervisible="true">
			<item row="1" col="1" caption="Vrsta zahtjeva:">
				<comboedit name="cmbZahtjev" dataname="global.~dtVrstaZahtjeva" valuefield="ServisVrstaZahtjevaId" displayfield="Naziv" datavalue="~dtLoad.@ServisVrstaZahtjevaId" />
			</item>
			<item row="2" col="1" caption="Broj Klase:">
				<textedit name="txtBrojKlase" datavalue="~dtLoad.@BrojKlase" />
			</item>
			<item row="3" col="1" caption="Urudžbeni broj:">
				<textedit name="txtUrBroj" datavalue="~dtLoad.@UrBroj" />
			</item>
			<item row="4" col="1" caption="Mjesto, adresa i šifra lokacije:">
				<textedit name="txtMjestoPotrosnje" datavalue="~dtLoad.@MjestoPotrošnje" readonly="true" />
			</item>
			<item row="5" col="1" caption="Katastarska općina:">
				<textedit name="txtKatOpcina" datavalue="~dtLoad.@KatOpcina" />
			</item>
			<item row="6" col="1" caption="Katastarska čestica:">
				<textedit name="txtKatCestica" datavalue="~dtLoad.@KatCestica" />
			</item>
		</group>
		<group row="2" col="1" rows="1" cols="1" caption="Izmjena brojila" groupbordervisible="true">
			<item row="1" col="1" caption="Brojilo:">
				<searchedit name="srcBrojilo" dataname="global.~dtBrojilo" fieldvalue="BrojiloId" fieldtext="NazivSve" datavalue="~dtLoad.@BSBrojilaId" datatext="~dtLoad.@Brojilo" />
			</item>
		</group>
	</part>
</parts>
