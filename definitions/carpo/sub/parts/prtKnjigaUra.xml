<!--svi partovi iz Carpo projekta KnjigaUra-->
<parts>
	<!--20.2.2023. AA dorade za 13. razdoblje-->
	<part name="prtUraUnesi">
		<action type="variable value">
			<parameter name="NoviId" value="null"/>
		</action>
		<action type="form open" value="frmKnjigaUraInsert">
			<parameter name="KntVrsteKnjigaUraIdInsert"  value="#tree.@KntVrsteKnjigaUraId"/>
		</action>
		<action type="control populate keepfocus" value="#grdGlava" if="$NoviId==null"/>
		<action else="$NoviId!=null">
			<action type="control populate" value="#grdGlava" />
			<action type="datarun reader" value="~dtDrvoNovaUra"/>
			<action type="control focus" value="#tree">
				<parameter value="~dtDrvoNovaUra.@Poz"/>
			</action>
			<action type="control focus" value="#grdGlava">
				<parameter value="$NoviId"/>
			</action>
		</action>
	</part>
	<part name="prtUraIzmijeni">
		<!--BLOKADA-->
		<action type="datarun reader" value="~dtBlokada"/>
		<action type="variable value">
			<parameter name="Global.$BlokadaOd" value="~dtBlokada.@Od" type="date"/>
			<parameter name="Global.$BlokadaDo" value="~dtBlokada.@Do" type="date"/>
		</action>
		<action type="message" value="Datum dokumenta je izvan dopuštenog razdoblja knjiženja!"
								if="#grdGlava.@datumknjizenja&lt;Global.$BlokadaOd||#grdGlava.@datumknjizenja&gt;Global.$BlokadaDo"/>
		<action else="">
			<action type="confirm" value="Promjene mogu prouzročiti razlike kartica i knjiga PDV-a!Jeste li sigurni da želite nastaviti?" if="#grdGlava.@RedniBroj!=RBROJ">

				<partsql name="partUraEditSpremiProknjizi" dataname="~dtPartUraEditSpremiProknjizi"/>

				<action type="form open" value="frmKnjigaUraRucno" else="">
					<parameter name="KntKnjigaUraId"  value="#grdGlava.@KntKnjigaUraId" type="int"/>
				</action>
				<action type="control populate" value="#grdGlava">
					<action type="control focus" value="#tree">
						<parameter value="$FokusDrvoIzmjena"/>
					</action>
					<action type="control focus" value="#grdGlava">
						<parameter value="$FokusIzmjena"/>
					</action>
				</action>
			</action>
			<action else="">

				<partsql name="partUraEditSpremiProknjizi" dataname="~dtPartUraEditSpremiProknjizi"/>

				<action type="form open" value="frmKnjigaUraRucno" else="">
					<parameter name="KntKnjigaUraId"  value="#grdGlava.@KntKnjigaUraId" type="int"/>
				</action>

				<action type="control populate" value="#grdGlava">
					<action type="control focus" value="#tree">
						<parameter value="$FokusDrvoIzmjena"/>
					</action>
					<action type="control focus" value="#grdGlava">
						<parameter value="$FokusIzmjena"/>
					</action>
				</action>
			</action>
			<action type="menu enable" value="#menDokument" if="#grdGlava.@IndGlk==1&amp;&amp;#grdGlava.@KntTemId!=null"/>
			<action type="menu disable" value="#menDokument" else=""/>
		</action>
	</part>
	<part name="prtUraObrisi">
		<!--BLOKADA-->
		<action type="datarun reader" value="~dtBlokada"/>
		<action type="variable value">
			<parameter name="Global.$BlokadaOd" value="~dtBlokada.@Od" type="date"/>
			<parameter name="Global.$BlokadaDo" value="~dtBlokada.@Do" type="date"/>
		</action>
		<action type="message" value="Datum dokumenta je izvan dopuštenog razdoblja knjiženja!"
								if="#grdGlava.@datumknjizenja&lt;Global.$BlokadaOd||#grdGlava.@datumknjizenja&gt;Global.$BlokadaDo"/>
		<action else="">
			<action type="confirm" value="Želite li zaista obrisati račun broj {#grdGlava.@Broj}?">
				<action type="datarun scalar" value="~dtObrisiUru"/>
				<action type="control populate keepfocus" value="#grdGlava"/>
			</action>
		</action>
	</part>
	<part name="prtZakljuci">
		<action type="message" value="Morate odabrati jednu od knjiga ili zaključak!" if="#tree.@value==godina">
			<action type="variable value" value="$PozDrvoZak">
				<parameter value="#tree.@id"/>
			</action>
		</action>
		<action type="datarun reader" value="~dtDatumZaZakljucak" else="">
			<action type="form open" value="frmZakljucak">
				<parameter name="datumzak" value="~dtDatumZaZakljucak.@datumzakljucka" type="date" />
				<parameter name="lastrb" value="~dtDatumZaZakljucak.@rednibroj" type="int" />
				<parameter name="node"  value="#tree.@Id" />
				<parameter name="treevalue"  value="#tree.@value" />
			</action>
			<action type="variable value" value="$Odustani" if="dialogresult==cancel">
				<parameter value="true"/>
			</action>
		</action>
		<action if="$Odustani==false">
			<action type="control populate" value="#tree"/>
			<action type="control expand" value="#tree">
				<parameter name="key" value="$Godina"/>
			</action>
			<action type="control focus" value="#tree">
				<parameter value="$PozDrvoZak" type="string"/>
			</action>
		</action>
		<action type="variable value" value="$Odustani" >
			<parameter value="false" type="bool"/>
		</action>
	</part>
	<part name="prtPonistiZakljucak">
		<action type="datarun reader" value="~dtRazdoblje13"/>
		<action type="message" value="Morate odabrati jednu od knjiga ili zaključak!" if="#tree.@value==godina"/>
		<action type="message" value="Odabrani datum u drvetu nema zaključak ili nije dopušteno poništiti zaključak za odabrani datum!" elseif="#tree.@value==vrstaknjige"/>
		<action type="message" value="Odabrani datum u drvetu nema zaključak ili nije dopušteno poništiti zaključak za odabrani datum!" elseif="#tree.@godina!=#tree.@godinadatzak&amp;&amp;~dtRazdoblje13.@Razdoblje13!=1"/>
		<action type="datarun reader" value="~dtZadnjiDatZak" else="">
			<action type="message" value="Odabrani datum {#tree.@datumzakljucka::dd.MM.yyyy} se nalazi izvan dopuštenog razdoblja. Nije moguće poništiti zaključak!" if="{#tree.@datumzakljucka::yyyyMMdd}&lt;{Global.$BlokadaOd::yyyyMMdd}||{#tree.@datumzakljucka::yyyyMMdd}&gt;{Global.$BlokadaDo::yyyyMMdd}"/>
			<action type="message" value="Odabrani datum u drvetu nema zaključak ili nije dopušteno poništiti zaključak za odabrani datum!" elseif="#tree.@datumzakljucka!=~dtZadnjiDatZak.@ZadnjiDatZak&amp;&amp;~dtRazdoblje13.@Razdoblje13!=1"/>
			<action type="confirm" value="Poništavate zaključak za datum {#tree.@datumzakljucka::dd.MM.yyyy}. Jeste li sigurni?" elseif="#tree.@datumzakljucka==~dtZadnjiDatZak.@ZadnjiDatZak||~dtRazdoblje13.@Razdoblje13==1">
				<action type="datarun reader" value="~dtPonistiZakljucak" />
				<action type="datarun reader" value="~dtPozicijaNezakljucen"/>
				<action type="control populate" value="#tree"/>
				<action type="control expand" value="#tree">
					<parameter name="key" value="$Godina"/>
				</action>
				<action type="control focus" value="#tree">
					<parameter value="~dtPozicijaNezakljucen.@Poz" type="string"/>
				</action>
			</action>
		</action>
	</part>
	<part name="prtSetPorezUpozorenje">
		<action type="variable value" value="$action">
			<parameter value="SetPorezUpozorenje"/>
		</action>
		<action type="datarun reader" value="~dtPostimajKontrole"/>
		<action type="control value" value="#lblRazlika">
			<parameter value="~dtPostimajKontrole.@PorezUpozorenje"/>
		</action>
	</part>
</parts>