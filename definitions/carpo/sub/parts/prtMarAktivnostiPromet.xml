									</event>
								</dropdownitem>
							</button>
						</item>
						<item col="2" row="1" caption=" ">
							<dateedit name="datRazOdPromet" value="now" />
						</item>
						<item col="3" row="1" caption=" " padding="1,1,20,1">
							<labeledit value="-" textposition="center" />
						</item>
						<item col="4" row="1" caption=" ">
							<dateedit name="datRazDoPromet" value="now" />
						</item>
					</group>
					<group col="2" row="1" cols="2" rows="1" bordervisible="true">
						<columnsdefinition>
							<column size="68%" position="1" />
							<column size="32%" position="2" />
							<!--
							<column size="5%" position="3" />
							<column size="5%" position="4" />
							-->
						</columnsdefinition>
						<!--
						<item col="1" row="1" caption=" " padding="1,1,20,1">
						<button value="" textposition="center" fontbold="true" />
						</item>
						-->
						<item col="1" row="1" caption=" " padding="1,1,20,1">
							<labeledit value="Obradi ovaj tab" textposition="right" fontbold="true" />
						</item>
						<item col="2" row="1" caption="" padding="1,1,18,1">
							<checkedit name="chkTabPromet" caption=" " />
						</item>
						<!--
						<item col="4" row="1" caption=" " padding="1,1,20,1">
						<button value="" textposition="center" fontbold="true" />
						</item>
						-->
					</group>
				</group>
				<group col="1" row="2" cols="4" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="43%" position="1" />
						<column size="10%" position="2" />
						<column size="43%" position="3" />
						<column size="4%" position="4" />
					</columnsdefinition>
					<group col="1" row="1" cols="2" rows="1" bordervisible="false">
						<item col="1" row="1" caption="Klasa robe">
							<combotreeedit name="cmbKlRobaPromet" dataname="~dtKlRoba" valuefield="SortKey" displayfield="Naziv" tabindex="5">
							</combotreeedit>
						</item>
						<item col="2" row="1" caption="I ispod" padding="1,1,18,1">
							<checkedit name="chkIspodKlRobaPromet" caption="I ispod" />
						</item>
					</group>
					<group col="3" row="1" cols="2" rows="1" bordervisible="false">
						<item col="1" row="1" caption="Organizacijska jedinica">
							<combotreeedit name="cmbOrgShemaPromet" dataname="~dtOrgShema" valuefield="SortKey" displayfield="Naziv" tabindex="5">
							</combotreeedit>
						</item>
						<item col="2" row="1" caption="I ispod" padding="1,1,18,1">
							<checkedit name="chkIspodOrgShemaPromet" caption="I ispod" />
						</item>
					</group>
				</group>
				<group col="1" row="3" cols="4" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="44%" position="1" />
						<column size="10%" position="2" />
						<column size="44%" position="3" />
						<column size="2%" position="4" />
					</columnsdefinition>
					<group col="1" row="1" cols="4" rows="1" bordervisible="true" caption="Ukupna neto vrijednost ostvarenog prometa">
						<columnsdefinition>
							<column size="40%" position="1" />
							<column size="10%" position="2" />
							<column size="40%" position="3" />
							<column size="10%" position="4" />
						</columnsdefinition>
						<item col="1" row="1" caption="">
							<textedit name="txtVrijednostOd" datatext="~dtGetDataEdit.@Vrijednost" format="n2" value="0" />
						</item>
						<item col="2" row="1" caption="" padding="1,1,4,1">
							<labeledit value="-" textposition="center" />
						</item>
						<item col="3" row="1" caption="">
							<textedit name="txtVrijednostDo" datatext="~dtGetDataEdit.@Vrijednost" format="n2" value="9999999" />
						</item>
					</group>
					<group col="3" row="1" cols="4" rows="1" bordervisible="true" caption="Ukupno ostvareni RUC">
						<columnsdefinition>
							<column size="4440%" position="1" />
							<column size="10%" position="2" />
							<column size="44%" position="3" />
							<column size="2%" position="4" />
						</columnsdefinition>
						<item col="1" row="1" caption="">
							<textedit name="txtRucOd" datatext="~dtGetDataEdit.@Vrijednost" format="n2" value="0" />
						</item>
						<item col="2" row="1" caption="" padding="1,1,4,1">
							<labeledit value="-" textposition="center" />
						</item>
						<item col="3" row="1" caption="">
							<textedit name="txtRucDo" datatext="~dtGetDataEdit.@Vrijednost" format="n2" value="9999999" />
						</item>
					</group>
				</group>
			</group>
			<group col="1" row="2" cols="1" rows="1" bordervisible="true">
				<item col="1" row="1" caption="" colspan="2">
					<grid name="grdTabPromet" dataname="dtTab" bestfitonrefresh="true" showcheckboxes="true" keepselectionafterfilter="true">
						<fields>
							<field name="PreTitleNaziv" caption="Titula" />
							<field name="Prezime" caption="Prezime" />
							<field name="Ime" caption="Ime" />
							<field name="Naziv" caption="Partner" />
						</fields>
						<event type="focusedrowchanged">
							<action type="variable value">
								<parameter name="Tab" value="Promet" />
							</action>
							<action type="footer text" value="Broj slogova: {#grdTabPromet.rowcount}  Broj označenih slogova: {#grdTabPromet.selectedrowscount}" />
						</event>
						<event type="selectionchanged">
							<action type="footer text" value="Broj slogova: {#grdTabPromet.rowcount}  Broj označenih slogova: {#grdTabPromet.selectedrowscount}" />
						</event>
					</grid>
				</item>
			</group>
		</group>
	</part>
</parts>
