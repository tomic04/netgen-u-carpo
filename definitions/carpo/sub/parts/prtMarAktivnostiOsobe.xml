<parts>
	<part name="prtMarAktivnostiOsobe">
		<group cols="2" rows="2" caption=" " name="tabOsobe">
			<columnsdefinition>
				<column size="80%" position="1" />
				<column size="20%" position="2" />
			</columnsdefinition>
			<!--
			<rowsdefinition>
			<row size="40%" position="1" />
			<row size="60%" position="2" />
			</rowsdefinition>
			-->
			<group col="1" row="1" cols="3" rows="4" bordervisible="true">
				<columnsdefinition>
					<column size="50%" position="1" />
					<column size="20%" position="2" />
					<column size="30%" position="3" />
				</columnsdefinition>
				<item col="1" row="1" caption="Klasa osoba:" highlight="false">
					<combotreeedit name="cmbKlOsobe" dataname="~dtKlOsobe" valuefield="SortKey" displayfield="Naziv" tabindex="5">
					</combotreeedit>
				</item>
				<item col="2" row="1" caption="" highlight="false" padding="1,1,18,1">
					<checkedit name="chkIspodKlOsobe" caption="I ispod" />
				</item>
				<item col="3" row="1" caption="PreTitule">
					<comboedit name="cmbPreTitule" dataname="~dtCmbPreTitule" valuefield="PreTitleId" displayfield="Naziv" tabindex="5">
					</comboedit>
				</item>
				<item col="1" row="2" caption="Odjel:" highlight="false">
					<comboedit name="cmbOdjel" dataname="~dtCmbOdjel" valuefield="OdjelId" displayfield="Naziv" tabindex="5">
					</comboedit>
				</item>
				<item col="3" row="2" caption="PosTitule:" highlight="false">
					<comboedit name="cmbPosTitule" dataname="~dtCmbPosTitule" valuefield="PosTitleId" displayfield="Naziv" tabindex="5">
					</comboedit>
				</item>
				<item col="1" row="3" caption="Funkcija:" highlight="false">
					<combotreeedit name="cmbFunkcija" dataname="~dtCmbFunkcija" valuefield="SortKey" displayfield="Naziv" tabindex="5">
					</combotreeedit>
				</item>
				<item col="2" row="3" caption="" highlight="false" padding="1,1,18,1">
					<checkedit name="chkIspodFunkcije" caption="I ispod" />
				</item>
				<item col="3" row="3" caption="" highlight="false" padding="1,1,18,1">
					<checkedit name="chkKeyContact" caption="Key Contact" />
				</item>
				<item col="1" row="4" caption="Mjesto" highlight="false">
					<comboedit name="cmbMjestaOsobe" dataname="~dtCmbMjesta" valuefield="MjestaId" displayfield="Naziv" tabindex="5">
					</comboedit>
				</item>
			</group>
			<group col="2" row="1" cols="1" rows="6" bordervisible="true">
				<item col="1" row="1">
					<labeledit value="E-mail" />
				</item>
				<item col="1" row="2" caption="" highlight="false">
					<checkedit name="chkIskljuceno" caption="Isključeno">
						<event type="checkedchanged">
							<action type="control value" value="#chkPrivatni,#chkFirmin,#chkPoslovni,#chkBiloKoji" if="#chkIskljuceno==true">
								<parameter value="False" />
							</action>
						</event>
					</checkedit>
				</item>
				<item col="1" row="3" caption="" highlight="false">
					<checkedit name="chkPrivatni" caption="Privatni">
						<event type="checkedchanged">
							<action type="control value" value="#chkIskljuceno,#chkFirmin,#chkPoslovni,#chkBiloKoji" if="#chkPrivatni==true">
								<parameter value="False" />
							</action>
						</event>
					</checkedit>
				</item>
				<item col="1" row="4" caption="" highlight="false">
					<checkedit name="chkFirmin" caption="Firmin">
						<event type="checkedchanged">
							<action type="control value" value="#chkIskljuceno,#chkPrivatni,#chkPoslovni,#chkBiloKoji" if="#chkFirmin==true">
								<parameter value="False" />
							</action>
						</event>
					</checkedit>
				</item>
				<item col="1" row="5" caption="" highlight="false">
					<checkedit name="chkPoslovni" caption="Poslovni">
						<event type="checkedchanged">
							<action type="control value" value="#chkIskljuceno,#chkPrivatni,#chkFirmin,#chkBiloKoji" if="#chkPoslovni==true">
								<parameter value="False" />
							</action>
						</event>
					</checkedit>
				</item>
				<item col="1" row="6" caption="" highlight="false">
					<checkedit name="chkBiloKoji" caption="Bilo koji">
						<event type="checkedchanged">
							<action type="control value" value="#chkIskljuceno,#chkPrivatni,#chkFirmin,#chkPoslovni" if="#chkBiloKoji==true">
								<parameter value="False" />
							</action>
						</event>
					</checkedit>
				</item>
			</group>
			<group col="1" row="2" cols="1" rows="1" bordervisible="true" colspan="2">
				<item col="1" row="1" caption="" colspan="2">
					<grid name="grdTabOsobe" dataname="dtTab" bestfitonrefresh="true" showcheckboxes="true" keepselectionafterfilter="true">
						<fields>
							<field name="PreTitleNaziv" caption="Titula" />
							<field name="Prezime" caption="Prezime" />
							<field name="Ime" caption="Ime" />
							<field name="Naziv" caption="Partner" />
						</fields>
						<event type="focusedrowchanged">
							<action type="variable value">
								<parameter name="Tab" value="Osobe" />
							</action>
							<action type="footer text" value="Broj slogova: {#grdTabOsobe.rowcount}  Broj označenih slogova: {#grdTabOsobe.selectedrowscount}" />
						</event>
						<event type="selectionchanged">
							<action type="footer text" value="Broj slogova: {#grdTabOsobe.rowcount}  Broj označenih slogova: {#grdTabOsobe.selectedrowscount}" />
						</event>
					</grid>
				</item>
			</group>
		</group>
	</part>
</parts>
