<parts>
  <part name="UnosIzmjenaSloga">
    <item row="1" col="1" caption="Vrsta ugovora">
      <comboedit name="cmbVrstaUgovora" valuefield="UgovoriNajamVrsteId" displayfield="Naziv" dataname="~dtGetVrsta">
        <fields>
          <field name="Naziv"/>
          <field name="Oznaka"/>
        </fields>
        <event type="valuechanged">
          <!--BSR - bazne stanice i vodovi-->
          <action if="#cmbVrstaUgovora.@Oznaka=='BSR'">
            <action type="control visible" value="#txtObavijesniPeriod, #datDatumPrimopredaje, #chkZasebanUgovor">
              <parameter value="true"/>
            </action>
            <action type="control attribute" value="#txtObavijesniPeriod">
              <parameter name="required" value="true"/>
            </action>
          </action>
          <action else="">
            <action type="control visible" value="#txtObavijesniPeriod, #datDatumPrimopredaje, #chkZasebanUgovor">
              <parameter value="false"/>
            </action>
            <action type="control attribute" value="#txtObavijesniPeriod">
              <parameter name="required" value="false"/>
            </action>
          </action>
        </event>
      </comboedit>
    </item>
    <!--<item row="2" col="1" caption="Partner">
      <searchedit name="srcPartner" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@PartnerNaziv" fieldtext="NazivId" fieldvalue="partneriid" dataname="~dtPartneri" />
    </item>-->
    <item row="2" col="1" caption="Tip razdoblja trajanja ugovora">
      <comboedit name="cmbTipTrajanja" valuefield="UgovoriTipTrajanjaID" displayfield="Naziv" dataname="~dtGetTipRazdobljaTrajanjaUgovora" required="true">
        <event type="valuechanged">
          <action if="#cmbTipTrajanja.text=='Automatsko produljenje'">
            <action type="control visible" value="#txtBrojProduljenja">
              <parameter value="true"/>
            </action>
            <action type="control attribute" value="#txtBrojProduljenja">
              <parameter name="required" value="true"/>
            </action>
            <action type="control visible" value="#txtTrajanjeProduljenja">
              <parameter value="true"/>
            </action>
            <action type="control attribute" value="#txtTrajanjeProduljenja">
              <parameter name="required" value="true"/>
            </action>
            <action type="control value" value="#txtBrojProduljenja">
              <parameter value="1"/>
            </action>
          </action>
          <action else="">
            <action type="control visible" value="#txtBrojProduljenja">
              <parameter value="false"/>
            </action>
            <action type="control attribute" value="#txtBrojProduljenja">
              <parameter name="required" value="false"/>
            </action>
            <action type="control visible" value="#txtTrajanjeProduljenja">
              <parameter value="false"/>
            </action>
            <action type="control attribute" value="#txtTrajanjeProduljenja">
              <parameter name="required" value="false"/>
            </action>
            <action type="control value" value="#txtTrajanjeProduljenja">
              <parameter value=""/>
            </action>
          </action>
        </event>
      </comboedit>
    </item>
    <item row="3" col="1" caption="Broj produljenja">
      <textedit name="txtBrojProduljenja" format="n0" />
    </item>
    <item row="4" col="1" caption="Trajanje produljenja">
      <textedit name="txtTrajanjeProduljenja" format="n0"/>
    </item>
    <item row="5" col="1" caption="Broj ugovora">
      <textedit name="txtBrojUgovora"/>
    </item>
    <item row="6" col="1" caption="Datum potpisivanja ugovora">
      <dateedit name="datDatumPotpisivanja"/>
    </item>
    <item row="7" col="1" caption="Datum početka važenja ugovora">
      <dateedit name="datDatumPocetka"/>
    </item>
    <item row="8" col="1" caption="Datum prestanka važenja ugovora">
      <dateedit name="datDatumPrestanka"/>
    </item>
    <item row="9" col="1" caption="Ugovor produljen do:">
      <dateedit name="datUgovorProduljenDo"/>
    </item>
    <item row="10" col="1" caption="Procijenjeni datum prestanka važenja ugovora">
      <dateedit name="datProcDatumPrestanka"/>
    </item>
    <item row="11" col="1" caption="Otkazni rok Tele2">
      <textedit name="txtOtkazniRokTele2" format="n0"/>
    </item>
    <item row="12" col="1" caption="Otkazni rok partnera">
      <textedit name="txtOtkazniRokPartner" format="n0"/>
    </item>
    <item row="13" col="1" caption="Obavijesni period">
      <textedit name="txtObavijesniPeriod" format="n0" />
    </item>
    <item row="14" col="1" caption="Datum primopredaje">
      <dateedit name="datDatumPrimopredaje"/>
    </item>
    <item row="15" col="1" caption="Status">
      <comboedit name="cmbStatus" dataname="~dtGetStatusi"  valuefield="UgovoriNajamStatusiID" displayfield="Naziv" required="true">
        <event type="valuechanged">
          <action if="#cmbStatus.text=='Zamijenjen'">
            <action type="control visible" value="#srcBrojNovogUgovora">
              <parameter value="true"/>
            </action>
            <action type="control attribute" value="#srcBrojNovogUgovora">
              <parameter name="required" value="true"/>
            </action>
          </action>
          <action if="#cmbStatus.text!='Zamijenjen'">
            <action type="control visible" value="#srcBrojNovogUgovora">
              <parameter value="false"/>
            </action>
            <action type="control attribute" value="#srcBrojNovogUgovora">
              <parameter name="required" value="false"/>
            </action>
            <action type="control value" value="#srcBrojNovogUgovora">
              <parameter value="null"/>
            </action>
          </action>
          <action if="#cmbStatus.text=='Aktivan'">
            <action type="control visible" value="#srcBrojPrethodnogUgovora">
              <parameter value="true"/>
            </action>
          </action>
          <action if="#cmbStatus.text!='Aktivan'">
            <action type="control visible" value="#srcBrojPrethodnogUgovora">
              <parameter value="false"/>
            </action>
            <action type="control value" value="#srcBrojPrethodnogUgovora">
              <parameter value="null"/>
            </action>
          </action>
        </event>
      </comboedit>
    </item>
    <item row="16" col="1" caption="Broj novog ugovora">
      <searchedit name="srcBrojNovogUgovora" dataname="~dtSearchUgovoriPoStatusu" fieldtext="Broj" fieldvalue="UgovoriNajamGlaId"/>
    </item>
    <item row="17" col="1" caption="Broj prethodnog ugovora">
      <searchedit name="srcBrojPrethodnogUgovora" dataname="~dtSearchUgovoriPoStatusu" fieldtext="Broj" fieldvalue="UgovoriNajamGlaId"/>
    </item>
    <item row="18" col="1" caption="Odgovorna osoba">
      <searchedit name="srcOsobe" fieldtext="Osoba" fieldvalue="OsobeId" dataname="~dtOdgovornaOsoba" datavalue="~dtGet.@OsobeId" datatext="~dtGet.@OsobaNaziv"/>
    </item>
    <item row="19" col="1" caption="Organizacijska jedinica">
      <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtGetOrgShema"/>
    </item>
    <item row="20" col="1" caption="Poseban ugovor za struju">
      <checkedit name="chkZasebanUgovor">
        <event type="checkedchanged">
          <action if="#chkZasebanUgovor==true">
            <action type="control visible" value="#srcTrazilicaUgovora">
              <parameter value="true"/>
            </action>
          </action>
          <action else="">
            <action type="control visible" value="#srcTrazilicaUgovora">
              <parameter value="false"/>
            </action>
          </action>
        </event>
      </checkedit>
    </item>
    <item row="21" col="1" caption="Tražilica ugovora">
      <searchedit name="srcTrazilicaUgovora" fieldtext="Broj" fieldvalue="UgovoriNajamGlaId" dataname="~dtSearchUgovoriPoVrsti" />
    </item>
  </part>
</parts>