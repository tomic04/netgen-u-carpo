<parts>
	<part name="posugoform">
		<group col="1" row="1" cols="3" rows="1" colspan="3">
			<item caption="Vrsta ugovora:" col="1" row="1" highlight="false">
				<comboedit name="cmbVrstaUgovora" valuefield="VrstaDokId" displayfield="Opis" datavalue="#dtGet.@VrstaDokId" dataname="global.dtVrstaUgovora" allownull="false" required="true"/>
			</item>		
			<item caption="Broj:" col="2" row="1" fontbold="true">
				<textedit name="txtBroj" datavalue="#dtGet.@Broj" nulltext="&lt;novi dokument&gt;"/>
			</item>		
		</group>
		<item caption="Datum:" col="1" row="2">
			<dateedit name="datDatumUgovora" value="now" datavalue="#dtGet.@DatumUgovora" required="true"/>
		</item>		
		<item caption="Vrijedi do:" col="2" row="2">
			<dateedit name="datDatumVrijediDo" value="now" datavalue="#dtGet.@UgovorVrijediDo" allownull="true" checked="true"/>
		</item>
		<item caption="Datum početka skladištenja:" col="3" row="2">
			<dateedit name="datDatumSkladistenja" value="now" datavalue="#dtGet.@DatumSkladistenja" allownull="true"/>
		</item>
		<item caption="Partner:" highlight="false" col="1" row="3" colspan="2">
			<searchedit netgenfields="true" name="srcpartner" required="true" fontbold="true" dataname="global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@Partner">
				<event type="valuechanged" >
					<action type="datarun reader" value="global.dtGetPartner" if="#srcpartner!=null"/>
					<action type="control value" value="#txtOIB">
						<parameter value="~dtGetPartner.@OIB" />
					</action>
					<action type="control value" value="#txtMBS">
						<parameter value="~dtGetPartner.@MBS" />
					</action>	
					<action type="control value" value="#txtAdresa">
						<parameter value="~dtGetPartner.@Adresa" />
					</action>		
					<action type="control value" value="#txtMjesto">
						<parameter value="~dtGetPartner.@Mjesto" />
					</action>
					<action type="control value" value="#txtHPTBroj">
						<parameter value="~dtGetPartner.@HPTBroj" />
					</action>
					<action type="control value" value="#txtTelefon">
						<parameter value="~dtGetPartner.@Telefon1" />
					</action>		
					<action type="control value" value="#txtFax">
						<parameter value="~dtGetPartner.@Fax" />
					</action>						
					<action type="control value" value="#txtIBAN">
						<parameter value="~dtGetPartner.@IBAN" />
					</action>						
					<action type="control value" value="#txtNacinPlacanja">
						<parameter value="~dtGetPartner.@NacinPlacanja" />
					</action>	
					<action type="control value" value="#txtKreditniLimit" if="$PosUgovoriglaId==null">
						<parameter value="~dtGetPartner.@KreditniLimit" />
					</action>	
					<action type="control value" value="#txtOdgoda" if="$PosUgovoriglaId==null">
						<parameter value="~dtGetPartner.@Odgoda" />
					</action>					
					<action type="control value" value="#txtRabat" if="$PosUgovoriglaId==null">
						<parameter value="~dtGetPartner.@Rabat" />
					</action>
				</event>										
				<event type="leave">

				</event>
			</searchedit>						
		</item>
		<item caption="OIB:" col="1" row="4" >
			<textedit name="txtOIB" datavalue="#dtGet.@OIB" />
		</item>	
		<item caption="MBS:" col="2" row="4" >
			<textedit name="txtMBS" datavalue="#dtGet.@MBS" />
		</item>	
		<item col="1" row="5" textvisible="False" colspan="3">
			<separator  dark="true" backcolor="gray" />
		</item>		
		<item caption="Adresa:" col="1" row="6" colspan="2">
			<textedit name="txtAdresa" datavalue="#dtGet.@Adresa" />
		</item>	 	
		<item caption="Mjesto:" col="3" row="6" >
			<textedit name="txtMjesto" datavalue="#dtGet.@Mjesto" />
		</item>	
		<item caption="Poštanski broj:" col="1" row="7" >
			<textedit name="txtHptBroj" datavalue="#dtGet.@HptBroj" />
		</item>	
		<item caption="Telefon:" col="2" row="7" >
			<textedit name="txtTelefon" datavalue="#dtGet.@Telefon" />
		</item>	
		<item caption="Fax:" col="3" row="7" >
			<textedit name="txtFax" datavalue="#dtGet.@fax" />
		</item>			
		<item col="1" row="8" textvisible="False" colspan="3">
			<separator  dark="true" backcolor="gray" />
		</item>	
		<item caption="IBAN:" col="1" row="9" colspan="2">
			<textedit name="txtIban" datavalue="#dtGet.@Iban" />
		</item>	
		<item caption="Način plaćanja:" col="3" row="9" >
			<textedit name="txtNacinPlacanja" datavalue="#dtGet.@NacinPlacanja" />
		</item>	
		<item caption="Količina:" col="1" row="10" >
			<textedit name="txtKolicina" datavalue="#dtGet.@Kolicina" format="n0"/>
		</item>	
		<item caption="Cijena:" col="2" row="10" >
			<textedit name="txtCijena" datavalue="#dtGet.@Cijena" format="n4"/>
		</item>	
		<item col="1" row="11" textvisible="False" colspan="3">
			<separator  dark="true" backcolor="gray" />
		</item>


		<item col="1" row="12" caption="Komercijala osoba:" colspan="2">
			<searchedit name="srcKomOsobe" dataname="Global.dtKomOdgovornaOsoba"  fieldtext="Osoba" datavalue="#dtGet.@OsobeId" datatext="#dtGet.@OvlastenaOsoba" function="srcKomOsobe"/>
		</item>

		<item caption="Kultura:" col="1" row="13" colspan="2">
			<comboedit name="cmbKultura" valuefield="KultureId" displayfield="Kultura" datavalue="#dtGet.@KultureId" dataname="global.dtKultura" allownull="true" />
		</item>

	</part>
</parts>