<parts>
	<part name="partStorniraj">
		<layout textposition="left">
			<group cols="1" rows="1" >
				<item caption="Datum:" col="1" row="1">
					<dateedit name="datDatumStorno" value="now"/>                                                                                         
				</item>
			</group>
		</layout>	
		<panelbuttons>
			<buttons>
				<button name="btnStorno" caption="STORNIRAJ">
					<event type="click">
						<action type="datarun scalar" value="~dtStorno" >
							<parameter name="SktPrometGlaId" />
						</action>
						<action type="variable value" value="Global.$DokId">
							<parameter value="$SktPrometGlaId" />
						</action>						
						<action type="datarun scalar" value="Global.dtDajNode">
							<parameter name="Tree_node" />
						</action>					
						<action type="control focus" value="parent.#tree" if="#tree.Id!=$Tree_node">
						  <parameter value="$Tree_node"/>
						</action>
						<action type="control populate" value="parent.#grdGlava" >
							<action type="control focus" value="parent.#grdGlava">
								<parameter value="$SktPrometGlaId" />
							</action>
						</action>
						<action type="form close"/>							
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" >
					<event type="click">
						<action type="form close"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spSklad_Gla_Storniranje" name="dtStorno">
				<parameter name="@SktPrometGlaId" value="$SktPrometGlaId" />
				<parameter name="@DatumStorno" value="#datDatumStorno" />
				<parameter name="@OperateriId" value="@@operateriid" />
				<parameter name="@VrstaPromId" value="Global.$VrstaPromId" />
			</data>
		</datalist>
	</part>
	
	
	
</parts>