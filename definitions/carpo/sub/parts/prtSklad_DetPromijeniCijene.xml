<parts>
	<part name="partDetPromijeniCijene">  	
		<event type="load">
		</event>	
		<layout textposition="left" itemspadding="3">
			<group cols="2" rows="2" >
				<item col="1" row="1" caption="">
					<checkedit name="chkNC"> 
						<event type="valuechanged">	
							<action type="control enable" value="#txtNabCijena" if="#chkNC==true"/>			
							<action type="control disable" value="#txtNabCijena" else=""/>
						</event>					
					</checkedit>
				</item>
				<item col="2" row="1" caption="Nova nabavna cijena:">
					<textedit name="txtNabCijena" value="0" type="decimal" format="n4" allownull="false" enabled="false"/> 
				</item>
				<item col="1" row="2" caption="">
					<checkedit name="chkPC"> 
						<event type="valuechanged">	
							<action type="control enable" value="#txtProdCijena" if="#chkPC==true"/>
							<action type="control disable" value="#txtProdCijena" else=""/>							
						</event>					
					</checkedit>
				</item>				
				<item caption="Nova prodajna cijena:" col="2" row="2" >
					<textedit name="txtProdCijena" value="0" type="decimal" format="n4" allownull="false" enabled="false"/>
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" >
					<event type="click">	
						<action type="confirm" value="Jeste li sigurni da želite promijeniti cijene na označenim stavkama?"/>				
						<action type="datarun nonquery" value="~dtDetPromijeniCijene" if="parent.$Smije==1"/>																	
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="ODUSTANI" type="cancel"></button>
			</buttons>
		</panelbuttons>	
		<datalist>
			<data command="spSklad_Det_PromijeniCijene" name="dtDetPromijeniCijene">
				<parameter name="@SktPrometGlaId" value="$SktPrometGlaId"/>
				<parameter name="@NabCijena" value="#txtNabCijena" if="#chkNC==true"/>
				<parameter name="@ProdCijena" value="#txtProdCijena" if="#chkPC==true"/>
				<parameter name="@table" value="parent.#grdDetalj.selectedids.table"/>		
			</data>					
		</datalist>			
	</part>	
</parts>