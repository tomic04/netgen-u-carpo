<parts>
	<part name="prtMarAktivnostiPartneri">
		<group cols="2" rows="2" caption=" " name="tabPartneri">
			<columnsdefinition>
				<column size="50%" position="1" />
				<column size="50%" position="2" />
			</columnsdefinition>
			<group col="1" row="1" cols="2" rows="3" bordervisible="true">
				<columnsdefinition>
					<column size="80%" position="1" />
					<column size="20%" position="2" />
				</columnsdefinition>
				<item col="1" row="1" colspan="2" caption="Djelatnost:" highlight="false">
					<combotreeedit name="cmbDjelatnost" valuefield="ID" displayfield="Naziv" dataname="~dtDjelatnosti">
						<!--
						<event type="valuechanged">
						<action type="datarun reader" value="dtDjelatnostiSort">
						<action type="variable value">
						<parameter name="DjelatnostiSortKey" value="~dtDjelatnostiSort.@SortKey" />
						</action>
						</action>
						</event>
						-->
					</combotreeedit>
				</item>
				<item col="1" row="2" caption="Klasa partnera:" highlight="false">
					<combotreeedit name="cmbKlPartner" valuefield="SortKey" displayfield="Naziv" dataname="~dtKlPartneri">
					</combotreeedit>
				</item>
				<item col="2" row="2" caption=" " padding="1,1,18,1">
					<checkedit name="chkIspod" caption="I ispod" />
				</item>
				<item col="1" row="3" colspan="2" caption="Partner:" highlight="false">
					<searchedit name="srcPartner" fieldtext="Partner3000" fieldvalue="PartneriId" dataname="dtSearchPartner" function="srcPartner" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@Partner">
					</searchedit>
				</item>
			</group>
			<group col="2" row="1" cols="1" rows="3" bordervisible="true">
				<item col="1" row="1" caption="Država:">
					<comboedit name="cmbDrzave" dataname="~dtCmbDrzave" displayfield="Naziv" valuefield="DrzaveId" tabindex="4">
						<event type="valuechanged">
							<action type="control populate" value="#cmbZupanije" />
							<action type="control populate" value="#cmbMjesta" />
						</event>
					</comboedit>
				</item>
				<item col="1" row="2" caption="Županija:">
					<comboedit name="cmbZupanije" dataname="~dtCmbZupanije" displayfield="Naziv" valuefield="ZupanijeId" tabindex="4">
						<event type="valuechanged">
							<action type="control populate" value="#cmbMjesta" />
						</event>
					</comboedit>
				</item>
				<item col="1" row="3" caption="Mjesto:">
					<comboedit name="cmbMjesta" dataname="~dtCmbMjesta" valuefield="MjestaId" displayfield="Naziv" tabindex="5">
					</comboedit>
				</item>
			</group>
			<group col="1" row="2" cols="1" rows="1" bordervisible="true" colspan="2">
				<item col="1" row="1" caption="" colspan="2">
					<grid name="grdTab" dataname="dtTab" bestfitonrefresh="true" showcheckboxes="true" keepselectionafterfilter="true" key="OsobeId">
						<fields>
							<field name="PreTitleNaziv" caption="Titula" />
							<field name="Prezime" caption="Prezime" />
							<field name="Ime" caption="Ime" />
							<field name="Naziv" caption="Partner" />
						</fields>
						<event type="focusedrowchanged">
							<action type="variable value">
								<parameter name="Tab" value="Partneri" />
							</action>
							<action type="footer text" value="Broj slogova: {#grdTab.rowcount}  Broj označenih slogova: {#grdTab.selectedrowscount}" />
						</event>
						<event type="selectionchanged">
							<action type="footer text" value="Broj slogova: {#grdTab.rowcount}  Broj označenih slogova: {#grdTab.selectedrowscount}" />
						</event>
					</grid>
				</item>
			</group>
		</group>
	</part>
</parts>
