<parts>
  <part name="UnosIzmjenaSloga">
    <item row="1" col="1" caption="Vrsta ugovora">
      <comboedit name="cmbVrstaUgovora" valuefield="UgovoriNajamVrsteId" displayfield="Naziv" dataname="~dtGetVrsta" datatext="~dtGetDetails.@VrstaUgovora" datavalue="~dtGetDetails.@UgovoriNajamVrsteId" required="true">
        <fields>
          <field name="Naziv"/>
          <field name="Oznaka"/>
        </fields>
        <event type="valuechanged">
          <!--BSR - bazne stanice i vodovi-->
          <action if="#cmbVrstaUgovora.@Oznaka=='BSR'">
            <action type="control enable" value="#txtObavijesniPeriod, #datDatumPrimopredaje, #chkZasebanUgovor"/>
            <action type="control value" value="#datDatumPrimopredaje">
              <parameter value="now"/>
            </action>
            <action type="control attribute" value="#txtObavijesniPeriod">
              <parameter name="required" value="true"/>
            </action>
          </action>
          <action else="">
            <action type="control disable" value="#txtObavijesniPeriod, #datDatumPrimopredaje, #chkZasebanUgovor"/>
            <action type="control attribute" value="#txtObavijesniPeriod">
              <parameter name="required" value="false"/>
            </action>
            <action type="control value" value="#txtObavijesniPeriod, #datDatumPrimopredaje,#chkZasebanUgovor, #srcTrazilicaUgovora">
              <parameter value="null"/>
            </action>
          </action>
        </event>
      </comboedit>
    </item>
    <item row="2" col="1" caption="Broj ugovora">
      <textedit name="txtBrojUgovora" datavalue="~dtGetDetails.@Broj"/>
    </item>
    <item row="3" col="1" caption="Tip razdoblja trajanja ugovora">
      <comboedit name="cmbTipTrajanja" valuefield="UgovoriTipTrajanjaID" displayfield="Naziv" dataname="~dtGetTipRazdobljaTrajanjaUgovora"
              datavalue="~dtGetDetails.@UgovoriNajamTipTrajanja" datatext="~dtGetDetails.@TipTrajanja" required="true">
        <event type="valuechanged">
          <action if="#cmbTipTrajanja.text=='Automatsko produljenje'">
            <action type="control enable" value="#txtBrojProduljenja, #txtTrajanjeProduljenja"/>
            <action type="control attribute" value="#txtBrojProduljenja, txtTrajanjeProduljenja">
              <parameter name="required" value="true"/>
            </action>
            <action type="control value" value="#txtBrojProduljenja">
              <parameter value="1"/>
            </action>
          </action>
          <action else="">
            <action type="control disable" value="#txtBrojProduljenja, #txtTrajanjeProduljenja"/>
            <action type="control attribute" value="#txtBrojProduljenja, #txtTrajanjeProduljenja">
              <parameter name="required" value="false"/>
            </action>
            <action type="control value" value="txtBrojProduljenja, #txtTrajanjeProduljenja">
              <parameter value="null"/>
            </action>
          </action>
        </event>
      </comboedit>
    </item>
    <item row="4" col="1" caption="Broj produljenja">
      <textedit name="txtBrojProduljenja" datavalue="~dtGetDetails.@BrojProduljenja" format="n0">
        <event type="valuechanged">
          <action type="control value" value="#txtBrojProduljenja" if="#txtBrojProduljenja&lt;1">
            <parameter value="1"/>
          </action>
        </event>
      </textedit>
    </item>
    <item row="5" col="1" caption="Trajanje produljenja">
      <textedit name="txtTrajanjeProduljenja" datavalue="~dtGetDetails.@TrajanjeProduljenja" format="n0">
        <event type="valuechanged">
          <action type="control value" value="#txtTrajanjeProduljenja" if="#txtTrajanjeProduljenja&lt;1">
            <parameter value="1"/>
          </action>
        </event>
      </textedit>
    </item>
    <item row="6" col="1" caption="Datum potpisivanja ugovora">
      <dateedit name="datDatumPotpisivanja" datavalue="~dtGetDetails.@DatumPotpisivanjaUgovora"/>
    </item>
    <item row="7" col="1" caption="Datum početka važenja ugovora">
      <dateedit name="datDatumPocetka" datavalue="~dtGetDetails.@DatumPocetkaVazenjaUgovora"/>
    </item>
    <item row="8" col="1" caption="Datum prestanka važenja ugovora">
      <dateedit name="datDatumPrestanka" datavalue="~dtGetDetails.@DatumPrestankaVazenjaUgovora"/>
    </item>
    <item row="9" col="1" caption="Ugovor produljen do:">
      <dateedit name="datUgovorProduljenDo" datavalue="~dtGetDetails.@UgovorProduljenDo"/>
    </item>
    <item row="10" col="1" caption="Procijenjeni datum prestanka važenja ugovora">
      <dateedit name="datProcDatumPrestanka" datavalue="~dtGetDetails.@ProcijenjeniDatumPrestanka"/>
    </item>
    <item row="11" col="1" caption="Otkazni rok Tele2">
      <textedit name="txtOtkazniRokTele2" datavalue="~dtGetDetails.@OtkazniRokTele2" format="n0">
        <event type="valuechanged">
          <action type="control value" value="#txtOtkazniRokTele2" if="#txtOtkazniRokTele2&lt;0">
            <parameter value="0"/>
          </action>
        </event>
      </textedit>
    </item>
    <item row="1" col="2" caption="Otkazni rok partnera">
      <textedit name="txtOtkazniRokPartner" datavalue="~dtGetDetails.@OtkazniRokPartner" format="n0">
        <event type="valuechanged">
          <action type="control value" value="#txtOtkazniRokPartner" if="#txtOtkazniRokPartner&lt;0">
            <parameter value="0"/>
          </action>
        </event>
      </textedit>
    </item>
    <item row="2" col="2" caption="Obavijesni period">
      <textedit name="txtObavijesniPeriod" datavalue="~dtGetDetails.@ObavijesniPeriod" format="n0">
        <event type="valuechanged">
          <action type="control value" value="#txtObavijesniPeriod" if="#txtObavijesniPeriod&lt;0">
            <parameter value="0"/>
          </action>
        </event>
      </textedit>
    </item>
    <item row="3" col="2" caption="Datum primopredaje">
      <dateedit name="datDatumPrimopredaje" datavalue="~dtGetDetails.@DatumPrimopredaje"/>
    </item>
