    <item row="4" col="2" caption="Odgovorna osoba">
      <searchedit name="srcOsobe" fieldtext="Osoba" fieldvalue="OsobeId" dataname="~dtOdgovornaOsoba"  required="true"
      datavalue="~dtGetDetails.@OsobeId" datatext="~dtGetDetails.@Osoba"/>
    </item>
    <item row="5" col="2" caption="Organizacijska jedinica">
      <searchedit name="srcOrgShema" fieldvalue="OrgShemaId" fieldtext="Naziv" dataname="~dtGetOrgShema" required="true"
      datavalue="~dtGetDetails.@OrgShemaId" datatext="~dtGetDetails.@OrgShema"/>
    </item>
    <item row="6" col="2" caption="Poseban ugovor za struju">
      <checkedit name="chkZasebanUgovor">
        <event type="checkedchanged">
          <action if="#chkZasebanUgovor==true">
            <action type="control enable" value="#srcTrazilicaUgovora"/>
            <action type="control attribute" value="srcTrazilicaUgovora">
              <parameter name="required" value="true"/>
            </action>
          </action>
          <action else="">
            <action type="control disable" value="#srcTrazilicaUgovora"/>
            <action type="control value"  value="#srcTrazilicaUgovora">
              <parameter value="null"/>
            </action>
            <action type="control attribute" value="srcTrazilicaUgovora">
              <parameter name="required" value="false"/>
            </action>
          </action>
        </event>
      </checkedit>
    </item>
    <item row="7" col="2" caption="Ugovor za struju">
      <searchedit name="srcTrazilicaUgovora" fieldtext="Broj" fieldvalue="UgovoriNajamGlaId" dataname="~dtSearchUgovoriPoVrsti"
            datavalue="~dtGetDetails.@StrujaUgovorId" datatext="~dtGetDetails.@StrujaUgovorBroj"/>
    </item>
  </part>
</parts>