    </item>
    <item row="6" col="2" caption="Broj prethodnog ugovora">
      <searchedit name="srcBrojPrethodnogUgovora" dataname="~dtSearchUgovoriPoStatusu" datavalue="~dtGetDetails.@PrethodniUgovorId" datatext="~dtGetDetails.@BrojPrethodnogUgovora" fieldtext="Broj" fieldvalue="UgovoriNajamGlaId"/>
