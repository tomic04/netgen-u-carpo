<parts>
  <part name="partGlaRekap">
    <event type="load">
		<action type="control populate" value="#grdGlaRekap"></action>		
    </event>
    <layout itemspadding="3">
      <group cols="1" rows="1" groupbordervisible="False">
          <item col="1" row="1">
			<grid name="grdGlaRekap" dataname="dtGlaRekap">
				<fields>
					<field name="Sifra" caption="Šifra" />
					<field name="Naziv" caption="Naziv" />
					<field name="Kolicina" caption="Količina" formatstring="n3"/>
					<field name="KolicinaPlan" caption="Količina plan" formatstring="n3"/>
					<field name="JM" caption="JM" />
					<field name="Kontingent" caption="Kontingent" />
					<field name="Klasa" caption="Klasa robe" />
				</fields>					  
			</grid>    
          </item>		  
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnOdustaniRekap" caption="IZLAZ" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spSklad_Gla_Rekapitulacija" name="dtGlaRekap">
        <parameter name="@list" value="parent.#grdGlava.selectedids"/>
        <parameter name="@VrstaPromSifra" value="global.$VrstaPromSifra"/>
      </data>
    </datalist>
  </part>
</parts>