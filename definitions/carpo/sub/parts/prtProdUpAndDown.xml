    <parts>
        <part name="UpDown">
			<group padding="0" groupbordervisible="false" cols="1" rows="2" col="2" row="1" >							
				<columnsdefinition>
					<column size="42" position="1" />
				</columnsdefinition>
				<item row="1" col="1" textvisible="False" spacing="3,0,0,0">
					<button name="btnMoveUp" image="top" caption=""  imagelocation="middlecenter">
						<event type="click">
							<action type="datarun nonquery" value="~dtBtnUp"/>
							<action type="control populate" value="#grdRoba" />
						</event>
					</button>
				</item>
				<item row="2" col="1" textvisible="False" spacing="3,0,0,0">
					<button name="btnMoveDown" image="bottom" caption=""  imagelocation="middlecenter">
						<event type="click">
							<action type="datarun nonquery" value="~dtBtnDown"/>
							<action type="control populate" value="#grdRoba" />
						</event>
					</button>
				</item>									
			</group>	
        </part>
    </parts>