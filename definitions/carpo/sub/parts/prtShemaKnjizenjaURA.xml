<parts>
	<part name="prtUnosMaster">
		<group cols="6" rows="4" bordervisible="true">
			<item col="1" row="1" colspan="6" caption="Naziv:" textposition="left">
				<textedit name="txtNaziv" required="true" datavalue="~dtGet.Naziv"/>
			</item>
			<item col="1" row="2" colspan="6" caption="Konto:" textposition="left" >
				<comboedit name="cmbKonto" allownull="false" dataname="~dtComboKonto" displayfield="Naziv" valuefield="KntPlanAId" datavalue="~dtGet.@KntPlanAId" />
			</item>
			<item col="1" row="3" colspan="6" caption="Konto devizni:" textposition="left" >
				<comboedit name="cmbKontoDev" allownull="false" dataname="~dtComboKontoDev" displayfield="Naziv" valuefield="KntPlanAId" datavalue="~dtGet.@KntPlanAId_Dev"/>
			</item>
			<item col="1" row="4" colspan="6" caption="Vrsta dokumenta:" textposition="left" >
				<comboedit name="cmbVrstaDok" allownull="false" dataname="~dtComboVrstaDok" displayfield="Naziv" valuefield="VrstaDokId" datavalue="~dtGet.@VrstaDokId"/>
			</item>
		</group>
	</part>
</parts>