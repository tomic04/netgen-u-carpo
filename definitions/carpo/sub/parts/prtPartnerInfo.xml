<parts>
	<part name="prtRefreshPartner">							
		<action type="datarun reader" value="~dtGetPartnerOpcenito"/> 
		<action type="datarun reader" value="~dtGetPartnerLogo"/> 	
		<action type="control refreshvalue" value="#txtAdresa,#txtMjesto,#txtOIB,#txtEmail,#txtWeb,#txtTelefon1,#txtTelefon2,#memMemo,#txtPosSifra,#txtPosMatBr,#txtFaxFirme,#txtOsnDjelatnost,
														#memAdresaPosta,#cmbNacinPlacanja,#txtMatBroj,#txtTrosarinskiBroj,#txtMIBPGBroj,#cmbMIBPGStatus,#txtIBK,#txtSluzbeniNaziv,#txtNaziv2,#chePDVSustav,#cheR2Racuni,#txtNaziv"/>											
			<action type="control value" value="#picLogo">
				<parameter value="null"/>
			</action>			
		<action type="control attribute" value="#picLogo">
			<parameter name="dbimg" value="~dtGetPartnerLogo.@Slika"/>
		</action>	
	
		<action if="$SelectedTabIndex==0">
			<!-- <action type="datarun reader" value="~dtGetPartnerOpcenito"/>  -->
			<action type="control refreshvalue" value="#txtAdresa,#txtMjesto,#txtOIB,#txtEmail,#txtWeb,#txtTelefon1,#txtTelefon2,#memMemo,#txtPosSifra,#txtPosMatBr,#txtFaxFirme,#txtOsnDjelatnost"/>		
			<action type="control populate" value="#grdKljucniKontakti"/>				
		</action>
		<action type="control populate" value="#grdLokacije" elseif="$SelectedTabIndex==2"/>
		<action type="control populate" value="#grdOsobe" elseif="$SelectedTabIndex==3"/>
		<action type="control populate" value="#grdBankovniRacuni" elseif="$SelectedTabIndex==4"/>	
		<action type="control populate" value="#grdStanje" elseif="$SelectedTabIndex==5"/>	
		<action type="control populate" value="#grdKlasePartnera" elseif="$SelectedTabIndex==6"/>
		<!-- <action type="control populate" value="#grdKlaseLokacija" elseif="$SelectedTabIndex==6"/>	 -->
		<action type="control populate" value="#grdBiljeske" elseif="$SelectedTabIndex==7"/>		
		<!-- <action type="control populate" value="#grdDokumenti" elseif="$SelectedTabIndex==10"/>	 -->
		<action type="control populate" value="#grdDjelatnosti" elseif="$SelectedTabIndex==9"/>			
	</part>
	<part name="prtRefreshVariable">
		<action type="variable value">
			<parameter name="NoviPartneriId" value="null" type="int"/>
			<parameter name="NoviParStruId" value="null" type="int"/>
			<parameter name="NoviParZiroId" value="null" type="int"/>
			<parameter name="global.$NoviPartneriId" value="null" type="int"/>
			<parameter name="global.$PartnerNaziv" value="null"/>
		</action>		
	</part>
	<part name="prtIzmijeni">
		<action type="datarun scalar" value="~dtPermissionIzmijeni">
			<parameter name="SmijeIzmijeni"/>
		</action>
		<action if="$SmijeIzmijeni!=0">					
			<action  if="$SelectedTabIndex==0">
				<action type="form open" value="frmPartnerInfoEdit">
					<parameter name="PartneriId" value="global.$PartneriId"/>
				</action>
				<action if="global.$NoviPartneriId!=null">
					<action type="variable value">
						<parameter name="$Id" value="global.$PartneriId"/>
					</action>					
					<action type="infocontrols refresh"/>
					<action type="variable value">
						<parameter name="$Loading" value="1"/>
					</action>				
					<action type="control value" value="#srcInfo"  if="global.$PartneriId==global.$NoviPartneriId">
						<parameter value="global.$PartneriId" text="global.$PartnerNaziv"/>
					</action>			
					<action type="variable value">
						<parameter name="$Loading" value="0"/>
					</action>				
					<part name="prtRefreshPartner" path="prtPartnerInfo.xml"/>	
				</action>				
			</action>
			<action if="$SelectedTabIndex==1">
				<action type="form open" value="frmPartnerInfoEditDodatni">
					<parameter name="caption" value="Izmjena podataka"/>
					<parameter name="click" value="0"/>
					<parameter name="tip" value="Izmjena"/>
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>									
				</action>	
				<action type="datarun reader" value="~dtGetPartnerOpcenito"/>
				<action type="control refreshvalue" value="#memAdresaPosta,#cmbNacinPlacanja,#txtMatBroj,#txtTrosarinskiBroj,#txtMIBPGBroj,#cmbMIBPGStatus,#txtIBK,#txtSluzbeniNaziv,#txtNaziv2,#chePDVSustav,#cheR2Racuni"/>									
			</action>			
			<action if="$SelectedTabIndex==2">
				<action type="form open" value="frmPartnerInfoLokacije">
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>
					<parameter name="ParStruId" value="#grdLokacije.@parstruid"/>
					<parameter name="LokacijaNaziv" value="#grdLokacije.@Naziv lokacije"/>								
				</action>	
				<action type="control populate keepfocus" value="#grdLokacije,#grdKlaseLokacija"/>				
			</action>
			<action if="$SelectedTabIndex==3">
				<action type="form open" value="frmInfoOsobniInsert">
					<parameter name="caption" value="Izmjena podataka"/>
					<parameter name="click" value="0"/>
					<parameter name="tip" value="Izmjena"/>
					<parameter name="OsobeId" value="#grdOsobe.@OsobeId"/>
					<parameter name="LnOsoParId" value="#grdOsobe.@LnOsoParId"/>
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>	
					<parameter name="Izvor" value="PartnerInfo"/>
				</action>	
				<action type="control populate keepfocus" value="#grdOsobe"/>									
			</action>
			<action  if="$SelectedTabIndex==4">
				<action type="form open" value="frmPartnerInfoBankovni">
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>
					<parameter name="ParZiroId" value="#grdBankovniRacuni.@ParZiroId"/>
				</action>					
			</action>	
			<action  if="$SelectedTabIndex==6">
				<action type="form open" value="frmPartnerInfoKlasePartnera">
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>
					<parameter name="KlPartneriId" value="#grdKlasePartnera.@KlpartneriId"/>
				</action>					
			</action>	
			<!-- <action  if="$SelectedTabIndex==6"> -->
				<!-- <action type="form open" value="frmPartnerInfoKlaseLokacija"> -->
					<!-- <parameter name="PartneriId" value="global.$PartneriId"/> -->
					<!-- <parameter name="PartnerNaziv" value="#txtNaziv"/> -->
					<!-- <parameter name="LnParStruId" value="#grdKlaseLokacija.@LnParStruId"/> -->
					<!-- <parameter name="KlPartneriId" value="#grdKlaseLokacija.@KlPartneriId"/> -->
					<!-- <parameter name="ParStruId" value="#grdKlaseLokacija.@ParStruId"/>									 -->
				<!-- </action>					 -->
			<!-- </action>	 -->
			<action  if="$SelectedTabIndex==7">
				<action if="#grdBiljeske.@OperateriId==@@operateriid">
					<action type="form open" value="frmPartnerInfoBiljeske">
						<parameter name="PartneriId" value="global.$PartneriId"/>
						<parameter name="PartnerNaziv" value="#txtNaziv"/>
						<parameter name="ParKontaktId" value="#grdBiljeske.@ParKontaktId"/>								
					</action>
				</action>				
			</action>	
			<action  if="$SelectedTabIndex==8">
				<action type="form open" value="frmPartnerInfoMemo">
					<parameter name="Akcija" value="I"/>	
					<parameter name="PartneriId" value="global.$PartneriId"/>
					<parameter name="PartnerNaziv" value="#txtNaziv"/>							
				</action>					
			</action>								
		</action>
		<action type="message" value="Ne posjedujete prava na traženu akciju!" else=""/>	
	</part>
	<part name="frmPartnerInfoEditInit">	
		<action type="datarun nonquery" value="global.~dtTmpKlaseObrisiSve"/> 		
		<action type="datarun reader" value="global.~dtGetPartnerOpcenito"/> 
		<action type="datarun reader" value="global.~dtGetPartnerLogo"/> 	
		<action type="variable value">
			<parameter name="SamoTmpEdit" value="0"/>
		</action>		
	</part>
	<part name="frmPartnerInfoEditDodatniInit">			
		<action type="datarun reader" value="global.~dtGetPartnerOpcenito"/> 	
	</part>	
	<part name="frmPartnerInfoLokacijeInit">	
		<action type="datarun reader" value="global.~dtGetLokacija"/>	
		<action type="variable value">
			<parameter name="SamoTmpEdit" value="0"/>
		</action>			
	</part>	
	<part name="frmPartnerInfoBankovniInit">	
		<action type="datarun reader" value="global.~dtGetZiro"/>	
	</part>		
	<part name="frmPartnerInfoMemoInit">	
		<action type="datarun reader" value="global.~dtGetPartnerOpcenitoMemo"/> 	
	</part>		
	<part name="frmPartnerInfoEditLoad">	
		<action type="control value" value="#picLogo">
			<parameter value="null"/>
		</action>			
		<action type="control attribute" value="#picLogo">
			<parameter name="dbimg" value="global.~dtGetPartnerLogo.@Slika"/>
		</action>	
		<action type="control populate" value="#grdKlase"/>
	</part>	
	<part name="frmPartnerInfoEditShown">	
		<action type="form caption" value="Unos novog partnera" if="$PartneriId==null"/>
		<action type="form caption" value="Izmjena osnovnih podataka partnera {global.~dtGetPartnerOpcenito.@Naziv}" elseif="$PartneriId!=null"/>			
		<action type="control visible" value="#cmbNacinPlacanja" if="global.$PVKupUgovoriNacinPlac==0">
			<parameter value="false"/>
		</action>	
		<action type="control value" value="#chePDVSustav" if="$PartneriId==null">
			<parameter value="true"/>
		</action>
		<action type="control populate" value="#cmbKlase"/>
		<action type="control disable" value="#btnKlaseObrisi" if="#grdKlase.rowcount==0"/>
		<action type="control enable" value="#btnKlaseObrisi" else=""/>			
	</part>	
	<part name="frmPartnerInfoBankovniShown">
		<action type="form caption" value="Unos bankovnog računa partnera {$PartnerNaziv}" if="$ParZiroId==null"/>
		<action type="form caption" value="Izmjena bankovnog računa partnera {$PartnerNaziv}" elseif="$ParZiroId!=null"/>
		<action type="variable value" if="#cheParZiroDefault==true">
			<parameter name="ParZiroDefault" value="1"/>
		</action>
		<action type="variable value" elseif="#cheParZiroDefault==false">
			<parameter name="ParZiroDefault" value="0"/>
		</action>		
	</part>	
	<part name="frmPartnerInfoKlaseLokacijaShown">
		<action type="control value" value="#cmbKlaseLokacija" if="$KlPartneriId!=null">
			<parameter value="$KlPartneriId"/>
		</action>
		<action type="control value" value="#cmbLokacije" if="$ParStruId!=null">
			<parameter value="$ParStruId"/>
		</action>
		<action type="control visible" value="#cmbLokacije" if="$MasterInd==1">
			<action type="false"/>
		</action>		
		<action type="form caption" value="Unos nove klase lokacije" if="$KlPartneriId==null"/>
		<action type="form caption" value="Izmjena klase lokacije" elseif="$KlPartneriId!=null"/>
	</part>	
	<part name="frmPartnerInfoEditLayout">
		<layout caption="Opći podaci" itemspadding="0">
			<group cols="1" rows="2" groupbordervisible="false">
				<columnsdefinition>
					<column position="1" size="100%"/>
				</columnsdefinition>			
				<group col="1" row="1" cols="3" rows="6" caption="   ">
					<columnsdefinition>
						<column position="1" size="33%"/>
						<column position="2" size="33%"/>
						<column position="3" size="33%"/>
					</columnsdefinition>
					<item row="1" col="1" caption="OIB (porezni broj):"> 
						<textedit name="txtOIB" datavalue="global.~dtGetPartnerOpcenito.@PorezniBroj"/> 
					</item> 
					<group col="2" row="1" cols="2" rows="1" rowspan="1" groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="70%"/>
						<column position="2" size="30%"/>
					</columnsdefinition>	
						<item row="1" col="1" caption="Šifra:"> 
							<textedit name="txtSifra" datavalue="global.~dtGetPartnerOpcenito.@Sifra"/> 
						</item>					
						<!-- <item row="1" col="2" colspan="1" >  -->
							<!-- <button name="btnSudskiRegistar" caption="Sudski registar"/>  -->
						<!-- </item>  -->
					</group>					
					<!-- <item row="1" col="1" caption="Šifra:">  -->
						<!-- <textedit name="txtSifra" datavalue="~dtGetPartnerOpcenito.@Sifra"/>  -->
					<!-- </item>  -->
					<item row="2" col="1" colspan="2" caption="Naziv partnera:">
						<textedit name="txtNaziv" datavalue="global.~dtGetPartnerOpcenito.@Naziv"/>
					</item>
					<!-- <item row="4" col="1" colspan="2" caption="Službeni naziv:"> -->
						<!-- <textedit name="txtSluzbeniNaziv" datavalue="global.~dtGetPartnerOpcenito.@SluzbeniNaziv"/> -->
					<!-- </item>						 -->
					<!-- <item row="5" col="1" colspan="2" caption="Skraćeni naziv:"> -->
						<!-- <textedit name="txtNaziv2" datavalue="global.~dtGetPartnerOpcenito.@Naziv2"/> -->
					<!-- </item>						 -->
					<item row="3" col="1" colspan="2" caption="Osnovna djelatnost:"> 
						<comboedit name="cmbDjelatnost" datavalue="global.~dtGetPartnerOpcenito.@DjelatnostiId" autopopulate="true" valuefield="DjelatnostiId" displayfield="OznakaNaziv" dataname="global.~dtDjelatnost"/> 
					</item> 
					<item row="1" col="3" rowspan="6"> 
						<pictureedit name="picLogo" displaynoimage="true" rightclick="true"/>
					</item> 					

				</group>
				<group col="1" row="2" cols="3" rows="4" caption="   ">
					<columnsdefinition>
						<column position="1" size="33%"/>
						<column position="2" size="33%"/>					
						<column position="3" size="33%"/>
					</columnsdefinition>	
					<group row="1" col="1" colspan="3" rows="1" cols="2" groupbordervisible="false">
						<item row="1" col="1" caption="Adresa:"> 
							<textedit name="txtAdresa" datavalue="global.~dtGetPartnerOpcenito.@adresa"/> 
						</item> 
						<item row="1" col="2" caption="Mjesto:"> 
							<comboedit name="cmbMjesto" datavalue="global.~dtGetPartnerOpcenito.@MjestaId" autopopulate="true" valuefield="mjestaid" displayfield="NazivFull" dataname="global.~dtMjesto"/> 
						</item> 
					</group>
					<item row="2" col="1" caption="Poslovni telefon 1:"> 
						<textedit name="txtTelefon1" datavalue="global.~dtGetPartnerOpcenito.@Telefon1"/> 
					</item> 							
					<item row="2" col="2" caption="Poslovni telefon 2:"> 
						<textedit name="txtTelefon2" datavalue="global.~dtGetPartnerOpcenito.@Telefon2"/> 
					</item> 
					<item row="2" col="3" colspan="1" caption="Poslovni fax:"> 
						<textedit name="txtfax" datavalue="global.~dtGetPartnerOpcenito.@Fax"/> 
					</item> 				
					<item row="3" col="1" colspan="1" caption="Poslovni e-mail:"> 
						<textedit name="txtEmail" datavalue="global.~dtGetPartnerOpcenito.@Email" isemail="true"/> 
					</item> 
					<item row="3" col="2" colspan="2" caption="Korporativna web stranica:"> 
						<textedit name="txtWeb" datavalue="global.~dtGetPartnerOpcenito.@Www"/> 
					</item> 
				</group>					
			</group>
		</layout>
		<layout caption="Dodatni podaci" itemspadding="0">
			<part name="frmPartnerInfoEditDodatniLayout" path="prtPartnerInfo.xml"/>
		</layout>	
		<layout caption="Klase partnera" itemspadding="0">
			<group cols="1" rows="1" groupbordervisible="false">
				<group cols="5" rows="2" col="1" row="1" spacing="0,0,0,4" caption="Klase">
					<columnsdefinition>
						<column position="1" size="20%" />
						<column position="2" size="20%" />
						<column position="3" size="20%" />
						<column position="4" size="20%" />
						<column position="5" size="20%" />
					</columnsdefinition>
					<item row="1" col="1" colspan="3">
						<comboedit name="cmbKlase" allownull="false" required="true" autopopulate="true" valuefield="KlPartneriID" displayfield="Naziv" dataname="global.~dtKlase"/> 
					</item>
					<item row="1" col="4" >
						<button name="btnKlaseDodaj" caption="Dodaj">
							<event type="click">
								<action type="variable value">
									<parameter name="SamoTmpEdit" value="1"/>
								</action>
								<action if="#cmbKlase!=null">
									<action type="datarun nonquery" value="global.~dtTmpKlaseDodaj"/>
									<action type="control populate" value="#grdKlase"/>
									<action type="control populate" value="#cmbKlase"/>
									<action type="control disable" value="#btnKlaseObrisi" if="#grdKlase.rowcount==0"/>
									<action type="control enable" value="#btnKlaseObrisi" else=""/>									
								</action>	
							</event>
						</button>	
					</item>	
					<item row="1" col="5" >
						<button name="btnKlaseObrisi" caption="Obriši">
							<event type="click">
								<action type="variable value">
									<parameter name="SamoTmpEdit" value="1"/>
								</action>							
								<action type="datarun nonquery" value="global.~dtTmpKlaseObrisi"/>
								<action type="control populate" value="#grdKlase"/>
								<action type="control populate" value="#cmbKlase"/>
								<action type="control disable" value="#btnKlaseObrisi" if="#grdKlase.rowcount==0"/>
								<action type="control enable" value="#btnKlaseObrisi" else=""/>
							</event>
						</button>	
					</item>	
					<item row="2" col="1" colspan="5">
						<grid name="grdKlase" dataname="global.~dtTmpKlase" key="KlPartneriId" bestfitonrefresh="true" autopopulate="false" fieldsmartspaces="false" showgrouppanel="false">
							<fields inherited="true">
							</fields>
						</grid>
					</item>					
				</group>
			</group>			
		</layout>	
	</part>
	<part name="frmPartnerInfoEditDodatniLayout">
		<group cols="1" rows="1" groupbordervisible="false">
			<columnsdefinition>
				<column position="1" size="100%"/>
			</columnsdefinition>
			<group col="1" row="1" cols="3" rows="8" caption="   ">
				<columnsdefinition>
					<column position="1" size="33%"/>
					<column position="2" size="33%"/>
					<column position="3" size="33%"/>
				</columnsdefinition>	
				<item row="1" col="1" colspan="3" caption="Službeni naziv:">
					<textedit name="txtSluzbeniNaziv" datavalue="global.~dtGetPartnerOpcenito.@SluzbeniNaziv"/>
				</item>						
				<item row="2" col="1" colspan="3" caption="Skraćeni naziv:">
					<textedit name="txtNaziv2" datavalue="global.~dtGetPartnerOpcenito.@Naziv2"/>
				</item>		
				<item row="3" col="1" colspan="1" >
					<checkedit name="chePDVSustav" caption="Partner u sustavu PDV" datavalue="global.~dtGetPartnerOpcenito.@IndPDV">

					</checkedit>
				</item>
				<item row="3" col="2" colspan="1">
					<checkedit name="cheR2Racuni" caption="Partner prima R2 račune" datavalue="global.~dtGetPartnerOpcenito.@IndR2">

					</checkedit>						
				</item>				
				<item row="4" col="1" colspan="3" rowspan="3" caption="Adresa za slanje pošte:"> 
					<memoedit name="memAdresaPosta" datavalue="global.~dtGetPartnerOpcenito.@AdresaPosta"/> 
				</item> 
				<item row="7" col="1" colspan="1" caption="Način plaćanja:"> 
					<comboedit name="cmbNacinPlacanja" datavalue="global.~dtGetPartnerOpcenito.@NacinPlacanja" autopopulate="true" valuefield="ProNacinNaplateId" displayfield="Opis" dataname="global.~dtNacinNaplate"/> 
				</item> 	
				<item row="7" col="2" caption="Matični broj:"> 
					<textedit name="txtMatBroj" datavalue="global.~dtGetPartnerOpcenito.@MatBroj"/> 
				</item> 
				<item row="7" col="3" caption="Trošarinski broj:"> 
					<textedit name="txtTrosarinskiBroj" datavalue="global.~dtGetPartnerOpcenito.@TrosarinskiBroj"/> 
				</item> 					
				<item row="8" col="1" caption="MIBPG broj:"> 
					<textedit name="txtMIBPGBroj" datavalue="global.~dtGetPartnerOpcenito.@MIPIGBroj" maxlength="15"/> 
				</item> 	
				<item row="8" col="2" caption="MIBPG status:"> 
					<comboedit name="cmbMIBPGStatus" datavalue="global.~dtGetPartnerOpcenito.@MIPIGStatus" autopopulate="true" valuefield="mibpgid" displayfield="Naziv" dataname="global.~dtMIBPGstatus"/> 
				</item> 	
				<item row="8" col="3" caption="IBK broj:"> 
					<textedit name="txtIBK" datavalue="global.~dtGetPartnerOpcenito.@IBK"/> 
				</item> 
			</group>
		</group>
	</part>	
	<part name="frmPartnerInfoLokacijeLayout">
		<layout caption="Lokacija općenito" itemspadding="0">
			<group cols="2" rows="8" caption="   ">
				<columnsdefinition>
					<column position="1" size="50%"/>
					<column position="2" size="50%"/>
				</columnsdefinition>	
				<group row="1" col="1" cols="3" rows="1" colspan="2" groupbordervisible="false">
					<columnsdefinition>
						<column position="1" size="40%"/>
						<column position="2" size="40%"/>
						<column position="3" size="20%"/>
					</columnsdefinition>					
					<item row="1" col="1" caption="Šifra:">
						<textedit name="txtLokacijaSifra" datavalue="global.~dtGetLokacija.@Sifra"/>
					</item>
					<item row="1" col="2" caption="PDV ID:">
						<textedit name="txtLokacijaPDVID" datavalue="global.~dtGetLokacija.@PorezniBr"/>
					</item>		
					<group row="1" col="3" rows="2" cols="1" groupbordervisible="false">
					<rowsdefinition>
						<row position="1" size="35%"/>
						<row position="2" size="65%"/>
					</rowsdefinition>
						<item col="1" row="2">				
							<checkedit name="cheSjediste" caption="Sjedište" datavalue="global.~dtGetLokacija.@Sjediste">
								<event type="valuechanged">
									<action type="variable value" if="#cheSjediste==true">
										<parameter name="hq" value="1"/>
									</action>
									<action type="variable value" elseif="#cheSjediste==false">
