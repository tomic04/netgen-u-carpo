	<part name="frmPartnerInfoEditSpremi">
		<!--priprema-->
		<action type="datarun scalar" value="global.~dtGetDrzave">
			<parameter name="DrzaveId"/>
		</action>
		<!--provjere-->
		<action type="datarun reader" value="global.~dtObaveznaPolja"/>
		<action type="variable value">
			<parameter name="Failure" value="global.~dtObaveznaPolja.@Failure"/>
			<parameter name="Error" value="global.~dtObaveznaPolja.@Poruka"/>
		</action>
		<action if="$Failure==1">
			<action type="message" value="{$Error}"/>
		</action>
		<action else="">							
			<action type="datarun reader" value="global.~dtValidatePartnera"/>
			<action type="variable value">
				<parameter name="Failure" value="global.~dtValidatePartnera.@Failure"/>
				<parameter name="Error" value="global.~dtValidatePartnera.@Poruka"/>
			</action>
			<action if="$Failure==1">
				<action type="message" value="{$Error}"/>
			</action>
			<action else="">
				<action type="datarun reader" value="global.~dtUnesiIzmijeniPartnera"/>
				<action type="variable value">
					<parameter name="NoviPartneriId" value="global.~dtUnesiIzmijeniPartnera.@PartneriId"/>
				</action>								
				<action if="$NoviPartneriId!=null">
					<!-- <action if="$PartneriId==null"> -->
						<action type="datarun nonquery" value="global.~dtUnesiIzmijeniKlase"/>
						<action type="variable value">
							<parameter name="global.$PartneriId" value="$NoviPartneriId"/>
							<parameter name="global.$NoviPartneriId" value="$NoviPartneriId"/>
							<parameter name="global.$PartnerNaziv" value="#txtNaziv"/>
						</action>							
					<!-- </action> -->
					
					<action type="form close" if="$MasterInd!=1"/>						
				</action>
			</action>
		</action>	
	</part>
	<part name="frmPartnerInfoLokacijeSpremi">
