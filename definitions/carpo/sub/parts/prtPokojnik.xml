    <parts>
        <part name="ProdPokojnik">
		<event type="oninit">
			<action type="datarun reader" value="Global.dtPokojnikQuery" />
			<action type="variable value" >
				<parameter name="FaktureDodatnaId" value="~dtPokojnikQuery.@FaktureDodatnaId"/>
			</action>		
		</event>
		<event type="onload">
			<action type="control populate" value="#grdVlasnik" />
		</event>
		<event type="onclose">
			<action type="datarun reader" value="~dtUdioProvjera"/>
			<action type="variable value">
				<parameter name="Udio" value="~dtUdioProvjera.@Udio" />
			</action>
			<action type="message" value="Niste dobro definirali udio vlasništva!" if="$Udio&lt;100&amp;&amp;$Udio&gt;=0"/>						
		</event>			
			<layout>
				<group cols="1" rows="1" col="1" row="1" backgroundcolor="" groupbordervisible="False">
					<tabs row="1" col="1" padding="4" backgroundcolor="">
						<group caption="Osnovno" name="tabOsnovno" cols="1" rows="3" row="1" col="1" groupbordervisible="false">			
							<columnsdefinition>
								<column size="420" position="1" />
							</columnsdefinition>							
							<item caption="Broj ugovora:" row="1" col="1" fontbold="false" >
								<textedit name="txtBrojUgovora" datavalue="#dtPokojnikQuery.@BrojUgovora" fontbold="false" />
							</item>			
							<item caption="Pokojnik:" row="2" col="1" fontbold="false"> 
								<searchedit netgenfields="false" name="srcPokojnik" required="" fontbold="true" dataname="~dtPokojnik" fieldtext="ImePrezime" fieldvalue="PokojniciID" datavalue="#dtPokojnikQuery.@PokojniciID" datatext="#dtPokojnikQuery.@Pokojnik">
									<event type="valuechanged" raiseonload="false">
										<action type="datarun reader" value="~dtGetPokojnik" if="#srcPokojnik!=null"/>
										<action type="control value" value="#txtGroblje" if="#srcPokojnik!=null">
											<parameter value="~dtGetPokojnik.@Groblje"/>
										</action>
										<action type="control value" value="#txtParcela" if="#srcPokojnik!=null">
											<parameter value="~dtGetPokojnik.@Parcela"/>
										</action>
										<action type="control value" value="#txtPolje" if="#srcPokojnik!=null">
											<parameter value="~dtGetPokojnik.@Polje"/>
										</action>
										<action type="control value" value="#txtRed" if="#srcPokojnik!=null">
											<parameter value="~dtGetPokojnik.@Red"/>
										</action>
										<action type="control value" value="#txtGrob" if="#srcPokojnik!=null">
											<parameter value="~dtGetPokojnik.@Grob"/>
										</action>							
									</event>
								</searchedit>
							</item>
							<group caption="Podatci o grobnom mjestu" cols="1" rows="4" row="3" col="1" groupbordervisible="true">	
								<columnsdefinition>
									<column size="420" position="1" />	
								</columnsdefinition>							
								<item caption="Groblje:" row="1" col="1" fontbold="false" >
									<textedit name="txtGroblje" datavalue="#dtPokojnikQuery.@Groblje" fontbold="false" />
								</item>	
								<item caption="Parcela:" row="2" col="1" fontbold="false" >
									<textedit name="txtParcela" datavalue="#dtPokojnikQuery.@Parcela" fontbold="false" />
								</item>	
								<item caption="Polje:" row="3" col="1" fontbold="false" >
									<textedit name="txtPolje" datavalue="#dtPokojnikQuery.@Polje" fontbold="false" />
								</item>	
								<group cols="2" rows="2" col="1" row="4" colspan="" backgroundcolor="" groupbordervisible="false">
									<item caption="Red:" row="1" col="1" fontbold="false" >
										<textedit name="txtRed" datavalue="#dtPokojnikQuery.@Red" fontbold="false" />
									</item>	
									<item caption="Grob:" row="1" col="2" fontbold="false" >
										<textedit name="txtGrob" datavalue="#dtPokojnikQuery.@Grob" fontbold="false" />
									</item>	
									<item caption="Opći broj:" row="2" col="1" fontbold="false" >
										<textedit name="txtOpciBroj" datavalue="#dtPokojnikQuery.@OpciBroj" fontbold="false" />
									</item>				
									<item caption="Površina:" row="2" col="2" fontbold="false" >
										<textedit name="txtPovrsina" datavalue="#dtPokojnikQuery.@Povrsina" fontbold="false" />
									</item>
								</group>
							</group>
						</group>
						<group caption="Vlasnici" name="tabVlasnici" cols="1" rows="2" row="1" col="1" groupbordervisible="false">
							<group cols="3" rows="1" col="1" row="1" backgroundcolor="" groupbordervisible="false">		
								<columnsdefinition>
									<column size="100%" position="1" />
									<column size="120" position="2" />																		
									<column size="65" position="3" />	
								</columnsdefinition>							
								<item caption="Vlasnik:" row="1" col="1" fontbold=""> 
									<searchedit netgenfields="true" name="srcVlasnik" required="" fontbold="" dataname="Global.dtVlasnik" fieldtext="NazivId" fieldvalue="partneriid" />					
								</item>
								<item caption="Udio vlasništva (%):" row="1" col="2" fontbold="" >
									<textedit name="txtVlasnikPostotak" datavalue="" format="n2" fontbold="" nulltext=""/>
								</item>	
								<item row="1" col="3" textvisible="False" >
									<button name="btnAddVlasnik" caption="Dodaj" image="add" type="add" >
										<event type="click">
											<!-- <action type="tab focus" value="tabOsnovno" if="#srcPokojnik==null"/> -->
											<action type="validate"/>										 
											<action type="datarun scalar" value="~dtSpremiPokojnika" if="$FaktureDodatnaId==null">
												<parameter name="FaktureDodatnaId" value="$FaktureDodatnaId" />
											</action>
											<action type="datarun nonquery" value="~dtSpremiPokojnika" if="$FaktureDodatnaId!=null"/>											
											<action type="datarun nonquery" value="~dtUnosVlasnik"/>
											<action type="control populate" value="#grdVlasnik" />
											<action type="control refreshvalue" value="#srcVlasnik,#txtVlasnikPostotak">
												<parameter value=""/>
											</action>
											<action type="control focus" value="#srcVlasnik" />
										</event>
									</button>	
								</item>								
							</group>							
							<group cols="2" rows="2" col="1" row="2" colspan="" backgroundcolor="" groupbordervisible="false">
								<columnsdefinition>
									<column size="100%" position="1" />
									<column size="65" position="2" />	
								</columnsdefinition>							
								<item row="1" col="1" highlight="False" rowspan="2">
									<grid name="grdVlasnik" multiselect="true" key="FaktureDodatna_LnVlasniciId" showautofilterrow="false" showgrouppanel="False" showfilter="false" showfooter="true" savelayout="true">
										<data command="spProd_FaktureDodatna_LnVlasnici_Grid" >
											<parameter name="@FaktureDodatnaId" value="$FaktureDodatnaId" />
										</data>
										<fields>
											<field name="Vlasnik" caption="Vlasnik" />										
											<field name="UdioVlasnistva" caption="Udio vlasništva (%)" editable="true" format="n2"/>
										</fields>
										<event type="cellvaluechanged">
											<action type="variable value">
												<parameter name="Tablica" value="FaktureDodatna_LnVlasnici" type="string" />
											</action>
											<action type="variable value">
												<parameter name="focusedvalue" value="#grdVlasnik.focusedvalue" />
											</action>
											<action type="variable value">
												<parameter name="focusedfield" value="#grdVlasnik.focusedfield"/>
											</action>
											<action type="variable value">
												<parameter name="GridId" value="#grdVlasnik.@FaktureDodatna_LnVlasniciId" type="int" />
											</action>											
											<action type="datarun nonquery" value="~dtEditGrid"/> 
											<action type="control populate keepfocus" value="#grdVlasnik"/> 
										</event>										
									</grid>										
								</item>
								<group cols="1" rows="2" col="2" row="1" colspan="" backgroundcolor="" groupbordervisible="false">	
									<rowsdefinition>
										<row size="48" position="1" />									
									</rowsdefinition>									
									<item row="1" col="1" textvisible="False" rowspan="1">
										<button name="btnDelVlasnik" caption="Obriši" image="delete" type="delete">
											<event type="click">
												<action type="control foreachrow selected" value="#grdVlasnik">									
													<action type="datarun nonquery" value="~dtBrisanjeVlasnik"/>
												</action>									
												<action type="control populate" value="#grdVlasnik" />
											</event>
										</button>
									</item>
								</group>							
							</group>							
						</group>
					</tabs>	
				</group>				
			</layout>			
			<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="&amp;SPREMI" type="add" dock="right">
						<event type="click">
							<action type="validate"/>						
							<action type="datarun nonquery" value="~dtSpremiPokojnika"/>			
							<action type="form close"/>
						</event>
					</button>
					<button caption="ODUSTANI" type="cancel" dock="right"/>				
				</buttons>
			</panelbuttons>			
			<datalist>
				<data command="spPokojniciQuery" name="dtPokojnik">
					<parameter name="@Action" value="0" />
					<parameter name="@String" value="#srcPokojnik.text" />
				</data>
				<data command="spPokojniciQuery" name="dtGetPokojnik">
					<parameter name="@Action" value="1" />
					<parameter name="@Id" value="#srcPokojnik" />
				</data>	
				<data command="spFaktureDodatnaAzur" name="dtSpremiPokojnika">
					<parameter name="@Action" value="1" if="$FaktureDodatnaId!=null"/>				
					<parameter name="@Action" value="0" if="$FaktureDodatnaId==null"/>
					<parameter name="@ID" value="$FaktureDodatnaId" type="int"/>
					<parameter name="@FaktureId" value="$FaktureId" />
					<parameter name="@ProPonGlaId" value="$ProPonGlaId" />
					<parameter name="@BrojUgovora" value="#txtBrojUgovora" />
					<parameter name="@Pokojnik" value="#srcPokojnik.text" />
					<parameter name="@Parcela" value="#txtParcela" />
					<parameter name="@Polje" value="#txtPolje" />
					<parameter name="@Red" value="#txtRed" />
					<parameter name="@Grob" value="#txtGrob" />
					<parameter name="@OpciBroj" value="#txtOpciBroj" />
					<parameter name="@Povrsina" value="#txtPovrsina" />
					<parameter name="@Groblje" value="#txtGroblje" />
					<parameter name="@PokojniciId" value="#srcPokojnik" type="int"/>
				</data>
				<data command="spProd_FaktureDodatna_LnVlasnici_Unos" name="dtUnosVlasnik">
					<parameter name="@FaktureDodatnaId" value="$FaktureDodatnaId" />
					<parameter name="@PartneriId" value="#srcVlasnik" />
					<parameter name="@UdioVlasnistva" value="#txtVlasnikPostotak" />
				</data>			
				<data command="spProd_FaktureDodatna_LnVlasnici_Brisanje" name="dtBrisanjeVlasnik">
					<parameter name="@FaktureDodatna_LnVlasniciId" value="#grdVlasnik.@FaktureDodatna_LnVlasniciId" />
				</data>	
				<data command="spProd_FaktureDodatna_UdioProvjera" name="dtUdioProvjera">
					<parameter name="@FaktureDodatnaId" value="$FaktureDodatnaId" />
				</data>					
				<data command="spProd_GradUgovori_EditGrid" name="dtEditGrid">
					<parameter name="@tablica" value="$Tablica"/>	
					<parameter name="@vrijednost" value="$focusedvalue" />
					<parameter name="@kolona" value="$focusedfield" />
					<parameter name="@id" value="$GridId" />			
				</data>					
			</datalist>
        </part>
    </parts>