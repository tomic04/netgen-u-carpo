<parts>
	<part name="prtCassaScontoUnosMaster">
		<group cols="6" rows="2" bordervisible="true">
			<item col="1" row="1" colspan="3" caption="Partner:" textposition="left">
				<searchedit name="srcPartner" allownull="false" dataname="~dtSrcPartneri" displayfield="Partneri Naziv" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@Partneri Naziv" />
			</item>
			<item col="5" row="1" colspan="2" caption="Broj:" textposition="left">
				<textedit name="txtBroj" required="false" datavalue="~dtGet.@Broj" />
			</item>
			<item col="1" row="2" colspan="2" caption="Datum:" textposition="left">
				<dateedit name="datCSDatum" value="now" required="false" datavalue="~dtGet.@Datum" />
			</item>
			<item col="6" row="2" colspan="2">
				<button name="btnStavke" caption="Stavke" image="rightend" imagelocation="middleright">
					<event type="click">
						<action type="validate" />
						<action type="datarun scalar" value="~dtUnosZaglavlja">
							<parameter name="KntDobrabatglaId" />
						</action>
						<action type="control disable" value="#srcPartner, #txtBroj, #datCSDatum">
						<action type="control enable" value="#btnStavkeUnesi, #btnStavkeIzmijeni, #btnStavkeObriši" />
						</action>
						<action type="datarun scalar" value="~dtGlavniScope">
							<parameter name="#grdGlava.@KntDobRabatGlaId" />
						</action>
						<action type="control focus" value="parent.#grdGlava">
						<parameter value="$KntDobRabatGlaId"  type="int" />
						</action>
					</event>
				</button>
			</item>
		</group>
	</part>
</parts>
