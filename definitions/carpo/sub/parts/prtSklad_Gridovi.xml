<parts>
	<part name="partMasterGrid">
		<grid name="grdGlava" type="master" async="true" key="SktPrometGlaId" keyfield="SktPrometGlaId" dataname="global.dtGlava" searchfield="SktPrometGlaId" multiselect="true" bestfitonrefresh="true" savelayout="true">
			<event type="focusedrowchanged">
				<action type="variable value">
					<parameter name="SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />
				</action>				
				<action type="control populate" value="#grdDetalj"/>											
				<action type="control populate" value="#grdDimenzije" if="global.$IndDimenzije==1"/>											
				<action type="control enable" value="#btnIzmijeni, #btnKopiraj, #btnWMS, #btnRekapitulacija, #btnProvedi" if="#grdGlava.rowcount&gt;0"/>
				<action type="control disable" value="#btnIzmijeni, #btnKopiraj, #btnWMS, #btnRekapitulacija, #btnProvedi" else=""/>
				<action type="control enable" value="#btnPromijeniStatus" if="#grdGlava.rowcount&gt;0&amp;&amp;#grdGlava.@Zaključeno!=Zaključen"/>
				<action type="control disable" value="#btnPromijeniStatus" else=""/>
				<action type="control disable" value="#btnStorniraj" if="#grdGlava.rowcount==0||#grdGlava.@Storno&gt;0||#grdGlava.@Zaključeno!=Zaključen"/>
				<action type="control enable" value="#btnStorniraj" else="" />	
				<action type="control disable" value="#btnObrisi" if="#grdGlava.rowcount==0||#grdGlava.@Status==2||#grdGlava.@Status==0||#grdGlava.@Smije==0"  />
				<action type="control enable" value="#btnObrisi"  else="" />
				<action type="control disable" value="#btnPrint" if="#grdGlava.rowcount==0||#grdGlava.@SmijeIspisati==0"/>
				<action type="control enable" value="#btnPrint" else=""/>				
			</event>
			<event type="doubleclick">
				<action type="variable value" value="Global.$DokId">
					<parameter value="#grdGlava.@SktPrometGlaId" />
				</action>			
				<action type="variable value">
					<parameter name="Objekt" value="Global.$ImeGranule" type="string" />
				</action>
				<action type="variable value">
					<parameter name="Funkcija" value="Edit" type="string" />
				</action>
				<action type="datarun scalar" value="Global.dtCheckPermission">
					<parameter name="Smije"/>
				</action>		
				<action type="form open" value="frmSkladGlaIzmjena" if="#grdGlava.rowcount&gt;0&amp;&amp;$Smije==1">
					<parameter name="SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />
					<parameter name="Status" value="#grdGlava.@Status" />
					<parameter name="Smije" value="#grdGlava.@Smije" />
				</action>
				<action type="control refreshrow" value="#grdGlava">
					<parameter value="Global.dtGlaRefreshRow"/>
				</action>	
				<action type="control populate" value="#grdDetalj" />
				<action type="control populate" value="#grdDimenzije" if="global.$IndDimenzije==1"/>											
				<action type="control enable" value="#btnPromijeniStatus" if="#grdGlava.rowcount&gt;0&amp;&amp;#grdGlava.@Zaključeno!=Zaključen"/>
				<action type="control disable" value="#btnPromijeniStatus" else=""/>
				<action type="control disable" value="#btnStorniraj" if="#grdGlava.rowcount==0||#grdGlava.@Storno&gt;0||#grdGlava.@Zaključeno!=Zaključen"/>
				<action type="control enable" value="#btnStorniraj" else="" />	
				<action type="control disable" value="#btnObrisi" if="#grdGlava.rowcount==0||#grdGlava.@Status==2||#grdGlava.@Status==0||#grdGlava.@Smije==0"  />
				<action type="control enable" value="#btnObrisi"  else="" />
				<action type="control disable" value="#btnPrint" if="#grdGlava.rowcount==0||#grdGlava.@SmijeIspisati==0"/>
				<action type="control enable" value="#btnPrint" else=""/>				
			</event>
			<event type="keydown">
				<action if="key==46&amp;&amp;#grdGlava.rowcount&gt;0&amp;&amp;#grdGlava.@Status!=2&amp;&amp;#grdGlava.@Status!=0&amp;&amp;#grdGlava.@Smije!=0">
					<action type="datarun scalar" value="Global.dtOperaterLock"/>
					<action type="confirm" value="Želite li obrisati dokument br. {#grdGlava.@Broj}?">
						<action type="datarun nonquery" value="Global.dtGlavaObrisi" >
							<action type="control populate" value="#grdGlava" />
						</action>
					</action>
				</action>
			</event>			
			<menu>	
				<menuitem name="menVratiStatus" caption="VRATI STATUS" sort="1" function="VratiStatus">
					<event type="click">
						<action type="variable value">
							<parameter name="VratiStatus" value="1" type="int" />
						</action>						
						<action type="datarun scalar" value="Global.dtOperaterLock"/>
						<action type="datarun scalar" value="Global.dtStatusiProvjera"/>	
						<action type="form open" value="frmPromijeniStatus"  if="#grdGlava.rowcount&gt;0">
							<parameter name="SktPrometGlaId" value="#grdGlava.@SktPrometGlaId" />
							<parameter name="StatusiId" value="#grdGlava.@StatusiId" />
							<parameter name="VratiStatus" value="$VratiStatus" />
							<parameter name="NaslovTekst" value="Vrati status" />
						</action>
						<action type="control refreshrow" value="#grdGlava">
							<parameter value="Global.dtGlaRefreshRow"/>
						</action>
						<!-- <action type="control populate" value="#grdDetalj" /> -->
						<!-- <action type="control populate" value="#grdDimenzije" if="global.@IndDimenzije==1"/>											 -->
						<action type="control enable" value="#btnPromijeniStatus" if="#grdGlava.rowcount&gt;0&amp;&amp;#grdGlava.@Zaključeno!=Zaključen"/>
						<action type="control disable" value="#btnPromijeniStatus" else=""/>
						<action type="control disable" value="#btnStorniraj" if="#grdGlava.rowcount==0||#grdGlava.@Storno&gt;0||#grdGlava.@Zaključeno!=Zaključen"/>
						<action type="control enable" value="#btnStorniraj" else="" />	
						<action type="control disable" value="#btnObrisi" if="#grdGlava.rowcount==0||#grdGlava.@Status==2||#grdGlava.@Status==0||#grdGlava.@Smije==0"  />
						<action type="control enable" value="#btnObrisi"  else="" />
						<action type="control disable" value="#btnPrint" if="#grdGlava.rowcount==0||#grdGlava.@SmijeIspisati==0"/>
						<action type="control enable" value="#btnPrint" else=""/>						
					</event>					
				</menuitem>	
				<menuitem caption="POVIJEST STATUSA" sort="2">
					<event type="click">
						<action type="form open" value="frmPovijestStatusa"/>
					</event>
				</menuitem>					
			</menu>
			<fields>
				<field name="VrstaDok" caption="Vrsta dokumenta" />
				<field name="broj" caption="Dokument" fixed="left" fontbold="true" />
				<field name="datumdok" caption="Datum" />
				<field name="Izvorni dokument" caption="Opis" />
				<field name="Partner" caption="Partner" />
				<field name="lokacija" caption="Lokacija" />
				<field name="Skladište" caption="global.$SkladisteCaption" />
				<field name="SkladišteUlaza" caption="global.$SkladisteUlazaCaption"/>
				<field name="Operater" caption="Operater" />
				<field name="Zaključeno" caption="Zaključeno" />
				<field name="StatusKorak" caption="Status" />		
				<field name="Radni nalog" caption="Radni nalog" />
				<field name="Org. shema" caption="Org. jedinica" />
				<field name="Odg. osoba" caption="Odg. osoba" />
				<field name="Napomena" caption="Napomena" />
				<field name="Knjiženo" caption="Knjiženo" />	
				<field name="Status" caption="Status" visible="false"/>
				<field name="rowforecolorid" caption="rowforecolorid" visible="false"/>
				<field name="Smije" caption="Smije" visible="false"/>
				<field name="Osoba" caption="Osoba"/>
				<field name="WMSbroj" caption="WMS broj"/>
				<field name="WMSstatus" caption="WMS status"/>
				<field name="Vozac" caption="Vozač"/>
				<field name="Kontakt" caption="Kontakt"/>
				<field name="SktPrometGla2_Broj" caption="Veza na dokument"/>
				<field name="SktPrometGla2_Partner" caption="Veza na partnera"/>
			</fields>
			<styles>
				<style name="fontcolor" value="green" if="#grdGlava.@Status==Zaključen" />
				<style name="fontcolor" value="gray" if="#grdGlava.@Status==Storniran" />
				<style name="fontcolor" value="black" if="#grdGlava.@Status==Otvoren||#grdGlava.@Status==Obrisan" />
			</styles>			
		</grid>	
	</part>
</parts>