    <parts>
        <part name="partKarticaGrid">
			<fields>	
				<field name="datumknjizenja" caption="Datum" />
				<field name="broj" caption="Broj dokumenta" />
				<field name="vrstadok" caption="Vrsta dokumenta" />
				<field name="kolicinaulaz" caption="Ulaz" formatstring="#,####0.0000" showtotalsum="true" type="decimal" />
				<field name="kolicinaizlaz" caption="Izlaz" formatstring="#,####0.0000" showtotalsum="true" type="decimal" />
				<field name="stanje" caption="Stanje" formatstring="#,####0.0000" showtotalsum="true" type="decimal" />
				<field name="vrijednostulaz" caption="Vrijednost ulaz" />
				<field name="vrijednostizlaz" caption="Vrijednost izlaz" />
				<field name="saldo" caption="Vrijednost zalihe" />
				<field name="partner" caption="Partner" />
				<field name="lokacija" caption="Lokacija" />
				<field name="inicijali" caption="Operater" />
				<field name="imeprezime" caption="Odg. osoba" />
				<field name="NabCijena" caption="Nabavna cijena" />
				<field name="ProdCijena" caption="Prodajna cijena" />
				<field name="orgdok" caption="Izvorni dok." />
				<field name="faktura" caption="Račun" />
				<field name="statusstr" caption="Status" />
				<field name="skladiste2" caption="Skladište2" />
				<field name="kkvalgla" caption="Kontingent" />
				<!-- <field name="Dimenzija" caption="Dimenzija" /> -->
				<field name="Napomena s dokumenta" caption="Napomena s dokumenta" />
				<field name="Opis" caption="Opis" />
<!-- 				<field name="Ispis_Template" caption="Ispis" visible="false" />
				<field name="Tablica" caption="Tablica" visible="false" />	 -->							
			</fields>			
        </part>	
		<part name="partGumbKartica">
			<action type="variable value" if="#grdStavke.@kkvalgla==null">
				<parameter name="varKontingent" value="" type="string" />
			</action>
			<action type="variable value" else="">
				<parameter name="varKontingent" value="(Kontingent: {#grdStavke.@kkvalgla})" type="string" />
			</action>
			<action type="variable value" if="#chkKontingent==true">
				<parameter name="Kontingent" value="1" type="int" />
			</action>
			<action type="variable value" else="">
				<parameter name="Kontingent" value="0" type="int" />
			</action>							
			<action type="form open" value="frmKartica" if="#grdStavke.@robaid!=null">
				<parameter name="DatumOd" value="#datDatumOd" />
				<parameter name="DatumDo" value="#datDatumDo" />
				<parameter name="SkladisteId" value="#grdStavke.@skladisteid" />
				<parameter name="RobaId" value="#grdStavke.@robaid" />
				<parameter name="KKvalGlaId" value="#grdStavke.@kkvalglaid" />
				<parameter name="Kontingent" value="$Kontingent" />
				<parameter name="Faktor" value="#grdStavke.@faktor" />
				<parameter name="varKontingent" value="$varKontingent" />								
			</action>		
		</part>	
    </parts>