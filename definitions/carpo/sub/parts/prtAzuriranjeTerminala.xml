<parts>
    <part name="UnosIzmjenaSloga">
        <layout>
            <group rows="8" cols="1">
                <item row="1" col="1"  caption="Šifra:">
                    <textedit name="txtSifra" maxlength="2" type="int" format="n0" textposition="left" datavalue="~dtGet.@Sifra"/>
                </item>
                <item row="2" col="1"  caption="Ime:">
                    <textedit name="txtIme" maxlength="25" datavalue="~dtGet.@Ime" required="true" />
                </item>
                <item row="3" col="1" caption="Lozinka:">
                    <textedit name="txtLozinka" maxlength="6" datavalue="~dtGet.@Lozinka" required="true" />
                </item>
                <item row="4" col="1" caption="Registracija:">
                    <textedit name="txtRegistracija" maxlength="9" datavalue="~dtGet.@Registracija" />
                </item>
                <item row="5" col="1" caption="Operater:">
                    <comboedit name="cmbOperater" valuefield="operateriid" displayfield="Naziv" fontbold="true" dataname="~dtOperateri" datavalue="~dtGet.@Operateriid" />
                </item>
                <item row="6" col="1" caption="Osobe:">
                    <comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Osoba" fontbold="true" dataname="~dtOdgovornaOsoba" datavalue="~dtGet.@Osobeid" />
                </item>
                <item row="7" col="1" caption="Glavno skladište:">
                    <comboedit name="cmbSkladiste" valuefield="SkladisteId" displayfield="Opis" dataname="~dtSkladiste" datavalue="~dtGet.@skladisteid" />
                </item>
                <item row="8" col="1" caption="OrgShema">
                    <combotreeedit name="cmbOrgShema" valuefield="OrgShemaId" displayfield="Naziv"  dataname="~dtOrgShema" datavalue="~dtGet.@OrgShemaId" />
                </item>
            </group>
        </layout>
    </part>
</parts>