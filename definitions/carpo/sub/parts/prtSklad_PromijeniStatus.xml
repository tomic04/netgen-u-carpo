<parts>
	<part name="partPromijeniStatus">
		<event type="init">
			<action type="variable value">
				<parameter name="Naslov" value="$NaslovTekst"/>
			</action>
		</event>	
		<layout textposition="top" itemspadding="3">
			<group cols="1" rows="2" >
				<item col="1" row="1" caption="Jeste li sigurni da želite promijeniti status?">
					<comboedit name="cmbStatusi" valuefield="StatusiId" displayfield="Korak" dataname="Global.dtStatusi" allownull="false"/> 
				</item>
				<item caption="Napomena:" col="1" row="2">
					<memoedit name="txtNapomena" entermovenextcontrol="true" />
				</item>					
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI" type="add" >
					<event type="click">
						<action if="$IzPodloge==1">
							<action type="control foreachrow selected" value="parent.#grdGlava">
								<action type="datarun nonquery" value="global.~dtPromijeniStatus"/>
							</action>						
						</action>
						<action else="">
							<action type="datarun nonquery" value="global.~dtPromijeniStatus"/>
						</action>
						<action type="variable value" value="global.IndStatusOdustani">
							<parameter value="0" type="int"/>
						</action>						
						<action type="form close"/>
					</event>
				</button>				
				<button name="btnOdustani" caption="ODUSTANI" type="">
					<event type="click">	
						<action type="variable value" value="global.IndStatusOdustani">
							<parameter value="1" type="int"/>
						</action>				
						<action type="form close"/>
					</event>			
				</button>
			</buttons>
		</panelbuttons>			
	</part>	
</parts>