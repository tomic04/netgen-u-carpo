<parts>
<!--18.3.2021. AA datDatum preračun brob na valuechanged da se okine na izmjeni zaglavlja-->
	<part name="prtKamate">
		<group cols="2" rows="4">
			<item col="1" row="1" caption="DatumDokumenta:">
				<dateedit name="datDatum" required="true">
					<event type="valuechanged">
						<action type="datarun reader" value="~dtBrojcanik"/>
						<action type="control value" value="#txtBrObr">
							<parameter value="~dtBrojcanik.@BrObr"/>
						</action>
					</event>
				</dateedit>
			</item>
			<item col="2" row="1" caption="Partner:">
				<searchedit type="partner" name="srcPartner" datavalue="~dtGet.@PartneriId" datatext="~dtGet.@Naziv" fieldtext="Naziv" fieldvalue="PartneriId" required="true"/>
			</item>			
			<item col="2" row="2" caption="Vrsta kamate:">
				<comboedit name="cmbKamata" dataname="~dtKamate" valuefield="kteVrsteStopaID" displayfield="Opis" required="true"/>
			</item>
			<item col="1" row="3" caption="Razdoblje od:">
				<dateedit name="datOd"  required="true"/>
			</item>
			<item col="2" row="3" caption="do:">
				<dateedit name="datDo"  required="true"/>
			</item>
			<item col="1" row="2" caption="Broj obračuna:">
				<textedit name="txtBrObr"/>
			</item>
			<item col="1" row="4" caption="Minimalni iznos:">
				<textedit name="txtMinIznos" format="n2" value="0"/>
			</item>
		</group>	
	</part>
</parts>