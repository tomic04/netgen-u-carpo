	<part name="partFakturaMasterGrid">
		<fields >
			<field name="VrstaDokOpis" caption="Vrsta dokumenta"  fontbold="true" />
			<!-- fixed="left" privremeno izbačeno zbog nemogućnosti grupiranja -->
			<field name="fiskalnibroj" caption="Fiskalni broj"  fontbold="true" fixed="left" />
			<field name="kupac" caption="Partner" fontbold="true"/>
			<field name="datumdok" caption="Datum" />
			<field name="datumvalute" caption="Datum dospijeća" />
			<field name="Iznosfakture" caption="Iznos s PDV-om" />
			<field name="iznosporeza" caption="Porez" />
