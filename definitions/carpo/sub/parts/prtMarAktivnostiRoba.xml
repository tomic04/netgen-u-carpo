<parts>
	<part name="prtMarAktivnostiRoba">
		<group cols="1" rows="2" caption=" " name="tabPromet">
			<columnsdefinition>
				<column size="50%" position="1" />
				<column size="50%" position="2" />
			</columnsdefinition>
			<!--
			<rowsdefinition>
			<row size="40%" position="1" />
			<row size="60%" position="2" />
			</rowsdefinition>
			-->
			<group col="1" row="1" cols="1" rows="3" bordervisible="true">
				<group col="1" row="1" cols="2" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="60%" position="1" />
						<column size="40%" position="2" />
					</columnsdefinition>
					<group col="1" row="1" cols="4" rows="1" bordervisible="true">
						<columnsdefinition>
							<column size="35%" position="1" />
							<column size="30%" position="2" />
							<column size="5%" position="3" />
							<column size="30%" position="4" />
						</columnsdefinition>
						<item col="1" row="1">
							<button name="btnRazdIzbor" caption="Razdoblje">
								<dropdownitem caption="Ovaj tjedan">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="1" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Ovaj mjesec">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="2" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Ovaj kvartal">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="3" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Ovo polugodište">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="4" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Ova godina">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="5" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Prošli tjedan">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="6" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Prošli mjesec">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="7" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Prošli kvartal">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="8" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Prošlo polugodište">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="9" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
								<dropdownitem caption="Prošla godina">
									<event type="click">
										<action type="variable value">
											<parameter name="Datum" value="10" />
										</action>
										<action type="datarun reader" value="~dtTjedan" />
										<action type="control value" value="#datRazOdRoba">
											<parameter value="~dtTjedan.@prvidan" />
										</action>
										<action type="control value" value="#datRazDoRoba">
											<parameter value="~dtTjedan.@zadnjidan" />
										</action>
									</event>
								</dropdownitem>
							</button>
						</item>
						<item col="2" row="1" caption=" ">
							<dateedit name="datRazOdRoba" value="now" />
						</item>
						<item col="3" row="1" caption=" " padding="1,1,20,1">
							<labeledit value="-" textposition="center" />
						</item>
						<item col="4" row="1" caption=" ">
							<dateedit name="datRazDoRoba" value="now" />
						</item>
					</group>
					<group col="2" row="1" cols="2" rows="1" bordervisible="true">
						<columnsdefinition>
							<column size="68%" position="1" />
							<column size="32%" position="2" />
						</columnsdefinition>
						<item col="1" row="1" caption=" " padding="1,1,18,1">
							<labeledit value="Obradi ovaj tab" textposition="right" fontbold="true" />
						</item>
						<item col="2" row="1" caption="" padding="1,1,18,1">
							<checkedit name="chkTabRoba" caption="" />
						</item>
					</group>
				</group>
				<group col="1" row="2" cols="4" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="43%" position="1" />
						<column size="10%" position="2" />
						<column size="43%" position="3" />
						<column size="4%" position="4" />
					</columnsdefinition>
					<group col="1" row="1" cols="2" rows="1" bordervisible="false">
						<item col="1" row="1" caption="Klasa robe">
							<combotreeedit name="cmbKlRoba" dataname="~dtKlRoba" valuefield="SortKey" displayfield="Naziv" tabindex="5">
							</combotreeedit>
						</item>
						<item col="2" row="1" caption="I ispod" padding="1,1,18,1">
							<checkedit name="chkIspodKlRoba" caption="I ispod" />
						</item>
					</group>
					<group col="3" row="1" cols="2" rows="1" bordervisible="false">
						<item col="1" row="1" caption="Organizacijska jedinica">
							<combotreeedit name="cmbOrgShemaRoba" dataname="~dtOrgShema" valuefield="SortKey" displayfield="Naziv" tabindex="5">
							</combotreeedit>
						</item>
						<item col="2" row="1" caption="I ispod" padding="1,1,18,1">
							<checkedit name="chkIspodOrgShemaRoba" caption="I ispod" />
						</item>
					</group>
				</group>
				<group col="1" row="3" cols="4" rows="1" bordervisible="false">
					<columnsdefinition>
						<column size="44%" position="1" />
						<column size="10%" position="2" />
						<column size="44%" position="3" />
						<column size="2%" position="4" />
					</columnsdefinition>
					<group col="1" row="1" cols="1" rows="1" bordervisible="false">
						<item col="1" row="1" caption="Roba:" colspan="2">
							<searchedit name="srcRoba" fieldtext="NazivId" fieldvalue="robaid" dataname="~dtRoba" />
						</item>
					</group>
					<group col="3" row="1" cols="3" rows="1" bordervisible="true">
						<item col="1" row="3" caption="Tip Prodaje:" padding="1,1,18,1">
							<labeledit value="Tip Prodaje:" />
						</item>
						<item col="2" row="3" caption="" padding="1,1,16,1">
							<checkedit name="chkKupljeno" caption="Kupljeno" value="true">
								<event type="checkedchanged">
									<action type="control value" value="#chkNuđeno" if="#chkKupljeno==true">
										<parameter value="False" />
									</action>
								</event>
							</checkedit>
						</item>
						<item col="3" row="3" caption="" padding="1,1,16,1">
							<checkedit name="chkNuđeno" caption="Nuđeno">
								<event type="checkedchanged">
									<action type="control value" value="#chkKupljeno" if="#chkNuđeno==true">
										<parameter value="False" />
									</action>
								</event>
							</checkedit>
						</item>
					</group>
				</group>
			</group>
			<group col="1" row="2" cols="1" rows="1" bordervisible="true">
				<item col="1" row="1" caption="" colspan="2">
					<grid name="grdTabRoba" dataname="dtTab" bestfitonrefresh="true" showcheckboxes="true" keepselectionafterfilter="true">
						<fields>
							<field name="PreTitleNaziv" caption="Titula" />
							<field name="Prezime" caption="Prezime" />
							<field name="Ime" caption="Ime" />
							<field name="Naziv" caption="Partner" />
						</fields>
						<event type="focusedrowchanged">
							<action type="variable value">
								<parameter name="Tab" value="Roba" />
							</action>
							<action type="footer text" value="Broj slogova: {#grdTabRoba.rowcount}  Broj označenih slogova: {#grdTabRoba.selectedrowscount}" />
						</event>
						<event type="selectionchanged">
							<action type="footer text" value="Broj slogova: {#grdTabRoba.rowcount}  Broj označenih slogova: {#grdTabRoba.selectedrowscount}" />
						</event>
					</grid>
				</item>
			</group>
		</group>
	</part>
</parts>
