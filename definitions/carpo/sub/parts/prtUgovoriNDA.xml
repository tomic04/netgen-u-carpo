<parts>
  <part name="UgovoriNDAform">
    <item caption="Vrsta ugovora:" col="1" row="1" highlight="false">
      <comboedit name="cmbVrstaUgovora" valuefield="PosUgovoriVrsteId" displayfield="Naziv" datavalue="#dtGet.@PosUgovoriVrsteId" dataname="global.dtVrstaUgovora" allownull="false" />
    </item>
    <item caption="Broj ugovora:" col="2" row="1" fontbold="true">
      <textedit name="txtBroj" datavalue="#dtGet.@Broj" nulltext="&lt;novi dokument&gt;" readonly="false"/>
    </item>
    <item caption="Datum kreiranja:" col="1" row="2">
      <dateedit name="datDatumUgovora" value="now" datavalue="~dtGet.@DatumUgovora" required="true"/>
    </item>
    <item caption="Vrijedi do:" row="2" col="2">
      <dateedit name="datDatumVrijediDo" datavalue="~dtGet.@UgovorVrijediDo" allownull="true" />
    </item>
    <item caption="Mjesto potpisa ugovora:" col="1" row="3">
      <textedit name="txtMjestoPotpisa" datavalue="~dtGet.@MjestoPotpisa" function="MjestoPotpisa"/>
    </item>
    <item caption="Datum potpisa:" col="2" row="3">
      <dateedit name="datDatumPotpisa" datavalue="~dtGet.@DatumPotpisa" allownull="" />
    </item>
    <item caption="Jezik:" col="1" row="4" highlight="false">
      <comboedit name="cmbJezik" valuefield="JeziciId" displayfield="Naziv" datavalue="~dtGet.@JeziciId" dataname="global.dtUgovoriNDAJezici" allownull="false"/>
    </item>
    <item caption="Čuvanje podataka nakon isteka ugovora:" col="2" row="4">
      <textedit name="txtUgovorVrijediGodina" datavalue="~dtGet.@UgovorVrijediGodina" format="n0" function="UgovorVrijediGodina" />
    </item>
    <item caption=" Iznos ugovorne kazne:" col="1" row="5">
      <textedit name="txtUgovorenaKaznaIznos" datavalue="~dtGet.@UgovorenaKaznaIznos" format="n2" function="UgovorenaKaznaIznos" />
    </item>
    <!-- <item caption="Valuta:" col="2" row="5" highlight="false">
      <comboedit name="cmbValuta" valuefield="PosUgovoriVrsteId" displayfield="Naziv" datavalue="#dtGet.@PosUgovoriVrsteId" dataname="global.dtVrstaUgovora" allownull="false" />
    </item> -->
    <item caption="Valuta:" col="2" row="5" colspan="1">
      <comboedit name="cmbValuta" valuefield="ValuteId" displayfield="Naziv" datavalue="~dtGet.@ValuteId" dataname="global.dtValuta" allownull="true" function="Valuta" />
    </item>
    <item caption="Broj kopija:" col="1" row="6">
      <textedit name="txtBrojKopija" datavalue="#dtBrojKopija.@BrojKopija" format="n0" function="BrojKopija" readonly="true" />
    </item>
  </part>
</parts>