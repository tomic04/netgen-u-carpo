			<parameter value="##funPriListKalk.@Poticaj" />
		</action>
		<action type="control value" value="#txtPovrat" if="#txtPovrat!=##funPriListKalk.@Povrat">
			<parameter value="##funPriListKalk.@Povrat" />
		</action>
		<action type="control value" value="#txtFVKn" if="#txtFVKn!=##funPriListKalk.@FakVKn">
			<parameter value="##funPriListKalk.@FakVKn" />
