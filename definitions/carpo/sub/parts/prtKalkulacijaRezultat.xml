			<parameter value="##funPriListKalk.@Marza" />
		</action>
		<action type="control value" value="#txtMarzaP" if="#txtMarzaP!=##funPriListKalk.@MarzaP">
			<parameter value="##funPriListKalk.@MarzaP" />
		</action>
<!-- 		<action type="control value" value="#txtVpc" if="#txtVpc!=##funPriListKalk.@VPC">
			<parameter value="##funPriListKalk.@VPC" />
		</action>
		<action type="control value" value="#txtMpc" if="#txtMpc!=##funPriListKalk.@MPC">
			<parameter value="##funPriListKalk.@MPC" />
		</action> -->
		<action type="control value" value="#txtRabat1IE" if="#txtRabat1IE!=##funPriListKalk.@Rabat1IE">
			<parameter value="##funPriListKalk.@Rabat1IE" />
		</action>
		<action type="control value" value="#txtRabat2IE" if="#txtRabat2IE!=##funPriListKalk.@Rabat2IE">
			<parameter value="##funPriListKalk.@Rabat2IE" />
		</action>
		<action type="control value" value="#txtRabat3IE" if="#txtRabat3IE!=##funPriListKalk.@Rabat3IE">
			<parameter value="##funPriListKalk.@Rabat3IE" />
		</action>
		
		
		<!-- varijable koje sluze umjesto lblKontrola za prosljeđivanje vrijednosti -->
		
		<action type = "variable value" value="txtMarza">
			<parameter value="##funPriListKalk.@Marza"></parameter>
		</action>
		<action type = "variable value" value="txtMarzaP">
			<parameter value="##funPriListKalk.@MarzaP"></parameter>
		</action>
		<action type = "variable value" value="txtNabCijena">
			<parameter value="##funPriListKalk.@NabCijena"></parameter>
		</action>
		<action type = "variable value" value="txtNabVrij">
			<parameter value="##funPriListKalk.@NabVrij"></parameter>
		</action>
		<action type = "variable value" value="txtNVrijednost">
			<parameter value="##funPriListKalk.@NVrijednost"></parameter>
		</action>
		<action type = "variable value" value="txtNCijena">
			<parameter value="##funPriListKalk.@NCijena"></parameter>
		</action>
		
		
		<!-- iznalzni parametri kalkulacije tag values zbog provjere da li je vrijednost mijenjana -->
		<action type = "variable value" value="devVrijednostTag">
			<parameter value="##funPriListKalk.@DevVrijednost"></parameter>
		</action>
		<action type = "variable value" value="fakVrijednostTag">
			<parameter value="##funPriListKalk.@FakVrijednost"></parameter>
		</action>
		<action type = "variable value" value="rabat1ITag">
			<parameter value="##funPriListKalk.@Rabat1I"></parameter>
		</action>
		<action type = "variable value" value="rabat2ITag">
			<parameter value="##funPriListKalk.@Rabat2I"></parameter>
		</action>
		<action type = "variable value" value="rabat3ITag">
			<parameter value="##funPriListKalk.@Rabat3I"></parameter>
		</action>
		
		<!-- enable/disable button cjenik ovisno o nabavnoj cijeni -->
		
		<action type="control disable" value="#btnCjenik" if="##funPriListKalk.@NCijena==0"/>
		<action type="control enable" value="#btnCjenik" else=""/>
			
	</part>
</parts>	