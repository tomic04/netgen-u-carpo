<!--8.11.2022. AA dinamički prikaz domicilne valute-->
<parts> 
	<part name="uferobnogatributi">
		<item caption="Dobavljač:" row="1" col="1" fontbold="true">
			<searchedit name="srcPartner" dataname="dtGetPartneri" fieldtext="Partner" fieldvalue="PartneriId" required="true" fontbold="true" datavalue="~dtKalkGlaQuery.@PartneriId" datatext="~dtKalkGlaQuery.@PartnerNaziv" tooltip="Izmjena partnera moguća je ako nije vezana URA!"> 
				<event type="valuechanged" raisonload="false">
					<action if="#srcPartner!=null">
						<action type="control enable" value="#cmbLokacija" if="#srcPartner!=null&amp;&amp;$Status==1&amp;&amp;$UFA==null"/>
						<action type="control populate" value="#cmbLokacija"/>
						<action type="datarun reader" value="~dtLokHqInd" if="#srcPartner!=null"/>
						<action type="control value" value="#cmbLokacija">
							<parameter value="~dtLokHqInd.@ParStruId"/>
						</action>
					</action>
					<action type="control disable" value="#cmbLokacija" else=""/>
				</event>
			</searchedit>
		</item>
		<item caption="Lokacija:" row="2" col="1">
			<comboedit name="cmbLokacija" valuefield="ParStruId" displayfield="Naziv" dataname="dtLokacija" autopopulate="false" datavalue="~dtKalkGlaQuery.@ParStruId"  tooltip="Izmjena lokacije moguća je ako nije vezana URA!"/>
		</item>
		<item caption="Org. shema:" row="3" col="1">
			<combotreeedit name="cteOrgShema" valuefield="ID" displayfield="Naziv" dataname="dtOrgShema" required="true" savevalue="app" datavalue="~dtKalkGlaQuery.@OrgShemaId"/>
		</item>
		 <item caption="Datum dokumenta:" row="4" col="1">
			<dateedit name="datDatumDok" value="now" datavalue="~dtKalkGlaQuery.@Datum">
				<event type="valuechanged" raisonload="false">
					<action if="#cmbValuta!=null&amp;&amp;#datDatumdok!=null">
						<action type="datarun reader" value="Global.~dtValutaTecaj"/>		
						<action type="control value" value="#txtTecaj">
							<parameter value="~dtValutaTecaj.@Iznos"/>
						</action>
					</action>
					<action type="datarun reader" value="~dtMainValuta"/>			
					<action type="variable value" value="$MainValuta">
						<parameter value="~dtMainValuta.@ValutaNow"/>
					</action>
					<action type="control value" value="#lblMainValuta1, #lblMainValuta2, #lblMainValuta3, #lblMainValuta4, #lblMainValuta5">
						<parameter value="$MainValuta"/>
					</action>
					<action type="control focus" value="#txtTecaj"/>
				</event>			
			</dateedit>
		</item>
		<item caption="Odgovorna osoba:" row="5" col="1">
			<comboedit name="cmbOsobe" valuefield="OsobeId" displayfield="Naziv" dataname="dtOdgovornaOsoba" required="true"  savevalue="app" datavalue="~dtKalkGlaQuery.@OsobeId"/>
		</item>
		<item caption="Opis:" row="6" col="1">
			<textedit name="txtOpis" entermovenextcontrol="true" datavalue="~dtKalkGlaQuery.@Opis"/>
		</item>	
	</part>
</parts>