
<!-- ulazni parametri kalkulacije za prijemni list -->
<parts>
	<part name="prtKalk">
		<action type="method run" value="funPriListKalk">
			<parameter name="tip" value="$tip" type="string" />
			<parameter name="kolicina" value="#txtKolicina" type="decimal" />
			<parameter name="fakCijena" value="#txtFCijena" type="decimal" />
			<parameter name="fakVrijednost" value="#txtFVrijednost" type="decimal" />
			<parameter name="tecaj" value="$tecaj" type="decimal" />
			<parameter name="devCijena" value="#txtDevCijena" type="decimal" /> 
			<parameter name="devVrijednost" value="#txtDevVrijednost" type="decimal" /> 
			<parameter name="ambalaza_faktor" value="$ambalaza_faktor" type="decimal" />
			<parameter name="ambalaza_cijena" value="$ambalaza_cijena" type="decimal" />	
			<parameter name="devCijeEnabled" value="1" type="bool" /> 
			<parameter name="rabat1I" value="#txtRabat1I" type="decimal" /> 
			<parameter name="rabat2I" value="#txtRabat2I" type="decimal" /> 
			<parameter name="rabat3I" value="#txtRabat3I" type="decimal" /> 
			<parameter name="rabat1P" value="#txtRabat1P" type="decimal" /> 
			<parameter name="rabat2P" value="#txtRabat2P" type="decimal" /> 
			<parameter name="rabat3P" value="#txtRabat3P" type="decimal" /> 
			<parameter name="carinaI" value="#txtCarinaI" type="decimal" /> 
			<parameter name="carinaP" value="#txtCarinaP" type="decimal" /> 
			<parameter name="trosakI" value="#txtTrosakI" type="decimal" /> 
			<parameter name="trosakP" value="#txtTrosakP" type="decimal" /> 
			<parameter name="trosarina" value="#txtTrosarina" type="decimal" /> 
			<!-- <parameter name="nCijena" value="#txtNCijena" type="decimal" />  -->

			<parameter name="poticaj" value="#txtPoticaj" type="decimal" /> 
			<parameter name="povrat" value="#txtPovrat" type="decimal" /> 
			<!-- <parameter name="fakVKn" value="#txtFVKn" type="decimal" />  -->
			<!-- <parameter name="fakVE" value="#txtFVe" type="decimal" />  -->
			
			<!-- za label kontrole napravi hidden field za prosljeđivanje vrijednosti-->
			<parameter name="marza" value="$txtMarza" type="decimal" /> 
			<parameter name="marzaP" value="$txtMarzaP" type="decimal" /> 
			<parameter name="nabCijena" value="$txtNabCijena" type="decimal" />
			<parameter name="nabVrij" value="$txtNabVrij" type="decimal" />		
			<parameter name="vpc" value="$txtVpc" type="decimal" /> 
			<parameter name="mpc" value="$txtMpc" type="decimal" /> 
			<parameter name="nVrijednost" value="$txtNVrijednost" type="decimal" /> 
			<!-- kraj kontrola koje trebaju hiddend fields -->
			
			
			<parameter name="rabat1IE" value="#txtRabat1IE" type="decimal" /> 
			<parameter name="rabat2IE" value="#txtRabat2IE" type="decimal" /> 
			<parameter name="rabat3IE" value="#txtRabat3IE" type="decimal" /> 
			
			<!-- ulazni parametri kalkulacije tag values zbog provjere da li je vrijednost mijenjana -->
			<parameter name="devVrijednostTag" value="$devVrijednostTag" type="decimal"/>
			<parameter name="fakVrijednostTag" value="$fakVrijednostTag" type="decimal"/>
			<parameter name="rabat1ITag" value="$rabat1ITag" type="decimal"/>
			<parameter name="rabat2ITag" value="$rabat2ITag" type="decimal"/>
			<parameter name="rabat3ITag" value="$rabat3ITag" type="decimal"/>
		</action>
	</part>

</parts>	