    <parts>
        <part name="partPolja">
			<group cols="3" rows="1" col="1" row="1" backgroundcolor="" groupbordervisible="False">
				<columnsdefinition>
					<column size="380" position="1" />
					<column size="50" position="2" />
					<column size="100" position="2" />
				</columnsdefinition> 						
				<item caption="Broj:" row="1" col="1" fontbold="true" >
					<textedit name="txtBroj" datavalue="#dtGet.@Broj" required="true" fontbold="true" nulltext=""/>
				</item>
				<item caption="Aneks:" row="1" col="2" fontbold="" >
					<textedit name="txtAneks" datavalue="#dtGet.@Aneks" format="n0" fontbold="" nulltext=""/>
				</item>
				<item caption="Datum ugovora:" row="1" col="3" fontbold="" >
					<dateedit name="datDatumDok" datavalue="#dtGet.@DatumDok" value="now" fontbold="" nulltext=""/>
				</item>				
			</group>
			<!-- <item caption="Broj predmeta:" row="2" col="1" fontbold="" > -->
			<item caption="Org. shema:" row="2" col="1" fontbold="" >
				<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" datavalue="#dtGet.@OrgShemaId" dataname="Global.dtOrgShema" required="true">
					<event type="valuechanged" raiseonload="false">
						<action type="control value" value="#txtNazivProjekta">
							<parameter value="#cmbOrgShema.@Opis"/>
						</action>
						<action type="control value" value="#srcPartner">
							<parameter value="#cmbOrgShema.@PartneriId" text="#cmbOrgShema.@PartnerNaziv"/>
						</action>						
					</event>			
				</combotreeedit>
			</item>
			<item caption="Naručitelj:" row="3" col="1" fontbold=""> 
				<searchedit netgenfields="true" name="srcPartner" required="true" fontbold="" dataname="Global.dtPartneri" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGet.@PartneriId" datatext="#dtGet.@PartnerNaziv"/>					
			</item>
			<item caption="Vrsta naručitelja:" row="4" col="1">
				<comboedit name="cmbVrstaNarucitelja" valuefield="ProdGradUgovori_VrstaNaruciteljaId" displayfield="Naziv" datavalue="#dtGet.@VrstaNaruciteljaId" dataname="Global.dtVrstaNarucitelja" />
			</item>
			<item caption="Komisionar:" row="5" col="1" fontbold="">
				<searchedit netgenfields="true" name="srcKomisionar" required="" fontbold="" dataname="Global.dtKomisionar" fieldtext="NazivId" fieldvalue="partneriid" datavalue="#dtGet.@PartnerKomisionarId" datatext="#dtGet.@KomisionarNaziv"/>
			</item>
			<item caption="Naziv projekta:" row="6" col="1" fontbold="" >
				<textedit name="txtNazivProjekta" datavalue="#dtGet.@NazivProjekta"  fontbold="" nulltext=""/>
			</item>
			<item caption="Vrsta projekta:" row="7" col="1">
				<comboedit name="cmbVrstaProjekta" valuefield="GradProjektiVrsteId" displayfield="Naziv" datavalue="#dtGet.@GradProjektiVrsteId" dataname="Global.dtVrstaProjekta" />
			</item>						
			<group cols="2" rows="2" col="1" row="8" backgroundcolor="" groupbordervisible="False">
				<columnsdefinition>
					<column size="200" position="1" />
					<column size="200" position="2" />
				</columnsdefinition>				
				<item caption="Rok izrade:" row="1" col="1" fontbold="" >
					<dateedit name="datRokIzrade" datavalue="#dtGet.@RokIzrade" value="now" allownull="true" fontbold="" nulltext=""/>
				</item>
				<item caption="Valuta (dana):" row="1" col="2" fontbold="" >
					<textedit name="txtDani" datavalue="#dtGet.@Dani" format="n0" fontbold="" nulltext=""/>
				</item>
				<item caption="Lokacija projekta:" row="2" col="1">
					<comboedit name="cmbMjesta" valuefield="MjestaId" displayfield="Naziv" datavalue="#dtGet.@MjestaId" dataname="Global.dtMjesta">
						<event type="leave" raiseonload="false">
							<action type="datarun reader" value="Global.dtDajZupaniju"/>
							<action type="control value" value="#lblZupanija">
								<parameter value="~dtDajZupaniju.@Zupanija"/>
							</action>
						</event>
					</comboedit>
				</item>
				<item caption="Županija projekta:" row="2" col="2">
					<labeledit name="lblZupanija" valuefield="" displayfield="" value="" datavalue="#dtGet.@Zupanija" dataname="" />
				</item>				
			</group>
			<group cols="3" rows="1" col="1" row="9" backgroundcolor="" groupbordervisible="False">			
				<columnsdefinition>
					<column size="200" position="1" />
					<column size="80" position="2" />
				</columnsdefinition>
				<item caption="Vrijed. ugovorenih radova izvođača:" row="1" col="1" fontbold="" >
					<textedit name="txtVrijRadova" datavalue="#dtGet.@VrijednostRadovaIzvodjaca" format="n2" value="0" fontbold="" nulltext="">
						<event type="valuechanged" raiseonload="false">
							<action type="datarun reader" value="Global.dtPreracunaj"/>
							<action type="control value" value="#txtVrijUsluga">
								<parameter value="~dtPreracunaj.@Vrijednost"/>
							</action>
						</event>
					</textedit>
				</item>					
				<item caption="% nadzora:" row="1" col="2" fontbold="" >
					<textedit name="txtPostotak" datavalue="#dtGet.@PostotakNadzora" format="n2" fontbold="" value="0" nulltext="">
						<event type="valuechanged" raiseonload="false">
							<action type="datarun reader" value="Global.dtPreracunaj"/>
							<action type="control value" value="#txtVrijUsluga">
								<parameter value="~dtPreracunaj.@Vrijednost"/>
							</action>
						</event>
					</textedit>					
				</item>							
				<item caption="Vrijed. ugovorenih usluga:" row="1" col="3" fontbold="" >
					<textedit name="txtVrijUsluga" datavalue="#dtGet.@VrijednostUsluga" format="n2" value="0" fontbold="" nulltext=""/>
				</item>
			</group>				

			<item caption="Napomena:" row="10" col="1">
				<memoedit name="txtNapomena" entermovenextcontrol="" datavalue="#dtGet.@Napomena" />
			</item>	           
        </part>
		<part name="partPodizvrsitelji">
			<item caption="Podizvršitelj:" row="1" col="1" fontbold=""> 
				<searchedit netgenfields="true" name="srcPodIzvrsitelji" required="" fontbold="" dataname="Global.dtPodizvrsitelji" fieldtext="NazivId" fieldvalue="partneriid" datavalue="~dtGetPodIzvrsitelji.@PodIzvrsiteljiId" datatext="~dtGetPodIzvrsitelji.@Podizvrsitelj"/>					
			</item>
			<item caption="Vrsta ugovora:" row="2" col="1">
				<comboedit name="cmbPodizvrsiteljiVrstaUgovora" valuefield="GradUgovoriVrsteId" displayfield="Naziv" datavalue="~dtGetPodIzvrsitelji.@GradUgovoriVrsteId" dataname="Global.dtGradUgovoriVrste" />
			</item>	
			<item caption="Broj ugovora:" row="3" col="1" fontbold="" >
				<textedit name="txtPodizvrsiteljiBrojUgovora" datavalue="~dtGetPodIzvrsitelji.@BrojUgovora" fontbold="" nulltext=""/>
			</item>						
			<item caption="Opis usluge:" row="4" col="1" fontbold="" >
				<textedit name="txtPodizvrsiteljiOpisUsluge" datavalue="~dtGetPodIzvrsitelji.@OpisUsluge" fontbold="" nulltext=""/>
			</item>			
		</part>
    </parts>