<parts>
	<part name="prtOsnovno">
		<item row="1" col="1" colspan="3" caption="Broj:">
			<textedit name="txtBroj" enabled="false" datavalue="~dtLoad.@Broj"/>
		</item>
		<group row="2" col="1" rows="7" cols="1" rowspan="7" groupbordervisible="false">
			<item row="1" col="1" caption="Datum:">
				<dateedit name="dateDatum" value="now" required="true" tabindex="0" datavalue="~dtLoad.@DatumDok"/>
			</item>
			<item row="2" col="1" caption="Model:">
				<comboedit name="cmbModel" dataname="global.~dtModel" valuefield="ServisId" displayfield="Naziv" required="true" tabindex="1" datavalue="~dtLoad.@ServisId">
					<event type="valuechanged">
						<action type="datarun reader" value="global.~dtParametriModela"/>
						<action type="variable value">
							<parameter name="KlMasterRobaId" value="global.~dtParametriModela.@KlMasterRobaId"/>
							<parameter name="InterniInd" value="global.~dtParametriModela.@InterniInd"/>
							<parameter name="Model" value="global.~dtParametriModela.@Model"/>
							<parameter name="OsobeMP" value="global.~dtParametriModela.@OsobeMP"/>
							<parameter name="OrgShemaReal" value="global.~dtParametriModela.@OrgShemaReal"/>
						</action>
						<action if="$InterniInd==true">
							<action type="control value" value="#srcPartner">
								<parameter value="global.$NasId" text="global.$NasNaziv"/>
							</action>
						</action>
						<action if="$Model==U">
							<action type="control visible" value="#srcUsluga">
								<parameter value="true"/>
							</action>
						</action>
						<action if="$OsobeMP==0">
							<action type="control disable" value="#srcOsoba"/>
							<action type="control value" value="#srcOsoba">
								<parameter value="null"/>
							</action>
						</action>
						<action if="$OrgShemaReal==false">
							<action type="control disable" value="#cmbOrgShemaReal"/>
						</action>
					</event>
				</comboedit>
			</item>
			<item row="3" col="1" caption="Vrsta RN:">
				<comboedit name="cmbVrstaRN" dataname="global.~dtVrstaRN" valuefield="ServisVrsteRNId" displayfield="Naziv" required="true" tabindex="2" datavalue="~dtLoad.@ServisVrsteRNId"/>
			</item>
			<item row="4" col="1" caption="Način obračuna:">
				<comboedit name="cmbNacinObracuna" dataname="global.~dtNacinObracuna" valuefield="ServisNacinObrId" displayfield="Naziv" required="true" tabindex="3" datavalue="~dtLoad.@ServisNacinObrId"/>
			</item>
			<item row="5" col="3" caption="Odgovorna osoba:">
				<searchedit name="srcOdgovornaOsoba" dataname="global.~dtOdgovornaOsoba" fieldvalue="OsobeId" fieldtext="Naziv" required="true" tabindex="4" datavalue="~dtLoad.@OdgovornaOsobaId" datatext="~dtLoad.@OdgovornaOsoba"/>
			</item>
			<item row="6" col="1" caption="Izvršitelj:">
				<searchedit name="srcIzvrsitelj" dataname="global.~dtIzvrsitelj" fieldvalue="HRKadroviId" fieldtext="Izvrsitelj" tabindex="5" datavalue="~dtLoad.@HRKadroviId" datatext="~dtLoad.@Izvrsitelj"/>
			</item>
			<item row="7" col="1" caption="Usluga za fakturiranje:">
				<searchedit name="srcUsluga" dataname="global.~dtUslugaIzKlase" valuefield="RobaId" displayfield="Naziv" tabindex="6" datavalue="~dtLoad.@UslugaId" datatext="~dtLoad.@UslugaNaziv"/>
			</item>
		</group>
		<item row="2" col="2" highlight="false">
			<radioedit name="rdoPartner">
				<event type="checkedchanged">
					<action type="control enable" value="#srcPartner, #srcLokacija, #srcKontakt"/>
					<action type="control attribute" value="#srcPartner, #srcLokacija">
						<parameter name="required" value="true"/>
					</action>
					<action type="control disable" value="#srcOsoba"/>
					<action type="control value" value="#srcOsoba">
						<parameter value="null"/>
					</action>
				</event>
			</radioedit>
		</item>
		<group row="2" col="3" rows="3" cols="1" rowspan="3" caption="Partner">
			<item row="1" col="1" caption="Naziv:">
				<searchedit netgenfields="true" name="srcPartner" dataname="global.~dtPartneri" fieldtext="NazivId" fieldvalue="PartneriId" required="true" tabindex="7" datavalue="~dtLoad.@PartneriId" datatext="~dtLoad.@Partner">
					<event type="valuechanged">
						<action type="datarun reader" value="global.~dtPop"/>
						<action type="control value" value="#srcLokacija">
							<parameter value="global.~dtPop.@ParStruId" text="global.~dtPop.@Naziv"/>
						</action>
						<!-- <action type="control populate" value="#srcKontakt"/> -->
					</event>
				</searchedit>
			</item>
			<item row="2" col="1" caption="Lokacija:">
				<searchedit name="srcLokacija" dataname="global.~dtLokacija" fieldtext="Naziv" fieldvalue="ParStruId" required="true" tabindex="8" datavalue="~dtLoad.@ParStruId" datatext="~dtLoad.@Lokacija"/>
			</item>
			<item row="3" col="1" caption="Kontakt:">
				<searchedit name="srcKontakt" dataname="global.~dtPartnerOsoba" fieldtext="Naziv" fieldvalue="OsobeId" tabindex="9" datavalue="~dtLoad.@PartneriOsobeId" datatext="~dtLoad.@PartnerOsoba"/>
			</item>
		</group>
		<item row="5" col="2" highlight="false">
			<radioedit name="rdoOsoba">
				<event type="checkedchanged">
					<action type="control enable" value="#srcOsoba"/>
					<action type="control disable" value="#srcPartner, #srcLokacija, #srcKontakt"/>
					<action type="control attribute" value="#srcPartner, #srcLokacija">
						<parameter name="required" value="false"/>
					</action>
					<action type="control value" value="#srcPartner, #srcLokacija, #srcKontakt">
						<parameter value="null"/>
					</action>
				</event>
			</radioedit>
		</item>
		<group row="5" col="3" rows="1" cols="1" rowspan="1" caption="Osoba">
			<item row="1" col="1" caption="Ime:">
				<searchedit name="srcOsoba" dataname="global.~dtOsoba" fieldtext="Naziv" fieldvalue="OsobeId" datavalue="~dtLoad.@OsobeId" datatext="~dtLoad.@Osoba" tabindex="10"/>
			</item>
		</group>
		<item row="6" col="3" caption="OrgShema:">
			<combotreeedit name="cmbOrgShema" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" required="true" tabindex="11" datavalue="~dtLoad.@TrosOrgShemaId">
				<event type="valuechanged">
					<action if="$OrgShemaReal==0">
						<action type="control value" value="#cmbOrgShemaReal">
							<parameter value="#cmbOrgShema"/>
						</action>
					</action>
				</event>
			</combotreeedit>
		</item>
		<item row="7" col="3" caption="OrgShema (real.):">
			<combotreeedit name="cmbOrgShemaReal" valuefield="ID" displayfield="Naziv" dataname="global.~dtNositelj" required="true" tabindex="12" datavalue="~dtLoad.@RealOrgShemaId"/>
		</item>
		<group row="8" col="1" rows="2" cols="2" colspan="3" caption="Podaci o stroju">
			<columnsdefinition>
				<column position="1" size="50%"/>
				<column position="2" size="50%"/>
			</columnsdefinition>
			<item row="1" col="1" caption="Stroj:">
				<searchedit name="srcStroj" dataname="global.~dtTraziVozilo" fieldvalue="VoziloId" fieldtext="Vozilo" tabindex="13" datavalue="~dtLoad.@VoziloId" datatext="~dtLoad.@Vozilo">
					<event type="valuechanged">
						<action type="datarun reader" value="global.~dtVoziloInfo"/>
						<action type="control value" value="#txtSerijskiBroj">
							<parameter value="global.~dtVoziloInfo.@BrojSasije"/>
						</action>
						<action type="control value" value="#txtBrojReg">
							<parameter value="global.~dtVoziloInfo.@RegOznaka"/>
						</action>
						<action type="control value" value="#txtInvBroj">
							<parameter value="global.~dtVoziloInfo.@InvBroj"/>
						</action>
					</event>
				</searchedit>
			</item>
			<item row="2" col="1" caption="Serijski broj:">
				<textedit name="txtSerijskiBroj" enabled="false"/>
			</item>
			<item row="1" col="2" caption="Broj registracije:">
				<textedit name="txtBrojReg" enabled="false"/>
			</item>
			<item row="2" col="2" caption="Inventurni broj:">
				<textedit name="txtInvBroj" enabled="false"/>
			</item>
		</group>
		<item row="9" col="1" colspan="3" caption="Opis:">
			<memoedit name="memOpis" tabindex="14" datavalue="~dtLoad.@RobaOpis"/>
		</item>
	</part>
</parts>