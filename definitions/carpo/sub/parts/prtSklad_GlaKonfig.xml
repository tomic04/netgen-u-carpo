<parts>
  <part name="partGlaKonfig">
    <event type="init">
      <action type="datarun reader" value="~dtGet"/>
      <action type="datarun reader" value="~dtDohvatID"/>
      <action type="datarun reader" value="~dtQuery" if="$SktParametriId!=null" />
      <action type="datarun reader" value="~dtQuery">
        <parameter value="@SktParametriId" />
      </action>
    </event>
    <event type="load">
      <action type="variable value">
        <parameter name="SktParametriId" value="~dtDohvatID.@SktParametriId" />
      </action>
      <action type="variable value">
        <parameter name="Smije" value="1" type="int"/>
      </action>
	  <action type="control enable" value="#cmbSkladisteDva" if="Global.$VrstaPromSifra==41||Global.$VrstaPromSifra==IMI"/>
	  <action type="control disable" value="#cmbSkladisteDva" else=""/>
    </event>
    <layout itemspadding="3">
      <group cols="1" rows="1" groupbordervisible="False">
        <group padding="0" groupbordervisible="False" cols="1" rows="14">
          <item caption="Datum (forma za unos dokumenta):" col="1" row="1">
            <comboedit name="cmbDatum" valuefield="Ind" displayfield="Datum" datavalue="~dtGet.@Datum" dataname="dtDatum" allownull="false" />
          </item>
          <item caption="Skladište (forma za unos dokumenta):" col="1" row="2">
            <comboedit name="cmbSkladiste" valuefield="Ind" displayfield="Skladiste" datavalue="~dtGet.@Skladiste" dataname="dtSkladiste" allownull="false" />
          </item>
          <item caption="Skladište 2 (forma za unos dokumenta):" col="1" row="3" highlight="false">
             <comboedit name="cmbSkladisteDva" valuefield="Ind" displayfield="Skladiste" datavalue="~dtGet.@Skladiste2" dataname="dtSkladiste" allownull="false" />
              </item>
          <item caption="Odg. osoba (forma za unos dokumenta):" col="1" row="4" highlight="false">
            <comboedit name="cmbOdgOsoba" valuefield="Ind" displayfield="OdgOsoba" datavalue="~dtGet.@OdgOsoba" dataname="dtOdgOsoba" allownull="false"/>
          </item>
          <item caption="Org. shema (forma za unos dokumenta):" col="1" row="5" highlight="false">
            <comboedit name="cmbOrgShema" valuefield="Ind" displayfield="OrgShema" datavalue="~dtGet.@OrgShema" dataname="dtOrgShema" allownull="false"/>
          </item>
          <item caption="Inicijalno stablo:" col="1" row="6" highlight="false">
            <comboedit name="cmbDrvoFilter" valuefield="Ind" displayfield="DrvoFilter" datavalue="~dtGet.@DrvoFilter" dataname="dtDrvoFilter" allownull="false"/>
          </item>
          <item caption="Broj prethodnih godina u stablu:" col="1" row="7" highlight="false">
            <textedit name="txtBrGod" format="n0" type="int" datavalue="~dtGet.@DrvoBrZadnjihGod" value="2" allownull="false"/>
          </item>		  
          <item caption="" col="1" row="8" highlight="false">
            <checkedit name="chkIducaGod" caption="prikaži iduću godinu u stablu" datavalue="~dtGet.@DrvoIducaGod" dataname="" value="false"/>
          </item>
          <item caption="" col="1" row="9" highlight="false">
            <checkedit name="chkDimenzije" caption="prikaži grid s dimenzijama (*)" datavalue="~dtGet.@Dimenzije" dataname="" value="false"/>
          </item>
          <item caption="" col="1" row="10" highlight="false">
            <checkedit name="chkNapomenaTabStop" caption="preskoči napomenu stavke (*)" datavalue="~dtGet.@NapomenaTabStop" dataname="" value="false"/>
          </item>	
          <item caption="" col="1" row="11" highlight="false">
            <checkedit name="chkRobaEnter" caption="zapamti zadnji odabir robe (enter) (*)" datavalue="~dtGet.@RobaEnter" dataname="" value="false"/>
          </item>			  
		  <item row="12" col="1" textvisible="False" >
			<separator dark="true" backcolor="gray" />
		  </item>		  
          <item caption="Napomena:" col="1" row="13" highlight="false">
            <labeledit name="lblNapomena" value="Ove postavke vrijede samo za ovog operatera u ovoj granuli." multiline="true"/>
          </item>	
          <item caption="" col="1" row="14" highlight="false">
            <labeledit name="lblNapomena" value="(*) Za aktivaciju nekih od postavki bit će potrebno ponovno pokrenuti granulu." multiline="true"/>
          </item>		  
        </group>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnesiKonf" caption="SPREMI" type="add" dock="left">
          <event type="click">
            <action type="validate"/>
			<action if="#txtBrGod&gt;10">
				<action type="message" value="Nije moguće prikazati više od 10 godina">
					<action type="control focus" value="#txtBrGod"/>
				</action>			
			</action>
			<action else="">
				<action type="datarun scalar" value="~dtKonfigSpremi"/>
				<action type="variable value">
					<parameter name="Global.DrvoFilter" value="#cmbDrvoFilter" type="int" />
				</action>
				<action type="form close" />
			</action>				
          </event>
        </button>
        <button name="btnOdustaniKonfig" caption="ODUSTANI" type="cancel">
          <event type="click">
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spSklad_Gla_Konfig_PuniCombo" name="dtDatum">
        <parameter name="@action" value="Datum" />
      </data>
      <data command="spSklad_Gla_Konfig_PuniCombo" name="dtSkladiste">
        <parameter name="@action" value="Skladiste" />
      </data>
      <data command="spSklad_Gla_Konfig_PuniCombo" name="dtOrgShema">
        <parameter name="@action" value="OrgShema" />
      </data>
      <data command="spSklad_Gla_Konfig_PuniCombo" name="dtOdgOsoba">
        <parameter name="@action" value="OdgOsoba" />
      </data>
      <data command="spSklad_Gla_Konfig_PuniCombo" name="dtDrvoFilter">
        <parameter name="@action" value="DrvoFilter" />
      </data>	  
      <data command="spSklad_Gla_Konfig" name="dtGet">
        <parameter name="@VrstaProm" value="$VrstaProm" />
        <parameter name="@OperateriId" value="@@operateriid" />
      </data>
      <data command="spSklad_Gla_Konfig_Azur" name="dtKonfigSpremi">
        <parameter name="@SktParametriId" value="$SktParametriId" />
        <parameter name="@SifraVrstaProm" value="$VrstaProm" />
        <parameter name="@OperateriId" value="@@OperateriId" />
        <parameter name="@Datum" value="#cmbDatum" />
        <parameter name="@Skladiste" value="#cmbSkladiste" />
		<parameter name="@Skladiste2" value="#cmbSkladisteDva" />
        <parameter name="@OrgShema" value="#cmbOrgShema" />
        <parameter name="@OdgOsoba" value="#cmbOdgOsoba" />
		<parameter name="@DrvoIducaGod" value="#chkIducaGod" />
		<parameter name="@Dimenzije" value="#chkDimenzije" />
		<parameter name="@DrvoFilter" value="#cmbDrvoFilter" />
		<parameter name="@DrvoBrZadnjihGod" value="#txtBrGod" />
		<parameter name="@NapomenaTabStop" value="#chkNapomenaTabStop" />
		<parameter name="@RobaEnter" value="#chkRobaEnter" />
      </data>
      <data command="spSklad_Gla_Konfig_SktParametriID" name="dtDohvatID">
        <parameter name="@VrstaProm" value="$VrstaProm" />
        <parameter name="@OperateriId" value="@@operateriid" />
      </data>
      <data command="spSklad_Gla_Konfig_Query" name="dtQuery">
        <parameter name="@SktParametriId" value="$SktParametriId" />
      </data>
    </datalist>
  </part>
</parts>