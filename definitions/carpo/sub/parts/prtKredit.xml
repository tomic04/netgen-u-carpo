<parts>
	<part name="Kredit">
		<event type="init">
			<action type="datarun reader" value="~dtIznos" />
		</event>
		<event type="shown">
			<action type="control focus" value="txtAvans"/>	
			<action type="control disable" value="txtUkIznos"/>	
			<action type="control value" value="txtAvansPosto">
				<parameter value="100"/>
			</action>
			<action type="control value" value="txtAvans">
				<parameter value="~dtIznos.Iznos"/>
			</action>
			<action type="control value" value="txtUkIznos">
				<parameter value="~dtIznos.Iznos"/>
			</action>
			<action type="control value" value="txtIznosPrve">
				<parameter value="0"/>
			</action>
			<action type="control value" value="txtIznosOstalih">
				<parameter value="0"/>
			</action>
		</event>
        <layout textposition="left" itemspadding="3">
            <group cols="1" rows="1">
                <group cols="1" rows="5" row="1" col="1" groupbordervisible="false">
					<item caption="Ukupan iznos:" row="1" col="1" textposition="left">
						<textedit name="txtUkIznos" value="0" format="n2" type="decimal"/>
					</item>	
					<group cols="3" rows="2" row="2" col="1" padding="0" groupbordervisible="False">
						<item caption="Avans:" row="1" col="1" textposition="left">
							<textedit name="txtAvansPosto" value="0" format="n2" type="decimal" >
								<event type="leave">
									<action type="variable value">
										<parameter name="IndUvjetiKalk" value="1" />
									</action>								
									<action type="datarun reader" value="~dtKalkPolja"/>
									<action type="control value" value="txtAvans">
										<parameter value="~dtKalkPolja.@Avans"/>
									</action>								
									<action type="control value" value="txtIznosPrve">
										<parameter value="~dtKalkPolja.@IznosPrve"/>
									</action>
									<action type="control value" value="txtIznosOstalih">
										<parameter value="~dtKalkPolja.@IznosOstalih"/>
									</action>									
								</event>
							</textedit>
						</item>
						<item row="1" col="2" textposition="left">
							<labeledit value="%" textalignmode="left"/>
						</item>						
						<item caption="" row="1" col="3" textposition="left">
							<textedit name="txtAvans" value="0" format="n2" type="decimal" >
								<event type="leave">
									<action type="variable value">
										<parameter name="IndUvjetiKalk" value="2" />
									</action>								
									<action type="datarun reader" value="~dtKalkPolja"/>
									<action type="control value" value="txtAvansPosto">
										<parameter value="~dtKalkPolja.@AvansPosto"/>
									</action>									
									<action type="control value" value="txtIznosPrve">
										<parameter value="~dtKalkPolja.@IznosPrve"/>
									</action>
									<action type="control value" value="txtIznosOstalih">
										<parameter value="~dtKalkPolja.@IznosOstalih"/>
									</action>									
								</event>						
							</textedit>
						</item>	
						<item caption="Broj rata:" row="2" col="1" textposition="left">
							<textedit name="txtRate" value="0" format="n0" type="integer" >
								<event type="leave">
									<action type="variable value">
										<parameter name="IndUvjetiKalk" value="3" />
									</action>								
									<action type="datarun reader" value="~dtKalkPolja"/>										
									<action type="control value" value="txtIznosPrve">
										<parameter value="~dtKalkPolja.@IznosPrve"/>
									</action>
									<action type="control value" value="txtIznosOstalih">
										<parameter value="~dtKalkPolja.@IznosOstalih"/>
									</action>									
								</event>
							</textedit>
						</item>	
						<item caption="Period (dana):" row="2" col="3" textposition="left">
							<textedit name="txtDani" value="0" format="n0" type="integer" sufix="dana" />
						</item>	
					 </group>
					<item caption="Datum prve rate:" row="3" col="1" textposition="left">
						<dateedit name="datDanRate" value="now" format="" type="" />
					</item>	
					<item caption="Iznos prve rate:" row="4" col="1" textposition="left">
						<textedit name="txtIznosPrve" value="0" format="n2" type="decimal" >
							<event type="leave">
								<action type="variable value">
									<parameter name="IndUvjetiKalk" value="4" />
								</action>								
								<action type="datarun reader" value="~dtKalkPolja"/>									
								<action type="control value" value="txtIznosOstalih">
									<parameter value="~dtKalkPolja.@IznosOstalih"/>
								</action>									
							</event>
						</textedit>						
					</item>	
					<item caption="Iznos ostalih rata:" row="5" col="1" textposition="left">
						<textedit name="txtIznosOstalih" value="0" format="n2" type="decimal" >
							<event type="leave">
								<action type="variable value">
									<parameter name="IndUvjetiKalk" value="5" />
								</action>								
								<action type="datarun reader" value="~dtKalkPolja"/>							
								<action type="control value" value="txtIznosPrve">
									<parameter value="~dtKalkPolja.@IznosPrve"/>
								</action>								
							</event>
						</textedit>							
					</item>						
                </group>
            </group>
        </layout>
        <panelbuttons>
            <buttons>
                <button caption="SPREMI" type="add" dock="right">
                    <event type="click">
						<action type="datarun reader" value="~dtKalkPolja"/>					
						<action type="control value" value="txtRate">
							<parameter value="~dtKalkPolja.@BrojRata"/>
						</action>								
						<action type="control value" value="txtIznosPrve">
							<parameter value="~dtKalkPolja.@IznosPrve"/>
						</action>
						<action type="control value" value="txtIznosOstalih">
							<parameter value="~dtKalkPolja.@IznosOstalih"/>
						</action>								
                        <action type="datarun nonquery" value="~dtUvjetiUnos"/>
						<action type="control populate" value="parent.#grdUvjeti" />
						<action type="form close" />
                    </event>
                </button>
                <button caption="ODUSTANI" type="cancel" dock="right" />
            </buttons>
        </panelbuttons>
        <datalist>
            <data command="spProd_Uvjeti" name="dtIznos">
                <parameter name="@Id" type='int' value="$ProPonGlaId" if="Global.$tablicaGla=='ProPonGla'" />
				<parameter name="@Id" type='int' value="$FaktureId" if="Global.$tablicaGla=='Fakture'" />
				<parameter name="@Id" type='int' value="$ProNOtpGlaId" if="Global.$tablicaGla=='ProNOtpGla'" />
				<parameter name="@Action" value="3" />
				<parameter name="@tablicaGla" value="Global.$tablicaGla" />
				<parameter name="@tablicaDet" value="Global.$tablicaDet" />				
            </data>
            <data command="spProd_Uvjeti_Kalk" name="dtKalkPolja">
				<parameter name="@action" value="1"/>
				<parameter name="@avans" type='decimal' value="#txtAvans"/>
				<parameter name="@avans_posto" type='decimal' value="#txtAvansPosto"/>
				<parameter name="@broj_rata" type='decimal' value="#txtRate"/>
				<parameter name="@iznos_prve" type='decimal' value="#txtIznosPrve"/>
				<parameter name="@iznos_ostalih" type='decimal' value="#txtIznosOstalih"/>
				<parameter name="@iznos" type='decimal' value="~dtIznos.Iznos"/>
				<parameter name="@ind" type='decimal' value="$IndUvjetiKalk"/>
            </data>
            <data command="spProd_Uvjeti_Unos" name="dtUvjetiUnos">
				<parameter name="@action" type='int' value="0"/>
				<parameter name="@avans" type='decimal' value="#txtAvans"/>
				<parameter name="@avans_posto" type='decimal' value="#txtAvansPosto"/>
				<parameter name="@broj_rata" type='decimal' value="#txtRate"/>
				<parameter name="@iznos_prve" type='decimal' value="#txtIznosPrve"/>
				<parameter name="@iznos_ostalih" type='decimal' value="#txtIznosOstalih"/>
				<parameter name="@iznos" type='decimal' value="~dtIznos.Iznos"/>
				<parameter name="@ProPonGlaId" type='int' value="$ProPonGlaId" if="Global.$tablicaGla=='ProPonGla'"/>
				<parameter name="@FaktureId" type='int' value="$FaktureId" elseif="Global.$tablicaGla=='Fakture'"/>
				<parameter name="@ProNotpGlaId" type='int' value="$ProNOtpGlaId" else="Global.$tablicaGla=='ProNOtpGla'"/>
				<parameter name="@kntnacinplacid" type='int' value="$KntNacinPlacId"/>
				<parameter name="@datum" type='date' value="#datDanRate"/>
				<parameter name="@period" type='int' value="#txtDani"/>
            </data>				
        </datalist>		
	</part>
</parts>