<root>
	<form name="frmDrugiDohodak" type="master" caption="Definicija isplate">
		<managerlayout>
			<grid name="grdDrugiDohodak" type="master" dataname="~dtMaster" key="OOPIsStavkeId" fieldsmartspaces="false">
				<menu>
					<menuitem caption="Unos vrste isplate" name="menUnos" sort="1">
						<event type="click">
							<action type="form open" value="frmPromjenaUnosBrisanjeOOPIsStavke">
								<parameter name="OOPIsStavkeId" value="0" type="int"/>
								<parameter  name="Tip" value="unos"/>
							</action>
							<action type="control populate" value="#grdDrugiDohodak"/>
						</event>
					</menuitem>
					<menuitem caption="Izmjeni vrstu isplate" name="menIzmjeni" sort="2">
						<event type="click">
							<action type="form open" value="frmPromjenaUnosBrisanjeOOPIsStavke">
								<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId" />
								<parameter  name="Tip" value="izmjena"/>
							</action>
							<action type="control populate" value="#grdDrugiDohodak"/>
						</event>
					</menuitem>
					<menuitem caption="Obriši vrstu isplate" name="menBrisi" sort="3">
						<event type="click">
							<action type="confirm" value="Da li ste sigurni da želite obrisati {#grdDrugiDohodak.@Naziv}?">
								<action type="datarun nonquery" value="~dtBrisi">
								</action>
							</action>
							<action type="control populate" value="#grdDrugiDohodak"/>
						</event>
					</menuitem>
				</menu>
				<event type="focusedrowchanged">
					<action type="control populate" value="#grdFormule"/>
					<action type="control populate" value="#grdKoeficijent"/>
					<action type="control populate" value="#grdVirmani"/>
				</event>
			</grid>
			<tabs name="tabs">
				<tab name="Formule" caption="Formule" >
					<grid name="grdFormule" dataname="dtFormule" key="OOPIsStavkeId" fieldsmartspaces="false" >
					</grid>
				</tab>
				<tab name="Koeficijent" caption="Koeficijent">
					<grid name="grdKoeficijent" dataname="dtKoeficijent" key="OOPIsStavkeKoefId" fieldsmartspaces="false" >
						<fields inherited="true" >
						<field name="Koeficijent" format="n7" />
						</fields>
						<menu>
							<menuitem caption="Obriši koeficijent" name="menBrisi" sort="3">
								<event type="click">
									<action type="confirm" value="Da li ste sigurni da želite obrisati koeficijent {#grdKoeficijent.@koeficijent} i prirez {#grdKoeficijent.@prirez}?">
										<action type="datarun nonquery" value="~dtBrisiKoef" >
										</action>
									</action>
									<action type="control populate" value="#grdKoeficijent"/>
								</event>
							</menuitem>
						</menu>					
					</grid>
				</tab>
				<tab name="Virmani" caption="Virmani">
					<grid name="grdVirmani" dataname="dtVirmani" key="OOPVirmaniIsId" fieldsmartspaces="false">	
					</grid>
				</tab>
			</tabs>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Unesi" type="add">
					<event type="click">
						<action type="form open" value="frmPromjenaUnosBrisanjeOOPIsStavke" >
							<parameter name="OOPIsStavkeId" value="0" type="int"/>
							<parameter  name="Tip" value="unos"/>
						</action> 
					</event>
				</button>
				<button name="btnIzmjeni" caption="Izmjeni" type="edit">
					<event type="click">
						<action type="form open" value="frmPromjenaUnosBrisanjeOOPIsStavke" >
							<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
							<parameter  name="Tip" value="izmjena"/>
						</action> 
						<action type="control populate" value="#grdDrugiDohodak" >
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="Obriši" type="delete">
					<event type="click">
						<action type="confirm" value="Da li ste sigurni da želite obrisati {#grdDrugiDohodak.@Naziv}?">
							<action type="datarun nonquery" value="~dtBrisi">
								<action type="control populate" value="#grdDrugiDohodak"/>
							</action>
						</action>
					</event>
				</button>
				<button name="btnAzuriraj" caption="Ažuriranje detalja" begingroup="true">
					<event type="click" >
						<action if="#tabs.selectedtab==Formule">
							<action type="form open" value="frmAzuriranjeFormule" >
								<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
							</action> 
							<action type="control populate" value="#grdFormule" >
							</action>
						</action>
						<action elseif="#tabs.selectedtab==Koeficijent">
							<action type="form open" value="frmAzuriranjeKoeficijenta" >
								<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
							</action> 
							<action type="control populate" value="#grdKoeficijent" >
							</action>
						</action>
						<action elseif="#tabs.selectedtab==Virmani">
							<action type="form open" value="frmAzuriranjeVirmani" >
								<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
							</action> 
							<action type="control populate" value="#grdVirmani" >
							</action>
						</action>
					</event>
				</button>
				<button name="btnKopiraj" caption="Kopiraj" type="edit" begingroup="true">
					<event type="click">
						<action type="form open" value="frmKopiranjeIsplate" >
							<parameter name="OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
							<parameter  name="Tip" value="copy"/>
						</action> 
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtMaster">
				<parameter name="@action" value="masterGrid"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtFormule">
				<parameter name="@action" value="tabFormule"/>
				<parameter name="@OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtKoeficijent">
				<parameter name="@action" value="tabKoeficijent"/>
				<parameter name="@OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
			</data>
			<data command="spDDDefaultIsplateQuery_Jadranka" name="dtVirmani">
				<parameter name="@action" value="tabVirmani"/>
				<parameter name="@OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId"/>
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtBrisi">
				<parameter name="@action" value="obrisi" />
				<parameter name="@OOPIsStavkeId" value="#grdDrugiDohodak.@OOPIsStavkeId" />
			</data>
			<data command="spDDDefaultIsplateAzur_Jadranka" name="dtBrisiKoef">
				<parameter name="@action" value="obrisi_Koef" />
				<parameter name="@OOPIsStavkeKoefId" value="#grdKoeficijent.@OOPIsStavkeKoefId" />
			</data>
		</datalist>
	</form>
	<form name="frmPromjenaUnosBrisanjeOOPIsStavke" path="frmPromjenaUnosBrisanjeOOPIsStavke.xml"/>
	<form name="frmAzuriranjeFormule" path="frmAzuriranjeFormule.xml"/>
	<form name="frmUnosFormula" path="frmAzuriranjeFormule.xml"/>
	<form name="frmAzuriranjeKoeficijenta" path="frmAzuriranjeKoeficijenta.xml"/>
	<form name="frmUnosKoeficijenta" path="frmAzuriranjeKoeficijenta.xml"/>
	<form name="frmAzuriranjeVirmani" path="frmAzuriranjeVirmani.xml"/>
	<form name="frmUnosVirmana" path="frmAzuriranjeVirmani.xml"/>
	<form name="frmBrojRacuna" path="frmAzuriranjeVirmani.xml"/>
	<form name="frmKopiranjeIsplate" path="frmKopiranjeIsplate.xml"/>
</root>