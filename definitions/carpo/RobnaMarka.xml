<!-- MH Radila na Jupiter2017, Spin -->

<root>
	<form name="frmMaster" type="master" caption="Robna marka">
		<event type="init">
			<!-- <action type="form open" value="frmPar"/> -->
			<action type="datarun scalar" value="Global.~dtCheckPermission">
				<parameter name="Global.Smije"/>
			</action>	
		</event>
		<event type="load">
			<action type="form open" value="frmPar"/>
		</event>	
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtRobnaMarka" key="RobnaMarkaId" savelayout="true" statusbar="true">
				<event type="doubleclick">
					<action if="global.$Smije==1">
						<action type="form open" value="frmRobnaMarkaInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="RobnaMarkaId" value="#grdMaster.@RobnaMarkaId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</action>
					<action else="">
						<action type="message" value="Nemate dopuštenje mijenjati robne marke"/>
					</action>
				</event> 
				<fields inherited="true">
				</fields>
				<print  caption="Robna marka" captionalign="center"/>				
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true" >
			<buttons>
				<button name="btnPronadji" caption="Filter" dock="left" > <!-- image="calendar" imagelocation="middleleft" -->
					<event type="click"> 
						<action type="form open" value="frmPar"/>
						<action type="control populate" value="#grdMaster"/>
					</event>
				</button>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<menuitem control="#grdMaster" sort="1"/>
					<event type="click">
						<action type="form open" value="frmRobnaMarkaInsertEdit" >
							<parameter name="RobnaMarkaId" value="null" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$RobnaMarkaId" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit" >
					<menuitem control="#grdMaster" sort="2"/>
					<event type="click">
						<action type="form open" value="frmRobnaMarkaInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="RobnaMarkaId" value="#grdMaster.@RobnaMarkaId" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$RobnaMarkaId" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="confirm" value="Želite li obrisati Robnu marku?">
							<action type="datarun nonquery" value="global.~dtDelete">
								<action type="control populate" value="#grdMaster"/>
							</action>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmRobnaMarkaInsertEdit" path="frmRobnaMarkaInsertEdit.xml" />
	<form name="frmPar" path="frmPar.xml" />

	<datalist>
		<data command="spRobnaMarka_Query" name="dtRobnaMarka">
			<parameter name="@Action" value="6" />
			<parameter name="@uvjet" value="global.$RobnaMarka" />
			<parameter name="@partneriid" value="global.$Partneriid" />
		</data>
<!-- 		<data command="spRobnaMarka_Query" name="dtMaster">
			<parameter name="@Action" value="0" />
		</data> -->
		<data command="spProd_CheckPermission" name="dtCheckPermission">
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@Objekt" value="RobnaMarka" />
			<parameter name="@Funkcija" value="edit" />
		</data>
		<data command="spRobnaMarka_Azur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@RobnaMarkaId" value="#grdMaster.@RobnaMarkaId" />
		</data>
	</datalist>
</root>