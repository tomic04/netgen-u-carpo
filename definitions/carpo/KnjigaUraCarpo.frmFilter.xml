<?xml version="1.0" encoding="utf-8"?>
<!-- GODINA_FORM - parametri za Knjiga URA: Godina, Vrsta knjige, Datum zaključka -->
<root version="1.2">
  <form name="frmFilter" type="custom" caption="Parametri" width="400">
    <event type="oninit">
      <action type="datarun reader" value="~dtDefaults"/>
      <action type="control value" value="#numGodina">
        <parameter value="~dtDefaults.@Godina"/>
      </action>
      <action type="control value" value="#cmbVrstaKnjige">
        <parameter value="~dtDefaults.@KntVrsteKnjigaUraId"/>
      </action>
      <action type="control value" value="#datZakljucek">
        <parameter value="~dtDefaults.@DatZak"/>
      </action>
    </event>
    <layout>
      <group rows="4" cols="1">
        <item row="1" col="1" caption="Godina:">
          <textedit name="numGodina" format="n0" savevalue="app"/>
        </item>
        <item row="2" col="1" caption="Vrsta knjige:">
          <comboedit name="cmbVrstaKnjige" dataname="~dtVrsteKnjiga" valuefield="KntVrsteKnjigaUraId" displayfield="Nazivknjige" savevalue="app"/>
        </item>
        <item row="3" col="1" caption="Datum zaključka:">
          <dateedit name="datZakljucek" savevalue="app"/>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnOk" caption="Izvrši">
          <event type="click">
            <action type="variable value">
              <parameter name="global.$Godina" value="#numGodina"/>
              <parameter name="global.$KntVrsteKnjigaUraId" value="#cmbVrstaKnjige"/>
              <parameter name="global.$DatZak" value="#datZakljucek"/>
              <parameter name="global.$Node" value="null"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel">
          <event type="click">
            <action type="variable value">
              <parameter name="global.$Close" value="true" type="bool"/>
            </action>
            <action type="form close"/>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data name="dtDefaults" command="select year(getdate()) as Godina, 23 as KntVrsteKnjigaUraId, getdate() as DatZak" type="text"/>
      <data name="dtVrsteKnjiga" command="select KntVrsteKnjigaUraId, Nazivknjige from KntVrsteKnjigaUra"/>
    </datalist>
  </form>
</root>
