<root version="1.0">
	<!--
  Komentari:
  8.9.2021. Marin Glavaš - dodao captione u check kontrole
  06.08.2021. Jadranka Vučenović Vojvodić - kreirala granulu ver 1.0.
  -->
	<!--
  *******************************************************************************************
  POČETNA FORMA
  *******************************************************************************************
  -->
	<form type="master" name="frmPocetna" caption="Dokumenti, isprave i certifikati" saveformsize="false" showversion="true" version="1.0">
		<event type="load">
			<action if="#tree.@id==-1">
				<action type="control disable" value="#btnEdit,#btnDelete"></action>
			</action>
		</event>

		<managerlayout>

			<lookup name="cmbFilter">
				<comboitem value="Aktivne" />
				<comboitem value="Umirovljene" />

				<event type="valuechanged">
					<action type="variable value">
						<parameter name="global.filter" value="#cmbFilter" />
					</action>
					<action type="control populate" value="#tree"></action>

				</event>
			</lookup>
			<tree name="tree" keyfield="HRIspraveId" allowselfdrag="true" dataname="~dtIspraveTree" showcolumns="true" autofiltercondition="contains" expandallonload="true" expandedlevel="2">
				<fields>
					<field name="Naziv"/>
					<field name="Oznaka" />
					<field name="IndIzbor" caption="Izbor"/>
					<field name="IndPrikaz" caption="Prikaz"/>
					<!-- <field name="Umirovljeno" /> -->
				</fields>

				<event type="focusedrowchanged">
					<action if="#tree.@id==-1">
						<action type="control disable" value="#btnEdit,#btnDelete"></action>
					</action>
					<action else="">
						<action type="control enable" value="#btnEdit,#btnDelete"></action>
					</action>
				</event>
			</tree>
		</managerlayout>


		<panelbuttons displaycontrolsprint="false">
			<buttons type="tree">
				<button name="btnDrag" caption="Spremi promjene" type="selfdrag" >
					<event type="click">
						<action type="datarun nonquery" value="~dtIspraveAzur" />
						<action type="control defaultmode" value="#tree" />
					</event>
				</button>

				<button name="btnDrag" caption="Odustani" type="selfdragcancel">
					<event type="click">
						<action type="confirm" value="Želite odustati od reorganizacije?">
							<action type="control populate" value="#tree" />
							<action type="control dragmode" value="#tree" />
						</action>
					</event>
				</button>
				<button name="btnUnesi" caption="Unesi" type="add" begingroup="true" >
					<event type="click">
						<action type="form open" value="frmPromjena">
							<parameter name="id" value="0" />
							<parameter name="FormType" value="Unos" />
						</action>
					</event>  
				</button>

				<button name="btnEdit" caption="Izmjeni" type="edit">
					<event type="click">
						<action type="form open" value="frmPromjena" >
							<parameter name="Id" value="#tree.@Id" />
							<parameter name="FormType" value="Izmjena" />
						</action>
						<action type="control populate keepfocus" value="#tree" />
					</event>
				</button>

				<button name="btnDelete" caption="Obriši" type="delete" >
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati {#tree.@Naziv}?" if="#tree.@ID!=-1">
							<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate keepfocus" value="#tree" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spHRIsprave_CP" name="dtIspraveTree">
				<parameter name="@Action" value="getTree" />
				<parameter name="@filter" value="global.$filter"/>
			</data>
			<data command="spHRIsprave_CP" name="dtIspraveAzur">
				<parameter name="@Action" value="setTree" />
				<parameter name="@TableVar" value="#tree.datasource" />
			</data>
			<data command="spHRIsprave_CP" name="dtDelete">
				<parameter name="@Action" value="BRISANJE" />
				<parameter name="@id" value="#tree.@Id"/>
			</data>

		</datalist>

	</form>

	<!--FORMA ZA UNOS/IZMJENU SMJEŠTAJA-->

	<form name="frmPromjena" caption="{$formType}" fixedsize="true">
		<event type="init">
			<action type="datarun reader" value="~dtGets" if="$Id!=0" />
		</event>
		<event type="shown">
			<action if="$FormType=='Izmjena'">
				<action type="control value" value="#cmbDokument">
					<parameter text="~dtGets.@Naziv2" value="~dtGets.@HRIspraveId" />
				</action>
			</action>
			<action type="control value" value="#cmbDokument">
			<parameter text="parent.#tree.@Naziv" value="parent.#tree.@ParentId"/>
			</action>
		</event>


		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
				<group row="1" col="1" cols="1" rows="6" spacing="2,2,2,2">
					<item caption="Naziv:" col="1" row="1" textposition="top" highlight="false">
						<textedit name="txtNaziv" datavalue="~dtGets.@Naziv" allownull="false" required="true" maxlength="50"></textedit>
					</item>
					<item caption="Oznaka:" col="1" row="2" textposition="top" highlight="false">
						<textedit name="txtOznaka" datavalue="~dtGets.@Oznaka" allownull="false" required="true" tooltip="Jedinstvena oznaka unutar kataloga" maxlength="50"></textedit>
					</item>
					<item row="3" col="1" caption="Dokument:" textposition="top" highlight="false" >
						<comboedit name="cmbDokument" valuefield="HRIspraveid" displayfield="Naziv" dataname="~dtDokument" />
					</item>
					<item col="1" row="4" highlight="false">
						<checkedit caption="Mogućnost izbora" name="chkIndIzbor" datavalue="~dtGets.@IndIzbor"></checkedit>
					</item>
					<item col="1" row="5" highlight="false">
						<checkedit caption="Mogućnost prikaza" name="chkIndPrikaz" datavalue="~dtGets.@IndPrikaz"></checkedit>
					</item>
					<item col="1" row="6" highlight="false">
						<checkedit caption="Umirovljeno" name="chkUmirovljeno" datavalue="~dtGets.@Umirovljeno"></checkedit>
					</item>
				</group>
			</group>
			<!--kraj omotača-->
		</layout>


		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action if="$Id==0">
							<action type="datarun reader" value="~dtUnos">
								<action type="control populate" value="parent.#tree">
									<action type="control focus" value="parent.#tree">
										<parameter value="$noviID"/>
									</action>
								</action>
							</action>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!" />
								<action type="form close" />
							</action>
						</action>
						<action if="$Id!=0">
							<action type="datarun reader" value="~dtIzmjena"></action>
							<action if="$indGreske==0">
								<action type="message" value="Uspješno spremljeno!" />
								<action type="form close" />
							</action>

							<!--<action type="form close"></action>-->
						</action>
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" dock="right">
					<event type="click">
						<action type="form close" />
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spHRIsprave_CP" name="dtDokument">
				<parameter name="@action" value="getDokument" />
			</data>
			<data command="spHRIsprave_CP" name="dtGets">
				<parameter name="@action" value="getGet"></parameter>
				<parameter name="@id" value="$Id"></parameter>
			</data>
			<data command="spHRIsprave_CP" name="dtUnos">
				<parameter name="@action" value="UNOS"></parameter>
				<parameter name="@Id.output.int" variablename="noviID"></parameter> 
				<parameter name="@oznaka" value="#txtOznaka"></parameter>
				<parameter name="@naziv" value="#txtNaziv"></parameter>
				<parameter name="@IndIzbor" value="#chkIndIzbor"></parameter>
				<parameter name="@IndPrikaz" value="#chkIndPrikaz"></parameter>
				<parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
				<parameter name="@Sortkey" value="parent.#tree.@SortKey"/>
				<parameter name="@ids" value="parent.#tree.@ParentId"/>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
			<data command="spHRIsprave_CP" name="dtIzmjena">
				<parameter name="@action" value="IZMJENA"></parameter>
				<parameter name="@Id" value="$Id"></parameter>
				<parameter name="@oznaka" value="#txtOznaka"></parameter>
				<parameter name="@naziv" value="#txtNaziv"></parameter>
				<parameter name="@IndIzbor" value="#chkIndIzbor"></parameter>
				<parameter name="@IndPrikaz" value="#chkIndPrikaz"></parameter>
				<parameter name="@umirovljeno" value="#chkUmirovljeno"></parameter>
				<parameter name="@Sortkey" value="parent.#tree.@SortKey"/>
				<parameter name="@indGreske.output.int"></parameter>
			</data>
		</datalist>
	</form>



</root>