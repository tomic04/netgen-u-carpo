<root>
	<form name="frmGlavna" type="master" caption="Opcije">
		<managerlayout>
			<grid name="grdGlava" type="master" dataname="~dtNapuniGrid" multiselect="true">
				<fields>
					<field name="Dimenzija" caption="Dimenzija" />
					<field name="Naziv" caption="Naziv" />
					<field name="Sifra" caption="Šifra" />
				    <field name="Adresa" caption="Adresa" />
				    <field name="KatastarskiBrojCestice" caption="Katastarski broj čestice" />
				    <field name="ZemljisnoKnjiznaCestica" caption="Zemljišnoknjižna čestica" />
				    <field name="ZemljisnoKnjizniUlozak" caption="Zemljišnoknjižni uložak" />
				    <field name="Naziv1" caption="Katastarska općina" />
				    <field name="TipOpcije" caption="Tip opcije" />
				    <field name="Status" caption="Status" />
				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnesi">
						</action>
					</event>
				</button>
				<button name="btnIzmjeni" caption="IZMJENI">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
							<parameter name="UgovoriNajamOpcijeID" value="#grdGlava.@UgovoriNajamOpcijeID" />
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI">
				<event type="click">
					<action type="confirm" value="Jeste li sigurni da želite obrisati odabrane stavke?" />
					<action type="control foreachrow selected" value="#grdGlava">
					<action type="datarun nonquery" value="~dtDelete" />
					</action>
					<action type="control populate" value="#grdGlava" />
				</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spUgovoriNajamOpcije_Query" name="dtNapuniGrid" />
			<data command="spUgovoriNajamOpcije_Delete" name="dtDelete">
				<parameter name="@UgovoriNajamOpcijeID" value="#grdGlava.@UgovoriNajamOpcijeID" />
			</data>
		</datalist>

	</form>

	<form name="frmUnesi" caption="Unesi">

		<event type="load">
			<action type="control disable" value="#cmbSifra" />
		</event>

		<layout>
			<group cols="1" rows="10" col="1" row="1">
				<item col="1" row="1" caption="Dimenzija:">
					<comboedit name="cmbDimenzije" valuefield="dimenzijeid" dataname="~dtGetDimenzije" displayfield="Naziv" required="true"/>
				</item>
				<item col="1" row="2" caption="Naziv:">
					<textedit name="txtNaziv" required="true"/>
				</item> 
				<item col="1" row="3" caption="Šifra:">
					<textedit name="cmbSifra" />
				</item>
				<item col="1" row="4" caption="Adresa:">
					<textedit name="txtAdresa" />
				</item>
				<item col="1" row="5" caption="Katastarski broj čestice:">
					<textedit name="txtKatBrojCestice" />
				</item>
				<item col="1" row="6" caption="Zemljišnoknjižna čestica:">
					<textedit name="txtZemKnjizCestica" />
				</item>
				<item col="1" row="7" caption="Zemljišnoknjižni uložak:">
					<textedit name="txtZemKnjizUlozak" />
				</item>
				<item col="1" row="8" caption="Katastarska općina:">
					<comboedit name="cmbKatOpcine" valuefield="UgovoriNajamOpcineID" dataname="~dtGetOpcine" displayfield="Naziv" required="true"/>
				</item>
				<item col="1" row="9" caption="Tip opcije:">
					<comboedit name="chkTipOpcije" valuefield="UgovoriNajamTipOpcijaID" dataname="~dtGetOpcije" displayfield="TipOpcije" required="true"/>
				</item>
				<item col="1" row="10" caption="Status:">
					<checkedit name="chkStatusi" value="true" />
				</item>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="~dtSpremi" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" type="cancel" caption="Odustani" dock="right" />
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="spUgovoriNajamOpcije_Dimenzije_Query" name="dtGetDimenzije">
				<parameter name="@dimVrsteid" value="4" />
				<parameter name="@action" value="1" />
			</data>
			<data command="spUgovoriNajamOpcije_GetOpcine" name="dtGetOpcine" />
			<data command="spUgovoriNajamOpcije_Insert" name="dtSpremi">
				<parameter name="@dimenzijeid" value="#cmbDimenzije" />
				<parameter name="@naziv" value="#txtNaziv" />
				<parameter name="@adresa" value="#txtAdresa" />
				<parameter name="@KatastarskiBrojCestice" value="#txtKatBrojCestice" />
				<parameter name="@ZemljisnoKnjiznaCestica" value="#txtZemKnjizCestica" />
				<parameter name="@ZemljisnoKnjizniUlozak" value="#txtZemKnjizUlozak" />
				<parameter name="@UgovoriNajamOpcineID" value="#cmbKatOpcine" />
				<parameter name="@UgovoriNajamTipOpcijeID" value="#chkTipOpcije" />
				<parameter name="@Status" value="#chkStatusi" />
			</data>
			<data command="spUgovoriNajamOpcije_getTipOpcije" name="dtGetOpcije" />
		</datalist>
	</form>

<form name="frmIzmjeni" caption="Izmjeni">

	<event type="init">
		<action type="datarun reader" value="~dtGet" />
	</event>

	<event type="onload">
		<action type="control disable" value="#txtSifra" />
		<action type="control disable" value="#cmbdimenzije" />
	</event>

	<layout>

		<group cols="1" rows="10" col="1" row="1">
			<item col="1" row="1" caption="Dimenzija:">
				<comboedit name="cmbDimenzije" valuefield="dimenzijeid" dataname="~dtGetDimenzije" displayfield="Naziv" datavalue="~dtGet.@dimenzijeid"/>
			</item>
			<item col="1" row="2" caption="Naziv:">
				<textedit name="txtNaziv" datavalue="~dtGet.@naziv" required="true"/>
			</item>
			<item col="1" row="3" caption="Šifra:">
				<textedit name="txtSifra" datavalue="~dtGet.@sifra" />
			</item>
			<item col="1" row="4" caption="Adresa:">
				<textedit name="txtAdresa" datavalue="~dtGet.@Adresa" />
			</item>
			<item col="1" row="5" caption="Katastarski broj čestice:">
				<textedit name="txtKatBrojCestice" datavalue="~dtGet.@KatastarskiBrojCestice" />
			</item>
			<item col="1" row="6" caption="Zemljišnoknjižna čestica:">
				<textedit name="txtZemKnjizCestica" datavalue="~dtGet.@ZemljisnoknjiznaCestica" />
			</item>
			<item col="1" row="7" caption="Zemljišnoknjižni uložak:">
				<textedit name="txtZemKnjizUlozak" datavalue="~dtGet.@ZemljisnoKnjizniUlozak" />
			</item>
			<item col="1" row="8" caption="Katastarska općina">
				<comboedit name="cmbKatOpcine" dataname="~dtGetOpcine" valuefield="UgovoriNajamOpcineID" displayfield="Naziv" datavalue="~dtGet.@UgovoriNajamOpcineID" required="true" />
			</item>
			<item col="1" row="9" caption="Tip opcije:">
				<comboedit name="chkTipOpcije" valuefield="UgovoriNajamTipOpcijaID" dataname="~dtGetOpcije" displayfield="TipOpcije" datavalue="~dtGet.@UgovoriNajamTipOpcijeID" required="true"/>
			</item>
			<item col="1" row="10" caption="Status">
				<checkedit name="chkStatusi" datavalue="~dtGet.@Status" />
			</item>
		</group>

		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="Spremi">
					<event type="click">
						<action type="validate" />
						<action type="datarun nonquery" value="dtUpdate" />
						<action type="control populate" value="parent.#grdGlava" />
						<action type="form close" />
					</event>
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
			</buttons>
		</panelbuttons>



	<datalist>

		<data command="spUgovoriNajamOpcije_EditQuery" name="dtGet">
			<parameter name="@UgovoriNajamOpcijeID" value="$UgovoriNajamOpcijeID" />
		</data>
			<data command="spUgovoriNajamOpcije_Dimenzije_Query" name="dtGetDimenzije">
				<parameter name="@dimVrsteid" value="4" />
				<parameter name="@action" value="0" />
			</data>
		<data command="spUgovoriNajamOpcije_GetOpcine" name="dtGetOpcine" />
		<data command="spUgovoriNajamOpcije_Update" name="dtUpdate">
			<parameter name="@UgovoriNajamOpcijeID" value="$UgovoriNajamOpcijeID" />
			<parameter name="@Dimenzijeid" value="#cmbDimenzije" /> -->
			<parameter name="@Naziv" value="#txtNaziv" />
			<parameter name="@Sifra" value="#txtSifra" />
			<parameter name="@Adresa" value="#txtAdresa" />
			<parameter name="@KatastarskiBrojCestice" value="#txtKatBrojCestice" />
			<parameter name="@ZemljisnoknjiznaCestica" value="#txtZemKnjizCestica" />
			<parameter name="@ZemljisnoKnjizniUlozak" value="#txtZemKnjizUlozak" />
			<parameter name="@UgovoriNajamOpcineID" value="#cmbKatOpcine" />
			<parameter name="@UgovoriNajamTipOpcijeID" value="#chkTipOpcije" />
			<parameter name="@Status" value="#chkStatusi" />
		</data>
		<data command="spUgovoriNajamOpcije_getTipOpcije" name="dtGetOpcije" />

	</datalist>

	</form>

</root>