<root>
	<form name="frmGlava" caption="CPV kodovi" type="master">
		<managerlayout>
			<grid name="grdMaster" dataname="~dtCpvGrid" type="master" key="cpvid">
				<fields>
					<field name="cpvid" caption="CpvId" visible="false" />
					<field name="code" caption="CODE" width="300" />
					<field name="opis" caption="Opis" />
				</fields>
			</grid>
		</managerlayout>
	<panelbuttons>
		<buttons>

			<button name="btnIzmjena" caption="TEST COMBO">
				<event type="click">
					<action type="form open" value="frmIzmijeni">
						<parameter name="id" value="#grdMaster.@cpvId" />
					</action>
				</event>
			</button>

		</buttons>
	</panelbuttons>
	<datalist>
		<data command="spNab_CpvKod_Query" name="dtCpvGrid" />
		<data command="spNab_CpvKod_Delete" name="dtBrisi">
			<parameter name="id" value="#grdMaster.@cpvid" />
		</data>
	</datalist>
	</form>
	<form name="frmUnos" caption="Unesi">
		<event type="close">
			<action type="control focus" value="parent.#grdMaster">
				<parameter value="$Id" type="int"/>
			</action>
		</event>
		<layout>
			<group cols="7" rows="1" col="1" row="1">
				<item col="1" row="1" caption="CODE:" colspan="2">
					<textedit name="txtCode" />
				</item>
				<item col="3" row="1" caption="Opis:" colspan="5">
					<textedit name="txtOpis" />
				</item>
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnSpremi" caption="SPREMI">
						<event type="click">
							<action type="datarun nonquery" value="~dtInsert" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="datarun reader" value="~dtGetId" />
							<action type="variable value">
								<parameter name="id" value="~dtGetId.@cpvid" />
							</action>
							<action type="form close" />
						</event>
					</button>
					<button name="btnIzlaz" caption="IZLAZ" type="cancel" dock="right" /> 
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spNab_CpvKod_Insert" name="dtInsert">
				<parameter name="@code" value="#txtCode" />
				<parameter name="@opis" value="#txtOpis" />
			</data>
			<data command="spNab_CpvKod_getID" name="dtGetId" />
		</datalist>
	</form>
	<form name="frmIzmijeni" caption="Combo">
		<layout>
			<group cols="1" rows="6" col="1" row="1">
				<item caption="Multiedit (naziv org. sheme)" row="1" col="1" textalignmode="top">
					<combomultiedit name="cmbOrgShema1" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema" showmultiselecttext="true" />
				</item>
				<item caption="Multiedit (vodeći blankovi + naziv org. sheme)" row="2" col="1" textalignmode="top">
					<combomultiedit name="cmbOrgShema2" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema2" showmultiselecttext="true" />
				</item>	
				<item caption="Comboedit (naziv org. sheme)" row="3" col="1" textalignmode="top">
					<comboedit name="cmbOrgShema3" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema" showmultiselecttext="true" />
				</item>
				<item caption="Comboedit (vodeći blankovi + naziv org. sheme)" row="4" col="1" textalignmode="top">
					<comboedit name="cmbOrgShema4" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema2" showmultiselecttext="true" />
				</item>
				<item caption="TreeEdit (naziv org. sheme)" row="5" col="1" textalignmode="top">
					<combotreeedit name="cmbOrgShema5" parentfieldname="ParentId" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema3" showmultiselecttext="true" />
				</item>
				<item caption="TreeEdit (vodeći blankovi + naziv org. sheme)" row="6" col="1" textalignmode="top">
					<combotreeedit name="cmbOrgShema6" parentfieldname="ParentId" valuefield="OrgShemaId" displayfield="Naziv" dataname="dtOrgShema4" showmultiselecttext="true" />
				</item>				
			</group>
		</layout>
		<panelbuttons>
				<buttons>
					<button name="btnIzlaz" caption="IZLAZ" type="cancel" dock="right" /> 
				</buttons>
		</panelbuttons>
		<datalist>
			<data command="spComboTest" name="dtOrgShema">
				<parameter name="@action" value="0" />
			</data>
			<data command="spComboTest" name="dtOrgShema2">
				<parameter name="@action" value="1" />
			</data>	
			<data command="spComboTest" name="dtOrgShema3">
				<parameter name="@action" value="2" />
			</data>
			<data command="spComboTest" name="dtOrgShema4">
				<parameter name="@action" value="3" />
			</data>				
		</datalist>
	</form>
</root>