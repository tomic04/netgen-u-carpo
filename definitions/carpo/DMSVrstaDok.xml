<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="master" type="master" caption="DMS Vrsta">
    
    <event type="init">
 			<action type="control populate" value="#grdGrid"/>
		</event>       
		<event type="shown">
			<action type="variable value" >
				<parameter name="NoviId" value="0" type="int"/>
			</action>   			
		</event>
    
		<managerlayout>        
			<event type="load">
				<action type="variable value" >
					<parameter name="NoviId" value="0" type="int"/>
				</action>                                           
			</event>  
      
			<grid name="grdGrid" dataname="dtGrid" key="VrstaDokumentaId" type="master" bestfitonrefresh="True">
        <fields>
					<field name="Oznaka" caption="Oznaka" fixwidth="100" />
					<field name="Naziv" caption="Naziv" fixwidth="200"/>
					<field name="Aktivan" caption="Aktivan" fixwidth="100"/> 
				</fields>
            
          
				<event type="focusedrowchanged">
					<action type="control enable" value="#btnObrisi,#btnIzmijeni" if="#grdGrid.rowcount!=0"/>
					<action type="control disable" value="#btnObrisi,#btnIzmijeni" else=""/>
				</event>
        
				<event type="doubleclick">
					<action type="form open" value="frmVrstaDokumenta"  if="#grdGrid.rowcount&gt;0">
						<parameter name="tekst" value="izmijena"/>
						<parameter name="VrstaDokumentaId" value="#grdGrid.@kVrstaDokumentaId"/>
						<parameter name="Action" value="1"/>
					</action>

					<action type="control populate" value="#grdGrid">
						<action type="control focus" value="#grdGrid">
							<parameter value="#grdGrid.@VrstaDokumentaId"/>
						</action>					
					</action>
				</event>
			</grid>
		</managerlayout>
		
		<panelbuttons>
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add">
					<menuitem control="#grdGrid"/>
					<event type="click">
						<action type="form open" value="frmVrstaDokumenta">
							<parameter name="tekst" value="unos"/>
							<parameter name="Action" value="0"/>
						</action>	
						
					</event>
				</button>

				<button name="btnIzmijeni" caption="IZMIJENI" type="edit">
					<menuitem control="#grdGrid"/>				
					<event type="click">
						<action type="form open" value="frmVrstaDokumenta"  if="#grdGrid.rowcount&gt;0">
							<parameter name="tekst" value="izmijena"/>
							<parameter name="VrstaDokumentaId" value="#grdGrid.@VrstaDokumentaId"/>
							<parameter name="Action" value="1"/>
						</action>	
											
					</event>
				</button>

				<button name="btnObrisi" caption="OBRIŠI" type="delete">
					<menuitem control="#grdGrid"/>
					<event type="click">
						<action type="confirm" value="Želite li obrisati DMS vrstu dokumenta: {#grdGrid.@Naziv}?">
							<action type="datarun nonquery" value="~dtDelete" >
								<action type="control populate" value="#grdGrid" />
							</action>
						</action>
					</event>
				</button>
        
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="dms.spDMSVrstaDokumentaQuery" name="dtGrid">
        <parameter name="@action" value="grid" />
      </data>
        
	
			<data command="dms.spDMSVrstaDokumentaAzur"  name="dtDelete">
				<parameter name="@Action" value="2" />
				<parameter name="@VrstaDokumentaId" value="#grdGrid.@VrstaDokumentaId" />
			</data>
		</datalist>
	</form>

	<form name="frmVrstaDokumenta" caption="Vrsta Dokumenta :: {$tekst}" width="400" fixedsize="true">
		<event type="init">		
			<action type="datarun reader" value="~dtGetIndikator" />
			<action type="datarun reader" value="~dtGetDataEdit" if="$VrstaDokumentaId!=null"/>
		</event>
		<event type="load">
			<action type="control value" value="#txtOznaka" if="$VrstaDokumentaId!=null">
				<parameter value="~dtGetDataEdit.@Oznaka"/>
			</action>
			<action type="control value" value="#txtNaziv"  if="$VrstaDokumentaId!=null">
				<parameter value="~dtGetDataEdit.@Naziv"/>
			</action>
			<action type="control value" value="#ckeAktivan"  if="$VrstaDokumentaId!=null">
				<parameter value="~dtGetDataEdit.@Aktivan"/>
			</action>
		</event>
		<layout textposition="left">
			<group cols="1" rows="3" >
				<item caption="Oznaka:" col="1" row="1">
					<textedit name="txtOznaka" required="True"   />
				</item>
				<item caption="Naziv:" col="1" row="2">
					<textedit name="txtNaziv" required="True"   />
				</item>				
				<item caption="Aktivan" col="1" row="3">
					<checkedit name="ckeAktivan" required="true" caption="Aktivan"   />
				</item>	
			
			</group>
		</layout>			
		<datalist>
			<data command="select case when ckeAktivan = 'True' then 1 else 0  as Aktivan" type="checkedit" name="ckeAktivan">
			</data>
			<data command="spDMSVrstaDokumentaAzur" name="dtAdd">
				<parameter name="@Action" value="$Action"/>
				<parameter name="@VrstaDokumentaId" value="$rstaDokumentaId"/>
				<parameter name="@Oznaka" value="#txtOznaka"/>	
				<parameter name="@Naziv" value="#txtNaziv"/>
				<parameter name="@Aktivan" value="#ckeAktivan"/>
			</data>
			<data command="dms.spDMSVrstaDokumentaQuery"  name="dtGetDataEdit">
        <parameter name="@action" value="edit" />
				<parameter name="@VrstaDokumentaId" value="$VrstaDokumentaId" />
			</data>
			
		</datalist>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="SPREMI">
					<event type="click">
						<!-- <action type="validate" /> -->
						<action type="datarun scalar" value="~dtAdd">
							<parameter name="parent.$Noviid" />
						</action>
						<action type="form close"/>
            
            <action type="control populate" value="parent.#grdGrid">
              
            <action type="control focus" value="parent.#grdGrid" if="$Action==0">
               <parameter value="parent.$Noviid" />
            </action>   

             <action type="control focus" value="parent.#grdGrid" if="$Action==1">
                 <parameter value="$VrstaDokumentaId" />
               </action>
            </action>
            
        
					</event>
				</button>
				<button name="btnOdustani" caption="ODUSTANI" type="cancel">
          <event type="click">
              <action type="control focus" value="parent.#grdGrid" if="$Action==1">
                 <parameter value="$VrstaDokumentaId" />
               </action> 
          </event>
        </button>
			</buttons>
		</panelbuttons>
	</form>

</root>