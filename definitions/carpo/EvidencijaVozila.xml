<?xml version="1.0" encoding="utf-8"?>
<root>
	<form name="master" type="master" caption="Evidencija vozila" width="1100" height="600">
		<managerlayout>
		<grid name="grdGlava" type="master">
			<fields>
				<field name="registracija" caption="Registracija"/>
				<field name="Vozač" caption="Vozač"/>
				<field name="Prijevoznik" caption="Prijevoznik"/>
			</fields>
			<data command="spEvidencijaVozilaQuery" name="dtEvidencijaVozilaQuery">
			</data>
		</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
					<button name="btnUnesi" caption="UNESI" type="add">
						<event type="click">
							<action type="form open" value="frmEvidencijaVozilaUnos" />
							<action type="control populate keepfocus" value="#grdGlava" />
						</event>
					</button>
					<button name="btnIzmijeni" caption="IZMIJENI" type="edit">
						<event type="click">
							<action type="form open" value="frmEvidencijaVozilaIzmjena">
								<parameter name="KamionId" value="#grdGlava.@KamionId"/>
							</action>
							<action type="control populate keepfocus" value="#grdGlava" />
						</event>
					</button>
					<button name="btnObrisi" caption="OBRIŠI" type="delete">
						<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati stavku?"></action>
							<action type="datarun nonquery" value="Global.dtEvidencijaVozilaDelete"/>
							<action type="control populate" value="#grdGlava" />
						</event>
					</button>
			</buttons>
		</panelbuttons>
	</form>
	<datalist>
		<data command="spEvidencijaVozilaDelete" name="dtEvidencijaVozilaDelete">
			<parameter name="kamionid" value="#grdGlava.@kamionId"/>
		</data>
	</datalist>
	<form name="frmEvidencijaVozilaUnos" path="frmEvidencijaVozilaUnos.xml"></form> 
	<form name="frmEvidencijaVozilaIzmjena" path="frmEvidencijaVozilaIzmjena.xml"></form> 
</root>
