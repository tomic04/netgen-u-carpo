<root version="1.0.0.">
	<form name="frmPregledKnjiga" type="master" caption="Pregled knjiga" maximized="true" template="splitter" statusbar="true">
		<event type="shown">
			<action type="control focus" value="#cmbKnjiga"/>
		</event>
		<layout name="panel1" type="collapsable">
			<group cols="2" rows="3">
				<columnsdefinition>
					<column size="120" position="1"/>
					<column size="120" position="2"/>
				</columnsdefinition>
				<item col="1" row="1" colspan="2" caption="Knjiga:" highlight="false" tabindex="1">
					<comboedit name="cmbKnjiga" required="true" dataname="~dtKnjiga" valuefield="Id" displayfield="Naziv" allownull="false" savevalue="app">
						<event type="valuechanged">
							<action type="control populate" value="#cmbVrsta"/>
						</event>
					</comboedit>
				</item>
				<item col="1" row="2" colspan="2" caption="Vrsta:" highlight="false" tabindex="2">
					<comboedit name="cmbVrsta" required="true" dataname="~dtVrsta" valuefield="Id" displayfield="NazivKnjige" allownull="false" savevalue="app">

					</comboedit>
				</item>
				<item col="1" row="3" caption="Od:" highlight="false" tabindex="3">
					<dateedit name="datOd"  required="true" savevalue="app">

					</dateedit>
				</item>	
				<item col="2" row="3" caption="Do:" highlight="false" tabindex="4">
					<dateedit name="datDo"  required="true" savevalue="app">
						<event type="leave">
							<action type="control focus" value="#btnPokazi"/>
						</event>
					</dateedit>				
				</item>				
			</group>
		</layout>
		<layout name="panel2">
			<group cols="1" rows="1">
				<item col="1" row="1">
					<grid name="grdIRA" fieldsmartspaces="false" dataname="~dtGlavni" savelayout="true" bestfitonrefresh="true" multiselect="true">
						<fields inherited="true">
							<field name="RedniBroj" caption="1\nRedni\nbroj"/>
							<field name="Broj" caption="2\nBroj računa"/>
							<field name="DatumDok" caption="3\nDatum računa"/>
							<field name="Naziv" caption="4\nNaziv-ime i prezime i\nsjedište/prebivalište \nili uobičajeno boravište dobavljača"/>
							<field name="PorezniBroj" caption="5\nPDVID broj\nOIB"/>
							<field name="IznosSaPorezom" caption="6\nIznos\n(s PDV-om)"/>
							<field name="Tuz_Obv" caption="7\nTuzemni prijenos\nporezne obveze"/>
							<field name="Isp_Drugim" caption="8\nIsporuke dobara\nu drugim\ndržavama članicama"/>
							<field name="Isp_EU" caption="9\nIsporuke dobara\nunutar EU"/>			
							<field name="Usl_EU" caption="10\nObavljene usluge\nunutar EU"/>
							<field name="Usl_Osb" caption="11\nObavljene usluge\nosobama bez\nsjedišta u RH"/>
							<field name="Sast_Dobr_EU" caption="12\nSastavljanje i postavljanje\ndobara u drugoj\ndržavi članici"/>
							<field name="Isp_NPS_EU" caption="13\nIsporuke NPS\nu EU"/>
							<field name="Tuzemstvo" caption="14\nU tuzemstvu"/>
							<field name="IznosIzvoz" caption="15\nIzvozne\nisporuke"/>
							<field name="IznosOstalo" caption="16\nOstala\noslobođenja"/>
							<field name="Osnovica5" caption="17\nOsnovica\n5%"/>
							<field name="Porez5" caption="18\nPorez\n5%"/>	
							<field name="Osnovica13" caption="19\nOsnovica\n13%"/>
							<field name="Porez13" caption="20\nPorez\n13%"/>
							<field name="Osnovica25" caption="21\nOsnovica\n25%"/>
							<field name="Porez25" caption="22\nPorez\n25%"/>
							<field name="IznosNulStopa" caption="Vrijednost\nisporuke 0%"/>
							<field name="IznosOsnovica" caption="Osnovica\n22%"/>
							<field name="IznosPorez" caption="Porez\n22%"/>
							<field name="Osnovica23" caption="Osnovica\n23%"/>
							<field name="Porez23" caption="Porez\n23%"/>	
							<field name="IznosOslPoreza" caption="Ne podliježe\noporezivanju"/>
							<field name="UVSMP" caption="Isporuke dobara\niz članka\n11.b zakona"/>
							<field name="datumValute" caption="Datum valute"/>
							<field name="Napomena" caption="Napomena"/>
							<field name="OrgNaziv" caption="Organizacijska\nshema"/>
							<field name="VrstaDokumenta" caption="Vrsta\ndokumenta"/>
							<field name="DevIznos" caption="Devizni\niznos"/>
							<field name="Drzava" caption="Država"/>
							<field name="Valuta" caption="Valuta"/>	
							<field name="ProlazneStavke" caption="Prolazne\nstavke"/>
							<field name="Osnovica10" caption="Osnovica\n10%"/>
							<field name="Porez10" caption="Porez\n10%"/>
						</fields>
						<styles>
							<style name="fontcolor" value="#00b300" if="#grdIRA.@KntKnjigaIraId==0&amp;&amp;#grdIRA.@Id!=3"/>
							<style name="fontcolor" value="#1E90FF" elseif="#grdIRA.@KntKnjigaIraId==0&amp;&amp;#grdIRA.@Id==3"/>							
							<style name="backgroundcolor" value="#ffffcc" if="#grdIRA.@KntKnjigaIraId==0"/>
							<style name="bold" value="true" if="#grdIRA.@KntKnjigaIraId==0"/>
						</styles>
					</grid>
				</item>
				<item col="1" row="1">
					<grid name="grdURA" dataname="~dtGlavni" fieldsmartspaces="false" savelayout="true" bestfitonrefresh="true" multiselect="true">
						<fields inherited="true">
							<field name="RedniBroj" caption="1\nRedni\nbroj"/>
							<field name="Broj" caption="2\nBroj računa" />
							<field name="BrojDok" caption="Ufa" />
							<field name="DatumDok" caption="3\nDatum računa"  />
							<field name="Naziv" caption="4\nNaziv-ime i prezime i\nsjedište/prebivalište \nili uobičajeno boravište dobavljača"  />
							<field name="PorezniBroj" caption="5\nPDVID broj\nOIB"  />
							<field name="Osnovica5" caption="6\nPorezna\nosnovica\n5%"  />
							<field name="Osnovica10_13" caption="7\nPorezna\nosnovica\n13%"  />
							<field name="Osnovica25" caption="8\nPorezna\nosnovica\n25%" />
							<field name="IznosUkupno" caption="9\nUkupni iznos\nračuna s PDV-om" />
							<field name="Pretporez" caption="10\nUkupno\n(11+12+13\n+14+15+16)" />
							<field name="PorezOdbiv5" caption="11\nMože se\nodbiti\n5%" />
							<field name="PorezNeodbiv5" caption="12\nNe može\nse odbiti\n5%" />
							<field name="PorezOdbiv10_13" caption="13\nMože se\nodbiti\n13%" />
							<field name="PorezNeodbiv10_13" caption="14\nNe može\nse odbiti\n13%" />
							<field name="PorezOdbiv25" caption="15\nMože se\nodbiti\n25%" />
							<field name="PorezNeodbiv25" caption="16\nNe može\nse odbiti\n25%" />
							<field name="NePod" caption="Ne podliježe\noporezivanju" />
							<field name="IznosNeoporeziv" caption="Osnovica\n0%" />
							<field name="Osnovica22" caption="Osnovica\n22%" />
							<field name="Osnovica23" caption="Osnovica\n23%" />
							<field name="IznosOdbitak" caption="Porez odbiv\n22%" />
							<field name="IznosNeOdbitak" caption="Porez neodbiv\n22%" />
							<field name="PorezOdbiv23" caption="Porez odbiv\n23%" />
							<field name="PorezNeodbiv23" caption="Porez neodbiv\n23%" />
							<field name="IznosPlaceni" caption="Plaćeno" />
							<field name="DatumValute" caption="Datum valute" />
							<field name="Napomena" caption="Napomena" />
							<field name="R1" caption="R1"/>
							<field name="VrstaRacuna" caption="Vrsta računa"/>
							<!-- <field name="Ind" caption=" " /> -->
							<field name="indglk" caption="IndGlk" />
							<field name="OrgNaziv" caption="Organizacijska\nshema" />
							<!-- <field name="BrojUCD" caption="Broj JCD" /> -->
							<!-- <field name="DatumUCD" caption="Datum JCD" /> -->
							<field name="BrojZakljucka" caption="Broj zaključka" />
							<field name="brojkalk" caption="Broj primke\nkalkulacije" />
							<field name="datumknjizenja" caption="Datum knjiženja\ntemeljnice" />
							<field name="DatKnjiz" caption="Datum knjiženja" />
							<field name="brojtem" caption="Broj temeljnice" />
							<field name="datDVO" caption="Datum DVO" />
							<field name="VrstaDok" caption="Vrsta dokumenta" />
							<field name="DevIznos" caption="Devizni iznos" />
							<field name="Drzava" caption="Država" />
							<field name="Valuta" caption="Valuta" />
							<field name="ProlazneStavke" caption="Prolazne stavke" />
							<field name="Osnovica10" caption="Osnovica\n10%" />
							<field name="PorezOdbiv10" caption="Može se odbiti\n10%" />
							<field name="PorezNeodbiv10" caption="Ne može\nse odbiti\n10%" />
							<field name="IndGlk" visible="false"/>
							<field name="Ind" visible="false"/>
							<field name="SortKey" visible="false"/>							
						</fields>
						<styles>
							<style name="fontcolor" value="#00b300" if="#grdURA.@KntKnjigaUraId==0&amp;&amp;#grdURA.@Id!=3"/>
							<style name="fontcolor" value="#1E90FF" if="#grdURA.@KntKnjigaUraId==0&amp;&amp;#grdURA.@Id==3"/>							
							<style name="backgroundcolor" value="#ffffcc" if="#grdURA.@KntKnjigaUraId==0"/>
							<style name="bold" value="true" if="#grdURA.@KntKnjigaUraId==0"/>
						</styles>
					</grid>
				</item>				
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnPokazi" caption="POKAŽI" tabindex="5" timeout="200">
					<event type="click">
						<action type="validate"/>
						<action type="message" value="Obvezan odabir vrste knjige!" if="#cmbVrsta==null"/>
						<action elseif="#cmbVrsta!=null">
							<action type="variable value">
								<parameter name="Vrsta" value="#cmbVrsta"/>
							</action>
							<action type="variable value">
								<parameter name="Knjiga" value="#cmbKnjiga"/>
							</action>						
							<action type="variable value">
								<parameter name="VrstaNaziv" value="#cmbVrsta.text"/>
							</action>
							<action type="variable value">
								<parameter name="KnjigaNaziv" value="#cmbKnjiga.text"/>
							</action>	
							<action if="$Knjiga==1">
								<action type="control visible" value="#grdURA">
									<parameter value="false"/>
								</action>
								<action type="control visible" value="#grdIRA">
									<parameter value="true"/>
								</action>
								<action type="control populate" value="#grdIRA"/>
								<action type="footer text" value="Broj stavki u razdoblju od {#datOd::dd.MM.yyyy}. do {#datDo::dd.MM.yyyy}. : {#grdIRA.rowcount}"/>							
							</action>
							<action elseif="$Knjiga==2">
								<action type="control visible" value="#grdIRA">
									<parameter value="false"/>
								</action>
								<action type="control visible" value="#grdURA">
									<parameter value="true"/>
								</action>
								<action type="control populate" value="#grdURA"/>
								<action type="footer text" value="Broj stavki u razdoblju od {#datOd::dd.MM.yyyy}. do {#datDo::dd.MM.yyyy}. : {#grdURA.rowcount}"/>							
							</action>						
							<action type="form caption" value="Pregled knjiga\{$KnjigaNaziv}\{$VrstaNaziv}"/>
						</action>
					</event>
				</button>
				<button name="btnIspisi" caption="ISPIŠI" tabindex="6">
					<event type="click">
						<action type="control printcontrol" value="#grdIRA" if="$Knjiga==1"/>
						<action type="control printcontrol" value="#grdURA" elseif="$Knjiga==2"/>					
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtKnjiga" command="spCKntPregledKnjigaCmb">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtVrsta" command="spCKntPregledKnjigaCmb">
				<parameter name="@Action" value="1" if="#cmbKnjiga==1"/>
				<parameter name="@Action" value="2" elseif="#cmbKnjiga==2"/>				
			</data>
			<data name="dtGlavni" command="spCKntPregledKnjiga">
				<parameter name="@Action" value="1" if="$Knjiga==1"/>
				<parameter name="@Action" value="2" elseif="$Knjiga==2"/>				
				<parameter name="@Vrsta" value="$Vrsta"/>
				<parameter name="@Od" value="#datOd"/>
				<parameter name="@Do" value="#datDo"/>				
			</data>			
		</datalist>
	</form>
</root>