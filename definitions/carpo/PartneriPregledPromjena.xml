<?xml version="1.0" encoding="utf-8"?>
<root version="1.0.0.1">
	<form name="frmMaster" type="master" caption="Pregled promjena partnera">
		<event type="init">
			<action type="form open" value="frmFilterForm" />			 	
		</event>
		<event type="load">			
			<action type="control populate" value="#grdGlava"/>			
		</event>
		<event type="shown">           

		</event>
		<managerlayout>
			<grid name="grdGlava" type="master" async="true" key="partneriid" multiselect="true" savelayout="true" cleargridfilter="true" keyfield="partneriid" wordwrap="true"> 										
				<data command="spC_Partneri_PregledPromjena_Query" timeout="180">
					<parameter name="@action" value="grid_Izvjestaj"/>
					<parameter name="@operateriid" value="@@operateriid" />
					<parameter name="@IndPartneriIzmjene" value="Global.$IndSvi" />
					<parameter name="@DatumOd" value="Global.$DatumOd" />
					<parameter name="@DatumDo" value="Global.$DatumDo" />
				</data>
				<fields>
					<field name="SifraPartnera" caption="Šifra partnera" />
					<field name="SifraLokacije" caption="Šifra lokacije" />
					<field name="VazeciNazivPartnera" caption="Važeći naziv partnera" />
					<field name="VazeciOIBPartnera" caption="Važeći OIB partnera" />
					<field name="PoljeIzmjene" caption="Polje izmjene" />
					<field name="StaraVrijednost" caption="Stara vrijednost" fixwidth="200"/>
					<field name="NovaVrijednost" caption="Nova vrijednost"  fixwidth="200"/>
					<field name="VrstaIzmjene" caption="Vrsta izmjene" />
					<field name="DatumZadnjePromjene" caption="Datum izmjene"  />
					<field name="VrijemeZadnjePromjene" caption="Vrijeme izmjene"  />
					<field name="KorisnikIzmjene" caption="Korisnik izmjene"  />

				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnFilter" caption="&amp;FILTER">
					<event type="click">
						<action type="form open" value="frmFilterForm"/>
						<action type="control populate" value="#grdGlava"/>
					</event>
				</button>
			</buttons>	
		</panelbuttons>

		<datalist>
			<data command="spC_Partneri_PregledPromjena_Query" name="dtParametri">
				<parameter name="@Action"  value="parametri" />
			</data>
		</datalist>
	</form>

	<form name="frmFilterForm" caption="Parametri upita" width="700" height="550">
		<event type="init">
			<action type="datarun reader" value="~dtDeleteSelPartnere" />	
			<action type="datarun reader" value="~dtParametri" />
		</event>
		<event type="load">
			<action type="control populate" value="#grdPartneri"/>

		</event>
		<event type="shown">  

		</event>
		<layout>
			<group caption="Odabir partnera" cols="1" rows="4" >
				<group cols="2" rows="1" col="1" row="1" groupbordervisible="false">
					<item col="1" row="1">
						<columnsdefinition>
							<column size="50%" position="1" />
							<column size="50%" position="2" />	
						</columnsdefinition>
						<checkedit name="chkPartneriIzmjene" caption="Samo partneri s izmjenama" value="1" savevalue="session">
							<event type="valuechanged">
								<action if="#chkPartneriIzmjene==False">
									<action type="control value" value="chkPartneriSvi">
										<parameter value="1" />
									</action>
									<action type="variable value" if="#chkPartneriIzmjene==False">
										<parameter name="Global.$IndSvi" value="0" type="int"/>
									</action>
								</action> 									
								<action elseif="#chkPartneriIzmjene==True">
									<action type="control value" value="chkPartneriSvi">
										<parameter value="0" />
									</action>
									<action type="variable value" if="#chkPartneriIzmjene==True">
										<parameter name="Global.$IndSvi" value="1" type="int"/>
									</action>
								</action>
								<action type="control populate" value="#grdPartneri"/>
							</event>
						</checkedit>
					</item>
					<item col="2" row="1">
						<checkedit name="chkPartneriSvi" caption="Svi partneri" value="0" savevalue="session">
							<event type="valuechanged">
								<action if="#chkPartneriSvi==False">
									<action type="control value" value="chkPartneriIzmjene">
										<parameter value="1" />
									</action>
								</action> 									
								<action elseif="#chkPartneriSvi==True">
									<action type="control value" value="chkPartneriIzmjene">
										<parameter value="0" />
									</action>
								</action>
								<action type="control populate" value="#grdPartneri"/>
							</event>			
						</checkedit>
					</item>
				</group>
				<group cols="3" rows="1" col="1" row="2" groupbordervisible="false">
					<columnsdefinition>
						<column size="20%" position="1" />
						<column size="20%" position="2" />
						<column size="60%" position="3" />	
					</columnsdefinition>
					<item caption="Datum od:" col="1" row="1" >
						<dateedit name="datDatumOd" datavalue="~dtParametri.datumod" savevalue="session">
							<event type="valuechanged">
								<action type="variable value">
									<parameter name="Global.$DatumOd" value="#datDatumOd"/>
								</action>
								<action type="control populate" value="#grdPartneri"/>
							</event>			
						</dateedit>
					</item>	
					<item caption="Datum do:" col="2" row="1" >
						<dateedit name="datDatumDo" datavalue="~dtParametri.datumdo" savevalue="session">
							<event type="valuechanged">
								<action type="variable value">
									<parameter name="Global.$DatumDo" value="#datDatumDo"/>
								</action>
								<action type="control populate" value="#grdPartneri"/>
							</event>			
						</dateedit>
					</item>	
				</group>

				<group padding="0" groupbordervisible="false" cols="2" rows="1" row="3" col="1">
					<columnsdefinition>
						<column size="60%" position="1" />
						<column size="30%" position="2" />											
					</columnsdefinition>
					<item caption="Klasa partnera:" row="1" col="1">
						<comboedit name="cmbKlPartneri" autopopulate="true" savevalue="session" valuefield="klpartneriid" displayfield="naziv" datavalue="~dtKlasaPartnera.@klpartneriid" dataname="dtKlasaPartnera">
							<event type="valuechanged">
								<action type="control populate" value="#grdPartneri"/>
							</event>	
						</comboedit>			
					</item>
					<item col="2" row="1" caption=" ">
						<checkedit name="chkKlasePartnera" caption="i ispod nje" value="1" savevalue="session">
							<event type="valuechanged">
								<action type="control populate" value="#grdPartneri"/>
							</event>	
						</checkedit>
					</item>
				</group> 

				<group caption="Partneri:" padding="0" groupbordervisible="true" cols="1" rows="1" col="1" row="4">
					<item row="1" col="1" highlight="False" >
						<grid name="grdPartneri" multiselect="true" key="partneriid" showgrouppanel="false" showfooter="false" savelayout="false"  cleargridfilter="true" showcheckboxes="true">															
							<data command="spC_Partneri_PregledPromjena_Query">
								<parameter name="@Action" value="grid_partneri" />
								<parameter name="@partneriklasaispod" value="#chkKlasePartnera" />
								<parameter name="@klpartneriid" value="#cmbKlPartneri" type="int"/>
								<parameter name="@datumod" value="#datDatumOd" type="date"/>
								<parameter name="@datumdo" value="#datDatumDo" type="date"/>
								<parameter name="@IndPartneriIzmjene" value="#chkPartneriIzmjene" type="boolean"/>														
							</data>
							<fields>					
								<field name="PartneriId" caption="PartneriId" fixwidth="50" hidden="true"/>
								<field name="sifra" caption="Šifra" fixwidth="80"/>
								<field name="partner" caption="Partner" fixwidth="170"/>
								<field name="Adresa" caption="Adresa" fixwidth="150" />
								<field name="mjesto" caption="Mjesto" fixwidth="100"/>
								<field name="poreznibroj" caption="OIB" fixwidth="90"/>

							</fields>			
						</grid>
					</item>
				</group>
			</group>
		</layout>

		<panelbuttons>
			<buttons>
				<button name="btnPrihvati" caption="&amp;PRIHVATI" type="add">
					<event type="click">
						<action type="variable value">
							<parameter name="Global.$DatumOd" value="#datDatumOd"/>
						</action>
						<action type="variable value">
							<parameter name="Global.$DatumDo" value="#datDatumDo"/>
						</action>
						<action if="#chkPartneriIzmjene==False">
							<action type="variable value">
								<parameter name="Global.$IndSvi" value="0" type="int"/>
							</action>
						</action> 									
						<action elseif="#chkPartneriIzmjene==True">
							<action type="variable value">
								<parameter name="Global.$IndSvi" value="1" type="int"/>
							</action>
						</action>
						<action type="datarun nonquery" value="~dtPartnerSelected" />
						<action type="form close"/>	
					</event>
				</button>
				<button name="btnOdustani" caption="&amp;ODUSTANI" type="cancel" dock="right">
					<event type="click">
						<action type="form close"/>	
					</event>
				</button>
			</buttons>
		</panelbuttons>

		<datalist>
			<data command="spC_Partneri_PregledPromjena_Query" name="dtKlasaPartnera">
				<parameter name="@Action"  value="klpartner" />
			</data>
			<data command="spC_Partneri_PregledPromjena_Query" name="dtParametri">
				<parameter name="@Action"  value="parametri" />
			</data>
			<data command="spC_Partneri_PregledPromjena_Query" name="dtPartnerSelected">
				<parameter name="@Action"  value="PartneriSelected" />
				<parameter name="@Parametar" value="#grdPartneri.selectedids" />
				<parameter name="@operateriid" value="@@operateriid" />
			</data>
			<data command="delete from dbo.C_Promjene_Partneri where operateriid=@operateriid" name="dtDeleteSelPartnere" type="text">
				<parameter name="@operateriid"  value="@@operateriid" />
			</data>

		</datalist>

	</form>
</root>