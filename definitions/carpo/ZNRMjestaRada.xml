<root version="1.1">

  <form name="frmMjestaRada" type="master" caption="Mjesta rada" fixedsize="true" height="500" width="800" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtMjestaRada" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdMjestaRada" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="1" spacing="2,2,2,2">
        <item col="1" row="1" highlight="false">
          <grid name="grdMjestaRada" type="master" autopopulate="true" dataname="dtMjestaRada" key="ZNRMjestaRadaId" showautofilterrow="true" bestfitonrefresh="true">
            <fields inherited="true">
            </fields>
          </grid>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnesi" caption="Unos" type="add" function="UnesiMR">
          <event type="click">
            <action type="form open" value="frmPromjenaMR">
              <parameter name="caption" value="Unos mjesta rada" />
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate " value="#grdMjestaRada" >
                <action type="control focus" value="#grdMjestaRada">
                  <parameter value="$Fokus"/>
                </action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmjena" type="edit" function="IzmijeniMR">
          <event type="click">
            <action type="form open" value="frmPromjenaMR">
              <parameter name="ZNRMjestaRadaId" value="#grdMjestaRada.@ZNRMjestaRadaId" />
              <parameter name="caption" value="Izmjena mjesta rada" />
            </action>
            <action type="control populate keepfocus" value="#grdMjestaRada" />
          </event>
        </button>
        <button name="btnBrisi" caption="Brisanje" type="delete" function="ObrisiMR">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označeno mjesto rada?">
              <action type="datarun reader" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdMjestaRada"></action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRMjestaRada" name="dtMjestaRada">
        <parameter name="@Action" value="Master_query"/>
      </data>
      <data command="spZNRMjestaRada" name="dtDelete">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@ZNRMjestaRadaId" value="#grdMjestaRada.@ZNRMjestaRadaId" />
      </data>
    </datalist>
  </form>

  <!--* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->

  <form name="frmPromjenaMR" caption="$caption" height="150"  width="500" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$ZNRMjestaRadaId!=null"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="2"   groupbordervisible="false">
        <item caption="Naziv:" row="1" col="1" highlight="false">
          <textedit name="txtNaziv" datavalue="~dtGet.@Naziv"  required="true"/>
        </item>
        <item caption="Oznaka:" row="2" col="1" highlight="false">
          <textedit name="txtOznaka"  datavalue="~dtGet.@Oznaka" required="false" />
        </item>
      </group >
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$ZNRMjestaRadaId!=null"/>
            <action type="datarun reader" value="~dtUnos" else="" >
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@Fokus" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRMjestaRada" name="dtGet">
        <parameter name="@Action" value="Dohvati_izmjena" />
        <parameter name="@ZNRMjestaRadaId" value="$ZNRMjestaRadaId"/>
      </data>
      <data command="spZNRMjestaRada" name="dtIzmjena">
        <parameter name="@Action" value="Izmjena_spremi" />
        <parameter name="@ZNRMjestaRadaId" value="$ZNRMjestaRadaId" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
      </data>
      <data command="spZNRMjestaRada" name="dtUnos">
        <parameter name="@Action" value="Unos_spremi"/>
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
      </data>
    </datalist>
  </form>

</root>