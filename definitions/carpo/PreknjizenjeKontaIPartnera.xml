		<panelbuttons>
			<buttons>
				<button name="btnPokazi" caption="POKAŽI" tabindex="12">
					<event type="click">
						<action type="validate"/>
						<action type="variable value">
							<parameter name="VrstaPreknj" value="#cmbVrstaPreknj"/>
						</action>
						<action type="variable value">
							<parameter name="StariPartner" value="#srcStariPartner"/>
						</action>
						<action type="variable value">
							<parameter name="NoviPartner" value="#srcNoviPartner"/>
						</action>
						<action type="variable value" value="VrstaKonta">
							<parameter value="K" if="#rdoKupci==true||$VrstaPreknj==1"/>
							<parameter value="D" elseif="#rdoDobavljaci==true"/>							
						</action>	
						<action type="variable value">
							<parameter name="StariKonto" value="#cmbStariKonto"/>
						</action>					
						<action type="variable value">
							<parameter name="NoviKonto" value="#cmbNoviKonto"/>
						</action>						
						<action type="variable value">
							<parameter name="Opis" value="#txtOpis"/>
						</action>	
						<action type="variable value">
							<parameter name="VrstaDokId" value="#cmbVrstaDok"/>
						</action>
						<action type="variable value">
							<parameter name="Datum" value="#datDatum"/>
						</action>
						<action type="variable value">
							<parameter name="DatumValute" value="#datDatumValute"/>
						</action>						
						<action type="variable value">
							<parameter name="AutoSaldo" value="#txtSaldo"/>
						</action>
						<action type="variable value">
							<parameter name="AutoDevSaldo" value="#txtDevSaldo"/>
						</action>
						<action if="#cmbVrstaPreknj==3">
							<action type="variable value" if="#txtSaldo==0||#txtSaldo==null">
								<parameter name="IndSaldo" value="0"/>
							</action>
							<action type="variable value" else="">
								<parameter name="IndSaldo" value="1"/>
							</action>
							<action type="variable value" if="#txtDevSaldo==0||#txtDevSaldo==null">
								<parameter name="IndDevSaldo" value="0"/>
							</action>
							<action type="variable value" else="">
								<parameter name="IndDevSaldo" value="1"/>
							</action>
							<action type="variable value" if="$IndSaldo==0&amp;&amp;$IndDevSaldo==0">
								<parameter name="Editable" value="1"/>
							</action>	
							<action type="variable value" else="">
								<parameter name="Editable" value="null"/>
							</action>
							<!--preostao je cjelokupni iznos salda-->
							<action type="variable value">
								<parameter name="Preostalo" value="$AutoSaldo"/>
							</action>
							<action type="variable value">
								<parameter name="PreostaloDev" value="$AutoDevSaldo"/>
							</action>							
						</action>
						<action elseif="#cmbVrstaPreknj!=3">
							<action type="variable value">
								<parameter name="IndSaldo" value="null"/>
							</action>
							<action type="variable value">
								<parameter name="IndDevSaldo" value="null"/>
							</action>	
							<action type="variable value">
								<parameter name="Editable" value="null"/>
							</action>							
						</action>
						<action type="datarun nonquery" value="~dtDelete"/>
						<action type="control populate" value="#grdGlavni"/>
						<action type="panel collapse" value="panel1" if="#grdGlavni.rowcount!=0"/>
						<action type="control disable" value="#btnPreknjizi"/>
						<action type="footer text"  value="suma Saldo:   | suma DevSaldo: "/>		
						<action type="control focus" value="#grdGlavni"/>
						<action type="control disable" value="#btnOznaciSve" if="#cmbVrstaPreknj==3||#grdGlavni.rowcount&lt;1"/>
						<action type="control enable" value="#btnOznaciSve" else=""/>						
					</event>
				</button>
				<button name="btnPreknjizi" caption="PREKNJIŽI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite preknjižiti odabrane stavke?"/>
						<action type="datarun nonquery" value="~dtUpdateSalda" if="$IndSaldo==1"/>
						<action type="datarun nonquery" value="~dtUpdateDevSalda" if="$IndDevSaldo==1"/>						
						<action type="datarun reader" value="~dtPreknjizi" />
						<action type="datarun nonquery" value="~dtDelete"/>
						<action type="control datasourceempty" value="#grdGlavni">
							<parameter name="clearcolumns" value="false"/>
						</action>							
						<action type="control populate" value="#grdGlavni"/>
						<action type="control enable" value="#btnPreknjizi" if="#grdGlavni.rowcount!=0"/>
						<action type="control disable" value="#btnPreknjizi" elseif="#grdGlavni.rowcount==0"/>
						<action type="control disable" value="#btnPreknjizi"/>	
						<action type="variable value" value="Odabrani">
							<parameter value="null"/>
						</action>
						<action type="footer text"  value="suma Saldo:   | suma DevSaldo: "/>	
						<action type="control disable" value="#btnOznaciSve" if="#cmbVrstaPreknj==3||#grdGlavni.rowcount&lt;1"/>
						<action type="control enable" value="#btnOznaciSve" else=""/>						
					</event>
				</button>
				<button name="btnOznaciSve">
					<event type="click">
						<action type="variable value" value="$OznaciSve" if="$OznaciSve==0">
							<parameter value="1" type="int"/>
						</action>
						<action type="variable value" value="$OznaciSve" else="$OznaciSve==1">
							<parameter value="0" type="int"/>
						</action>
						<action if="$OznaciSve==1">
							<action type="control foreachrow" value="#grdGlavni">
									<action type="generate string" if="$StringId==">
										<parameter name="$StringId"/>									
										<parameter value="#grdGlavni.@CKntTmpPreknjizenjeKPId"/>					
									</action>
									<action type="generate string" else="$StringId!=">
										<parameter name="$StringId"/>
										<parameter value="$StringId"/>								
										<parameter value="," />										
										<parameter value="#grdGlavni.@CKntTmpPreknjizenjeKPId"/>					
									</action>	
							</action>	
						</action>
						<action else="">
							<action type="variable value" value="$StringId">
								<parameter value=""/>
							</action>							
						</action>
						<action type="datarun nonquery" value="~dtOznaciSve"/>
						<action type="control populate" value="#grdGlavni"/>
						<action type="control caption" value="#btnOznaciSve" if="$OznaciSve==1">
							<parameter value="ODZNAČI SVE"/>
						</action>
						<action type="control caption" value="#btnOznaciSve" if="$OznaciSve==0">
							<parameter value="OZNAČI SVE"/>
						</action>	
						<action type="control disable" value="#btnPreknjizi" if="$StringId=="/>
						<action type="control enable" value="#btnPreknjizi" else="$StringId!="/>						
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS   SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdGlavni"/>
					</event>
				</button>
			</buttons>
		</panelbuttons>
