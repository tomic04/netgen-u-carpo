									<action type="generate string" if="$StringId==">
										<parameter name="$StringId"/>									
										<parameter value="#grdGlavni.@CKntTmpPreknjizenjeKPId"/>					
									</action>
									<action type="generate string" else="$StringId!=">
										<parameter name="$StringId"/>
										<parameter value="$StringId"/>								
										<parameter value="," />										
										<parameter value="#grdGlavni.@CKntTmpPreknjizenjeKPId"/>					
									</action>	
								</action>
							</action>				
							<action if="$Editable==1">
								<action type="variable value">
									<parameter name="Saldo" value="#grdGlavni.@Saldo" format="n2"/>
								</action>
								<action type="variable value">
									<parameter name="DevSaldo" value="#grdGlavni.@DevSaldo" format="n2"/>
								</action>							
								<action type="datarun nonquery" value="~dtSaldo"/>
							</action>	
							
							<action type="datarun reader" value="~dtSuma"/>
							<action if="$Editable!=1&amp;&amp;$VrstaPreknj==3">
								<action type="datarun reader" value="~dtPreostalo"/>
								<action type="footer text" value="suma Saldo: {~dtSuma.@suma::n2} | preostalo Saldo: {~dtPreostalo.@saldopreo::n2} | suma DevSaldo: {~dtSuma.@devsuma::n2} | preostalo DevSaldo: {~dtPreostalo.@devsaldopreo::n2}" if="$Editable!=1&amp;&amp;$VrstaPreknj==3"/>										
								<action type="variable value">
									<parameter name="Preostalo" value="~dtPreostalo.@saldopreo"/>
									<parameter name="PreostaloDev" value="~dtPreostalo.@devsaldopreo"/>									
								</action>
							</action>
							<action type="footer text"  value="suma Saldo: {~dtSuma.@suma::n2}  | suma DevSaldo: {~dtSuma.@devsuma::n2}" else=""/>						
							<action type="control disable" value="#btnPreknjizi" if="$StringId=="/>
							<action type="control enable" value="#btnPreknjizi" else="$StringId!="/>								
							<!-- <action type="variable value"> -->
								<!-- <parameter name="FokusId" value="#grdGlavni.@CKntTmpPreknjizenjeKPId"/> -->
							<!-- </action> -->
							<!-- <action type="datarun reader" value="~dtCheck" if="$Editable!=1&amp;&amp;$VrstaPreknj==3"> -->
							<!-- </action> -->
							<!-- <action type="datarun nonquery" value="~dtCheck" else=""/> -->
							<!-- <action type="datarun scalar" value="~dtDohvati"> -->
								<!-- <parameter name="Odabrani"/> -->
							<!-- </action>	-->								
							<!-- <action type="footer text" value="suma Saldo: {~dtSuma.@suma::n2} | preostalo Saldo: {~dtCheck.@saldopreo::n2} | suma DevSaldo: {~dtSuma.@devsuma::n2} | preostalo DevSaldo: {~dtCheck.@devsaldopreo::n2}" if="$Editable!=1&amp;&amp;$VrstaPreknj==3"/> -->
							<!-- <action type="footer text"  value="suma Saldo: {~dtSuma.@suma::n2}  | suma DevSaldo: {~dtSuma.@devsuma::n2}" else=""/> -->
							<!-- <action type="control populate" value="#grdGlavni"/> -->
							<!-- <action type="control focus" value="#grdGlavni"> -->
								<!-- <parameter value="$FokusId"/> -->
							<!-- </action> -->
							<!-- <action type="control disable" value="#btnPreknjizi" if="$Odabrani==null"/> -->
							<!-- <action type="control enable" value="#btnPreknjizi" elseif="$Odabrani!=null"/> -->						
						</event>
						<event type="showingeditor">
							<!-- <action type="editor allow" value="true" if="#grdGlavni.@Smije==1" /> -->
							<action type="editor allow" value="true" if="#cmbVrstaPreknj==0"/>
							<action type="editor allow" value="true" elseif="#cmbVrstaPreknj==1"/>	
							<action type="editor allow" value="true" elseif="#cmbVrstaPreknj==2"/>	
							<!--cesija i upisan saldo-->
							<action type="editor allow" value="true" elseif="#cmbVrstaPreknj==3&amp;&amp;$Editable==null&amp;&amp;$Preostalo>0"/>	
