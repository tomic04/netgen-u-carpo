<root>
	<form name="frmMaster" caption="Model" type="master">
		<managerlayout>
			<grid name="grdMaster" type="master" dataname="~dtGrid" multiselect="true" key="StatusID" savelayout="true" bestfitonrefresh="true">
				<fields>
					<field name="StatusID" visible="false" />
					<field name="Naziv" caption="Naziv" />
					<field name="Oznaka" caption="Oznaka" />
				</fields>
			</grid>
		</managerlayout>
		<panelbuttons>
			<buttons>
				<button name="btnDodaj" caption="DODAJ">
					<event type="click">
						<action type="form open" value="frmUnos" />
					</event>
				</button>
				<button name="btnIzmjena" caption="IZMIJENI">
					<menuitem control="#grdMaster" />
					<event type="click">
						<action type="form open" value="frmIzmjena">
							<parameter name="StatusID" value="#grdMaster.@StatusID" />
						</action>
					</event>
				</button>
				<button name="btnDelete" caption="OBRIŠI">
					<menuitem control="#grdMaster" />
					<event type="click">
						<action type="confirm" value="Želite li obrisati označeni zapis?" />
						<action type="datarun nonquery" value="~dtDelete" />
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
			</buttons>
		</panelbuttons>
		<datalist>
			<data command="dms.spDMSStausQuery" name="dtGrid">
				<parameter name="@action" value="grid" />
			</data>
			<data command="dms.spDMSStatusAzur" name="dtDelete">
				<parameter name="@Action" value="2" />
				<parameter name="@StatusID" value="#grdMaster.@StatusID" />
			</data>
		</datalist>
	</form>
	<!-- <form name="frmUnos" path="frmUnos" /> -->
	<!-- <form name="frmIzmjena" path="frmIzmjena" /> -->


	<form name="frmUnos" caption="Unos" width="400" height="200" saveformsize="false">
		<layout>
			<group rows="3" cols="3">
				<item row="1" col="1" caption="Naziv statusa" colspan="3">
					<textedit name="txtNaziv" />
				</item>
				<item row="2" col="1" caption="Oznaka" colspan="3">
					<textedit name="txtOznaka" />
				</item>
				<item row="3" col="1" width="125" height="50" saveformsize="false">
					<button name="btnSpremi" caption="SPREMI" dock="left">
						<event type="click">
							<action type="datarun nonquery" value="~dtInsert" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" />
						</event>
					</button>
				</item>
				<item row="3" col="3" width="125" height="50" saveformsize="false">
					<button name="btnIzlaz" caption="ODUSTANI" type="cancel" dock="right" />
				</item>
			</group>
		</layout>
		<datalist>
			<data command="dms.spDMSStatusAzur" name="dtInsert">
				<parameter name="@action" value="0" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@Oznaka" value="#txtOznaka" />
			</data>
		</datalist>
	</form>


<form name="frmIzmjena" caption="Izmjena" width="400" height="200" saveformsize="false">
		<event type="oninit">
			<action type="datarun reader" value="~dtGet" />
		</event>
		<layout>
			<group rows="3" cols="3">
				<item row="1" col="1" caption="Naziv" colspan="3">
					<textedit name="txtNaziv" dataname="~dtGet" valuefield="StatusID" displayfield="Naziv" datavalue="~dtGet.@Naziv" />
				</item>
				<item row="2" col="1" caption="Oznaka" colspan="3">
					<textedit name="txtOznaka" dataname="~dtGet" valuefield="StatusID" displayfield="Oznaka" datavalue="~dtGet.@Oznaka" />
				</item>
				<item row="3" col="1" width="125" height="50" saveformsize="false">
					<button name="btnSpremi" caption="SPREMI" dock="left">
						<event type="click">
							<action type="datarun nonquery" value="~dtEdit" />
							<action type="control populate" value="parent.#grdMaster" />
							<action type="form close" />
						</event>
					</button>
				</item>
				<item row="3" col="3" width="125" height="50" saveformsize="false">
					<button name="btnIzlaz" caption="ODUSTANI" type="cancel" dock="right" />
				</item>
			</group>
		</layout>
		<datalist>
			<data command="dms.spDMSStausQuery" name="dtGet">
				<parameter name="@action" value="edit" />
				<parameter name="@StatusID" value="$StatusID" />
			</data>
			<data command="dms.spDMSStatusAzur" name="dtEdit">
				<parameter name="@action" value="1" />
				<parameter name="@StatusID" value="$StatusID" />
				<parameter name="@Naziv" value="#txtStatus" />
				<parameter name="@Oznaka" value="#txtOznaka" />
			</data>
		</datalist>
	</form>

</root>




