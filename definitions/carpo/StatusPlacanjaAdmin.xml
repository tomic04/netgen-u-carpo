<root version="1.0.0.0" loglevel="3">
	<form type="master" name="frmGlavni" caption="Administratori statusa plaćanja" width="650" height="650" saveformsize="false">
		<event type="load">
			<action type="control populate" value="#grdGlavni"/>
		</event>
		<layout>
			<group cols="1" rows="1" groupbordervisible="false">
			<item col="1" row="1">
			<grid name="grdGlavni" type="master" dataname="~dtGlavni" key="StatusPlacanjaAdminID" >
				<event type="doubleclick">
					<action type="form open" value="frmUnos">
						<parameter name="StatusPlacanjaAdminID" value="#grdGlavni.@StatusPlacanjaAdminID"/>
						<parameter name="IndUnosa" value="0"/>
					</action>
					<action type="control populate keepfocus" value="#grdGlavni"/>
				</event>
				<fields>
					<field name="Naziv"/>
				</fields>
			</grid>
			</item>
			</group>
		</layout>
		<panelbuttons >
			<buttons>
				<button name="btnDodaj" caption="DODAJ">
					<event type="click">	
						<action  type="form open" value="frmUnos">
							<parameter name="IndUnosa" value="1"/>
						</action>	
						<action type="control populate" value="#grdGlavni"/>
						<action type="datarun scalar" value="~dtScope">
							<parameter name="StatusPlacanjaAdminID"/>
						</action>
						<action type="control focus" value="#grdGlavni">
							<parameter value="$StatusPlacanjaAdminID" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI">
					<event type="click">	
						<action  type="form open" value="frmUnos">
							<parameter name="StatusPlacanjaAdminID" value="#grdGlavni.@StatusPlacanjaAdminID"/>
							<parameter name="IndUnosa" value="0"/>
						</action>
						<action type="control populate keepfocus" value="#grdGlavni"/>
					</event>
				</button>
				<button name="btnObriši" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Jeste li sigurni da želite obrisati odabranog operatera iz admnistratora?">
							<action type="datarun nonquery" value="~dtObriši"/>
						</action>
						<action type="control populate keepfocus" value="#grdGlavni"/>
					</event>
				</button>
				<button name="btnIspis" caption="ISPIS     SUČELJA">
					<event type="click">
						<action type="control printcontrol" value="#grdGlavni"/>
					</event>
				</button>				
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtGlavni" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="0"/>
			</data>
			<data name="dtObriši" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="3"/>
				<parameter name="@id" value="#grdGlavni.@StatusPlacanjaAdminID"/>
			</data>
			<data name="dtScope" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="6"/>
			</data>
		</datalist>
	</form>
	<form name="frmUnos" caption="Operateri" width="500" >
		<event type="init">
			<action type="datarun reader" value="~dtGet"/>
		</event>
		<layout>
			<group cols="1" rows="1">
				<item col="1" row="1" caption="Operater:" textposition="left">
					<comboedit name="cmbOperater" required="true" dataname="~dtOperateri" valuefield="OperateriId" displayfield="Naziv" datavalue="~dtGet.@operateriid"/>
				</item>
			</group>
		</layout>
		<panelbuttons>
			<buttons>
				<button name="btnSpremi" caption="Spremi">
					<event type="click">
						<action type="validate"/>
						<action type="datarun nonquery" value="~dtAzur"/>
						<action type="form close"/>
					</event>		
				</button>
				<button name="btnOdustani" caption="Odustani" type="cancel"/>
			</buttons>
		</panelbuttons>
		<datalist>
			<data name="dtOperateri" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="4"/>
			</data>
			<data name="dtAzur" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="1" if="$IndUnosa==1"/>
				<parameter name="@Action" value="2" if="$IndUnosa==0"/>
				<parameter name="@OperateriId" value="#cmbOperater"/>
				<parameter name="@ID" value="$StatusPlacanjaAdminID" if="$IndUnosa==0"/>
			</data>
			<data name="dtGet" command="spStatusPlacanjaAdmin">
				<parameter name="@Action" value="5"/>
				<parameter name="@ID" value="$StatusPlacanjaAdminID"/>
			</data>
		</datalist>
	</form>
</root>