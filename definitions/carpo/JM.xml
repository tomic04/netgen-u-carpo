<!-- MH Radila na Jupiter2017, Spin -->

<root>
	<form name="frmMaster" type="master" caption="Jedinice mjere">
		<event type="init">
			<action type="datarun scalar" value="Global.~dtCheckPermission">
				<parameter name="Global.Smije"/>
			</action>
		</event>
		<managerlayout>
			<grid name="grdMaster" type="master" showautofilterrow="true" dataname="global.dtMaster" key="JMid" multiselect="true" savelayout="true" statusbar="true">
				<event type="doubleclick">
					<action if="global.$Smije==1">
						<action type="form open" value="frmJMInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="JMId" value="#grdMaster.@JMId" />
						</action>
						<action type="control populate keepfocus" value="#grdMaster" />
					</action>
					<action else="">
						<action type="message" value="Nemate dopuštenje mijenjati jedinice mjere"/>
					</action>
				</event> 
				<fields inherited="true">
				</fields>				
			</grid>
		</managerlayout>
		<panelbuttons displaycontrolsprint="true" >
			<buttons>
				<button name="btnUnesi" caption="UNESI" type="add" function="insert">
					<menuitem control="#grdMaster" sort="1"/>
					<event type="click">
						<action type="form open" value="frmJMInsertEdit" >
							<parameter name="JMid" value="null" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$JMid" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnIzmijeni" caption="IZMIJENI" type="edit" function="edit" >
					<menuitem control="#grdMaster" sort="2"/>
					<event type="click">
						<action type="form open" value="frmJMInsertEdit"  if="#grdMaster.rowcount&gt;0">
							<parameter name="JMid" value="#grdMaster.@JMid" />
						</action>
						<action type="control populate" value="#grdMaster"/>
						<action type="control focus" value="#grdMaster">
							<parameter value="$JMid" type="int"/>
						</action>
					</event>
				</button>
				<button name="btnObrisi" caption="OBRIŠI" type="delete" function="delete">
					<event type="click">
						<action type="datarun nonquery" value="global.~dtDelete">
							<action type="control populate" value="#grdMaster"/>
						</action>
					</event>
				</button>
			</buttons>
		</panelbuttons>
	</form>

	<form name="frmJMInsertEdit" path="frmJMInsertEdit.xml" />

	<datalist>
		<data command="spJM_Query" name="dtMaster">
			<parameter name="@Action" value="0" />
		</data>
		<data command="spProd_CheckPermission" name="dtCheckPermission">
			<parameter name="@OperateriId" value="@@OperateriId" />
			<parameter name="@Objekt" value="JM" />
			<parameter name="@Funkcija" value="edit" />
		</data>
		<data command="spJM_Azur" name="dtDelete">
			<parameter name="@Action" value="2" />
			<parameter name="@ID" value="#grdMaster.@JMId" />
		</data>
	</datalist>
</root>