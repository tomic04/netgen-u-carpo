<root version="1.1">

  <form name="frmStrucnaOsposobljavanja" type="master" caption="Stručna osposobljavanja"  height="500" width="800" saveformlayout="true">
    <event type="oninit">
      <action type="datarun reader" value="~dtStrucnaOsposobljavanja" />
    </event>
    <event type="onload">
      <action type="control populate" value="#grdStrucnaOsposobljavanja" />
    </event>
    <layout textposition="left">
      <group cols="1" rows="1" spacing="2,2,2,2">
        <item col="1" row="1" highlight="false">
          <grid name="grdStrucnaOsposobljavanja" type="master" autopopulate="true" dataname="dtStrucnaOsposobljavanja" key="ZNRStrucnaOsposobljavanjaId" showautofilterrow="true" bestfitonrefresh="true"  >
            <fields inherited="true">
            </fields>
          </grid>
        </item>
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnUnesi" caption="Unos" type="add" function="UnesiSO">
          <event type="click">
            <action type="form open" value="frmPromjenaSO">
              <parameter name="caption" value="Unos Stručnog osposobljavanja" />
            </action>
            <action if="dialogresult!=cancel">
              <action type="control populate " value="#grdStrucnaOsposobljavanja" >
                <action type="control focus" value="#grdStrucnaOsposobljavanja">
                  <parameter value="$Fokus"/>
                </action>
              </action>
            </action>
          </event>
        </button>
        <button name="btnIzmijeni" caption="Izmjena" type="edit" function="IzmijeniSO">
          <event type="click">
            <action type="form open" value="frmPromjenaSO">
              <parameter name="ZNRStrucnaOsposobljavanjaId" value="#grdStrucnaOsposobljavanja.@ZNRStrucnaOsposobljavanjaId" />
              <parameter name="caption" value="Izmjena stručnog osposobljavanja" />
            </action>
            <action type="control populate keepfocus" value="#grdStrucnaOsposobljavanja" />
          </event>
        </button>
        <button name="btnBrisi" caption="Brisanje" type="delete" function="ObrisiMR">
          <event type="click">
            <action type="confirm" value="Da li ste sigurni da želite obrisati označeno stručno osposobljavanje?">
              <action type="datarun reader" value="~dtDelete"></action>
            </action>
            <action type="control populate" value="#grdStrucnaOsposobljavanja"></action>
          </event>
        </button>
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRStrucnaOsposobljavanja" name="dtStrucnaOsposobljavanja">
        <parameter name="@Action" value="Master_query"/>
      </data>
      <data command="spZNRStrucnaOsposobljavanja" name="dtDelete">
        <parameter name="@Action" value="Brisanje" />
        <parameter name="@ZNRStrucnaOsposobljavanjaId" value="#grdStrucnaOsposobljavanja.@ZNRStrucnaOsposobljavanjaId" />
      </data>
    </datalist>
  </form>

  <!--* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *-->

  <form name="frmPromjenaSO" caption="$caption" height="250"  width="500" fixedsize="true">
    <event type="init">
      <action type="datarun reader" value="~dtGet" if="$ZNRStrucnaOsposobljavanjaId!=null"/>
    </event>
    <layout textposition="left" >
      <group cols="1" rows="3" groupbordervisible="false">
        <item caption="Naziv:" row="1" col="1" highlight="false">
          <memoedit name="txtNaziv" datavalue="~dtGet.@Naziv"  required="true"/>
        </item>
        <item caption="Oznaka:" row="2" col="1" highlight="false">
          <textedit name="txtOznaka"  datavalue="~dtGet.@Oznaka" required="false" />
        </item>
        <group row="3" col="1" rows="1" cols="2" groupbordervisible="false">
          <!-- padding 4 lijevo, 6 gore -->
          <item row="1" col="1" padding="4,0,6,0">
            <labeledit name="lblChk" value="Fiksno: " fontbold="true"></labeledit>
          </item>
          <item row="1" col="2" highlight="false">
            <checkedit name="chkFiksno"  datavalue="~dtGet.@indFiksno"/>
          </item>
        </group>
        <!-- bez grupe, label desno -->
        <!-- <item row="3" col="1" highlight="false">
          <checkedit name="chkFiksno" caption="Fiksno" fontbold="true"  datavalue="~dtGet.@indFiksno"/>
        </item> -->
      </group>
    </layout>
    <panelbuttons>
      <buttons>
        <button name="btnSpremi" caption="Spremi" type="add">
          <event type="click">
            <action type="validate" />
            <action type="datarun reader" value="~dtIzmjena" if="$ZNRStrucnaOsposobljavanjaId!=null"/>
            <action type="datarun reader" value="~dtUnos" else="" >
              <action type="variable value">
                <parameter name="parent.$Fokus" value="~dtUnos.@Fokus" type="int"/>
              </action>
            </action>
            <action type="form close"/>
          </event>
        </button>
        <button name="btnOdustani" caption="Odustani" type="cancel" dock="right" />
      </buttons>
    </panelbuttons>
    <datalist>
      <data command="spZNRStrucnaOsposobljavanja" name="dtGet">
        <parameter name="@Action" value="Dohvati_izmjena" />
        <parameter name="@ZNRStrucnaOsposobljavanjaId" value="$ZNRStrucnaOsposobljavanjaId"/>
      </data>
      <data command="spZNRStrucnaOsposobljavanja" name="dtIzmjena">
        <parameter name="@Action" value="Izmjena_spremi" />
        <parameter name="@ZNRStrucnaOsposobljavanjaId" value="$ZNRStrucnaOsposobljavanjaId" />
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@indFiksno" value="#chkFiksno" />
      </data>
      <data command="spZNRStrucnaOsposobljavanja" name="dtUnos">
        <parameter name="@Action" value="Unos_spremi"/>
        <parameter name="@Naziv" value="#txtNaziv" />
        <parameter name="@Oznaka" value="#txtOznaka" />
        <parameter name="@indFiksno" value="#chkFiksno" />
      </data>
    </datalist>
  </form>

</root>