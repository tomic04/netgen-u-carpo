<root>
    <form type="master" caption="Audit">
        <managerlayout>
            <tree name="trTree" dataname="~dtNapuniDrvo" caption="Pronađene tablice" key="GdprTabliceId" valueid="Naziv">
                <event type="focusedrowchanged">
                    <action type="control datasourceempty" value="#grdGlava"/>
                    <action type="control populate" value="#grdGlava" />
                </event>
                <fields>
		            <field name="Naziv" />
	            </fields>
            </tree>
            <grid name="grdGlava" type="master" caption="Zaboravljene osobe" dataname="~dtNapuniGlavu" fieldsmartspaces="false" showmenutools="false" showmenuprintitem="false" >
            </grid>
        </managerlayout>
        <datalist>
            <data command="spGdprZabPodaciAudit" name="dtNapuniDrvo">
                <parameter name="@Action" value="tree" />
            </data>
            <data command="spGdprZabPodaciAudit" name="dtNapuniGlavu">
                <parameter name="@Action" value="izvjestaj" />
                <parameter name ="@GdprTabliceId" value="#trTree.@GdprTabliceId"/>
            </data>
        </datalist>
    </form>
</root>