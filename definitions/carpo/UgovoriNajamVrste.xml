<root>
	<form name="frmMaster" type="master" caption="Vrste ugovora o najmu">
		<managerlayout>
			<grid type="Master" name="grdMaster" dataname="~dtPuniMaster" multiselect="true">
				<fields>

				</fields>
			</grid>
		</managerlayout>

		<panelbuttons>
			<buttons>
				<button name="btnUnos" caption="UNESI">
					<event type="click">
						<action type="form open" value="frmUnos" />
					</event>
				</button>


				<button name="btnIzmjeni" caption="IZMJENI">
					<event type="click">
						<action type="form open" value="frmIzmjeni">
								<parameter name="UgovoriNajamVrsteId" value="#grdMaster.@UgovoriNajamVrsteId" />
								<parameter name="Naziv" value="#grdMaster.@Naziv" />
								<parameter name="Aktivno" value="#grdMaster.@aktivno" />
								<parameter name="Oznaka" value="#grdMaster.@oznaka" />
						</action>
					</event>
				</button>

				<button name="btnDelete" caption="OBRIŠI">
					<event type="click">
						<action type="confirm" value="Brisanje stavke {#grdMaster.@naziv}. Nastaviti?" />
						<action type="control foreachrow selected" value="#grdGlava">	
							<action type="datarun nonquery" value="~dtDelete" />
						</action>
						<action type="control populate" value="#grdMaster" />
					</event>
				</button>
			</buttons>	

		</panelbuttons>

	<datalist>
		<data command="spUgovoriNajamVrste_Query" name="dtPuniMaster">
			<parameter name="@action" value="0" />
		</data>
		<data command="spUgovoriNajamVrste_Delete" name="dtDelete">
			<parameter name="UgovoriNajamVrsteId" value="#grdMaster.@UgovoriNajamVrsteId" />
		</data>
	</datalist>


	</form>

<form name="frmUnos" caption="Unos">
		<layout>
			<group cols="1" rows="3">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" value="" required="true"/>
				</item>
				<item col="1" row="3" caption="Aktivno:">
					<checkedit name="chkAktivno" value="1"/>
				</item>
					<item col="1" row="2" caption="Oznaka:">
						<textedit name="txtOznaka" value=""/>
					</item>
			</group>
		</layout>

	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">
				<event type="click">
					<action type="validate" />
					<action type="datarun nonquery" value="~dtSpremi" />
					<action type="control populate" value="parent.#grdMaster" />
					<action type="form close" value="frmUnos"/>
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani" type="cancel" dock="right">

			</button>
		</buttons>
	</panelbuttons>


	<datalist>
		<data command="spUgovoriNajamVrste_Insert" name="dtSpremi">
			<parameter name="@naziv" value="#txtNaziv" />
			<parameter name="@aktivno" value="#chkAktivno" />
			<parameter name="@oznaka" value="#txtOznaka" />
		</data>

	</datalist>	

	</form>

<form name="frmIzmjeni" caption="Izmijeni">

	<event type="init">
			<action type="datarun reader" value="dtGet" />
	</event>

		<layout>
			<group cols="1" rows="3">
				<item col="1" row="1" caption="Naziv:">
					<textedit name="txtNaziv" datavalue="~dtGet.@naziv"/>
				</item>
				<item col="1" row="3" caption="Aktivno:">
					<checkedit name="chkAktivno" datavalue="~dtGet.@Aktivno"/>
				</item>
				<item col="1" row="2" caption="Oznaka:">
					<textedit name="txtOznaka" datavalue="~dtGet.@Oznaka" />
				</item>
			</group>
		</layout>

	<panelbuttons>
		<buttons>
			<button name="btnSpremi" caption="Spremi">
				<event type="click">
					<action type="validate" />
					<action type="datarun nonquery" value="~dtIzmjeni" />
					<action type="control populate" value="parent.#grdMaster" />
					<action type="form close" value="frmUnos"/>
				</event>
			</button>
			<button name="btnOdustani" caption="Odustani" type="cancel" dock="right"/>
		</buttons>
	</panelbuttons>

	<datalist>
		
		<data command="spUgovoriNajamVrste_Query" name="dtGet">
			<parameter name="@action" value="1" />
			<parameter name="@UgovoriNajamVrsteId" value="$UgovoriNajamVrsteId" />
		</data>

		<data command="spUgovoriNajamVrste_Edit" name="dtIzmjeni">
				<parameter name="@UgovoriNajamVrsteId" value="$UgovoriNajamVrsteId" />
				<parameter name="@Naziv" value="#txtNaziv" />
				<parameter name="@aktivno" value="#chkAktivno" />
				<parameter name="@oznaka" value="#txtOznaka" />
		</data>

	</datalist>

</form>


</root>